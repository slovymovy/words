                "translations": [
                    {
                        "translation_id": "cb82a311-5d30-49ad-8bb9-cb1b07aa894d",
                        "source_entry_id": "f3e74856-66b0-38e6-a7f2-9a7abec27486",
                        "source_sense_id": "bbdd54c0-1645-3084-87ce-842823656163",
                        "source_sense_description": "door een rottingsproces verloren gaan",
                        "target_lang_word": "deteriorate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "deteriorate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ccfeec79-1020-3ee7-9327-86911d42f4e0",
                                        "entry_id": "a62c182e-1423-3583-8317-cab981fb22d6",
                                        "glosses": [
                                            "To make worse; to make inferior in quality or value; to impair."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb43f705-f8b3-411c-ab7d-061ce317f3ed",
                                                "sense_id": "ccfeec79-1020-3ee7-9327-86911d42f4e0",
                                                "text": "to deteriorate the mind"
                                            },
                                            {
                                                "example_id": "e34944e7-31b8-4f73-a1f0-3d0b7313896d",
                                                "sense_id": "ccfeec79-1020-3ee7-9327-86911d42f4e0",
                                                "text": "The art of war, like every other art, ecclesiastical architecture alone excepted, was greatly deteriorated during those years of general degradation[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23d7ac90-a1af-361b-abab-146276ccf15c",
                                        "entry_id": "a62c182e-1423-3583-8317-cab981fb22d6",
                                        "glosses": [
                                            "To grow worse; to be impaired in quality; to degenerate."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64171c39-995a-4b1c-a440-1b685002b9ab",
                                                "sense_id": "23d7ac90-a1af-361b-abab-146276ccf15c",
                                                "text": "During this fine run through Fife the weather had deteriorated rapidly, and as we passed Wormit and came onto the Tay Bridge heavy rain clouds were piled over the sea."
                                            },
                                            {
                                                "example_id": "6fb50aab-9c91-4353-9ee9-590fa48be566",
                                                "sense_id": "23d7ac90-a1af-361b-abab-146276ccf15c",
                                                "text": "It was turning into an abysmal afternoon for Newcastle and it deteriorated further when Tiote saw red for his challenge on Jon Ashton."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "90493f43-9785-43a5-8e3a-05064db38939",
                        "source_entry_id": "f3e74856-66b0-38e6-a7f2-9a7abec27486",
                        "source_sense_id": "bbdd54c0-1645-3084-87ce-842823656163",
                        "source_sense_description": "door een rottingsproces verloren gaan",
                        "target_lang_word": "rot",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f51cb74c-0c34-3635-b484-22cfa8a41dd1",
                                        "entry_id": "a79ef189-9f95-3e14-ae12-9b89e6089648",
                                        "glosses": [
                                            "To suffer decomposition due to biological action, especially by fungi or bacteria."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67c0364f-3726-4a7e-9838-045eac440352",
                                                "sense_id": "f51cb74c-0c34-3635-b484-22cfa8a41dd1",
                                                "text": "The apple left in the cupboard all that time had started to rot."
                                            },
                                            {
                                                "example_id": "c77c4caa-d415-463a-aca1-54aec8255699",
                                                "sense_id": "f51cb74c-0c34-3635-b484-22cfa8a41dd1",
                                                "text": "Fix'd like a plant on his peculiar spot, / To draw nutrition, propagate, and rot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c1f74af-6096-3af3-a5b0-03c2fe866862",
                                        "entry_id": "a79ef189-9f95-3e14-ae12-9b89e6089648",
                                        "glosses": [
                                            "To decline in function or utility."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "106928cf-3245-484c-8fc2-2e28ead3ff95",
                                                "sense_id": "3c1f74af-6096-3af3-a5b0-03c2fe866862",
                                                "text": "Your brain will rot if you spend so much time on the computer, Tony!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "526638a6-e4b0-3984-9761-06bd1a64794d",
                                        "entry_id": "a79ef189-9f95-3e14-ae12-9b89e6089648",
                                        "glosses": [
                                            "To (cause to) deteriorate in any way, as in morals; to corrupt."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "88cbf681-7bb2-30c4-8bbb-32b6eb0cec0d",
                                        "entry_id": "a79ef189-9f95-3e14-ae12-9b89e6089648",
                                        "glosses": [
                                            "To make putrid; to cause to be wholly or partially decomposed by natural processes."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dff47004-5c29-446f-869d-ce4d99aa4e47",
                                                "sense_id": "88cbf681-7bb2-30c4-8bbb-32b6eb0cec0d",
                                                "text": "to rot vegetable fiber"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d31d06d7-e10a-3160-a186-f89bdd9ad873",
                                        "entry_id": "a79ef189-9f95-3e14-ae12-9b89e6089648",
                                        "glosses": [
                                            "To spend a long period of time (in an unpleasant place or state)."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa90ba3d-9c42-4dc0-8c42-d493848842cb",
                                                "sense_id": "d31d06d7-e10a-3160-a186-f89bdd9ad873",
                                                "text": "to rot in prison"
                                            },
                                            {
                                                "example_id": "0837f7e0-739f-4f8b-bf86-dbde8eb52fb5",
                                                "sense_id": "d31d06d7-e10a-3160-a186-f89bdd9ad873",
                                                "text": "to rot in Hell"
                                            },
                                            {
                                                "example_id": "ae3c9414-b1b9-42b0-a5e9-a1a6b4ffea73",
                                                "sense_id": "d31d06d7-e10a-3160-a186-f89bdd9ad873",
                                                "text": "If I hadn't rotted in bed all day I would've come..."
                                            },
                                            {
                                                "example_id": "680907fb-3a0a-4752-afb1-35a00d79664d",
                                                "sense_id": "d31d06d7-e10a-3160-a186-f89bdd9ad873",
                                                "text": "Four of the sufferers were left to rot in irons."
                                            },
                                            {
                                                "example_id": "2327dcb3-5748-41cd-815b-7cd78b2bb9e6",
                                                "sense_id": "d31d06d7-e10a-3160-a186-f89bdd9ad873",
                                                "text": "Rot, poor bachelor, in your club."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5567e1f-8ca5-3d9f-856a-b9b700d8d956",
                                        "entry_id": "a79ef189-9f95-3e14-ae12-9b89e6089648",
                                        "glosses": [
                                            "To expose, as flax, to a process of maceration, etc., for the purpose of separating the fiber; to ret."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f0b034e9-f891-333f-8b6f-ce03c29756ce",
                                        "entry_id": "a79ef189-9f95-3e14-ae12-9b89e6089648",
                                        "glosses": [
                                            "To talk nonsense."
                                        ],
                                        "tags": [
                                            "dated",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2758226-59a8-4932-8080-81e568047743",
                                                "sense_id": "f0b034e9-f891-333f-8b6f-ce03c29756ce",
                                                "text": "“Did they hang you well?” said Porson.\n“Don’t rot,” said Mr Watkins; “I don’t like it.”"
                                            },
                                            {
                                                "example_id": "73a81108-37b5-4b2b-ad74-fe42a8253bb9",
                                                "sense_id": "f0b034e9-f891-333f-8b6f-ce03c29756ce",
                                                "text": "Adrian thought it worth while to try out his new slang. ‘I say, you fellows, here's a rum go. Old Biffo was jolly odd this morning. He gave me a lot of pi-jaw about slacking and then invited me to tea. No rotting! He did really.’"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
