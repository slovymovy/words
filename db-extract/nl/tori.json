                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "0abd1dd0-464c-4191-b4d1-7cbe8aaab16c",
                                "sense_id": "95553e46-14f9-37eb-b89e-4d9a75c2b332",
                                "text": "Opmerkelijk is, dat de hoeken opgevat zijn als dunne ronde kolonnetten met basement en een eenvoudig lijstkapiteeltje. Uit hun ezelsrugbogen met kruisbloemen en kleine hoekfialen, stijgt een volgende korte geleding op, beëindigd door een afzaat waarop dubbele pinakels staan met een kantig profiel tussen beide in. Hun afgeknotte toppen eindigen tegen de onderlijst van de balustrade, met als profiel een hol tussen twee tori, waarboven een congé."
                            }
                        ]
                    }
