                ],
                "senses": [
                    {
                        "sense_id": "cdcaffa0-e308-3634-8af9-9a6c33651970",
                        "entry_id": "36a3651a-9c81-34a9-9671-166f91efedb5",
                        "glosses": [
                            "die Beratung oder auch die Beratertätigkeit mit dem Ziel einer Lösung (Problemlösung) durch einen Ingenieur oder eine Ingenieurin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10fcd19e-17d9-4003-8abf-e0e9a4ece7a6",
                                "sense_id": "cdcaffa0-e308-3634-8af9-9a6c33651970",
                                "text": "Das Ingenieurconsulting ist die Projekt begleitende, freiberufliche Beratung durch einen oder mehrere Ingenieure aus den unterschiedlichsten Fachrichtungen."
                            },
                            {
                                "example_id": "f7e9e5d9-7fa7-435e-9db6-373755010fdd",
                                "sense_id": "cdcaffa0-e308-3634-8af9-9a6c33651970",
                                "text": "„Der heuer zum 21. Mal vergebene Staatspreis Consulting-Ingenieurconsulting zeichnet daher qualitativ hochwertige Beratungsleistungen aus, die insbesondere durch ihren Innovationsgehalt, ihre Umwelt- und Gesellschaftsrelevanz sowie ihre Exportfähigkeit hervorstechen.“"
                            },
                            {
                                "example_id": "bc7ee6c3-b5c0-45d3-a642-94cb2e6e2867",
                                "sense_id": "cdcaffa0-e308-3634-8af9-9a6c33651970",
                                "text": "„Für die maßgeblichen Entwicklungsleistungen an einem Sensorsystem für veterinär-medizinische Zwecke wurde ein Mitarbeiter des Studienganges „Elektronik & Technologiemanagement“ der FH JOANNEUM vom Wirtschaftsministerium mit der Nominierung zum Staatspreis Ingenieurconsulting ausgezeichnet.“"
                            },
                            {
                                "example_id": "6c1dcb6a-918f-4194-a18c-e1b39dd7f023",
                                "sense_id": "cdcaffa0-e308-3634-8af9-9a6c33651970",
                                "text": "Das Ziel des Ingenieurconsulting ist es, zeitbedingt freie Ingenieure in ein Projekt einzubinden und diese nicht dauerhaft anzustellen."
                            },
                            {
                                "example_id": "44d6f30a-6ca2-4733-89d0-9302471ab8a7",
                                "sense_id": "cdcaffa0-e308-3634-8af9-9a6c33651970",
                                "text": "Dem interdisziplinären Ingenieurconsulting ist es zu verdanken, das herausragende Projekt realisiert werden konnten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
