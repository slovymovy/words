    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "9d99afb8-dbf5-342b-878e-832fb43ec8ad",
                "word": "unpaid",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "89f30470-810a-32de-9d99-1806058ae147",
                        "entry_id": "9d99afb8-dbf5-342b-878e-832fb43ec8ad",
                        "glosses": [
                            "Not paid for."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "dab1a2fb-89bc-4904-95dc-7848e039dcb2",
                                "sense_id": "89f30470-810a-32de-9d99-1806058ae147",
                                "text": "an unpaid bill"
                            },
                            {
                                "example_id": "a6d9c89e-d5a8-4a6f-bc7e-659e155ff47b",
                                "sense_id": "89f30470-810a-32de-9d99-1806058ae147",
                                "text": "Plea, that R. and E. being ſeiſed of lands, were diſſeiſed by plaintiff, who demiſed to defendent;^([sic]) R. and E. re-entered before any rent was unpaid."
                            },
                            {
                                "example_id": "dacc0296-fad2-4276-a514-e70c7c44c7b6",
                                "sense_id": "89f30470-810a-32de-9d99-1806058ae147",
                                "text": "[T]he plaintiff re-sold the said one hundred and sixty-five bags of Russian and German wool so remaining unaccepted by the defendants and unpaid for by them, by public sale, at and for a much less sum, to wit, the sum of 2000l. less than the sum so agreed to be paid by the defendants for the same; […]"
                            },
                            {
                                "example_id": "c5a45581-253d-402f-9297-8505fa096e35",
                                "sense_id": "89f30470-810a-32de-9d99-1806058ae147",
                                "text": "The volume of unpaid consumption in movies appears to be lower, particularly in the United States. Rob and Waldfogel (2007) report that only about 5 percent of movie consumption among University of Pennsylvania students in 2005 was unpaid (at a time when about half of a similar population's music consumption was unpaid)."
                            },
                            {
                                "example_id": "8d493024-c290-4301-8ddf-c722b508ae22",
                                "sense_id": "89f30470-810a-32de-9d99-1806058ae147",
                                "text": "A growing number of U.S. cities are alerting residents to a widespread phishing scam involving fraudulent text messages about unpaid parking violations."
                            }
                        ]
                    },
                    {
                        "sense_id": "d886bbc7-7451-340a-abf3-c2b048b34ef3",
                        "entry_id": "9d99afb8-dbf5-342b-878e-832fb43ec8ad",
                        "glosses": [
                            "Of work: done without agreed payment, usually voluntarily."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "5781f857-d3fa-4892-829b-1a7d82656c2b",
                                "sense_id": "d886bbc7-7451-340a-abf3-c2b048b34ef3",
                                "text": "an unpaid position"
                            },
                            {
                                "example_id": "97e3b52e-87cc-489f-8db8-8f9ab3dcb9b2",
                                "sense_id": "d886bbc7-7451-340a-abf3-c2b048b34ef3",
                                "text": "Farm labor is a critical input in agricultural production. Farm operators provide just about half of all labor hours in agriculture, most of which are unpaid. An additional 18 percent of farm labor hours are unpaid hours provided by farm household members, partners, and others."
                            },
                            {
                                "example_id": "6d558d66-0825-484c-b94b-8718567e7e8a",
                                "sense_id": "d886bbc7-7451-340a-abf3-c2b048b34ef3",
                                "text": "[A]ll people who perform work, paid or unpaid, are economically active. It is, and always has been, quite misleading to regard people who perform only unpaid household work outside the SNA [United Nations System of National Accounts] production boundary as economically inactive."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7f768952-7799-4814-b568-651e97c655e2",
                        "source_entry_id": "9d99afb8-dbf5-342b-878e-832fb43ec8ad",
                        "source_sense_description": "not paid for",
                        "target_lang_word": "impayé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "impayé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f9c51e56-ce8d-3ca5-a263-0335095c0384",
                                        "entry_id": "df283bc2-acc3-38ea-a8e4-a9f161fbad53",
                                        "glosses": [
                                            "Qui n’a pas été payé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d372056-9506-4960-bfd2-18efa38962a5",
                                                "sense_id": "f9c51e56-ce8d-3ca5-a263-0335095c0384",
                                                "text": "Une dette impayée est la bassesse, un commencement de friponnerie, et pis que tout cela, un mensonge !"
                                            },
                                            {
                                                "example_id": "e83b094a-01e8-4499-81ce-2515cd29e8cb",
                                                "sense_id": "f9c51e56-ce8d-3ca5-a263-0335095c0384",
                                                "text": "Mais comment pourra-ton satisfaire au besoin moral des masses ? On ne le peut que par une instruction publique généralement gratuite, […]. Mais si, comme jusqu'alors, les instituteurs sont inconsidérés, tourmentés, vexés, impayés, mal logés, à une merci ingrate, paupérisante et dégradante, sous une dépendance entravante et serve, sous le coterisme du prêtre et de quelques factotons de village, les populations ne sortiront pas de leur ignorance, resteront dans leur abêtissement et leur abrutissement, […]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "impayé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "38e5b5fc-2135-3db4-9d7b-7bbee5030849",
                                        "entry_id": "43eed670-9ca8-3896-96aa-16fe90c59568",
                                        "glosses": [
                                            "Somme qui n’est pas payée à l'échéance où elle devrait l'être."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "802927a0-383f-475e-b7d8-807912f73bea",
                                                "sense_id": "38e5b5fc-2135-3db4-9d7b-7bbee5030849",
                                                "text": "« Nous faisons de plus en plus de médiation avec les bailleurs ou les fournisseurs d’énergie pour étaler les impayés », remarque Fathia, qui accompagne 80 familles."
                                            },
                                            {
                                                "example_id": "29abbcd6-6fcb-488b-91fb-d637f1650c26",
                                                "sense_id": "38e5b5fc-2135-3db4-9d7b-7bbee5030849",
                                                "text": "Il s’agit d’un procès entamé à Buenos Aires par un commerçant portugais en rapport à une dette dont l’origine est un impayé issu d’un long rapport commercial."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
