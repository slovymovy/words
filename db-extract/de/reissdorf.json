                ],
                "senses": [
                    {
                        "sense_id": "92680cc7-4460-3dd4-be28-7e04f400e599",
                        "entry_id": "e26c68a6-c800-34b7-a8b9-cbb8b9104917",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6932df4e-9bce-496a-9ed1-5354be3c1d74",
                                "sense_id": "92680cc7-4460-3dd4-be28-7e04f400e599",
                                "text": "Frau Reissdorf ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "03f8af0d-b6a3-4c6f-be41-e9552e726f8d",
                                "sense_id": "92680cc7-4460-3dd4-be28-7e04f400e599",
                                "text": "Herr Reissdorf wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "f49bdfe0-685e-41d2-a8d7-3773cdea1465",
                                "sense_id": "92680cc7-4460-3dd4-be28-7e04f400e599",
                                "text": "Die Reissdorfs fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "940972e2-9683-4325-a166-d65a51c8da21",
                                "sense_id": "92680cc7-4460-3dd4-be28-7e04f400e599",
                                "text": "Der Reissdorf trägt nie die Schals, die die Reissdorf ihm strickt."
                            },
                            {
                                "example_id": "8efd9229-5888-46a3-b098-39fe5fee9d70",
                                "sense_id": "92680cc7-4460-3dd4-be28-7e04f400e599",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Reissdorf kommt, geht der Herr Reissdorf.“"
                            },
                            {
                                "example_id": "eb27c784-f875-4421-8d11-056a3d16ea6f",
                                "sense_id": "92680cc7-4460-3dd4-be28-7e04f400e599",
                                "text": "Reissdorf kommt und geht."
                            },
                            {
                                "example_id": "7ef3bcf6-9ab5-4a63-a9ea-4cd877390109",
                                "sense_id": "92680cc7-4460-3dd4-be28-7e04f400e599",
                                "text": "Reissdorfs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
