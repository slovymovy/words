                    "sense_id": "77a135f7-6976-3a75-86f1-5e5cf493f5e8",
                    "sense_definition": "De ogen ergens op richten om iets of iemand te zien.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "waarneming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij bleef naar de prachtige zonsondergang <w>kijken</w>.",
                            "target_lang_translations": {
                                "ru": "Он продолжал <w>смотреть</w> на прекрасный закат.",
                                "en": "He kept <w>looking</w> at the beautiful sunset.",
                                "pl": "Nadal <w>patrzył</w> na piękny zachód słońca.",
                                "de": "Er <w>schaute</w> weiterhin den wunderschönen Sonnenuntergang an.",
                                "fr": "Il continuait à <w>regarder</w> le magnifique coucher de soleil.",
                                "it": "Continuò a <w>guardare</w> il bellissimo tramonto.",
                                "cs": "Stále se <w>díval</w> na ten krásný západ slunce.",
                                "tr": "Muhteşem gün batımına <w>bakmaya</w> devam etti.",
                                "es": "Se quedó <w>mirando</w> el hermoso atardecer."
                            }
                        },
                        {
                            "text": "Ik <w>kijk</w> graag naar de sterrenhemel op een heldere nacht.",
                            "target_lang_translations": {
                                "ru": "Я люблю <w>смотреть</w> на звездное небо в ясную ночь.",
                                "en": "I like <w>looking</w> at the starry sky on a clear night.",
                                "pl": "Lubię <w>patrzeć</w> w gwieździste niebo w jasną noc.",
                                "de": "Ich <w>schaue</w> in einer klaren Nacht gerne in den Sternenhimmel.",
                                "fr": "J'aime <w>regarder</w> le ciel étoilé par une nuit claire.",
                                "it": "Mi piace <w>guardare</w> il cielo stellato in una notte serena.",
                                "cs": "Za jasné noci se rád <w>dívám</w> na hvězdnou oblohu.",
                                "tr": "Açık bir gecede yıldızlı gökyüzüne <w>bakmayı</w> severim.",
                                "es": "Me gusta <w>mirar</w> el cielo estrellado en una noche despejada."
                            }
