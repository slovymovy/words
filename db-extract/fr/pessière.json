                    {
                        "sense_id": "34754f15-c6d9-33b8-a751-b0e3752862ed",
                        "entry_id": "ab158790-1931-3a5e-a9a0-3af206ca677b",
                        "glosses": [
                            "Lieu peuplé d'épicéas."
                        ],
                        "tags": [
                            "Phytosociologie"
                        ],
                        "examples": [
                            {
                                "example_id": "8a81d78e-fc79-44f7-b612-f5e0c97515f4",
                                "sense_id": "34754f15-c6d9-33b8-a751-b0e3752862ed",
                                "text": "A l'heure actuelle, l'étendue inculte boisable en épicéa étant fortement réduite, son extension est due à la conversion de peuplements feuillus en pessières et au boisement de terres agricoles."
                            },
                            {
                                "example_id": "9478ae00-72c0-4647-b20d-43f98cdb132c",
                                "sense_id": "34754f15-c6d9-33b8-a751-b0e3752862ed",
                                "text": "C'est le cas par exemple de forêts très artificialisées à haute productivité (la ligniculture pratiquée pour le peuplier italien, le pin maritime landais, l’eucalyptus portugais, les pessières ou douglaseraies de moyenne montagne), ou à l'inverse d'écosystèmes forestiers en réserve intégrale."
                            },
                            {
                                "example_id": "29e2b8a3-d91e-4884-8459-2ea25b29b417",
                                "sense_id": "34754f15-c6d9-33b8-a751-b0e3752862ed",
                                "text": "En revanche, en fonction du degré d’évolution dynamique ou de la nature des actions sylvicoles, on peut rencontrer, par exemple selon les stations, une boulaie-pineraie pionnière, une pineraie pionnière, ou bien encore une pessière, ou une douglasaie plantées…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "02d6ce78-c31a-4eb4-bc27-3abbb2f93a88",
                        "source_entry_id": "ab158790-1931-3a5e-a9a0-3af206ca677b",
                        "source_sense_id": "34754f15-c6d9-33b8-a751-b0e3752862ed",
                        "target_lang_word": "Fichtenwald",
                        "target_lang_code": "de",
