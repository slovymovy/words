                "senses": [
                    {
                        "sense_id": "ea9b4f6e-5436-3640-b2d9-7ee47c84b4e7",
                        "entry_id": "c61da9a7-18ee-39a1-adfb-40a145a5eda3",
                        "glosses": [
                            "Donner un caractère norvégien à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92a66a21-85fa-4101-a263-74acadac5833",
                                "sense_id": "ea9b4f6e-5436-3640-b2d9-7ee47c84b4e7",
                                "text": "Les efforts qu’on a faits pour créer une langue purement norvégienne, le Maal, composé de plusieurs dialectes du pays, ont eu pour résultat de norvégianiser encore davantage le norvégien, ce dont il faut se féliciter."
                            },
                            {
                                "example_id": "eb85fbea-8a18-4b67-be49-cc2e57b35edc",
                                "sense_id": "ea9b4f6e-5436-3640-b2d9-7ee47c84b4e7",
                                "text": "Le premier, sous l’égide du poète Wergeland, visa à \"norvégianiser\" le danois."
                            }
                        ]
                    }
