                            }
                        ]
                    },
                    {
                        "sense_id": "b9ef9361-f751-344a-beed-c2d465029991",
                        "entry_id": "4f45f4db-87c3-38ce-968a-c27b9536466e",
                        "glosses": [
                            "an excessive lust for profit"
                        ],
                        "tags": [
