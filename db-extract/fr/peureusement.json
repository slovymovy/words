        "fr-extract.jsonl": [
            {
                "entry_id": "ed1c9db8-aac3-38e7-a671-f9cab43266b9",
                "word": "peureusement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "eb40a63f-4f52-3f4f-886d-6719d7bd0940",
                        "entry_id": "ed1c9db8-aac3-38e7-a671-f9cab43266b9",
                        "glosses": [
                            "D’une façon peureuse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d2208e0-078a-4c2c-908b-399301188640",
                                "sense_id": "eb40a63f-4f52-3f4f-886d-6719d7bd0940",
                                "text": "Une petite pluie mince et tenace dégoulinait sans arrêt depuis la veille et les passants, recroquevillés sous leurs riflards, les yeux rivés sur le pavé en larmes, glissant peureusement parmi les files des voitures serrées, lui fournissaient l’impression vague de spectres titubants."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c3a1d7c7-1474-437d-a38a-4fd3cb4a4094",
                        "source_entry_id": "ed1c9db8-aac3-38e7-a671-f9cab43266b9",
                        "source_sense_id": "eb40a63f-4f52-3f4f-886d-6719d7bd0940",
                        "target_lang_word": "anxiously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anxiously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8830ceb2-da90-3084-b8b4-1ec3067aeaf2",
                                        "entry_id": "28ca4ed7-32df-3288-99d3-c22b47ffc9bd",
                                        "glosses": [
                                            "In an anxious manner; with painful uncertainty; solicitously."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb79ecab-813d-402f-8ada-f56489caec7d",
                                                "sense_id": "8830ceb2-da90-3084-b8b4-1ec3067aeaf2",
                                                "text": "'Even in summer, Grannie?' Heidi persisted anxiously."
                                            },
                                            {
                                                "example_id": "8fade652-2376-4dc6-977d-12203edf0e41",
                                                "sense_id": "8830ceb2-da90-3084-b8b4-1ec3067aeaf2",
                                                "text": "He tried to persuade Cicely to stay away from the ball-room for a fourth dance.[…]But she said she must go back, and when they joined the crowd again[…]she found her mother standing up before the seat on which she had sat all the evening searching anxiously for her with her eyes, and her father by her side."
                                            },
                                            {
                                                "example_id": "5ba59b51-68de-41d5-bd1e-ebb5910eab28",
                                                "sense_id": "8830ceb2-da90-3084-b8b4-1ec3067aeaf2",
                                                "text": "He anxiously awaited the arrival of his child."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dd4fb02b-ecdb-46f7-b794-fcc4bc70a029",
                        "source_entry_id": "ed1c9db8-aac3-38e7-a671-f9cab43266b9",
                        "source_sense_id": "eb40a63f-4f52-3f4f-886d-6719d7bd0940",
                        "target_lang_word": "nervously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nervously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "94e2630e-9bbf-396e-80f5-3fc260bc89d7",
                                        "entry_id": "61867f81-6774-3d89-9039-0180286eee4b",
                                        "glosses": [
                                            "In a nervous manner; feeling or displaying nervousness."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e942f3fa-e9e2-40c2-9af7-4f38c46eed88",
                                                "sense_id": "94e2630e-9bbf-396e-80f5-3fc260bc89d7",
                                                "text": "He paced nervously as he waited for the important phone call."
                                            },
                                            {
                                                "example_id": "72fa48c7-3437-4fef-9a81-8e897ddc63de",
                                                "sense_id": "94e2630e-9bbf-396e-80f5-3fc260bc89d7",
                                                "text": "Then he could see the modest bookseller, somewhat clammy in his extremities and lost within his academic robe and hood, nervously fidgeting his mortar-board, haled forward by ushers, and tottering rubescent before the chancellor, provost, president (or whoever it might be) who hands out the diploma."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8ac740a8-03a4-4896-b1b0-a7f43c49b8bc",
                        "source_entry_id": "ed1c9db8-aac3-38e7-a671-f9cab43266b9",
