                "senses": [
                    {
                        "sense_id": "f5da6026-3876-3462-880e-4d38af79d880",
                        "entry_id": "437b8490-e436-3325-80c1-f2937ab7c6cb",
                        "glosses": [
                            "Faire perdre son caractère diasporique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fa9b213-4968-4f50-aaa6-0450542da690",
                                "sense_id": "f5da6026-3876-3462-880e-4d38af79d880",
                                "text": "L’ambition n’était pas uniquement de sortir les Juifs de la diaspora, mais aussi, et surtout, de les « dédiasporiser »."
                            },
                            {
                                "example_id": "c9aa1757-962b-4ff3-b8c2-1592b7ae6bad",
                                "sense_id": "f5da6026-3876-3462-880e-4d38af79d880",
                                "text": "Le ministère des Affaires étrangères l’impose même à ses fonctionnaires en poste, sans doute pour projeter une certaine image d’Israël, mais aussi pour « dédiasporiser » l’image juive traditionnelle."
                            }
                        ]
                    }
