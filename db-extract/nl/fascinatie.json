        "nl-extract.jsonl": [
            {
                "entry_id": "776f2006-cb6b-3c24-bc7e-1d629e582cf7",
                "word": "fascinatie",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "4b102c01-449a-45bf-a6b0-1a7060ab004d",
                        "entry_id": "776f2006-cb6b-3c24-bc7e-1d629e582cf7",
                        "tags": [
                            "plural"
                        ],
                        "form": "fascinaties"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0e2d6141-f84e-33ea-bfd4-c17805a2bf4c",
                        "entry_id": "776f2006-cb6b-3c24-bc7e-1d629e582cf7",
                        "glosses": [
                            "intense en voortdurende aandacht voor bepaalde zaak; hevige interesse voor iets"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6433a9f0-8301-40b4-9389-0bedc1639f3e",
                                "sense_id": "0e2d6141-f84e-33ea-bfd4-c17805a2bf4c",
                                "text": "Ondertussen had zich een Amerikaanse vrouw van 22 jaar bij ons gevoegd, So it Goes. Deze trailnaam had ze gekregen vanwege haar fascinatie voor het boek ‘Slaughterhouse five’ van Kurt Vonnegut, waarin vaak de bijzin ‘so it goes’ terugkomt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "76812e96-fa64-4fad-8da7-57b6e11f87be",
                        "source_entry_id": "776f2006-cb6b-3c24-bc7e-1d629e582cf7",
                        "source_sense_id": "0e2d6141-f84e-33ea-bfd4-c17805a2bf4c",
                        "target_lang_word": "Faszination",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Faszination",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e743b7d0-88a7-3812-bdca-45f1e7e0e5b0",
                                        "entry_id": "3272c518-1146-3abb-8dcc-46aa9fac97aa",
                                        "glosses": [
                                            "anziehende Wirkung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39b65006-fb7a-48a9-91ec-85e5943abb87",
                                                "sense_id": "e743b7d0-88a7-3812-bdca-45f1e7e0e5b0",
                                                "text": "Es übt große Faszination auf mich aus und ist damit für mich ein Faszinosum."
                                            },
                                            {
                                                "example_id": "55ed0b0d-ec56-4a6a-ac3e-ab996b792a08",
                                                "sense_id": "e743b7d0-88a7-3812-bdca-45f1e7e0e5b0",
                                                "text": "„Auch sozialdemokratische Arbeiter ließ die Faszination des Militärischen nicht unberührt.“"
                                            },
                                            {
                                                "example_id": "7d3ac784-8670-4921-810a-5e088646f3c6",
                                                "sense_id": "e743b7d0-88a7-3812-bdca-45f1e7e0e5b0",
                                                "text": "„Das Kriegsspiel bezieht seine Faszination aus folgenden Momenten, die zunächst wertungsfrei dargestellt werden sollen: ….\""
                                            },
                                            {
                                                "example_id": "81e30cbf-e678-4564-b502-00cca86c416c",
                                                "sense_id": "e743b7d0-88a7-3812-bdca-45f1e7e0e5b0",
                                                "text": "„Viele prominente Texte spiegelten diese Faszination wider.“"
                                            },
                                            {
                                                "example_id": "327e1c4a-615f-489f-8788-37c583dea105",
                                                "sense_id": "e743b7d0-88a7-3812-bdca-45f1e7e0e5b0",
                                                "text": "„Schon als Achtzehnjähriger war Schumann bei einer Schiffahrt der Faszination des Rheinlands erlegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "91619989-419c-3f96-89d9-0f48e0b9f075",
                                        "entry_id": "3272c518-1146-3abb-8dcc-46aa9fac97aa",
                                        "glosses": [
                                            "Begeisterung, euphorisches Interesse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a29faf7f-0c3a-4ccb-aee8-b23baa839003",
                                                "sense_id": "91619989-419c-3f96-89d9-0f48e0b9f075",
                                                "text": "„Das Kriegsspiel bezieht seine Faszination aus folgenden Momenten, die zunächst wertungsfrei dargestellt werden sollen: ….\""
                                            },
                                            {
                                                "example_id": "863baa4f-5039-4a05-92ee-ca6a3e6f58eb",
                                                "sense_id": "91619989-419c-3f96-89d9-0f48e0b9f075",
                                                "text": "Ich kann meine Faszination bei dieser Sache nicht wirklich begründen."
                                            },
                                            {
                                                "example_id": "00fa003e-a1e9-4d0a-a44a-93497a7f7773",
                                                "sense_id": "91619989-419c-3f96-89d9-0f48e0b9f075",
                                                "text": "„Evoziert wird eine Situation des Höhenschwindels, die an Rousseaus Faszination für Wasserfälle und Abgründe erinnert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f9f91b43-48ae-348b-897f-1968f61700af",
                                        "entry_id": "3272c518-1146-3abb-8dcc-46aa9fac97aa",
                                        "glosses": [
                                            "die Tat des Faszinierens, des Verhexens oder des Verzauberns; Verzauberung; Zauberkraft; die Ausübung eines mächtigen oder unwiderstehlichen Einflusses auf die Neigungen des Gemütszustand oder der Leidenschaft; ungesehenen, unerklärlicher Einfluss"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f10cee6-09cf-4527-ad26-71dbc79b50a1",
                                                "sense_id": "f9f91b43-48ae-348b-897f-1968f61700af",
                                                "text": "Ihm gelang die Faszination des Publikums wieder hervorragend."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1c0779bf-caa1-489b-9869-2ab6b5024a2f",
                        "source_entry_id": "776f2006-cb6b-3c24-bc7e-1d629e582cf7",
                        "source_sense_id": "0e2d6141-f84e-33ea-bfd4-c17805a2bf4c",
                        "target_lang_word": "fascination",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fascination",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "177c3196-7db8-30fc-add4-78e89a6f94cb",
                                        "entry_id": "25ba19be-188c-395b-a9bc-75cd5eb75038",
                                        "glosses": [
                                            "The act of bewitching, or enchanting"
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b7942d5-f9aa-4ec0-9f2d-4351e779b3f3",
                                                "sense_id": "177c3196-7db8-30fc-add4-78e89a6f94cb",
                                                "text": "Little disappointed, then, she turned attention to \"Chat of the Social World,\" gossip which exercised potent fascination upon the girl's intelligence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21529453-00a0-37af-9b7b-08a761d842b5",
                                        "entry_id": "25ba19be-188c-395b-a9bc-75cd5eb75038",
                                        "glosses": [
                                            "The state or condition of being fascinated."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64c99b5a-6937-4918-9fac-c97ba062f1c6",
                                                "sense_id": "21529453-00a0-37af-9b7b-08a761d842b5",
                                                "text": "To my fascination, the skies turned all kinds of colours."
                                            },
                                            {
                                                "example_id": "9128ab7c-2dec-47a0-a643-94d332bb831a",
                                                "sense_id": "21529453-00a0-37af-9b7b-08a761d842b5",
                                                "text": "Sliding down the shaft he lay still, the spear jutting above him its full length, like a horrible stalk growing out of his back.\nThe girl stared down at him in morbid fascination, until Khemsa took her arm and led her through the gate."
                                            },
                                            {
                                                "example_id": "2a8968b9-17d1-42c7-a826-40447c5d12b9",
                                                "sense_id": "21529453-00a0-37af-9b7b-08a761d842b5",
                                                "text": "But the compensations are many: changing scenes, long days out of doors, freedom from the bondage of conventional life, and above all, the fascination of living among peoples of primitive simplicity and yet of a civilization so ancient that it makes all that is oldest in the West seem raw and crude and unfinished."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7cbf668f-c5f7-3897-9e6c-5d25b10f8c3b",
                                        "entry_id": "25ba19be-188c-395b-a9bc-75cd5eb75038",
                                        "glosses": [
                                            "Something which fascinates."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8953ea57-26db-41af-b812-6a1d90467473",
                                                "sense_id": "7cbf668f-c5f7-3897-9e6c-5d25b10f8c3b",
                                                "text": "Life after death had always been a great fascination to him."
                                            },
                                            {
                                                "example_id": "7d34a8b7-f735-4e38-bd07-fc19cc9b5408",
                                                "sense_id": "7cbf668f-c5f7-3897-9e6c-5d25b10f8c3b",
                                                "text": "Though more thoughtful than Madame de Mercœur, yet it asked far more knowledge of society—that wilderness of small intricacies—for her to penetrate into the motives of those who seemed so suddenly struck with her fascination; but she was too clear-headed to be deceived, and set it all down under one general belief in caprice."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0e153ca2-77ef-4754-9560-d143d80f587c",
                        "source_entry_id": "776f2006-cb6b-3c24-bc7e-1d629e582cf7",
                        "source_sense_id": "0e2d6141-f84e-33ea-bfd4-c17805a2bf4c",
                        "target_lang_word": "fascination",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fascination",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0ad350e3-f7d4-3905-bcc7-feb3fb5fa8a3",
                                        "entry_id": "9e886955-62e6-31c0-8332-2cf54e808a91",
                                        "glosses": [
                                            "Action à distance qui passe par le regard pour nuire ou tuer, mauvais œil."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4bcaedc-10ee-4578-863b-99dfd44f01d7",
                                                "sense_id": "0ad350e3-f7d4-3905-bcc7-feb3fb5fa8a3",
                                                "text": "Avec de multiples arguments, le moine formé pour partie à Padoue élabore une théorie psycho-physiologique de la fascination dont les vecteurs principaux sont les « esprits » à la fois spirituels et corporels qui sont mus par l’âme du fascinateur jusqu’au corps du fasciné, entre théorie de l’âme, physique, optique et médecine ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aafca937-a924-33cc-a303-a765369ba4b2",
                                        "entry_id": "9e886955-62e6-31c0-8332-2cf54e808a91",
                                        "glosses": [
                                            "Faculté qu’ont certains animaux de fasciner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5508d43-876c-4d59-a34e-c75504de5f3e",
                                                "sense_id": "aafca937-a924-33cc-a303-a765369ba4b2",
                                                "text": "La fascination que le serpent exerce, dit-on, sur le rossignol."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0558ec7c-4cca-3b92-9f3e-c11ac817fa2b",
                                        "entry_id": "9e886955-62e6-31c0-8332-2cf54e808a91",
                                        "glosses": [
                                            "Action de fasciner et résultat de cette action."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef415f15-4955-41e5-8403-4772e1d5a9a6",
                                                "sense_id": "0558ec7c-4cca-3b92-9f3e-c11ac817fa2b",
                                                "text": "Voyez, mon frère Conrad, le danger de céder aux premiers artifices, aux premières fascinations de Satan !"
                                            },
                                            {
                                                "example_id": "3c6c8ad6-f416-439e-9bdc-05065a19a9d5",
                                                "sense_id": "0558ec7c-4cca-3b92-9f3e-c11ac817fa2b",
                                                "text": "Jimmy n'y avait pas pris garde au départ, mais la vue de ces galeries exerçaient sur lui une espèce de fascination."
                                            },
                                            {
                                                "example_id": "2f0fe955-6a74-4c2c-acd2-f9a1a733de15",
                                                "sense_id": "0558ec7c-4cca-3b92-9f3e-c11ac817fa2b",
                                                "text": "En vérité, il n’y avait dans ma tête aucune pensée, rien que la fascination pour le vide, par la baie vitrée."
                                            },
                                            {
                                                "example_id": "d49497bd-be79-4867-b81a-ab3e06de935a",
                                                "sense_id": "0558ec7c-4cca-3b92-9f3e-c11ac817fa2b",
                                                "text": "Au delà de l'évocation pittoresque d'un passé un peu idéalisé […], ce texte donne des informations indirectes, mais précieuses, sur le rapport qui commence à s'établir entre un public populaire et le nouveau spectacle : l’ébahissement et la fascination ( « badaient devant les images » ) n'empêchent pas le recul critique ([…])."
                                            },
                                            {
                                                "example_id": "49e8dff7-dbd1-47ae-8ce5-8adba3091c57",
                                                "sense_id": "0558ec7c-4cca-3b92-9f3e-c11ac817fa2b",
                                                "text": "«Il y a une fascination pour Musk autour du récit de l'entrepreneur à succès», «une forme de complaisance des extrêmes droites et au-delà»."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
