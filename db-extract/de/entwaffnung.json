                        "translation_id": "275dcded-8321-427e-ae65-86e15172d945",
                        "source_entry_id": "01da6cce-689a-310c-ad16-f2817c643728",
                        "source_sense_id": "5010ebdb-3a95-3ee1-b758-55c8f92b808a",
