                    "frequency": "High",
                    "semantic_group_id": "transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous devons nous retrouver devant la grande <w>gare</w> une heure avant le départ du train."
                        },
                        {
                            "text": "Le train rapide est entré lentement en <w>gare</w> sous les yeux des voyageurs impatients."
                        }
