                        "entry_id": "d0d89999-0a8e-3657-a54a-e692d4879264",
                        "glosses": [
                            "geld betaald voor iemands vrijlating"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "434b43f9-58c3-4208-bd06-6215afabb92b",
                                "sense_id": "746aaeb9-c068-3f7f-92da-c7a93b45fef4",
                                "text": "De bandieten eisten een groot losgeld voor de gijzelaars die zij overweldigd hadden."
                            }
                        ]
                    },
                    {
                        "sense_id": "b48bd3ee-463e-3394-b29e-eb568d1633f4",
                        "entry_id": "d0d89999-0a8e-3657-a54a-e692d4879264",
                        "glosses": [
                            "goederen die betaald moeten worden voor iemands vrijlating"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "c9032dda-f7f4-4879-b338-cf3f9b5ce6d1",
                                "sense_id": "b48bd3ee-463e-3394-b29e-eb568d1633f4",
                                "text": "Verder eisen wij een losgeld voor de Koning van 200 kwasten en 500 verfpotten, bijeen te brengen door de inwoners van Perspektivum."
                            }
                        ]
                    },
                    {
                        "sense_id": "10eb6fa7-43a7-3440-a86d-aec40c73cb90",
                        "entry_id": "d0d89999-0a8e-3657-a54a-e692d4879264",
                        "glosses": [
                            "geld dat men moet betalen voor het vrijgeven van een computersysteem na een hack met gijzelsoftware"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1cdb60e6-5608-4a6a-be14-6399892a18b2",
                                "sense_id": "10eb6fa7-43a7-3440-a86d-aec40c73cb90",
                                "text": "De Universiteit Maastricht (UM) krijgt het losgeld dat in 2019 na een hack werd betaald aan cybercriminelen terug. De politie en het Openbaar Ministerie hebben inmiddels een deel van het losgeld en de cryptomunten gevonden. Doordat de cryptomunten meer waard zijn geworden, ontvangt de universiteit zo'n 500.000 euro, terwijl destijds bijna 200.000 euro aan losgeld is betaald, meldt de Volkskrant."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "499e9cdf-e131-4a03-b620-26451bdf9a95",
                        "source_entry_id": "d0d89999-0a8e-3657-a54a-e692d4879264",
                        "source_sense_id": "746aaeb9-c068-3f7f-92da-c7a93b45fef4",
                        "source_sense_description": "geld betaald voor iemands vrijlating",
                        "target_lang_word": "Lösegeld",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lösegeld",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "464a0a9f-2acf-3b18-86a4-7297a36830c5",
                                        "entry_id": "c0e1fbfd-0c80-321f-ae37-a603a3ce2db3",
                                        "glosses": [
                                            "Geld, das für die Freilassung einer Geisel gezahlt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6618c150-e54f-4722-a482-27d17b4dda7a",
                                                "sense_id": "464a0a9f-2acf-3b18-86a4-7297a36830c5",
                                                "text": "Die Entführer verlangen eine Million Euro Lösegeld."
                                            },
                                            {
                                                "example_id": "cd13dddf-0792-4690-8d6b-fa72a364e904",
                                                "sense_id": "464a0a9f-2acf-3b18-86a4-7297a36830c5",
                                                "text": "„Die Krise verschärfte sich erheblich, als im Jahre 455 die Vandalen Rom einnahmen, die Stadt plünderten, die Oberschicht gefangen nahmen und erst nach Zahlung eines hohen Lösegeldes entließen.“"
                                            },
                                            {
                                                "example_id": "0c56b100-6486-4d04-a6b4-4d1fd5d50836",
                                                "sense_id": "464a0a9f-2acf-3b18-86a4-7297a36830c5",
                                                "text": "„Vielfach enden Entführungen glimpflich für die Entführten, doch hat in letzter Zeit auch die Extremistengruppe Al-Kaida auf der Arabischen Halbinsel (AQAP) mehrere Ausländer entführt, darunter einen südafrikanischen Lehrer, den sie zu ermorden drohen, sollte für ihn kein Lösegeld gezahlt werden.“"
                                            },
                                            {
                                                "example_id": "f973834c-48ae-4ac0-8190-24eac2f57cec",
                                                "sense_id": "464a0a9f-2acf-3b18-86a4-7297a36830c5",
                                                "text": "„Polybios erwähnt nicht das hohe Lösegeld, das die Römer für den Abzug der Gallier zahlen müssen, wie Livius berichtet.“"
                                            },
                                            {
                                                "example_id": "7bfe5b8a-d5d5-4392-9a3e-3d4eab73d7b5",
                                                "sense_id": "464a0a9f-2acf-3b18-86a4-7297a36830c5",
                                                "text": "„Das musste der Wesir des Mogulreichs erfahren, dessen großes Heer Baji Rao zweimal besiegte, dann aber jedesmal gegen hohes Lösegeld davonziehen ließ.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4f6a6c2e-deaa-483b-bd48-454e286fb000",
                        "source_entry_id": "d0d89999-0a8e-3657-a54a-e692d4879264",
