                                "target_senses": [
                                    {
                                        "sense_id": "81e74796-08df-3453-ac6b-815bebcb15ca",
                                        "entry_id": "975f222c-f2e7-3fce-8a20-e669f41eb979",
                                        "glosses": [
                                            "von wenigen oder keinem erwartet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df8275d5-3ee3-4b5a-b82e-4ce3f229d159",
                                                "sense_id": "81e74796-08df-3453-ac6b-815bebcb15ca",
                                                "text": "Das kam ganz unerwartet."
                                            },
                                            {
                                                "example_id": "9e1b326c-dac0-407c-910a-b8228e8da722",
                                                "sense_id": "81e74796-08df-3453-ac6b-815bebcb15ca",
                                                "text": "Ein unerwarteter Knall versetzte das Publikum in Panik."
                                            },
                                            {
                                                "example_id": "2a74dc3a-4704-4cd4-b01f-85380c3691fe",
                                                "sense_id": "81e74796-08df-3453-ac6b-815bebcb15ca",
                                                "text": "„Nach Einrichtung des Weltpostvereins und seines Standardportos verzeichnet der überseeische Postverkehr ebenso wie die Postdienste der beteiligten Länder gänzlich unerwartete Zuwachsraten.“"
                                            },
                                            {
                                                "example_id": "ae48cee3-31d5-4478-9254-ce7e5d5ccd99",
                                                "sense_id": "81e74796-08df-3453-ac6b-815bebcb15ca",
                                                "text": "„Das Grabmal ist von unerwarteter Monumentalität und wirkt dabei fast zerbrechlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f820ce23-97e5-421e-8ec4-fb5b1671fbed",
                        "source_entry_id": "106e7ec8-3d6d-36af-a090-4147b63f33dc",
                        "source_sense_id": "90253238-1b7b-3736-a9a2-1e9409405b05",
