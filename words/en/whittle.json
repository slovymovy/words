                    "sense_definition": "To make someone intoxicated or drunk.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "intoxication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The guests were quite <w>whittled</w> after several rounds of strong ale.",
                            "target_lang_translations": {
                                "nl": "De gasten waren behoorlijk <w>dronken</w> na verschillende rondes sterk bier."
                            }
