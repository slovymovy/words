                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56f880d5-4f58-4168-b746-6ee05a30346e",
                                "sense_id": "d3d07a3c-2e78-3e96-804e-5a5b24880ff4",
                                "text": "„Beim Vorschliff wird mit 80er bis maximal 120er Körnung die Holzfläche egalisiert und eben geschliffen.“"
                            },
                            {
                                "example_id": "88b6ba11-ab12-4303-abe1-5f1ee9f30898",
                                "sense_id": "d3d07a3c-2e78-3e96-804e-5a5b24880ff4",
                                "text": "„Auf der Innenseitenmitte der Holzfläche lassen sich in Höhe der Lüftungslöcher Risse und im Schloßbereich Wasserränder feststellen.“"
                            },
                            {
                                "example_id": "e58c0867-91ee-4e0e-8c35-14fc7bca9806",
                                "sense_id": "d3d07a3c-2e78-3e96-804e-5a5b24880ff4",
                                "text": "„Bei Holz, insbesondere größeren Holzflächen bietet sich dagegen ein Hochdruckreiniger an, falls das Holz nicht zu filigran ist - diesen können Sie sich übrigens auch einfach leihen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
