                        "examples": [
                            {
                                "example_id": "c271fd13-798f-48bd-9a60-415bc5a87cbc",
                                "sense_id": "07fb9072-d747-3de5-9163-e9df83e0abc9",
                                "text": "Много повозок было унесено волной, 14 человек получило поранения и один погиб."
                            }
                        ]
                    }
