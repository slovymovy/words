                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e27f7fe3-653a-3cd9-99a6-498f50cd97fe",
                                        "entry_id": "da7e06fe-926c-3c9a-961b-2622fd1db40c",
                                        "glosses": [
                                            "Pluriel de autorité."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aceb9000-cf64-4d02-ba80-6e8fc4a5c90f",
                                                "sense_id": "e27f7fe3-653a-3cd9-99a6-498f50cd97fe",
                                                "text": "Les tables de ce banquet étaient dressées au milieu de la grande place, sous des tentes, tandis que, dans la salle principale de la nouvelle mairie, une autre était servie pour les autorités."
                                            },
                                            {
                                                "example_id": "82a69253-b489-4a4d-a1b3-5cec06d2b88f",
                                                "sense_id": "e27f7fe3-653a-3cd9-99a6-498f50cd97fe",
                                                "text": "Il faut toujours essayer de « subsidiariser », c’est-à-dire de donner les compétences au plus près des besoins afin que les décisions appartiennent à des autorités locales qui connaissent les questions et non à des autorités qui n’ont fait que lire un rapport."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
