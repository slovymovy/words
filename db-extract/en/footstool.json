                                "target_senses": [
                                    {
                                        "sense_id": "c3bac8d4-3f5b-34b1-b570-a6bef5e04fc5",
                                        "entry_id": "4702d870-a37a-3e83-b777-a3b061dfed9a",
                                        "glosses": [
                                            "Schemel, der als Fußstütze dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c06c9a8-84b4-455d-93f0-078b64217d5b",
                                                "sense_id": "c3bac8d4-3f5b-34b1-b570-a6bef5e04fc5",
                                                "text": "„Ferris nahm ein paar Züge, und legte dann die Beine auf den gepolsterten Fußschemel, der zwischen ihnen stand.“"
                                            },
                                            {
                                                "example_id": "95a6ceb3-b82a-4e77-9083-fca73414367b",
                                                "sense_id": "c3bac8d4-3f5b-34b1-b570-a6bef5e04fc5",
                                                "text": "„Eine Decke war von dem Sessel geglitten, in dem Mama immer gesessen hatte, ein kleiner Fußschemel war ein Stück weit ins Zimmer geschoben worden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
