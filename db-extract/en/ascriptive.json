                        "entry_id": "c78b50b0-62fc-3c14-97a0-84a0a79dbcc7",
                        "glosses": [
                            "The act, or an instance, of ascribing a quality, characteristic, quotation, artistic work or other object to someone or something."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7f6b947-3010-4e32-bbe6-b46438a88d4c",
                                "sense_id": "43269a4f-e46d-3e05-a625-9c982a857136",
                                "text": "Herodotus uses more ascriptives than Homer, but the adverbial participle is well illustrated in Herodotus and the complementary is fairly common."
                            },
                            {
                                "example_id": "1f43cf50-26ae-40f9-8bf7-4f283c25ea77",
                                "sense_id": "43269a4f-e46d-3e05-a625-9c982a857136",
                                "text": "Ascriptives need not be novel. Tension is a conventional ascriptive that, despite its ubiquitous use, has never achieved technical status in musical discourse."
                            }
                        ]
