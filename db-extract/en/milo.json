    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "8ae6cee1-7846-3dc2-9331-26ff92c788c7",
                "word": "Milo",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ee99d426-b2de-3583-a73f-c44367c5f181",
                        "entry_id": "8ae6cee1-7846-3dc2-9331-26ff92c788c7",
                        "glosses": [
                            "A male given name from the Germanic languages."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b98a3a9-6f3c-41e0-8aa3-81246fdc784b",
                                "sense_id": "ee99d426-b2de-3583-a73f-c44367c5f181",
                                "text": "Stevie didn't care. At least he didn't have an oddball name like Milo and he never had to get up for church on Sunday."
                            },
                            {
                                "example_id": "5c5e2af5-4299-42f1-a804-e791634fd31c",
                                "sense_id": "ee99d426-b2de-3583-a73f-c44367c5f181",
                                "text": "Just one thing, if I may, Mark said. It's Miles, his name. Not Milo.\nYeah, I know, Anna's always going on about that too. But Milo's better, Milo's got something about it, hasn't it? the man said. It's catchier. It's catching on round the camp, Milo, where Miles sounds a bit, well, wet. A bit middle class, you know?"
                            },
                            {
                                "example_id": "60fc2501-8ab4-4156-9521-c9c5b468afaa",
                                "sense_id": "ee99d426-b2de-3583-a73f-c44367c5f181",
                                "text": "Back in 2011, a 9-year-old named Milo Cress found it odd that the restaurants he would go to with his mom in Burlington, Vermont, would automatically serve drinks with a straw, whether or not their customer wanted one."
                            }
                        ]
                    },
                    {
                        "sense_id": "7991991e-9180-33d6-8466-def9e0d37668",
                        "entry_id": "8ae6cee1-7846-3dc2-9331-26ff92c788c7",
                        "glosses": [
                            "An English surname originating as a patronymic transferred from the given name."
                        ],
