                    },
                    {
                        "translation_id": "b04b8d7f-6523-4e0c-a02d-8daa9aa673f4",
                        "source_entry_id": "6c80bfe3-0819-3f89-99c9-5d4291a9161f",
                        "source_sense_id": "1b2055f5-eecc-399a-999c-78d977bfb4f3",
                        "source_sense_description": "state of bondage, slavery, or subjugation to another person",
                        "target_lang_word": "Sklaverei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sklaverei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "52b2edef-2859-3df7-8356-d6b159dff0ba",
                                        "entry_id": "e9a63cfd-c448-3c35-a756-28d393d76f1f",
                                        "glosses": [
                                            "völlige rechtliche und wirtschaftliche Abhängigkeit des Sklaven als Eigentum eines Sklavenhalters"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "196c1c39-fcfe-4457-ac2d-66a7b5647003",
                                                "sense_id": "52b2edef-2859-3df7-8356-d6b159dff0ba",
                                                "text": "Offiziell ist die Sklaverei heute in allen Staaten der Welt abgeschafft. Dennoch befinden sich in vielen Ländern immer noch zu viele Menschen in einer derartigen Abhängigkeit."
                                            },
                                            {
                                                "example_id": "345ceb5a-2dea-4d98-b37f-0840b571eacd",
                                                "sense_id": "52b2edef-2859-3df7-8356-d6b159dff0ba",
                                                "text": "„Zum Glück ist da die sanfte, gebrechliche Urgroßmutter, die ihr von der Sklaverei erzählt und von den sechzehn Kindern, die sie von ihrem weißen Herrn bekommen hat.“"
                                            },
                                            {
                                                "example_id": "bfc0220c-e298-4671-a3f8-99f379ef1a23",
                                                "sense_id": "52b2edef-2859-3df7-8356-d6b159dff0ba",
                                                "text": "„Die ganze Wirtschaft, der ganze Stolz des Südens basierte auf der Sklaverei.“"
                                            },
                                            {
                                                "example_id": "f0a94ea7-51bd-46cc-adf0-2b7e342e83ec",
                                                "sense_id": "52b2edef-2859-3df7-8356-d6b159dff0ba",
                                                "text": "„Melliers erstes Argument zur Rechtfertigung der Sklaverei beruhte auf einer merkantilistischen Wirtschaftstheorie: nämlich der, dass Frankreich sich mit den anderen europäischen Ländern in einem erbitterten Wettkampf um nationalen Wohlstand und nationale Macht befand.“"
                                            },
                                            {
                                                "example_id": "e700a048-7c8e-4f62-aa22-b8951e035f5c",
                                                "sense_id": "52b2edef-2859-3df7-8356-d6b159dff0ba",
                                                "text": "„Die Gründerväter der griechischen Demokratie beispielsweise erachteten die Sklaverei als derart unabdingbar für die Gesellschaft, dass sie sich eine Gesellschaft ohne sie gar nicht vorstellen konnten.“"
                                            },
                                            {
                                                "example_id": "88b203d6-19c9-44f5-bf07-f869dd9a62a0",
                                                "sense_id": "52b2edef-2859-3df7-8356-d6b159dff0ba",
                                                "text": "„Ich habe schon an anderer Stelle über meine Einstellung zur Frage der Sklaverei Stellung genommen - und zwar sehr offen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0bbf9d9f-71b4-3ac3-b465-5855598f0cab",
                                        "entry_id": "e9a63cfd-c448-3c35-a756-28d393d76f1f",
                                        "glosses": [
                                            "schwere, mühsame, andauernde Arbeit wie die eines Sklaven"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a12ef18-028d-410e-9b07-d2382bca9739",
                                                "sense_id": "0bbf9d9f-71b4-3ac3-b465-5855598f0cab",
                                                "text": "In dem Unternehmen zu arbeiten ist die reinste Sklaverei und zahlen tun sie auch nicht besonders gut."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0a6743fb-9b7a-451a-b1fb-4606a06b748d",
                        "source_entry_id": "6c80bfe3-0819-3f89-99c9-5d4291a9161f",
                        "source_sense_id": "1b2055f5-eecc-399a-999c-78d977bfb4f3",
