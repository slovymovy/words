                "senses": [
                    {
                        "sense_id": "c23b937d-179d-377f-ac1c-4ace0e056b30",
                        "entry_id": "5d93510e-7097-376a-a72e-a6288cf290ef",
                        "glosses": [
                            "de uiterlijke begrenzing van een mens of dier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "734bffb0-b466-4303-8d1d-218d349fe116",
                                "sense_id": "c23b937d-179d-377f-ac1c-4ace0e056b30",
                                "text": "Haar gelaat en haar handen waren zwarter dan pek en toch was het eerder haar lichaamsvorm, dan haar kleur, die het lelijkst was."
                            },
                            {
                                "example_id": "ae0701b3-0ec5-4856-84df-879f6794779a",
                                "sense_id": "c23b937d-179d-377f-ac1c-4ace0e056b30",
                                "text": "En andersom: toen Majda Laboudi en haar collega's wat beter keken naar twee Noord-Afrikaanse malariamuggen-'soorten', elk herkenbaar aan gedrag en lichaamsvorm, ontdekten ze dat de twee identieke DNA-barcodes hadden en dus waarschijnlijk beide tot dezelfde soort behoorden."
                            },
                            {
                                "example_id": "30a6892c-6352-4b00-8fb2-5221123c4223",
                                "sense_id": "c23b937d-179d-377f-ac1c-4ace0e056b30",
                                "text": "Ook stopt het bedrijf met het digitaal bewerken van modellenfoto's in reclames als het gaat om huidskleur en lichaamsvorm."
                            }
                        ]
                    }
                ],
