                                                "sense_id": "0e4f073e-926e-3117-b579-1f944efcbbe6",
                                                "text": "I misplaced the software installation CD."
                                            },
                                            {
                                                "example_id": "665836a3-ee9e-4656-8deb-df8ab93ec1d2",
                                                "sense_id": "0e4f073e-926e-3117-b579-1f944efcbbe6",
                                                "text": "Called Compact Discs (CD for short) and expected to enter the market by 1983, they play an hour per side and are virtually indestructible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd0aeac2-e3ee-3773-ae78-5d1afb177166",
