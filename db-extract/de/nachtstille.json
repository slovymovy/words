                "senses": [
                    {
                        "sense_id": "06817533-7156-308c-9f51-90e16ee0b0ae",
                        "entry_id": "e4c8350b-4bd5-3b3e-841e-7a0515891a9f",
                        "glosses": [
                            "Ruhe, Stille der Nacht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb8509af-d7f8-4140-a70e-2867847d8ca5",
                                "sense_id": "06817533-7156-308c-9f51-90e16ee0b0ae",
                                "text": "„In der Ferne hört man, die Nachtstille durchreißend, das lange Pfeifen der Lokomotive.“"
                            },
                            {
                                "example_id": "624f9e49-7f0e-4ecf-b3cd-9557bca39430",
                                "sense_id": "06817533-7156-308c-9f51-90e16ee0b0ae",
                                "text": "„Das hohe Aufheulen eines Motors durchdringt die Nachtstille.“"
                            },
                            {
                                "example_id": "51b730bc-70a1-4ac5-a047-d1efa81cdfbc",
                                "sense_id": "06817533-7156-308c-9f51-90e16ee0b0ae",
                                "text": "„Am Altare der Priester hielt feierlich das Hochamt, und die Orgel erklang dazu durch die Nachtstille in süßen Tönen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
