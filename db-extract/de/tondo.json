                                        "sense_id": "a3831058-769c-34e5-b934-cf5c1fb81e76",
                                        "entry_id": "4c2df0bc-c19e-32cd-b5a0-36a6c5e3a8ff",
                                        "glosses": [
                                            "Peinture réalisée sur un support de forme ronde."
                                        ],
                                        "tags": [
                                            "Peinture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cdd75118-866b-490d-9e58-90c5362758b3",
                                                "sense_id": "a3831058-769c-34e5-b934-cf5c1fb81e76",
                                                "text": "Placé au plafond, le tondo est souvent associé aux peintures allégoriques."
                                            },
                                            {
                                                "example_id": "0576d441-5f38-492d-896f-2f3b992c5d04",
                                                "sense_id": "a3831058-769c-34e5-b934-cf5c1fb81e76",
                                                "text": "L’immense miroir et les portraits vidéo de Solo (Pascal Grandmaison, 2002), la série fétiche de moniteurs télé plongés dans des barils d’eau The Sleepers (Bill Viola, 1992) ou les immenses tondos Non-lieu (Claude Tousignant, 1971) sont parmi ceux qui ont retrouvé l’emplacement occupé lors de précédentes expos."
                                            },
                                            {
                                                "example_id": "1b71e3e6-252e-45bc-8252-efd0f4664c34",
                                                "sense_id": "a3831058-769c-34e5-b934-cf5c1fb81e76",
                                                "text": "Le tondo Doni"
                                            }
                                        ]
                                    }
                                ]
                            }
