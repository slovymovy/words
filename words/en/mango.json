{
    "word_family": [
        "mangoed",
        "mangoing"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6549dd89-ae5c-3ce4-bb9b-146e6588b2bf",
                    "sense_definition": "The oval tropical fruit of the mango tree, which has a smooth skin, sweet juicy orange-yellow flesh, and a large stone.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "fruit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I bought a ripe <w>mango</w> at the market to make a fresh fruit salad.",
                            "target_lang_translations": {
                                "ru": "Я купил спелое <w>манго</w> на рынке, чтобы приготовить свежий фруктовый салат."
                            }
                        },
                        {
                            "text": "The sweet juice of the <w>mango</w> ran down his chin as he ate it.",
                            "target_lang_translations": {
                                "ru": "Сладкий сок <w>манго</w> тек по его подбородку, пока он его ел."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ripe mango",
                        "mango juice",
                        "fresh mango"
                    ],
                    "target_lang_definitions": {
                        "ru": "Овальный тропический плод дерева манго с гладкой кожицей, сладкой сочной оранжево-желтой мякотью и крупной косточкой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "манго",
                                "target_lang_sense_clarification": "плод"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "87bb2d67-1d3d-3282-b91e-a1a8f9ec459b",
                    "sense_definition": "A tropical Asian evergreen tree (Mangifera indica) that produces the mango fruit.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "plants",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We sat in the shade of a large <w>mango</w> to escape the afternoon sun.",
                            "target_lang_translations": {
                                "ru": "Мы сидели в тени большого <w>манго</w>, чтобы укрыться от полуденного солнца."
                            }
                        },
                        {
                            "text": "The <w>mango</w> tree in our backyard is finally starting to bear fruit.",
                            "target_lang_translations": {
                                "ru": "<w>Манговое дерево</w> на нашем заднем дворе наконец-то начало плодоносить."
                            }
                        }
                    ],
                    "synonyms": [
                        "mango tree"
                    ],
                    "common_phrases": [
                        "shade of a mango",
                        "mango tree"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тропическое азиатское вечнозеленое дерево (Mangifera indica), на котором растут плоды манго."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "манго",
                                "target_lang_sense_clarification": "дерево"
                            },
                            {
                                "target_lang_word": "манговое дерево",
                                "target_lang_sense_clarification": "растение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9fee4321-c64b-32b4-bc8c-7a71fcf1e3c0",
                    "sense_definition": "A vibrant yellow-orange color, resembling the color of the flesh of a ripe mango.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "colors",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore a beautiful <w>mango</w> dress that stood out in the crowd.",
                            "target_lang_translations": {
                                "ru": "На ней было прекрасное платье цвета <w>манго</w>, которое выделялось в толпе."
                            }
                        },
                        {
                            "text": "The walls of the kitchen were painted a bright <w>mango</w> color.",
                            "target_lang_translations": {
                                "ru": "Стены кухни были выкрашены в ярко-оранжевый цвет <w>манго</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "mango yellow",
                        "bright mango"
                    ],
                    "target_lang_definitions": {
                        "ru": "Яркий желто-оранжевый цвет, напоминающий цвет мякоти спелого манго."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "манго",
                                "target_lang_sense_clarification": "цвет"
                            },
                            {
                                "target_lang_word": "цвет манго",
                                "target_lang_sense_clarification": "оттенок"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6b7d1f0b-795b-3fdf-b406-3179a7876991",
                    "sense_definition": "A green bell pepper, especially one used for pickling.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "vegetables",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In some parts of the Midwest, people still refer to a green pepper as a <w>mango</w>.",
                            "target_lang_translations": {
                                "ru": "В некоторых частях Среднего Запада люди до сих пор называют зеленый перец <w>манго</w>."
                            }
                        },
                        {
                            "text": "The recipe calls for three large <w>mangoes</w> to be stuffed with cabbage.",
                            "target_lang_translations": {
                                "ru": "По рецепту требуется три больших <w>перца</w>, которые нужно нафаршировать капустой."
                            }
                        }
                    ],
                    "synonyms": [
                        "bell pepper",
                        "green pepper"
                    ],
                    "common_phrases": [
                        "mango pepper"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Midwestern United States"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Зеленый болгарский перец, особенно используемый для маринования."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "болгарский перец",
                                "target_lang_sense_clarification": "региональное название в США"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b5c0c7c4-a279-3090-add9-472758508d4f",
                    "sense_definition": "A vegetable or fruit that has been stuffed with spices and pickled.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The traditional meal included a spicy <w>mango</w> made from a stuffed melon.",
                            "target_lang_translations": {
                                "ru": "Традиционная трапеза включала острый <w>маринад</w> из фаршированной дыни."
                            }
                        },
                        {
                            "text": "She prepared a jar of <w>mangoes</w> using green peppers and a vinegar brine.",
                            "target_lang_translations": {
                                "ru": "Она приготовила банку <w>маринованных овощей</w>, используя зеленый перец и уксусный рассол."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pickled mango"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "historical culinary term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Овощ или фрукт, начиненный специями и замаринованный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фаршированный маринад",
                                "target_lang_sense_clarification": "устаревшее кулинарное значение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3d392aaa-85d8-36ec-af43-94a39af81809",
                    "sense_definition": "Any of several species of hummingbirds belonging to the genus Anthracothorax.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "birds",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The green-throated <w>mango</w> is a beautiful bird found in South America.",
                            "target_lang_translations": {
                                "ru": "Зеленогорлый <w>манго</w> — красивая птица, обитающая в Южной Америке."
                            }
                        },
                        {
                            "text": "We spotted a rare <w>mango</w> hovering near the tropical flowers.",
                            "target_lang_translations": {
                                "ru": "Мы заметили редкого <w>манго</w>, парящего возле тропических цветов."
                            }
                        }
                    ],
                    "common_phrases": [
                        "green-throated mango"
                    ],
                    "target_lang_definitions": {
                        "ru": "Любой из нескольких видов колибри, принадлежащих к роду Anthracothorax."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "манго",
                                "target_lang_sense_clarification": "род колибри"
                            },
                            {
                                "target_lang_word": "колибри-манго",
                                "target_lang_sense_clarification": "птица"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "946328f9-3dfd-370f-8983-8e938d449992",
                    "sense_definition": "To stuff and pickle a fruit or vegetable.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "cooking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cook decided to <w>mango</w> the small melons to preserve them for winter.",
                            "target_lang_translations": {
                                "ru": "Повар решил <w>замариновать</w> маленькие дыни, чтобы сохранить их на зиму."
                            }
                        },
                        {
                            "text": "In the eighteenth century, it was common to <w>mango</w> cucumbers as a substitute for tropical fruit.",
                            "target_lang_translations": {
                                "ru": "В восемнадцатом веке было принято <w>мариновать</w> огурцы в качестве замены тропическим фруктам."
                            }
                        }
                    ],
                    "synonyms": [
                        "pickle"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical cooking technique"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фаршировать и мариновать фрукты или овощи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мариновать",
                                "target_lang_sense_clarification": "способом фарширования"
                            }
                        ]
                    }
                }
            ]
        },
        {
