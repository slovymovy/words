                "senses": [
                    {
                        "sense_id": "ab931e82-f429-3288-9c0b-391f2f477765",
                        "entry_id": "ac0d77c1-ca70-39a8-b9df-411456160e9b",
                        "glosses": [
                            "действие по значению гл. выдворять, выдворить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6361e87d-47f1-4e03-ab92-77b67911cdfb",
                                "sense_id": "ab931e82-f429-3288-9c0b-391f2f477765",
                                "text": "Было объявлено, что все граждане, временно находящиеся в Москве, обязаны в трёхдневный срок пройти перерегистрацию, в противном случае они будут привлечены к ответственности вплоть до принудительного выдворения из города."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "84ad3354-bdbb-42aa-8bb5-5d0bde0fae45",
                        "source_entry_id": "ac0d77c1-ca70-39a8-b9df-411456160e9b",
                        "source_sense_id": "ab931e82-f429-3288-9c0b-391f2f477765",
                        "target_lang_word": "expulsion",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "expulsion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ad1af0a3-e8b3-3ca5-ab97-f9256822fd76",
                                        "entry_id": "3861bdb3-fe62-3fbb-b086-a85d67caefab",
                                        "glosses": [
                                            "Action d’expulser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2ee60b8-337b-4961-9ac8-01676a75ea73",
                                                "sense_id": "ad1af0a3-e8b3-3ca5-ab97-f9256822fd76",
                                                "text": "La mine calcareuse a, en outre, l’inconvénient de rendre le premier laitier ferreux, apte à mazer la fonte et à rendre son expulsion du creuset difficile."
                                            },
                                            {
                                                "example_id": "061dba62-4a0a-495b-905c-4c1ff3904ee9",
                                                "sense_id": "ad1af0a3-e8b3-3ca5-ab97-f9256822fd76",
                                                "text": "Procéder à l’expulsion d’un locataire, d’un fermier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2876034b-77c1-336c-a47c-dfe18ecb434b",
                                        "entry_id": "3861bdb3-fe62-3fbb-b086-a85d67caefab",
                                        "glosses": [
                                            "Action d’expulser.",
                                            "Action d’évacuer hors du corps, évacuation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b6d187c-fe23-430b-a53f-31e02d38cba9",
                                                "sense_id": "2876034b-77c1-336c-a47c-dfe18ecb434b",
                                                "text": "L’expulsion d’un calcul hors de la vessie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e148350-2bbb-36ef-920a-7b1466909597",
                                        "entry_id": "3861bdb3-fe62-3fbb-b086-a85d67caefab",
                                        "glosses": [
                                            "Action d’expulser hors d'un pays ; déportation."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f18fd3e-8066-4e15-9a34-e3d4cadb228b",
                                                "sense_id": "0e148350-2bbb-36ef-920a-7b1466909597",
                                                "text": "Si des étrangers sont punis de l’expulsion judiciaire exécutoire après subissement de la peine privative de liberté, il ne reste pas de place pour la libération conditionnelle avec patronage; […]."
                                            },
                                            {
                                                "example_id": "eedc5e6f-019c-470e-87bc-8a0aa8799b23",
                                                "sense_id": "0e148350-2bbb-36ef-920a-7b1466909597",
                                                "text": "le ministre de l’Immigration et de l’Identité nationale a officiellement admis qu’il n’atteindrait pas l’objectif de 25 000 expulsions qui lui avait été fixé par Nicolas Sarkozy dans sa lettre de mission."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
