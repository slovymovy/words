                        "sense_id": "358a4b91-2e4a-3e48-99ce-e546544d4647",
                        "entry_id": "c61d5f75-a1a3-309a-ab23-a63edd5f4046",
                        "glosses": [
                            "Eigenschaft, gerne und viel zu reden, zu sprechen"
