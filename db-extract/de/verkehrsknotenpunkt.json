                    }
                ],
                "senses": [
                    {
                        "sense_id": "768e3ffc-971b-3082-86cc-42a2848afc2f",
                        "entry_id": "a8266e95-2c4a-36b8-ad00-f038438574bc",
                        "glosses": [
                            "eine Region, in der sich Verkehrswege oder Verkehrslinien (meist verschiedener Verkehrsmittel) kreuzen; ein Umsteigeort zwischen den verschiedenen Verkehrsmitteln"
                        ],
                        "tags": [
                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "4270f0b8-e633-44a9-adb2-68ee9878f320",
                                "sense_id": "768e3ffc-971b-3082-86cc-42a2848afc2f",
                                "text": "Frankfurt am Main ist ein bedeutsamer Verkehrsknotenpunkt."
                            },
                            {
                                "example_id": "b02b729a-cac5-4cc0-9e97-df585b6a8541",
                                "sense_id": "768e3ffc-971b-3082-86cc-42a2848afc2f",
                                "text": "„Koblenz blieb somit weitgehend beschränkt auf seine Funktion als Standort der Verwaltung und des Militärs, als Verkehrsknotenpunkt und Handelszentrum sowie als Versorgungsmittelpunkt für das ländliche Umland.“"
                            },
                            {
                                "example_id": "7aa51090-c4e5-49cf-a97d-6436a0d59671",
                                "sense_id": "768e3ffc-971b-3082-86cc-42a2848afc2f",
                                "text": "„Koblenz ist ein Verkehrsknotenpunkt.“"
                            },
                            {
                                "example_id": "c044691c-efe0-4fa1-8a67-6174280472a6",
                                "sense_id": "768e3ffc-971b-3082-86cc-42a2848afc2f",
                                "text": "„Kriegswichtige Industrien auszuschalten und Verkehrsknotenpunkte lahm zu legen, ist eines, Wohnviertel in Trümmergräber zu verwandeln, etwas anderes: reiner Terror.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
