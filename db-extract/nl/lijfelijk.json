                "senses": [
                    {
                        "sense_id": "84a7126f-28be-348c-ba25-bc038fa0fe23",
                        "entry_id": "b60641ab-e8b2-3c35-96b3-5f8c3eca1066",
                        "glosses": [
                            "het lichaam betreffende"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1f577ab-9a77-4a6b-a498-dfa15fa95cd8",
                                "sense_id": "84a7126f-28be-348c-ba25-bc038fa0fe23",
                                "text": "Depressie bij reuma heeft lijfelijke oorzaak"
                            },
                            {
                                "example_id": "8955447b-1019-4626-be7c-fb7472834055",
                                "sense_id": "84a7126f-28be-348c-ba25-bc038fa0fe23",
                                "text": "Het is een ode aan de liefde, en aan de ontdekking van de lijfelijke liefde - wat toch één van de meest fantastische zaken is die je kunt meemaken in het leven. Als tiener heb je daar allerhande voorstellingen over en verwachtingen bij, en als het dan zover is, doe je het in het geniep. Je ouders mogen er niets van weten, wat het gevoel geeft dat je de grootste misdaad denkbaar pleegt.'"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5614d4ae-397c-4f5e-a471-33b7607853fb",
                        "source_entry_id": "b60641ab-e8b2-3c35-96b3-5f8c3eca1066",
                        "source_sense_id": "84a7126f-28be-348c-ba25-bc038fa0fe23",
                        "target_lang_word": "physical",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "physical",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "71637f95-ac16-3f0a-81cf-1137798325fc",
                                        "entry_id": "70e691f3-6e8c-31ae-be8b-fb8e9b355754",
                                        "glosses": [
                                            "Of medicine.",
                                            "Pertaining to the field of medicine; medical."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "40c7045b-7be8-3de7-81a0-644767a2ec9b",
                                        "entry_id": "70e691f3-6e8c-31ae-be8b-fb8e9b355754",
                                        "glosses": [
                                            "Of medicine.",
                                            "That practises medicine; pertaining to doctors, physicianly."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5e9d6ab-7efd-4d82-abc2-b4c811fc786c",
                                                "sense_id": "40c7045b-7be8-3de7-81a0-644767a2ec9b",
                                                "text": "Her father was thrown from his horse, when his blood was in a very inflammatory state, and the bruises were very dangerous; his recovery was not expected by the physical tribe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb7589f7-2652-38af-983f-e0a223442156",
                                        "entry_id": "70e691f3-6e8c-31ae-be8b-fb8e9b355754",
                                        "glosses": [
                                            "Of medicine.",
                                            "Medicinal; good for the health, curative, therapeutic."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b953e7e6-722b-44db-b4ac-72702a21ba0f",
                                                "sense_id": "cb7589f7-2652-38af-983f-e0a223442156",
                                                "text": "Phisicall [translating φαρμακώδεις (pharmakṓdeis)] herbes, as Helleborum, Lingewort, or Beares foote."
                                            },
                                            {
                                                "example_id": "3df833c3-3664-4282-a08b-d2c2fbabbe80",
                                                "sense_id": "cb7589f7-2652-38af-983f-e0a223442156",
                                                "text": "Is Brutus sick? and is it physical / To walk unbraced, and suck up the humours / Of the dank morning?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16798d3c-4bd2-304f-8675-0818e9800068",
                                        "entry_id": "70e691f3-6e8c-31ae-be8b-fb8e9b355754",
                                        "glosses": [
                                            "Of matter and nature.",
                                            "Pertaining to the world as understood through the senses rather than the mind; tangible, concrete; real. Having to do with the material world."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f466db67-f4ce-4b54-b9a6-e53efa7a8eda",
                                                "sense_id": "16798d3c-4bd2-304f-8675-0818e9800068",
                                                "text": "Labour, then, in the physical world, is […] employed in putting objects in motion."
                                            },
                                            {
                                                "example_id": "67fffdad-013b-4eb6-b4fe-c8df6bd99444",
                                                "sense_id": "16798d3c-4bd2-304f-8675-0818e9800068",
                                                "text": "In America alone, people spent $170 billion on “direct marketing”—junk mail of both the physical and electronic varieties—last year. Yet of those who received unsolicited adverts through the post, only 3% bought anything as a result."
                                            },
                                            {
                                                "example_id": "2363c448-6762-4915-a3d0-475c05f91eef",
                                                "sense_id": "16798d3c-4bd2-304f-8675-0818e9800068",
                                                "text": "It's not so much a physical place as a state of mind."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d99235e3-1679-3726-9b6c-862d4b910745",
                                        "entry_id": "70e691f3-6e8c-31ae-be8b-fb8e9b355754",
                                        "glosses": [
                                            "Of matter and nature.",
                                            "In accordance with the laws of nature; now specifically, pertaining to physics."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1dd354ab-e2c6-47ca-bb3a-080d01c26f6c",
                                                "sense_id": "d99235e3-1679-3726-9b6c-862d4b910745",
                                                "text": "The substance has a number of interesting physical properties."
                                            },
                                            {
                                                "example_id": "1c6c5d0f-8bc9-4348-bc1c-b47d56ad0ffe",
                                                "sense_id": "d99235e3-1679-3726-9b6c-862d4b910745",
                                                "text": "Some of the most beautiful and thus appealing physical theories, including quantum electrodynamics and quantum gravity, have been dogged for decades by infinities that erupt when theorists try to prod their calculations into new domains."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d1b1198-d5c5-345f-ae44-9ca7f7ac3d96",
                                        "entry_id": "70e691f3-6e8c-31ae-be8b-fb8e9b355754",
                                        "glosses": [
                                            "Of matter and nature.",
                                            "Denoting a map showing natural features of the landscape (compare political)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "88e0d1c0-434a-397f-8d82-8d7d90afdd79",
                                        "entry_id": "70e691f3-6e8c-31ae-be8b-fb8e9b355754",
                                        "glosses": [
                                            "Of the human body.",
                                            "Having to do with the body as opposed to the mind; corporeal, bodily."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30004066-cb8b-49b8-ba30-e1099abe514a",
                                                "sense_id": "88e0d1c0-434a-397f-8d82-8d7d90afdd79",
                                                "text": "Are you feeling any physical effects?"
                                            },
                                            {
                                                "example_id": "4af4656d-0192-4104-bb45-79303d894dcb",
                                                "sense_id": "88e0d1c0-434a-397f-8d82-8d7d90afdd79",
                                                "text": "A society sunk in ignorance, and ruled by mere physical force."
                                            },
                                            {
                                                "example_id": "53d15be2-8fdf-4f25-9062-4b628a5b14f6",
                                                "sense_id": "88e0d1c0-434a-397f-8d82-8d7d90afdd79",
                                                "text": "In mild cases of hypergonadism prior to puberty, the onset of physical and mood changes may not be abnormally early or significant enough to cause any psychological or long-term physical complications."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6590cf77-534e-3a25-ad15-983a0220f396",
                                        "entry_id": "70e691f3-6e8c-31ae-be8b-fb8e9b355754",
                                        "glosses": [
                                            "Of the human body.",
                                            "Sexual, carnal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4f49fcb-cbac-45cb-8329-8a55cf50bfd0",
                                                "sense_id": "6590cf77-534e-3a25-ad15-983a0220f396",
                                                "text": "to get physical"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aba997c0-db83-315f-a51e-861cd6f72525",
                                        "entry_id": "70e691f3-6e8c-31ae-be8b-fb8e9b355754",
                                        "glosses": [
                                            "Of the human body.",
                                            "Involving bodily force or contact; vigorous, aggressive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db07a3fd-99d6-4ddf-ae38-8609eaf9abe5",
                                                "sense_id": "aba997c0-db83-315f-a51e-861cd6f72525",
                                                "text": "This team plays a very physical game, so watch out."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "physical",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "15687f3c-21ae-3c0d-8bcc-e9b09f150dc2",
                                        "entry_id": "145e7a99-65b3-38d9-ab03-98692922b125",
                                        "glosses": [
                                            "A physical examination."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19309a69-6395-4a1d-b696-eadc30096123",
                                                "sense_id": "15687f3c-21ae-3c0d-8bcc-e9b09f150dc2",
                                                "text": "How long has it been since your last physical?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "556c1eec-bb43-36a3-b961-03cb283aa92e",
                                        "entry_id": "145e7a99-65b3-38d9-ab03-98692922b125",
                                        "glosses": [
                                            "A physical manifestation of psychic origin, as through ectoplasmic solidification."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffd11a79-cabb-4329-8bda-2e1632c71913",
                                                "sense_id": "556c1eec-bb43-36a3-b961-03cb283aa92e",
                                                "text": "\"I don't mind readings and clairvoyance, but the physicals do try you.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
