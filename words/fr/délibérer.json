    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ce118a73-f8d6-3be0-8032-f8db15f4eb22",
                    "sense_definition": "Discuter et examiner collectivement une question au sein d'une assemblée, d'un jury ou d'un tribunal avant de prendre une décision.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "examen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après plusieurs heures de débats intenses, les membres du jury se réunissent pour <w>délibérer</w> en secret."
                        },
                        {
                            "text": "Le conseil municipal <w>délibère</w> actuellement sur le budget alloué aux nouvelles écoles de la ville."
                        }
                    ],
                    "synonyms": [
                        "débattre",
                        "se concerter",
                        "discuter"
                    ],
                    "common_phrases": [
                        "délibérer en assemblée",
                        "se retirer pour délibérer"
                    ]
                },
                {
                    "sense_id": "709bd334-e999-3738-a549-8ee468d8a272",
                    "sense_definition": "Réfléchir attentivement et peser le pour et le contre en soi-même avant de faire un choix.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "examen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a longuement <w>délibéré</w> avec lui-même avant d'accepter cette proposition d'emploi à l'étranger."
                        },
                        {
                            "text": "Elle préfère mûrement <w>délibérer</w> avant de s'engager dans un projet aussi complexe."
                        }
                    ],
                    "synonyms": [
                        "méditer",
                        "peser",
                        "réfléchir"
                    ],
                    "common_phrases": [
                        "mûrement délibérer",
                        "délibérer en soi-même"
                    ]
                },
                {
                    "sense_id": "7a4e8fb4-32c7-320a-8515-f18bccba3cf7",
                    "sense_definition": "Prendre une résolution, décider une action après un examen approfondi ou une consultation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "decision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Face à cette crise inattendue, le comité a <w>délibéré</w> d'interrompre provisoirement tous les travaux en cours."
                        },
                        {
                            "text": "Les associés ont finalement <w>délibéré</w> de vendre l'entreprise afin d'éviter la faillite."
                        }
                    ],
                    "synonyms": [
                        "arrêter",
                        "décider",
                        "résoudre"
                    ],
                    "common_phrases": [
                        "délibérer de faire"
                    ]
                }
            ]
        }
    ]
}