                "senses": [
                    {
                        "sense_id": "7ce23ca1-cdd0-3b8f-bd74-8a67336a62a7",
                        "entry_id": "daf666a1-9964-3ad0-ac4b-2ef9c591e9dc",
                        "glosses": [
                            "Eau de pluie, eau pluviale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a7f10e6-9568-4578-b9be-215eb5ab0c86",
                                "sense_id": "7ce23ca1-cdd0-3b8f-bd74-8a67336a62a7",
                                "text": "Regenwasser kann in meist unterirdischen Zisternen aufgefangen und als Brauch- oder Nutzwasser verwendet werden.",
                                "translation": "L'eau de pluie peut être recueillie dans des citernes le plus souvent souterraines et utilisée comme eau de service ou industrielle."
                            },
                            {
                                "example_id": "a51bc28b-f0ec-4f7e-9ace-7577a13bb084",
                                "sense_id": "7ce23ca1-cdd0-3b8f-bd74-8a67336a62a7",
                                "text": "Wenn das Erdreich zu stark verdichtet ist, dann kann das Regenwasser nicht versickern und fließt an der Oberfläche ab.",
                                "translation": "Si le sol est trop compacté, l’eau de pluie ne peut pas s’infiltrer et s’écoule à la surface."
                            }
                        ]
                    }
                ],
