                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a2f7b65-bda9-40ab-80f2-111f6fed785f",
                                                "sense_id": "920157cd-3665-34b8-aca3-e5f45e75bb39",
                                                "text": "Het geweldloze verzet van de demonstranten veroorzaakte een zeer geweldadige reactie van de politie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4e0632a-9f22-36ee-8e93-b451fcb77855",
                                        "entry_id": "65aa24a2-955f-3ffa-a3f8-137211d9e34c",
