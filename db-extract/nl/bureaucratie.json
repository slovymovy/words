        "nl-extract.jsonl": [
            {
                "entry_id": "08211c91-8b51-3c9a-86a3-6f14d1b32b30",
                "word": "bureaucratie",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "3e4dc911-ea44-4808-8bb4-b7058b4c0265",
                        "entry_id": "08211c91-8b51-3c9a-86a3-6f14d1b32b30",
                        "tags": [
                            "plural"
                        ],
                        "form": "bureaucratieën"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cc3bda1c-42a7-3bdd-b318-c2f681c99efd",
                        "entry_id": "08211c91-8b51-3c9a-86a3-6f14d1b32b30",
                        "glosses": [
                            "is een organisatiestructuur die gekenmerkt wordt door aan regels onderheven procedures, verdeling van verantwoordelijkheid, hiërarchie en onpersoonlijke relaties"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8f98dd0-f071-4e17-b87f-71117b5965e2",
                                "sense_id": "cc3bda1c-42a7-3bdd-b318-c2f681c99efd",
                                "text": "Een efficiënt en eerlijk werkende bureaucratie is een van de belangrijkste voorwaarden voor sociaal-economische ontwikkeling."
                            }
                        ]
                    },
                    {
                        "sense_id": "5a7042a3-bf05-3cdf-bad8-2954ecebd0e2",
                        "entry_id": "08211c91-8b51-3c9a-86a3-6f14d1b32b30",
                        "glosses": [
                            "een ten gevolge van starre procedures, overmatig gebruik van formulieren en formaliteiten, zeer inefficiënte organisatie; terreur van de ambtenaren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd6c25e4-2099-44d8-b0ee-2d2f93d3d4cc",
                                "sense_id": "5a7042a3-bf05-3cdf-bad8-2954ecebd0e2",
                                "text": "De grootste zorgen zijn voor bijna al mijn ondervraagden dezelfde. Immigratie, veiligheid, bureaucratie, overmatige regelgeving en het gevoel te moeten doen wat ongekozen ambtenaren zeggen. De dagelijkse contributie van 53 miljoen pond, de zakkenvullerij, de druk op de lonen en het gebrek aan transparantie. Reëel of ingebeeld, dit zijn de zorgen die de kiezers bezighouden."
                            },
                            {
                                "example_id": "fbe11f77-b622-4095-8895-e6356b4ca571",
                                "sense_id": "5a7042a3-bf05-3cdf-bad8-2954ecebd0e2",
                                "text": "Ze waren tegen een muur van bureaucratie opgelopen waarvan deze arts slechts een voorpost was."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "272ba192-6872-4a79-94f6-e0d7ec663bc5",
                        "source_entry_id": "08211c91-8b51-3c9a-86a3-6f14d1b32b30",
                        "target_lang_word": "Bürokratie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bürokratie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0d23071f-744e-36b4-8a4e-b0bad7a9c14d",
                                        "entry_id": "ea2d4ed1-d233-3af8-bf97-d943ac73a8a9",
                                        "glosses": [
                                            "bürokratisches (sich sehr streng an die [amtlichen] Vorschriften haltendes) Handeln"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88a7a965-82e4-4eb3-bda3-b199bc5983e8",
                                                "sense_id": "0d23071f-744e-36b4-8a4e-b0bad7a9c14d",
                                                "text": "„Bundeskanzlerin Angela Merkel hat die Eröffnungsrede beim Weltwirtschaftsforum in Davos für ein Plädoyer gegen Bürokratie und für mehr Freiheit genutzt.“ (www.spiegel.de)"
                                            },
                                            {
                                                "example_id": "b945c067-25fe-46cf-8f7f-49798ae45d72",
                                                "sense_id": "0d23071f-744e-36b4-8a4e-b0bad7a9c14d",
                                                "text": "„Die Freiheitsliebe beschränkt sich in Deutschland häufig auf die Klage über zu viel Bürokratie, doch sobald etwas im Fleisch oder Frühstücksei auftaucht, was dort nicht hingehört, ergeht der Ruf nach strikteren Kontrollen und Vorschriften.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a9996da8-28b2-35c5-ad9c-42f4329d91fa",
                                        "entry_id": "ea2d4ed1-d233-3af8-bf97-d943ac73a8a9",
                                        "glosses": [
                                            "Verwaltungsapparat, Gesamtheit der Beamten"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96423dc0-b5d4-4861-9ac1-0884d82ae5b3",
                                                "sense_id": "a9996da8-28b2-35c5-ad9c-42f4329d91fa",
                                                "text": "„Der kaiserliche Hof, die umfangreiche Bürokratie und das Heer verzehrten fast die Gesamtheit der in den Städten und auf dem Lande über die Subsistenz hinaus erwirtschafteten Überschüsse.“"
                                            },
                                            {
                                                "example_id": "9d4de617-4b8a-40e9-af22-9b8e6fab87d0",
                                                "sense_id": "a9996da8-28b2-35c5-ad9c-42f4329d91fa",
                                                "text": "„Doch viele Studien beklagen die ineffiziente Bürokratie, die hohe Steuerlast und den Zickzackkurs der Regierung.“"
                                            },
                                            {
                                                "example_id": "b0a6032a-6fb7-4034-9db6-05545af67f51",
                                                "sense_id": "a9996da8-28b2-35c5-ad9c-42f4329d91fa",
                                                "text": "„Sie lernten die äthiopische Bürokratie von einer Seite kennen, die selbst Kafka für übertrieben gehalten hätte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b49c7623-dbf7-3943-aa79-e9af318c9858",
                                        "entry_id": "ea2d4ed1-d233-3af8-bf97-d943ac73a8a9",
                                        "glosses": [
                                            "eine Herrschaftsform, in der Beamten die Herrschaft ausüben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b5f67df-6051-4f40-8baf-244e5006abdb",
                                                "sense_id": "b49c7623-dbf7-3943-aa79-e9af318c9858",
                                                "text": "„Die Deutschen meckern gern über ihre Bürokratie, aber sie ist nicht übermäßig korrupt, politisiert oder ineffizient.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4d01311c-80e5-4c33-835b-5e057a4e9dc2",
                        "source_entry_id": "08211c91-8b51-3c9a-86a3-6f14d1b32b30",
                        "target_lang_word": "bureaucracy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bureaucracy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "651b726f-6cab-3cf3-8971-e3e62cbcc516",
                                        "entry_id": "d18b20db-a8b2-3dd4-9c7a-c306f3543fa3",
                                        "glosses": [
                                            "Government by bureaus or their administrators or officers."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a780d77-a33b-418e-8a84-fe085234ed0f",
                                                "sense_id": "651b726f-6cab-3cf3-8971-e3e62cbcc516",
                                                "text": "However, when Britain left the European Union, ferries started to ply a direct sea link from Ireland, to save hauliers from custom's bureaucracy of driving via Britain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4bff55c5-ed33-3863-ab79-a92424f708da",
                                        "entry_id": "d18b20db-a8b2-3dd4-9c7a-c306f3543fa3",
                                        "glosses": [
                                            "A system of administration based upon organisation into bureaus, division of labour, a hierarchy of authority, etc., designed to dispose of a large body of work in a routine manner."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e789ef0-85d1-4a15-b113-25a669e1bb56",
                                                "sense_id": "4bff55c5-ed33-3863-ab79-a92424f708da",
                                                "text": "At that time the administration replaced the system of patronage in the civil service with a bureaucracy."
                                            },
                                            {
                                                "example_id": "38f74b51-9672-48cb-be09-c04e43836094",
                                                "sense_id": "4bff55c5-ed33-3863-ab79-a92424f708da",
                                                "text": "Each of the most provocative selections is facing criticism that they lack the expertise and experience to run the vast, specialized bureaucracies that would be under their control."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d97e8614-8d64-3ea9-bd22-41acdba6a90e",
                                        "entry_id": "d18b20db-a8b2-3dd4-9c7a-c306f3543fa3",
                                        "glosses": [
                                            "The body of officers and administrators, especially of a government."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad279b48-ea92-44e6-ad8d-a9c3223d59c4",
                                                "sense_id": "d97e8614-8d64-3ea9-bd22-41acdba6a90e",
                                                "text": "The bureaucracy is expanding to meet the needs of the expanding bureaucracy. (apocryphal quip)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3334cd00-d7e0-3a13-9cc6-248068ae87f0",
                                        "entry_id": "d18b20db-a8b2-3dd4-9c7a-c306f3543fa3",
                                        "glosses": [
                                            "Excessive red tape and routine in any administration, body or behaviour."
                                        ],
                                        "tags": [
                                            "countable",
                                            "derogatory",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f74930f-7d91-4968-b671-d4383e80c50d",
                                                "sense_id": "3334cd00-d7e0-3a13-9cc6-248068ae87f0",
                                                "text": "The head of the civil service promised to clamp down on bureaucracy."
                                            },
                                            {
                                                "example_id": "ca6d945f-9395-44db-ac41-f097a9e95fcd",
                                                "sense_id": "3334cd00-d7e0-3a13-9cc6-248068ae87f0",
                                                "text": "\"If we can capture anything from this awful situation, it is that ability to trust people to do certain things for themselves and to look out for each other, and to give them the tools to do their job as well as they can without having to go through endless bureaucracy to achieve it, which very often just delays and dilutes and doesn't add much value."
                                            },
                                            {
                                                "example_id": "38dcb402-959d-4adc-bdea-c3bc26c62231",
                                                "sense_id": "3334cd00-d7e0-3a13-9cc6-248068ae87f0",
                                                "text": "“If you have rule of the bureaucrat — if the bureaucracy is in charge, then what meaning does democracy actually have?” Musk said during his 30-minute appearance with Trump, where he rebuffed critics who said he’s the one undermining democratic institutions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f4b9374e-1eb8-4360-bf49-43062fd4fe7f",
                        "source_entry_id": "08211c91-8b51-3c9a-86a3-6f14d1b32b30",
                        "target_lang_word": "bureaucratie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bureaucratie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1250b5b7-6fce-387d-bd20-d5685f647ba7",
                                        "entry_id": "3e24ae2c-6ce3-3643-8f71-5a949f66e821",
                                        "glosses": [
                                            "Autorité, pouvoir diffus qui se caractérise par des règles procédurières strictes, la division des responsabilités, une forte hiérarchie et des relations impersonnelles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e3fc613-76be-42b6-a93b-06211550e03c",
                                                "sense_id": "1250b5b7-6fce-387d-bd20-d5685f647ba7",
                                                "text": "[…] Tarbouriech a même étudié des modèles de paperasses à recommander à la bureaucratie future."
                                            },
                                            {
                                                "example_id": "22b6f8fd-4084-42be-a8d8-46ebc5c9d771",
                                                "sense_id": "1250b5b7-6fce-387d-bd20-d5685f647ba7",
                                                "text": "Le « pas de zèle » de M. de Talleyrand fait partie du vocabulaire de la haute bureaucratie française."
                                            },
                                            {
                                                "example_id": "ebb200b6-f46f-4a8f-a719-b86407c95008",
                                                "sense_id": "1250b5b7-6fce-387d-bd20-d5685f647ba7",
                                                "text": "Une bureaucratie manie beaucoup de petits papiers, éventuellement des armes. Elle est surtout un groupe d'hommes hiérarchiquement organisés. C'est à l'équilibre psychique des hommes qui composent cette machine centrale qu'on doit s'intéresser."
                                            },
                                            {
                                                "example_id": "64278b54-5ee7-4f50-a3ef-a55f01a31cc4",
                                                "sense_id": "1250b5b7-6fce-387d-bd20-d5685f647ba7",
                                                "text": "« Vous ne vivez pas en démocratie, vous vivez en bureaucratie », jette-t-il à ses électeurs étonnés."
                                            },
                                            {
                                                "example_id": "ba989285-101b-4c9d-bc4c-569d7ed3d96a",
                                                "sense_id": "1250b5b7-6fce-387d-bd20-d5685f647ba7",
                                                "text": "Bureaucratie\n La bureaucratie déshumanise. Elle gomme toute notion du bien et du mal, toute moralité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d80f3d5-5e4a-368b-a6ce-01bac95732dd",
                                        "entry_id": "3e24ae2c-6ce3-3643-8f71-5a949f66e821",
                                        "glosses": [
                                            "Caste administrative politique qui accapare le pouvoir et les richesses."
                                        ],
                                        "tags": [
                                            "especially",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12546956-b5c1-409d-9e8a-ffa268ad3751",
                                                "sense_id": "2d80f3d5-5e4a-368b-a6ce-01bac95732dd",
                                                "text": "La dictature stalinienne apparait comme un régime politique bonapartiste dont la fonction consiste à défendre les privilèges de la bureaucratie dans le cadre des rapports de production donnés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ecb44185-ff3e-3d95-ac61-712b5b1db596",
                                        "entry_id": "3e24ae2c-6ce3-3643-8f71-5a949f66e821",
                                        "glosses": [
                                            "Paperasserie."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c41b855-8101-4f84-8744-eecdfce5de6a",
                                                "sense_id": "ecb44185-ff3e-3d95-ac61-712b5b1db596",
                                                "text": "Il a créé dans la cellule une bureaucratie impossible, avec tout un système de plans minutés qui changent tout le temps, qu’on suit ou qu’on ne suit pas, mais il leur fait croire que c’est cela, le génie de l'organisation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47086d44-272e-39df-a748-fcbc62d1754e",
                                        "entry_id": "3e24ae2c-6ce3-3643-8f71-5a949f66e821",
                                        "glosses": [
                                            "Administration, condition, occupation d’employé de bureau."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f34f76a-f3fc-4eaf-8bf2-1c3e53ad79fd",
                                                "sense_id": "47086d44-272e-39df-a748-fcbc62d1754e",
                                                "text": "[…] son père, né en 1811, tombé à la bureaucratie, petit employé médiocre, percepteur au Chêne-Populeux, où il s’était usé […]"
                                            },
                                            {
                                                "example_id": "9d5b5dc6-3f67-4a2c-88bb-2349a8034475",
                                                "sense_id": "47086d44-272e-39df-a748-fcbc62d1754e",
                                                "text": "Je parlais de Bour, mon vieux : il m'a révélé très clairement toute sa position; il n’a rien et rien à attendre. À part une vie odieuse à recommencer dans les bureaucraties, nous ne voyons d’autre sort que le mariage, qui pourrait l’en tirer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
