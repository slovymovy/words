                            "искусственное разведение лесов"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "7a3ef24b-e9c4-3183-ad3d-170fbb889509",
                        "entry_id": "c7d0fdbd-04f7-3127-9eb2-5c7fce6d0a7a",
