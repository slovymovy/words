            {
                "entry_id": "6c5d4074-4558-3856-8511-0ea69832c927",
                "word": "ne",
                "pos": "particle",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b0eae9cc-5895-37a3-bbdb-a806950b5898",
                        "entry_id": "6c5d4074-4558-3856-8511-0ea69832c927",
                        "glosses": [
                            "not (used alone to negate a verb, now chiefly with only a few particular verbs: see usage notes)"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "7a5248cd-4425-4694-9ec6-9854d4547fbc",
                                "sense_id": "b0eae9cc-5895-37a3-bbdb-a806950b5898",
                                "text": "Je ne sais si je dois vous appeler Monsieur ou Mademoiselle […].",
                                "translation": "I don't know if I should call you Mr or Miss.",
                                "english": "I don't know if I should call you Mr or Miss."
                            },
                            {
                                "example_id": "ee54a9ce-f09c-46b2-8328-89c4985095ac",
                                "sense_id": "b0eae9cc-5895-37a3-bbdb-a806950b5898",
                                "text": "Le prince de France nous aime, celui d'Espagne ne cesse de nous secourir.",
                                "translation": "The prince of France loves us, that of Spain never stops helping us.",
                                "english": "The prince of France loves us, that of Spain never stops helping us."
                            },
                            {
                                "example_id": "dd276080-1a59-465e-abfc-add4f9dd0f73",
                                "sense_id": "b0eae9cc-5895-37a3-bbdb-a806950b5898",
                                "text": "Je n'ose te jurer que je t'aime toujours, parce que je sens bien que tu ne me croirais pas.",
                                "translation": "I dare not swear that I still love you, for I sense that you would not believe me.",
                                "english": "I dare not swear that I still love you, for I sense that you would not believe me."
                            },
                            {
                                "example_id": "70d388c0-1c4c-4d2c-bc57-19de9bea0f0e",
                                "sense_id": "b0eae9cc-5895-37a3-bbdb-a806950b5898",
                                "text": "Mais je ne le crois pas : un homme qui trouve naturel de dénoncer des hommes ne peut avoir notre conception de l'humain […].",
                                "translation": "But I don't think so: a man who finds it natural to denounce men cannot have our idea of being human.",
                                "english": "But I don't think so: a man who finds it natural to denounce men cannot have our idea of being human."
                            },
                            {
                                "example_id": "ac297fff-003e-4f24-8695-3d33852a4721",
                                "sense_id": "b0eae9cc-5895-37a3-bbdb-a806950b5898",
                                "text": "L'amour s'en va, et le tien ne saurait durer.",
                                "translation": "Love goes away, and yours will not be able to last.",
                                "english": "Love goes away, and yours will not be able to last."
                            }
                        ]
                    },
                    {
                        "sense_id": "27a84a51-fc9a-35f8-a576-ab22e3467d21",
                        "entry_id": "6c5d4074-4558-3856-8511-0ea69832c927",
                        "glosses": [
                            "not, no (used before a verb, with a coordinating negative element usually following; see Usage Notes, below)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ddd6a1c-fd52-46a9-af26-78d00ec15b7f",
                                "sense_id": "27a84a51-fc9a-35f8-a576-ab22e3467d21",
                                "text": "Je ne sais rien de plus odieux que l'hypocrisie.",
                                "translation": "I don't know anything more odious than hypocrisy.",
                                "english": "I don't know anything more odious than hypocrisy."
                            },
                            {
                                "example_id": "ec0b4f8f-1c8d-4db7-8333-b462795c9f17",
                                "sense_id": "27a84a51-fc9a-35f8-a576-ab22e3467d21",
                                "text": "Bruno se rendit compte qu'il ne serait jamais accepté par les hippies […].",
                                "translation": "Bruno realised that he'd never be accepted by the hippies.",
                                "english": "Bruno realised that he'd never be accepted by the hippies."
                            },
                            {
                                "example_id": "ac05f519-8ed7-42d9-b799-bed240117f71",
                                "sense_id": "27a84a51-fc9a-35f8-a576-ab22e3467d21",
                                "text": "\"Il n'y a pas eu un truc auquel on ne s'attendait pas\", affirme Stéphane Le Foll.",
                                "translation": "\"There wasn't anything we weren't expecting,\" stated Stéphane Le Foll.",
                                "english": "\"There wasn't anything we weren't expecting,\" stated Stéphane Le Foll."
                            }
                        ]
                    },
                    {
                        "sense_id": "eebefe04-5ded-3675-95f6-f00c6f2593a5",
                        "entry_id": "6c5d4074-4558-3856-8511-0ea69832c927",
                        "glosses": [
                            "Used in a subordinate clause before a subjunctive verb (especially when the main verb expresses doubt or fear), to provide extra overtones of doubt or uncertainty (but not negating its verb); the so-called \\\"pleonastic\\\" or \\\"expletive\\\" ne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "235d3292-a645-4d1d-a856-6e7eadad425c",
                                "sense_id": "eebefe04-5ded-3675-95f6-f00c6f2593a5",
                                "text": "Ah! mes cheveux blanchiront avant que ma tête ne tombe!",
                                "translation": "Oh! My hair will go white before my head falls!",
                                "english": "Oh! My hair will go white before my head falls!"
                            },
                            {
                                "example_id": "d7197943-1fe9-45d3-ac21-114f521ec4ce",
                                "sense_id": "eebefe04-5ded-3675-95f6-f00c6f2593a5",
                                "text": "Oui, mais je crains qu'elle ne soit plus malade qu'elle ne l'avoue, repartit l'abbé.",
                                "translation": "\"Yes, but I think she might be more ill than she's letting on,\" the priest replied.",
                                "english": "\"Yes, but I think she might be more ill than she's letting on,\" the priest replied."
                            }
                        ]
                    },
                    {
                        "sense_id": "f31426fc-0777-334d-9f95-c36effa06948",
                        "entry_id": "6c5d4074-4558-3856-8511-0ea69832c927",
                        "glosses": [
                            "In comparative clauses usually translated with the positive sense of the subsequent negative"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c7ef010-3716-4d56-b4fd-be21ecd4c905",
                                "sense_id": "f31426fc-0777-334d-9f95-c36effa06948",
                                "text": "Apprendre le français est plus facile qu'on ne pense.",
                                "translation": "Learning French is easier than you (might) think.",
                                "english": "Learning French is easier than you (might) think."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
