                "senses": [
                    {
                        "sense_id": "e8ab60db-7371-3404-85be-9eca8af69dde",
                        "entry_id": "09773c6f-bb9d-37f1-b9cf-77dcfb7d4849",
                        "glosses": [
                            "Tribune où se regroupent les supporters d’un club."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f72df7d3-7cc2-4afc-b5e8-64e022ef4005",
                                "sense_id": "e8ab60db-7371-3404-85be-9eca8af69dde",
                                "text": "Journaliste et familier du « kop » (la tribune populaire où s’installent les spectateurs les plus acharnés) du Red Star de Saint-Ouen, Mickaël Correia a fait de son engagement sportif une démarche quasi citoyenne."
                            }
                        ]
                    },
                    {
                        "sense_id": "3b5c28c1-1e02-35c8-ac91-c407c057a4db",
                        "entry_id": "09773c6f-bb9d-37f1-b9cf-77dcfb7d4849",
                        "glosses": [
                            "Groupe de supporters exaltés."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "a3ba529d-5ab0-457f-98cf-d2686582003c",
                                "sense_id": "3b5c28c1-1e02-35c8-ac91-c407c057a4db",
                                "text": "Des sifflets permanents quand la Roja jouait à la baballe, un emballement à l’approche des buts d’Unai Simon et deux kops qui se répondaient en s’applaudissant."
                            },
                            {
                                "example_id": "fa7a1ac9-b43d-4216-a060-b42f82fe5a24",
                                "sense_id": "3b5c28c1-1e02-35c8-ac91-c407c057a4db",
                                "text": "Diane Parry peut également remercier le kop français, venu à son secours alors qu’elle était menée 4-1 dans le premier set par Kamilla Rakhimova au deuxième tour."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "57826ed4-c9b1-4242-ae7d-9a63447a058f",
                        "source_entry_id": "09773c6f-bb9d-37f1-b9cf-77dcfb7d4849",
                        "source_sense_description": "tribune",
                        "target_lang_word": "kop",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kop",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "990d8331-4e03-31a0-9728-d33805fad2b8",
                                        "entry_id": "5e76fa38-74b3-36c0-9b70-7c0f0e95f9d4",
                                        "glosses": [
                                            "A hill or mountain."
                                        ],
                                        "tags": [
                                            "South-Africa"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "691c7d87-1a65-45a2-995e-53d4cbb94495",
                                                "sense_id": "990d8331-4e03-31a0-9728-d33805fad2b8",
                                                "text": "[…] a zigzag line of Lee-Enfield flashes, and a charge which took the kop at a cost of ten casualties. The victors held the key to the Ladysmith lock."
                                            },
                                            {
                                                "example_id": "c43839f2-1c3b-4d3e-9c48-45f90338e5a8",
                                                "sense_id": "990d8331-4e03-31a0-9728-d33805fad2b8",
                                                "text": "Within three hours, we took the kop. The dead and wounded were everywhere.\nThe Boers had taken the kop, collected their prisoners and had suffered very few casualties. However, they did not have the strength to hold the prisoners […]"
                                            },
                                            {
                                                "example_id": "7d02302f-f42f-4e7b-bf0e-d5633965afcd",
                                                "sense_id": "990d8331-4e03-31a0-9728-d33805fad2b8",
                                                "text": "A party of burghers, under Commandant Nel, of Kroonstad, were ordered to station themselves on a kop with a flat top, called Swartbooiskop, an hour and a half to the south of Nicholson's Nek."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "kop",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cb4b1c08-cf17-34fe-a0ac-26cccde04220",
                                        "entry_id": "df660d70-a481-30c6-96fa-fb61ba0fef04",
                                        "glosses": [
                                            "Rare spelling of cop (“dome, in armor”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "afea7633-3ba6-45ad-a168-3355901ea491",
                                                "sense_id": "cb4b1c08-cf17-34fe-a0ac-26cccde04220",
                                                "text": "The solerets are wide-toed, […]; the wings of the elbow and knee-kops small. The inner bends of the elbow joints are furnished with a pliable protection of numerous very narrow plates."
                                            },
                                            {
                                                "example_id": "b140d06d-dd79-4e2e-b0a1-b5a75e59170b",
                                                "sense_id": "cb4b1c08-cf17-34fe-a0ac-26cccde04220",
                                                "text": "1. Elbow Kop with rope-cable border.\n2. Part of left Pauldron (shoulder piece) with similar border."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
