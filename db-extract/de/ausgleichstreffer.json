                        "entry_id": "8d7002aa-dcdd-3ec1-b4b5-df4cf2cdfa6c",
                        "glosses": [
                            "Schuss, Hieb, Wurf oder Schlag, der zum Ausgleich führt, also einen vorläufigen Gleichstand bewirkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e915ed3-9d0b-4f6f-8c62-639c78b68fc1",
                                "sense_id": "095da481-7bcc-3603-973e-920432c3fb53",
                                "text": "„Der späte und kuriose Ausgleichstreffer in Bielefeld kann kein Zufall gewesen sein. Vielmehr ist er der Beweis dafür, dass es den Fußballgott eben doch gibt.“"
                            },
                            {
                                "example_id": "dbd07c9a-8204-4abb-b8a4-664ea5110748",
                                "sense_id": "095da481-7bcc-3603-973e-920432c3fb53",
                                "text": "„Doch die Gastgeber erstarrten nicht in Ehrfurcht vor dem Weltmeister und durften in der 31. Minute den Ausgleichstreffer von Dmitrij Nazarov bejubeln.“"
                            }
                        ],
