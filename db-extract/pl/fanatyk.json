                "translations": [
                    {
                        "translation_id": "dd6e611d-c459-4298-be24-17b021ce1537",
                        "source_entry_id": "462e7f8f-fe81-350e-b731-092108928a0c",
                        "source_sense_id": "dd0462d6-525c-324e-97cc-cb1632be05ee",
                        "target_lang_word": "fanatic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fanatic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "896b9968-8684-3add-9fd8-9ee1b4d6e348",
                                        "entry_id": "230c8e2f-73dc-3e57-bf31-0746a3f80373",
                                        "glosses": [
                                            "Fanatical."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79036451-b66a-45bd-9fee-dc22e3bbf603",
                                                "sense_id": "896b9968-8684-3add-9fd8-9ee1b4d6e348",
                                                "text": "But Faith, fanatic Faith, once wedded fast / To some dear falsehood, hugs it to the last."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c80c8d7-905c-32b9-943c-1c14c8f557a5",
                                        "entry_id": "230c8e2f-73dc-3e57-bf31-0746a3f80373",
                                        "glosses": [
                                            "Showing evidence of possession by a god or demon; frenzied, overzealous."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "fanatic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e4da81e3-1862-3b1e-8c35-60b76c765393",
                                        "entry_id": "09a88fa9-e2be-3cb0-9783-0bf329754ddb",
                                        "glosses": [
                                            "A person who is zealously enthusiastic for some cause."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e79eff5-6a1f-4a51-871b-aa79ad2f5755",
                                                "sense_id": "e4da81e3-1862-3b1e-8c35-60b76c765393",
                                                "text": "The reclusive tycoon calling himself the Illusive Man is a human nationalist focused on advancing human interests, whatever the cost to non-humans. The Citadel Council regards him as a fanatic posing a serious threat to galactic security."
                                            },
                                            {
                                                "example_id": "80a0dc6f-fd15-4d3c-85b0-24dd9c7f1ce7",
                                                "sense_id": "e4da81e3-1862-3b1e-8c35-60b76c765393",
                                                "text": "A zealot can't change his mind. A fanatic can't change his mind and won't change the subject. —Winston Churchill (attributed)"
                                            },
                                            {
                                                "example_id": "52041bca-f25d-4856-badb-d05e36c8be55",
                                                "sense_id": "e4da81e3-1862-3b1e-8c35-60b76c765393",
                                                "text": "A fanatic is one who redoubles his effort when he has forgotten his aim. —George Santayana"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7784aa1f-8736-4628-9892-0fbdb661f0b5",
                        "source_entry_id": "462e7f8f-fe81-350e-b731-092108928a0c",
                        "source_sense_id": "dd0462d6-525c-324e-97cc-cb1632be05ee",
                        "target_lang_word": "fanatik",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "db09cfe0-34a7-4174-9005-57b3fe444621",
                        "source_entry_id": "462e7f8f-fe81-350e-b731-092108928a0c",
                        "source_sense_id": "dd0462d6-525c-324e-97cc-cb1632be05ee",
                        "target_lang_word": "fanatique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fanatique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3ac4ee07-ed88-3993-9706-7f5367ea55fa",
                                        "entry_id": "8089cd78-4a1a-3472-bd40-b2ed26e43fd9",
                                        "glosses": [
                                            "Qui est emporté par une passion excessive pour la politique ou la religion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1467a02d-6055-40d2-866f-508617fdc2f9",
                                                "sense_id": "3ac4ee07-ed88-3993-9706-7f5367ea55fa",
                                                "text": "Outre l’ascension du peintre refoulé devenu soldat fanatique puis sauveur vénéré d’une Allemagne en perdition, le musée abordait l’Holocauste et ses millions de victimes, photographies sans concession à l’appui, montrant comment la folie d’une poignée d’individus ultradéterminés avait mené le pays dans l’horreur."
                                            },
                                            {
                                                "example_id": "8ebf9d48-cdd9-4977-a072-5e535aab49ea",
                                                "sense_id": "3ac4ee07-ed88-3993-9706-7f5367ea55fa",
                                                "text": "Nous laissons beaucoup trop les Alsaciens « cuire dans leur jus », nous les abandonnons trop à l’horizon confiné de ce couloir d’entre Vosges et Rhin où la fermentation d’un particularisme fanatique finit par exhaler une agressive odeur de renfermé."
                                            },
                                            {
                                                "example_id": "ec94dfb8-5633-4109-9f72-1438abb97a24",
                                                "sense_id": "3ac4ee07-ed88-3993-9706-7f5367ea55fa",
                                                "text": "Qu’une aventurière fanatique assoiffée de sang et de meurtres soit béatifiée par l'Église, passe encore !"
                                            },
                                            {
                                                "example_id": "cdaaa49c-5051-4135-9372-930571895d11",
                                                "sense_id": "3ac4ee07-ed88-3993-9706-7f5367ea55fa",
                                                "text": "Prenez un livre d’histoire et considérez les contemporains de Montaigne ou même ceux de Descartes et vous verrez que la haine religieuse qui a opposé les chrétiens catholiques et les Chrétiens protestants était plus furibonde, plus sanguinaire, plus fanatique, plus intrinsèquement sauvage que celle qui peut exister aujourd’hui entre les communautés musulmanes et chrétiennes d’Afrique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b999f267-3787-3740-a09a-49ce39fccdb3",
                                        "entry_id": "8089cd78-4a1a-3472-bd40-b2ed26e43fd9",
                                        "glosses": [
                                            "Celui, celle qui se passionne à l’excès pour un parti, pour une opinion, pour un auteur, etc."
                                        ],
                                        "tags": [
                                            "hyperbole"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e602d7e-3b4e-4988-b196-c3b3cad406d2",
                                                "sense_id": "b999f267-3787-3740-a09a-49ce39fccdb3",
                                                "text": "A peine arrivé en ce lieu de ses rêves, il se mettait à pêcher : il pêchait jusqu’à la nuit.\nChaque dimanche, il rencontrait là un petit homme replet et jovial, M. Sauvage, mercier rue Notre-Dame-de-Lorette, autre pêcheur fanatique."
                                            },
                                            {
                                                "example_id": "202408b4-6f7e-416c-ae80-fe3e355511da",
                                                "sense_id": "b999f267-3787-3740-a09a-49ce39fccdb3",
                                                "text": "Les adultes qui veulent protéger les enfants victimes de violences sexuelles font l’objet de menaces et de sanctions. Ces adultes sont souvent affublés de qualificatifs tels que : manipulatrice, aliénante, imprudent, intrusif, complotiste, féministe, fanatique, caricatural, voire militant qui est le qualificatif le plus péjoratif dans l’esprit de la personne qui l’utilise comme une arme de langage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c0e036b-e61b-3498-8e98-ee7b5dc6f37c",
                                        "entry_id": "8089cd78-4a1a-3472-bd40-b2ed26e43fd9",
                                        "glosses": [
                                            "Qui est aliéné d’esprit, qui croit avoir des apparitions, des inspirations."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3782100-2632-44b7-9a4e-e0b3386374e8",
                                                "sense_id": "3c0e036b-e61b-3498-8e98-ee7b5dc6f37c",
                                                "text": "Les illuminés, les Quakers étaient fanatiques."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fanatique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "53fcac29-218c-30d4-a84e-21ec52f291db",
                                        "entry_id": "4da498ae-8465-32fc-aa13-48c9db5adc7b",
                                        "glosses": [
                                            "Celui ou celle qui est emporté par une passion excessive pour la politique ou la religion et qui cherche à l’imposer aux autres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43adcae8-c7b1-4c8e-91c0-81563160b570",
                                                "sense_id": "53fcac29-218c-30d4-a84e-21ec52f291db",
                                                "text": "La fanatisme est à la superstition ce que le transport est à la fièvre, ce que la rage est à la colère. Celui qui a des extases, des visions, qui prend ses songes pour des réalités, et ses imaginations pour des prophéties, est un enthousiaste ; celui qui soutient sa folie par le meurtre est un fanatique."
                                            },
                                            {
                                                "example_id": "28896e16-3e7f-47d5-9a99-102d1fb203de",
                                                "sense_id": "53fcac29-218c-30d4-a84e-21ec52f291db",
                                                "text": "Toutefois la pacification des villes ne va pas sans réactions parfois violentes et soudaines de fanatiques irréductibles."
                                            },
                                            {
                                                "example_id": "229a04cc-af5a-4344-bdb9-856cf0c12618",
                                                "sense_id": "53fcac29-218c-30d4-a84e-21ec52f291db",
                                                "text": "Les sadhu ne sont pas des marginaux ou des fanatiques religieux, ce sont des hommes saints, vénérés par les hindous comme des représentants des divinités, entrés dans la voie de la libération et de l’élévation spirituelle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3913a62d-e27f-3f42-8963-2868868cd206",
                                        "entry_id": "4da498ae-8465-32fc-aa13-48c9db5adc7b",
                                        "glosses": [
                                            "Au jeu de l'hombre, réunion des quatre valets dans la même main."
                                        ],
                                        "tags": [
                                            "Cartes à jouer"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9961dc26-1c4c-4f6a-99ce-3b450b7bae51",
                        "source_entry_id": "462e7f8f-fe81-350e-b731-092108928a0c",
                        "source_sense_id": "dd0462d6-525c-324e-97cc-cb1632be05ee",
                        "target_lang_word": "fanático",
