                "senses": [
                    {
                        "sense_id": "32884b96-66c4-3dc5-a396-eaa1a0124217",
                        "entry_id": "ee92f7d5-6980-3f91-b5b7-4944146de4e6",
                        "glosses": [
                            "кулин. (уменьш. от тефтели) мясное или рыбное блюдо в виде шарика из фарша, приготовляемое в супе или бульоне"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "676cc214-9aca-475f-b902-f70c577282e1",
                                "sense_id": "32884b96-66c4-3dc5-a396-eaa1a0124217",
                                "text": "Примерно с той же периодичностью, что и кашу, Юля приготовляет вареные тефтельки"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "73d7a7e5-2bda-4af2-a394-7daf08382552",
                        "source_entry_id": "ee92f7d5-6980-3f91-b5b7-4944146de4e6",
                        "source_sense_id": "32884b96-66c4-3dc5-a396-eaa1a0124217",
                        "target_lang_word": "meatball",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "meatball",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "568416a7-2d14-3e44-9d3b-0dcada13a687",
                                        "entry_id": "dccec249-5a43-31f4-b8a9-8c885986a984",
                                        "glosses": [
                                            "A ball of minced or ground meat, seasoned and cooked."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "791c68d8-5cc9-4c23-b134-53bc11b8dc86",
                                                "sense_id": "568416a7-2d14-3e44-9d3b-0dcada13a687",
                                                "text": "Meatballs was on the menu for lunch."
                                            },
                                            {
                                                "example_id": "9eecab93-feb6-4414-ba70-856521832501",
                                                "sense_id": "568416a7-2d14-3e44-9d3b-0dcada13a687",
                                                "text": "Meatballs may contain ground meat mixed with seasonings, breadcrumbs, mashed potatoes, rice, and liquid. The meat mixture is often shaped, browned. and simmered in a sauce for 30 to 45 minutes over low heat or in a 350° F. oven. During cooking the meat is basted with the sauce occasionally. Meatballs also may be fried in a pan or in deep fat."
                                            },
                                            {
                                                "example_id": "c70dfefe-ba4f-4485-b0b6-5cd06533bf66",
                                                "sense_id": "568416a7-2d14-3e44-9d3b-0dcada13a687",
                                                "text": "1996: Mrs. Miracle. Debbie Macomber. Pg. 101.\nI prefer spaghetti with meatballs instead the meat all crumbled in with the sauce."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0e1b0d3-944a-3684-a7f0-edd50d24c08e",
                                        "entry_id": "dccec249-5a43-31f4-b8a9-8c885986a984",
                                        "glosses": [
                                            "A stupid person; a meathead."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "969478db-c522-3d9d-a74e-ab7c4691ca86",
                                        "entry_id": "dccec249-5a43-31f4-b8a9-8c885986a984",
                                        "glosses": [
                                            "An easy pitch to hit, especially thrown right down the middle of the plate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19a06fdb-059c-40f8-9e4c-746daf2915c3",
                                                "sense_id": "969478db-c522-3d9d-a74e-ab7c4691ca86",
                                                "text": "And then. A 98.4 fastball on the inside half of the plate, ring him up, Strike 3, game over. It wasn’t a meatball like Terrence Long watched to finish 2003 ALDS Game 5, but it felt the same."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e798f823-09fe-3200-b69e-c084a1e7131b",
                                        "entry_id": "dccec249-5a43-31f4-b8a9-8c885986a984",
                                        "glosses": [
                                            "An optical landing system."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d366c39c-f3c6-4418-b5ea-48e909e3cf75",
                                                "sense_id": "e798f823-09fe-3200-b69e-c084a1e7131b",
                                                "text": "During a pitching deck recovery a pilot must average out the meatball oscillations at the ramp in an attempt to maintain his airplane on the desired glide slope."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1329254c-265c-349a-a570-aec161937dd2",
                                        "entry_id": "dccec249-5a43-31f4-b8a9-8c885986a984",
                                        "glosses": [
                                            "A menu icon of three horizontal dots."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
