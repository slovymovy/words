    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "15b2d66f-d72f-3ddb-b85a-62da025ed928",
                    "sense_definition": "Reconduire une personne ou reporter un objet au lieu d'où il était parti.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "retour",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est déjà tard, je peux te <w>ramener</w> chez toi en voiture si tu veux."
                        },
                        {
                            "text": "Vous m'aviez confié ce jeune homme, je vous le <w>ramène</w> sain et sauf."
                        }
                    ],
                    "common_phrases": [
                        "ramener à la maison",
                        "ramener en voiture"
                    ]
                },
                {
                    "sense_id": "ea2334ea-e0b0-345c-88eb-f00a4d1e067a",
                    "sense_definition": "Apporter quelque chose d'un endroit que l'on quitte ou que l'on visite.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "apport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ils ont passé leurs vacances en Italie et nous ont <w>ramené</w> une excellente huile d'olive."
                        },
                        {
                            "text": "Pendant que tu es encore en ville, tu pourrais <w>ramener</w> du pain pour ce soir ?"
                        }
                    ],
                    "common_phrases": [
                        "ramener un souvenir"
                    ]
                },
                {
                    "sense_id": "4fb268ac-54e4-31a2-8fa1-28dd9a2f36a5",
                    "sense_definition": "Arriver ou se présenter quelque part de façon impromptue.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "venir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sans prévenir personne, il s'est <w>ramené</w> à la fête au milieu de la nuit."
                        },
                        {
                            "text": "Si tu n'as rien de prévu ce soir, tu peux te <w>ramener</w> chez nous."
                        }
                    ],
                    "synonyms": [
                        "débarquer"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier"
                        }
                    ]
                },
                {
                    "sense_id": "3cd0052d-7ce5-31cd-9a17-89513866b0f7",
                    "sense_definition": "Rétablir un état d'esprit, un ordre ou une situation qui s'était dégradée.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "retablir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur a pris la parole afin de <w>ramener</w> le calme dans la salle de réunion."
                        },
                        {
                            "text": "Cette nouvelle mesure économique a enfin <w>ramené</w> la confiance parmi les commerçants du quartier."
                        }
                    ],
                    "common_phrases": [
                        "ramener le calme",
                        "ramener la paix",
                        "ramener à la raison"
                    ]
                },
                {
                    "sense_id": "79aa11ba-22c7-3cc0-83ba-4d4baa87e277",
                    "sense_definition": "Tirer, replier ou déplacer vers soi une partie du corps ou un objet.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "tirer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur de gymnastique nous a demandé de <w>ramener</w> doucement les genoux vers la poitrine."
                        },
                        {
                            "text": "Elle <w>ramène</w> ses cheveux derrière les oreilles pour mieux se concentrer sur son dessin."
                        }
                    ],
                    "common_phrases": [
                        "ramener ses cheveux en arrière"
                    ]
                },
                {
                    "sense_id": "cc939a85-18eb-363a-979b-540e74e4fa7f",
                    "sense_definition": "Réduire ou simplifier une question complexe à son point fondamental.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "reduire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En réalité, tout ce long débat se <w>ramène</w> à une simple question financière."
                        },
                        {
                            "text": "Le professeur a su <w>ramener</w> ce problème difficile à quelques principes élémentaires bien clairs."
                        }
                    ],
                    "common_phrases": [
                        "se ramener à"
                    ]
                }
            ]
        }
    ]
}