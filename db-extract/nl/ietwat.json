                                            {
                                                "example_id": "112083a0-1b0f-41dd-9a52-58ebd20a2f23",
                                                "sense_id": "a3f0c5ce-722a-31df-9e0e-eafd33608730",
                                                "text": "Hast du etwas Zeit?"
                                            },
                                            {
                                                "example_id": "9762d830-39b2-4607-9d9e-2ef42adbddae",
                                                "sense_id": "a3f0c5ce-722a-31df-9e0e-eafd33608730",
                                                "text": "Nehmen Sie etwas Salz und streuen Sie es über den Fleck."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "554873db-942a-3bbc-82ee-2c2ee685d4da",
                                        "entry_id": "f69668fa-aeab-3222-a408-d1ba71e811f1",
                                        "glosses": [
                                            "ein nicht näher Bestimmtes (in Verwendung als Artikelwort oder Substantiv)"
                                        ],
                                        "tags": [
                                            "steht ganz allgemein für"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e128b2e-ff70-4caf-a882-b174967f4153",
                                                "sense_id": "554873db-942a-3bbc-82ee-2c2ee685d4da",
                                                "text": "Hast du etwas gesehen?"
                                            },
                                            {
                                                "example_id": "46e11ea8-4422-4fdd-9f73-bfdcaa7bf94f",
                                                "sense_id": "554873db-942a-3bbc-82ee-2c2ee685d4da",
                                                "text": "Ich höre etwas. Können das Kinderstimmen sein?"
                                            },
                                            {
                                                "example_id": "681659d8-8705-4305-9d40-a64715b3ff0e",
                                                "sense_id": "554873db-942a-3bbc-82ee-2c2ee685d4da",
                                                "text": "Haben Sie etwas Neues von der Tochter gehört?"
                                            },
                                            {
                                                "example_id": "9d157a59-e72d-478a-9e37-6831dba5705e",
                                                "sense_id": "554873db-942a-3bbc-82ee-2c2ee685d4da",
                                                "text": "Kauf dir etwas Schönes!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e968f958-acb2-39ac-ab5a-194e81c027cb",
                                        "entry_id": "f69668fa-aeab-3222-a408-d1ba71e811f1",
                                        "glosses": [
                                            "ein nicht näher bestimmtes, aber bedeutend Positives, das als erstrebenswert und wichtig angesehen wird"
                                        ],
                                        "tags": [
                                            "steht in festen Wendungen für"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a05efb7d-ac60-4dab-b4f2-3c001cdf5807",
                                                "sense_id": "e968f958-acb2-39ac-ab5a-194e81c027cb",
                                                "text": "In Amerika hat mein Onkel es dann damals zu etwas gebracht."
                                            },
                                            {
                                                "example_id": "140dc45d-e7ba-443b-9e50-7dec4c8b61ca",
                                                "sense_id": "e968f958-acb2-39ac-ab5a-194e81c027cb",
                                                "text": "Er hat ein Summa cum laude Examen gemacht, das muss doch in diesem Land etwas gelten!"
                                            },
                                            {
                                                "example_id": "3d2908a8-9a82-44f1-84c7-6e910027c8e5",
                                                "sense_id": "e968f958-acb2-39ac-ab5a-194e81c027cb",
                                                "text": "Sie ist bei ihrem ersten Rennen Dritte geworden, das will schon etwas heißen!"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c9ff188b-8e70-4ec7-9014-169c8845fb6d",
                        "source_entry_id": "958e0980-cb2a-3a15-9081-2daa99c412c3",
                        "source_sense_id": "5620bc53-8567-38eb-b580-93348cfc905d",
