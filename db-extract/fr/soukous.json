                "entry_id": "9aabef5b-6ad7-3daa-a8db-59344d552554",
                "word": "soukous",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "29224f37-f0c4-401a-aa35-e9beb19eedc2",
