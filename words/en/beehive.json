{
    "word_family": [
        "bee",
        "hive"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fa7e91e0-2541-305f-a204-aed1176d81a4",
                    "sense_definition": "A man-made structure in which honey bees are kept so that humans can harvest their honey.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "bee_home",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The beekeeper checked every <w>beehive</w> to ensure the colony was healthy.",
                            "target_lang_translations": {
                                "zh": "养蜂人检查了每一个<w>蜂箱</w>，以确保蜂群健康。"
                            }
                        },
                        {
                            "text": "We placed a new <w>beehive</w> in the orchard to help pollinate the fruit trees.",
                            "target_lang_translations": {
                                "zh": "我们在果园里放置了一个新的<w>蜂箱</w>，以帮助果树授粉。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hive",
                        "apiary"
                    ],
                    "common_phrases": [
                        "beehive box"
                    ],
                    "target_lang_definitions": {
                        "zh": "人工建造的蜂箱，用于饲养蜜蜂并采集蜂蜜。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "蜂箱",
                                "target_lang_sense_clarification": "指人工制作的养蜂容器"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "213a7f4d-5475-3e98-833d-474e7be4b26a",
                    "sense_definition": "A natural home prepared by bees in which they live and raise their young.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bee_home",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wild bees built a large <w>beehive</w> inside the hollow tree trunk.",
                            "target_lang_translations": {
                                "zh": "野蜂在空树干里筑了一个巨大的<w>蜂巢</w>。"
                            }
                        },
                        {
                            "text": "We spotted a natural <w>beehive</w> hanging from a branch in the forest.",
                            "target_lang_translations": {
                                "zh": "我们在森林里发现了一个挂在树枝上的天然<w>蜂巢</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hive"
                    ],
                    "target_lang_definitions": {
                        "zh": "蜜蜂在自然界中筑造的巢穴。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "蜂巢",
                                "target_lang_sense_clarification": "指蜜蜂居住的天然巢穴"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf167f7b-bb8a-34a3-ae6c-c23194ffcc5f",
                    "sense_definition": "Any place full of activity, or in which people are very busy.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The office became a <w>beehive</w> of activity as the deadline approached.",
                            "target_lang_translations": {
                                "zh": "随着截止日期临近，办公室变成了一个<w>繁忙之地</w>。"
                            }
                        },
                        {
                            "text": "During the festival, the town square was a <w>beehive</w> of activity.",
                            "target_lang_translations": {
                                "zh": "节日期间，城镇广场成了人声鼎沸的<w>繁忙之地</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hive of activity"
                    ],
                    "common_phrases": [
                        "beehive of activity"
                    ],
                    "target_lang_definitions": {
                        "zh": "形容一个地方非常繁忙、充满活力。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "繁忙之地",
                                "target_lang_sense_clarification": "比喻人声鼎沸、极其忙碌的场所"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e7c92e60-1064-369d-a16e-113b28eabc6b",
                    "sense_definition": "A women's hairstyle, popular in the 1960s, in which long hair is styled into a hive-shaped form on top of the head.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore her hair in a tall <w>beehive</w> for the retro-themed party.",
                            "target_lang_translations": {
                                "zh": "为了参加复古主题派对，她梳了一个高高的<w>蜂巢头</w>。"
                            }
                        },
                        {
                            "text": "The vintage photograph showed her mother sporting a classic <w>beehive</w> hairstyle.",
                            "target_lang_translations": {
                                "zh": "那张老照片显示她母亲留着经典的<w>蜂巢头</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Refers to a specific fashion trend from the 1960s."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一种20世纪60年代流行的女性发型，将长发盘成蜂巢状。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "蜂巢头",
                                "target_lang_sense_clarification": "指一种复古的盘发造型"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "89dd87cc-00e7-3261-a8cc-9e307e943c17",
                    "sense_definition": "To fill a place with busy activity.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The volunteers began <w>beehiving</w> the community center to prepare for the event.",
                            "target_lang_translations": {
                                "zh": "志愿者们开始<w>挤满</w>社区中心，为活动做准备。"
                            }
                        },
                        {
                            "text": "Crowds were <w>beehiving</w> the market square throughout the entire afternoon.",
                            "target_lang_translations": {
                                "zh": "整个下午，人群都在<w>挤满</w>集市广场。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "使某地变得繁忙、人头攒动。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "挤满",
                                "target_lang_sense_clarification": "形容人流密集、活动频繁"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "fab6b9b9-9255-3eb6-b4e5-d736c9885221",
                    "sense_definition": "The executive wing of the New Zealand parliament buildings.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "no",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The Prime Minister held a press conference at the <w>Beehive</w> this morning.",
                            "target_lang_translations": {
                                "zh": "总理今天上午在<w>蜂巢大厦</w>举行了新闻发布会。"
                            }
                        },
                        {
                            "text": "Many tourists visit the <w>Beehive</w> when they travel to Wellington.",
                            "target_lang_translations": {
                                "zh": "许多游客去惠灵顿旅游时都会参观<w>蜂巢大厦</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Used specifically in New Zealand."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "新西兰议会大厦的行政办公楼，因外形像蜂巢而得名。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "蜂巢大厦",
                                "target_lang_sense_clarification": "新西兰议会办公楼的专称"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}