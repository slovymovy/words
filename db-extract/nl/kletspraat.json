        "nl-extract.jsonl": [
            {
                "entry_id": "7fefc354-827a-3a0d-a555-1e258fa0ad66",
                "word": "kletspraat",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "a676cce3-294c-4215-befe-41b622882640",
                        "entry_id": "7fefc354-827a-3a0d-a555-1e258fa0ad66",
                        "tags": [
                            "diminutive",
                            "singular"
                        ],
                        "form": "kletspraatje"
                    },
                    {
                        "form_id": "96d9af34-6e8f-4f2e-bb7d-d073bed4586e",
                        "entry_id": "7fefc354-827a-3a0d-a555-1e258fa0ad66",
                        "tags": [
                            "diminutive",
                            "plural"
                        ],
                        "form": "kletspraatjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "50af93bd-2f92-309a-9174-4c1b7c438121",
                        "entry_id": "7fefc354-827a-3a0d-a555-1e258fa0ad66",
                        "glosses": [
                            "onzin die iemand vertelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6913533e-f838-49c3-bbdc-77fc52e3a52d",
                                "sense_id": "50af93bd-2f92-309a-9174-4c1b7c438121",
                                "text": "Deze jongen had weer enorme kletspraatjes uitgekraamd over de wilde avonturen die hij op zijn vakantie had meegemaakt."
                            },
                            {
                                "example_id": "82ccd9d9-4b79-41aa-bb4d-acaedb74ba14",
                                "sense_id": "50af93bd-2f92-309a-9174-4c1b7c438121",
                                "text": "De informatie bestaat voor 90 procent uit gissingen, vermoedens, kletspraat en gekissebis tussen leken die het beter denken te weten dan andere leken. En ergens in die brij zit misschien de oplossing, maar misschien ook niet."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "483bacaa-7b38-45d3-a1aa-f27390e4280a",
                        "source_entry_id": "7fefc354-827a-3a0d-a555-1e258fa0ad66",
                        "source_sense_id": "50af93bd-2f92-309a-9174-4c1b7c438121",
                        "target_lang_word": "gossip",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gossip",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "455bb8c8-3fb6-37f7-8237-7818dd8089fa",
                                        "entry_id": "c851e37e-900a-379e-a646-d2bb7fc32635",
                                        "glosses": [
                                            "Someone who likes to talk about other people's private or personal business."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20bcfde4-b169-4ffa-98d4-7dee679de0ad",
                                                "sense_id": "455bb8c8-3fb6-37f7-8237-7818dd8089fa",
                                                "text": "Be careful what you say to him: he’s a bit of a gossip."
                                            },
                                            {
                                                "example_id": "05dff602-15be-48f2-bfa1-f40e48411daa",
                                                "sense_id": "455bb8c8-3fb6-37f7-8237-7818dd8089fa",
                                                "text": "A losing Gamester, who is obliged to drive into the City to dispose of a little South Sea Stock, gives the Hint there. The Gossips at Garraway’s have it in a Moment: At One it is buzz’d on Change, and the circulating Whisper in the Boxes interrupts the Play at Night."
                                            },
                                            {
                                                "example_id": "68b6f53e-b2f2-4338-aaab-5f175397884d",
                                                "sense_id": "455bb8c8-3fb6-37f7-8237-7818dd8089fa",
                                                "text": "He was an arrant old gossip, too; for ever coming off in his canoe to the ships in the bay, and regaling their crews with choice little morsels of court scandal […]"
                                            },
                                            {
                                                "example_id": "59d4e66d-d7bd-4846-be66-68ddd9adbfcd",
                                                "sense_id": "455bb8c8-3fb6-37f7-8237-7818dd8089fa",
                                                "text": "Alf could tell you about everybody on both sides of Main Street. He was a vicious male gossip, insatiably curious and vindictive without malice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de765805-569f-32cf-ae02-2161eaa5bcb0",
                                        "entry_id": "c851e37e-900a-379e-a646-d2bb7fc32635",
                                        "glosses": [
                                            "Idle talk about someone’s private or personal matters, especially about someone not present."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ed408d9-b438-4b89-aaf7-948876f18ddd",
                                                "sense_id": "de765805-569f-32cf-ae02-2161eaa5bcb0",
                                                "text": "According to the latest gossip, their relationship is on the rocks."
                                            },
                                            {
                                                "example_id": "d086a9dc-7b3d-44cd-ac38-014522ba0274",
                                                "sense_id": "de765805-569f-32cf-ae02-2161eaa5bcb0",
                                                "text": "I have a juicy piece of gossip to share with you."
                                            },
                                            {
                                                "example_id": "54e481e3-7b2b-4f71-b159-e978cc3856df",
                                                "sense_id": "de765805-569f-32cf-ae02-2161eaa5bcb0",
                                                "text": "[…] the thing is certainly true. It is not a mere bit of gossip. We have it from Frederick himself."
                                            },
                                            {
                                                "example_id": "2a8c7880-72f8-46ed-a48d-3088469c7143",
                                                "sense_id": "de765805-569f-32cf-ae02-2161eaa5bcb0",
                                                "text": "I ought to arise and go forth with timbrels and with dances; but, do you know, I am not inclined to revels? There has been a little—just a very little bit too much festivity so far …. Not that I don’t adore dinners and gossip and dances; not that I do not love to pervade bright and glittering places.[…]"
                                            },
                                            {
                                                "example_id": "d266434c-f63f-4ce5-88de-f63c2c2bc899",
                                                "sense_id": "de765805-569f-32cf-ae02-2161eaa5bcb0",
                                                "text": "The smaller a town the more richly it hums with gossip. There are no private affairs here. Gossip is the air we breathe."
                                            },
                                            {
                                                "example_id": "d12cf42e-408e-4832-9aa5-48a29f41fe57",
                                                "sense_id": "de765805-569f-32cf-ae02-2161eaa5bcb0",
                                                "text": "Intense nosiness about everybody had always existed in the area. Gossip washed in, washed out, came, went, moved on to the next target."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6830279a-b5af-34c2-b23a-769da03959a4",
                                        "entry_id": "c851e37e-900a-379e-a646-d2bb7fc32635",
                                        "glosses": [
                                            "Idle conversation in general."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7cbf32b9-edea-4579-8a1c-7c015461f97a",
                                                "sense_id": "6830279a-b5af-34c2-b23a-769da03959a4",
                                                "text": "The parlor was always bright and attractive, the chessboard ready, the piano in tune, plenty of gay gossip, and a nice little supper set forth in tempting style."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "358e678b-f89f-3dc6-ad1f-73332c5abba1",
                                        "entry_id": "c851e37e-900a-379e-a646-d2bb7fc32635",
                                        "glosses": [
                                            "A genre in contemporary media, usually focused on the personal affairs of celebrities."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6bd2be4-1630-4e1d-8e3e-2a24484f7293",
                                                "sense_id": "358e678b-f89f-3dc6-ad1f-73332c5abba1",
                                                "text": "a gossip columnist"
                                            },
                                            {
                                                "example_id": "729be399-97d4-49ae-83c3-65f1bd722c7f",
                                                "sense_id": "358e678b-f89f-3dc6-ad1f-73332c5abba1",
                                                "text": "a gossip blog"
                                            },
                                            {
                                                "example_id": "27b4e48d-a83c-4ed4-bf30-d2b464a0ab35",
                                                "sense_id": "358e678b-f89f-3dc6-ad1f-73332c5abba1",
                                                "text": "Little disappointed, then, she turned attention to \"Chat of the Social World,\" gossip which exercised potent fascination upon the girl's intelligence. She devoured with more avidity than she had her food those pretentiously phrased chronicles of the snobocracy—[…]—distilling therefrom an acid envy that robbed her napoleon of all its flavor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1dcfce1a-3477-39d8-960a-3260cadcc4b6",
                                        "entry_id": "c851e37e-900a-379e-a646-d2bb7fc32635",
                                        "glosses": [
                                            "Communication done using a gossip protocol."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "88e5c2b5-664e-361c-848a-03908440055c",
                                        "entry_id": "c851e37e-900a-379e-a646-d2bb7fc32635",
                                        "glosses": [
                                            "A sponsor; a godfather or godmother; the godparent of one's child or godchild, or the parent of one's godchild."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ebba84d-990d-42bb-93cf-a94a43dfe9de",
                                                "sense_id": "88e5c2b5-664e-361c-848a-03908440055c",
                                                "text": "’tis not a maid, for she hath had gossips [i.e. she could not be a virgin, because she has children with godparents]"
                                            },
                                            {
                                                "example_id": "f25c247c-4f15-4385-9277-615a1b9d43bd",
                                                "sense_id": "88e5c2b5-664e-361c-848a-03908440055c",
                                                "text": "Should a great Lady, that was invited to be a Gossip, in her place send her Kitchen-Maid, ’twould be ill taken;"
                                            },
                                            {
                                                "example_id": "195c031f-ba6f-40b3-a00c-9b7aafe3688a",
                                                "sense_id": "88e5c2b5-664e-361c-848a-03908440055c",
                                                "text": "It seems, Miss, that if he stood not himself, or procur’d not Gossips for the Christening of the Children of his poorer Tenants, he always sent them a large rich Cake […]"
                                            },
                                            {
                                                "example_id": "0cfbd786-c11e-432f-87cb-ee23c98c125f",
                                                "sense_id": "88e5c2b5-664e-361c-848a-03908440055c",
                                                "text": "When a man stood sponsor for a child at baptism, he became the child's godfather, and gossip to the parents."
                                            },
                                            {
                                                "example_id": "dd564acb-e38e-41af-b300-448326861fd6",
                                                "sense_id": "88e5c2b5-664e-361c-848a-03908440055c",
                                                "text": "Gossips accepted responsibility for the child's spiritual and physical well-being, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "649a2200-3c49-35f6-b580-75783a3c9e59",
                                        "entry_id": "c851e37e-900a-379e-a646-d2bb7fc32635",
                                        "glosses": [
                                            "A familiar acquaintance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2d18984-9523-4420-babf-f9275ad6402f",
                                                "sense_id": "649a2200-3c49-35f6-b580-75783a3c9e59",
                                                "text": "My noble gossips, ye have been too prodigal:\nI thank ye heartily;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dcbf0ec7-528f-3212-9c29-6e31353c58b8",
                                        "entry_id": "c851e37e-900a-379e-a646-d2bb7fc32635",
                                        "glosses": [
                                            "Title used with the name of one's child's godparent or of a friend."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67a9bed2-d425-48e3-beaa-63b989a1dcaa",
                                                "sense_id": "dcbf0ec7-528f-3212-9c29-6e31353c58b8",
                                                "text": "What, ho, gossip Ford! what, ho!"
                                            },
                                            {
                                                "example_id": "4943e44d-d68a-4950-b8c0-42129a2028a1",
                                                "sense_id": "dcbf0ec7-528f-3212-9c29-6e31353c58b8",
                                                "text": "He was old and infirm, he wrote, and Gossip Death was waiting for him on the moor; but before he went to join him he would like to see Susan’s boy again."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gossip",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "533a6a66-ace6-345b-abd2-83f86fb5f2a3",
                                        "entry_id": "aac679bb-ef3e-3a6c-9d97-d5a340114949",
                                        "glosses": [
                                            "To talk about someone else's private or personal business, especially in a manner that spreads the information."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49d3ade9-c1a0-4341-89c4-375c84dbd91e",
                                                "sense_id": "533a6a66-ace6-345b-abd2-83f86fb5f2a3",
                                                "text": "This Place then is no other than the Chandler’s Shop; the known Seat of all the News; or, as it is vulgarly called, Gossiping, in every Parish in England."
                                            },
                                            {
                                                "example_id": "1c74deba-ccd8-4825-934d-257be7f9d796",
                                                "sense_id": "533a6a66-ace6-345b-abd2-83f86fb5f2a3",
                                                "text": "Godfrey felt guilty at having gossiped to Olive about Lettie’s changes in her will."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8caa695f-7860-3965-a03a-a303d5614e44",
                                        "entry_id": "aac679bb-ef3e-3a6c-9d97-d5a340114949",
                                        "glosses": [
                                            "To talk idly."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af08e6a4-dcc0-4b45-add3-82ffa52444bc",
                                                "sense_id": "8caa695f-7860-3965-a03a-a303d5614e44",
                                                "text": "[…] on seats beneath the trees, the old men group of an evening to drink their ale and gossip over village politics;"
                                            },
                                            {
                                                "example_id": "286b95fa-0d40-4f5f-827e-292af913ad61",
                                                "sense_id": "8caa695f-7860-3965-a03a-a303d5614e44",
                                                "text": "\"Tut! tut! The unchanging woman. They gossiped in my time and they gossip still.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f22e4dbc-d026-3e73-8a1c-ea578c5160fd",
                                        "entry_id": "aac679bb-ef3e-3a6c-9d97-d5a340114949",
                                        "glosses": [
                                            "To stand godfather to; to provide godparents for."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd719388-2536-48ce-b69f-b6f904c70e76",
                                                "sense_id": "f22e4dbc-d026-3e73-8a1c-ea578c5160fd",
                                                "text": "[…] a world\nOf pretty, fond, adoptious christendoms [i.e. Christian names],\nThat blinking Cupid gossips."
                                            },
                                            {
                                                "example_id": "619ab36e-882d-476e-ad93-8ce628249fff",
                                                "sense_id": "f22e4dbc-d026-3e73-8a1c-ea578c5160fd",
                                                "text": "The Pleasure I used to take in telling my Boy Stories of the Battles, and asking my Girl Questions about the Disposal of her Baby, and the Gossiping of it, is turned into inward Reflection and Melancholy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "918e61cd-e652-31ac-9980-56c7ef1646f4",
                                        "entry_id": "aac679bb-ef3e-3a6c-9d97-d5a340114949",
                                        "glosses": [
                                            "To enjoy oneself during festivities, to make merry."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6786b43f-b9a3-491e-9f99-a48b89ad8715",
                                                "sense_id": "918e61cd-e652-31ac-9980-56c7ef1646f4",
                                                "text": "[…] those baby eyes\nThat never saw the giant world enraged;\nNor met with fortune other than at feasts,\nFull of warm blood, of mirth, of gossiping."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53083c00-8675-3ccb-abd9-deb2c7ac58d1",
                                        "entry_id": "aac679bb-ef3e-3a6c-9d97-d5a340114949",
                                        "glosses": [
                                            "To communicate using a gossip protocol."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
