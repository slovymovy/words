                                        "entry_id": "8fd52531-8b0b-301e-b42a-7daf66e01056",
                                        "glosses": [
                                            "een fout bij het maken van een berekening (en omdat computers foutloos kunnen rekenen zijn dat dus eigenlijk volkomen overbodige fouten)"
                                        ],
