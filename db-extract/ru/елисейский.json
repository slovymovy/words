                "translations": [
                    {
                        "translation_id": "e87613cc-b965-4f02-b306-3914eb0ec92f",
                        "source_entry_id": "83a60d69-0f79-347f-836f-20c6b79f8321",
                        "source_sense_id": "4bbd3db9-5e87-3d40-9f60-2988a8c05b2c",
                        "target_lang_word": "Elysian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Elysian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1d8f5e5d-3735-3eb4-92e6-19cb6e7b238f",
                                        "entry_id": "d3bca276-8bc8-3ef2-ba3b-c4aabe842fe9",
                                        "glosses": [
                                            "Elysium (“the home of the blessed after death”)."
                                        ],
