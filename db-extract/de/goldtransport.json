                                "sense_id": "2bd33051-0f14-309b-9b80-8498c1988f72",
                                "text": "„Die Bundesbank will die Goldtransporte aus den Tresoren der US-Notenbank Fed nach Deutschland deutlich erhöhen.“"
                            }
