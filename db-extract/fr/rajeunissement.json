                                    {
                                        "sense_id": "cfbce5ea-62c5-3965-b0ea-1256c3406594",
                                        "entry_id": "74606fa2-b726-3de3-af69-54ab65f91b42",
                                        "glosses": [
                                            "The process of rendering young again."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4a87833-b471-4873-afdd-7bf4d3b0070d",
                                                "sense_id": "cfbce5ea-62c5-3965-b0ea-1256c3406594",
                                                "text": "Utnapishtim hears his wife's plea and tells Gilgamesh where he can find a miraculous plant of invigoration and rejuvenation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60e9d07c-c7ed-38ce-8e04-4e9aa463d3b3",
                                        "entry_id": "74606fa2-b726-3de3-af69-54ab65f91b42",
                                        "glosses": [
                                            "The process of producing beneficial changes."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a516b997-d4ea-44ee-a5f7-824684fbec8b",
                                                "sense_id": "60e9d07c-c7ed-38ce-8e04-4e9aa463d3b3",
                                                "text": "the rejuvenation of the city center"
                                            },
                                            {
                                                "example_id": "96bb4dec-d650-4fa8-9fc5-7aa793030e23",
                                                "sense_id": "60e9d07c-c7ed-38ce-8e04-4e9aa463d3b3",
                                                "text": "The 1987 book British Piers was written at a time when Britain's seaside resorts were perhaps at their lowest ebb, with a groundswell of support for rejuvenation and conservation just beginning."
                                            }
                                        ]
