                    {
                        "translation_id": "4149fac5-c804-4996-9ed4-0534ab680425",
                        "source_entry_id": "400ffd3c-b9e4-32aa-9bac-7567a49a81eb",
                        "source_sense_id": "4de45dc6-369a-300c-8c3a-0b7332ce62de",
