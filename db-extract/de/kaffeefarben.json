                "senses": [
                    {
                        "sense_id": "2c7a3d58-fbd3-380d-889e-3bfa86dcdb89",
                        "entry_id": "afff154f-95f9-3a4b-a952-ebfa82d76fb7",
                        "glosses": [
                            "in einem an Kaffee erinnernden Farbton, die Farbe von Kaffee habend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3f50e67-295f-499d-a790-45decaf98825",
                                "sense_id": "2c7a3d58-fbd3-380d-889e-3bfa86dcdb89",
                                "text": "„In den Abflussrinnen staute sich das Wasser oder bildete Strudel, in denen ein Rückstand von kaffeefarbenem Schaum trieb, eine seifige Lauge, die allerlei hilflos trudelndes Strandgut umrahmte, Treibholz, Flaschen, Netzkorken und die weißen Leiber toter Fische, alles drehte sich träge im Sog des Flusses, der sich entfesselt und leise brodelnd meerwärts wälzte mitsamt seinem Schlamm, seinen Leibeigenen und Toten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
