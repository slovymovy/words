                "senses": [
                    {
                        "sense_id": "73d3e62f-5ca2-358c-a818-bfefc6d808b3",
                        "entry_id": "9131c1d4-c880-367c-b4af-9bbd59c24456",
                        "glosses": [
                            "Zweig der Zoologie, der sich wissenschaftlich mit den Vögeln beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35fd5907-6de5-4aa8-be85-9c5dd36575d9",
                                "sense_id": "73d3e62f-5ca2-358c-a818-bfefc6d808b3",
                                "text": "„Alfred Brehm sei ein Volksaufklärer gewesen, der Kenntnisse aus der Biologie verständlich vermittelt habe, erklärt Brehm-Kenner Dietrich von Knorre. Vater Christian Ludwig Brehm (1787-1864) gelte bis heute als einer der wichtigsten Altmeister der Vogelkunde. Er legte eine Sammlung von Vogelpräparaten an, die bei seinem Tod rund 9000 Stück umfasste.“"
                            },
                            {
                                "example_id": "9041f037-790e-47d5-90e8-8693825ec1e6",
                                "sense_id": "73d3e62f-5ca2-358c-a818-bfefc6d808b3",
                                "text": "„In Friedrichs Bibliothek befanden sich arabische Texte zur Vogelkunde, die er übersetzen ließ und ausgiebig studierte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d05a9df0-3ac6-442e-b2f0-fcbf8ed34c3e",
                        "source_entry_id": "9131c1d4-c880-367c-b4af-9bbd59c24456",
                        "source_sense_id": "73d3e62f-5ca2-358c-a818-bfefc6d808b3",
                        "source_sense_description": "Biologie: Zweig der Zoologie, der sich wissenschaftlich mit den Vögeln beschäftigt",
                        "target_lang_word": "ornithology",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ornithology",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f242e121-e4f0-39b7-af47-62c0469a0e1a",
                                        "entry_id": "b3265d66-0102-3914-b3a6-662ea272f731",
                                        "glosses": [
                                            "The branch of zoology that deals with the scientific study of birds."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08c52368-630e-41c6-b774-08ff1d9a6280",
                                                "sense_id": "f242e121-e4f0-39b7-af47-62c0469a0e1a",
                                                "text": "Gesner says in his Ornithology, that this fact was attested by a great many moderns of his own time, and he even quotes Albert the great, who asserts that he has seen a cock foster chickens."
                                            },
                                            {
                                                "example_id": "41a189d3-c45b-49b2-ad5b-957f35b4d284",
                                                "sense_id": "f242e121-e4f0-39b7-af47-62c0469a0e1a",
                                                "text": "Jerome A. Jackson, an ivory bill specialist at Florida Gulf Coast University in Fort Myers, has now increased the intensity of the discussion in a 15-page article in the current issue of The Auk, a quarterly ornithology journal published by the American Ornithologists' Union."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c186078d-227b-4829-9895-56ee2e04558b",
                        "source_entry_id": "9131c1d4-c880-367c-b4af-9bbd59c24456",
                        "source_sense_id": "73d3e62f-5ca2-358c-a818-bfefc6d808b3",
                        "source_sense_description": "Biologie: Zweig der Zoologie, der sich wissenschaftlich mit den Vögeln beschäftigt",
                        "target_lang_word": "ornithologie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ornithologie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "19a49903-cc31-3153-a2bc-a8c77d98452a",
                                        "entry_id": "5216462c-e947-39e0-8d45-f0e116127cce",
                                        "glosses": [
                                            "Branche de la zoologie consacrée à l’étude des oiseaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4b8c62d-a9e3-4cfb-a00c-33302dce1fc4",
                                                "sense_id": "19a49903-cc31-3153-a2bc-a8c77d98452a",
                                                "text": "L’oncle Jules commença une petite conférence sur les mœurs et coutumes de ces oiseaux, et mon père ajouta quelques renseignements personnels fraîchement extraits du Dictionnaire Larousse. Mais je compris que toute cette ornithologie n’avait d’autres raison que leur désir de ne pas prolonger mon humiliation."
                                            },
                                            {
                                                "example_id": "d1a44d81-dc5a-44cd-b4a9-953f20f54e7e",
                                                "sense_id": "19a49903-cc31-3153-a2bc-a8c77d98452a",
                                                "text": "Brunner qui s’y connaissait autant en ornithologie qu’en théologie ne voyait dans cette silhouette d’oiseau qu’une hirondelle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f13fc6f1-5a7b-3955-8069-16099800f166",
                                        "entry_id": "5216462c-e947-39e0-8d45-f0e116127cce",
                                        "glosses": [
                                            "Ouvrage, traité fait sur cette matière."
                                        ],
                                        "tags": [
