                    }
                ],
                "senses": [
                    {
                        "sense_id": "3e46942a-03b1-3166-af3d-4e0f874be692",
                        "entry_id": "c2322f67-b087-34ca-88ca-6dcc13c6c26f",
                        "glosses": [
                            "Fahrzeug mit Elektromotor"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50349378-3a5b-4494-89b2-9cdfc540c7ed",
                                "sense_id": "3e46942a-03b1-3166-af3d-4e0f874be692",
                                "text": "„Kaufprämien, die mehr Elektrofahrzeuge auf die Straße bringen könnten, haben insbesondere Unionsfraktionschef Volker Kauder und Finanzminister Wolfgang Schäuble, CDU, bislang verhindert.“"
                            },
                            {
                                "example_id": "f7152944-817b-4222-981f-3416e9d87c4c",
                                "sense_id": "3e46942a-03b1-3166-af3d-4e0f874be692",
                                "text": "„So schlägt die Arbeitsgruppe einen Umweltbonus für Elektrofahrzeuge vor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "05c3d8e9-4878-4ba5-b591-921eccbfab66",
                        "source_entry_id": "c2322f67-b087-34ca-88ca-6dcc13c6c26f",
                        "source_sense_id": "3e46942a-03b1-3166-af3d-4e0f874be692",
                        "source_sense_description": "Fahrzeug mit Elektromotor",
                        "target_lang_word": "electric vehicle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "electric vehicle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e7a9304e-92c9-38b5-9899-04f38d1a3c37",
                                        "entry_id": "588c835a-a4a7-3a34-9b37-25c8a07c7c51",
                                        "glosses": [
                                            "A vehicle that uses an electric motor as the means of propulsion; most especially, an e-car or e-truck."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28cf3249-e548-434d-a452-f991e73d4a6e",
                                                "sense_id": "e7a9304e-92c9-38b5-9899-04f38d1a3c37",
                                                "text": "By the middle of the decade, he [Clive Sinclair] had sold his computer businesses and moved on to transportation with the Sinclair C5 electric vehicle, which was designed with a single seat but, bafflingly for as wet and chilly a country as Britain, without a roof."
                                            },
                                            {
                                                "example_id": "bd4e79b2-36f0-4414-8103-1fe53ce6186b",
                                                "sense_id": "e7a9304e-92c9-38b5-9899-04f38d1a3c37",
                                                "text": "His car company, Tesla, controls two-thirds of the multibillion-dollar electric-vehicle market it pioneered and is valued at a cool $1 trillion."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8d49e161-81b7-45d4-a33f-97d92ac79388",
                        "source_entry_id": "c2322f67-b087-34ca-88ca-6dcc13c6c26f",
                        "source_sense_id": "3e46942a-03b1-3166-af3d-4e0f874be692",
                        "source_sense_description": "Fahrzeug mit Elektromotor",
                        "target_lang_word": "pojazd elektryczny",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "3aa333b4-c393-4048-8868-d73c046101ad",
                        "source_entry_id": "c2322f67-b087-34ca-88ca-6dcc13c6c26f",
                        "source_sense_id": "3e46942a-03b1-3166-af3d-4e0f874be692",
                        "source_sense_description": "Fahrzeug mit Elektromotor",
                        "target_lang_word": "электромобиль",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "электромобиль",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f278af61-7cf3-32e9-a8db-cea1b7530843",
                                        "entry_id": "28299494-7e75-3d2c-a264-88a128285b8f",
                                        "glosses": [
                                            "автомобиль, приводимый в движение электродвигателем с питанием от автономного источника электроэнергии, а не двигателем внутреннего сгорания"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3aae4805-d0b2-4a09-82c0-e76d84f4708c",
                                                "sense_id": "f278af61-7cf3-32e9-a8db-cea1b7530843",
                                                "text": "Клуб электриков сообщал о постройке новой аккумуляторной станции для нужд электромобилей…"
                                            },
                                            {
                                                "example_id": "2674fcbd-d0d3-452a-b79e-89073bf64389",
                                                "sense_id": "f278af61-7cf3-32e9-a8db-cea1b7530843",
                                                "text": "Подсчитано, что двухтонный электромобиль с батареей весом около 200 кг и электрической емкостью 25 квт-час может пройти 130–160 километров без перезарядки."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
