                    {
                        "sense_id": "6b11b1cc-4060-3df4-8a6e-f07891286539",
                        "entry_id": "db97d79c-e71b-3623-bcdd-e290174d740a",
                        "glosses": [
                            "kletspraatjes die verteld worden tijdens informele bijeenkomsten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3bb5615d-26e9-40c6-9858-98d5b47774ae",
                                "sense_id": "6b11b1cc-4060-3df4-8a6e-f07891286539",
                                "text": "Dat leraren zich schamen voor hun digitale vaardigheden is in geen enkel onderzoek aangetoond. Borrelpraat dus."
                            },
                            {
                                "example_id": "c045a62f-10b6-4de7-85b3-2919456f2428",
                                "sense_id": "6b11b1cc-4060-3df4-8a6e-f07891286539",
                                "text": "'Achterlijke dakhazen met hun idiote prijzen,' zei hij, het kwam duidelijk recht uit het hart. Het daaropvolgende uur werd gekenmerkt door gezellige borrelpraat en een drinktempo van Joop en Coby waarmee Jeroen en Chantal zich niet konden en wilden meten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d0dd9c58-d1ea-4940-bfd9-5591b3c31a47",
                        "source_entry_id": "db97d79c-e71b-3623-bcdd-e290174d740a",
                        "source_sense_id": "6b11b1cc-4060-3df4-8a6e-f07891286539",
                        "source_sense_description": "kletspraatjes die verteld worden tijdens informele bijeenkomsten",
                        "target_lang_word": "small talk",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "small talk",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c65b635e-5307-377b-b144-927247a8ce70",
                                        "entry_id": "21ec2825-c31c-3941-a699-df6c5ddfbe5a",
                                        "glosses": [
                                            "Idle conversation, typically regarding innocuous or unimportant subjects, usually engaged in at social gatherings out of politeness."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0e367ed-1cef-4430-ac70-cbc1fe48dec9",
                                                "sense_id": "c65b635e-5307-377b-b144-927247a8ce70",
                                                "text": "[T]o the credit of the lady it may be added, that […] without any of the arts of flattery or the gaieties of small talk, he began to be agreeable to her."
                                            },
                                            {
                                                "example_id": "0bc37d08-bda6-4962-9121-48568124799f",
                                                "sense_id": "c65b635e-5307-377b-b144-927247a8ce70",
                                                "text": "If he had a fault as a conversationalist, it was a certain tendency to monotony, a certain lack of sparkle and variety in his small-talk."
                                            },
                                            {
                                                "example_id": "e7b79413-0e0d-4661-8558-93728746015f",
                                                "sense_id": "c65b635e-5307-377b-b144-927247a8ce70",
                                                "text": "Yet for so public a figure, Jackson was socially awkward, inept at small talk and terrified when the distant audience became an adoring mob."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
