                ],
                "senses": [
                    {
                        "sense_id": "36f90f1a-95e4-3b1e-ab99-d736eb3cc63f",
                        "entry_id": "f5c2e6e9-72f7-36d1-9a80-7ae90cea557e",
                        "glosses": [
                            "Cadrer à l’intérieur d’un cadre plus large."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94cab8d3-6631-431b-96e3-fc69ddca9516",
                                "sense_id": "36f90f1a-95e4-3b1e-ab99-d736eb3cc63f",
                                "text": "Il suffit pour cela, en fonction des scènes et des décors, de sous-cadrer à l'intérieur du cadre."
                            },
                            {
                                "example_id": "20411742-56e0-40df-bbd2-348a6da9f88d",
                                "sense_id": "36f90f1a-95e4-3b1e-ab99-d736eb3cc63f",
                                "text": "Et au début des empires primaires, à Sumer, en Egypte, en Chine, en Inde, en Amérinde, lorsque les spécimens hominiens se mirent non seulement à cadrer, mais à tout sous-cadrer, en inventant des écritures intenses pour régler dans le dernier détail leurs flux de poteries, de soldats, de prisonniers, de titulatures, d’arpentages de la terre et du ciel ; jamais hommes et femmes ne furent plus justifiés par l’ordre du monde ; dans leurs images et leurs musiques, mais aussi mot à mot, terme à terme."
                            }
                        ]
                    },
                    {
                        "sense_id": "822ad1a0-a90c-3576-aaa5-2b2f89ca52e3",
                        "entry_id": "f5c2e6e9-72f7-36d1-9a80-7ae90cea557e",
                        "glosses": [
                            "Cadrer plus bas."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cdd06581-fc72-4077-ab61-a4780c4747f9",
                                "sense_id": "822ad1a0-a90c-3576-aaa5-2b2f89ca52e3",
                                "text": "C'est à dire que je m'astreins à « sous-cadrer de qques mm » à la pdvues."
                            }
                        ]
                    }
