                        "glosses": [
                            "mieszkaniec Dubaju; osoba z tego miasta"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64b04f8e-67ff-4670-b1dd-33c42cb80927",
                                "sense_id": "a6e7de08-a403-33a4-87a8-4103aa064e2a",
                                "text": "A jednak, chociaż dubajczycy mówią, że im na nafcie nie zależy i daliby sobie radę bez niej, to kiedy się jedzie wzdłuż brzegu Zatoki z Abu Zabi, przez Dubaj, do szejkanatu Szardża, Adżmanu i dalej: do Umm al-Kajwajn i Ras al-Chajma – można dokładnie obliczyć w jakiej kolejności nafta wytrysnęła z ziemi – i gdzie jej w ogóle nie ma"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
