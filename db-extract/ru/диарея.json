                    },
                    {
                        "translation_id": "64e916ab-8f37-498e-8221-e9941853f12b",
                        "source_entry_id": "5647b775-1226-3d6a-bd3d-737f8be57f22",
                        "source_sense_id": "c35ecb2b-1b21-33a5-9904-e88386804899",
                        "target_lang_word": "diarree",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "diarree",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "a8125c7c-b7d8-3f09-8be8-cb09ac07bf5c",
                                        "entry_id": "2602d5a6-eadb-358c-8b91-9c420ceaf4d7",
                                        "glosses": [
                                            "darmstoornis die dunne ontlasting veroorzaakt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f988d86-13e4-4642-9446-dae6cdf378f4",
                                                "sense_id": "a8125c7c-b7d8-3f09-8be8-cb09ac07bf5c",
                                                "text": "Hij is ziek en heeft al weken diarree."
                                            },
                                            {
                                                "example_id": "f5409722-9e2a-4876-8618-6c9f3d2d168f",
                                                "sense_id": "a8125c7c-b7d8-3f09-8be8-cb09ac07bf5c",
                                                "text": "Overal ter wereld daalt het aantal kinderen dat overlijdt vóór het vijfde levensjaar, maar in Afrika onder de Sahara en Zuid-Azië gaat dat langzamer dan elders in de wereld, vooral door “vermijdbare oorzaken” als ondervoeding, diarree en longontsteking. In 2030 zou de kindersterfte onder de 25 kinderen per jaar moeten zitten, per duizend geboortes. Dat wordt niet gehaald “als overheden, donateurs, bedrijven en internationale organisaties geen extra inspanning leveren”, zegt de organisatie in een persbericht."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9ad2039a-12a3-4444-a789-a8206afb178d",
                        "source_entry_id": "5647b775-1226-3d6a-bd3d-737f8be57f22",
