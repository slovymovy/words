                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "d687d64a-1186-4d3d-801b-39a8f9cd7257",
                        "entry_id": "a445aa42-eb85-3335-a97b-5064ee9b8b71",
                        "tags": [
                            "plural"
                        ],
                        "form": "platitudes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6a73c161-595e-3ebe-a62a-a56f5f5d7146",
                        "entry_id": "a445aa42-eb85-3335-a97b-5064ee9b8b71",
                        "glosses": [
                            "platte of afgezaagde zinsnede"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "916fdc6c-4cd3-4b98-87dd-2b3705c8116d",
                                "sense_id": "6a73c161-595e-3ebe-a62a-a56f5f5d7146",
                                "text": "- Ik begon het gesprek met de platitude 'heb je een vuurtje voor me?'."
                            },
                            {
                                "example_id": "afaa1a82-40dc-4654-a9bd-ef271daf74fa",
                                "sense_id": "6a73c161-595e-3ebe-a62a-a56f5f5d7146",
                                "text": "- De politicus bediende zich van de platitude dat we wel rekening moeten houden met toekomstige generaties."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "416a6058-0333-41eb-93f5-bc39dc260270",
                        "source_entry_id": "a445aa42-eb85-3335-a97b-5064ee9b8b71",
                        "source_sense_id": "6a73c161-595e-3ebe-a62a-a56f5f5d7146",
                        "source_sense_description": "platte of afgezaagde zinsnede",
                        "target_lang_word": "Plattitüde",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Plattitüde",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0492349b-07cc-34a7-bcd8-5bbebbb02894",
                                        "entry_id": "e709ccbc-1971-389c-bd21-9a59015b672c",
                                        "glosses": [
                                            "eine nichtssagende, abgenutzte Aussage oder Redewendung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08dfbfc8-d1ac-4d45-826f-40ade5722e4f",
                                                "sense_id": "0492349b-07cc-34a7-bcd8-5bbebbb02894",
                                                "text": "Der 11. September hat alles verändert: Diese Plattitüde ist fest im amerikanischen politischen Diskurs verwurzelt."
                                            },
                                            {
                                                "example_id": "54db7c10-8fd9-4d86-a09d-c8c2b00ad19c",
                                                "sense_id": "0492349b-07cc-34a7-bcd8-5bbebbb02894",
                                                "text": "„Heinrich hält große Stücke auf solche Plattitüden; Riesenfeld nicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4a869224-948e-42ba-9951-8946efcc4eab",
                        "source_entry_id": "a445aa42-eb85-3335-a97b-5064ee9b8b71",
                        "source_sense_id": "6a73c161-595e-3ebe-a62a-a56f5f5d7146",
                        "source_sense_description": "platte of afgezaagde zinsnede",
                        "target_lang_word": "platitude",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "platitude",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e3b89845-0113-34f9-9d02-d47dbd01902a",
                                        "entry_id": "5915aebe-d917-3c6d-80e5-88e060b6cba4",
                                        "glosses": [
                                            "An often-quoted saying that is supposed to be meaningful but has become unoriginal or hackneyed through overuse."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c5257ac-6f10-48fa-886c-ad2f13a43b3a",
                                                "sense_id": "e3b89845-0113-34f9-9d02-d47dbd01902a",
                                                "text": "Beauty, I suppose, opens the heart, extends the consciousness. It is a platitude, of course."
                                            },
                                            {
                                                "example_id": "2686d31b-6312-4722-b4b1-eb26c64e44eb",
                                                "sense_id": "e3b89845-0113-34f9-9d02-d47dbd01902a",
                                                "text": "Semiramis was the first woman to invent eunuchs and women have had sympathy for them ever since; […] and women can tell them what they can't tell other men. And Ivor, suddenly cheered by laughing at his absurd platitudes, and finding himself by the door, was going from the room."
                                            },
                                            {
                                                "example_id": "77f436cf-b336-4dc7-8a0e-f5a38f84bd12",
                                                "sense_id": "e3b89845-0113-34f9-9d02-d47dbd01902a",
                                                "text": "For most of the past three decades, the natural world was treated almost as an afterthought by world leaders. If discussed at all, it was with platitudes about the need to save polar bears and tigers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e3298d4-aac9-3e5f-9798-0dc7fc177b19",
                                        "entry_id": "5915aebe-d917-3c6d-80e5-88e060b6cba4",
                                        "glosses": [
                                            "A claim that is trivially true, to the point of being uninteresting."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9e668f7-70fd-4933-a117-d85cad1d4158",
                                                "sense_id": "4e3298d4-aac9-3e5f-9798-0dc7fc177b19",
                                                "text": "The synthesis which he helped to effect was so successful that this aspect of his work escaped notice in the last century: all that Britomart stands for was platitude to our fathers. It is platitude no longer."
                                            },
                                            {
                                                "example_id": "de4b1630-d366-42f1-9067-59ba96cffd41",
                                                "sense_id": "4e3298d4-aac9-3e5f-9798-0dc7fc177b19",
                                                "text": "After explaining myself sufficiently, I now offer my own platitude: I believe that the institution of the cabaret has the right to exist only so long as it bears the character of dilettantism and improvisation."
                                            },
                                            {
                                                "example_id": "68d5a969-79f0-4aeb-9447-e5f9e2592232",
                                                "sense_id": "4e3298d4-aac9-3e5f-9798-0dc7fc177b19",
                                                "text": "Indeed, in the ownership scenario the idealization is supported in a much thinner manner: we start with a platitude that characterizes individuals as coowners (that they are de facto seen as either property holders themselves or otherwise as […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5eba65de-7f15-3dc6-a5bb-fe00da294902",
                                        "entry_id": "5915aebe-d917-3c6d-80e5-88e060b6cba4",
                                        "glosses": [
                                            "Flatness; lack of change, activity, or deviation."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51c7bbdc-1728-433f-9f56-6b72e52ca83f",
                                                "sense_id": "5eba65de-7f15-3dc6-a5bb-fe00da294902",
                                                "text": "The former figures the typical prairie landscape-poet who stops at the correction line (which itself literally denies the platitude of flatness) to notice the ever-present wind."
                                            },
                                            {
                                                "example_id": "f1d2c26f-90e1-4a25-8127-78311f2d0603",
                                                "sense_id": "5eba65de-7f15-3dc6-a5bb-fe00da294902",
                                                "text": "With the photograph, we enter into flat death. One day, leaving one of my classes, someone said to me with disdain, \"You talk about death very flatly.\" — As if the horror of Death were not precisely its platitude!"
                                            },
                                            {
                                                "example_id": "faaf02fa-d2c0-4052-be02-9719b428a15f",
                                                "sense_id": "5eba65de-7f15-3dc6-a5bb-fe00da294902",
                                                "text": "Though we do not have a traditional correspondence theory, which sets up a structural similarity relation between statements and facts, we have the truth of sentences determined by word-to-world relations, in particular, relations between linguistic items and objects. This reflects the platitude behind correspondence, but the Tarskian appartatus gives the platitude more substance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42789994-53d8-3e6b-94c5-6f05fab1005b",
                                        "entry_id": "5915aebe-d917-3c6d-80e5-88e060b6cba4",
                                        "glosses": [
                                            "Unoriginality; triteness."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cee009a1-1e7c-45f4-9f5e-b48516559f12",
                                                "sense_id": "42789994-53d8-3e6b-94c5-6f05fab1005b",
                                                "text": "seemly platitude, flat-footed ordinariness, and well-enacted upper working class respectability cancel out any turpitude, exhilarating tension or satanic glamour a casino might be expected to have."
                                            },
                                            {
                                                "example_id": "e8afc7b0-cf9d-4b5a-b498-bb77019ac0dc",
                                                "sense_id": "42789994-53d8-3e6b-94c5-6f05fab1005b",
                                                "text": "After a passage of what we feel to be true poetry, there follows, inevitably, a passage of platitude which no critical pre-judgment can force us to admire;"
                                            },
                                            {
                                                "example_id": "c23c7564-988a-4e99-940c-bfe07381c76d",
                                                "sense_id": "42789994-53d8-3e6b-94c5-6f05fab1005b",
                                                "text": "Of the true steady-going German nature the bane is, as I remarked, flat commonness; there seems no end to its capacity for platitude; it has neither the quick perception of the Celt to save it from platitude, nor the strenuousness of the Norman;"
                                            },
                                            {
                                                "example_id": "4d9617e8-51ac-4812-96b8-5548d9bf0e64",
                                                "sense_id": "42789994-53d8-3e6b-94c5-6f05fab1005b",
                                                "text": "More damning, this 'flat-pack kit' causes us to decline into platitude and predictability, denies us from real political intellectual purchase and, as result, standard theoretical ideas become our ideological comforters."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8ea00a49-9ddc-47a1-bc6a-03dc7e4dc24c",
                        "source_entry_id": "a445aa42-eb85-3335-a97b-5064ee9b8b71",
                        "source_sense_id": "6a73c161-595e-3ebe-a62a-a56f5f5d7146",
                        "source_sense_description": "platte of afgezaagde zinsnede",
                        "target_lang_word": "platitude",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "platitude",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1ea869c1-d262-3b23-b227-83d448adab94",
                                        "entry_id": "1e2d4e3c-fe2a-3fa2-ae28-7fa9425b61b2",
                                        "glosses": [
                                            "Ce qui est plat."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f28d339-913d-4308-90b5-4625470022dc",
                                                "sense_id": "1ea869c1-d262-3b23-b227-83d448adab94",
                                                "text": "De place en place, une dune ressort sur cette platitude, donnant sa note propre avec ses grands pignons ou ses buissons de tamaris, seuls à résister au vent de la côte, et parfois de véritables bois comme cette extraordinaire génévraie des Bièges."
                                            },
                                            {
                                                "example_id": "0220338f-d3cf-4092-b2d2-989272f73e77",
                                                "sense_id": "1ea869c1-d262-3b23-b227-83d448adab94",
                                                "text": "D’après ses propres calculs, l’engin devrait être en mesure de monter à une altitude de cinq cent cinquante mètres, une altitude suffisante de son point de vue pour prouver la platitude de notre planète."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7d1e295-13e4-34b3-a8cf-086158c15544",
                                        "entry_id": "1e2d4e3c-fe2a-3fa2-ae28-7fa9425b61b2",
                                        "glosses": [
                                            "Caractère de ce qui est plat, sans relief, qui manque de caractère."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "128b6d6e-078e-46fd-a108-acdefd3cf3bc",
                                                "sense_id": "b7d1e295-13e4-34b3-a8cf-086158c15544",
                                                "text": "Comme pour Joe Biden présentement, sa platitude lui procurait un statut de valeur sûre pour qui espérait seulement un retour à la tranquillité."
                                            },
                                            {
                                                "example_id": "175447b4-56f2-4f1f-bb97-a591d0cfeb9f",
                                                "sense_id": "b7d1e295-13e4-34b3-a8cf-086158c15544",
                                                "text": "Ce discours, ce livre est de la dernière platitude."
                                            },
                                            {
                                                "example_id": "b887a5d4-3d0a-439d-83c3-c0f7172873a3",
                                                "sense_id": "b7d1e295-13e4-34b3-a8cf-086158c15544",
                                                "text": "La platitude de son style me dégoûte."
                                            },
                                            {
                                                "example_id": "bca4911d-d452-426d-81a2-e0338a78479e",
                                                "sense_id": "b7d1e295-13e4-34b3-a8cf-086158c15544",
                                                "text": "Sa conduite a été d’une platitude révoltante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ddb22adc-aacd-37e3-81ed-5a1ed28d3e53",
                                        "entry_id": "1e2d4e3c-fe2a-3fa2-ae28-7fa9425b61b2",
                                        "glosses": [
                                            "Caractère de ce qui est plat, sans relief, qui manque de caractère.",
                                            "Par rapport à la sensation, absence de goût."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9db9152-aa7b-442f-90be-1706fd07fe55",
                                                "sense_id": "ddb22adc-aacd-37e3-81ed-5a1ed28d3e53",
                                                "text": "Ce vin est d’une platitude extrême."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58c87458-0c50-3cb8-a585-6a841e930c0a",
                                        "entry_id": "1e2d4e3c-fe2a-3fa2-ae28-7fa9425b61b2",
                                        "glosses": [
                                            "Idées ou paroles banales."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2657269-a1c7-40e2-a237-e09cdd70ceb5",
                                                "sense_id": "58c87458-0c50-3cb8-a585-6a841e930c0a",
                                                "text": "L'auteur ne tombe pas dans les platitudes communes de la publiphobie ; il nous amène à connaître les mécanismes psychologiques et les facteurs sociaux de la publicité, envers laquelle d'ailleurs il ne montre nulle complaisance."
                                            },
                                            {
                                                "example_id": "d1a38e93-02ec-4ec0-8efa-db5f3b579741",
                                                "sense_id": "58c87458-0c50-3cb8-a585-6a841e930c0a",
                                                "text": "Dans son école, deux à trois heures par semaine restent consacrées à l’étude du Roukhnama, le recueil de platitudes morales compilées par Saparmourad Niazov."
                                            },
                                            {
                                                "example_id": "9525b582-64e9-4708-b78a-ff9cf099d613",
                                                "sense_id": "58c87458-0c50-3cb8-a585-6a841e930c0a",
                                                "text": "Nous les appelons \"préjugés négatifs\", car ils contribuent à la perte de rationalité et à la consécration de la platitude dans l'interprétation et la traduction des textes africains en général et égyptiens en particulier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6295643a-278f-3412-87e3-48a57ba07807",
                                        "entry_id": "1e2d4e3c-fe2a-3fa2-ae28-7fa9425b61b2",
                                        "glosses": [
                                            "Servilité, bassesse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5291bbbf-8518-4d3d-8da5-00f0c8ab272e",
                                                "sense_id": "6295643a-278f-3412-87e3-48a57ba07807",
                                                "text": "— Toi, Martin, tu es mon secrétaire particulier. Je t’appellerai tour à tour : « Martin ! », « mon cher Martin ! » ou « mon cher ami ! » Tu répondras : « Monsieur le Ministre ! » avec plus de platitude encore que ces messieurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b5d20ca-543e-3156-8a3f-425c79af718d",
                                        "entry_id": "1e2d4e3c-fe2a-3fa2-ae28-7fa9425b61b2",
                                        "glosses": [
                                            "Surface plane destinée à permettre l'assemblage à l'équerre de trois pièces de tissu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c213855f-1e88-4254-a269-03fcd1c74d5d",
                                                "sense_id": "9b5d20ca-543e-3156-8a3f-425c79af718d",
                                                "text": "Pour le col, on choisit une valeur de platitude d'un centimètre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
