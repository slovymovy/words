                                        "entry_id": "774d39a4-c9de-3f19-9739-f0f6f3ffc13f",
                                        "glosses": [
                                            "Zusammenfassung mehrerer Verse zu einer (Sinn-)Einheit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40f3368f-312d-4429-8a60-1172605e5db4",
                                                "sense_id": "1c48f24b-ef44-3251-8b73-829fc63fabf7",
                                                "text": "Schillers „Das Lied von der Glocke“ zählt neunzehn Strophen."
                                            },
                                            {
                                                "example_id": "a18b9f66-61bb-4c72-ab19-eec0d3e4eae4",
                                                "sense_id": "1c48f24b-ef44-3251-8b73-829fc63fabf7",
                                                "text": "„Er trat während der ersten Strophe neben das Bild des amtierenden Staatspräsidenten, das in jedem Klassenzimmer neben dem Kruzifix hängen musste, und salutierte bei der letzten Strophe.“"
                                            },
                                            {
                                                "example_id": "fbf25276-efaa-40ba-aa5e-de8c2f67b0a1",
                                                "sense_id": "1c48f24b-ef44-3251-8b73-829fc63fabf7",
                                                "text": "„Über drei weitere Strophen zieht sich diese liebe Betrachtung im selben Metrum und treibt uns weiter.“"
                                            },
                                            {
                                                "example_id": "cf74efc4-dc20-4458-93c1-7cb229234af4",
                                                "sense_id": "1c48f24b-ef44-3251-8b73-829fc63fabf7",
                                                "text": "„Unsre hoch oben stehenden Freunde horchten weiter, aber es blieb bei dieser Strophe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
