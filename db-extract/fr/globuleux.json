                "senses": [
                    {
                        "sense_id": "55f3634c-0ae9-3237-9fd3-cc6c0c2f0e98",
                        "entry_id": "7c8704e6-82a1-3c02-bff7-9088ee592f7a",
                        "glosses": [
                            "Qui est composé de globules."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6dc0c8ff-24c1-44b1-8c3b-0e3c29e18f5c",
                                "sense_id": "55f3634c-0ae9-3237-9fd3-cc6c0c2f0e98",
                                "text": "Matière globuleuse."
                            }
                        ]
                    },
                    {
                        "sense_id": "3007f5a4-2fe0-31d7-b764-a0577b25d4d9",
                        "entry_id": "7c8704e6-82a1-3c02-bff7-9088ee592f7a",
                        "glosses": [
                            "Qui a la forme d’un globule, sphérique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c360ff79-fc4d-4dc8-8089-ded295023c79",
                                "sense_id": "3007f5a4-2fe0-31d7-b764-a0577b25d4d9",
                                "text": "Quand on parvient à évulser adroitement, quand on désenchatonne le globe oculaire de dessous la cornée transparente qui l’abrite, on constate que la rétine qui en fait la masse a une forme ovoïde, de globuleuse qu’elle devait être avant l’énucléation."
                            },
                            {
                                "example_id": "0166bed8-0172-4d01-85a5-773ca58fc3f4",
                                "sense_id": "3007f5a4-2fe0-31d7-b764-a0577b25d4d9",
                                "text": "Il lut la terreur dans l’œil globuleux des bovins préposés à l'attelage et appuya derechef sur les pédales pour fuir le courroux du cocher à chapeau de paille."
                            },
                            {
                                "example_id": "d9d8dd0a-59e7-48c0-8f02-99fb9c66caee",
                                "sense_id": "3007f5a4-2fe0-31d7-b764-a0577b25d4d9",
                                "text": "Cette grosse fille lève au plafond ses yeux globuleux et pose sur l’autel une main de pâtissière."
                            },
                            {
                                "example_id": "a145f98c-3685-4aff-8160-bca876482a17",
                                "sense_id": "3007f5a4-2fe0-31d7-b764-a0577b25d4d9",
                                "text": "Je vais me déplacer du point A au point B à la vitesse de la lumière, sous vos yeux incrédules et globuleux!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "25d2f13c-55e6-4519-9555-09ef8d82a023",
                        "source_entry_id": "7c8704e6-82a1-3c02-bff7-9088ee592f7a",
                        "target_lang_word": "globular",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "globular",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "27e85ee5-639d-332d-97fe-82e6ed7f7346",
                                        "entry_id": "a6d5a740-ff32-30c5-8dc8-922f4af4fc08",
                                        "glosses": [
                                            "Roughly spherical in shape; globe-shaped."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16a7bf12-117d-4953-b2c2-be6a2e16037b",
                                                "sense_id": "27e85ee5-639d-332d-97fe-82e6ed7f7346",
                                                "text": "\"Nary a spot,\" interrupted E. R. Coglan, flippantly. \"The terrestrial, globular, planetary hunk of matter, slightly flattened at the poles, and known as the Earth, is my abode.[…]\""
                                            },
                                            {
                                                "example_id": "6440235a-9984-48e9-9a4d-d9dee2343acf",
                                                "sense_id": "27e85ee5-639d-332d-97fe-82e6ed7f7346",
                                                "text": "Podson's globular stare assured any woman that the bargain was sacred. It was solemn, intent, opaque; it was also slightly mesmeric, which is to say that it gave out everything and took in nothing."
                                            },
                                            {
                                                "example_id": "6997024f-84e2-4562-8756-09038aca7663",
                                                "sense_id": "27e85ee5-639d-332d-97fe-82e6ed7f7346",
                                                "text": "Globular lights, painted a dark green, hang from under the fancy iron eaves, unlit for centuries . . ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16448a32-5a6e-3eb2-aa0d-464fbc69779d",
                                        "entry_id": "a6d5a740-ff32-30c5-8dc8-922f4af4fc08",
                                        "glosses": [
                                            "Comprising globules."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
