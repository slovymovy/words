                "senses": [
                    {
                        "sense_id": "a4e6a07a-2a7b-3f1d-8fb4-10a00c602095",
                        "entry_id": "87fd6712-ed94-33a5-a43e-a19a15ce7a2d",
                        "glosses": [
                            "Substance amère, jaune citron extraite de la bourdaine (Frangula alnus) de la classe des glycosides de l’anthraquinone, utilisée pour ses propriétés laxatives, et dont on a isolé plusieurs isoformes.→ voir franguloside"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "c32007c8-b85d-402e-b5f6-d2aec499e23d",
                                "sense_id": "a4e6a07a-2a7b-3f1d-8fb4-10a00c602095",
                                "text": "La franguline est une anthraquinone ayant pour formule brute C₂₁H₂₀O₉."
                            },
                            {
                                "example_id": "34d19bd1-e5d4-4814-9ff7-2d2f86610620",
                                "sense_id": "a4e6a07a-2a7b-3f1d-8fb4-10a00c602095",
                                "text": "Les isoformes de la franguline diffèrent entre autres par la nature du glucide lié au noyau anthraquinone: ainsi, la franguline A est substituée par un résidu rhamnose, tandis que la franguline B est liée à un résidu d’apiose."
                            },
                            {
                                "example_id": "daf16d79-2a66-4fe1-980f-7f227d217849",
                                "sense_id": "a4e6a07a-2a7b-3f1d-8fb4-10a00c602095",
                                "text": "En 1849, Binwanger en retirait une substance colorante jaune appelée plus tard par Buchner rhamnoxanthine et par Casselmann franguline."
                            }
                        ]
                    }
                ],
