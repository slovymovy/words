                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "террористка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "bd85f7b0-414e-33ed-b85e-050453f23d3c",
                                        "entry_id": "ed385807-a151-3bd4-9b2c-9372516c96ec",
                                        "glosses": [
                                            "женск. к террорист; женщина, совершающая или планирующая совершить террористический акт"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90c7bf5e-0bf9-4cc5-9d44-d1b146e49020",
                                                "sense_id": "bd85f7b0-414e-33ed-b85e-050453f23d3c",
                                                "text": "Потом они спросили обо мне и с ужасом узнали, что я террористка и приговорена к восьми годам тюремного заключения."
                                            },
                                            {
                                                "example_id": "f92642e8-0ee6-40dd-bc4d-121b80fb0053",
                                                "sense_id": "bd85f7b0-414e-33ed-b85e-050453f23d3c",
                                                "text": "Сотрудница петрозаводского кинотеатра «Мираж» приняла посетительницу-мусульманку за террористку и выгнала её из кинозала."
                                            },
                                            {
                                                "example_id": "ba993206-e7d6-4801-8de0-1d0a0a5ffeff",
                                                "sense_id": "bd85f7b0-414e-33ed-b85e-050453f23d3c",
                                                "text": "Несостоявшуюся террористку задержали и отправили в изолятор ФСБ «Лефортово»."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
