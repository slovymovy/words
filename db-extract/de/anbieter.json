                    }
                ],
                "senses": [
                    {
                        "sense_id": "20f2a37e-8e80-3731-9941-87d5ae24189c",
                        "entry_id": "800d12ec-a532-38ec-9ce7-4a3d0c1f0588",
                        "glosses": [
                            "jemand, der etwas anbietet; jemand, der eine Ware oder Dienstleistung gegen Bezahlung zur Verfügung stellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29045b40-bfbe-4ea6-a9d8-c122f6affbe6",
                                "sense_id": "20f2a37e-8e80-3731-9941-87d5ae24189c",
                                "text": "Nirgendwo ist der Preisvergleich so schnell und einfach wie im Internet: Datenbanken suchen den günstigsten Anbieter für ein Produkt."
                            },
                            {
                                "example_id": "e84575c9-e6e3-43ba-8676-82eef1741070",
                                "sense_id": "20f2a37e-8e80-3731-9941-87d5ae24189c",
                                "text": "„Dementsprechend wichtig ist es, einen versierten Finanzierungsberater an der Seite zu haben, der nicht nur weiß, worauf es den Anbietern besonders ankommt, sondern der durch seine Erfahrung auch manchen Kniff kennt, der das Vorhaben günstig und schnell wahr werden lässt.“"
                            },
                            {
                                "example_id": "9e3df487-efa1-4c06-bd4a-3b20b68ed9b3",
                                "sense_id": "20f2a37e-8e80-3731-9941-87d5ae24189c",
                                "text": "„Der Markt für Wallboxen ist insgesamt recht unübersichtlich, es gibt eine Vielzahl von Anbietern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b708c9a5-ab3e-4858-8d1c-a8796dbc1d9d",
                        "source_entry_id": "800d12ec-a532-38ec-9ce7-4a3d0c1f0588",
                        "source_sense_id": "20f2a37e-8e80-3731-9941-87d5ae24189c",
                        "source_sense_description": "jemand, der eine Ware oder Dienstleistung gegen Bezahlung zur Verfügung stellt",
                        "target_lang_word": "provider",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "provider",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "120dc7cd-2b06-3e75-956c-49c3def508b1",
                                        "entry_id": "3837f502-8bb0-3b27-ad24-5fbdb9d223fc",
                                        "glosses": [
                                            "One who, or that which, provides a service, commodity, or the means for subsistence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9590e751-3c32-4dd2-98cd-60ed31ae9d69",
                                                "sense_id": "120dc7cd-2b06-3e75-956c-49c3def508b1",
                                                "text": "In view of this, it is clear why internet service providers (ISPs) are inclined to play a backbench role when it comes to combating file sharing."
                                            },
                                            {
                                                "example_id": "39a52648-d6d9-4a32-a159-54b067de78d8",
                                                "sense_id": "120dc7cd-2b06-3e75-956c-49c3def508b1",
                                                "text": "Using BLE, a merchant or other provider can define more targeted \"micro-locations\" to trigger an alert, in some cases requiring that you be in the presence of an iBeacon in order to validate a Passbook entry."
                                            },
                                            {
                                                "example_id": "c47927e8-660e-4c92-943a-a7431b57ca84",
                                                "sense_id": "120dc7cd-2b06-3e75-956c-49c3def508b1",
                                                "text": "Even if policy shifts resources away from hard investment and back into social spending, the \"Floridization\" of Chinese demographics will intensify the shortage of healthcare provision over the next decade, worsening the frayed contract between patients, providers, and the government."
                                            },
                                            {
                                                "example_id": "d7205103-73a7-4e4f-bf15-2fcfb087dd4e",
                                                "sense_id": "120dc7cd-2b06-3e75-956c-49c3def508b1",
                                                "text": "A part of the nervousness at Chelsea involves whether any more sponsors will follow the telecommunications and internet service provider Three in withdrawing support, at least temporarily."
                                            },
                                            {
                                                "example_id": "c15f9fbb-fd47-449e-9a7a-c12e7642c0b4",
                                                "sense_id": "120dc7cd-2b06-3e75-956c-49c3def508b1",
                                                "text": "Both switching costs and network effects tend to lead to enshittification because platform providers see early adopters as an investment in future profits."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "444c0aee-af90-4027-8d60-cd8aae6e3db8",
                        "source_entry_id": "800d12ec-a532-38ec-9ce7-4a3d0c1f0588",
                        "source_sense_id": "20f2a37e-8e80-3731-9941-87d5ae24189c",
                        "source_sense_description": "jemand, der eine Ware oder Dienstleistung gegen Bezahlung zur Verfügung stellt",
                        "target_lang_word": "supplier",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "supplier",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e5f56d3a-d87b-385d-8d8e-ff4511aabead",
                                        "entry_id": "0ca8105c-1b84-3e88-b29c-bf2ac0e20dc9",
                                        "glosses": [
                                            "One who supplies; a provider."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "440f323d-6d68-401e-92ae-80aceb40c911",
                                                "sense_id": "e5f56d3a-d87b-385d-8d8e-ff4511aabead",
                                                "text": "A farmer could place an order for a new tractor part by text message and pay for it by mobile money-transfer. A supplier many miles away would then take the part to the local matternet station for airborne dispatch via drone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1138d01b-0139-3bdc-aeb4-3ce49beb6bc7",
                                        "entry_id": "0ca8105c-1b84-3e88-b29c-bf2ac0e20dc9",
                                        "glosses": [
                                            "Someone who assists (sets up) a goal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea4c8a3f-3323-4190-8532-d63cddeb86c3",
                                                "sense_id": "1138d01b-0139-3bdc-aeb4-3ce49beb6bc7",
                                                "text": "Regular supplier Barton played in another teasing corner, which was headed on towards goal by the impressive Ameobi and flicked in by expert poacher Nolan."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b09143e0-8e0e-4385-adda-fff54cbcd7b0",
                        "source_entry_id": "800d12ec-a532-38ec-9ce7-4a3d0c1f0588",
                        "source_sense_id": "20f2a37e-8e80-3731-9941-87d5ae24189c",
                        "source_sense_description": "jemand, der eine Ware oder Dienstleistung gegen Bezahlung zur Verfügung stellt",
                        "target_lang_word": "fournisseur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fournisseur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a8cb98b7-910f-3f05-b16e-63a98e516148",
                                        "entry_id": "d7909a79-6e94-3343-9a17-2f82f18c3c98",
                                        "glosses": [
                                            "Celui, entreprise ou particulier, qui entreprend de faire la fourniture de marchandises, de denrées ou celui chez qui on se les procure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e93ea839-fe26-458e-8a2d-32feb99a17b4",
                                                "sense_id": "a8cb98b7-910f-3f05-b16e-63a98e516148",
                                                "text": "Un riche propriétaire, M. Roudier, au visage grassouillet et insinuant, y discourait des heures entières, avec la passion d’un orléaniste que la chute de Louis-Philippe avait dérangé dans ses calculs. C’était un bonnetier de Paris retiré à Plassans, ancien fournisseur de la cour, qui avait fait de son fils un magistrat, comptant sur les Orléans pour pousser ce garçon aux plus hautes dignités."
                                            },
                                            {
                                                "example_id": "fc42e1b7-c8cc-4850-96f1-01910bc0626a",
                                                "sense_id": "a8cb98b7-910f-3f05-b16e-63a98e516148",
                                                "text": "Je le crois bien, dit Henri, quand on est comme vous le fournisseur de toutes les têtes couronnées de France et de l’étranger."
                                            },
                                            {
                                                "example_id": "5eb9243d-ed70-4905-8d4f-eb9b391e5e25",
                                                "sense_id": "a8cb98b7-910f-3f05-b16e-63a98e516148",
                                                "text": "Le soir, chacun se récria sur la qualité de ces grosses dattes entourées de sirop. Mounira elle-même les déclara plus exquises que celles des grands fournisseurs."
                                            },
                                            {
                                                "example_id": "96b53b45-a140-4bc3-9476-fb8e9411fe76",
                                                "sense_id": "a8cb98b7-910f-3f05-b16e-63a98e516148",
                                                "text": "— Un crétin chimiquement pur… je me demande où tu vas le chercher ?\n— Quai des Orfèvres. Je suis fidèle à mes fournisseurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71a078d4-cfce-3b1c-b595-8e0ae7a81f7c",
                                        "entry_id": "d7909a79-6e94-3343-9a17-2f82f18c3c98",
                                        "glosses": [
                                            "Celui qui fournit et qui monte des sabres, des épées."
                                        ],
                                        "tags": [
                                            "dated",
                                            "especially"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "091ea17d-20bd-4890-831c-b011bd800d7f",
                        "source_entry_id": "800d12ec-a532-38ec-9ce7-4a3d0c1f0588",
                        "source_sense_id": "20f2a37e-8e80-3731-9941-87d5ae24189c",
                        "source_sense_description": "jemand, der eine Ware oder Dienstleistung gegen Bezahlung zur Verfügung stellt",
                        "target_lang_word": "παροχέας",
                        "target_lang_code": "el",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "παροχέας",
                                "target_lang_code": "el",
                                "target_senses": [
                                    {
                                        "sense_id": "7d1aa565-275e-31e1-8601-a95226415bad",
                                        "entry_id": "89a5ea75-c54f-3ef0-a621-c8e4f3086d1a",
                                        "glosses": [
                                            "άλλη μορφή του πάροχος, μορφή με κατάληξη δημοτικής του παροχεύς. Η λέξη βρίσκεται σε χρήση στην Κύπρο, αλλά έχει σπάνια χρήση στην Ελλάδα, όπου έχει καθιερωθεί θεσμικά η λέξη πάροχος"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f00ce763-05f7-4409-912e-67a0d4ea6d4e",
                                                "sense_id": "7d1aa565-275e-31e1-8601-a95226415bad",
                                                "text": "※ (Κύπρος, νόμος) Ο παροχέας υπηρεσιών πιστοποίησης, που εκδίδει αναγνωρισμένο πιστοποιητικό στο κοινό ή εγγυάται για την ακρίβεια τέτοιου πιστοποιητικού, ευθύνεται έναντι οποιουδήποτε φορέα ή φυσικού ή νομικού προσώπου, για την ζημία που προκλήθηκε σε βάρος του επειδή το πρόσωπο αυτό ευλόγα βασίσθηκε στο πιστοποιητικό, όσον αφορά: (Ο Περί του Νομικού Πλαισίου για τις Ηλεκτρονικές Υπογραφές καθώς και για Συναφή Θέματα Νόμος του 2004 (188(I)/2004), Παγκύπριος Δικηγορικός Σύλλογος, 2004 https://www.cylaw.org/nomoi/enop/ind/2004_1_188/section-scc89517ee-5bbe-2c72-bca9-c60da9782d4e.html)"
                                            },
                                            {
                                                "example_id": "24164ff4-2e28-404f-8902-f1f2c1986a29",
                                                "sense_id": "7d1aa565-275e-31e1-8601-a95226415bad",
                                                "text": "※ (Κύπρος, ειδήσεις) ο Διευθύνων Σύμβουλος του Ομίλου Ελληνικά Πετρέλαια Γρηγόρης Στεργιούλης, εξέφρασε τη βεβαιότητα πως ο επόμενος παροχέας φυσικού αερίου προς την Ευρώπη θα προέρχεται από τα κοιτάσματα Ισραήλ, Κύπρου και Αιγύπτου. (Κυβέρνηση και πετρελαϊκοί κολοσσοί, υπογράφουν αύριο συμβόλαια για τον 3ο γύρο, alphanews, 04/04/2017 https://www.alphanews.live/politics/kyvernisi-kai-petrelaikoi-kolossoi-ypografoun-avrio-symvolaia-gia-ton-3o-gyro/"
                                            },
                                            {
                                                "example_id": "7d84ac9d-f8e4-4d4e-931c-627a1bcd8fc4",
                                                "sense_id": "7d1aa565-275e-31e1-8601-a95226415bad",
                                                "text": "※ (Κύπρος, ειδήσεις / πρόταση νόμου) σύμφωνα με την πρόταση νόμου ο παροχέας θα συλλέγει τα στοιχεία του συνδρομητή, όταν πρόκειται για φυσικό πρόσωπο, όπως ονοματεπώνυμο και αριθμό ταυτότητας, ενώ σημείωσε ότι όταν πρόκειται για εταιρεία, θα συλλέγονται η επωνυμία και ο αριθμός εγγραφής της συγκεκριμένης εταιρείας (Ταυτοποίηση των κατόχων καρτών προπληρωμένης κινητής τηλεφωνίας, ΑΝΤ1 Κύπρος, 02/04/2015 https://www.ant1live.com/arheio/203748_taytopoiisi-ton-katohon-karton-propliromenis-kinitis-tilefonias)"
                                            },
                                            {
                                                "example_id": "f348079d-3ab2-4010-a1ac-a4188767a8fb",
                                                "sense_id": "7d1aa565-275e-31e1-8601-a95226415bad",
                                                "text": "※ (Ελλάδα, μοναδική χρήση σε νόμο) Καθορισμός όρων και προϋποθέσεων για την έκδοση Άδειας Παροχέα Καταδυτικών υπηρεσιών Αναψυχής (ΦΕΚ 931 Β΄ - 18.03.2020/Απόφαση Αριθμ. Δ1α/ΓΠ.οικ.19420, 2020)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c1a7edba-5148-437a-9315-d884dd4d4ac9",
                        "source_entry_id": "800d12ec-a532-38ec-9ce7-4a3d0c1f0588",
