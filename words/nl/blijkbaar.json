                        {
                            "text": "Zij heeft <w>blijkbaar</w> te veel gedronken want ze kan niet meer recht lopen.",
                            "target_lang_translations": {
                                "en": "She has <w>apparently</w> drunk too much because she can no longer walk straight.",
                                "ru": "Она, <w>по-видимому</w>, слишком много выпила, потому что больше не может идти прямо.",
                                "pl": "Ona <w>najwyraźniej</w> wypiła za dużo, bo nie może już prosto chodzić.",
                                "de": "Sie hat <w>anscheinend</w> zu viel getrunken, denn sie kann nicht mehr geradeaus laufen.",
                                "fr": "Elle a <w>apparemment</w> trop bu car elle ne peut plus marcher droit.",
                                "it": "Lei ha <w>apparentemente</w> bevuto troppo perché non riesce più a camminare dritta.",
                                "cs": "Zřejmě <w>pila</w> příliš mnoho, protože už nedokáže jít rovně.",
                                "tr": "<w>Görünüşe göre</w> çok fazla içmiş çünkü artık düz yürüyemiyor.",
                                "es": "Ella <w>aparentemente</w> ha bebido demasiado, porque ya no puede caminar derecho.",
                                "zh": "她<w>显然</w>喝多了，因为她已经走不稳直线了。"
                            }
                        },
                        {
                            "text": "Het is <w>blijkbaar</w> verboden om hier te parkeren aangezien iedereen een boete krijgt.",
                            "target_lang_translations": {
                                "en": "It is <w>evidently</w> forbidden to park here since everyone is getting a fine.",
                                "ru": "Здесь, <w>очевидно</w>, запрещено парковаться, так как все получают штраф.",
                                "pl": "Parkowanie tutaj jest <w>najwyraźniej</w> zabronione, skoro wszyscy dostają mandat.",
                                "de": "Es ist <w>offensichtlich</w> verboten, hier zu parken, da jeder einen Strafzettel bekommt.",
                                "fr": "Il est <w>visiblement</w> interdit de se garer ici puisque tout le monde reçoit une amende.",
                                "it": "È <w>evidentemente</w> vietato parcheggiare qui, dato che tutti ricevono una multa.",
                                "cs": "Zde je <w>zřejmě</w> zakázáno parkovat, protože všichni dostávají pokutu.",
                                "tr": "<w>Anlaşılan</w> buraya park etmek yasak çünkü herkes ceza yiyor.",
                                "es": "Está <w>evidentemente</w> prohibido aparcar aquí, ya que todos están recibiendo una multa.",
                                "zh": "这里<w>看来</w>是禁止停车的，因为每个人都收到了罚单。"
                            }
                        }
