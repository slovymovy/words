                "senses": [
                    {
                        "sense_id": "286b6f55-1862-3b16-a541-089d42bd08be",
                        "entry_id": "702dfdfb-a0e6-3ba9-8814-b056987eda1e",
                        "glosses": [
                            "British and Canada standard spelling of clamor."
                        ],
                        "tags": [
                            "Canada",
                            "UK",
                            "alt-of",
                            "standard"
                        ],
                        "examples": [
                            {
                                "example_id": "64b01c63-5a85-41e0-b4d4-000ee9c8932f",
                                "sense_id": "286b6f55-1862-3b16-a541-089d42bd08be",
                                "text": "The second argument , against the integrity of the Law from this Omission , has been clamoured by a large Body of Answerers"
                            }
                        ]
                    },
                    {
                        "sense_id": "11f75c1d-74b6-36c7-95c8-2fde4a4f15d9",
                        "entry_id": "702dfdfb-a0e6-3ba9-8814-b056987eda1e",
                        "glosses": [
                            "To salute loudly."
                        ],
                        "tags": [
                            "obsolete",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "0b5d01e7-bf1b-4abd-8cf6-2d2018b3a39b",
                                "sense_id": "11f75c1d-74b6-36c7-95c8-2fde4a4f15d9",
                                "text": "At ſight of him the people with a ſhout / Rifted the Air clamouring thir god with praiſe,"
                            }
                        ]
                    },
                    {
                        "sense_id": "3b6cf585-7f89-337b-b4fe-b72829a5cf90",
                        "entry_id": "702dfdfb-a0e6-3ba9-8814-b056987eda1e",
                        "glosses": [
                            "To stun with noise."
                        ],
                        "tags": [
                            "obsolete",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "90eccb22-60cc-4407-a2e0-0511e4e14938",
                                "sense_id": "3b6cf585-7f89-337b-b4fe-b72829a5cf90",
                                "text": "Let them not come..in a Tribunitious Manner; For that is, to clamour Counsels, not to enforme them."
                            }
                        ]
                    },
                    {
                        "sense_id": "925955b0-1d2d-3307-9c0e-8474c54e6cfe",
                        "entry_id": "702dfdfb-a0e6-3ba9-8814-b056987eda1e",
                        "glosses": [
                            "To repeat the strokes quickly on (bells) so as to produce a loud clang."
                        ],
