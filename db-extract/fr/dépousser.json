                ],
                "senses": [
                    {
                        "sense_id": "e0ccf2df-f002-3aa2-a102-1df9f1e7ab1d",
                        "entry_id": "0a54b527-73ee-3749-8106-cbe7b50355a9",
                        "glosses": [
                            "Pousser pour éloigner."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "a20d518c-34e7-408b-ace4-b0ddfe4742db",
                                "sense_id": "e0ccf2df-f002-3aa2-a102-1df9f1e7ab1d",
                                "text": "L'armement et les vivres des embarcations furent vérifiés ; les espars, pour dépousser les glaces, dégagés de la drome et répartis sur le pont."
                            },
                            {
                                "example_id": "cb3f2e0d-45a8-4588-bc58-70aa92798cb9",
                                "sense_id": "e0ccf2df-f002-3aa2-a102-1df9f1e7ab1d",
                                "text": "Après une bonne heure d'efforts épuisants à chercher avec gaffes et avirons à nous dépousser sur ses flancs lisses, glissants et mouvants, nous sommes parvenus à nous éloigner, couverts d'une couche de glace."
                            }
                        ]
                    },
                    {
                        "sense_id": "5aa242d9-3d98-396f-916f-3fb408757eca",
                        "entry_id": "0a54b527-73ee-3749-8106-cbe7b50355a9",
                        "glosses": [
                            "Décroître."
                        ],
                        "tags": [
                            "ironic"
                        ],
                        "examples": [
                            {
                                "example_id": "cde1c44f-c00f-4ff6-a8f7-0c75c37c2284",
                                "sense_id": "5aa242d9-3d98-396f-916f-3fb408757eca",
                                "text": "J'ai revu l'autre soir ce caveau musical, ce temple souterrain de l'échaudé et de la bière de mars ; je l'ai revu avec des yeux et des sentiments différents de ceux d'autrefois,—ceux de l'âge où les plumes commençaient à me pousser, où je n'étais encore qu'un poulet sorti de sa coquille. Aujourd'hui que les plumes, à force de pousser, commencent à dépousser, et que j'ai l'émotion moins facile à propos de certaines choses."
                            }
                        ]
                    },
                    {
                        "sense_id": "a2aeb210-1119-3089-8de3-2092d6842d16",
                        "entry_id": "0a54b527-73ee-3749-8106-cbe7b50355a9",
                        "glosses": [
                            "Déféquer, chier."
                        ],
                        "tags": [
                            "dated",
                            "slang"
                        ],
                        "examples": []
                    }
