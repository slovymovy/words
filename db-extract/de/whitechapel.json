                "senses": [
                    {
                        "sense_id": "d7bb044c-fbf3-3d9c-934d-821fc36cd113",
                        "entry_id": "b0307192-b1b5-3f6c-9075-f9d04d9afede",
                        "glosses": [
                            "Stadtteil von London"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25e2d36b-06ff-4adb-84cb-e4c7305077fa",
                                "sense_id": "d7bb044c-fbf3-3d9c-934d-821fc36cd113",
                                "text": "„Unsere Gänge führten in zwanzig Jahren so oft nach Whitechapel, wo die Bürde der Unglücklichen zum ersten Mal mein Herz peinigte.“"
                            },
                            {
                                "example_id": "18905cba-d0eb-4e4a-9ab5-6c21769cfbd6",
                                "sense_id": "d7bb044c-fbf3-3d9c-934d-821fc36cd113",
                                "text": "„Ein weiterer Verbündeter war der Gewerkschaftsführer Ernest Bevin, der angesichts einer bevorstehenden Wahl im Londoner Stadtteil Whitechapel um die Stimmen des beträchtlichen jüdischen Bevölkerungsanteils fürchtete.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
