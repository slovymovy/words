                {
                    "sense_id": "51d070f4-329f-3745-baa0-2095c3776794",
                    "sense_definition": "Tuer quelqu'un à l'aide d'une arme à feu.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "violence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le malfaiteur a menacé de <w>flinguer</w> tous les témoins présents dans la banque.",
                            "target_lang_translations": {
                                "en": "The criminal threatened to <w>shoot</w> all the witnesses present in the bank.",
                                "de": "Der Verbrecher drohte, alle anwesenden Zeugen in der Bank zu <w>erschießen</w>.",
                                "es": "El delincuente amenazó con <w>matar</w> a tiros a todos los testigos presentes en el banco.",
                                "zh": "罪犯威胁要<w>枪杀</w>银行里在场的所有证人。",
                                "ru": "Преступник угрожал <w>застрелить</w> всех свидетелей, находившихся в банке."
                            }
                        },
                        {
                            "text": "Dans ce polar sombre, le détective privé manque de se faire <w>flinguer</w> en pleine rue.",
                            "target_lang_translations": {
                                "en": "In this dark crime novel, the private detective nearly gets <w>shot</w> in the middle of the street.",
                                "de": "In diesem düsteren Krimi wird der Privatdetektiv mitten auf der Straße beinahe <w>erschossen</w>.",
                                "es": "En esta novela negra, el detective privado está a punto de ser <w>abatido</w> a tiros en plena calle.",
                                "zh": "在这部阴暗的侦探小说里，私家侦探差点在大街上被<w>枪杀</w>。",
                                "ru": "В этом мрачном детективе частный детектив чуть не был <w>застрелен</w> посреди улицы."
                            }
                        }
                    ],
                    "synonyms": [
                        "abattre",
                        "descendre",
                        "fusiller",
                        "tuer"
                    ],
                    "antonyms": [
                        "épargner"
                    ],
                    "common_phrases": [
