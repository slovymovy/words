    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [],
        "ru-extract.jsonl": [],
        "nl-extract.jsonl": [
            {
                "entry_id": "b96d41e2-29fc-37a9-8e84-ba1b8cbf1a8a",
                "word": "beklemdheid",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3ce573b3-d217-3c31-8594-fb493dd98e2c",
                        "entry_id": "b96d41e2-29fc-37a9-8e84-ba1b8cbf1a8a",
                        "glosses": [
                            "de mate waarin men zich angstig of somber voelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4d2661b-d909-4444-bc91-2037049cee39",
                                "sense_id": "3ce573b3-d217-3c31-8594-fb493dd98e2c",
                                "text": "Al zijn ergernis over het hemd, over zijn te laat komen, het praten met zijn vrienden en familieleden, hun ontstemdheid, zijn dwaze situatie, het was plotseling verdwenen en er kwam een gevoel van grote vreugde en van beklemdheid over hem."
                            },
                            {
                                "example_id": "ea97d9f4-c93d-45b5-b409-edcbb5fea2ba",
                                "sense_id": "3ce573b3-d217-3c31-8594-fb493dd98e2c",
                                "text": "Uit het onderzoek komt naar voren dat 20 procent van de maffialeden last heeft van gevoelens van beklemdheid en paniekaanvallen. Bij 17 procent van de maffiosi is zelfs een persoonlijkheidsstoornis vastgesteld. Met een team van psychologen heeft onderzoeker Girolamo Lo Verso vijftien jaar gewerkt aan een ziektedossier van maffialeden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ee9da306-cd9b-4109-a3f4-e3e64949b41c",
                        "source_entry_id": "b96d41e2-29fc-37a9-8e84-ba1b8cbf1a8a",
                        "source_sense_id": "3ce573b3-d217-3c31-8594-fb493dd98e2c",
                        "source_sense_description": "de mate waarin men zich angstig of somber voelt",
                        "target_lang_word": "sinking feeling",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sinking feeling",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "62653583-8b83-3961-88fa-034778fe0ec9",
                                        "entry_id": "a776b9a0-6f85-36c4-9442-4e39bd9e3a3e",
                                        "glosses": [
                                            "An unpleasant feeling in the abdomen caused by hunger or, especially, apprehension or uneasiness."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30a54132-0225-49b1-8945-641bb39836c0",
                                                "sense_id": "62653583-8b83-3961-88fa-034778fe0ec9",
                                                "text": "I have a sinking feeling in the pit of my stomach."
                                            },
                                            {
                                                "example_id": "9be81024-5676-4b35-8fd3-a76dba61e962",
                                                "sense_id": "62653583-8b83-3961-88fa-034778fe0ec9",
                                                "text": "Appetite craving, but feels no better for the food which he eats, having always a sinking feeling at the stomach— […]"
                                            },
                                            {
                                                "example_id": "edf48181-3cb9-40d5-bb2a-0c6edadefa11",
                                                "sense_id": "62653583-8b83-3961-88fa-034778fe0ec9",
                                                "text": "The danger was over, and Annabel, though dreadfully weak and reduced, was pronounced out of danger, and in a fair way of recovery, though her sinking feelings and wretched mind led her to suppose she should soon be no more—nor did the assurances of those who attended her serve, in any measure, to convince her she was safe."
                                            },
                                            {
                                                "example_id": "921e476b-1f8f-4546-b50d-ea0d2a2e5db1",
                                                "sense_id": "62653583-8b83-3961-88fa-034778fe0ec9",
                                                "text": "I cannot tell them what a sickening, sinking feeling came over me when I saw men, my fellow-men bought and sold like horses: […]"
                                            },
                                            {
                                                "example_id": "307e8d7f-32a9-4fba-ada3-dc7f76a3083a",
                                                "sense_id": "62653583-8b83-3961-88fa-034778fe0ec9",
                                                "text": "She had dragging pains in the loins; general weakness, especially in the back; sinking feelings in the stomach, and a craving for food, without appetite; her bowels are sluggish; tongue pale and flabby."
                                            },
                                            {
                                                "example_id": "dba91fac-69df-44fc-b303-b7797e07f090",
                                                "sense_id": "62653583-8b83-3961-88fa-034778fe0ec9",
                                                "text": "Both were silent, for their hearts were full, and overcome with the sinking feeling of depression accompanying all associations with that melancholy word farewell!"
                                            },
                                            {
                                                "example_id": "8c8b291d-5181-4a0e-ba0f-f7ad2e7fb5ee",
                                                "sense_id": "62653583-8b83-3961-88fa-034778fe0ec9",
                                                "text": "A person, in an attack of this fever [i.e., “slow fever”], commonly feels a loss of strength, a loss of appetite, and a loss of mental activity. He realizes a heavy, indescribable, sinking feeling at the pit of the stomach."
                                            },
                                            {
                                                "example_id": "844f0350-5315-43ce-be36-27fa9275fcde",
                                                "sense_id": "62653583-8b83-3961-88fa-034778fe0ec9",
                                                "text": "He dressed moodily, and left the room to go down to breakfast. Breakfast would at least alleviate this sinking feeling which was unmanning him."
                                            },
                                            {
                                                "example_id": "4388d7b5-8f48-44c6-9689-072852b6f089",
                                                "sense_id": "62653583-8b83-3961-88fa-034778fe0ec9",
                                                "text": "With a sinking feeling I realized it would be past midnight before we saw our bedding."
                                            },
                                            {
                                                "example_id": "3b9678ea-b96c-4973-87dd-0c7c08e9d820",
                                                "sense_id": "62653583-8b83-3961-88fa-034778fe0ec9",
                                                "text": "At one time or another, all of us have experienced butterflies in the stomach while approaching a challenging task like an interview for employment, or when one's name is announced for the stage as the next speaker. Such fluttering sensations of nervousness or sinking feelings of fear are also felt in the stomach when one has to face something ominous. Has it ever surprised us that though our brain is in the head, such feelings are felt in our stomach?"
                                            },
                                            {
                                                "example_id": "acaa1e23-2d96-45a5-b86b-8c41733bd254",
                                                "sense_id": "62653583-8b83-3961-88fa-034778fe0ec9",
                                                "text": "Dr. Weiss's voice was understanding and kind, but that didn't stop the sinking feeling in Megan's stomach. \"I think you should take some time off until it does [i.e., an incident blows over].\" The sinking feeling became a twenty-story drop. \"What?\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "170bcec8-f76a-4c97-8263-b64d90e912bf",
                        "source_entry_id": "b96d41e2-29fc-37a9-8e84-ba1b8cbf1a8a",
