                "senses": [
                    {
                        "sense_id": "debe47e8-7c52-38b7-98fc-8bb08201de83",
                        "entry_id": "fb09a2fe-2606-3e4b-a560-48557b2cd09a",
                        "glosses": [
                            "weibliche Person, die schlafwandelt, das heißt, im Schlaf herumgeht, ohne sich später daran zu erinnern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bce33409-caea-4ccf-a36f-afa501f4b035",
                                "sense_id": "debe47e8-7c52-38b7-98fc-8bb08201de83",
                                "text": "„Dass sie Schlafwandlerin ist, weiß die Familie laut einer Polizeisprecherin.“"
                            },
                            {
                                "example_id": "4973c02c-5bf8-43d9-a009-190ee0d80557",
                                "sense_id": "debe47e8-7c52-38b7-98fc-8bb08201de83",
                                "text": "„Schritt für Schritt lotsten wir die wie eine Schlafwandlerin zu unserem Haus zurück und in die Wohnung hinauf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
