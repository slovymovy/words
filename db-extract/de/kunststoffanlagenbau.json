                "senses": [
                    {
                        "sense_id": "68dc657f-a692-3530-ae47-e686a02c5ba5",
                        "entry_id": "47115f62-60a3-3b1f-b61e-84639741b202",
                        "glosses": [
                            "Gesamtheit aller Betriebe, die mit dem Bau von technischen und industriellen Anlagen aus Kunststoffen beschäftigt sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3f523ed-e5b6-4fe6-aebb-c3c4b908d734",
                                "sense_id": "68dc657f-a692-3530-ae47-e686a02c5ba5",
                                "text": "„Der Kunststoffanlagenbau mit individuellen Anforderungen kann auf ein breites Ventilprogramm von diversen Lieferanten zugreifen.“"
                            },
                            {
                                "example_id": "39ba086a-b346-43e3-9ff7-4d1e945af6a8",
                                "sense_id": "68dc657f-a692-3530-ae47-e686a02c5ba5",
                                "text": "„Der Kunststoffanlagenbau in der Industrie nimmt ein immer größer werdendes Einsatzfeld in Anspruch.“"
                            },
                            {
                                "example_id": "95b64eba-d043-4e28-8c36-f03d8a29b846",
                                "sense_id": "68dc657f-a692-3530-ae47-e686a02c5ba5",
                                "text": "Und diese magere Marge frass die in Konstanz ansässige, im Kunststoffanlagenbau tätige Coperion weg: Das Joint Venture mit der deutschen Unternehmensfinanziererin WestLB / West Private Equity schrieb allein im ersten Semester einen Verlust von zwölf Millionen."
                            },
                            {
                                "example_id": "9cf5ea54-8c50-4e37-9de8-1e14189fd0f4",
                                "sense_id": "68dc657f-a692-3530-ae47-e686a02c5ba5",
                                "text": "Die plasto-tec GmbH ist ein am Markt gut eingeführtes, dynamisches Unternehmen im Kunststoffanlagenbau mit Sitz in Mautern."
                            },
                            {
                                "example_id": "8c1f7efc-e035-4abb-b5c5-5da8cbdc790e",
                                "sense_id": "68dc657f-a692-3530-ae47-e686a02c5ba5",
                                "text": "Auch bei Havarien stehen wir Ihnen mit unserer Erfahrung und Technik hilfreich und schnell zur Seite. Wenn es um Kunststoffanlagenbau, Kunststoffrohrleitungsbau und Kunststofftechnik geht – setzen Sie auf unsere Erfahrung!"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "fd127260-6f91-30ac-8a74-640f89e2dd9f",
                        "entry_id": "47115f62-60a3-3b1f-b61e-84639741b202",
                        "glosses": [
                            "Kunststoffengineering und Bau von Technischen Anlagen aus Kunststoffkomponenten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8dbaf1db-09a5-4452-88f0-1366fbfac6a8",
                                "sense_id": "fd127260-6f91-30ac-8a74-640f89e2dd9f",
                                "text": "„Im Marksegment Kunststoffanlagenbau sind wir für Sie ein starker Partner aufgrund der langjährigen Erfahrung und dem spezifisches Branchenwissen, die Voraussetzungen für die hochwertige Ausführung in der Kunststoffverarbeitung sind.“"
                            },
                            {
                                "example_id": "80c35b83-868f-4e21-87b1-59250743272c",
                                "sense_id": "fd127260-6f91-30ac-8a74-640f89e2dd9f",
                                "text": "„Zu unserem Lieferprogramm als Ventilatoren - Hersteller gehören neben den Komponenten für den Kunststoffanlagenbau auch Ventilatoren aus thermoplastischen Kunststoffen.“"
                            },
                            {
                                "example_id": "03c2c2f3-8d1f-4cc8-91e4-d05a94a974a6",
                                "sense_id": "fd127260-6f91-30ac-8a74-640f89e2dd9f",
                                "text": "„Im Marksegment Kunststoffanlagenbau sind wir für Sie ein starker Partner aufgrund der langjährigen Erfahrung, unseres know-hows und dem spezifisches Branchenwissen, die Voraussetzungen für die hochwertige Ausführung in der Kunststoffverarbeitung sind.“"
                            },
                            {
                                "example_id": "407a154f-1b0e-4984-acb6-088239f10d78",
                                "sense_id": "fd127260-6f91-30ac-8a74-640f89e2dd9f",
                                "text": "„Die plasto-tec GmbH ist ein am Markt gut eingeführtes, dynamisches Unternehmen im Kunststoffanlagenbau mit Sitz in Mautern.“"
                            },
                            {
                                "example_id": "811b47b9-9fb4-4724-aaec-0d35cd89b4e9",
                                "sense_id": "fd127260-6f91-30ac-8a74-640f89e2dd9f",
                                "text": "„Der Unternehmenszweig Kunststoffanlagenbau ist im Rohr- und Anlagenbau in der chemisch-pharmazeutischen Industrie, der Lebensmittelindustrie, in Kliniken sowie im Kraftwerksanlagenbau tätig.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
