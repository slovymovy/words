                    {
                        "sense_id": "dcdfb1c9-e910-3296-b4dd-06a93c0fdd69",
                        "entry_id": "be6615da-b541-3847-9ad2-e4a416a9df7e",
                        "glosses": [
                            "A wall."
                        ],
                        "tags": [
                            "Derbyshire",
                            "Northern-England",
                            "dialectal"
                        ],
                        "examples": [
                            {
                                "example_id": "e4b122e8-b040-4cf8-8815-268215e1f694",
                                "sense_id": "dcdfb1c9-e910-3296-b4dd-06a93c0fdd69",
                                "text": "He stands ahint our wo."
                            },
                            {
                                "example_id": "5bcc6429-8702-4996-bfc4-f95342b8c06d",
                                "sense_id": "dcdfb1c9-e910-3296-b4dd-06a93c0fdd69",
                                "text": "Yo may turn up yor noses at me an' th' owd dame,\nAn thrutch us like dogs agen th' wo :\nBo as lung 's aw con nayger, aw'll ne'er be a beggar,\nSo aw care no a cuss for yo o-o'."
                            },
                            {
                                "example_id": "f7041615-f9cb-4848-aacc-59c67dd407fe",
                                "sense_id": "dcdfb1c9-e910-3296-b4dd-06a93c0fdd69",
                                "text": "[…] thinkan it ran at him, thrast him up again t' wo, ramm't at him, […]"
                            },
                            {
                                "example_id": "bb1f662e-d412-4bc7-bba4-581582ee155d",
                                "sense_id": "dcdfb1c9-e910-3296-b4dd-06a93c0fdd69",
                                "text": "Plantit up agen t'wo"
                            },
                            {
                                "example_id": "5ba6124b-e927-49a1-b326-085f374eb37b",
                                "sense_id": "dcdfb1c9-e910-3296-b4dd-06a93c0fdd69",
                                "text": "Hoo's pluck of a lion an' faces her foe\nWi' calm in her e'en an' her beck agen t' wo;\nHoo's firm i' decision, stonds up for her reets"
                            }
                        ]
                    }
                ],
