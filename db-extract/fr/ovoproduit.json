                        "entry_id": "8ffb0529-3118-3d6b-adef-a6369b4e01bd",
                        "glosses": [
                            "Produit de l’industrie agroalimentaire extrait des œufs."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "fa9e381a-aee5-420e-acf9-7f739adf1c7f",
                                "sense_id": "8745a00c-c4a2-3e24-8933-c8af3a559e13",
                                "text": "L’industrie de l’ovoproduit transforme l’œuf sous des formes très variées."
                            },
                            {
                                "example_id": "baea2f82-6e05-4eee-95eb-7cd364c5c7c8",
                                "sense_id": "8745a00c-c4a2-3e24-8933-c8af3a559e13",
                                "text": "Un quart de la consommation française d’œufs se fait sous forme d’ovoproduits au détriment de la consommation d’œuf coquille."
                            },
                            {
                                "example_id": "c1b5b11b-2d7e-4a42-95bf-2655e8febf16",
                                "sense_id": "8745a00c-c4a2-3e24-8933-c8af3a559e13",
                                "text": "Les ovoproduits se retrouvent même dans des recettes a priori sans œufs. Le blanc, par exemple, sert à assouplir les tanins des vins rouges. Le jaune, badigeonné, dore les croissants. Et cetera."
                            }
                        ]
                    }
