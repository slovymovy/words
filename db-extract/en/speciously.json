                                        "sense_id": "6fad8aff-29f3-3114-8439-841b4cc85de0",
                                        "entry_id": "02d7e162-a5b7-3da2-95b8-2103c4b294e5",
                                        "glosses": [
                                            "ohne tieferen Sinn, leicht durchschaubar, eine tiefgreifendere Bedeutung verbergend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
