    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "230bbadb-9c66-330b-8e05-8d88d33e46bc",
                "word": "valance",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "18cc3837-8219-4851-a2d9-dfce6f3dab31",
                        "entry_id": "230bbadb-9c66-330b-8e05-8d88d33e46bc",
                        "tags": [
                            "plural"
                        ],
                        "form": "valances"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2bd99081-f1fd-3c3c-8f30-28bd96cba697",
                        "entry_id": "230bbadb-9c66-330b-8e05-8d88d33e46bc",
                        "glosses": [
                            "A short curtain that usually hangs along the top edge of a window."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b83c9818-0879-491a-85d8-fd2d26ddbe2e",
                                "sense_id": "2bd99081-f1fd-3c3c-8f30-28bd96cba697",
                                "text": "Even the mantelpiece is adorned with a totally unfunctional tasselled valance rather like an altar frontal."
                            }
                        ]
                    },
                    {
                        "sense_id": "76b226b9-842e-36f4-8171-4d8ba0ff3a6d",
                        "entry_id": "230bbadb-9c66-330b-8e05-8d88d33e46bc",
                        "glosses": [
                            "A decorative framework used to conceal the curtain mechanism and so on at the top of a window."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c50f40cb-f329-3f39-b5cd-db69cffa9ba5",
                        "entry_id": "230bbadb-9c66-330b-8e05-8d88d33e46bc",
                        "glosses": [
                            "A short, decorative edging of cloth that hangs from a bed, from beneath the mattress to the floor, used to conceal the box spring or space under the bed and prevent dust from accumulating there."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "87250917-383a-3c7d-aec3-3adad5cfd77a",
                        "entry_id": "230bbadb-9c66-330b-8e05-8d88d33e46bc",
                        "glosses": [
                            "A short, decorative edging of cloth that conceals the legs of a couch, sofa, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4aa15602-7812-46ad-abee-72b12d1a5c00",
                                "sense_id": "87250917-383a-3c7d-aec3-3adad5cfd77a",
                                "text": "Mortally insulted, Jasper went under the couch, where he remained with only his nose showing beneath the valance, emitting little world-weary groans at intervals, and refusing to come out for cake."
                            }
                        ]
                    },
                    {
                        "sense_id": "3154b751-3a96-3b0f-aa13-c2892655bdf1",
                        "entry_id": "230bbadb-9c66-330b-8e05-8d88d33e46bc",
                        "glosses": [
                            "A low-hanging auto body panel, below a front or rear bumper, whose purpose is aerodynamic and decorative but not structural (often valance panel)."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "0e90cf8f-8562-3dae-9062-62cffa9b1c75",
                        "entry_id": "230bbadb-9c66-330b-8e05-8d88d33e46bc",
                        "glosses": [
                            "The drooping edging of the lid of a trunk, which covers the joint when the lid is closed."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ec8922c0-41b0-48c3-ae04-7ecdc037da46",
                        "source_entry_id": "230bbadb-9c66-330b-8e05-8d88d33e46bc",
                        "source_sense_description": "short curtain on top of a window",
                        "target_lang_word": "záclonka",
                        "target_lang_code": "cs",
