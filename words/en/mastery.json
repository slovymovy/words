{
    "word_family": [
        "master",
        "masterful",
        "masterless",
        "masterpiece"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "55ebbf52-f1f0-3486-b8a7-0a228f8efd3c",
                    "sense_definition": "The state of having comprehensive knowledge or skill in a subject or activity.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "skill",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She demonstrated complete <w>mastery</w> of the piano after years of dedicated practice.",
                            "target_lang_translations": {
                                "zh": "经过多年的刻苦练习，她展现出了对钢琴的<w>精通</w>。"
                            }
                        },
                        {
                            "text": "Achieving <w>mastery</w> of a foreign language requires consistent effort and daily study.",
                            "target_lang_translations": {
                                "zh": "想要<w>掌握</w>一门外语，需要持之以恒的努力和每日的学习。"
                            }
                        }
                    ],
                    "synonyms": [
                        "expertise",
                        "proficiency",
                        "skill"
                    ],
                    "common_phrases": [
                        "achieve mastery",
                        "complete mastery"
                    ],
                    "target_lang_definitions": {
                        "zh": "对某项学科或活动拥有全面知识或技能的状态。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "精通",
                                "target_lang_sense_clarification": "指对学问或技能达到非常熟练的程度。"
                            },
                            {
                                "target_lang_word": "掌握",
                                "target_lang_sense_clarification": "指熟练地掌握某种知识或技能。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f766a225-e88c-3e04-bd42-d1727a895e83",
                    "sense_definition": "The power to control or command something or someone.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "control",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The captain maintained firm <w>mastery</w> over the ship during the violent storm.",
                            "target_lang_translations": {
                                "zh": "在猛烈的风暴中，船长始终牢牢地<w>掌控</w>着这艘船。"
                            }
                        },
                        {
                            "text": "The government struggled to regain <w>mastery</w> of the situation after the unexpected crisis.",
                            "target_lang_translations": {
                                "zh": "突发危机后，政府努力试图重新<w>控制</w>局面。"
                            }
                        }
                    ],
                    "synonyms": [
                        "control",
                        "dominion",
                        "command"
                    ],
                    "common_phrases": [
                        "gain mastery"
                    ],
                    "target_lang_definitions": {
                        "zh": "控制或指挥某人或某事物的权力。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "控制",
                                "target_lang_sense_clarification": "指对局势或事物的支配权。"
                            },
                            {
                                "target_lang_word": "掌控",
                                "target_lang_sense_clarification": "指对局面或权力的牢固把握。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e3d11ec-aaff-3e83-b7c5-3be24efcbbfb",
                    "sense_definition": "Victory or superiority in a competitive struggle.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "competition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The athlete fought hard for <w>mastery</w> in the final minutes of the championship game.",
                            "target_lang_translations": {
                                "zh": "在冠军赛的最后几分钟里，这位运动员奋力拼搏以争取<w>优势</w>。"
                            }
                        },
                        {
                            "text": "Both teams were desperate to claim <w>mastery</w> on the field.",
                            "target_lang_translations": {
                                "zh": "两支队伍都渴望在赛场上取得<w>胜算</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "victory",
                        "triumph"
                    ],
                    "target_lang_definitions": {
                        "zh": "在竞争性斗争中的胜利或优势。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "优势",
                                "target_lang_sense_clarification": "指在竞争中处于领先地位。"
                            },
                            {
                                "target_lang_word": "胜算",
                                "target_lang_sense_clarification": "指在竞争中获胜的可能性或把握。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bfdd91f3-0461-34f5-bb05-4d7ba2e445f0",
                    "sense_definition": "A competitive contest or trial of skill.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "competition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The knights engaged in various <w>masteries</w> to prove their strength and agility.",
                            "target_lang_translations": {
                                "zh": "骑士们参加了各种<w>比武</w>来证明他们的力量和敏捷。"
                            }
                        },
                        {
                            "text": "They held a friendly <w>mastery</w> to see who was the better archer.",
                            "target_lang_translations": {
                                "zh": "他们举行了一场友好的<w>竞技</w>，看看谁的箭术更高明。"
                            }
                        }
                    ],
                    "synonyms": [
                        "contest",
                        "competition"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in historical contexts referring to trials of skill."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一种竞争性的比赛或技能测试（古语）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "比武",
                                "target_lang_sense_clarification": "指古代武艺的较量。"
                            },
                            {
                                "target_lang_word": "竞技",
                                "target_lang_sense_clarification": "指技能的比赛。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "79a88137-2ec7-3704-9e31-10cfc6a909c3",
                    "sense_definition": "A remarkable or skillful feat or action.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "skill",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The acrobat performed several <w>masteries</w> that left the audience in complete awe.",
                            "target_lang_translations": {
                                "zh": "杂技演员表演了几项<w>绝技</w>，让观众惊叹不已。"
                            }
                        },
                        {
                            "text": "His ability to solve the puzzle so quickly was a true <w>mastery</w> of logic.",
                            "target_lang_translations": {
                                "zh": "他能如此迅速地解开谜题，展现了真正的逻辑<w>绝技</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "feat",
                        "exploit"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Refers to an impressive act or feat."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一种非凡的、高超的壮举或行为（古语）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "绝技",
                                "target_lang_sense_clarification": "指高超的技艺或非凡的本领。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f65a3231-0960-397f-8ae4-6b35632d3755",
                    "sense_definition": "The legendary substance believed to turn base metals into gold.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "alchemy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Alchemists spent their lives searching for the <w>mastery</w> to create gold.",
                            "target_lang_translations": {
                                "zh": "炼金术士们终其一生都在寻找制造黄金的<w>点金术</w>。"
                            }
                        },
                        {
                            "text": "Ancient texts often referred to the philosopher's stone as the ultimate <w>mastery</w>.",
                            "target_lang_translations": {
                                "zh": "古籍中常将贤者之石称为终极的<w>点金术</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in the context of alchemy."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "炼金术中传说能将贱金属转化为黄金的物质（古语）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "点金术",
                                "target_lang_sense_clarification": "指炼金术中将金属变为黄金的传说技术。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}