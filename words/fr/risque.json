    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f9ab5867-5f32-3c8d-ac12-993e55ee83fb",
                    "sense_definition": "Possibilité ou éventualité d'un événement négatif, d'un péril ou d'un dommage.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "danger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Conduire trop vite augmente considérablement le <w>risque</w> d'avoir un accident grave."
                        },
                        {
                            "text": "Il préfère ne prendre aucun <w>risque</w> et vérifier attentivement tout le matériel."
                        }
                    ],
                    "synonyms": [
                        "danger"
                    ],
                    "antonyms": [
                        "certitude"
                    ],
                    "common_phrases": [
                        "prendre des risques",
                        "courir un risque",
                        "facteur de risque"
                    ]
                },
                {
                    "sense_id": "ace00fbc-1bcd-3ccb-93c7-e780ecc718a9",
                    "sense_definition": "Probabilité d'un dommage combinée à l'estimation chiffrée de son impact potentiel.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gestion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les analystes financiers évaluent le <w>risque</w> de crédit avant d'accorder ce prêt."
                        },
                        {
                            "text": "Toute décision stratégique exige une évaluation approfondie du <w>risque</w> pour l'entreprise."
                        }
                    ],
                    "antonyms": [
                        "opportunité"
                    ],
                    "common_phrases": [
                        "gestion des risques",
                        "analyse des risques"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2e57d61f-704a-3f32-8a66-af61de560f61",
                    "sense_definition": "Première et troisième personnes du singulier du présent de l'indicatif ou du subjonctif de <w>risquer</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "conjugaison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Prends ton imperméable car il <w>risque</w> de pleuvoir dans le courant de la journée."
                        },
                        {
                            "text": "Je ne <w>risque</w> rien en restant prudent lors de cette longue randonnée."
                        }
                    ],
                    "common_phrases": [
                        "ne risque rien"
                    ]
                },
                {
                    "sense_id": "291fa10a-a253-3c65-813f-ebfca87e116a",
                    "sense_definition": "Deuxième personne du singulier de l'impératif présent de <w>risquer</w>.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "conjugaison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Risque</w> le coup et pose ta candidature dès aujourd'hui sans hésiter."
                        },
                        {
                            "text": "Ne <w>risque</w> pas tes économies dans un projet dont tu ignores les détails."
                        }
                    ]
                }
            ]
        }
    ]
