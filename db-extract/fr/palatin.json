                                        "sense_id": "57fbb8dd-b8e4-31d3-8a0e-58ca2cfe0322",
                                        "entry_id": "952aa08d-c29b-32b8-af48-010a76fbde27",
                                        "glosses": [
                                            "холм в Риме"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87d09ce5-ea1a-48be-9c29-730e1265f3d2",
                                                "sense_id": "57fbb8dd-b8e4-31d3-8a0e-58ca2cfe0322",
                                                "text": "... тучи черною медвежьей шкурою лежали над Римом, ливень хлестал Палатин и Капитолий, а Тибр вздувался в оковах набережной, пытаясь, как узник, вырваться на свободу и затопить Трастевере мутной волной."
                                            }
                                        ]
