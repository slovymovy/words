{
    "word_family": [
        "assemble",
        "assembler",
        "reassemble",
        "disassemble"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6943f17e-325c-3e0e-b15c-a546fffbb60f",
                    "sense_definition": "A group of people gathered together in one place for a common purpose.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "gathering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The principal addressed the students during the morning <w>assembly</w> in the hall.",
                            "target_lang_translations": {
                                "ru": "Директор обратился к ученикам во время утренней <w>линейки</w> в зале."
                            }
                        },
                        {
                            "text": "The constitution guarantees the right to peaceful <w>assembly</w> and free speech.",
                            "target_lang_translations": {
                                "ru": "Конституция гарантирует право на мирные <w>собрания</w> и свободу слова."
                            }
                        }
                    ],
                    "synonyms": [
                        "foregathering"
                    ],
                    "common_phrases": [
                        "school assembly",
                        "freedom of assembly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа людей, собравшихся вместе в одном месте для общей цели."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "собрание",
                                "target_lang_sense_clarification": "мероприятие или группа людей"
                            },
                            {
                                "target_lang_word": "линейка",
                                "target_lang_sense_clarification": "школьное торжественное собрание"
                            },
                            {
                                "target_lang_word": "сходка",
                                "target_lang_sense_clarification": "неформальное собрание"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "304f898e-f1c1-3b2d-a38d-3c5592b7ccf4",
                    "sense_definition": "The act or process of putting together different parts to create a finished product.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "construction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The instructions for <w>assembly</w> were very difficult to follow.",
                            "target_lang_translations": {
                                "ru": "Инструкциям по <w>сборке</w> было очень трудно следовать."
                            }
                        },
                        {
                            "text": "The car was put together on a massive <w>assembly</w> line in the factory.",
                            "target_lang_translations": {
                                "ru": "Автомобиль был собран на огромной <w>сборочной</w> линии на заводе."
                            }
                        }
                    ],
                    "common_phrases": [
                        "assembly line",
                        "some assembly required"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие или процесс соединения различных частей для создания готового изделия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сборка",
                                "target_lang_sense_clarification": "процесс монтажа"
                            },
                            {
                                "target_lang_word": "монтаж",
                                "target_lang_sense_clarification": "установка и соединение частей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1e8a6a22-8955-37e3-93f4-7ac140ae639f",
                    "sense_definition": "A group of people elected to make laws or decisions for a particular country or state.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "government",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The national <w>assembly</w> voted in favor of the new tax legislation.",
                            "target_lang_translations": {
                                "ru": "Национальная <w>ассамблея</w> проголосовала за новое налоговое законодательство."
                            }
                        },
                        {
                            "text": "Representatives from every region met at the general <w>assembly</w> to discuss the crisis.",
                            "target_lang_translations": {
                                "ru": "Представители всех регионов встретились на генеральной <w>ассамблее</w>, чтобы обсудить кризис."
                            }
                        }
                    ],
                    "common_phrases": [
                        "legislative assembly",
                        "general assembly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа людей, избранных для принятия законов или решений для конкретной страны или штата."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ассамблея",
                                "target_lang_sense_clarification": "законодательный орган или съезд"
                            },
                            {
                                "target_lang_word": "собрание",
                                "target_lang_sense_clarification": "официальный орган, например, национальное собрание"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "14188b2e-e913-3d88-895c-3333184ef3bc",
                    "sense_definition": "A set of parts that are fitted together to form a complete unit or mechanism.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "construction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to replace the entire tail light <w>assembly</w> if the plastic is cracked.",
                            "target_lang_translations": {
                                "ru": "Если пластик треснул, вам нужно заменить весь <w>узел</w> заднего фонаря целиком."
                            }
                        },
                        {
                            "text": "The technician carefully inspected the gearbox <w>assembly</w> for any signs of wear.",
                            "target_lang_translations": {
                                "ru": "Техник тщательно осмотрел <w>агрегат</w> коробки передач на наличие признаков износа."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gearbox assembly",
                        "valve assembly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Набор деталей, которые соединены вместе, образуя законченный узел или механизм."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "узел",
                                "target_lang_sense_clarification": "часть механизма"
                            },
                            {
                                "target_lang_word": "агрегат",
                                "target_lang_sense_clarification": "крупный технический узел"
                            },
                            {
                                "target_lang_word": "механизм",
                                "target_lang_sense_clarification": "совокупность деталей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "56a35297-a669-3e40-a4f0-36faf5ee180d",
                    "sense_definition": "A low-level programming language that is closely related to machine code.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to write the performance-critical parts of the software in <w>assembly</w>.",
                            "target_lang_translations": {
                                "ru": "Он решил написать критически важные для производительности части программы на <w>ассемблере</w>."
                            }
                        },
                        {
                            "text": "Learning <w>assembly</w> helps programmers understand how the computer hardware actually works.",
                            "target_lang_translations": {
                                "ru": "Изучение <w>ассемблера</w> помогает программистам понять, как на самом деле работает компьютерное железо."
                            }
                        }
                    ],
                    "common_phrases": [
                        "assembly language",
                        "write in assembly"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "shortened form of assembly language"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Язык программирования низкого уровня, тесно связанный с машинным кодом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ассемблер",
                                "target_lang_sense_clarification": "язык программирования"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c713f55f-e42e-357d-88f5-59cc7ea9e114",
                    "sense_definition": "A signal given by a drum or bugle to command soldiers to gather together.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "military",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bugler sounded the <w>assembly</w> early in the morning to wake the troops.",
                            "target_lang_translations": {
                                "ru": "Горнист протрубил <w>сбор</w> рано утром, чтобы разбудить войска."
                            }
                        },
                        {
                            "text": "Upon hearing the <w>assembly</w> the soldiers quickly lined up in the courtyard.",
                            "target_lang_translations": {
                                "ru": "Услышав сигнал в <w>сбору</w>, солдаты быстро выстроились во дворе."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sound the assembly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сигнал, подаваемый барабаном или горном, приказывающий солдатам собраться вместе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сбор",
                                "target_lang_sense_clarification": "военный сигнал"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "71f50876-3c80-3359-aa8b-ccfde38b817a",
                    "sense_definition": "In software development, a compiled code library used for deployment, versioning, and security.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The developer added a reference to the shared <w>assembly</w> in the project settings.",
                            "target_lang_translations": {
                                "ru": "Разработчик добавил ссылку на общую <w>сборку</w> в настройках проекта."
                            }
                        },
                        {
                            "text": "Each <w>assembly</w> contains a manifest that lists all the external dependencies.",
                            "target_lang_translations": {
                                "ru": "Каждая <w>сборка</w> содержит манифест, в котором перечислены все внешние зависимости."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical term in .NET programming"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В разработке программного обеспечения — скомпилированная библиотека кода, используемая для развертывания и версионности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сборка",
                                "target_lang_sense_clarification": "скомпилированный модуль в .NET"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
