                                        "entry_id": "880f7199-12c6-3bf8-94bf-91ce6507f912",
                                        "glosses": [
                                            "A cellmate."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4f8652fc-47d5-32a9-b120-032dcc44ba41",
                                        "entry_id": "880f7199-12c6-3bf8-94bf-91ce6507f912",
                                        "glosses": [
                                            "A jail cell."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05d24637-e4a9-4a43-ae2b-db14d197f1e0",
                                                "sense_id": "4f8652fc-47d5-32a9-b120-032dcc44ba41",
                                                "text": "So tragic, need a hot meal in my baby’s belly / Reminisce no hard times in my pen, in my celly, / I ain’t tryna go back, cause backwards ain’t part of my PJ"
                                            },
                                            {
                                                "example_id": "cfc8c697-48bb-44e9-b7ae-2ac56e76751d",
                                                "sense_id": "4f8652fc-47d5-32a9-b120-032dcc44ba41",
                                                "text": "I was locked up in my celly / Murder for hire, no snitchin or tellin / I got no calls or no type of mailin"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5f544f7-6edc-302b-bfe5-0b23cbb75b57",
                                        "entry_id": "880f7199-12c6-3bf8-94bf-91ce6507f912",
                                        "glosses": [
                                            "A cellular phone."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "679b830e-c8bb-434d-9fd7-d1a02fd4c27a",
                                                "sense_id": "b5f544f7-6edc-302b-bfe5-0b23cbb75b57",
                                                "text": "You got no hand skills, there's no security to save ya / No pager, no celly, no drop top Benz-y"
                                            },
                                            {
                                                "example_id": "cb6a17ad-23bf-4f9f-8c19-9ce3639a7f94",
                                                "sense_id": "b5f544f7-6edc-302b-bfe5-0b23cbb75b57",
                                                "text": "[…] but I am ready to dip / to the telly with my relly / cuz these fuckin git up chicks keep blowin up my celly."
                                            },
                                            {
                                                "example_id": "2f4bb2cd-745c-4d4b-b5a3-f814978dbe99",
                                                "sense_id": "b5f544f7-6edc-302b-bfe5-0b23cbb75b57",
                                                "text": "This a celly / That's a tool / On my Kodak"
                                            }
                                        ]
