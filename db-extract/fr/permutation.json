                "senses": [
                    {
                        "sense_id": "202e4aad-8e7c-3dad-ae25-95732a5f08c0",
                        "entry_id": "31fc4109-5fe7-3c94-a48b-109c55a3f56a",
                        "glosses": [
                            "Échange, action de permuter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2d176da-06b3-4284-9884-ccd41c4986fc",
                                "sense_id": "202e4aad-8e7c-3dad-ae25-95732a5f08c0",
                                "text": "Pendant des jours et des jours, désespérément, il chercha un moyen quelconque de ne pas partir, une permutation avec un camarade... mais en vain."
                            }
                        ]
                    },
                    {
                        "sense_id": "7298d5c9-9296-3fc0-ba2e-c4b54013fb59",
                        "entry_id": "31fc4109-5fe7-3c94-a48b-109c55a3f56a",
                        "glosses": [
                            "Processus consistant à échanger le contenu d'une zone de mémoire principale avec le contenu d'une zone de mémoire auxiliaire."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "6cf2fd17-19a9-3d6c-a136-b8c7d183dead",
                        "entry_id": "31fc4109-5fe7-3c94-a48b-109c55a3f56a",
                        "glosses": [
                            "Bijection d'un ensemble vers lui-même. Les différentes manières de disposer des objets à la suite les uns des autres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4aadd2d8-b337-4837-9232-8288f0d2e72c",
                                "sense_id": "6cf2fd17-19a9-3d6c-a136-b8c7d183dead",
                                "text": "Les trois lettres A, B, C ont six permutations : abc, acb, bac, bca, cab, cba."
                            },
                            {
                                "example_id": "38cb0761-6fc6-45ee-a9d0-cdfcc26664dd",
                                "sense_id": "6cf2fd17-19a9-3d6c-a136-b8c7d183dead",
                                "text": "Un ensemble fini de n éléments possède n! permutations."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "448b24d3-f591-4bcb-af91-053ef0fb591c",
                        "source_entry_id": "31fc4109-5fe7-3c94-a48b-109c55a3f56a",
                        "target_lang_word": "swap",
                        "target_lang_code": "en",
