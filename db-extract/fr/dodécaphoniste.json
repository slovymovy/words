                            {
                                "example_id": "04690054-f17b-4c2f-b4e1-2619bc564cae",
                                "sense_id": "b86fcffe-de7e-3980-ba1e-40bccb98685c",
                                "text": "D’abord influencé par Stravinski puis par Webern, Pierre Froidebise devint un dodécaphoniste convaincu et entretint des relations avec Messiaen, Leibowitz et Boulez."
                            },
                            {
                                "example_id": "9ebc24ba-4061-4257-b751-484a2b71f93d",
                                "sense_id": "b86fcffe-de7e-3980-ba1e-40bccb98685c",
                                "text": "Or, qui donc se flatterait aujourd’hui de pouvoir distinguer le style d’un dodécaphoniste tchèque de celui d’un dodécaphoniste américain ?"
                            }
                        ]
                    }
                ],
