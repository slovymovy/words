                        "examples": [
                            {
                                "example_id": "76b6027b-5570-405e-bb15-7fd856a91dd0",
                                "sense_id": "cbc90bcb-176a-3c2f-af45-a795ef794cb3",
                                "text": "Horecaondernemer A. Houimli krijgt geen toestemming van de gemeente om een uitrit aan te leggen aan de Stationslaan 3. De Gorenaar wil die uitrit gebruiken voor zijn snackcar, maar de gemeente heeft daar een aantal bezwaren tegen."
                            },
                            {
                                "example_id": "f478fe75-f791-48e6-bbdd-1afa11709beb",
                                "sense_id": "cbc90bcb-176a-3c2f-af45-a795ef794cb3",
                                "text": "Een nummerbord heeft hij niet. ‘Snackcar’ staat er op de plek waar je het bord zou verwachten. “Ik heb de wagen niet in de wegenbelasting. Ik tank drie keer in de twee jaar. Ik ben de goedkoopste bestuurder van dit land.”"
                            },
                            {
                                "example_id": "97d0c827-13e6-4515-afe9-7e264e2dd373",
                                "sense_id": "cbc90bcb-176a-3c2f-af45-a795ef794cb3",
                                "text": "Vanwege de rookontwikkeling ontruimde de brandweer een naastgelegen supermarkt. De brand was rond 19.30 uur geblust. Het vuur is niet overgeslagen naar andere panden. Wel is de snackcar verwoest."
                            }
                        ]
                    }
