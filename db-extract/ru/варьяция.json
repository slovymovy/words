                                "target_senses": [
                                    {
                                        "sense_id": "a6caa5a5-37d4-3325-999e-a4af73a1434d",
                                        "entry_id": "0b62a0ed-c56a-3382-8d8f-5f20cc166909",
                                        "glosses": [
                                            "Changement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88538721-3695-4ac3-92ef-5d8afa79c487",
                                                "sense_id": "a6caa5a5-37d4-3325-999e-a4af73a1434d",
                                                "text": "[…] les variations de température qu’on constate en Champagne, surtout au printemps, donnent à cette région un caractère continental […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "186bf704-f0a4-30d0-a1f5-d1af698ac49d",
                                        "entry_id": "0b62a0ed-c56a-3382-8d8f-5f20cc166909",
                                        "glosses": [
                                            "Dérivation de l’aiguille de la boussole qui, au lieu de regarder droit vers le nord géographique, décline plus ou moins vers l’est ou vers l’ouest."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b687c37e-b9ce-4d08-8bf7-13c4bf9e5c54",
                                                "sense_id": "186bf704-f0a4-30d0-a1f5-d1af698ac49d",
                                                "text": "La boussole est en Islande d'un emploi assez difficile, à cause de la variation magnétique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7937999-144b-310d-874a-081688b53749",
                                        "entry_id": "0b62a0ed-c56a-3382-8d8f-5f20cc166909",
                                        "glosses": [
                                            "Répétition d’un thème avec des modifications, des ornements, sous une forme nouvelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5795820a-5168-4cc0-b450-3aa4ce988833",
                                                "sense_id": "b7937999-144b-310d-874a-081688b53749",
                                                "text": "Les flûtes, l’une après l’autre, inventent et modulent de gracieuses variations, comme pour célébrer joyeusement la virtuosité du vainqueur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41c83a59-de17-399e-aaee-2f0078c23c8b",
                                        "entry_id": "0b62a0ed-c56a-3382-8d8f-5f20cc166909",
                                        "glosses": [
                                            "Différences des états d'une langue selon l'époque, la localisation géographique, le groupe social, la situation d'énonciation ou l'éthique du locutorat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79e25de2-359e-4766-b1e2-66fee628c5bd",
                                                "sense_id": "41c83a59-de17-399e-aaee-2f0078c23c8b",
                                                "text": "Selon Bulot et Blanchet (2013, p. 48), la variation externe s’organise autour de cinq dimensions : diachronique, diatopique, diastratique, diaphasique et diagénique"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
