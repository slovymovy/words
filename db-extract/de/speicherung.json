                                        "entry_id": "d2fd25f8-32a2-3563-b702-add4396f687a",
                                        "glosses": [
                                            "That which contains something, as a tablet; a means of preserving impressions."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55b691d8-ada3-4cfd-993c-1c3aefe74fa4",
                                                "sense_id": "48111875-7f3d-3ecb-b37a-9aa7010f9701",
                                                "text": "Thy gift, thy tables, are within my brain\nFull character’d with lasting memory,\n[…]\nThat poor retention could not so much hold,\nNor need I tallies thy dear love to score;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fcb8884c-fb9e-3ae6-a9a9-2e75962197d4",
                                        "entry_id": "d2fd25f8-32a2-3563-b702-add4396f687a",
                                        "glosses": [
                                            "The act of withholding; restraint; reserve."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f3ffa85-0ef4-4ecf-a8e7-98a2b26a67bb",
                                                "sense_id": "fcb8884c-fb9e-3ae6-a9a9-2e75962197d4",
                                                "text": "His life I gave him, and did thereto add / My love without retention or restraint,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3f1cc07-ef84-38a4-a18c-b09c2736505e",
                                        "entry_id": "d2fd25f8-32a2-3563-b702-add4396f687a",
                                        "glosses": [
                                            "A place of custody or confinement."
                                        ],
