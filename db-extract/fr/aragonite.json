                                        "entry_id": "441acc3d-3b2d-3dcc-9661-d64fae24c85f",
                                        "glosses": [
                                            "An evaporite consisting of anhydrous calcium carbonate with the chemical formula CaCO₃ and occurring in pearls, shells and nacre; it is dimorphous with calcite."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95201639-2bc3-40c9-ac65-77cc2e8a042c",
                                                "sense_id": "88089391-0669-3a6a-a841-491a5fcd7fea",
                                                "text": "The basic chemical material of molluscan shells is calcium carbonate, which forms the outer layer of calcite, and the inner layer of aragonite, which is a heavier and harder substance although it has the same chemical composition."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
