    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2de16a55-524b-36fa-907e-023efa321c01",
                    "sense_definition": "Made of lace or decorated with lace.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore a beautiful <w>lacy</w> dress to the evening party.",
                            "target_lang_translations": {
                                "ru": "Она надела красивое <w>кружевное</w> платье на вечеринку."
                            }
                        },
                        {
                            "text": "The store sells elegant <w>lacy</w> curtains for bedroom windows.",
                            "target_lang_translations": {
                                "ru": "В магазине продаются элегантные <w>кружевные</w> шторы для окон спальни."
                            }
                        }
                    ],
                    "synonyms": [
                        "laced"
                    ],
                    "common_phrases": [
                        "lacy dress",
                        "lacy curtains"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделанный из кружева или украшенный кружевом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кружевной",
                                "target_lang_sense_clarification": "изготовленный из кружева или с кружевом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0ab6d9a2-65d0-3330-a785-d2f75a844682",
                    "sense_definition": "Resembling lace in appearance, texture, or pattern; delicate and openwork.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The frost created <w>lacy</w> patterns on the cold windowpane.",
                            "target_lang_translations": {
                                "ru": "Мороз создал <w>кружевные</w> узоры на холодном оконном стекле."
                            }
                        },
                        {
                            "text": "We admired the <w>lacy</w> foliage of the delicate fern leaves.",
                            "target_lang_translations": {
                                "ru": "Мы любовались <w>ажурной</w> листвой нежных листьев папоротника."
                            }
                        }
                    ],
                    "synonyms": [
                        "lace-like",
                        "filigree",
                        "delicate"
                    ],
                    "common_phrases": [
                        "lacy patterns",
                        "lacy foliage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Напоминающий кружево по виду, текстуре или узору; ажурный и тонкий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кружевной",
                                "target_lang_sense_clarification": "похожий на кружево"
                            },
                            {
                                "target_lang_word": "ажурный",
                                "target_lang_sense_clarification": "сквозной, тонкой работы"
                            }
                        ]
                    }
                }
            ]
        },
        {
