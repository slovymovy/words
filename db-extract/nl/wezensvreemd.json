                "senses": [
                    {
                        "sense_id": "ee204c3f-81de-329c-af66-ad0725fa1b1d",
                        "entry_id": "6cf5eed7-bf5f-3ecb-a79b-65848bfc5dc0",
                        "glosses": [
                            "niet overeenkomstig met de ware aard van iets of iemand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f8a0846-2557-47f6-930e-f9765e3209c1",
                                "sense_id": "ee204c3f-81de-329c-af66-ad0725fa1b1d",
                                "text": "Dan begint het grote strompelen achter mijn rollator door de woonkamer. Verrekkend van de pijn in mijn hamstrings, mijn rug, en mijn linkerhand. Ik leun naar links, teveel naar links. Dat heeft gemaakt dat ik op de muis van mijn handpalm eelt begin te ontwikkelen. Vreemd voor iemand die altijd zijn brood heeft verdiend met het tikken van stukkies. Een schep of een schop is altijd een wezensvreemd voorwerp geweest."
                            },
                            {
                                "example_id": "3447aa5c-73ba-4729-9ec9-6d1a1dbf5b07",
                                "sense_id": "ee204c3f-81de-329c-af66-ad0725fa1b1d",
                                "text": "Voor veel mensen is het een wezensvreemd idee: bankgegevens delen met derde partijen. Dat Jan en alleman - techbedrijfjes, financieel adviseurs, Google en Facebook - weten wat je betaalt, en aan wie. Dat deze partijen zelfs betalingen kunnen doen vanaf je bankrekening."
                            }
                        ]
                    }
