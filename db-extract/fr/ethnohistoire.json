                    {
                        "sense_id": "4472d162-90a3-3af9-adc1-79bee12047c6",
                        "entry_id": "1f9518bc-feb6-3816-88d7-a451a12330dd",
                        "glosses": [
                            "Discipline de l'anthropologie (ou des sciences humaines) dont l'objet est l'étude des ethnies ou des peuples intégrant les aspects historiques et les aspects ethnologiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8919b2f-5f91-4828-9a67-4c15362b0574",
                                "sense_id": "4472d162-90a3-3af9-adc1-79bee12047c6",
                                "text": "L’ethnohistoire, l’histoire des peuples sans écriture est, on le sait, la critique historique des traditions orales censées véhiculer la mémoire du passé"
                            },
                            {
                                "example_id": "0fe8d6a4-b76f-4eb5-8b80-e4cae95c95df",
                                "sense_id": "4472d162-90a3-3af9-adc1-79bee12047c6",
                                "text": "D’une certaine manière, je souhaiterais témoigner que pour ceux ne pratiquant pas l’ethnohistoire, ils peuvent malgré tout se sentir encouragés par ce que j’appellerai une « attitude d’ethnohistoire »"
                            }
                        ]
                    }
                ],
