                "senses": [
                    {
                        "sense_id": "751e35e4-b571-3702-8947-d35f711e5f54",
                        "entry_id": "8817194c-2b0a-3e1e-af54-9fa73bb4a065",
                        "glosses": [
                            "Redonner un caractère libidinal à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "465f455b-08af-4020-8ac1-e01909b3b0d3",
                                "sense_id": "751e35e4-b571-3702-8947-d35f711e5f54",
                                "text": "À travers la prise de conscience de son vécu masochiste, il a l’occasion de relibidinaliser ses agirs violents et ses angoisses paralysantes."
                            },
                            {
                                "example_id": "d0e8d058-7ce1-4d89-bc19-cc6a0a8932e5",
                                "sense_id": "751e35e4-b571-3702-8947-d35f711e5f54",
                                "text": "Il s’avère donc essentiel de repérer, en premier lieu, le fantôme intérieur égaré et errant, seul susceptible d’autoriser le sujet à se relibidinaliser' pour se trouver bon, naturellement et sans justification."
                            }
                        ]
                    }
                ],
