                        "glosses": [
                            "Jeune morfal qui a l’habitude de manger gloutonnement ou beaucoup, goinfre."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "08ce774d-55b4-4f6e-bd9e-a46a0f427aab",
                                "sense_id": "006f67cc-083e-3144-991b-9cb0a1e5ad7b",
                                "text": "C’est un véritable morfaloux."
                            },
                            {
                                "example_id": "379261da-d964-40f8-9da2-f3553c6d341a",
                                "sense_id": "006f67cc-083e-3144-991b-9cb0a1e5ad7b",
                                "text": "Nous autres, les morfaloux, la pelle ou la pioche ostensiblement sur l’épaule, dès qu’une queue pour la soupe se pointe à l’horizon nous nous y incrustons, cuillère au poing – poing caché sous la loque, nous étions censés laper à même l’écuelle –, sous le bras n’importe quoi de creux pouvant contenir son litre de soupe."
                            }
                        ]
                    }
