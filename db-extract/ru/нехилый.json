                "senses": [
                    {
                        "sense_id": "38d13762-2fa4-39a9-bf6f-e66c7fc32e4c",
                        "entry_id": "4edb064d-b34a-3c30-a299-017dd05e59b7",
                        "glosses": [
                            "прост. отличный, высшего качества, вызывающий одобрение"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2259d6dc-56ca-3048-b913-6a33b29e019e",
                        "entry_id": "4edb064d-b34a-3c30-a299-017dd05e59b7",
                        "glosses": [
                            "прост. проявляющийся в высшей степени; большой, крепкий, мощный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "735e7971-6b37-417e-a6dd-103b045a53cd",
                                "sense_id": "2259d6dc-56ca-3048-b913-6a33b29e019e",
                                "text": "― Да, нехилый сейф, ― устало произнес вспотевший Кирпич."
                            },
                            {
                                "example_id": "f31b538b-e5c6-483d-8655-19b45f1ec9ab",
                                "sense_id": "2259d6dc-56ca-3048-b913-6a33b29e019e",
                                "text": "Наверное, на плече будет нехилый такой синяк."
                            },
                            {
                                "example_id": "87546bb5-78d7-4ae4-8362-9d0e4f81fff9",
                                "sense_id": "2259d6dc-56ca-3048-b913-6a33b29e019e",
                                "text": "Этот конь железный питается бензином, бензин стоит нехилых денег, а денег нет."
                            }
                        ]
                    }
