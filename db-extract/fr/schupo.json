                        "cross_references": [
                            {
                                "target_word": "Schupo",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "79690833-8ccb-3c36-9169-81793ed0ea04",
                                        "entry_id": "45920486-051c-306b-98ab-eb8a59f38f60",
                                        "glosses": [
                                            "in der Bundesrepublik Schutzpolizei"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70add811-8e65-421f-b199-6f348ef043f4",
                                                "sense_id": "79690833-8ccb-3c36-9169-81793ed0ea04",
                                                "text": "„Während der Fahrt nach Osten wurden die Transporte von Angehörigen der Schutzpolizei (Schupo) bewacht.“"
                                            },
                                            {
                                                "example_id": "f08f17df-ee56-4ec3-8735-b5fb02d6e5bd",
                                                "sense_id": "79690833-8ccb-3c36-9169-81793ed0ea04",
                                                "text": "„Wo auch die Schupo vorstößt, ihn zu fassen meint, schon mit den Händen zu halten glaubt… Zehn Meter weiter wandert er, blinkt er, spottet er, droht er.“"
                                            },
                                            {
                                                "example_id": "b2fa5584-d025-4df9-a469-65d9403291ab",
                                                "sense_id": "79690833-8ccb-3c36-9169-81793ed0ea04",
                                                "text": "„Die Schupo arbeitete glänzend.“"
                                            },
                                            {
                                                "example_id": "d08f1d49-18ad-4abe-bd6c-81384f768e7b",
                                                "sense_id": "79690833-8ccb-3c36-9169-81793ed0ea04",
                                                "text": "„Die Kladnoer Schupo erschoss alle Männer, lieferte die Frauen in Konzentrationslager, verteilte die Kinder.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Schupo",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5cdf0062-1ae0-3b4c-8f59-b93f8b558232",
                                        "entry_id": "cf3d4cec-0fff-3f36-a3ce-901cad2c6034",
                                        "glosses": [
                                            "Schutzpolizist"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f85b622-c0a2-4865-887a-9129805cb472",
                                                "sense_id": "5cdf0062-1ae0-3b4c-8f59-b93f8b558232",
                                                "text": "„Der Schupo hatte unterdes die Karte gelesen.“"
                                            },
                                            {
                                                "example_id": "c7385e07-b764-4937-af57-36e2322ea2cc",
                                                "sense_id": "5cdf0062-1ae0-3b4c-8f59-b93f8b558232",
                                                "text": "„Auf der Straße stand ein Lastwagen mit Schupos.“"
                                            },
                                            {
                                                "example_id": "bb7d186f-a1c7-444f-a36a-b04fd6be3f51",
                                                "sense_id": "5cdf0062-1ae0-3b4c-8f59-b93f8b558232",
                                                "text": "„Die Schupos haben jetzt blaue Uniformen.“"
                                            },
                                            {
                                                "example_id": "ddbbf7ab-abfa-432f-bc95-77b0efdfb604",
                                                "sense_id": "5cdf0062-1ae0-3b4c-8f59-b93f8b558232",
                                                "text": "„In diesem Moment öffnete sich die Türe und drei Schupos polterten herein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
