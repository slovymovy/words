                                        "entry_id": "35f22f4f-46e5-3fac-b31c-1627e9487270",
                                        "glosses": [
                                            "Bauart der Tuba mit nach vorne gerichtetem Schallbecher, deren Schallrohr den Musiker ringförmig umgibt"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2c168ec-b305-436f-8460-4364c6e68616",
                                                "sense_id": "99f5f185-4e7e-326c-964c-e0842a041ecf",
                                                "text": "Das Sousaphon ist vor allem zum Marschieren besser geeignet als herkömmliche Tuben."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
