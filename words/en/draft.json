                            {
                                "target_lang_word": "затяжка",
                                "target_lang_sense_clarification": "при курении или вдохе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "842d30de-4caf-33c2-9e30-2779059bd9c5",
                    "sense_definition": "The vertical distance between the waterline and the bottom of a ship's hull; the depth of water a ship needs to float.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "nautical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ship has a shallow <w>draft</w>, allowing it to enter smaller harbors.",
                            "target_lang_translations": {
                                "ru": "У корабля небольшая <w>осадка</w>, что позволяет ему заходить в небольшие гавани."
                            }
                        },
                        {
                            "text": "The captain checked the vessel's <w>draft</w> before entering the shallow canal.",
                            "target_lang_translations": {
                                "ru": "Капитан проверил <w>осадку</w> судна перед входом в мелководный канал."
                            }
