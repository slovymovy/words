                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1716853-040e-4794-b639-7e4308a57fbf",
                                "sense_id": "cb2918d4-3c54-344a-80d6-9bab21c11375",
                                "text": "„Jeder der vergoldeten Gitterstäbe des Käfigs war mit einer stilisierten Kreuzblume verziert.“"
                            },
                            {
                                "example_id": "c3eb2926-5807-4191-9e88-77ff9a5e7892",
                                "sense_id": "cb2918d4-3c54-344a-80d6-9bab21c11375",
                                "text": "„Sie werden von drei grossen Kreuzblumen bekrönt, zwischen denen sich zwei Fialen befinden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ba74205b-b195-3cdb-9088-46d764f698e4",
                        "entry_id": "57fa13f7-6936-32e7-87db-430ae14bcfb6",
                        "glosses": [
                            "Pflanze, die in verschiedensten Arten vorkommt und weiße bis rote Blüten aufweist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c7f8362-afe6-48ef-aa75-dd46c8c7b2d6",
                                "sense_id": "ba74205b-b195-3cdb-9088-46d764f698e4",
                                "text": "„In den Schweizer Bergen treibt es die Kreuzblume besonders bunt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
