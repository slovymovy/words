                                                "text": "Die suggestive Wirkung war unterschwellig."
                                            },
                                            {
                                                "example_id": "142fd051-3f20-4975-af01-b38b4e1a3d39",
                                                "sense_id": "c7dca26c-bdce-3d3b-99e2-77a8ccf2a4fc",
