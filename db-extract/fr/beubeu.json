                "senses": [
                    {
                        "sense_id": "f870b418-9ddd-3828-a22a-1e88c53c81dc",
                        "entry_id": "4b6f3f77-f010-3aef-8db1-a827f81200e3",
                        "glosses": [
                            "Personne stupide, naïve, intellectuellement déficiente."
                        ],
                        "tags": [
                            "common",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "89f5c0d5-d47a-46a8-99bb-fe6d8b12a826",
                                "sense_id": "f870b418-9ddd-3828-a22a-1e88c53c81dc",
                                "text": "Nous RAPPELONS (comme si les beubeus d’auditeurs l’avaient déjà oublié) que DEUX femmes ont été ASSASSINÉES dans des conditions ABOMINABLES."
                            },
                            {
                                "example_id": "ff8c0ec1-2ed9-48a7-9a37-56a4342fe3ac",
                                "sense_id": "f870b418-9ddd-3828-a22a-1e88c53c81dc",
                                "text": "A le voir marmonner, dodeliner de la tête, ils le prenaient pour un beubeu. Le juge d'instruction s'échauffait contre le flic :\n— Mais regardez-le ! C'est un crétin fini ! Un sous-fifre ! Nous perdons notre temps !"
                            },
                            {
                                "example_id": "04d68803-5872-4b07-a7c4-31ea0131b611",
                                "sense_id": "f870b418-9ddd-3828-a22a-1e88c53c81dc",
                                "text": "Un court silence durant lequel je me retiens de l’interroger, mais ce beubeu plonge en plein dedans :\n — On a pris les clés dans le placard de l’Infirmerie .\nIls ont volé les clés. Je rêve ! Ils n’ont aucune gêne !"
                            }
                        ]
                    }
