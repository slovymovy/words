                "senses": [
                    {
                        "sense_id": "61b92ec8-3ddb-3cf9-a0da-f03b89533da8",
                        "entry_id": "86503d02-2bd2-3700-93bc-dac7b2b5b171",
                        "glosses": [
                            "mit einem Schaufelrad versehener Bagger, der beim Abbau von Rohstoffen (etwa im Braunkohletagebau) und auf Großbaustellen zum Einsatz kommt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c0f3f42-74ed-4b53-b6c2-43cec34ff2f5",
                                "sense_id": "61b92ec8-3ddb-3cf9-a0da-f03b89533da8",
                                "text": "„288 – Diesen unauffälligen Namen trägt ein ganz und gar nicht unauffälliger Bagger: Der größte Schaufelradbagger der Welt.“"
                            },
                            {
                                "example_id": "18130aa2-99b9-49f1-87ce-1f8dc3df26f9",
                                "sense_id": "61b92ec8-3ddb-3cf9-a0da-f03b89533da8",
                                "text": "„Bis zu 400 Meter tief graben die riesigen Schaufelradbagger, um die Braunkohle zu fördern.“"
                            },
                            {
                                "example_id": "5ed88834-8d7b-4f4e-9746-644f3929eac2",
                                "sense_id": "61b92ec8-3ddb-3cf9-a0da-f03b89533da8",
                                "text": "„Danach können Sie vom Aussichtspunkt Hambach/Garzweiler die riesigen Schaufelradbagger bestaunen.“"
                            },
                            {
                                "example_id": "4aff6057-0d69-474b-b999-1e4470fec76f",
                                "sense_id": "61b92ec8-3ddb-3cf9-a0da-f03b89533da8",
                                "text": "„Kernstück der Ausstellung sind zwei Großgeräte aus dem ehemaligen Großtagebau Espenhain - der Schaufelradbagger 1547 (1.300 t, BJ. 1985) und das Bandabwurfgerät (Absetzer) 1115 (2.400 t, BJ. 1986).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
