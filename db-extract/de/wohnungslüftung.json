                "senses": [
                    {
                        "sense_id": "63e96834-0731-302e-95d2-06dc79c8db10",
                        "entry_id": "b931f016-7b6a-3f2f-93f2-cd4e788f0c98",
                        "glosses": [
                            "Oberbegriff für die Lüftungsarten in Wohnungen und Gebäuden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a2495b2-b700-4943-85f0-3754bef38ea0",
                                "sense_id": "63e96834-0731-302e-95d2-06dc79c8db10",
                                "text": "Die Entscheidung zwischen freier oder maschineller Lüftung bei der Wohnungslüftung obliegt dem Planer und dem Bauherrn gemeinsam."
                            },
                            {
                                "example_id": "a4600e26-a5b3-4fbb-8515-d1214a70be79",
                                "sense_id": "63e96834-0731-302e-95d2-06dc79c8db10",
                                "text": "„Seit Juli 2009 liegt eine neue Norm vor, die die Geräte für die Wohnungslüftung vollständig beschreibt.“"
                            },
                            {
                                "example_id": "15096958-1d51-4ce5-9b18-0040ccde2be6",
                                "sense_id": "63e96834-0731-302e-95d2-06dc79c8db10",
                                "text": "„Durch kontrollierte, automatische Wohnungslüftung lässt sich im Vergleich zu manueller Lüftung nicht nur Energie - und damit bares Geld - einsparen. Auch die Behaglichkeit des Raumklimas ist stets gewährleistet.“"
                            },
                            {
                                "example_id": "03348b96-5778-40bc-a89f-03c5979a0103",
                                "sense_id": "63e96834-0731-302e-95d2-06dc79c8db10",
                                "text": "„Die baurechtlich eingeführte Norm 4108-2 fordert eine planerisch gesicherte Grundlüftung während der Heizperiode und verweist für Wohnungslüftung auf DIN 1946-6.“"
                            },
                            {
                                "example_id": "a45d69a1-a9d7-4590-930f-5fc6b2a8609a",
                                "sense_id": "63e96834-0731-302e-95d2-06dc79c8db10",
                                "text": "„In jedem Moment bietet die bedarfsgeführte Wohnungslüftung eine Optimierung der Innenraumluftqualität und eine Senkung des Heizverbrauchs, ganz automatisch. Dank der Reduzierung der Luftwechselrate bietet die bedarfsgeführte Wohnungslüftung zahlreiche indirekte Vorteile neben einer permanenten Optimierung der Raumluftqualität und Energieeinsparungen“"
                            },
                            {
                                "example_id": "ce317950-8d73-410e-86b1-0f372a642639",
                                "sense_id": "63e96834-0731-302e-95d2-06dc79c8db10",
                                "text": "„Wohnungslüftung - Systeme tauschen „auf Knopfdruck“ exakt die erforderliche Luftmenge aus und schaffen so eine hervorragende Luftqualität.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
