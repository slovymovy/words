                "senses": [
                    {
                        "sense_id": "8b997483-0dfe-3e6f-93fc-c08780fbf207",
                        "entry_id": "5ec3ecba-3fb8-3225-8151-13ebbec8e264",
                        "glosses": [
                            "Torte, die Marzipan enthält oder mit einer Schicht aus Marzipan belegt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3b5e3c0-eee5-4117-acf5-9bc6a161b87c",
                                "sense_id": "8b997483-0dfe-3e6f-93fc-c08780fbf207",
                                "text": "„Und wenn ich zehn Bahnen schwimme, wird sich das Stück Marzipantorte nicht auf meinen Hüften niederlassen. Ich liebe Marzipantorte! Ich hasse Schwimmbäder!“"
                            },
                            {
                                "example_id": "3a6629e9-76a5-4f94-b733-d9d7c822a72f",
                                "sense_id": "8b997483-0dfe-3e6f-93fc-c08780fbf207",
                                "text": "„Da sind wir beide ja mal richtig erfolgreich, kommentierte Ola zufrieden, während er mein Stück Marzipantorte aufaß, das ich nicht mehr schaffte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
