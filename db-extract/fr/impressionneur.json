                        "glosses": [
                            "Personne qui impressionne."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "f6032114-a46e-41ac-b34a-c6f4fabf8b5d",
                                "sense_id": "55a8991e-6a5d-33f1-8806-216b13f3db0a",
                                "text": "Au milieu de ce monde, la duchesse avait grand mal à conserver une vertueuse impassibilité; par leurs talents, leur valeur, leur physique, leur naissance, même leurs vices, tous ces hommes étaient des impressionneurs, elle une impressionnable."
