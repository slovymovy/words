                    ],
                    "common_phrases": [
                        "nieuwe toplaag",
                        "beschermende toplaag"
                    ],
                    "target_lang_definitions": {
                        "en": "the uppermost layer of something consisting of several layers"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "top layer",
                                "target_lang_sense_clarification": "general use for the highest layer"
                            },
                            {
                                "target_lang_word": "surface layer",
                                "target_lang_sense_clarification": "the layer at the very surface"
                            },
                            {
                                "target_lang_word": "topcoat",
                                "target_lang_sense_clarification": "specifically for paint or protective finishes"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "428259d6-0c5a-33e5-954a-b1ab5764b522",
                    "sense_definition": "de elite of de hoogste leidinggevenden van een groep, organisatie of samenleving",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "hiërarchie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>toplaag</w> van het bedrijf besloot om de koers van de organisatie drastisch te wijzigen.",
                            "target_lang_translations": {
                                "en": "The <w>top tier</w> of the company decided to drastically change the organization's course."
                            }
                        },
                        {
                            "text": "In deze conservatieve samenleving heeft de <w>toplaag</w> nog steeds alle macht in handen.",
                            "target_lang_translations": {
                                "en": "In this conservative society, the <w>upper crust</w> still holds all the power."
                            }
                        }
                    ],
                    "synonyms": [
                        "elite",
                        "bestuur",
                        "directie",
                        "leiding",
                        "top",
                        "staf"
                    ],
                    "antonyms": [
                        "basis",
                        "onderlaag"
                    ],
                    "common_phrases": [
                        "toplaag van de samenleving",
                        "toplaag van het bedrijf"
                    ],
                    "target_lang_definitions": {
                        "en": "the elite or the highest-ranking executives of a group, organization, or society"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "upper crust",
                                "target_lang_sense_clarification": "social elite"
                            },
                            {
                                "target_lang_word": "top tier",
                                "target_lang_sense_clarification": "highest level of an organization"
                            },
                            {
                                "target_lang_word": "elite",
                                "target_lang_sense_clarification": "the most powerful or successful group"
                            }
                        ]
                    }
                }
