                                            {
                                                "example_id": "34009487-e08c-4861-8fe1-7626b61e6af7",
                                                "sense_id": "7511a2c1-f2f2-397a-b0e9-9d1ebd6f9e34",
                                                "text": "Un espasmo de muerte me vuelve a abrazar, me atraviesa los costados, parece que no me quiere dejar ningún descanso el mal miserable que me devora. ¡Oh, soberano Hades, recíbeme! ¡Oh rayo de Zeus hiéreme! Porque el mal de nuevo me devora, está en su plenitud, llega al paroxismo."
                                            }
                                        ],
