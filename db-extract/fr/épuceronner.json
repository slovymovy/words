                "senses": [
                    {
                        "sense_id": "752fb6df-7c0d-3e92-9d35-d864d43a36cf",
                        "entry_id": "ebe46bbf-a6be-34fc-8202-2db55c927dd8",
                        "glosses": [
                            "Débarrasser des pucerons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6c23a6f-1ed3-45de-ac5a-07df6c6117b8",
                                "sense_id": "752fb6df-7c0d-3e92-9d35-d864d43a36cf",
                                "text": "Quand on se sert comme toi d'un Karcher pour épuceronner ses légumes on conçoit aisément la sottise que tu viens d'écrire..."
                            },
                            {
                                "example_id": "f863a9de-3db4-405c-b6de-a04c33266878",
                                "sense_id": "752fb6df-7c0d-3e92-9d35-d864d43a36cf",
                                "text": "Je m'en étais allé aux champs, ces jours derniers, pour épuceronner les rosiers de mon jardin, tailler mes treilles, donner du sécateur dans l'élan printanier des rejets, surgeons et gourmands des arbres de mon verger."
                            },
                            {
                                "example_id": "f8899deb-a21b-450e-a217-064a4df03b98",
                                "sense_id": "752fb6df-7c0d-3e92-9d35-d864d43a36cf",
                                "text": "On dit épuceronner, comme on dit écheniller, ce qui signifie détruire ces insectes."
                            }
                        ]
                    }
                ],
