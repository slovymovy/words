                "senses": [
                    {
                        "sense_id": "e64052db-a250-3f34-b6ed-fd0fdb7086eb",
                        "entry_id": "bf7bcc14-2bcc-32ef-8073-f684d171a1cf",
                        "glosses": [
                            "einem Frosch ähnelnd, an einen Frosch erinnernd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "728163f7-de7d-40b4-9d59-792d05f88312",
                                "sense_id": "e64052db-a250-3f34-b6ed-fd0fdb7086eb",
                                "text": "„Das Tier sah mich mit trüben, blutunterlaufenen Augen an, die sich zu schließen schienen. Es bewegte kraftlos den Kopf und aus seinem dünnen Hals drang ein froschartiges Quaken.“"
                            },
                            {
                                "example_id": "ef33d616-f7ea-42d7-ab16-3333adc42699",
                                "sense_id": "e64052db-a250-3f34-b6ed-fd0fdb7086eb",
                                "text": "„Er sah noch froschartiger aus, und sein Körper schien etwas geschrumpft zu sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
