                        "sense_id": "a60dbe3c-510a-3df3-b489-5bd95e8ec16e",
                        "entry_id": "85286b5e-f7a9-35ba-b96f-5471ab9565ca",
                        "glosses": [
                            "der gesamte Bereich, der Maßnahmen zur Betreuung und Pflege alter Menschen umfasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbfc5d1c-50f0-4d8a-8b79-f425d6e9b5d7",
                                "sense_id": "a60dbe3c-510a-3df3-b489-5bd95e8ec16e",
                                "text": "„Die rund 661.000 Beschäftigten in der Altenpflege reichen nicht aus, um allen Pflegebedürftigen hierzulande gerecht zu werden. Geschweige denn, um die zunehmende Zahl alter Menschen ausreichend zu versorgen.“"
                            },
                            {
                                "example_id": "efbc99cd-18a8-4bc1-be40-90c69f48fcdb",
                                "sense_id": "a60dbe3c-510a-3df3-b489-5bd95e8ec16e",
                                "text": "„Aber Onni Nurmi hatte in seinem Testament festgelegt, dass das Geld ausschließlich zur Förderung der Altenpflege verwendet werden durfte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
