                "senses": [
                    {
                        "sense_id": "22de356b-1654-3d35-9d87-2059406ceec1",
                        "entry_id": "e0428ba4-1985-3c06-9557-157a91bd1511",
                        "glosses": [
                            "delen van het Nederlandse bedrijfsleven die op hun gebied kunnen concurreren met de meest vooraanstaande bedrijven van de wereld en waarin veel geïnvesteerd moet worden qua onderzoek om deze positie te behouden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84a806d7-e6b7-4566-8d00-bbaf5e7411fe",
                                "sense_id": "22de356b-1654-3d35-9d87-2059406ceec1",
                                "text": "Er is 400 miljoen euro beschikbaar voor onderzoek in de topsectoren van de Nederlandse economie. Minister Henk Kamp (Economische Zaken) meldt dat in een brief aan de Tweede Kamer dit weekend, voorafgaand aan het overleg dat hij maandag met de Kamer heeft over ondernemen. Ruim 1500 bedrijven trekken komend jaar 319 miljoen euro uit voor onderzoek en het kabinet legt er 83 miljoen euro bij, aldus de minister."
                            },
                            {
                                "example_id": "9e3be9c5-7adc-4582-898b-fa686b3fa70e",
                                "sense_id": "22de356b-1654-3d35-9d87-2059406ceec1",
                                "text": "De topsectoren hebben op verzoek van Verhagen sinds september gewerkt aan zogenoemde innovatiecontracten met kennisinstellingen zoals NWO, KNAW en TNO. Dat betekent dat ze samen hebben gekeken op welk gebied onderzoek kan leiden tot betere, vernieuwende en concurrerende producten en diensten."
                            },
                            {
                                "example_id": "aeadb7d2-92af-4fb7-93e0-dce9412d9168",
                                "sense_id": "22de356b-1654-3d35-9d87-2059406ceec1",
                                "text": "Het kabinet blijft komend jaar inzetten op mogelijkheden om de economische groei te versterken. Zo is er 2,8 miljard euro beschikbaar om de topsectoren van de Nederlandse economie verder uit te bouwen."
                            }
                        ]
                    }
