                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2f740380-674b-4814-8fba-4e2e8f9ebd4e",
                        "entry_id": "ef5fa3a9-05ff-32ad-8cea-545dbba14cbf",
                        "tags": [
                            "plural"
                        ],
                        "form": "authentifications"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cec57dbe-9b09-3669-a125-fc326e4a20f1",
                        "entry_id": "ef5fa3a9-05ff-32ad-8cea-545dbba14cbf",
                        "glosses": [
                            "Action visant à authentifier un document, un acte, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31bf95d1-bf96-4dde-b65a-87b0411382e6",
                                "sense_id": "cec57dbe-9b09-3669-a125-fc326e4a20f1",
                                "text": "Je crois qu’au contraire il faut la rendre obligatoire quitte à trouver le minimum de coût de la procédure d’authentification pour que ça ne pénalise pas le producteur et le marché de la perle."
                            }
                        ]
                    },
                    {
                        "sense_id": "3d5deb21-ffa6-39a8-944c-27e70613bddf",
                        "entry_id": "ef5fa3a9-05ff-32ad-8cea-545dbba14cbf",
                        "glosses": [
                            "Vérification de l’identité d’une entité (personne, ordinateur…), afin d’autoriser l’accès de cette entité à des ressources (systèmes, réseaux, applications…)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0ec3b07-6679-492c-860d-a69ed8a94862",
                                "sense_id": "3d5deb21-ffa6-39a8-944c-27e70613bddf",
                                "text": "Les NFT m’intéressent aussi pour les possibilités qu’ils offrent en matière de fundraising, de gouvernance ou encore d’authentification."
                            }
                        ]
                    },
                    {
                        "sense_id": "df73e136-24c7-3b7c-a092-2b529fd46ae0",
                        "entry_id": "ef5fa3a9-05ff-32ad-8cea-545dbba14cbf",
                        "glosses": [
                            "Le fait de s’assurer, par une procédure conventionnelle, de la qualité de son correspondant."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9fe0afac-78da-49ad-ad33-0fd88a14c73d",
