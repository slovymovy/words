                                        ]
                                    },
                                    {
                                        "sense_id": "82794318-1eb1-3dc8-8633-04bcd9d1e6bd",
                                        "entry_id": "44794dee-1ed7-3afb-a3c7-89385ad43a5d",
                                        "glosses": [
                                            "Something that is in the process of improving."
