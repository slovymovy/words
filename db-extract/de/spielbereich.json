                ],
                "senses": [
                    {
                        "sense_id": "8d4cb56a-5b60-3edf-86dc-a41a7a3ffc47",
                        "entry_id": "9a073c31-ddd4-3bcb-949f-3f6b38255c5c",
                        "glosses": [
                            "ein Areal oder Handlungsfeld, das auf das Spielen ausgerichtet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d79ee7b2-1841-4484-9255-55f838663f71",
                                "sense_id": "8d4cb56a-5b60-3edf-86dc-a41a7a3ffc47",
                                "text": "„Andererseits wird das Kind auf seinen Spielbereich abgeschoben, es wird zum Spielen weggeschickt, bleibt sich im Spiel selbst überlassen und von der Welt der Erwachsenen isoliert.“"
                            },
                            {
                                "example_id": "650dced0-d324-46c0-9314-7ac40fa2010e",
                                "sense_id": "8d4cb56a-5b60-3edf-86dc-a41a7a3ffc47",
                                "text": "„Die Technik eroberte sich auch Spielbereiche, die technischer Mittel kaum bedurften, jedoch den Gegenstand mit Funktionen ausstatteten, die ihn manipulierbarer und realistischer erscheinen ließen.“"
                            },
                            {
                                "example_id": "babaef90-0e34-4619-907c-746853aeede4",
                                "sense_id": "8d4cb56a-5b60-3edf-86dc-a41a7a3ffc47",
                                "text": "„Man deutete die Konkurrenzspiele als Spiegelbild der Leistungsgesellschaft und fürchtete ein Überhandnehmen des Leistungsgedankens auch im Spielbereich, der eher als kontrastierendes Erlebnisfeld verstanden wurde.“"
                            },
                            {
                                "example_id": "85a24f7d-31db-4429-8cf6-b3e9cec4e6c0",
                                "sense_id": "8d4cb56a-5b60-3edf-86dc-a41a7a3ffc47",
                                "text": "„Es hat einen Spielbereich und einen Wickelraum und bietet samstags kostenlose Kinderbetreuung an.“"
                            },
                            {
                                "example_id": "093493e6-f01d-46d2-ae1e-0e11873a50e7",
                                "sense_id": "8d4cb56a-5b60-3edf-86dc-a41a7a3ffc47",
                                "text": "„Dabei dient bei jedem Partner-Hotel unter anderem eine familienfreundliche Infrastruktur mit geräumigen Unterkünften, einem Kinder-Buffet, sicheren Spielbereichen und einem abwechslungsreichen, liebevoll betreuten Kinderprogramm in den vorgeschriebenen Qualitätsstandards als Fundament.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
