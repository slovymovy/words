                        "glosses": [
                            "lijnen die aangeven hoe de krachten lopen in een krachtveld"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fe9873b-4b7a-4d71-9e0b-196f8cd76c9a",
                                "sense_id": "7780fd7e-d949-3815-a4b1-8268730bd5c9",
                                "text": "YouTube wemelt van de filmpjes van maffe magneetvloeistoffen die vreemd reageren op naderende magneten. Haast hysterische pieken en stekels, ze krullen op, kartelen en wervelen. Allemaal omdat de ijzerdeeltjes in het spul de krachtlijnen van de magneet moeten volgen en tegelijk ook zelf een tikje magnetisch worden."
                            },
                            {
                                "example_id": "96e48d3f-49d7-4828-bf62-e5d49f1dba84",
                                "sense_id": "7780fd7e-d949-3815-a4b1-8268730bd5c9",
                                "text": "De krachtlijnen lopen door de lucht, schuin omhoog vanuit de aarde. Ze reizen naar het zuidelijk halfrond en duiken in de buurt van het eiland Bouvet ten zuidwesten van Kaapstad in de oceaan."
                            }
                        ]
                    }
