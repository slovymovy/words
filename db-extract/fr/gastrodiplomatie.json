                        "sense_id": "22e66729-f7ab-3a93-b610-653d09725d56",
                        "entry_id": "555e9bdb-26ed-3712-8a03-8033b0190845",
                        "glosses": [
                            "Diplomatie utilisant la culture culinaire d’un pays pour améliorer les relations internationales et promouvoir sa culture."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef0ffeb3-b9dd-4e56-81f8-5b82134e4e88",
                                "sense_id": "22e66729-f7ab-3a93-b610-653d09725d56",
                                "text": "La Thaïlande a été pionnière dans la pratique de la gastrodiplomatie en encourageant ses ressortissants à ouvrir des restaurants thaïlandais à travers le monde."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "32ed668d-ddcd-48ef-a012-d6f535f8c185",
                        "source_entry_id": "555e9bdb-26ed-3712-8a03-8033b0190845",
                        "source_sense_id": "22e66729-f7ab-3a93-b610-653d09725d56",
