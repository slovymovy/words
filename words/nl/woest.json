                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij schudde zijn hoofd <w>woest</w> heen en weer om nee te zeggen.",
                            "target_lang_translations": {
                                "en": "He shook his head <w>wildly</w> back and forth to say no.",
                                "ru": "Он <w>яростно</w> мотал головой из стороны в сторону, чтобы сказать «нет».",
                                "fr": "Il secouait la tête <w>furieusement</w> d'un côté à l'autre pour dire non."
                            }
                        },
                        {
                            "text": "De wind waaide <w>woest</w> door de bomen tijdens de zware storm.",
                            "target_lang_translations": {
