{
    "word_family": [
        "kram",
        "krammer",
        "ontkrammen"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dc91684e-6e89-3372-84b5-2f73c1a1433a",
                    "sense_definition": "Vastmaken met behulp van metalen staafjes die aan beide uiteinden ombuigen tot een haakje dat in het te bevestigen materiaal wordt gestoken.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bij honderden waren de mensen doende boten te bouwen en te herstellen, te <w>krammen</w> en te snoeren.",
                            "target_lang_translations": {
                                "en": "By the hundreds, people were busy building and repairing boats, <w>stapling</w> and lashing them."
                            }
                        },
                        {
                            "text": "De timmerman moest de houten planken stevig <w>krammen</w> om te voorkomen dat ze loslieten.",
                            "target_lang_translations": {
                                "en": "The carpenter had to <w>clamp</w> the wooden planks firmly to prevent them from coming loose."
                            }
                        }
                    ],
                    "synonyms": [
                        "vastkrammen",
                        "hechten"
                    ],
                    "antonyms": [
                        "ontkrammen"
                    ],
                    "common_phrases": [
                        "houten planken krammen"
                    ],
                    "target_lang_definitions": {
                        "en": "To fasten or secure using metal staples or clamps with bent ends inserted into the material."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to staple",
                                "target_lang_sense_clarification": "fasten with metal staples"
                            },
                            {
                                "target_lang_word": "to clamp",
                                "target_lang_sense_clarification": "secure with clamps or brackets"
                            },
                            {
                                "target_lang_word": "to cramp",
                                "target_lang_sense_clarification": "fasten with a metal cramp"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "014e2bdb-8aaf-3cf8-9b53-458213e55fbb",
                    "sense_definition": "Meervoud van het zelfstandig naamwoord <w>kram</w>.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De archeologen vonden ijzeren <w>krammen</w> die het breeuwsel tussen de scheepsnaden op zijn plaats hielden.",
                            "target_lang_translations": {
                                "en": "The archaeologists found iron <w>staples</w> that held the caulking in place between the ship's seams."
                            }
                        },
                        {
                            "text": "Hij kocht een doosje met metalen <w>krammen</w> om het gaas aan de palen te bevestigen.",
                            "target_lang_translations": {
                                "en": "He bought a box of metal <w>staples</w> to attach the wire mesh to the posts."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ijzeren krammen"
                    ],
                    "target_lang_definitions": {
                        "en": "Plural form of the noun 'kram' (staple, cramp, or metal fastener)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "staples",
                                "target_lang_sense_clarification": "U-shaped metal fasteners"
                            },
                            {
                                "target_lang_word": "cramps",
                                "target_lang_sense_clarification": "metal brackets or clamps used in building"
                            },
                            {
                                "target_lang_word": "clamps",
                                "target_lang_sense_clarification": "devices used to hold things together"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}