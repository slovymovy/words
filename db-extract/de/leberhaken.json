                "senses": [
                    {
                        "sense_id": "3033c565-517b-3b32-8a47-f9fd3961cb6b",
                        "entry_id": "0a8a118a-6448-3560-ae57-9b85413f7943",
                        "glosses": [
                            "Schlag auf den Bereich der Leber einer anderen Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9e52975-989e-4270-8a98-0e5e64724fe6",
                                "sense_id": "3033c565-517b-3b32-8a47-f9fd3961cb6b",
                                "text": "„Deshalb drehte ich mich weg, sodass sein Leberhaken nur an meiner Kleidung radierte.“"
                            },
                            {
                                "example_id": "6e540a83-14fe-4f1d-80cc-91e8aff19021",
                                "sense_id": "3033c565-517b-3b32-8a47-f9fd3961cb6b",
                                "text": "„Er erwischte den ersten Mann voll am Kinn und schickte auch noch einen Sergeanten mit einem Leberhaken zu Boden.“"
                            },
                            {
                                "example_id": "593cc94f-60d6-4886-af08-73edf65ecabe",
                                "sense_id": "3033c565-517b-3b32-8a47-f9fd3961cb6b",
                                "text": "„Der Boxer musste dagegen einen schmerzhaften Leberhaken und vier harte Kopftreffer kassieren.“"
                            },
                            {
                                "example_id": "a3fa6c34-dbf6-4e7d-85d4-7025f22e94a5",
                                "sense_id": "3033c565-517b-3b32-8a47-f9fd3961cb6b",
                                "text": "„Er ließ ihn immer aufs neue hochkommen, und er zerschlug systematisch den Schatten seines Feindes, keuchend vor Erregung, wobei ihm zum Schluß als besondere Delikatesse schwere Leberhaken einfielen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
