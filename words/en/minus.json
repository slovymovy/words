                        "zh": [
                            {
                                "target_lang_word": "负",
                                "target_lang_sense_clarification": "数学上的负数"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bcf73e4b-e7fe-3b86-a1be-b19f2b7b5382",
                    "sense_definition": "Ranking slightly below a specific grade or rating.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "rating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was disappointed to receive a B <w>minus</w> on her final essay.",
                            "target_lang_translations": {
                                "ru": "Она была расстроена, получив «четверку» <w>с минусом</w> за итоговое эссе.",
                                "zh": "她对期末论文只拿到B<w>减</w>感到很失望。"
                            }
                        },
                        {
                            "text": "The student worked hard to improve his grade from a C <w>minus</w>.",
                            "target_lang_translations": {
                                "ru": "Студент усердно работал, чтобы исправить свою оценку «удовлетворительно» <w>с минусом</w>.",
                                "zh": "这名学生努力学习，想把C<w>减</w>的成绩提上去。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "B minus",
                        "A minus"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ранг чуть ниже определенной оценки или рейтинга.",
                        "zh": "等级略低于特定的分数或评级。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "с минусом",
                                "target_lang_sense_clarification": "об оценке"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "减",
                                "target_lang_sense_clarification": "用于等级后表示略低"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bc5020c1-afc5-36cb-b5a9-775caad5ff62",
                    "sense_definition": "Having less money than before; in a state of financial loss.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the failed investment, he found himself several thousand pounds <w>minus</w>.",
                            "target_lang_translations": {
                                "ru": "После неудачной инвестиции он оказался <w>в минусе</w> на несколько тысяч фунтов.",
                                "zh": "投资失败后，他发现自己<w>亏损</w>了几千英镑。"
                            }
                        },
                        {
                            "text": "The company ended the quarter <w>minus</w> by a significant margin.",
                            "target_lang_translations": {
                                "ru": "Компания закончила квартал <w>в убытке</w> со значительным отрывом.",
                                "zh": "公司本季度以大幅<w>亏损</w>告终。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "pounds minus"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий меньше денег, чем раньше; в состоянии финансового убытка.",
                        "zh": "拥有的钱比以前少；处于财务亏损状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "в минусе",
                                "target_lang_sense_clarification": "финансовый убыток"
                            },
                            {
                                "target_lang_word": "в убытке",
                                "target_lang_sense_clarification": "потеря денег"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "亏损",
                                "target_lang_sense_clarification": "财务上的损失"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6b0f4270-4bc0-3f2f-91c3-dfc00c373b26",
                    "sense_definition": "A disadvantage, drawback, or negative aspect of something.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "pros_cons",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We must weigh the plusses and <w>minuses</w> of moving to a new city.",
                            "target_lang_translations": {
                                "ru": "Мы должны взвесить все плюсы и <w>минусы</w> переезда в новый город.",
                                "zh": "我们必须权衡搬到新城市的利与<w>弊</w>。"
                            }
                        },
                        {
                            "text": "One major <w>minus</w> of the job is the long commute.",
                            "target_lang_translations": {
                                "ru": "Один из главных <w>недостатков</w> этой работы — долгая дорога.",
                                "zh": "这份工作的一个主要<w>缺点</w>是通勤时间太长。"
                            }
                        }
                    ],
                    "synonyms": [
                        "defect",
                        "deficiency",
                        "drawback",
                        "flaw",
                        "shortcoming"
                    ],
                    "antonyms": [
                        "advantage",
                        "bonus",
                        "boon",
                        "gain",
                        "plus"
                    ],
                    "common_phrases": [
                        "plusses and minuses",
                        "major minus"
