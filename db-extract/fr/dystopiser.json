                "senses": [
                    {
                        "sense_id": "8c889075-dada-3bce-b301-68c9ad155d5a",
                        "entry_id": "bcfaa665-d3bf-3f2b-8cf1-2c366794f4f3",
                        "glosses": [
                            "Donner un caractère dystopique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3fb4b4c6-b920-48b8-aa27-68069fbb3a35",
                                "sense_id": "8c889075-dada-3bce-b301-68c9ad155d5a",
                                "text": "J'avoue que je ne pensais pas qu’ils allaient autant \"dystopiser\" FA, pas glop."
                            },
                            {
                                "example_id": "7ad83c19-12e6-435c-9d28-bc2270fc606d",
                                "sense_id": "8c889075-dada-3bce-b301-68c9ad155d5a",
                                "text": "Tout le monde saute sur la moindre occasion, la moindre déclaration pour « dystopiser » une situation dans laquelle seule la population malgache paie et paiera les pots cassés."
                            },
                            {
                                "example_id": "2c8c5bb7-6ca3-47d0-9a6b-24e3f69d6b55",
                                "sense_id": "8c889075-dada-3bce-b301-68c9ad155d5a",
                                "text": "Et je vais « dystopiser » à fond encore pour quelques mois, puisque je traduis aussi la trilogie de Veronica Rossi chez Nathan."
                            }
                        ]
                    }
