                "senses": [
                    {
                        "sense_id": "1e6ead3a-0b70-3080-b21d-462bfd704ab5",
                        "entry_id": "77c690c1-a6cd-3704-9265-3f8ba0db5424",
                        "glosses": [
                            "Dont la forme rappelle celle de l’amidon."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ddb0a0f7-6451-3597-839b-df6768b3b991",
                        "entry_id": "77c690c1-a6cd-3704-9265-3f8ba0db5424",
                        "glosses": [
                            "De la nature de l’amidon, ou réagissant comme de l’amidon au contact de l’iode."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ecf6f02e-2cda-4de6-9d50-aaa08117aa7e",
                                "sense_id": "ddb0a0f7-6451-3597-839b-df6768b3b991",
                                "text": "Le type annellé s’oppose au précédent; il est dépourvu de nasse, mais possède (du moins en principe, car une évolution régressive les a souvent rudimentarisés ou supprimés) un ou plusieurs anneaux apicaux ; on les voit distincts ou soudés, et ils sont amyloïdes ou non."
                            },
                            {
                                "example_id": "2539ce9b-663a-432e-8d17-f92967087adc",
                                "sense_id": "ddb0a0f7-6451-3597-839b-df6768b3b991",
                                "text": "Des chercheurs suisses et italiens confirment ainsi qu’une corrélation existe entre un déséquilibre du microbiote intestinal et le développement des plaques amyloïdes dans le cerveau humain responsables de l’apparition de la démence."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fc48400c-05a1-49e4-a6ec-2a3cff10beb4",
                        "source_entry_id": "77c690c1-a6cd-3704-9265-3f8ba0db5424",
                        "target_lang_word": "Amyloid",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Amyloid",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "49b6d42c-2629-316c-a79f-3f7fac1c6f9f",
                                        "entry_id": "9fc2d2a5-fec6-3274-852a-8ffc4c587110",
                                        "glosses": [
                                            "stärkeähnlicher (amyloider) Eiweißkörper, der sich bei verschiedenen Krankheiten bildet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42f10ed5-2a92-4f0e-bba8-b436369dcf49",
                                                "sense_id": "49b6d42c-2629-316c-a79f-3f7fac1c6f9f",
                                                "text": "Bei rheumatischen Leiden ist manchmal auch ein Amyloid feszustellen."
                                            },
                                            {
                                                "example_id": "9e620e38-5dfe-49b0-bbf9-26c5c8c1c09b",
                                                "sense_id": "49b6d42c-2629-316c-a79f-3f7fac1c6f9f",
                                                "text": "„Nach seinem Verhalten zum Jod und zu den Anilinfarben ist das Chitin dem Amyloide ähnlich.“"
                                            },
                                            {
                                                "example_id": "dc6f955d-ecf4-4d19-b301-278e1d33b830",
                                                "sense_id": "49b6d42c-2629-316c-a79f-3f7fac1c6f9f",
                                                "text": "„Diese Degenerationsproducte haben mit dem Amyloide aber nichts Gemeinsames.“"
                                            },
                                            {
                                                "example_id": "b812a99c-1de0-48e1-a80c-d5903ed4acf3",
                                                "sense_id": "49b6d42c-2629-316c-a79f-3f7fac1c6f9f",
                                                "text": "„Zu der gleichen Überzeugung gelangte auch LETTERER durch chemische Lösung des Amyloides und Darstellung der zurückgebliebenen Fasern. Bei der amyloiden Infiltration der Herzmuskeln konnte BENEKE das Verhalten des Amyloides zu den Muskelfasern nach jeder Richtung hin einem genauen Studium unterziehen und dabei Umschlingung und Einmauerung des Muskelgewebes in Amyloid erheben."
                                            },
                                            {
                                                "example_id": "5102a664-6626-4514-81e3-11132506a247",
                                                "sense_id": "49b6d42c-2629-316c-a79f-3f7fac1c6f9f",
                                                "text": "„Eine anderweitige Lokalisation des Amyloides (Niere, Darm) ließ sich nicht erweisen.“"
                                            },
                                            {
                                                "example_id": "794fda48-74e5-4f54-964d-3237c4e08c11",
                                                "sense_id": "49b6d42c-2629-316c-a79f-3f7fac1c6f9f",
                                                "text": "„Die elektronenoptische Untersuchung des Amyloides hat grundlegend neue Kenntnisse zu seiner Struktur gebracht[.]“"
                                            },
                                            {
                                                "example_id": "8daca384-2bc3-4173-94d7-b47852367a9a",
                                                "sense_id": "49b6d42c-2629-316c-a79f-3f7fac1c6f9f",
                                                "text": "„Der Wachstumsfaktor Notch1 wird wahrscheinlich durch das gleiche Enzym gespalten, wie die Beta-Sekretase, die für die erhöhte Bildung des Amyloides bei der Alzheimer-Krankheit verantwortlich gemacht wird [..].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
