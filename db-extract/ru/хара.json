                "senses": [
                    {
                        "sense_id": "223c9a27-9c3a-35b9-b895-e057bcb534ff",
                        "entry_id": "1363da0f-64af-398a-aa58-46a0975d8aca",
                        "glosses": [
                            "женское имя"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "811f37e2-25a3-4b99-84c6-8027e268c9a0",
                                "sense_id": "223c9a27-9c3a-35b9-b895-e057bcb534ff",
                                "text": "Мою подругу зовут Хара."
                            }
                        ]
                    },
                    {
                        "sense_id": "9d6828f2-27aa-37c2-8cd6-01c008ed6281",
                        "entry_id": "1363da0f-64af-398a-aa58-46a0975d8aca",
                        "glosses": [
                            "мужское имя"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e404b6aa-ff41-4744-b6f9-ce4f76b307e1",
                                "sense_id": "9d6828f2-27aa-37c2-8cd6-01c008ed6281",
                                "text": "Молодой переводчик Хара пришел к нам в комнату и вскрикнул от ужаса: увидел на циновке туфли Любы."
                            }
                        ]
                    },
                    {
                        "sense_id": "ff253486-eb45-3623-a5e9-ade8f86db920",
                        "entry_id": "1363da0f-64af-398a-aa58-46a0975d8aca",
                        "glosses": [
                            "фамилия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7a40e87-bf83-44f6-af52-66a29e1f061d",
                                "sense_id": "ff253486-eb45-3623-a5e9-ade8f86db920",
                                "text": "А мне он давно казался сказочным героем, еще до развала коммунизма. Певец Виктор Хара? Это обычный уличный музыкант, попавший под «молотки», вполне вероятно, случайно погибший."
                            }
                        ]
                    }
