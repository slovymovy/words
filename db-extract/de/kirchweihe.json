                "senses": [
                    {
                        "sense_id": "6f90ccdb-4592-3e60-bdb1-30983e3c5a7c",
                        "entry_id": "149c9625-dc82-3c33-ab20-a98119e33a8c",
                        "glosses": [
                            "die feierliche Weihe eines Kirchengebäudes für seine gottesdienstliche Bestimmung durch einen Bischof"
                        ],
                        "tags": [
                            "Katholizismus"
                        ],
                        "examples": [
                            {
                                "example_id": "4693fff7-b4cc-42fa-9a43-f06976a5cb0c",
                                "sense_id": "6f90ccdb-4592-3e60-bdb1-30983e3c5a7c",
                                "text": "Nächste Woche feiern wir die große Kirchweihe."
                            },
                            {
                                "example_id": "8a50b5d0-ca49-4060-9ef8-b44dcdacb79e",
                                "sense_id": "6f90ccdb-4592-3e60-bdb1-30983e3c5a7c",
                                "text": "„In der frühchristlichen Zeit wurde die Kirchweihe mit einer feierlich abgehaltenen ersten Messe, die vom Ortsbischof oder einem von diesem eingesetzten Vertreter gefeiert wurde, begangen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0aff8280-3889-3889-96b7-d3ac143aeef0",
                        "entry_id": "149c9625-dc82-3c33-ab20-a98119e33a8c",
                        "glosses": [
                            "die jährliche Gedächtnisfeier an das unter [1] gefeierte Ereignis; das Kirchweihfest"
                        ],
                        "tags": [
                            "Katholizismus"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
