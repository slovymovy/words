                "translations": [
                    {
                        "translation_id": "12c023da-8f46-4ca3-9027-94a0fbd0d97d",
                        "source_entry_id": "e1f8c4cf-0331-344a-9ec9-ec1f80ecb627",
                        "source_sense_id": "bfce4590-24c1-3f2e-a643-6c8db88f8cf9",
