                                "target_senses": [
                                    {
                                        "sense_id": "d8975d32-c13a-3542-b718-c28d957a7d87",
                                        "entry_id": "b9ff5775-78e1-3a72-aa13-aad8995e5ff8",
                                        "glosses": [
                                            "Principe selon lequel les différents pouvoirs dans un État (généralement législatif, exécutif et judiciaire) sont exercés par des institutions différentes qui disposent d’une certaine indépendance entre elles."
                                        ],
                                        "tags": [
                                            "Droit constitutionnel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96e53cfb-6885-4bea-8c73-41f24c3f92a9",
                                                "sense_id": "d8975d32-c13a-3542-b718-c28d957a7d87",
                                                "text": "Les sages considèrent à l’égard de telles dispositions qu’en subordonnant le dépôt d’un projet de loi à l’établissement de telles carte, liste et bilan par le Gouvernement, le législateur a méconnu le principe de séparation des pouvoirs ainsi que le 1ᵉʳ alinéa de l’article 20 de la Constitution prévoyant que le Gouvernement détermine et conduit la politique de la Nation."
                                            }
                                        ]
                                    }
                                ]
                            }
