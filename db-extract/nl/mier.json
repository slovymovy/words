                                "sense_id": "4a9d0ddb-829f-35f4-9ca6-005ec0bff6c0",
                                "text": "Wij hebben heel vaak last van mieren."
                            },
                            {
                                "example_id": "49103254-3e3d-4200-865f-7dfda53794a8",
                                "sense_id": "4a9d0ddb-829f-35f4-9ca6-005ec0bff6c0",
                                "text": "Overal waar je keek zag je leven in de woestijn. Duikende vogels, mieren, hagedissen en het onophoudelijke gezang van de krekels."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
