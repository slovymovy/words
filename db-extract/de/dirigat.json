                "senses": [
                    {
                        "sense_id": "f951a7a3-a8f8-344d-859a-2cf5b7849497",
                        "entry_id": "4bb6d01a-b439-31f3-a632-bf4edb37872d",
                        "glosses": [
                            "die Leitung eines Orchesters oder Chores"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90657ba7-beb8-4a5c-8504-bcc5c1bbd6ea",
                                "sense_id": "f951a7a3-a8f8-344d-859a-2cf5b7849497",
                                "text": "Im Jahre 1853 übernahm Herr Hauptlehrer Barlen das Dirigat [des Chores] von Herrn Rosenkranz."
                            },
                            {
                                "example_id": "9fe260ad-c21c-4a5c-aafc-fdcd3be39ec1",
                                "sense_id": "f951a7a3-a8f8-344d-859a-2cf5b7849497",
                                "text": "Nach der Amtszeit des Dirigenten Wefers wird Lehrer Franz Hilgers im Juli mit dem Dirigat betraut, das er bis zum 17. Dezember 1939 inne hat."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d5ae8dc5-713b-3e98-9d83-01aae1491c96",
                        "entry_id": "4bb6d01a-b439-31f3-a632-bf4edb37872d",
                        "glosses": [
                            "die konkrete Tätigkeit eines Dirigenten; das öffentliche Auftreten eines Dirigenten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b807e76-727f-4bc5-a205-35fc052182dc",
                                "sense_id": "d5ae8dc5-713b-3e98-9d83-01aae1491c96",
                                "text": "Das Dirigat eines Stückes setzt eine intensive Beschäftigung des Chorleiters mit dem Stück voraus."
                            },
                            {
                                "example_id": "e7d48bd3-6853-47d9-b55f-1eb2636a2f0f",
                                "sense_id": "d5ae8dc5-713b-3e98-9d83-01aae1491c96",
                                "text": "Am weitesten entfernt sich das Tenorsolo \"Stricke des Todes\" von der religiös-innigen Grundstimmung, das im Zusammenspiel von Neuhoffs Dirigat und Donát Havárs Gesang zu einer berührenden Szene gestaltet wurde."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
