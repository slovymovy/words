{
    "word_family": [
        "lunatic",
        "lunar"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "559e41b0-e865-37f0-9378-3e45bf99b762",
                    "sense_definition": "The state of being mentally ill or insane.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "mental_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor described the patient's condition as a form of <w>lunacy</w>.",
                            "target_lang_translations": {
                                "nl": "De dokter omschreef de toestand van de patiënt als een vorm van <w>krankzinnigheid</w>."
                            }
                        },
                        {
                            "text": "Historical beliefs often linked <w>lunacy</w> to the changing phases of the moon.",
                            "target_lang_translations": {
                                "nl": "Historische opvattingen brachten <w>maanziekte</w> vaak in verband met de veranderende schijngestalten van de maan."
                            }
                        }
                    ],
                    "synonyms": [
                        "insanity",
                        "madness",
                        "craziness"
                    ],
                    "target_lang_definitions": {
                        "nl": "De toestand van geestelijk ziek of krankzinnig zijn."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "krankzinnigheid",
                                "target_lang_sense_clarification": "geestesziekte of ernstige mentale stoornis"
                            },
                            {
                                "target_lang_word": "waanzin",
                                "target_lang_sense_clarification": "toestand van verstandsverbijstering of geestesziekte"
                            },
                            {
                                "target_lang_word": "maanziekte",
                                "target_lang_sense_clarification": "historische benaming voor periodieke krankzinnigheid gekoppeld aan de maan"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "db58e9d1-449d-353b-a0d3-b609753f5de4",
                    "sense_definition": "An act or idea that is extremely foolish or misguided.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "foolishness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was pure <w>lunacy</w> to drive through the storm without any headlights.",
                            "target_lang_translations": {
                                "nl": "Het was pure <w>waanzin</w> om zonder koplampen door de storm te rijden."
                            }
                        },
                        {
                            "text": "The decision to cancel the project was absolute <w>lunacy</w>.",
                            "target_lang_translations": {
                                "nl": "Het besluit om het project te schrappen was volslagen <w>waanzin</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pure lunacy",
                        "absolute lunacy"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een handeling of idee dat uiterst dwaas, onverstandig of absurd is."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "waanzin",
                                "target_lang_sense_clarification": "volstrekt onverstandig of bizar gedrag"
                            },
                            {
                                "target_lang_word": "gekte",
                                "target_lang_sense_clarification": "dwaasheid of absurditeit"
                            },
                            {
                                "target_lang_word": "dwaasheid",
                                "target_lang_sense_clarification": "zeer onverstandige handeling"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}