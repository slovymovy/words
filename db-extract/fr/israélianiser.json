                "senses": [
                    {
                        "sense_id": "b2364443-bf1d-301a-bd84-a6eb3a4d0ae9",
                        "entry_id": "467a8f67-4e48-3fac-979e-669c45acd3f8",
                        "glosses": [
                            "Donner un caractère israélien à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4e7463c-9c73-4ac6-8891-bfda05cdf7b5",
                                "sense_id": "b2364443-bf1d-301a-bd84-a6eb3a4d0ae9",
                                "text": "L’État hébreu a progressivement affirmé son contrôle sur la ville mais il a plus cherché à \"l’israélianiser\" qu’à la judaïser."
                            },
                            {
                                "example_id": "e3591ad3-b517-4ac6-b956-e15503e95b9e",
                                "sense_id": "b2364443-bf1d-301a-bd84-a6eb3a4d0ae9",
                                "text": "En Israël, encore moins nombreux qu'ailleurs, ils ont particulièrement bien réussi à s'israélianiser."
                            },
                            {
                                "example_id": "f6a56429-3ef2-49e6-af91-cf5d5d2f7314",
                                "sense_id": "b2364443-bf1d-301a-bd84-a6eb3a4d0ae9",
                                "text": "Mais on ne doit pas se rassurer, car en fait le terrorisme est en train de s'\"israélianiser\" ici, et bientôt en Europe et aux Etast-Unis."
                            }
                        ]
                    }
