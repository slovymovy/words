                "senses": [
                    {
                        "sense_id": "d7f14d18-df30-360d-be23-98fe096e6185",
                        "entry_id": "65294ed6-5fb1-30ef-af41-28a516ffe5b1",
                        "glosses": [
                            "een door een ander gemaakt bericht doorsturen op het sociale netwerk Twitter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25d7f9a4-359c-4026-90a9-14ae8ae81195",
                                "sense_id": "d7f14d18-df30-360d-be23-98fe096e6185",
                                "text": "Dat bericht is gisteren ruim 3000 keer gedeeld. Nu het stel zich heeft gemeld, bedankt de politie het publiek voor het retweeten en meedenken."
                            },
                            {
                                "example_id": "dc0b268a-17e6-43d1-afd8-5348c40b9cd4",
                                "sense_id": "d7f14d18-df30-360d-be23-98fe096e6185",
                                "text": "Gebruikers van sociale media gingen meteen aan de slag om de weggehaalde tweets te achterhalen en te retweeten. Het ging onder meer om een tweet waarin Scaramucci Trumps rivale Hillary Clinton prijst en een ander waarin hij zegt dat het tijd is het wapenbezit in de VS te verminderen."
                            },
                            {
                                "example_id": "14213241-1f66-4fbe-a6eb-09cc609d8a25",
                                "sense_id": "d7f14d18-df30-360d-be23-98fe096e6185",
                                "text": "Het begint allemaal bij de inlichtingendienst AIVD. Daar moeten voldoende aanwijzingen zijn om iemand aan te merken als verdachte. Denk bijvoorbeeld aan: IS retweeten, praten over op jihad gaan of instructies geven hoe je springstof kan maken voor een bom."
                            }
                        ]
                    }
