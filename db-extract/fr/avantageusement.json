        "fr-extract.jsonl": [
            {
                "entry_id": "7d2338ff-3414-3efc-a8c3-7b9645f27b6b",
                "word": "avantageusement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ada0a69c-d592-3cbd-9bab-ef1ad952e127",
                        "entry_id": "7d2338ff-3414-3efc-a8c3-7b9645f27b6b",
                        "glosses": [
                            "Qui apporte un avantage en étant utile, profitable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85744b02-47eb-4acf-b795-8218f2c1006f",
                                "sense_id": "ada0a69c-d592-3cbd-9bab-ef1ad952e127",
                                "text": "Cette maison est située très avantageusement pour les opérations secrètes du ministère."
                            },
                            {
                                "example_id": "642992c5-1b71-4cf2-8ce0-1e7bbf55922f",
                                "sense_id": "ada0a69c-d592-3cbd-9bab-ef1ad952e127",
                                "text": "À Tripoli comme à Alger l’embonpoint est considéré comme un type de beauté, aussi engraisse-t-on les jeunes filles pour les marier avantageusement."
                            },
                            {
                                "example_id": "b4eea72c-96b7-41f4-aa4d-8e426dfa7531",
                                "sense_id": "ada0a69c-d592-3cbd-9bab-ef1ad952e127",
                                "text": "Le diamant remplace avantageusement aujourd’hui le fer chaud"
                            },
                            {
                                "example_id": "4ae3feab-e73a-447c-98da-fd7d7027b456",
                                "sense_id": "ada0a69c-d592-3cbd-9bab-ef1ad952e127",
                                "text": "Quant à la ruine, elle sera pour moi moins considérable que je ne l’avais cru, parce que j’ai vendu très avantageusement ma ferme à Deauville."
                            },
                            {
                                "example_id": "27de3fda-23b7-47e7-a22d-ea7aef601ac1",
                                "sense_id": "ada0a69c-d592-3cbd-9bab-ef1ad952e127",
                                "text": "Est-ce que des professeurs particuliers ne remplaceraient pas avantageusement la routine universitaire ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "3aab1e83-8928-38b4-9ffd-d6c70fbf9871",
                        "entry_id": "7d2338ff-3414-3efc-a8c3-7b9645f27b6b",
                        "glosses": [
                            "De manière à honorer, à flatter, à mettre en valeur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e19cce3-aa35-496e-ba5b-fa01f384a72b",
                                "sense_id": "3aab1e83-8928-38b4-9ffd-d6c70fbf9871",
                                "text": "Par exemple, les auteurs du cinquiéme siécle ne parlent point avantageusement du courage et des mœurs des vandales."
                            },
                            {
                                "example_id": "362442a1-899f-4908-a6bf-1933449a7a63",
                                "sense_id": "3aab1e83-8928-38b4-9ffd-d6c70fbf9871",
                                "text": "Le goût des habillements qui dessinent avantageusement les formes, a repris faveur."
                            },
                            {
                                "example_id": "95643357-6672-4656-bad3-e001efcd7194",
                                "sense_id": "3aab1e83-8928-38b4-9ffd-d6c70fbf9871",
                                "text": "Toutefois, il était si avantageusement connu dans les provinces du Magne que, devant ce nom, tous s’inclinèrent."
                            },
                            {
                                "example_id": "cadb10c8-e2b5-47b9-a954-da8a5e83ce09",
                                "sense_id": "3aab1e83-8928-38b4-9ffd-d6c70fbf9871",
                                "text": "Alors je lui dis que je serais heureux de prendre sa photographie, ce qui le fit sourire avantageusement."
                            },
                            {
                                "example_id": "3c02b221-aacc-4219-9e59-ef08cd05a1f7",
                                "sense_id": "3aab1e83-8928-38b4-9ffd-d6c70fbf9871",
                                "text": "La taille élancée, l’œil profond et la moustache retroussée sur de belles dents blanches, il portait avantageusement encore son renom d’homme à femmes."
                            }
                        ]
                    }
                ],
