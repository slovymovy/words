                                "target_senses": [
                                    {
                                        "sense_id": "86e0dc29-111c-38b2-b136-adfbd0481a31",
                                        "entry_id": "b4199fda-d224-3837-85a8-5b8368d37ec9",
                                        "glosses": [
                                            "Additional time added to the end of a match, or period of a match, in order to compensate for time lost due to any stoppages of play."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed44077f-16fb-4415-a563-fc7c8b8774c7",
                                                "sense_id": "86e0dc29-111c-38b2-b136-adfbd0481a31",
                                                "text": "But Sunderland fans fearing the worst finally had something to cheer when in the fourth of five minutes of stoppage time Gyan stood at the right place at the right time."
                                            },
                                            {
                                                "example_id": "17cb554b-d8cf-4922-9a5e-1df003c0ef98",
                                                "sense_id": "86e0dc29-111c-38b2-b136-adfbd0481a31",
                                                "text": "Brazilian substitute Andressa Alves had equalised in stoppage time to force the shootout after Ella Toone had given England a first-half lead."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
