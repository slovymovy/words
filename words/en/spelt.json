                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>spelt</w> her surname clearly so the receptionist could write it down correctly.",
                            "target_lang_translations": {
                                "pl": "Wyraźnie <w>przeliterowała</w> swoje nazwisko, aby recepcjonista mógł je poprawnie zapisać."
                            }
                        },
                        {
                            "text": "His name was <w>spelt</w> wrong on the official certificate.",
                            "target_lang_translations": {
                                "pl": "Jego nazwisko zostało błędnie <w>zapisane</w> na oficjalnym świadectwie."
                            }
