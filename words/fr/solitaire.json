    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c65ce06d-3e1e-3de0-95c4-a95ec8b806f0",
                    "sense_definition": "Qui est seul ou qui a l'habitude de vivre dans la solitude.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "seul",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vieil homme mène une vie <w>solitaire</w> dans sa petite maison de campagne."
                        },
                        {
                            "text": "Cet enfant <w>solitaire</w> préfère souvent lire dans sa chambre plutôt que de jouer dehors."
                        }
                    ],
                    "synonyms": [
                        "seul",
                        "isolé"
                    ],
                    "antonyms": [
                        "sociable",
                        "entouré"
                    ],
                    "common_phrases": [
                        "vie solitaire",
                        "promeneur solitaire"
                    ]
                },
                {
                    "sense_id": "81c4b214-34ba-3f42-aa6d-222af7d419da",
                    "sense_definition": "Qui est désert, retiré, à l'écart du monde et de l'activité humaine.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "lieu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous avons marché le long d'un chemin <w>solitaire</w> à travers la forêt silencieuse."
                        },
                        {
                            "text": "La petite cabane en bois se trouvait dans un endroit <w>solitaire</w> de la montagne."
                        }
                    ],
                    "synonyms": [
                        "désert",
                        "isolé",
                        "retiré"
                    ],
                    "antonyms": [
                        "animé",
                        "fréquenté",
                        "peuplé"
                    ],
                    "common_phrases": [
                        "lieu solitaire",
                        "chemin solitaire"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cff0297d-d4ad-3e9a-b911-f8531d943ad4",
                    "sense_definition": "Personne qui vit retirée du monde ou qui apprécie particulièrement la solitude.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "seul",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce peintre réputé est un grand <w>solitaire</w> qui participe rarement aux réceptions artistiques."
                        },
                        {
                            "text": "Même s'il apprécie ses collègues de bureau, il reste un <w>solitaire</w> qui aime le calme."
                        }
                    ],
                    "synonyms": [
                        "ermite"
                    ],
                    "common_phrases": [
                        "grand solitaire"
                    ]
                },
                {
                    "sense_id": "8fa44893-ab52-3f55-9b0e-d33dc8f28619",
                    "sense_definition": "Jeu de cartes ou casse-tête qui se pratique sans partenaire.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "jeu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour passer le temps dans l'avion, elle fait une partie de <w>solitaire</w> sur sa tablette."
                        },
                        {
                            "text": "Mon grand-père passait ses soirées d'hiver à jouer au <w>solitaire</w> sur la table du salon."
                        }
                    ],
                    "synonyms": [
                        "patience"
                    ],
                    "common_phrases": [
                        "partie de solitaire",
                        "jouer au solitaire"
                    ]
                },
                {
                    "sense_id": "9f6c3bf2-ff5e-3692-9a3a-30b40054039f",
                    "sense_definition": "Bague ornée d'un diamant unique sans pierres d'accompagnement.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "bijou",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a demandé sa compagne en mariage en lui offrant un superbe <w>solitaire</w> en diamant."
                        },
                        {
                            "text": "Elle ne quitte jamais le <w>solitaire</w> étincelant qu'elle a reçu pour ses vingt ans."
                        }
                    ],
                    "common_phrases": [
                        "solitaire en diamant"
                    ]
                },
                {
                    "sense_id": "9b814919-dbb1-3647-ae74-47beb04e6344",
                    "sense_definition": "Vieux sanglier mâle qui s'est séparé de la compagnie.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "chasse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au coucher du soleil, les chasseurs ont aperçu un <w>solitaire</w> qui traversait prudemment la clairière."
                        },
                        {
                            "text": "Le garde forestier nous a prévenus qu'un gros <w>solitaire</w> rôdait autour du village."
                        }
                    ]
                },
                {
                    "sense_id": "8a0c15b6-0263-3ae2-9506-d8e1884ba4fa",
                    "sense_definition": "Religieux ou anachorète qui s'isole du monde pour se consacrer à la prière.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce pieux <w>solitaire</w> a choisi de vivre isolé du monde pour méditer et prier chaque jour."
                        },
                        {
                            "text": "Autrefois, de nombreux <w>solitaires</w> habitaient ces grottes reculées pour trouver la paix intérieure."
                        }
                    ],
                    "synonyms": [
                        "anachorète",
                        "ermite"
                    ],
                    "traits": [
                        {
