                "translations": [
                    {
                        "translation_id": "868679dd-0dac-4e2b-a373-b79cc4809f23",
                        "source_entry_id": "dbca0565-4f68-346d-9896-1fdad1eda34f",
                        "source_sense_id": "7c7d7f55-dfa5-3540-a7c6-5c665ce1e6e5",
                        "source_sense_description": "gebrek",
                        "target_lang_word": "deficit",
