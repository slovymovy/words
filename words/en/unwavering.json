{
    "word_family": [
        "waver",
        "waverer",
        "waveringly",
        "unwaveringly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "53e22e54-980f-3da4-8756-3d5f0147ce1d",
                    "sense_definition": "Remaining firm, steady, and constant; not changing or fading over time.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "steadiness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her parents offered <w>unwavering</w> support throughout her long medical studies.",
                            "target_lang_translations": {
                                "nl": "Haar ouders boden <w>onwankelbare</w> steun gedurende haar lange medische studie.",
                                "es": "Sus padres le brindaron un apoyo <w>inquebrantable</w> a lo largo de sus largos estudios de medicina."
                            }
                        },
                        {
                            "text": "The activist showed an <w>unwavering</w> commitment to human rights despite constant threats.",
                            "target_lang_translations": {
                                "nl": "De activist toonde een <w>onwankelbare</w> toewijding aan mensenrechten ondanks voortdurende bedreigingen.",
                                "es": "El activista mostró un compromiso <w>inquebrantable</w> con los derechos humanos a pesar de las constantes amenazas."
                            }
                        }
                    ],
                    "synonyms": [
                        "constant",
                        "staunch",
                        "steadfast",
                        "unshakable"
                    ],
                    "antonyms": [
                        "wavering"
                    ],
                    "common_phrases": [
                        "unwavering support",
                        "unwavering commitment",
                        "unwavering loyalty"
                    ],
                    "target_lang_definitions": {
                        "nl": "Standvastig, stabiel en constant blijvend; niet veranderend of afnemend in de loop van de tijd.",
                        "es": "Que se mantiene firme, constante y continuo; que no cambia ni se debilita con el paso del tiempo."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "onwankelbaar",
                                "target_lang_sense_clarification": "zeer standvastig en niet van zijn stuk te brengen"
                            },
                            {
                                "target_lang_word": "onvoorwaardelijk",
                                "target_lang_sense_clarification": "zonder twijfel of voorbehoud, met name bij steun"
                            },
                            {
                                "target_lang_word": "onvermoeibaar",
                                "target_lang_sense_clarification": "onafgebroken en vol toewijding"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "inquebrantable",
                                "target_lang_sense_clarification": "muy firme, que no se debilita ni decae con el tiempo"
                            },
                            {
                                "target_lang_word": "constante",
                                "target_lang_sense_clarification": "continuo y perseverante"
                            },
                            {
                                "target_lang_word": "firme",
                                "target_lang_sense_clarification": "estable y sólido en apoyo o compromiso"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9f2136e6-d81d-3fd0-b295-582e95163c82",
                    "sense_definition": "Completely decisive, confident, and free from doubt or hesitation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "resoluteness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He answered the difficult questions with an <w>unwavering</w> voice.",
                            "target_lang_translations": {
                                "nl": "Hij beantwoordde de moeilijke vragen met een <w>vaste</w> stem.",
                                "es": "Respondió a las preguntas difíciles con voz <w>firme</w>."
                            }
                        },
                        {
                            "text": "She maintained an <w>unwavering</w> belief in her client's innocence during the trial.",
                            "target_lang_translations": {
                                "nl": "Ze behield tijdens het proces een <w>onwrikbaar</w> geloof in de onschuld van haar cliënt.",
                                "es": "Mantuvo una fe <w>inquebrantable</w> en la inocencia de su cliente durante el juicio."
                            }
                        }
                    ],
                    "synonyms": [
                        "confident",
                        "certain",
                        "sure"
                    ],
                    "antonyms": [
                        "indecisive",
                        "irresolute",
                        "uncertain",
                        "undecided",
                        "vacillating"
                    ],
                    "common_phrases": [
                        "unwavering belief",
                        "unwavering faith",
                        "unwavering gaze"
                    ],
                    "target_lang_definitions": {
                        "nl": "Volledig beslist, zelfverzekerd en zonder enige twijfel of aarzeling.",
                        "es": "Completamente decidido, seguro y libre de dudas o vacilaciones."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "onwrikbaar",
                                "target_lang_sense_clarification": "vastberaden, niet aan het wankelen te brengen"
                            },
                            {
                                "target_lang_word": "vastberaden",
                                "target_lang_sense_clarification": "zonder aarzeling of twijfel"
                            },
                            {
                                "target_lang_word": "onverschrokken",
                                "target_lang_sense_clarification": "dapper en niet aarzelend"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "firme",
                                "target_lang_sense_clarification": "sin vacilación o temblor; seguro"
                            },
                            {
                                "target_lang_word": "inquebrantable",
                                "target_lang_sense_clarification": "imposible de hacer dudar; irreductible"
                            },
                            {
                                "target_lang_word": "resuelto",
                                "target_lang_sense_clarification": "decidido y sin dudas"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}