                        ]
                    },
                    {
                        "translation_id": "552a2cde-3ecf-4648-b3ab-43b71f1ba87b",
                        "source_entry_id": "452a2d59-5bd9-324d-ab55-0c954c11d10c",
                        "source_sense_id": "6109b10f-99ac-3400-9951-9ef32cedd360",
                        "target_lang_word": "homonyme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "homonyme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "90eb8263-4a29-377c-ac74-0aa6c04fbb23",
                                        "entry_id": "1b2dd0be-1384-363f-8b72-d3d1cc9bb9e4",
                                        "glosses": [
                                            "Mot identique par la prononciation (homophone) ou par la graphie (homographe), à un autre de sens différent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96d6a81e-3c35-4de6-9294-a8c99ff5024c",
                                                "sense_id": "90eb8263-4a29-377c-ac74-0aa6c04fbb23",
                                                "text": "Ce mot a pour homonyme tel autre mot."
                                            },
                                            {
                                                "example_id": "e2883921-86cb-4dfe-b05b-b442f00bf1ec",
                                                "sense_id": "90eb8263-4a29-377c-ac74-0aa6c04fbb23",
                                                "text": "Dictionnaire des homonymes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1cf25ea5-3431-3b97-96a0-23e6b844d190",
                                        "entry_id": "1b2dd0be-1384-363f-8b72-d3d1cc9bb9e4",
                                        "glosses": [
                                            "Mot homophone. Mot identique par la prononciation."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f95ab388-24ea-4c7b-8ea9-35e8519596d8",
                                                "sense_id": "1cf25ea5-3431-3b97-96a0-23e6b844d190",
                                                "text": "Homonymes simples : vers, vert, ver et verre."
                                            },
                                            {
                                                "example_id": "de1a4642-7441-4bc2-8d92-0b5f67b78143",
                                                "sense_id": "1cf25ea5-3431-3b97-96a0-23e6b844d190",
                                                "text": "Les homonymes sont des mots qui ont (du moins ordinairement) une seule prononciation et plusieurs orthographes. […] Les homographes, au contraire, sont des mots qui ont plusieurs prononciations et une seule orthographe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0004e260-fae8-3b3b-8200-1f211e99a285",
                                        "entry_id": "1b2dd0be-1384-363f-8b72-d3d1cc9bb9e4",
                                        "glosses": [
                                            "Mot homophonographe. Mot identique par la prononciation et par la graphie."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "174e1955-28b4-4f30-9dd4-66b9283824f0",
                                                "sense_id": "0004e260-fae8-3b3b-8200-1f211e99a285",
                                                "text": "Des homonymes sont des termes de graphie et de prononciation identiques (Exemple : la ferme du village, il ferme la porte). Il est quelquefois difficile de déterminer si deux termes sont homonymiques ou s’il s’agit de deux acceptions différentes d’un même terme polysémique, l’étymologie ne permettant pas toujours de se prononcer avec certitude (Exemple : profession de foi et profession médicale, ou tour de taille, tour de main et tour [à mon]). En outre, chez de nombreux auteurs, la distinction entre homonymes et homophones n’est pas claire ; ainsi, Guiraud tend à qualifier d’homonymiques des termes qui sont en réalité homophoniques. Quant aux termes dont la graphie est identique, mais pas la prononciation (comme le fils du maire et les fils du tissu, ou les poules du couvent couvent), ce sont des homographes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "homonyme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2e463c84-f7dd-3921-bb5e-969ad6b24811",
                                        "entry_id": "7b402e36-2b79-371b-87d5-4e6d7ce6d1d9",
                                        "glosses": [
                                            "Personne portant le même nom qu’une autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8912017f-e3a8-4518-ad7c-657cd644fb7a",
                                                "sense_id": "2e463c84-f7dd-3921-bb5e-969ad6b24811",
                                                "text": "Je ne parle pas de Nicolas mais de son homonyme."
                                            },
                                            {
                                                "example_id": "ede3fd4e-6e11-40f8-9ddc-1e2de468d92e",
                                                "sense_id": "2e463c84-f7dd-3921-bb5e-969ad6b24811",
                                                "text": "Elle fut ensuite rendue à son père, mais n’eut garde apparemment d’imiter sa belle homonyme de Nérac, qui, séduite par le prince béarnais, puis abandonnée, se noya de désespoir dans la Baïse."
                                            },
                                            {
                                                "example_id": "ee2d93b3-7be8-4c2c-93f8-1bb6b022461b",
                                                "sense_id": "2e463c84-f7dd-3921-bb5e-969ad6b24811",
                                                "text": "D’abord ce nom, Alexandre Perrin, et un peu plus loin ce geste étrange et criminel, un coup de planche. […]. Non, vraiment, je n’y crois pas une seconde, je n’ai aucun doute sur le fait qu’il s’agisse d’un homonyme. Alexandre Perrin, c’est tout de même très commun."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "homonyme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f7df42e7-72f6-32af-8935-e8e9b88a266f",
                                        "entry_id": "6d856b3f-9e87-33fe-94b7-7eeda11422a6",
                                        "glosses": [
                                            "Qui se prononce ou s’écrit de façon identique, mais diffère par le sens."
                                        ],
                                        "tags": [],
                                        "note": "Dans le premier cas, on parle d’homophone, dans le second, d’homographe",
                                        "examples": [
                                            {
                                                "example_id": "ca2a4705-3714-4fad-9d6e-83a0bdf4fa66",
                                                "sense_id": "f7df42e7-72f6-32af-8935-e8e9b88a266f",
                                                "text": "Le genre Dufourea Ach, a eu le défaut d’être homonyme d’un Dufourea Bory désignant des phanérogames, et, lichénologiquement, celui d’être mal défini ; en effet, sa synonymie nous donne les espèces suivantes : […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0ffbeb31-36e5-4973-a14f-1536a3a4d212",
                        "source_entry_id": "452a2d59-5bd9-324d-ab55-0c954c11d10c",
                        "source_sense_id": "6109b10f-99ac-3400-9951-9ef32cedd360",
                        "target_lang_word": "homonymique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "homonymique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c6c39c17-a315-3db2-ad00-ac9e1915fc13",
                                        "entry_id": "1da8cd1b-f31f-3e7f-9de9-d9805dd1007f",
                                        "glosses": [
                                            "Qui a un caractère d’homonymie, relatif à celle-ci."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "263c61ff-d86d-4a00-a069-3dd70b26af3e",
                                                "sense_id": "c6c39c17-a315-3db2-ad00-ac9e1915fc13",
                                                "text": "La pauvreté de cette langue crée une tendance homonymique et des difficultés d’orthographe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "025e6025-345b-38ca-b9cb-421d53ed8e14",
                                        "entry_id": "1da8cd1b-f31f-3e7f-9de9-d9805dd1007f",
                                        "glosses": [
                                            "Homonyme."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30e0098a-13e3-486b-bbf0-2f48a8c9cff6",
                                                "sense_id": "025e6025-345b-38ca-b9cb-421d53ed8e14",
                                                "text": "Le colonel Pedro Santana, père homonymique du futur président de la République."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
