{
    "word_family": [
        "старый",
        "старость",
        "стареть",
        "старик",
        "старуха",
        "старина"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "416a6fac-8389-3b57-9588-9ff3560fa156",
                    "sense_definition": "Имеющий большее количество лет по сравнению с кем-либо, более старый или самый старый по возрасту среди кого-либо.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "age",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мой <w>старший</w> брат учится в университете.",
                            "target_lang_translations": {
                                "pl": "Mój <w>starszy</w> brat studiuje na uniwersytecie."
                            }
                        },
                        {
                            "text": "Она самая <w>старшая</w> в нашей семье.",
                            "target_lang_translations": {
                                "pl": "Ona jest <w>najstarsza</w> w naszej rodzinie."
                            }
                        }
                    ],
                    "antonyms": [
                        "младший"
                    ],
                    "common_phrases": [
                        "старший брат",
                        "старшая сестра"
                    ],
                    "target_lang_definitions": {
                        "pl": "Mający więcej lat w porównaniu z kimś innym, starszy lub najstarszy wiekiem."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "starszy",
                                "target_lang_sense_clarification": "o wieku"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1527e23e-f735-390f-905d-acc71ffbf0f9",
                    "sense_definition": "Стоящий по званию, должности или служебному положению выше других.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "rank",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Сегодня <w>старший</w> менеджер проводит важное собрание.",
                            "target_lang_translations": {
                                "pl": "Dzisiaj <w>starszy</w> menedżer prowadzi ważne zebranie."
                            }
                        },
                        {
                            "text": "Нужно доложить обо всём <w>старшему</w> офицеру.",
                            "target_lang_translations": {
                                "pl": "Trzeba zameldować o wszystkim <w>starszemu</w> oficerowi."
                            }
                        }
                    ],
                    "antonyms": [
                        "младший"
                    ],
                    "common_phrases": [
                        "старший менеджер",
                        "старший офицер"
                    ],
                    "target_lang_definitions": {
                        "pl": "Wyższy rangą, stopniem lub stanowiskiem służbowym."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "starszy",
                                "target_lang_sense_clarification": "o randze lub stanowisku"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5edaec71-9451-3c84-9801-c5f032e8852f",
                    "sense_definition": "Близкий к завершению обучения, относящийся к последним годам учёбы.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "education",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ученики <w>старших</w> классов готовятся к экзаменам.",
                            "target_lang_translations": {
                                "pl": "Uczniowie <w>starszych</w> klas przygotowują się do egzaminów."
                            }
                        },
                        {
                            "text": "Студенты <w>старшего</w> курса уже проходят практику.",
                            "target_lang_translations": {
                                "pl": "Studenci <w>wyższego</w> roku odbywają już praktyki."
                            }
                        }
                    ],
                    "synonyms": [
                        "выпускной"
                    ],
                    "common_phrases": [
                        "старшие классы",
                        "старший курс"
                    ],
                    "target_lang_definitions": {
                        "pl": "Dotyczący wyższych, ostatnich lat lub klas nauki."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "starszy",
                                "target_lang_sense_clarification": "o klasie, roczniku"
                            },
                            {
                                "target_lang_word": "wyższy",
                                "target_lang_sense_clarification": "o kursie, stopniu nauki"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "30cf11b4-a439-31a2-9e20-eca9bab68767",
                    "sense_definition": "Тот, кто возглавляет группу или коллектив; главный.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "rank",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Назначьте <w>старшего</w> в этой группе для отчёта.",
                            "target_lang_translations": {
                                "pl": "Wyznaczcie <w>starszego</w> w tej grupie do złożenia raportu."
                            }
                        },
                        {
                            "text": "Все вопросы решал <w>старший</w> по дому.",
                            "target_lang_translations": {
                                "pl": "Wszystkie sprawy załatwiał <w>gospodarz</w> domu."
                            }
                        }
                    ],
                    "synonyms": [
                        "главный"
                    ],
                    "common_phrases": [
                        "старший по дому"
                    ],
                    "target_lang_definitions": {
                        "pl": "Stojący na czele grupy, odpowiedzialny za nią; główny."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "starszy",
                                "target_lang_sense_clarification": "jako funkcja, np. starszy grupy"
                            },
                            {
                                "target_lang_word": "główny",
                                "target_lang_sense_clarification": "stojący na czele"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "03c08dd3-14f7-3ec4-816c-4b3e92271e6f",
                    "sense_definition": "Человек, который является главным или ответственным за группу людей.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "rank",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Наш <w>старший</w> сегодня не пришёл на работу.",
                            "target_lang_translations": {
                                "pl": "Nasz <w>przełożony</w> nie przyszedł dzisiaj do pracy."
                            }
                        },
                        {
                            "text": "Подойдите к <w>старшему</w> и спросите у него разрешения.",
                            "target_lang_translations": {
                                "pl": "Podejdźcie do <w>kierownika</w> i zapytajcie go o zgodę."
                            }
                        }
                    ],
                    "synonyms": [
                        "начальник",
                        "главный"
                    ],
                    "common_phrases": [
                        "старший смены",
                        "старший группы"
                    ],
                    "target_lang_definitions": {
                        "pl": "Osoba pełniąca funkcję kierowniczą lub odpowiedzialna za grupę."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "przełożony",
                                "target_lang_sense_clarification": "osoba zarządzająca"
                            },
                            {
                                "target_lang_word": "kierownik",
                                "target_lang_sense_clarification": "stojący na czele zespołu"
                            },
                            {
                                "target_lang_word": "starszy",
                                "target_lang_sense_clarification": "np. starszy cechu, starszy zmiany"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}