                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45e0de43-ce5a-40a7-be27-74b1fc0dd20b",
                                "sense_id": "fa8a7100-e518-3f3c-8d55-1b7103c78585",
                                "text": "Prezydent, znany z głębokiej wiary, zawdzięcza swą reelekcję w znacznej mierze głosom religijnych konserwatystów"
                            }
                        ],
