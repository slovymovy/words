                                "example_id": "7d0369d6-98eb-4769-a7a5-6012e572b629",
                                "sense_id": "ce6d086c-83d2-394d-9fc3-0b1994da1308",
                                "text": "I'd like to learn how to play saxophone.",
                                "translation": "Ich möchte lernen, wie man Saxophon spielt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e33be9c7-59f4-4388-afac-470bddb80922",
                        "source_entry_id": "2b21802d-7c36-3951-b077-3552c8e51ef9",
                        "source_sense_id": "ce6d086c-83d2-394d-9fc3-0b1994da1308",
                        "source_sense_description": "Saxophon",
                        "target_lang_word": "Saxophon",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Saxophon",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fdef53da-8b86-35c8-b10c-308e506286d5",
                                        "entry_id": "928c3046-8869-3e52-a77c-191f002c5bd4",
                                        "glosses": [
                                            "ein Holzblasinstrument"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f985e236-1aae-47dc-b952-8f45b7a62237",
                                                "sense_id": "fdef53da-8b86-35c8-b10c-308e506286d5",
                                                "text": "Beim Jazz findet das Saxophon sehr häufig Verwendung."
                                            },
                                            {
                                                "example_id": "1064c09d-95c4-40f1-a8fe-bb70dbc5da19",
                                                "sense_id": "fdef53da-8b86-35c8-b10c-308e506286d5",
                                                "text": "„Der Ton entsteht beim Saxophon durch ein einzelnes schwingendes Rohrblatt. Deswegen zählt das Saxophon zu den Holzblasinstrumenten und nicht, wie sich durch das Material des Korpus vermuten ließe, zu den Blechblasinstrumenten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ee900446-671f-427d-ac0e-1910d4306684",
                        "source_entry_id": "2b21802d-7c36-3951-b077-3552c8e51ef9",
                        "source_sense_id": "ce6d086c-83d2-394d-9fc3-0b1994da1308",
                        "source_sense_description": "Saxophon",
                        "target_lang_word": "saxophone",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "saxophone",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "17342fdf-51c3-3902-a8ac-b9331ac588ca",
                                        "entry_id": "29a22902-8759-3bea-879e-91a4d43dc942",
                                        "glosses": [
                                            "Instrument de musique à clefs de la famille des bois, à anche simple généralement en métal ou ébonite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77bc8627-5ca2-496f-b442-d244115349ba",
                                                "sense_id": "17342fdf-51c3-3902-a8ac-b9331ac588ca",
                                                "text": "Parmi toutes les maisons verrouillées comme des tombeaux où chaque lampe à son tour s'est éteinte derrière chaque persienne, tout le long de la grand-rue (il est dix heures du soir), dans une seule mansarde brûle une seule bougie et à cette lueur quelqu'un joue du saxophone."
                                            },
                                            {
                                                "example_id": "329d0cbe-974d-452d-8c76-85f93fec5040",
                                                "sense_id": "17342fdf-51c3-3902-a8ac-b9331ac588ca",
                                                "text": "Reste le saxophone. C’est un instrument dont l’apprentissage est simple. Il permet de passer avec une facilité étonnante du grave à l’aigu. L’aisance des doigtés autorise des phrasés fluides, extrêmement rapides. Et surtout, c’est un instrument à anche, contrairement à la trompette, dont l’embouchure nécessite un contrôle physique des lèvres, de la colonne d’air, du diaphragme et des abdominaux beaucoup plus contraignant."
                                            },
                                            {
                                                "example_id": "6c5d6f3c-f127-4776-a6ed-8a4bcffc108f",
                                                "sense_id": "17342fdf-51c3-3902-a8ac-b9331ac588ca",
                                                "text": "Le saxophone, entre-temps, semble ne pas avoir remarqué ces changements et continue son « barrissement »."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "saxophone",
                                "target_lang_code": "fr",
