                "senses": [
                    {
                        "sense_id": "3a84e482-0e06-3154-b91e-1cc7f444ea46",
                        "entry_id": "5f608703-776f-33d4-bfe2-ba2766230cdc",
                        "glosses": [
                            "One who rustles; a cattle (or other livestock) thief."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e5f693a-d014-4ad5-98e4-cda56253963a",
                                "sense_id": "3a84e482-0e06-3154-b91e-1cc7f444ea46",
                                "text": "Two years have now passed since Hayward’s farm in north Wales was raided, leading to the loss of tens of thousands of bees. But the rustlers have continued to be active. Most recently they have targeted the property of one of her Anglesey neighbours, where around 40,000 bees were taken last month."
                            }
                        ]
                    },
                    {
                        "sense_id": "7a9a9c6c-d531-3913-8d61-bc4bcc42545c",
                        "entry_id": "5f608703-776f-33d4-bfe2-ba2766230cdc",
                        "glosses": [
                            "A bovine animal that can care for itself in any circumstances."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b5a3e6db-165c-3954-b07a-16ed69a91e16",
                        "entry_id": "5f608703-776f-33d4-bfe2-ba2766230cdc",
                        "glosses": [
                            "An alert, energetic, driving person."
                        ],
                        "tags": [
                            "US",
                            "Western",
                            "dated",
                            "especially",
                            "slang"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "102e5ace-8a27-3719-868c-9d573ec9adb0",
                        "entry_id": "5f608703-776f-33d4-bfe2-ba2766230cdc",
                        "glosses": [
                            "That which makes a rustling noise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "564a7323-c7d4-4bc2-8260-b7be971e1b8a",
                                "sense_id": "102e5ace-8a27-3719-868c-9d573ec9adb0",
                                "text": "Like this weekend, with moderate temperatures, the sky a bowl of blue, and the wind not a cold curse or a hot furnace, but a bit of a leaf-rustler, a cooling refreshment."
                            }
                        ]
                    }
                ],
