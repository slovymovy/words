                        "sense_id": "a0a0482e-dd52-3749-8d24-c07c03479147",
                        "entry_id": "133ba387-4694-3169-aebc-a91b1f624189",
                        "glosses": [
                            "Prêtresse de l’oracle d’Apollon à Delphes."
                        ],
                        "tags": [
                            "Ancient-Greek"
                        ],
                        "examples": [
                            {
                                "example_id": "7777ae03-e334-4b74-b8e5-62ccf9ada457",
                                "sense_id": "a0a0482e-dd52-3749-8d24-c07c03479147",
                                "text": "La Pythie, consultée sur ce qu'Apollon pensait de Socrate, répondit: « Il n'y a aucun homme plus libre, plus juste, plus sensé. »"
                            },
                            {
                                "example_id": "12803681-0559-41af-9cc8-a8c755230d4e",
                                "sense_id": "a0a0482e-dd52-3749-8d24-c07c03479147",
                                "text": "Lacan se contente d’un : à bon entendeur salut ! – après avoir proféré une parole aussi ambiguë que celles de la Pythie."
                            }
                        ]
                    }
                ],
