                        "glosses": [
                            "iemand uit Hindoestan, oorspronkelijk een gebied in het noorden van het huidige India tussen de Indus en de Ganges, later ook gebruikt als benaming voor heel Voor-Indië"
                        ],
                        "tags": [],
                        "examples": [
