                "senses": [
                    {
                        "sense_id": "e081c3af-15eb-377d-b405-902f43789238",
                        "entry_id": "e4f76bf9-5250-31c7-b89d-1bf2370a4179",
                        "glosses": [
                            "Ausstattungsgegenstand und Erscheinungsweise einer Narrenfigur"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec45e7d3-47fd-4ab1-97af-978ee1a50354",
                                "sense_id": "e081c3af-15eb-377d-b405-902f43789238",
                                "text": "„Natürlich dürfen klassische Narrenattribute nicht fehlen: Narrenkappen, Zepter, Uniformen und viele närrische Kuriositäten vervollständigen die bunte Ausstellung.“"
                            },
                            {
                                "example_id": "4eab618c-0d6a-449a-9d37-a89f2bef651a",
                                "sense_id": "e081c3af-15eb-377d-b405-902f43789238",
                                "text": "„Als Narrenattribut trägt sie eine Narrenwurst.“"
                            },
                            {
                                "example_id": "6dfd307e-23e3-468c-8c2f-38956c1213e2",
                                "sense_id": "e081c3af-15eb-377d-b405-902f43789238",
                                "text": "„Mit auf dem Wagen ist übrigens (Bild) noch ein Narrenattribut, ein Ausstattungsgegenstand, der üblicherweise nicht so im Fokus der Öffentlichkeit steht, der Schellenstab mit Narrenkopf.“"
                            },
                            {
                                "example_id": "745e0d22-ea80-455b-9184-107e8ef11d3d",
                                "sense_id": "e081c3af-15eb-377d-b405-902f43789238",
                                "text": "„Mit diesem Narrenattribut macht sich der Pflumeschlucker bemerkbar, vor allem als Gruppe wirkt der Klang unverwechselbar.“"
                            },
                            {
                                "example_id": "e654d93e-d612-4aa4-acd4-32d363b48165",
                                "sense_id": "e081c3af-15eb-377d-b405-902f43789238",
                                "text": "„Der Rudo erklärt, was typische Narrenattribute der Schwäbisch-Alemannischen Fasnet sind und woher sie stammen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
