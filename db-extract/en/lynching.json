                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lynchjustiz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6b06095b-8f66-308e-a164-ab8c8dce7ddb",
                                        "entry_id": "53799616-c1d4-3d1b-b427-e07135a25cfe",
                                        "glosses": [
                                            "ungesetzliche schwere Bestrafung (durch Misshandeln oder Töten) ohne Rechtfertigung durch ein Gerichtsurteil"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d37fd69a-518b-4de5-9d1c-66386a6e5a56",
                                                "sense_id": "6b06095b-8f66-308e-a164-ab8c8dce7ddb",
                                                "text": "„Wenn so etwas wie die Drohung einer Lynchjustiz in der Luft gelegen hatte, jetzt war sie völlig verflogen.“"
                                            },
                                            {
                                                "example_id": "e08dd928-99b6-48ab-b4a8-ce9253f2fc51",
                                                "sense_id": "6b06095b-8f66-308e-a164-ab8c8dce7ddb",
                                                "text": "„Es kam zu Lynchjustiz, häufig in Form von necklacing.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
