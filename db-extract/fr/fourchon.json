                "senses": [
                    {
                        "sense_id": "45c11898-0490-37ed-a3d8-6eb69ed0def7",
                        "entry_id": "4019c320-3313-3584-a82f-962968e89c71",
                        "glosses": [
                            "Une des pointes de la fourche ou de la fourchette."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbccf7e9-1d2c-458e-a689-279a131211e5",
                                "sense_id": "45c11898-0490-37ed-a3d8-6eb69ed0def7",
                                "text": "Fourche à trois fourchons."
                            },
                            {
                                "example_id": "271cccd5-3324-44a3-b544-809dd7a1482a",
                                "sense_id": "45c11898-0490-37ed-a3d8-6eb69ed0def7",
                                "text": "Fourchette à quatre fourchons."
                            },
                            {
                                "example_id": "c8823b80-fba8-4979-8351-4afc0afb1200",
                                "sense_id": "45c11898-0490-37ed-a3d8-6eb69ed0def7",
                                "text": "Les Athéniens ont aussi eu une pièce de monnaye marquée de l'image de Pallas, qui pour ce par Euripide est appelée (Parthenon) c'est à dire vierge, les Trezeniens en l'honneur de Neptune, qu'ils adoraient comme Dieu protecteur de leur ville, ont marqué la monnaye du trident qui est une fourche à trois fourchons enseigne du Dieu Neptune,"
                            },
                            {
                                "example_id": "006d1d7a-87c7-4a89-90ee-519cb4b23145",
                                "sense_id": "45c11898-0490-37ed-a3d8-6eb69ed0def7",
                                "text": "Puis çonsidère la pointe crochue du hamesson, & l'épine au dos d'iceluy & prenant en main les fourchons du trident, essaye les."
                            }
                        ]
                    },
                    {
                        "sense_id": "55923e5d-c036-37b0-84ad-d6610e8fbc4e",
                        "entry_id": "4019c320-3313-3584-a82f-962968e89c71",
                        "glosses": [
                            "Petite fourche à deux pointes utilisée pour les fagots."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b201d48-8be5-4b98-bc9f-3b91e0eb70ba",
                                "sense_id": "55923e5d-c036-37b0-84ad-d6610e8fbc4e",
                                "text": "Plusieurs ustensiles servent au potier pendant la cuisson : le fourchon pour manipuler les fagots de bois, la pique de fer …. — (Jean Boudon, Henri Rougier, Histoire du Dauphiné, Éd. Horvath, 1992)"
                            }
                        ]
                    },
                    {
                        "sense_id": "487be601-111a-37f6-8c72-f4b62a3fe0b4",
                        "entry_id": "4019c320-3313-3584-a82f-962968e89c71",
                        "glosses": [
                            "Endroit d’où sortent les branches d’un arbre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c2e0969-a674-48ca-be4f-92984a5f041b",
                                "sense_id": "487be601-111a-37f6-8c72-f4b62a3fe0b4",
                                "text": "La construction de ce Bâtiment, est des arbres coupez par le tronc, en, fourches, qu'ils plantent en terre; ils y en enfoncent trois ou quatre de quinze à seize pieds de haut, sur les fourchons desquels ils mettent une pièce de bois, qui est le faîte, ils en placent à six pieds de là & de chaque côté huit de même qui n'ont que six à sept pieds de hauteur, sur les fourchons desquels ils posent des pièces de bois, de même qu'ils ont posé sur les premières qu'ils nomment Filieres, en mettent encore sur chaque petite fourche, une qu'ils nomment des Travers."
                            }
                        ]
                    }
