                "senses": [
                    {
                        "sense_id": "a843c852-d261-37d9-bc82-ad3b6ff05189",
                        "entry_id": "c46f5f6f-18f6-3e0b-a7e1-d89d23256d0c",
                        "glosses": [
                            "Former un horizon ; entourer au loin en bornant la vue comme fait un horizon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c85a47ce-55e4-4360-92d7-ff368ff0176b",
                                "sense_id": "a843c852-d261-37d9-bc82-ad3b6ff05189",
                                "text": "Je sentis bien vite le charme et le pittoresque de cette hôtellerie franque perdue, à cent lieues d’Alger, au milieu d’une immense plaine qu’horizonnait un fond de petites collines pressées et bleues comme des vagues."
                            },
                            {
                                "example_id": "6957593e-b4bc-42b5-a5ba-26459ec736a6",
                                "sense_id": "a843c852-d261-37d9-bc82-ad3b6ff05189",
                                "text": "Sur des gazons toujours très verts,\nHorizonnés d'un ciel de jade."
                            }
                        ]
                    }
                ],
