                            "verkürzte Schreibweise von"
                        ],
                        "examples": [
                            {
                                "example_id": "404d4a70-b47a-4ca1-b458-f6170cb2d647",
                                "sense_id": "a62eb17f-e3a9-3b2f-86be-9ef248fe5bbd",
                                "text": "„Wir aber stehn unten ganz zurückgedrängt und wesenlos und sehen diesem Menschen zu.“"
                            },
                            {
                                "example_id": "2898cefe-dd63-4896-a689-d51a5a17b949",
                                "sense_id": "a62eb17f-e3a9-3b2f-86be-9ef248fe5bbd",
                                "text": "„Jede Frau kann heute selbst ihren Mann stehn.“"
                            },
                            {
                                "example_id": "fce18752-6903-4377-b04a-58c095604dd7",
                                "sense_id": "a62eb17f-e3a9-3b2f-86be-9ef248fe5bbd",
                                "text": "„Vor dem Möbelwagen stehen sechs Belgierpferde, sie stehn in zwei Reihen und haben gespaltene Kruppen.“"
                            },
                            {
                                "example_id": "4c646830-5465-43a0-a9ac-3440c1dd9b82",
                                "sense_id": "a62eb17f-e3a9-3b2f-86be-9ef248fe5bbd",
                                "text": "„Im Acker die Hälmchen stehn Reih an Reih.“"
                            },
                            {
                                "example_id": "0226baa6-46a1-4739-be49-a632859a4d9e",
                                "sense_id": "a62eb17f-e3a9-3b2f-86be-9ef248fe5bbd",
                                "text": "„Da stehn schon rechts und links Antonella und Antonio und stemmen sich gegen die Torflügel, und nun ist die Scheune ganz offen, vorn und hinten, die Manege liegt im vollen Licht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
