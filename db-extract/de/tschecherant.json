                        "examples": [
                            {
                                "example_id": "a3eeddac-93a4-4426-b17b-f7d339433190",
                                "sense_id": "ea7d2429-1de3-38b5-9ac1-a8a52bf458d0",
                                "text": "„Ein wamperter Tschecherant steht blunznfett mit einer Eitrigen auf einem Fensterbankl im Mezzanin.“"
                            },
                            {
                                "example_id": "b9c5f726-6147-4157-8d2a-88855538bede",
                                "sense_id": "ea7d2429-1de3-38b5-9ac1-a8a52bf458d0",
                                "text": "„Ihr glaubts, ich bin ein Tschecherant.“"
                            },
                            {
                                "example_id": "8da1ae3f-2a6c-4cc6-ac3e-d95544bee54b",
                                "sense_id": "ea7d2429-1de3-38b5-9ac1-a8a52bf458d0",
                                "text": "„Ist also ein Bläser entweder ein Tschecherant oder ein Musikant oder beides.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
