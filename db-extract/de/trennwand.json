                "senses": [
                    {
                        "sense_id": "161074ad-e76d-3cd3-af4e-78d6853d84b3",
                        "entry_id": "c1395af1-3a26-37d7-8a9b-2290fc51184d",
                        "glosses": [
                            "Wand, die dazu dient, Räume voneinander zu trennen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87f9fba7-10a7-494e-992e-23d32e693979",
                                "sense_id": "161074ad-e76d-3cd3-af4e-78d6853d84b3",
                                "text": "Das Zimmer ist groß genug, um daraus mit einer Trennwand zwei Räume zu machen."
                            },
                            {
                                "example_id": "efcd894c-3c0b-4408-81d4-0a1c570dfb73",
                                "sense_id": "161074ad-e76d-3cd3-af4e-78d6853d84b3",
                                "text": "„Ihre Beschlüsse vermittelte sie durch eine Trennwand oder durch ihren Vollschleier, der jedoch wesentlich bunter und prachvoller aussah als das, was wir heute als Burka kennen.“"
                            },
                            {
                                "example_id": "a3815fc9-5552-48a4-93f9-690b7f3a7f47",
                                "sense_id": "161074ad-e76d-3cd3-af4e-78d6853d84b3",
                                "text": "„Die gläserne Trennwand verhinderte, daß Robert etwas von dem Gesprochenen vernahm.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
