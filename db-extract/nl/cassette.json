                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "651b099b-363b-46a2-b623-2f69d998a0d3",
                                "sense_id": "9e3cbdb8-d18f-3983-80fe-c4239b14a54a",
                                "text": "Met hun afmeting van 54 x 54 centimeter zien de cassettes eruit als tapijttegels."
