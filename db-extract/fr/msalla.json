                "senses": [
                    {
                        "sense_id": "5bf3e794-00da-303c-bc7e-87f33374190c",
                        "entry_id": "ccd54a5b-8e14-38b5-9957-2c292f3fdf9f",
                        "glosses": [
                            "Espace consacré à la prière (e. g. salle ou oratoire en plein air) à l’usage des musulmans."
                        ],
                        "tags": [
                            "Maroc",
                            "Algérie"
                        ],
                        "examples": [
                            {
                                "example_id": "7ccbdc18-250f-4c19-9419-6eca128338b6",
                                "sense_id": "5bf3e794-00da-303c-bc7e-87f33374190c",
                                "text": "Un oratoire (msalla), simple mur en maçonnerie blanchi à la chaux, avait été construit à la hâte sur une colline voisine, toute blanche de pâquerettes. Et c’est là, hier matin, premier choûal, que le Sultan s’est rendu en grande pompe pour remplir ses fonctions d’imâm, de souverain pontife, et y faire la prière à la tête de sa cour et de son armée."
                            },
                            {
                                "example_id": "1f1ebf2a-fa7e-4fa5-bcda-d4f27d357160",
                                "sense_id": "5bf3e794-00da-303c-bc7e-87f33374190c",
                                "text": "A gauche en entrant, un dôme ovoïde, précédé d’une msalla tapissée d’une natte de palmier nain, indique le point où se place l’imam qui dirige la prière."
                            },
                            {
                                "example_id": "aa32956a-7ac8-4be6-9905-8dfea2dfef5d",
                                "sense_id": "5bf3e794-00da-303c-bc7e-87f33374190c",
                                "text": "Dans le Mogreb, notamment au Maroc, on rencontre d’autres édifices religieux, qui sont les zaoufas, sièges de confréries religieuses, et les msallas, immenses oratoires suburbains."
                            }
                        ]
                    }
