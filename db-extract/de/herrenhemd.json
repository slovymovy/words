                        "examples": [
                            {
                                "example_id": "c4a52392-52e4-4145-bec3-f02223183833",
                                "sense_id": "2305d1d8-cffb-38f1-ae29-797750fe65be",
                                "text": "„Ich besitze übrigens noch ein paar Herrenhemden von Jobst, die ich nach und nach zu Herrn Totta hinübertrage und die er gerne annimmt.“"
                            },
                            {
                                "example_id": "c7226a5f-5426-449b-841b-efa7280a54f8",
                                "sense_id": "2305d1d8-cffb-38f1-ae29-797750fe65be",
                                "text": "„Chantal hatte gleich nach der Ankunft einen großen Schrank geöffnet, der gefüllt war mit Herrenhemden, Herrenwäsche, Krawatten und Anzügen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
