                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b53f8e77-6788-3d39-8777-89c000fb9b72",
                        "entry_id": "fa3c6bad-3c9f-3796-9163-8a80fdcc270b",
                        "glosses": [
                            "самец-олень (или другое животное) с рогами"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d596e9bf-2c8e-448a-bd9f-25580abb793f",
                                "sense_id": "b53f8e77-6788-3d39-8777-89c000fb9b72",
                                "text": "Были там три взрослых оленя, две ланки, один рогач."
                            }
                        ]
                    },
                    {
                        "sense_id": "524c80f8-b059-30ce-a41a-148641642afc",
                        "entry_id": "fa3c6bad-3c9f-3796-9163-8a80fdcc270b",
                        "glosses": [
                            "рег. (ru) большой ухват"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37d05cf2-7fdc-4f55-a524-84bc3dd627f2",
                                "sense_id": "524c80f8-b059-30ce-a41a-148641642afc",
                                "text": "Он стал бить Андрея рогачом, чем горшки в печь сажают."
                            }
                        ]
                    },
                    {
                        "sense_id": "f6a5ca0f-7b86-3dd0-b673-0bc9d70596a3",
                        "entry_id": "fa3c6bad-3c9f-3796-9163-8a80fdcc270b",
                        "glosses": [
                            "рег. (ru) шутл. обманутый муж, рогоносец"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5ad6f5d-4d7a-4091-9c54-dff2abbdd5b3",
                                "sense_id": "f6a5ca0f-7b86-3dd0-b673-0bc9d70596a3",
                                "text": "По старом рогаче вдовицы плач амурный."
                            }
                        ]
