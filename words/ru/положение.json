                    "synonyms": [
                        "распорядок",
                        "закон",
                        "распоряжение"
                    ],
                    "common_phrases": [
                        "положение о конкурсе",
                        "разработать положение",
                        "утвердить положение"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "official"
                        }
                    ],
                    "target_lang_definitions": {
