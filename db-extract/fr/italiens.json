            {
                "entry_id": "d30ae0f3-6b06-30ef-a793-508da526c6dd",
                "word": "Italiens",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0ec09678-44f8-39c2-85b3-427c140ff7f1",
                        "entry_id": "d30ae0f3-6b06-30ef-a793-508da526c6dd",
                        "glosses": [
                            "Ellipse de Théâtre des Italiens, surnom d’un théâtre ayant fonctionné à Paris au XIXᵉ siècle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c2b63a2-46d3-4af5-8509-6ffb2a65e510",
                                "sense_id": "0ec09678-44f8-39c2-85b3-427c140ff7f1",
                                "text": "Huit heures ayant sonné, j’allais prendre ma place au balcon des Italiens, doutant presque d’y être, et n’osant affirmer que je fusse à Paris, au milieu d’une éblouissante société, dont je ne distinguais encore ni les toilettes ni les figures."
                            },
                            {
                                "example_id": "17110f0a-7f77-4d57-8092-a8d297e90cd7",
                                "sense_id": "0ec09678-44f8-39c2-85b3-427c140ff7f1",
                                "text": "Laissons donc à ceux-là qui sont assez riches pour se permettre ce luxe, l’Opéra, les Italiens, les promenades à cheval aux Champs-Élysées."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
