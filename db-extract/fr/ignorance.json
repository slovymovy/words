        "fr-extract.jsonl": [
            {
                "entry_id": "adcf1657-9266-3276-91ce-becd6b8691da",
                "word": "ignorance",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "de77f48d-a0fa-439d-a8a4-27667f8415c0",
                        "entry_id": "adcf1657-9266-3276-91ce-becd6b8691da",
                        "tags": [
                            "plural"
                        ],
                        "form": "ignorances"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c5fbf7d2-2be9-3479-ad1e-934621fb50d1",
                        "entry_id": "adcf1657-9266-3276-91ce-becd6b8691da",
                        "glosses": [
                            "État de celui qui est ignorant ; celui qui ne connaît rien."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45fc68e4-2abe-4e09-a541-255e7b9b05d6",
                                "sense_id": "c5fbf7d2-2be9-3479-ad1e-934621fb50d1",
                                "text": "Sa connaissance des livres, quoique superficielle, suffisait à imposer à l’ignorance un certain respect pour le savoir qu’on lui supposait."
                            },
                            {
                                "example_id": "fc05d8ea-03cc-4f8a-8ba0-24a96b259495",
                                "sense_id": "c5fbf7d2-2be9-3479-ad1e-934621fb50d1",
                                "text": "Pour un spectateur instruit, ce contraste entre la complète ignorance des uns et la palpitante attention des autres eût été sublime."
                            },
                            {
                                "example_id": "eb7dacdd-6480-4b8e-bbbe-58ca4621b835",
                                "sense_id": "c5fbf7d2-2be9-3479-ad1e-934621fb50d1",
                                "text": "Durandus eut beau exciper de son ignorance, il ne fut libéré qu'après s'être vu condamner à une amende."
                            },
                            {
                                "example_id": "38c615bc-cd86-4871-ad5e-acbf00046613",
                                "sense_id": "c5fbf7d2-2be9-3479-ad1e-934621fb50d1",
                                "text": "L’ignorance d’aujourd’hui est le bon usage de demain."
                            },
                            {
                                "example_id": "d5834eee-300f-4d29-946f-7140cce2bfe9",
                                "sense_id": "c5fbf7d2-2be9-3479-ad1e-934621fb50d1",
                                "text": "La raison d'État n'est le plus souvent qu'un manteau commode pour couvrir l’ignorance, la bêtise ou la scélératesse d'une oligarchie..."
                            },
                            {
                                "example_id": "a443bfcb-a35f-4854-8bf2-f594efbe3380",
                                "sense_id": "c5fbf7d2-2be9-3479-ad1e-934621fb50d1",
                                "text": "Un système aussi injuste ne peut se maintenir qu’en tenant la population dans l’ignorance et la vulnérabilité."
                            }
                        ]
                    },
                    {
                        "sense_id": "1354bcd2-3896-3bab-9bdb-5aba7af52b93",
                        "entry_id": "adcf1657-9266-3276-91ce-becd6b8691da",
                        "glosses": [
                            "Fautes qui marquent une ignorance grossière."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "f18e92c8-ba26-4313-af56-b60bb0424803",
                                "sense_id": "1354bcd2-3896-3bab-9bdb-5aba7af52b93",
                                "text": "Ce livre est plein d’ignorances impardonnables."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d52207db-01b1-4d2f-8423-6dd5e2a629f4",
                        "source_entry_id": "adcf1657-9266-3276-91ce-becd6b8691da",
                        "source_sense_id": "c5fbf7d2-2be9-3479-ad1e-934621fb50d1",
                        "source_sense_description": "État de celui qui est ignorant.",
                        "target_lang_word": "Unwissenheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unwissenheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fd4602cb-e1c2-3f38-83ac-1772381356e5",
                                        "entry_id": "a6ca5e14-fd4b-377d-9aed-f25cde83c706",
                                        "glosses": [
                                            "Eigenschaft einer Person, manches/vieles nicht zu wissen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71016c3e-0bd8-48f6-9a78-11fc23df619e",
                                                "sense_id": "fd4602cb-e1c2-3f38-83ac-1772381356e5",
                                                "text": "Meiner Unwissenheit kann ich durch intensives Lernen entgegen wirken."
                                            },
                                            {
                                                "example_id": "3223e97d-44e3-410e-944a-2accf2b5148f",
                                                "sense_id": "fd4602cb-e1c2-3f38-83ac-1772381356e5",
                                                "text": "„Unwissenheit liegt mitten zwischen gründlicher Wissenschaft und irriger Lehre.“"
                                            },
                                            {
                                                "example_id": "00f687d4-f738-492e-937d-881162df65d0",
                                                "sense_id": "fd4602cb-e1c2-3f38-83ac-1772381356e5",
                                                "text": "„Vielleicht hatte sie einfach genug davon, dass die Mieterinnen alles zu Geld machten, was nicht niet- und nagelfest war, und sich dann auf Unwissenheit beriefen.“"
                                            },
                                            {
                                                "example_id": "9dba741b-4172-47f0-aec1-db92b059271d",
                                                "sense_id": "fd4602cb-e1c2-3f38-83ac-1772381356e5",
                                                "text": "„Heute frage ich mich, ob meine Unwissenheit daher rührte, dass wir Gastarbeiterkinder aus Westdeutschland die alte BRD so verinnerlicht hatten, dass die meisten nie über die Welt jenseits des Eisernen Vorhangs nachdachten.“"
                                            },
                                            {
                                                "example_id": "9ab72c62-554c-4310-8b62-b640ab39ba9f",
                                                "sense_id": "fd4602cb-e1c2-3f38-83ac-1772381356e5",
                                                "text": "„Diese Unwissenheit war später die Quelle verschiedener Mythen über das wahre Atlantis.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ae4d2ca7-0495-45ce-8553-68b639e662bc",
                        "source_entry_id": "adcf1657-9266-3276-91ce-becd6b8691da",
                        "source_sense_id": "c5fbf7d2-2be9-3479-ad1e-934621fb50d1",
