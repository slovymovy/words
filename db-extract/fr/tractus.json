                                    {
                                        "sense_id": "395fceee-de80-3c94-87fe-f9b7304f8673",
                                        "entry_id": "8d5bd4c2-2018-31b9-ad73-861de22ead9e",
                                        "glosses": [
                                            "An area or expanse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0986bc2e-6657-4113-9155-a9f1186474b1",
                                                "sense_id": "395fceee-de80-3c94-87fe-f9b7304f8673",
                                                "text": "an unexplored tract of sea"
                                            },
                                            {
                                                "example_id": "33ac29bc-3ee5-419c-a816-e9141e7a6d86",
                                                "sense_id": "395fceee-de80-3c94-87fe-f9b7304f8673",
                                                "text": "the deep tract of hell"
                                            },
                                            {
                                                "example_id": "8d78a1fe-f549-4c3e-9645-024b78c2a9c7",
                                                "sense_id": "395fceee-de80-3c94-87fe-f9b7304f8673",
                                                "text": "a very high mountain joined to the mainland by a narrow tract of earth"
                                            },
                                            {
                                                "example_id": "a43300bd-13fe-47d9-814e-497feac7bb15",
                                                "sense_id": "395fceee-de80-3c94-87fe-f9b7304f8673",
                                                "text": "small tracks of ground"
                                            },
                                            {
                                                "example_id": "498c8cf1-4a1a-43d8-8ee7-45f017039711",
                                                "sense_id": "395fceee-de80-3c94-87fe-f9b7304f8673",
                                                "text": "Another place where, from the aesthetic point of view, a long tunnel would have been a real blessing, is East London as viewed from the carriage window on the old Great Eastern line. Despite a vast change from crowded slums to tracts of wasteland, due to its grim wartime experience, this approach still provides a shabby and unworthy introduction to the great capital."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e142ba4-35ad-3e64-92a4-2feee770870c",
                                        "entry_id": "8d5bd4c2-2018-31b9-ad73-861de22ead9e",
                                        "glosses": [
                                            "A series of connected body organs, such as the digestive tract."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3fec04be-0131-3979-889c-09ed178d6737",
                                        "entry_id": "8d5bd4c2-2018-31b9-ad73-861de22ead9e",
                                        "glosses": [
                                            "A small booklet such as a pamphlet, often for promotional or informational uses."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d1e4b635-6016-32d2-a3e0-ebc0eef21ef2",
                                        "entry_id": "8d5bd4c2-2018-31b9-ad73-861de22ead9e",
                                        "glosses": [
                                            "A brief treatise or discourse on a subject."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9434fb56-33fb-4f20-8a38-2052889bf8dd",
                                                "sense_id": "d1e4b635-6016-32d2-a3e0-ebc0eef21ef2",
                                                "text": "The church clergy at that writ the best collection of tracts against popery that ever appeared."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1797aa3-e65c-3aab-92c0-4b4c94a172a6",
                                        "entry_id": "8d5bd4c2-2018-31b9-ad73-861de22ead9e",
                                        "glosses": [
                                            "A commentator's view or perspective on a subject."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a1823601-5592-35bb-987b-9952c2206463",
                                        "entry_id": "8d5bd4c2-2018-31b9-ad73-861de22ead9e",
                                        "glosses": [
                                            "Continued or protracted duration, length, extent"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6dd01f9b-c850-4d6d-9181-1a76385817e1",
                                                "sense_id": "a1823601-5592-35bb-987b-9952c2206463",
                                                "text": "improved by tract of time"
                                            },
                                            {
                                                "example_id": "69ed72d6-ff6a-4c82-8f74-b40ae8eb534e",
                                                "sense_id": "a1823601-5592-35bb-987b-9952c2206463",
                                                "text": "Nay, in another case of litigation, the unjust Standard bearer, for his own profit, asserting that the cause belonged not to St. Edmund’s Court, but to his in Lailand Hundred, involved us in travellings and innumerable expenses, vexing the servants of St. Edmund for a long tract of time […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4bddeb4c-6f89-3947-8557-ea97620e5aba",
                                        "entry_id": "8d5bd4c2-2018-31b9-ad73-861de22ead9e",
                                        "glosses": [
                                            "Part of the proper of the liturgical celebration of the Eucharist for many Christian denominations, used instead of the alleluia during Lenten or pre-Lenten seasons, in a Requiem Mass, and on a few other penitential occasions."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2bdc5d33-b46d-302f-8311-06e3f7009c03",
                                        "entry_id": "8d5bd4c2-2018-31b9-ad73-861de22ead9e",
                                        "glosses": [
                                            "Continuity or extension of anything."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc2ce813-d528-4c10-8554-693f6dd0edcc",
                                                "sense_id": "2bdc5d33-b46d-302f-8311-06e3f7009c03",
                                                "text": "in tract of speech"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71ccb0d5-39b2-3dfc-9ac9-3d5e6b02e0b8",
                                        "entry_id": "8d5bd4c2-2018-31b9-ad73-861de22ead9e",
                                        "glosses": [
                                            "Traits; features; lineaments."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac099dc7-37c0-4262-999b-6f77cde764b1",
                                                "sense_id": "71ccb0d5-39b2-3dfc-9ac9-3d5e6b02e0b8",
                                                "text": "The discovery of a man's self by the tracts of his countenance is a great weakness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f3d3b90-2c6c-3dfd-b321-8debf712fec3",
                                        "entry_id": "8d5bd4c2-2018-31b9-ad73-861de22ead9e",
                                        "glosses": [
                                            "The footprint of a wild animal."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d507914d-fe0b-405a-b9af-aeb2f9e11d61",
                                                "sense_id": "8f3d3b90-2c6c-3dfd-b321-8debf712fec3",
                                                "text": "The Prophet Telemus […]mark'd the Tracts of every Bird that flew"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b49645e-a551-33b1-915a-09a9a9685280",
                                        "entry_id": "8d5bd4c2-2018-31b9-ad73-861de22ead9e",
                                        "glosses": [
                                            "Track; trace."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c59f6f96-d62b-4bfb-b37d-305f20e05a06",
                                                "sense_id": "6b49645e-a551-33b1-915a-09a9a9685280",
                                                "text": "Efface all tract of its traduction."
                                            },
                                            {
                                                "example_id": "f7aac350-ba10-47f5-8064-cf1bf2b017b9",
                                                "sense_id": "6b49645e-a551-33b1-915a-09a9a9685280",
                                                "text": "But flies an eagle flight, bold, and forth on, / Leaving no tract behind."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27359bee-b021-30d3-ae45-b91b84969d77",
                                        "entry_id": "8d5bd4c2-2018-31b9-ad73-861de22ead9e",
                                        "glosses": [
                                            "Treatment; exposition."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0975dd5-57a1-45db-96fb-6fab95581d25",
                                                "sense_id": "27359bee-b021-30d3-ae45-b91b84969d77",
                                                "text": "The tract of every thing Would, by a good discourser, lose some life Which action's self was tongue to."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tract",
