                "senses": [
                    {
                        "sense_id": "d2321f36-b874-3c0f-9089-9977686c2ec8",
                        "entry_id": "1f619733-14cb-326b-9c30-3cf330ec2a82",
                        "glosses": [
                            "Geistlicher einer orthodoxen Kirche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92da9430-4d5a-44d8-8a11-2c67fa199fd8",
                                "sense_id": "d2321f36-b874-3c0f-9089-9977686c2ec8",
                                "text": "„Zorica, die Nachbarin aus dem zweiten Stock, umarmt dich, nimmt einen Keks und sagt, sie habe auf dem Markt den Popen getroffen, der die Zeremonie am Friedhof abhalten werde.“"
                            },
                            {
                                "example_id": "091dd141-9fed-441d-b0ae-4ae6ab7cdcac",
                                "sense_id": "d2321f36-b874-3c0f-9089-9977686c2ec8",
                                "text": "„Der Pope mit einem langen Bart war über mein Auftauchen überrascht und fragte mich auf griechisch, ob ich ein »Romeo«, ein Grieche sei.“"
                            },
                            {
                                "example_id": "2347e52d-3167-4b0e-ae99-b56ee278ed73",
                                "sense_id": "d2321f36-b874-3c0f-9089-9977686c2ec8",
                                "text": "„Vor der Revolution hatte es wahrscheinlich dem Popen gehört.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "02161d44-040f-30dc-aa93-7a43a866be54",
                        "entry_id": "1f619733-14cb-326b-9c30-3cf330ec2a82",
                        "glosses": [
                            "Geistlicher, der nicht zur Gruppe unter [1] gehört"
                        ],
