    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f2bdc4cc-b4f3-3dc5-9b03-b274e4b6ddab",
                    "sense_definition": "iemand die verdrietig of neerslachtig is weer vrolijk of optimistischer maken",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vrolijk maken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het gesprek met zijn oude vriend <w>beurde</w> hem zichtbaar <w>op</w>.",
                            "target_lang_translations": {
                                "en": "The conversation with his old friend visibly <w>cheered</w> him <w>up</w>."
                            }
                        },
                        {
                            "text": "Ik probeerde haar met een klein cadeautje een beetje <w>op</w> te <w>beuren</w>.",
                            "target_lang_translations": {
                                "en": "I tried to <w>cheer</w> her <w>up</w> a bit with a small gift."
                            }
                        }
                    ],
                    "synonyms": [
                        "opkikkeren",
                        "opvrolijken"
                    ],
                    "antonyms": [
                        "neerslaan"
                    ],
                    "common_phrases": [
                        "iemand opbeuren"
                    ],
                    "target_lang_definitions": {
                        "en": "to make someone who is sad or depressed feel happy or more optimistic again"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cheer up",
                                "target_lang_sense_clarification": "to make someone feel happier"
                            },
                            {
                                "target_lang_word": "comfort",
                                "target_lang_sense_clarification": "to provide consolation to someone in distress"
                            },
                            {
                                "target_lang_word": "uplift",
                                "target_lang_sense_clarification": "to improve someone's spiritual or emotional state"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fe5135e8-718c-3001-acd4-19a8ac604cc5",
                    "sense_definition": "iets fysiek omhoog tillen of naar een hogere positie brengen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "tillen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij moest de zware kist voorzichtig <w>opbeuren</w> om hem op de tafel te zetten.",
                            "target_lang_translations": {
                                "en": "He had to carefully <w>lift up</w> the heavy chest to put it on the table."
                            }
                        },
                        {
                            "text": "Met vereende krachten <w>beurden</w> ze de gevallen boomstam <w>op</w>.",
                            "target_lang_translations": {
                                "en": "With combined efforts, they <w>heaved up</w> the fallen tree trunk."
                            }
                        }
                    ],
                    "antonyms": [
                        "neerleggen"
                    ],
                    "common_phrases": [
                        "iets opbeuren"
                    ],
                    "target_lang_definitions": {
                        "en": "to physically lift something up or move it to a higher position"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lift up",
                                "target_lang_sense_clarification": "to raise something to a higher level"
                            },
                            {
                                "target_lang_word": "heave",
                                "target_lang_sense_clarification": "to lift or haul a heavy object with great effort"
                            },
                            {
                                "target_lang_word": "raise",
                                "target_lang_sense_clarification": "to move something to a higher vertical position"
                            }
                        ]
                    }
                }
            ]
        }
    ]
