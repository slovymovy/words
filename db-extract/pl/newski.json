                "senses": [
                    {
                        "sense_id": "e4a7ee9a-d600-3dec-b88a-a1b0d9a3b92b",
                        "entry_id": "8c3e2bed-5e40-3ac3-aaba-6f6453b72281",
                        "glosses": [
                            "od Newa"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "029d3ee3-357e-4c5a-ac12-f07023ec233e",
                                "sense_id": "e4a7ee9a-d600-3dec-b88a-a1b0d9a3b92b",
                                "text": "Petersburczanie (=Petersburżanie) winszują sobie zwykle, po powrocie z podróży, że będą mogli pić znowu wodę newską, a cesarz Aleksander I, jak powiadają, woził zawsze z sobą, w czasie podróży, wodę newską we flaszach"
                            },
                            {
                                "example_id": "a43ae291-f1f0-4f10-bb01-fecaaa704c55",
                                "sense_id": "e4a7ee9a-d600-3dec-b88a-a1b0d9a3b92b",
                                "text": "W Leningradzie na rozkaz Kwatery Głównej umacniano rubież newską, na bazie newskiej grupy operacyjnej rozlokowywała się tam 67. Armia"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
