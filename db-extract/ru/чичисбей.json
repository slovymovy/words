                "senses": [
                    {
                        "sense_id": "fe4dfac3-123a-3fbf-a24d-cdf7d91bf4a1",
                        "entry_id": "bfe34632-5260-3028-bba3-e567c079bf92",
                        "glosses": [
                            "устар. постоянный спутник дамы; кавалер замужней женщины на прогулках и увеселительных мероприятиях"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2da5ecfe-98d9-4034-91e8-9ce0983b8aa0",
                                "sense_id": "fe4dfac3-123a-3fbf-a24d-cdf7d91bf4a1",
                                "text": "Оказалось, что при всех хорошеньких женщинах Венеции имеются чичисбеи, нередко с ведома и согласия мужей, а иногда на основании пункта в брачном договоре, предусмотренного невестой или её родителями."
                            },
                            {
                                "example_id": "cfeb684f-4762-437a-ade6-8d03e0298066",
                                "sense_id": "fe4dfac3-123a-3fbf-a24d-cdf7d91bf4a1",
                                "text": "В частности, ничего не имею против этого милого и тихого юноши, который служит чичисбеем и Наде, и Ате и в «моменты, свободные от службы» изучает Серова для предпринятой им монографии."
                            }
                        ]
                    }
