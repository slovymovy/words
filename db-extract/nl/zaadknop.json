                                "target_senses": [
                                    {
                                        "sense_id": "494d11ab-b71d-3ac1-adf1-bc5b96e6ab37",
                                        "entry_id": "faf750b2-316f-35ed-839b-bae6415395ed",
                                        "glosses": [
                                            "Gamète femelle haploïde produit par l’ovaire, susceptible de fusionner avec un spermatozoïde lors de la fécondation pour former un zygote, puis le fœtus."
                                        ],
                                        "tags": [
                                            "Biologie animale"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "755702ce-ece9-4d31-bf9c-f32213efb27a",
                                                "sense_id": "494d11ab-b71d-3ac1-adf1-bc5b96e6ab37",
                                                "text": "À mesure que les ovules quittent le ventre de la femelle, ils sont fécondés par le mâle. La semence s’échappe par l’orifice anal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4005d65c-b068-3232-af57-dc9372950c90",
                                        "entry_id": "faf750b2-316f-35ed-839b-bae6415395ed",
                                        "glosses": [
                                            "Structure diploïde des plantes à graines (spermatophytes), issue du sporophyte, qui renferme le gamétophyte femelle haploïde. Ce dernier produit l’oosphère, destinée à être fécondée ; après fécondation, l’ovule se transforme en graine."
                                        ],
                                        "tags": [
                                            "Biologie végétale",
                                            "Anatomie végétale",
                                            "Biologie évolutive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2cd8705-1aae-472a-819c-d180842409ad",
                                                "sense_id": "4005d65c-b068-3232-af57-dc9372950c90",
                                                "text": "Les phylogénies moléculaires et morphologiques soutiennent également fortement la monophylie des spermatophytes, impliquant une origine unique de l’ovule."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1a69a08-5dee-33eb-bf2d-38ad501d90e2",
                                        "entry_id": "faf750b2-316f-35ed-839b-bae6415395ed",
                                        "glosses": [
                                            "Médicament solide, souvent de forme ovoïde, destiné à être appliqué par insertion dans le vagin ; aussi appelé « ovule gynécologique » ou « suppositoire vaginal »."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "321f5dc7-4b56-4839-9175-f5475cd4c5ab",
                                                "sense_id": "f1a69a08-5dee-33eb-bf2d-38ad501d90e2",
                                                "text": "Dans le cadre d’un traitement antimycosique, antiparasitaire ou anti-infectieux, l’ovule doit être introduit dans le vagin le soir au moment du coucher."
                                            },
                                            {
                                                "example_id": "28bab8a8-0677-4e38-9782-68e69e129010",
                                                "sense_id": "f1a69a08-5dee-33eb-bf2d-38ad501d90e2",
                                                "text": "Pour les femmes, ne mettez pas d’ovules et ne faites pas d’injection vaginale 48 heures avant."
                                            }
                                        ]
                                    }
                                ]
                            },
