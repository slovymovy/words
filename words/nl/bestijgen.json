{
    "word_family": [
        "stijgen",
        "stijging",
        "bestijging"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "06ecf2bc-6ad1-3d42-bb74-83e86758ac15",
                    "sense_definition": "Bovenop iets klimmen of geraken, zoals een berg, paard of podium.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "klimmen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De ervaren klimmers wilden de steile berg <w>bestijgen</w> ondanks het slechte weer.",
                            "target_lang_translations": {
                                "en": "The experienced climbers wanted to <w>climb</w> the steep mountain despite the bad weather."
                            }
                        },
                        {
                            "text": "Hij moest eerst het paard <w>bestijgen</w> voordat de tocht door het bos kon beginnen.",
                            "target_lang_translations": {
                                "en": "He first had to <w>mount</w> the horse before the trek through the forest could begin."
                            }
                        }
                    ],
                    "synonyms": [
                        "beklimmen",
                        "opstijgen"
                    ],
                    "antonyms": [
                        "afdalen",
                        "afstijgen"
                    ],
                    "common_phrases": [
                        "een berg bestijgen",
                        "een paard bestijgen"
                    ],
                    "target_lang_definitions": {
                        "en": "To climb or get on top of something, such as a mountain, horse, or stage."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "climb",
                                "target_lang_sense_clarification": "a mountain or hill"
                            },
                            {
                                "target_lang_word": "mount",
                                "target_lang_sense_clarification": "a horse or stage"
                            },
                            {
                                "target_lang_word": "ascend",
                                "target_lang_sense_clarification": "a mountain or stairs, formal"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a7cf3a1c-79df-3e72-a7ce-91c5a2d977e1",
                    "sense_definition": "De troon in bezit nemen om vorst of vorstin te worden.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "troon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De jonge prins zal volgende maand officieel de troon <w>bestijgen</w>.",
                            "target_lang_translations": {
                                "en": "The young prince will officially <w>ascend</w> the throne next month."
                            }
                        },
                        {
                            "text": "Nadat de koning overleed, moest zijn oudste dochter de troon <w>bestijgen</w>.",
                            "target_lang_translations": {
                                "en": "After the king died, his eldest daughter had to <w>ascend</w> the throne."
                            }
                        }
                    ],
                    "synonyms": [
                        "de troon aanvaarden"
                    ],
                    "antonyms": [
                        "aftreden"
                    ],
                    "common_phrases": [
                        "de troon bestijgen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Vaak gebruikt in formele of historische contexten"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To take possession of the throne to become a monarch."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ascend",
                                "target_lang_sense_clarification": "the throne"
                            },
                            {
                                "target_lang_word": "mount",
                                "target_lang_sense_clarification": "the throne"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1b1aa36c-0397-337e-91b6-ebb6176df5e6",
                    "sense_definition": "Het paren van mannelijke dieren (met name paarden) door op het vrouwtje te klimmen.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "paren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De hengst probeerde de merrie in de weide te <w>bestijgen</w>.",
                            "target_lang_translations": {
                                "en": "The stallion tried to <w>mount</w> the mare in the pasture."
                            }
                        },
                        {
                            "text": "In de fokkerij laat men de hengst de merrie onder toezicht <w>bestijgen</w>.",
                            "target_lang_translations": {
                                "en": "In breeding, the stallion is allowed to <w>mount</w> the mare under supervision."
                            }
                        }
                    ],
                    "synonyms": [
                        "dekken",
                        "bespringen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Term gebruikt in de diergeneeskunde en veeteelt"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The mating of male animals (especially horses) by mounting the female."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mount",
                                "target_lang_sense_clarification": "of male animals for mating"
                            },
                            {
                                "target_lang_word": "cover",
                                "target_lang_sense_clarification": "of a stallion mating with a mare"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}