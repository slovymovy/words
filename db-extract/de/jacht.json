                    },
                    {
                        "form_id": "fac1fa94-f1af-4288-9655-a8d053495a54",
                        "entry_id": "21ee8524-417c-3c6f-ac19-418396a2d3f6",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Jachten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2f665b00-1ce9-32c0-b9ea-488582384641",
                        "entry_id": "21ee8524-417c-3c6f-ac19-418396a2d3f6",
                        "glosses": [
                            "No glosses available"
                        ],
                        "tags": [
                            "no-gloss"
                        ],
                        "examples": [
                            {
                                "example_id": "fee5cedf-04ac-4e7c-8ca0-9d35c54021d0",
                                "sense_id": "2f665b00-1ce9-32c0-b9ea-488582384641",
                                "text": "Abe wandte den Blick ab und schaute zur Jacht in der Lagune hinüber. (Karel Capek, Der Krieg mit den Molchen, 1. Buch, 6. Kapitel)"
                            },
                            {
                                "example_id": "dabf93d9-0932-4516-b593-ef0cfbd7b016",
                                "sense_id": "2f665b00-1ce9-32c0-b9ea-488582384641",
                                "text": "„Halb im Sand versunken, rosteten ein paar Jachten vor sich hin.“"
                            },
                            {
                                "example_id": "9533aeda-5aa6-4b77-a3c0-6ab9038925f2",
                                "sense_id": "2f665b00-1ce9-32c0-b9ea-488582384641",
                                "text": "„Es war das Modell einer prächtigen Jacht und die riesige Fernsteuerung mit zwei Antennen trug der Sohn stolz an einem Gurt um den Hals.“"
                            },
                            {
                                "example_id": "8f1e6197-87ba-4bfd-87ac-db5b4bec401a",
                                "sense_id": "2f665b00-1ce9-32c0-b9ea-488582384641",
                                "text": "„Und dann war oben unten und unten oben, der Kutter kenterte, indessen sich der Bug der Jacht knirschend in seine Seite grub.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
