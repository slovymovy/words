                    "target_lang_definitions": {
                        "ru": "Специфическое название нижней палаты законодательного собрания в нескольких штатах США."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ассамблея",
                                "target_lang_sense_clarification": "нижняя палата штата"
                            },
                            {
                                "target_lang_word": "законодательное собрание",
