                "senses": [
                    {
                        "sense_id": "19db1520-ae53-3cad-a607-76410fdb7b17",
                        "entry_id": "1f2cf7c6-8d92-31f0-a228-12a76d99865a",
                        "glosses": [
                            "Preference, bias in favor of, tendency."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "6c479aa5-8236-41ab-bc68-b2fb9c40fa99",
                                "sense_id": "19db1520-ae53-3cad-a607-76410fdb7b17",
                                "text": "The judge's partiality towards the defendant caused him to be replaced, with someone who was apparently more neutral."
                            }
                        ]
                    },
                    {
                        "sense_id": "72b25c7f-683e-3278-b55c-791b8f2ff55c",
                        "entry_id": "1f2cf7c6-8d92-31f0-a228-12a76d99865a",
                        "glosses": [
                            "The quality of being partial or incomplete."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "4fb1c3e0-21d4-48e1-96be-b3f77e5a3ecc",
                                "sense_id": "72b25c7f-683e-3278-b55c-791b8f2ff55c",
                                "text": "Illness confronts the self with partiality, incompleteness, and mortality."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ea7f88fd-3fd8-4cf1-b943-257d72ee03f3",
                        "source_entry_id": "1f2cf7c6-8d92-31f0-a228-12a76d99865a",
                        "source_sense_description": "preference",
                        "target_lang_word": "partijdigheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "partijdigheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "0df25326-6f88-3437-9cad-9c1175cac9e5",
                                        "entry_id": "5b959df8-0760-380c-b4f0-6a22b9bfd423",
                                        "glosses": [
                                            "de mate waarin iemand kiest voor een van de partijen die strijden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "784930c7-56cb-43ff-a6f2-5c122b275de6",
                                                "sense_id": "0df25326-6f88-3437-9cad-9c1175cac9e5",
                                                "text": "Zo iemand noemen wij een besmette getuige, omdat er mogelijk van partijdigheid sprake is."
                                            },
                                            {
                                                "example_id": "ce7e0c98-fbe5-406c-a9a3-17b4eb056ad7",
                                                "sense_id": "0df25326-6f88-3437-9cad-9c1175cac9e5",
                                                "text": "Het wrakingsverzoek werd door de rechter aanvankelijk afgewezen, maar uiteindelijk werd de rechter alsnog vervangen omdat hij onopzettelijk onjuiste informatie had verstrekt. Daardoor zou de schijn van partijdigheid gewekt kunnen worden volgens een tweede wrakingskamer. Hierdoor moest gezocht worden naar een nieuwe rechter, die zich vervolgens moest inlezen in het dossier."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fcc3496c-2faf-4716-b277-148df2e2c475",
                        "source_entry_id": "1f2cf7c6-8d92-31f0-a228-12a76d99865a",
                        "source_sense_description": "preference",
                        "target_lang_word": "partialité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "partialité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7fbf90cc-aaf0-34c7-aedb-d48f5dfa2df8",
                                        "entry_id": "91342deb-ad0b-31b1-a4d6-dd9e8d565f2b",
                                        "glosses": [
                                            "Disposition à favoriser une personne, une opinion plutôt qu’une autre, préférence marquée à son égard et contraire à la justice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2450e97f-0181-4746-8e48-5f432071f301",
                                                "sense_id": "7fbf90cc-aaf0-34c7-aedb-d48f5dfa2df8",
                                                "text": "Tous les souverains de la race normande avaient témoigné la partialité la plus marquée pour leurs sujets normands ; les lois […] avaient été fixées comme un joug sur le cou des habitants subjugués, surcroît féodal, des chaînes dont ils étaient chargés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "20987bf0-7284-475d-9a9c-2c1fb7939783",
                        "source_entry_id": "1f2cf7c6-8d92-31f0-a228-12a76d99865a",
                        "source_sense_description": "preference",
                        "target_lang_word": "Parteilichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "4b8986e6-c5d2-42b2-aa81-796d9dc0e759",
                        "source_entry_id": "1f2cf7c6-8d92-31f0-a228-12a76d99865a",
                        "source_sense_description": "preference",
                        "target_lang_word": "Befangenheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Befangenheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c33a6cef-94e6-3a9a-98e0-fbd7ec6958d2",
                                        "entry_id": "a0b1e802-53ed-3710-bb83-b22c25c67da6",
                                        "glosses": [
                                            "Unsicherheit oder Zögern einer Sache gegenüber"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e035be93-b949-4a4b-8932-3a4e008cb3dc",
                                                "sense_id": "c33a6cef-94e6-3a9a-98e0-fbd7ec6958d2",
                                                "text": "Als Anna vorgestellt wurde, wich ihre Befangenheit schnell dem Interesse an ihren neuen Klassenkameraden."
                                            },
                                            {
                                                "example_id": "09389e00-9a2d-45e0-83bd-80fa31adc820",
                                                "sense_id": "c33a6cef-94e6-3a9a-98e0-fbd7ec6958d2",
                                                "text": "„Er geht wie im Traum weiter, dann aber schüttelt er die Befangenheit ab, als neben ihm, hoch oben auf den Stadtbahnbögen, eine S-Bahn vorüberrasselt.“"
                                            },
                                            {
                                                "example_id": "bbfd4eef-6b3a-4dd9-a2ba-b77c530b8370",
                                                "sense_id": "c33a6cef-94e6-3a9a-98e0-fbd7ec6958d2",
                                                "text": "„Als Thomas seine anfängliche Befangenhet abgelegt hatte, war er bereit, bei diesem Spiel mitzuwirken, das ihn zeitweise an absurdes Theater erinnerte.“"
                                            },
                                            {
                                                "example_id": "b00b7549-3808-45be-bfb0-2877a45ec359",
                                                "sense_id": "c33a6cef-94e6-3a9a-98e0-fbd7ec6958d2",
                                                "text": "„Die Tanzenden hatten sich ein für allemal gesagt, sie seien eben maskiert und niemand könne sie erkennen, und darum waren sie auch von jeglicher Befangenheit frei.“"
                                            },
                                            {
                                                "example_id": "d973f468-2f22-4e9c-a33e-c108783ea752",
                                                "sense_id": "c33a6cef-94e6-3a9a-98e0-fbd7ec6958d2",
                                                "text": "„Vielleicht erklärte sich die Befangenheit auch daher, daß er irgendwelche Aufgaben zu versäumen glaubte, die seiner im Archiv warteten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "015e9c74-4b68-3c94-88a2-b5d1b415580e",
                                        "entry_id": "a0b1e802-53ed-3710-bb83-b22c25c67da6",
                                        "glosses": [
                                            "mangelnde Fähigkeit, ein objektives und unabhängiges Urteil zu bilden, insbesondere aufgrund einer persönlichen Verwicklung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6323d513-123a-4317-a5bc-03b5fcb1f727",
                                                "sense_id": "015e9c74-4b68-3c94-88a2-b5d1b415580e",
                                                "text": "Der Staatsanwalt unterstellt dem Richter Befangenheit, weil er ein Stammtischbruder des Angeklagten sei."
                                            },
                                            {
                                                "example_id": "8ed6a3f3-6b03-4cd2-938f-1a0e9ded2b07",
                                                "sense_id": "015e9c74-4b68-3c94-88a2-b5d1b415580e",
                                                "text": "„Das Wesen der Befangenheit besteht in der Hemmung einer unparteiischen Entschließung durch unsachliche psychologische Motive.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
