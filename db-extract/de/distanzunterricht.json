                "senses": [
                    {
                        "sense_id": "379de0b6-7dbd-3ace-b09a-60cdee6bd46f",
                        "entry_id": "3ea090d9-8b63-359d-acbd-96d6e75fbaa5",
                        "glosses": [
                            "Form des Unterrichts, bei dem die Schüler von zu Hause aus lernen und nicht in der Schule sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6a008e7-2d68-4eee-bba7-2435876cb2ac",
                                "sense_id": "379de0b6-7dbd-3ace-b09a-60cdee6bd46f",
                                "text": "„Schüler ab der Klassenstufe 7 sollen aber in den Tagen vor Weihnachten zu Hause bleiben und dort Distanzunterricht erhalten.“"
                            },
                            {
                                "example_id": "a09b3c81-03e7-46c0-9f2f-80a7dd35c9a5",
                                "sense_id": "379de0b6-7dbd-3ace-b09a-60cdee6bd46f",
                                "text": "„Kaum zu begreifen ist aber, dass ein Land wie Deutschland […] mit offenen Augen derart in ein Schlamassel wie den Distanzunterricht hineinschlittern kann, und das beim zweiten Lockdown – mit Ansage, quasi.“"
                            },
                            {
                                "example_id": "33d36a6a-f3ff-4da4-ba50-fc36b9e431cb",
                                "sense_id": "379de0b6-7dbd-3ace-b09a-60cdee6bd46f",
                                "text": "[Schlagzeile:] „Wie monatelange Ferien – So verheerend ist Distanzunterricht für den Lernerfolg“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
