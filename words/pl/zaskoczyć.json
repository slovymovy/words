{
    "word_family": [
        "zaskoczenie",
        "zaskakujący"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "249eb811-323b-36f3-a4ec-48cf47ec4722",
                    "sense_definition": "sprawić, że ktoś poczuje zdziwienie przez nagłe, nieoczekiwane działanie lub zdarzenie",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "zaskoczenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jej wizyta <w>zaskoczyła</w> wszystkich domowników.",
                            "target_lang_translations": {
                                "ru": "Её визит <w>удивил</w> всех домочадцев."
                            }
                        },
                        {
                            "text": "Prezent <w>zaskoczył</w> go w pozytywny sposób.",
                            "target_lang_translations": {
                                "ru": "Подарок приятно его <w>удивил</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "zdziwić"
                    ],
                    "common_phrases": [
                        "zaskoczyć kogoś"
                    ],
                    "target_lang_definitions": {
                        "ru": "вызвать удивление внезапным, неожиданным действием или событием"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удивить",
                                "target_lang_sense_clarification": "вызвать чувство удивления"
                            },
                            {
                                "target_lang_word": "застать врасплох",
                                "target_lang_sense_clarification": "застать кого-то в момент, когда он не готов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "82716af1-1c67-3157-8996-eb095a489bc6",
                    "sense_definition": "wprawić kogoś w zakłopotanie lub zmieszanie poprzez sytuację, na którą nie jest przygotowany",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "zaskoczenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Trudne pytanie <w>zaskoczyło</w> studenta podczas egzaminu.",
                            "target_lang_translations": {
                                "ru": "Трудный вопрос <w>озадачил</w> студента во время экзамена."
                            }
                        },
                        {
                            "text": "Nagła zmiana planów zupełnie mnie <w>zaskoczyła</w>.",
                            "target_lang_translations": {
                                "ru": "Внезапная смена планов совершенно меня <w>сбила с толку</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "zbić z tropu"
                    ],
                    "common_phrases": [
                        "zaskoczyć pytaniem"
                    ],
                    "target_lang_definitions": {
                        "ru": "поставить кого-то в неловкое положение или смутить ситуацией, к которой он не готов"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сбить с толку",
                                "target_lang_sense_clarification": "запутать или привести в замешательство"
                            },
                            {
                                "target_lang_word": "озадачить",
                                "target_lang_sense_clarification": "поставить в тупик сложным вопросом или ситуацией"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ba0373b8-e430-3dcb-a178-60f2f6ba0d91",
                    "sense_definition": "aspekt dokonany od czasownika <w>zaskakiwać</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "zaskoczenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Był wyraźnie <w>zaskoczony</w> nagłym obrotem spraw.",
                            "target_lang_translations": {
                                "ru": "Он был явно <w>удивлён</w> внезапным поворотом событий."
                            }
                        },
                        {
                            "text": "To rozwiązanie <w>zaskoczyło</w> nawet ekspertów.",
                            "target_lang_translations": {
                                "ru": "Это решение <w>удивило</w> даже экспертов."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "совершенный вид глагола, означающий завершенное действие удивления"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удивить",
                                "target_lang_sense_clarification": "результативное действие удивления"
                            },
                            {
                                "target_lang_word": "поразить",
                                "target_lang_sense_clarification": "сильно удивить, произвести сильное впечатление"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}