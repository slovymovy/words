                        "entry_id": "6555f58e-a236-3d1b-a116-d38b214d1318",
                        "glosses": [
                            "To shake slightly; to push suddenly but slightly, so as to cause to shake or totter; to jostle; to jog."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "7b3d8dbd-1671-4669-bf43-2282e0fb3e9a",
                                "sense_id": "6f6109d4-ebee-3e40-b19a-6548c40d2920",
                                "text": "Little Elephant sighed because he felt ready to burst and he didn't see how he could eat any pudding, and he'd been waiting all day for that pudding. So he got up and trotted around the table ten times to joggle down his turkey. He must make room for the Christmas pudding!"
                            }
                        ]
                    },
                    {
                        "sense_id": "7d55357e-788b-33cb-9cdb-127996cda6af",
                        "entry_id": "6555f58e-a236-3d1b-a116-d38b214d1318",
                        "glosses": [
                            "To shake or totter; to slip out of place."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": []
                    }
                ],
                "translations": [],
                "word_linkages": []
