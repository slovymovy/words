                        "cross_references": [
                            {
                                "target_word": "compatibility",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9cdf9bee-894d-3c2a-a51f-019e5b88d837",
                                        "entry_id": "b5cddaf9-ca97-305c-86d0-854e03951b17",
                                        "glosses": [
                                            "The state of being compatible; in which two or more things are able to exist or work together in combination without problems or conflict."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1769cd0-a806-4e8a-a9a6-082f3c9f72d7",
                                                "sense_id": "9cdf9bee-894d-3c2a-a51f-019e5b88d837",
                                                "text": "One huge self-inflicted wound the industry is now suffering from is the lack of coupling compatibility. Up to the 1980s virtually everything had compatible drawgear on a given route, so there was every chance of pushing a failed train out of the way. Since privatisation, compatibility has been lost and in the last few years operators seem to have gone out of their way to avoid compatibility."
                                            },
                                            {
                                                "example_id": "9e83d0b9-ab64-40e8-85d7-c391069b4516",
                                                "sense_id": "9cdf9bee-894d-3c2a-a51f-019e5b88d837",
                                                "text": "They will feature wider gangways for better wheelchair accessibility, as well as compatibility with platform screen doors - should these ever be introduced in the future."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "785b7a41-df05-3c09-9a36-cc3b8bf0889e",
                                        "entry_id": "b5cddaf9-ca97-305c-86d0-854e03951b17",
                                        "glosses": [
                                            "the capability of two or more items or components of equipment or material to exist or function in the same system or environment without mutual interference."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dfe37068-e6e2-3d0f-851d-37f3bda1dc41",
                                        "entry_id": "b5cddaf9-ca97-305c-86d0-854e03951b17",
                                        "glosses": [
                                            "the ability to execute a given program on different types of computers without modification of the program or the computers. See backward compatibility and forward compatibility."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ef86dd91-8774-3ea4-be12-0ae4157ffe82",
                                        "entry_id": "b5cddaf9-ca97-305c-86d0-854e03951b17",
                                        "glosses": [
                                            "the capability that allows the substitution of one subsystem (storage facility), or of one functional unit (e.g., hardware, software), for the originally designated system or functional unit in a relatively transparent manner, without loss of information and without the introduction of errors."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
