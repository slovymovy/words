                                        "sense_id": "692100d0-d340-3ad9-819f-f950559229e6",
                                        "entry_id": "defa26ba-43df-370d-97da-41062a454134",
                                        "glosses": [
                                            "Outil utilisé dans le travail du bois et servant à tenir réunies des pièces destinées à être assemblées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a366bbf2-d3d6-4b8a-a305-ec54bdbae175",
                                                "sense_id": "692100d0-d340-3ad9-819f-f950559229e6",
                                                "text": "Autour de ses poignets et de ses chevilles, de vulgaires serre-joints attachés solidement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "793dd6f7-b85d-3fe5-8145-882c2466d754",
                                        "entry_id": "defa26ba-43df-370d-97da-41062a454134",
                                        "glosses": [
                                            "Outil utilisé pour assembler différentes pièces."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eafdfe17-7048-4221-8ee3-76167c992716",
                                                "sense_id": "793dd6f7-b85d-3fe5-8145-882c2466d754",
                                                "text": "Les maçons utilisent des serre-joints pour la réalisation de leurs coffrages."
                                            },
                                            {
                                                "example_id": "bca890d0-2e64-4a88-86d1-a0270c35c31c",
                                                "sense_id": "793dd6f7-b85d-3fe5-8145-882c2466d754",
                                                "text": "Une impressionnante collection de varlopes, rabots, limes & râpes était accrochée aux murs de tous côtés ; les ciseaux à bois, les bédanes, des chignoles à vilebrequin, toutes les dimensions de clés plates ou à pipes, deux ou trois clés à molette, les serre-joints ; toutes sortes de pinces, tenailles & sécateurs."
                                            }
                                        ]
                                    }
                                ]
                            }
