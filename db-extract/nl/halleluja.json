                                                "sense_id": "4f3f9693-f325-353a-8a1f-a9f87eb6e607",
                                                "text": "Hallelujah! It’s finally the weekend!"
                                            },
                                            {
                                                "example_id": "2415a1a4-9d98-437d-adff-92ce7acd01bb",
                                                "sense_id": "4f3f9693-f325-353a-8a1f-a9f87eb6e607",
                                                "text": "Hallelujah, it's nice to know you / It's so peculiar how you've come and changed my mind"
                                            }
                                        ]
                                    }
