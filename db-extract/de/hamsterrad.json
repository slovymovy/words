                "senses": [
                    {
                        "sense_id": "3e3face1-ca37-33aa-a452-c4ae5e99c7cd",
                        "entry_id": "4f1661d6-1ec0-340c-8312-5185797777d3",
                        "glosses": [
                            "kleines Laufrad, das in Gefangenschaft lebenden Kleinsäugern zur Beschäftigung und zur Auslebung ihres Bewegungsdranges angeboten wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "002f4b0c-07a9-4e0e-99c6-2acd37f689c2",
                                "sense_id": "3e3face1-ca37-33aa-a452-c4ae5e99c7cd",
                                "text": "Ein Hamsterrad gehört zur Grundausstattung eines Hamsterkäfigs."
                            },
                            {
                                "example_id": "fd937be3-9067-438c-9ab8-e57c5b9f4dd6",
                                "sense_id": "3e3face1-ca37-33aa-a452-c4ae5e99c7cd",
                                "text": "„Ich steckte genauso im Hamsterrad wie all die anderen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "917899f8-5ecd-47c4-a801-4d214fe35b6a",
                        "source_entry_id": "4f1661d6-1ec0-340c-8312-5185797777d3",
                        "source_sense_id": "3e3face1-ca37-33aa-a452-c4ae5e99c7cd",
                        "target_lang_word": "hamster wheel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hamster wheel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "68e44630-91ea-317a-b564-60e9d825e0f6",
                                        "entry_id": "209af3fd-9f09-3fb6-9785-3eadde12d6f0",
                                        "glosses": [
                                            "A circular cage for a hamster or other small rodent, which rotates vertically as the animal runs at its base."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "79dd97fb-9774-381d-a206-98fbb964a31a",
                                        "entry_id": "209af3fd-9f09-3fb6-9785-3eadde12d6f0",
                                        "glosses": [
                                            "A monotonous, repetitive, unfulfilling activity, especially one in which no progress is achieved."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ecc775e-7752-43da-8eb6-32d5bd2fc35d",
                                                "sense_id": "79dd97fb-9774-381d-a206-98fbb964a31a",
                                                "text": "The overall mood of this volume is one of melancholy and loss, weary resignation to one's lot—trudging round and round on the rusty hamster wheel of life."
                                            },
                                            {
                                                "example_id": "e7129445-f9fc-4c8a-8afe-6df3033e3b4a",
                                                "sense_id": "79dd97fb-9774-381d-a206-98fbb964a31a",
                                                "text": "Before the current pandemic, the rail industry appeared to be trapped on an ever-accelerating hamster wheel, trying to keep up with customer demand and political expectation on an essentially historic system itself exposed to greater impacts of climate change."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hamster wheel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "82979709-e7f0-3c7a-830c-763da6186bda",
                                        "entry_id": "6cbc9679-36fe-3dd3-9736-caf63591b853",
                                        "glosses": [
                                            "To cycle fruitlessly."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "informal",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34e8a7ea-aad2-4a0f-88a0-3b6094b63518",
                                                "sense_id": "82979709-e7f0-3c7a-830c-763da6186bda",
                                                "text": "I was shocked that I'd forgotten about the game that morning, but my mind had hamster-wheeled around for hours during the night, long after I should have been asleep."
                                            },
                                            {
                                                "example_id": "94b0f980-7c8d-4bd6-8caa-6dc527a74cb0",
                                                "sense_id": "82979709-e7f0-3c7a-830c-763da6186bda",
                                                "text": "But my brain was hamster-wheeling on that one hopefully-not-true-but-probably-was fact."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2cc4ed6d-def6-4eb3-889b-c1321fc7aad0",
                        "source_entry_id": "4f1661d6-1ec0-340c-8312-5185797777d3",
                        "source_sense_id": "3e3face1-ca37-33aa-a452-c4ae5e99c7cd",
                        "target_lang_word": "roda de hamster",
                        "target_lang_code": "pt",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "roda de hamster",
                                "target_lang_code": "pt",
                                "target_senses": [
                                    {
                                        "sense_id": "45462263-9ff8-3f4f-bddd-cad490bd4083",
                                        "entry_id": "7aaafeed-1962-3f50-b9ff-22ea941b2b91",
                                        "glosses": [
                                            "aparelho giratório colocado em gaiolas para que pequenos animais confinados possam exercitar-se, particularmente roedores; preso a um eixo central fixo na vertical, permite que o animal permaneça na base enquanto se movimenta"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5933474a-0e8e-47cf-baa6-8f53f764aa9a",
                                                "sense_id": "45462263-9ff8-3f4f-bddd-cad490bd4083",
                                                "text": "Imagine viver dentro de um círculo – não um tipo qualquer, mas na verdade uma roda de hamster gigante. Dois homens acabam de passar dez dias nesta estrutura incomum, uma instalação artística que ainda pode ser vista em uma galeria no Brooklyn, em Nova York."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0491aff1-d4a2-3f8a-925a-592fef4d03a6",
                                        "entry_id": "7aaafeed-1962-3f50-b9ff-22ea941b2b91",
                                        "glosses": [
                                            "repetição contínua de algo sem obter qualquer resultado concreto ou positivo; vida ou trabalho monótono e infrutífero, apesar dos esforços"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
