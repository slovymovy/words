                                    {
                                        "sense_id": "1d02741e-da74-3a8a-b613-1fa85a8cf622",
                                        "entry_id": "ad2c8822-e67d-3773-a4aa-2362a47b02b6",
                                        "glosses": [
                                            "Ensemble de signes utilisés pour représenter les phonèmes de certaines langues, une certaine voyelle étant rajoutée à chaque consonne, sauf indication contraire (grâce à quelque chose qui indique la voyelle à utiliser ou l’absence de la voyelle)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26f2bf68-ff8d-4c87-aeeb-4acbd7b124a8",
                                                "sense_id": "1d02741e-da74-3a8a-b613-1fa85a8cf622",
                                                "text": "L’amharique et le tigrinya s’écrivent dans des abugidas dérivés de celui du guèze."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
