                                        "entry_id": "9774f440-5d8f-3cc4-90ca-c1e0bb8deba1",
                                        "glosses": [
                                            "Facile à faire, simple, sans problème."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24163481-7ff6-4a54-b8e9-aff93c65a06e",
                                                "sense_id": "e3cbaf5b-2ff9-3e4a-a50e-cdb650ed2954",
                                                "text": "Une lettre qui n’est pas aisée à lire."
                                            },
                                            {
                                                "example_id": "9a8f9f17-5e44-4611-8b27-1c585475d6db",
                                                "sense_id": "e3cbaf5b-2ff9-3e4a-a50e-cdb650ed2954",
                                                "text": "Il est aisé de participer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e6e8616-860a-3949-885c-1be9eb2b4bbb",
                                        "entry_id": "9774f440-5d8f-3cc4-90ca-c1e0bb8deba1",
                                        "glosses": [
                                            "Qui n'a pas de problème d'argent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8149b57-f22a-451b-a7f1-0c4dae7e1108",
                                                "sense_id": "8e6e8616-860a-3949-885c-1be9eb2b4bbb",
                                                "text": "Oui, sans doute, il est pitoyable que des personnes aisées occupent indûment des lits dans les hôpitaux."
                                            },
                                            {
                                                "example_id": "002255ed-5e4a-4fea-98e7-d03cfb7f2fac",
                                                "sense_id": "8e6e8616-860a-3949-885c-1be9eb2b4bbb",
                                                "text": "Ses campagnes se désertifient, ses villages se disloquent, ses villes stagnent – tandis que ses enclaves aisées brillent de tous leurs feux derrière leurs grilles sur-protectrices."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b121821-0c87-3eb1-aecf-ccf32b82e1d4",
                                        "entry_id": "9774f440-5d8f-3cc4-90ca-c1e0bb8deba1",
                                        "glosses": [
                                            "Fluide, à propos d'un mouvement, d'une conversation."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5f416806-d5c8-3287-9b2f-c7c5c57c6a24",
                                        "entry_id": "9774f440-5d8f-3cc4-90ca-c1e0bb8deba1",
                                        "glosses": [
                                            "Se dit de vêtements qu’on met facilement, où l’on est à l’aise."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c5a1351-0452-4b98-85e3-1a509929d2b8",
                                                "sense_id": "5f416806-d5c8-3287-9b2f-c7c5c57c6a24",
                                                "text": "Ces souliers sont trop aisés: ils sont trop larges et ne serrent pas assez le pied."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
