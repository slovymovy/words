{
    "word_family": [
        "сложный",
        "сложность",
        "усложнять",
        "осложнять",
        "усложнение",
        "осложнение"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "9b6def9e-fee3-3bcb-aeb3-ab602186d30e",
                    "sense_definition": "Трудно, тяжело; оценка ситуации или действия как требующих больших усилий для понимания или выполнения.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "difficulty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мне <сложно> говорить по-русски быстро.",
                            "target_lang_translations": {
                                "en": "It is <hard> for me to speak Russian fast.",
                                "nl": "Ik vind het <w>moeilijk</w> om snel Russisch te spreken.",
                                "zh": "我快速说俄语很<w>难</w>。"
                            }
                        },
                        {
                            "text": "Решить эту задачу было очень <сложно>.",
                            "target_lang_translations": {
                                "en": "It was very <difficult> to solve this problem.",
                                "nl": "Het was erg <w>moeilijk</w> om deze opgave op te lossen.",
                                "zh": "解决这个问题非常<w>难</w>。"
                            }
                        },
                        {
                            "text": "В такой ситуации <сложно> принять правильное решение.",
                            "target_lang_translations": {
                                "en": "In such a situation, it is <difficult> to make the right decision.",
                                "nl": "In zo'n situatie is het <w>moeilijk</w> om de juiste beslissing te nemen.",
                                "zh": "在这种情况下，<w>很难</w>做出正确的决定。"
                            }
                        }
                    ],
                    "synonyms": [
                        "непросто",
                        "нелегко",
                        "трудно"
                    ],
                    "antonyms": [
                        "просто",
                        "легко"
                    ],
                    "common_phrases": [
                        "мне сложно",
                        "очень сложно",
                        "слишком сложно",
                        "сложно сказать"
                    ],
                    "target_lang_definitions": {
                        "en": "Hard, difficult; an assessment of a situation or action as requiring great effort to understand or perform.",
                        "nl": "Moeilijk, zwaar; beoordeling van een situatie of handeling als vereisend van grote inspanning om te begrijpen of uit te voeren.",
                        "zh": "指某事难以理解或完成，需要付出很大努力。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "difficult",
                                "target_lang_sense_clarification": "requiring effort or skill to do or understand"
                            },
                            {
                                "target_lang_word": "hard",
                                "target_lang_sense_clarification": "not easy; requiring physical or mental effort"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "moeilijk",
                                "target_lang_sense_clarification": "niet gemakkelijk, vereist inspanning of vaardigheid"
                            },
                            {
                                "target_lang_word": "lastig",
                                "target_lang_sense_clarification": "moeilijk op te lossen of uit te voeren"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "难",
                                "target_lang_sense_clarification": "指做某事有困难，需要费力"
                            },
                            {
                                "target_lang_word": "不容易",
                                "target_lang_sense_clarification": "指事情不简单，难以达成"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "340cc779-0afa-3be9-94a0-cc05ab8776dc",
                    "sense_definition": "Запутанно, витиевато; образом, имеющим сложную структуру или множество деталей.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "complexity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Этот механизм <сложно> устроен внутри.",
                            "target_lang_translations": {
                                "en": "This mechanism is <intricately> designed inside.",
                                "nl": "Dit mechanisme zit vanbinnen <w>ingewikkeld</w> in elkaar.",
                                "zh": "这个装置的内部结构很<w>复杂</w>。"
                            }
                        },
                        {
                            "text": "Автор пишет слишком <сложно> для детей.",
                            "target_lang_translations": {
                                "en": "The author writes too <complexly> for children.",
                                "nl": "De auteur schrijft te <w>ingewikkeld</w> voor kinderen.",
                                "zh": "作者写的内容对孩子来说太<w>深奥</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "непросто"
                    ],
                    "antonyms": [
                        "просто"
                    ],
                    "common_phrases": [
                        "сложно устроенный",
                        "сложно объяснить"
                    ],
                    "target_lang_definitions": {
                        "en": "Intricately, in a complex manner; in a way that has a complex structure or many details.",
                        "nl": "Ingewikkeld, complex; op een manier met een ingewikkelde structuur of veel details.",
                        "zh": "指结构复杂、细节繁多或难以解释。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "complexly",
                                "target_lang_sense_clarification": "in a complex or intricate manner"
                            },
                            {
                                "target_lang_word": "intricately",
                                "target_lang_sense_clarification": "with many complicated details"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "ingewikkeld",
                                "target_lang_sense_clarification": "met veel details of een complexe structuur"
                            },
                            {
                                "target_lang_word": "complex",
                                "target_lang_sense_clarification": "op een ingewikkelde, veelzijdige manier"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "复杂",
                                "target_lang_sense_clarification": "指事物种类多、结构复杂"
                            },
                            {
                                "target_lang_word": "深奥",
                                "target_lang_sense_clarification": "指道理或内容难以理解"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d42c92ee-d78c-34e9-b936-c9965da79ad7",
                    "sense_definition": "Краткая форма среднего рода единственного числа прилагательного <w>сложный</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это предложение слишком <сложно> для перевода.",
                            "target_lang_translations": {
                                "en": "This sentence is too <difficult> to translate.",
                                "nl": "Deze zin is te <w>moeilijk</w> om te vertalen.",
                                "zh": "这个句子太<w>复杂</w>，难以翻译。"
                            }
                        },
                        {
                            "text": "Всё это <сложно>, но очень интересно.",
                            "target_lang_translations": {
                                "en": "All this is <complicated>, but very interesting.",
                                "nl": "Dit is allemaal <w>ingewikkeld</w>, maar erg interessant.",
                                "zh": "这一切虽然很<w>复杂</w>，但非常有趣。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Short form of the neuter singular adjective 'complex' or 'difficult'.",
                        "nl": "Korte vorm van het onzijdig enkelvoudig bijvoeglijk naamwoord 'moeilijk' of 'ingewikkeld'.",
                        "zh": "形容词“复杂”或“困难”的短语形式，用于描述事物状态。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "complicated",
                                "target_lang_sense_clarification": "consisting of many interconnecting parts or elements"
                            },
                            {
                                "target_lang_word": "difficult",
                                "target_lang_sense_clarification": "hard to deal with or understand"
                            },
                            {
                                "target_lang_word": "complex",
                                "target_lang_sense_clarification": "consisting of many different and connected parts"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "moeilijk",
                                "target_lang_sense_clarification": "niet makkelijk te begrijpen of te doen"
                            },
                            {
                                "target_lang_word": "ingewikkeld",
                                "target_lang_sense_clarification": "bestaande uit veel verschillende delen, complex"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "复杂",
                                "target_lang_sense_clarification": "指事物本身结构或情况繁杂"
                            },
                            {
                                "target_lang_word": "困难",
                                "target_lang_sense_clarification": "指处理或理解某事有阻碍"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}