                ],
                "senses": [
                    {
                        "sense_id": "42f4b342-422a-3b95-bb7d-a92cb3069744",
                        "entry_id": "376f3490-4892-3d89-99de-723bd9f63b9b",
                        "glosses": [
                            "Membre d’une dynastie grecque régnant en Égypte, dont Ptolémée, fils de Lagos et l’un des capitaines d’Alexandre, fut le fondateur."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "8e8351fe-d075-4fb3-be8e-61d5e600beab",
                                "sense_id": "42f4b342-422a-3b95-bb7d-a92cb3069744",
                                "text": "Les deux plus puissantes monarchies qui s’élevèrent alors [à la mort d’Alexandre], furent celle d’Égypte, fondée par Ptolémée, fils de Lagus, d’où viennent les Lagides, & celle d’Asie ou de Syrie, fondée par Séleucus, d’où viennent les Séleucides."
                            },
                            {
                                "example_id": "aca71b80-6ab9-48d7-9b28-773b71b0e8c5",
                                "sense_id": "42f4b342-422a-3b95-bb7d-a92cb3069744",
                                "text": "La belle Lagide, Cléopâtre."
                            }
                        ]
                    }
                ],
