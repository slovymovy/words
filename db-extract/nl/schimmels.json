                    },
                    {
                        "translation_id": "de0fc386-31a0-4b22-be64-3f00eb5c7d67",
                        "source_entry_id": "734453b1-8d8d-3236-824b-11f68d92a5d6",
                        "source_sense_id": "9c6f1dad-8f04-3ae9-a7e0-6de952ce3cc7",
                        "source_sense_description": "rijk binnen de eukaryoten, Fungi",
                        "target_lang_word": "гриб",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "гриб",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "cce5e63d-dd7c-3d71-b615-3a6668b2886e",
                                        "entry_id": "068fb1fb-eba2-3ad9-ac40-a4d332251c65",
                                        "glosses": [
                                            "биол. организм [2], относящийся к грибам [1] или [2]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9939ba07-a977-4c69-977a-374ed61de9ea",
                                                "sense_id": "cce5e63d-dd7c-3d71-b615-3a6668b2886e",
                                                "text": "Споры белого гриба."
                                            },
                                            {
                                                "example_id": "34baf35b-f424-424c-870a-a12c4fbf2243",
                                                "sense_id": "cce5e63d-dd7c-3d71-b615-3a6668b2886e",
                                                "text": "Фитофтора — паразитический гриб, поражающий многие сельскохозяйственные растения."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1b97f8c-eb02-3bee-93be-0d9315b584ab",
                                        "entry_id": "068fb1fb-eba2-3ad9-ac40-a4d332251c65",
                                        "glosses": [
                                            "плодовое тело некоторых грибов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36d0804b-080e-4ad0-80e4-3afb0698a946",
                                                "sense_id": "f1b97f8c-eb02-3bee-93be-0d9315b584ab",
                                                "text": "Грибы произрастают в необыкновенном количестве; сжаренные в сметане представляют приятную .. пищу."
                                            },
                                            {
                                                "example_id": "70b6d033-7ee7-4db1-88cb-79e736d56696",
                                                "sense_id": "f1b97f8c-eb02-3bee-93be-0d9315b584ab",
                                                "text": "Грибов тут мало; за грибами надо идти в березняк, и я собираюсь отправиться."
                                            },
                                            {
                                                "example_id": "bf5fb2ae-90b4-4602-9253-a462c7811a63",
                                                "sense_id": "f1b97f8c-eb02-3bee-93be-0d9315b584ab",
                                                "text": "Грибов набрали целую корзинку, даже Лили нашла берёзовый гриб."
                                            },
                                            {
                                                "example_id": "5909c302-df8b-4475-9cc4-fca3545e0dda",
                                                "sense_id": "f1b97f8c-eb02-3bee-93be-0d9315b584ab",
                                                "text": "Однажды я гриб в лесу увидел. Смотрю, под самой берёзой стоит боровик."
                                            },
                                            {
                                                "example_id": "27ceebff-c11a-4452-b9bf-12ada844fbc6",
                                                "sense_id": "f1b97f8c-eb02-3bee-93be-0d9315b584ab",
                                                "text": "Когда вы собираете грибы, то далеко не всё равно, все ли их класть в корзину или избегать червивых и ядовитых."
                                            },
                                            {
                                                "example_id": "50314844-ba44-48f4-bb98-8890be7da99d",
                                                "sense_id": "f1b97f8c-eb02-3bee-93be-0d9315b584ab",
                                                "text": "Если завтра с утра будет хорошая погода, мы с вами пойдём в лес за грибами."
                                            },
                                            {
                                                "example_id": "16c7cf54-bc93-4868-8d14-d0172e8de48c",
                                                "sense_id": "f1b97f8c-eb02-3bee-93be-0d9315b584ab",
