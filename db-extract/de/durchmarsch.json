                "senses": [
                    {
                        "sense_id": "52f7b87a-0d9e-38d9-8927-beccec5c1b55",
                        "entry_id": "ccfac5d2-2a1f-327b-b9ed-5a2a537e18a0",
                        "glosses": [
                            "der nahezu unbehinderte Marsch durch ein Gebiet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef0a4306-38e0-44dc-b294-5d67212d62a2",
                                "sense_id": "52f7b87a-0d9e-38d9-8927-beccec5c1b55",
                                "text": "„Es waren diese zermürbenden Guerillaattacken, die den Elan der Konquistadoren stoppten und den geplanten Durchmarsch nach Norden verhinderten.“"
                            },
                            {
                                "example_id": "8f1254c5-db79-4993-a322-f2dfc6227ce0",
                                "sense_id": "52f7b87a-0d9e-38d9-8927-beccec5c1b55",
                                "text": "„Der Durchmarsch unserer Truppen durch Moskau hatte um zwei Uhr nachts begonnen und dauerte bis zwei Uhr nachmittags; die letzten flüchtenden Einwohner und Verwundeten schlossen sich den Kolonnen an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7337f4a1-4fae-34b6-b4d3-50631e12cfb8",
                        "entry_id": "ccfac5d2-2a1f-327b-b9ed-5a2a537e18a0",
