                    {
                        "sense_id": "3dbf344b-514a-3a1c-b424-c439987d5861",
                        "entry_id": "237714a4-878a-323b-8579-99a3c3c88165",
                        "glosses": [
                            "zróżnicowanie życia na wszelkich poziomach jego organizacji w przyrodzie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8461361-6726-4931-a19b-8ae2563b068e",
                                "sense_id": "3dbf344b-514a-3a1c-b424-c439987d5861",
                                "text": "Bioróżnorodność ma podstawowe znaczenie dla ewolucji."
                            },
                            {
                                "example_id": "306cad81-a6e2-4528-9189-0145e1b61390",
                                "sense_id": "3dbf344b-514a-3a1c-b424-c439987d5861",
                                "text": "Niewiele osób zdaje sobie zapewne sprawę, że koszenie trawnika i usuwanie chwastów szkodzi bioróżnorodności."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
