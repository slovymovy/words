                ],
                "senses": [
                    {
                        "sense_id": "364e91aa-e010-391b-a285-9c69b0d1b5d0",
                        "entry_id": "ac559360-e75d-3b83-99f3-61790d124ccb",
                        "glosses": [
                            "Träne, die beim (sehr starken) Lachen vergossen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c61f633b-5535-4e58-9940-fb3079becd75",
                                "sense_id": "364e91aa-e010-391b-a285-9c69b0d1b5d0",
                                "text": "„Manchmal droht die unfreiwillige Komik so heftig zu werden, daß Lachtränen den Blick trüben für die Aufsätze des Buches, die nun wirklich lesenswert sind […]“"
                            },
                            {
                                "example_id": "1419d7f2-9b9e-4354-860a-d79c7c6141bb",
                                "sense_id": "364e91aa-e010-391b-a285-9c69b0d1b5d0",
                                "text": "„Da gab es am Montag bei der Gastspielpremiere am Blickfelder-Festival keinen Zuschauer, der nicht zwischendurch eine Lachträne verdrückt hätte und am Schluss auch ein paar Zähren ganz ohne Lachen.“"
                            },
                            {
                                "example_id": "8bc8c37c-c313-489e-940f-c3e61c5767b7",
                                "sense_id": "364e91aa-e010-391b-a285-9c69b0d1b5d0",
                                "text": "„Wir kugelten uns, Lachtränen rollten meine Wangen hinunter.“"
                            },
                            {
                                "example_id": "93fed83a-9043-482f-b83a-4651fb8beae9",
                                "sense_id": "364e91aa-e010-391b-a285-9c69b0d1b5d0",
                                "text": "„Keuchend richtete ich mich halb auf, wischte mir die Lachtränen ab und sah in Bens funkelnde braune Augen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
