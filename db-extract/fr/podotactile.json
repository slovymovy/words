                "senses": [
                    {
                        "sense_id": "88367c82-ffd0-3435-a96d-ce1c68caf928",
                        "entry_id": "d0ff5d3e-7ee0-36c6-a7e6-82b643b9301e",
                        "glosses": [
                            "Qui présente une texture, un relief reconnaissable au toucher, par les pieds, au travers de chaussures ou à l’aide d’une canne blanche, afin de guider des individus atteints d’une déficience visuelle."
                        ],
                        "tags": [
                            "Urbanisme"
                        ],
                        "examples": [
                            {
                                "example_id": "b04ab2d7-ab3d-4534-81c6-b4693fc6ebe5",
                                "sense_id": "88367c82-ffd0-3435-a96d-ce1c68caf928",
                                "text": "Ainsi, les quais seront abaissés et rendus accessibles aux personnes à mobilité réduite (rampes d’accès, bandes podotactiles, …)."
                            },
                            {
                                "example_id": "5da54889-7184-4380-b610-7b6311070403",
                                "sense_id": "88367c82-ffd0-3435-a96d-ce1c68caf928",
                                "text": "Du côté de la place Chauderon, le guidage au sol par bandes podotactiles se développe également en connectant le réseau existant à l’administration communale et à la bibliothèque."
                            }
                        ]
                    }
                ],
