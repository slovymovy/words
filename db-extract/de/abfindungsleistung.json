                "senses": [
                    {
                        "sense_id": "1eb5e5e4-bb5a-340e-bbcc-12724cbcccbd",
                        "entry_id": "61b02c0e-ed75-36e1-aa00-8940ddcc7c70",
                        "glosses": [
                            "Leistung in Form einer Abfindung"
