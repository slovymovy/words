            {
                "entry_id": "a738fa96-8164-332c-97cf-47f5e09d06ab",
                "word": "lanolin",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "b60ef570-f7c3-47ed-ac4b-f582908ba060",
                        "entry_id": "a738fa96-8164-332c-97cf-47f5e09d06ab",
                        "tags": [
                            "plural"
                        ],
                        "form": "lanolins"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "023f589a-f3fb-3fe6-aa77-c36dd700398c",
                        "entry_id": "a738fa96-8164-332c-97cf-47f5e09d06ab",
                        "glosses": [
                            "A greasy yellow substance chemically akin to wax that is secreted from wooly animals, with a variety of uses from rust prevention, lubrication and waterproofing to cosmetics and skin ointments."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "9e324cf8-a784-4c18-a530-578993683883",
                                "sense_id": "023f589a-f3fb-3fe6-aa77-c36dd700398c",
                                "text": "She was sitting cross-legged on the floor with a tray of leather-bound books in front of her; she was rubbing lanolin into their covers […] ‘Look at these lovely old editions,’ she said, showing me a couple of small tan books, their bindings still glossy and moist from the lanolin, like newly exposed conkers."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "98aca45e-c97d-4e09-8c83-e6dc086a0a17",
                        "source_entry_id": "a738fa96-8164-332c-97cf-47f5e09d06ab",
                        "source_sense_id": "023f589a-f3fb-3fe6-aa77-c36dd700398c",
                        "source_sense_description": "greasy yellow substance",
                        "target_lang_word": "lanoline",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lanoline",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "26dabee6-d9c5-3606-861b-cb89f27d2889",
                                        "entry_id": "14ab0878-75a8-3532-b2ec-809e2b99746f",
                                        "glosses": [
                                            "Matière grasse issue du suint de la laine."
                                        ],
                                        "tags": [
                                            "Cosmétologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e2e5646-e731-461d-8c77-d3a7b1ead666",
                                                "sense_id": "26dabee6-d9c5-3606-861b-cb89f27d2889",
                                                "text": "Cette suintine épurée, débarrassée des acides gras, des savons et neutralisée, donne un sous-produit appelé la lanoline qui est employée en pharmacie et dans l'industrie."
                                            },
                                            {
                                                "example_id": "b699821c-d749-4a3c-97fa-ade696281175",
                                                "sense_id": "26dabee6-d9c5-3606-861b-cb89f27d2889",
                                                "text": "La vaseline est la base la plus courante des pommades : on la rend plus adhésive en l'additionnant de lanoline […] qui absorbe plusieurs fois son poids d'eau."
                                            },
                                            {
                                                "example_id": "adee6f82-9753-482d-8e76-bf4fcd715871",
                                                "sense_id": "26dabee6-d9c5-3606-861b-cb89f27d2889",
                                                "text": "Solution alternative peu usitée, les langes en laine – pléonasme étymologique – matière riche en lanoline, avaient la propriété de supporter l’urine, qui se combinait avec la lanoline pour tuer les bactéries & neutraliser l’ammoniaque."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
