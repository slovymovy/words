                                        "entry_id": "eabf3048-81f0-3e6f-a49c-6e698bf4eb96",
                                        "glosses": [
                                            "An act or instance of making something larger."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c33a0c6-4608-43cb-9737-dd21789e9c33",
                                                "sense_id": "890e8a75-bcd3-3199-93a9-57985bd4b027",
                                                "text": "Rick was ashamed about the size of his penis, so he had a penis enlargement."
                                            }
