                                "target_senses": [
                                    {
                                        "sense_id": "32b56ac0-d355-3381-ab65-f5f17d313517",
                                        "entry_id": "2c8a5775-36a2-31c5-81ef-100cf2417bd2",
                                        "glosses": [
                                            "Pâte frite à la poêle et qui enveloppe ordinairement une tranche de quelque fruit."
                                        ],
                                        "tags": [
                                            "Pâtisserie"
                                        ],
                                        "note": "Ce terme est généralement utilisé au pluriel. → voir bougnette",
                                        "examples": [
                                            {
                                                "example_id": "b75d0044-48d4-42a1-a51f-9f4ead5e90b5",
                                                "sense_id": "32b56ac0-d355-3381-ab65-f5f17d313517",
                                                "text": "Quand les beignets sont bien montés et de belle couleur, retirez-les pour les égoutter et saupoudrez-les de sucre fin."
                                            },
                                            {
                                                "example_id": "3ab4b2e2-d589-4863-9482-01ef2dbc831d",
                                                "sense_id": "32b56ac0-d355-3381-ab65-f5f17d313517",
                                                "text": "La prochaine fois, on pourra aussi essayer les tempuras, ce sont des beignets."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
