                    },
                    {
                        "translation_id": "d1556b98-8629-4119-95e4-bbc5a3744cea",
                        "source_entry_id": "104fb50b-3238-33f2-a5ed-5be1f0472798",
                        "source_sense_description": "поубивать",
                        "target_lang_word": "abmurksen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abmurksen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2110f97f-641b-39d2-bff8-a207a2176925",
                                        "entry_id": "2d672fbe-f1c3-3de3-a8c1-1301f9d1791e",
                                        "glosses": [
                                            "einer Person oder einem Tier das Leben nehmen"
                                        ],
                                        "tags": [
                                            "casual",
                                            "colloquial",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "084e5c03-e0c8-4740-a02b-99d232554e6a",
                                                "sense_id": "2110f97f-641b-39d2-bff8-a207a2176925",
                                                "text": "„Immer, wenn ein Spatz gegen ein Fenster geprallt war, drückte ich mit dem Besen dagegen und murkste ihn ab.“"
                                            },
                                            {
                                                "example_id": "bfa701ee-7d5e-4ec3-ba01-3dc88313e363",
                                                "sense_id": "2110f97f-641b-39d2-bff8-a207a2176925",
                                                "text": "„Vor Jahren drohte Putin, er werde alle tschetschenischen ‚Terroristen auf der Latrine abmurksen‘.“"
                                            },
                                            {
                                                "example_id": "bdd89962-be33-4c74-b3ca-42231f96868a",
                                                "sense_id": "2110f97f-641b-39d2-bff8-a207a2176925",
                                                "text": "„Na ja, das war jedenfalls das erste Mal, dass sie jemand abgemurkst hatten, aber danach kamen noch viele.“"
                                            },
                                            {
                                                "example_id": "31d6e4e0-477c-4089-ae9e-d206f8339f97",
                                                "sense_id": "2110f97f-641b-39d2-bff8-a207a2176925",
                                                "text": "„Er musste den Kleinen abmurksen und dafür sorgen, dass er an den Fersen baumelte, ehe sie die Endstation erreichten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
