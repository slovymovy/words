                                        "sense_id": "9d6a5ab1-3ac2-3d84-9e13-a9dc3e8c5b7f",
                                        "entry_id": "82965e51-91f8-3bb3-8b20-891b565a1174",
                                        "glosses": [
                                            "Jeu qui se joue avec un trictrac (dans ce cas, le mot français dérivé est jacquet)."
