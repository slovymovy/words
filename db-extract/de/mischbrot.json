                                "target_senses": [
                                    {
                                        "sense_id": "e93b98ad-8548-3607-8459-439bbc42f717",
                                        "entry_id": "7d76e03a-8e1e-3123-9236-3891c6fd1939",
                                        "glosses": [
                                            "dead"
                                        ],
                                        "tags": [
