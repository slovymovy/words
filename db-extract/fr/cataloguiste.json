                "senses": [
                    {
                        "sense_id": "82ab2217-10d7-3a49-a50c-416d73d90ee2",
                        "entry_id": "7e12d276-2b87-3c04-8c2d-35d24a30df3f",
                        "glosses": [
                            "Entreprise de vente à distance par le biais de catalogues."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68ecbecb-3d90-4c3d-bb8b-d769c43c41e3",
                                "sense_id": "82ab2217-10d7-3a49-a50c-416d73d90ee2",
                                "text": "L’heure est au (grand) changement pour les 3 Suisses. Le vénérable cataloguiste était ces dernières années surtout évoqué pour ses difficultés, quand son concurrent historique La Redoute opérait son retour en grâce."
                            },
                            {
                                "example_id": "4595fdb2-8d03-4688-8a49-14d599439bee",
                                "sense_id": "82ab2217-10d7-3a49-a50c-416d73d90ee2",
                                "text": "RS Components est un cataloguiste qui propose plus de 500 000 références de composants électroniques, d’automatismes, d’équipements, d’appareils de tests et mesure, d’outillages et de fournitures industrielles."
                            }
                        ]
                    },
                    {
                        "sense_id": "d7ee8738-09ef-3592-ab83-f1f2b7bfb4d3",
                        "entry_id": "7e12d276-2b87-3c04-8c2d-35d24a30df3f",
                        "glosses": [
                            "Personne chargée de créer un catalogue commercial destiné à la promotion et à la vente de produits."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57d88d16-4fff-43e7-a37c-eece08ead4a3",
                                "sense_id": "d7ee8738-09ef-3592-ab83-f1f2b7bfb4d3",
                                "text": "De retour à Paris, il trouve très vite un emploi de cataloguiste aux Éditions Crès, 116 boulevard Saint-Germain."
                            }
                        ]
                    },
                    {
                        "sense_id": "864a090d-4218-38ca-9452-a898de091e72",
                        "entry_id": "7e12d276-2b87-3c04-8c2d-35d24a30df3f",
                        "glosses": [
                            "Catalogueur, personne qui dresse des catalogues, des listes sur un thème particulier (œuvres musicales, œuvres littéraires, objets, faits, etc.)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "853d0630-4104-4b48-aad2-890c54aa9f6b",
                                "sense_id": "864a090d-4218-38ca-9452-a898de091e72",
                                "text": "Une hypothèse de travail judicieuse à propos de la pratique du cataloguiste serait la suivante ; lorsqu’une référence est répertoriée par le cataloguiste sans recours à un titre en tête de manuscrit ou en tête d’une liasse de papiers, on utilise le français, lorsqu’un titre apparaît en tête de manuscrit, il est reporté directement dans le catalogue dans sa langue d’origine."
                            }
                        ]
                    }
