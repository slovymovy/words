                "senses": [
                    {
                        "sense_id": "5650af88-1d8d-3d83-8759-384b67670286",
                        "entry_id": "dfb85b8e-4392-3bf4-bb23-9319997248aa",
                        "glosses": [
                            "Wahrnehmung von Geruch in der Luft, der von Torf stammt; verbale Zuordnung nach Feuchtigkeit oder brennend/glimmend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3071c9a4-65f5-43ab-b50a-061b16034281",
                                "sense_id": "5650af88-1d8d-3d83-8759-384b67670286",
                                "text": "„Ich sehnte mich nach Torfgeruch, Nach deutschem Tabaksdampfe; Es bebte mein Fuß vor Ungeduld, Daß er deutschen Boden stampfe.“"
                            },
                            {
                                "example_id": "f8187ae3-79d1-4d21-974a-2da1b0553b6e",
                                "sense_id": "5650af88-1d8d-3d83-8759-384b67670286",
                                "text": "„Die goldenen Malts bestechen mit Toffeenoten wobei der leichte Torfgeruch auch im Geschmack erhalten bleibt.“"
                            },
                            {
                                "example_id": "ee0b2a4f-7292-4f1c-9390-e8aab9997444",
                                "sense_id": "5650af88-1d8d-3d83-8759-384b67670286",
                                "text": "„Sie mögen das Ambiente, Dudelsäcke, Kilts, karge Hügel, Hochmoor und Torfgeruch, sie prosten mit \"Slainte!\".“"
                            },
                            {
                                "example_id": "1b2a018d-821c-4275-acd5-d1b990b89dca",
                                "sense_id": "5650af88-1d8d-3d83-8759-384b67670286",
                                "text": "„Schon beim Entkorken der Flasche strömt uns ein angenehmer salziger Torfgeruch in die Nase.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
