                                "target_lang_sense_clarification": "naturaleza o paisaje"
                            },
                            {
                                "target_lang_word": "virgen",
                                "target_lang_sense_clarification": "terreno no perturbado"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "sauvage",
                                "target_lang_sense_clarification": "nature/paysage"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1e8b2803-f7e2-3285-8993-441c6b7d6809",
                    "sense_definition": "Очень сильный, чрезмерный, превышающий обычную меру (о чувствах, состояниях).",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "figurative_intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "От этой новости он пришёл в <дикий> восторг.",
                            "target_lang_translations": {
                                "en": "He went into <wild> delight at this news.",
                                "es": "Esta noticia le provocó un <entusiasmo desenfrenado>.",
                                "fr": "Cette nouvelle l'a plongé dans un enthousiasme <fou>."
                            }
                        },
                        {
                            "text": "У меня сегодня просто <дикая> усталость после работы.",
                            "target_lang_translations": {
                                "en": "I have simply <terrible> fatigue after work today.",
                                "es": "Hoy tengo un cansancio <tremendo> después del trabajo.",
                                "fr": "Aujourd'hui, j'ai une fatigue tout simplement <terrible> après le travail."
                            }
                        }
                    ],
                    "synonyms": [
                        "ужасный",
                        "необузданный"
                    ],
                    "common_phrases": [
                        "дикий восторг",
                        "дикий крик",
                        "дикая жара",
                        "дикая боль",
                        "дикий страх"
