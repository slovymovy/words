                    {
                        "translation_id": "ca54bcd0-d753-4a82-9060-ccb3ba357233",
                        "source_entry_id": "fae969c6-8b99-3364-a215-dfcd23c8259a",
                        "source_sense_id": "b543b914-97c3-3640-a4db-678a324a756e",
                        "source_sense_description": "gehoben: Autorin/Schriftstellerin, die Romane verfasst",
                        "target_lang_word": "romancière",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "romancière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d46aeb9d-b32a-30a1-a44c-39079c43074a",
                                        "entry_id": "0f3f0032-b30b-3215-bf57-eb898b6d538c",
                                        "glosses": [
                                            "Autrice qui écrit des romans."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "258140bc-592d-4838-bc28-975302e6e772",
                                                "sense_id": "d46aeb9d-b32a-30a1-a44c-39079c43074a",
                                                "text": "Mademoiselle de Scudéri était la grande romancière du temps, et jouissait d’une réputation fabuleuse"
                                            },
                                            {
                                                "example_id": "c5d280b2-f811-496e-bcc4-e081e9e52da3",
                                                "sense_id": "d46aeb9d-b32a-30a1-a44c-39079c43074a",
                                                "text": "C’est ainsi que la romancière interprète désormais la conception du roman qu’elle doit à Lukàcs, classique pour sa peinture de la vie privée, classique aussi pour son enchevêtrement avec la représentation du monde politique et social contemporain."
                                            },
                                            {
                                                "example_id": "f90f9adc-6658-4316-b7df-82b64f5a62db",
                                                "sense_id": "d46aeb9d-b32a-30a1-a44c-39079c43074a",
                                                "text": "Elle m’avait fait découvrir des romancières anglaises contemporaines que j’appréciais presque autant que Daphné Du Maurier : Penelope Lively, Rose Tremain, Joanna Trollope, A. S. Byatt."
                                            }
                                        ]
                                    }
                                ]
                            },
