                    }
                ],
                "senses": [
                    {
                        "sense_id": "11b8abf4-3107-31e7-ae92-6b99bcb588bb",
                        "entry_id": "8fe01ec7-6d03-32ef-bb54-1037a9386520",
                        "glosses": [
                            "eine Echsenart innerhalb der Familie der Schleichen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55fd04d4-98fd-492d-b40b-d34f324bc916",
                                "sense_id": "11b8abf4-3107-31e7-ae92-6b99bcb588bb",
                                "text": "Die Blindschleiche wird oft für eine Schlange gehalten."
                            },
                            {
                                "example_id": "3c222709-77c8-43d1-87a5-025ae7941b48",
                                "sense_id": "11b8abf4-3107-31e7-ae92-6b99bcb588bb",
                                "text": "„Er zeigte mir eine Blindschleiche und erläuterte, dass sie nicht giftig sei.“"
                            },
                            {
                                "example_id": "2afc7eff-02bc-4519-854c-c7ea8fbd924a",
                                "sense_id": "11b8abf4-3107-31e7-ae92-6b99bcb588bb",
                                "text": "„Es gibt die Blindschleiche, die gar keine Schlange ist, sondern eine Echsenart aus der Familie der Schleichen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "320a4f6c-8151-4fea-a566-5f42a0306b33",
                        "source_entry_id": "8fe01ec7-6d03-32ef-bb54-1037a9386520",
                        "source_sense_id": "11b8abf4-3107-31e7-ae92-6b99bcb588bb",
                        "source_sense_description": "eine Echsenart innerhalb der Familie der Schleichen",
                        "target_lang_word": "slowworm",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "slowworm",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "50dddda5-5389-3438-a73d-7d7e7e28e1be",
                                        "entry_id": "7aa935a7-97cf-3a11-8fc5-150add7048de",
                                        "glosses": [
                                            "A small Old World lizard, Anguis fragilis, often mistaken for a snake, having no legs and small eyes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a15e5a44-ae83-4a84-b0dd-a31b20f02b90",
                                                "sense_id": "50dddda5-5389-3438-a73d-7d7e7e28e1be",
                                                "text": "Well, sir, it may be we shall have some better orations of it anon: well, Ile watch you as narrowly as ever you were watcht, and Ile play with you as the nightingale with the slowworme;[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6d4634a5-cb4f-4a92-8194-5b865208ebea",
                        "source_entry_id": "8fe01ec7-6d03-32ef-bb54-1037a9386520",
                        "source_sense_id": "11b8abf4-3107-31e7-ae92-6b99bcb588bb",
                        "source_sense_description": "eine Echsenart innerhalb der Familie der Schleichen",
                        "target_lang_word": "blindworm",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blindworm",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e807421b-4978-3a32-aa35-457550684f9e",
                                        "entry_id": "679e3164-88ae-3c37-9125-67dd963cde01",
                                        "glosses": [
                                            "Anguis fragilis (slowworm), a small species of legless lizard."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "afb6aa9b-6483-4939-ae06-368939160fdf",
                                                "sense_id": "e807421b-4978-3a32-aa35-457550684f9e",
                                                "text": "[…] we haue a blind worme to be found vnder logs in woods, and timber that hath lien long in a place, which some also doo call (and vpon better ground) by the name of [s]low worms, and they are knowen easilie by their more or lesse varietie of striped colours, drawen long waies from their heads, their whole bodies little excéeding a foot in length, & yet is there venem deadlie."
                                            },
                                            {
                                                "example_id": "fab31c0c-0778-4051-8346-8c3b616a4076",
                                                "sense_id": "e807421b-4978-3a32-aa35-457550684f9e",
                                                "text": "You spotted snakes with double tongue,\nThorny hedgehogs, be not seen;\nNewts and blind-worms, do no wrong,\nCome not near our fairy queen."
                                            },
                                            {
                                                "example_id": "50784ab3-a188-4404-bac1-190d13158e23",
                                                "sense_id": "e807421b-4978-3a32-aa35-457550684f9e",
                                                "text": "\"But I'll give you a bit of advice! Take a blindworm - I'll find you one - and ram it into the barrel of your gun and then fire it, after that you may try what powder and shot will do.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "538f0486-3f94-41df-86f0-a63016b54902",
                        "source_entry_id": "8fe01ec7-6d03-32ef-bb54-1037a9386520",
                        "source_sense_id": "11b8abf4-3107-31e7-ae92-6b99bcb588bb",
                        "source_sense_description": "eine Echsenart innerhalb der Familie der Schleichen",
                        "target_lang_word": "orvet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "orvet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dc008b91-1578-370a-b440-5523a9b95acb",
                                        "entry_id": "66d72771-980a-3b35-913b-d5df1abfb95e",
                                        "glosses": [
                                            "Espèce de lézard sans pattes, d’aspect semblable à un serpent, mais à paupières mobiles, et inoffensif."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a98dfa9d-c23c-4aeb-ba0b-a5be4d24040e",
                                                "sense_id": "dc008b91-1578-370a-b440-5523a9b95acb",
                                                "text": "L’orvet passe facilement inaperçu."
                                            },
                                            {
                                                "example_id": "933fc370-4096-432c-ba25-1685f6774341",
                                                "sense_id": "dc008b91-1578-370a-b440-5523a9b95acb",
                                                "text": "Cela grouillait, cela rampait, cela sifflait, cela s’élançait et se nouait hideusement. Il y avait des vipères portant la marque d’un fer de lance sur leur front écrasé, des cérastes aux protubérances menaçantes, des hydres verdâtres et visqueuses, des aspics aux crochets mobiles, des trigonocéphales jaunes, des orvets ou serpents de verre, des crotales au museau court, à la robe noirâtre, faisant sonner les osselets de leur queue ; des amphisbènes marchant en avant et en arrière ; des boas ouvrant leur large gueule capable d’engloutir le bœuf Apis ; des serpents aux yeux entourés de disques comme ceux des hiboux : le pavé de la salle en était couvert."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
