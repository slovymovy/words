                ],
                "translations": [
                    {
                        "translation_id": "db4969f2-1e23-4304-b7af-5b25af580695",
                        "source_entry_id": "09b4c953-6c41-35d1-9a60-1fef8a339c38",
                        "source_sense_id": "ac4504c3-d91c-3bda-9c33-e29a412176c0",
                        "target_lang_word": "phlegm",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "phlegm",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "17057365-4288-3dcc-ace5-645266daa6bf",
                                        "entry_id": "047e59fe-c0ab-328c-92fa-95c2ae06815f",
                                        "glosses": [
                                            "One of the four humors making up the body in ancient and mediaeval medicine; said to be cold and moist, and often identified with mucus."
                                        ],
                                        "tags": [
                                            "historical",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9fd5412b-453d-449c-b1b1-ffb713cea4be",
                                                "sense_id": "17057365-4288-3dcc-ace5-645266daa6bf",
                                                "text": "Each person's unique mixture of these substances determines his temperament: a predominance of blood gives a sanguine temperament; a predominance of phlegm makes one phlegmatic; yellow bile, bilious (or choleric); and black bile, melancholic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f0b48cb-231c-3085-86b7-7ec549b19b9b",
                                        "entry_id": "047e59fe-c0ab-328c-92fa-95c2ae06815f",
                                        "glosses": [
                                            "Viscid mucus produced by the body, later especially mucus expelled from the bronchial passages by coughing."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7272c6e6-3103-42bb-891c-0b08b07846df",
                                                "sense_id": "4f0b48cb-231c-3085-86b7-7ec549b19b9b",
                                                "text": "Even some members of the new bourgeoisie indulge in conspicuously boorish behavior, like hawking phlegm onto the pavement or picking their noses at business meetings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cad32b52-0a28-31a8-b841-4be38bbb0124",
                                        "entry_id": "047e59fe-c0ab-328c-92fa-95c2ae06815f",
                                        "glosses": [
                                            "A watery distillation, especially one obtained from plant matter; an aqueous solution."
                                        ],
                                        "tags": [
                                            "historical",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae850d3a-a7a3-408f-8ddd-9cfb4781595f",
                                                "sense_id": "cad32b52-0a28-31a8-b841-4be38bbb0124",
                                                "text": "The attempts made to analyse vegetable substances previous to 1720, merely produced their resolution into the supposed elements of the chemists of those days, namely, salts, Earths, phlegm, and sulphur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9531682-deae-38e6-b0ee-9f5cb3b1900b",
                                        "entry_id": "047e59fe-c0ab-328c-92fa-95c2ae06815f",
                                        "glosses": [
                                            "Calmness of temperament, composure; also seen negatively, sluggishness, indifference."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89beed40-1f95-4c0f-b665-e032cdee90ec",
                                                "sense_id": "f9531682-deae-38e6-b0ee-9f5cb3b1900b",
                                                "text": "Orloff's phlegm broke completely, and he snatched at the monocle as it dropped[.]"
                                            },
                                            {
                                                "example_id": "6b6ec911-918b-47ad-911d-9aa20f1dddad",
                                                "sense_id": "f9531682-deae-38e6-b0ee-9f5cb3b1900b",
                                                "text": "But Swedish Nazis also talked of the necessity of saving Sweden from Bolshevism, and with the menacing Berlin radio gnawing in their ears many Swedes lost their Scandinavian phlegm."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
