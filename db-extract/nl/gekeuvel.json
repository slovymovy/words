                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ebaac18-26a6-4937-8e1c-001223f187b0",
                                                "sense_id": "e46c4da4-05e0-3265-bc11-9d9a4d3c6b08",
                                                "text": "It'd be cool to meet up again soon and have a quick chat."
                                            },
                                            {
                                                "example_id": "8221fd30-6a19-4b61-8668-fc93aad4bf56",
                                                "sense_id": "e46c4da4-05e0-3265-bc11-9d9a4d3c6b08",
                                                "text": "Reg liked a chat about old times and we used to go and have a chinwag in the pub."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afe86062-2845-3b27-bee7-d4df0bb52a5f",
                                        "entry_id": "480364fc-459b-3ff7-8a46-9309be9b77a2",
