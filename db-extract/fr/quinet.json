                                "example_id": "96281dc1-9859-4e5c-9e76-0ad8180786a9",
                                "sense_id": "83a2e6c5-82b2-31e1-9885-6b663c25b670",
                                "text": "Dans certains combats, ce n’est pas seulement une lutte chorégraphiée, détaille Loïc Quinet."
                            },
                            {
                                "example_id": "1e3de13d-75c0-4ca1-a100-a26a96dde569",
                                "sense_id": "83a2e6c5-82b2-31e1-9885-6b663c25b670",
                                "text": "Delphine Geisler, qui travaille au lycée Edgar-Quinet de Bourg-en-Bresse (Ain), a envie de « tout envoyer balader »."
                            }
                        ]
                    }
