                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ancien : personnes d'expérience ou d'ancienneté",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les <w>anciens</w> de la compagnie ont accueilli les nouveaux."
