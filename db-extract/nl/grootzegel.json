                        "glosses": [
                            "zegel van een vorst of president dat de echtheid van een document of oorkonde waarborgt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da6622c5-175f-447a-9104-20aa21774e48",
                                "sense_id": "97ee20b2-b13e-3a16-bca5-312cb87bbfec",
                                "text": "Vroeger waren wetten pas geldig als het grootzegel van de vorst erop was aangebracht. Tegenwoordig wordt het alleen nog gebruikt voor de Akte van Abdicatie en voor adelsdiploma's, het bewijs dat iemand een adellijke titel mag voeren."
                            },
                            {
                                "example_id": "f5f1da98-3dd2-47c8-9ddb-b54fe61a6aab",
                                "sense_id": "97ee20b2-b13e-3a16-bca5-312cb87bbfec",
                                "text": "Voor het eerst heeft het Archief vastgelegd hoe de Akte van Abdicatie is gemaakt, inclusief de vervaardiging van het grootzegel."
                            },
                            {
                                "example_id": "2831a01a-8708-454b-9033-f1c740abe0b8",
                                "sense_id": "97ee20b2-b13e-3a16-bca5-312cb87bbfec",
                                "text": "De vogel is het nationale symbool van de Verenigde Staten. De American Eagle staat afgebeeld op het grootzegel van de president. Zo wordt het symbool onder meer gebruikt op het paspoort."
                            }
                        ]
                    }
