                                "example_id": "1d1311ba-2900-4227-aaf5-6cc9349e67f9",
                                "sense_id": "ffeae62c-b630-3612-aa0f-9318f14f2e79",
                                "text": "Он был честен, правдив, совершенно неспособен обманывать умышленно, лгать сознательно."
                            }
                        ]
                    }
                ],
                "translations": [
