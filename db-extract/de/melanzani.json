                            {
                                "example_id": "4e6208fd-b8bf-470b-8af8-05848f8d4c1f",
                                "sense_id": "3f6fc4e8-12ef-3075-866f-f639a95e2271",
                                "text": "Panier bitte die Melanzani!"
                            },
                            {
                                "example_id": "051b5247-b57b-4aac-b89b-6939235f8906",
                                "sense_id": "3f6fc4e8-12ef-3075-866f-f639a95e2271",
