                                        "entry_id": "a5f1d326-e160-3b74-a133-ea9544501e66",
                                        "glosses": [
                                            "město v Německu, hlavní město spolkové země Braniborsko"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dde4a66b-aa44-48e0-8415-c6c1ee460608",
                                                "sense_id": "017ab9ea-2e6b-3959-9554-0faf0b1a6298",
                                                "text": "Jak naložíme s Německem? Představitelé tří vítězných mocností o tom měli rokovat v Postupimi, jižně od Berlína."
                                            }
                                        ]
