                "senses": [
                    {
                        "sense_id": "2eefdf24-b4fc-3381-8fc0-b56442ef9e4d",
                        "entry_id": "7cc4ff80-fbb4-3e84-8d5a-6f5ecce0e066",
                        "glosses": [
                            "Any of several perennial herbaceous plants, of the genus Agrimonia, that have spikes of yellow flowers."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84dcba80-f33f-4aea-a908-61e9f50a2e7c",
                                "sense_id": "2eefdf24-b4fc-3381-8fc0-b56442ef9e4d",
                                "text": "I grant, my Pils are bitter, I, and costly; / But their effects are rare, Diuine, and holsome, […] / I grant, theres bitter Egrimony in vm, / And Antimony, I put mony in all still: / And it works preciously […]"
                            },
                            {
                                "example_id": "63ab4d55-020c-4083-b8ac-18e590cc3289",
                                "sense_id": "2eefdf24-b4fc-3381-8fc0-b56442ef9e4d",
                                "text": "So he put the four shoes in a graceful group on the turf and looked at them. And seeing them there among the grass and springing agrimony, it suddenly occurred to him that both pairs were exceedingly ugly to see."
                            }
                        ]
                    },
                    {
                        "sense_id": "84a8c1d4-8cb2-3aac-b361-87db2d011aed",
                        "entry_id": "7cc4ff80-fbb4-3e84-8d5a-6f5ecce0e066",
                        "glosses": [
                            "Any of several not closely related plants of a similar appearance."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
