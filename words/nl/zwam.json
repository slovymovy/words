{
    "word_family": [
        "zwammen",
        "gezwam",
        "zwamachtig",
        "zwamvormig"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5d3e53d0-24e6-3c3f-9fe3-134e1791dbe5",
                    "sense_definition": "een organisme dat bestaat uit een netwerk van schimmeldraden en vaak zichtbaar is als paddenstoel of schimmel",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "biologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In het vochtige bos groeide een grote bruine <w>zwam</w> op de stam van een oude eik.",
                            "target_lang_translations": {
                                "en": "In the damp forest, a large brown <w>fungus</w> grew on the trunk of an old oak tree."
                            }
                        },
                        {
                            "text": "Sommige soorten <w>zwammen</w> parasiteren op andere planten en kunnen schade aanrichten in de tuin.",
                            "target_lang_translations": {
                                "en": "Some types of <w>fungi</w> parasitize other plants and can cause damage in the garden."
                            }
                        }
                    ],
                    "synonyms": [
                        "paddenstoel",
                        "fungus",
                        "schimmel"
                    ],
                    "common_phrases": [
                        "eetbare zwam",
                        "giftige zwam"
                    ],
                    "target_lang_definitions": {
                        "en": "An organism consisting of a network of fungal threads, often visible as a mushroom or mold."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fungus",
                                "target_lang_sense_clarification": "biological organism"
                            },
                            {
                                "target_lang_word": "mushroom",
                                "target_lang_sense_clarification": "fruiting body of a fungus"
                            },
                            {
                                "target_lang_word": "toadstool",
                                "target_lang_sense_clarification": "often used for inedible or poisonous mushrooms"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1e9c9472-eed7-3322-ba3d-24791e6f304a",
                    "sense_definition": "een zacht en absorberend voorwerp of organisme dat water kan vasthouden",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "voorwerpen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de oude tekst werd beschreven hoe men een <w>zwam</w> gebruikte om het water te filtreren.",
                            "target_lang_translations": {
                                "en": "In the ancient text, it was described how a <w>sponge</w> was used to filter the water."
                            }
                        },
                        {
                            "text": "De natuurlijke <w>zwam</w> lag in de badkamer om water op te zuigen.",
                            "target_lang_translations": {
                                "en": "The natural <w>sponge</w> lay in the bathroom to soak up water."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "vroeger vaker gebruikt voor spons"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A soft and absorbent object or organism capable of holding water."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sponge",
                                "target_lang_sense_clarification": "absorbent material or organism"
                            },
                            {
                                "target_lang_word": "tinder",
                                "target_lang_sense_clarification": "specifically referring to tinder fungus used for fire"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fd8719c5-21c4-32b3-a580-514366e3992e",
                    "sense_definition": "eerste persoon enkelvoud tegenwoordige tijd van <w>zwammen</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>zwam</w> soms maar wat raak als ik de weg niet precies weet.",
                            "target_lang_translations": {
                                "en": "I sometimes just <w>babble</w> on when I don't know the way exactly."
                            }
                        },
                        {
                            "text": "Als ik zenuwachtig ben, <w>zwam</w> ik vaak over onbelangrijke dingen.",
                            "target_lang_translations": {
                                "en": "When I'm nervous, I often <w>ramble</w> about unimportant things."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informeel taalgebruik voor onzin praten"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "First person singular present tense of 'zwammen' (to talk nonsense)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "babble",
                                "target_lang_sense_clarification": "talking aimlessly"
                            },
                            {
                                "target_lang_word": "ramble",
                                "target_lang_sense_clarification": "talking at length without a clear point"
                            },
                            {
                                "target_lang_word": "talk rubbish",
                                "target_lang_sense_clarification": "saying things that are not true or sensible"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "87fcae7c-3f7a-3077-b835-8c123fde6ddb",
                    "sense_definition": "gebiedende wijs van <w>zwammen</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Zwam</w> niet zo en vertel me nu eindelijk de waarheid over wat er gebeurd is.",
                            "target_lang_translations": {
                                "en": "Don't <w>talk such rubbish</w> and finally tell me the truth about what happened."
                            }
                        },
                        {
                            "text": "Hou op met dat gedoe en <w>zwam</w> niet over zaken waar je niets van begrijpt.",
                            "target_lang_translations": {
                                "en": "Stop that nonsense and don't <w>babble</w> about things you don't understand at all."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informeel taalgebruik voor onzin praten"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Imperative mood of 'zwammen' (to talk nonsense)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stop babbling",
                                "target_lang_sense_clarification": "command to stop talking nonsense"
                            },
                            {
                                "target_lang_word": "don't talk rot",
                                "target_lang_sense_clarification": "informal command to stop saying silly things"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}