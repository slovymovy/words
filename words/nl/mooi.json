                {
                    "sense_id": "88bd6299-eb85-3236-8650-7e728eed8a53",
                    "sense_definition": "Prettig om te ervaren, van goede kwaliteit of gunstig.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "pleasant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is vandaag erg <w>mooi</w> weer om buiten te wandelen.",
                            "target_lang_translations": {
                                "en": "It is very <w>nice</w> weather today for walking outside.",
                                "ru": "Сегодня очень <w>хорошая</w> погода для прогулки.",
                                "pl": "Dzisiaj jest bardzo <w>ładna</w> pogoda na spacer na zewnątrz.",
                                "de": "Es ist heute sehr <w>schönes</w> Wetter, um draußen spazieren zu gehen.",
                                "fr": "Il fait très <w>beau</w> aujourd'hui pour se promener dehors.",
                                "it": "Oggi c'è un tempo davvero <w>bello</w> per fare una passeggiata all'aperto.",
                                "cs": "Dnes je velmi <w>pěkné</w> počasí na procházku venku.",
                                "tr": "Bugün dışarıda yürümek için çok <w>güzel</w> bir hava var.",
                                "es": "Hoy hace un tiempo muy <w>bueno</w> para pasear al aire libre."
                            }
                        },
                        {
                            "text": "Dat heb je goed gedaan, <w>mooi</w> werk!",
                            "target_lang_translations": {
                                "en": "You did that well, <w>nice</w> work!",
                                "ru": "Ты хорошо справился, <w>отличная</w> работа!",
                                "pl": "Dobrze to zrobiłeś, <w>dobra</w> robota!",
                                "de": "Das hast du gut gemacht, <w>gute</w> Arbeit!",
                                "fr": "Tu as bien fait cela, <w>joli</w> travail !",
                                "it": "Hai fatto un ottimo lavoro, <w>bel</w> lavoro!",
                                "cs": "To se ti povedlo, <w>dobrá</w> práce!",
                                "tr": "Bunu iyi yaptın, <w>harika</w> iş!",
                                "es": "¡Lo has hecho bien, <w>buen</w> trabajo!"
                            }
                        }
