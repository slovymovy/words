    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "b246395a-76f7-37bc-8aca-1486d808f8dd",
                "word": "skelp",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "21e882be-4668-485a-8ace-abf2080eb939",
                        "entry_id": "b246395a-76f7-37bc-8aca-1486d808f8dd",
                        "tags": [
                            "plural"
                        ],
                        "form": "skelps"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "989876d6-6dc0-38e9-b253-9224bc3d3016",
                        "entry_id": "b246395a-76f7-37bc-8aca-1486d808f8dd",
                        "glosses": [
                            "A blow; a smart stroke, especially with the hand; a smack."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb0c61fd-e4c6-411b-876e-c31ae769f1e9",
                                "sense_id": "989876d6-6dc0-38e9-b253-9224bc3d3016",
                                "text": "They came crack down on their bottoms with a loud skelp on the seats."
                            },
                            {
                                "example_id": "2a54fc57-879b-40b8-ad2a-9026b5faf129",
                                "sense_id": "989876d6-6dc0-38e9-b253-9224bc3d3016",
                                "text": "A skelp on the lug is not a very deadly assault. It is neither a stroke nor a blow."
                            }
                        ]
                    },
                    {
                        "sense_id": "4fe526a9-7098-3b06-95c9-6ade8f7c2df8",
                        "entry_id": "b246395a-76f7-37bc-8aca-1486d808f8dd",
                        "glosses": [
                            "A squall; a heavy fall of rain."
                        ],
                        "tags": [
                            "Scotland"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "ab420e12-c918-3c47-acbb-8f26df826da2",
                        "entry_id": "b246395a-76f7-37bc-8aca-1486d808f8dd",
                        "glosses": [
                            "A large portion."
                        ],
                        "tags": [
                            "Scotland"
                        ],
                        "examples": [
                            {
                                "example_id": "338c0503-f5aa-4047-afc8-748bc565909c",
                                "sense_id": "ab420e12-c918-3c47-acbb-8f26df826da2",
                                "text": "Great skelps of riotous colors followed each other across the window-framed screen, pounding upon bleak northern hearts as the surf pounds upon a rocky headland."
                            },
                            {
                                "example_id": "ec32aa02-64fa-4279-91fc-965d234d07e3",
                                "sense_id": "ab420e12-c918-3c47-acbb-8f26df826da2",
                                "text": "... great skelps of centuries together until they're almost in the same skin, growing into each other, shrinking to each other's sizes and shapes, speaking with one voice, clinging fast together, dying days or hours apart."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "a194dbe5-6e45-31d8-b039-b2b4894c394a",
                "word": "skelp",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "9a16e6ea-d23d-4d7f-b342-c627cfc6e009",
                        "entry_id": "a194dbe5-6e45-31d8-b039-b2b4894c394a",
                        "tags": [
                            "plural"
                        ],
                        "form": "skelps"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f3bbdef5-fdf6-32c4-9b54-64f3712d6571",
                        "entry_id": "a194dbe5-6e45-31d8-b039-b2b4894c394a",
                        "glosses": [
                            "A narrow strip of rolled or forged metal, ready to be bent and welded to form a pipe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4aae544d-6ddf-41e9-9087-cb33b1f30bed",
                                "sense_id": "f3bbdef5-fdf6-32c4-9b54-64f3712d6571",
                                "text": "[…] he then heats one half of the skelp at a time in an air furnace, or other fire, and having so heated it, he passes the skelp between a pair of grooved rollers placed at the mouth of the furnace, for the purpose of uniting (or marrying, as he terms it) the edges of the metal ; that is, causing the edges of the open part of the skelp to be pressed together, and made to adhere and form a complete cylinder."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "f89e4624-1575-3d7c-97f9-7b4e391085c8",
                "word": "skelp",
                "pos": "verb",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "97e4a9f3-7393-402e-97df-1f9d3826277e",
                        "entry_id": "f89e4624-1575-3d7c-97f9-7b4e391085c8",
                        "tags": [
                            "present",
                            "singular",
                            "third-person"
                        ],
                        "form": "skelps"
                    },
                    {
                        "form_id": "311184e0-b991-407d-b96f-eb094438c47f",
                        "entry_id": "f89e4624-1575-3d7c-97f9-7b4e391085c8",
                        "tags": [
