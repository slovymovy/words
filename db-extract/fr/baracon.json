                        "glosses": [
                            "Baraque élevée par les négriers sur la côte d’Afrique et en Louisiane."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96b7be23-cf66-486b-ac95-d9b6599a71d6",
                                "sense_id": "d88f87b3-8c3f-35a2-903f-8866a22457af",
                                "text": "Ils [les esclaves] étaient environ sept cents noirs des deux sexes, proprement logés dans de larges baracons, entretenus avec soin, nourris à leur convenance"
                            }
                        ]
                    }
                ],
