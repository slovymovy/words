                ],
                "senses": [
                    {
                        "sense_id": "e0bf7f06-d46a-37f8-b53b-741c9e3ed90c",
                        "entry_id": "f35f933a-659f-3218-ae03-f07c0f2a30e8",
                        "glosses": [
                            "Équipé d'un système de changement de vitesse, en parlant d’une bicyclette ou, par extension, d’un cycliste."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "eecce7b9-6493-4e7b-a790-19c454fcf95c",
                                "sense_id": "e0bf7f06-d46a-37f8-b53b-741c9e3ed90c",
                                "text": "En réalité, et pour remettre les choses au point, la bicyclette polymultipliée est un perfectionnement incontestable : la roue libre en est un autre ; et il n'existe absolument aucune raison de les mettre en opposition."
                            },
                            {
                                "example_id": "a73c2f81-c570-4dd5-a314-9d72a042109a",
                                "sense_id": "e0bf7f06-d46a-37f8-b53b-741c9e3ed90c",
                                "text": "La bicyclette de route sera polymultipliée ou ne sera pas."
                            },
                            {
                                "example_id": "f67382e8-8214-40d6-a7b8-a9c0cd84b9c9",
                                "sense_id": "e0bf7f06-d46a-37f8-b53b-741c9e3ed90c",
                                "text": "Donc dès que vous voyez qu'une averse menace de se prolonger, déployez votre pèlerine, enfliez vos houseaux, graissez les parties les plus exposées de votre machine, baissez d'un cran votre vitesse — car je suppose que voue êtes polymultiplié — si le vent souffle debout et roulez en opposant à la pluie le dédain le plus stoïque."
                            }
                        ]
                    }
                ],
