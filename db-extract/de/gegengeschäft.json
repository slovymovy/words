                "senses": [
                    {
                        "sense_id": "8836b837-d90d-3f64-88ca-7ba37236908b",
                        "entry_id": "30caa050-9253-3724-9df7-8424161c9b13",
                        "glosses": [
                            "Austausch von Gütern oder Leistung (Geschäft), der seine Begründung darin findet, dass es eine bereits vorhandene wirtschaftliche Beziehung gibt (in der der Partner zunächst einen monetären/finanziellen Gewinn machte und der Wunsch besteht, ebenfalls Vorteile zu erlangen; Zahlung in Form von Leistung statt durch Geld/Devisen)"
                        ],
                        "tags": [
                            "deshalb besonders"
                        ],
                        "examples": [
                            {
                                "example_id": "1c92de45-f9b0-4030-8679-b2a0e65dc87b",
                                "sense_id": "8836b837-d90d-3f64-88ca-7ba37236908b",
                                "text": "Ich habe Ihnen für die Abwasserreinigungsanlage eine ganze Menge bezahlt. Vielleicht können wir das Ganze über ein Gegengeschäft erträglicher gestalten?"
                            },
                            {
                                "example_id": "d7037cb3-329c-458f-83d2-f74e3a0703fe",
                                "sense_id": "8836b837-d90d-3f64-88ca-7ba37236908b",
                                "text": "„Wegen des chronischen Devisenmangels spielten Gegengeschäfte im Agrarhandel mit den MOE-Ländern seit jeher eine bedeutende Rolle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
