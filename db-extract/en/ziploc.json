                    {
                        "sense_id": "4976c394-5e85-3889-854c-4900932d406b",
                        "entry_id": "25ef5edb-7b03-3acf-add7-bbf2af66cfb8",
                        "glosses": [
                            "Any of a range of disposable, resealable storage bags that are fastened by a pair of interlocking plastic flanges."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d570c587-85b3-40d6-8723-831511d9176c",
                                "sense_id": "4976c394-5e85-3889-854c-4900932d406b",
                                "text": "Over the years I'd surrendered many vices, among them whiskey, cigarettes, and the various non-Newtonian drugs, but marijuana and I remained steadfast companions. I had one fragrant ounce of Humboldt County, California, in a Ziploc bag in the glove compartment of my car."
                            },
                            {
                                "example_id": "8e78b608-fc8e-44c5-bfd1-70338734cccf",
                                "sense_id": "4976c394-5e85-3889-854c-4900932d406b",
                                "text": "When she get what she wants / She puts the rest on a tray / In a zip-loc bag in the freezer."
                            },
                            {
                                "example_id": "d17d925d-cc20-466e-8fcc-fe6ec967d946",
                                "sense_id": "4976c394-5e85-3889-854c-4900932d406b",
                                "text": "I basically had all my different pieces of gear in individual Ziploc bags."
                            }
                        ]
                    }
