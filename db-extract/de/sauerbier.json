                ],
                "senses": [
                    {
                        "sense_id": "de7903ae-7ee9-3405-b22d-01dc6aaf6930",
                        "entry_id": "9d98bd8d-1397-3744-942e-913ba0340cea",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed20e8e3-aa3a-44d2-be01-bd05a9f8814a",
                                "sense_id": "de7903ae-7ee9-3405-b22d-01dc6aaf6930",
                                "text": "Frau Sauerbier ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "68af0849-6fe9-4d5e-b020-24e9fcfa50ba",
                                "sense_id": "de7903ae-7ee9-3405-b22d-01dc6aaf6930",
                                "text": "Herr Sauerbier wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "c322dc6d-8d4d-4ee9-b68e-e9909de0262c",
                                "sense_id": "de7903ae-7ee9-3405-b22d-01dc6aaf6930",
                                "text": "Die Sauerbiers fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "c279db04-b17f-4aeb-a81a-66fb488f2b66",
                                "sense_id": "de7903ae-7ee9-3405-b22d-01dc6aaf6930",
                                "text": "Der Sauerbier trägt nie die Schals, die die Sauerbier ihm strickt."
                            },
                            {
                                "example_id": "1b8ecb2e-437e-411e-a8a4-4afc9bafe72b",
                                "sense_id": "de7903ae-7ee9-3405-b22d-01dc6aaf6930",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Sauerbier kommt, geht der Herr Sauerbier.“"
                            },
                            {
                                "example_id": "30085f6b-2064-4209-a2f3-e7222ef00722",
                                "sense_id": "de7903ae-7ee9-3405-b22d-01dc6aaf6930",
                                "text": "Sauerbier kommt und geht."
                            },
                            {
                                "example_id": "abe4b8ef-e419-4bdd-a31b-a89e30b5c0a7",
                                "sense_id": "de7903ae-7ee9-3405-b22d-01dc6aaf6930",
                                "text": "Sauerbiers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
