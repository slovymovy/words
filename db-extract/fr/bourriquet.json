                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "3f8d7619-837c-3dd6-acca-6b06e3d815a8",
                        "entry_id": "2b8d48c3-c644-37d7-8408-40789fda7917",
                        "glosses": [
                            "Banc portant des tenailles."
                        ],
                        "tags": [
