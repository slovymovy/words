                "entry_id": "f918c6d7-d1a4-342d-99e8-1f2aa20e8a36",
                "word": "hommesse",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "644e45c2-614f-45d9-8269-be6d436e0b9e",
                        "entry_id": "f918c6d7-d1a4-342d-99e8-1f2aa20e8a36",
                        "tags": [
                            "plural"
                        ],
                        "form": "hommesses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4fa23500-a344-32a0-bcec-19d291d1a81f",
                        "entry_id": "f918c6d7-d1a4-342d-99e8-1f2aa20e8a36",
                        "glosses": [
                            "Femme tirée de la côte d’Adam dans le récit de la Genèse."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "b67654bb-e831-41b9-b891-9b96b19cad49",
                                "sense_id": "4fa23500-a344-32a0-bcec-19d291d1a81f",
                                "text": "Pour cette fois, c’est os de mes os et chair de ma chair ; elle s’appellera hommesse, parce qu’elle a été prise de l’homme. C’est pourquoi l’homme quittera son père et sa mère, et il s’attachera à sa femme, et les deux seront une même chair (Gen., 2, 23 et 24)."
                            },
                            {
                                "example_id": "066845e4-185d-4d7a-9071-e22e8d1ede97",
                                "sense_id": "4fa23500-a344-32a0-bcec-19d291d1a81f",
                                "text": "Au verset 2,23, lors de la nomination de la femme, la traduction du rabbinat français propose en note ‘hommesse’, un mot péjoratif en français, alors qu’en hébreu le féminin isha ne l’est pas. En latin, la Vulgate a gardé le jeu de mot en utilisant vir et virago, un mot également passé en français avec un sens péjoratif."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "97334546-f4a4-4772-bf2e-3f6f7c88a848",
                        "source_entry_id": "f918c6d7-d1a4-342d-99e8-1f2aa20e8a36",
                        "source_sense_id": "4fa23500-a344-32a0-bcec-19d291d1a81f",
                        "target_lang_word": "manželkou",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "manželkou",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "3ff74752-8300-3eb7-af42-ad295f4f38f7",
                                        "entry_id": "028761b0-1a26-3b27-842f-814283a07ab7",
                                        "glosses": [
                                            "instrumentál jednotného čísla podstatného jména manželka"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f030f186-8ee4-46d8-a37d-34b5c62c2534",
                                                "sense_id": "3ff74752-8300-3eb7-af42-ad295f4f38f7",
                                                "text": "S manželkou svou Marjánou z Hřivic měl syny Jáchyma a Jana."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8c32454e-a386-4390-b70a-921233888bfb",
                        "source_entry_id": "f918c6d7-d1a4-342d-99e8-1f2aa20e8a36",
                        "source_sense_id": "4fa23500-a344-32a0-bcec-19d291d1a81f",
                        "target_lang_word": "Männin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Männin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "378cf014-2059-3b91-9b63-0fc67b4c8af3",
                                        "entry_id": "467d55ec-691e-3aa8-8b96-39d7712ec694",
                                        "glosses": [
                                            "die Frau in ihrer Eigenschaft als Partnerin und Gefährtin des Mannes"
                                        ],
                                        "tags": [
                                            "biblisch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16232619-fe0c-4328-8957-432d84df3b1c",
                                                "sense_id": "378cf014-2059-3b91-9b63-0fc67b4c8af3",
                                                "text": "„Da sprach der Mensch: Das ist doch Bein von meinem Bein und Fleisch von meinem Fleisch; man wird sie Männin nennen, weil sie vom Manne genommen ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "565ab965-4ef1-3e58-845a-31a21f2e5e4b",
                                        "entry_id": "467d55ec-691e-3aa8-8b96-39d7712ec694",
                                        "glosses": [
                                            "Frau, die ein männliches oder heldenhaftes Auftreten hat; Mannweib"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "304b3a1d-1a63-41c9-a7f4-d0ba635735cb",
                                                "sense_id": "565ab965-4ef1-3e58-845a-31a21f2e5e4b",
                                                "text": "„Es ist daher wahrscheinlicher, daß die wilde Männin ihren Kriegszug im „bayerischen Rummel\" (1703) unternommen hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b6954f7f-a021-47a8-a0d8-ed5f15cb2095",
                        "source_entry_id": "f918c6d7-d1a4-342d-99e8-1f2aa20e8a36",
                        "source_sense_id": "4fa23500-a344-32a0-bcec-19d291d1a81f",
                        "target_lang_word": "woman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "woman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "77713d18-0d7d-3a01-b944-81c05084fdb7",
                                        "entry_id": "9989ccbe-cd48-3a52-8e4c-8d7f71ff7309",
                                        "glosses": [
                                            "An adult female human."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de6531a2-7b5f-4e67-8592-f574b250f5e0",
                                                "sense_id": "77713d18-0d7d-3a01-b944-81c05084fdb7",
                                                "text": "But this woman is a nice German woman that fell on the ice and sprained her ankle last winter, and we saw to her well as we could till she got better."
                                            },
                                            {
                                                "example_id": "64deb10c-9645-44b0-ae9a-12dfe539cd08",
                                                "sense_id": "77713d18-0d7d-3a01-b944-81c05084fdb7",
                                                "text": "Dr. J. H. Vincent, the great lecturer, says that a man's greatness consists in his courage; his inherent nobleness; his noble deeds, great exploits, and benefits to the world; but that behind every great man is a great woman - his mother."
                                            },
                                            {
                                                "example_id": "57714ae2-328a-4f12-8410-448320c83629",
                                                "sense_id": "77713d18-0d7d-3a01-b944-81c05084fdb7",
                                                "text": "Cause I'm every woman / It's all in me"
                                            },
                                            {
                                                "example_id": "736bd51f-2bd6-4e8c-88a0-166e1456696a",
                                                "sense_id": "77713d18-0d7d-3a01-b944-81c05084fdb7",
                                                "text": "During World War II, many women worked as blacksmiths in the shipbuilding industry and found they liked the challenging, independent work."
                                            },
                                            {
                                                "example_id": "128360d2-8600-4863-8d99-582dfb1b95a0",
                                                "sense_id": "77713d18-0d7d-3a01-b944-81c05084fdb7",
                                                "text": "But of course Britain since 1979 has had a woman prime minister, while no woman has ever come near to being president of the United States."
                                            },
                                            {
                                                "example_id": "e0469f64-24ec-4d79-8c41-934936117d3c",
                                                "sense_id": "77713d18-0d7d-3a01-b944-81c05084fdb7",
                                                "text": "\"There is nothing wrong with Melissa or the way she was raised. She is a sweet, kind, intelligent woman with a generous heart and more love for her child than you and Mother ever showed for either of your children.\""
                                            },
                                            {
                                                "example_id": "ffe708b4-77ad-4f13-9dda-fd2039ab26bc",
                                                "sense_id": "77713d18-0d7d-3a01-b944-81c05084fdb7",
                                                "text": "You can't spend months studying the history of the suffrage movement without gaining a new appreciation for the grit and gumption it takes to be a powerful woman leader."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b74eb44-9bf0-3ffd-a875-3fc914d0609a",
                                        "entry_id": "9989ccbe-cd48-3a52-8e4c-8d7f71ff7309",
                                        "glosses": [
                                            "All female humans collectively; womankind."
                                        ],
                                        "tags": [
                                            "collective"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d911e6eb-4b8e-4eee-8882-e8bddb7ca138",
                                                "sense_id": "1b74eb44-9bf0-3ffd-a875-3fc914d0609a",
                                                "text": "Listen, Holly. Thou art a good and honest man, and I fain would spare thee; but, oh! it is so hard for woman to be merciful."
                                            },
                                            {
                                                "example_id": "893308e2-2d82-4318-a40c-0969a134beba",
                                                "sense_id": "1b74eb44-9bf0-3ffd-a875-3fc914d0609a",
                                                "text": "“[…] it is not fair of you to bring against mankind double weapons ! Dangerous enough you are as woman alone, without bringing to your aid those gifts of mind suited to problems which men have been accustomed to arrogate to themselves.”"
                                            },
                                            {
                                                "example_id": "9b771937-808a-4fbb-b8a0-ac2b813f3d92",
                                                "sense_id": "1b74eb44-9bf0-3ffd-a875-3fc914d0609a",
                                                "text": "I am Woman, hear me roar / In numbers too big to ignore"
                                            },
                                            {
                                                "example_id": "0602cb65-daa2-4dbd-bb8d-4cad046bb915",
                                                "sense_id": "1b74eb44-9bf0-3ffd-a875-3fc914d0609a",
                                                "text": "For if modern woman is so intent on keeping her surname alive, why not demand it be passed along to her children?"
                                            },
                                            {
                                                "example_id": "5c8ad59e-849a-4eeb-a347-67c22ab77ced",
                                                "sense_id": "1b74eb44-9bf0-3ffd-a875-3fc914d0609a",
                                                "text": "Unsurprisingly, if modern man is a sort of camera, modern woman is a picture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "618f6000-b8d2-31ff-96f8-dc34a2cffd65",
                                        "entry_id": "9989ccbe-cd48-3a52-8e4c-8d7f71ff7309",
                                        "glosses": [
                                            "A female person, usually an adult: a (generally adult) female sentient being, whether human, supernatural, elf, alien, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3482664c-da61-4e25-a5db-ce659aa2ca4c",
                                                "sense_id": "618f6000-b8d2-31ff-96f8-dc34a2cffd65",
                                                "text": "Sir, have you ever served with any Bajoran women?"
                                            },
                                            {
                                                "example_id": "695befc1-dcc6-4f2f-abf4-4de6508aaa8d",
                                                "sense_id": "618f6000-b8d2-31ff-96f8-dc34a2cffd65",
                                                "text": "To be born a woman has been to be born, within an allotted and confined space, into the keeping of men."
                                            },
                                            {
                                                "example_id": "caf45478-59b1-4c52-9474-9ca267ea4237",
                                                "sense_id": "618f6000-b8d2-31ff-96f8-dc34a2cffd65",
                                                "text": "One of the elves, a woman with long auburn hair, was garbed identically to the two dwarves."
                                            },
                                            {
                                                "example_id": "e2c0e114-272d-4e1b-be5d-b3e36c4abde0",
                                                "sense_id": "618f6000-b8d2-31ff-96f8-dc34a2cffd65",
                                                "text": "Clearing a space between the tables, the men tested their prowess against one another with feats of wrestling and archery and bouts with quarterstaves. Two of the elves, a man and a woman, demonstrated their skill with swordplay—[…]"
                                            },
                                            {
                                                "example_id": "9741f2bb-f84c-481c-952f-384702c08396",
                                                "sense_id": "618f6000-b8d2-31ff-96f8-dc34a2cffd65",
                                                "text": "At the very dawn of religion, God was a woman."
                                            },
                                            {
                                                "example_id": "bb2369ae-1ba7-48b1-9a23-fbd434a985ea",
                                                "sense_id": "618f6000-b8d2-31ff-96f8-dc34a2cffd65",
                                                "text": "There was a pair of burly dwarves – a woman and a man – bearing the markings of the formidable Thane Guards."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94f21b78-4436-340b-befe-78a694f329c7",
                                        "entry_id": "9989ccbe-cd48-3a52-8e4c-8d7f71ff7309",
                                        "glosses": [
                                            "A wife (or sometimes a fiancée or girlfriend)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e62d979-2231-4334-bdee-e2551ceaae43",
                                                "sense_id": "94f21b78-4436-340b-befe-78a694f329c7",
                                                "text": "And then, when he lies with his woman, the man may concurrently be with God, and so get increase of his soul."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d65965e7-a1dd-3d25-84f0-42d98b91a9aa",
                                        "entry_id": "9989ccbe-cd48-3a52-8e4c-8d7f71ff7309",
                                        "glosses": [
                                            "A female person who is extremely fond of or devoted to a specified type of thing. (Used as the last element of a compound.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a0a723b-165c-46ef-81a7-f86eb9e72233",
                                                "sense_id": "d65965e7-a1dd-3d25-84f0-42d98b91a9aa",
                                                "text": "Perhaps my problem is that I am a cat woman. I can't imagine any finicky feline (and they all are that at one time or another) slobbering over anyone, even a beloved owner, the way a dog does."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ba6f18e-57cc-318b-bbf1-d4b0f75511dd",
                                        "entry_id": "9989ccbe-cd48-3a52-8e4c-8d7f71ff7309",
                                        "glosses": [
                                            "A female attendant or servant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8475a6fa-fb97-4108-a912-ec1584b7c1c2",
                                                "sense_id": "6ba6f18e-57cc-318b-bbf1-d4b0f75511dd",
                                                "text": "By her woman I sent your message."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "woman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9962ff80-1b6b-330c-8dcb-8e106b4d6acb",
                                        "entry_id": "f3d3c1c5-9310-3ab5-98a5-15f42dd7847a",
                                        "glosses": [
                                            "To staff with female labor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bdd79d3-a859-45a6-86be-9cb8c253fabb",
                                                "sense_id": "9962ff80-1b6b-330c-8dcb-8e106b4d6acb",
                                                "text": "[…]he should prove, from the testimony of the most experienced seamen, that the vessel was, if not, strictly speaking, sufficiently manned, yet that she was sufficiently manned and womanned. The Gypsey was a vessel of 43 tons burden, and there were on board two able seamen and the Captain’s wife, who was a very good sailor;"
                                            },
                                            {
                                                "example_id": "5a02250a-b904-4a42-9bb8-c9698a96d4fc",
                                                "sense_id": "9962ff80-1b6b-330c-8dcb-8e106b4d6acb",
                                                "text": "Apparently the Sixty-ninth Street office of Bagby Answers, Inc., was being womaned for the day from other offices."
                                            },
                                            {
                                                "example_id": "9c1d5beb-5d36-45ad-870d-f14ac8a26406",
                                                "sense_id": "9962ff80-1b6b-330c-8dcb-8e106b4d6acb",
                                                "text": "Gus Dinsmore, the public beach parking lot attendent,^([sic]) said he guessed that so many cars must be just stopped dead along the road that even those manned (or womaned) by able drivers would be unable to move."
                                            },
                                            {
                                                "example_id": "d57b0cf6-7700-462d-a9f0-21157dd65ac2",
                                                "sense_id": "9962ff80-1b6b-330c-8dcb-8e106b4d6acb",
                                                "text": "The information desk is now manned (womaned) by someone whose main job is to help you reserve time slots for the computers or guide you through the arduous process of “logging on.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56b75ff5-fb23-3587-928a-987fa04e9ee5",
                                        "entry_id": "f3d3c1c5-9310-3ab5-98a5-15f42dd7847a",
                                        "glosses": [
                                            "To make effeminate or womanish."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42df201f-8861-4f0c-b43e-e006f1defee3",
                                                "sense_id": "56b75ff5-fb23-3587-928a-987fa04e9ee5",
                                                "text": "I have felt so many quirks of joy and grief / That the first face of neither on the start / Can woman me unto't."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c609b589-8cf6-3534-9441-8034d0671b76",
                                        "entry_id": "f3d3c1c5-9310-3ab5-98a5-15f42dd7847a",
                                        "glosses": [
                                            "To furnish with, or unite to, a woman."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de6a2840-f863-424b-92a4-ca744f136989",
                                                "sense_id": "c609b589-8cf6-3534-9441-8034d0671b76",
                                                "text": "And think it no addition, nor my wish, / To have him see me woman'd."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3d06c20-4b4c-3690-937f-d0c44f9384f6",
                                        "entry_id": "f3d3c1c5-9310-3ab5-98a5-15f42dd7847a",
                                        "glosses": [
                                            "To call (a person) \\\"woman\\\" in a disrespectful fashion."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
