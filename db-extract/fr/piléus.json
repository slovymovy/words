                "entry_id": "929ba047-e225-3eb2-928b-d744290efb3b",
                "word": "piléus",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e4267203-7cb3-3c5b-abcd-f5502209c40f",
                        "entry_id": "929ba047-e225-3eb2-928b-d744290efb3b",
                        "glosses": [
                            "Bonnet de feutre dont se coiffaient les esclaves affranchis."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "2ffcf6f2-192c-331b-b5ba-3f366121f3c3",
                        "entry_id": "929ba047-e225-3eb2-928b-d744290efb3b",
                        "glosses": [
                            "Nuage annexe, en forme de bonnet ou de capuchon, qui se développe au-dessus du sommet d'un nuage convectif."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "3fae2cdc-26a3-3cc4-928f-b17d650c3b4c",
                        "entry_id": "929ba047-e225-3eb2-928b-d744290efb3b",
                        "glosses": [
                            "Nom scientifique du chapeau des champignons notamment chez les ascomycètes et les basidiomycètes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9faa7aa-3f59-4c23-ab50-cce96017114f",
                                "sense_id": "3fae2cdc-26a3-3cc4-928f-b17d650c3b4c",
                                "text": "Il me paraît probable que l’Amanita nobilis de Bolton (qui, autant que nous le sachions, n’a pas été retrouvée) n’est qu’une Amanita muscaria dont le bulbe s’est hypertrophié, et qui constitue à lui seul la volve, tandis que la vraie volve est restée attachée au piléus."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a68c516b-b77d-4559-83b6-7bdc02844cf0",
                        "source_entry_id": "929ba047-e225-3eb2-928b-d744290efb3b",
                        "source_sense_description": "coiffe antique",
                        "target_lang_word": "Pileus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "877d8cf8-289f-4b74-b92e-265ac07d23d9",
                        "source_entry_id": "929ba047-e225-3eb2-928b-d744290efb3b",
                        "source_sense_description": "coiffe antique",
                        "target_lang_word": "pileus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pileus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aebcffba-616c-31df-aeb2-c524ec4dcdee",
                                        "entry_id": "6924fd5b-ada5-3b5d-b8f1-ba5cfa6a84a9",
                                        "glosses": [
                                            "The cap of a mushroom."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d45bc34-42c7-4584-9217-4fc122a20fb4",
                                                "sense_id": "aebcffba-616c-31df-aeb2-c524ec4dcdee",
                                                "text": "The stem is easily separable from the pileus at its junction, in this respect being similar to Amanita, Amanitopsis, Lepiota and others."
                                            },
                                            {
                                                "example_id": "41687784-db4f-47be-82b5-c76f0f5e231a",
                                                "sense_id": "aebcffba-616c-31df-aeb2-c524ec4dcdee",
                                                "text": "One must check the size and shape of the pileus as well as its color. Many weird and unexpected shapes are found in the mushroom kingdom."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7bcca2c0-6f20-3796-b8ad-d2efb153c262",
                                        "entry_id": "6924fd5b-ada5-3b5d-b8f1-ba5cfa6a84a9",
                                        "glosses": [
                                            "The bell of a jellyfish."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "08198da1-eeb7-3590-9450-c7cad60e3777",
                                        "entry_id": "6924fd5b-ada5-3b5d-b8f1-ba5cfa6a84a9",
                                        "glosses": [
                                            "A small thin cloud attached to a cumulus cloud."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55bb0056-9bfa-4922-af22-b337fddaec71",
                                                "sense_id": "08198da1-eeb7-3590-9450-c7cad60e3777",
                                                "text": "The most short-lived of all the accessory clouds, pileus is also the most beautiful."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6f374b3-ae2e-387e-befc-a9e5ac4472fd",
                                        "entry_id": "6924fd5b-ada5-3b5d-b8f1-ba5cfa6a84a9",
                                        "glosses": [
                                            "A conical felt hat worn in Ancient Rome and Greece."
                                        ],
                                        "tags": [
                                            "Ancient-Rome",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87533565-e4c5-46c9-992f-9f027ed806cd",
                                                "sense_id": "e6f374b3-ae2e-387e-befc-a9e5ac4472fd",
                                                "text": "Among the Romans the cap of felt was the emblem of liberty. When a slave obtained his freedom he had his head shaved, and wore instead of his hair an undyed pileus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d27f663c-1eb4-3ac0-b8c8-c64b8d3bbd8a",
                                        "entry_id": "6924fd5b-ada5-3b5d-b8f1-ba5cfa6a84a9",
                                        "glosses": [
                                            "The top of the head of a bird, from the bill to the nape."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
