                ],
                "senses": [
                    {
                        "sense_id": "3fde4e2e-79c1-34a9-9fc6-8cd9b0a8cc73",
                        "entry_id": "3792672b-d4c6-3b4b-8329-583fb95c8e6e",
                        "glosses": [
                            "letzte Klasse am Gymnasium, insgesamt Klasse 13"
                        ],
                        "tags": [
                            "Germany",
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "01a27fb8-3085-4f8e-9c2c-1778ac43b77a",
                                "sense_id": "3fde4e2e-79c1-34a9-9fc6-8cd9b0a8cc73",
                                "text": "„Die ganze Schülerschaft von Sexta bis Oberprima machte sich gegen Abend auf den Weg, diese Tanne zu finden.“"
                            },
                            {
                                "example_id": "e658a3b4-e0da-4fff-ac0a-a85b2e0d52a5",
                                "sense_id": "3fde4e2e-79c1-34a9-9fc6-8cd9b0a8cc73",
                                "text": "„Roman direkt gegenüber, am Kopfe der Oberprima auf der anderen Seite, hatte sich die Speckrolle aufgebaut, mit quellendem, rötlichem Nackenwulst, das schmißgezeichnete, runde Gesicht von ekstatischer Begeisterung hingerissen.“"
                            },
                            {
                                "example_id": "97af04dd-b4bc-499d-a9c3-27c9a88af2a3",
                                "sense_id": "3fde4e2e-79c1-34a9-9fc6-8cd9b0a8cc73",
                                "text": "„Er versuchte nicht, es zu glätten, schimpfte auch nicht mit mir, aber von da an mußte ich immer draußen im Flur auf ihn warten, allein mit Scharnhorsts blutrotem Kragen und allein mit der Röte von Iphigenies Lippen, deren Bild neben der Oberprima hing, und es blieb mir nichts als die dunkelgraue Dunkelheit im Flur und hin und wieder ein Blick durch den Spion in die Oberprima.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
