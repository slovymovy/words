                "senses": [
                    {
                        "sense_id": "5b0da98a-404f-3dd9-998d-809013257602",
                        "entry_id": "1e9ed120-4fc4-35a4-9d11-eed2e71e0137",
                        "glosses": [
                            "Enlever ses bijoux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77363d61-d861-4a60-ba6d-8df4bb4c0c63",
                                "sense_id": "5b0da98a-404f-3dd9-998d-809013257602",
                                "text": "Une bonne cinquantaine de passagers doivent encore se débarrasser de leurs sacs, clés, bijoux, portables, se déchausser, se déceinturer, se débijouter, avant que ce soit notre tour."
                            },
                            {
                                "example_id": "f3a0641f-e834-4b22-bc73-72abe231a64a",
                                "sense_id": "5b0da98a-404f-3dd9-998d-809013257602",
                                "text": "Enrobée, bottée, bijoutée, parfumée, maquillée et le sac qui ne dépareille pas, c’est primordial. Non. Je me dérobe, débotte, débijoute, déparfume, démaquille et j’oublie le sac."
                            }
                        ]
                    }
                ],
