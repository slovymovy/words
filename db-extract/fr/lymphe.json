                                        "glosses": [
                                            "tekutina proudící cévními svazky rostlin"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6697ae6-199c-4233-8f3b-2cfd4a1c48d8",
                                                "sense_id": "85d96bef-4afc-31d4-8326-4c01828a1d29",
                                                "text": "Míza jarního času z navrtaného kmenu tekoucí (stává neb voda březová, březovice, březovník, čemeha), odporučovala se též dříve proti kamenu ledvinnému i močnímu a proti žloutenici."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce1d90b6-5f73-3b64-bfec-ae55fb7f4dc5",
