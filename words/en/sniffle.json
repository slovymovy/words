{
    "word_family": [
        "sniff",
        "sniffler"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "37c2e318-c4d0-373e-a2a0-299c0c1259d8",
                    "sense_definition": "The act or sound of breathing noisily through the nose, often due to a cold or allergies.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "nasal_sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I sometimes have a <w>sniffle</w> during the spring allergy season.",
                            "target_lang_translations": {
                                "tr": "Bahar alerjisi mevsiminde bazen <w>burnumu çekiyorum</w>.",
                                "cs": "Během jarní pylové sezóny občas <w>popotahuji</w>."
                            }
                        },
                        {
                            "text": "She tried to hide her <w>sniffle</w> during the quiet movie.",
                            "target_lang_translations": {
                                "tr": "Sessiz film sırasında <w>burun çekme</w> sesini gizlemeye çalıştı.",
                                "cs": "Během tichého filmu se snažila skrýt své <w>popotahování</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "sniff"
                    ],
                    "common_phrases": [
                        "have a sniffle"
                    ],
                    "target_lang_definitions": {
                        "tr": "Soğuk algınlığı veya alerji nedeniyle burundan sesli bir şekilde nefes alma eylemi veya sesi.",
                        "cs": "Projev nebo zvuk hlasitého dýchání nosem, často v důsledku nachlazení nebo alergií."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "burun çekme",
                                "target_lang_sense_clarification": "Burundan sesli nefes alma eylemi."
                            },
                            {
                                "target_lang_word": "hırıltı",
                                "target_lang_sense_clarification": "Burun tıkanıklığına bağlı çıkan ses."
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "popotahování",
                                "target_lang_sense_clarification": "Zvuk vznikající při vdechování nosem."
                            },
                            {
                                "target_lang_word": "posmrkávání",
                                "target_lang_sense_clarification": "Opakované popotahování nosem při rýmě."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7fda5305-a7b6-3405-8f49-bb071b5d850f",
                    "sense_definition": "To breathe noisily through the nose, often because of a cold or crying.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "nasal_sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her dad heard her <w>sniffling</w> and passed her a handkerchief.",
                            "target_lang_translations": {
                                "tr": "Babası onun <w>burnunu çektiğini</w> duydu ve ona bir mendil uzattı.",
                                "cs": "Její táta slyšel, jak <w>popotahuje</w>, a podal jí kapesník."
                            }
                        },
                        {
                            "text": "The child began to <w>sniffle</w> after falling down on the playground.",
                            "target_lang_translations": {
                                "tr": "Çocuk oyun parkında düştükten sonra <w>burnunu çekmeye</w> başladı.",
                                "cs": "Dítě začalo <w>popotahovat</w> poté, co na hřišti upadlo."
                            }
                        }
                    ],
                    "synonyms": [
                        "sniff"
                    ],
                    "target_lang_definitions": {
                        "tr": "Soğuk algınlığı veya ağlama nedeniyle burundan sesli bir şekilde nefes almak.",
                        "cs": "Hlasité dýchání nosem, často kvůli nachlazení nebo pláči."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "burnunu çekmek",
                                "target_lang_sense_clarification": "Burundan sesli nefes alma eylemi."
                            },
                            {
                                "target_lang_word": "hırıldamak",
                                "target_lang_sense_clarification": "Burun tıkanıklığı nedeniyle ses çıkarmak."
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "popotahovat",
                                "target_lang_sense_clarification": "Vydávat zvuk nosem při dýchání."
                            },
                            {
                                "target_lang_word": "posmrkávat",
                                "target_lang_sense_clarification": "Často popotahovat nosem, obvykle při rýmě."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f46599b9-828e-326f-bccf-a88ae4844883",
                    "sense_definition": "To say something while making a whimpering or sniffing sound.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "nasal_sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>sniffled</w> a pathetic apology while looking at the floor.",
                            "target_lang_translations": {
                                "tr": "Yere bakarak <w>burnunu çekip</w> acınası bir özür diledi.",
                                "cs": "Díval se do země a <w>popotahujíc</w> zamumlal ubohou omluvu."
                            }
                        },
                        {
                            "text": "She <w>sniffled</w> a quiet goodbye before leaving the room.",
                            "target_lang_translations": {
                                "tr": "Odadan çıkmadan önce <w>burnunu çekerek</w> sessizce veda etti.",
                                "cs": "Než odešla z místnosti, <w>popotahujíc</w> tiše zamumlala na rozloučenou."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Ağlamaklı veya burun çekerek bir şey söylemek.",
                        "cs": "Říci něco s doprovodným zvukem popotahování nebo kňourání."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "burnunu çekerek söylemek",
                                "target_lang_sense_clarification": "Ağlamaklı bir ses tonuyla konuşmak."
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "říci popotahujíc",
                                "target_lang_sense_clarification": "Mluvit s doprovodným zvukem popotahování."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}