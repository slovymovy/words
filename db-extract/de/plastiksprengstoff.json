                    {
                        "translation_id": "817a0657-d8f8-4038-aae1-7813d25ae547",
                        "source_entry_id": "88692427-22bc-31d8-99e1-0143f4624e5b",
                        "source_sense_id": "a257300a-e258-3d4e-9bfc-85bd79dbc363",
