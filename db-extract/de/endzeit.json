                ],
                "senses": [
                    {
                        "sense_id": "39814d51-ce3e-3141-8c48-77d4848b7e3e",
                        "entry_id": "e0e43efc-36c5-3abb-8391-90e1d5ba207e",
                        "glosses": [
                            "Zeitraum vor dem Weltuntergang, dem Ende der Menschheit, der Erde oder des Universums"
                        ],
                        "tags": [
                            "insbesondere"
                        ],
                        "examples": [
                            {
                                "example_id": "c7f8b547-0aac-4fe8-bc36-9669066bebf4",
                                "sense_id": "39814d51-ce3e-3141-8c48-77d4848b7e3e",
                                "text": "„In den vergangenen Jahren, sagt Johanna Wehner, habe sie sehr viele Stücke inszeniert, die mit Endzeit oder Jenseits zu tun hatten – immer aus der Perspektive der Lebenden.“"
                            },
                            {
                                "example_id": "d5eff811-f3d0-4fc2-9bd7-26131944e16d",
                                "sense_id": "39814d51-ce3e-3141-8c48-77d4848b7e3e",
                                "text": "„Jesus greift im Markus-Evangelium dieses Wort auf, wenn er von den Wirrnissen spricht, die in der Endzeit über die Menschen hereinbrechen werden. Mit der Endzeit ist nicht eine mysteriöse Zukunft gemeint, die vor uns liegt, sondern ganz einfach die Zeit, in der die Jünger Jesu leben […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d4cb6084-39bd-354d-b410-f01a36f6b787",
                        "entry_id": "e0e43efc-36c5-3abb-8391-90e1d5ba207e",
                        "glosses": [
                            "Ende eines Zeitraums, eines Zeitalters, der Herrschaft, der Existenz von etwas"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "00675f98-5ca8-4cb8-8a38-c553cba2de22",
                                "sense_id": "d4cb6084-39bd-354d-b410-f01a36f6b787",
                                "text": "„Hilfreich seien etwa gestaffelte Anfangs- und Endzeiten des Schulunterrichts.“"
                            },
                            {
                                "example_id": "51e40ea5-20f7-4308-89b2-6b2f28caf9b0",
                                "sense_id": "d4cb6084-39bd-354d-b410-f01a36f6b787",
                                "text": "„Während die Überreste immerhin einiges über den Zustand der Reiche in der Endzeit ihres Bestehens verraten, liegen deren Anfänge zumeist im Dunkeln.“"
                            },
                            {
                                "example_id": "2cddd2b5-0d3a-4bfd-8f42-8be8e71f2412",
                                "sense_id": "d4cb6084-39bd-354d-b410-f01a36f6b787",
                                "text": "„Militärisch überdehnt, die Staatsfinanzen in Gefahr, der innere Zusammenhalt prekär – es gibt Historiker, welche den Zustand der Vereinigten Staaten mit der Endzeit des Römischen Reiches vergleichen.“"
                            },
                            {
                                "example_id": "a612d1c2-7600-443d-b872-8ceb8012aa7a",
                                "sense_id": "d4cb6084-39bd-354d-b410-f01a36f6b787",
                                "text": "„Seine Aufzeichnungen, die er in den späten 1980er Jahren zu Papier gebracht hat - in der Endzeit der DDR -, schließen mit der Nachkriegszeit 1945/46 ab.“"
                            },
                            {
                                "example_id": "59800852-2ce4-46e1-9cc0-c6fd61569be6",
                                "sense_id": "d4cb6084-39bd-354d-b410-f01a36f6b787",
                                "text": "„Der Kapitalismus wurde angesichts von Wirtschaftskrise und Massenarbeitslosigkeit bereits in der Endzeit der Weimarer Republik von vielen als gescheitert angesehen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
