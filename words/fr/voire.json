                    "frequency": "High",
                    "semantic_group_id": "renforcement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette tâche semble très difficile, <w>voire</w> tout à fait impossible sans aide."
                        },
                        {
                            "text": "Il devra attendre plusieurs semaines, <w>voire</w> plusieurs mois, avant d'obtenir une réponse."
                        }
                    ],
