                "senses": [
                    {
                        "sense_id": "04d63fcb-9bb7-33ca-86c0-d39d80f8ae0f",
                        "entry_id": "5e01d825-ce38-38a1-abc7-d2ea981e3058",
                        "glosses": [
                            "icon case, kiot"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4139e145-7889-441b-a3c6-20f5cf04da41",
                                "sense_id": "04d63fcb-9bb7-33ca-86c0-d39d80f8ae0f",
                                "text": "— Тепе́рь кио́т-то весь сло́вно в ды́рах…\n— Что ж де́лать! И пе́ред таки́м помоли́сь! Бо́гу ведь не кио́т, а моли́тва твоя́ нужна́![...]",
                                "translation": "‘The icon-case looks as if it’s full of holes...’\n‘That can’t be helped! Pray before it as it is! God needs your prayers, not an icon-case!…",
                                "english": "‘The icon-case looks as if it’s full of holes...’\n‘That can’t be helped! Pray before it as it is! God needs your prayers, not an icon-case!…"
                            }
                        ]
                    }
