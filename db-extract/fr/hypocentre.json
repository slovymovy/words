                        "sense_id": "69bd6ae1-b297-373a-bf5f-ca3489a1a3a2",
                        "entry_id": "47300c2b-bf59-3aa3-b741-2ce414cd3e3f",
                        "glosses": [
                            "Point souterrain où l'on situe l'origine d’un séisme."
                        ],
                        "tags": [
                            "Géophysique"
                        ],
                        "examples": [
                            {
                                "example_id": "c752fccb-822d-4c24-9a7d-ccc8a21e1fdf",
                                "sense_id": "69bd6ae1-b297-373a-bf5f-ca3489a1a3a2",
                                "text": "La situation va en s'aggravant à mesure de la progression vers le nord et l’hypocentre du séisme, à l'extrême pointe de la péninsule."
                            },
                            {
                                "example_id": "ae32ab54-5bd5-464a-9015-2fd5e005451c",
                                "sense_id": "69bd6ae1-b297-373a-bf5f-ca3489a1a3a2",
                                "text": "Les hypocentres des tremblements de terre sont souvent profonds dans les zones de subduction."
                            }
                        ]
