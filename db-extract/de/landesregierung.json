                        ],
                        "form": "die Landesregierungen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4b8d271a-ad25-31f5-9847-14a107465564",
                        "entry_id": "4cec2635-f133-36f8-8414-fec99dcd9e57",
                        "glosses": [
                            "Regierung eines Bundeslandes"
                        ],
                        "tags": [
                            "Austrian German",
                            "Germany"
                        ],
                        "examples": [
                            {
                                "example_id": "d93dfadf-b013-4b04-920b-0c4bdffefe33",
                                "sense_id": "4b8d271a-ad25-31f5-9847-14a107465564",
                                "text": "Die Landesregierung von Nordrhein-Westfalen wurde neu gebildet."
                            },
                            {
                                "example_id": "55ff0469-05f8-4eb3-b7e6-79d6b6e36664",
                                "sense_id": "4b8d271a-ad25-31f5-9847-14a107465564",
                                "text": "Die Bundeskanzlerin traf sich mit Vertretern der Landesregierungen."
                            },
                            {
                                "example_id": "daf16937-2577-4a48-93ad-cf6f4eb3a08d",
                                "sense_id": "4b8d271a-ad25-31f5-9847-14a107465564",
                                "text": "Der Bundesumweltminister liegt im Streit mit den Länderregierungen, d. h. mit den Regierungen der Länder"
                            },
                            {
                                "example_id": "e4aec46d-63e1-4e4f-a482-8b88b7122c71",
                                "sense_id": "4b8d271a-ad25-31f5-9847-14a107465564",
                                "text": "„Ähnliches deutet sich für das Obereichsfeld an, das nach dem Willen der Erfurter Landesregierung ebenfalls mit den Nachbarkreisen fusionieren soll.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1767556c-3b1f-3a8b-9168-74a65681b07e",
                        "entry_id": "4cec2635-f133-36f8-8414-fec99dcd9e57",
                        "glosses": [
                            "Regierung der Schweizerischen Eidgenossenschaft, Bundesrat"
                        ],
                        "tags": [
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "5c271593-d279-4b0c-a258-b8b084a43196",
                                "sense_id": "1767556c-3b1f-3a8b-9168-74a65681b07e",
                                "text": "„Die Landesregierung der Schweiz setzt sich aus sieben Mitgliedern zusammen, die von der Vereinigten Bundesversammlung gewählt werden.“"
                            },
                            {
                                "example_id": "6b037820-8833-42e2-8a59-38a1e0b03818",
                                "sense_id": "1767556c-3b1f-3a8b-9168-74a65681b07e",
                                "text": "„ESG-Finanzprodukte müssten künftig neben einem rein finanziellen auch ein nachhaltiges Anlageziel verfolgen, teilte die Schweizer Landesregierung mit.“"
                            },
                            {
                                "example_id": "6ca597e1-577d-4610-bd4c-abdec9e3733b",
                                "sense_id": "1767556c-3b1f-3a8b-9168-74a65681b07e",
                                "text": "„Bundespräsident Alain Berset hat am Mittwoch seinen Rücktritt aus der Landesregierung auf Ende Jahr bekanntgegeben.“"
                            },
                            {
                                "example_id": "0a34769d-e2ce-4912-a60e-47b166564635",
                                "sense_id": "1767556c-3b1f-3a8b-9168-74a65681b07e",
                                "text": "„Der Bundesrat hat Anfang Dezember, am Samichlaus-Tag, seine gesundheitspolitische Strategie 2020–2030 veröffentlicht. […] Wäre der Samichlaus an diesem Tag vorbeigekommen, hätte er der Landesregierung eine grosse Rute mitbringen müssen. Die vorgestellten Überlegungen sind eine glatte Enttäuschung.“"
                            },
                            {
                                "example_id": "269bb37d-62e4-469e-9d75-d1a4e90d1b2d",
                                "sense_id": "1767556c-3b1f-3a8b-9168-74a65681b07e",
                                "text": "„Die Landesregierung setzt drastische Massnahmen für die Schweiz in Kraft.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
