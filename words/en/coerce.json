{
    "word_family": [
        "coercion",
        "coercive",
        "coercible",
        "coercivity"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d821ebb2-50ab-3fe8-b784-19e244ade8e2",
                    "sense_definition": "To use force, threats, or intimidation to compel someone to act against their will.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "compulsion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The suspect claimed that the police tried to <w>coerce</w> him into signing a false confession.",
                            "target_lang_translations": {
                                "ru": "Подозреваемый утверждал, что полиция пыталась <w>заставить</w> его подписать ложное признание."
                            }
                        },
                        {
                            "text": "It is illegal to <w>coerce</w> a witness into changing their testimony through threats of violence.",
                            "target_lang_translations": {
                                "ru": "Незаконно <w>принуждать</w> свидетеля к изменению показаний путем угроз расправой."
                            }
                        }
                    ],
                    "synonyms": [
                        "compel",
                        "bully",
                        "dragoon"
                    ],
                    "antonyms": [
                        "persuade",
                        "convince"
                    ],
                    "common_phrases": [
                        "coerce into",
                        "coerce a witness",
                        "coerce a confession"
                    ],
                    "target_lang_definitions": {
                        "ru": "Использовать силу, угрозы или запугивание, чтобы заставить кого-либо действовать против его воли."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "принуждать",
                                "target_lang_sense_clarification": "силой или давлением"
                            },
                            {
                                "target_lang_word": "заставлять",
                                "target_lang_sense_clarification": "делать что-то против воли"
                            },
                            {
                                "target_lang_word": "вынуждать",
                                "target_lang_sense_clarification": "создавать условия, не оставляющие выбора"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a75cf53-3a25-30ea-9c89-a31e6972c359",
                    "sense_definition": "To restrain or repress by force, especially through the application of law or authority.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "restraint",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new regulations were designed to <w>coerce</w> the behavior of large corporations.",
                            "target_lang_translations": {
                                "ru": "Новые правила были разработаны, чтобы <w>сдерживать</w> поведение крупных корпораций."
                            }
                        },
                        {
                            "text": "The state has the power to <w>coerce</w> compliance with public health mandates during an emergency.",
                            "target_lang_translations": {
                                "ru": "Государство имеет право <w>принуждать</w> к соблюдению предписаний в области общественного здравоохранения во время чрезвычайной ситуации."
                            }
                        }
                    ],
                    "synonyms": [
                        "bludgeon"
                    ],
                    "antonyms": [
                        "permit",
                        "allow"
                    ],
                    "common_phrases": [
                        "coerce compliance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сдерживать или подавлять силой, особенно путем применения закона или власти."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "принуждать",
                                "target_lang_sense_clarification": "к соблюдению норм или законов"
                            },
                            {
                                "target_lang_word": "сдерживать",
                                "target_lang_sense_clarification": "путем применения власти"
                            },
                            {
                                "target_lang_word": "подавлять",
                                "target_lang_sense_clarification": "силой авторитета"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c99ea973-4670-33fa-84be-64c2d6cbe79a",
                    "sense_definition": "To force a value of one data type to be treated as another data type.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The compiler will automatically <w>coerce</w> the integer into a floating-point number during the calculation.",
                            "target_lang_translations": {
                                "ru": "Компилятор автоматически <w>преобразует</w> целое число в число с плавающей запятой во время вычисления."
                            }
                        },
                        {
                            "text": "You may need to manually <w>coerce</w> the string into a boolean value for the logic to work.",
                            "target_lang_translations": {
                                "ru": "Вам может потребоваться вручную <w>привести</w> строку к логическому значению, чтобы логика заработала."
                            }
                        }
                    ],
                    "common_phrases": [
                        "coerce a type",
                        "type coercion"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Принудительно преобразовывать значение одного типа данных в другой тип."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приводить",
                                "target_lang_sense_clarification": "тип данных к другому виду"
                            },
                            {
                                "target_lang_word": "преобразовывать",
                                "target_lang_sense_clarification": "тип данных принудительно"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}