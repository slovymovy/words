                "senses": [
                    {
                        "sense_id": "d09119cb-5637-393f-9b39-17f6c736ee70",
                        "entry_id": "484570c0-76a8-3733-9f2f-4c301a7eb163",
                        "glosses": [
                            "Faire artificiellement baisser le degré alcoolique d'un vin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85ecc62e-edaf-4393-8909-b95db5516ca0",
                                "sense_id": "d09119cb-5637-393f-9b39-17f6c736ee70",
                                "text": "Les vignerons réfléchissent certains à court terme,comme ce vigneron qui élabore du rosé et le \"déchaptalise\"en y ajoutant de l'eau pour faire descendre les degrés (interdit normalement)(voir article revue des vins de France, Bloc Note, Antoine Gerbelle numéro d'avril 2008)."
                            },
                            {
                                "example_id": "92d0f889-2d3e-4d7c-9db4-5f2af06c13c0",
                                "sense_id": "d09119cb-5637-393f-9b39-17f6c736ee70",
                                "text": "Je déchaptalise, comme beaucoup de mes confrères qui ne vous l'avoueront jamais. Comment faire autrement ?"
                            }
                        ]
                    }
