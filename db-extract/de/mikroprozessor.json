                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "6084474b-94e8-453e-bcd8-2ed1c8afb011",
                        "source_entry_id": "8ae9c044-fca3-3696-80dc-9259e0963ee8",
                        "source_sense_id": "6e39cb6d-9995-3595-b95a-e5062d52878a",
                        "target_lang_word": "microprocessor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "microprocessor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "32135d96-c7d4-3f6b-9998-b43a36124fcd",
                                        "entry_id": "48d8c8e6-d3b7-3e5a-8f64-80675e9b00ad",
                                        "glosses": [
                                            "The entire CPU of a computer on a single integrated circuit (chip)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "559568b9-25f4-46da-93ad-96c8ebb76026",
                                                "sense_id": "32135d96-c7d4-3f6b-9998-b43a36124fcd",
                                                "text": "When the microprocessor decodes the JSR opcode, it stores the operand into the TEMP register and pushes the current contents of the PC ($00 0128) onto the stack."
                                            },
                                            {
                                                "example_id": "1c307164-47e4-43af-ab0d-cc42589791b7",
                                                "sense_id": "32135d96-c7d4-3f6b-9998-b43a36124fcd",
                                                "text": "When you think of current microprocessors (μPs), the Intel Itanium processor with 592 million transistors may come to mind. […] Clearly today's FPGAs will not be able to implement such a top-of-the-range μP with a single FPGA."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e1eed9d5-702e-4d55-887d-f053ec8bf8b3",
                        "source_entry_id": "8ae9c044-fca3-3696-80dc-9259e0963ee8",
                        "source_sense_id": "6e39cb6d-9995-3595-b95a-e5062d52878a",
                        "target_lang_word": "microprocesseur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "microprocesseur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "82dc9836-461b-3c60-bfe1-847c76a3f35a",
                                        "entry_id": "c5c56536-f5b0-3125-9424-d9f2f104dcf0",
                                        "glosses": [
                                            "Composant électronique de petite taille formé de transistors, et chargé d'exécuter des instructions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ca81de6-fe91-463d-9893-7fdf3744360a",
                                                "sense_id": "82dc9836-461b-3c60-bfe1-847c76a3f35a",
                                                "text": "Les microprocesseurs sont de plus en plus petits et de plus en plus puissants."
                                            },
                                            {
                                                "example_id": "cb20ee7d-66f7-4b83-a11e-bffd68998abc",
                                                "sense_id": "82dc9836-461b-3c60-bfe1-847c76a3f35a",
                                                "text": "Une chaussure de sport dotée d'un microprocesseur."
                                            },
                                            {
                                                "example_id": "5c40376d-3e6a-4e68-a361-8a1ddb574377",
                                                "sense_id": "82dc9836-461b-3c60-bfe1-847c76a3f35a",
                                                "text": "Au cœur de tout ordinateur bat le microprocesseur."
                                            },
                                            {
                                                "example_id": "6f2391f0-cb45-46e4-a7c1-1bee823350fb",
                                                "sense_id": "82dc9836-461b-3c60-bfe1-847c76a3f35a",
                                                "text": "La présence d'un microprocesseur conformément à l'article 1ᵉʳ n'est pas une condition de validité d'un permis de conduire. La perte ou l'illisibilité d'un microprocesseur, ou tout autre dommage subi par celui-ci, n'a aucun effet sur la validité du document."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
