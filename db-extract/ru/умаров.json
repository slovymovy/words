        "ru-extract.jsonl": [
            {
                "entry_id": "85c1c43b-22ab-3eea-a48f-c787623f17b2",
                "word": "Умаров",
                "pos": "name",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f6623fbe-2945-3ae0-ad08-7cb5589207dd",
                        "entry_id": "85c1c43b-22ab-3eea-a48f-c787623f17b2",
                        "glosses": [
                            "фамилия, распространённая среди тюркских и кавказских народов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e6bbf74-7975-4d3f-9471-eedae511c962",
                                "sense_id": "f6623fbe-2945-3ae0-ad08-7cb5589207dd",
                                "text": "Умаров был одним из организаторов рейда боевиков в Ингушетию 22 июня 2004 года. По решению руководителя непризнанного государства Ичкерия Абдул-Халима Садулаева Умаров стал его заместителем. После смерти Садулаева 17 июня 2006 года стал самопровозглашённым президентом Ичкерии."
                            },
                            {
                                "example_id": "9a443f44-63ec-407a-b8e6-cfd5df3cc773",
                                "sense_id": "f6623fbe-2945-3ae0-ad08-7cb5589207dd",
                                "text": "Кроме того, сотрудники, упомянутые в расследовании Христо Грозева, в 2013 году летали в Нальчик примерно в то же время, когда при невыясненных обстоятельствах умер лидер запрещённой в России организации «Имарат Кавказ» Доку Умаров."
                            }
                        ]
                    }
                ],
