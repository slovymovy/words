                "senses": [
                    {
                        "sense_id": "5ebc2131-7e0e-3431-b6a7-9aa9808bdc9c",
                        "entry_id": "df3e8a1e-bdb9-3a62-b1af-a684a22e7ae2",
                        "glosses": [
                            "Donner un caractère paraguayen à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c4691b6-7019-4f86-8aa3-f411d49a6e64",
                                "sense_id": "5ebc2131-7e0e-3431-b6a7-9aa9808bdc9c",
                                "text": "La géopolitique internationale de la guerre vient subordonner (paraguayaniser) les souvenirs des communautés dans leur relation à l’espace et à l’ennemi d’hier désigné comme bolivien."
                            },
                            {
                                "example_id": "ac7c010e-241d-4f08-a568-91ae36fc914a",
                                "sense_id": "5ebc2131-7e0e-3431-b6a7-9aa9808bdc9c",
                                "text": "Ils retrouvent Robert, que d'aucuns disent qu'il s'est beaucoup paraguayanisé, qu'il est devenu imprévoyant et insouciant."
                            },
                            {
                                "example_id": "ceda682c-6374-4e9b-b3fd-b95307213560",
                                "sense_id": "5ebc2131-7e0e-3431-b6a7-9aa9808bdc9c",
                                "text": "Vous vous êtes paraguayanisés"
                            }
                        ]
                    }
