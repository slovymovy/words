            {
                "entry_id": "4423d32c-b4c9-3bb4-88c4-00da7f1971a1",
                "word": "céréalier",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "918f294a-a068-4cb5-ad79-986f5776d0d7",
                        "entry_id": "4423d32c-b4c9-3bb4-88c4-00da7f1971a1",
                        "tags": [
                            "plural"
                        ],
                        "form": "céréaliers"
                    },
                    {
                        "form_id": "c17a0135-f05c-4d56-9daf-a35d462f4f66",
                        "entry_id": "4423d32c-b4c9-3bb4-88c4-00da7f1971a1",
                        "tags": [
                            "feminine"
                        ],
                        "form": "céréalière"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ada4d7eb-ff63-3cd9-a5fa-23c6c43cf20e",
                        "entry_id": "4423d32c-b4c9-3bb4-88c4-00da7f1971a1",
                        "glosses": [
                            "Exploitant agricole produisant des céréales."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5bede6e1-49e3-4762-968a-2e51775a37a9",
                                "sense_id": "ada4d7eb-ff63-3cd9-a5fa-23c6c43cf20e",
                                "text": "Céréalier d’origine, Xavier Beulin, également patron du groupe agroalimentaire Avril, était un industriel et un businessman siégeant dans de nombreuses sociétés. Une double casquette d’homme d’affaires et de syndicaliste qui lui a valu de nombreuses critiques."
                            }
                        ]
                    },
                    {
                        "sense_id": "5a935db5-3f16-3f7a-a63d-4f4dd70d8d29",
                        "entry_id": "4423d32c-b4c9-3bb4-88c4-00da7f1971a1",
                        "glosses": [
                            "Vraquier spécialisé dans le transport des céréales."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cef369bf-8fbd-4cd2-ad55-2330257a14a3",
                                "sense_id": "5a935db5-3f16-3f7a-a63d-4f4dd70d8d29",
                                "text": "Alors ils cessent d’être le cargo Chose ou le céréalier Machin et deviennent des tramp steamers, des vagabonds des ports qui naviguent sous les pavillons les plus pauvres avec des équipages réduits et obtiennent des contrats à bas prix pour transporter des cargaisons sans se poser de question sur leur nature ni se soucier de leur destination."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1ee57b96-42dd-46aa-a9fd-e9f6326a19ee",
                        "source_entry_id": "4423d32c-b4c9-3bb4-88c4-00da7f1971a1",
                        "source_sense_description": "exploitant agricole",
                        "target_lang_word": "Getreide",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Getreide",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7de8e4cd-a7bb-3370-a3be-d6a6279e3ae1",
                                        "entry_id": "f8d5540c-9238-32d4-95e4-3914c50a66e9",
                                        "glosses": [
                                            "Grasart, die wegen ihrer essbaren Samenkörner angebaut wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74cab94c-9603-47e5-bc5c-f4371c0fabfa",
                                                "sense_id": "7de8e4cd-a7bb-3370-a3be-d6a6279e3ae1",
                                                "text": "Auf diesem Boden kann man gut Getreide anbauen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "09839f8f-a5aa-32a4-99a3-c7bbe181792a",
                                        "entry_id": "f8d5540c-9238-32d4-95e4-3914c50a66e9",
                                        "glosses": [
                                            "Samenkörner der unter [1] genannten Grasarten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0ec6564-51fb-41ab-9f93-356152eb9124",
                                                "sense_id": "09839f8f-a5aa-32a4-99a3-c7bbe181792a",
                                                "text": "Jedes Jahr wird weltweit mehr Getreide produziert."
                                            },
                                            {
                                                "example_id": "a3b077f0-322b-4d8a-a0a0-631f6791643a",
                                                "sense_id": "09839f8f-a5aa-32a4-99a3-c7bbe181792a",
                                                "text": "„Selbst der Steinbruch in der Eifel ist bekannt, aus dem der Mühlstein stammt, mit dem Legionäre in Hedemünden ihr Getreide mahlten.“"
                                            },
                                            {
                                                "example_id": "df36de22-5d30-4be9-a941-410b7eea26bb",
                                                "sense_id": "09839f8f-a5aa-32a4-99a3-c7bbe181792a",
                                                "text": "„Andere lassen ihre Tiere stundenlang über das auf einem runden Platz zusammengetragene Getreide trampeln, während sie das Stroh immer wieder mit der aus einer Astgabel geschnitzten Forke in die Luft werfen.“"
                                            },
                                            {
                                                "example_id": "cd7ba261-e2c9-4a56-bc9e-c83f88d16bd6",
                                                "sense_id": "09839f8f-a5aa-32a4-99a3-c7bbe181792a",
                                                "text": "„Die Mühle liegt etwas abseits von anderen Häusern an ihrem Mühlbach; auch sie ist ständig in Betrieb und wird mit Getreide versorgt.“"
                                            },
                                            {
                                                "example_id": "7eb5dca8-4b6c-40e5-adfa-0114d1e00d1c",
                                                "sense_id": "09839f8f-a5aa-32a4-99a3-c7bbe181792a",
                                                "text": "„Reis und Getreide füllten seine Speicher.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
