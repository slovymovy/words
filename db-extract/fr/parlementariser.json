                "senses": [
                    {
                        "sense_id": "c73f5efb-2a76-3bce-ac35-eec4926a3d4c",
                        "entry_id": "05de23ee-5e56-3bf4-b05f-8eace14e9cfc",
                        "glosses": [
                            "Donner un caractère parlementaire à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e74d0c97-2f8b-4cac-b572-57b537b3428b",
                                "sense_id": "c73f5efb-2a76-3bce-ac35-eec4926a3d4c",
                                "text": "Je comprends ce qu'il souffre en voyant parlementariser l'art, si j'ai jugé par ce que je souffre en voyant démocratiser les lettres dans le Petit Journal."
                            },
                            {
                                "example_id": "56c61661-3220-454e-a0cf-e73e74c0cefb",
                                "sense_id": "c73f5efb-2a76-3bce-ac35-eec4926a3d4c",
                                "text": "S'ils voulaient le parlementariser, s'intégrer à lui et, à l'avenir, participer à sa conduite, ils étaient horrifiés par le désordre que sa transformation révolutionnaire aurait nécessairement comporté."
                            }
                        ]
                    }
