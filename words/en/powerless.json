{
    "word_family": [
        "power",
        "powerful",
        "empower",
        "disempower"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a03ef1fd-edaa-3e0c-99c1-509a7d678e5c",
                    "sense_definition": "Lacking sufficient power or strength to act or influence a situation.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "lacking_strength",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt completely <w>powerless</w> to stop the argument between his parents.",
                            "target_lang_translations": {
                                "pl": "Czuł się całkowicie <w>bezsilny</w>, by powstrzymać kłótnię między swoimi rodzicami."
                            }
                        },
                        {
                            "text": "The small boat was <w>powerless</w> against the strength of the ocean waves.",
                            "target_lang_translations": {
                                "pl": "Mała łódź była <w>bezsilna</w> wobec siły oceanicznych fal."
                            }
                        }
                    ],
                    "synonyms": [
                        "weak",
                        "impotent",
                        "helpless"
                    ],
                    "antonyms": [
                        "powerful",
                        "strong"
                    ],
                    "common_phrases": [
                        "feel powerless",
                        "powerless to"
                    ],
                    "target_lang_definitions": {
                        "pl": "Pozbawiony wystarczającej siły lub możliwości, by działać lub wpłynąć na sytuację."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "bezsilny",
                                "target_lang_sense_clarification": "niezdolny do działania lub zmiany sytuacji"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5b833666-ea20-3377-8208-ace5477b0eaf",
                    "sense_definition": "Without electricity or electrical power.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "lacking_strength",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The storm left the entire city <w>powerless</w> for three days.",
                            "target_lang_translations": {
                                "pl": "Burza sprawiła, że całe miasto było <w>bez prądu</w> przez trzy dni."
                            }
                        },
                        {
                            "text": "Many homes remained <w>powerless</w> after the main grid failed.",
                            "target_lang_translations": {
                                "pl": "Wiele domów pozostało <w>bez prądu</w> po awarii głównej sieci."
                            }
                        }
                    ],
                    "common_phrases": [
                        "left powerless"
                    ],
                    "target_lang_definitions": {
                        "pl": "Pozbawiony zasilania elektrycznego."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "bez prądu",
                                "target_lang_sense_clarification": "pozbawiony dostaw energii elektrycznej"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f16b57ad-b3dd-35d9-be05-cefcc66ad597",
                    "sense_definition": "Lacking the legal authority or official right to take action.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "lacking_strength",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local council was <w>powerless</w> to change the national law.",
                            "target_lang_translations": {
                                "pl": "Rada lokalna była <w>bezsilna</w> wobec zmiany prawa krajowego."
                            }
                        },
                        {
                            "text": "Without a warrant, the police officer was <w>powerless</w> to enter the building.",
                            "target_lang_translations": {
                                "pl": "Bez nakazu policjant był <w>bezsilny</w> i nie mógł wejść do budynku."
                            }
                        }
                    ],
                    "synonyms": [
                        "vulnerable"
                    ],
                    "target_lang_definitions": {
                        "pl": "Nieposiadający uprawnień prawnych lub oficjalnego prawa do podjęcia działań."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "bezradny",
                                "target_lang_sense_clarification": "nieposiadający możliwości prawnej lub faktycznej do działania"
                            },
                            {
                                "target_lang_word": "bezsilny",
                                "target_lang_sense_clarification": "nieposiadający władzy lub autorytetu do interwencji"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}