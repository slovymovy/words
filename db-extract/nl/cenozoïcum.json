                        "glosses": [
                            "geologisch tijdperk, het derde en laatste era van het fanerozoïcum, vanaf 66 miljoen jaar geleden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cd51fa7-9806-461e-b549-6f63179e17e3",
                                "sense_id": "d9752f09-4716-3539-9533-2cd0047917fb",
                                "text": "Het cenozoïcum is een era van het fanerozoïcum dat volgt op het mesozoïcum."
                            }
                        ]
