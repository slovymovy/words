        "fr-extract.jsonl": [
            {
                "entry_id": "da2dd8d8-56fd-3825-bafd-57414059a41d",
                "word": "conurbation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0787865a-ddab-4e07-a905-39e0cba7e326",
                        "entry_id": "da2dd8d8-56fd-3825-bafd-57414059a41d",
                        "tags": [
                            "plural"
                        ],
                        "form": "conurbations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "938e8387-f025-38b5-af89-1b6b79bd2203",
                        "entry_id": "da2dd8d8-56fd-3825-bafd-57414059a41d",
                        "glosses": [
                            "Ensemble urbain constitué de plusieurs noyaux urbains (ou villes) distincts."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83ef8758-f0b1-4dbb-b0b2-76fe99f8a387",
                                "sense_id": "938e8387-f025-38b5-af89-1b6b79bd2203",
                                "text": "En ville, les cimetières, eux aussi translatés en dehors des bourgs et des villes aux XVIIIᵉ et XIXᵉ siècles, ont souvent été rattrapés par la conurbation des faubourgs et des banlieues."
                            },
                            {
                                "example_id": "26b07a3b-33f5-4d6a-b2d5-aad3ee4d93a9",
                                "sense_id": "938e8387-f025-38b5-af89-1b6b79bd2203",
                                "text": "Les chercheurs ont calculé que 17 mégalopoles et conurbations en Asie se classent parmi les 30 villes les plus touchées par la pollution de l’air."
                            },
                            {
                                "example_id": "eb1aa30b-a088-4f50-8a48-9eee96b9b391",
                                "sense_id": "938e8387-f025-38b5-af89-1b6b79bd2203",
                                "text": "L'extension des villes rend pourtant obligatoire l'usage du visiophone. Depuis bientôt dix ans, les différents secteurs d'une conurbation sont quelquefois si éloignés qu'il est impossible de rencontrer tous ceux avec lesquels il est nécessaire d'échanger."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9c16a0c4-b7ab-4d99-8a3a-81e7361bad3e",
                        "source_entry_id": "da2dd8d8-56fd-3825-bafd-57414059a41d",
                        "source_sense_id": "938e8387-f025-38b5-af89-1b6b79bd2203",
                        "target_lang_word": "Ballungszentrum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ballungszentrum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "793141af-ee83-3888-8ed8-df653c614750",
                                        "entry_id": "b61a73cc-3426-3d1b-919d-cde84bf0b66a",
                                        "glosses": [
                                            "zentral gelegenes oder dicht bevölkertes Gebiet eines Ballungsraumes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88b13eca-2ced-4809-aee5-f45182f17e42",
                                                "sense_id": "793141af-ee83-3888-8ed8-df653c614750",
                                                "text": "Während es im Norden und Osten also Windstrom im Überfluss gibt, ist er in den Ballungszentren im Westen und Süden Mangelware."
                                            },
                                            {
                                                "example_id": "28793d1b-655a-4b18-b068-b264ebcb9193",
                                                "sense_id": "793141af-ee83-3888-8ed8-df653c614750",
                                                "text": "Nach aktueller Einschätzung des Deutschen Mieterbundes ist „in den Ballungszentren und Universitätsstädten bei Neuverträgen mit Mietpreissteigerungen von durchschnittlich 10 Prozent“ zu rechnen."
                                            },
                                            {
                                                "example_id": "f0fb6144-f53e-46b4-a083-37a31ce5c03b",
                                                "sense_id": "793141af-ee83-3888-8ed8-df653c614750",
                                                "text": "Experten rechnen damit, dass kleine Dörfer, die abseits von Ballungszentren liegen, in ihrer Existenz gefährdet sein könnten."
                                            },
                                            {
                                                "example_id": "7d2704e1-ac38-4880-a6f3-d99a7c4a31d4",
                                                "sense_id": "793141af-ee83-3888-8ed8-df653c614750",
                                                "text": "„Bundesweit fehlen […] rund 550.000 Wohnungen - insbesondere bezahlbarer Wohnraum in Ballungszentren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
