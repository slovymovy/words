                    {
                        "sense_id": "36ff50df-91ef-30ed-8dbe-00fc201411e0",
                        "entry_id": "697b7f48-5e2e-39c3-9e9b-eaf601ef63b1",
                        "glosses": [
                            "A no-op; a CPU instruction that does nothing."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e66bcca-e0c8-42a1-a750-84af8a319038",
                                "sense_id": "36ff50df-91ef-30ed-8dbe-00fc201411e0",
                                "text": "The MIPS instruction set is rich in nops, since any instruction with zero as a destination is guaranteed to do nothing."
                            },
                            {
                                "example_id": "89eee092-9d23-4a91-896a-21ec61bc1757",
                                "sense_id": "36ff50df-91ef-30ed-8dbe-00fc201411e0",
                                "text": "2004, Patterson et al, Computer Organization and Design: The Hardware/Software Interface\nNotice that in computing CPI or IPC, we do not count any nops executed as useful instructions."
                            }
                        ]
                    }
                ],
                "translations": [],
