                "senses": [
                    {
                        "sense_id": "cf7ad4a7-d8a0-3798-a0c9-417d1a80bb51",
                        "entry_id": "73ea45c4-6451-3564-bf63-249cc6eef537",
                        "glosses": [
                            "Susceptible de provoquer un érythème, une rougeur cutanée s’effaçant sous la pression."
                        ],
                        "tags": [
                            "le sens semble différent de celui de érythémateux… à préciser ou à vérifier"
                        ],
                        "examples": [
                            {
                                "example_id": "fd80f2b9-d02f-483c-ad43-2666632c910e",
                                "sense_id": "cf7ad4a7-d8a0-3798-a0c9-417d1a80bb51",
                                "text": "Cependant, lors des expositions naturelles type bain de soleil, la dose d’UVA reçue est cent fois supérieure à celle d’UVB et, ainsi, dans de telles conditions on admet que l’effet érythémal est dû pour 80 % aux UVB et 20% aux UVA."
                            },
                            {
                                "example_id": "0dc941da-5104-4b33-bfcf-23ccb8a16ec9",
                                "sense_id": "cf7ad4a7-d8a0-3798-a0c9-417d1a80bb51",
                                "text": "La dose érythémale minimale varie d’un sujet à l’autre suivant les phototypes cutanés […]"
                            },
                            {
                                "example_id": "2420ca03-b7e9-4df2-9697-4fee015adf60",
                                "sense_id": "cf7ad4a7-d8a0-3798-a0c9-417d1a80bb51",
                                "text": "Ceci est encore vrai dans la plupart des cas de photoallergie ou les rayons efficients ne sont plus les UV érythémaux, mais des UV longs et même du visible."
                            }
                        ]
                    }
                ],
