                                "sense_id": "c652533a-4bbc-3b34-80c7-42b355735369",
                                "text": "Dzikimi przodkami koników polskich były tarpany."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "2ca4f466-328f-3af7-85a2-60675d143e14",
