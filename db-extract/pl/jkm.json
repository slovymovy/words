                                        "sense_id": "1ec81b0f-2d89-3f32-950e-4d3ed413f70c",
                                        "entry_id": "31f4f3e9-ab67-36eb-ba94-0488eb0a7e9a",
                                        "glosses": [
                                            "Initialism of Hannah Montana, an American teen sitcom that aired from 2006 to 2011."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "initialism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7fb7ba73-f26a-43b6-a457-49075afd3185",
                                                "sense_id": "1ec81b0f-2d89-3f32-950e-4d3ed413f70c",
                                                "text": "She [Millie Bobby Brown] then demonstrated how she eventually started slipping in and out of an American accent as a by-product of her HM marathons (and fair warning, it’s so seamless that it’s a little jarring)."
                                            }
                                        ]
                                    }
                                ]
