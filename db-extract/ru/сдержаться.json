                "senses": [
                    {
                        "sense_id": "10373054-4bc4-3f48-bd00-12855a80ed95",
                        "entry_id": "3db4b200-2fe3-3548-a283-5d43e08924e4",
                        "glosses": [
                            "удержать себя от проявления каких-либо чувств, от исполнения каких-либо намерений"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5920efa6-268c-4f2b-8e17-3cbdb444709f",
                                "sense_id": "10373054-4bc4-3f48-bd00-12855a80ed95",
                                "text": "Я хотел возразить ему, но вовремя сдержался: я отлично понимал, что каждый мой гневный порыв, каждое резкое выражение сочтут за несомненный признак сумасшествия."
                            },
                            {
                                "example_id": "27576f8d-41c1-4d1a-bee5-a18a78fdf10b",
                                "sense_id": "10373054-4bc4-3f48-bd00-12855a80ed95",
                                "text": "Но ты всегда можешь сдержаться от того, чтобы ни словом, ни делом не показать своего сердца."
                            }
                        ]
                    }
                ],
