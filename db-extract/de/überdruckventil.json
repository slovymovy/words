                "senses": [
                    {
                        "sense_id": "c2cafc3e-ed25-3c2e-a1c6-0bf93d028a30",
                        "entry_id": "9817f3b9-ee0d-3db0-9a1d-919cc0e0df58",
                        "glosses": [
                            "Ventil, das bei zu viel Druck Gase oder Ähnliches entweichen lässt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f38f60a-896c-4b98-ad2d-ad78c6558fdb",
                                "sense_id": "c2cafc3e-ed25-3c2e-a1c6-0bf93d028a30",
                                "text": "Der Anus fungiert teilweise als Überdruckventil."
                            },
                            {
                                "example_id": "3b463e5b-9cf7-4c9f-ae6f-5df2e708a43f",
                                "sense_id": "c2cafc3e-ed25-3c2e-a1c6-0bf93d028a30",
                                "text": "„Ursache der Explosion sei vielmehr ein durch ein Schlauchstück verstopftes Überdruckventil gewesen.“"
                            },
                            {
                                "example_id": "5a6550b4-02d0-4886-b2be-fe2011211ac4",
                                "sense_id": "c2cafc3e-ed25-3c2e-a1c6-0bf93d028a30",
                                "text": "Als ein Feuer in der Fabrik ausbrach und sich bis zu den Gasbehältern ausbreitete, ließen die Überdruckventile das Gas aus den Behältern, damit diese nicht explodieren."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
