                        "glosses": [
                            "Qui est sujet à être vexé facilement."
                        ],
                        "tags": [
                            "Très rare"
                        ],
                        "examples": [
                            {
                                "example_id": "e8de53c0-693b-451c-88fe-2e715c23e7cf",
                                "sense_id": "7a26a21e-b43c-3973-aa22-fe110b368e59",
                                "text": "Tout petit, j’étais vexable et tourmentable à merci. La susceptibilité a été le siège de mes blessures préverbales."
                            },
                            {
                                "example_id": "f5a16cb3-ee7c-4dad-8ef9-9bc15afe9ed8",
                                "sense_id": "7a26a21e-b43c-3973-aa22-fe110b368e59",
                                "text": "Du coup je me suis retrouvé dans une position plus facile pour repérer, accepter certains projets, et surtout je n’étais plus vexable !"
                            },
                            {
                                "example_id": "6deb273d-059e-49b6-b93b-cdd77d613c04",
                                "sense_id": "7a26a21e-b43c-3973-aa22-fe110b368e59",
                                "text": "Bien, nous sommes quasiment arrivés chez le sieur Yteulaire. Je vous demanderai de l’appeler professeur, en italique ! Il est très facilement vexable. Il est aisément irritable."
                            }
                        ]
                    }
