{
    "word_family": [
        "lurcher"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "aebf7edc-a117-3621-b658-0bc56c29c528",
                    "sense_definition": "To make a sudden, unsteady, or uncontrolled movement to one side.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "unsteady_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bus came to a sudden stop, causing the passengers to <w>lurch</w> forward. ",
                            "target_lang_translations": {
                                "de": "Der Bus hielt plötzlich an, sodass die Fahrgäste nach vorne <w>ruckten</w>."
                            }
                        },
                        {
                            "text": "He was so tired that he began to <w>lurch</w> down the street.",
                            "target_lang_translations": {
                                "de": "Er war so müde, dass er anfing, die Straße entlang zu <w>torkeln</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "stagger",
                        "sway",
                        "stumble",
                        "reel"
                    ],
                    "common_phrases": [
                        "lurch forward",
                        "lurch to the side"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine plötzliche, unsichere oder unkontrollierte Bewegung zu einer Seite machen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "taumeln",
                                "target_lang_sense_clarification": "unsicher oder schwankend gehen"
                            },
                            {
                                "target_lang_word": "schlingern",
                                "target_lang_sense_clarification": "von Fahrzeugen oder Schiffen, unkontrolliert ausweichen"
                            },
                            {
                                "target_lang_word": "torkeln",
                                "target_lang_sense_clarification": "unsicher auf den Beinen gehen, z. B. bei Trunkenheit oder Müdigkeit"
                            },
                            {
                                "target_lang_word": "rucken",
                                "target_lang_sense_clarification": "sich plötzlich und ruckartig bewegen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "303bbe8a-a66c-3ea6-ad50-1bb9ee084353",
                    "sense_definition": "A sudden, unsteady, or abrupt movement to one side.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "unsteady_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "With a sudden <w>lurch</w>, the ship tipped heavily to the left. ",
                            "target_lang_translations": {
                                "de": "Mit einem plötzlichen <w>Schlingern</w> neigte sich das Schiff stark nach links."
                            }
                        },
                        {
                            "text": "The sudden <w>lurch</w> of the train made everyone lose their balance.",
                            "target_lang_translations": {
                                "de": "Der plötzliche <w>Ruck</w> des Zuges brachte alle aus dem Gleichgewicht."
                            }
                        }
                    ],
                    "synonyms": [
                        "jolt",
                        "jerk",
                        "stagger",
                        "sway"
                    ],
                    "common_phrases": [
                        "sudden lurch"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine plötzliche, unsichere oder abrupte Bewegung zu einer Seite."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "der Ruck",
                                "target_lang_sense_clarification": "eine plötzliche, steile oder plötzliche Bewegung"
                            },
                            {
                                "target_lang_word": "das Schlingern",
                                "target_lang_sense_clarification": "eine unkontrollierte Seitwärtsbewegung eines Fahrzeugs oder Schiffs"
                            },
                            {
                                "target_lang_word": "der Schwank",
                                "target_lang_sense_clarification": "eine schwankende oder unsichere Bewegung"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8b088599-452e-3bb7-96e9-c4ddc4a5afa7",
                    "sense_definition": "A difficult or vulnerable situation (primarily used in the idiom 'leave in the lurch').",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "predicament",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He promised to help us move, but he left us in the <w>lurch</w> at the last minute. ",
                            "target_lang_translations": {
                                "de": "Er versprach, uns beim Umzug zu helfen, aber er ließ uns in letzter Minute <w>im Stich</w>."
                            }
                        },
                        {
                            "text": "You shouldn't leave your teammates in the <w>lurch</w> when things get tough.",
                            "target_lang_translations": {
                                "de": "Du solltest deine Teamkollegen nicht <w>im Stich lassen</w>, wenn es schwierig wird."
                            }
                        }
                    ],
                    "synonyms": [
                        "predicament",
                        "bind",
                        "jam"
                    ],
                    "common_phrases": [
                        "in the lurch",
                        "leave in the lurch"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine schwierige oder hilflose Lage (hauptsächlich in der Redewendung 'im Stich lassen' verwendet)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "im Stich lassen",
                                "target_lang_sense_clarification": "jemanden in einer schwierigen Situation alleine lassen (Entsprechung zu 'leave in the lurch')"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}