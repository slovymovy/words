                "senses": [
                    {
                        "sense_id": "95af4aec-2fd7-3dc2-ab0b-6dacf4ef1cb6",
                        "entry_id": "b77b8a6d-151c-3197-8741-d0d607fc2d30",
                        "glosses": [
                            "Donner un caractère péninsulaire à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6eaa510c-6f17-43b0-8703-c8b35931aa0b",
                                "sense_id": "95af4aec-2fd7-3dc2-ab0b-6dacf4ef1cb6",
                                "text": "Les îles Saint-Marcouf sont bien isolées au large par des fonds de plus de 10 mètres sous les plus basses mers, et la poldérisation de la Baie des Veys, qui s’est poursuivie jusqu’en 1973, ne risque pas de sitôt de les péninsulariser."
                            },
                            {
                                "example_id": "5f4690bd-bad7-4af6-a294-84332ba15771",
                                "sense_id": "95af4aec-2fd7-3dc2-ab0b-6dacf4ef1cb6",
                                "text": "Il faut désinsulariser le concept de science. Il faut le péninsulariser seulement, c’est-à-dire que la science est effectivement une péninsule dans le continent culturel et dans le continent social."
                            }
                        ]
                    }
