                        "glosses": [
                            "Rongeur de la famille des Octodontidae, vivant dans le piémont des Andes en Argentine, au Chili et en Bolivie."
                        ],
                        "tags": [
                            "Glirologie"
                        ],
                        "examples": [
                            {
                                "example_id": "065980db-0cb8-4c0f-8644-93822de7f683",
                                "sense_id": "98d88e8f-0acd-36ff-8986-3fcd5bd086cb",
                                "text": "Parmi les espèces les plus connues de ce groupe sont les souris, les rats, les écureuils, les chiens de prairie, les porcs-épics, les castors, les cochons d’Inde, les hamsters, les maras, les capybaras, les ragondins, les rats des rochers, les octodons, les chozchoz, les coruros, les Rats-viscaches roux d'Argentine, les Rats-taupes nus, les Campagnols des Prairies, les Loirs gris, les marmottes, les Spermophiles, les tamias …"
                            }
                        ]
                    }
