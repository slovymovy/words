                "senses": [
                    {
                        "sense_id": "5de5cb1e-f3d9-39b5-95d5-1f50eccb3ffa",
                        "entry_id": "e469dab9-8201-3ce9-ac58-1d511be8df62",
                        "glosses": [
                            "Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d2184f5-2ff4-4bac-b31c-84d5091217fd",
                                "sense_id": "5de5cb1e-f3d9-39b5-95d5-1f50eccb3ffa",
                                "text": "Frau Kowaczek ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "57c14b9a-d1d9-4c6b-80a5-b101b945ef6a",
                                "sense_id": "5de5cb1e-f3d9-39b5-95d5-1f50eccb3ffa",
                                "text": "Herr Kowaczek wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "b35e1eb4-3c09-442a-9aea-47c174d0a1c9",
                                "sense_id": "5de5cb1e-f3d9-39b5-95d5-1f50eccb3ffa",
                                "text": "Die Kowaczeks fahren heute ins Oderbruch."
                            },
                            {
                                "example_id": "4baa8092-5f9e-4897-82a6-14728f4e4405",
                                "sense_id": "5de5cb1e-f3d9-39b5-95d5-1f50eccb3ffa",
                                "text": "Der Kowaczek trägt nie die Schals, die die Kowaczek ihm strickt."
                            },
                            {
                                "example_id": "865ae3fd-caae-4ea6-8436-1a4a079baee8",
                                "sense_id": "5de5cb1e-f3d9-39b5-95d5-1f50eccb3ffa",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kowaczek kommt, geht der Herr Kowaczek.“"
                            },
                            {
                                "example_id": "efc3350f-fcc8-4015-a359-60e3fdc98ea8",
                                "sense_id": "5de5cb1e-f3d9-39b5-95d5-1f50eccb3ffa",
                                "text": "Kowaczek kommt und geht."
                            },
                            {
                                "example_id": "2e67a0a8-af94-4f6a-bf98-8a3a9bfbe5e4",
                                "sense_id": "5de5cb1e-f3d9-39b5-95d5-1f50eccb3ffa",
                                "text": "Kowaczeks kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
