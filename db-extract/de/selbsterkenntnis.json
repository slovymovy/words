                                        "entry_id": "7b81c85c-d09f-3157-982c-0d40d60d806a",
                                        "glosses": [
                                            "Knowledge or insight into one's own character, abilities, feelings, or motivations; self-understanding."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce42d09d-65d8-4d3b-9ab1-3648fe7061ce",
                                                "sense_id": "243bc234-9808-373b-aea8-cfb76af6d787",
                                                "text": "A girl's love is half poetry, an unconscious preference till startled into self-knowledge. Isabella had been grateful for Mr. Glentworth's kindness—struck with his cultivated mind, and impressed with his distinguished appearance; so were all her sisters; but she alone was timid in expressing that admiration; in her alone had they inspired that feeling, which, shy, vague, and tender, is love."
                                            }
                                        ]
