                                        ]
                                    },
                                    {
                                        "sense_id": "4003d656-53a7-3194-8690-ababb6181cb4",
                                        "entry_id": "6c855d0a-76b2-3e8c-9ade-10d2f73cac37",
                                        "glosses": [
