                "senses": [
                    {
                        "sense_id": "e61372d3-d55e-3421-b430-85bbc346651a",
                        "entry_id": "8deb046f-cc7e-3725-abd7-7e50899840ed",
                        "glosses": [
                            "schmerzende/geschwollene/gerötete Einstichstelle am Arm nach der Impfung mit einem Vakzin gegen Covid-19; muskelkaterähnliche Schmerzen im Oberarm"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "ded0b609-e3e1-476d-a17d-ff503ab29c32",
                                "sense_id": "e61372d3-d55e-3421-b430-85bbc346651a",
                                "text": "„Die auch als \"Covid-Arm\" bezeichnete Nebenwirkung betrifft vor allem Frauen.“"
                            },
                            {
                                "example_id": "a2985af3-4273-421d-9a48-23f578a6ba13",
                                "sense_id": "e61372d3-d55e-3421-b430-85bbc346651a",
                                "text": "„Auch für die schnell entwickelten Covid-Impfstoffe wird eine Liste erstellt. Darauf befindet sich auch der Covid-Arm. Experten versichern jedoch: kein Grund zur Sorge.“"
                            },
                            {
                                "example_id": "9d014fd5-7c38-4a15-a0c7-045ae7935b70",
                                "sense_id": "e61372d3-d55e-3421-b430-85bbc346651a",
                                "text": "„Hinter der Bezeichnung „Covid-Arm“ verbirgt sich eine Reaktion an der Einstichstelle am Oberarm, die wohl erst einige Tage nach der Impfung auftritt. Bekannt ist diese unerwünschte Nebenwirkung schon länger, doch in der Öffentlichkeit war das Wissen um dieses Impf-Phänomen bislang wenig verbreitet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
