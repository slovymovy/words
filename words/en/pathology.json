{
    "word_family": [
        "pathologist",
        "pathological",
        "pathologically",
        "pathogenic",
        "psychopathology",
        "cytopathology",
        "histopathology"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ca19632b-8eb4-3ad8-bbf2-394af4e7e280",
                    "sense_definition": "The branch of medicine and biology that studies the nature, causes, and effects of diseases.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "medical_science",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The surgeon sent a specimen of the cyst to the hospital's <w>pathology</w> department for analysis.",
                            "target_lang_translations": {
                                "ru": "Хирург отправил образец кисты в отделение <w>патологии</w> больницы для анализа."
                            }
                        },
                        {
                            "text": "Advances in <w>pathology</w> have allowed doctors to identify rare diseases much more quickly than before.",
                            "target_lang_translations": {
                                "ru": "Достижения в области <w>патологии</w> позволили врачам выявлять редкие заболевания гораздо быстрее, чем раньше."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pathology department",
                        "clinical pathology",
                        "speech pathology"
                    ],
                    "target_lang_definitions": {
                        "ru": "Раздел медицины и биологии, изучающий природу, причины и последствия заболеваний."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "патология",
                                "target_lang_sense_clarification": "научная дисциплина"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c8e11933-3415-3df2-acd7-9b59ee09ba37",
                    "sense_definition": "A physical or mental condition that is caused by a disease; an <w>abnormality</w> or <w>illness</w>.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "medical_condition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The biopsy results showed no discernible <w>pathology</w> in the patient's kidney tissue.",
                            "target_lang_translations": {
                                "ru": "Результаты биопсии не выявили заметной <w>патологии</w> в тканях почек пациента."
                            }
                        },
                        {
                            "text": "The doctor looked for signs of social <w>pathology</w> within the community's behavior.",
                            "target_lang_translations": {
                                "ru": "Врач искал признаки социальной <w>патологии</w> в поведении сообщества."
                            }
                        }
                    ],
                    "synonyms": [
                        "abnormality",
                        "disease",
                        "illness",
                        "pathosis"
                    ],
                    "common_phrases": [
                        "discernible pathology",
                        "social pathology",
                        "mental pathology"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физическое или психическое состояние, вызванное болезнью; отклонение от нормы или заболевание."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "патология",
                                "target_lang_sense_clarification": "отклонение от нормы"
                            },
                            {
                                "target_lang_word": "заболевание",
                                "target_lang_sense_clarification": "болезненное состояние"
                            },
                            {
                                "target_lang_word": "аномалия",
                                "target_lang_sense_clarification": "неправильность развития"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}