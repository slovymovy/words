                ],
                "senses": [
                    {
                        "sense_id": "7d86199c-8b95-353d-9926-79a2ba2e3fae",
                        "entry_id": "36478623-788a-3e32-92e2-35c78085049f",
                        "glosses": [
                            "Shrivelled, shrunken or faded, especially due to lack of water."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f41b633-95c7-4341-a59e-cedb53f56936",
                                "sense_id": "7d86199c-8b95-353d-9926-79a2ba2e3fae",
                                "text": "Lying on the floor was a dead man, in evening dress, with a knife in his heart. He was withered, wrinkled, and loathsome of visage. It was not till they had examined the rings that they recognized who it was."
                            },
                            {
                                "example_id": "8c2735e3-a0a3-40e2-ae5a-e722af08a4fa",
                                "sense_id": "7d86199c-8b95-353d-9926-79a2ba2e3fae",
                                "text": "Three chairs of the steamer type, all maimed, comprised the furniture of this roof-garden, with […] on one of the copings a row of four red clay flower-pots filled with sun-baked dust from which gnarled and rusty stalks thrust themselves up like withered elfin limbs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d4da84c7-3622-4017-a517-baa2641555eb",
                        "source_entry_id": "36478623-788a-3e32-92e2-35c78085049f",
                        "source_sense_id": "7d86199c-8b95-353d-9926-79a2ba2e3fae",
                        "source_sense_description": "shrivelled",
                        "target_lang_word": "flétri",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flétri",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6db9916c-8dd5-3b01-b592-7022ab325e5a",
                                        "entry_id": "5f9344fd-98d3-309f-a86c-ab10e8d50a67",
                                        "glosses": [
                                            "Qui a séché, qui a perdu sa fraîcheur, en parlant des pétales d’une fleur ou d’un autre végétal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa59ff82-26d5-46ed-a1ce-b285a9df5caa",
                                                "sense_id": "6db9916c-8dd5-3b01-b592-7022ab325e5a",
                                                "text": "Les heures voluptueuses gisent dans le passé, comme la dépouille rousse des bois flétris."
                                            },
                                            {
                                                "example_id": "a13c2401-b886-4c04-ac0e-85a3c1d8a1f5",
                                                "sense_id": "6db9916c-8dd5-3b01-b592-7022ab325e5a",
                                                "text": "Les feuilles étaient devenues jaunes et flétries."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7081a66e-31ed-33df-87c8-7084974580ec",
                                        "entry_id": "5f9344fd-98d3-309f-a86c-ab10e8d50a67",
                                        "glosses": [
                                            "Qui porte les signes de dégradation de l’âge, en parlant de la peau d’une personne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02cddcc9-2b9c-464c-9f9f-736e70c2e50a",
                                                "sense_id": "7081a66e-31ed-33df-87c8-7084974580ec",
                                                "text": "Il avait la peau flétrie par l’âge et le soleil."
                                            },
                                            {
                                                "example_id": "4d781d50-8b89-4bf7-bcea-6b3a425e1cf1",
                                                "sense_id": "7081a66e-31ed-33df-87c8-7084974580ec",
                                                "text": "Ils avaient l’air intelligent, et les femmes, bien que hâlées et flétries, portaient avec grâce un long manteau noir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "244096c1-bccd-3507-91d2-6dfd1215c5fa",
                                        "entry_id": "5f9344fd-98d3-309f-a86c-ab10e8d50a67",
                                        "glosses": [
                                            "Qui a subi un outrage, un déshonneur, une atteinte à sa dignité et en ressent encore les conséquences."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9987641a-6602-4c57-9508-5c89bc91a816",
                                                "sense_id": "244096c1-bccd-3507-91d2-6dfd1215c5fa",
                                                "text": "Je suis repartie avec mon orgueil flétri."
                                            }
                                        ]
                                    }
                                ]
                            },
