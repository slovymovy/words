                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "1eea7882-c50e-3f5c-afdd-2bf7db6d2faf",
                        "entry_id": "74b1d779-12b5-3b2f-aea7-f5ff0d4967bf",
                        "glosses": [
                            "The trained muscular structure of a person's body."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ead8a6ae-a2e6-49bc-b0ec-1d4c542ab50f",
                                "sense_id": "1eea7882-c50e-3f5c-afdd-2bf7db6d2faf",
                                "text": "Over the next week, men and women from diverse backgrounds participated in eighteen sports ranging from boxing and billiards to physique, the marathon and volleyball."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b49f2888-5b96-44c4-bb5b-e8340d69eb35",
                        "source_entry_id": "74b1d779-12b5-3b2f-aea7-f5ff0d4967bf",
                        "source_sense_description": "physical structure of a person",
                        "target_lang_word": "Körperbau",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Körperbau",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f3fe09e0-7eb4-364e-bb1e-6535ae0d1e11",
                                        "entry_id": "ad620251-6fa6-3ed4-a638-35975d6c344c",
                                        "glosses": [
                                            "die Art, wie ein menschlicher oder tierischer Körper gebaut ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4abeb82d-0ad4-42c0-b1be-2c4bf227c055",
                                                "sense_id": "f3fe09e0-7eb4-364e-bb1e-6535ae0d1e11",
                                                "text": "Die Fledermäuse haben den grundlegenden Körperbau der Säugetiere."
                                            },
                                            {
                                                "example_id": "e6ae3105-f2f6-458c-beea-94b62754c820",
                                                "sense_id": "f3fe09e0-7eb4-364e-bb1e-6535ae0d1e11",
                                                "text": "„Als Arztsohn mit Interesse an Mathematik und Statistik hatte er sich eingehend mit Daten zum individuellen Körperbau befasst.“"
                                            },
                                            {
                                                "example_id": "681c6618-4c38-4a8a-bdba-d5a2542fd1e1",
                                                "sense_id": "f3fe09e0-7eb4-364e-bb1e-6535ae0d1e11",
                                                "text": "„Er hielt es aber für eine Pflicht der Höflichkeit, gleiches mit gleichem zu vergelten, und so sah er sich die Hunde des jungen Grafen an, und seine Wahl fiel auf Milka, deren breiter Körperbau seine Blicke auf sich gezogen hatte.“"
                                            },
                                            {
                                                "example_id": "7aeddf20-1e50-491a-af65-a80830202ee9",
                                                "sense_id": "f3fe09e0-7eb4-364e-bb1e-6535ae0d1e11",
                                                "text": "„An ihrem Körperbau und an ihrer Gangart war nichts Fremdes, nur eben das Schwächliche, Lebensbehindernde, Blasse.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f1e3879d-20d6-4174-9bc0-42a334bc07cc",
                        "source_entry_id": "74b1d779-12b5-3b2f-aea7-f5ff0d4967bf",
                        "source_sense_description": "physical structure of a person",
                        "target_lang_word": "Statur",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
