                "senses": [
                    {
                        "sense_id": "778f8a6b-441a-3c84-8e39-4fd40e0db0a3",
                        "entry_id": "d4fefa7f-858e-3c03-9c49-60cf870a1449",
                        "glosses": [
                            "Que l’on peut taxer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ba423dd-ccc1-41cd-8990-0535d44ed391",
                                "sense_id": "778f8a6b-441a-3c84-8e39-4fd40e0db0a3",
                                "text": "Les dépens sont toujours taxatifs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7cd2f1e8-ece8-4902-b6d2-cec31753623b",
                        "source_entry_id": "d4fefa7f-858e-3c03-9c49-60cf870a1449",
                        "source_sense_id": "778f8a6b-441a-3c84-8e39-4fd40e0db0a3",
                        "target_lang_word": "taxativ",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "taxativ",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bda2e536-1265-3f74-a272-c71f8a2b7820",
                                        "entry_id": "ee5dc53d-5719-31df-9ed6-9848c9f5e97b",
                                        "glosses": [
                                            "vollständig, erschöpfend"
                                        ],
                                        "tags": [
                                            "besonders österreichisch amtssprachlich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ebb1163b-9891-442c-bff4-e88b1123af97",
                                                "sense_id": "bda2e536-1265-3f74-a272-c71f8a2b7820",
                                                "text": "Eine taxative Auflistung der Himmelsrichtungen ist: Westen, Norden, Osten und Süden."
                                            },
                                            {
                                                "example_id": "292cffc9-114f-4bcc-948c-55b2edca8c9a",
                                                "sense_id": "bda2e536-1265-3f74-a272-c71f8a2b7820",
                                                "text": "Die genehmigungspflichtigen Gewerbe sind in § 94 GewO taxativ aufgezählt (zB Waffengewerbe, Baumeister, Elektrotechniker, Inkassoinstitute)."
                                            },
                                            {
                                                "example_id": "1e99ebf2-a42f-4c24-b0f2-7bc13b169a38",
                                                "sense_id": "bda2e536-1265-3f74-a272-c71f8a2b7820",
                                                "text": "Die Anschauung des Rekursgerichtes, daß in den §§ 370 und 371 EO. die Titel, auf Grund deren eine Exekution zur Sicherstellung bewilligt werden kann, taxativ ausgezählt sind, […]"
                                            },
                                            {
                                                "example_id": "f4bbb584-d232-4b5e-869d-2a0e068000ba",
                                                "sense_id": "bda2e536-1265-3f74-a272-c71f8a2b7820",
                                                "text": "Artikel 8 zählte dagegen die gemeinsamen Kompetenzen auf, bei den taxativ aufgeführten Angelegenheiten lagen die Befugnisse primär bei den Organen der Tschechoslowakischen Republik, […]"
                                            },
                                            {
                                                "example_id": "ba818cfe-c26b-4ec4-8a65-8e18f4731619",
                                                "sense_id": "bda2e536-1265-3f74-a272-c71f8a2b7820",
                                                "text": "Bei einer Zuordnung im Wege der Enumeration ist die Aufzählung daraufhin zu untersuchen, ob sie taxativ oder demonstrativ ist."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0c81de9c-1058-431f-a9e0-3ea935d36f13",
                        "source_entry_id": "d4fefa7f-858e-3c03-9c49-60cf870a1449",
                        "source_sense_id": "778f8a6b-441a-3c84-8e39-4fd40e0db0a3",
                        "target_lang_word": "taxative",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "taxative",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1361ad0e-47ac-3135-8347-59f2802fb10a",
                                        "entry_id": "19cfbdfa-7694-3126-bd28-410f298aca9f",
                                        "glosses": [
                                            "Relating to taxation."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d32f1485-a5ff-401a-9057-b188f9e8886f",
                                                "sense_id": "1361ad0e-47ac-3135-8347-59f2802fb10a",
                                                "text": "We gather from this that the taxative machinery of the exchequer — that is, the visits of the barons to the different towns and county courts for the purpose of rating the feudal aids and assessing Danegeld — […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e0014bc-1345-3415-a126-a1e13a61a0ee",
                                        "entry_id": "19cfbdfa-7694-3126-bd28-410f298aca9f",
                                        "glosses": [
                                            "Exhaustive, comprehensive."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4705b05e-ec1d-4a69-aa09-2b007333caeb",
                                                "sense_id": "9e0014bc-1345-3415-a126-a1e13a61a0ee",
                                                "text": "They are merely demonstrative, not taxative."
                                            },
                                            {
                                                "example_id": "f4d84ce1-a674-4a82-b774-43b7a0bbba46",
                                                "sense_id": "9e0014bc-1345-3415-a126-a1e13a61a0ee",
                                                "text": "It was held that the description was indicative of the identity of the lands, but not taxative as to the extent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
