                "senses": [
                    {
                        "sense_id": "ccaf7146-451b-3679-8d5d-deaa0605edff",
                        "entry_id": "0fa6eaf0-7ef3-3f49-a097-6136fde982dd",
                        "glosses": [
                            "Halsausschnitt an einem Kleidungsstück in der Form des Buchstabens V"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66e85f83-2ad8-41e1-a015-0e82e8813fae",
                                "sense_id": "ccaf7146-451b-3679-8d5d-deaa0605edff",
                                "text": "„Die dunklen Haare sind glatt gefönt, er trägt ein rosa Hemd, darüber einen dunklen Pullover mit V-Ausschnitt.“"
                            },
                            {
                                "example_id": "ae4159f7-1f0e-4475-a6df-8eab9b02c44c",
                                "sense_id": "ccaf7146-451b-3679-8d5d-deaa0605edff",
                                "text": "„In Jeans, Polohemd und einem Pullover mit V-Ausschnitt hätte er genauso ausgesehen wie Millionen anderer junger Männer auch, wäre da nicht dieser durchdringende Blick gewesen, mit dem er ständig die Umgebung sondierte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
