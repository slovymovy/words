                        "target_lang_word": "сырьё",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "сырьё",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "fee23838-9887-3d40-9a2c-8aa1e6a07494",
                                        "entry_id": "3f6e7543-62b3-3fed-ae2c-e6dfd3ac5391",
                                        "glosses": [
                                            "материал, предназначенный для дальнейшей промышленной обработки и изготовления готового продукта"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6727d2cc-8e15-4191-9883-8caa8c849ca1",
                                                "sense_id": "fee23838-9887-3d40-9a2c-8aa1e6a07494",
                                                "text": "Дело в том, что где-то в конце 20-х — начале 30-х годов всё оборудование и сырьё для этой фабрики было куплено у какой-то американской фирмы."
                                            },
                                            {
                                                "example_id": "13c51fdf-6391-42fd-a952-9cb91734ebde",
                                                "sense_id": "fee23838-9887-3d40-9a2c-8aa1e6a07494",
                                                "text": "Способ привлечь интерес промышленности (заставить, если хотите) к переработке сырья в высокотехнологичные изделия, между прочим, давно известен ― это таможенное регулирование."
                                            },
                                            {
                                                "example_id": "5d864815-ccb4-4181-9f7b-c5808cb0cd43",
                                                "sense_id": "fee23838-9887-3d40-9a2c-8aa1e6a07494",
                                                "text": "Качество древесного сырья, с одной стороны, зависит от условий произрастания древостоев, которые влияют на размерные характеристики хлыстов (диаметр и длину) и по которым определяются категория крупности и количество деловых сортиментов, с другой ― от наличия пороков, влияющих на сортность деловых сортиментов."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a88f80b5-06f3-3534-81d0-d627113cb6ee",
                                        "entry_id": "3f6e7543-62b3-3fed-ae2c-e6dfd3ac5391",
                                        "glosses": [
                                            "перен., разг. то, что не до конца отделано, не обработано как следует"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
