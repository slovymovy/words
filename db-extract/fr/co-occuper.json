                "senses": [
                    {
                        "sense_id": "c9c2f74f-4f53-3e88-b9a6-d46f13ea4416",
                        "entry_id": "0bb7445c-8f40-3b52-a4f0-b2aa9014ad2c",
                        "glosses": [
                            "Occuper en commun."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3dde5237-39dc-4a27-9adc-d06d9658ad28",
                                "sense_id": "c9c2f74f-4f53-3e88-b9a6-d46f13ea4416",
                                "text": "Le propriétaire co-occupe."
                            },
                            {
                                "example_id": "4655a73d-96cc-41dd-81ab-f66daf27f021",
                                "sense_id": "c9c2f74f-4f53-3e88-b9a6-d46f13ea4416",
                                "text": "Je dois me co-occuper d'une playliste pour une soirée en novembre dont le thème porte sur les années trente."
                            },
                            {
                                "example_id": "b2e915eb-3d2e-4ea1-aebd-1717178951e2",
                                "sense_id": "c9c2f74f-4f53-3e88-b9a6-d46f13ea4416",
                                "text": "Les partenaires de pavillon préfèrent co-occuper un espace commun, car ils savent qu'ils seraient noyés dans les grandes salles d'exposition s'ils présentaient des stands individuels et que, de par sa taille, le pavillon attire un plus grand nombre de visiteurs."
                            }
                        ]
                    }
