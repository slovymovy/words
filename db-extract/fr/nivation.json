                "senses": [
                    {
                        "sense_id": "799925d9-cc06-366a-ae21-006644f3d278",
                        "entry_id": "d87b4f90-442a-3186-b02f-10c8b09dd813",
                        "glosses": [
                            "Transformation du sol sous l’effet de la neige."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d38c71a-c8a8-4c68-b870-df8bf1469fc6",
                                "sense_id": "799925d9-cc06-366a-ae21-006644f3d278",
                                "text": "Il convient de distinguer les cirques des niches de nivation, plus petites et des amphithéâtres glaciaires, en bout de vallée glaciaire."
                            },
                            {
                                "example_id": "7f733260-b150-438b-9e0b-231277bdf011",
                                "sense_id": "799925d9-cc06-366a-ae21-006644f3d278",
                                "text": "Au-dessous, nous retrouvons le cortège nivo-périglaciaire habituel: cirques de nivation, cailloutis gélifractés."
                            },
                            {
                                "example_id": "b9cd6014-481d-4b75-8e92-af54d62ebe0a",
                                "sense_id": "799925d9-cc06-366a-ae21-006644f3d278",
                                "text": "Vallée après vallée, j’ai exploré la nivation tardive sur les versants tournés vers le nord et particulièrement le nord-est qui subit le vent de l’inlandsis, les glissements de terrain, les loupes de solifluxion."
                            }
                        ]
                    }
                ],
