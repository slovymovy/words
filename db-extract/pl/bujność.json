                        ],
                        "examples": [
                            {
                                "example_id": "04ff2548-f2c6-472d-aa5d-debeb5ac37ae",
                                "sense_id": "17083f39-bd30-3bf1-b568-cd0459d043f5",
                                "text": "Ilość wody spadającej rocznie z atmosfery stanowi wraz z wymiarem ciepła o bujności wegetacji miejscowej.",
                                "translation": "The amount of water falling annually from the atmosphere, along with the level of warmth, determines the lushness of a place's vegetation.",
                                "english": "The amount of water falling annually from the atmosphere, along with the level of warmth, determines the lushness of a place's vegetation."
                            },
                            {
                                "example_id": "5e52e0f7-2edf-4ce0-b85f-6acf9417cbd3",
                                "sense_id": "17083f39-bd30-3bf1-b568-cd0459d043f5",
                                "text": "... stojąc przed komodą rozczesywała czarne, zadziwiającej bujności włosy.",
                                "translation": "... standing in front of the chest of drawers, she was brushing her black hair of amazing luxuriance.",
                                "english": "... standing in front of the chest of drawers, she was brushing her black hair of amazing luxuriance."
                            }
                        ]
