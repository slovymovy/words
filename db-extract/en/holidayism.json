        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "5be65201-4e57-3b47-9e36-253ce38f4f9e",
                "word": "holidayism",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "89ff79f0-710c-3f92-89c8-1ed6a7341e1b",
                        "entry_id": "5be65201-4e57-3b47-9e36-253ce38f4f9e",
                        "glosses": [
                            "The tendency to treat the Sabbath as a day off rather than a solemn religious occasion."
                        ],
                        "tags": [
                            "dated",
                            "derogatory",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "03319be2-0840-49e8-9151-a2d62f1ffb15",
                                "sense_id": "89ff79f0-710c-3f92-89c8-1ed6a7341e1b",
                                "text": "The tide of holidayism which came into Christianity with the Sunday has never been checked, even temporarily, by any other authority. Divine authority alone can make a Sabbath; whatever is less than that, cannot rise above holidayism."
                            },
                            {
                                "example_id": "6bc0c1e7-1671-4875-8925-9bf59f133503",
                                "sense_id": "89ff79f0-710c-3f92-89c8-1ed6a7341e1b",
                                "text": "And now, slain by their folly and error, these same Christian leaders sink willingly into holidayism, or wail in wondering weakness over the fact that they must reap what they and their ancestors have sown."
                            }
                        ]
                    },
                    {
                        "sense_id": "8b78cde9-a7e5-3c0c-9549-dbad720381e0",
                        "entry_id": "5be65201-4e57-3b47-9e36-253ce38f4f9e",
                        "glosses": [
                            "Holiday spirits; holiday cheer."
                        ],
                        "tags": [
                            "dated",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "acea9b16-b380-4283-baca-4d588f12daa8",
                                "sense_id": "8b78cde9-a7e5-3c0c-9549-dbad720381e0",
                                "text": "We will now suppose it Wednesday, all sunshine and holidayism. The town overflowed with the human tide, but it was somewhat muddy: the million is the better of being filtered."
                            }
                        ]
                    }
                ],
