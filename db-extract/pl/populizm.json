                        ],
                        "form": "populizmie"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f97173b5-d2d0-3635-a1d7-408734da0ccd",
                        "entry_id": "75b9ce1f-8891-3ff5-be81-c6a0c4d0a691",
                        "glosses": [
                            "popieranie idei politycznych i ekonomicznych, które są w danym momencie najbardziej popularne w celu łatwego zdobycia poparcia bez zwracania uwagi na rzeczywistą możliwość zrealizowania obietnic, zwłaszcza pod kątem finansowym"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d85b0a0b-9754-4e9c-8391-64434a865721",
                        "source_entry_id": "75b9ce1f-8891-3ff5-be81-c6a0c4d0a691",
                        "source_sense_id": "f97173b5-d2d0-3635-a1d7-408734da0ccd",
                        "target_lang_word": "populism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "populism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "528a995e-2feb-356c-bc43-fd1700997f34",
                                        "entry_id": "7346dc07-ee68-3ea8-aafe-c350c16d87e1",
                                        "glosses": [
                                            "A political doctrine or philosophy that proposes that the rights and powers of ordinary people are exploited by a privileged elite, and supports their struggle to overcome this."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2fa2eb13-6aed-39fc-8925-2e5588d4c8ff",
                                        "entry_id": "7346dc07-ee68-3ea8-aafe-c350c16d87e1",
                                        "glosses": [
                                            "The practice of appealing to the interests of the common people."
                                        ],
                                        "tags": [
                                            "countable",
                                            "derogatory",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20a596aa-4007-4cd8-8784-aa6977acdebf",
                                                "sense_id": "2fa2eb13-6aed-39fc-8925-2e5588d4c8ff",
                                                "text": "It is not crass populism or majoritanianism that ratifies the legitimacy of the polity or the administration."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "40bd9f53-9fe9-4fee-b0ea-e1964d9da81d",
                        "source_entry_id": "75b9ce1f-8891-3ff5-be81-c6a0c4d0a691",
                        "source_sense_id": "f97173b5-d2d0-3635-a1d7-408734da0ccd",
                        "target_lang_word": "populisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "populisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "331d44e5-6dd3-379a-8f74-189efe9ba1fb",
                                        "entry_id": "be973034-3151-3156-9d4b-8beae3defcd1",
                                        "glosses": [
                                            "Discours politique favorable aux classes défavorisées, et souvent hostile aux élites."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77504d7c-3780-4d90-9693-428fa03ddd00",
                                                "sense_id": "331d44e5-6dd3-379a-8f74-189efe9ba1fb",
                                                "text": "L’héritage Johnson reste bien ancré : « L’identité britannique se construit de plus en plus en opposition avec l’identité européenne, et le populisme antieuropéen et antifrançais devrait fonctionner encore longtemps », poursuit Gilles Leydier, professeur et spécialiste de la Grande-Bretagne à l’université du Sud Toulon-Var."
                                            },
                                            {
                                                "example_id": "b5138bb0-5c36-4222-bafd-bcfa817483ff",
                                                "sense_id": "331d44e5-6dd3-379a-8f74-189efe9ba1fb",
                                                "text": "Est-ce faire du populisme de bas étage que de trouver qu’un salaire mensuel de 15.117 € pour un collaborateur du ministre du Budget c’est purement et simplement scandaleux ?"
                                            },
                                            {
                                                "example_id": "23577141-7118-4a84-ab55-2f61b49c6b10",
                                                "sense_id": "331d44e5-6dd3-379a-8f74-189efe9ba1fb",
                                                "text": "Les responsables politiques et les journalistes voient du populisme partout où s’expriment des positions allant à l’encontre d’une doxa très large sur laquelle s’entendent les partis politiques traditionnels, ceux qui, en France, en Allemagne ou aux Etats-Unis, ont gouverné en alternance ou en coalition."
                                            },
                                            {
                                                "example_id": "eb446d6b-9dda-4619-9ad4-1eb09c99bade",
                                                "sense_id": "331d44e5-6dd3-379a-8f74-189efe9ba1fb",
                                                "text": "Sous ce mot, on range aussi bien des mouvements néonazis comme L’Aube dorée, en Grèce, les partis conservateurs de l’ancienne Europe de l’Est, comme celui de Victor Orban en Hongrie, un parti d’extrême gauche comme Syriza, un personnage hérétique comme Donald Trump et le Mouvement 5 étoiles qui se dit « ni de droite ni de gauche ». De là à conclure que le mot « populisme » sert à désigner tout ce qui dérange la mondialisation heureuse et qu’on n’arrive pas à comprendre, il n’y a qu’un pas qu’on serait tenté de franchir."
                                            },
                                            {
                                                "example_id": "6fccf13e-4911-4697-83af-1734336cefc8",
                                                "sense_id": "331d44e5-6dd3-379a-8f74-189efe9ba1fb",
                                                "text": "Mais le populisme est un récit idéologique qui se met à l’abri des atteintes de la réalité, et se fonde sur la désignation d’un ennemi affublé de tous les vices, les élites du savoir et de la compétence."
                                            },
                                            {
                                                "example_id": "69ca16ee-5189-4fc3-a819-f66622408427",
                                                "sense_id": "331d44e5-6dd3-379a-8f74-189efe9ba1fb",
                                                "text": "Cette doctrine, il la construit de manière arbitraire, à partir d’éléments provenant de sources très hétérogènes et en reprenant les clichés déjà exposés dans la plupart des critiques du populisme. [La définition de Pierre Rosanvalon] n’apporte rien à la thèse, reprise par de nombreux auteurs, selon laquelle le populisme consiste à opposer un « peuple pur » à une « élite corrompue » et à concevoir la politique comme l’expression immédiate de la « volonté générale » du peuple."
                                            },
                                            {
                                                "example_id": "762780ed-582b-47c3-9fa5-b32e6aa279b2",
                                                "sense_id": "331d44e5-6dd3-379a-8f74-189efe9ba1fb",
                                                "text": "Ouvriers et employés quittent le jeu électoral ou ventilent leurs suffrages vers des partis qui, s’ils ne représentent pas leurs intérêts économiques, se définissent contre les élites libérales. « Si l’on veut comprendre la montée du “populisme”, écrit Piketty, il n’est pas inutile de commencer par analyser cette montée en puissance de “l’élitisme”. »"
                                            },
                                            {
                                                "example_id": "e783e4dc-8916-4085-86a4-d242a3eab1b3",
                                                "sense_id": "331d44e5-6dd3-379a-8f74-189efe9ba1fb",
                                                "text": "En outre, parmi les spécialistes français de l’extrême droite, historiens ou politistes, ce sont d’autres concepts – notamment ceux de « populisme » ou de « national-populisme » – qui furent rapidement employés pour caractériser les idées et les organisations d’extrême droite réalisant alors une percée électorale, et qui contribuèrent non seulement à obscurcir la compréhension des extrêmes droites, notamment la continuité avec la matrice fasciste, mais aussi à minorer le danger."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19ac4c00-1a2c-3f7e-adcc-f923c582bb69",
                                        "entry_id": "be973034-3151-3156-9d4b-8beae3defcd1",
                                        "glosses": [
                                            "Courant de pensée qui se développe dans la Russie de la seconde moitié du XIXe siècle et qui prône un développement économique non industriel, sinon ouvrier et centré autour de la communauté paysanne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3016f825-9d61-47f5-9552-7489a2a38368",
                                                "sense_id": "19ac4c00-1a2c-3f7e-adcc-f923c582bb69",
                                                "text": "(...) se développe une pensée matérialiste et scientifique, laquelle, évoluant progressivement vers le narodnitchestvo, le populisme, affirme le projet de libérer la masse paysanne de sa misère matérielle. Refusant l'industrialisation de la Russie, les populistes se réclament d'un socialisme coopératif, organisé autour du mir, la commune paysanne dont ils font la cheville ouvrière du développement économique de la Russie. Le populisme apparaît comme un mouvement spécifiquement russe (...)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7416272-5744-3297-a64e-cb1421859f70",
                                        "entry_id": "be973034-3151-3156-9d4b-8beae3defcd1",
                                        "glosses": [
                                            "Courant littéraire français cherchant à dépeindre avec réalisme la vie des gens du peuple."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7f8888c-8ac8-4730-b0ff-d9b083a7dae3",
                                                "sense_id": "c7416272-5744-3297-a64e-cb1421859f70",
                                                "text": "Le populisme n’est pas destiné au peuple mis en scène, incapable de l’apprécier."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3973e5d6-4f79-4157-9e3e-d27986d4cbcf",
                        "source_entry_id": "75b9ce1f-8891-3ff5-be81-c6a0c4d0a691",
                        "source_sense_id": "f97173b5-d2d0-3635-a1d7-408734da0ccd",
                        "target_lang_word": "populismo",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "populismo",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "73e8d656-5abe-3a2a-a35a-cca9ffc0a2d3",
                                        "entry_id": "bd48db72-b7ca-383f-a0d8-8bb1c7877cfd",
                                        "glosses": [
                                            "Actitud política que consiste en atraer al pueblo convenciéndolo de que está siendo explotado por una élite o clase más privilegiada."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [],
