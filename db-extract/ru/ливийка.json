                        "form": "ливи́йках"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7bbf5ae7-4fa9-3252-b3bc-0506a57c9ebc",
                        "entry_id": "ebdd8df5-1847-32bd-9e69-542ff73dfe00",
                        "glosses": [
                            "гражданка, жительница или уроженка Ливии"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "714dc717-f088-4f7f-803e-fd5d1bcb2b28",
                                "sense_id": "7bbf5ae7-4fa9-3252-b3bc-0506a57c9ebc",
                                "text": "Теперь Мику (его настоящее имя Майкл Холлбрук Пенниман, он рожденный в Бейруте сын ливийки и американца) сравнивают с имеющим похожие корни и похожий голос Фредди Меркьюри"
                            }
                        ]
                    },
                    {
                        "sense_id": "ca0fa858-4fe4-3021-b018-eff875d72402",
                        "entry_id": "ebdd8df5-1847-32bd-9e69-542ff73dfe00",
                        "glosses": [
                            "истор. представительница народа, обитавшего западнее Древнего Египта"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "296fd013-5030-40f5-9fb3-b1e1a36cfd12",
                                "sense_id": "ca0fa858-4fe4-3021-b018-eff875d72402",
                                "text": "Фебово сердце смеялось, когда приспели впервые // Сроки Карнейских торжеств и в кругу белокурых ливиек // Начали пляс, доспехи надев, браноносные мужи"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8bfb591e-c708-40b8-b19d-7f842ddf8971",
                        "source_entry_id": "ebdd8df5-1847-32bd-9e69-542ff73dfe00",
                        "target_lang_word": "Libyan",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Libyan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "07fbc68e-1a28-342d-9ace-8b40fcf530ec",
                                        "entry_id": "2e08f777-f4d5-3408-b95a-13b306683eef",
                                        "glosses": [
                                            "Of, from, or pertaining to Libya."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4c17c51-f2bd-4572-b168-19a5e696d88f",
                                                "sense_id": "07fbc68e-1a28-342d-9ace-8b40fcf530ec",
                                                "text": "More than 40,000 would-be migrants to Europe have been intercepted at sea since Italy began paying and equipping the Libyan coastguard to do so in 2017."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Libyan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d876b474-acac-3929-8814-d3acbabd8bf9",
                                        "entry_id": "cf54bb75-47d6-3846-ac7f-6512bb287c45",
                                        "glosses": [
                                            "A person from Libya or of Libyan descent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18556753-a8b9-4585-a46a-225404ee7d46",
                                                "sense_id": "d876b474-acac-3929-8814-d3acbabd8bf9",
                                                "text": "No one in Faya forgets that French air force raids drove the Libyans out of Faya, prompting them to abandon their tanks with less than Gaddafian revolutionary zeal and hightail it back home on foot."
                                            },
                                            {
                                                "example_id": "f37c36a1-9dee-4249-9c3b-b064d82b050a",
                                                "sense_id": "d876b474-acac-3929-8814-d3acbabd8bf9",
                                                "text": "Their frustration has surfaced in protests in several Libyan cities over the last few days, most notably in Benghazi, the seat of the revolution, where Libyans stormed the National Transitional Council building."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Libyan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c1ea5967-81c8-3d17-8824-6d63e728c7a3",
                                        "entry_id": "d312509b-8e34-3cc4-94bd-caae8b1736e6",
                                        "glosses": [
                                            "The Libyan Arabic language."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
