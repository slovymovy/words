                "senses": [
                    {
                        "sense_id": "59b5cadb-19d0-3896-baee-965033d66c6c",
                        "entry_id": "73426248-b175-3b02-82a7-176af0046a22",
                        "glosses": [
                            "Constituer un doublon ; être en redondance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "360a876a-5130-4a15-a18f-87d9bac53ab4",
                                "sense_id": "59b5cadb-19d0-3896-baee-965033d66c6c",
                                "text": "Dans un système décentralisé, il importe d'éviter que les activités de collecte de données ne doublonnent constamment, afin d'éviter que plusieurs administrations ne communiquent des données différentes sur la même dette."
                            },
                            {
                                "example_id": "fc8a66f8-e4b4-4e2a-8c56-f697285211db",
                                "sense_id": "59b5cadb-19d0-3896-baee-965033d66c6c",
                                "text": "Pourquoi la ligne Maginot s'arrêtait-elle aux Ardennes alors que sur une partie de son parcours elle y doublonnait la défense naturelle que constituait le Rhin […]."
                            },
                            {
                                "example_id": "f6e3dabd-6754-4f91-a351-07de66c9be94",
                                "sense_id": "59b5cadb-19d0-3896-baee-965033d66c6c",
                                "text": "Il défendit la lettre Q quoiqu'elle doublonnât auprès de K et de C."
                            }
                        ]
                    }
