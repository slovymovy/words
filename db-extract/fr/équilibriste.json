        "fr-extract.jsonl": [
            {
                "entry_id": "2153a0db-6ff1-371c-b9e7-afac2ef5510b",
                "word": "équilibriste",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "562a6ab5-de66-4e08-b015-0774b222ec02",
                        "entry_id": "2153a0db-6ff1-371c-b9e7-afac2ef5510b",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "équilibristes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "433e4ee3-8777-344d-a078-ecc5defab845",
                        "entry_id": "2153a0db-6ff1-371c-b9e7-afac2ef5510b",
                        "glosses": [
                            "Celui, celle qui fait des exercices dans des positions où l’équilibre est difficile à garder."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2aec628b-4db0-471f-84d3-a421a30b3664",
                                "sense_id": "433e4ee3-8777-344d-a078-ecc5defab845",
                                "text": "[…] le bon sens ne nie pas qu’il soit agréable et possible de danser avec un pot au lait sur la tête, mais nous prévient seulement que c’est plutôt l’affaire des équilibristes et n’est pas, en tout cas, à la portée de tout le monde […]"
                            },
                            {
                                "example_id": "ab60ffc7-6607-4753-933b-6d61be4f5bfc",
                                "sense_id": "433e4ee3-8777-344d-a078-ecc5defab845",
                                "text": "À foison, nous rencontrions des jongleurs, cracheurs de feu, équilibristes, chanteurs qui cherchaient à travailler : nous les engagions tous."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d14e6b14-680a-4069-abd8-0278dbc56081",
                        "source_entry_id": "2153a0db-6ff1-371c-b9e7-afac2ef5510b",
                        "source_sense_id": "433e4ee3-8777-344d-a078-ecc5defab845",
                        "target_lang_word": "equilibrista",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "equilibrista",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "307eb732-c505-3753-ab76-1681f7713c0d",
                                        "entry_id": "00319730-c77e-307c-9027-eecde0d274ee",
                                        "glosses": [
                                            "chi intrattiene il pubblico mantenendo altre persone o sé stesso in difficili posizioni d'equilibrio"
                                        ],
