                "senses": [
                    {
                        "sense_id": "dbb93c62-ad1e-3f70-a2e1-a70d5759614d",
                        "entry_id": "0645f7de-e906-32d9-81f8-733699246ffa",
                        "glosses": [
                            "Celle qui incite, qui pousse à faire quelque chose."
                        ],
                        "tags": [],
                        "note": "Il se prend le plus souvent en mauvaise part",
                        "examples": [
                            {
                                "example_id": "1d7fae51-1c7a-404b-928b-87cc202915b5",
                                "sense_id": "dbb93c62-ad1e-3f70-a2e1-a70d5759614d",
                                "text": "Elle a été l’animatrice et l’instigatrice de toutes les œuvres d’organisation et de renouveau social, en particulier du mouvement de colonisation."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6cf10e72-7252-421c-84f5-87eb0a8a1a4f",
                        "source_entry_id": "0645f7de-e906-32d9-81f8-733699246ffa",
                        "source_sense_id": "dbb93c62-ad1e-3f70-a2e1-a70d5759614d",
                        "target_lang_word": "Anstifterin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anstifterin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a7486f29-252d-3980-9ba0-42b1bf5a1946",
                                        "entry_id": "e20042ab-ee6f-3100-b280-ea0fc651ae93",
                                        "glosses": [
                                            "weibliche Person, die jemand dazu veranlasst, etwas Falsches/Unrechtmäßiges zu tun"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5528fc4-301d-443e-80ee-234bd6b3e1c3",
                                                "sense_id": "a7486f29-252d-3980-9ba0-42b1bf5a1946",
                                                "text": "Ida hat nicht mitgemacht, sie war nicht dabei, aber sie war ja eigentlich die Anstifterin, weil sie als erste auf die Idee gekommen ist."
                                            },
                                            {
                                                "example_id": "19071417-fdc6-4019-9abe-b45da09663d6",
                                                "sense_id": "a7486f29-252d-3980-9ba0-42b1bf5a1946",
                                                "text": "„Ich sah in ihnen Anstifterinnen meiner schrecklichen Begehrlichkeit, die mich zum Mörder eines leibhaftigen Engels hatte werden lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b8fc15e7-e9a8-4206-8d1c-8e511e595abc",
                        "source_entry_id": "0645f7de-e906-32d9-81f8-733699246ffa",
