                                        "sense_id": "7b63c256-0738-392b-a661-255d0185f33a",
                                        "entry_id": "f080850a-40c7-38ce-9eda-716535b05c2b",
                                        "glosses": [
                                            "Firm, unyielding, determined."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8fc5bde-bc01-4b85-aa46-1e4289200216",
                                                "sense_id": "7b63c256-0738-392b-a661-255d0185f33a",
                                                "text": "She was resolute in her determination to resist his romantic advances."
                                            },
                                            {
                                                "example_id": "040961af-71ce-4510-915b-8fb79a008113",
                                                "sense_id": "7b63c256-0738-392b-a661-255d0185f33a",
                                                "text": "He was resolute in his decision to stay."
                                            },
                                            {
                                                "example_id": "c9e6b19a-b7ca-4f0c-b653-09e98a322c49",
                                                "sense_id": "7b63c256-0738-392b-a661-255d0185f33a",
                                                "text": "Edward is at hand, / Ready to fight; therefore be resolute."
                                            },
                                            {
                                                "example_id": "db7f5b31-2765-4822-8fbb-19831e0e36b8",
                                                "sense_id": "7b63c256-0738-392b-a661-255d0185f33a",
                                                "text": "If the Coward Bumble Bee / In his chimney corner stay, / I, must resoluter be!"
                                            },
                                            {
                                                "example_id": "6ad31df3-016a-4c57-b4d7-58efdc644bc0",
                                                "sense_id": "7b63c256-0738-392b-a661-255d0185f33a",
                                                "text": "Villa had plenty of opportunities to make the game safe after a shaky start and despite not reaching any great heights, they were resolute enough to take control of the game in the second half."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c68fbaad-3d28-3c65-b9f3-14e9d581b572",
