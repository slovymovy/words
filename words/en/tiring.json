                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Working in the garden all day is <w>tiring</w> me out.",
                            "target_lang_translations": {
                                "ru": "Работа в саду весь день меня <w>утомляет</w>.",
