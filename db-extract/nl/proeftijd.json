                "senses": [
                    {
                        "sense_id": "4349aee9-d0fa-3854-87e2-8f49351fc3e7",
                        "entry_id": "01dcd482-d2b4-31f7-9ae2-5ad3554a938d",
                        "glosses": [
                            "een periode waarin men iets of iemand kan uitproberen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee19793c-e2d5-45b4-af28-b5d9f768b1e9",
                                "sense_id": "4349aee9-d0fa-3854-87e2-8f49351fc3e7",
                                "text": "Na een proeftijd van een maand krijgt hij een vaste baan."
                            }
                        ]
                    },
                    {
                        "sense_id": "0cfef9ab-f50f-3c9e-9c63-a47aef01aa55",
                        "entry_id": "01dcd482-d2b4-31f7-9ae2-5ad3554a938d",
                        "glosses": [
                            "een periode waarin men bij het plegen van een strafbaar feit de voorwaardelijke straf alsnog krijg opgelegd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af476e10-deb8-41a6-97c4-b7a52f0dafba",
                                "sense_id": "0cfef9ab-f50f-3c9e-9c63-a47aef01aa55",
                                "text": "Hij kreeg een voorwaardelijke gevangenisstraf van zes maanden met een proeftijd van 2 jaar."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "59d2e4eb-690b-4cc5-9783-62ae87411080",
                        "source_entry_id": "01dcd482-d2b4-31f7-9ae2-5ad3554a938d",
                        "target_lang_word": "Probezeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Probezeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d22c2339-6ced-3219-9213-54497996bb7b",
                                        "entry_id": "293388f7-3e5f-3997-8a22-b3eeefa51ece",
                                        "glosses": [
                                            "„vereinbarter oder gesetzlich angeordneter Zeitraum, während dessen ein Rechtsverhältnis oder eine erteilte Erlaubnis unter erleichterten Bedingungen gelöst bzw. entzogen werden kann.“"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ae02d6c-febb-4c57-992b-86304d87f132",
                                                "sense_id": "d22c2339-6ced-3219-9213-54497996bb7b",
                                                "text": "„Auch mit Verbesserungsvorschlägen halten sich neue Mitarbeiter während der Probezeit deswegen lieber zurück.“"
                                            },
                                            {
                                                "example_id": "78697566-9591-434e-9eb3-301ed72c1eba",
                                                "sense_id": "d22c2339-6ced-3219-9213-54497996bb7b",
                                                "text": "„In der Probezeit wird festgestellt, ob die Schülerin oder der Schüler den Anforderungen der Fachoberschule bzw. der Berufsoberschule gewachsen ist.“"
                                            },
                                            {
                                                "example_id": "4fbc0d99-329d-4034-8bd7-b9f0a622e788",
                                                "sense_id": "d22c2339-6ced-3219-9213-54497996bb7b",
                                                "text": "„Die Probezeit ist nicht bestanden, wenn bei einer Gesamtwürdigung der Leistungen der Schülerin oder des Schülers nicht damit gerechnet werden kann, dass sie oder er das Ziel des Schuljahres erreicht.“"
                                            },
                                            {
                                                "example_id": "4814b236-c195-48f5-b48e-381663bd3e2f",
                                                "sense_id": "d22c2339-6ced-3219-9213-54497996bb7b",
                                                "text": "„Doch das Schicksal machte schon bald meiner bitteren Probezeit ein Ende.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ede467bc-2c5a-3022-8415-0d166019d893",
                                        "entry_id": "293388f7-3e5f-3997-8a22-b3eeefa51ece",
                                        "glosses": [
                                            "Zeitraum, in dem der vollständige oder teilweise Aufschub einer Strafe widerrufen werden kann"
                                        ],
                                        "tags": [
                                            "Austrian German",
                                            "Swiss Standard German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82b59105-be98-4269-a05c-ae79283cd7fe",
                                                "sense_id": "ede467bc-2c5a-3022-8415-0d166019d893",
                                                "text": "„Spricht der Staatsanwalt oder der Richter eine bedingte Strafe aus, entfällt bei Bewährung während der Probezeit die Vollstreckung der Strafe, was zur Folge hat, dass eine Freiheitsstrafe nicht «abgesessen» und eine Geldstrafe nicht bezahlt werden muss.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "20429947-a46a-44b2-90b4-096f0b2ca3ce",
                        "source_entry_id": "01dcd482-d2b4-31f7-9ae2-5ad3554a938d",
                        "target_lang_word": "probation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "probation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7acfc0b1-7512-3f19-a159-b36b831be86d",
                                        "entry_id": "2134ae23-50ea-3400-8ef2-4b3be7744dd9",
                                        "glosses": [
                                            "A period of time when a person occupies a position only conditionally and may be removed if certain conditions are not met."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ca44e1d-645e-48a9-a857-f023fc122b31",
                                                "sense_id": "7acfc0b1-7512-3f19-a159-b36b831be86d",
                                                "text": "You'll be on probation for first six months. After that, if you work out, they'll hire you permanently."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc9638a4-ded9-3e46-9dbc-2a5bcbdcb845",
                                        "entry_id": "2134ae23-50ea-3400-8ef2-4b3be7744dd9",
                                        "glosses": [
                                            "A type of sentence where convicted criminals are permitted to continue living in a community but will automatically be sent to jail if they violate certain conditions."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "828657e1-abf6-4fed-9c0b-b8d3e9132839",
                                                "sense_id": "cc9638a4-ded9-3e46-9dbc-2a5bcbdcb845",
                                                "text": "He got two years probation for robbery."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3eb19d17-06c3-3f9b-8c7a-39391495e1a7",
                                        "entry_id": "2134ae23-50ea-3400-8ef2-4b3be7744dd9",
                                        "glosses": [
                                            "A testing period of time."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "edfa0519-fc73-4b20-9512-6863b75ad2f0",
                                                "sense_id": "3eb19d17-06c3-3f9b-8c7a-39391495e1a7",
                                                "text": "A probation of long and shameful years must be gone through; each one with the endurance more bitter, suffering yet more intolerable, before the debtor can arrive at that system of reckless evasion which is the last stage of poverty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f56909dc-ef77-38e6-aaed-faafe548cebf",
                                        "entry_id": "2134ae23-50ea-3400-8ef2-4b3be7744dd9",
                                        "glosses": [
                                            "The act of testing; proof."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4191af66-dc0e-4b73-b66a-d6f0650c0c84",
                                                "sense_id": "f56909dc-ef77-38e6-aaed-faafe548cebf",
                                                "text": "And I shall proceed to consider the testimony of Experience, when I shall have first advertis'd You, that if Men were as perfectly rational as 'tis to be wish'd they were, this sensible way of Probation would be as needless as 'tis wont to be imperfect."
                                            },
                                            {
                                                "example_id": "166a066c-9e41-4011-91f1-f15b9b6e9cbc",
                                                "sense_id": "f56909dc-ef77-38e6-aaed-faafe548cebf",
                                                "text": "And then it started like a guilty thing / Upon a fearful summons. I have heard, / The cock, that is the trumpet to the morn, / Doth with his lofty and shrill-sounding throat / Awake the god of day; and, at his warning, / Whether in sea or fire, in earth or air / The extravagant and erring spirit hies / To his confine: and of the truth herein / This present object made probation."
                                            },
                                            {
                                                "example_id": "2e735b45-851b-4bd1-9390-a863438947f2",
                                                "sense_id": "f56909dc-ef77-38e6-aaed-faafe548cebf",
                                                "text": "Such assessment of others' organizational morality is a crucial aspect of a more general set of probations that are intrinsic to managerial work."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
