                        "glosses": [
                            "mit Licht, Schein, Schimmer (Glanz) versehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2571a39c-be7d-4677-8146-ef561cb7c5c4",
                                "sense_id": "85359ef5-a283-3be3-8f56-3ba961730fa6",
                                "text": "„Mir aber graute schon lange vor ihm und seinem wilden Gerede, und als er sich nun förmlich zu dem schlafenden Maler herumwandle, benutzte ich die Gelegenheit, schlich, ohne daß er es bemerkte, um den Tisch aus dem Garten heraus und stieg, allein und fröhlich im Herzen, an dem Rebengeländer in das weite, vom Mondschein beglänzte Tal hinunter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
