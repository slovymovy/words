    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "192d534b-9bbd-326f-a836-ce65f6a65ab6",
                    "sense_definition": "To move hands or feet playfully in water or mud.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "water_interaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children sat on the dock and <w>dabbled</w> their feet in the water."
                        },
                        {
                            "text": "It is fun to <w>dabble</w> in the shallow stream on a hot summer day."
                        }
                    ],
                    "common_phrases": [
                        "dabble one's feet"
                    ]
                },
                {
                    "sense_id": "64ae7586-ffe2-3f68-ad7a-439ee89eb3e3",
                    "sense_definition": "To take part in an activity in a casual or superficial way.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "participation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is an actress by trade, but has been known to <w>dabble</w> in poetry."
                        },
                        {
                            "text": "He <w>dabbles</w> in the stock market but does not invest large amounts of money."
                        }
                    ],
                    "common_phrases": [
