                        "source_sense_id": "eedd865c-e59a-341d-bd18-bbbbaf76b558",
                        "source_sense_description": "Fahrzeug, mit dem Milch transportiert wird",
                        "target_lang_word": "milk float",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "milk float",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "da05f3c3-dc3a-3a62-93fc-2eb2906988b6",
                                        "entry_id": "2d95b2d8-c475-377d-a890-15c5d47303ff",
                                        "glosses": [
                                            "An electric accumulator battery-driven vehicle (formerly also horse-drawn), designed for the house-to-house delivery of fresh milk; common in Europe, especially the United Kingdom."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eee920d3-0ea6-44b2-9117-f3807fa543cb",
                                                "sense_id": "da05f3c3-dc3a-3a62-93fc-2eb2906988b6",
                                                "text": "Further clues are provided by milk-floats bearing the legend 'Lord Rayleigh's Dairies: A Family Business', and a number of signs indicating the whereabouts of various departments of Lord Rayleigh's Farms."
                                            },
                                            {
                                                "example_id": "cd350bbe-fe9a-4db6-9096-7385f079a54a",
                                                "sense_id": "da05f3c3-dc3a-3a62-93fc-2eb2906988b6",
                                                "text": "Milk floats were flimsy at the front (especially the three-wheelers) but very strong at the back. They were uncomplicated vehicles. Nothing much could go wrong and, when it did go wrong, the vehicles were relatively easy to repair."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
