                            {
                                "example_id": "32f06b91-89ad-4a85-b210-db61def75624",
                                "sense_id": "244d9e10-e429-35aa-91d6-5d142516d853",
                                "text": "De Canadees David Marcus probeert met zijn paard Capital een perfecte dressuurproef af te werken. Het paard ging alleen zijn geheel eigen weg. Het publiek had er wel waardering voor, de jury iets minder."
                            },
                            {
                                "example_id": "02e24d47-9fa0-40e4-9490-ab8c70310931",
                                "sense_id": "244d9e10-e429-35aa-91d6-5d142516d853",
                                "text": "Lips reed zaterdag zijn dressuurproef en Pen en Heffernan kwamen zondag in actie. Pal voor de proef van Pen, van wie op voorhand het meest was verwacht, barstte een hevig onweer los. De donderklappen leidden tot spanning bij haar sensibele paard Vira, dat daardoor fouten maakte."
                            },
                            {
                                "example_id": "12e28186-df44-424b-aa0c-66a0dba13763",
                                "sense_id": "244d9e10-e429-35aa-91d6-5d142516d853",
                                "text": "Zara Phillips, kleindochter van koningin Elizabeth II, heeft vandaag als ruiter haar debuut gemaakt op de Olympische Spelen. Ze reed een dressuurproef."
                            }
                        ]
                    }
