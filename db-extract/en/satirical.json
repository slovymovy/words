                    {
                        "translation_id": "dafa922d-0580-44d5-ad45-4b885b0c1177",
                        "source_entry_id": "5584377d-6df1-3b5e-ba51-aaa061a7f55d",
                        "source_sense_id": "9393451e-0fda-3396-829c-6ffa45891d81",
                        "source_sense_description": "of or pertaining to satire",
                        "target_lang_word": "satirisch",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "satirisch",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "56a70f55-5c8e-36b5-9923-521228e6c339",
                                        "entry_id": "6fda8b51-c9f4-3218-9336-b88b785a389e",
                                        "glosses": [
                                            "naar de aard van een satire, waarbij iets aan de kaak wordt gesteld"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e38a01a3-ea8f-4a24-a1d2-2dfd72b4286d",
                                                "sense_id": "56a70f55-5c8e-36b5-9923-521228e6c339",
                                                "text": "12 doden door terroristische aanslag op redactie Frans satirisch weekblad 'Charlie Hebdo'."
                                            },
                                            {
                                                "example_id": "d28b144c-1a15-44bb-b8be-422f417dda40",
                                                "sense_id": "56a70f55-5c8e-36b5-9923-521228e6c339",
                                                "text": "Het roept de vraag op waarom in de tien jaar dat The Donald het Amerikaanse politieke landschap domineert de literatuur zo’n laf tegengeluid heeft geproduceerd. De weinige satirische romans die tijdens Trumps eerste termijn verschenen – Dave Eggers’ De kapitein en de Glory (2019) of Howard Jacobsons Pussy (2017) – bleven steken in overdrijving van het evidente: dat Trump een oliedomme, van empathie gespeende pestkop is, een maffiakoning die maatschappelijke onvrede kanaliseert voor eigen ego en gewin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a4170499-c684-40df-991e-ea6931541849",
                        "source_entry_id": "5584377d-6df1-3b5e-ba51-aaa061a7f55d",
                        "source_sense_id": "9393451e-0fda-3396-829c-6ffa45891d81",
                        "source_sense_description": "of or pertaining to satire",
                        "target_lang_word": "satirique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "satirique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "41dd81cb-1cb1-3add-b9cd-f4b45839526f",
                                        "entry_id": "50efbdf8-ada0-3c16-affa-13b7b6d098e4",
                                        "glosses": [
                                            "Qui appartient à la satire ; qui tient de la satire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c42e9f31-9136-4c0a-8d0f-e82fc3857f56",
                                                "sense_id": "41dd81cb-1cb1-3add-b9cd-f4b45839526f",
                                                "text": "Mais, pour répondre à ceux qui pourront m'accuser d'avoir été satirique, je soutiens qu'il a toujours été permis aux gens de lettres de plaisanter sur la vie humaine, pourvu que cette plaisanterie ne dégénérât point en rage et en fureur."
                                            },
                                            {
                                                "example_id": "64bc8158-f2de-4b03-a827-b6c2d56f3258",
                                                "sense_id": "41dd81cb-1cb1-3add-b9cd-f4b45839526f",
                                                "text": "La poésie satirique ne procède pas non plus du latin, les Bibles sont nées à l'aspect des désordres du temps."
                                            },
                                            {
                                                "example_id": "1018cdbe-f161-4eb1-97e8-55221c42acb0",
                                                "sense_id": "41dd81cb-1cb1-3add-b9cd-f4b45839526f",
                                                "text": "Dans le décor des miséricordes, autrefois simple, les huchiers donnent libre cours à leur fantaisie, les groupes sculptés n'ont pas toujours un caractère religieux, la tendance de l'époque au réalisme stimule l'humour et la verve satirique des artistes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e84bdaa3-cd39-32d2-a33b-d9da133b3057",
                                        "entry_id": "50efbdf8-ada0-3c16-affa-13b7b6d098e4",
                                        "glosses": [
                                            "Qui est enclin aux propos mordants ; qui est porté à la médisance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f382661-521b-460c-8ae7-b868e49589af",
                                                "sense_id": "e84bdaa3-cd39-32d2-a33b-d9da133b3057",
                                                "text": "De juillet 1888 à février 1890, Alfred Le Petit réactive son journal satirique de 1871, La Charge, pour en faire un brûlot boulangiste, mais il s'enlise avec le déclin du général."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "satirique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d91951cd-a667-30a8-bbd3-8a1090a460c2",
                                        "entry_id": "55c39418-3e18-3bb2-9760-00e1be22723a",
                                        "glosses": [
                                            "Auteur de satires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20abab41-8740-442a-8e1b-3dccd27bb45c",
                                                "sense_id": "d91951cd-a667-30a8-bbd3-8a1090a460c2",
                                                "text": "Mais les succès de ces convertisseurs bénévoles devaient être considérables, à en juger par les récriminations qu'il souleva de la part des auteurs des Évangiles et par les flèches que leur décochent les satiriques latins."
                                            },
                                            {
                                                "example_id": "47046f86-e348-40ed-aedd-b0ad470ab48f",
                                                "sense_id": "d91951cd-a667-30a8-bbd3-8a1090a460c2",
                                                "text": "La France n'aime plus les moralistes : ils posent des problèmes qui n'existent pas. Elle n'aime plus les satiriques : ils dérangent l'ordre présent des valeurs. Approfondir, soit, contester, non."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "299ccd27-466b-4319-b551-0c9d219075e4",
                        "source_entry_id": "5584377d-6df1-3b5e-ba51-aaa061a7f55d",
                        "source_sense_id": "9393451e-0fda-3396-829c-6ffa45891d81",
                        "source_sense_description": "of or pertaining to satire",
                        "target_lang_word": "satirisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "satirisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d9ea8737-8f29-38f1-b2ff-32153d30bd0e",
                                        "entry_id": "5e9d10cd-aa72-3312-ae9f-71ff093fa59c",
                                        "glosses": [
                                            "nach Art oder mit den Mitteln der Satire: jemanden (beispielsweise einen Politiker), seine Ideen oder etwas (beispielsweise gesellschaftliche Missstände) humorvoll kritisierend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67f28d8b-8840-42e7-882e-d5f8c09b5bbf",
                                                "sense_id": "d9ea8737-8f29-38f1-b2ff-32153d30bd0e",
                                                "text": "Der Flughafen Berlin-Brandenburg, die Elbphilharmonie, Stuttgart 21, der Neubau des Klinikums Bremen-Mitte: die Pannen und Kostensteigerungen öffentlicher Großprojekte in Deutschland kann man nur noch satirisch würdigen."
                                            },
                                            {
                                                "example_id": "1808c691-03ab-4e8a-8003-349991a0638b",
                                                "sense_id": "d9ea8737-8f29-38f1-b2ff-32153d30bd0e",
                                                "text": "„Mit seinem satirischen Bestseller ‚Der Untertan‘ ist Heinrich Mann in die Literaturgeschichte eingegangen.“"
                                            },
                                            {
                                                "example_id": "ff882ec8-9ec7-4dcc-adc5-9e6011afe00c",
                                                "sense_id": "d9ea8737-8f29-38f1-b2ff-32153d30bd0e",
                                                "text": "„Ihr Text ist spaßig, voller satirischer Anspielungen auf den philosophischen Ehrgeiz von Autoren und die Meinungsmache von Literaturfunktionären.“"
                                            },
                                            {
                                                "example_id": "5bd3f0cb-e287-4de9-ace8-9d268b19a593",
                                                "sense_id": "d9ea8737-8f29-38f1-b2ff-32153d30bd0e",
                                                "text": "„Der […] Text nimmt satirisch den Alltagsbetrieb an der Badischen Landeskunstschule […] aufs Korn, an der Georg Scholz von 1925 bis 1933 eine Professur hatte.“"
                                            },
                                            {
                                                "example_id": "33e1993f-7bd6-4282-b9d4-83822f60e097",
                                                "sense_id": "d9ea8737-8f29-38f1-b2ff-32153d30bd0e",
                                                "text": "„Die deutsche Tageszeitung ‚taz‘ hatte den Zwillingsbruder des neuen Ministerpräsidenten, den polnischen Präsidenten Lech Kaczyński, satirisch als ‚Polens neue Kartoffel‘ bezeichnet.“"
                                            },
                                            {
                                                "example_id": "a75691c3-a431-448f-b235-ee21f3bda6e7",
                                                "sense_id": "d9ea8737-8f29-38f1-b2ff-32153d30bd0e",
                                                "text": "„Dementsprechend sollte die zentrale Frage an jeden satirischen Beitrag, egal in welchem Medium, sein: ‚Wer ist der Feind?‘ Oder, wem das zu martialisch klingt: ‚Wer ist verantwortlich für einen (veränderbaren) schlechten Zustand?‘“"
                                            },
                                            {
                                                "example_id": "4bbd204c-04f4-4b19-8ae4-e90665a7569d",
                                                "sense_id": "d9ea8737-8f29-38f1-b2ff-32153d30bd0e",
                                                "text": "„In den sozialen Medien erntete die AfD viel Gegenwind für das Meldeportal[, auf der sich Schüler und Eltern über Lehrer beschweren können]. Einzelne User und die Partei der Freien Demokraten riefen dazu auf, das Portal mit satirischen Nachrichten zu überfluten, um es so zu blockieren.“"
                                            },
                                            {
                                                "example_id": "854c2126-5127-4990-a2fb-03ca1f15ca5d",
                                                "sense_id": "d9ea8737-8f29-38f1-b2ff-32153d30bd0e",
                                                "text": "„Sachliche Aufklärung hilft [gegen eine angebliche Umbenennung des Dresdner Striezelmarktes in sozialen Medien] offenbar nicht. Das kleine Internetlexikon Pluspedia frotzelt satirisch dagegen: ‚Noch vor der Eroberung von Konstantinopel und der Belagerung Wiens eilen die Dresdener voreilend und nennen ihren Weihnachtsmarkt Striezelmarkt. […]‘“"
                                            },
                                            {
                                                "example_id": "b84bc83f-62e1-41f0-b02d-56c5a499ad4b",
                                                "sense_id": "d9ea8737-8f29-38f1-b2ff-32153d30bd0e",
                                                "text": "Voltaire setzt in „Candide“ dem philosophischen Optimismus seiner Zeitgenossen den philosophischen Pessimismus entgegen und brilliert durch seine realistische, wenngleich satirisch verzerrte, Schilderung der Korruption innerhalb der Gesellschaft."
                                            },
                                            {
                                                "example_id": "0fb4daab-99bb-4b06-b1f1-07c248c705b2",
                                                "sense_id": "d9ea8737-8f29-38f1-b2ff-32153d30bd0e",
                                                "text": "„Die satirische «heute show» bezeichnet Mario Barth als «Volltrottel». Barth selbst sagt, er mache Comedy für seine Fans, nicht für die Medien.“"
                                            },
                                            {
                                                "example_id": "4eeff1e1-bec8-4403-90d0-c5265eb6c732",
                                                "sense_id": "d9ea8737-8f29-38f1-b2ff-32153d30bd0e",
                                                "text": "„Das [französische] Magazin [Charlie Hebdo] hatte die in der dänischen Zeitung ‚Jyllands-Posten‘ zuerst veröffentlichten satirischen Darstellungen des Propheten Mohammed im Februar 2006 nachgedruckt und mit eigenen Karikaturen ergänzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
