                "senses": [
                    {
                        "sense_id": "c0b7639b-07a3-30a2-8965-0466cefad068",
                        "entry_id": "25ccee83-4dd8-38b6-a1e5-4b6110c37660",
                        "glosses": [
                            "rechtop staand op een surfplank je met een peddel voortbewegen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e1b5b9c-f31c-4a06-aa8b-f6144cb295f4",
                                "sense_id": "c0b7639b-07a3-30a2-8965-0466cefad068",
                                "text": "Officieel heet het stand up paddle boarding of peddelsurfen, maar zeg gerust suppen. Terwijl je rechtop op een al dan niet opblaasbaar supboard staat, klief je met een twee meter lange peddel door het water. Mits wat goede stroming en wat oefening kan je zo een snelheid halen van om en bij de tien kilometer per uur."
                            },
                            {
                                "example_id": "3678064b-ea64-4d50-b0f8-47635653e8fd",
                                "sense_id": "c0b7639b-07a3-30a2-8965-0466cefad068",
                                "text": "Merijn Tinga (44) is druk bezig met de voorbereidingen van een nieuw groot project. In juni wil hij 1.300 kilometer gaan peddelsurfen (suppen), de Rijn af van Zwitserland naar Nederland. Tijdens zijn reis wil hij met bekende Nederlanders en specialisten plastic uit de rivier halen."
                            }
                        ]
                    }
