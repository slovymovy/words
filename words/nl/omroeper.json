{
    "word_family": [
        "omroepen",
        "omroep",
        "omroepster"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "34256e4a-b431-31a4-8830-57f9804fb0de",
                    "sense_definition": "Een persoon die televisie- of radioprogramma's aankondigt",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "omroeper_media",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De bekende <w>omroeper</w> wenste alle kijkers een hele fijne avond toe.",
                            "target_lang_translations": {
                                "en": "The famous <w>announcer</w> wished all viewers a very pleasant evening."
                            }
                        },
                        {
                            "text": "Tegenwoordig zie je bijna geen <w>omroeper</w> meer op de televisie.",
                            "target_lang_translations": {
                                "en": "Nowadays you hardly see an <w>announcer</w> on television anymore."
                            }
                        }
                    ],
                    "synonyms": [
                        "presentator"
                    ],
                    "common_phrases": [
                        "televisie en radio omroeper"
                    ],
                    "target_lang_definitions": {
                        "en": "A person who announces television or radio programs"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "announcer",
                                "target_lang_sense_clarification": "on television or radio"
                            },
                            {
                                "target_lang_word": "broadcaster",
                                "target_lang_sense_clarification": "media presenter"
                            },
                            {
                                "target_lang_word": "presenter",
                                "target_lang_sense_clarification": "TV or radio host"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "271defb4-3a93-3e39-9744-769379fb0493",
                    "sense_definition": "Een persoon die mededelingen doet aan een grote groep mensen, bijvoorbeeld op een station of evenement",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "omroeper_algemeen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>omroeper</w> op het station meldde dat de trein naar Utrecht vertraging had.",
                            "target_lang_translations": {
                                "en": "The <w>announcer</w> at the station reported that the train to Utrecht was delayed."
                            }
                        },
                        {
                            "text": "Dankzij de duidelijke stem van de <w>omroeper</w> wist iedereen direct waar ze heen moesten.",
                            "target_lang_translations": {
                                "en": "Thanks to the clear voice of the <w>announcer</w>, everyone knew immediately where they had to go."
                            }
                        }
                    ],
                    "synonyms": [
                        "boodschapper",
                        "omroeper"
                    ],
                    "common_phrases": [
                        "de omroeper op het station"
                    ],
                    "target_lang_definitions": {
                        "en": "A person who makes announcements to a large group of people, for example at a station or event"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "announcer",
                                "target_lang_sense_clarification": "at a station, stadium, or event"
                            },
                            {
                                "target_lang_word": "public address announcer",
                                "target_lang_sense_clarification": "making public announcements"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}