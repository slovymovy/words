                                                "sense_id": "f6847d22-9038-338d-bb59-c96ce8f354d6",
                                                "text": "La misère sexuelle des employés et ses palliatifs constituent un thème inépuisable de la littérature du second XIXe siècle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1d62c5d-66e5-385c-ab59-b58e570810fc",
                                        "entry_id": "ff1bf845-ad75-38d9-b7cd-d177f5a8e80a",
                                        "glosses": [
                                            "Remède palliatif."
                                        ],
