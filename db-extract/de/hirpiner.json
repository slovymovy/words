                "senses": [
                    {
                        "sense_id": "a53d194b-e53b-341b-a425-2be2b75a6653",
                        "entry_id": "006908ce-9f38-34d2-afae-8f43e8f4e7ad",
                        "glosses": [
                            "Angehöriger des gleichnamigen, antiken samnitischen Stammes in Mittelitalien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9e03ab1-4070-4275-8c3c-62885cb265ab",
                                "sense_id": "a53d194b-e53b-341b-a425-2be2b75a6653",
                                "text": "„Dieser Bund umfaßte mehrere Stämme, die Pentrer, Hirpiner und Kaudiner.“"
                            },
                            {
                                "example_id": "745cb369-4003-4b5b-a4c0-4c2dea92ec0a",
                                "sense_id": "a53d194b-e53b-341b-a425-2be2b75a6653",
                                "text": "„Samniten ist der Oberbegriff für vier altitalische Stämme, nämlich die Caracener, Kaudiner, Hirpiner und Pentrer.“"
                            },
                            {
                                "example_id": "461926be-fbfc-4ddb-a5b9-2b97502c4448",
                                "sense_id": "a53d194b-e53b-341b-a425-2be2b75a6653",
                                "text": "„Während die eigentlichen Samniter Rom treu bleiben, treten die Hirpiner über auf die karthagische Seite; […]“"
                            },
                            {
                                "example_id": "244cafdd-9ff6-4d85-9ca7-7316debeb87a",
                                "sense_id": "a53d194b-e53b-341b-a425-2be2b75a6653",
                                "text": "„Abellinum […] war eine antike Stadt der Hirpiner in Kampanien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
