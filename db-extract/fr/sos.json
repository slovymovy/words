                                "target_senses": [
                                    {
                                        "sense_id": "193080dc-4ff1-351a-ac73-3051a97fa465",
                                        "entry_id": "1ed24613-519d-3c59-8838-ad303972d45a",
                                        "glosses": [
                                            "The conventional Morse code call made by a ship in distress."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17ab3762-b4ac-47a5-8a34-d93d8b9dd485",
                                                "sense_id": "193080dc-4ff1-351a-ac73-3051a97fa465",
                                                "text": "The crew sent a frantic SOS as they realised the scale of the disaster."
                                            },
                                            {
                                                "example_id": "7d7cfa45-9e2d-4301-9d66-afa837fb78f7",
                                                "sense_id": "193080dc-4ff1-351a-ac73-3051a97fa465",
                                                "text": "\"Look at wireless. Look at the S. O. S. call at sea. Is that not a benefit to mankind?\""
                                            },
                                            {
                                                "example_id": "fe3b5ba8-0b97-46aa-bc6f-8ac215f4b058",
                                                "sense_id": "193080dc-4ff1-351a-ac73-3051a97fa465",
                                                "text": "At around 5:30 a.m., crewmembers of a JCG patrol boat received an SOS from the 106,726-ton freighter Anangel Courage. The patrol vessel and a JCG plane found the freighter on the high seas about 67 kilometers away from Uotsuri Island, one of the Senkaku Islands, which are also claimed by China."
                                            }
                                        ]
                                    }
