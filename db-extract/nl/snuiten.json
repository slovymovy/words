                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fab39156-1428-44dc-93bc-bebb4c41cfda",
                                                "sense_id": "4314df5c-deeb-36d1-9ff8-035c58a12151",
