                                    },
                                    {
                                        "sense_id": "825c1cb5-d9aa-3c84-bc0c-b24354135395",
                                        "entry_id": "e54fee99-819f-3935-8587-7b3dbd52b6fb",
                                        "glosses": [
                                            "Any similar elevated walkway."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9ccc625-68f9-4f65-94bc-4f0a1fa0b8f7",
                                                "sense_id": "825c1cb5-d9aa-3c84-bc0c-b24354135395",
                                                "text": "The lengthening [of the District Line platforms] is being done so that passengers will no longer have to use the narrow catwalks to enter and leave the front and rear portions of eight-car trains."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0bbd5e93-96cd-3ac7-b153-6b7a8a62d575",
                                        "entry_id": "e54fee99-819f-3935-8587-7b3dbd52b6fb",
                                        "glosses": [
                                            "A narrow elevated stage on which models parade."
                                        ],
