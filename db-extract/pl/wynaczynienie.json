                "senses": [
                    {
                        "sense_id": "c9c8cf8d-e07d-3861-adbb-febdbb8866f8",
                        "entry_id": "e09f7e89-732d-3693-92b4-ced8de317604",
                        "glosses": [
                            "przedostanie się substancji z naczyń do otaczającej je tkanki, zwłaszcza krwi z naczyń krwionośnych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98744123-8535-4fc0-9700-dec62025e897",
                                "sense_id": "c9c8cf8d-e07d-3861-adbb-febdbb8866f8",
                                "text": "Twarde promieniowanie w dawkach zabójczych pozostawia ślady: wynaczynienia, petechie, zmiany w obrazie krwi."
                            },
                            {
                                "example_id": "fa35d40e-a43e-4efe-a99c-bbcaf3c139d2",
                                "sense_id": "c9c8cf8d-e07d-3861-adbb-febdbb8866f8",
                                "text": "Fentolamina ponadto zapobiega miejscowej martwicy tkanek w przypadku wynaczynienia norepinefryny."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
