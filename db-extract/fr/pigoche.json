                        "glosses": [
                            "Jeu qui consiste à faire sortir d’un cercle tracé à terre une pièce de monnaie, en jetant dessus une autre pièce."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f90870c5-bc07-4d7c-9827-11b01b6303d0",
                                "sense_id": "c37dde73-cd11-3fd0-a9b1-1fe001d2f352",
                                "text": "[…] derrière une haie maigre ou dans l’angle d’un mur lugubre, des enfants, groupés tumultueusement, fétides, boueux, poudreux, dépenaillés, hérissés, qui jouent à la pigoche couronnés de bleuets."
                            },
                            {
                                "example_id": "44cd0b7c-cffa-47ad-aa23-5882b73208dc",
                                "sense_id": "c37dde73-cd11-3fd0-a9b1-1fe001d2f352",
                                "text": "Je vivais dans la rue, sur la place Saint-Séverin, jouant à la pigoche, aux billes, aux barres, avec les gamins du quartier."
                            }
                        ]
                    }
