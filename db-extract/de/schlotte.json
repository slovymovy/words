                    {
                        "sense_id": "70e28fa5-d4f8-335d-a3d9-9c6ee3a6bcca",
                        "entry_id": "9059b84f-ea4d-3472-a50f-06fea11b53f8",
                        "glosses": [
                            "grünes, röhrenförmiges Zwiebelblatt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95856501-0d16-4f50-8e4b-42664042bd62",
                                "sense_id": "70e28fa5-d4f8-335d-a3d9-9c6ee3a6bcca",
                                "text": "„Während sich die Zwiebeln noch im Wachstum befinden, können Sie jederzeit pro Pflanze etwas Laub, also die Schlotten, ernten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "50c73db4-df03-3489-a68f-f3ac905b88ac",
                        "entry_id": "9059b84f-ea4d-3472-a50f-06fea11b53f8",
                        "glosses": [
                            "Höhle im Gestein, die durch Sickerwasser entstanden ist"
                        ],
                        "tags": [
                            "Bergmannssprache"
                        ],
                        "examples": [
                            {
                                "example_id": "cf3c7bad-37d6-4127-adcb-95ab98b9fe7b",
                                "sense_id": "50c73db4-df03-3489-a68f-f3ac905b88ac",
                                "text": "„In technologischer und wirtschaftlicher Hinsicht waren die Schlotten für den Bergbau stets von ambivalenter Bedeutung. Konsequenzen ergaben sich für die Wasserhaltung, die Wetterführung, den Stollenvortrieb sowie das Abteufen von Schächten, die Standsicherheit des Grubengebäudes generell und nicht zuletzt für die Abraumförderung […].“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
