                "senses": [
                    {
                        "sense_id": "cfb5a400-a014-3c43-9ff5-5449502e9b8f",
                        "entry_id": "5b8032b2-7749-3fe3-8bba-5a35d3436c48",
                        "glosses": [
                            "Wissen eines Individuums um sich selbst, Bewusstsein einer Person (beziehungsweise eines Lebewesens) über ihre eigene (individuelle) Existenz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72a68d03-7b59-4f56-bd61-aa30555c1bbd",
                                "sense_id": "cfb5a400-a014-3c43-9ff5-5449502e9b8f",
                                "text": "„Der Stoff, aus dem unser Ichbewusstsein gewebt wurde, ist durch Bilder kultiviert, die von der Kulturindustrie hergestellt und verbreitet werden.“"
                            },
                            {
                                "example_id": "7ff254b0-2d4b-42a0-8def-208be6ba02e7",
                                "sense_id": "cfb5a400-a014-3c43-9ff5-5449502e9b8f",
                                "text": "„Man hat bewiesen, dass Gorillas Ichbewusstsein, bemerkenswerte Intelligenz und eine Fähigkeit besitzen, um mit Zeichen und Symbolen zu kommunizieren.“"
                            },
                            {
                                "example_id": "01ab5b22-e404-439a-8c1b-2228e1075a53",
                                "sense_id": "cfb5a400-a014-3c43-9ff5-5449502e9b8f",
                                "text": "„Diese Übung verhilft euch dazu, euer Ichbewusstsein vom Körper zu lösen und – genau wie die Seele – ein »schweigender Zeuge« der körperlichen Tätigkeit zu werden.“"
                            },
                            {
                                "example_id": "f86819b8-688d-4929-bef1-0d0b0d33bff5",
                                "sense_id": "cfb5a400-a014-3c43-9ff5-5449502e9b8f",
                                "text": "„Die Menschen hätten aber auf der Erde nicht ihr Ichbewusstsein entwickeln können, wenn sich nicht zuerst die Sonne, später der Mond von ihr abgetrennt hätten.“"
                            },
                            {
                                "example_id": "67e674da-18c0-4470-afb3-224697462a3f",
                                "sense_id": "cfb5a400-a014-3c43-9ff5-5449502e9b8f",
                                "text": "„Das Ichbewusstsein geht den meisten Tieren vollständig ab; allein Schimpansen und Orang-Utans vermochten bisher ihr eigenes Spiegelbild zu erkennen, und selbst dies nur dann, wenn sie mit ihren eigenen Artgenossen aufwachsen konnten.“"
                            },
                            {
                                "example_id": "cca2cbcf-d606-4daf-b4f1-6538fbcb61af",
                                "sense_id": "cfb5a400-a014-3c43-9ff5-5449502e9b8f",
                                "text": "„Nur der in seinem Ichbewusstsein isolierte Mensch, in seiner inneren Entfremdung von Gott, vernimmt nichts von Gottes Gegenwart.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
