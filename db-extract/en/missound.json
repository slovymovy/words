                "senses": [
                    {
                        "sense_id": "c41fdfe1-b878-3bfb-b583-5be265e0b743",
                        "entry_id": "f1c038d7-3f0e-3195-9e24-f48ffe7f6b07",
                        "glosses": [
                            "To sound or pronounce wrongly."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9deb9fd-1edf-4fae-92f1-d5401b0e95d8",
                                "sense_id": "c41fdfe1-b878-3bfb-b583-5be265e0b743",
                                "text": "Every word in English of more than one Syllable has a fixed accent established by the custom of the language, to misplace which is as offensive to the propriety of speech, as to missound the vowel."
                            },
                            {
                                "example_id": "6b86ef42-0b50-4053-b99e-0b8128740bb1",
                                "sense_id": "c41fdfe1-b878-3bfb-b583-5be265e0b743",
                                "text": "Many of you have read these stories and could never pick out any such English; no more would you of the Ismael Persians Haly, or Mortuus Alli they worship, whose true etymology is, mortuum halec, a dead Red-Herring, and no other, though, by corruption of speech they false dialect and missound it."
                            },
                            {
                                "example_id": "2da20774-421f-42fe-bf5f-3ed4e3adbcf4",
                                "sense_id": "c41fdfe1-b878-3bfb-b583-5be265e0b743",
                                "text": "It is by some regarded a far more serious error to misaccent a word than to missound a vowel or diphthong or some other part."
                            }
                        ]
                    }
                ],
