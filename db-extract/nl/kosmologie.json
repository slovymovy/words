        "nl-extract.jsonl": [
            {
                "entry_id": "f4dc6767-941e-3ab2-8e1c-1b1e08e03843",
                "word": "kosmologie",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f201e9b2-13db-3558-8ef1-2ea9ac704f3d",
                        "entry_id": "f4dc6767-941e-3ab2-8e1c-1b1e08e03843",
                        "glosses": [
                            "de wetenschap die de globale structuur en de evolutie van het heelal bestudeert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b8c2bb3-793b-435d-9026-55998d839d1d",
                                "sense_id": "f201e9b2-13db-3558-8ef1-2ea9ac704f3d",
                                "text": "Volgens Riess en zijn collega's, die hun resultaten publiceren in The Astrophysical Journal, is het dan ook denkbaar dat het huidige standaardmodel van de kosmologie toch niet helemaal klopt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7237cab0-c83f-420c-8852-86c253cc0923",
                        "source_entry_id": "f4dc6767-941e-3ab2-8e1c-1b1e08e03843",
                        "source_sense_id": "f201e9b2-13db-3558-8ef1-2ea9ac704f3d",
                        "target_lang_word": "宇宙学",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "f8968f20-7159-4bc8-9d68-4b2e4376443c",
                        "source_entry_id": "f4dc6767-941e-3ab2-8e1c-1b1e08e03843",
                        "source_sense_id": "f201e9b2-13db-3558-8ef1-2ea9ac704f3d",
                        "target_lang_word": "Kosmologie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kosmologie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e71c1881-eb39-33ef-bfef-582d023b1f60",
                                        "entry_id": "c6befa40-e844-35fb-90a9-8676012291ee",
                                        "glosses": [
                                            "Lehre, die sich mit dem Ursprung und der Entwicklung des Weltalls beschäftigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f6dee06-8741-4bb2-a665-8575ee8f7184",
                                                "sense_id": "e71c1881-eb39-33ef-bfef-582d023b1f60",
                                                "text": "„Das Jenseits der schamanischen Kosmologie ist von einer ganzen Reihe unterschiedlich mächtiger Geistmächte mit unterschiedlichen Aufgabenbereichen bevölkert.“"
                                            },
                                            {
                                                "example_id": "df3ae567-ac84-4893-9db6-528e01c257d7",
                                                "sense_id": "e71c1881-eb39-33ef-bfef-582d023b1f60",
                                                "text": "„Infolge der kopernikanischen Wende entwickelten sich verschiedene Kosmologien, die sich darin unterschieden, welche Sternenverteilung sie im Universum annehmen.“"
                                            },
                                            {
                                                "example_id": "e216a1d5-15a8-4198-9b4f-dfa107805765",
                                                "sense_id": "e71c1881-eb39-33ef-bfef-582d023b1f60",
                                                "text": "„Das Standardmodell der Kosmologie beschreibt ein Universum, das aus dem Nichts mit dem Urknall entstand und seitdem expandiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "89876e5a-d1c0-4b22-8fba-ad12c7921115",
                        "source_entry_id": "f4dc6767-941e-3ab2-8e1c-1b1e08e03843",
                        "source_sense_id": "f201e9b2-13db-3558-8ef1-2ea9ac704f3d",
                        "target_lang_word": "cosmology",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cosmology",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e2899fca-fcfb-3aa0-90da-522501541222",
                                        "entry_id": "9f974fdc-ea43-3953-8609-e99b0798a355",
                                        "glosses": [
                                            "The study of the physical universe, its structure, dynamics, origin and evolution, and fate."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "295dca74-bc2f-49e2-8cdf-584135bbe2a1",
                                                "sense_id": "e2899fca-fcfb-3aa0-90da-522501541222",
                                                "text": "We live our lives in three dimensions for our threescore and ten allotted years. Yet every branch of contemporary science, from statistics to cosmology, alludes to processes that operate on scales outside of human experience: the millisecond and the nanometer, the eon and the light-year."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0bf8f996-0490-3eb0-9880-f8188d1c3cdc",
                                        "entry_id": "9f974fdc-ea43-3953-8609-e99b0798a355",
                                        "glosses": [
                                            "A metaphysical study into the origin and nature of the universe."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "254f0cd1-592c-3d64-8275-e3719af6a3b5",
                                        "entry_id": "9f974fdc-ea43-3953-8609-e99b0798a355",
                                        "glosses": [
                                            "A particular view (cultural or religious) of the structure and origin of the universe."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ebcea706-3471-48e0-b984-bbc4da7fd87f",
                                                "sense_id": "254f0cd1-592c-3d64-8275-e3719af6a3b5",
                                                "text": "Near-synonyms: cosmovision, worldview"
                                            },
                                            {
                                                "example_id": "7245a640-a420-4b6f-bf74-e13b37d08dad",
                                                "sense_id": "254f0cd1-592c-3d64-8275-e3719af6a3b5",
                                                "text": "But the work of Marshack and Leroi-Gourhan enable us to see that these later religions of the civilized period are elaborations of the cosmologies from the universal religion of the Upper Paleolithic."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "40c9ef7d-1b1e-43ac-8d79-cd5a43091e81",
                        "source_entry_id": "f4dc6767-941e-3ab2-8e1c-1b1e08e03843",
                        "source_sense_id": "f201e9b2-13db-3558-8ef1-2ea9ac704f3d",
