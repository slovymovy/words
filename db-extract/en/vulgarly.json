                        "glosses": [
                            "In a vulgar manner; obscenely or unrefinedly."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f67b2dc-d4d0-4cbb-ab42-4d2aac6afb5f",
                                "sense_id": "efc6f5c6-23e1-385c-83ba-00f944746a2e",
                                "text": "Rosemary peeled off Sloane Square, Hartnell, decorations-will-be-worn, fog primroses, crumpets by the fire, and let fly vulgarly at Vythilingam."
                            }
                        ]
                    },
                    {
                        "sense_id": "22a48edd-1ee2-3e46-849d-d724da7b15ce",
                        "entry_id": "7b368cb2-03bf-36fa-843e-37cd0080522f",
                        "glosses": [
                            "In the manner of the common people."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23dba17a-aaa6-4199-a455-66c5d198ebb0",
                                "sense_id": "22a48edd-1ee2-3e46-849d-d724da7b15ce",
                                "text": "The last, the knotted fucus, which has long slender stalks, leaves small, bulbs or vesicles in the middle of the stalks, vulgarly called eelwrack, is most esteemed by our kelp-makers."
                            }
                        ]
                    }
