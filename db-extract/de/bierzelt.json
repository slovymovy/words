                                "target_senses": [
                                    {
                                        "sense_id": "d88665c5-1dd3-3759-8898-6f5c01892ab0",
                                        "entry_id": "84312abc-8bc1-3398-8c57-87dc5d291f11",
                                        "glosses": [
                                            "At a fair or festival, a tent set up for the purpose of selling and consuming beer and other alcoholic beverages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f2ee4e9-da0b-4415-92ba-82505ff0c80a",
                                                "sense_id": "d88665c5-1dd3-3759-8898-6f5c01892ab0",
                                                "text": "“Sideshows, dancing.” “And two beer-tents,” said Nabby Adams."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ed02cb90-4770-4837-803d-14accb832076",
                        "source_entry_id": "6e3080ad-e267-3bc4-8f6f-cd2199c101f7",
                        "source_sense_id": "01cbefed-f880-3fa7-853a-3a6e43e4e40b",
