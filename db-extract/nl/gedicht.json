                ],
                "senses": [
                    {
                        "sense_id": "9ae5f775-6f85-343a-8324-49edb2d87de5",
                        "entry_id": "9e49b1c8-a544-3d0f-81a7-f530872474b1",
                        "glosses": [
                            "een in versmaat of in dichterlijke stijl opgesteld stuk tekst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1510dda2-e398-4735-a0b8-23014fa9e6ba",
                                "sense_id": "9ae5f775-6f85-343a-8324-49edb2d87de5",
                                "text": "Ze leest mijn laatst geschreven gedicht."
                            },
                            {
                                "example_id": "f6aae45a-3cc2-47b7-8041-4f0a2fca1dd3",
                                "sense_id": "9ae5f775-6f85-343a-8324-49edb2d87de5",
                                "text": "Ze leest het gedicht nog een keer."
                            },
                            {
                                "example_id": "05955b60-03cf-4102-92f9-a930e178391f",
                                "sense_id": "9ae5f775-6f85-343a-8324-49edb2d87de5",
                                "text": "Thuis had het Britse consulaat me de eerste prijs voor studenten uit het Gemenebest toegekend voor mijn gedicht 'Caribische spinlelie'."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fc513ca8-68f4-4e9f-af87-f38b92540c38",
                        "source_entry_id": "9e49b1c8-a544-3d0f-81a7-f530872474b1",
                        "source_sense_id": "9ae5f775-6f85-343a-8324-49edb2d87de5",
                        "source_sense_description": "een in versmaat of in dichterlijke stijl opgesteld stuk",
                        "target_lang_word": "Gedicht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gedicht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "74794b1c-38d4-3319-ae76-db68b4f89e00",
                                        "entry_id": "5a8ef8e6-473a-3ad0-9a5e-57b73346f890",
                                        "glosses": [
                                            "lyrisches sprachliches Kunstwerk, das meist schriftlich und in Strophen- und Versform vorliegt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aba0f552-63f8-4de6-8920-ee1c2006a793",
                                                "sense_id": "74794b1c-38d4-3319-ae76-db68b4f89e00",
                                                "text": "Manche Menschen finden Trost in Gedichten."
                                            },
                                            {
                                                "example_id": "a879fd35-1972-429b-a615-6d2c7911d7ec",
                                                "sense_id": "74794b1c-38d4-3319-ae76-db68b4f89e00",
                                                "text": "„Die Gedichte waren viel interessanter.“"
                                            },
                                            {
                                                "example_id": "68b345f1-e2a7-46bf-a20b-c1b578ec0f4e",
                                                "sense_id": "74794b1c-38d4-3319-ae76-db68b4f89e00",
                                                "text": "„Farben finden sich immer wieder in seinen Gedichten.“"
                                            },
                                            {
                                                "example_id": "8ed43c43-412d-4c65-b719-be2dd62c284a",
                                                "sense_id": "74794b1c-38d4-3319-ae76-db68b4f89e00",
                                                "text": "„Auf dem Tablett lag ein gedrucktes, zu Ehren des Helden verfasstes Gedicht.“"
                                            },
                                            {
                                                "example_id": "c4ea4037-d5c6-456e-95aa-5ed53002e1c4",
                                                "sense_id": "74794b1c-38d4-3319-ae76-db68b4f89e00",
                                                "text": "„Aber Aufsätze waren keine Gedichte oder Romane.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ff231b65-e232-3ce0-8507-a9b95ee1a19c",
                                        "entry_id": "5a8ef8e6-473a-3ad0-9a5e-57b73346f890",
                                        "glosses": [
                                            "etwas außergewöhnlich gut Gelungenes"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ccdd8fb-a5a7-4c36-a640-ee81378e2606",
                                                "sense_id": "ff231b65-e232-3ce0-8507-a9b95ee1a19c",
                                                "text": "Dein Pudding ist mal wieder ein Gedicht."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1d20c61e-01fb-4545-be02-51644803934d",
                        "source_entry_id": "9e49b1c8-a544-3d0f-81a7-f530872474b1",
                        "source_sense_id": "9ae5f775-6f85-343a-8324-49edb2d87de5",
                        "source_sense_description": "een in versmaat of in dichterlijke stijl opgesteld stuk",
                        "target_lang_word": "poem",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "poem",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e759d877-6fc1-3f35-a7a8-71fa1564fabc",
                                        "entry_id": "9b9aa2ae-a58c-3a2d-b77c-07c5a712af84",
                                        "glosses": [
                                            "A literary piece written in verse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2be30e1-1bd7-4c6c-b12f-955f411af498",
                                                "sense_id": "e759d877-6fc1-3f35-a7a8-71fa1564fabc",
                                                "text": "Some poems, echoing the purpose of early poetic treatises on scientific principles, attempt to elucidate the mathematical concepts that underlie prime numbers. Others play with primes’ cultural associations. Still others derive their structure from mathematical patterns involving primes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "811d0c7c-c2b4-37b3-8a1f-5819e749e21f",
                                        "entry_id": "9b9aa2ae-a58c-3a2d-b77c-07c5a712af84",
                                        "glosses": [
                                            "A piece of writing in the tradition of poetry, an instance of poetry."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8291daee-102c-3f35-b794-ac33c8a3f516",
                                        "entry_id": "9b9aa2ae-a58c-3a2d-b77c-07c5a712af84",
                                        "glosses": [
                                            "A piece of poetic writing, that is with an intensity or depth of expression or inspiration greater than is usual in prose."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e53d0c26-c089-4f47-b132-56622fca49d6",
                        "source_entry_id": "9e49b1c8-a544-3d0f-81a7-f530872474b1",
                        "source_sense_id": "9ae5f775-6f85-343a-8324-49edb2d87de5",
                        "source_sense_description": "een in versmaat of in dichterlijke stijl opgesteld stuk",
                        "target_lang_word": "poème",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "poème",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eb4b2ba0-cfba-366b-91c5-faeb1276ec8c",
                                        "entry_id": "5653381f-e7ea-3a0b-85c4-d7d01091c3ea",
                                        "glosses": [
                                            "Ouvrage de littérature en vers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b3dbc0a-4bd9-475a-a023-8750e2e47eb7",
                                                "sense_id": "eb4b2ba0-cfba-366b-91c5-faeb1276ec8c",
                                                "text": "Mais rien ne peut empêcher qu’un poème dénué de poésie soit plus que mort, intolérable."
                                            },
                                            {
                                                "example_id": "33d61899-f83e-44f9-9b89-938969c0d6cb",
                                                "sense_id": "eb4b2ba0-cfba-366b-91c5-faeb1276ec8c",
                                                "text": "Mais pour d’autres, quelle angoisse ! et quelle injustice ! Les sentiments les plus nobles, les sujets les plus naturellement poétiques, les rythmes travaillés, les rimes recherchées, tout cela pour aboutir à cet enfant mort-né, pleuré de personne, qu’est un poème sans poésie."
                                            },
                                            {
                                                "example_id": "4d8e1b7f-e413-45fc-ae6f-7edc064d7b6b",
                                                "sense_id": "eb4b2ba0-cfba-366b-91c5-faeb1276ec8c",
                                                "text": "Il n’y avait là que des poèmes, et, sur certaines pages, on ne trouvait que quelques lignes parfois très courtes. Pour le père, ce n’était pas du travail sérieux. Un peu comme un boulanger qui eût triché sur le poids du pain. Il trouvait stupide d’acheter des livres contenant autant de papier blanc."
                                            },
                                            {
                                                "example_id": "a69bec31-c7f9-45e2-a29f-709af6c20499",
                                                "sense_id": "eb4b2ba0-cfba-366b-91c5-faeb1276ec8c",
                                                "text": "Devant le roi et sa suite guerrière (truste, Gefolschaft), le scalde déclame son poème qui s’envole d’une bataille peuplée d’êtres fantastiques et qui s’adapte aux structures sociales et mentales du groupe : […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9733f3ba-36b2-31d3-b2eb-3c7da9999733",
                                        "entry_id": "5653381f-e7ea-3a0b-85c4-d7d01091c3ea",
                                        "glosses": [
                                            "Ouvrage analogue par la pensée, par le style, mais écrits en prose."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94cae3b4-64b1-41e6-8925-dfe54c3faa5c",
                                                "sense_id": "9733f3ba-36b2-31d3-b2eb-3c7da9999733",
                                                "text": "Les poèmes en prose de Baudelaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afdfa958-1bdd-3dce-8225-d2377d5b3f0c",
                                        "entry_id": "5653381f-e7ea-3a0b-85c4-d7d01091c3ea",
                                        "glosses": [
                                            "Quelque chose de remarquable."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1948d178-215a-4142-a8ba-bc5a314dd8f2",
                                                "sense_id": "afdfa958-1bdd-3dce-8225-d2377d5b3f0c",
                                                "text": "C’était un poème que de la regarder écoutant un morceau de Weber, de Beethoven ou d’Hérold, les yeux levés, silencieuse, et regrettant sans doute la vie qu’elle sentait lui échapper."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
