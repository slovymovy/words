                            {
                                "example_id": "41e5d421-a17c-4c36-9644-95d65c7f0823",
                                "sense_id": "1fc56c65-1967-36b4-bb4b-ea81eac7eee6",
                                "text": "„Im Osten schob sich die Sonne orangerot hinter der kargen Landschaft hervor und tauchte den Himmel in ein Farbenmeer von Rosarot bis Hellgelb.“"
                            },
                            {
                                "example_id": "800e56ab-5304-421b-ba42-e6c671e70d7f",
                                "sense_id": "1fc56c65-1967-36b4-bb4b-ea81eac7eee6",
                                "text": "„Auf den Blumenbeeten, die den ganzen Trailer umgaben, leuchteten Hunderte von Blüten und verwandelten den Garten in ein blendendes Farbenmeer.“"
                            }
                        ],
