                        "translation_id": "c7f1ecbe-1c12-4ea4-a578-ce77a6ef3c1c",
                        "source_entry_id": "5e2589c6-8430-393f-96a8-eadf2d6e5688",
                        "source_sense_description": "inhabitant of one of the modern Baltic states",
                        "target_lang_word": "Balte",
                        "target_lang_code": "fr",
