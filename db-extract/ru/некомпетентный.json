                    {
                        "translation_id": "b8e6f0e1-3235-4cad-ace7-df3579f54e19",
                        "source_entry_id": "bd889ac4-3da3-3178-b667-c4b98f26d101",
                        "source_sense_id": "83f15665-b236-388e-8c59-13477a97f7de",
                        "target_lang_word": "unqualified",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unqualified",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "99ecfd03-e441-3dda-95c6-d98deb1aa79f",
                                        "entry_id": "49f3f0fb-ef5e-31a5-9546-50968a30ee4f",
                                        "glosses": [
                                            "Not qualified: ineligible; unfit for a position or task."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "faf6db29-349e-4de6-bfa5-ed36d0ccb0d9",
                                                "sense_id": "99ecfd03-e441-3dda-95c6-d98deb1aa79f",
                                                "text": "His lack of a high school diploma renders him unqualified for the job."
                                            },
                                            {
                                                "example_id": "e4c3a0bc-1b75-4b49-9093-082a73567c78",
                                                "sense_id": "99ecfd03-e441-3dda-95c6-d98deb1aa79f",
                                                "text": "An obvious characteristic of a kakistocrat is inserting unqualified loyalists into positions of power. Nepotism and kakistocracy go hand-in-hand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1db8dc2f-391d-3601-874d-f211796e8680",
                                        "entry_id": "49f3f0fb-ef5e-31a5-9546-50968a30ee4f",
                                        "glosses": [
                                            "Not elaborated upon; undescribed; unrestricted."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06c145ce-eca6-4ba9-ba78-962a47b0d07e",
                                                "sense_id": "1db8dc2f-391d-3601-874d-f211796e8680",
                                                "text": "The right to free speech is well established as not being an unqualified right to violent incitement nor to free amplification."
                                            },
                                            {
                                                "example_id": "d1c1d183-de06-4569-a5cb-139809cf38aa",
                                                "sense_id": "1db8dc2f-391d-3601-874d-f211796e8680",
                                                "text": "Obviously, we must reject the existence of an unqualified or unspecified right to know. If the right to know did not require disclosure of only specific (types of) data or information, a person could be said to have a right to know just anything whatsoever."
                                            },
                                            {
                                                "example_id": "4ba34196-7151-4916-b74e-d32d96f7700a",
                                                "sense_id": "1db8dc2f-391d-3601-874d-f211796e8680",
                                                "text": "[…] there is a multiplicity in the unqualified or unspecified concept of “soul,” such that it still retains its real meaning but by its very definition is predicated of different levels of things, at least in the classical conception of “soul.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89169e95-b676-3446-8673-f74ed1cb42b3",
                                        "entry_id": "49f3f0fb-ef5e-31a5-9546-50968a30ee4f",
                                        "glosses": [
                                            "Outright; thorough; utter; unhampered."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e018f11d-b286-415a-b246-ff4869f83fc0",
                                                "sense_id": "89169e95-b676-3446-8673-f74ed1cb42b3",
                                                "text": "an unqualified success"
                                            },
                                            {
                                                "example_id": "d5362dd3-13c6-49b1-8db3-58fa86797c2d",
                                                "sense_id": "89169e95-b676-3446-8673-f74ed1cb42b3",
                                                "text": "Gibson is an unqualified fool, and only fit to mix with beasts of the same calibre; […]"
                                            },
                                            {
                                                "example_id": "07af850d-ce97-4df9-9b18-32c56a1bc9bf",
                                                "sense_id": "89169e95-b676-3446-8673-f74ed1cb42b3",
                                                "text": "The silicon rectifiers installed in the 42 English Electric-equipped units of the Shenfield augmentation stock have proved an unqualified success; [...]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "unqualified",
                                "target_lang_code": "en",
