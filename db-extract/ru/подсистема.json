                "senses": [
                    {
                        "sense_id": "b48cd679-ddec-3330-973f-8c59d07e84d5",
                        "entry_id": "18ba3936-718d-3e68-9d87-6dabf4a66414",
                        "glosses": [
                            "спец. подчинённая или вспомогательная система; часть какой-либо более крупной, общей системы, характеризующаяся относительной целостностью"
                        ],
