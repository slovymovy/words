                "senses": [
                    {
                        "sense_id": "0db4cc81-4978-30f1-8d12-08dd9509fc4b",
                        "entry_id": "be9e5aaf-3337-34bb-a668-c308aac1341b",
                        "glosses": [
                            "ein gebackener Malzpudding, der zur Fastenzeit kalt gegessen wird"
                        ],
                        "tags": [
                            "Finnland"
                        ],
                        "examples": [
                            {
                                "example_id": "13aa6f22-5327-4da0-a80c-ada337c4a398",
                                "sense_id": "0db4cc81-4978-30f1-8d12-08dd9509fc4b",
                                "text": "Mämmi besteht aus Roggenmehl und Braumalz, die in Wasser gerührt und mit etwas Salz, Bitterorange und Sirup abgeschmeckt wird."
                            },
                            {
                                "example_id": "4b152f71-b8a2-45c9-bd60-5b9ebb7562ef",
                                "sense_id": "0db4cc81-4978-30f1-8d12-08dd9509fc4b",
                                "text": "Als Nachspeise gedenkt sie, mit den beiden einen Mämmi, einen traditionellen Malzpudding zu backen."
                            },
                            {
                                "example_id": "427c47c2-6c11-4010-b654-ee8c67415539",
                                "sense_id": "0db4cc81-4978-30f1-8d12-08dd9509fc4b",
                                "text": "Übrigens werden in Finnland pro Jahr gut 1 700 000 kg Mämmi gegessen, das macht knapp 300 g pro Person."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
