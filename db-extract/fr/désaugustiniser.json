                "senses": [
                    {
                        "sense_id": "62f23798-8c1c-3990-a530-3c117782c0b8",
                        "entry_id": "165cff49-15fb-3212-933a-c160a7a2b259",
                        "glosses": [
                            "Faire perdre son caractère augustinien à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd924da1-3593-4109-b1da-c119c8a27cea",
                                "sense_id": "62f23798-8c1c-3990-a530-3c117782c0b8",
                                "text": "Il est redevenu populaire, mais cette appréciation n’est-elle pas basée sur un malentendu, sur un « Augustin désaugustinisé » ?"
                            },
                            {
                                "example_id": "57a7863a-08f0-4630-a267-08c31e978978",
                                "sense_id": "62f23798-8c1c-3990-a530-3c117782c0b8",
                                "text": "Leszek Kolakowski a bien montré comment la publication de l’Augustinus a offert à l’Église l’occasion de se désaugustiniser : en dénonçant les cinq propositions de l’Augustinus, elle désavouait la théologie augustinienne et adoptait pratiquement la doctrine des jésuites."
                            }
                        ]
                    }
