                                            {
                                                "example_id": "6621acc7-3b59-47e3-9c18-19dc4b341540",
                                                "sense_id": "94caa545-dbb7-3c91-bf97-4e6e92c424ee",
                                                "text": "W 1981 medyna w Fezie została wpisana na listę światowego dziedzictwa kultury UNESCO"
                                            },
                                            {
                                                "example_id": "169c1812-36c0-430f-9d49-a19a3570eb21",
                                                "sense_id": "94caa545-dbb7-3c91-bf97-4e6e92c424ee",
                                                "text": "Do miast partnerskich Fezu należy również Kraków."
                                            }
