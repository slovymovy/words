                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5350a32a-95bc-4a83-bdd0-a58f1f5cf989",
                        "entry_id": "ad167be4-6fae-3791-8458-ef2616dd1956",
                        "tags": [
