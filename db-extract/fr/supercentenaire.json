                        "sense_id": "4c4212b9-ede9-3d7c-85cd-4e47b7c38e92",
                        "entry_id": "52b51338-0932-3d61-8c51-7f280ed5e014",
                        "glosses": [
                            "Personne âgée de plus de cent-dix ans."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1bc2331d-4024-4a1c-a83e-94c0a7ea4ebf",
                                "sense_id": "4c4212b9-ede9-3d7c-85cd-4e47b7c38e92",
                                "text": "La nouvelle doyenne des États-Unis est désormais Eunice Sanborn, née le 20 juillet 1896, selon la dernière liste actualisée du groupe de recherches gérontologiques (Gerontology Research Group), qui recense les \"supercentenaires\" (personnes de plus de 110 ans)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "33774825-3535-451a-bc5a-34ffc14aca1c",
                        "source_entry_id": "52b51338-0932-3d61-8c51-7f280ed5e014",
