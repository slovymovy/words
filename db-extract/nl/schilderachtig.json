                "senses": [
                    {
                        "sense_id": "90488b06-406c-338b-b342-df4037736422",
                        "entry_id": "86724448-3139-3bf9-ac79-dcfa7b02cc08",
                        "glosses": [
                            "zo mooi, prachtig en lieflijk dat het waard is er een schilderij van de maken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f2fc032-59b6-4951-a6da-78001fd09165",
                                "sense_id": "90488b06-406c-338b-b342-df4037736422",
                                "text": "Zij woont in een schilderachtig dorpje."
                            }
                        ]
                    },
                    {
                        "sense_id": "2dabcda8-b14e-36eb-b961-776a833432c2",
                        "entry_id": "86724448-3139-3bf9-ac79-dcfa7b02cc08",
                        "glosses": [
                            "romantisch, kleurrijk, bijzonder"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a2adb2e-d3bf-4f13-9c10-17add8a0221b",
                                "sense_id": "2dabcda8-b14e-36eb-b961-776a833432c2",
                                "text": "Hoewel de feesten de hoofdrol spelen, hebben ook enkele andere inspirerende en schilderachtige figuren een plaats gekregen. Zoals Franciscus, Hieronymus en Christofoor, die de hele wereld (het Christuskind) op zijn schouder draagt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8551eedf-ad5b-4d0f-97d6-fe46118830f7",
                        "source_entry_id": "86724448-3139-3bf9-ac79-dcfa7b02cc08",
                        "target_lang_word": "picturesque",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "picturesque",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6d8c2150-3248-3081-b0fa-47214b00421f",
                                        "entry_id": "e7c7fd85-421f-38be-9a8f-4441b75ba722",
                                        "glosses": [
                                            "Resembling or worthy of a picture or painting; having the qualities of a picture or painting; pleasingly beautiful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4d873c6-50a9-48e9-aa29-8b0b666ef5c3",
                                                "sense_id": "6d8c2150-3248-3081-b0fa-47214b00421f",
                                                "text": "We looked down onto a beautiful, picturesque sunset over the ocean."
                                            },
                                            {
                                                "example_id": "5f0d0b76-1765-4b51-8920-565fe173e200",
                                                "sense_id": "6d8c2150-3248-3081-b0fa-47214b00421f",
                                                "text": "A two minutes' walk brought Warwick—the name he had registered under, and as we shall call him—to the market-house, the central feature of Patesville, from both the commercial and the picturesque points of view."
                                            },
                                            {
                                                "example_id": "0943e5e9-20a4-4030-8990-a5a50014820b",
                                                "sense_id": "6d8c2150-3248-3081-b0fa-47214b00421f",
                                                "text": "A dear old lady said she thought the ancient castle at Conway most picturesque, but that it was a pity they put it so close to the railway!"
                                            },
                                            {
                                                "example_id": "14aa1623-0be2-4a40-ae53-dcd5ab648626",
                                                "sense_id": "6d8c2150-3248-3081-b0fa-47214b00421f",
                                                "text": "The Australian teens, both from Melbourne, were enjoying a backpacking trip when they became ill after a night out in Vang Vieng.\nThe picturesque rural town in northern Laos has long been a popular backpacking spot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1400f416-6b40-38a1-b5fe-78b7e2ff1563",
                                        "entry_id": "e7c7fd85-421f-38be-9a8f-4441b75ba722",
                                        "glosses": [
                                            "Strikingly graphic or vivid; having striking and vivid imagery."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fdba4899-4448-433e-ad66-8f087da1f1ce",
                                                "sense_id": "1400f416-6b40-38a1-b5fe-78b7e2ff1563",
                                                "text": "picturesque language"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
