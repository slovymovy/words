                "word_linkages": []
            },
            {
                "entry_id": "fb094289-06e9-3e45-9ee9-e47b01120f11",
                "word": "papelonné",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7375c511-a2c5-4137-9016-00456d14f5ce",
