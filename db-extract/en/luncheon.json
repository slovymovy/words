                ],
                "translations": [
                    {
                        "translation_id": "0b3f917a-23e6-4377-810a-4f299efd60c2",
                        "source_entry_id": "e5ce1250-a631-320b-8255-33cf9bf35d64",
                        "source_sense_id": "1dabcd75-6f66-3656-8040-dc4847286359",
                        "source_sense_description": "Bezeichnung für ein Essen um die formales Mittagszeit",
                        "target_lang_word": "Mittagessen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mittagessen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "865c27a0-f427-39f0-9536-fd0655bf3851",
                                        "entry_id": "8227c363-36d1-3707-b421-613d138fe28c",
                                        "glosses": [
                                            "Mahlzeit, die zur Mittagszeit eingenommen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b508e1e-01f6-4adc-9b04-d0bf99a72978",
                                                "sense_id": "865c27a0-f427-39f0-9536-fd0655bf3851",
                                                "text": "Heute gab es Fischsuppe zum Mittagessen."
                                            },
                                            {
                                                "example_id": "9710d906-c81d-4f51-9f37-33a5f1b8648b",
                                                "sense_id": "865c27a0-f427-39f0-9536-fd0655bf3851",
                                                "text": "„Für andere Geschäfte bediente er sich der Rotunde, die ihm auf dem Wege vom Mittagessen zur Werkstatt am nächsten lag.“"
                                            },
                                            {
                                                "example_id": "15019a5a-65f4-4054-bb33-6bb81789f48b",
                                                "sense_id": "865c27a0-f427-39f0-9536-fd0655bf3851",
                                                "text": "„Nach dem Mittagesssen wurde der Unterricht fortgesetzt.“"
                                            },
                                            {
                                                "example_id": "0785def7-e7d9-4fa6-a975-d3f737644e12",
                                                "sense_id": "865c27a0-f427-39f0-9536-fd0655bf3851",
                                                "text": "„Danach lud er uns noch einen großen Kessel auf, aus dem das Mittagessen an die Gefangenen auszuteilen war.“"
                                            },
                                            {
                                                "example_id": "0640599f-491e-40da-adab-1c61cbbbf25a",
                                                "sense_id": "865c27a0-f427-39f0-9536-fd0655bf3851",
                                                "text": "„Max hätte gern beim Mittagessen Gesellschaft gehabt.“"
                                            },
                                            {
                                                "example_id": "007ef9ab-2f5e-4028-b983-a1644d206b18",
                                                "sense_id": "865c27a0-f427-39f0-9536-fd0655bf3851",
                                                "text": "„Vor dem Mittagessen mußte ich die Hände vorzeigen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0c633edb-219d-4aba-8708-302b767e444f",
                        "source_entry_id": "e5ce1250-a631-320b-8255-33cf9bf35d64",
                        "source_sense_id": "1dabcd75-6f66-3656-8040-dc4847286359",
                        "source_sense_description": "Bezeichnung für ein Essen um die formales Mittagszeit",
                        "target_lang_word": "Mittagsmahlzeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mittagsmahlzeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b6233a55-ca32-30a9-9191-6df208d7692a",
                                        "entry_id": "504b6422-7344-32e3-8b13-851313d83d8d",
                                        "glosses": [
                                            "Mahlzeit zur Tagesmitte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9042e795-2cca-4bed-abb6-0252b3a7d482",
                                                "sense_id": "b6233a55-ca32-30a9-9191-6df208d7692a",
                                                "text": "„Die Mittagsmahlzeit fürs Büro zu Hause vorzukochen – ein Trend, der sich seit Jahren vor allem bei Arbeitnehmern durchsetzt, die den Gang zum Imbiss ums Eck oder die klassische Firmenkantine scheuen.“"
                                            },
                                            {
                                                "example_id": "f991363a-3b28-4245-bf73-a000a7992347",
                                                "sense_id": "b6233a55-ca32-30a9-9191-6df208d7692a",
                                                "text": "„Bei eingeschränktem Schul- und Kitabetrieb könne man eine zubereitete Mittagsmahlzeit in den Einrichtungen für viele Kinder nicht regelmäßig anbieten.“"
                                            },
                                            {
                                                "example_id": "fc22596e-e115-4a1e-b3ef-9431c3483748",
                                                "sense_id": "b6233a55-ca32-30a9-9191-6df208d7692a",
                                                "text": "„Nachdem ich für die nächste Mittagsmahlzeit Reis und ein Curry aus Kichererbsen, Kokosmilch und Gemüse gekocht habe, muss ich sehr lange warten, bis es abgekühlt ist und ich es in die Dosen füllen kann.“"
                                            },
                                            {
                                                "example_id": "117b5a2b-25c2-4e6b-955e-7890ceec7b97",
                                                "sense_id": "b6233a55-ca32-30a9-9191-6df208d7692a",
                                                "text": "„Erst seit der Aufbau von Ganztagsschulen forciert wird und die Kultusministerkonferenz 2004 verfügte, dass jede dieser Einrichtungen ihren Schülern eine warme Mittagsmahlzeit anzubieten hat, werden Mensen gewissermaßen aus dem Boden gestampft.“"
                                            },
                                            {
                                                "example_id": "cbe52b1c-421e-48be-9b4f-80fdd077db8d",
                                                "sense_id": "b6233a55-ca32-30a9-9191-6df208d7692a",
                                                "text": "„Von montags bis freitags werden die Familien außerdem kostenlos mit einer warmen Mittagsmahlzeit versorgt.“"
                                            },
                                            {
                                                "example_id": "6fa74594-763f-42a8-9187-f247a9e6fecb",
                                                "sense_id": "b6233a55-ca32-30a9-9191-6df208d7692a",
                                                "text": "„Der fünffache Familienvater - er war seit 1959 mit einer Ärztin verheiratet - spendete viel Geld, um bedürftigen Kindern eine tägliche Mittagsmahlzeit zu ermöglichen.“"
                                            },
                                            {
                                                "example_id": "15f35600-b3a5-4703-83be-9f2c45ecfcd2",
                                                "sense_id": "b6233a55-ca32-30a9-9191-6df208d7692a",
                                                "text": "„Trotzdem hat sich im Erdgeschoß ein Feinschmeckerrestaurant niedergelassen, in dem Kieser gerne seine Mittagsmahlzeiten einnimmt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
