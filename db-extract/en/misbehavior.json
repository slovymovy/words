                                "target_senses": [
                                    {
                                        "sense_id": "9d4677ac-f5ab-353a-942d-64ce3565578b",
                                        "entry_id": "0ecd7545-8e4b-3680-b39d-dbe00365411b",
                                        "glosses": [
                                            "gedrag dat tegen de regels van het fatsoen ingaat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f8b4755-9858-4a78-bd31-99b991707876",
                                                "sense_id": "9d4677ac-f5ab-353a-942d-64ce3565578b",
                                                "text": "Zijn wangedrag hangt me verschrikkelijk de keel uit."
                                            },
                                            {
                                                "example_id": "57caf07c-2046-45ba-8d4a-51197ac241c5",
                                                "sense_id": "9d4677ac-f5ab-353a-942d-64ce3565578b",
                                                "text": "Recent kwam er een nieuw schandaal aan het licht. De premier had een ex-regeringslid ondanks klachten over seksueel wangedrag toch een baan gegeven."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4487f6f1-cd3b-428b-86ff-a4dee6c2f305",
                        "source_entry_id": "5771f9d0-44d9-3644-a088-cba3d921aa70",
                        "source_sense_id": "6e582370-7685-3618-98b7-b18a035a70ae",
                        "source_sense_description": "conduct that is inappropriate",
                        "target_lang_word": "inconduite",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inconduite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7120116f-958b-3d18-9c22-4c13c90d971d",
                                        "entry_id": "04f8898c-25ef-317a-9193-a4b2140bc283",
                                        "glosses": [
                                            "Défaut de conduite morale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "506c09a8-eb15-4390-a366-bc41415b0ad7",
                                                "sense_id": "7120116f-958b-3d18-9c22-4c13c90d971d",
                                                "text": "Muserolle, avec colère.– Vous que j’ai quittée si maigre… Après ça, l’inconduite engraisse !\nBlanche, de même.– En vous regardant, on croirait plutôt le contraire."
                                            },
                                            {
                                                "example_id": "913faa0a-5e90-431b-9b7f-3e8320a4e4d3",
                                                "sense_id": "7120116f-958b-3d18-9c22-4c13c90d971d",
                                                "text": "Personne ne m'attendait, ni femme, ni fille pour un brin de causette ou d’inconduite, comme on voudra."
                                            },
                                            {
                                                "example_id": "f850ab3d-81b3-4abb-91cc-c4ec4e98f751",
                                                "sense_id": "7120116f-958b-3d18-9c22-4c13c90d971d",
                                                "text": "Après plusieurs cas d’inconduite scientifique, la recherche française doit se doter de règles claires et partagées sur les modalités d’enquête et de sanction."
                                            },
                                            {
                                                "example_id": "a556c1d0-5bf0-4445-968e-874e3ce95b33",
                                                "sense_id": "7120116f-958b-3d18-9c22-4c13c90d971d",
                                                "text": "Le premier ministre, Justin Trudeau, a déclaré que le fait que l'amiral … se soit retiré du poste de chef d'état-major de la défense pendant que la police militaire enquête sur des allégations d'inconduite sexuelle démontre à quel point ces cas sont pris au sérieux."
                                            },
                                            {
                                                "example_id": "97a4c2df-bea2-424e-a373-72383043d79e",
                                                "sense_id": "7120116f-958b-3d18-9c22-4c13c90d971d",
                                                "text": "– Mais à la première inconduite, c’est bien de mon fusil que sortira la balle qui trouera vos fesses."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
