                ],
                "senses": [
                    {
                        "sense_id": "3828387b-3bdd-3f3c-9089-2e0236511e66",
                        "entry_id": "930a1c5e-8a72-39c2-adad-5f3b7d759ebd",
                        "glosses": [
                            "Schriftsystem bestimmt dadurch, welche sprachlichen Elemente vorrangig durch seine Schriftzeichen wiedergegeben werden"
                        ],
                        "tags": [
                            "speziell Schriftlinguistik"
                        ],
                        "examples": [
                            {
                                "example_id": "95f55935-fd70-45d5-a1b5-a34c02ebe372",
                                "sense_id": "3828387b-3bdd-3f3c-9089-2e0236511e66",
                                "text": "„Diese drei Schrifttypen werden danach unterschieden, welches das kleinste Element des Sprachsystems ist, das sie graphisch repräsentieren: das Phonem, die Silbe oder das Wort.“"
                            },
                            {
                                "example_id": "bf9769a9-ca48-4a65-beac-f726e21244ef",
                                "sense_id": "3828387b-3bdd-3f3c-9089-2e0236511e66",
                                "text": "„Allein der Sachverhalt, daß etwa ein Fünftel der Weltbevölkerung nach dem Prinzip der Logographie schreibt, macht diesen Schrifttyp im Kreis der modernen Schriftsysteme bedeutend.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6a467a90-74ff-3ae2-b288-7cb8a5e45209",
                        "entry_id": "930a1c5e-8a72-39c2-adad-5f3b7d759ebd",
                        "glosses": [
                            "Schrift nach der Art der Gestaltung der einzelnen Schriftzeichen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8cc64fb7-ed07-46b9-9664-b51c141778f2",
                                "sense_id": "6a467a90-74ff-3ae2-b288-7cb8a5e45209",
                                "text": "„Mit dem Schrifttyp „Frosty“ schreiben Sie Ihre Briefe im winterlichen Stil.“"
                            },
                            {
                                "example_id": "49653daa-5c39-4542-b69d-e8d7679c1d57",
                                "sense_id": "6a467a90-74ff-3ae2-b288-7cb8a5e45209",
                                "text": "„Selbst die karolingische Minuskel, ein neuer, wegbereitender Schrifttyp, der die nachfolgende Schriftentwicklung nachhaltig beeinflussen sollte, konnte diese Nationalschriften, besonders die des angelsächsischen Bereichs, vorerst nicht verdrängen.“"
                            },
                            {
                                "example_id": "ad84563e-cb04-4e4e-9c95-32361683b5dc",
                                "sense_id": "6a467a90-74ff-3ae2-b288-7cb8a5e45209",
                                "text": "„In der Informatik wird zwischen zwei Schrifttypen unterschieden: serifenloser Schrift und Serifenschrift. Der Unterschied ist leicht erkennbar: serifenlose Schrift hat keine \"Schnörkel\" an den Enden der Buchstaben, Serifenschrift hingegen schon.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
