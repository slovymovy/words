                                "target_lang_sense_clarification": "large room for events, meetings, or gatherings"
                            },
                            {
                                "target_lang_word": "room",
                                "target_lang_sense_clarification": "designated room such as a classroom, conference room, or operating room"
                            },
                            {
                                "target_lang_word": "ward",
                                "target_lang_sense_clarification": "hospital room for patients"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7198c16c-fbba-327f-b2ec-c85c390cea0e",
                    "sense_definition": "Ogół ludzi zgromadzonych w dużym pomieszczeniu, publiczność.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "people_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Po zakończeniu spektaklu cała <w>sala</w> wstała i biła brawo.",
                            "target_lang_translations": {
                                "ru": "После окончания спектакля весь <w>зал</w> встал и зааплодировал.",
                                "en": "After the performance ended, the whole <w>audience</w> stood up and applauded."
                            }
                        },
                        {
                            "text": "Prowadzący spotkanie zapytał, czy na <w>sali</w> są jakieś pytania.",
                            "target_lang_translations": {
                                "ru": "Ведущий встречу спросил, есть ли в <w>зале</w> вопросы.",
                                "en": "The moderator asked if there were any questions from the <w>floor</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "publiczność",
                        "widownia"
                    ],
                    "common_phrases": [
                        "cała sala",
                        "śmiech sali"
                    ],
                    "target_lang_definitions": {
                        "ru": "Люди, собравшиеся в большом помещении; публика.",
                        "en": "The people gathered in a large room or auditorium; an audience."
