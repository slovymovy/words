                                    {
                                        "sense_id": "46dd5d2a-7279-3f9d-8e03-a7e8f55d4f29",
                                        "entry_id": "e7e8d539-fb26-329c-b6f2-1baf3b717fe3",
                                        "glosses": [
                                            "A radio or television serial, typically broadcast in the afternoon or evening, about the lives of melodramatic characters, which are often filled with strong emotions, highly dramatic situations and suspense."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff2e59ca-83b5-4140-9d9c-ce953cb1d974",
                                                "sense_id": "46dd5d2a-7279-3f9d-8e03-a7e8f55d4f29",
                                                "text": "This chapter considers the growing interest in the popular Welsh-language soap opera, Pobol Y Cwm (People of the Valley), and the extent to which discourses of Welshness and definitions of cultural and national identity contribute to the appeal and longevity of the soap."
                                            },
                                            {
                                                "example_id": "abd1fc53-861c-48bb-add8-f6536014e165",
                                                "sense_id": "46dd5d2a-7279-3f9d-8e03-a7e8f55d4f29",
                                                "text": "It also followed the very successful long-running soap opera, Neighbours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69b2fdca-4c39-3bca-90cc-223cb17cba0e",
                                        "entry_id": "e7e8d539-fb26-329c-b6f2-1baf3b717fe3",
                                        "glosses": [
                                            "Such serials in general."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "21d65666-98ed-3175-b72b-dd619872039c",
                                        "entry_id": "e7e8d539-fb26-329c-b6f2-1baf3b717fe3",
                                        "glosses": [
                                            "Any story that is like a soap opera, as by being convoluted or melodramatic."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84ad0ed1-408e-4eb5-87a8-d1be55a723cc",
                                                "sense_id": "21d65666-98ed-3175-b72b-dd619872039c",
                                                "text": "Salal invented some soap opera about a mystery informant, and Meg sold it to the cops."
                                            },
                                            {
                                                "example_id": "341a0ce8-7388-4f81-bbbb-38507d95ca67",
                                                "sense_id": "21d65666-98ed-3175-b72b-dd619872039c",
                                                "text": "An' just lookit how things turned out! What a complete and utter soap opera"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
