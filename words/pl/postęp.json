                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Lekarze starają się farmakologicznie zatrzymać <w>postęp</w> choroby.",
