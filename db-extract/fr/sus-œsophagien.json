                        "glosses": [
                            "Situé au-dessus de l’œsophage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "771ad3b8-b070-4d84-9309-af93ba126d1e",
                                "sense_id": "bdf59cac-2bd9-3c0a-838f-e7924f87c672",
                                "text": "Elle montre les origines sus-œsophagienne et sous-œsophagiennes de ces nerfs, ainsi que leur chiasma."
                            },
                            {
                                "example_id": "287f3e60-0e2a-4c2f-ac34-5fd70bdb2c71",
                                "sense_id": "bdf59cac-2bd9-3c0a-838f-e7924f87c672",
                                "text": "Les deux commissures nerveuses (fig. 22, co) qui relient la masse nerveuse sus-œsophagienne à la masse nerveuse sous-œsophagienne entourent l’œsophage comme un collier et sont très courtes chez la femelle, un peu plus longues chez le mâle ; elles prennent naissance dans les parties latérales du cerveau proprement dit."
                            }
                        ]
                    }
