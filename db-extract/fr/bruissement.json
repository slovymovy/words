        "fr-extract.jsonl": [
            {
                "entry_id": "831fab4f-cecf-3e49-9828-fe3ef7891b6b",
                "word": "bruissement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ff044291-0bb8-46a2-a556-534071a44f8c",
                        "entry_id": "831fab4f-cecf-3e49-9828-fe3ef7891b6b",
                        "tags": [
                            "plural"
                        ],
                        "form": "bruissements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "07e2f913-a353-3c7c-84d7-0383cfed12b6",
                        "entry_id": "831fab4f-cecf-3e49-9828-fe3ef7891b6b",
                        "glosses": [
                            "Sorte de bruit confus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58268c19-142d-42e3-aeb5-3eb772ddd1c2",
                                "sense_id": "07e2f913-a353-3c7c-84d7-0383cfed12b6",
                                "text": "Lorsqu’il chasse, encore que guidé surtout par la vue, il est souvent mis en alerte par le bruissement de sa petite proie."
                            },
                            {
                                "example_id": "f92d19d4-0adf-436e-96ca-6ba3fa9ae384",
                                "sense_id": "07e2f913-a353-3c7c-84d7-0383cfed12b6",
                                "text": "…, tout ici, au contraire, est mouvement et murmure : […], des bruissements d’ondes, de faibles gémissements, de sourds meuglements, de doux roucoulements, remplissent ces déserts d’une tendre et sauvage harmonie."
                            },
                            {
                                "example_id": "d8342ab3-2469-42d2-a543-df52b94c63c5",
                                "sense_id": "07e2f913-a353-3c7c-84d7-0383cfed12b6",
                                "text": "[…], et, au milieu du silence troublé par le seul bruissement de la brise hivernale, je crus effectivement entendre de longues plaintes qui me semblaient n’être pas seulement la lamentation du vent."
                            },
                            {
                                "example_id": "35a784e1-239b-41f8-8f1b-16e59b3e49b8",
                                "sense_id": "07e2f913-a353-3c7c-84d7-0383cfed12b6",
                                "text": "Même les hirondelles s’étaient tues, et seul le bruissement du vent dans les feuilles et le craquettement de la cigale donnaient un peu de répit au silence étouffant d’un soir d’été."
                            }
                        ]
                    },
                    {
                        "sense_id": "6b038bca-9f4b-3f37-b637-d7aa4d74252d",
                        "entry_id": "831fab4f-cecf-3e49-9828-fe3ef7891b6b",
                        "glosses": [
                            "Faible effet."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "fa25bca0-40dd-4e0b-8660-b13724d99310",
                                "sense_id": "6b038bca-9f4b-3f37-b637-d7aa4d74252d",
                                "text": "[Sur la phrénologie de Franz Gall] Le bruissement de la postérité n’a pas retenu cette construction théorique révolutionnaire, et seules les bosses du pauvre Gall ont cheminé jusqu’à notre XXIᵉ siècle balbutiant. — (Lionel Naccache, Le Nouvel Inconscient : Freud, le Christophe Colomb des neurosciences, Odile Jacob, 2009, page 269)"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8251e673-39f1-4144-9871-d85b4bf95d69",
                        "source_entry_id": "831fab4f-cecf-3e49-9828-fe3ef7891b6b",
                        "target_lang_word": "rustle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rustle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2f65910b-92f2-3c4e-9d27-2da44a013505",
                                        "entry_id": "1be8a3ea-6018-3138-a654-6c581f929481",
                                        "glosses": [
                                            "A soft crackling sound similar to the movement of dry leaves."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4af3ee78-5880-4a76-a3d1-e7b51f4ef070",
                                                "sense_id": "2f65910b-92f2-3c4e-9d27-2da44a013505",
                                                "text": "He heard the silken rustle of a dressing-gown being drawn on."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0eeeac5c-9345-320e-9f70-819a801bb7bb",
                                        "entry_id": "1be8a3ea-6018-3138-a654-6c581f929481",
                                        "glosses": [
                                            "A movement producing such a sound."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "rustle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3aff0598-2450-3b38-8563-fd6fb5f7f225",
                                        "entry_id": "0a3ab49d-07b0-3bd2-9dd7-21500fbd7038",
                                        "glosses": [
                                            "To move (something) with a soft crackling sound."
                                        ],
                                        "tags": [
                                            "ergative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd03a0fb-4128-4447-8a6f-9488e2ff46f5",
                                                "sense_id": "3aff0598-2450-3b38-8563-fd6fb5f7f225",
                                                "text": "The next day at three o'clock we were again at the door, and the footmen as before; we heard the silk dress rustle, and the lady came down the steps and in an imperious voice, she said, \"York, you must put those horses' heads higher, they are not fit to be seen.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3d5be6e-daf2-3f3f-978e-215ab7d7a817",
                                        "entry_id": "0a3ab49d-07b0-3bd2-9dd7-21500fbd7038",
                                        "glosses": [
                                            "To make or obtain in a lively, energetic way."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "982d36d9-73ef-4d3e-9abb-6dd2ce90d938",
                                                "sense_id": "c3d5be6e-daf2-3f3f-978e-215ab7d7a817",
                                                "text": "When at last the lumber was piled again in its rightful place, and the boxes of food had been returned to the shelter from which they had been stolen, the two friends rustled a meal, and then set off on horseback […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5eb0de50-dfb9-3308-9d43-ff3a9af9c952",
                                        "entry_id": "0a3ab49d-07b0-3bd2-9dd7-21500fbd7038",
                                        "glosses": [
                                            "To steal (cattle or other livestock)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "194f1483-392e-4b9c-88bb-3bf2203c9a85",
