                "senses": [
                    {
                        "sense_id": "685086c3-a2ef-39e3-b9d6-4411d8033ebd",
                        "entry_id": "7d6e47cc-50f7-39a2-a1ff-5bdc9456c0e6",
                        "glosses": [
                            "Faire devenir un oligopole."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78b15ba8-9607-44cd-bb15-831baf39e2a3",
                                "sense_id": "685086c3-a2ef-39e3-b9d6-4411d8033ebd",
                                "text": "Grâce à la protection douanière du marché national, ces énormes liquidités leur ont permis d'oligopoliser les activités commerciales, certains services et l'immobilier."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ef5e4710-87a3-42ee-8fb1-11c01a021603",
                        "source_entry_id": "7d6e47cc-50f7-39a2-a1ff-5bdc9456c0e6",
                        "source_sense_id": "685086c3-a2ef-39e3-b9d6-4411d8033ebd",
                        "target_lang_word": "oligopolize",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oligopolize",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4763f48c-c000-3f2e-8a85-3578f3fccb44",
                                        "entry_id": "9de07275-9524-35da-af49-f87d3132b567",
                                        "glosses": [
                                            "To convert a market into an oligopoly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24718813-68fe-4c21-ba98-c1aa0afd21d8",
                                                "sense_id": "4763f48c-c000-3f2e-8a85-3578f3fccb44",
                                                "text": "Also, another reason to oligopolize is uncertainity^([sic]) of world economy because of value of the US high dollar."
                                            },
                                            {
                                                "example_id": "6184ab1c-a7cc-435d-ab95-f3836af7c905",
                                                "sense_id": "4763f48c-c000-3f2e-8a85-3578f3fccb44",
                                                "text": "Japanese trading companies and large seafood companies responded with attempts to monopolize or oligopolize import and sales routes."
                                            },
                                            {
                                                "example_id": "af9d635b-91ab-4bdc-8e10-e844b9b45917",
                                                "sense_id": "4763f48c-c000-3f2e-8a85-3578f3fccb44",
                                                "text": "It is, of course, possible for an enterprising body to highly diversify its business into various industries and concurrently to oligopolize some of the industries, but it is rather rare."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
