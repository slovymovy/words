                        "glosses": [
                            "grote badhanddoek die groot genoeg is om languit op te liggen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e455b4e6-e3a3-41d0-a702-60eb009299c4",
                                "sense_id": "bedfe66c-f364-3319-aa00-3bbbcd274b16",
                                "text": "Ze klauteren het dijkje op en zoeken een paar platte keien waar ze hun badlakens over uitspreiden."
                            },
                            {
                                "example_id": "887c3ace-c7f1-40ed-bf12-b6d8c686d796",
                                "sense_id": "bedfe66c-f364-3319-aa00-3bbbcd274b16",
                                "text": "Een tandenborstel, bikini en een strandlaken. Dingen die bijna iedereen op zijn vakantiechecklist heeft staan. Daar kan tegenwoordig ook een fotograaf aan toegevoegd worden, want in de VS blijken jonge gezinnen hun Facebookfoto's zo belangrijk te vinden dat ze iemand inhuren om die voor ze te maken."
                            }
                        ]
                    }
