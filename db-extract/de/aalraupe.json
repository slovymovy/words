                        "examples": [
                            {
                                "example_id": "07f9a4ef-7b29-4b12-a1f2-4c66737f684e",
                                "sense_id": "ed2386db-f05d-3934-8098-b18a44f47f7f",
                                "text": "Ich habe hier noch nie eine Aalraupe gesehen."
                            },
                            {
                                "example_id": "7884701d-f60c-44bd-845e-b8135c528556",
                                "sense_id": "ed2386db-f05d-3934-8098-b18a44f47f7f",
                                "text": "„ Eine angeblich probate Methode zur Verhütung der Fraisen bestand darin, einer Aalraupe – das ist ein Süßwasserfisch mit froschähnlichem Schädel – lebendig den Kopf abzubeißen, diesen zu dörren und sodann in pulverisierter Form dem Kindlein noch vor der Taufe einzugeben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
