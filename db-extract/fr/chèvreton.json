                        "entry_id": "59205f9a-0ea9-3240-a45f-f223bc496c90",
                        "glosses": [
                            "Petit fromage au lait de chèvre, à pâte molle, à croûte naturelle, fabriqué en Auvergne, plus particulièrement dans les régions du Forez, du Livradois, du Vivarais et du Velay."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b995cbe1-69c5-4ff5-bbf4-a54ba25bbbab",
                                "sense_id": "01fadf93-686a-3b35-ad0d-274313ea2ed2",
                                "text": "Comme disait M. Clovis, selon le célèbre vers de Boileau : « Un chèvreton sans défaut vaut seul un long gruyère. »"
                            },
                            {
                                "example_id": "6342fc18-9cc4-4ebc-9a45-078d34de183f",
                                "sense_id": "01fadf93-686a-3b35-ad0d-274313ea2ed2",
                                "text": "Un quignon de pain, deux chèvretons, trois poignées de noix et de prunes."
                            }
                        ]
                    }
