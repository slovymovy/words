                                "example_id": "390ee4e8-9f14-4637-ac81-239461521357",
                                "sense_id": "023b1208-27d9-3741-b072-eb67b1edad38",
                                "text": "Toute conception de la diversité culturelle, ou multiculturalité, ainsi que ses répercussions dans la pratique pédagogique dépendent de la notion de culture à laquelle on se réfère."
                            }
                        ]
                    }
