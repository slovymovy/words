                            }
                        },
                        {
                            "text": "Będąc na <w>kręglach</w>, natknęliśmy się na znajomych.",
                            "target_lang_translations": {
                                "ru": "Когда мы были в <w>боулинге</w>, мы встретили знакомых."
                            }
                        }
                    ],
                    "synonyms": [
