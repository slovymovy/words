                "senses": [
                    {
                        "sense_id": "3c0dbc6e-075e-30bd-9f0e-0065d4afa40e",
                        "entry_id": "109ad94b-c2fb-331e-a4f2-66a505cd0240",
                        "glosses": [
                            "Celui qui est employé à la sape."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "024f4874-c32e-4605-b42e-d987f4a6582b",
                                "sense_id": "3c0dbc6e-075e-30bd-9f0e-0065d4afa40e",
                                "text": "D’un autre côté, les assiégeants cherchaient à mettre le feu à ces hourds de bois qui rendaient le travail des sapeurs impossible […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "40bfa3f4-3ed1-34d2-b557-f5bbb54da67c",
                        "entry_id": "109ad94b-c2fb-331e-a4f2-66a505cd0240",
                        "glosses": [
                            "Soldat de l’arme du génie chargé, d’une part de l’exécution des tranchées et surtout des sapes, c’est-à-dire des ouvrages souterrains permettant de renverser ou de dynamiter un édifice et d'autre part, de faciliter le passage des armées à travers les terrains difficiles. NB : La Légion étrangère compte aussi ses propres sapeurs (ou pionniers) qui défilent traditionnellement en tête lors des parades militaires."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3768c730-94f2-4091-96c6-8d4894b46b13",
                                "sense_id": "40bfa3f4-3ed1-34d2-b557-f5bbb54da67c",
                                "text": "Une petite escouade de sapeurs était entrée avec le détachement. Hervé leur commanda d'ouvrir à coup de pioche des meurtrières dans le mur qui séparait le jardin de la campagne […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "3e7e224c-d4a8-3abf-8581-2725be9e1549",
                        "entry_id": "109ad94b-c2fb-331e-a4f2-66a505cd0240",
                        "glosses": [
                            "Désignation du grade d’un membre d’un régiment de génie détenant le grade de soldat."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "36269d13-bc8f-436f-815b-5c04beab1c51",
                        "source_entry_id": "109ad94b-c2fb-331e-a4f2-66a505cd0240",
                        "source_sense_description": "Soldat de l’arme du génie",
                        "target_lang_word": "sapper",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sapper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1b26c848-fd0b-37a9-8c4d-736d50263ec9",
                                        "entry_id": "dabdf740-1283-3af9-8aab-604a18fe1a94",
                                        "glosses": [
                                            "A combat engineer; an engineer or a soldier engaged in attacking, destroying, and circumventing or building fortifications, bridges, and roads; a military engineer active in a combat zone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0527f19d-02f1-4e9b-b030-6447115e5812",
                                                "sense_id": "1b26c848-fd0b-37a9-8c4d-736d50263ec9",
                                                "text": "his knowledge of Arabic and freedom from the theories of the ordinary sapper-school enabled him to teach the art of demolition to unlettered Beduin in a quick and ready way."
                                            },
                                            {
                                                "example_id": "883134b9-1114-4832-8a5a-ce5e197be041",
                                                "sense_id": "1b26c848-fd0b-37a9-8c4d-736d50263ec9",
                                                "text": "A vast minefield trapped Ukrainian troops for weeks as infantry sappers slowly cleared an assault route on foot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7df39efd-d4d5-32f1-9e1b-976944886395",
                                        "entry_id": "dabdf740-1283-3af9-8aab-604a18fe1a94",
                                        "glosses": [
                                            "An officer or private of the Royal Engineers."
                                        ],
                                        "tags": [
                                            "British",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "764f16f1-8d03-48fb-bb9d-0cfcc589444e",
                                                "sense_id": "7df39efd-d4d5-32f1-9e1b-976944886395",
                                                "text": "By a remarkable piece of railway reconstruction work on the part of the Allied Forces—mainly South African railway construction troops—mines laid along the track by the retreating enemy were removed by sappers, and the German damage made good, within 7 days."
                                            },
                                            {
                                                "example_id": "8f8235af-de34-4357-a2a5-17ab3a2032e2",
                                                "sense_id": "7df39efd-d4d5-32f1-9e1b-976944886395",
                                                "text": "Billinge, from St Austell, was one of the first soldiers to land on 'Gold' beach on June 6 1944. He was a sapper attached to the 44 Royal Engineer Commandos and was one of only four to survive from his unit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "23c302c4-f0d4-4f23-b596-25fec4616668",
                        "source_entry_id": "109ad94b-c2fb-331e-a4f2-66a505cd0240",
                        "source_sense_description": "Soldat de l’arme du génie",
                        "target_lang_word": "combat engineer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "combat engineer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "84d10a18-5753-382f-89de-4966caa9e058",
                                        "entry_id": "228e6d24-0aff-3b37-b0d1-d3c15ed0055c",
                                        "glosses": [
                                            "A soldier employed to carry out engineering tasks in support of land forces during combat operations, facilitating the mobility of friendly forces while impeding that of the enemy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e269bb7a-35ff-4140-a719-2fee371ccfc3",
                                                "sense_id": "84d10a18-5753-382f-89de-4966caa9e058",
                                                "text": "With him were 60,000 combat engineers for multiple bridgings of the river, and hundreds of thousands of tons of supplies, landing craft, and amphibious vehicles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
