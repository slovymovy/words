                        "entry_id": "e216eae7-7ee7-3a2b-8e05-3bb7c708bbf8",
                        "glosses": [
                            "Qui ravigote, qui redonne de la force ou de la vigueur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33ae9976-1d63-4a83-8454-6b7dd95dd7a9",
                                "sense_id": "40aa7add-c895-3f7a-9cf5-b02f2540a00b",
                                "text": "Je m’étais acheté une jolie petite tête d’agneau ; avec une vinaigrette à l’estragon, c’est ravigotant, par les chaleurs…"
                            },
                            {
                                "example_id": "56399438-8cfe-45b0-82ad-68fafdbfedbf",
                                "sense_id": "40aa7add-c895-3f7a-9cf5-b02f2540a00b",
                                "text": "Elle est aidée par deux femmes : la mienne, qui me laisse parfois passer une partie de la nuit, ce qui fait que je tire encore un coup de temps en temps, et une petite rousse ravigotante."
                            }
                        ]
                    }
