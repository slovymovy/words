                "senses": [
                    {
                        "sense_id": "67df72e7-dfaf-3d89-bac5-0aad34da9aa6",
                        "entry_id": "aa4e8763-716c-384e-90ce-57ba117afb6b",
                        "glosses": [
                            "die Größe eines Fußballs habend, so groß wie ein Fußball"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a4d6ef5-9d44-4541-ac0c-90fa4e3c41a6",
                                "sense_id": "67df72e7-dfaf-3d89-bac5-0aad34da9aa6",
                                "text": "„Sie hat schon einige Monstrositäten in ihrem Leben gesehen, aber ein fußballgroßes Nest aus grauem Menschenhaar, in dem eine lebende Ratte hockt, gehört nicht dazu.“"
                            },
                            {
                                "example_id": "502acb7b-0790-406e-8a06-8405ac36152a",
                                "sense_id": "67df72e7-dfaf-3d89-bac5-0aad34da9aa6",
                                "text": "„Die schwarze Blase ist überhaupt keine Blase, sondern die Rückseite einer Jacke. Sie treibt auf dem Wasser, zusammen mit einem fußballgroßen Gegenstand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
