                                        "glosses": [
                                            "A repair made by darning."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1656c479-341c-4003-8dd2-da5bfc0cd097",
                                                "sense_id": "7e3a3dbb-eb18-3135-b55c-20c6854e1a97",
                                                "text": "Who has told of the turnings, the dyings, the ironings, the darnings, that have gone to make misses of ten pounds a-year pin-money look as smart as the squanderer of five hundred?"
