                "senses": [
                    {
                        "sense_id": "9c59a5d5-943a-3aa8-b461-d107eae40cc6",
                        "entry_id": "085c8448-9f6a-38c8-92a2-bd0dfbc7878f",
                        "glosses": [
                            "прост. то же, что вытряхнуть; тряся, извлечь, выронить; заставить выпасть откуда-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ace71500-ea5a-4142-9a0c-30765547f60d",
                                "sense_id": "9c59a5d5-943a-3aa8-b461-d107eae40cc6",
                                "text": "Но прошу рассудить-с: если я вытрусил бумажник из кармана, переменяя сюртук, то вытрушенный предмет должен был лежать тут же на полу."
                            },
                            {
                                "example_id": "e180a6d7-dc54-47ec-af14-932b677fd27a",
                                "sense_id": "9c59a5d5-943a-3aa8-b461-d107eae40cc6",
                                "text": "У вас не будет повода сомневаться в моей благодарности, ― объявил он торжественно и вытрусил из тощего кошелька несколько медных монет."
                            }
                        ]
                    }
