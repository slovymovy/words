                "senses": [
                    {
                        "sense_id": "6844433c-d73e-3552-b36b-28cd1608a13f",
                        "entry_id": "58c1a574-aa70-38e1-91ad-82f56eb7416e",
                        "glosses": [
                            "в некоторой, в определённой степени чёрный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34638f5a-e42f-487a-90e1-c30af2abfaf0",
                                "sense_id": "6844433c-d73e-3552-b36b-28cd1608a13f",
                                "text": "Пестрины, или рябины, на шее, зобу и брюшке разноцветные: черноватые, белые, желтоватые и даже красноватые…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7a298fe2-91f2-4805-a558-19c759020c5d",
                        "source_entry_id": "58c1a574-aa70-38e1-91ad-82f56eb7416e",
                        "source_sense_id": "6844433c-d73e-3552-b36b-28cd1608a13f",
                        "target_lang_word": "blackish",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blackish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4a132fc9-a95d-3414-9075-aadfbe481ae5",
                                        "entry_id": "1852c925-1ffe-36eb-823e-ecdb4a1023d7",
                                        "glosses": [
                                            "somewhat black"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6799a507-7b73-4683-a408-91314d27733d",
                                                "sense_id": "4a132fc9-a95d-3414-9075-aadfbe481ae5",
                                                "text": "Hác Sá (Black Sand) is the most popular beach in Macau. The sand is indeed a grey to blackish colour and makes the water look somewhat dirty (especially at the tide line), but it's perfectly clean."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "95fb6f38-91a0-4365-91b0-af5f7ad5d0c8",
                        "source_entry_id": "58c1a574-aa70-38e1-91ad-82f56eb7416e",
                        "source_sense_id": "6844433c-d73e-3552-b36b-28cd1608a13f",
                        "target_lang_word": "blacky",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blacky",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d496ca9a-f720-3bec-9256-16870078fd96",
                                        "entry_id": "1aa691e0-95d5-32d0-83a0-6c83397a629d",
                                        "glosses": [
                                            "A black person."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "ethnic",
                                            "informal",
                                            "offensive",
                                            "slur"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b698cc2-e20f-494a-8c7f-e858912fddd1",
                                                "sense_id": "d496ca9a-f720-3bec-9256-16870078fd96",
                                                "text": "[I]t was agreed that two double beds were in requisition: — one for the host and hostess — and the other for the loving nigger and his wife, who it plainly appeared, had no inclination to be separated. Our hope was in a double bed — the one which the blacky and his fairer half looked at with a longing eye — but out of which he had no idea of turning: […]"
                                            },
                                            {
                                                "example_id": "0ceb8ba1-3920-4b24-b25f-c7f4724acc9d",
                                                "sense_id": "d496ca9a-f720-3bec-9256-16870078fd96",
                                                "text": "Apropos of Van Balen, an artist who painted me lately had painted a blackamoor praying; and not filling his canvas, stuffed in his little girl aside of a blacky gaping at him unmeaningly; and then did not know what to call it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "55e7a64d-0838-406c-a914-70e0f6ac86d6",
                        "source_entry_id": "58c1a574-aa70-38e1-91ad-82f56eb7416e",
                        "source_sense_id": "6844433c-d73e-3552-b36b-28cd1608a13f",
                        "target_lang_word": "negruzco",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "negruzco",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "483cd5f7-c04d-3b45-8df5-1c465af19145",
                                        "entry_id": "ec84aaf7-9708-3ac3-8f60-76bae5111453",
                                        "glosses": [
                                            "De color similar al negro; de tono oscuro."
                                        ],
                                        "tags": [
                                            "Colores"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7a786b5-24da-40fc-af56-cb7d73fcdccb",
                                                "sense_id": "483cd5f7-c04d-3b45-8df5-1c465af19145",
                                                "text": "Según la creencia popular, el calor de las llamas provocó que la talla se tornarse de un color negruzco."
                                            },
                                            {
                                                "example_id": "cf1a906e-a86e-4ef5-a77a-a9be38e57f61",
                                                "sense_id": "483cd5f7-c04d-3b45-8df5-1c465af19145",
                                                "text": "Recojo extrañas caracolas, cristales que al traer a nuestro elemento se convierten en guijarros negruzcos e informes."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
