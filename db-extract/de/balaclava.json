                "senses": [
                    {
                        "sense_id": "3011d8c0-70c5-33f7-83f8-99c778201c69",
                        "entry_id": "8a8469e1-ec28-30e0-877d-d3b402e62b95",
                        "glosses": [
                            "den ganzen Kopf und den Hals umhüllende Mütze, die entweder nur das Gesicht oder auch nur Augen und Mund freilässt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c05f06b-6111-41a0-8314-d680529bc105",
                                "sense_id": "3011d8c0-70c5-33f7-83f8-99c778201c69",
                                "text": "„Jenen Teil des Gesichts, der nicht von der Balaclava — so nannte man in England seit dem Krimkrieg eine Sturmhaube — geschützt wurde, spürte Oates schon seit einer Weile nicht mehr.“"
                            },
                            {
                                "example_id": "03b6686f-d6de-4252-9bdd-3dd14404189b",
                                "sense_id": "3011d8c0-70c5-33f7-83f8-99c778201c69",
                                "text": "„Nein, wir haben ihn doch noch nie auf frischer Tat ertappt“, antwortete Jack, „übrigens, bevor ich es vergesse, habt ihr außerdem für uns Balaclavas über? Wir wollen nämlich unerkannt bleiben.“ „Balaclavas?“ „Sturmhauben […]”"
                            },
                            {
                                "example_id": "8cfa6399-ebeb-44e4-85ea-8446f5035e9b",
                                "sense_id": "3011d8c0-70c5-33f7-83f8-99c778201c69",
                                "text": "„Der im militärischen Bereich gebräuchliche Name Balaclava stammt aus dem Krimkrieg (1853–1856), wo man gegen die klimatischen Bedingungen des russischen Winters erstmals Strickmützen dieser Art an die britischen Truppen ausgab und nach dem auf dem Kriegsschauplatz gelegenen Ort Balaklawa benannte.“"
                            },
                            {
                                "example_id": "9e52cfc0-34a3-418b-ab31-470118b0ad9d",
                                "sense_id": "3011d8c0-70c5-33f7-83f8-99c778201c69",
                                "text": "„Als ich letztes Wochenende mit ein paar Freunden über einen eisigen angefrorenen See in Lettland spaziert bin, musste ich situationsbedingt […] sehr intensiv über eine Balaclava nachdenken, da es mir unter der Mütze doch sehr zugig wurde.“"
                            },
                            {
                                "example_id": "85371d2e-f75a-4a3c-9505-fafd0fe45085",
                                "sense_id": "3011d8c0-70c5-33f7-83f8-99c778201c69",
                                "text": "Die Balaclava ist ein Gesichts-, Hals- und Nackenschutz mit Öffnungen für Augen und Nase."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
