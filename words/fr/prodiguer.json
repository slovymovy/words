{
    "word_family": [
        "prodigalité",
        "prodigue"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4b177ada-4e18-3855-a335-89570c91f112",
                    "sense_definition": "Donner ou accorder généreusement et en abondance des soins, des conseils ou des marques d'affection.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "donner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'infirmière <w>prodigue</w> des soins attentifs aux malades hospitalisés."
                        },
                        {
                            "text": "Le professeur <w>prodiguait</w> de précieux conseils avant chaque examen important."
                        }
                    ],
                    "synonyms": [
                        "dispenser",
                        "accorder"
                    ],
                    "antonyms": [
                        "ménager",
                        "refuser"
                    ],
                    "common_phrases": [
                        "prodiguer des soins",
                        "prodiguer des conseils",
                        "prodiguer des encouragements"
                    ]
                },
                {
                    "sense_id": "5367e93b-fcbd-382c-882c-c9dea5884390",
                    "sense_definition": "Dépenser son argent ou ses biens de façon excessive et sans compter.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gaspiller",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jeune héritier a rapidement <w>prodigué</w> toute sa fortune dans des soirées luxueuses."
                        },
                        {
                            "text": "Il est dangereux de <w>prodiguer</w> ses ressources financières sans penser à l'avenir."
                        }
                    ],
                    "synonyms": [
                        "gaspiller",
                        "dissiper"
                    ],
                    "antonyms": [
                        "économiser",
                        "épargner"
                    ],
                    "common_phrases": [
                        "prodiguer son bien",
                        "prodiguer son argent"
                    ]
                },
                {
                    "sense_id": "f1239fd7-fe28-38d0-b5b9-70d42765b0ed",
                    "sense_definition": "Se dépenser sans réserve pour les autres ou se donner corps et âme à une tâche.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "devouement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette bénévole se <w>prodigue</w> pour soutenir les familles en difficulté."
                        },
                        {
                            "text": "Épuisé par son travail, le médecin a enfin compris qu'il ne pouvait plus se <w>prodiguer</w> ainsi."
                        }
                    ],
                    "synonyms": [
                        "se dévouer"
                    ],
                    "antonyms": [
                        "s'économiser",
                        "se ménager"
                    ],
                    "common_phrases": [
                        "se prodiguer pour autrui",
                        "se prodiguer sans compter"
                    ]
                }
            ]
        }
    ]
}