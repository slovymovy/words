        "nl-extract.jsonl": [
            {
                "entry_id": "a3925bf9-fa6f-37a4-b64a-95e591e92662",
                "word": "kontje",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "314a47ae-10eb-37ee-9fab-efb870e3dec3",
                        "entry_id": "a3925bf9-fa6f-37a4-b64a-95e591e92662",
                        "glosses": [
                            "verkleinwoord enkelvoud van het zelfstandig naamwoord kont"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "8c4fdeff-16c8-494d-94be-9b919da1044b",
                                "sense_id": "314a47ae-10eb-37ee-9fab-efb870e3dec3",
                                "text": "Dan ontdekken we onze eerste wisent, zwiepend met zijn lange staart met kwastje. (…) Achter de heuvel graast de kudde, kastanjebruin in de middagzon. Kolossale dieren, met een klein kontje, brede schouders, een flinke vetbult als bochel op de hoge rug en fraaie, gekromde horens."
                            },
                            {
                                "example_id": "59e226db-8260-4296-8f37-448df12a34e7",
                                "sense_id": "314a47ae-10eb-37ee-9fab-efb870e3dec3",
                                "text": "Hiphopmerken werken graag met vrouwen zoals ik. Het maakt niet uit of je maatje 40 hebt en je hoeft geen strakke buik of een klein kontje te hebben."
                            }
                        ]
                    },
                    {
                        "sense_id": "43faf1dd-b100-339c-927b-0ebc8e7de254",
                        "entry_id": "a3925bf9-fa6f-37a4-b64a-95e591e92662",
                        "glosses": [
                            "dim. tant. uiteinde dat niet wordt gegeten of bereid als de rest"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "211c1f38-5199-42cd-88ef-a94b555261cf",
                                "sense_id": "43faf1dd-b100-339c-927b-0ebc8e7de254",
                                "text": "Als je een paar schoteltjes maakt die op kamertemperatuur gegeten worden, dan zie je jezelf vorderen – de tuinboontjes met komijn, de wortel met citroensap, oranjebloesemwater en munt, de doperwtjes met een in stukjes gehakt kontje serranoham, het is allemaal zo klaar en meteen lekker."
                            }
                        ]
                    },
                    {
                        "sense_id": "567c6829-896c-371d-b266-e16e8c618b88",
                        "entry_id": "a3925bf9-fa6f-37a4-b64a-95e591e92662",
                        "glosses": [
                            "dim. tant. uiteinde dat niet wordt gegeten of bereid als de rest",
                            "bij groente of fruit de overgang naar steel of wortels"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "0a9744a8-c8ee-495d-a84e-8a3489da1206",
                                "sense_id": "567c6829-896c-371d-b266-e16e8c618b88",
                                "text": "Als je een paar schoteltjes maakt die op kamertemperatuur gegeten worden, dan zie je jezelf vorderen – de tuinboontjes met komijn, de wortel met citroensap, oranjebloesemwater en munt, de doperwtjes met een in stukjes gehakt kontje serranoham, het is allemaal zo klaar en meteen lekker."
                            },
                            {
                                "example_id": "d1935eeb-0313-4273-a1f9-693d18354c28",
                                "sense_id": "567c6829-896c-371d-b266-e16e8c618b88",
                                "text": "Snijd het kontje van de courgettes."
                            },
                            {
                                "example_id": "32fb2f33-6b63-473d-99e1-793260ac9e52",
                                "sense_id": "567c6829-896c-371d-b266-e16e8c618b88",
                                "text": "Snij het kontje van de venkel en het bovenste gedeelte van de stelen."
                            },
                            {
                                "example_id": "7d3e886e-20aa-494c-8f0e-a09b28de74ac",
                                "sense_id": "567c6829-896c-371d-b266-e16e8c618b88",
                                "text": "Haal punt en kontje van de bonen af."
                            }
                        ]
                    },
                    {
                        "sense_id": "82129bea-40d2-383b-83b7-a7d240941a0b",
                        "entry_id": "a3925bf9-fa6f-37a4-b64a-95e591e92662",
                        "glosses": [
                            "dim. tant. uiteinde dat niet wordt gegeten of bereid als de rest",
                            "overgebleven uiteinde van een worst"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "2a84800b-9742-4a60-87f4-664ca7124f51",
                                "sense_id": "82129bea-40d2-383b-83b7-a7d240941a0b",
                                "text": "Als je een paar schoteltjes maakt die op kamertemperatuur gegeten worden, dan zie je jezelf vorderen – de tuinboontjes met komijn, de wortel met citroensap, oranjebloesemwater en munt, de doperwtjes met een in stukjes gehakt kontje serranoham, het is allemaal zo klaar en meteen lekker."
                            },
                            {
                                "example_id": "21ef4acc-e69e-4037-a7a0-3e331432269a",
                                "sense_id": "82129bea-40d2-383b-83b7-a7d240941a0b",
                                "text": "Want ‘we’ gooien gemiddeld wel veertig kilo voedsel per persoon per jaar weg, sommige bronnen zeggen zelfs: wel vijftig kilo. () Maar denk eens aan alle beschimmelde boterhammen, de restjes die achter in de ijskast uit het zicht zijn gaan staan bederven, de verschrompelde worteltjes en slappe bleekselderie uit de groentela, de halve blikjes tomatenpuree, de uitgelopen uien en aardappelen, de restjes slagroom en zure room die naar kaas zijn gaan ruiken, de boter die naar kaas is gaan ruiken, de kaas die een zweterige korst is geworden, de muffe amandelen, het kontje worst waar een zure lucht aan hangt, de drie plakjes lichtgroene ham, de glazig geworden gekookte aardappelen, de keiharde ontbijtkoek of de koekjes die slof zijn geworden in de trommel."
                            }
                        ]
                    },
                    {
                        "sense_id": "6822d8fc-add4-381f-b114-32856c7ceb41",
                        "entry_id": "a3925bf9-fa6f-37a4-b64a-95e591e92662",
                        "glosses": [
                            "dim. tant. uiteinde dat niet wordt gegeten of bereid als de rest",
                            "bij in plakken gesneden brood of gebak: elk van de uiteinden die grotendeels uit korst bestaan"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "dc549402-3d35-4535-9620-4dd3a8fe2572",
                                "sense_id": "6822d8fc-add4-381f-b114-32856c7ceb41",
                                "text": "Als je een paar schoteltjes maakt die op kamertemperatuur gegeten worden, dan zie je jezelf vorderen – de tuinboontjes met komijn, de wortel met citroensap, oranjebloesemwater en munt, de doperwtjes met een in stukjes gehakt kontje serranoham, het is allemaal zo klaar en meteen lekker."
                            },
                            {
                                "example_id": "6672e39a-9900-4d8d-8a1e-d3931920857e",
                                "sense_id": "6822d8fc-add4-381f-b114-32856c7ceb41",
                                "text": "Geen verspilling zo erg als voedselverspilling. Of het nu verkeerd inkoopbeleid in de horeca of dat laatste kontje brood in de broodtrommel is, het is doodzonde en schandalig als je bedenkt dat elders mensen sterven van de honger."
                            }
                        ]
                    },
                    {
                        "sense_id": "56fb00fa-7b1b-371b-aee3-a593959e9c83",
                        "entry_id": "a3925bf9-fa6f-37a4-b64a-95e591e92662",
                        "glosses": [
                            "dim. tant. behulpzame duw tegen het achterste"
                        ],
                        "tags": [
                            "metonymisch"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "f1210cd4-b379-36c4-af74-02ce2084f89b",
                        "entry_id": "a3925bf9-fa6f-37a4-b64a-95e591e92662",
                        "glosses": [
                            "dim. tant. behulpzame duw tegen het achterste",
                            "van iemand die iets beklimt"
                        ],
                        "tags": [
                            "metonymisch"
                        ],
                        "examples": [
                            {
                                "example_id": "29527745-3609-4285-a74e-e7b24a1d4363",
                                "sense_id": "f1210cd4-b379-36c4-af74-02ce2084f89b",
                                "text": "Om vier uur klimt Het Ruime Sop met dertig man het podium op, hier en daar wordt een kontje gegeven. Het shantykoor moet groter „en vooral jonger”."
                            }
                        ]
                    },
                    {
                        "sense_id": "79dd096a-f5ff-3812-b99c-b95cd4772120",
                        "entry_id": "a3925bf9-fa6f-37a4-b64a-95e591e92662",
                        "glosses": [
                            "dim. tant. behulpzame duw tegen het achterste",
                            "van wielrenners"
                        ],
                        "tags": [
                            "metonymisch"
                        ],
                        "examples": [
                            {
                                "example_id": "e0d5f21b-fbce-42b0-b15a-ee6c341ab21c",
                                "sense_id": "79dd096a-f5ff-3812-b99c-b95cd4772120",
                                "text": "De wielrenner in een koers is openbaar bezit. Mensen rennen met hem mee, in duivelspak, gooien water over hem heen. Ongevraagd zitten ze aan zijn billen als ze hem een kontje geven."
                            }
                        ]
                    },
                    {
                        "sense_id": "c6bd52e7-b1f6-303a-bb47-cc8957b3d856",
                        "entry_id": "a3925bf9-fa6f-37a4-b64a-95e591e92662",
                        "glosses": [
                            "dim. tant. behulpzame duw tegen het achterste",
                            "ondersteuning bij het bereiken van een doel"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "eb091408-55a0-43ec-ae2e-f4875eb2e693",
                                "sense_id": "c6bd52e7-b1f6-303a-bb47-cc8957b3d856",
                                "text": "Het doel van het spel is dat werkloze jongeren hun kans op een baan vergroten. Ze doen dit door opdrachten uit te voeren waarmee ze hun cv aantrekkelijker maken. Hierdoor verdienen ze punten, waarmee ze in een online winkel zaken kunnen kopen die hun carrière een kontje geven. Denk aan een sollicitatietraining, een meeloopstage of een ontmoeting met de directeur van een groot bedrijf."
                            },
                            {
                                "example_id": "8583ce31-4234-4130-93ab-1d0a9a3e56d3",
                                "sense_id": "c6bd52e7-b1f6-303a-bb47-cc8957b3d856",
                                "text": "Hij pleit voor een sterke overheid, die vooral ook dienstbaar is aan mensen die “een kontje” nodig hebben in het leven."
                            }
                        ]
                    },
                    {
                        "sense_id": "6d107f28-1f09-3153-8da5-9d7f1b99aded",
                        "entry_id": "a3925bf9-fa6f-37a4-b64a-95e591e92662",
                        "glosses": [
                            "duw met het achterste"
                        ],
                        "tags": [
                            "metonymisch"
                        ],
                        "examples": [
                            {
                                "example_id": "78cadcb4-99fb-4706-8220-38553b784627",
                                "sense_id": "6d107f28-1f09-3153-8da5-9d7f1b99aded",
                                "text": "Vorige week zag ik Kamerleden van het CDA en de Partij voor de Dieren elkaar in de wandelgangen al met een kontje begroeten."
                            },
                            {
                                "example_id": "a19b896a-aff3-4a01-8f38-c7b4dc167496",
                                "sense_id": "6d107f28-1f09-3153-8da5-9d7f1b99aded",
                                "text": "Arne: „Soms stonden er zoveel rond mijn microfoon dat ik ze maar heb laten zingen. Maar één gast die alleen maar stond te grunten, heb ik wel even een kontje gegeven. Zo van: wegwezen jij!”"
                            }
                        ]
                    }
