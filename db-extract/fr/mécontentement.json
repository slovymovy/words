                                        "sense_id": "463ab6a6-4eb3-3d1b-9d29-f2ad594b271e",
                                        "entry_id": "697b33bc-1b82-3c3d-b3bf-f2a63eaa1265",
                                        "glosses": [
                                            "Dissatisfaction."
