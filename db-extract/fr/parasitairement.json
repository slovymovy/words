                "senses": [
                    {
                        "sense_id": "f6f942c4-c65c-3c80-aa4b-44d43c0f2b49",
                        "entry_id": "6ba2dad9-8892-3131-b8f8-e69b97fdb800",
                        "glosses": [
                            "De façon parasitaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ad8df4b-0bfe-4b2a-8f1a-acd02a0c719d",
                                "sense_id": "f6f942c4-c65c-3c80-aa4b-44d43c0f2b49",
                                "text": "Il vit parasitairement sur ses auxiliaires, comme il aime parasitairement ses amantes, et la preuve de ce parasitisme amoureux ressort de ses infidélités et de ses abandons."
                            },
                            {
                                "example_id": "d83be20b-83cd-43b9-b3de-b3048738cdd8",
                                "sense_id": "f6f942c4-c65c-3c80-aa4b-44d43c0f2b49",
                                "text": "La nature a tracé à cet effet une voie très simple, elle a assigné à ces végétaux des plantes nourrices dans lesquelles ils implantent parasitairement leurs racines pour puiser les substances organiques qui leur sont nécessaires."
                            }
                        ]
                    }
