                "senses": [
                    {
                        "sense_id": "57e0d0bc-a92a-376a-8981-24cd1acb36b4",
                        "entry_id": "28e224a6-91fc-3a06-bafd-d11eeb0a6c88",
                        "glosses": [
                            "ein Kind, das den Kindergarten besucht"
                        ],
                        "tags": [
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "16aeac9f-53d3-4146-b89c-b66c1085aebd",
                                "sense_id": "57e0d0bc-a92a-376a-8981-24cd1acb36b4",
                                "text": "„Mit 3 Jahren Kindergärtler, vom 6. bis 16. Jahr Schulzwängling, vom 16. bis 21. Jahr Fortbildungsschüler, vom 21. bis 24. Soldat, vom 24. bis 27. Reservist, vom 27. bis 32. Landwehrmann – das ist jetzt der normale Lebenslauf der modernen Menschen.“"
                            },
                            {
                                "example_id": "23fa6973-882f-4640-9a89-e4f335d7a815",
                                "sense_id": "57e0d0bc-a92a-376a-8981-24cd1acb36b4",
                                "text": "„Das Lehrpersonal bestand meist aus einem Schulmeister für die Schulkinder und aus mehreren Schulschwestern und »Kindsdirnen« für die Kindergärtler.“"
                            },
                            {
                                "example_id": "ca2925ff-fc4b-4b7f-8be4-e075d1d2676a",
                                "sense_id": "57e0d0bc-a92a-376a-8981-24cd1acb36b4",
                                "text": "„Die Spanne wurde ausgenützt, der Kindergärtler wurde angesprochen, und in einem Gespräch mit Klaus Brunner über Jugendbuchillustrationen und Bilderbücher vor Oberseminaristen konnte auch die oberste Schulstufe in die Aktion einbezogen werden.“"
                            },
                            {
                                "example_id": "15ba2ec7-7b39-41a7-81d5-8ea987c82471",
                                "sense_id": "57e0d0bc-a92a-376a-8981-24cd1acb36b4",
                                "text": "„Die Kindergärtler reagieren auf Fragen nach Bedeutungen oft damit, dass sie von aussersprachlichen Gegenständen und Erfahrungen erzählen.“"
                            },
                            {
                                "example_id": "603a7555-01cb-422e-b553-da150caef500",
                                "sense_id": "57e0d0bc-a92a-376a-8981-24cd1acb36b4",
                                "text": "„In meine Klasse geht auch noch einer, und der ist so klein wie ein Kindergärtler, zu dem sagen wir: Professor Zwiebel.“"
                            },
                            {
                                "example_id": "7a11e654-7145-41fe-8f11-37bfe7e02d3a",
                                "sense_id": "57e0d0bc-a92a-376a-8981-24cd1acb36b4",
                                "text": "„Diese Festlegung reduziert die Phänomenvielfalt, und es entstehen daraus leicht Typisierungen, die für viele Individuen schlecht zutreffen (viele Kinder im Kindergarten sind keine 'typischen Kindergärtler).“"
                            },
                            {
                                "example_id": "3923d4d9-82aa-419d-8c56-d3d0a38469de",
                                "sense_id": "57e0d0bc-a92a-376a-8981-24cd1acb36b4",
                                "text": "„Das war ja das letzte, was ich wünschte: daß sie mich so sähe – einen Kindergärtler.“"
                            },
                            {
                                "example_id": "b6994faa-0ff3-4b27-96c4-6c75ed771d94",
                                "sense_id": "57e0d0bc-a92a-376a-8981-24cd1acb36b4",
                                "text": "„Es zeigte sich, daß für die Kindergärtler und Zweitkläßler höchstens eine kleine Differenz besteht zwischen norddeutscher und schweizerischer Färbung der Standardsprache, während der gleiche Unterschied für die Schüler groß und für die Erwachsenen immer noch ziemlich groß ist.“"
                            },
                            {
                                "example_id": "dcd46b36-4577-4caf-a981-452d0df19045",
                                "sense_id": "57e0d0bc-a92a-376a-8981-24cd1acb36b4",
                                "text": "„Es fällt auf, dass es zahlreiche Witze gibt, die sich sowohl bei den Kindergärtlern wie auch bei den Sechstklässlern grosser Belebtheit erfreuen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aa2d4ec2-93c5-4478-acc6-54a5b5429a48",
                        "source_entry_id": "28e224a6-91fc-3a06-bafd-d11eeb0a6c88",
                        "source_sense_id": "57e0d0bc-a92a-376a-8981-24cd1acb36b4",
                        "source_sense_description": "Schweiz, Liechtenstein, Vorarlberg: ein Kind, das den Kindergarten besucht",
                        "target_lang_word": "kindergartner",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kindergartner",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "78a7bd9f-c44c-3785-8f8a-88d5caf5bca7",
                                        "entry_id": "11bd5505-12e4-364d-a2a3-08765abd68e9",
                                        "glosses": [
                                            "A child who attends a kindergarten."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c37748b-b396-4862-ad5b-1f9e1e314917",
                                                "sense_id": "78a7bd9f-c44c-3785-8f8a-88d5caf5bca7",
                                                "text": "I partnered the older kids with my kindergartners and let everyone get a taste of teaching or learning from someone different."
                                            },
                                            {
                                                "example_id": "d86529c6-d43e-4742-91a5-11b83d4cbdf2",
                                                "sense_id": "78a7bd9f-c44c-3785-8f8a-88d5caf5bca7",
                                                "text": "All 50 states have had school immunization requirements since the beginning of the 1980s, with incoming kindergartners needing shots to protect against diseases including measles, polio and tetanus. No states require a Covid-19 vaccine for schoolchildren."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "kindergartner",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a43d5be0-7c68-3b19-afc5-947bbf9f34bf",
                                        "entry_id": "4088fb6b-025f-3afb-a891-27d0f73065d8",
                                        "glosses": [
                                            "A person who teaches at a kindergarten."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6cb6578c-f73f-4f18-8266-2dbee4a58a79",
                                                "sense_id": "a43d5be0-7c68-3b19-afc5-947bbf9f34bf",
                                                "text": "But the heart is generally larger than the creed, as was once strikingly evidenced to me by Louisa Frankenberg, a dear, devout old German kindergartner, who had learned the art of kindergartning [...]"
                                            },
                                            {
                                                "example_id": "58e55518-e92f-4461-b872-7c0e2524c35d",
                                                "sense_id": "a43d5be0-7c68-3b19-afc5-947bbf9f34bf",
                                                "text": "[Jean-Jacques] Rousseau rightly insists that man’s education begins at his birth, and that what is acquired unconsciously far exceeds, in amount and importance, what is acquired consciously and through instruction.¹ […] ¹ This is a truth to which kindergærtners ought to give serious heed."
                                            },
                                            {
                                                "example_id": "86886290-7a47-48ff-8f5e-58b1eb80113b",
                                                "sense_id": "a43d5be0-7c68-3b19-afc5-947bbf9f34bf",
                                                "text": "I am a kindergartner, teaching in the Harrington School, New Bedford, Mass., and am a reader of the “Kindergarten Primary Magazine.”"
                                            },
                                            {
                                                "example_id": "948d7aa5-a130-4026-a46f-0788edb7f45c",
                                                "sense_id": "a43d5be0-7c68-3b19-afc5-947bbf9f34bf",
                                                "text": "The book that laid the groundwork for this new ideology was written by a German kindergartner who had emigrated to America in the late 1860s."
                                            },
                                            {
                                                "example_id": "a5d1004c-cb4f-4d3e-829e-fb62cfb676b9",
                                                "sense_id": "a43d5be0-7c68-3b19-afc5-947bbf9f34bf",
                                                "text": "She went to New York City in 1872 to train under German kindergartner Maria Kraus-Boelte[.]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
