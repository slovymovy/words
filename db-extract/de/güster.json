                                    {
                                        "sense_id": "4a85799d-0070-3552-85f8-3d1c57c9280a",
                                        "entry_id": "088b937b-a715-36ff-bfb0-1323b2a0e89e",
                                        "glosses": [
                                            "Espèce de poisson osseux d'eau douce d'Europe, de la famille des carpes, à la forme caractéristique d'un plateau plat argenté et dont la couleur est souvent plus brillante que la brème commune."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d6de90a-8cf3-4657-9d50-d59c30bfc81c",
                                                "sense_id": "4a85799d-0070-3552-85f8-3d1c57c9280a",
                                                "text": "Gardons, rotengles, carpes, brèmes bordelières et grenouilles figurent en bonne place au menu du silure glane qui lui-même n’est pas dédaigné, à l’occasion, par le brochet, l’aspe ou le sandre."
                                            },
                                            {
                                                "example_id": "f4241990-15cf-4244-aada-123099dc4abf",
                                                "sense_id": "4a85799d-0070-3552-85f8-3d1c57c9280a",
                                                "text": "Poisson grégaire, la brème bordelière vit en groupes dans les étangs et les rivières particulièrement lentes."
                                            },
                                            {
                                                "example_id": "f280db02-5048-481c-8057-1d3ad5182280",
                                                "sense_id": "4a85799d-0070-3552-85f8-3d1c57c9280a",
                                                "text": "Les parties très calmes de la zone à brème ainsi que les eaux stagnantes des lacs de plaine et des étangs constituent l’habitat ordinaire de la brème bordelière."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
