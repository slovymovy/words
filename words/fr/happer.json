{
    "word_family": [
        "happement",
        "happe"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5ec3ecea-3554-32a7-a75b-de9f6a45ca38",
                    "sense_definition": "Heurter, faucher ou aspirer violemment au passage, en parlant d'un véhicule ou d'une machine en mouvement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "choc",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le piéton distrait a failli être <w>happé</w> par un train à proximité du passage à niveau."
                        },
                        {
                            "text": "Un ouvrier de l'usine a été <w>happé</w> par les engrenages d'une presse défectueuse."
                        }
                    ],
                    "synonyms": [
                        "faucher",
                        "percuter",
                        "renverser"
                    ],
                    "common_phrases": [
                        "être happé par un train",
                        "être happé par une voiture"
                    ]
                },
                {
                    "sense_id": "8b520857-5693-3e09-be58-3c6c8d644988",
                    "sense_definition": "Captiver ou absorber entièrement l'attention, l'esprit ou l'imagination de quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dès les premières pages, le lecteur se retrouve complètement <w>happé</w> par l'atmosphère mystérieuse de cette histoire."
                        },
                        {
                            "text": "Les adolescents restent souvent des heures d'affilée <w>happés</w> par leurs écrans sans voir le temps passer."
                        }
                    ],
                    "synonyms": [
                        "absorber",
                        "captiver",
                        "fasciner"
                    ],
                    "common_phrases": [
                        "être happé par l'histoire",
                        "être happé par l'intrigue"
                    ]
                },
                {
                    "sense_id": "b563f028-832d-307c-b48e-8f298417fc2f",
                    "sense_definition": "Saisir vivement et avidement avec la gueule ou le bec au vol ou au passage.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "saisie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chien bondit aussitôt pour <w>happer</w> la friandise que son maître venait de lui lancer."
                        },
                        {
                            "text": "La grenouille déploie brusquement sa langue gluante afin de <w>happer</w> les mouches en plein vol."
                        }
                    ],
                    "synonyms": [
                        "gober",
                        "attraper"
                    ],
                    "common_phrases": [
                        "happer au vol"
                    ]
                },
                {
                    "sense_id": "74a98577-b1a3-3682-9a3b-6bf79c1c2e89",
                    "sense_definition": "Attraper, retenir ou surprendre brusquement au passage.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "saisie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Alors que je traversais le couloir, mon collègue m'a <w>happé</w> pour me demander un renseignement urgent."
                        },
                        {
                            "text": "Le vigile a vivement <w>happé</w> le voleur par le bras avant qu'il ne franchisse la sortie."
                        }
                    ],
                    "synonyms": [
                        "agripper",
                        "attraper",
                        "saisir"
                    ],
                    "common_phrases": [
                        "happer au passage"
                    ]
                }
            ]
        }
    ]
}