            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2864aced-4a45-35e6-b9e6-8ec82fa643f5",
                    "sense_definition": "Maladie infectieuse et contagieuse provoquée par le virus influenza, se manifestant par de la fièvre, des courbatures et une grande fatigue.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "maladie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Paul est resté au lit toute la semaine car il a attrapé une mauvaise <w>grippe</w>."
                        },
                        {
                            "text": "Le médecin recommande aux personnes âgées de faire le vaccin contre la <w>grippe</w> avant l'hiver."
                        }
                    ],
                    "synonyms": [
                        "influenza"
                    ],
                    "common_phrases": [
                        "attraper la grippe",
                        "grippe saisonnière",
                        "vaccin contre la grippe",
                        "virus de la grippe"
                    ]
                },
                {
                    "sense_id": "5e997f88-4ced-39c6-8301-6a0e0ed102b5",
                    "sense_definition": "Par extension, infection virale respiratoire présentant des symptômes similaires à ceux de l'influenza.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "maladie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce n'est sans doute qu'une petite <w>grippe</w>, mais repose-toi quand même quelques jours."
                        },
                        {
                            "text": "Avec le retour du froid, la moitié de la classe est absente à cause d'une sorte de <w>grippe</w>."
                        }
                    ],
                    "synonyms": [
