                    }
                ],
                "translations": [
                    {
                        "translation_id": "dc9e5abf-1e08-46e2-b59a-19e78499cac1",
                        "source_entry_id": "a6adb6eb-d7ed-33df-a8fb-3455bc08eb5a",
                        "source_sense_id": "63ca36d9-2328-3a26-b179-8dc308d87465",
                        "source_sense_description": "Militär: Transporteinheit, Transport",
                        "target_lang_word": "Transporteinheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "e3337847-6f94-4fca-8b1c-659051ac7156",
                        "source_entry_id": "a6adb6eb-d7ed-33df-a8fb-3455bc08eb5a",
                        "source_sense_id": "63ca36d9-2328-3a26-b179-8dc308d87465",
                        "source_sense_description": "Militär: Transporteinheit, Transport",
                        "target_lang_word": "Transport",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Transport",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "177d3ac2-a4b4-36b6-8853-08eac8118105",
                                        "entry_id": "67705e1c-2ee4-38d7-96ff-aa755e16ad12",
                                        "glosses": [
                                            "Beförderung, Transportieren von Gütern, Personen, Tieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d938a02e-d69f-4b17-8844-514666e06c48",
                                                "sense_id": "177d3ac2-a4b4-36b6-8853-08eac8118105",
                                                "text": "Der Transport kam trotz Verkehrsstaus noch rechtzeitig an."
                                            },
                                            {
                                                "example_id": "72199f25-004b-464d-9cba-f54a5b285f43",
                                                "sense_id": "177d3ac2-a4b4-36b6-8853-08eac8118105",
                                                "text": "„Dann kam der Transport nach Moabit, und während dieses Transportes wenigstens hatte ich zu rauchen, soviel ich wollte.“"
                                            },
                                            {
                                                "example_id": "8f82aa85-c298-4eff-959c-bdfdf2daa2ed",
                                                "sense_id": "177d3ac2-a4b4-36b6-8853-08eac8118105",
                                                "text": "„Zwar gibt es nicht nur die Transporte zur Ausreise; sondern dann und wann verkehren auch schon wieder richtige Personenzüge.“"
                                            },
                                            {
                                                "example_id": "0b121003-42ed-4204-91b8-2efb181348b5",
                                                "sense_id": "177d3ac2-a4b4-36b6-8853-08eac8118105",
                                                "text": "„Der erste Transport ging südwärts, aber alle weiteren führten ihn nach Westen.“"
                                            },
                                            {
                                                "example_id": "54118205-d331-4460-b3a2-de7d0455f756",
                                                "sense_id": "177d3ac2-a4b4-36b6-8853-08eac8118105",
                                                "text": "„In der Nacht, die er zum erstenmal im Archiv verbracht hatte, war der Patron seines Gasthofs von Stadtwächtern abgeholt und, wie es hieß, mit einem Transport in die abseits liegenden nordwestlichen Randgebiete auf den Weg gebracht worden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bf5581a4-bb2d-3fac-a048-8ce049ac79a5",
                                        "entry_id": "67705e1c-2ee4-38d7-96ff-aa755e16ad12",
                                        "glosses": [
                                            "Menge von (gleichen) Gütern, Gruppe von Personen, Tieren, die zur gemeinsamen Beförderung zusammengestellt worden ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "277762c4-f31e-4be8-be5a-c7dc838a37d5",
                                                "sense_id": "bf5581a4-bb2d-3fac-a048-8ce049ac79a5",
                                                "text": "„Unbestreitbar ist: Nach der Stromerzeugung ist der Bereich Transport mit 20 Prozent die zweitgrößte Quelle von Treibhausgasen weltweit“ […]."
                                            },
