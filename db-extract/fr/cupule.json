        "fr-extract.jsonl": [
            {
                "entry_id": "7631a923-e254-3dcd-b0da-0814e1cf0157",
                "word": "cupule",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3c6bd260-82e3-487c-87c7-cd42d9dc0f5e",
                        "entry_id": "7631a923-e254-3dcd-b0da-0814e1cf0157",
                        "tags": [
                            "plural"
                        ],
                        "form": "cupules"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "92817e69-b514-32ec-9932-2ccca030d32f",
                        "entry_id": "7631a923-e254-3dcd-b0da-0814e1cf0157",
                        "glosses": [
                            "Godet qui enveloppe la base de certains fruits comme le gland chez les chênes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aff3d924-5bb8-46ee-a843-8bad796d52d6",
                                "sense_id": "92817e69-b514-32ec-9932-2ccca030d32f",
                                "text": "Le gland du chêne offre le type du fruit en cupule."
                            },
                            {
                                "example_id": "fed1a360-cd17-4202-b2a7-036c2e886e75",
                                "sense_id": "92817e69-b514-32ec-9932-2ccca030d32f",
                                "text": "Les Cupulifères sont caractérisées par une collerette de bractées persistantes, ou cupule, entourant le fruit. Il y en a cinq genres: le Chêne, le Hêtre, le Châtaignier, le Charme, le Coudrier noisetier."
                            },
                            {
                                "example_id": "b8e2b8bb-d1d4-4d6f-934d-0e47c0396585",
                                "sense_id": "92817e69-b514-32ec-9932-2ccca030d32f",
                                "text": "Marthe descendit l’escalier de pierres branlantes, plongea ses mains dans l’eau, pénétrée jusqu’au cœur par le contact du flot. Des cupules de glands y couraient, comme une flottille minuscule."
                            },
                            {
                                "example_id": "fcc9d353-fbeb-409b-a94c-7f230c3ec1e3",
                                "sense_id": "92817e69-b514-32ec-9932-2ccca030d32f",
                                "text": "[…] une cupule. Cet organe, qui peut être considéré comme une simple prolongement du pédicelle floral, forme à la fructification une coupe écailleuse à la base du gland, se développe en une enveloppe épaisse et déhiscente entourant les faînes… ou en une bogue épineuse, encore appelée pelon ou hérisson, abritant les châtaignes."
                            },
                            {
                                "example_id": "df860b82-9003-48e6-a9f7-1b33989b038a",
                                "sense_id": "92817e69-b514-32ec-9932-2ccca030d32f",
                                "text": "Des botanistes curieux ont tenté de discerner les prémices de ces plantes de demain. Ils ont vu le gland du chêne s’entourer d’une cupule, la châtaigne et le faîne du hêtre s’y enfermer complètement. Mais l’encerclement du fruit par ces cupules plus ou moins développées n’intervient qu’après la pollinisation."
                            }
                        ]
                    },
                    {
                        "sense_id": "bd0e5d3c-7353-3ffc-88ea-7892780d6c2e",
                        "entry_id": "7631a923-e254-3dcd-b0da-0814e1cf0157",
                        "glosses": [
                            "Sorte de petite coupe plus ou moins stipitée renfermant les organes de la reproduction chez certains lichens fruticuleux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f9ae5a7-df4b-4c2c-a139-375911f5efb9",
                                "sense_id": "bd0e5d3c-7353-3ffc-88ea-7892780d6c2e",
                                "text": "Les apothécies des lichens du genre Cladonia sont souvent placées sur le bord de cupules caractéristiques."
                            },
                            {
                                "example_id": "1cdc21e1-4277-4f8f-8660-6574e99ae0f2",
                                "sense_id": "bd0e5d3c-7353-3ffc-88ea-7892780d6c2e",
                                "text": "L’hypothecium forme comme une cupule qui contient le thecium."
                            }
                        ]
                    },
                    {
                        "sense_id": "03ccef80-fec0-3276-ae39-45ca731bad81",
                        "entry_id": "7631a923-e254-3dcd-b0da-0814e1cf0157",
                        "glosses": [
                            "Creux microscopique observé sur la surface de rupture d’un matériau ductile soumis à une déformation plastique, qui résulte de la croissance et de la jonction de microcavités."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "93467b3e-4069-3d84-9d75-df2426a9d534",
                        "entry_id": "7631a923-e254-3dcd-b0da-0814e1cf0157",
                        "glosses": [
                            "Creux circulaire d’origine anthropique à la surface d'une dalle ou d'un rocher."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d5694f9-75de-43f4-b681-026310701faa",
                                "sense_id": "93467b3e-4069-3d84-9d75-df2426a9d534",
                                "text": "Les symboles les plus mystérieux sont ces nombreuses petites cupules, des creux circulaires de 1 à 10 mm de diamètre dont est percée la dalle, qui pourraient représenter des tumulus, des habitations ou bien des gisements géologiques."
                            }
                        ]
                    }
