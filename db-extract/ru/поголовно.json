                                        "examples": [
                                            {
                                                "example_id": "56b10357-f847-48e6-8169-c5b6ad6dacb7",
                                                "sense_id": "a658a781-14a2-3989-a1e4-aee5879de6a2",
                                                "text": "J’ai vu tous ses films, sans exception."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1bdda3b9-10d5-4a9d-a5d0-25784fd7c7e3",
                        "source_entry_id": "a3078ebc-4b7d-3de2-93cf-84efd4833e5a",
                        "source_sense_description": "охватывая всех, каждого; распространяясь на всех",
                        "target_lang_word": "totalement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "totalement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "59ad20d2-978a-3ffd-beb7-241d54a55895",
                                        "entry_id": "47273283-4eb2-3e22-bb0c-0681f0e0de5b",
                                        "glosses": [
                                            "Entièrement ; tout à fait."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b8d5d8c-bed4-4f44-af73-c79e60e1010d",
                                                "sense_id": "59ad20d2-978a-3ffd-beb7-241d54a55895",
                                                "text": "Ma conduite dissipa totalement les inquiétudes de son père,"
                                            },
                                            {
                                                "example_id": "636c5a06-17ff-4c53-9b20-ac88d997c6f7",
                                                "sense_id": "59ad20d2-978a-3ffd-beb7-241d54a55895",
                                                "text": "Totalement crédible en Marylin Monroe, elle pourrait même décrocher un Oscar pour sa performance dans cette adaptation du best-seller de Joyce Caroll Oates."
                                            },
                                            {
                                                "example_id": "75949ef1-52f3-49b8-8b6e-b927346aac7c",
                                                "sense_id": "59ad20d2-978a-3ffd-beb7-241d54a55895",
                                                "text": "Tenez vos engagements. Cela découragera totalement vos adversaires."
                                            },
                                            {
                                                "example_id": "14871123-364a-45f6-9da2-b288af10788b",
                                                "sense_id": "59ad20d2-978a-3ffd-beb7-241d54a55895",
                                                "text": "Pour que le téléspectateur ne soit pas totalement abruti par des talk-shows et leurs têtes à clashs ou des téléréalités avec des personnages ignares et exubérants."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "03b075d3-1ba3-46b3-b8f9-31866d1abb7f",
                        "source_entry_id": "a3078ebc-4b7d-3de2-93cf-84efd4833e5a",
