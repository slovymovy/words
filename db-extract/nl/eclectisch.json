                "translations": [
                    {
                        "translation_id": "817f1fb7-5a14-44b9-904b-90a15c716675",
                        "source_entry_id": "989c18ee-f7eb-39d8-adc6-80fbf14ea778",
                        "source_sense_id": "9a8040fc-cd18-3c2b-836e-d2d63c477011",
                        "target_lang_word": "eklektisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eklektisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e0a5bebe-283a-3501-957d-a157f767c594",
                                        "entry_id": "e7597b38-19bf-31ba-80c2-f6505a1eea37",
                                        "glosses": [
                                            "aus etwas Vorhandenem zusammengestellt, gesammelt; auf den Eklektizismus bezogen"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "650c3605-fdbc-4063-8e25-3de902421a82",
                                                "sense_id": "e0a5bebe-283a-3501-957d-a157f767c594",
                                                "text": "„[…] - die fünfte, welche hierin eine starke, aber einer Wirts-Tochter gar nicht nachteilige Sprödigkeit findet, ist von der vorigen im Grunde wenig verschieden; -, und die sechste, die ich selber bin, denkt eklektisch, und verknüpft alle fünf Sekten mit ihrer eignen und läßt in dem wogenden Weiberherzen alle diese fünf Gefühle miteinander und widereinander segeln und reagieren.“"
                                            },
                                            {
                                                "example_id": "6ac1d6db-1b8a-404c-b122-f71120eb55d7",
                                                "sense_id": "e0a5bebe-283a-3501-957d-a157f767c594",
                                                "text": "„Sie beschreibt seine Sammlung als die größte und eklektischste in Deutschland und weist darauf hin, wie beeindruckt Ludwig von den großen deutschen Mäzenen vom Rang Josef Haubrichs war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2f32ae3c-6396-3a62-8db6-52cf33700e11",
                                        "entry_id": "e7597b38-19bf-31ba-80c2-f6505a1eea37",
                                        "glosses": [
                                            "imitierend, nachahmend, unschöpferisch"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5eca5cd6-3370-4e19-abba-f47a6cfda549",
                                                "sense_id": "2f32ae3c-6396-3a62-8db6-52cf33700e11",
                                                "text": "„Die rechte Selbständigkeit ging ihm ab; seine Natur war ebenso eklektisch als encyklopädistisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "38bbf8c8-ecb4-49ab-88ff-e5f9edddfb31",
                        "source_entry_id": "989c18ee-f7eb-39d8-adc6-80fbf14ea778",
                        "source_sense_id": "9a8040fc-cd18-3c2b-836e-d2d63c477011",
                        "target_lang_word": "eclectic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eclectic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d2cccdcb-1a44-3752-ba26-641c2eec370b",
                                        "entry_id": "1312cda4-7d59-3706-a64a-5e2e14715272",
                                        "glosses": [
                                            "Selecting a mixture of what appears to be best of various doctrines, methods or styles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd0b6e55-d179-4d63-8375-15e9352cd8d0",
                                                "sense_id": "d2cccdcb-1a44-3752-ba26-641c2eec370b",
                                                "text": "Chunder Sen and the Progressive Brahmists broke entirely with Hinduism...and he selected from the scriptures of all creeds what seemed best in them for instruction and for worship. […] It is an eclectic religion: it seeks to select what is good from all religions, and it has become the latest evidence that no eclectic religion can ever influence large numbers of men."
                                            },
                                            {
                                                "example_id": "065c993d-c193-4fc2-9d6a-cc3d12fa070d",
                                                "sense_id": "d2cccdcb-1a44-3752-ba26-641c2eec370b",
                                                "text": "Though rooted in jazz, Byron's music is stylistically eclectic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7512c420-f9a1-3402-89cd-69861129fed0",
                                        "entry_id": "1312cda4-7d59-3706-a64a-5e2e14715272",
                                        "glosses": [
                                            "Unrelated and unspecialized; heterogeneous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b473f8bc-a3c2-441a-8aa4-fa4cf4e7d197",
                                                "sense_id": "7512c420-f9a1-3402-89cd-69861129fed0",
                                                "text": "All members of the Hominoidea, apes and man, show an eclectic taste in food but select, from a wide range of possibilities, only a few to provide the bulk of their diet."
                                            },
                                            {
                                                "example_id": "1c487f6d-92c1-4a33-817e-a25086a353e1",
                                                "sense_id": "7512c420-f9a1-3402-89cd-69861129fed0",
                                                "text": "Colvin said Obama has an eclectic taste in music, listening to everything from Indonesian flute music to OutKast to Motown."
                                            },
                                            {
                                                "example_id": "f07df02b-a161-45d0-9909-8711e87e07e0",
                                                "sense_id": "7512c420-f9a1-3402-89cd-69861129fed0",
                                                "text": "The Austrians concentrated their entire armored formation into the 1st Division; the 2nd Division consisted solely of the wooden ship of the line Kaiser, looking incredibly out of place in a battle of ironclads, along with five frigates; and the 3rd Division had an eclectic collection of smaller gunboats and armed merchantmen."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "eclectic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "838209af-06a4-3a05-adeb-e8916e415654",
                                        "entry_id": "60e57a52-c0dd-3f57-b151-66fe6d918021",
                                        "glosses": [
                                            "Someone who selects according to the eclectic method."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17275101-59fe-4aed-ad30-adbb19e0e185",
                                                "sense_id": "838209af-06a4-3a05-adeb-e8916e415654",
                                                "text": "Neo-Pagans are eclectics, often borrowing from a variety of cultural traditions as they try to shape their religious organizations and practices to meet group and individual needs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3ea6d8d1-0a73-4922-b593-df064bdd2ce4",
                        "source_entry_id": "989c18ee-f7eb-39d8-adc6-80fbf14ea778",
                        "source_sense_id": "9a8040fc-cd18-3c2b-836e-d2d63c477011",
                        "target_lang_word": "éclectique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "éclectique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "617b33f4-ce09-3e41-a55d-a4b80b4bc565",
                                        "entry_id": "144d4f2c-7da8-3f7b-bd74-b010900db021",
                                        "glosses": [
                                            "Qui n’adopte pas une doctrine particulière mais choisit, dans les divers systèmes, les opinions qui lui paraissent les plus justes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1cafcae-63f7-49a9-a441-ad1d510f7fc2",
                                                "sense_id": "617b33f4-ce09-3e41-a55d-a4b80b4bc565",
                                                "text": "Un philosophe éclectique."
                                            },
                                            {
                                                "example_id": "82b2fbf1-cd08-4ef4-82fd-f14586f9908d",
                                                "sense_id": "617b33f4-ce09-3e41-a55d-a4b80b4bc565",
                                                "text": "La philosophie éclectique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ad50e9e-8d3c-376a-a2ab-211190daf564",
                                        "entry_id": "144d4f2c-7da8-3f7b-bd74-b010900db021",
                                        "glosses": [
                                            "Qui est d’une disposition d’esprit non systématique, accueillante et qui adopte ce qui lui parait bon dans un ensemble d’idées, d’opinions."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b0ccb75-d247-4ba9-b890-6cc5ad2e3915",
                                                "sense_id": "1ad50e9e-8d3c-376a-a2ab-211190daf564",
                                                "text": "Éclectique en littérature, en peinture."
                                            },
                                            {
                                                "example_id": "2b1245ad-d309-42c1-9f46-10f0d7b65903",
                                                "sense_id": "1ad50e9e-8d3c-376a-a2ab-211190daf564",
                                                "text": "Toby-Chien, devant nous, chasse, éclectique et inoffensif, le lapin, la mésange, la taupe et le grillon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca2f9cf6-e486-3bd0-a966-ebe1bdd370ce",
                                        "entry_id": "144d4f2c-7da8-3f7b-bd74-b010900db021",
                                        "glosses": [
                                            "Qui est fait d'éléments très divers."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01d44006-ddbf-4328-b830-5f204a4e15f8",
                                                "sense_id": "ca2f9cf6-e486-3bd0-a966-ebe1bdd370ce",
                                                "text": "Paris est le seul lieu du monde où il existe de ces maisons éclectiques où tous les goûts, tous les vices, toutes les opinions sont reçus avec une mise décente"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "éclectique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eeaf5e96-5a26-3013-9d77-a46cf5a654c4",
                                        "entry_id": "c62cf9ef-f291-3316-a5df-de3b1792d115",
                                        "glosses": [
                                            "Personne qui n’adopte pas une doctrine particulière mais choisit, dans les divers systèmes, les opinions qui lui paraissent les plus justes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36f898af-6322-4c4b-88e2-c58970014110",
                                                "sense_id": "eeaf5e96-5a26-3013-9d77-a46cf5a654c4",
                                                "text": "L’éclectique est un philosophe qui foulant aux piés le préjugé, la tradition, l’ancienneté, le consentement universel, l’autorité (...)"
                                            },
                                            {
                                                "example_id": "0e776b11-0f65-4dfc-8f1f-8f9276cd0b57",
                                                "sense_id": "eeaf5e96-5a26-3013-9d77-a46cf5a654c4",
                                                "text": "Or, vous avez entrepris cette tâche : donc vous êtes vous-même un éclectique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
