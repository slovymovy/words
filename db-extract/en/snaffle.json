        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "1b4522dd-930a-39a6-ad8e-6e5a4adc9389",
                "word": "snaffle",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "6a8d9694-e464-4406-b417-9fcb293626ca",
                        "entry_id": "1b4522dd-930a-39a6-ad8e-6e5a4adc9389",
                        "tags": [
                            "plural"
                        ],
                        "form": "snaffles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5b2eae14-77e9-338e-b552-7335c4eac4c6",
                        "entry_id": "1b4522dd-930a-39a6-ad8e-6e5a4adc9389",
                        "glosses": [
                            "A broad-mouthed, loose-ringed bit (metal in a horse's mouth). It brings pressure to bear on the tongue and the corners of the mouth, and is often used as a training bit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c84f64d-6be9-4fff-bc50-c586bbfb0c80",
                                "sense_id": "5b2eae14-77e9-338e-b552-7335c4eac4c6",
                                "text": "Captain went out in the cab all the morning. Harry came in after school to feed me and give me water. In the afternoon I was put into the cab. Jerry took as much pains to see if the collar and bridle fitted comfortably, as if he had been John Manly over again. When the crupper was let out a hole or two, it all fitted well. There was no bearing rein—no curb—nothing but a plain ring snaffle. What a blessing that was!"
                            },
                            {
                                "example_id": "dc7cde7b-45dc-47ca-974d-b83cc86eefa3",
                                "sense_id": "5b2eae14-77e9-338e-b552-7335c4eac4c6",
                                "text": "“I shall have to take the mare to-morrow,” said the Tertium Quid, “and she will stand nothing heavier than a snaffle.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "3ecf7014-25e8-3b25-a0ba-1e963ad0426d",
                        "entry_id": "1b4522dd-930a-39a6-ad8e-6e5a4adc9389",
                        "glosses": [
                            "Decorative wear that looks like a snaffle."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "6deb2c48-9fe8-44b8-b55d-ff8b91e04163",
                                "sense_id": "3ecf7014-25e8-3b25-a0ba-1e963ad0426d",
                                "text": "Sunning himself on the board steps, I saw for the first time Mr. Farquhar Fenelon Cooke.[…]A silver snaffle on a heavy leather watch guard which connected the pockets of his corduroy waistcoat, together with a huge gold stirrup in his Ascot tie, sufficiently proclaimed his tastes."
                            }
                        ]
                    }
                ],
