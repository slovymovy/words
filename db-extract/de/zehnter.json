                            {
                                "example_id": "f79ab9b9-3222-43a3-9e14-28920d493b31",
                                "sense_id": "1b36db2a-b434-3f91-bfe0-8a7370df73e5",
                                "text": "Der Zehnte musste mehrere Strafrunden laufen."
                            },
                            {
                                "example_id": "1fb3ab78-165b-4b30-980a-8ab201e99aa2",
                                "sense_id": "1b36db2a-b434-3f91-bfe0-8a7370df73e5",
                                "text": "Der Teilnehmer aus Russlands Mannschaft wurde Zehnter."
                            },
                            {
                                "example_id": "852a189d-a611-4322-aa98-6b9d8186eddb",
                                "sense_id": "1b36db2a-b434-3f91-bfe0-8a7370df73e5",
                                "text": "Als er einmal Zehnter im Turmspringen wurde, hat ihn das sehr gefreut."
                            }
                        ],
