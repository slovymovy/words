        "fr-extract.jsonl": [
            {
                "entry_id": "e1fa8c51-fb5c-334a-aa7e-273cede2695a",
                "word": "bouffissure",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "12c30d40-f818-4536-a389-a4cd92ca487a",
                        "entry_id": "e1fa8c51-fb5c-334a-aa7e-273cede2695a",
                        "tags": [
                            "plural"
                        ],
                        "form": "bouffissures"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7a6ded84-5a83-335d-8b01-59fc36a1f1ea",
                        "entry_id": "e1fa8c51-fb5c-334a-aa7e-273cede2695a",
                        "glosses": [
                            "État des chairs qui sont bouffies."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c10117c0-a3b4-4c6a-a786-429aa5908867",
                                "sense_id": "7a6ded84-5a83-335d-8b01-59fc36a1f1ea",
                                "text": "Elle se plongea la tête dans l’eau, mais le remède ne fut point efficace : les traces de larmes disparurent ; la bouffissure du visage, la rougeur des paupières, ne s’effacèrent point."
                            },
                            {
                                "example_id": "76ad4fb0-aa04-467c-908e-c1fdd033021f",
                                "sense_id": "7a6ded84-5a83-335d-8b01-59fc36a1f1ea",
                                "text": "Malgré, ou plutôt à cause de cet état de bouffissure, l’acheteur, le plus souvent, est séduit par le poil lustré, onctueux et cette ardeur factice qui fait cabrioler, se cabrer, ou croupionner les chevaux, comme s’ils étaient doués d’une vigueur hors ligne […]."
                            },
                            {
                                "example_id": "2949cff3-e2a6-4ad8-87fc-6d87f209b625",
                                "sense_id": "7a6ded84-5a83-335d-8b01-59fc36a1f1ea",
                                "text": "Celui-ci fut brillant, autrefois ; il garde encore, malgré l’embonpoint qui est venu, malgré la bouffissure des chairs, une allure élégante, et un parfum de bonne compagnie."
                            },
                            {
                                "example_id": "fdb1d741-93b8-446f-813a-c1d1028dbeed",
                                "sense_id": "7a6ded84-5a83-335d-8b01-59fc36a1f1ea",
                                "text": "D’une pauvre maison de pisé, une paysanne sortit. Sa vieille face portait les peines d’une vie de travail, les fatigues d’une existence difficile et les bouffissures de chagrins récents."
                            }
                        ]
                    },
                    {
                        "sense_id": "13042cfc-5067-38d5-aeb3-013007a1fd19",
                        "entry_id": "e1fa8c51-fb5c-334a-aa7e-273cede2695a",
                        "glosses": [
                            "Ces chairs bouffies elles-mêmes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1011d665-2833-405e-9145-cb309e5f8a3d",
                                "sense_id": "13042cfc-5067-38d5-aeb3-013007a1fd19",
                                "text": "Il avait pu sauver ses yeux, désormais privés de paupières, semblables à deux clous de métal sombre enfoncés en deux bouffissures sanguinolentes ; mais le nez, les lèvres, les oreilles avaient disparu et les trois quarts de la face étaient noircis, calcinés, comme si un pinceau de lave brûlante y avait passé."
                            },
                            {
                                "example_id": "bfb05206-8e89-46b6-bcf5-b0b8cd458219",
                                "sense_id": "13042cfc-5067-38d5-aeb3-013007a1fd19",
                                "text": "Déjà il était souverainement beau, les bouffissures de son visage semblaient mystérieusement annulées …."
                            }
                        ]
                    },
                    {
                        "sense_id": "c7a4cd64-7be5-3a21-9640-8a256e31d7b7",
                        "entry_id": "e1fa8c51-fb5c-334a-aa7e-273cede2695a",
                        "glosses": [
                            "Emploi de termes ampoulés ou d’expressions exagérées."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "8d743e8a-1628-4ff4-b404-92653a3abff6",
                                "sense_id": "c7a4cd64-7be5-3a21-9640-8a256e31d7b7",
                                "text": "Bouffissure du style."
                            }
                        ]
                    }
