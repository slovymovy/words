                "senses": [
                    {
                        "sense_id": "6a1afea0-ebbc-3ca9-99c8-ae12279af072",
                        "entry_id": "b38a4fcd-429d-355b-bd9e-0f25e256ea91",
                        "glosses": [
                            "Type de saucisses originaires de la Pologne."
                        ],
                        "tags": [
                            "Charcuterie"
                        ],
                        "examples": [
                            {
                                "example_id": "ac29150b-0ae8-49b9-887c-248b57d6ad43",
                                "sense_id": "6a1afea0-ebbc-3ca9-99c8-ae12279af072",
                                "text": "Les étaks vendaient du ragoût de chou, de la choucroute et d’épaisses tranches de porcs dans de grandes marmites fumantes ; des saucisses kiełbasa étaient suspendues à des cordes au-dessus d’oignons et d’ail en train de frire, et il y avait des marmites de pierogi, certines boulettes étant farcies de viande et de pomme de terre, d’autres, de fruits et nappées de crème."
                            },
                            {
                                "example_id": "3a3ad9a4-f085-4e6a-9526-6f57ad991704",
                                "sense_id": "6a1afea0-ebbc-3ca9-99c8-ae12279af072",
                                "text": "Elle fait sa propre publicité au Pirogi Palace de Pete le Polonais. Pete la paye en cash et kiełbasa."
                            },
                            {
                                "example_id": "6064f149-3a1d-40bf-82a0-6306b2c7cbe7",
                                "sense_id": "6a1afea0-ebbc-3ca9-99c8-ae12279af072",
                                "text": "Ça te fait une belle jambe, mon gars, glapit Marcin en se découpant une part de kiełbasa, le saucisson de rigueur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2d581cc8-96c5-4f96-8cef-adca9059554c",
                        "source_entry_id": "b38a4fcd-429d-355b-bd9e-0f25e256ea91",
                        "source_sense_id": "6a1afea0-ebbc-3ca9-99c8-ae12279af072",
                        "target_lang_word": "kiełbasa",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kiełbasa",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2ea5dd7d-b6c3-31b6-aaa2-b642b568275c",
                                        "entry_id": "86cab037-6c21-35c5-bd2b-e600ee084bfa",
                                        "glosses": [
                                            "Alternative form of kielbasa."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5addb3c-8437-4582-9109-95ea1658d0e9",
                                                "sense_id": "2ea5dd7d-b6c3-31b6-aaa2-b642b568275c",
                                                "text": "Polish music, the Polish language, a display of photographs from the President’s trip to Poland and, of course, an array of Polish foods such as: kiełbasa, pierogi,[…]"
                                            },
                                            {
                                                "example_id": "95aa3de3-4d71-4351-a8be-aeda464a9421",
                                                "sense_id": "2ea5dd7d-b6c3-31b6-aaa2-b642b568275c",
                                                "text": "Bring the sauce to a boil and into it place the kiełbasa, cut into pieces diagonally. The kiełbasa may also be served in a spicily seasoned onion or tomato sauce."
                                            },
                                            {
                                                "example_id": "988b170b-b6b6-4f6e-8657-926c7ef58b9b",
                                                "sense_id": "2ea5dd7d-b6c3-31b6-aaa2-b642b568275c",
                                                "text": "The food is good and inexpensive, and includes daily specials like kiełbasa, pierogi, and gołąbki."
                                            },
                                            {
                                                "example_id": "40df4161-636f-437d-86e7-9bb5b2a99b33",
                                                "sense_id": "2ea5dd7d-b6c3-31b6-aaa2-b642b568275c",
                                                "text": "What would be a typical Polish meal? Around these parts Polish people say it is gołąbki, pierogi and kiełbasa."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e25fd045-cb23-4f11-914f-a0508b62dec4",
                        "source_entry_id": "b38a4fcd-429d-355b-bd9e-0f25e256ea91",
