                "translations": [
                    {
                        "translation_id": "677cc01e-d868-424b-8530-1a69caac3ea1",
                        "source_entry_id": "e6f4f695-0dd6-3ec7-bd00-d85294865cce",
                        "source_sense_id": "e220c318-30a0-3326-b79c-56f684606458",
                        "source_sense_description": "Uhr, von der man sich zu einer eingestellten Zeit wecken lassen kann",
                        "target_lang_word": "réveil-matin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "réveil-matin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bf88311e-9d46-3ffe-88fe-c3f1783f3131",
                                        "entry_id": "c0203cb6-0690-3b5d-86b3-2b5cef199ec3",
                                        "glosses": [
                                            "Petite pendule, munie d’un mécanisme qui actionne une sonnerie bruyante et prolongée, à l’heure que l’on a marquée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9998f117-8556-4d91-a04a-a83447f788d9",
                                                "sense_id": "bf88311e-9d46-3ffe-88fe-c3f1783f3131",
                                                "text": "Cette personne a besoin de deux choses: la première , d'un réveil-matin pour se lever à l'heure, & la seconde d'un fuzil pour avoir de la lumière ; […]"
                                            },
                                            {
                                                "example_id": "77a1aab2-b9c8-4b70-a9b7-6ab9a5a93545",
                                                "sense_id": "bf88311e-9d46-3ffe-88fe-c3f1783f3131",
                                                "text": "Inventaire de mes effets que Marchand doit garder pour remettre à mon fils […] nᵒ 2 Mon réveil-matin. C’est le réveil-matin de Frédéric II que j’ai pris à Potsdam (dans la boite nᵒ III)."
                                            },
                                            {
                                                "example_id": "4d74799a-8f3e-4fb2-afc1-2ee391dc08f5",
                                                "sense_id": "bf88311e-9d46-3ffe-88fe-c3f1783f3131",
                                                "text": "LAMPE RÉVEIL-MATIN […] Un réveil-matin ordinaire est surmonté d'une lampe à pétrole portant un petit brûleur qui reste allumé toute la nuit et qui sert de veilleuse […]."
                                            },
                                            {
                                                "example_id": "21c7d08e-7a40-49f2-9d5c-83488bf60d0d",
                                                "sense_id": "bf88311e-9d46-3ffe-88fe-c3f1783f3131",
                                                "text": "Mon réveil matin est réglé à l'heure où je dois me lever. Chaque matin, mon réveil matin sonne. Ensuite je me lève."
                                            },
                                            {
                                                "example_id": "c1861ae6-dba9-4739-8d36-d18a21fe0a0f",
                                                "sense_id": "bf88311e-9d46-3ffe-88fe-c3f1783f3131",
                                                "text": "Comme il n'utilisait pas la fonction réveil-matin de son réveil-matin il se réveillait le plus souvent parce qu'il n'avait plus sommeil, ou plus exactement parce qu'il avait assez dormi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d05578a3-4fa1-37fa-a2f1-e1795e8e81b7",
                                        "entry_id": "c0203cb6-0690-3b5d-86b3-2b5cef199ec3",
                                        "glosses": [
                                            "Bruit que fait le matin de bonne heure un coq, un voisin bruyant, etc."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d5a86ba-ee1e-40a5-ad6e-330181ecc2b3",
                                                "sense_id": "d05578a3-4fa1-37fa-a2f1-e1795e8e81b7",
                                                "text": "Cette entrée fracassante et guillerette de Jamel au petit matin est un fantastique réveil matin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48aa8f7f-6765-362a-a42f-815f36e07da6",
                                        "entry_id": "c0203cb6-0690-3b5d-86b3-2b5cef199ec3",
                                        "glosses": [
                                            "Bonne ou mauvaise nouvelle qu’on apprend en s’éveillant."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90ccbd84-575e-4c94-a265-3fe7b8afd6b6",
                                                "sense_id": "48aa8f7f-6765-362a-a42f-815f36e07da6",
                                                "text": "Des créanciers à notre porte\nNous font lever avec chagrin :\nMais de l’argent qu’on nous apporte ;\nOh! c’est un bon réveil-matin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26d79bec-6b98-3921-a809-416ce03e5d51",
                                        "entry_id": "c0203cb6-0690-3b5d-86b3-2b5cef199ec3",
                                        "glosses": [
                                            "Nom populaire de l’euphorbe réveil-matin."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa8256e2-9df0-4a19-9cfe-62786588ab23",
                                                "sense_id": "26d79bec-6b98-3921-a809-416ce03e5d51",
                                                "text": "C'est ainsi que dans le genre Euphorbe existent des plantes aussi différentes d'aspect que notre modeste Réveil-matin (E. helioscopia) herbacé et les Euphorbes en cierges des demis déserts africains."
                                            },
                                            {
                                                "example_id": "f8c829f2-eb97-4ca9-b268-2c88676c2b99",
                                                "sense_id": "26d79bec-6b98-3921-a809-416ce03e5d51",
                                                "text": "Euphorbe réveil-matin. — Nom vulgaire : Réveil-matin. — Nom latin : Euphorbia helioscopia"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93e0b9f8-b2fa-387b-a2f2-d31f75120e39",
                                        "entry_id": "c0203cb6-0690-3b5d-86b3-2b5cef199ec3",
                                        "glosses": [
                                            "Nom que donna Georges-Louis Leclerc de Buffon à une sorte de caille de Java."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "797d2d7b-7ba4-40dc-aadf-761159cd17bd",
                                                "sense_id": "93e0b9f8-b2fa-387b-a2f2-d31f75120e39",
                                                "text": "La caille de Bontius, que Buffon nomme réveil-matin est une espèce trop succinctement indiquée, pour la placer comme réellement distincte dans un système ; je l’exclus de la liste méthodique, en attendant que des découvertes nouvelles fassent mieux connoître cet oiseau."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
