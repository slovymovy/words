                "senses": [
                    {
                        "sense_id": "ab199618-01ed-36aa-8422-ea007edb1e86",
                        "entry_id": "c7d9b04d-2c35-3d2b-a131-547c85c825db",
                        "glosses": [
                            "das Sichausbreiten von Geruch; Emission von Geruchsstoffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5ed7bbd-6e71-4f20-8192-9bb143f89c76",
                                "sense_id": "ab199618-01ed-36aa-8422-ea007edb1e86",
                                "text": "„Dies als Verstoß gegen die Menschenrechte, wozu sicher heute auch die freie Geruchsentfaltung gehört, zu empfinden, sahen sie nicht so pingelig.“"
                            },
                            {
                                "example_id": "885b62f3-2c70-409c-9540-3816c86f35b8",
                                "sense_id": "ab199618-01ed-36aa-8422-ea007edb1e86",
                                "text": "„Und tote Fische dienen hier unter anderem als Modelle – mit entsprechender Geruchsentfaltung im Atelier.“"
                            },
                            {
                                "example_id": "8b95a70a-3fb4-4e75-9c22-fa67a7545947",
                                "sense_id": "ab199618-01ed-36aa-8422-ea007edb1e86",
                                "text": "„In der räumlich beengten 2 ½ Zimmer Wohnung (50 qm) lebt noch ein großer Hund (Mischling), dessen leere Hundefutterdosen in der Küche neben weiterem Haushaltsmüll zu einer intensiven Geruchsentfaltung beiträgt.“"
                            },
                            {
                                "example_id": "536992ee-c54e-40c4-8ed3-64b6ee078a29",
                                "sense_id": "ab199618-01ed-36aa-8422-ea007edb1e86",
                                "text": "„Über eine mögliche Geruchsentfaltung ist nichts bekannt, wohl aber über den ethischen Wohlfühlfaktor der Plastikkollektion.“"
                            },
                            {
                                "example_id": "0269deeb-1abe-4846-ba66-43c552e67490",
                                "sense_id": "ab199618-01ed-36aa-8422-ea007edb1e86",
                                "text": "„Die Indooranlagen waren mit verschiedenen Filtern ausgerüstet und verfügten über geschlossene Lüftungssysteme, sodass eine Geruchsentfaltung nach außen nicht gegeben war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
