                ],
                "senses": [
                    {
                        "sense_id": "06954960-81ee-3582-8a94-e9ce1433f6ce",
                        "entry_id": "fda85c55-f983-3c49-adf8-f608a791a59f",
                        "glosses": [
                            "Gesamtheit der Bedingungen und Umstände, Wirklichkeit des Spielens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6ebe6f5-e3bd-4f1f-8b91-2caf8adde236",
                                "sense_id": "06954960-81ee-3582-8a94-e9ce1433f6ce",
                                "text": "„Der phantasierende Mensch oder das spielende Kind befindet sich zwar in einer Spielrealität und in einer inneren Phantasie; der außenstehende Beobachter jedoch, der die Botschaft und die Gefahr des verhinderten Wunsches erkennt, […] ist doppelt betroffen.“"
                            },
                            {
                                "example_id": "20a4e0b3-677b-484d-b3ad-b09abad3b368",
                                "sense_id": "06954960-81ee-3582-8a94-e9ce1433f6ce",
                                "text": "„Erst der zeitliche Abstand lässt die Grenzen zwischen Alltags- und Spielrealität wieder deutlich hervortreten.“"
                            },
                            {
                                "example_id": "d3a68a63-ffef-4b8a-9a85-19525d1bf0bb",
                                "sense_id": "06954960-81ee-3582-8a94-e9ce1433f6ce",
                                "text": "„Kriegsspielgegner und Kriegsspielbefürworter sollten sich nicht gegenseitig anfeinden, sondern eine gegenseitige Toleranz aufbauen und Kindern und Jugendlichen zutrauen, dass sie Alltagsrealität und Spielrealität zu unterscheiden vermögen.“"
                            },
                            {
                                "example_id": "b370902e-4d8b-48aa-b0b2-d2f8b558597d",
                                "sense_id": "06954960-81ee-3582-8a94-e9ce1433f6ce",
                                "text": "„Je bewußter und leidenschaftlicher gespielt wird, ohne daß die Spielrealität transzendiert würde, um so wirksamer löst sich der heutige Mensch aus dem Zustand der Selbstentfremdung.“"
                            },
                            {
                                "example_id": "7e4dafde-1f51-44bb-b42f-a5e5b1fd3708",
                                "sense_id": "06954960-81ee-3582-8a94-e9ce1433f6ce",
                                "text": "„Die Spielrealität wird wegen dieser dem sekundären Lernprozeß eigentümlichen Abschirmung gegenüber Spontanität und Kreativität bei der Umsetzung in Handlung in der Umgebung kognitiver Vermittlungsformen als Fremdkörper oder zumindest als Ausnahme empfunden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
