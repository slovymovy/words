                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0c2004ac-34ac-3928-b695-7f9a3f7a9709",
                                        "entry_id": "b005b19d-9c53-32cf-b033-0ee0dbea7936",
                                        "glosses": [
                                            "A gutter under the eaves of a building; an eaves trough."
                                        ],
                                        "tags": [
                                            "Canada"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2df6934f-b1f1-44de-acfd-98e9c6a9cf11",
                                                "sense_id": "0c2004ac-34ac-3928-b695-7f9a3f7a9709",
                                                "text": "The troughs were filled with leaves and needed clearing."
                                            }
                                        ]
                                    },
