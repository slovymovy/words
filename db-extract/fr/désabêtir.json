                ],
                "senses": [
                    {
                        "sense_id": "e8172908-6bcf-3272-a404-799536534f35",
                        "entry_id": "4ca78edd-3fd7-34ba-afbe-d01c972eff55",
                        "glosses": [
                            "Faire cesser d’être bête."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48fb42a5-830a-4f11-9c82-d36faaf46995",
                                "sense_id": "e8172908-6bcf-3272-a404-799536534f35",
                                "text": "C’est ça qui les désabêtit, qui leur donne le courage de travailler et le goût de vivre."
                            },
                            {
                                "example_id": "7b8d2124-c6e3-4d9d-9a2d-ff7bb9968a71",
                                "sense_id": "e8172908-6bcf-3272-a404-799536534f35",
                                "text": "Vaste chantier que de se désabêtir!"
                            },
                            {
                                "example_id": "b9e583d9-b95d-4a64-9d6d-d804056b0fb5",
                                "sense_id": "e8172908-6bcf-3272-a404-799536534f35",
                                "text": "Et, elle m'avait paru bof-bof, et je me disais, avec Georges qui doit lui en mettre plein ... la tête elle finira par se \"désabêtir\"."
                            },
                            {
                                "example_id": "54007071-a493-487b-a11d-a5e6291d4e23",
                                "sense_id": "e8172908-6bcf-3272-a404-799536534f35",
                                "text": "En un sens, le but de la vie est de sursoir (ou surseoir, à l’ancienne) à son abêtissement supplémentaire, voire de se désabêtir, comme on se désembourgeoise : le but de la vie est de ne pas devenir la blonde, ou le blond qu’on est déjà; le but de la vie est de déblondir un peu."
                            }
                        ]
                    }
                ],
