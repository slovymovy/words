{
    "word_family": [
        "smile",
        "smiley",
        "unsmiling"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a76ae51d-96bd-3d79-96d4-2808391c2d36",
                    "sense_definition": "Present participle and gerund of <w>smile</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is <w>smiling</w> at the camera for the photo.",
                            "target_lang_translations": {
                                "ru": "Она <w>улыбается</w> в камеру для фотографии.",
                                "zh": "她正对着镜头<w>微笑</w>拍照。"
                            }
                        },
                        {
                            "text": "Why are you <w>smiling</w> so much today?",
                            "target_lang_translations": {
                                "ru": "Почему ты так много <w>улыбаешься</w> сегодня?",
                                "zh": "你今天为什么一直<w>微笑</w>？"
                            }
                        }
                    ],
                    "common_phrases": [
                        "start smiling",
                        "stop smiling"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола <w>smile</w>.",
                        "zh": "动词 smile 的现在分词和动名词形式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "улыбающийся",
                                "target_lang_sense_clarification": "причастие"
                            },
                            {
                                "target_lang_word": "улыбаясь",
                                "target_lang_sense_clarification": "деепричастие"
                            },
                            {
                                "target_lang_word": "улыбаться",
                                "target_lang_sense_clarification": "глагол (в составе длительных времен)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "微笑",
                                "target_lang_sense_clarification": "动词，表示面带笑容"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a562342b-1c54-3da7-a1a5-ed942d4725ec",
                    "sense_definition": "That smiles or has a smile.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>smiling</w> baby looked happily at her mother.",
                            "target_lang_translations": {
                                "ru": "<w>Улыбающийся</w> ребенок радостно смотрел на маму.",
                                "zh": "那个<w>微笑的</w>婴儿开心地看着她的妈妈。"
                            }
                        },
                        {
                            "text": "He greeted everyone with a warm, <w>smiling</w> face.",
                            "target_lang_translations": {
                                "ru": "Он приветствовал всех с теплым, <w>улыбающимся</w> лицом.",
                                "zh": "他带着温暖、<w>微笑的</w>面容向大家问好。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cheerful",
                        "beaming",
                        "happy",
                        "grinning"
                    ],
                    "antonyms": [
                        "unsmiling"
                    ],
                    "common_phrases": [
                        "smiling face",
                        "keep smiling"
                    ],
                    "target_lang_definitions": {
                        "ru": "Улыбающийся или с улыбкой на лице.",
                        "zh": "指正在微笑的，或者具有微笑特征的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "улыбающийся",
                                "target_lang_sense_clarification": "описывает текущее состояние"
                            },
                            {
                                "target_lang_word": "улыбчивый",
                                "target_lang_sense_clarification": "описывает черту характера"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "微笑的",
                                "target_lang_sense_clarification": "形容词，描述当前状态"
                            },
                            {
                                "target_lang_word": "爱笑的",
                                "target_lang_sense_clarification": "形容词，描述性格特征"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a24168f7-e94c-398c-b565-50dbd844a5bf",
                    "sense_definition": "The action of the verb to <w>smile</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Smiling</w> uses fewer muscles than frowning does.",
                            "target_lang_translations": {
                                "ru": "<w>Улыбка</w> задействует меньше мышц, чем хмурый взгляд.",
                                "zh": "<w>微笑</w>比皱眉动用的肌肉更少。"
                            }
                        },
                        {
                            "text": "Her constant <w>smiling</w> made the guests feel very welcome.",
                            "target_lang_translations": {
                                "ru": "Её постоянная <w>улыбка</w> заставляла гостей чувствовать себя очень желанными.",
                                "zh": "她始终保持<w>微笑</w>，让客人们感到非常受欢迎。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по глаголу <w>smile</w>.",
                        "zh": "动词 smile 的动作过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "улыбка",
                                "target_lang_sense_clarification": "существительное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "微笑",
                                "target_lang_sense_clarification": "名词，指微笑的动作或表情"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}