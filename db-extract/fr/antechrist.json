                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d82f9953-d7f9-4984-ac61-dcee88e10cf4",
                                                "sense_id": "3a962101-7e8b-3a6e-9887-4cd0e9294b06",
                                                "text": "Namawiał, pomagając sobie różnymi groźbami, aby parafianie nie sprzedawali ziemi pod budowę dworca i drogi żelaznej. Hr. Władysława Zamoyskiego, dra Andrzeja Chramca, inżynierów i majstrów zatrudnionych przy budowie wyzywał od antychrystów itp."
                                            }
                                        ],
