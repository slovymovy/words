        "nl-extract.jsonl": [
            {
                "entry_id": "fd4748b9-617b-3c47-9ab6-c013ea7eb754",
                "word": "luiheid",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e1e6c44c-8da3-319f-bc69-8c998789bdbf",
                        "entry_id": "fd4748b9-617b-3c47-9ab6-c013ea7eb754",
                        "glosses": [
                            "het ontbreken van de wil iets te doen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15f10941-d47f-4ae8-a560-b7d08dafa402",
                                "sense_id": "e1e6c44c-8da3-319f-bc69-8c998789bdbf",
                                "text": "Als hij niks doet aan zijn luiheid wordt het nooit wat met hem."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fe1341be-2f83-4e71-b11f-5e4c32d4e013",
                        "source_entry_id": "fd4748b9-617b-3c47-9ab6-c013ea7eb754",
                        "source_sense_id": "e1e6c44c-8da3-319f-bc69-8c998789bdbf",
                        "source_sense_description": "het ontbreken van de wil iets te doen",
                        "target_lang_word": "Faulheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Faulheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dfb62bab-d8e2-37b7-acfd-91f5cd4865df",
                                        "entry_id": "b94f6cbb-cf2b-3860-a212-f3d6868c3c2b",
                                        "glosses": [
                                            "innere Grundstimmung oder Geisteshaltung, nichts Mühsames tun zu wollen"
                                        ],
                                        "tags": [
                                            "meist Singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52300926-8742-426b-a969-c7a126bcd3a1",
                                                "sense_id": "dfb62bab-d8e2-37b7-acfd-91f5cd4865df",
                                                "text": "Als ich aufhörte, meine Faulheit zurückzudrängen, fiel es mir auf einmal ganz leicht zu arbeiten."
                                            },
                                            {
                                                "example_id": "acca109f-e90f-451f-9d53-94514c4fc379",
                                                "sense_id": "dfb62bab-d8e2-37b7-acfd-91f5cd4865df",
                                                "text": "Freundlichkeit, Reizbarkeit, Ehrgeiz oder Faulheit – zwar beeinflussen auch spätere Erfahrungen, was uns ausmacht – jedoch meist nur noch innerhalb der Marksteine, die genetischer, vorgeburtlicher und frühkindlicher Einfluss gelegt haben."
                                            },
                                            {
                                                "example_id": "1d39317e-1b59-42d2-9266-dd97c7d923b0",
                                                "sense_id": "dfb62bab-d8e2-37b7-acfd-91f5cd4865df",
                                                "text": "Der Hang zur Ruhe ohne vorhergehende Arbeit in jenem Zustande ist Faulheit."
                                            },
                                            {
                                                "example_id": "6229b5d6-a663-49da-a8e2-890cae2688d1",
                                                "sense_id": "dfb62bab-d8e2-37b7-acfd-91f5cd4865df",
                                                "text": "Und die großen Gelehrten und Erfinder, ich sage es noch einmal, nirgends anders sind ihre Werke aufgekeimt, als in der Einsamkeit, in der Zelle, die der Menge oft nur als Ort der Faulheit erscheint."
                                            },
                                            {
                                                "example_id": "be74d659-53c8-40b0-bb4c-b6a726f3b554",
                                                "sense_id": "dfb62bab-d8e2-37b7-acfd-91f5cd4865df",
                                                "text": "Ferner war der alte Cantinet dem Likör und der Faulheit hingegeben, er hatte um dieser beiden Laster willen seinen Handel aufgeben müssen."
                                            },
                                            {
                                                "example_id": "46dc5f9f-9050-4841-90ec-1f676f47a987",
                                                "sense_id": "dfb62bab-d8e2-37b7-acfd-91f5cd4865df",
                                                "text": "„Wer arbeiten kann, aber nicht will, der kann nicht mit Solidarität rechnen. Es gibt kein Recht auf Faulheit in unserer Gesellschaft!“"
                                            },
                                            {
                                                "example_id": "fd734ba7-04b2-4072-8b96-34c25ff0fa35",
                                                "sense_id": "dfb62bab-d8e2-37b7-acfd-91f5cd4865df",
                                                "text": "„Nichtsdestoweniger leistet sie allerhand, die Natur, und wir erleben dauernd die Effekte ihrer Betriebsamkeit, die sich physikalisch genommen als eine Summe von unendlich vielen Faulheiten darstellt.“"
                                            },
                                            {
                                                "example_id": "5947ccf0-62a4-4702-9dd1-6d0e6e17734c",
                                                "sense_id": "dfb62bab-d8e2-37b7-acfd-91f5cd4865df",
                                                "text": "„Siehe deine Gewohnheiten an, aus denen sie besteht: sind sie das Erzeugnis zahlloser kleiner Feigheiten und Faulheiten oder das deiner Tapferkeit und erfinderischen Vernunft?“"
                                            },
                                            {
                                                "example_id": "9eaad371-7eeb-4643-9adb-fd0455ba742a",
                                                "sense_id": "dfb62bab-d8e2-37b7-acfd-91f5cd4865df",
                                                "text": "„In einem Interview mit «Le Monde» hat Roland Barthes Ende der siebziger Jahre einmal über seine Faulheiten Auskunft gegeben.“"
                                            },
                                            {
                                                "example_id": "e99036a1-0b68-4aea-9a7b-b85932a43978",
                                                "sense_id": "dfb62bab-d8e2-37b7-acfd-91f5cd4865df",
                                                "text": "„Ethische Grundsätze allein genügen oft nicht, um Gewohnheiten, Faulheiten, Raffgier und Machtbesessenheit in die Schranken zu weisen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "503631ba-1c4e-4a2a-927b-ca27106a4c10",
                        "source_entry_id": "fd4748b9-617b-3c47-9ab6-c013ea7eb754",
                        "source_sense_id": "e1e6c44c-8da3-319f-bc69-8c998789bdbf",
                        "source_sense_description": "het ontbreken van de wil iets te doen",
                        "target_lang_word": "laziness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "laziness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "646cca4b-01d9-3068-bc8b-0c5b113af3ce",
                                        "entry_id": "d8a711cb-a415-33fb-b9b8-3500499bdc6f",
                                        "glosses": [
                                            "The quality of being lazy"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c190b1cf-7a97-420e-8f22-f645f0d44b49",
                                                "sense_id": "646cca4b-01d9-3068-bc8b-0c5b113af3ce",
                                                "text": "“It is thine own laziness, thou false English blood, that doest nothing but drink and sleep,” retorted the page, “and leaves that lither lad to do the work, that he minds as little as thou.”"
                                            },
                                            {
                                                "example_id": "bb1611d7-7c5b-463e-8b7a-339733d3140b",
                                                "sense_id": "646cca4b-01d9-3068-bc8b-0c5b113af3ce",
                                                "text": "Generalizing harshly and broadly but implying “you know which ones I mean” is an intellectual and rhetorical laziness that is not allowed to pass anywhere else in these communities."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "254db333-e48c-4103-aef7-da505d0942f8",
                        "source_entry_id": "fd4748b9-617b-3c47-9ab6-c013ea7eb754",
                        "source_sense_id": "e1e6c44c-8da3-319f-bc69-8c998789bdbf",
                        "source_sense_description": "het ontbreken van de wil iets te doen",
                        "target_lang_word": "paresse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paresse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d8cf2cd6-89d4-3d29-a898-398bcd2201b7",
                                        "entry_id": "9c4da971-7472-3e48-966f-0cfd624c3b44",
                                        "glosses": [
                                            "Tendance à éviter toute activité, à refuser tout effort consenti par les autres lambdas, disposition habituelle à ne pas travailler, nonchalance, négligence des choses qui sont de devoir, d’obligation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19464030-81a6-4657-b5fe-634d27188851",
                                                "sense_id": "d8cf2cd6-89d4-3d29-a898-398bcd2201b7",
                                                "text": "On souhaite la paresse d'un méchant et le silence d'un sot."
                                            },
                                            {
                                                "example_id": "175928e6-aeb2-46e9-a84f-05877a7c9b2b",
                                                "sense_id": "d8cf2cd6-89d4-3d29-a898-398bcd2201b7",
                                                "text": "Une peste de psychologue, que mes parents m'avaient emmené voir sur le conseil d'une prof complètement tarée, avait parlé de « nonchaloir oriental » pour expliquer ces accès de paresse."
                                            },
                                            {
                                                "example_id": "3efd42d8-be4b-4e2f-bc89-cabe9e81dee8",
                                                "sense_id": "d8cf2cd6-89d4-3d29-a898-398bcd2201b7",
                                                "text": "Le pauvre n'est plus tout à fait l'image du Christ sur terre mais un profiteur sans vergogne et paresseux, dont la paresse est fortement combattue ; une ordonnance de 1351 de Jean II condamne les vagabonds qui refusent de poursuivre une activité salariée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a216ccc-b29c-3984-aa87-7b9ca59510f8",
                                        "entry_id": "9c4da971-7472-3e48-966f-0cfd624c3b44",
                                        "glosses": [
                                            "Tendance à éviter toute activité, à refuser tout effort consenti par les autres lambdas, disposition habituelle à ne pas travailler, nonchalance, négligence des choses qui sont de devoir, d’obligation.",
                                            "Se dit d’une faiblesse de tempérament qui porte à se dispenser de faire tout ce qui demande un peu d’effort."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7cb5cdb2-c04b-476f-9041-63b64fb43130",
                                                "sense_id": "2a216ccc-b29c-3984-aa87-7b9ca59510f8",
                                                "text": "C’est par paresse qu’il ne va jamais se promener."
                                            },
                                            {
                                                "example_id": "2fd56428-93f1-400f-be51-d664f8ed1467",
                                                "sense_id": "2a216ccc-b29c-3984-aa87-7b9ca59510f8",
                                                "text": "Le théâtre est à ma porte ; si je n’y vais pas, c’est la paresse qui m’en empêche."
                                            },
                                            {
                                                "example_id": "cfebb691-bb70-43e1-afb5-61619cd15a57",
                                                "sense_id": "2a216ccc-b29c-3984-aa87-7b9ca59510f8",
                                                "text": "Paresse d’esprit, certaine lenteur, certaine nonchalance d’esprit, qui empêche de concevoir promptement ou de s’appliquer avec force, avec persévérance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9fc90b78-3ccf-3c49-bbf0-de475cefb0c0",
                                        "entry_id": "9c4da971-7472-3e48-966f-0cfd624c3b44",
                                        "glosses": [
                                            "Tendance à éviter toute activité, à refuser tout effort consenti par les autres lambdas, disposition habituelle à ne pas travailler, nonchalance, négligence des choses qui sont de devoir, d’obligation.",
                                            "Amour du repos, du loisir, tranquillité du corps et de l’esprit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "932efa42-4a7a-4095-b2e2-777a87977f0d",
                                                "sense_id": "9fc90b78-3ccf-3c49-bbf0-de475cefb0c0",
                                                "text": "Paresse aimable."
                                            },
                                            {
                                                "example_id": "6b5e64ff-c8d9-4722-aff5-8f1869bdfb09",
                                                "sense_id": "9fc90b78-3ccf-3c49-bbf0-de475cefb0c0",
                                                "text": "Une douce paresse."
                                            },
                                            {
                                                "example_id": "cb3af58c-3c03-41e0-98c9-2e3547651170",
                                                "sense_id": "9fc90b78-3ccf-3c49-bbf0-de475cefb0c0",
                                                "text": "Ce poète a chanté la paresse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "296f80fe-06f1-3bb8-a87c-e447168fb12a",
                                        "entry_id": "9c4da971-7472-3e48-966f-0cfd624c3b44",
                                        "glosses": [
                                            "Fonctionnement ralenti d’un organe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc0c02ab-4777-43e3-ac1c-0770648a51ad",
                                                "sense_id": "296f80fe-06f1-3bb8-a87c-e447168fb12a",
                                                "text": "Rien de grave, disait son médecin, le docteur D. : des troubles du foie, de la paresse intestinale ; il prescrivait quelques drogues, de la confiture de tamarine contre la constipation."
                                            }
                                        ]
                                    }
                                ]
                            },
