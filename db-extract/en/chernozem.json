                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1489b5a-cf88-4431-9aaf-d05ecdf0b919",
                                                "sense_id": "475c97c3-56a3-34c9-b8fc-cd2e318f7c3d",
                                                "text": "Murchison suppose que le tchernozème a été formé par le limon des mers déposé par les courants du Nord."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
