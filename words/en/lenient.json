    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "836043da-4461-3f70-8217-ac56b1a1cb54",
                    "sense_definition": "Not strict; tolerant of dissent or deviation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tolerant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher was <w>lenient</w> with the students who forgot their homework.",
                            "target_lang_translations": {
                                "ru": "Учитель был <w>снисходителен</w> к ученикам, забывшим домашнее задание."
                            }
                        },
                        {
                            "text": "The judge gave a <w>lenient</w> sentence because it was the defendant's first offense.",
                            "target_lang_translations": {
                                "ru": "Судья вынес <w>мягкий</w> приговор, поскольку это было первое правонарушение подсудимого."
                            }
                        }
                    ],
                    "synonyms": [
                        "lax",
                        "permissive",
                        "forgiving"
                    ],
                    "antonyms": [
                        "strict",
                        "severe",
                        "stringent"
                    ],
                    "common_phrases": [
                        "lenient judge",
                        "lenient policy",
                        "lenient sentence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нестрогий, проявляющий терпимость к проступкам или мягкость в наказании."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "снисходительный",
                                "target_lang_sense_clarification": "прощающий ошибки, нестрогий"
                            },
                            {
                                "target_lang_word": "мягкий",
                                "target_lang_sense_clarification": "нежестокий, умеренный в требованиях или наказании"
                            },
                            {
                                "target_lang_word": "терпимый",
                                "target_lang_sense_clarification": "толерантный к отклонениям или слабостям"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3bffc23e-241e-3609-9137-58d0cb6de6a5",
                    "sense_definition": "A substance that softens or soothes the skin.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pharmacist recommended a <w>lenient</w> to help soothe the irritated skin.",
                            "target_lang_translations": {
                                "ru": "Фармацевт порекомендовал <w>смягчающее средство</w>, чтобы успокоить раздражённую кожу."
                            }
                        },
                        {
                            "text": "Apply the <w>lenient</w> gently to the affected area twice a day.",
                            "target_lang_translations": {
                                "ru": "Аккуратно наносите <w>смягчающее средство</w> на поражённый участок дважды в день."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This term is rarely used in modern medical contexts."
                        }
                    ],
                    "target_lang_definitions": {
