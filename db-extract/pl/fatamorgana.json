                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03dcab9e-b64c-4505-8fcf-719daa5f05a0",
                                                "sense_id": "add9916f-ba1e-31be-b521-f8c58c001995",
                                                "text": "On the other side of the electric fence, the fata morgana shimmers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8d60d02f-494f-464e-a660-ef07c637ff75",
                        "source_entry_id": "f94a1cc5-1258-3be4-9501-29ad4ea88140",
                        "source_sense_id": "ddbcc98a-b82f-3260-ae59-fba463df6d1a",
                        "target_lang_word": "fata morgána",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fata morgána",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "38b3e2c1-78c5-3f90-b16f-1a7727f5f9c9",
                                        "entry_id": "85568ff0-38d6-3efd-9ab3-7d94e516a67f",
                                        "glosses": [
                                            "optický jev v atmosféře — obrazy velmi vzdálených objektů či krajiny, vyvolané zrcadlením na vrstvách vzduchu s velkým rozdílem teplot"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "802a8e9b-c786-45e2-ab1f-f193a6862f0a",
                        "source_entry_id": "f94a1cc5-1258-3be4-9501-29ad4ea88140",
                        "source_sense_id": "ddbcc98a-b82f-3260-ae59-fba463df6d1a",
                        "target_lang_word": "Fata Morgana",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fata Morgana",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ae2e22df-c556-3ff7-8a2b-2b65815ee320",
                                        "entry_id": "ab472875-de14-32db-852d-768f059f7054",
                                        "glosses": [
                                            "Luftspiegelung entfernter Objekte verursacht durch Reflexionen an Luftschichten unterschiedlicher Temperatur in Bodennähe"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b7a80a6-61fe-470a-b70d-303a0c002be0",
                                                "sense_id": "ae2e22df-c556-3ff7-8a2b-2b65815ee320",
                                                "text": "Dieses Alföld, welches Petöfi ein offenes Buch nennt, ist eine tolle Gegend. Bei Tage zeigt es mit seiner Fata Morgana das Land als Wasser, des Nachts das Wasser als Land. (Wann soll der Mensch ihm glauben?)"
                                            },
                                            {
                                                "example_id": "9246ffb6-4f57-4400-aaf5-6920d54a341f",
                                                "sense_id": "ae2e22df-c556-3ff7-8a2b-2b65815ee320",
                                                "text": "Und hinter diesem Gartenringe erglänzt die Stadt, von den Arabern ›Schamm‹ genannt, wie eine Wahrheit gewordene Fata Morgana des sich nach Labung und Erquickung sehnenden Wüstenpilgers."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7a07f84d-85fc-3d00-bdfb-e9377bb87876",
                                        "entry_id": "ab472875-de14-32db-852d-768f059f7054",
                                        "glosses": [
                                            "eine falsche Vorstellung"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5ccfecd-e844-441c-8758-2b0260bbd514",
                                                "sense_id": "7a07f84d-85fc-3d00-bdfb-e9377bb87876",
                                                "text": "Er hält Desertec für eine gewaltige „Fata Morgana“ und glaubt, das Projekt sei viel zu teuer."
                                            },
                                            {
                                                "example_id": "dc4f8394-bfee-449c-8cb4-545a7b8771d0",
                                                "sense_id": "7a07f84d-85fc-3d00-bdfb-e9377bb87876",
                                                "text": "Aber im selben Augenblick überkam es sie bang und düster, und in ihrer Seele rief eine Stimme: Fata Morgana."
                                            },
                                            {
                                                "example_id": "7b917c20-c42f-42d5-a3ab-0974f7964c52",
                                                "sense_id": "7a07f84d-85fc-3d00-bdfb-e9377bb87876",
                                                "text": "Vision oder Fata Morgana? Der Text wurde im Jahr 1988 veröffentlicht, genau ein Jahr nach Krenns Bischofsweihe."
                                            },
                                            {
                                                "example_id": "2f52c078-0e77-4994-b88e-90945342f7d2",
                                                "sense_id": "7a07f84d-85fc-3d00-bdfb-e9377bb87876",
                                                "text": "„Ich schaue hinauf zum Palast, der eine Fata Morgana sein könnte, die wir nie erreichen werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "43a647df-1851-4b6b-a73c-8f0226eed02b",
                        "source_entry_id": "f94a1cc5-1258-3be4-9501-29ad4ea88140",
                        "source_sense_id": "ddbcc98a-b82f-3260-ae59-fba463df6d1a",
                        "target_lang_word": "мираж",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "мираж",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c20da3f0-90f3-3be4-bc7d-881dfa573171",
                                        "entry_id": "07e1b993-f888-3a58-a86a-8eaa8d3e147a",
                                        "glosses": [
                                            "физ. оптическое явление в атмосфере, заключающееся в появлении у горизонта изображений участков неба или предметов вследствие отражения света границей слоёв воздуха различной плотности"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e235c645-35f9-403b-9ff0-f03711f7ac38",
                                                "sense_id": "c20da3f0-90f3-3be4-bc7d-881dfa573171",
                                                "text": "Чередой проходили в памяти образы прекрасного Кашмира, качались и дрожали, будто в мираже, и пропадали, развеиваясь на стенах комнаты, затянутых светлой тканью."
                                            },
                                            {
                                                "example_id": "72eb3847-53e2-422d-aad8-510049ae0c6a",
                                                "sense_id": "c20da3f0-90f3-3be4-bc7d-881dfa573171",
                                                "text": "Мираж в пустыне."
                                            },
                                            {
                                                "example_id": "c24415f7-cb93-4344-aa9e-5625d5d24e63",
                                                "sense_id": "c20da3f0-90f3-3be4-bc7d-881dfa573171",
                                                "text": "— Днём миражи видятся вдали, а сейчас — прямо под носом, ужас берёт. … Солнечные лучи, отражаясь от этого чёрного зеркала под определённым углом, отбросили вроде проекционного фонаря на какие-то создающие мираж струи воздуха гигантский призрачный облик живого динозавра уже не в перевёрнутом виде."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b47d79a1-986a-3acc-a173-b3289633e721",
                                        "entry_id": "07e1b993-f888-3a58-a86a-8eaa8d3e147a",
                                        "glosses": [
                                            "перен. обманчивый призрак, иллюзия чего-нибудь, что-нибудь созданное воображением, не соответствующее действительности"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3458dbe0-96f7-41ba-ac8f-5ae9bb6c564c",
                                                "sense_id": "b47d79a1-986a-3acc-a173-b3289633e721",
                                                "text": "Мираж славы."
                                            },
                                            {
                                                "example_id": "44bf948c-690c-4f4e-9a8d-20994eb124c7",
                                                "sense_id": "b47d79a1-986a-3acc-a173-b3289633e721",
                                                "text": "Мираж любви."
                                            },
                                            {
                                                "example_id": "d213f2da-6e19-41b1-be4e-bf5fe7c140bc",
                                                "sense_id": "b47d79a1-986a-3acc-a173-b3289633e721",
                                                "text": "Впрочем, сказка эта (о золоте) иногда и покидала чащу тайги и приходила к людям, чтобы показать им свои неблекнущие одежды и умелой рукой разбросать перед их глазами миражи счастья."
                                            },
                                            {
                                                "example_id": "3de81477-8c4b-4731-bb39-d105337e8838",
                                                "sense_id": "b47d79a1-986a-3acc-a173-b3289633e721",
                                                "text": "Он пытался вмешаться в этот хаос, силился вызвать из прошлого какой-нибудь сладкий мираж, ощущение нежности или бодрости, он выдавливал из глубин памяти свежее смеющееся личико Гуты, ещё девчонки, желанной и неприкосновенной, и оно появлялось было, но сразу же затекало ржавчиной, искажалось и превращалось в угрюмую, заросшую грубой бурой шерстью мордочку Мартышки…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e9ce7aa0-c577-4d27-95bd-c2522c3f9b4b",
                        "source_entry_id": "f94a1cc5-1258-3be4-9501-29ad4ea88140",
