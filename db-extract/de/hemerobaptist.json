                ],
                "senses": [
                    {
                        "sense_id": "9cdf5e81-7cee-32f8-bda3-e8fc784f1fc6",
                        "entry_id": "488ba4ce-30d0-38ba-a74d-00bcfc886e9d",
                        "glosses": [
                            "jüdische Sekte, deren Mitglieder täglich kultische Waschungen vollziehen"
                        ],
                        "tags": [
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "e6d70fc2-100b-48bc-a047-d3b7e1dde674",
                                "sense_id": "9cdf5e81-7cee-32f8-bda3-e8fc784f1fc6",
                                "text": "„Höchst wahrscheinlich sind diese Hemerobaptisten die Vorfahren oder Verwandten der heutigen Johannis-Christen oder Johannis-Jünger, welche noch bis auf den heutigen Tag in nicht geringer Anzahl in der Gegend von Basra und Suster in Persien leben, und deren Religionsschriften hauptsächlich durch Norberg […] bekannt geworden sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8abf6eea-ad1f-334a-861a-612aa8d2b47b",
                        "entry_id": "488ba4ce-30d0-38ba-a74d-00bcfc886e9d",
                        "glosses": [
                            "ein Mitglied der jüdischen Sekte der Hemerobaptisten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b541efc-c1bf-4f6e-b63d-e9291e263aee",
                                "sense_id": "8abf6eea-ad1f-334a-861a-612aa8d2b47b",
                                "text": "„Schon daß sein Schüler Iosephus den Täufer erwähnte, während er Iesum überging, läßt vermuthen, daß dieser Hemerobaptist in irgend welcher Beziehung zu der Taufbewegung stand.“"
                            },
                            {
                                "example_id": "f996d6da-159d-4d3d-8f0d-e0085ef97ecc",
                                "sense_id": "8abf6eea-ad1f-334a-861a-612aa8d2b47b",
                                "text": "„Beachtung verdient in diesem Zusammenhang, daß Johannes der Täufer in den pseudoclementinischen Homilieen II 23 ein Hemerobaptist (ἡμεροβαπτιστἠς) genannt wird.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
