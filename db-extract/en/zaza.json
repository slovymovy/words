                        "entry_id": "325abcd3-970f-31ea-beb7-299f30f34935",
                        "glosses": [
                            "A parent; a gender-neutral alternative to mama or papa."
                        ],
                        "tags": [
                            "gender-neutral",
                            "informal",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "6601086e-bb22-4460-848c-db6932cf08f4",
                                "sense_id": "6f4f1203-52b4-34ef-9e50-6c2a5fdcdf9a",
                                "text": "You are your zaza's daughter."
                            },
                            {
                                "example_id": "353e4b88-ec5e-4391-b6c5-5eba48cded83",
                                "sense_id": "6f4f1203-52b4-34ef-9e50-6c2a5fdcdf9a",
                                "text": "A common gender-neutral pronoun that some folks use is Ze, and my parent name, Zaza, is based on that: Ze+Mama=Zaza. I don't go by mom or mommy, and my wife, who is also genderqueer, uses the parent name \"Mo.\" It's pretty cute; \"Mo and Zaza love you!\""
                            }
                        ]
                    }
