                        ],
                        "examples": [
                            {
                                "example_id": "b850fca3-1345-4afb-84ca-dcf124933061",
                                "sense_id": "1d28974d-2d39-3d14-93e4-479a26d489bf",
                                "text": "Je m’habillais vivement, je prenais une serviette et un roman français et j’allais me baigner dans le ruisseau, à l’ombre de la boulassière située à une demi-verste de la maison."
                            },
                            {
                                "example_id": "4009e199-9e3e-405f-afec-cd60ea2d27a2",
                                "sense_id": "1d28974d-2d39-3d14-93e4-479a26d489bf",
                                "text": "Tantôt dans les pineraies et dans les boulassières …"
                            },
                            {
                                "example_id": "a34da389-a394-492e-af2d-c9beef5128c3",
                                "sense_id": "1d28974d-2d39-3d14-93e4-479a26d489bf",
                                "text": "Un peu plus loin, il bifurqua vers une boulassière qu’elle ne reconnaissait pas, puis ils escaladèrent un talus sablonneux. Dans une trouée au milieu de la cime des arbres, elle aperçut des étoiles qui scintillaient, […]."
                            }
                        ]
                    }
