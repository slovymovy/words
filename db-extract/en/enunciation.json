                                "sense_id": "d0168175-c159-339a-9bbc-57fa6b183085",
                                "text": "She speaks with an impressively clear enunciation."
                            }
                        ]
                    },
                    {
                        "sense_id": "ced4f373-d6ff-30b8-8592-cb67883b196f",
                        "entry_id": "4fb5a457-2118-3cd8-8992-a44e3037278a",
