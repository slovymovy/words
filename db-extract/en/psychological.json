                                "target_senses": [
                                    {
                                        "sense_id": "304e036c-6446-3324-9547-202f558decd5",
                                        "entry_id": "df395f8e-1533-3a23-8630-c9152107a73e",
                                        "glosses": [
                                            "betrekking hebbend op de psychologie; betrekking hebbend op het denken en het gedrag"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "536ce090-413d-4deb-a016-c362834e31c1",
                                                "sense_id": "304e036c-6446-3324-9547-202f558decd5",
                                                "text": "Ik ga een psychologische test doen. Om erachter te komen wat ik echt wil.'"
                                            },
                                            {
                                                "example_id": "d17b63ca-ce0f-4b94-ba7b-aa3c38eb9ec3",
                                                "sense_id": "304e036c-6446-3324-9547-202f558decd5",
                                                "text": "Financieel was er geen grens tot hoever de weddenschappen konden gaan. Maar we waren erachter gekomen dat er een psychologische grens was. Die lag bij vier kronen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48faa296-b1b7-37bb-89bc-44ef2bb0c664",
                                        "entry_id": "df395f8e-1533-3a23-8630-c9152107a73e",
