                "senses": [
                    {
                        "sense_id": "ec7adc73-552a-327d-8b45-f33927aefa9f",
                        "entry_id": "cf272a63-f8f5-35a5-9031-a98478d8c892",
                        "glosses": [
                            "driehoekige gevelbekleding in de classicistische bouwstijl als bekroning van raam, deur of gevel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4950f85-4702-4f0b-b924-3db873901859",
                                "sense_id": "ec7adc73-552a-327d-8b45-f33927aefa9f",
                                "text": "Scamozzi was een puritein. Hij gruwde van de fratsen die maniëristen als Michelangelo uithaalden met de klassieke bouwkunst, zoals gebroken frontons of gedraaide zuilen. Hij beschouwde zijn architectuur als een terugkeer naar de oorspronkelijke bouwkunst van de oude Romeinen. Ongetwijfeld was Scamozzi’s soberheid een derde reden voor zijn populariteit onder architecten van de calvinistische republiek."
                            }
                        ]
                    },
                    {
                        "sense_id": "bb433f5b-eeba-3b9b-9517-61675fefc04f",
                        "entry_id": "cf272a63-f8f5-35a5-9031-a98478d8c892",
                        "glosses": [
                            "met lijsten omgeven gevelplaat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a87568f0-5643-4122-973f-b4150550ef40",
                                "sense_id": "bb433f5b-eeba-3b9b-9517-61675fefc04f",
                                "text": "Wij zoeken culinaire troost bij de poffertjestent. `Poffertjes, wafelen en ververschingen' staat op het fronton van de authentieke reizende poffertjestent geschilderd."
                            }
                        ]
                    }
