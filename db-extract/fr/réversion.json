                "senses": [
                    {
                        "sense_id": "98055818-d972-3116-95ab-213584c5eceb",
                        "entry_id": "562f1da9-0c8b-3986-b429-3fc92ae520a4",
                        "glosses": [
                            "Retour, droit de retour, en vertu duquel les biens dont une personne a disposé en faveur d’une autre lui reviennent quand celle-ci meurt sans enfants."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23314b6d-5760-4c2f-b83a-ac47d0aa685f",
                                "sense_id": "98055818-d972-3116-95ab-213584c5eceb",
                                "text": "Ce n’est pas pour cette misère que constituera ma pension de réversion quand ils me la donneront. Je serais fraîche, si je n’avais pas ma dot !"
                            },
                            {
                                "example_id": "719a610e-325c-4c47-b0ab-f571bf82a12d",
                                "sense_id": "98055818-d972-3116-95ab-213584c5eceb",
                                "text": "Il est rentré dans ce bien par droit de réversion."
                            },
                            {
                                "example_id": "73ab82f0-730d-42ac-811a-dee42612a280",
                                "sense_id": "98055818-d972-3116-95ab-213584c5eceb",
                                "text": "Ce duché revint à la couronne par droit de réversion."
                            }
                        ]
                    },
                    {
                        "sense_id": "e275d281-ea43-3b4c-bc7d-df930bd4c617",
                        "entry_id": "562f1da9-0c8b-3986-b429-3fc92ae520a4",
                        "glosses": [
                            "Retour d’individus modifiés par le croisement, au type primitif, après un certain nombre de générations."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "fed4c961-7354-353c-887c-3c952469e432",
                        "entry_id": "562f1da9-0c8b-3986-b429-3fc92ae520a4",
                        "glosses": [
                            "Synonyme de régression et de rétrogression."
                        ],
