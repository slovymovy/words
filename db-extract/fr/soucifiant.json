                "senses": [
                    {
                        "sense_id": "bafcdf4c-ca47-34f0-a650-9075b36a84d9",
                        "entry_id": "8da83ac1-4fc2-34c5-bd53-0b9c99c4ac03",
                        "glosses": [
                            "Qui cause une certaine inquiétude."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "5174d1c8-661f-4836-800b-0355d31155bf",
                                "sense_id": "bafcdf4c-ca47-34f0-a650-9075b36a84d9",
                                "text": "M’en fous, pour ma défense, j’ai juste dit que le poids de la gamine était un peu soucieux ( soucifiant quoi )."
                            },
                            {
                                "example_id": "15c521df-18d0-451e-9bf8-883161e82a9d",
                                "sense_id": "bafcdf4c-ca47-34f0-a650-9075b36a84d9",
                                "text": "— C’est bien ce qui est soucifiant.\n— Pardon ?\n— Soucifiant. Comme terrifiant. Souci et fiant. Se faire du souci.\n— Ça vous fait un souci ?\n— Oui. Et même... Un gros souci."
                            },
                            {
                                "example_id": "9dc01922-3382-4195-9b3a-47448d7bfd24",
                                "sense_id": "bafcdf4c-ca47-34f0-a650-9075b36a84d9",
                                "text": "Mais les variations de températures, c’est vrai que c’est plus soucifiant."
                            },
                            {
                                "example_id": "cd1e219b-883c-420b-8efd-ada463b54d74",
                                "sense_id": "bafcdf4c-ca47-34f0-a650-9075b36a84d9",
                                "text": "Actuellement je trouve le bac un poil soucifiant, même si papa Chlamydo \"couve\" toujours aussi bien !"
                            },
                            {
                                "example_id": "014d2280-ade5-44b8-ad67-f1834e00e70c",
                                "sense_id": "bafcdf4c-ca47-34f0-a650-9075b36a84d9",
                                "text": "C’est vraiment « soucifiant » que ce ne soit pas « reproduisable »"
                            }
                        ]
                    }
