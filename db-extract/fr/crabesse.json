                            {
                                "example_id": "8c1ac04b-8e2e-4d8c-bcaf-6f929e192737",
                                "sense_id": "fb80d289-713d-3b6e-b6aa-7374627d77ee",
                                "text": "Est-ce qu’on sait jamais ce qui mijote dans le citron des crabesses !"
                            }
                        ]
                    },
                    {
                        "sense_id": "9503b40f-a6bf-3f6d-821d-8166db832833",
                        "entry_id": "e1cc7f13-55c5-32cb-93f1-44d0a29386b6",
                        "glosses": [
                            "Crabe femelle."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "f1de89e9-a133-45ab-a12d-5820d533648a",
                                "sense_id": "9503b40f-a6bf-3f6d-821d-8166db832833",
                                "text": "D’abord, le crabe, il a un cœur. Un qui bat à toute allure quand il repère une crabesse."
                            },
                            {
                                "example_id": "7136e96a-2fcc-401c-9d11-8f47b5dfd7ec",
                                "sense_id": "9503b40f-a6bf-3f6d-821d-8166db832833",
                                "text": "Il y avait un crabe plein de vie et aux couleurs chatoyantes qui m’a fait penser à une femme : sans doute une princesse parmi les renégats, une courageuse crabesse gravement blessée — l’une de ses pattes était bousillée, un bras pendait piteusement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "57803ae7-dba3-42b8-a8db-a23617b8d483",
                        "source_entry_id": "e1cc7f13-55c5-32cb-93f1-44d0a29386b6",
                        "source_sense_id": "9503b40f-a6bf-3f6d-821d-8166db832833",
