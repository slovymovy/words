                                "target_senses": [
                                    {
                                        "sense_id": "c85443e9-0bee-3c12-ac32-3725be9c093f",
                                        "entry_id": "49fdf6b4-872a-38cd-8357-7be715783853",
                                        "glosses": [
                                            "A bright red resin, obtained from different species of a number of distinct plants Calamus rotang and genera Croton, Dracaena, Daemonorops, and Pterocarpus, used in the manufacture of varnishes, lacquers, medicines, and incenses."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1d22f00-95d4-4dde-a65f-ca6f2de2df31",
                                                "sense_id": "c85443e9-0bee-3c12-ac32-3725be9c093f",
                                                "text": "For black magic, assafœtida, garlic, dragon's blood, sulphur, and such-like vile-smelling concoctions were used."
                                            },
                                            {
                                                "example_id": "eb03d329-5123-4701-aaa4-7b203d881f42",
                                                "sense_id": "c85443e9-0bee-3c12-ac32-3725be9c093f",
                                                "text": "Another ancient vegetable relic surviving in Macaronesia is the legendary dragon tree, whose sap, marketed as dragon’s blood, was in past times much prized as a medicine, as incense and as a dye."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
