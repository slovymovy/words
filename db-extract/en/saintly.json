                        "sense_id": "aa6d69c9-de8f-344d-ac9e-5e2a1c377a41",
                        "entry_id": "acdde285-1024-3e99-ad88-3bda8a549557",
                        "glosses": [
                            "Like or characteristic of a saint; befitting a holy person; saintlike."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94b3ef59-41eb-43be-a6a7-780f2136cf2a",
                                "sense_id": "aa6d69c9-de8f-344d-ac9e-5e2a1c377a41",
                                "text": "Sophie led a saintly life."
                            },
                            {
                                "example_id": "4b4519d0-ef1d-473f-8d78-3d96acfb115d",
                                "sense_id": "aa6d69c9-de8f-344d-ac9e-5e2a1c377a41",
                                "text": "Since my sother is nothing short of saintly, she fetches me daily from work and transports me here and there."
                            },
                            {
                                "example_id": "249b0e7d-0e98-4339-8a75-65352ee0d224",
                                "sense_id": "aa6d69c9-de8f-344d-ac9e-5e2a1c377a41",
                                "text": "She met more than a quarter of all the American presidents who have ever lived, five popes, hundreds of national leaders, from the saintly, such as Nelson Mandela, to the tyrannical, including Robert Mugabe and Nicolae Ceausescu[…]"
                            }
                        ]
                    }
