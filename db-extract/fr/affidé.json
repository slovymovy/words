                ],
                "senses": [
                    {
                        "sense_id": "bf029731-00a2-3748-bb36-c3d70f06cb34",
                        "entry_id": "3388b2f8-6829-35bd-b4ac-8e3eab5cfb6d",
                        "glosses": [
                            "À qui on se fie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31c8321a-be5c-4512-a054-f16dbc8be358",
                                "sense_id": "bf029731-00a2-3748-bb36-c3d70f06cb34",
                                "text": "Fuller y voit surtout un investissement peu onéreux aux bénéfices garantis, ainsi qu’une façon détournée de reposer un pied américain dans ce territoire affidé à l’Asie qu'est l’Amérique du Sud."
                            },
                            {
                                "example_id": "640a3dce-2cfa-4e5e-a97c-cb0a57d1db2b",
                                "sense_id": "bf029731-00a2-3748-bb36-c3d70f06cb34",
                                "text": "Mais, face au pilonnement de la propagande du pouvoir et de ses médias affidés, il s’est toutefois bien gardé de s’exprimer sur d’éventuels envois d’armes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "35000847-efd6-4eeb-8c58-6b1ff4fc729f",
                        "source_entry_id": "3388b2f8-6829-35bd-b4ac-8e3eab5cfb6d",
                        "source_sense_id": "bf029731-00a2-3748-bb36-c3d70f06cb34",
