                        ],
                        "examples": [
                            {
                                "example_id": "8da0b8f0-8b95-45b1-af94-49f67eec6c02",
                                "sense_id": "3d17661c-9eca-39d5-a1ae-6b98ffcf1fae",
                                "text": "Als normales Product unseres staatlichen Unterrichts verließ ich Ostern 1832 die Schule als Pantheist, und wenn nicht als Republikaner, doch mit der Ueberzeugung, daß die Republik die vernünftigste Staatsform sei, [...]",
                                "translation": "I left school at Easter 1832, a normal product of our state system of education; a Pantheist, and, if not a Republican, at least with the persuation that the Republic was the most rational form of government; …",
                                "english": "I left school at Easter 1832, a normal product of our state system of education; a Pantheist, and, if not a Republican, at least with the persuation that the Republic was the most rational form of government; …"
                            }
                        ]
                    }
