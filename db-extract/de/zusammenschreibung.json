                ],
                "senses": [
                    {
                        "sense_id": "92e755bd-65ee-3f14-ab6e-30adfc721f0b",
                        "entry_id": "91e3d0e8-1840-3a44-9650-1f18cbbe4dce",
                        "glosses": [
                            "Schreibung eines sprachlichen Ausdrucks in einem Wort"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11599480-7ce9-4bed-aabb-89cec83265c5",
                                "sense_id": "92e755bd-65ee-3f14-ab6e-30adfc721f0b",
                                "text": "„Zur Schreibweise kann man sagen, daß sich alles findet, was möglich ist: Zusammen-, Bindestrich- und Getrenntschreibungen […]“"
                            },
                            {
                                "example_id": "c9e61bd7-d4ad-42fa-a449-770583a69420",
                                "sense_id": "92e755bd-65ee-3f14-ab6e-30adfc721f0b",
                                "text": "„Viele Fragen wirft die Getrennt-/Zusammenschreibung auf, schon weil im Englischen Getrenntschreibung von Komposita verbreitet ist.“"
                            },
                            {
                                "example_id": "3fc55a9c-1cdb-451a-8b15-451097de90cf",
                                "sense_id": "92e755bd-65ee-3f14-ab6e-30adfc721f0b",
                                "text": "Durch Zusammenschreibung zeigt man an, dass der betreffende Ausdruck ein einziges Wort ist."
                            },
                            {
                                "example_id": "d119399b-8ef0-464f-a9e2-58fca236e969",
                                "sense_id": "92e755bd-65ee-3f14-ab6e-30adfc721f0b",
                                "text": "„Die Unterscheidung von getrennt geschriebenen Wortgruppen und zusammengeschriebenen Zusammensetzungen ist nicht immer eindeutig möglich. Wo die nachstehenden Hinweise und das amtliche Regelwerk keine Klarheit schaffen, sollte sowohl Getrenntschreibung als auch Zusammenschreibung toleriert werden.“"
                            },
                            {
                                "example_id": "a8f7a87c-321f-49c8-bebc-fb17d6b4f575",
                                "sense_id": "92e755bd-65ee-3f14-ab6e-30adfc721f0b",
                                "text": "„Die Konstruktionen wurden bisher vor allem als orthographische Fälle gesehen, wobei es um die Groß- und Kleinschreibung sowie um die Zusammen- und Getrenntschreibung geht.“"
                            },
                            {
                                "example_id": "baa0f5a1-94bb-4193-a507-100f528b87b5",
                                "sense_id": "92e755bd-65ee-3f14-ab6e-30adfc721f0b",
                                "text": "„Wo die nachstehenden Hinweise und das amtliche Regelwerk keine Klarheit schaffen, sollte sowohl Getrenntschreibung als auch Zusammenschreibung toleriert werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
