                "senses": [
                    {
                        "sense_id": "d75a6478-177f-32bd-8f4f-6a1a1da17f5d",
                        "entry_id": "2f0e89b1-f148-3635-8c17-4453fec4b4f9",
                        "glosses": [
                            "высокий детский голос"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b52ed431-c23a-45ba-a13a-746de62c7b22",
                                "sense_id": "d75a6478-177f-32bd-8f4f-6a1a1da17f5d",
                                "text": "Я слушал беседу двух старцев в гостиной // Мой бас превратился в дискант: // Один был действительный статский советник, // Другой ― генерал-лейтенант."
                            },
                            {
                                "example_id": "13033e35-422d-4201-b565-8dc16893b3bc",
                                "sense_id": "d75a6478-177f-32bd-8f4f-6a1a1da17f5d",
                                "text": "Слово «что» он произнёс дискантом, «вам» ― басом, а «угодно» у него совсем не вышло."
                            }
                        ]
                    },
