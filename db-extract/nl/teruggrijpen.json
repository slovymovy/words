        "nl-extract.jsonl": [
            {
                "entry_id": "637de6eb-0a6a-3774-a543-18b0dc4da802",
                "word": "teruggrijpen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4cfabaa3-1d77-3cd2-a84d-409b8be99bdb",
                        "entry_id": "637de6eb-0a6a-3774-a543-18b0dc4da802",
                        "glosses": [
                            "weer gebruikmaken van iets ouds en vertrouwds"
                        ],
                        "tags": [
                            "noodgedwongen"
                        ],
                        "examples": [
                            {
                                "example_id": "216b28c1-86fc-4dcd-865b-e7e37302249d",
                                "sense_id": "4cfabaa3-1d77-3cd2-a84d-409b8be99bdb",
                                "text": "Het vermoeiende is dat we iedere ochtend, uit de verschaalde roes ontwakend, een nieuw leven beginnen, en dezelfde avond alweer naar het oude teruggrijpen."
                            },
                            {
                                "example_id": "d58238ba-9375-4095-859e-4de5c5a58a66",
                                "sense_id": "4cfabaa3-1d77-3cd2-a84d-409b8be99bdb",
                                "text": "\"Kerst in een tijd van melancholie waarin mensen teruggrijpen op bestaande thema's als familie, de slee en dingdong, dingdong\", zegt Baruch. \"Als je opgroeit met steeds dezelfde liedjes, dan zoek je dat goede gevoel dat daarbij hoort graag ieder jaar weer op.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c3c562f8-5f03-4954-b994-8c877cbe092f",
                        "source_entry_id": "637de6eb-0a6a-3774-a543-18b0dc4da802",
                        "source_sense_id": "4cfabaa3-1d77-3cd2-a84d-409b8be99bdb",
                        "source_sense_description": "weer gebruikmaken van iets ouds en vertrouwds",
                        "target_lang_word": "zurückgreifen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zurückgreifen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5b05f075-10f5-3517-af85-e391499b2fce",
                                        "entry_id": "0cee465c-4fa8-3da9-853d-b46da034d6ef",
                                        "glosses": [
                                            "etwas oder jemanden, der/das verfügbar ist, nutzen"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ef55268-2599-4107-8d93-83000fd18eb2",
                                                "sense_id": "5b05f075-10f5-3517-af85-e391499b2fce",
                                                "text": "„Diese Untersuchung greift auf eine vergleichsweise breite Literaturauswahl sowie auf bislang unveröffentlichtes Archivmaterial zurück.“"
                                            },
                                            {
                                                "example_id": "04d3532e-c313-450e-8cb7-42d4adac0aaf",
                                                "sense_id": "5b05f075-10f5-3517-af85-e391499b2fce",
                                                "text": "„Interessanterweise griffen viele Naturforscher und Ärzte unter dem Eindruck des Mesmerismus noch in der Mitte des 19. Jahrhunderts auf die Tradition der antiken Traumdeutung zurück.“"
                                            },
                                            {
                                                "example_id": "f0d0b46b-c945-4000-81cd-f31b2ab7d587",
                                                "sense_id": "5b05f075-10f5-3517-af85-e391499b2fce",
                                                "text": "„Ein Team der Universität Bremen griff für die Untersuchung zusammen mit anderen Forschungseinrichtungen auf Sedimentproben zurück.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ee071c8f-2ce5-32db-843e-899ae7edfb6c",
                                        "entry_id": "0cee465c-4fa8-3da9-853d-b46da034d6ef",
                                        "glosses": [
                                            "bei einer Erzählung auf etwas in der Vergangenheit eingehen"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80de368f-cc4c-42ce-a467-010191060f03",
                                                "sense_id": "ee071c8f-2ce5-32db-843e-899ae7edfb6c",
                                                "text": "Frisch porträtierte in der Figur Fabers einen zeittypischen Antifeminismus und griff zurück auf Beobachtungen aus Simone de Beauvoirs einige Jahre zuvor erschienenem Werk Das andere Geschlecht."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ff3ff313-f91d-3891-8f21-4919e6368270",
                                        "entry_id": "0cee465c-4fa8-3da9-853d-b46da034d6ef",
                                        "glosses": [
                                            "hinter sich/hinter jemanden etwas mit der Hand packen"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68727c98-3ad4-484b-90bc-652b4b612efc",
                                                "sense_id": "ff3ff313-f91d-3891-8f21-4919e6368270",
                                                "text": "Sie griff zurück nach der Klinke, aber die schwere Eichentür wollte sich nicht öffnen lassen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
