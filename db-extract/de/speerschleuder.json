                "senses": [
                    {
                        "sense_id": "aeae3a80-7f5b-34bc-aea8-e53c01472229",
                        "entry_id": "e5ad91a6-f89d-3644-9240-bd6ce8813248",
                        "glosses": [
                            "Gerät zum Abwurf von Speeren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88e34401-822b-4077-8e70-e73dd6734ec1",
                                "sense_id": "aeae3a80-7f5b-34bc-aea8-e53c01472229",
                                "text": "„Sie waren Spezialisten in der Gestaltung und Herstellung einer Waffe, die Schildblume atlatl, Speerschleuder, genannt hätte.“"
                            },
                            {
                                "example_id": "b606e244-6116-46f3-91aa-1908c44046df",
                                "sense_id": "aeae3a80-7f5b-34bc-aea8-e53c01472229",
                                "text": "„Diese frühen Einwanderer haben mit ihren Hunden und mit Speerschleudern und Speeren bewaffnet in Verfolgung von Großwild und anderen Nahrungsquellen den ganzen Kontinent durchmessen.“"
                            },
                            {
                                "example_id": "29ca4e22-2d2d-4c11-94f7-8a1225492d7c",
                                "sense_id": "aeae3a80-7f5b-34bc-aea8-e53c01472229",
                                "text": "„Noch ein weiteres Mal ließ Cortés das Requerimiento verlesen, doch die Maya antworteten mit einem Hagel aus Pfeilen, Steinen und anderen Wurfgeschossen und setzten auch ihre Speerschleudern, die Atlatls, ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
