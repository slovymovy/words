                "forms": [],
                "senses": [
                    {
                        "sense_id": "e97d71e7-2cbd-3fe8-a776-54dd761595a9",
                        "entry_id": "cf4aa0ba-287e-334f-bbb7-fca858298c33",
                        "glosses": [
                            "русская фамилия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "261501d9-22e2-45a1-ba8a-8e614d13d342",
                                "sense_id": "e97d71e7-2cbd-3fe8-a776-54dd761595a9",
                                "text": "Корнилов дать стихи отказался. — Клал я на вашего Тихонова с прибором, — заявил он."
                            },
                            {
                                "example_id": "e7ebb4db-adc8-4642-a537-dc628244116a",
                                "sense_id": "e97d71e7-2cbd-3fe8-a776-54dd761595a9",
                                "text": "Кремль впервые официально признал Катерину Тихонову и Марию Воронцову, в отношении которых накануне США ввели санкции, дочерьми Владимира Путина."
                            }
                        ]
                    }
                ],
