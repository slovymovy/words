                "senses": [
                    {
                        "sense_id": "320d0257-c830-372d-b92b-1cc2127b40e3",
                        "entry_id": "12def681-5fcf-3da4-a9e4-b1fd07cb7b03",
                        "glosses": [
                            "besondere Sprachform (Varietät) einer bestimmten Entwicklungsphase der Sprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75963d2d-d0cb-4b83-a158-6a3cd852408b",
                                "sense_id": "320d0257-c830-372d-b92b-1cc2127b40e3",
                                "text": "„Als solche Varietäten können die historisch gebundenen, die Historiolekte, und die Soziolekte als regional und historisch bestimmte Varietäten aufgefaßt werden.“"
                            },
                            {
                                "example_id": "326568c7-6fe4-40bb-afb1-a7813eae6e4d",
                                "sense_id": "320d0257-c830-372d-b92b-1cc2127b40e3",
                                "text": "„Historiolekte stellen sich dann dar als Zusammenfassungen von zeitlich abgrenzbar verschiedenen, aber untereinander verbindend-ähnlichen sprachlich-kommunikativen Handlungsbedingungen.“"
                            },
                            {
                                "example_id": "78f985b1-9eb8-4095-80cf-39fac215cfec",
                                "sense_id": "320d0257-c830-372d-b92b-1cc2127b40e3",
                                "text": "„In der Tradition der germanistischen Lexikologie findet man außer dem nur vereinzelt berücksichtigten sogenannten Register als der situationsbezogenen Varietät vor allem die Dialekte, Historiolekte und Soziolekte als die geographisch (diatopisch), historisch (diachronisch) und sozial (diastratisch) dimensionierten Varietäten behandelt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
