                                        "entry_id": "af8bf00b-f83d-31c6-9842-2b9e75fd99ac",
                                        "glosses": [
                                            "Personne identifiée comme ayant fréquenté une personne porteuse d'une maladie contagieuse, et donc susceptible elle-même d'être infectée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb7b1c64-1350-48a5-a13d-65ae4ad177b7",
                                                "sense_id": "5e97d992-7e24-3f28-b87a-7e6e15e3a04d",
                                                "text": "Le gouvernement s’est fixé comme objectif d’identifier 75 % des cas contacts."
                                            },
                                            {
                                                "example_id": "c82b3474-556c-4af5-8bec-b48928e4e57e",
                                                "sense_id": "5e97d992-7e24-3f28-b87a-7e6e15e3a04d",
                                                "text": "Pour le ministre, il faut également veiller à ne pas élargir outre mesure les chaînes de transmission : « les cas contacts des cas contacts ne sont pas des cas contacts »."
                                            }
                                        ]
                                    },
