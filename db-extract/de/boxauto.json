                "senses": [
                    {
                        "sense_id": "be927566-621a-37b2-8d32-f206309b5361",
                        "entry_id": "12e62231-1bf6-3d7d-9b1c-6f8dc2d9d65e",
                        "glosses": [
                            "auf Jahrmärkten, Volksfesten oder in Vergnügungsparks anzutreffendes, elektrisch angetriebenes, autoähnliches, kleines zweisitziges, lenkbares Fahrzeug mit breitem, wulstartigem Gummirand (zum Schutz vor Zusammenstößen), das in einem Fahrgeschäft auf einer begrenzten Fahrfläche gesteuert wird"
                        ],
                        "tags": [
                            "südwestdeutsch"
                        ],
                        "examples": [
                            {
                                "example_id": "dc159eb4-3caf-44ba-82c9-4665c7234c8f",
                                "sense_id": "be927566-621a-37b2-8d32-f206309b5361",
                                "text": "„Das Riesenrad ‚Amore‘ zeigt schon von weitem den Weg zum Festplatz, rasante Fahrten mit Loopings garantiert ein ‚Break-Dancer‘, der ‚Dschungel-Train‘ dreht seine Runden und beim Autoskooter fahren 30 Boxautos.“"
                            },
                            {
                                "example_id": "a0859a11-efff-4586-a888-26023d5bf4c5",
                                "sense_id": "be927566-621a-37b2-8d32-f206309b5361",
                                "text": "„Am Ostersamstag um 14 Uhr kommt dann Bewegung in die Sache: Die Holzläden der Süßwarenstände werden aufgeklappt, im Bistro-Zelt werden Getränke, Grillspezialitäten und ein abwechslungsreicher Mittagstisch serviert, die Jugendlichen rasen mit den Boxautos frontal aufeinander und die ganz Kleinen fahren mit dem Kinderkarussell.“"
                            },
                            {
                                "example_id": "a152d5f0-8a81-475b-860a-e396f2f463ef",
                                "sense_id": "be927566-621a-37b2-8d32-f206309b5361",
                                "text": "„Hinter ihm rammen sich Boxautos, rattert der Zug, tobt es auf den Trampolinen, werden Bälle in der Abenteuerlandschaft abgefeuert.“"
                            },
                            {
                                "example_id": "379d3588-6016-4e0f-ae56-9ddfa68258cf",
                                "sense_id": "be927566-621a-37b2-8d32-f206309b5361",
                                "text": "„Während die Jungs lieber Boxauto fahren oder ihr Glück an der Losbude versuchen, drehen die vier Enkeltöchter Runde um Runde auf dem Karussell.“"
                            },
                            {
                                "example_id": "c0931702-74e8-467d-a646-d28c3cf9f372",
                                "sense_id": "be927566-621a-37b2-8d32-f206309b5361",
                                "text": "„Jetzt ist die Zeit der Kinder und Jugendlichen, die strahlend ihre ersten Fahrversuche im Boxauto machen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
