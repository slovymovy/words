                    {
                        "form_id": "b14ff5d9-b7c0-448f-897f-d73e75757233",
                        "entry_id": "a73a3b5d-f63c-35bb-a4ad-e9568224f8af",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "prolixes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "80371d35-8c25-38c8-93cc-60a3eba6fc96",
                        "entry_id": "a73a3b5d-f63c-35bb-a4ad-e9568224f8af",
                        "glosses": [
                            "Qui est trop long, diffus, en parlant ou en écrivant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2fb89b10-94ec-444c-9b0d-0335e861d822",
                                "sense_id": "80371d35-8c25-38c8-93cc-60a3eba6fc96",
                                "text": "Si l’un était peu loquace, l’autre était volontiers bavard. D’après cela, on ne s’étonnera pas que les questions fussent très prolixes, et les réponses très brèves."
                            },
                            {
                                "example_id": "b9bea174-88ac-47cc-8284-418c4888c116",
                                "sense_id": "80371d35-8c25-38c8-93cc-60a3eba6fc96",
                                "text": "Parfois la liquidation des comptes frisait les moyens violents. C’était toujours un démêlé fort prolixe et souvent pénible, mais à notre époque de progrès on ne gagne pas sa vie sans batailler."
                            },
                            {
                                "example_id": "719824e8-5cbd-48a3-8514-bb3a2a62f076",
                                "sense_id": "80371d35-8c25-38c8-93cc-60a3eba6fc96",
                                "text": "Auteur prolixe, Acloque ne s'est pas contenté de limiter ses travaux à l'étude de la flore et de la fonge (champignons et lichens). La faune a également retenu son attention comme l'attestent plusieurs volumes […]."
                            },
                            {
                                "example_id": "69149733-f98f-44c4-b491-cc9af43e201f",
                                "sense_id": "80371d35-8c25-38c8-93cc-60a3eba6fc96",
                                "text": "— Les oiseaux faisaient entendre leurs prolixes concerts ; […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a0e125ea-508b-4490-a644-992bfb92a727",
                        "source_entry_id": "a73a3b5d-f63c-35bb-a4ad-e9568224f8af",
                        "source_sense_id": "80371d35-8c25-38c8-93cc-60a3eba6fc96",
                        "target_lang_word": "schwatzhaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schwatzhaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5cc36ed3-f529-3315-a178-4898351f2705",
                                        "entry_id": "c062523b-8218-3a5f-a99e-5480c91137dd",
                                        "glosses": [
                                            "viel und wortreich (über Überflüssiges oder Belangloses) redend; dazu neigend, Geheimnisse weiterzuerzählen"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7de0a61-f847-4c94-b1ac-8b94a94cd7c1",
                                                "sense_id": "5cc36ed3-f529-3315-a178-4898351f2705",
                                                "text": "Die Deutschlehrerin meines Sohnes ist eine äußerst schwatzhafte Person."
                                            },
                                            {
                                                "example_id": "fa285a27-6bfc-45ef-9b8c-62290b763116",
                                                "sense_id": "5cc36ed3-f529-3315-a178-4898351f2705",
                                                "text": "Neil wäre eigentlich ein ganz patenter Kerl, wäre er doch nur nicht so furchtbar schwatzhaft."
                                            },
                                            {
                                                "example_id": "a652ab60-4b57-4b41-af64-5f69d472b83c",
                                                "sense_id": "5cc36ed3-f529-3315-a178-4898351f2705",
                                                "text": "Ich hätte nicht gedacht, dass es jemanden geben könnte, der noch schwatzhafter ist als Yolantha."
                                            },
                                            {
                                                "example_id": "a0273b2d-ae0c-4f88-990c-0a7f708e0668",
                                                "sense_id": "5cc36ed3-f529-3315-a178-4898351f2705",
                                                "text": "Tante Priscilla darfst du rein gar nichts erzählen. Sie ist dermaßen schwatzhaft, dass in null Komma nichts jeder in ihrem Umfeld über alles Bescheid weiß."
                                            },
                                            {
                                                "example_id": "2e146d9a-7f53-4954-8036-228d16a22b0e",
                                                "sense_id": "5cc36ed3-f529-3315-a178-4898351f2705",
                                                "text": "Auf der Feier war auch die Kollegin von Reiner. In ihrer schwatzhaften Art hat sie mich den ganzen Abend über mit Beschlag belegt, so dass mir irgendwann von ihrem ununterbrochenen Gesabbel die Ohren klingelten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "33899367-753e-4744-a3db-86ab9afe336b",
                        "source_entry_id": "a73a3b5d-f63c-35bb-a4ad-e9568224f8af",
                        "source_sense_id": "80371d35-8c25-38c8-93cc-60a3eba6fc96",
