                ],
                "senses": [
                    {
                        "sense_id": "c622bbed-0f62-3b4a-8ed0-ae378b145524",
                        "entry_id": "7795d4fb-224e-3db8-a959-209994dc1c07",
                        "glosses": [
                            "Kleid, das aus Samt gefertigt ist – einem dickeren Stoff mit kurzem, schwach glänzenden Flor"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ccfb159-705c-4adf-b25c-44e4df87170b",
                                "sense_id": "c622bbed-0f62-3b4a-8ed0-ae378b145524",
                                "text": "»Du siehst einfach klasse aus in diesem Samtkleid!«"
                            },
                            {
                                "example_id": "4aa7ed41-68d3-463b-8008-1f91ca749930",
                                "sense_id": "c622bbed-0f62-3b4a-8ed0-ae378b145524",
                                "text": "»Dieses Samtkleid passt Ihnen wie angegossen.«"
                            },
                            {
                                "example_id": "862dedec-10b1-4714-a159-2166f4646171",
                                "sense_id": "c622bbed-0f62-3b4a-8ed0-ae378b145524",
                                "text": "Für den Ball kaufte ich mir ein langes schwarzes Samtkleid."
                            },
                            {
                                "example_id": "0cd15061-4a64-4f12-ab57-cfa613cba28e",
                                "sense_id": "c622bbed-0f62-3b4a-8ed0-ae378b145524",
                                "text": "Mir gefällt das Samtkleid mit dem V-Ausschnitt am besten."
                            },
                            {
                                "example_id": "4a11b81f-110a-4dbe-8b1a-86b16b1bdf6b",
                                "sense_id": "c622bbed-0f62-3b4a-8ed0-ae378b145524",
                                "text": "„Erika wünscht sich zur Konfirmation ein blaues Samtkleid.“"
                            },
                            {
                                "example_id": "4fefddd7-475d-48e5-b4a5-2e369943436d",
                                "sense_id": "c622bbed-0f62-3b4a-8ed0-ae378b145524",
                                "text": "„Wenn sie das hellblaue Samtkleid trug, wußte ich kaum, was blauer leuchtete, das Kleid oder die Augen.“"
                            },
                            {
                                "example_id": "e40bd0ca-b15f-4676-a643-52e85d2e0c76",
                                "sense_id": "c622bbed-0f62-3b4a-8ed0-ae378b145524",
                                "text": "„In dieser Robe schwebte sie mit John Travolta über das Parkett: Bei einer Auktion wird Prinzessin Dianas berühmtes Samtkleid versteigert.“"
                            },
                            {
                                "example_id": "2fd1b98c-80e1-4e1f-81af-f9aca29ba29d",
                                "sense_id": "c622bbed-0f62-3b4a-8ed0-ae378b145524",
                                "text": "„Ich zog es an – das war's – ein blaues Samtkleid! Schick sah es aus und wie gut es mir stand. Das Kleid saß wie angegossen […].“"
                            },
                            {
                                "example_id": "4e80d8af-c6f5-4d5c-9ab2-0a7860637c9d",
                                "sense_id": "c622bbed-0f62-3b4a-8ed0-ae378b145524",
                                "text": "„Ich starrte das Kleid an, das […] vor meinem Bett lag. Ein grünes Samtkleid? Wann hatte ich jemals ein grünes Samtkleid getragen?“"
                            },
                            {
                                "example_id": "2bb2c7de-8e70-4f84-9434-a4ae291c8336",
                                "sense_id": "c622bbed-0f62-3b4a-8ed0-ae378b145524",
                                "text": "[Die französische Schriftstellerin] „Marguerite Yourcenar zog in einem schwarzen Samtkleid und mit einem weissen Schleier in die Académie ein. Das Kleid war extra für sie entworfen worden – von Yves Saint Laurent.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
