                        "examples": [
                            {
                                "example_id": "4c46306a-7bf5-4e95-82f5-678b897691c9",
                                "sense_id": "3696cf76-7d7f-3013-b388-dc17dad79b94",
                                "text": "Ancient mysteries brood silently in the Land of the Pharaohs. Across the desert sands, the Sphinx stares voicelessly, noselessly."
                            },
                            {
                                "example_id": "e4b949e4-92c4-4e8d-8b80-5c5f0d7c0192",
                                "sense_id": "3696cf76-7d7f-3013-b388-dc17dad79b94",
                                "text": "She had a number of children who were quite recognizable by their faces and their resemblance to her: many women descended from her—this is the truth—were born without a nose and so they lived their lives noselessly."
                            }
                        ]
                    }
