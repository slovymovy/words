                ],
                "senses": [
                    {
                        "sense_id": "224764bc-516c-3737-b25b-d43c5f4d3563",
                        "entry_id": "9fa744bf-39ee-3689-accb-c89908332c61",
                        "glosses": [
                            "Messeinrichtung, die das tatsächliche Müllgewicht in einem Müllfahrzeug ermittelt; Differenzmessung und Entgeltberechnung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b232447-29d2-4570-b4f9-06420fd3abfe",
                                "sense_id": "224764bc-516c-3737-b25b-d43c5f4d3563",
                                "text": "Jedes Müllfahrzeug wir an einer Deponie oder Müllverbrennungsanlage auf der Müllwaage im vollen, und beim Ausfahren, im leeren Zustand, gewogen."
                            },
                            {
                                "example_id": "2cd9bdd2-0df3-4ba7-a46b-6a3118cb69fb",
                                "sense_id": "224764bc-516c-3737-b25b-d43c5f4d3563",
                                "text": "„Bei selbsttätigen Müllwaagen sind simulierte Lasten bekannter Masse in mehreren Laststufen (z.B. Sandsäcke o.ä. … Messunsicherheit ≤1/3 der Eichfehlergrenze des Prüflings) erforderlich.“"
                            },
                            {
                                "example_id": "5ba139a2-bdbe-40f2-9881-d4ad9b7746f7",
                                "sense_id": "224764bc-516c-3737-b25b-d43c5f4d3563",
                                "text": "„Die Beschwerdeführer schlagen vor, die Müllwaage abzuschaffen, weil die Versuchung zu groß sei, Essensreste an der grauen Tonnen vorbei zu entsorgen.“"
                            },
                            {
                                "example_id": "a2b05877-6da5-4068-adcd-9e5f69a9504c",
                                "sense_id": "224764bc-516c-3737-b25b-d43c5f4d3563",
                                "text": "„In Gebietskörperschaften, in denen die Abfallgebühren nach Gewicht berechnet werden, betreibt die Innotec Abfallmanagement GmbH auch sogenannte Müllwaagen.“"
                            },
                            {
                                "example_id": "fa1f110c-4b48-463b-95e4-d1886d898948",
                                "sense_id": "224764bc-516c-3737-b25b-d43c5f4d3563",
                                "text": "„Zuerst wurden wir auf der großen Müllwaage gewogen – Ergebnis: 780 kg!“"
                            },
                            {
                                "example_id": "c1dfadeb-b72d-4c86-b829-ffcbc67ef6dd",
                                "sense_id": "224764bc-516c-3737-b25b-d43c5f4d3563",
                                "text": "„Gegenwärtig bringt der RAVON nur noch ca. 80.000 Tonnen jährlich auf die Müllwaage, was vor allem an der Liberalisierung der Entsorgung von Gewerbeabfällen und am demografischen Wandel liegen dürfte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
