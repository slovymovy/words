                        ]
                    },
                    {
                        "translation_id": "44a67fe6-2e70-42f8-bbca-dbb962b7c14e",
                        "source_entry_id": "07721057-a2b8-3582-9e1d-9cbb52ff6d85",
                        "source_sense_description": "a swimming stroke swum on one's back",
                        "target_lang_word": "dos",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dos",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1b0301cb-180e-3479-8414-a2ef9613edf9",
                                        "entry_id": "024e4f6b-9acd-3f43-8824-070d0da5f16c",
                                        "glosses": [
                                            "Partie du corps humain située au-dessus du postérieur, depuis le cou jusqu’aux reins."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5dff2265-2a11-4261-851c-c8a82243c06b",
                                                "sense_id": "1b0301cb-180e-3479-8414-a2ef9613edf9",
                                                "text": "Tandis que j’arrondis le dos en m’inclinant, elle m’honore d’un salut de tête qui ne met en jeu que les vertèbres de son long cou, […]."
                                            },
                                            {
                                                "example_id": "8f145708-0f83-43c5-8ed3-4b0f2ee7f872",
                                                "sense_id": "1b0301cb-180e-3479-8414-a2ef9613edf9",
                                                "text": "Il dormait sans qu’on l’entende respirer, couché à plat sur le dos comme les beaux dormeurs."
                                            },
                                            {
                                                "example_id": "b1e3985e-ac8c-4aff-8fe7-84336e91717c",
                                                "sense_id": "1b0301cb-180e-3479-8414-a2ef9613edf9",
                                                "text": "Je demeurai couché sur le dos, les yeux grands ouverts, fixant le plafond."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17812040-76ee-3757-a70c-f7b285ee2462",
                                        "entry_id": "024e4f6b-9acd-3f43-8824-070d0da5f16c",
                                        "glosses": [
                                            "Partie équivalente au dos humain du corps de certains animaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e479a29-cc3d-4a4d-9fec-1582cd51bb3d",
                                                "sense_id": "17812040-76ee-3757-a70c-f7b285ee2462",
                                                "text": "Il leur suffisait […] de passer la main sur le dos d’une vache pour que le lait tournât en urine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c7807d4-6e38-3260-8cc9-7a0c08378953",
                                        "entry_id": "024e4f6b-9acd-3f43-8824-070d0da5f16c",
                                        "glosses": [
                                            "Envers, partie de certaines choses qui, par sa destination, par sa position ou par sa forme, offre quelque rapport avec le dos de l’homme ou de l’animal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c4cf6dd-c934-49ff-a7e3-9367159b0427",
                                                "sense_id": "0c7807d4-6e38-3260-8cc9-7a0c08378953",
                                                "text": "Le dos d’un habit, d’une robe, partie d’un habit, d’une robe qui sert à couvrir le dos;"
                                            },
                                            {
                                                "example_id": "a095705a-ee8d-42be-a257-dfa841b9d3e2",
                                                "sense_id": "0c7807d4-6e38-3260-8cc9-7a0c08378953",
                                                "text": "Le dos d’une chaise, d’un fauteuil, etc., partie d’une chaise, etc., contre laquelle on s’appuie le dos."
                                            },
                                            {
                                                "example_id": "98e59230-e3a7-42c2-8899-1dbcfc0bf530",
                                                "sense_id": "0c7807d4-6e38-3260-8cc9-7a0c08378953",
                                                "text": "Dos brisé, reliure faite de telle sorte que le livre que l’on ouvre ne se referme pas de lui-même."
                                            },
                                            {
                                                "example_id": "bafcab66-8a33-43bc-adf9-3b4f87c689d7",
                                                "sense_id": "0c7807d4-6e38-3260-8cc9-7a0c08378953",
                                                "text": "Le dos d’un papier, d’un billet, d’un acte, etc., le revers."
                                            },
                                            {
                                                "example_id": "f7d3261c-ed28-482e-8a17-f9eba008ecab",
                                                "sense_id": "0c7807d4-6e38-3260-8cc9-7a0c08378953",
                                                "text": "Mettre sa signature au dos d’un chèque."
                                            },
                                            {
                                                "example_id": "75a6ba84-3ef4-4057-a9cd-a283448596c8",
                                                "sense_id": "0c7807d4-6e38-3260-8cc9-7a0c08378953",
                                                "text": "Le dos de la main, côté extérieur de la main, opposé à la paume de la main."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e17257b-69ec-3347-8c4a-1a40479ecbaa",
                                        "entry_id": "024e4f6b-9acd-3f43-8824-070d0da5f16c",
                                        "glosses": [
                                            "Dos crawlé (style de nage)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a12ed24-48cd-41a2-81b5-11337ed9d6e4",
                                                "sense_id": "3e17257b-69ec-3347-8c4a-1a40479ecbaa",
                                                "text": "Camille Replumaz, grand espoir du club détient, après deux années d'entraînement, quatre records de l’histoire de l’UAS dans sa catégorie en dos et en papillon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2270d5a-72e6-356e-9862-47f123ccc183",
                                        "entry_id": "024e4f6b-9acd-3f43-8824-070d0da5f16c",
                                        "glosses": [
                                            "Partie opposée au tranchant d’une lame, qui porte généralement les inscriptions indiquant le nom du fournisseur de l’arme."
                                        ],
                                        "tags": [
                                            "Armement"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "17ca327c-4958-3db0-ad23-ea4876fbe674",
                                        "entry_id": "024e4f6b-9acd-3f43-8824-070d0da5f16c",
                                        "glosses": [
                                            "Côté du livre où se trouve la reliure. À ne pas confondre avec la quatrième de couverture."
                                        ],
                                        "tags": [
                                            "Bibliothéconomie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d73a0fd6-eed2-4d3f-a34f-4edf50d6deb4",
                                                "sense_id": "17ca327c-4958-3db0-ad23-ea4876fbe674",
                                                "text": "Le dos d’un livre, partie opposée à la tranche et sur laquelle on met ordinairement le titre."
                                            },
                                            {
                                                "example_id": "3e616d8e-396e-4cf7-a586-091ad8801bac",
                                                "sense_id": "17ca327c-4958-3db0-ad23-ea4876fbe674",
                                                "text": "Les livres s’étageaient en face de Simon, mais il n’osait les toucher, s’appliquant, le front haut, les bras croisés sur la table, à suivre le speech du professeur. Il risquait parfois un regard, penchait le cou, lorgnait les dos."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1515b606-ba64-3fb3-8699-7c54fd67ef56",
                                        "entry_id": "024e4f6b-9acd-3f43-8824-070d0da5f16c",
                                        "glosses": [
                                            "Proxénète."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa669edd-1821-4ad7-ac4b-ff41f206bc02",
                                                "sense_id": "1515b606-ba64-3fb3-8699-7c54fd67ef56",
                                                "text": "Puis, déguerpissant tour à tour,\n Chaque dos rentre sa marmite,\n Compte la braise et fait l’amour !"
                                            },
                                            {
                                                "example_id": "8347c4c1-3826-4ff3-9644-fd3152f995f2",
                                                "sense_id": "1515b606-ba64-3fb3-8699-7c54fd67ef56",
                                                "text": "[…] mais qu'un mec se soit appelé un dos, un poisse et, plus tard, un hareng, ça ne change rien à son état civil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "537e9656-9c02-3934-9b3b-8842c0017adf",
                                        "entry_id": "024e4f6b-9acd-3f43-8824-070d0da5f16c",
                                        "glosses": [
                                            "Dans une course hippique, espace situé derrière un cheval, sillage."
                                        ],
                                        "tags": [
                                            "Sports hippiques"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a23c14cf-f50f-4763-b2b6-56837b4ccfe9",
                                                "sense_id": "537e9656-9c02-3934-9b3b-8842c0017adf",
                                                "text": "avoir le dos de"
                                            },
                                            {
                                                "example_id": "9f918897-304d-4bda-a363-ea002f533d85",
                                                "sense_id": "537e9656-9c02-3934-9b3b-8842c0017adf",
                                                "text": "prendre le dos de"
                                            },
                                            {
                                                "example_id": "fa655f7e-a5a3-45ac-8777-801bd088de33",
                                                "sense_id": "537e9656-9c02-3934-9b3b-8842c0017adf",
                                                "text": "offrir son dos"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
