        "nl-extract.jsonl": [
            {
                "entry_id": "9c4dde9e-93d2-3eb4-b805-8222e7c968a7",
                "word": "sneeuwwater",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "cb4fe9cd-d60c-33e6-a19d-232b8f1a62f8",
                        "entry_id": "9c4dde9e-93d2-3eb4-b805-8222e7c968a7",
                        "glosses": [
                            "gesmolten sneeuw"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec454619-fec6-4951-8899-5b3bc98a73d3",
                                "sense_id": "cb4fe9cd-d60c-33e6-a19d-232b8f1a62f8",
                                "text": "Ik woon in een huis uit 1934. Ik zou het regenwater (en afgelopen dagen ook het sneeuwwater) graag willen gebruiken voor bijvoorbeeld het doorspoelen van het toilet. Zou dat een rendabele investering kunnen worden?"
                            },
                            {
                                "example_id": "42ee622b-5aca-41bc-a53a-1258b6283c37",
                                "sense_id": "cb4fe9cd-d60c-33e6-a19d-232b8f1a62f8",
                                "text": "„Mijn ouders zijn allebei geboren in Karsu, een Turks dorpje aan de grens met Syrië, vlakbij [sic!] de Middellandse Zee. Kar betekent sneeuw, Su water. Sneeuwwater heet ik dus."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f80ee4b5-e361-46e9-bb2f-a3e3ce267391",
                        "source_entry_id": "9c4dde9e-93d2-3eb4-b805-8222e7c968a7",
                        "source_sense_id": "cb4fe9cd-d60c-33e6-a19d-232b8f1a62f8",
                        "target_lang_word": "slosh",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "slosh",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d9af1916-f572-3e4a-8100-b3e2727c39f2",
                                        "entry_id": "ebf16529-5870-3406-9ba4-f9ec18d22c74",
                                        "glosses": [
                                            "To shift chaotically; to splash noisily."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe6c64a0-a234-4e35-8c0d-61ed5ed6ea44",
                                                "sense_id": "d9af1916-f572-3e4a-8100-b3e2727c39f2",
                                                "text": "The water in his bottle sloshed back and forth as he ran."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47fd088e-2e49-3f42-a49a-d1d6d0af09a5",
                                        "entry_id": "ebf16529-5870-3406-9ba4-f9ec18d22c74",
                                        "glosses": [
                                            "To cause to slosh."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "780a0540-df46-4b30-ad9a-ff860b429eb8",
                                                "sense_id": "47fd088e-2e49-3f42-a49a-d1d6d0af09a5",
                                                "text": "The boy sloshed water over the edge of the bath."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b41bdef8-58b2-3b71-8694-4a7d71b582ff",
                                        "entry_id": "ebf16529-5870-3406-9ba4-f9ec18d22c74",
                                        "glosses": [
                                            "To make a sloshing sound."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "799bc04c-6716-4403-b85f-98479773e053",
                                                "sense_id": "b41bdef8-58b2-3b71-8694-4a7d71b582ff",
                                                "text": "His boots were so completely soaked that they sloshed when he walked."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1addd2d8-1cd4-39d1-bf9d-c57ff75020aa",
                                        "entry_id": "ebf16529-5870-3406-9ba4-f9ec18d22c74",
                                        "glosses": [
                                            "To pour noisily, sloppily or in large amounts."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64a7d2d2-0ad8-4ff7-adb9-42fab3f8503c",
                                                "sense_id": "1addd2d8-1cd4-39d1-bf9d-c57ff75020aa",
                                                "text": "The coffee was nice and hot, so she sloshed some into a cup and went back to her desk."
                                            },
                                            {
                                                "example_id": "04a8b5d9-ed77-4614-b5c4-c35278370310",
                                                "sense_id": "1addd2d8-1cd4-39d1-bf9d-c57ff75020aa",
                                                "text": "He really sloshed on the sauce- they were a bit strong for my taste."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92cc27fe-0950-39e1-8fca-15d53e10dbb8",
                                        "entry_id": "ebf16529-5870-3406-9ba4-f9ec18d22c74",
                                        "glosses": [
                                            "to move noisily through water or other liquid."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63e2c793-18ff-4744-a7a6-664d87a3639b",
                                                "sense_id": "92cc27fe-0950-39e1-8fca-15d53e10dbb8",
                                                "text": "The streets were flooded, but they still managed to slosh their way to school."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0ae0df8-ec10-31e6-a8ab-e54b48c77d6d",
                                        "entry_id": "ebf16529-5870-3406-9ba4-f9ec18d22c74",
                                        "glosses": [
                                            "To punch (someone)."
                                        ],
                                        "tags": [
                                            "British",
                                            "colloquial",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6cbb6936-631b-460a-ae5c-797be868f7df",
                                                "sense_id": "d0ae0df8-ec10-31e6-a8ab-e54b48c77d6d",
                                                "text": "She greeted me with a bright smile, and said: “Back already? Did you find it?” With a strong effort I mastered my emotion and replied curtly but civilly that the answer was in the negative. “No,” I said, “I did not find it.” “You can't have looked properly.” Again I was compelled to pause and remind myself that an English gentleman does not slosh a sitting redhead, no matter what the provocation."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "slosh",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "79885389-91f7-3fee-86b4-374808ec1e66",
                                        "entry_id": "9f0ddd35-1e68-34c3-a9f0-3fe4a4d4587b",
                                        "glosses": [
