                        "target_lang_word": "atonement",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "atonement",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b33f05e9-38fa-3de0-8917-745317d45e7e",
                                        "entry_id": "620db31c-3a8e-3baa-9fb9-ecd764c9b055",
                                        "glosses": [
                                            "Making amends to restore a damaged relationship; expiation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f13bab4-da7c-4deb-8a6e-e49e9cf577e9",
                                                "sense_id": "b33f05e9-38fa-3de0-8917-745317d45e7e",
                                                "text": "When a man has been guilty of any vice, the best atonement he can make for it is, to warn others."
                                            },
                                            {
                                                "example_id": "d70c999c-1878-4f3d-b236-91c59f2cb17c",
                                                "sense_id": "b33f05e9-38fa-3de0-8917-745317d45e7e",
                                                "text": "1697-1698, John Potter, Archaeologia Graeca\nThe Phocians behaved themselves with so much gallantry, that they were thought to have made a sufficient atonement for their former offense."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fde5a197-fadd-3f9a-b95b-1efa347a2323",
                                        "entry_id": "620db31c-3a8e-3baa-9fb9-ecd764c9b055",
                                        "glosses": [
                                            "The reconciliation of God and mankind through the death of Jesus."
                                        ],
                                        "tags": [
                                            "countable",
                                            "often",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "671b3720-3edf-31ed-b2a6-a5b080f133be",
                                        "entry_id": "620db31c-3a8e-3baa-9fb9-ecd764c9b055",
                                        "glosses": [
                                            "Reconciliation; restoration of friendly relations; concord."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7dabe448-c788-434d-b049-aa981bdc91a9",
                                                "sense_id": "671b3720-3edf-31ed-b2a6-a5b080f133be",
                                                "text": "by whom we have now received the atonement"
                                            },
                                            {
                                                "example_id": "e389f5cc-5a74-4795-a1f1-f4fd0c0bc18e",
                                                "sense_id": "671b3720-3edf-31ed-b2a6-a5b080f133be",
                                                "text": "He desires to make atonement\nBetwixt the Duke of Gloucester and your brothers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "95017582-9fe4-4829-a714-500e23bedde2",
                        "source_entry_id": "7450516b-aa6e-309c-b118-48299367d114",
