    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "12d9a592-79a2-3da6-84b8-a42a8c76bead",
                "word": "outfielder",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "0e076dd7-47f8-40d1-9ed2-2bbb9fc6fd6d",
                        "entry_id": "12d9a592-79a2-3da6-84b8-a42a8c76bead",
                        "tags": [
                            "plural"
                        ],
                        "form": "outfielders"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "957518a3-16eb-3ccb-88c3-4e4844b36523",
                        "entry_id": "12d9a592-79a2-3da6-84b8-a42a8c76bead",
                        "glosses": [
                            "A player that plays in the outfield, which is the outer portion of the field."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3be69d84-8107-4753-a9e7-f1220858cb87",
                                "sense_id": "957518a3-16eb-3ccb-88c3-4e4844b36523",
                                "text": "The outfielder tracked down the long fly."
                            },
                            {
                                "example_id": "9f87c321-160b-49a3-a291-757fccdf6645",
                                "sense_id": "957518a3-16eb-3ccb-88c3-4e4844b36523",
                                "text": ". I like to think that if I wasn't pitcher I could be an outfielder or a first baseman or something and play major league baseball anyway."
                            },
                            {
                                "example_id": "d9fb8501-7db5-4920-9b64-99699c6cfae5",
                                "sense_id": "957518a3-16eb-3ccb-88c3-4e4844b36523",
                                "text": "The Twins are known for their fascination with toolsy and athletic outfielders, but Hicks has the most talent of any Twins draft pick since Joe Mauer in 2002."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b092681e-f176-4e2c-9bb3-9042ea177449",
                        "source_entry_id": "12d9a592-79a2-3da6-84b8-a42a8c76bead",
                        "source_sense_id": "957518a3-16eb-3ccb-88c3-4e4844b36523",
                        "source_sense_description": "a player that plays in the outfield",
                        "target_lang_word": "voltigeur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "voltigeur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "addb7694-a6ff-302c-b25e-c36a13716954",
                                        "entry_id": "2f118130-ca02-37e2-bd1c-183176b21fae",
                                        "glosses": [
                                            "Qui concerne ou pratique la voltige."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d649228e-f4fe-4c0e-a7d5-e6cf4a18154e",
                                                "sense_id": "addb7694-a6ff-302c-b25e-c36a13716954",
                                                "text": "Des délégués de l'USC purent en effet assister aux prestations des motards du peloton voltigeur motorisé, le PVM, une unité de prestige […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16c3c0af-b2a3-3558-a1bb-b32b00526491",
                                        "entry_id": "2f118130-ca02-37e2-bd1c-183176b21fae",
                                        "glosses": [
                                            "Qui va çà et là, sans se fixer."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "320ddf57-c6ad-4dd4-ae06-e0aa00645cf1",
                                                "sense_id": "16c3c0af-b2a3-3558-a1bb-b32b00526491",
                                                "text": "Leur seul adieu au jardin est de secouer sur son seuil des perles de rosée, dans un geste que fait Arlette pour écarter de ses yeux des cheveux voltigeurs."
                                            },
                                            {
                                                "example_id": "5a54ea66-e9c1-4479-a422-32ebef77e77d",
                                                "sense_id": "16c3c0af-b2a3-3558-a1bb-b32b00526491",
                                                "text": "Cécile chantait, jouait, je ne sais trop, comme saisie d’inspiration. Sa main voltigeuse faisait sourdre du vieux meuble perclus des accents célestes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "voltigeur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d128cdaf-f67b-3645-8c3c-30c84536be09",
                                        "entry_id": "13ea4a18-61a7-3dc4-985e-443f84e8c82d",
                                        "glosses": [
                                            "Soldat d’infanterie légère mobile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3fa419f-db75-45e6-83ed-b15b821e8554",
                                                "sense_id": "d128cdaf-f67b-3645-8c3c-30c84536be09",
                                                "text": "Si un sabre est utile dans l’infanterie, c’est particulièrement à un voltigeur."
                                            },
                                            {
                                                "example_id": "75fc4832-4416-4341-ae82-cf7b2c5814f2",
                                                "sense_id": "d128cdaf-f67b-3645-8c3c-30c84536be09",
                                                "text": "Des voltigeurs, au cours de la nuit, allaient de poste en poste pour donner les consignes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3905e9ba-7f2f-3a6e-b694-90c15d9b7778",
                                        "entry_id": "13ea4a18-61a7-3dc4-985e-443f84e8c82d",
                                        "glosses": [
                                            "Désignation du grade d’un membre du régiment des Voltigeurs du Québec détenant le grade de soldat."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8f3fc0ef-606b-3778-8e4a-2517caf39ef9",
                                        "entry_id": "13ea4a18-61a7-3dc4-985e-443f84e8c82d",
                                        "glosses": [
                                            "Joueur de champ extérieur."
                                        ],
                                        "tags": [
                                            "Canada"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d7a5ce8-247f-487c-a423-474f2acb3b47",
                                                "sense_id": "8f3fc0ef-606b-3778-8e4a-2517caf39ef9",
                                                "text": "Mais les Rays avaient surpris tout le monde et menaient devant les Sox depuis maintenant sept matches, et trois de nos lanceurs de départ, notre voltigeur de gauche, notre arrêt-court et notre troisième base étaient blessés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c9a4c28-cfc4-3e5b-909b-42ff2cf946ed",
                                        "entry_id": "13ea4a18-61a7-3dc4-985e-443f84e8c82d",
                                        "glosses": [
                                            "Soldat appartenant à un corps d’infanterie légère transporté par une brigade à cheval et spécialisé dans les actions au-delà des lignes (renseignement, « coup de main », sabotage…)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5472c93b-d2da-44f5-a39e-7acd25707029",
                                                "sense_id": "3c9a4c28-cfc4-3e5b-909b-42ff2cf946ed",
                                                "text": "Cet homme était un bandit, qui, étant parti de nuit pour aller chercher de la poudre à la ville, était tombé en route dans une embuscade de voltigeurs corses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3374d0da-e08a-35e2-b767-6e70974b0224",
                                        "entry_id": "13ea4a18-61a7-3dc4-985e-443f84e8c82d",
                                        "glosses": [
                                            "Cavalier napoléonien légèrement armé."
                                        ],
                                        "tags": [
                                            "Particulièrement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9edd75fa-cc75-4323-8b00-023088c01338",
                                                "sense_id": "3374d0da-e08a-35e2-b767-6e70974b0224",
                                                "text": "Le voltigeur, c’est aussi le nom du soldat dans l’armée de Napoléon, celui qui cavale sans cesse sur le champ de bataille, très légèrement armé pour aller plus vite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1503d33-9219-36d1-acac-a48b5cf288f7",
                                        "entry_id": "13ea4a18-61a7-3dc4-985e-443f84e8c82d",
                                        "glosses": [
                                            "Celui qui voltige sur une moto."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4f2c9f7-08bf-4656-84a4-22e09a59f238",
                                                "sense_id": "f1503d33-9219-36d1-acac-a48b5cf288f7",
                                                "text": "Quant à Laurent Bezault, juché sur une moto, il est le voltigeur de la direction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "537a4fa4-b7c5-34d3-8dd1-a2d2b2bf4e9c",
                                        "entry_id": "13ea4a18-61a7-3dc4-985e-443f84e8c82d",
                                        "glosses": [
                                            "Policier transporté par un membre d’une brigade motorisée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "727a80f0-66fb-4277-b41b-5c4310012cc2",
                                                "sense_id": "537a4fa4-b7c5-34d3-8dd1-a2d2b2bf4e9c",
                                                "text": "Nous devions rester sur les motos et il était interdit au voltigeur de mettre pied à terre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e4c4018-ee18-3453-ba63-6b8837cc39f2",
                                        "entry_id": "13ea4a18-61a7-3dc4-985e-443f84e8c82d",
                                        "glosses": [
                                            "Acrobate qui effectue des figures, seul ou avec un porteur (parfois avec un cheval, avec une moto…)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8df300b5-a52f-44e8-9c3c-01d83ab12506",
                                                "sense_id": "6e4c4018-ee18-3453-ba63-6b8837cc39f2",
                                                "text": "Le voltigeur décolle les pieds par une série d’impulsions, le porteur assure la verticalité avec les bras."
                                            },
                                            {
                                                "example_id": "33caeb59-7b84-40f4-9a49-a428e9f3c7dd",
                                                "sense_id": "6e4c4018-ee18-3453-ba63-6b8837cc39f2",
                                                "text": "L’homme est un voltigeur de moto, il répète son numéro, il est extraordinaire."
                                            },
                                            {
                                                "example_id": "d3ac8fcc-d608-48cc-b6a7-4eb0c55cfe3f",
                                                "sense_id": "6e4c4018-ee18-3453-ba63-6b8837cc39f2",
                                                "text": "Le voltigeur apprend à monter et à descendre du cheval en mouvement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "508b4377-418f-3709-9338-53a77ea842b3",
                                        "entry_id": "13ea4a18-61a7-3dc4-985e-443f84e8c82d",
                                        "glosses": [
                                            "Marque de cigare."
                                        ],
                                        "tags": [
                                            "Tabacologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "660d2da6-b458-413f-9ab8-560cd94ddb9a",
                                                "sense_id": "508b4377-418f-3709-9338-53a77ea842b3",
                                                "text": "Et le commissaire Labbé cligna de l’œil, alluma un voltigeur."
                                            },
                                            {
                                                "example_id": "de28d856-f599-4e91-9a1d-d8e7d99ecfca",
                                                "sense_id": "508b4377-418f-3709-9338-53a77ea842b3",
                                                "text": "Le gendarme avalait à demi son voltigeur, à chaque bouffée."
                                            },
                                            {
                                                "example_id": "04788423-0632-4179-a4b4-be80fd42047c",
                                                "sense_id": "508b4377-418f-3709-9338-53a77ea842b3",
                                                "text": "le Voltigeur dénicotinisé disparut en 1946 après onze années d'existence."
                                            },
                                            {
                                                "example_id": "dcf8783b-5b31-4880-bc56-3aa7ba758673",
                                                "sense_id": "508b4377-418f-3709-9338-53a77ea842b3",
                                                "text": "J’allumai un voltigeur, pour pousser mon insubordination jusqu’à la limite - il était interdit de fumer dans l’autobus…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e95197a5-f33f-3a47-9563-bd78129b1ca5",
                                        "entry_id": "13ea4a18-61a7-3dc4-985e-443f84e8c82d",
                                        "glosses": [
                                            "Ramoneur qui entre dans une cheminée, et y travaille sans support."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51e6ecca-0a99-44e7-b0d7-edacf793eeb6",
                                                "sense_id": "e95197a5-f33f-3a47-9563-bd78129b1ca5",
                                                "text": "Le capitaine sort de la cheminée : arc-bouté entre les parois, le voltigeur continue l’ouvrage seul, à la force des bras, des cuisses, des mollets."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
