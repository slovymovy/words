                "senses": [
                    {
                        "sense_id": "36d494b7-a2d9-3d58-b980-d0aa025ccfcf",
                        "entry_id": "28f112f0-8f4d-318c-8425-8c92c3368e2c",
                        "glosses": [
                            "Grenzpunkt, an dem drei Länder aufeinandertreffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "906b9fcf-4da7-4dbc-a2e1-27c468ef4a30",
                                "sense_id": "36d494b7-a2d9-3d58-b980-d0aa025ccfcf",
                                "text": "„Sie können aber in einer Region wie dem Fergana-Tal im Länderdreieck zwischen Usbekistan, Kirgistan und Tadschikistan, in der die Bevölkerung auf grenzüberschreitende Kommunikation und Handel angewiesen ist, nicht – wie geschehen – einfach geschlossen oder gar vermint werden, ohne soziale, ethnische und politische Konflikte aufzuwerfen.“"
                            },
                            {
                                "example_id": "387a0041-5556-442e-a74a-e47edcaf910c",
                                "sense_id": "36d494b7-a2d9-3d58-b980-d0aa025ccfcf",
                                "text": "„Im Länderdreieck gab es ein Geschütz mit Radarsteuerung, und wir sind da durchgesegelt, als ginge uns das alles am Arsch vorbei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
