                ],
                "senses": [
                    {
                        "sense_id": "a01aab66-87a7-3b5c-8c8c-2a2ae97a9b58",
                        "entry_id": "05e7ac12-700e-37ad-9de3-11ce202545f0",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b338450-4079-4dc0-bd6d-2729c19dd624",
                                "sense_id": "a01aab66-87a7-3b5c-8c8c-2a2ae97a9b58",
                                "text": "Frau Gerdes ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "dcb13d34-97e5-4906-ba7f-2521ceac9eec",
                                "sense_id": "a01aab66-87a7-3b5c-8c8c-2a2ae97a9b58",
                                "text": "Herr Gerdes wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "67023271-6f99-4b52-be9c-c43ebb1f1c9e",
                                "sense_id": "a01aab66-87a7-3b5c-8c8c-2a2ae97a9b58",
                                "text": "Die Gerdesens fahren heute nach Bremen."
                            },
                            {
                                "example_id": "68e06422-778e-4786-8308-2a259e711fe7",
                                "sense_id": "a01aab66-87a7-3b5c-8c8c-2a2ae97a9b58",
                                "text": "Der Gerdes trägt nie die Schals, die die Gerdes ihm strickt."
                            },
                            {
                                "example_id": "e458b4c8-24a1-4ec5-a93d-467063864fda",
                                "sense_id": "a01aab66-87a7-3b5c-8c8c-2a2ae97a9b58",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Gerdes kommt, geht der Herr Gerdes.“"
                            },
                            {
                                "example_id": "d3a2b7c8-8abb-4ae9-92a8-3c52ec481f4a",
                                "sense_id": "a01aab66-87a7-3b5c-8c8c-2a2ae97a9b58",
                                "text": "Gerdes kommt und geht."
                            },
                            {
                                "example_id": "4d6bc2c7-9cc1-46e2-883b-7e275b9ad949",
                                "sense_id": "a01aab66-87a7-3b5c-8c8c-2a2ae97a9b58",
                                "text": "Gerdes kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
