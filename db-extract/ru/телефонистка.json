                                            {
                                                "example_id": "886dc2c8-f059-4a69-a4a5-7cb95ef71f20",
                                                "sense_id": "51214a1d-fb71-3d5c-9d7b-6322206dbdfd",
                                                "text": "À six heures nous rejoignons au jardin du couvent les téléphonistes."
                                            },
