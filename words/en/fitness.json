                                "target_lang_sense_clarification": "система упражнений и состояние здоровья"
                            },
                            {
                                "target_lang_word": "подтянутость",
                                "target_lang_sense_clarification": "внешний вид и тонус"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "19935bc1-6976-3091-9fcc-f8c573874ddb",
                    "sense_definition": "The quality of being suitable, appropriate, or right for a particular purpose or situation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "suitability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee will evaluate the <w>fitness</w> of the candidate for this high-level position.",
                            "target_lang_translations": {
                                "ru": "Комитет оценит <w>пригодность</w> кандидата на эту высокую должность."
                            }
                        },
                        {
                            "text": "They questioned the <w>fitness</w> for purpose of the new safety regulations.",
                            "target_lang_translations": {
                                "ru": "Они поставили под сомнение <w>соответствие</w> новых правил безопасности их назначению."
                            }
                        }
                    ],
                    "synonyms": [
                        "suitability",
                        "capability"
                    ],
                    "antonyms": [
                        "unfitness"
                    ],
                    "common_phrases": [
                        "fitness for purpose",
                        "test of fitness"
                    ],
                    "target_lang_definitions": {
                        "ru": "Качество соответствия, уместности или правильности для определенной цели или ситуации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пригодность",
                                "target_lang_sense_clarification": "соответствие требованиям"
                            },
                            {
                                "target_lang_word": "соответствие",
                                "target_lang_sense_clarification": "подходящий характер"
                            },
                            {
                                "target_lang_word": "годность",
                                "target_lang_sense_clarification": "способность к использованию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "266a5e2b-5061-3365-a217-980ed92d0224",
                    "sense_definition": "The ability of an organism to survive and reproduce in its environment.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In evolutionary biology, reproductive <w>fitness</w> determines which traits are passed to the next generation.",
                            "target_lang_translations": {
                                "ru": "В эволюционной биологии репродуктивная <w>приспособленность</w> определяет, какие черты передаются следующему поколению."
                            }
                        },
                        {
                            "text": "Natural selection favors individuals with higher genetic <w>fitness</w> in changing environments.",
                            "target_lang_translations": {
                                "ru": "Естественный отбор благоприятствует особям с более высокой генетической <w>приспособленностью</w> в меняющихся условиях среды."
                            }
                        }
                    ],
                    "common_phrases": [
                        "evolutionary fitness",
                        "reproductive fitness",
                        "genetic fitness"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "scientific"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Способность организма выживать и размножаться в своей среде обитания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приспособленность",
