                        "cross_references": [
                            {
                                "target_word": "microfractography",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9b158c9c-34a4-30d8-847d-da24e5f8fcc7",
                                        "entry_id": "a96ab7fb-9a26-3186-be7a-b7929cfaaf5f",
                                        "glosses": [
                                            "Fractography using microscope."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bdb1bd53-0331-45ee-b99c-7f06dce4edab",
                                                "sense_id": "9b158c9c-34a4-30d8-847d-da24e5f8fcc7",
                                                "text": "Microfractography, the study of fracture interfaces by metallographic examination, has become a valuable technique through its use with the electron microscope."
                                            },
                                            {
                                                "example_id": "674ed7a1-ad1f-4394-a20b-aa65a0a628fe",
                                                "sense_id": "9b158c9c-34a4-30d8-847d-da24e5f8fcc7",
                                                "text": "A new microscope with a zoom lens system seems to be a step forward for the application of the metallurgical microscope to microfractography."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09d0ca7a-880b-3dad-92d4-597772426f05",
                                        "entry_id": "a96ab7fb-9a26-3186-be7a-b7929cfaaf5f",
                                        "glosses": [
                                            "An examination of surface fractures using a microscope."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fac34670-9b0d-4dd4-b27c-fb3a4ded83fa",
                                                "sense_id": "09d0ca7a-880b-3dad-92d4-597772426f05",
                                                "text": "Microfractography - the examination of a fracture surface under high and ultra-high magnification by means of an optical or an electron-microscope - makes it possible to study the mechanism of crack propagation under fatigue stresses in relation to external and internal parameters which are otherwise difficult or impossible to observe. Microfractography appears to be particularly suitable for the study of cumulative damage and for the determination of the cause of service failures."
                                            },
                                            {
                                                "example_id": "f6e112a7-cdd0-4990-9b77-81f2f8ca82b9",
                                                "sense_id": "09d0ca7a-880b-3dad-92d4-597772426f05",
                                                "text": "The influence of temperature has been studied by scanning electron microfractographies for specimens with R = 0,1 and increasing temperatures ;"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
