                ],
                "senses": [
                    {
                        "sense_id": "d1bfc47b-5ef2-34da-b764-baa50b9749cf",
                        "entry_id": "788267b4-cd0c-3700-a839-ba2139827a28",
                        "glosses": [
                            "Autre nom du bibacier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a2a20ad-9484-4760-9f20-42e006c93140",
                                "sense_id": "d1bfc47b-5ef2-34da-b764-baa50b9749cf",
                                "text": "Le loquat (Eriobotrya japonica Lindl.) aussi appelé bibassier ou néflier du Japon est un petit arbre originaire de Chine du Sud."
                            }
                        ]
                    },
                    {
                        "sense_id": "a7a1b568-c785-3ff2-b75a-88f1e1d773f3",
                        "entry_id": "788267b4-cd0c-3700-a839-ba2139827a28",
                        "glosses": [
                            "Fruit de cet arbre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c2df739-b089-4a45-9040-e9426a05b00c",
                                "sense_id": "a7a1b568-c785-3ff2-b75a-88f1e1d773f3",
                                "text": "Quelqu'un a offert des fruits à Sam et il les partage avec nous. Des kumquats et des loquats — je connais déjà les premiers et les apprécie, mais c'est la première fois que je goûte à un loquat, nèfle du Japon ou bibasse, en français. Absolument délicieux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c796837c-9e27-4d9c-b1c9-7f9fdb6a0c44",
                        "source_entry_id": "788267b4-cd0c-3700-a839-ba2139827a28",
                        "target_lang_word": "loquat",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "loquat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "caea5b5b-4b86-385c-aa90-d115d42892ff",
                                        "entry_id": "39013504-d05b-3588-af35-a7dc3b154db4",
                                        "glosses": [
                                            "Any of species Eriobotrya japonica of trees (Japanese medlar, Chinese plum, Japanese plum)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d692e966-81a1-4d0e-acb9-4ec4eb229c0f",
                                                "sense_id": "caea5b5b-4b86-385c-aa90-d115d42892ff",
                                                "text": "Japan Mespilus, or Loquat."
                                            },
                                            {
                                                "example_id": "c1ebac6c-f1aa-4fcc-b106-6706523eafdb",
                                                "sense_id": "caea5b5b-4b86-385c-aa90-d115d42892ff",
                                                "text": "As far as the eye can see, one observes nothing but loquat orchards growing luxuriantly on the low, rich land, where the roots never suffer from lack of water."
                                            },
                                            {
                                                "example_id": "fc03a394-1561-4e6e-ab21-8507a21c00de",
                                                "sense_id": "caea5b5b-4b86-385c-aa90-d115d42892ff",
                                                "text": "I climbed up into the loquat (Eriobotrya japonica) tree in our backyard to think."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d7b128d-4a62-3745-abd8-fb8908120154",
                                        "entry_id": "39013504-d05b-3588-af35-a7dc3b154db4",
                                        "glosses": [
                                            "The fruit of this tree. It is as large as a small plum, but grows in clusters, and contains four or five large seeds."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
