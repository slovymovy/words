                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9cdd6bf1-05be-4e5e-b4c7-46ade8a6b6b7",
                                "sense_id": "3aff313b-0446-3e91-8068-054547a71ad2",
                                "text": "\"What do you want?\" she said distantly."
                            },
                            {
                                "example_id": "53b81022-d319-4c34-a7d5-ebeb933c6a3c",
                                "sense_id": "3aff313b-0446-3e91-8068-054547a71ad2",
                                "text": "\"Don't go,\" he implored. \"I must,\" said Millie distantly."
                            }
                        ]
