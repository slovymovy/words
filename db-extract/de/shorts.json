                                                "sense_id": "cbc04bc9-90fe-3e37-adf9-11282fb6baf3",
                                                "text": "Jessica hated covering her legs, so she usually wore shorts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47eca8d6-62a0-3b0d-a871-81f7ec72a5d0",
