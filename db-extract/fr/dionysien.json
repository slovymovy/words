                "senses": [
                    {
                        "sense_id": "c0905913-eb7e-38c8-ac0b-bae01492ba9b",
                        "entry_id": "b73c506d-6791-33f4-aed6-bef73d180419",
                        "glosses": [
                            "Relatif à saint Denis."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "458af266-7cfe-488e-b541-d7f15ba8dac8",
                                "sense_id": "c0905913-eb7e-38c8-ac0b-bae01492ba9b",
                                "text": "Auparavant, au stade dionysien, quelque 80 000 spectateurs avaient salué avec chaleur et émotion les athlètes qui, pendant les onze jours qu’ont duré les Jeux paralympiques, ont fait vibrer et tenu en haleine le public."
                            },
                            {
                                "example_id": "43264398-88af-4285-af0f-a3d97e207560",
                                "sense_id": "c0905913-eb7e-38c8-ac0b-bae01492ba9b",
                                "text": "[…] et ce rappel d’une observation anatomique confirme à point nommé que c’est un texte dionysien qui a fourni le germe à l’éclosion de la légende céphalophorique."
                            }
                        ]
                    },
