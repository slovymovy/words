                        "cross_references": [
                            {
                                "target_word": "cafetière italienne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "492cc126-7218-3845-b511-18ea93fa28e2",
                                        "entry_id": "cfad2c1a-e14c-3f8f-b6a1-2db7317a20a8",
                                        "glosses": [
                                            "Ustensile de cuisine de forme verticale caractéristique, destiné à préparer le café par percolation sous pression au moyen d'une source de chaleur externe, composée d'une chambre inférieure remplie d'eau, d'une chambre intermédiaire où l'on met les grains de café moulus puis d’une chambre supérieure où est recueilli le café prêt à boire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1af7ccb-daff-4f06-829e-df9601d7b3b6",
                                                "sense_id": "492cc126-7218-3845-b511-18ea93fa28e2",
                                                "text": "Il se fait un café, ça il sait, c'est même son territoire exclusif, avec une cafetière italienne en aluminium qui siffle quand c'est prêt."
                                            },
                                            {
                                                "example_id": "9be6d3b7-0cae-4438-9145-b9e3c8fe8ce2",
                                                "sense_id": "492cc126-7218-3845-b511-18ea93fa28e2",
                                                "text": "J'a dévissé la cafetière italienne et jeté le marc, puis l'ai remplie d'eau et de café moulu. J'ai allumé le brûleur à gaz."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a5c7fdbf-8c57-478b-bb9b-a605e7672ec5",
                        "source_entry_id": "6e246d52-69f2-36ca-b573-e7a37c6752a0",
                        "source_sense_id": "3ba0325d-7ae4-3d94-9056-3423dcb8d213",
