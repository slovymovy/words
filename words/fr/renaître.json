                                "target_lang_word": "возрождаться",
                                "target_lang_sense_clarification": "об идеях и традициях"
                            },
                            {
                                "target_lang_word": "оживать",
                                "target_lang_sense_clarification": "о чувствах и воспоминаниях"
                            },
                            {
                                "target_lang_word": "разгораться",
                                "target_lang_sense_clarification": "о чувствах и надежде"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "wiederaufleben",
                                "target_lang_sense_clarification": "Hoffnung, Ideen, Traditionen"
                            },
                            {
                                "target_lang_word": "aufleben",
                                "target_lang_sense_clarification": "Gefühle, Erinnerungen, Interesse"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "resurgir",
                                "target_lang_sense_clarification": "ideas, movimientos o tradiciones"
                            },
                            {
                                "target_lang_word": "reavivarse",
                                "target_lang_sense_clarification": "sentimientos, recuerdos o pasiones"
                            },
                            {
                                "target_lang_word": "revivir",
                                "target_lang_sense_clarification": "esperanza, ilusión o interés"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "重燃",
                                "target_lang_sense_clarification": "希望、感情或火焰"
                            },
                            {
                                "target_lang_word": "复苏",
                                "target_lang_sense_clarification": "感情或经济重新恢复"
