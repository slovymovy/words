                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ennui",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce collègue commence vraiment à nous <w>raser</w> avec ses histoires interminables sur ses vacances."
