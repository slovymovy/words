            "senses": [
                {
                    "sense_id": "33fbf6da-66b7-353f-8159-a3e0308513a9",
                    "sense_definition": "anregende Wirkung oder Denkanstoß, der eine Entwicklung oder Handlung in Gang setzt",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "anregung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Konferenz soll neue <w>Impulse</w> für den internationalen Klimaschutz liefern."
                        },
                        {
                            "text": "Sein engagierter Vortrag gab den Mitarbeitern wichtige <w>Impulse</w> für die zukünftige Projektarbeit."
                        }
                    ],
                    "synonyms": [
                        "Anstoß",
                        "Anregung",
                        "Antrieb"
                    ],
                    "common_phrases": [
