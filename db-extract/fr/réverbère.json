        "fr-extract.jsonl": [
            {
                "entry_id": "e965d8ba-0fd7-3c9b-a822-04eb617795dc",
                "word": "réverbère",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "78c7e3c1-e30a-4eb0-8f58-c304d3d4d867",
                        "entry_id": "e965d8ba-0fd7-3c9b-a822-04eb617795dc",
                        "tags": [
                            "plural"
                        ],
                        "form": "réverbères"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8c9db01e-42f7-3e15-978b-7e2371ece265",
                        "entry_id": "e965d8ba-0fd7-3c9b-a822-04eb617795dc",
                        "glosses": [
                            "Dispositif pour réfléchir la lumière ou la chaleur."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "1e3cdda8-de7a-4901-b1de-b5068cf7bbb9",
                                "sense_id": "8c9db01e-42f7-3e15-978b-7e2371ece265",
                                "text": "Fourneau à réverbère, Four à réverbère."
                            }
                        ]
                    },
                    {
                        "sense_id": "558a6eae-1879-359f-ae0a-3563e421628c",
                        "entry_id": "e965d8ba-0fd7-3c9b-a822-04eb617795dc",
                        "glosses": [
                            "Lanterne contenant une lampe munie d’un ou de plusieurs réflecteurs et servant à l’éclairage des voies publiques."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "5256f2b4-41aa-4db6-869b-60d5c6a4f2a9",
                                "sense_id": "558a6eae-1879-359f-ae0a-3563e421628c",
                                "text": "Voici qui, à la clarté sombre des réverbères tourmentés par le vent de la nuit, remonte une des rues tortueuses et peuplées de petits ménages de montagne Sainte-Geneviève."
                            },
                            {
                                "example_id": "32f8f4ed-c707-4d06-8638-b2d962d1c1eb",
                                "sense_id": "558a6eae-1879-359f-ae0a-3563e421628c",
                                "text": "Il resta pensif, debout et dans une attitude d'hésitation, faiblement éclairé par un réverbère dont la lueur indécise perçait à peine le brouillard."
                            },
                            {
                                "example_id": "eae8431b-d2cf-4745-b944-ceacf7327772",
                                "sense_id": "558a6eae-1879-359f-ae0a-3563e421628c",
                                "text": "L’un de ces honnêtes citadins, devant qui j’exaltais les agréments de Grenade, me répondit : « C’est la ville la mieux éclairée d’Andalousie. Remarquez quelle quantité de réverbères ; mais quel dommage qu’ils ne soient pas alimentés par le gaz ! »"
                            },
                            {
                                "example_id": "e49ba403-19a3-4b02-aa6f-9c7916f92716",
                                "sense_id": "558a6eae-1879-359f-ae0a-3563e421628c",
                                "text": "Nous nous trouvâmes bientôt au pied du Sacré-Cœur et de roides escaliers que de vagues réverbères éclairent parcimonieusement."
                            },
                            {
                                "example_id": "043108d3-c77d-4e1d-ac20-1300b1755f06",
                                "sense_id": "558a6eae-1879-359f-ae0a-3563e421628c",
                                "text": "Ces réverbères étaient des lanternes de fer encore éclairées à l’huile et suspendues par des câbles quatre ou cinq mètres au-dessus du milieu de la rue. Elles projetaient beaucoup plus l’ombre de leur armature que la lumière."
                            },
                            {
                                "example_id": "95b7bb4a-f8d5-4406-9259-e0a17f3c1956",
                                "sense_id": "558a6eae-1879-359f-ae0a-3563e421628c",
                                "text": "Cet événement est d’autant plus rare que cette maman tortue est venue pondre, la nuit, sur une plage « assez hostile », ultrafréquentée la journée, cernée par les réverbères et les enseignes lumineuses."
                            }
                        ]
                    },
                    {
                        "sense_id": "9e6da478-66f1-3a55-8f37-b1f2c8372c9b",
                        "entry_id": "e965d8ba-0fd7-3c9b-a822-04eb617795dc",
                        "glosses": [
                            "Chasse au réverbère : Chasse aux canards pratiquée la nuit avec une lumière attachée au bout d'une perche à l'avant de l’embarcation des chasseurs."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6ccd1197-d7ef-43ae-a196-ff0c32bf783a",
                        "source_entry_id": "e965d8ba-0fd7-3c9b-a822-04eb617795dc",
                        "source_sense_id": "558a6eae-1879-359f-ae0a-3563e421628c",
                        "source_sense_description": "Lanterne contenant une lampe munie d’un ou de plusieurs réflecteurs",
                        "target_lang_word": "Straßenlampe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Straßenlampe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4bb734b7-cd9b-360f-bb45-1728ba258fca",
                                        "entry_id": "1a72f0ee-d399-3095-843d-4cb715c2c23b",
                                        "glosses": [
                                            "an einem Mast oder an einer Hauswand angebrachte Lampe zur Beleuchtung von Straßen oder Plätzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1cd1a853-c9d7-4246-b91c-888c6cb0694b",
                                                "sense_id": "4bb734b7-cd9b-360f-bb45-1728ba258fca",
                                                "text": "„1921 wurde Ottersdorf mit elektrischen Straßenlampen ausgestattet und nach und nach die meisten Häuser an das Stromnetz angeschlossen.“"
                                            },
                                            {
                                                "example_id": "342ed876-8bd4-4131-b35f-ac2e713582d9",
                                                "sense_id": "4bb734b7-cd9b-360f-bb45-1728ba258fca",
                                                "text": "„Hier in der Nacht, wo die Straßenlampe ihrer beider Nacktheit enthüllte, war Sabina zu einer fast unerträglichen Erwartung der Lust angestachelt.“"
                                            },
                                            {
                                                "example_id": "e78d670b-a6ce-45b4-a1a6-851e0543f915",
                                                "sense_id": "4bb734b7-cd9b-360f-bb45-1728ba258fca",
                                                "text": "„Eine doppelte Reihe von Straßenlampen flammte auf.“"
                                            },
                                            {
                                                "example_id": "6100adbf-a755-4943-8b32-67e5ec9a6edd",
                                                "sense_id": "4bb734b7-cd9b-360f-bb45-1728ba258fca",
                                                "text": "„Amsterdam galt bald als strahlendes Vorbild Europas, da Amsterdam auf die von Jan van der Heyden entwickelte ölbefeuerte Straßenlampen gesetzt hatte…“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "36a22a4b-38a7-4bb4-b0da-ed8a27ba72e6",
                        "source_entry_id": "e965d8ba-0fd7-3c9b-a822-04eb617795dc",
                        "source_sense_id": "558a6eae-1879-359f-ae0a-3563e421628c",
                        "source_sense_description": "Lanterne contenant une lampe munie d’un ou de plusieurs réflecteurs",
                        "target_lang_word": "Gaslaterne",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gaslaterne",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9283c6e3-b5f2-35f0-90b6-ddbb0dca6f30",
                                        "entry_id": "3f8fcadb-a8d5-3861-a9b0-a110678d4094",
                                        "glosses": [
                                            "Laterne, die mit Gas betrieben wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd2c734d-feaf-48a3-ab2b-52a6668bd6ee",
                                                "sense_id": "9283c6e3-b5f2-35f0-90b6-ddbb0dca6f30",
                                                "text": "„Die Gaslaternen spiegelten sich in der feuchten Schwärze des Weges, der von den vergilbten Blättern wie ein Mosaikband gemustert war.“"
                                            },
                                            {
                                                "example_id": "bf15d5b4-acbd-4cb5-ac28-0284777ded84",
                                                "sense_id": "9283c6e3-b5f2-35f0-90b6-ddbb0dca6f30",
                                                "text": "„Der Regen hatte aufgehört, die nasse Brücke glänzte, in ihren Mauersteinen spiegelte sich das Licht der Gaslaternen.“"
                                            },
                                            {
                                                "example_id": "f5ca2cc5-a562-4542-8635-e227cdd611f4",
                                                "sense_id": "9283c6e3-b5f2-35f0-90b6-ddbb0dca6f30",
                                                "text": "„Sie schlichen durch den Park, durch enge Gassen, in denen schläfrige Gaslaternen ihr gelbes Licht in die blaue Nacht hineinwarfen.“"
                                            },
                                            {
                                                "example_id": "227ef4b6-3555-436a-ac6b-ad96f9385fe9",
                                                "sense_id": "9283c6e3-b5f2-35f0-90b6-ddbb0dca6f30",
                                                "text": "„Am Ende der Breslauer Straße tauchten im trüben Licht der Gaslaternen junge Kerle mit karierten Schlägermützen und bunten geknoteten Halstüchern auf.“"
                                            },
                                            {
                                                "example_id": "716f96cd-95f9-4463-a01d-bc781d18a781",
                                                "sense_id": "9283c6e3-b5f2-35f0-90b6-ddbb0dca6f30",
                                                "text": "[Hamburg:] „Am 4. Oktober 1845 ist es dann soweit: Die ersten Gaslaternen beleuchten die Johannisstraße am Rathaus mit einem hellen und gleichförmigem Licht.“"
                                            },
                                            {
                                                "example_id": "3a736847-79bb-4856-b30d-da2cc8974e71",
                                                "sense_id": "9283c6e3-b5f2-35f0-90b6-ddbb0dca6f30",
                                                "text": "„Sogenannte \"Lüchtenpüster\" klettern abends auf die Leiter und entzünden jeden einzelne Gaslaterne.“"
                                            },
                                            {
                                                "example_id": "affe1641-e443-47fe-a6bd-9732448b692b",
                                                "sense_id": "9283c6e3-b5f2-35f0-90b6-ddbb0dca6f30",
                                                "text": "„Die letzten Gaslaternen werden 1981 auf Erdgas umgerüstet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc3527e6-cd9d-4c02-8f30-89c4d55447ba",
