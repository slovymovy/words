                "senses": [
                    {
                        "sense_id": "a27d3b2d-802f-3246-9a4d-a76a74bc5ec2",
                        "entry_id": "b941ddc5-38bc-35e4-b460-23fda86f8406",
                        "glosses": [
                            "Fährschiff, das auch Kraftfahrzeuge (Autos) transportieren kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b75cc006-3a64-4dd4-aa80-64c47f51b0d4",
                                "sense_id": "a27d3b2d-802f-3246-9a4d-a76a74bc5ec2",
                                "text": "„Dort legte gerade eine Autofähre an, während mehrere Schubschiffe den Strom auf- und abwärts fuhren.“"
                            },
                            {
                                "example_id": "9e6df862-9beb-4558-a4d1-7c56d142d70c",
                                "sense_id": "a27d3b2d-802f-3246-9a4d-a76a74bc5ec2",
                                "text": "„Die Autofähre Michael, die Ingelheim und Oestrich-Winkel verbindet, kreuzt unsere Fahrtrichtung und der Fluss ist hier so breit und voller Motor- und Segelboote, dass er fast wie ein geschlossenes Gewässer wirkt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4ab83ef4-fd7e-4e89-a4f4-b21e57c309a5",
                        "source_entry_id": "b941ddc5-38bc-35e4-b460-23fda86f8406",
                        "source_sense_id": "a27d3b2d-802f-3246-9a4d-a76a74bc5ec2",
                        "source_sense_description": "Fährschiff, das auch Kraftfahrzeuge (Autos) transportieren kann",
                        "target_lang_word": "car ferry",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "car ferry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "633d65a2-ec73-3801-a6c2-402d92407fa1",
                                        "entry_id": "f16d32cd-10c4-3256-916a-597af750850c",
                                        "glosses": [
                                            "A ferry that transports cars (motor vehicles)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b9da761-0eb7-475f-9e19-626da0349eb2",
                                                "sense_id": "633d65a2-ec73-3801-a6c2-402d92407fa1",
                                                "text": "The harbour is now a terminus of the Hebridean car-ferry service to Stornoway in Lewis, and the fishing grounds of the Minch attract many boats from east-coast ports."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
