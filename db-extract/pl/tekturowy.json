                        "sense_id": "1d9ae419-518e-381d-8351-736f43a2c5b7",
                        "entry_id": "6fd62d9a-60b9-36b1-ad64-e8ed854a2fa3",
                        "glosses": [
                            "zrobiony z tektury"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60230a4b-77c9-4093-bd58-c8bcf9fc9009",
                                "sense_id": "1d9ae419-518e-381d-8351-736f43a2c5b7",
                                "text": "Stare zabawki włożyłem do tekturowego pudełka i wyniosłem na strych."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "46e81945-6b7f-471c-a9ec-3ec05be679fb",
                        "source_entry_id": "6fd62d9a-60b9-36b1-ad64-e8ed854a2fa3",
                        "source_sense_id": "1d9ae419-518e-381d-8351-736f43a2c5b7",
                        "target_lang_word": "cardboard",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cardboard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f0922a0b-fc9b-3ae8-8ca7-3d0562179fb1",
                                        "entry_id": "4a573e17-b990-30af-bc70-5fb2130d18c0",
                                        "glosses": [
                                            "A wood-based material resembling heavy paper, used in the manufacture of boxes, cartons and signs."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a4c5bcc3-c41a-359a-9c10-71f7dcfc8944",
                                        "entry_id": "4a573e17-b990-30af-bc70-5fb2130d18c0",
                                        "glosses": [
                                            "Something flat or insubstantial."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e9e6d49-38d4-45b1-9ddc-6978ce20c115",
                                                "sense_id": "a4c5bcc3-c41a-359a-9c10-71f7dcfc8944",
                                                "text": "In my experience, one of the most vital times in the life of a piece of fiction is when a character begins to speak, timidly and softly, in one's head. Honest and true books get written when the author feels free to coax and invite that character in. If the author's response to that small voice is instead to submit it to a test: \"Are you: black/white/gay/straight/male/female/Christian/Jewish/old/young/politically correct\" the character will probably turn around and leave or else turn into cardboard."
                                            },
                                            {
                                                "example_id": "1c22d091-39d1-4218-a2d5-83bf206abed3",
                                                "sense_id": "a4c5bcc3-c41a-359a-9c10-71f7dcfc8944",
                                                "text": "According to these keyboard warriors, the young men and women who survived the shooting are part of a big hoax, are liars, are mere cardboard cutouts – “crisis actors” who roam the country looking for mass shootings from which to promote their anti-gun message – all being pushed forward by the giant liberal machine that is Hillary Clinton’s robot attack army."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cardboard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e22ba75f-398c-3caa-8224-431b7d4312fb",
                                        "entry_id": "3b369928-c2c7-3711-9620-92b1441358b5",
                                        "glosses": [
                                            "Made of or resembling cardboard; (figurative) flat or flavorless."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d020749-4354-43ff-b262-906042b090fc",
                                                "sense_id": "e22ba75f-398c-3caa-8224-431b7d4312fb",
                                                "text": "The worst of the thing, however, is that the enormity, such as it is, happens to be of a very cardboard and tinsel character."
                                            },
                                            {
                                                "example_id": "a7e330bc-91a7-440a-8513-23f0c7efc7e0",
                                                "sense_id": "e22ba75f-398c-3caa-8224-431b7d4312fb",
                                                "text": "The thing really looked quite cardboard."
                                            },
                                            {
                                                "example_id": "59a3db31-4678-43ce-b5fe-90e07c85fee4",
                                                "sense_id": "e22ba75f-398c-3caa-8224-431b7d4312fb",
                                                "text": "While Lensky’s character is quite cardboard, Onegin’s manipulations and lack of ability to call off the duel because he fears society’s jibes, Lensky’s youth and naivety, and Tatiana’s reaction to the duel lend the event its gravity."
                                            },
                                            {
                                                "example_id": "427580ab-04a2-49d5-9e5f-14dc4ccf5753",
                                                "sense_id": "e22ba75f-398c-3caa-8224-431b7d4312fb",
                                                "text": "MUMMER 3 pulls out an inflated cushion with a very cardboard crown on it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9a01de52-163c-4649-ab69-d1cde54d0a8d",
                        "source_entry_id": "6fd62d9a-60b9-36b1-ad64-e8ed854a2fa3",
                        "source_sense_id": "1d9ae419-518e-381d-8351-736f43a2c5b7",
                        "target_lang_word": "картонный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "картонный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "43fb35fb-3f2d-3ff1-92a8-9a48bfa947b8",
                                        "entry_id": "c634cec9-2cd3-36df-964a-11f38e91424e",
                                        "glosses": [
                                            "связанный, соотносящийся по значению с существительным картон"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad88f91f-9d64-4c3f-81a1-4036031e1148",
                                                "sense_id": "43fb35fb-3f2d-3ff1-92a8-9a48bfa947b8",
                                                "text": "Ни с того ни с сего возникли пожары на бумажном и картонном заводах."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "012e5ccf-8a68-3755-9f03-8d0e2ae55883",
                                        "entry_id": "c634cec9-2cd3-36df-964a-11f38e91424e",
                                        "glosses": [
                                            "свойственный картону, характерный для него"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aaea08cb-dea3-499b-a240-63203cba97f6",
                                                "sense_id": "012e5ccf-8a68-3755-9f03-8d0e2ae55883",
                                                "text": "Вместе они вытащили на лужайку стол и стулья, в чемодане Захара нашлась пачка чесночных крекеров картонного авиационного вкуса…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1c50bdd-bb31-3a2a-8425-a60ae8517b3c",
                                        "entry_id": "c634cec9-2cd3-36df-964a-11f38e91424e",
                                        "glosses": [
                                            "сделанный из картона"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b161a99-d67f-489f-8da6-1150d405e613",
                                                "sense_id": "b1c50bdd-bb31-3a2a-8425-a60ae8517b3c",
                                                "text": "Рот его, лишенный губ, походил на отверстие, прорезанное перочинным ножичком в картонной маске, щеки его, впалые и смугловатые, местами были испещрены мелкими ямочками, следами разрушительной оспы."
                                            },
                                            {
                                                "example_id": "374ce339-a973-4608-adbc-03d2af336a4a",
                                                "sense_id": "b1c50bdd-bb31-3a2a-8425-a60ae8517b3c",
                                                "text": "Сбежав подгору, Ваня стал на колени и наклонился к воде, чтобы спустить кораблик, склеенный искусно из картонной бумаги, ― свою новую игрушку, которую он показывал мне в восторге накануне…"
                                            },
                                            {
                                                "example_id": "87ae58ea-16fb-4ae6-b6d3-cda58dae648f",
                                                "sense_id": "b1c50bdd-bb31-3a2a-8425-a60ae8517b3c",
                                                "text": "Шуршат по асфальту бумаги, обрывки картонных упаковок."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb194fc5-f82f-32cc-a45e-f42bd2de1a4e",
                                        "entry_id": "c634cec9-2cd3-36df-964a-11f38e91424e",
                                        "glosses": [
                                            "перен. неестественный, выглядящий как подделка"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02f38d16-4bfe-4580-82a4-48fbd5eda6eb",
                                                "sense_id": "cb194fc5-f82f-32cc-a45e-f42bd2de1a4e",
                                                "text": "Зато как слаба эта завязка у самых лучших комиков! как ничтожны эти театральные любовники с их картонной любовью!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
