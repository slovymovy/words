                    "frequency": "High",
                    "semantic_group_id": "desire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мне очень <w>хочется</w> поехать в отпуск на море этим летом."
                        },
                        {
                            "text": "Когда долго гуляешь на свежем воздухе, всегда <w>хочется</w> есть."
                        }
                    ],
                    "synonyms": [
