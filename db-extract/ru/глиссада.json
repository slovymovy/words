                ],
                "senses": [
                    {
                        "sense_id": "7381b286-12f7-3e24-bad3-5729dc8a3aa0",
                        "entry_id": "6721d683-50a0-3778-b4ff-69b2138e0df0",
                        "glosses": [
                            "авиац. оптимальная траектория летательного аппарата при снижении и посадке"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09887c9c-1fb0-42e2-8a05-9e1835bf8678",
                                "sense_id": "7381b286-12f7-3e24-bad3-5729dc8a3aa0",
                                "text": "Самолёт может оснащаться двигателями российского и зарубежного производства, эксплуатироваться на коротких взлётно-посадочных полосах в различных климатических условиях, на грунтовых аэродромах, производить посадки по крутой глиссаде на небольшие горные аэродромы и площадки."
                            }
                        ]
                    },
                    {
                        "sense_id": "5de3f3a2-862e-3080-ad34-3c11e9829b65",
                        "entry_id": "6721d683-50a0-3778-b4ff-69b2138e0df0",
                        "glosses": [
                            "авиац. прямолинейная траектория движения летательного аппарата под углом к горизонтальной плоскости"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dfee9808-05bf-47c4-b1a2-87526e00aaa7",
                        "source_entry_id": "6721d683-50a0-3778-b4ff-69b2138e0df0",
                        "target_lang_word": "glide path",
