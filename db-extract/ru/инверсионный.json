                        "source_sense_id": "25ca9bb8-289b-3ea9-b98a-8a870e246d5c",
                        "target_lang_word": "inversion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inversion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d2350b3c-17c5-3471-b051-ba5485b6cdf3",
                                        "entry_id": "fef5d2c0-4319-31cc-b30e-95cf12c602c0",
                                        "glosses": [
                                            "The action of inverting."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9878f2bf-21d9-3d83-b4c6-2a08b36a4825",
                                        "entry_id": "fef5d2c0-4319-31cc-b30e-95cf12c602c0",
                                        "glosses": [
                                            "The act of being in an inverted state; being upside down, inside out, or in a reverse sequence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1559f1c5-4b52-357b-acdb-72945aaff8e8",
                                        "entry_id": "fef5d2c0-4319-31cc-b30e-95cf12c602c0",
                                        "glosses": [
                                            "The reversal of an interval; the move of one pitch in an interval up or down an octave."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9c9dd687-1ed2-32ff-a206-095d6d026679",
                                        "entry_id": "fef5d2c0-4319-31cc-b30e-95cf12c602c0",
                                        "glosses": [
                                            "The position of a chord which has a note other than the root as its bass note."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a5bc8072-57b4-3c71-b214-cf69fb8af5b2",
                                        "entry_id": "fef5d2c0-4319-31cc-b30e-95cf12c602c0",
                                        "glosses": [
                                            "The flipping of a melody or contrapuntal line so that high notes become low and vice versa; the reversal of a pitch contour."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a977aede-3d4d-32eb-bec3-29cdecfcee6d",
                                        "entry_id": "fef5d2c0-4319-31cc-b30e-95cf12c602c0",
                                        "glosses": [
                                            "A segment of DNA in the context of a chromosome that is reversed in orientation relative to a reference karyotype or genome."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "deb14fe7-65dc-3ca6-b64b-2a6abac95a3f",
                                        "entry_id": "fef5d2c0-4319-31cc-b30e-95cf12c602c0",
                                        "glosses": [
                                            "A situation where air temperature increases with altitude (the ground being colder than the surrounding air)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ad6176c8-d007-3b65-8614-2e13ca9efef7",
                                        "entry_id": "fef5d2c0-4319-31cc-b30e-95cf12c602c0",
                                        "glosses": [
                                            "A section of a roller coaster where passengers are temporarily turned upside down."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d5b57dfc-8a58-3881-9952-6829cf85ada4",
                                        "entry_id": "fef5d2c0-4319-31cc-b30e-95cf12c602c0",
                                        "glosses": [
                                            "Deviation from standard word order, as for example by putting the predicate before the subject. It takes place in questions with auxiliary verbs; in normal, affirmative clauses beginning with a negative particle, for the purpose of emphasis; and in other rhetorical devices or unusual situations."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4130c516-b529-4170-9682-bb83dfcad2a2",
                                                "sense_id": "d5b57dfc-8a58-3881-9952-6829cf85ada4",
                                                "text": "Inversion takes place in the sentence 'Is she here?' — 'is', the predicate, is before 'she', the subject."
                                            },
                                            {
                                                "example_id": "be60d735-85db-4f09-bff6-128231dadf78",
                                                "sense_id": "d5b57dfc-8a58-3881-9952-6829cf85ada4",
                                                "text": "Inversion takes place in the sentence 'Never have I done that.' — 'have', the predicate, is before 'I', the subject, due to 'never' being the first word of the sentence."
                                            },
                                            {
                                                "example_id": "f5ca4f85-840b-41df-9d12-8b10a362678c",
                                                "sense_id": "d5b57dfc-8a58-3881-9952-6829cf85ada4",
                                                "text": "Question formation involves the phenomenon commonly known as subject-auxiliary inversion, a change in word order in which the auxiliary moves in front of the subject.\n(a) Here we shall describe this phenomenon in terms of movement of the element under INFL into COMP position.\n(b) According to this analysis, what looks like an exchanging of positions between the subject and auxiliary (or INFL element, in GB terms) is actually the movement of the INFL element past the subject position into COMP.\n(c) INFL-to-COMP movement seems to be triggered by the presence of the [+WH] feature in COMP."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "adb8b6b0-72c8-3c20-8c49-5722c63ec970",
                                        "entry_id": "fef5d2c0-4319-31cc-b30e-95cf12c602c0",
                                        "glosses": [
                                            "An operation on a group, analogous to negation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2567a79c-ef5d-3554-b1c2-2a272b05d984",
                                        "entry_id": "fef5d2c0-4319-31cc-b30e-95cf12c602c0",
                                        "glosses": [
                                            "Homosexuality, particularly in early psychoanalysis."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "825f39ab-8944-46fd-a26a-f4c209092fc6",
                                                "sense_id": "2567a79c-ef5d-3554-b1c2-2a272b05d984",
                                                "text": "We can seldom, therefore, congratulate ourselves on the success of any \"cure\" of inversion."
                                            },
                                            {
                                                "example_id": "72e5fda0-be0f-4c76-901f-0047048a5f9c",
                                                "sense_id": "2567a79c-ef5d-3554-b1c2-2a272b05d984",
                                                "text": "My father, León Fuertes, was a fag three years; […] He put on all the trappings of inversion: the twittered mouthings, the hyper-feminine moues, the languid mincings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9508ce3c-ec7b-303e-9ac7-b8f82cb4d030",
                                        "entry_id": "fef5d2c0-4319-31cc-b30e-95cf12c602c0",
                                        "glosses": [
                                            "The catalytic action of invertase."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
