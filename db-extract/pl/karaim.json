                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "караим",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "afc385a5-a030-3c17-94f2-bbba95f1f0a1",
                                        "entry_id": "11a90a4f-855e-311e-a98f-443e5776bf83",
                                        "glosses": [
                                            "представитель народа тюркской этноязыковой группы, традиционно исповедовавшего караизм — религию, родственную иудаизму"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f90552b-a0ee-47e9-b730-4208395f6f6a",
                                                "sense_id": "afc385a5-a030-3c17-94f2-bbba95f1f0a1",
                                                "text": "Но ведь Адам был еврей? Это спорный вопрос, ваше величество. У меня есть сведения, что он был караим"
                                            },
                                            {
                                                "example_id": "705d2291-ee52-4753-ae95-210ba0b172ff",
                                                "sense_id": "afc385a5-a030-3c17-94f2-bbba95f1f0a1",
                                                "text": "Надо, мама, смотреть на вещи глубже. Караим — это почти турок, турок — почти перс, перс — почти грек, грек — почти одессит, а одессит — это москвич!"
                                            },
                                            {
                                                "example_id": "8ff01abc-aeed-4ef9-8819-7dadcb20d0a8",
                                                "sense_id": "afc385a5-a030-3c17-94f2-bbba95f1f0a1",
                                                "text": "Местный караим-купец, приятель Синани, пригласил Чехова на обед с шашлыками и с классическими, как он говорил, чебуреками."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
