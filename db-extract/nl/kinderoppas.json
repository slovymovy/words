                "senses": [
                    {
                        "sense_id": "7b4c9be5-35f2-3158-97cf-d041825f6370",
                        "entry_id": "19d7105d-76e3-349e-b877-6f937567fc18",
                        "glosses": [
                            "een persoon die op andermans kinderen past"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "acc2563d-5da0-4bb8-b0ac-1ca46054c7fe",
                                "sense_id": "7b4c9be5-35f2-3158-97cf-d041825f6370",
                                "text": "Bakker heeft het misbruik altijd ontkend. Hij zegt geen seksuele relatie met zijn kinderoppas te hebben gehad voordat zij achttien was."
                            },
                            {
                                "example_id": "1b62d29e-9024-4233-8061-579d3bcc6814",
                                "sense_id": "7b4c9be5-35f2-3158-97cf-d041825f6370",
                                "text": "Het probleem was dat mama bijna de hele zomer op haar werk als maître d'hôtel moest zijn. Ze kwam maar om het weekend naar ons toe en af en toe een paar losse dagen. Dat hield in dat ik de hele tijd kinderoppas van Acke moest spelen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "09c589cd-894c-480d-aaf5-cd4d199ec272",
                        "source_entry_id": "19d7105d-76e3-349e-b877-6f937567fc18",
                        "source_sense_id": "7b4c9be5-35f2-3158-97cf-d041825f6370",
                        "target_lang_word": "babysitter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "babysitter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "782c8fb3-0945-3215-9233-426d8c1cc6fc",
                                        "entry_id": "4c53f76b-2386-3288-ab95-0d0c55919386",
                                        "glosses": [
                                            "A person who cares for one or more babies or children for a short period of time in place of their legal guardians."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bee6c99e-fc87-4c01-b547-74b51e3f05f8",
                                                "sense_id": "782c8fb3-0945-3215-9233-426d8c1cc6fc",
                                                "text": "My neighbor is sometimes a babysitter for other mothers’ children."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dfbcde27-3290-31ee-b29e-37a9133516f6",
                                        "entry_id": "4c53f76b-2386-3288-ab95-0d0c55919386",
                                        "glosses": [
                                            "A person who has to watch or attend to anything or anyone unnecessarily closely; a coddler or handholder."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0881a27-1ef9-4e03-bc67-27f5f07c1938",
                                                "sense_id": "dfbcde27-3290-31ee-b29e-37a9133516f6",
                                                "text": "He said he did not want to be on tenterhooks worrying about us and having to act as a babysitter for grown men."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1eed5ea6-78d9-4273-967d-54377afc1492",
                        "source_entry_id": "19d7105d-76e3-349e-b877-6f937567fc18",
                        "source_sense_id": "7b4c9be5-35f2-3158-97cf-d041825f6370",
                        "target_lang_word": "baby-sitter",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "baby-sitter",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "01576219-e3d4-383c-b1a0-079673e7f724",
                                        "entry_id": "8a6200c8-53e2-314c-89ce-f6807fbb3d84",
                                        "glosses": [
                                            "Personne payée par les parents pour garder les enfants en leur absence pour une courte durée (en général quelques heures)."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "969cf827-e580-404f-813a-c66552c473f1",
                                                "sense_id": "01576219-e3d4-383c-b1a0-079673e7f724",
                                                "text": "— Vous avez des enfants ? Pas nous, mais c’est pour bientôt… Si nous avons des enfants en même temps, nous pourrons partager les frais de baby-sitter, parce que le baby-sitting, ça coûte les yeux de la tête."
                                            },
                                            {
                                                "example_id": "84d5db26-168b-4e5c-8dba-f1859af87832",
                                                "sense_id": "01576219-e3d4-383c-b1a0-079673e7f724",
                                                "text": "C’est Lulu, la baby-sitter, qui les accompagne."
                                            },
                                            {
                                                "example_id": "40ba378f-4f94-4b17-b64c-b12faa31e86a",
                                                "sense_id": "01576219-e3d4-383c-b1a0-079673e7f724",
                                                "text": "Les Harper me demandent de faire le baby-sitter de leur fille."
                                            },
                                            {
                                                "example_id": "0a65009f-b990-4f9c-9a5f-4bce95ad8654",
                                                "sense_id": "01576219-e3d4-383c-b1a0-079673e7f724",
                                                "text": "Il rentrait tard et ne cherchait même pas à coucher avec la baby-sitter, ce que la plupart des hommes essayaient de faire pourtant."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "baby-sitter",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "159d94be-750e-34c0-a1b5-b7c411ba51bc",
                                        "entry_id": "3c603fcb-b873-39b8-b159-c1a29bcdeaaa",
                                        "glosses": [
                                            "Garder des enfants pour une courte durée en l’absence des parents."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1a3098c-50cf-4c60-a0c1-f6ce8a02ed88",
                                                "sense_id": "159d94be-750e-34c0-a1b5-b7c411ba51bc",
                                                "text": "J’ai à plusieurs reprises proposé de garder Alice, ou de la sortir (ce n’est arrivé que deux fois en sept ans), ou que Louna la « baby-sitte », pour gagner un peu d’argent de poche, voire gratos, histoire qu’elles passent un peu de temps ensemble."
                                            },
                                            {
                                                "example_id": "02d7fb4a-b9e3-4e95-9a23-c60cd15d4a36",
                                                "sense_id": "159d94be-750e-34c0-a1b5-b7c411ba51bc",
                                                "text": "Les informations récoltées au camping laissent penser que la jeune Hartmann ne baby-sittait pas que les enfants. Les hommes aussi."
                                            },
                                            {
                                                "example_id": "87db07ba-d111-46f7-ad78-e33da50823bc",
                                                "sense_id": "159d94be-750e-34c0-a1b5-b7c411ba51bc",
                                                "text": "C’est tout ce qu’elle obtiendra, je ne vais pas baby-sitter cette fille plus longtemps."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1aba4b6d-e945-45e4-a5dc-3f610929dd7c",
                        "source_entry_id": "19d7105d-76e3-349e-b877-6f937567fc18",
                        "source_sense_id": "7b4c9be5-35f2-3158-97cf-d041825f6370",
                        "target_lang_word": "canguro",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "canguro",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "493eb1b6-5b57-3165-8458-d0bc483f5031",
                                        "entry_id": "097d08bb-31f1-3b16-b828-59aa604df30d",
                                        "glosses": [
                                            "(Macropus spp.) Cualquiera de cuatro especies de mamíferos marsupiales nativos de Australia, de cuerpo erecto, patas traseras musculosas dotadas de grandes pies adaptados para saltar, cola larga y fuerte, vientre con marsupio, manos pequeñas y cabeza alargada con grandes orejas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d8d7f4b-e778-4952-a24a-320e44ae75aa",
                                                "sense_id": "493eb1b6-5b57-3165-8458-d0bc483f5031",
                                                "text": "El canguro, que lleva sus hijuelos en la bolsa que tiene bajo el abdomen, acostumbra mantenerse derecho, apoyado sobre los miembros posteriores y la cola y á marchar á saltos, sin perder esa posición, para no maltratar á sus crías y tal vez de esto depende el desarrollo exagerado de sus patas de atrás con relación á las de delante, y de ahí también la dilatación de su cola, que le sirve para completar la base de sustentación y para ejecutar sobre seguro sus principales movimientos."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b2465e89-2e1a-31c6-b332-992bdf26a270",
                                        "entry_id": "097d08bb-31f1-3b16-b828-59aa604df30d",
                                        "glosses": [
                                            "Por analogía con el marsupio del canguro₁, prenda de abrigo para el torso con un bolsillo ocupando el abdomen."
                                        ],
                                        "tags": [
                                            "Vestimenta"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4030a6a-a6db-4820-a679-de4feaac1c12",
                                                "sense_id": "b2465e89-2e1a-31c6-b332-992bdf26a270",
                                                "text": "El anorac más corriente y útil es el llamado ‘canguro’ o ‘buzo’, provisto de capucha, cerrada por delante, amplio y con un único bolsillo central en el pecho (por eso se le llama canguro)."
                                            },
                                            {
                                                "example_id": "1602c8f4-0d47-46dc-bb3a-404713ae2420",
                                                "sense_id": "b2465e89-2e1a-31c6-b332-992bdf26a270",
                                                "text": "Es imprescindible un anorak, un canguro o una prenda que proteja del sol."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f53e9ba8-6250-3590-a6d2-71f2aa5eaaa6",
                                        "entry_id": "097d08bb-31f1-3b16-b828-59aa604df30d",
                                        "glosses": [
                                            "Por analogía, arnés para transportar un bebé junto al abdomen."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "7d38e169-e714-3b24-9f0b-bb3b20c41ecf",
                                        "entry_id": "097d08bb-31f1-3b16-b828-59aa604df30d",
                                        "glosses": [
                                            "Bolso pequeño y fijado a una correa para llevarlo a la cintura."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "20e41cec-03fd-3a10-88c4-774f7f03e829",
                                        "entry_id": "097d08bb-31f1-3b16-b828-59aa604df30d",
                                        "glosses": [
                                            "Resaca alcohólica muy fuerte."
                                        ],
                                        "tags": [
                                            "Venezuela",
                                            "colloquial"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            },
                            {
                                "target_word": "canguro",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "540097b7-ffda-3bd3-8c13-d34788771e36",
                                        "entry_id": "ad0ad9cc-cb52-3c96-8da2-744e5dff33b1",
                                        "glosses": [
                                            "Niñero a domicilio por horas."
                                        ],
                                        "tags": [
                                            "Spain"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "173991aa-4ffa-4d40-b167-9bd04751bcf2",
                                                "sense_id": "540097b7-ffda-3bd3-8c13-d34788771e36",
                                                "text": "Claro que la escena paternofilial conllevaría otras obligaciones menos gratas; la rutinaria convivencia familiar; ver televisión todas las noches; y los sábados, que es cuando vendría la canguro, ir a cenar a un restaurante con otra pareja."
                                            },
                                            {
                                                "example_id": "75e2b905-4b04-403e-99c7-6d64088a9459",
                                                "sense_id": "540097b7-ffda-3bd3-8c13-d34788771e36",
                                                "text": "La verdad es que no me gusta la idea de dejar a Tamara sola en casa, pero ella no quiso ni oír hablar de que contratáramos a una canguro para que la cuidara durante el día. Me dijo que ya era demasiado mayor, que no necesitaba que la vigilara nadie, y como Maribel se ofreció a ocuparse de ella y a hacerle la comida…."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            }
                        ]
