    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5be0ae18-c6e8-3d96-a6fc-bb0179452bf4",
                    "sense_definition": "moeilijk te begrijpen of te verklaren door een gebrek aan informatie",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "mysterieus",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Op <w>geheimzinnige</w> wijze is de krant van de tafel verdwenen.",
                            "target_lang_translations": {
                                "en": "The newspaper disappeared from the table in a <w>mysterious</w> way."
                            }
                        },
                        {
                            "text": "Hij doet altijd erg <w>geheimzinnig</w> over zijn nieuwe plannen voor het bedrijf.",
                            "target_lang_translations": {
                                "en": "He is always very <w>secretive</w> about his new plans for the company."
                            }
                        }
                    ],
                    "synonyms": [
                        "raadselachtig",
                        "mysterieus"
                    ],
                    "antonyms": [
                        "duidelijk",
                        "helder"
                    ],
                    "common_phrases": [
                        "geheimzinnig doen",
                        "op geheimzinnige wijze"
                    ],
                    "target_lang_definitions": {
                        "en": "difficult to understand or explain due to a lack of information"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mysterious",
                                "target_lang_sense_clarification": "difficult to understand or of unknown origin"
                            },
                            {
                                "target_lang_word": "secretive",
                                "target_lang_sense_clarification": "deliberately evasive or keeping information to oneself"
                            },
                            {
                                "target_lang_word": "enigmatic",
                                "target_lang_sense_clarification": "puzzling or difficult to interpret"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b66cd22e-9082-33eb-8a17-3ae78c7a495b",
                    "sense_definition": "met betrekking tot het bovennatuurlijke of magische",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mysterieus",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij deed er water in en toen allerlei <w>geheimzinnige</w> kruiden en glanzende stenen.",
                            "target_lang_translations": {
                                "en": "She put water in it and then all kinds of <w>mysterious</w> herbs and shiny stones."
                            }
                        },
                        {
                            "text": "In het bos hangt een <w>geheimzinnige</w> sfeer die bijna magisch aanvoelt.",
                            "target_lang_translations": {
                                "en": "There is a <w>mystical</w> atmosphere in the forest that feels almost magical."
                            }
                        }
                    ],
                    "synonyms": [
                        "mysterieus"
                    ],
                    "common_phrases": [
                        "geheimzinnige krachten"
                    ],
                    "target_lang_definitions": {
                        "en": "relating to the supernatural or magical"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mysterious",
                                "target_lang_sense_clarification": "having unknown or mystical qualities"
                            },
                            {
                                "target_lang_word": "mystical",
                                "target_lang_sense_clarification": "relating to spiritual or supernatural powers"
                            },
                            {
                                "target_lang_word": "arcane",
                                "target_lang_sense_clarification": "understood by few; mysterious or secret"
                            }
                        ]
                    }
                }
            ]
        }
    ]
