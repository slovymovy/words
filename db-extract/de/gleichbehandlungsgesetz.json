                ],
                "senses": [
                    {
                        "sense_id": "8d5009dd-f2c1-34bd-819a-4215f4834bc5",
                        "entry_id": "3ceb0267-2da1-38c7-929d-e3cb0e7e541e",
                        "glosses": [
                            "Gesetz, das Benachteiligungen von bestimmten Personengruppen in der Gesellschaft verhindern und beseitigen soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0627293a-558f-47e3-9ad2-9c4bff4d0fb3",
                                "sense_id": "8d5009dd-f2c1-34bd-819a-4215f4834bc5",
                                "text": "„Auch die Diskriminierung von Menschen ostdeutscher Herkunft müsste im Gleichbehandlungsgesetz thematisiert werden.“"
                            },
                            {
                                "example_id": "f10c7d59-a00d-48fb-8897-fc1d5104193a",
                                "sense_id": "8d5009dd-f2c1-34bd-819a-4215f4834bc5",
                                "text": "„Was ist neu seit 1. August 2008? Das Datum markiert das in Kraft treten der Novelle zum Gleichbehandlungsgesetz, und die wiederum bringt einiges an Neuerungen und Besserstellungen für Frauen am Arbeitsmarkt mit sich.“"
                            },
                            {
                                "example_id": "99564bf1-602b-46ec-bce0-8e08b37bb78a",
                                "sense_id": "8d5009dd-f2c1-34bd-819a-4215f4834bc5",
                                "text": "„Das Gleichbehandlungsgesetz schützt vor Benachteiligung aufgrund bestimmter Merkmale: Niemand darf wegen seiner Religion, seiner Hautfarbe, seines Geschlechts oder seiner ethnischen Herkunft in seinem beruflichen Werdegang behindert werden. Auch sexuelle Vorlieben, die Weltanschauung, eine Behinderung oder das Alter dürfen am Arbeitsplatz keine Rolle spielen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
