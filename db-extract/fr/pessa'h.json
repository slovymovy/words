                                                "sense_id": "7ae23258-4189-322b-a64b-44c6579b5a3d",
                                                "text": "„Zu Pessach feiern die Juden den Auszug aus Ägypten, wo sie 400 Jahre lang unter den Pharaonen als Sklaven gehalten wurden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
