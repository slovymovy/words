                    "semantic_group_id": "qualite_travail",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'artisan a rendu un travail particulièrement <w>soigné</w> qui a impressionné tous les clients.",
                            "target_lang_translations": {
                                "en": "The craftsman delivered particularly <w>meticulous</w> work that impressed all the clients.",
                                "ru": "Мастер выполнил особенно <w>тщательную</w> работу, которая произвела впечатление на всех клиентов.",
                                "de": "Der Handwerker hat eine besonders <w>sorgfältige</w> Arbeit abgeliefert, die alle Kunden beeindruckt hat.",
