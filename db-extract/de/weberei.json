                        "glosses": [
                            "Betriebsstätte, in der gewebte Textilien hergestellt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0968da34-382a-4cf2-807c-344aaa882ee9",
                                "sense_id": "9a800d2c-5f58-35e8-b97f-cf8918164666",
                                "text": "Mein Vater arbeitet in der Weberei hier am Ort."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "79e8f0c0-c50c-33f0-a20a-aed1cb128c3f",
                        "entry_id": "55c79fd1-2f5f-3d11-9801-1cd2427ea9bb",
                        "glosses": [
                            "ein einzelnes gewebtes Stück, eine einzelne Webarbeit"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "bd4b8fc1-884e-45b3-9009-c838308f8db4",
                                "sense_id": "79e8f0c0-c50c-33f0-a20a-aed1cb128c3f",
                                "text": "Bei uns liegt jetzt eine sehr dekorative Weberei meiner Schwester auf dem Tisch."
                            }
