                                "target_senses": [
                                    {
                                        "sense_id": "24a57f2d-3a3a-38fa-ab78-f4b05624b345",
                                        "entry_id": "8a5dd4cc-4cf3-3797-a8bd-590798577855",
                                        "glosses": [
                                            "Qui concerne l’ordinal de neuf."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9355aee3-5419-4c83-b991-f1cd49bdcd06",
                                                "sense_id": "24a57f2d-3a3a-38fa-ab78-f4b05624b345",
                                                "text": "Depuis le 24 janvier nous sommes en ramadan, neuvième mois de l’année lunaire mahométane, pendant lequel tout bon musulman s’abstient de manger, de boire, de fumer, bref, de toute jouissance charnelle, depuis l’aube jusqu’au coucher du soleil."
                                            },
                                            {
                                                "example_id": "62b0e322-6335-4ce5-a610-e7257e2dad33",
                                                "sense_id": "24a57f2d-3a3a-38fa-ab78-f4b05624b345",
                                                "text": "François-Xavier Boudant, dernier tricolore barragiste, prend quand à lui la neuvième place, avec Brazyl du Mezel."
                                            },
                                            {
                                                "example_id": "819ae4d5-e42b-4a5f-b631-0bcbb00e87a3",
                                                "sense_id": "24a57f2d-3a3a-38fa-ab78-f4b05624b345",
                                                "text": "Le Fonds culturel de l’Ermitage, présidé par Martine Boulart, a fait don à la Ville - à l’occasion de son neuvième prix qui s’est tenu au Palais du Luxembourg le 24 octobre dernier - d’une œuvre de l’artiste ukrainien Misha Sydorenko, un amoureux de Saint-Cloud."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c0daaf1-2927-37c1-b6a4-2f78aebec757",
                                        "entry_id": "8a5dd4cc-4cf3-3797-a8bd-590798577855",
                                        "glosses": [
                                            "(Lui neuvième, elle neuvième ou en neuvième) Avec huit autres."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c518a7d-0020-4a83-a613-74a4fc6aa422",
                                                "sense_id": "6c0daaf1-2927-37c1-b6a4-2f78aebec757",
                                                "text": "Embarqué à seize ans comme mousse à bord d’une frégate, il avait parcouru presque toutes les îles de la Sonde, et, obligé de séjourner à Java, il échappa par la force de sa constitution, et lui neuvième, disait-il, aux fièvres pestilentielles qui avaient enlevé tout l’équipage."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "neuvième",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ab5146a7-dc27-3697-8384-cd02525545e7",
                                        "entry_id": "3f0631f6-7fdd-3958-b24a-19f4ef106ec9",
                                        "glosses": [
                                            "Élément ordinal, correspondant au cardinal neuf."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "099d7f87-48fd-4074-8ca5-e3fb2b34e905",
                                                "sense_id": "ab5146a7-dc27-3697-8384-cd02525545e7",
                                                "text": "Il est le neuvième, elle est la neuvième de sa classe."
                                            },
                                            {
                                                "example_id": "b91989cd-35fd-4621-8a9f-86184f0bdde5",
                                                "sense_id": "ab5146a7-dc27-3697-8384-cd02525545e7",
                                                "text": "Le neuvième précède le dixième et suit le huitième."
                                            },
                                            {
                                                "example_id": "e0c87ea4-93b0-4a70-bd4b-bdd3754cccba",
                                                "sense_id": "ab5146a7-dc27-3697-8384-cd02525545e7",
                                                "text": "Pierre Delsol, le neuvième Compagnon de Quastina, est mort le 2 juillet 1987."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01e464c1-0853-3846-b7a9-2b2150004a31",
                                        "entry_id": "3f0631f6-7fdd-3958-b24a-19f4ef106ec9",
                                        "glosses": [
                                            "Fraction obtenue en divisant en neuf parties égales."
