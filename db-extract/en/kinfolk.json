                    {
                        "translation_id": "281846f4-6f50-4f7a-b6c9-c37f2706cb44",
                        "source_entry_id": "aad6fc33-06a8-31aa-8c22-a480c66b2679",
                        "source_sense_id": "231d2d84-fe21-3d51-8c45-4ba57b539d78",
