                        "examples": [
                            {
                                "example_id": "20fba4a7-f302-47d1-a796-12005c559426",
                                "sense_id": "e5691439-22a5-31b3-9906-37849f76d208",
                                "text": "Dat een kort deel van het parcours tussen Oldenzaal en Hengelo door werkzaamheden van Rijkswaterstaat absoluut niet marathonwaardig bleek, werd de organisatie niet zwaar aangerekend. Eikenaar herinnert het zich nog. \"Er werden slakken gestort. Ja, dat was een tegenvaller. Konden we niets aan doen.\" Toch was aan alles gedacht. De streekvervoerders TAT en TET hadden extra bussen ingezet om aan de verwachte toeloop van kijkers te kunnen voldoen. Er zijn naar schatting honderdduizend mensen op de marathonloop afgekomen, die de lopers toejuichten. Deze massale ondersteuning was voor zowel de Slowaakse scheidsrechter Bukovsky als het Zwitserse jurylid Beer een unieke ervaring."
                            }
                        ]
                    },
                    {
                        "sense_id": "35037bd7-a516-3ddd-af89-26c3a537e612",
                        "entry_id": "29a2c427-742e-3012-9e0d-d2068a1bdb96",
                        "glosses": [
                            "een langdurig proces"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "8b5a4d91-9894-48bd-9d13-7127e6bbfd69",
                                "sense_id": "35037bd7-a516-3ddd-af89-26c3a537e612",
                                "text": "‘Vroeger was de dood een eindsprint’, laat ze haar vertelster zeggen, ‘tegenwoordig is het een marathonloop’."
                            }
                        ]
