                "entry_id": "99f669ed-015d-328b-aa30-e64b00e18287",
                "word": "aiguillée",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "cec9bcb4-13b3-43aa-a625-4d405e5661ed",
                        "entry_id": "99f669ed-015d-328b-aa30-e64b00e18287",
