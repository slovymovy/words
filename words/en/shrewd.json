                            {
                                "target_lang_word": "szkodliwy",
                                "target_lang_sense_clarification": "przynoszący szkodę"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5d4a37a1-8004-3d9d-a941-4fb1ca18ee01",
                    "sense_definition": "Abusive, ill-tempered, or shrewish.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "hostility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old man was known for his <w>shrewd</w> temper and constant complaints.",
                            "target_lang_translations": {
                                "pl": "Starzec był znany ze swojego <w>zrzędliwego</w> charakteru i ciągłych narzekań."
                            }
                        },
                        {
                            "text": "She gave him a <w>shrewd</w> scolding that left him speechless.",
                            "target_lang_translations": {
                                "pl": "Dała mu <w>ostrą</w> burę, która pozbawiła go mowy."
                            }
                        }
                    ],
                    "synonyms": [
                        "shrewish",
                        "ill-tempered",
                        "abusive"
                    ],
                    "antonyms": [
                        "mild-tempered",
                        "gentle"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Obsolete meaning related to shrewish behavior"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Kłótliwy, wybuchowy lub zrzędliwy (przestarzałe)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "zrzędliwy",
                                "target_lang_sense_clarification": "o charakterze"
                            },
                            {
                                "target_lang_word": "kłótliwy",
                                "target_lang_sense_clarification": "skłonny do awantur"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "345cb796-7a4b-34a3-a71a-2a9f3e941069",
                    "sense_definition": "Scolding, satirical, or sharp of tongue.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "hostility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was so <w>shrewd</w> of her tongue that few dared to argue with her.",
                            "target_lang_translations": {
                                "pl": "Miała tak <w>ostry</w> język, że niewielu odważało się z nią kłócić."
                            }
                        },
                        {
                            "text": "His <w>shrewd</w> wit often offended those who did not understand his humor.",
                            "target_lang_translations": {
                                "pl": "Jego <w>cięty</w> dowcip często obrażał tych, którzy nie rozumieli jego humoru."
                            }
                        }
