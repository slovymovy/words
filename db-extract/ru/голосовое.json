                "senses": [
                    {
                        "sense_id": "5543e438-bdfd-3b70-8828-140a61fe44c6",
                        "entry_id": "d3bcbecb-e390-3013-86ab-3c63d21c746a",
                        "glosses": [
                            "разг. то же, что голосовое сообщение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "512a50d0-ffa6-43eb-bd0a-d7386c9d0610",
                                "sense_id": "5543e438-bdfd-3b70-8828-140a61fe44c6",
                                "text": "Они посылают мне, а я посылаю им голосовые, и с этим нет никаких проблем, потому что все нацелены на результат и на дело, а не на демагогию!"
                            },
                            {
                                "example_id": "749ce528-8f44-4f43-b51c-83ad624d4997",
                                "sense_id": "5543e438-bdfd-3b70-8828-140a61fe44c6",
                                "text": "Печальная особенность голосового — оно не предполагает обязательной скорой реакции, так как весьма вероятно, что адресат не может его сейчас прослушать."
                            }
                        ]
                    }
