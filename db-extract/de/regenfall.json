                "senses": [
                    {
                        "sense_id": "5afb3ea0-c52d-36ca-849d-f95cd34d1b5a",
                        "entry_id": "20c10081-2611-34d9-968b-2291b9e43db7",
                        "glosses": [
                            "meist starker Regen"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "38fa6f23-eade-435c-baa8-ceed95527f7c",
                                "sense_id": "5afb3ea0-c52d-36ca-849d-f95cd34d1b5a",
                                "text": "„Die Regenfälle haben aufgehört, und aus der Erde sprießen Gras und dazwischen weiße Blumen.“"
                            },
                            {
                                "example_id": "4dd0cb56-6f81-4b7d-a1ce-d67f77eac13b",
                                "sense_id": "5afb3ea0-c52d-36ca-849d-f95cd34d1b5a",
                                "text": "„Im Hochsommer wiederum brachen lang andauernde Regenfälle über das ausgedörrte Land herein, bis im September eine neue Trockenphase einsetzte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
