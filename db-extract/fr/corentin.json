                ],
                "senses": [
                    {
                        "sense_id": "4e45941d-08f1-36be-a390-c300f9f38d1e",
                        "entry_id": "b3766e8a-e00e-3e43-a426-695d1d6a5acc",
                        "glosses": [
                            "Prénom masculin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d62ced3-7b2d-4420-a85f-bd5b74fdee00",
                                "sense_id": "4e45941d-08f1-36be-a390-c300f9f38d1e",
                                "text": "Bien qu’elle ne fît que passer de sa mauvaise ottomane sur un antique sopha que Corentin avait su lui trouver, la fantasque Parisienne prit possession de cette maison comme d’une chose qui lui aurait appartenu."
                            },
                            {
                                "example_id": "66b1046b-a6ad-4e6b-90bf-5318865ebd20",
                                "sense_id": "4e45941d-08f1-36be-a390-c300f9f38d1e",
                                "text": "Corentin rageait d’être condamné à l’inaction, et se piétait contre l’envie de forcer la retraite où se terrait sa belle sirène de Landemer."
                            },
                            {
                                "example_id": "6d6ef178-8c9b-4bc5-b398-e78e7eba0aac",
                                "sense_id": "4e45941d-08f1-36be-a390-c300f9f38d1e",
                                "text": "Avec, en point d’orgue, une occase XXL croquée de la tête par Alexandre Lacazette, sur une sublime ouverture de son pote Corentin Tolisso (21ᵉ)."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
