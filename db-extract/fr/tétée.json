                                    },
                                    {
                                        "sense_id": "00e7ecb9-9a7d-32cd-85df-27a808b25a90",
                                        "entry_id": "358e0466-d76d-3c4d-aece-0533882e25b3",
                                        "glosses": [
                                            "The forward motion of the material fed into a machine."
                                        ],
