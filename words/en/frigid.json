            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "09c050ff-6e64-321b-8f24-c0e9354919ed",
                    "sense_definition": "Extremely cold in temperature; freezing or icy.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "temperature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The climbers struggled to breathe in the <w>frigid</w> air near the summit.",
                            "target_lang_translations": {
                                "zh": "登山者们在接近山顶的<w>冰冷</w>空气中呼吸困难。"
                            }
                        },
                        {
                            "text": "She wrapped a thick woolen blanket around herself against the <w>frigid</w> wind.",
                            "target_lang_translations": {
                                "zh": "她给自己裹上厚厚的羊毛毯，以抵御<w>严寒的</w>冷风。"
                            }
                        }
                    ],
                    "synonyms": [
                        "freezing",
                        "icy",
                        "frosty",
                        "glacial"
                    ],
                    "common_phrases": [
                        "frigid air",
                        "frigid weather",
                        "frigid zone"
                    ],
                    "target_lang_definitions": {
                        "zh": "极度寒冷的；严寒的；冰冷的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "严寒的",
                                "target_lang_sense_clarification": "指气候或天气极其寒冷"
                            },
                            {
                                "target_lang_word": "冰冷的",
                                "target_lang_sense_clarification": "指温度极低、如冰一般冷"
                            },
                            {
                                "target_lang_word": "寒冷的",
                                "target_lang_sense_clarification": "指极低的气温"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7bacd325-fe29-3a73-ac8d-d5e9a6b93c6c",
                    "sense_definition": "Lacking warmth, friendliness, or emotional expression; aloof and unwelcoming.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "temperament",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee gave him a <w>frigid</w> reception when he entered the room.",
                            "target_lang_translations": {
                                "zh": "他走进房间时，委员会对他报以<w>冷淡的</w>接待。"
                            }
                        },
                        {
                            "text": "His polite but <w>frigid</w> tone made it clear that the meeting was over.",
                            "target_lang_translations": {
                                "zh": "他礼貌却<w>冷漠的</w>语气清楚地表明会议已经结束。"
                            }
                        }
                    ],
                    "synonyms": [
                        "aloof",
                        "chilly",
                        "distant",
                        "unfriendly",
                        "frosty"
                    ],
                    "antonyms": [
                        "fervid"
                    ],
                    "common_phrases": [
                        "frigid reception",
                        "frigid smile",
                        "frigid glance"
                    ],
                    "target_lang_definitions": {
