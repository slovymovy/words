                ],
                "senses": [
                    {
                        "sense_id": "662b99e3-e1c2-35de-8090-9612716d2cc3",
                        "entry_id": "5602421a-4d56-3fb5-a39a-da15d93fe312",
                        "glosses": [
                            "karta sieciowa Ethernet lub Wi-Fi"
                        ],
                        "tags": [
                            "środ."
                        ],
                        "examples": [
                            {
                                "example_id": "3690e728-86c6-4491-b644-72f67c3b7818",
                                "sense_id": "662b99e3-e1c2-35de-8090-9612716d2cc3",
                                "text": "Mam pytanko, czy można spalić sieciówkę, podłączając ją do linii telefonicznej?"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "4a29aeaa-b1e4-302e-b7c6-85bcef6ecac6",
                        "entry_id": "5602421a-4d56-3fb5-a39a-da15d93fe312",
                        "glosses": [
                            "sklep, market, zakład usługowy itp., posługujący się daną marką jako nazwą własną; często na warunkach franczyzy"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "fc9bf34f-16fb-4be1-bc9c-bcc649df4079",
                                "sense_id": "4a29aeaa-b1e4-302e-b7c6-85bcef6ecac6",
                                "text": "Mniejszą rolę grają dla mnie sieciówki, zdecydowanie większą sklepy vintage i ciucholandy"
                            },
                            {
                                "example_id": "6336d894-eb95-48fe-92c1-5184f60e22f1",
                                "sense_id": "4a29aeaa-b1e4-302e-b7c6-85bcef6ecac6",
                                "text": "Biedronki, Tesco i Carrefour – właściciele osiedlowych sklepików czuja się coraz bardziej osaczeni przez sieciówki, które w szybkim tempie pojawiają się na kolejnych osiedlach"
                            },
                            {
                                "example_id": "62bd62c4-c127-476b-801b-ebf2024044cf",
                                "sense_id": "4a29aeaa-b1e4-302e-b7c6-85bcef6ecac6",
                                "text": "Angielska sieciówka Primark, po fali krytyki ze strony polityków i organizacji praw dziecka postanowiła wycofać ze sprzedaży usztywniane góry bikini przeznaczone dla dziewczynek w wieku około 7 lat"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "0fbdfc47-8562-3a8e-acd4-1e5eda0e6129",
                        "entry_id": "5602421a-4d56-3fb5-a39a-da15d93fe312",
                        "glosses": [
                            "bilet miesięczny"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "0739e86b-966c-4479-95c4-d72c7a6185d2",
                                "sense_id": "0fbdfc47-8562-3a8e-acd4-1e5eda0e6129",
                                "text": "Już studentem nie jestem i potrzebna mi sieciówka od marca"
                            }
                        ],
