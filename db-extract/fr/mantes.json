                "forms": [],
                "senses": [
                    {
                        "sense_id": "85275931-0092-3fcd-a520-689632bab86a",
                        "entry_id": "a3bcdd20-9d3e-318e-bc05-cc50e7f51d43",
                        "glosses": [
                            "Nom court de Mantes-la-Jolie, commune française située dans le département des Yvelines."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3c98383-a4b2-4959-93b6-939d44921fbe",
                                "sense_id": "85275931-0092-3fcd-a520-689632bab86a",
                                "text": "Sous la marquise des grandes lignes, l’arrivée d’un train de Mantes avait animé les quais ; et il suivit des yeux la machine de manœuvre, une petite machine-tender, aux trois roues basses et couplées, qui commençait le débranchement du train, alerte besogneuse, emmenant, refoulant les wagons sur les voies de remisage."
                            },
                            {
                                "example_id": "9f9a42bf-59d5-48e3-83cc-40343ae532dc",
                                "sense_id": "85275931-0092-3fcd-a520-689632bab86a",
                                "text": "Ces jours-là Raoul s’ennuyait fort. Aussi, à Mantes, se trouvant encore seul, il loua une bicyclette et roula quelque temps à travers la campagne."
                            }
                        ]
                    }
                ],
