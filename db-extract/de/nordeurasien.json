                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50d578b4-81ad-4fdf-b75f-ff1801b28c95",
                                "sense_id": "a161027e-d307-3f4d-abe6-6f3f698fd5c9",
                                "text": "„Anfang der 30er Jahre drang die Sowjetunion nach Nordeurasien vor und propagierte den Beginn eines neuen Zeitalters.“"
                            },
                            {
                                "example_id": "1bb98793-f828-4367-a405-74e98ffee7f7",
                                "sense_id": "a161027e-d307-3f4d-abe6-6f3f698fd5c9",
                                "text": "„Hultkrantz hat die Religion der europäischen und der amerikanischen Arktiker (Lappen und Eskimos) untersucht, Jettmar »die Aussage der Archäologie zur Religionsgeschichte Nordeurasiens« hinzugefügt.“"
                            },
                            {
                                "example_id": "d1dd41a7-4a94-4065-8616-dae3a4915a2b",
                                "sense_id": "a161027e-d307-3f4d-abe6-6f3f698fd5c9",
                                "text": "„Für die kulturgeschichtliche Stellung des Seelendualismus in Nordeurasien ist an erster Stelle ihre durchaus universale kulturgeographische Verbreitung über das ganze weite Gebiet zu berücksichtigen.“"
                            }
                        ],
