{
    "word_family": [
        "primitivisme",
        "primitiviteit"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4f9d33a0-0fa4-3a4f-96bd-46961b34d147",
                    "sense_definition": "met weinig comfort of technische hulpmiddelen; heel eenvoudig",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "eenvoudig",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tijdens onze kampeervakantie moesten we onder zeer <w>primitieve</w> omstandigheden overleven.",
                            "target_lang_translations": {
                                "en": "During our camping holiday, we had to survive under very <w>primitive</w> conditions."
                            }
                        },
                        {
                            "text": "De berghut was erg <w>primitief</w> ingericht zonder stromend water of elektriciteit.",
                            "target_lang_translations": {
                                "en": "The mountain hut was very <w>primitively</w> furnished, without running water or electricity."
                            }
                        }
                    ],
                    "synonyms": [
                        "eenvoudig",
                        "sober"
                    ],
                    "antonyms": [
                        "modern",
                        "ontwikkeld"
                    ],
                    "common_phrases": [
                        "primitieve omstandigheden",
                        "primitief ingericht"
                    ],
                    "target_lang_definitions": {
                        "en": "with little comfort or technical resources; very simple"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "primitive",
                                "target_lang_sense_clarification": "lacking comfort or modern technology"
                            },
                            {
                                "target_lang_word": "basic",
                                "target_lang_sense_clarification": "providing only the most essential things"
                            },
                            {
                                "target_lang_word": "crude",
                                "target_lang_sense_clarification": "roughly made or simple"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d549bd07-eb74-3901-b2f9-c6a04d31ecad",
                    "sense_definition": "behorend tot een vroege fase van ontwikkeling; niet ver geëvolueerd",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ontwikkeling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het vogelbekdier wordt vaak beschouwd als een <w>primitief</w> zoogdier vanwege de voortplanting via eieren.",
                            "target_lang_translations": {
                                "en": "The platypus is often considered a <w>primitive</w> mammal because it reproduces via eggs."
                            }
                        },
                        {
                            "text": "In de grot vonden archeologen <w>primitieve</w> werktuigen van duizenden jaren oud.",
                            "target_lang_translations": {
                                "en": "In the cave, archaeologists found <w>primitive</w> tools that were thousands of years old."
                            }
                        }
                    ],
                    "synonyms": [
                        "oorspronkelijk",
                        "onontwikkeld"
                    ],
                    "antonyms": [
                        "gespecialiseerd",
                        "hoogontwikkeld"
                    ],
                    "common_phrases": [
                        "primitief zoogdier",
                        "primitieve werktuigen"
                    ],
                    "target_lang_definitions": {
                        "en": "belonging to an early stage of development; not far evolved"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "primitive",
                                "target_lang_sense_clarification": "relating to an early stage of evolution"
                            },
                            {
                                "target_lang_word": "early",
                                "target_lang_sense_clarification": "belonging to the beginning of a period"
                            },
                            {
                                "target_lang_word": "primeval",
                                "target_lang_sense_clarification": "relating to the earliest ages in history"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e5185c31-c08a-34e8-a5a1-f91defb661de",
                    "sense_definition": "verwijzend naar een functie waarvan de afgeleide de oorspronkelijke functie is",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "wiskunde",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De student moest de <w>primitieve</w> functie bepalen om de integraal op te lossen.",
                            "target_lang_translations": {
                                "en": "The student had to determine the <w>primitive</w> function to solve the integral."
                            }
                        },
                        {
                            "text": "Een functie kan meerdere <w>primitieve</w> functies hebben die slechts een constante verschillen.",
                            "target_lang_translations": {
                                "en": "A function can have multiple <w>primitive</w> functions that differ only by a constant."
                            }
                        }
                    ],
                    "antonyms": [
                        "afgeleid"
                    ],
                    "common_phrases": [
                        "primitieve functie"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "referring to a function whose derivative is the original function"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "primitive",
                                "target_lang_sense_clarification": "a function whose derivative is a given function"
                            },
                            {
                                "target_lang_word": "antiderivative",
                                "target_lang_sense_clarification": "the inverse of a derivative"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aca7b1ca-6071-36e7-8def-546760d11883",
                    "sense_definition": "verwijzend naar een kristalstructuur met de kleinst mogelijke eenheidscel",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "natuurkunde",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Alle kristalstelsels kennen <w>primitieve</w> ruimtegroepen met één roosterpunt per cel.",
                            "target_lang_translations": {
                                "en": "All crystal systems have <w>primitive</w> space groups with one lattice point per cell."
                            }
                        },
                        {
                            "text": "In de kristallografie is een <w>primitieve</w> cel de eenvoudigste weergave van de symmetrie.",
                            "target_lang_translations": {
                                "en": "In crystallography, a <w>primitive</w> cell is the simplest representation of the symmetry."
                            }
                        }
                    ],
                    "antonyms": [
                        "gecentreerd"
                    ],
                    "common_phrases": [
                        "primitieve cel",
                        "primitieve beschrijving"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "scientific"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "referring to a crystal structure with the smallest possible unit cell"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "primitive",
                                "target_lang_sense_clarification": "relating to a unit cell with only one lattice point"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}