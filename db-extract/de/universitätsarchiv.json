                "senses": [
                    {
                        "sense_id": "2c7a9a3d-fd62-386d-8059-d022541e650e",
                        "entry_id": "e26c21f0-4f7c-3fc6-8007-52ee45b99f60",
                        "glosses": [
                            "Archiv einer Universität"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a999d1b-488d-464e-8935-cf5381f470cf",
                                "sense_id": "2c7a9a3d-fd62-386d-8059-d022541e650e",
                                "text": "„Er kehrte zum Küchenschrank zurück und nahm erneut den Umschlag heraus, den er aus dem Universitätsarchiv gestohlen hatte und der in eleganter Handschrift die Bezeichnung Benotete Arbeiten, 25.5 trug.“"
                            },
                            {
                                "example_id": "44c7a9e0-7c83-45bc-b957-84510e563d09",
                                "sense_id": "2c7a9a3d-fd62-386d-8059-d022541e650e",
                                "text": "„Ich war selbst noch Student, als ich diesen Brief im Universitätsarchiv entdeckte und beinahe gestohlen hätte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
