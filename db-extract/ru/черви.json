                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "402451ed-ae9a-4d15-a048-166c128e8112",
                                                "sense_id": "f85bdd07-55b7-3dc7-8bb5-cc726a5a6918",
                                                "text": "Graag zou ik willen geloven in een ziel die doorleeft na de dood, maar ik geloof eerder dat de zielen van onze overleden vrienden voortleven in de harten van mensen die aan hen terugdenken."
                                            }
