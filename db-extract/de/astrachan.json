                "translations": [
                    {
                        "translation_id": "30a3b841-ba06-4a67-bb7b-bdf75b3fd5de",
                        "source_entry_id": "fcb074c2-bbac-3aba-8862-15fb3a668329",
                        "source_sense_id": "22668d6c-3af8-3cf6-8ef3-c584ed5581aa",
