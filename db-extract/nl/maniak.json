                "translations": [
                    {
                        "translation_id": "e6391e6a-ba86-4269-974f-fd5f75a60201",
                        "source_entry_id": "332bc97a-2e1f-35aa-b71f-2f99ff604b13",
                        "target_lang_word": "maniac",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "maniac",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d0bcce9c-7f34-3326-bac5-da4224fb014c",
                                        "entry_id": "40546f1f-c868-36ff-901a-21ef18a8acb9",
                                        "glosses": [
                                            "An insane person, especially one who suffers from a mania."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3ae43cb-ccec-48ce-a18a-2c9691c8776f",
                                                "sense_id": "d0bcce9c-7f34-3326-bac5-da4224fb014c",
                                                "text": "She was driving like a maniac."
                                            },
                                            {
                                                "example_id": "a7d654b5-0813-4238-9c49-1c6b521de3eb",
                                                "sense_id": "d0bcce9c-7f34-3326-bac5-da4224fb014c",
                                                "text": "In these early days of silent pictures, the accent was chiefly on thrills and danger as provided by supposedly unstoppable locomotives with crooks or maniacs on the footplate."
                                            },
                                            {
                                                "example_id": "4bdfc0f3-5c15-44d7-a778-f15edd1f01f9",
                                                "sense_id": "d0bcce9c-7f34-3326-bac5-da4224fb014c",
                                                "text": "Hey kids, the word of the week is \"pupaphobia\"! Others may enjoy being frightened by chainsaw-wielding maniacs and cannibal clowns, but my Halloween is never complete without a murderous Muppet or two. Thankfully, a pair of events last Friday the 13th provided a perfect double feature of puppet perversity."
                                            },
                                            {
                                                "example_id": "a25d88a9-4c83-41b0-b51d-7bc0de732ba8",
                                                "sense_id": "d0bcce9c-7f34-3326-bac5-da4224fb014c",
                                                "text": "“It gives me the dithers, thinking of the damage that maniac could do if he ever took the headship. He could reinstate the cycle of chosen births, or enact any of a hundred other terrible laws.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0234e8b-f1e2-3636-8d5c-61aff87ba60d",
                                        "entry_id": "40546f1f-c868-36ff-901a-21ef18a8acb9",
                                        "glosses": [
                                            "A fanatic, a person with an obsession."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e314457-cb26-45d4-9ed6-d1de67c1c145",
                                                "sense_id": "c0234e8b-f1e2-3636-8d5c-61aff87ba60d",
                                                "text": "He's a manga maniac."
                                            },
                                            {
                                                "example_id": "38557ae8-9817-4e35-b6d6-791fdf6ec590",
                                                "sense_id": "c0234e8b-f1e2-3636-8d5c-61aff87ba60d",
                                                "text": "She's a maniac, maniac on the floor / And she's dancing like she's never danced before"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f9de868-5330-3bcc-9226-1a7c6f210c4f",
                                        "entry_id": "40546f1f-c868-36ff-901a-21ef18a8acb9",
                                        "glosses": [
                                            "Ellipsis of sex maniac."
                                        ],
