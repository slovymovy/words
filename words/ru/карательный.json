            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "74902463-661b-30bd-9733-74eddef63a4b",
                    "sense_definition": "Предназначенный для осуществления наказания или взыскания.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "punishment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Суд вынес <w>карательный</w> приговор за совершенное преступление.",
                            "target_lang_translations": {
                                "de": "Das Gericht fällte ein <w>strafendes</w> Urteil für das begangene Verbrechen."
                            }
                        },
                        {
                            "text": "В государстве была введена новая <w>карательная</w> мера для нарушителей порядка.",
                            "target_lang_translations": {
                                "de": "Im Staat wurde eine neue <w>strafende</w> Maßnahme für Ruhestörer eingeführt."
                            }
                        }
                    ],
                    "synonyms": [
                        "пенальный"
                    ],
                    "common_phrases": [
                        "карательная мера"
                    ],
                    "target_lang_definitions": {
                        "de": "Dient dazu, eine Strafe oder Sanktion zu vollstrecken."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "strafend",
                                "target_lang_sense_clarification": "allgemein im Sinne von eine Strafe enthaltend"
                            },
                            {
                                "target_lang_word": "strafrechtlich",
                                "target_lang_sense_clarification": "im juristischen Kontext"
                            },
                            {
                                "target_lang_word": "sanktionierend",
                                "target_lang_sense_clarification": "im Sinne von Maßnahmen ergreifend"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "88a2fb45-1bcf-3c1a-8f22-623ac3cae285",
                    "sense_definition": "Имеющий целью жестоко наказать или произвести расправу.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "punishment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Отряд отправился в деревню с <w>карательной</w> экспедицией.",
                            "target_lang_translations": {
                                "de": "Die Einheit brach zu einer <w>Strafexpedition</w> in das Dorf auf."
                            }
                        },
                        {
                            "text": "Политика властей приобрела ярко выраженный <w>карательный</w> характер.",
                            "target_lang_translations": {
                                "de": "Die Politik der Behörden nahm einen deutlich <w>repressiven</w> Charakter an."
                            }
                        }
                    ],
                    "synonyms": [
                        "репрессивный",
                        "усмирительный",
                        "экзекуционный"
                    ],
                    "common_phrases": [
                        "карательная экспедиция"
                    ],
                    "target_lang_definitions": {
                        "de": "Mit dem Ziel, grausam zu bestrafen oder gewaltsam gegen eine Gruppe vorzugehen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "strafexpeditionär",
