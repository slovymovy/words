                "senses": [
                    {
                        "sense_id": "c4368f54-edec-34d2-86a6-9471aa1a4885",
                        "entry_id": "049f3822-836a-3ed4-843d-2665a6c8f975",
                        "glosses": [
                            "de mate waarin iets schuin of scheef is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3fb6048-a335-46cc-a0f7-81d7f3494167",
                                "sense_id": "c4368f54-edec-34d2-86a6-9471aa1a4885",
                                "text": "In 1993 bereikte de toren zijn maximale schuinte met een verschil van bijna 4,5 meter. Na jaren van tegengewicht is het verschil nu gestabiliseerd op net geen 4 meter. Nu alle restauratiewerken gedaan zijn, zal het deze zomer voor het eerst mogelijk zijn vanuit de binnenplaats van de Middeleeuwse toren alle zeven loges te zien. Dat was sinds 1935 niet meer mogelijk."
                            },
                            {
                                "example_id": "200ca471-3626-4699-9925-8eea2b1abe00",
                                "sense_id": "c4368f54-edec-34d2-86a6-9471aa1a4885",
                                "text": "De aanleg van het richellandschap is niet zonder problemen gegaan. Van een enkele huiseigenaar aan de rand van het gebied kwam protest en ook agrariërs die het gebied naast de Polderbaan in beheer hebben tekenden bezwaar aan. Een boer die zijn bedrijf heeft aan de IJweg in Hoofddorp voegt zich bij ons. Hij laat weten dat „zijn kostbare land teloor gaat”. En dat het maaien bijna onmogelijk is door de schuinte van de hellingshoek."
                            }
                        ]
                    },
                    {
                        "sense_id": "6b42e3a4-cf51-3159-8dc7-49e7e9fdc714",
                        "entry_id": "049f3822-836a-3ed4-843d-2665a6c8f975",
                        "glosses": [
                            "helling"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "635c5522-2a20-42be-b8fd-5242a31dc0f4",
                        "source_entry_id": "049f3822-836a-3ed4-843d-2665a6c8f975",
                        "source_sense_id": "c4368f54-edec-34d2-86a6-9471aa1a4885",
                        "source_sense_description": "de mate waarin iets schuin of scheef is",
                        "target_lang_word": "obliquity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obliquity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4e260a15-7185-37b5-a561-78c9edf2748b",
                                        "entry_id": "0743f044-4a4b-3bb9-80b1-f21874eed5ab",
                                        "glosses": [
                                            "The quality of being oblique in direction, deviating from the horizontal or vertical; or the angle created by such a deviation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "468cddba-a2dc-4229-afa7-7414598ea909",
                                                "sense_id": "4e260a15-7185-37b5-a561-78c9edf2748b",
                                                "text": "The Planet Earth, so stedfast though she seem, / Insensibly three different Motions move? / Which else to several Sphears thou must ascribe, / Mov'd contrarie with thwart obliquities"
                                            },
                                            {
                                                "example_id": "45691870-3827-4720-ba86-4caa21b6cfd2",
                                                "sense_id": "4e260a15-7185-37b5-a561-78c9edf2748b",
                                                "text": "Screwed at its axis against the side, a swinging lamp slightly oscillates in Jonah’s room; and the ship, heeling over towards the wharf with the weight of the last bales received, the lamp, flame and all, though in slight motion, still maintains a permanent obliquity with reference to the room; though, in truth, infallibly straight itself, it but made obvious the false, lying levels among which it hung."
                                            },
                                            {
                                                "example_id": "408e29ca-34f8-4710-99c3-307d4ff5bd7c",
                                                "sense_id": "4e260a15-7185-37b5-a561-78c9edf2748b",
                                                "text": "She wore glasses which, in humble reference to a divergent obliquity of vision, she called her straighteners, and a little ugly snuff-coloured dress trimmed with satin bands in the form of scallops and glazed with antiquity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a7e2eb4-cf5d-3fcc-952d-ea59db9d4d3b",
                                        "entry_id": "0743f044-4a4b-3bb9-80b1-f21874eed5ab",
                                        "glosses": [
                                            "Axial tilt."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61171d5f-91d8-4124-bbce-2bf76b464d5d",
                                                "sense_id": "5a7e2eb4-cf5d-3fcc-952d-ea59db9d4d3b",
                                                "text": "Calculating by spherical trigonometry, and assuming the same obliquity, I obtain 3 dundas and 40 pulas for the ascensional arc, giving a difference in time of 3 pulas, or about one of our minutes; an error so small, that even were the Indian astronomer aware of its existence he would disregard it, satisfied that the practical purposes which his labours subserve, are, notwithstanding, carried out with sufficient accuracy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20fde0be-21a5-336e-a09c-757a032c144d",
                                        "entry_id": "0743f044-4a4b-3bb9-80b1-f21874eed5ab",
                                        "glosses": [
                                            "Mental or moral deviation or perversity; immorality."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20a334dc-931b-42a3-aa98-16c370474341",
                                                "sense_id": "20fde0be-21a5-336e-a09c-757a032c144d",
                                                "text": "Habitually living with the elements and knowing little more of the land than as a beach, or, rather, that portion of the terraqueous globe providentially set apart for dance-houses, doxies and tapsters, in short what sailors call a \"fiddlers'-green,\" his simple nature remained unsophisticated by those moral obliquities which are not in every case incompatible with that manufacturable thing known as respectability."
                                            },
                                            {
                                                "example_id": "2ec9154f-c16f-48ca-afb9-6017d97ee172",
                                                "sense_id": "20fde0be-21a5-336e-a09c-757a032c144d",
                                                "text": "Stray's [friends], apt to keep more to the shadows, tended to be practitioners of obliquity—as it quite often came down to, varieties of pimp."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d31e2cb-47c0-3719-861a-8b1cdc915022",
                                        "entry_id": "0743f044-4a4b-3bb9-80b1-f21874eed5ab",
                                        "glosses": [
                                            "The quality of being obscure, oftentimes willfully, sometimes as an exercise in euphemism."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6174c65-1d58-4df5-927a-6092b94fb357",
                                                "sense_id": "7d31e2cb-47c0-3719-861a-8b1cdc915022",
                                                "text": "That spiked my gun. I could not say anything. I was entirely out of verbal obliquities; to go further would be to lie, and that I would not do; so I simply sat still and suffered,—sat mutely and resignedly there, and sizzled,—for I was being slowly fried to death in my own blushes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
