                            {
                                "example_id": "098cf1a8-7c58-4c67-acb6-6b29a8a13183",
                                "sense_id": "fcc680dc-f7d4-3bf5-a9ae-91c39fec6057",
                                "text": "Das BIP ist in diesem Jahr wieder gestiegen."
                            },
                            {
                                "example_id": "4f1eda26-a11b-4b6f-a899-3290eeadd574",
                                "sense_id": "fcc680dc-f7d4-3bf5-a9ae-91c39fec6057",
                                "text": "„Auch die Finanzämter treiben noch immer zu wenig Geld ein, die Außenstände bei Steuern und Abgaben liegen bei 70 Prozent des BIP.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2950bad8-07d9-4554-94df-39908f3e70ab",
                        "source_entry_id": "81361f37-0dd5-38d5-a791-109c1f3c0608",
                        "source_sense_id": "fcc680dc-f7d4-3bf5-a9ae-91c39fec6057",
                        "source_sense_description": "Abkürzung für „Bruttoinlandsprodukt“",
                        "target_lang_word": "GDP",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "GDP",
