                "translations": [
                    {
                        "translation_id": "f3ffb0bb-6fc7-4e20-a704-227b8977217f",
                        "source_entry_id": "176a6ec7-bbc3-344c-8124-d3174b9f757c",
                        "source_sense_id": "9eab0671-c271-31aa-954a-9c5b178057c3",
                        "target_lang_word": "stalken",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stalken",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7b7a4eea-0c7e-3ee9-a028-590e26b37914",
                                        "entry_id": "c692a184-8d35-3d68-a9a6-c2fe614074d6",
                                        "glosses": [
                                            "jemanden aus verschmähter Liebe, aus Rachegelüsten oder aus anderen Motiven beständig verfolgen, ihm auflauern und ihn zum Beispiel durch Geschenke, Anrufe, SMS, E-Mails, Briefe oder Nachrichten in sozialen Netzwerken belästigen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2a6868c-3345-4171-b3fd-af719706fb82",
                                                "sense_id": "7b7a4eea-0c7e-3ee9-a028-590e26b37914",
                                                "text": "„Nur etwa 15 Prozent stalken aus einem Machtgefühl heraus und aus der Freude, sich überlegen zu fühlen, erläutert der Experte.“"
                                            },
                                            {
                                                "example_id": "efd271f6-7e8d-41ef-82e9-18db7dbdd635",
                                                "sense_id": "7b7a4eea-0c7e-3ee9-a028-590e26b37914",
                                                "text": "„Gegen den Niederländer, der sie nach dem Ende der Affäre stalkte, zog sie später vor Gericht.“"
                                            },
                                            {
                                                "example_id": "691c881c-4c04-4a04-9eb9-ff7d17927023",
                                                "sense_id": "7b7a4eea-0c7e-3ee9-a028-590e26b37914",
                                                "text": "„Nur dass man nicht über Statistiken nachdenkt, wenn man gestalkt wird.“"
                                            },
                                            {
                                                "example_id": "7d52079c-e2c4-48a2-83e2-7d19fc238fcb",
                                                "sense_id": "7b7a4eea-0c7e-3ee9-a028-590e26b37914",
                                                "text": "„Menschen, die stalken, haben einen sehr labilen Selbstwert und sind oft Wiederholungstäter“, erklärt Diplompsychologe Jens Hoffmann."
                                            },
                                            {
                                                "example_id": "449f834c-1a03-4123-b4c0-bdb48b7245b6",
                                                "sense_id": "7b7a4eea-0c7e-3ee9-a028-590e26b37914",
                                                "text": "„Manche Ex-Freundinnen können nicht loslassen und stalken dir regelrecht hinterher.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9e60d08d-5ecf-453d-b279-587b0e9f90a9",
