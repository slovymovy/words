                                    {
                                        "sense_id": "91a5bab8-9daf-3b12-8af9-58b8fe1a404e",
                                        "entry_id": "09f95770-d4ad-333b-b1aa-91c128c56adc",
                                        "glosses": [
                                            "driedimensionaal beeld gemaakt met behulp van fotografische projectie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d413b09d-8f52-4e72-a260-f8204b101474",
                                                "sense_id": "91a5bab8-9daf-3b12-8af9-58b8fe1a404e",
                                                "text": "Het nieuwe biljet van vijftig euro is dinsdag onthuld door de Europese Centrale Bank. Het nieuwe briefje heeft, net als het eerder vernieuwde twintigje, een doorzichtig venster met daarin een hologram van de mythologische figuur Europa. Met nieuwe kenmerken moet het makkelijker worden om het biljet te controleren op echtheid."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9e29a813-fb69-4adf-8c5c-cc6c82ecc0ad",
                        "source_entry_id": "5e37be37-6f8d-382d-ad36-07f5595cae28",
                        "source_sense_id": "06ac63e6-1ae8-3b10-a548-0e618f6b4272",
