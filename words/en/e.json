            "senses": [
                {
                    "sense_id": "c0c52efa-4e6a-3cf7-ab9a-6bb94852c057",
                    "sense_definition": "The name of the fifth letter of the English alphabet, written as E or e.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "letter_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The word \"elephant\" starts with the letter <w>e</w>.",
                            "target_lang_translations": {
                                "ru": "Слово \"elephant\" начинается с буквы <w>e</w>.",
                                "zh": "单词“elephant”以字母 <w>e</w> 开头。"
                            }
                        },
                        {
                            "text": "There is a silent <w>e</w> at the end of the word \"hope\".",
                            "target_lang_translations": {
                                "ru": "В конце слова \"hope\" стоит непроизносимая <w>e</w>.",
                                "zh": "单词“hope”末尾有一个不发音的 <w>e</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "capital E",
                        "lowercase e",
                        "silent e"
                    ],
                    "target_lang_definitions": {
                        "ru": "Название пятой буквы английского алфавита, которая пишется как E или e.",
                        "zh": "英语字母表中的第五个字母，写作E或e。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "e",
                                "target_lang_sense_clarification": "буква английского алфавита"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "e",
                                "target_lang_sense_clarification": "英文字母"
                            },
                            {
                                "target_lang_word": "E",
                                "target_lang_sense_clarification": "大写英文字母"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "71999f12-c20b-33ec-93ca-e5ac9a2a1715",
                    "sense_definition": "An abbreviation for \"episode\", often used in file names or listings for TV series.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am looking for season one, <w>E</w> five of that documentary.",
                            "target_lang_translations": {
                                "ru": "Я ищу первый сезон, <w>пятую серию</w> того документального фильма.",
                                "zh": "我正在找那部纪录片的第一季第 5 <w>集</w>。"
                            }
                        },
                        {
                            "text": "The file name indicates that this is <w>E</w> ten of the series.",
                            "target_lang_translations": {
                                "ru": "Имя файла указывает, что это <w>десятая серия</w> сериала.",
                                "zh": "文件名显示这是该剧集的第 10 <w>集</w>。"
                            }
