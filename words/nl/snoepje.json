    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "779c0155-6a7e-3811-a367-f7311b772abc",
                    "sense_definition": "een klein stukje suikerwerk of lekkernij",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "snoepgoed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het kind kreeg een <w>snoepje</w> omdat het zo goed had geluisterd.",
                            "target_lang_translations": {
                                "it": "Il bambino ha ricevuto una <w>caramella</w> perché aveva ascoltato così bene."
                            }
                        },
                        {
                            "text": "In de winkel kocht ik een zakje met verschillende soorten <w>snoepjes</w>.",
                            "target_lang_translations": {
                                "it": "Al negozio ho comprato un sacchetto con diversi tipi di <w>caramelle</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "bonbon",
                        "lekkerij"
                    ],
                    "common_phrases": [
                        "een snoepje eten"
                    ],
                    "target_lang_definitions": {
                        "it": "Un piccolo pezzo di dolciume o una caramella."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "caramella",
                                "target_lang_sense_clarification": "termine generico per un piccolo dolce da succhiare o masticare"
                            },
                            {
                                "target_lang_word": "dolcetto",
                                "target_lang_sense_clarification": "termine affettuoso o diminutivo per un piccolo dolce"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5c7aba24-cc3c-3e67-a541-54ed8dbd185e",
                    "sense_definition": "een pil met drugs zoals ecstasy",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "drugs",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De politie waarschuwde voor gevaarlijke <w>snoepjes</w> die op het festival werden verkocht.",
                            "target_lang_translations": {
                                "it": "La polizia ha messo in guardia contro le pericolose <w>pasticche</w> vendute al festival."
                            }
                        },
                        {
                            "text": "Hij slikte een <w>snoepje</w> om de hele nacht door te kunnen dansen.",
                            "target_lang_translations": {
                                "it": "Ha preso una <w>pasticca</w> per poter ballare tutta la notte."
                            }
                        }
                    ],
                    "synonyms": [
                        "pil"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "gebruikt in drugsmiddens"
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Una pastiglia contenente sostanze stupefacenti, come l'ecstasy."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "pasticca",
                                "target_lang_sense_clarification": "termine gergale per indicare una pillola di droga sintetica"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "093727e6-b7aa-3112-ae18-3d25ec3ca34c",
                    "sense_definition": "verkleinwoord van <w>snoep</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "grammatica",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het woord <w>snoepje</w> is het verkleinwoord van het zelfstandig naamwoord <w>snoep</w>.",
                            "target_lang_translations": {
                                "it": "La parola <w>snoepje</w> è il diminutivo del sostantivo snoep."
                            }
                        },
                        {
                            "text": "Je vormt het meervoud van <w>snoepje</w> door er een s achter te plakken.",
                            "target_lang_translations": {
                                "it": "Si forma il plurale di <w>snoepje</w> aggiungendo una s alla fine."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "grammaticale vorm"
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Diminutivo del sostantivo 'snoep' (dolce/caramella)."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "diminutivo",
                                "target_lang_sense_clarification": "forma grammaticale che indica piccolezza o affetto"
                            }
                        ]
                    }
                }
            ]
        }
    ]
