                                        "sense_id": "f585b107-ce72-32c0-b5b9-3426cfb59726",
                                        "entry_id": "ecf371e8-0089-31c7-917c-a8fc47a5f423",
                                        "glosses": [
                                            "langes Messer mit breiter Klinge; bevorzugte Nahkampfwaffe zur See im 16. bis 19. Jahrhundert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6638b4fe-cb58-4e16-849f-14ba88071e09",
                                                "sense_id": "f585b107-ce72-32c0-b5b9-3426cfb59726",
                                                "text": "„Aus dem Entermesser als Werkzeug entstand später vermutlich die Machete, ein dickes, sehr kopflastiges Messer, welches sich hervorragend eignet, um Zuckerrohr zu schneiden oder dichte Vegetation zu lichten.“"
                                            },
                                            {
                                                "example_id": "8d18b34d-e660-4de4-9f9b-d374b0276cf9",
                                                "sense_id": "f585b107-ce72-32c0-b5b9-3426cfb59726",
                                                "text": "„Jeden Fußbreit Boden mußten wir uns mit unseren Entermessern freikämpfen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9692b74c-302d-4163-8d1a-7739e071a71f",
                        "source_entry_id": "6ebc2b23-69c7-3e4b-ac8c-2c8d472f1450",
