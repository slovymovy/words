                        "examples": [
                            {
                                "example_id": "1cb3ed11-caae-47d4-9758-35acf80dede7",
                                "sense_id": "9d71bb0f-44b0-300e-a97b-ebb0af4b387b",
                                "text": "„Aus dem Kalender wählen Sie dazu das heutige Datum aus und in der Textbox darunter geben Sie Ihren Namen ein.“"
                            },
                            {
                                "example_id": "8efa3753-9579-47d9-bed8-c173e02b93a6",
                                "sense_id": "9d71bb0f-44b0-300e-a97b-ebb0af4b387b",
                                "text": "„Erstellen Sie eine Textbox und tippen Sie die URL der Webseite ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
