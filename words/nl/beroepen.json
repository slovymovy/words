                            "text": "In deze stad zijn veel verschillende <w>beroepen</w> te vinden in de techniek.",
                            "target_lang_translations": {
                                "en": "In this city, many different <w>professions</w> can be found in technology."
                            }
                        },
                        {
                            "text": "De Joden moesten meer belasting gaan betalen en werden geweerd uit bepaalde <w>beroepen</w>.",
                            "target_lang_translations": {
