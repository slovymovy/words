                "senses": [
                    {
                        "sense_id": "373a3b4b-96f4-3b76-b5ef-3584973b197c",
                        "entry_id": "584cce9b-c855-36ae-8b96-94fb7035af34",
                        "glosses": [
                            "buitenmuur van een gebouw, in het bijzonder die aan de voorkant"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32f1fc62-f7ac-460a-832a-6cda35bb0c80",
                                "sense_id": "373a3b4b-96f4-3b76-b5ef-3584973b197c",
                                "text": "Ik liep langs gevels die waren voorzien van kantwerk van marmer."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1b762500-cc14-49aa-ac35-edf24fbee40d",
                        "source_entry_id": "584cce9b-c855-36ae-8b96-94fb7035af34",
                        "source_sense_id": "373a3b4b-96f4-3b76-b5ef-3584973b197c",
                        "source_sense_description": "buitenmuur van een gebouw",
                        "target_lang_word": "Fassade",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fassade",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0f95d7af-af2a-3124-8a56-8e9531acb8f5",
                                        "entry_id": "d07b464c-864c-341e-88cb-9a215f104be0",
                                        "glosses": [
                                            "Vorderansicht eines Gebäudes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e00c786a-bb54-4146-a104-e24d8a0b627b",
                                                "sense_id": "0f95d7af-af2a-3124-8a56-8e9531acb8f5",
                                                "text": "Die Fassaden wurden zur 100-Jahrfeier des Ortes alle erneuert."
                                            },
                                            {
                                                "example_id": "66d8ce33-c072-4ba4-a813-e846cd971719",
                                                "sense_id": "0f95d7af-af2a-3124-8a56-8e9531acb8f5",
                                                "text": "„Ehe sie das Haus betritt, wandert ihr Blick an der Fassade hoch.“"
                                            },
                                            {
                                                "example_id": "eba1b674-6ef4-4bf1-9fd0-de41cbbd6766",
                                                "sense_id": "0f95d7af-af2a-3124-8a56-8e9531acb8f5",
                                                "text": "„Für die Fassaden stellt sich Kister eine Holzfront und farbige Elemente, etwa bunte Fensterläden, vor.“"
                                            },
                                            {
                                                "example_id": "8da95309-c14d-4ac7-a115-0e97a5a48f0f",
                                                "sense_id": "0f95d7af-af2a-3124-8a56-8e9531acb8f5",
                                                "text": "„Die Fassade des ehrwürdigen, in der Renaissance errichteten Alten Rathauses mit seiner Fassadenmalerei war von Splittereinschlägen übersät.“"
                                            },
                                            {
                                                "example_id": "1a810f84-f5de-42e7-9ed9-2dab47b3b551",
                                                "sense_id": "0f95d7af-af2a-3124-8a56-8e9531acb8f5",
                                                "text": "„Die grauen Fassaden von Autun werden lebendig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "013953f8-0a03-3dae-9819-e9ee3ee87dc7",
                                        "entry_id": "d07b464c-864c-341e-88cb-9a215f104be0",
                                        "glosses": [
                                            "sichtbare, äußere Seite, das Äußere"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd3f0253-17a7-4c36-a877-d0c51bdd7438",
                                                "sense_id": "013953f8-0a03-3dae-9819-e9ee3ee87dc7",
                                                "text": "Hinter der frommen Fassade verbirgt sich ein kleines Teufelchen."
                                            },
                                            {
                                                "example_id": "75ad0b85-08cf-4ac3-9b10-cb0fec336d6d",
                                                "sense_id": "013953f8-0a03-3dae-9819-e9ee3ee87dc7",
                                                "text": "Ich würde gerne hinter ihre Fassade schauen."
                                            },
                                            {
                                                "example_id": "3ebf4752-1f44-432b-8164-997a008a9dca",
                                                "sense_id": "013953f8-0a03-3dae-9819-e9ee3ee87dc7",
                                                "text": "„Von der Volkskirche ist heute bestenfalls noch die Fassade übrig: wir gehen zu Weihnachten, Hochzeiten und Beerdigungen in die Kirche, aber sonst?“"
                                            },
                                            {
                                                "example_id": "f5c0130c-65e0-4a33-ae30-efb8f3987d82",
                                                "sense_id": "013953f8-0a03-3dae-9819-e9ee3ee87dc7",
                                                "text": "„Frauen im Libanon kleiden sich modern und wirken selbstbewusst. Doch trotz der modernen Fassade ist der Libanon auch eine sehr patriarchalische Gesellschaft: Frauen sind alles andere als gleichberechtigt.“"
                                            },
                                            {
                                                "example_id": "80c06b48-92df-4f8f-8cf9-5022c91be882",
                                                "sense_id": "013953f8-0a03-3dae-9819-e9ee3ee87dc7",
                                                "text": "„Man spricht in solchen Situationen davon, dass der demenzkranke Mensch eine gute Fassade aufrechterhalten kann. […] Als Angehörige kann mich die gute Fassade des Kranken in äußerst unangenehme Situationen bringen.“"
                                            },
                                            {
                                                "example_id": "a06402aa-ee0a-4d7a-904d-e37c6168b208",
                                                "sense_id": "013953f8-0a03-3dae-9819-e9ee3ee87dc7",
                                                "text": "„Nichts war geblieben als Fassaden, wie auf den Bildern von Chirico, Fassaden mit Türen und Fenstern, die noch halb in den Scharnieren hingen und sich nicht zu einem Haushalt öffneten, sondern zu Familien, die unter dem Himmel hausten, vor Fremden nur durch eine Wand und eine Tür geschützt und auf den anderen drei Seiten ohne Wände und Dach.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1ea6a2da-acca-33de-9cf3-41553c40c3c8",
                                        "entry_id": "d07b464c-864c-341e-88cb-9a215f104be0",
                                        "glosses": [
                                            "Entwurfsmuster, das eine häufig benötigte Untermenge an Funktionalität eines Subsystems umfasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5cd46be1-3276-458c-b73e-dc80d089f457",
                                                "sense_id": "1ea6a2da-acca-33de-9cf3-41553c40c3c8",
                                                "text": "„Die Fassade kapselt die verschiedenen Technologien und Konzepte ein und stellt eine praktische Sicht der Funktionalität bereit ([…]).“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2d2518e3-1035-47db-914e-7c0023086138",
                        "source_entry_id": "584cce9b-c855-36ae-8b96-94fb7035af34",
                        "source_sense_id": "373a3b4b-96f4-3b76-b5ef-3584973b197c",
                        "source_sense_description": "buitenmuur van een gebouw",
                        "target_lang_word": "façade",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "façade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "24beed72-9c8b-3e4a-bbfe-660f7c1e7464",
                                        "entry_id": "f2447977-81f5-3374-83e0-ea8e66bb90e2",
                                        "glosses": [
                                            "Alternative form of facade."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b49d30d1-2d28-46a0-8821-6e5b67c4b219",
                                                "sense_id": "24beed72-9c8b-3e4a-bbfe-660f7c1e7464",
                                                "text": "If Euston is not typically English, St. Pancras is. Its façade is a nightmare of improbable Gothic. It is fairly plastered with the aesthetic ideals of 1868, and the only beautiful thing about it is Barlow's roof. It is haunted by the stuffier kind of ghost. Yet there is something about the ordered whole of St. Pancras that would make demolition a terrible pity."
                                            },
                                            {
                                                "example_id": "85e537af-b95d-4f54-9c39-e3ccb2278f5b",
                                                "sense_id": "24beed72-9c8b-3e4a-bbfe-660f7c1e7464",
                                                "text": "he wanted to know who she was deep down inside, the real Penny behind the pleasant, people-pleasing façade, as was her fate as a woman and mother"
                                            },
                                            {
                                                "example_id": "4dd7cae4-0c26-4bfe-883c-ac0711cae5a5",
                                                "sense_id": "24beed72-9c8b-3e4a-bbfe-660f7c1e7464",
                                                "text": "From the 4th Century BCE onwards, the Lycians built rock-hewn \"house\" tombs – often funeral chambers carved into cliffs, with the rock face around the doorway cut to imitate the façade of a wooden Lycian house, complete with \"timbers\" and protruding \"joists\"."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "af4ae4e7-dd44-4786-888a-a458645ab21d",
                        "source_entry_id": "584cce9b-c855-36ae-8b96-94fb7035af34",
                        "source_sense_id": "373a3b4b-96f4-3b76-b5ef-3584973b197c",
                        "source_sense_description": "buitenmuur van een gebouw",
                        "target_lang_word": "gable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8a42a7ec-af6a-33de-9e43-6e7d21baf543",
                                        "entry_id": "955dfdb8-f6b4-3c6c-afa2-c1472657c9f9",
                                        "glosses": [
                                            "The triangular area at the peak of an external wall adjacent to, and terminating, two sloped roof surfaces (pitches)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7437eb0-83e9-4210-9a54-1b2ed58d4622",
                                                "sense_id": "8a42a7ec-af6a-33de-9e43-6e7d21baf543",
                                                "text": "It was a queer sort of place—a gable-ended old house, one side palsied as it were, and leaning over sadly."
                                            },
                                            {
                                                "example_id": "0a166f3c-3bd9-4996-9236-20c653e0dd2d",
                                                "sense_id": "8a42a7ec-af6a-33de-9e43-6e7d21baf543",
                                                "text": "Although there were important developments in the internal organization of Cape houses during this period, their most obvious element is the gable. End-gables were common in medieval northern European and particularly Dutch buildings, but central gables set into the long side of roofs were more unusual and became the quintessential feature of the Cape Dutch style."
                                            },
                                            {
                                                "example_id": "97301e7e-3a82-4c68-b81d-2c127d21d1f7",
                                                "sense_id": "8a42a7ec-af6a-33de-9e43-6e7d21baf543",
                                                "text": "Qionglin Village in Kinhu with its well-preserved ancestral halls, arches, and old Fujian-style houses with interesting gables is famous for having more shrines than any other village on Kinmen."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "70a51b81-77df-326c-8b32-587f3ff23060",
                                        "entry_id": "37a8c679-3fff-301c-8611-bde95140eed7",
                                        "glosses": [
                                            "A cable."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f8454b9-be57-4207-a26f-683bb0874381",
                                                "sense_id": "70a51b81-77df-326c-8b32-587f3ff23060",
                                                "text": "First, striking sail, their tacklings then they loosed.\nAnd (with their gables stoop'd) their mast imposed\nInto the mast-room."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f7d8bce3-428d-4bc7-9a8f-90e8af1f1502",
                        "source_entry_id": "584cce9b-c855-36ae-8b96-94fb7035af34",
                        "source_sense_id": "373a3b4b-96f4-3b76-b5ef-3584973b197c",
                        "source_sense_description": "buitenmuur van een gebouw",
                        "target_lang_word": "façade",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "façade",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "54ad7828-2b78-317d-b526-e106c7c0632c",
                                        "entry_id": "840b50be-7735-3398-a424-3c7677cb5feb",
                                        "glosses": [
                                            "Un des côtés d’un bâtiment, d’un édifice, lorsqu’il se présente au spectateur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84b4ef35-09ce-495f-ab03-0877bf6f4a4b",
                                                "sense_id": "54ad7828-2b78-317d-b526-e106c7c0632c",
                                                "text": "Les quatre façades de la maison close brûlaient en même temps et celle qui bordait le pont Saint-Michel vomissait des flammes par toutes les ouvertures."
                                            },
                                            {
                                                "example_id": "12827f0f-7f4c-43e7-b9be-28dca4200737",
                                                "sense_id": "54ad7828-2b78-317d-b526-e106c7c0632c",
                                                "text": "Manuelle Gautrand, elle, propose des structures en verre massif, conçues à partir de façades vitrées recyclées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b44c32c-a4a2-3def-9933-52c22a854c0c",
                                        "entry_id": "840b50be-7735-3398-a424-3c7677cb5feb",
                                        "glosses": [
                                            "Le côté où se trouve l'entrée principale."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7a61e9c-0003-453c-9124-be6d16b4468e",
                                                "sense_id": "5b44c32c-a4a2-3def-9933-52c22a854c0c",
                                                "text": "Sur la rue, la maison présentait cette façade de moellons ravalée en plâtre, ondée par le temps et rayée par le crochet du maçon de manière à figurer des pierres de taille."
                                            },
                                            {
                                                "example_id": "7841dc13-c7c2-4f0b-a5dc-23d11c07d991",
                                                "sense_id": "5b44c32c-a4a2-3def-9933-52c22a854c0c",
                                                "text": "De style ogival flamboyant, à ornementation très fouillée, surtout dans la façade et les tours, ses arcs-boutants, ses clochetons, ses pinacles gothiques sont remarquables."
                                            },
                                            {
                                                "example_id": "c67dd768-30d8-47c8-b987-6eb518171a06",
                                                "sense_id": "5b44c32c-a4a2-3def-9933-52c22a854c0c",
                                                "text": "Sa maison était propre, bien tenue; elle tranchait avec la blancheur gaie de sa façade et le luisant de ses meubles, sur les taudis immondes où, d’ordinaire, croupissent dans la fange et dans la vermine, les marins bretons."
                                            },
                                            {
                                                "example_id": "0cfcd752-016a-42f9-8fa7-09f618403a04",
                                                "sense_id": "5b44c32c-a4a2-3def-9933-52c22a854c0c",
                                                "text": "Mon hôtel, en façade sur l’une des principales voies, a vraiment noble allure : des portiers corrects gardent son huis."
                                            },
                                            {
                                                "example_id": "46f99b43-1c6e-4afe-bec8-52abe8d16f28",
                                                "sense_id": "5b44c32c-a4a2-3def-9933-52c22a854c0c",
                                                "text": "[…], et une peinture sous verre, fixée sur la façade, représentait une femme appétissante aux yeux noirs qui, frileusement, s’emmitouflait de fourrures."
                                            },
                                            {
                                                "example_id": "34a19efa-4aa8-4ee6-97ea-f392ba9042fb",
                                                "sense_id": "5b44c32c-a4a2-3def-9933-52c22a854c0c",
                                                "text": "Émile vit dans une ville, petite, quiète, une ville aux rues propres, aux trottoirs nets et les façades des maisons rénovées, […]."
                                            },
                                            {
                                                "example_id": "fe6c9ee2-2c0f-41c4-bdef-73246f71455e",
                                                "sense_id": "5b44c32c-a4a2-3def-9933-52c22a854c0c",
                                                "text": "Aussi, je me cachai derrière la première, à l’angle de la rue, dotée d’un gazon envahi par les mauvaises herbes et d’un grand lantana aux fleurs rouge et jaune couvertes de poussière qui luttait sur la façade contre un chèvrefeuille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32153450-c54d-357f-9e48-4fed44bbb6fe",
                                        "entry_id": "840b50be-7735-3398-a424-3c7677cb5feb",
                                        "glosses": [
                                            "Face des murs en contact avec l’extérieur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "627ca1ee-9c46-48c1-aa18-ade524d9305b",
                                                "sense_id": "32153450-c54d-357f-9e48-4fed44bbb6fe",
                                                "text": "Isolation des façades d’une maison."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd654b65-04e7-3e00-8819-c157aad1408f",
                                        "entry_id": "840b50be-7735-3398-a424-3c7677cb5feb",
                                        "glosses": [
                                            "Apparence qui trompe sur la réalité."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8370328e-f328-41cd-af5e-71be8c11c228",
                                                "sense_id": "fd654b65-04e7-3e00-8819-c157aad1408f",
                                                "text": "Talent qui n’est qu’en façade."
                                            },
                                            {
                                                "example_id": "aa996b3a-0d5c-4a9f-89b5-45e4d8bbe787",
                                                "sense_id": "fd654b65-04e7-3e00-8819-c157aad1408f",
                                                "text": "Cet homme est tout en façade."
                                            },
                                            {
                                                "example_id": "754e8062-43e4-4c7f-a7d5-26ce3c0c8fbf",
                                                "sense_id": "fd654b65-04e7-3e00-8819-c157aad1408f",
                                                "text": "Derrière une satisfaction de façade, voter cette motion dut être pénible à beaucoup de sénateurs à une époque où l’avènement de Claude demeurait une blessure ouverte."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7ad0c1b0-48f8-4191-a516-fa09cc75e70a",
                        "source_entry_id": "584cce9b-c855-36ae-8b96-94fb7035af34",
                        "source_sense_id": "373a3b4b-96f4-3b76-b5ef-3584973b197c",
                        "source_sense_description": "buitenmuur van een gebouw",
                        "target_lang_word": "pignon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pignon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0a6386e4-bad2-36f9-aa65-9ea2a3219e31",
                                        "entry_id": "3b70d10c-74d4-30d4-b9ce-635a9a368aba",
                                        "glosses": [
                                            "Roue dentée faisant partie d’un système à chaîne (inventée en 1880) ou d’un couple d’engrenage dans un système de transmission ou un réducteur. Le pignon est la roue dentée qui a le plus petit nombre de dents."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd95f3de-b37e-4bf6-9e26-ea529a5db7d5",
                                                "sense_id": "0a6386e4-bad2-36f9-aa65-9ea2a3219e31",
                                                "text": "Deux grands défauts qu’on doit éviter dans un engrenage, c’est qu’il soit trop fort ou trop faible. Dans le premier cas, les dents de la roue sont sujettes à quoter, c’est-à-dire, que les deux pointes de deux dents voisines vont toucher les deux faces opposées des deux ailes du pignon ; de sorte que ni la roue, ni le pignon ne peuvent se mouvoir."
                                            },
                                            {
                                                "example_id": "b294a192-52cf-45a4-a50f-9452d72f824d",
                                                "sense_id": "0a6386e4-bad2-36f9-aa65-9ea2a3219e31",
                                                "text": "La disposition à engrenages planétaires comporte un pignon central monté directement sur l’arbre du moteur, un équipage de satellites et une couronne fixe dans laquelle les satellites engrènent en tournant sur eux-mêmes."
                                            },
                                            {
                                                "example_id": "b9af8f46-fbc3-4ff6-b985-2a5323642f3f",
                                                "sense_id": "0a6386e4-bad2-36f9-aa65-9ea2a3219e31",
                                                "text": "À Scionzier, en août 1852, l'altercation se déroule dans l'auberge, à 22 h 30, jour de la vogue, en « fin de veillée. » Quatre jeunes gens, tous fabricants de pignons de montre, entonnent « La République en Savoie règnera » au nez des carabiniers présents dans la salle."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pignon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7dc21f48-535b-3f39-932d-a9be7a1edad7",
                                        "entry_id": "318b2616-0868-3e98-85b2-9e0b66486c51",
                                        "glosses": [
                                            "Partie supérieure d’un mur qui se termine en pointe et dont le sommet porte le bout du faîtage d’un comble à deux pentes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11a06377-74b6-4fec-bca7-83f159421da5",
                                                "sense_id": "7dc21f48-535b-3f39-932d-a9be7a1edad7",
                                                "text": "Termonde était vide. Termonde n’était plus. Çà et là, un pignon subsistait, ou un monument, pour montrer que sur cet emplacement avait fleuri une cité."
                                            },
                                            {
                                                "example_id": "093ebe36-d5b9-4c73-81c5-5d3c26609b40",
                                                "sense_id": "7dc21f48-535b-3f39-932d-a9be7a1edad7",
                                                "text": "[…] ; des pignons s’effritent comme de vieux chicots, une étable n’est plus qu’un amas de pierrailles ; […]."
                                            },
                                            {
                                                "example_id": "d6e5927c-f931-4773-91e6-d17da4bf8eb6",
                                                "sense_id": "7dc21f48-535b-3f39-932d-a9be7a1edad7",
                                                "text": "On aurait dit un morceau d'image d'Epinal, avec de petites maisons à pignon aigu et ancien, des lointains tout en hachures, des clochetons grêles et mignons."
                                            },
                                            {
                                                "example_id": "8ce5ab20-850c-45c7-b513-5cece8b693fa",
                                                "sense_id": "7dc21f48-535b-3f39-932d-a9be7a1edad7",
                                                "text": "Cela occupait pourtant une bien petite place dans le lointain, ce quelque chose, mais c’était une silhouette extraordinaire : le pignon d’une vieille maison, avec une espèce de cheminée démolie, le tout ayant un profil d’animal, une ressemblance de loup."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pignon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8e32bf9b-65d2-383c-a797-978b5d057a6a",
                                        "entry_id": "6c3eff5d-5f56-3aae-b1fc-1c25e753c0a0",
                                        "glosses": [
                                            "Pin pignon, pin parasol, Pinus pinea."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb372262-28ac-4dc4-9aaa-db67e6567ffe",
                                                "sense_id": "8e32bf9b-65d2-383c-a797-978b5d057a6a",
                                                "text": "De place en place, une dune ressort sur cette platitude, donnant sa note propre avec ses grands pignons ou ses buissons de tamaris, seuls à résister au vent de la côte, et parfois de véritables bois comme cette extraordinaire génévraie des Bièges."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f5df388-b2b4-32b7-b209-716edb7ed410",
                                        "entry_id": "6c3eff5d-5f56-3aae-b1fc-1c25e753c0a0",
                                        "glosses": [
                                            "Amande de la pomme de pin du pin parasol"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d818c812-353c-4bc2-8400-6898102c660c",
                                                "sense_id": "7f5df388-b2b4-32b7-b209-716edb7ed410",
                                                "text": "À Malte, le prinjolata est un gâteau fait à base de biscuits à la cuiller, cerises glacées et pignons."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pignon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6dae58bb-5cf4-3b5c-aa6b-65173b7391e5",
                                        "entry_id": "bebaf6dd-13ce-3064-a2be-b619326644e6",
                                        "glosses": [
                                            "Telline, coquillage bivalve du bord de mer, synonyme de haricot de mer (espèce d’animaux)."
                                        ],
                                        "tags": [
                                            "Vendée"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "603b6411-c686-492b-81c7-81fc6ff2af3f",
                                                "sense_id": "6dae58bb-5cf4-3b5c-aa6b-65173b7391e5",
                                                "text": "La pêche aux pignons."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
