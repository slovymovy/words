                        "cross_references": [
                            {
                                "target_word": "вы́пуск",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f791e9c3-78ee-3d48-9859-99c39bff134e",
                                        "entry_id": "2c8c150a-0f14-3001-a924-cd3571159e2b",
                                        "glosses": [
                                            "действие по значению гл. выпускать; производство, выдача"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da3a04c2-6c0a-4b8e-8a6d-022e04d5e7c9",
                                                "sense_id": "f791e9c3-78ee-3d48-9859-99c39bff134e",
                                                "text": "Вслед за компаниями, прибегнувшими к выпуску облигаций, потянулись российские регионы."
                                            },
                                            {
                                                "example_id": "3dcbbdce-6061-4549-9064-396dc2a33acf",
                                                "sense_id": "f791e9c3-78ee-3d48-9859-99c39bff134e",
                                                "text": "В межотраслевом балансе связь между выпуском и конечным использованием продукции описывается тождеством."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e54823ad-d4a7-3afd-b77f-44ee442020b3",
                                        "entry_id": "2c8c150a-0f14-3001-a924-cd3571159e2b",
                                        "glosses": [
                                            "совокупность объектов, появляющихся в результате такого действия"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a3345096-f5b1-3332-86f7-be0cd8634b6e",
                                        "entry_id": "2c8c150a-0f14-3001-a924-cd3571159e2b",
                                        "glosses": [
                                            "совокупность объектов, появляющихся в результате такого действия",
                                            "группа учащихся, одновременно закончивших учебное заведение, курс"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f0e6b93-1965-453f-bf66-bc4dfdf26983",
                                                "sense_id": "a3345096-f5b1-3332-86f7-be0cd8634b6e",
                                                "text": "Хотелось бы, чтобы и учителя вспоминали наш выпуск чаще всего с улыбкой."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fee5335e-a30d-399b-a3a6-9bd148115471",
                                        "entry_id": "2c8c150a-0f14-3001-a924-cd3571159e2b",
                                        "glosses": [
                                            "совокупность объектов, появляющихся в результате такого действия",
                                            "отдельный номер периодического издания, отдельная радио- или телепередача и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cf17599-5551-4967-a15b-d5bae1efced5",
                                                "sense_id": "fee5335e-a30d-399b-a3a6-9bd148115471",
                                                "text": "В прошлом выпуске программы \"Намедни\" Леонид Парфенов сделал первый публичный выпад в сторону нового гендиректора канала."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c934f852-6804-3748-a9c4-c0e731fff293",
                                        "entry_id": "2c8c150a-0f14-3001-a924-cd3571159e2b",
                                        "glosses": [
                                            "совокупность объектов, появляющихся в результате такого действия",
                                            "фин., экон. пакет ценных бумаг"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "625f6766-b927-4f19-81f9-c558561f84be",
                                                "sense_id": "c934f852-6804-3748-a9c4-c0e731fff293",
                                                "text": "При размещении 5-й серии ОФЗ объем поданных заявок в два раза превышал номинальный выпуск, и Министерство финансов пошло на существенное повышение цены отсечения размещенного выпуска."
                                            }
