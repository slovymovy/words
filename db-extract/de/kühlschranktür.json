                ],
                "senses": [
                    {
                        "sense_id": "5bc75b9f-8fc3-35c2-8d98-5c11513aebe2",
                        "entry_id": "e1921c3d-195d-3f96-9107-728d1c88f17c",
                        "glosses": [
                            "Tür vom Kühlschrank; das Element womit der Kühlschrank geöffnet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "157e02c5-a9e5-4210-9016-3d20a5fc4720",
                                "sense_id": "5bc75b9f-8fc3-35c2-8d98-5c11513aebe2",
                                "text": "„Die Kühlschranktür drückt beim Zuklappen auf einen Schalter und schon ist es dunkel im Kühlschrank.“"
                            },
                            {
                                "example_id": "df04cb37-2a60-4f89-be08-51bc2a372780",
                                "sense_id": "5bc75b9f-8fc3-35c2-8d98-5c11513aebe2",
                                "text": "„[…] Doch nur Bierholer-Anfänger nutzen eine Elfmeterunterbrechung - und werden häufig genug an der Kühlschranktür vom Torschrei eingeholt.“"
                            },
                            {
                                "example_id": "1f4d231a-1502-4568-8f27-d8b787607377",
                                "sense_id": "5bc75b9f-8fc3-35c2-8d98-5c11513aebe2",
                                "text": "„Entweder fresse ich aus dem Napf oder ich mach die Kühlschranktür auf.“"
                            },
                            {
                                "example_id": "9a3d44d7-b032-4485-830e-6cae2f0f9cd8",
                                "sense_id": "5bc75b9f-8fc3-35c2-8d98-5c11513aebe2",
                                "text": "„Wenn man die Kühlschranktür aufmacht und es nicht mal mehr für ein Butterbrot reicht. Genauso wie beim Leergut-Kabuff, nur umgekehrt.“"
                            },
                            {
                                "example_id": "a048937b-8e72-4f59-a945-f1e0a9c813ea",
                                "sense_id": "5bc75b9f-8fc3-35c2-8d98-5c11513aebe2",
                                "text": "„[…] Drinnen ist vieles von Computern gesteuert, das Haus kann weit mehr, als Jacques Tati in seinem Film Mon Oncle zu fürchten wagte: Die Kühlschranktür öffnet sich auf eine Winkbewegung hin, die Wassertemperatur im Badezimmer wird über Sensoren gesteuert, das Klima in diesem luftigen, an Wänden armen Haus kann je nach Etage kühler oder wärmer eingestellt werden – und das lässt sich sogar vom Computer im Gästehaus aus steuern, in das sich Sobeks erwachsener Sohn dauerhaft zurückgezogen hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
