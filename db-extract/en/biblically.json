                        "examples": [
                            {
                                "example_id": "3380d8f0-fadb-41bf-83af-ae651eff4903",
                                "sense_id": "fcbde923-fbd4-3ee9-8378-c18993f1afdf",
                                "text": "He is now in practice, and must be past the midway point of the Biblically allotted span of man’s life."
                            },
                            {
                                "example_id": "6b7b9eed-3f89-4ea2-b0ab-ab37c9e9fff9",
                                "sense_id": "fcbde923-fbd4-3ee9-8378-c18993f1afdf",
                                "text": "“We’re a Biblically illiterate community,” acknowledges the Rev. Randall Updegraff Spleth, the 34-year-old pastor of booming Geist Disciples of Christ Church in Indiana."
                            },
                            {
                                "example_id": "2aa71c2c-a962-4b3a-897a-73be3dc75961",
                                "sense_id": "fcbde923-fbd4-3ee9-8378-c18993f1afdf",
                                "text": "Freyda had cursed her then, with a hatred so venomous, so long-stifled, so Biblically intense that she had immediately repressed the exact words her friend said."
                            },
                            {
                                "example_id": "17f9d9b2-17b4-4e6c-b600-2aa39245196a",
                                "sense_id": "fcbde923-fbd4-3ee9-8378-c18993f1afdf",
                                "text": "It [the number 17] has importance in both of the math realm and Biblically."
                            }
                        ]
                    }
