                            {
                                "target_word": "commanding",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "488fc3c5-2bfb-39b5-9507-06911bd108b3",
                                        "entry_id": "53a662c6-5344-34ac-ad0e-eff159e2222f",
                                        "glosses": [
                                            "The act of giving a command."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "603837c3-5ceb-4dc0-aa17-a340a7b94eda",
                                                "sense_id": "488fc3c5-2bfb-39b5-9507-06911bd108b3",
                                                "text": "God could then have dispelled their ignorance by revealing to them that He had issued those commands; the fact of the occurrence of the earlier commandings would be the content of the revelation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
