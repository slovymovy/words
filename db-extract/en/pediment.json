    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "9c4dabe4-5d5c-39ea-a1c7-c7ceb0b86b7c",
                "word": "pediment",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "5e967b67-7606-4cbc-a9aa-a797546f0a62",
                        "entry_id": "9c4dabe4-5d5c-39ea-a1c7-c7ceb0b86b7c",
                        "tags": [
                            "plural"
                        ],
                        "form": "pediments"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "950780eb-1a54-33e6-aa2e-d82708014c84",
                        "entry_id": "9c4dabe4-5d5c-39ea-a1c7-c7ceb0b86b7c",
                        "glosses": [
                            "A classical architectural element consisting of a triangular section or gable found above the horizontal superstructure (entablature) which lies immediately upon the columns; fronton."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d8f82f1-35b1-453c-8134-87e9598250e6",
                                "sense_id": "950780eb-1a54-33e6-aa2e-d82708014c84",
                                "text": "Passing the Congregation Shearith Israel on Central Park West (a white whale of a building with a triangular pediment supported by four count ’em four massive Corinthian columns), Professor Solanka scurrying through the downpour remembered the newly bat-mitzvahed thirteen-year-old girl he’d glimpsed through the side door, […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "4f384aa1-eff4-3dce-bda5-fe6390e03fa5",
                        "entry_id": "9c4dabe4-5d5c-39ea-a1c7-c7ceb0b86b7c",
                        "glosses": [
                            "A very gently sloping (0.5°-7°) inclined bedrock surface."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "63cb84b0-71cf-480d-b4f7-0546ff53ec02",
                        "source_entry_id": "9c4dabe4-5d5c-39ea-a1c7-c7ceb0b86b7c",
                        "source_sense_description": "architectural element",
                        "target_lang_word": "fronton",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fronton",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "ec7adc73-552a-327d-8b45-f33927aefa9f",
                                        "entry_id": "cf272a63-f8f5-35a5-9031-a98478d8c892",
                                        "glosses": [
                                            "driehoekige gevelbekleding in de classicistische bouwstijl als bekroning van raam, deur of gevel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4950f85-4702-4f0b-b924-3db873901859",
                                                "sense_id": "ec7adc73-552a-327d-8b45-f33927aefa9f",
                                                "text": "Scamozzi was een puritein. Hij gruwde van de fratsen die maniëristen als Michelangelo uithaalden met de klassieke bouwkunst, zoals gebroken frontons of gedraaide zuilen. Hij beschouwde zijn architectuur als een terugkeer naar de oorspronkelijke bouwkunst van de oude Romeinen. Ongetwijfeld was Scamozzi’s soberheid een derde reden voor zijn populariteit onder architecten van de calvinistische republiek."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb433f5b-eeba-3b9b-9517-61675fefc04f",
                                        "entry_id": "cf272a63-f8f5-35a5-9031-a98478d8c892",
                                        "glosses": [
                                            "met lijsten omgeven gevelplaat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a87568f0-5643-4122-973f-b4150550ef40",
                                                "sense_id": "bb433f5b-eeba-3b9b-9517-61675fefc04f",
                                                "text": "Wij zoeken culinaire troost bij de poffertjestent. `Poffertjes, wafelen en ververschingen' staat op het fronton van de authentieke reizende poffertjestent geschilderd."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4f7608b7-a1cf-423d-84d4-644cee838117",
                        "source_entry_id": "9c4dabe4-5d5c-39ea-a1c7-c7ceb0b86b7c",
                        "source_sense_description": "architectural element",
                        "target_lang_word": "fronton",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fronton",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "05017735-1368-3a37-8da2-6d7f81fa78c8",
                                        "entry_id": "9711238f-eac6-3703-8716-ff7d6f0eb8b5",
                                        "glosses": [
                                            "Ornement d’architecture qui est fait habituellement en triangle et qui se met en haut de l’entrée principale d’un bâtiment, au-dessus des portes, des croisées, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5533148-78e7-47ac-817f-8a2bea4d19c3",
                                                "sense_id": "05017735-1368-3a37-8da2-6d7f81fa78c8",
                                                "text": "Elle offre aussi un visage sobrement néo-classique avec trois arcades et un fronton à horloge."
                                            },
                                            {
                                                "example_id": "302e65ec-1625-423a-a4a5-17ec28293e1f",
                                                "sense_id": "05017735-1368-3a37-8da2-6d7f81fa78c8",
                                                "text": "Il y a quelques années, florissait, orgueil de nos boulevards, certain vaste et lumineux café, situé presque en face d’un de nos théâtres de genre, dont le fronton rappelle celui d’un temple païen."
                                            },
                                            {
                                                "example_id": "06299166-1ab0-44fd-bd65-370105a8d73f",
                                                "sense_id": "05017735-1368-3a37-8da2-6d7f81fa78c8",
                                                "text": "Depuis quelques années, des commerçants constatent le vol des lettres « U » sur le fronton de leur boutique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbafae26-d025-3c68-9741-4989e6adf3a9",
                                        "entry_id": "9711238f-eac6-3703-8716-ff7d6f0eb8b5",
                                        "glosses": [
                                            "Mur sur lequel frappe la pelote."
                                        ],
                                        "tags": [
                                            "Pelote basque"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "48975569-10b5-3906-94eb-b7652e14f28b",
                                        "entry_id": "9711238f-eac6-3703-8716-ff7d6f0eb8b5",
                                        "glosses": [
                                            "Terrain où l’on pratique la pelote basque."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0200aa58-5a00-484d-b2a6-ea11f96ca5af",
                                                "sense_id": "48975569-10b5-3906-94eb-b7652e14f28b",
                                                "text": "Il longeait le terrain de sport, celui des jeux pour enfants, les courts de tennis et le fronton de pelote basque."
                                            },
                                            {
                                                "example_id": "927f29cf-95c3-4f56-a250-4e8de5384f7b",
                                                "sense_id": "48975569-10b5-3906-94eb-b7652e14f28b",
                                                "text": "Au Pays basque, le fronton fait souvent office de place centrale du village."
                                            },
                                            {
                                                "example_id": "7a2e0b31-5fbb-40cc-b35e-5184f7956fcd",
                                                "sense_id": "48975569-10b5-3906-94eb-b7652e14f28b",
                                                "text": "En Provence, surtout dans le pays grassois, on jouait à la pelote provençale (à l'origine jeu de paume) également sur un fronton, mais à main nue."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fronton",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5833dd98-8007-3cb3-b02d-d6b1c0f20e56",
                                        "entry_id": "b4cfed4d-1c93-362e-aa23-831be9ee3f3f",
                                        "glosses": [
                                            "Relatif à Fronton (Haute-Garonne), commune française, située dans le département de la Haute-Garonne et à son vignoble."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b73c8b36-242b-4b85-88b4-fc59f1b1ddec",
                                                "sense_id": "5833dd98-8007-3cb3-b02d-d6b1c0f20e56",
                                                "text": "Nous sommes l'unique cave coopérative de l'appellation fronton."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "74a96e54-773c-453d-b55c-d9202739b7b9",
