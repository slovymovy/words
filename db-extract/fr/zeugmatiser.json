                "senses": [
                    {
                        "sense_id": "a3106dab-7ceb-3a58-9fb0-8e465c83c6b9",
                        "entry_id": "9639beeb-4542-3a18-80f0-4ab20a6ec55e",
                        "glosses": [
                            "Pratiquer la figure de style appelée zeugme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90fbc045-3f7e-482a-9661-88b9ca7976e6",
                                "sense_id": "a3106dab-7ceb-3a58-9fb0-8e465c83c6b9",
                                "text": "Il a pu le penser, pour s'engager ainsi auprès de la purpurine porte, après avoir bouclé l'autre (là, je zeugmatise)."
                            },
                            {
                                "example_id": "72e397e1-9cac-4682-82f0-196b7550dc96",
                                "sense_id": "a3106dab-7ceb-3a58-9fb0-8e465c83c6b9",
                                "text": "Chez nous, on expertise et on zeugmatise."
                            }
                        ]
                    },
                    {
                        "sense_id": "42f8696f-0aaf-30eb-9796-9f33efe07be7",
                        "entry_id": "9639beeb-4542-3a18-80f0-4ab20a6ec55e",
                        "glosses": [
                            "Adapter pour en faire un zeugme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb13e439-73be-4ef7-a256-761875380b8a",
                                "sense_id": "42f8696f-0aaf-30eb-9796-9f33efe07be7",
                                "text": "Un zeugma serait plutôt du genre \"si je passais un jour à Seattle et à la casserole\", je n'en vois pas trop avec \"ça m'étonnerait\" qui est plutôt une proposition finie qui ne se décline pas avec plusieurs possibilités qu'on peut zeugmatiser."
                            }
                        ]
                    }
