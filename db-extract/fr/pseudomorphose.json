                    {
                        "sense_id": "f4cddfa8-15e8-3821-8727-d21a51332961",
                        "entry_id": "5968f0f1-edc7-3e3a-8913-1ce039c8897b",
                        "glosses": [
                            "Substitution d'un minéral à un autre, dont il épouse la forme extérieure ou le résultat de cette substitution."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86f81d9f-1d04-4570-bd91-db6091586bff",
                                "sense_id": "f4cddfa8-15e8-3821-8727-d21a51332961",
                                "text": "Un cristal peut être peu à peu modifié chimiquement et converti en une autre substance sans changer simultanément sa forme; le corps que nous rencontrons a donc un autre faciès que celui qu'il devrait avoir ; on appelle pseudomorphose ce phénomène de forme fausse."
                            },
                            {
                                "example_id": "aec31b19-cef8-4253-95ad-0640da48a7f7",
                                "sense_id": "f4cddfa8-15e8-3821-8727-d21a51332961",
                                "text": "Les pseudomorphoses peuvent se former par une désorganisation et un réarrangement des mêmes atomes (paramorphose), par un léger changement de composition, par un enduit sur un autre cristal, ou par un remplacement complet par un minéral entièrement différent."
                            }
                        ]
                    }
                ],
