                        "examples": [
                            {
                                "example_id": "25f949c5-6216-407d-ac9d-7549756b7a00",
                                "sense_id": "7c883695-0735-3a7e-b00f-1fe5c1e20978",
                                "text": "„Beim Schreinern in der 9. Klasse beispielsweise erziehen sich die Schülerinnen und Schüler durch das exakte Arbeiten an einer Zinkverbindung selbst zur Genauigkeit.“"
                            },
                            {
                                "example_id": "83639fb4-14a4-40c1-a78b-0c61c9f81032",
                                "sense_id": "7c883695-0735-3a7e-b00f-1fe5c1e20978",
                                "text": "„Die Zinkverbindung ist als Vogelschutz in der Beize Korit enthalten.“"
                            },
                            {
                                "example_id": "be750f42-beb0-4ca4-bffd-63b9f2fcd5d4",
                                "sense_id": "7c883695-0735-3a7e-b00f-1fe5c1e20978",
                                "text": "„Mit einer Zinkverbindung und später Aluminiumchlorid konnten die Schweißdrüsen verengt werden.“"
                            }
                        ],
