                "senses": [
                    {
                        "sense_id": "f9a3c892-5dc4-353e-8256-faffef435498",
                        "entry_id": "289a7c5a-55c3-3f6b-945f-eff46ccf87af",
                        "glosses": [
                            "een muur gemaakt van bevroren water"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc16b68a-9b81-402d-983e-578f08022e11",
                                "sense_id": "f9a3c892-5dc4-353e-8256-faffef435498",
                                "text": "Van Winterfel tot Koningslanding en van de Noordelijke IJsmuur tot de luchtcellen van het Adelaarsnest: alles in Westeros is minutieus nagebouwd."
                            },
                            {
                                "example_id": "f230b8ea-b45f-4109-ad15-9ae7301cc811",
                                "sense_id": "f9a3c892-5dc4-353e-8256-faffef435498",
                                "text": "Door een combinatie van dooi en harde wind begint het ijs rond het IJsselmeer te kruien. Daardoor is een metershoge ijsmuur ontstaan bij de vuurtoren van het schiereiland Marken. Ook aan de andere kant van het meer, bij het Friese Stavoren, hopen de ijsschotsen zich op."
                            },
                            {
                                "example_id": "533d2640-5e0d-49ed-beaa-7bad7453fc5b",
                                "sense_id": "f9a3c892-5dc4-353e-8256-faffef435498",
                                "text": "De Japanse regering kondigde dinsdag aan dat de grond wordt bevroren om te voorkomen dat het grondwater het radioactieve water nog bereikt. Zo'n muur van bevroren aarde is volgens Kloosterman een beproefde methode om grondwater te beschermen. De maatregel zou ook in dit geval goed kunnen werken, denkt de onderzoeker van de TU Delft. Hij wijst er wel op dat de ijsmuur geen permanente oplossing is."
                            }
                        ]
                    }
