                        "sense_id": "a362570f-e40f-303e-8cbd-33890bfc7423",
                        "entry_id": "d7c21d96-ddac-3b3f-b341-e7f9b7fdc6fe",
                        "glosses": [
                            "D’une manière sacramentelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55506631-6ef3-468d-892a-6fc4c624c97b",
                                "sense_id": "a362570f-e40f-303e-8cbd-33890bfc7423",
                                "text": "… une haine grandiose, sans mesure, presque mystique, sacramentellement déclarée contre une populace « engourdie et illettrée » …."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "de530bbc-0936-45e0-99a9-ad9dfda48334",
                        "source_entry_id": "d7c21d96-ddac-3b3f-b341-e7f9b7fdc6fe",
                        "source_sense_id": "a362570f-e40f-303e-8cbd-33890bfc7423",
                        "target_lang_word": "sacramentally",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sacramentally",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b11f4c95-7e97-3059-b36d-b84a5ac03568",
                                        "entry_id": "d63cc9d1-377f-387a-96c0-a3e7dd7817d5",
                                        "glosses": [
                                            "In a sacramental manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8c66e4d-fe10-47cb-981c-e9610a63c60c",
                                                "sense_id": "b11f4c95-7e97-3059-b36d-b84a5ac03568",
                                                "text": "[…] in the supper, or in the bread and wine (which two retaine their propre substaunces) they are Sacramentally or spiritually present, not substancially or bodily."
                                            },
                                            {
                                                "example_id": "425d5ef0-6c6e-4834-b4d5-dcb965806d80",
                                                "sense_id": "b11f4c95-7e97-3059-b36d-b84a5ac03568",
                                                "text": "“But I have made up my mind that I am not your wife! I belong to him—I sacramentally joined myself to him for life. Nothing can alter it!”"
                                            },
                                            {
                                                "example_id": "7b699c22-32b0-4721-af2d-3500c61c3fee",
                                                "sense_id": "b11f4c95-7e97-3059-b36d-b84a5ac03568",
                                                "text": "He saw himself giving a little book to Sir Bussy almost sacramentally. “Here,” he would say, “is a book to set you thinking […].”"
                                            },
                                            {
                                                "example_id": "334c67ef-1e48-42d7-9555-80a6c7b37b2f",
                                                "sense_id": "b11f4c95-7e97-3059-b36d-b84a5ac03568",
                                                "text": "The Christian rites for the coronation of kings make it very clear that the temporal monarch is in some sense being ordained, for he is sacramentally anointed and has the hands of the bishop laid upon him in the same manner as at the ordination of a priest."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0d3ee6db-914b-408f-a7c5-76023a70b6dd",
