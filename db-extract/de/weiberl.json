                        "sense_id": "5bc47f89-92bd-3c06-a802-f5ee5fcbb3ec",
                        "entry_id": "acd0da18-3922-31f4-97bb-d27507b916bf",
                        "glosses": [
                            "weibliche, erwachsene Person; Frau"
                        ],
                        "tags": [
                            "Austrian German",
                            "casual"
                        ],
                        "examples": [
                            {
                                "example_id": "b3b6515b-ba28-4631-b86b-ec898d807f58",
                                "sense_id": "5bc47f89-92bd-3c06-a802-f5ee5fcbb3ec",
                                "text": "„Mein erster Meister, zu dem ich als G'sell kommen bin, hat ein schön's jung's Weiberl g'habt, das Weiberl hat mir g'fallen, und ich ihr auch, denn ich war damals ein sehr ein liebenswürdiger Jüngling.“"
                            },
                            {
                                "example_id": "b4e31466-42fa-49af-8939-ec3de91402a9",
                                "sense_id": "5bc47f89-92bd-3c06-a802-f5ee5fcbb3ec",
                                "text": "„Kaum in die Stube gebracht, streifte das Weiberl die Hemdärmelchen zurück, schürzte das Kleidchen auf und begann zum Verwundern und Ergößen der Hausbewohner geschäftig aufzuräumen […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
