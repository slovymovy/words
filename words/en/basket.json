                                "target_lang_sense_clarification": "технический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "吊篮",
                                "target_lang_sense_clarification": "热气球部件"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0ac93e6d-217e-30a8-bcce-79f7b0a61386",
                    "sense_definition": "A set or collection of intangible things, often used in economics to refer to currencies or goods.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The value of the money is pegged to a <w>basket</w> of foreign currencies.",
                            "target_lang_translations": {
                                "ru": "Стоимость денег привязана к <w>корзине</w> иностранных валют.",
                                "zh": "货币价值与一<w>篮子</w>外币挂钩。"
                            }
                        },
                        {
                            "text": "Economists track the price of a standard <w>basket</w> of goods to measure inflation.",
                            "target_lang_translations": {
                                "ru": "Экономисты отслеживают цену стандартной потребительской <w>корзины</w> товаров для измерения инфляции.",
                                "zh": "经济学家通过追踪标准商品<w>篮子</w>的价格来衡量通货膨胀。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "basket of currencies",
                        "basket of goods"
                    ],
                    "target_lang_definitions": {
                        "ru": "Набор или совокупность нематериальных объектов, часто используемый в экономике применительно к валютам или товарам.",
                        "zh": "一组无形事物的集合，常用于经济学中指代货币或商品组合。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "корзина",
                                "target_lang_sense_clarification": "экономическая"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一篮子",
                                "target_lang_sense_clarification": "经济学组合"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f59c176f-c97f-3160-9afa-a4239c4d4cf9",
                    "sense_definition": "A protection for the hand on a sword or a singlestick.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The antique sword featured an elaborate metal <w>basket</w> to protect the hand.",
                            "target_lang_translations": {
                                "ru": "Старинная шпага имела сложную металлическую <w>гарду</w> для защиты руки.",
                                "zh": "这把古剑配有精美的金属<w>护手</w>以保护手部。"
                            }
                        },
                        {
                            "text": "He gripped the <w>basket</w> of his weapon tightly during the duel.",
