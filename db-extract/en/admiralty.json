    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "bf2f69c4-4c77-33b3-8a76-a297daf59f0d",
                "word": "Admiralty",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "44dd6da1-6b9f-3d8a-8899-77dcd1a4ca91",
                        "entry_id": "bf2f69c4-4c77-33b3-8a76-a297daf59f0d",
                        "glosses": [
                            "An area of Central and Western district, Hong Kong."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c48b7e5-6d68-41ad-bea3-77e7931a1114",
                                "sense_id": "44dd6da1-6b9f-3d8a-8899-77dcd1a4ca91",
                                "text": "But when the march reached the government headquarters in the Admiralty district, the line of people behind stretched nearly two miles, with large crowds still waiting to leave the park."
                            },
                            {
                                "example_id": "0fbf5faf-af2e-4c7d-bf1c-4e81ff2406b2",
                                "sense_id": "44dd6da1-6b9f-3d8a-8899-77dcd1a4ca91",
                                "text": "A Hong Kong court has sentenced seven people to up to three years in jail for rioting in Admiralty, when the city was in the throes of the 2019 anti-extradition unrest."
                            },
                            {
                                "example_id": "b001e68e-f64a-41a7-aa02-52c749eef238",
                                "sense_id": "44dd6da1-6b9f-3d8a-8899-77dcd1a4ca91",
                                "text": "On Wednesday, police dismantled barricades at the last main occupation site in the city's Admiralty district and arrested some 200 protesters who refused to leave the site."
                            }
                        ]
                    },
