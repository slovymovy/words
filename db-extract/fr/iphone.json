        "fr-extract.jsonl": [
            {
                "entry_id": "d45b66f1-81a8-356b-9168-c2120fcd6a79",
                "word": "iPhone",
                "pos": "name",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5e7cf723-c16d-43d5-90ea-090afd0b927b",
                        "entry_id": "d45b66f1-81a8-356b-9168-c2120fcd6a79",
                        "tags": [
                            "plural"
                        ],
                        "form": "iPhones"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "42145cdf-531a-3945-b812-9ed3a5ba427b",
                        "entry_id": "d45b66f1-81a8-356b-9168-c2120fcd6a79",
                        "glosses": [
                            "Ordiphone de la compagnie Apple."
                        ],
                        "tags": [
                            "Marque commerciale"
                        ],
                        "examples": [
                            {
                                "example_id": "6c8dd756-b9e3-4bbe-bf5a-2b917915019b",
                                "sense_id": "42145cdf-531a-3945-b812-9ed3a5ba427b",
                                "text": "C'est pourquoi l'année 2007 est à mes yeux une année pivot : le iPhone a profondément bouleversé les mœurs sociales, et avec elles la circulation des idées qui composent notre climat intellectuel."
                            },
                            {
                                "example_id": "d8df75a4-865d-4a0a-8891-46cf44da9256",
                                "sense_id": "42145cdf-531a-3945-b812-9ed3a5ba427b",
                                "text": "Qui ne connaît pas la boîte à meuh ? Pour simuler ce vieux jouet qui connaît un regain de popularité, les auteurs de boîtes à meuh ont exploité la fonction qui, dans l’iPhone, détecte le changement de sens de l’appareil."
                            },
                            {
                                "example_id": "eb0c4bbe-33f1-4283-9aa7-8c356cf71cc5",
                                "sense_id": "42145cdf-531a-3945-b812-9ed3a5ba427b",
                                "text": "D’ailleurs, tiens, il faut que je raconte ça sur Fessebouc ! En allongeant le cou, je vis dans le rétroviseur qu’elle avait extirpé de sa poche un iPhone."
                            },
                            {
                                "example_id": "ba059c3b-0f77-4cf1-8728-1adbe3738b76",
                                "sense_id": "42145cdf-531a-3945-b812-9ed3a5ba427b",
                                "text": "Zhengzhou, ville de Chine qui héberge une usine d’iPhone, a ordonné, jeudi, le confinement de six millions de personnes, après une flambée des cas de Covid-19."
                            },
                            {
                                "example_id": "c56d3681-9e91-41f7-89c1-99d01209514d",
                                "sense_id": "42145cdf-531a-3945-b812-9ed3a5ba427b",
                                "text": "J'en vois des bougs dans le bus, ils font genre les bonhommes et sur leur iPhone c'est marqué « Bébé » avec l'émoji cœur, tu connais ?"
                            },
                            {
                                "example_id": "05f534dd-9e90-42c8-95a6-f07a73146a87",
                                "sense_id": "42145cdf-531a-3945-b812-9ed3a5ba427b",
                                "text": "Apple a construit son succès sur un écosystème fermé autour des iPhone et iPad dont il contrôle tous les paramètres, invoquant des impératifs de sécurité et le confort accru des utilisateurs — une philosophie en opposition frontale avec les règles européennes de concurrence."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e3d7d19c-a509-4080-918d-0e7693082a25",
                        "source_entry_id": "d45b66f1-81a8-356b-9168-c2120fcd6a79",
                        "source_sense_id": "42145cdf-531a-3945-b812-9ed3a5ba427b",
                        "target_lang_word": "iPhone",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "iPhone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bcb1fa32-87ec-32b8-8086-8df099048095",
                                        "entry_id": "7ebcc39d-2c60-3e73-8c6e-9a00ec202bca",
                                        "glosses": [
                                            "A smartphone of a series produced by Apple, which typically combine a camera phone, PDA, multimedia player, and wireless communication device."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e271412f-8f0a-4876-821a-94570ba95b64",
                                                "sense_id": "bcb1fa32-87ec-32b8-8086-8df099048095",
                                                "text": "His mom bought him an IPhone for his 11th birthday."
                                            },
                                            {
                                                "example_id": "7580ec00-63b5-4ec7-ac2f-bfa8c7013518",
                                                "sense_id": "bcb1fa32-87ec-32b8-8086-8df099048095",
                                                "text": "This concept puts the curve back on the iPhone 5 with a silhouette that's reminiscent of a banana phone."
                                            },
                                            {
                                                "example_id": "25a0fbb1-8895-4f70-a4a5-d2860d25c7a2",
                                                "sense_id": "bcb1fa32-87ec-32b8-8086-8df099048095",
                                                "text": "Apple is rolling out the public beta of iOS 14 and iPadOS 14 on Thursday. We have a full (and lengthy) preview guide on both operating systems here, and now we’re breaking down how to get the public beta on your iPhone or iPad."
                                            },
                                            {
                                                "example_id": "ab5a4eee-6b76-4a7b-aeb0-8ae27f89c7df",
                                                "sense_id": "bcb1fa32-87ec-32b8-8086-8df099048095",
                                                "text": "“This is before everyone had [geographic information system] mapping, before iPads, iPhones, laptops, Google,” he says. “This is doing research way back with a hammer and a chisel.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "548434b9-0b45-35b1-8202-9986fb497e76",
                                        "entry_id": "7ebcc39d-2c60-3e73-8c6e-9a00ec202bca",
                                        "glosses": [
                                            "Any knockoff or similar high-end smartphone; through trademark genericization."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
