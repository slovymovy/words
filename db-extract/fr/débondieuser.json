                ],
                "senses": [
                    {
                        "sense_id": "9f0e99d0-1ecc-33bb-9629-850219b0a19d",
                        "entry_id": "1cef3a62-d512-36a3-9120-5abbf0a53baf",
                        "glosses": [
                            "Enlever son caractère divin à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "435a0c2f-05a0-43c3-bf14-88ac3f7fb733",
                                "sense_id": "9f0e99d0-1ecc-33bb-9629-850219b0a19d",
                                "text": "Drôle de peuple que ce peuple français ! Il ne veut plus de Dieu, il ne veut plus de religion, et vient-il de débondieuser le Christ, aussitôt, il bondieuse Hugo et proclame l’hugolâtrie."
                            }
                        ]
                    },
                    {
                        "sense_id": "67eb88ff-527c-3124-84c7-b089a4a63417",
                        "entry_id": "1cef3a62-d512-36a3-9120-5abbf0a53baf",
                        "glosses": [
                            "Enlever son caractère religieux à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0a73f71-3a81-41e9-a5d6-abad3d8dc10b",
                                "sense_id": "67eb88ff-527c-3124-84c7-b089a4a63417",
                                "text": "L’A. a voulu « débondieuser » le vocabulaire de traduction."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "64e85732-5f9c-4b3b-a1cd-b979c49cd3b9",
                        "source_entry_id": "1cef3a62-d512-36a3-9120-5abbf0a53baf",
                        "target_lang_word": "deconsecrate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "deconsecrate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dd530123-8298-3ed7-adb6-932ef84a3edb",
                                        "entry_id": "fbc0ae2c-fe9f-3be7-94bb-6ca21b10468a",
                                        "glosses": [
                                            "To remove the holy or sacred status of a place"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb8ccff7-4a1f-445a-a181-4f522a82d48b",
                                                "sense_id": "dd530123-8298-3ed7-adb6-932ef84a3edb",
                                                "text": "The ancient Romans deconsecrated city walls with a plow, undoing the rituals that first established their course."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ed089497-e360-4bfd-b04d-dada1936ee02",
                        "source_entry_id": "1cef3a62-d512-36a3-9120-5abbf0a53baf",
                        "target_lang_word": "desecrate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "desecrate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5dffd121-1e2b-3e72-b834-d4d77bb1cf69",
                                        "entry_id": "afdfa1c4-6083-335b-bd1e-6ea408897e74",
                                        "glosses": [
                                            "To profane or violate the sacredness or sanctity of something."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec4e458c-03bb-45ea-8f96-eb4a70ec3781",
                                                "sense_id": "5dffd121-1e2b-3e72-b834-d4d77bb1cf69",
                                                "text": "It's reform -- reform! You're going to 'turn over a new leaf,' and all that, and sign the pledge, and quit cigars, and go to work, and pay your debts, and gravitate back into Sunday-school, where you can make love to the preacher's daughter under the guise of religion, and desecrate the sanctity of the innermost pale of the church by confessions at Class of your 'thorough conversion'!"
                                            },
                                            {
                                                "example_id": "57bf748b-ddbc-482f-822a-36ff642d0b80",
                                                "sense_id": "5dffd121-1e2b-3e72-b834-d4d77bb1cf69",
                                                "text": "Tonight nothing is too sacred, we desecrate and live in sin"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6dec762d-6439-3f95-bc12-6ac239856122",
                                        "entry_id": "afdfa1c4-6083-335b-bd1e-6ea408897e74",
                                        "glosses": [
                                            "To remove the consecration from someone or something; to deconsecrate."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c618dc27-3506-3418-aa93-aa889866ab75",
                                        "entry_id": "afdfa1c4-6083-335b-bd1e-6ea408897e74",
                                        "glosses": [
                                            "To change in an inappropriate and destructive manner."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a622800-0559-4657-95d3-76922cdc3bf4",
                                                "sense_id": "c618dc27-3506-3418-aa93-aa889866ab75",
                                                "text": "A subsequent owner has desecrated the main hall and robbed it of its grandeur by putting in a floor just beneath the circular windows in order to make an upper room over the hall."
                                            },
                                            {
                                                "example_id": "4e9aa52d-c7b5-4968-ae36-dab88be2c466",
                                                "sense_id": "c618dc27-3506-3418-aa93-aa889866ab75",
                                                "text": "Everything a living animal could do to destroy and to desecrate bed and walls had been done. […] A canister of flour from the kitchen had been thrown at the looking-glass and lay like trampled snow over the remains of a decent blue suit with the lining ripped out which lay on top of the ruin of a plastic wardrobe."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "desecrate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a3a6d27d-71c7-3f0a-93c9-080fd2e77420",
                                        "entry_id": "54c65aaf-74b2-3bed-ace1-6e630a9047b8",
                                        "glosses": [
                                            "Desecrated."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8e0c1da-8bf4-4cd2-9681-6f5b679fc249",
                                                "sense_id": "a3a6d27d-71c7-3f0a-93c9-080fd2e77420",
                                                "text": "Here are the very nooks where the unwashed most abound—here are the temples most desecrate."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
