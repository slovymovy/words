            "senses": [
                {
                    "sense_id": "94f21c93-40ef-30da-8b3f-76e5fcc0364a",
                    "sense_definition": "An alternative spelling of <w>gravelly</w>, describing a surface covered with small stones or a voice that sounds rough.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "texture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old path was <w>gravely</w> and difficult to walk on without sturdy boots.",
                            "target_lang_translations": {
                                "ru": "Старая тропа была <w>гравийной</w>, и по ней было трудно идти без прочных ботинок."
                            }
                        },
                        {
                            "text": "He spoke in a <w>gravely</w> voice that made it hard to hear his words clearly.",
                            "target_lang_translations": {
                                "ru": "Он говорил <w>хриплым</w> голосом, из-за чего было трудно четко разобрать его слова."
                            }
                        }
                    ],
                    "synonyms": [
                        "gravelly",
                        "gritty",
                        "stony"
                    ],
                    "antonyms": [
                        "smooth"
                    ],
