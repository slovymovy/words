                        "entry_id": "b9ba0838-7ca8-3482-8932-5067e962570b",
                        "glosses": [
                            "Appareil permettant de mesurer les déformations d’une pièce soumise à des contraintes, avec ou sans contact avec celle-ci."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b82bf24-11bc-40b6-ab0d-a02cc5660fbc",
                                "sense_id": "75fafbb8-ba85-3e8e-a9f7-234c83ef2131",
                                "text": "L’extensomètre est alors en contact sur ses appuis par sept points ce qui, compte tenu de sa géométrie, définit dans l’espace un système isostatique n’admettant qu’une position unique."
                            }
                        ]
                    }
                ],
