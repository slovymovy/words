                "senses": [
                    {
                        "sense_id": "8d898bbf-8c0a-3025-bf53-dc1a19d4598c",
                        "entry_id": "43ceac05-5988-3f4f-8c6e-a6179b2381a9",
                        "glosses": [
                            "Inflammation des doigts."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d0db7d3-0f17-430e-9e4d-2861af0df7dc",
                                "sense_id": "8d898bbf-8c0a-3025-bf53-dc1a19d4598c",
                                "text": "Le panaris produit des élancements très douloureux."
                            },
                            {
                                "example_id": "4a0e4838-34c7-4492-af30-1dea1c71bc1b",
                                "sense_id": "8d898bbf-8c0a-3025-bf53-dc1a19d4598c",
                                "text": "Ouvrir un panaris."
                            },
                            {
                                "example_id": "2fc1ab61-8f7b-46a6-a336-5812777fa00b",
                                "sense_id": "8d898bbf-8c0a-3025-bf53-dc1a19d4598c",
                                "text": "Il guérissait les panaris avec des applications d’herbes."
                            },
                            {
                                "example_id": "1731fa5c-8f14-4630-8079-4a6f1951f291",
                                "sense_id": "8d898bbf-8c0a-3025-bf53-dc1a19d4598c",
                                "text": "Ce fut une belle et mémorable entrée, au seuil de la pièce où l'on était attablé, ce soir-là, que celle du marquis et de la marquise de Chamarante tenant, chacun par une sangle, une grosse poupée, accoutrée – mais en des proportions pantagruéliques – à la façon de celles que l'on improvise autour d'un doigt atteint de panaris."
                            },
                            {
                                "example_id": "406e4e2a-dffa-4840-96ba-6106f8ea8f74",
                                "sense_id": "8d898bbf-8c0a-3025-bf53-dc1a19d4598c",
                                "text": "Je voudrais savoir si le panaris qu’on a ouvert avec des ciseaux à ongles ne s’est pas infecté."
                            }
                        ]
                    }
