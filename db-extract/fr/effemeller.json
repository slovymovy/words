                        "glosses": [
                            "Retrancher dans une forêt le bois mort ou mauvais."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2ff5914-a40d-4a1d-95f4-460bc47e53c5",
                                "sense_id": "f0b63d6c-36fc-3190-868d-242a99aa1424",
                                "text": "Pour les hommes il faudrait faire comme les bûcherons font tous les ans dans les grandes forêts ; ils y entrent pour les visiter, pour reconnaître le mort bois ou le bois vert, et effemeller la forêt, retranchant tout ce qui est superflu ou dommageable, pour retenir seulement les bons arbres ou les jeunes baliveaux d’espérance"
                            }
                        ]
                    }
