                "senses": [
                    {
                        "sense_id": "1c984b94-4f46-3a0f-a77d-ff8c590804a8",
                        "entry_id": "47b31393-68c9-3af7-ac95-53b572f0f526",
                        "glosses": [
                            "Obstbaum, der Birne als Früchte trägt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea25be62-a08b-4c15-9f9d-39edc8aef9f4",
                                "sense_id": "1c984b94-4f46-3a0f-a77d-ff8c590804a8",
                                "text": "„Der Nachbar war wütend, stürzte mit einer Axt in Garbos' Obstgarten und fällte aus Rache alle Birnen- und Apfelbäume.“"
                            }
