    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "aea07c54-98cf-376c-97d4-1bfd498b489b",
                    "sense_definition": "To unroll or spread out something that was rolled or folded, such as a flag, sail, or umbrella.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They decided to <w>unfurl</w> the flag before the ceremony started.",
                            "target_lang_translations": {
                                "ru": "Они решили <w>развернуть</w> флаг до начала церемонии."
                            }
                        },
                        {
                            "text": "The sailors had to <w>unfurl</w> the sails quickly as the wind picked up.",
                            "target_lang_translations": {
                                "ru": "Морякам пришлось быстро <w>распустить</w> паруса, так как поднялся ветер."
                            }
                        }
                    ],
                    "antonyms": [
                        "furl",
                        "roll"
                    ],
                    "common_phrases": [
                        "unfurl the flag",
                        "unfurl the sails"
                    ],
                    "target_lang_definitions": {
                        "ru": "Развёртывать или расправлять что-либо свёрнутое или сложенное, например, флаг, парус или зонт."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "развёртывать",
                                "target_lang_sense_clarification": "флаг, парус, свиток"
                            },
                            {
                                "target_lang_word": "распускать",
                                "target_lang_sense_clarification": "паруса, флаг"
                            },
                            {
                                "target_lang_word": "раскрывать",
                                "target_lang_sense_clarification": "зонт, веер"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fcee1fcc-3d77-352a-b5a3-93c17c338d4a",
                    "sense_definition": "To gradually reveal, launch, or present something new, such as a plan, event, or story.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company plans to <w>unfurl</w> a new feature next month.",
                            "target_lang_translations": {
                                "ru": "Компания планирует <w>представить</w> новую функцию в следующем месяце."
                            }
                        },
                        {
                            "text": "As the story begins to <w>unfurl</w>, the main character reveals a hidden secret.",
                            "target_lang_translations": {
                                "ru": "По мере того как история начинает <w>раскрываться</w>, главный герой выдает скрытую тайну."
                            }
                        }
                    ],
                    "common_phrases": [
                        "unfurl a new feature",
                        "unfurl a strategy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Постепенно раскрывать, запускать или презентовать что-то новое, например, план, событие или сюжет."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разворачивать",
                                "target_lang_sense_clarification": "план, кампанию, деятельность"
                            },
                            {
                                "target_lang_word": "раскрывать",
                                "target_lang_sense_clarification": "сюжет, план, тему"
                            },
                            {
                                "target_lang_word": "представлять",
                                "target_lang_sense_clarification": "новую функцию, проект"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}