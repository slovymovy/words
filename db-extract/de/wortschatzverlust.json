                "senses": [
                    {
                        "sense_id": "9c59373d-bbdd-32c6-92d3-d0d2d2285902",
                        "entry_id": "432cd2c6-b62b-3df5-91a0-41cef92226a5",
                        "glosses": [
                            "Verlust an Wortschatz(teilen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "052f7d68-4aae-4bdf-86df-415821c8fc43",
                                "sense_id": "9c59373d-bbdd-32c6-92d3-d0d2d2285902",
                                "text": "„In der Vorlesung sollen verschiedene Aspekte der Wortschatzbeschreibung vorgestellt werden: Wortschatzausbau (zum Beispiel durch Entlehnung, Wortbildung), Etymologie/Wortschatzwandel (neben Wortschatzausbau zum Beispiel Bedeutungswandel, Wortschatzverlust), semantische Beschreibungsmodelle (zum Beispiel Merkmalssemantik, Prototypensemantik, kognitive Semantik), Eigennamen als Bestandteil des Wortschatzes (Onomastik) sowie Überblick über lexikographische Arbeitsweisen und Problemstellungen.“"
                            },
                            {
                                "example_id": "972388a2-8d31-44d8-bae0-82d7630f606a",
                                "sense_id": "9c59373d-bbdd-32c6-92d3-d0d2d2285902",
                                "text": "„Daten zum Wortschatzverlust des Englischen nennt Dike (1935: 364: …).“"
                            },
                            {
                                "example_id": "63700729-f5bc-44d4-b80b-358d5316d316",
                                "sense_id": "9c59373d-bbdd-32c6-92d3-d0d2d2285902",
                                "text": "„Damit geht ein gewisser Wortschatzverlust einher, den man, wenn überhaupt, nur mit sprachpolitischen Maßnahmen aufhalten kann.“"
                            },
                            {
                                "example_id": "aa2984af-6e55-41ab-b6c3-53f5ed1861a1",
                                "sense_id": "9c59373d-bbdd-32c6-92d3-d0d2d2285902",
                                "text": "„Ganz zu schweigen von der gewaltigen Schieflage zwischen der Zahl Studierender und Auszubildender sowie dem Wortschatzverlust von Viertklässlern: Deren – lehrplanmäßige – Kompetenz war in drei Jahrzehnten von 13.000 auf 700 Wörter geschrumpft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
