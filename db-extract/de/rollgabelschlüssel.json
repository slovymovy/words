                "senses": [
                    {
                        "sense_id": "7830e6dd-bd87-3a13-bdf0-f54814b0581f",
                        "entry_id": "e59f5149-8dbb-3e54-a6ab-536f9cd3340a",
                        "glosses": [
                            "stufenlos einstellbarer Schraubenschlüssel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a019062-c8e5-4425-b309-c1437b094b03",
                                "sense_id": "7830e6dd-bd87-3a13-bdf0-f54814b0581f",
                                "text": "„Grundsätzlich gilt, dass eine Wasserpumpenzange nur für eine runde Verschraubung verwendet werden sollte, auf die kein Ring- oder Gabelschlüssel (Maulschlüssel) bzw. Rollgabelschlüssel passt.“"
                            },
                            {
                                "example_id": "31f85434-a505-4ff1-b0a3-e6780742d637",
                                "sense_id": "7830e6dd-bd87-3a13-bdf0-f54814b0581f",
                                "text": "„Ein kräftiger Bursche mit einem Rollgabelschlüssel installiert Scheinwerfer, während sich ein Stück weiter unter Chantals kritischem Blick ein Typ am Motor des Flugapparats zu schaffen macht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
