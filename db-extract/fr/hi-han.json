                        "cross_references": [
                            {
                                "target_word": "hee haw",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8c062b63-f380-3279-a32e-529e277424c9",
                                        "entry_id": "656f28a2-c52f-3a89-903d-90c167df6b25",
                                        "glosses": [
                                            "Alternative spelling of hee-haw."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ecb800e7-9dfd-359b-91b3-c9892de24e0a",
                                        "entry_id": "656f28a2-c52f-3a89-903d-90c167df6b25",
                                        "glosses": [
                                            "A braying laugh."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42f9bc10-4943-43f3-8253-617c1316de54",
                                                "sense_id": "ecb800e7-9dfd-359b-91b3-c9892de24e0a",
                                                "text": "He had sharp brown eyes that he made look merry when it suited him, and a subborn chin he hid behind a hearty, good ol' boy hee haw that disarmed those who didn't know him well, but put the few who did on full alert."
                                            },
                                            {
                                                "example_id": "ca27d23c-c93f-48c4-9aeb-250c1011bf50",
                                                "sense_id": "ecb800e7-9dfd-359b-91b3-c9892de24e0a",
                                                "text": "He answered, blooming out with a clownish grin that usually brought big hee-haws, “Sixteen. Short for my age.”"
                                            },
                                            {
                                                "example_id": "9f69dc5c-b288-42b3-99cb-ba67f3110a4c",
                                                "sense_id": "ecb800e7-9dfd-359b-91b3-c9892de24e0a",
                                                "text": "The little gurgling sounds became great big hee haws of hysteria."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hee haw",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3db2f2ba-ca1b-3442-aa72-5654e536aa23",
                                        "entry_id": "14665f48-5a12-341f-b8e7-8f03cb8ab698",
                                        "glosses": [
                                            "Alternative spelling of hee-haw."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "hee haw",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "58393eb6-a81f-3066-9240-8b0993a5e60a",
                                        "entry_id": "4f20bba2-7356-35f9-987b-2211cc6e2a16",
                                        "glosses": [
                                            "Alternative spelling of hee-haw."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24c4d135-ca21-4573-b3b9-65bf044763ae",
                                                "sense_id": "58393eb6-a81f-3066-9240-8b0993a5e60a",
                                                "text": "In fact, I was actually hee hawing!"
                                            },
                                            {
                                                "example_id": "ff37c2cd-7cfd-431a-81ce-ac89a56e17a9",
                                                "sense_id": "58393eb6-a81f-3066-9240-8b0993a5e60a",
                                                "text": "Burro hee hawed and hee hawed until she was red in the face."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "73a52867-fea5-440f-b87c-5e7bf6b68fae",
                        "source_entry_id": "75035516-77df-39d3-9e73-3e3f33f6a8ba",
