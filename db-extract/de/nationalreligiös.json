                ],
                "senses": [
                    {
                        "sense_id": "f6324618-8c5d-31c0-abe0-8c81ab2c76b4",
                        "entry_id": "0a80dd5c-8621-35dd-8af0-fddf4c1f8914",
                        "glosses": [
                            "sich auf die religiösen Überzeugungen, Praktiken oder Werte beziehend, die spezifisch für eine bestimmte Nation oder ihre nationale Identität sind, wie beispielsweise die jüdische Religion für das jüdische Volk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80702ab1-5533-48d4-ba6b-d6ae85950835",
                                "sense_id": "f6324618-8c5d-31c0-abe0-8c81ab2c76b4",
                                "text": "„In allen Parteien drängten damals junge Leute nach vorn, doch die großen ursprünglichen Führer behaupteten sich: Menachem Begin Cherut, Meir Ja’ari in der Mapam, Chaim-Mosche Schapira in der nationalreligiösen Mafdal.“"
                            },
                            {
                                "example_id": "0dfb0e07-4e45-43b5-baf9-078ff9daf69f",
                                "sense_id": "f6324618-8c5d-31c0-abe0-8c81ab2c76b4",
                                "text": "„Für den anschwellenden jüdischen Besucherstrom sorgen militante Kreise der nationalreligiösen Siedler.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
