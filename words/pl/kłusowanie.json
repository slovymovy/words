                    "sense_id": "f77089ea-6856-3479-8477-b8aea530a4c6",
                    "sense_definition": "poruszanie się konia lub innego czworonoga chodem szybszym od stępa, a wolniejszym od galopu",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ruch_zwierzecia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Długie <w>kłusowanie</w> po twardym podłożu może być bardzo męczące dla wierzchowca.",
                            "target_lang_translations": {
                                "ru": "Долгий <w>бег рысью</w> по твёрдому грунту может быть очень утомительным для верховой лошади."
                            }
                        },
                        {
                            "text": "Instruktor jazdy konnej zwrócił uwagę na prawidłowe <w>kłusowanie</w> podczas rozgrzewki.",
                            "target_lang_translations": {
                                "ru": "Инструктор по верховой езде обратил внимание на правильное <w>движение рысью</w> во время разминки."
                            }
                        }
                    ],
                    "antonyms": [
                        "niekłusowanie"
                    ],
                    "common_phrases": [
                        "nauka kłusowania"
                    ],
                    "target_lang_definitions": {
                        "ru": "передвижение лошади или другого животного аллюром быстрее шага, но медленнее галопа"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бег рысью",
                                "target_lang_sense_clarification": "аллюр животного"
                            },
                            {
                                "target_lang_word": "движение рысью",
                                "target_lang_sense_clarification": "аллюр животного"
                            },
                            {
                                "target_lang_word": "рысь",
                                "target_lang_sense_clarification": "ход лошади"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "19f4c989-6d3d-30e4-bd34-0723be1a011a",
                    "sense_definition": "nielegalne polowanie na zwierzynę lub nielegalny połów ryb",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "klusownictwo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Straż leśna zatrzymała dwóch mężczyzn podejrzanych o <w>kłusowanie</w> w rezerwacie przyrody.",
                            "target_lang_translations": {
                                "ru": "Лесная охрана задержала двух мужчин, подозреваемых в <w>браконьерстве</w> в природном заповеднике."
                            }
                        },
                        {
                            "text": "Nielegalne <w>kłusowanie</w> na rzece doprowadziło do znacznego spadku populacji pstrąga.",
                            "target_lang_translations": {
                                "ru": "Незаконное <w>браконьерство</w> на реке привело к значительному сокращению популяции форели."
                            }
                        }
                    ],
                    "antonyms": [
