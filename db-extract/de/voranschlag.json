                                "target_senses": [
                                    {
                                        "sense_id": "34a8964f-26e2-323d-9721-477b36c02ba5",
                                        "entry_id": "47aa1790-4ba0-3c43-8378-2526da6e16ea",
                                        "glosses": [
                                            "Menus propos, entretien familier."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b5c0fa4-526d-46b4-810c-c57ba2473cf3",
                                                "sense_id": "34a8964f-26e2-323d-9721-477b36c02ba5",
                                                "text": "De joyeux devis."
                                            },
                                            {
                                                "example_id": "90627770-8e9a-4f5f-b52a-6e95e256e2d5",
                                                "sense_id": "34a8964f-26e2-323d-9721-477b36c02ba5",
                                                "text": "Qui plus suffisamment entrant sur le devis."
                                            },
                                            {
                                                "example_id": "61042681-f7f5-49e8-995a-aaf166925cbf",
                                                "sense_id": "34a8964f-26e2-323d-9721-477b36c02ba5",
                                                "text": "Un jour qu’ils étaient en devis."
                                            },
                                            {
                                                "example_id": "000b896a-44e0-434a-8423-9c9b02761863",
                                                "sense_id": "34a8964f-26e2-323d-9721-477b36c02ba5",
                                                "text": "Tuez-vous donc vite ; ah ! que de longs devis."
                                            },
                                            {
                                                "example_id": "ec6d2bdb-bcaa-4eaf-b1f2-edbbff74d67a",
                                                "sense_id": "34a8964f-26e2-323d-9721-477b36c02ba5",
                                                "text": "un pli, qui suffisait, pendant plus de quatre semaines aux entretiens et menus devis, dans les soirées d’hiver autour de la grande cheminée"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6e10af6-54ba-3480-8fca-995a38873375",
                                        "entry_id": "47aa1790-4ba0-3c43-8378-2526da6e16ea",
                                        "glosses": [
                                            "Description des travaux qu’on doit exécuter pour la construction d’un bâtiment, avec l’estimation des dépenses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91ba5f7d-1e5a-43ee-ac6c-aa8e1d6651e9",
                                                "sense_id": "f6e10af6-54ba-3480-8fca-995a38873375",
                                                "text": "N’hésitez pas à vous rendre chez un réparateur informatique pour demander un devis. C'est souvent plus économique que d’acheter un nouvel ordinateur."
                                            },
                                            {
                                                "example_id": "fdc0eddb-9521-4ec2-8a34-726d2d7dd02b",
                                                "sense_id": "f6e10af6-54ba-3480-8fca-995a38873375",
                                                "text": "Par exemple, la transition d’un devis de prescription (dont les critères sont restrictifs) vers un devis de performance les amènera à apprécier pleinement la valeur ajoutée d’un matériau technique québécois aux propriétés ignifuges de pointe comparativement à un produit étranger acheté à prix moindre."
                                            },
                                            {
                                                "example_id": "7b073c51-b7a4-4206-94e8-9be67d0c5e94",
                                                "sense_id": "f6e10af6-54ba-3480-8fca-995a38873375",
                                                "text": "Devis et marché, acte par lequel sont réglés la forme, le poids, la mesure, la quantité, la quotité et le prix d’un ouvrage, et les obligations respectives de celui qui fait faire l’ouvrage et de celui qui l’entreprend."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75f96883-d0e0-3475-a50c-b73822028c8d",
                                        "entry_id": "47aa1790-4ba0-3c43-8378-2526da6e16ea",
                                        "glosses": [
                                            "Devis d’armement d’un navire, état de prévision de tout ce qu’il doit contenir."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
