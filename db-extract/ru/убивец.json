                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e87ce0e9-071b-4bea-8c8c-ebfd0a03e233",
                                "sense_id": "bb138001-c962-3c8f-bd8c-bba3796389c5",
                                "text": "Зарыв тело Адонирама, убивцы присыпали могилу землей и мелкими камнями."
                            },
                            {
                                "example_id": "c14e96a7-9796-4e6c-80c6-20c0191846a7",
                                "sense_id": "bb138001-c962-3c8f-bd8c-bba3796389c5",
                                "text": "С первого сего августа взяты из розыскной экспедиции на смерть осужденные преступники, убивцы."
                            }
                        ]
                    }
