{
    "word_family": [
        "pavilioning",
        "pavilioned"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0e513508-c9aa-3af1-bc25-3cd1db4383c1",
                    "sense_definition": "A light roofed structure used as a shelter in a public place.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We sat under the <w>pavilion</w> to stay dry during the sudden rainstorm.",
                            "target_lang_translations": {
                                "ru": "Мы сидели под <w>павильоном</w>, чтобы не намокнуть во время внезапного ливня.",
                                "zh": "突如其来的暴雨中，我们坐在<w>亭子</w>下面避雨。"
                            }
                        },
                        {
                            "text": "The park features a beautiful wooden <w>pavilion</w> overlooking the lake.",
                            "target_lang_translations": {
                                "ru": "В парке есть красивая деревянная <w>беседка</w> с видом на озеро.",
                                "zh": "公园里有一座俯瞰湖面的漂亮木制<w>凉亭</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "park pavilion",
                        "wooden pavilion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Легкая крытая постройка, используемая в качестве укрытия в общественном месте.",
                        "zh": "公共场所里一种轻便的有顶建筑，用来遮阳、避雨或供人休息。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "павильон",
                                "target_lang_sense_clarification": "садовая или парковая постройка"
                            },
                            {
                                "target_lang_word": "беседка",
                                "target_lang_sense_clarification": "открытая садовая постройка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "亭子",
                                "target_lang_sense_clarification": "公园或公共场所里供人遮阳避雨、休息的有顶小建筑"
                            },
                            {
                                "target_lang_word": "凉亭",
                                "target_lang_sense_clarification": "通常较为开敞的园林式亭子"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0b85d909-60d2-39a2-869d-e87f97d277d7",
                    "sense_definition": "A structure, sometimes temporary, erected to house exhibits at a fair, etc.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The national <w>pavilion</w> at the expo showcased the latest technological innovations.",
                            "target_lang_translations": {
                                "ru": "Национальный <w>павильон</w> на выставке представил последние технологические инновации.",
                                "zh": "博览会上的国家<w>展馆</w>展示了最新的科技创新成果。"
                            }
                        },
                        {
                            "text": "Visitors flocked to the art <w>pavilion</w> to see the new exhibition.",
                            "target_lang_translations": {
                                "ru": "Посетители стекались в художественный <w>павильон</w>, чтобы увидеть новую выставку.",
                                "zh": "游客纷纷涌向艺术<w>展馆</w>去看新展览。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "exhibition pavilion",
                        "national pavilion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Здание, иногда временное, возведенное для размещения экспонатов на ярмарке или выставке.",
                        "zh": "为博览会、展会等陈列展品而搭建的建筑，有时是临时的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "павильон",
                                "target_lang_sense_clarification": "выставочное здание"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "展馆",
                                "target_lang_sense_clarification": "博览会、展会等用于陈列展品的建筑"
                            },
                            {
                                "target_lang_word": "展示馆",
                                "target_lang_sense_clarification": "强调用于展示展品的场馆"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aa61548a-4862-3e10-8e3e-c46249bb482e",
                    "sense_definition": "The building where the players change clothes, wait to bat, and eat their meals.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The batsman walked back to the <w>pavilion</w> after being bowled out.",
                            "target_lang_translations": {
                                "ru": "Бэтсмен вернулся в <w>павильон</w> после того, как его вывели из игры.",
                                "zh": "击球手被投杀出局后走回了<w>球员休息室</w>。"
                            }
                        },
                        {
                            "text": "Only one player has hit a six over the Lord's <w>pavilion</w>.",
                            "target_lang_translations": {
                                "ru": "Только одному игроку удалось выбить мяч за пределы <w>павильона</w> стадиона Лордс.",
                                "zh": "只有一名球员把球六分击过了洛德球场的<w>球员休息室</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cricket pavilion",
                        "players pavilion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Здание на спортивной площадке, где игроки переодеваются, ждут своей очереди и едят.",
                        "zh": "板球场上的一座建筑，供球员更衣、等待击球和用餐休息。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "павильон",
                                "target_lang_sense_clarification": "спортивная раздевалка или клубный дом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "球员休息室",
                                "target_lang_sense_clarification": "板球场上供球员更衣、等待上场和休息用的建筑"
                            },
                            {
                                "target_lang_word": "球员馆",
                                "target_lang_sense_clarification": "板球场内球员使用的附属建筑"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c2eb5c04-ea4e-3d6a-b59a-d69837853302",
                    "sense_definition": "An ornate tent.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "tent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king stayed in a magnificent silk <w>pavilion</w> during the tournament.",
                            "target_lang_translations": {
                                "ru": "Во время турнира король остановился в великолепном шелковом <w>шатре</w>.",
                                "zh": "比赛期间，国王住在一顶华丽的丝绸<w>华帐</w>里。"
                            }
                        },
                        {
                            "text": "The garden was decorated with a colorful <w>pavilion</w> for the wedding.",
                            "target_lang_translations": {
                                "ru": "Для свадьбы сад был украшен красочным <w>шатром</w>.",
                                "zh": "为了婚礼，花园里布置了一座色彩鲜艳的<w>华帐</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "royal pavilion",
                        "silk pavilion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Богато украшенный большой шатер.",
                        "zh": "装饰华丽的帐篷。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шатер",
                                "target_lang_sense_clarification": "большая нарядная палатка"
                            },
                            {
                                "target_lang_word": "павильон",
                                "target_lang_sense_clarification": "временный нарядный навес"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "华帐",
                                "target_lang_sense_clarification": "装饰华美的帐篷，常见于仪式或庆典语境"
                            },
                            {
                                "target_lang_word": "锦帐",
                                "target_lang_sense_clarification": "较文雅的说法，指华丽的大帐篷"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1c89a757-4ebd-3e80-a6f4-f503e482538f",
                    "sense_definition": "A detached or semi-detached building at a hospital or other building complex.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The maternity ward is located in the north <w>pavilion</w> of the hospital.",
                            "target_lang_translations": {
                                "ru": "Родильное отделение находится в северном <w>корпусе</w> больницы.",
                                "zh": "妇产科位于医院北侧的<w>楼</w>里。"
                            }
                        },
                        {
                            "text": "The university added a new <w>pavilion</w> to the science complex.",
                            "target_lang_translations": {
                                "ru": "Университет пристроил новый <w>корпус</w> к научному комплексу.",
                                "zh": "大学给科学园区新增了一座<w>楼</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "hospital pavilion",
                        "north pavilion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдельно стоящее или примыкающее здание в больничном или ином комплексе.",
                        "zh": "医院或其他建筑群中一座独立或半独立的建筑。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "корпус",
                                "target_lang_sense_clarification": "отдельное здание комплекса"
                            },
                            {
                                "target_lang_word": "павильон",
                                "target_lang_sense_clarification": "отдельный блок здания"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "楼",
                                "target_lang_sense_clarification": "医院、大学等建筑群中的单独楼栋"
                            },
                            {
                                "target_lang_word": "分馆",
                                "target_lang_sense_clarification": "综合建筑群中的独立分馆或分楼"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "53dfd3a5-a1dc-3922-9182-be1f3af43c9a",
                    "sense_definition": "A covering; a canopy; figuratively, the sky.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "canopy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>pavilion</w> of heaven was bare and filled with stars.",
                            "target_lang_translations": {
                                "ru": "Небесный <w>свод</w> был чист и усыпан звездами.",
                                "zh": "天空的<w>天幕</w>澄澈无云，繁星满布。"
                            }
                        },
                        {
                            "text": "They rested under the leafy <w>pavilion</w> of the ancient oak trees.",
                            "target_lang_translations": {
                                "ru": "Они отдыхали под лиственным <w>шатром</w> вековых дубов.",
                                "zh": "他们在古老橡树枝叶形成的<w>华盖</w>下休息。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "pavilion of heaven"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used figuratively for the sky or a canopy"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Покрытие, навес; в переносном смысле — небосвод.",
                        "zh": "遮盖物、帷幕或顶篷；古义中也可比喻天空。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свод",
                                "target_lang_sense_clarification": "небесный купол"
                            },
                            {
                                "target_lang_word": "шатёр",
                                "target_lang_sense_clarification": "густое покрытие, например, листвы"
                            },
                            {
                                "target_lang_word": "полог",
                                "target_lang_sense_clarification": "навес"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "天幕",
                                "target_lang_sense_clarification": "比喻天空时，指像帷幕一样覆盖在上方的天空"
                            },
                            {
                                "target_lang_word": "华盖",
                                "target_lang_sense_clarification": "比喻树叶等形成的覆盖物，也可用于较文雅的遮盖物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "67aa14fa-a26b-3967-8654-66b25e98d8eb",
                    "sense_definition": "The lower surface of a brilliant-cut gemstone, lying between the girdle and collet.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "gemstone",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The jeweler examined the <w>pavilion</w> of the diamond for any flaws.",
                            "target_lang_translations": {
                                "ru": "Ювелир осмотрел <w>павильон</w> бриллианта на наличие дефектов.",
                                "zh": "珠宝匠检查了这颗钻石的<w>亭部</w>，看是否有瑕疵。"
                            }
                        },
                        {
                            "text": "A deep <w>pavilion</w> can affect how light reflects through the stone.",
                            "target_lang_translations": {
                                "ru": "Глубокий <w>павильон</w> может влиять на то, как свет отражается в камне.",
                                "zh": "较深的<w>亭部</w>会影响光线在宝石中的反射方式。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "diamond pavilion"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in gemology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Нижняя часть ограненного драгоценного камня, расположенная между рундистом и калеттой.",
                        "zh": "明亮式切割宝石下部的部分，位于腰棱与底尖之间。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "павильон",
                                "target_lang_sense_clarification": "нижняя часть бриллианта"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "亭部",
                                "target_lang_sense_clarification": "宝石学术语，指明亮式切割宝石腰棱以下到底尖之间的下部"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9806f2eb-079f-31b3-a4de-eb8e15e7ad59",
                    "sense_definition": "The cartilaginous part of the outer ear; auricle.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor noted a small bruise on the <w>pavilion</w> of the patient's ear.",
                            "target_lang_translations": {
                                "ru": "Врач заметил небольшой синяк на <w>ушной раковине</w> пациента.",
                                "zh": "医生注意到病人的<w>耳廓</w>上有一小块淤青。"
                            }
                        },
                        {
                            "text": "Sound waves are collected by the <w>pavilion</w> and directed into the ear canal.",
                            "target_lang_translations": {
                                "ru": "Звуковые волны собираются <w>ушной раковиной</w> и направляются в слуховой проход.",
                                "zh": "声波由<w>耳廓</w>收集后被导入耳道。"
                            }
                        }
                    ],
                    "synonyms": [
                        "auricle",
                        "pinna"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "anatomical term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Хрящевая часть наружного уха; ушная раковина.",
                        "zh": "外耳的软骨部分，即耳廓。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ушная раковина",
                                "target_lang_sense_clarification": "внешняя часть уха"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "耳廓",
                                "target_lang_sense_clarification": "外耳可见的软骨部分"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "92227c4a-3213-3418-834f-6c39f3ee0693",
                    "sense_definition": "To put inside a pavilion.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "enclose",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The guests were <w>pavilioned</w> away from the wind during the outdoor gala.",
                            "target_lang_translations": {
                                "ru": "Во время торжества на открытом воздухе гостей <w>разместили в павильонах</w>, чтобы защитить от ветра.",
                                "zh": "户外晚会期间，客人被<w>安置在亭子里</w>以避风。"
                            }
                        },
                        {
                            "text": "They decided to <w>pavilion</w> the delicate statues to protect them from the weather.",
                            "target_lang_translations": {
                                "ru": "Они решили <w>укрыть в павильоне</w> хрупкие статуи, чтобы защитить их от непогоды.",
                                "zh": "他们决定把这些脆弱的雕像<w>安置在亭子里</w>，以防日晒雨淋。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Поместить внутрь павильона или шатра.",
                        "zh": "把人或物放进亭子、棚子之类的建筑中。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "размещать в павильоне",
                                "target_lang_sense_clarification": "укрывать в постройке"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "安置在亭子里",
                                "target_lang_sense_clarification": "把人或物安置到亭子、棚子等遮蔽建筑里"
                            },
                            {
                                "target_lang_word": "置于棚内",
                                "target_lang_sense_clarification": "强调放入有顶遮蔽物中"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "efe33bbf-51b6-3d57-a270-6c277f207255",
                    "sense_definition": "To enclose or surround.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "enclose",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient city was <w>pavilioned</w> in splendor and history.",
                            "target_lang_translations": {
                                "ru": "Древний город был <w>окутан</w> великолепием и историей.",
                                "zh": "这座古城被辉煌与历史<w>笼罩</w>着。"
                            }
                        },
                        {
                            "text": "The mountain peak was <w>pavilioned</w> by thick white clouds.",
                            "target_lang_translations": {
                                "ru": "Горная вершина была <w>окружена</w> густыми белыми облаками.",
                                "zh": "山峰被浓厚的白云<w>环绕</w>着。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "pavilioned in splendour"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "often used in literary or religious contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Окружать или окутывать (часто в литературном контексте).",
                        "zh": "围住或包围；常用于文学语境中表示笼罩、环绕。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "окутывать",
                                "target_lang_sense_clarification": "окружать со всех сторон"
                            },
                            {
                                "target_lang_word": "окружать",
                                "target_lang_sense_clarification": "заключать в пределы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "笼罩",
                                "target_lang_sense_clarification": "像雾、光辉、气氛等从四周或整体上覆盖"
                            },
                            {
                                "target_lang_word": "环绕",
                                "target_lang_sense_clarification": "从周围包围、围住"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}