                        "se reconnaître"
                    ],
                    "common_phrases": [
                        "s'avouer vaincu",
                        "s'avouer coupable",
                        "s'avouer impuissant"
                    ]
                },
                {
                    "sense_id": "88d4fef4-f26f-3bdc-88ef-6a5f58e97219",
                    "sense_definition": "Reconnaître quelqu'un comme sien, en particulier un enfant ou une filiation, ou se reconnaître l'auteur d'une œuvre.",
