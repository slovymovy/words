                "senses": [
                    {
                        "sense_id": "7f30c726-2e0f-394e-954a-e73c54eaa495",
                        "entry_id": "bc88edb3-68b8-300e-ae63-06f6caa516b4",
                        "glosses": [
                            "Résider dans les alpages pour l'été."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bdb52465-73f2-4a87-af4d-1a3b841c9215",
                                "sense_id": "7f30c726-2e0f-394e-954a-e73c54eaa495",
                                "text": "Nous nous jetions au travail avec une sorte de frénésie malgré la chaleur qui nous exaspérait avec les taons, les mouches, les moustiques et nous ne songions qu'à la « montée » proche, impatients de revoir notre cabane et d'alpager."
                            }
                        ]
                    },
                    {
                        "sense_id": "37178896-9a09-32a5-9d8f-31c97ecab619",
                        "entry_id": "bc88edb3-68b8-300e-ae63-06f6caa516b4",
                        "glosses": [
                            "Faire paître des animaux dans les alpages."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce86bd61-ee0e-4095-85e8-ef03a8f5b978",
                                "sense_id": "37178896-9a09-32a5-9d8f-31c97ecab619",
                                "text": "… en versant des sommes proportionnelle au nombre et au type de bêtes qu'ils mènent alpager, favorisant ainsi la constitution de larges troupeaux."
                            }
                        ]
                    }
