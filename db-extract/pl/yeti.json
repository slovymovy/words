                        ]
                    },
                    {
                        "translation_id": "fbc54070-3b43-4329-93d8-2a92d6f717f9",
                        "source_entry_id": "aacbb592-767c-3009-8590-cb7fff6f59f0",
                        "source_sense_id": "bd572134-38ff-3b9b-93c3-5d200bc3a384",
                        "target_lang_word": "Yeti",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Yeti",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fb90338a-60b7-33f4-9b89-3b1d6244a95a",
                                        "entry_id": "9591864e-71ce-36e9-9358-53f808199508",
                                        "glosses": [
                                            "ein legendenhafter, menschenähnlicher Großprimat, der in den Hochgebirgsregionen Asiens (Himalaya, Pamir) leben soll, bisher aber nur aus Fußspuren, Exkrementen und behaupteten Begegnungen erschlossen ist. Die Existenz des Yeti ist wissenschaftlich nicht nachgewiesen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1997ca0-20e5-4408-94c9-90bdabd2c9f8",
                                                "sense_id": "fb90338a-60b7-33f4-9b89-3b1d6244a95a",
                                                "text": "Möglicherweise ist der Yeti nur eine Erfindung phantasiebegabter Menschen."
                                            },
                                            {
                                                "example_id": "e2f00738-3ba4-495e-89b4-f7ec093fcc33",
                                                "sense_id": "fb90338a-60b7-33f4-9b89-3b1d6244a95a",
                                                "text": "„In einer chinesischen Apotheke fand ein deutscher Paläontologe Zähne eines Riesenprimaten. Vielleicht waren frühe Menschen dem Giganten noch begegnet - und schufen die Legende vom Yeti.“"
                                            },
                                            {
                                                "example_id": "b517559f-096a-4c3f-ad70-5a7c6dfe98bc",
                                                "sense_id": "fb90338a-60b7-33f4-9b89-3b1d6244a95a",
                                                "text": "„… Was es hingegen mit dem Yeti auf sich hat, ob Gigantopithecus für ihn Modell stand, wird sich wohl nie klären lassen - auch wenn Einzelne unserer Zeitgenossen den Riesen in einsamen Gegenden des Himalayas gesehen haben wollen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
