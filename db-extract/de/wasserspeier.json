                    }
                ],
                "senses": [
                    {
                        "sense_id": "beb856da-8fbc-36c5-bed0-c2fd882c290f",
                        "entry_id": "aad66bc8-7492-309d-afec-a509719c93db",
                        "glosses": [
                            "Rohre oder Rinnen zur Wasserableitung an Dächern, häufig in Verbindung mit aus Stein gemeißeltem Bauschmuck, der motivisch meist Tierformen, Fabelwesen oder Menschenköpfe darstellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b33992c-faf7-4aa9-a920-6bae3583c5e1",
                                "sense_id": "beb856da-8fbc-36c5-bed0-c2fd882c290f",
                                "text": "Wasserspeier zieren viele alte Gebäude."
                            },
                            {
                                "example_id": "de37f19a-5181-49ae-a9f1-e6b8fc190707",
                                "sense_id": "beb856da-8fbc-36c5-bed0-c2fd882c290f",
                                "text": "„So schaute er wie ein melancholischer gotischer Wasserspeier auf die anderen herab.“"
                            },
                            {
                                "example_id": "47aa5117-70ae-48a2-aa8b-97d18209a480",
                                "sense_id": "beb856da-8fbc-36c5-bed0-c2fd882c290f",
                                "text": "„Über ihm im Mond schimmerte die blasse Fratze eines Wasserspeiers.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "76be4644-3b8c-4d54-9dde-418b44e7c2e5",
                        "source_entry_id": "aad66bc8-7492-309d-afec-a509719c93db",
                        "source_sense_id": "beb856da-8fbc-36c5-bed0-c2fd882c290f",
                        "target_lang_word": "gargoyle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gargoyle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d04ac34f-15bf-33e8-94d8-0ad6970cf4d0",
                                        "entry_id": "485994cc-0531-35ef-ba3b-44e7694fb34b",
                                        "glosses": [
                                            "A carved grotesque figure on a spout which conveys water away from the gutters."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6e8f946-5759-443d-a142-7c97f6160c62",
                                                "sense_id": "d04ac34f-15bf-33e8-94d8-0ad6970cf4d0",
                                                "text": "As we went, however, I took the precaution of noting our route as well as I could; and this was not so very difficult, owing to the extraordinary and most fantastic shape of the rocks that were strewn about, many of which in that dim light looked more like the grim faces carven upon mediæval gargoyles than ordinary boulders."
                                            },
                                            {
                                                "example_id": "1bc3dd15-0361-4b6f-9d5d-8a211eeb914a",
                                                "sense_id": "d04ac34f-15bf-33e8-94d8-0ad6970cf4d0",
                                                "text": "From between set teeth came now a flow of oaths and imprecations as steady as the flow of water from the gargoyle overhead."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f5eaea0-7c29-3c82-8e6b-ec5537568d83",
                                        "entry_id": "485994cc-0531-35ef-ba3b-44e7694fb34b",
                                        "glosses": [
                                            "Any decorative carved grotesque figure on a building."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e32f4bc-de13-42a3-83ca-19851038dea5",
                                                "sense_id": "6f5eaea0-7c29-3c82-8e6b-ec5537568d83",
                                                "text": "The long-closed G.W.R. station alongside has a decidedly derelict-looking frontage, with eight gargoyles or figureheads still clinging to the portico."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7506901-6745-3997-86b4-115b263255f7",
                                        "entry_id": "485994cc-0531-35ef-ba3b-44e7694fb34b",
                                        "glosses": [
                                            "A fictional winged monster."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8d6c86d-2e24-4efb-9dfd-a7d2aca7beb1",
                                                "sense_id": "d7506901-6745-3997-86b4-115b263255f7",
                                                "text": "Almost immediately one of the gargoyles swept down from the sky and attacked him. The gargoyle's momentum drove them both over the side."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b24cb43c-c9dd-30bf-84fe-e980f133ba1b",
                                        "entry_id": "485994cc-0531-35ef-ba3b-44e7694fb34b",
                                        "glosses": [
                                            "An ugly woman."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38a46520-84ad-4955-b7e5-a0d27aaa63df",
                                                "sense_id": "b24cb43c-c9dd-30bf-84fe-e980f133ba1b",
                                                "text": "Above all, in what reckless moment had she encouraged that person and her gargoyle of a mother to move to Mayfair, and set up house around the corner?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0b04dafa-2fab-4c22-ad48-684d2fbf2970",
                        "source_entry_id": "aad66bc8-7492-309d-afec-a509719c93db",
                        "source_sense_id": "beb856da-8fbc-36c5-bed0-c2fd882c290f",
                        "target_lang_word": "gargouille",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gargouille",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7d8e2ac4-0288-33e0-a6aa-23708873dde3",
                                        "entry_id": "3c7f3a69-b1fa-322f-bd45-4440d2a556a6",
                                        "glosses": [
                                            "Partie d’une gouttière ou d’un tuyau par où l’eau tombe, et qui est souvent ornée d’une figure de dragon, de lion ou de quelque autre animal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af4b4e57-f286-4570-8b86-2dd868e6f9b8",
                                                "sense_id": "7d8e2ac4-0288-33e0-a6aa-23708873dde3",
                                                "text": "Les gargouilles qui existent encore à l’extérieur indiquent d’une manière certaine que le chemin de ronde supérieur était à ciel ouvert."
                                            },
                                            {
                                                "example_id": "719edacb-b508-4cdb-b8f5-38220a3be8c2",
                                                "sense_id": "7d8e2ac4-0288-33e0-a6aa-23708873dde3",
                                                "text": "Il y eut un orage effroyable à la tombée de la nuit. Et, pendant qu’il tonnait à tout briser, comme si on eût tiré des salves d’artillerie sur le toit de la maison de mon oncle ; pendant que toutes les vieilles gargouilles du village vomissaient de l’eau tourmentée et que des torrents couraient sur les pavés en galets noirs des rues, nous nous étions réfugiés, les petits Peyral et moi, dans la cuisine, pour y faire tapage plus à notre aise et y danser des rondes."
                                            },
                                            {
                                                "example_id": "c68fcc30-4cc6-4f95-b05b-754886b2f1cd",
                                                "sense_id": "7d8e2ac4-0288-33e0-a6aa-23708873dde3",
                                                "text": "Elle levait les yeux sur le mur qu’ils longeaient, où des gargouilles s’avançaient comme des têtes effilées de serpents."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ee810ae-aed8-3112-9ade-7c4ddac96595",
                                        "entry_id": "3c7f3a69-b1fa-322f-bd45-4440d2a556a6",
                                        "glosses": [
                                            "Ces figures mêmes."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e59c6460-9943-48ab-9312-358723e4a94d",
                                                "sense_id": "3ee810ae-aed8-3112-9ade-7c4ddac96595",
                                                "text": "Les gargouilles de Notre-Dame de Paris."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06796f73-c4d0-3bb4-89c9-1ac5fd60158d",
                                        "entry_id": "3c7f3a69-b1fa-322f-bd45-4440d2a556a6",
                                        "glosses": [
                                            "Canal ou tuyau destiné à l’écoulement des eaux."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "56a3eef5-c135-38a3-bb65-7c4adacf8034",
                                        "entry_id": "3c7f3a69-b1fa-322f-bd45-4440d2a556a6",
                                        "glosses": [
                                            "Conduit qui amène les produits de la combustion dans la cheminée d’un haut fourneau."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
