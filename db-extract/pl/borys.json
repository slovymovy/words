                                "target_senses": [
                                    {
                                        "sense_id": "3739e8e0-8e98-3aaf-b43c-e1ddbbb38adf",
                                        "entry_id": "c3939961-49c7-305c-a5e1-7ce6f8b13b7d",
                                        "glosses": [
                                            "A male given name from the Slavic languages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a0f8c2d-661a-4866-a033-8da79ed387d9",
                                                "sense_id": "3739e8e0-8e98-3aaf-b43c-e1ddbbb38adf",
                                                "text": "Boris Johnson, Prime Minister of the United Kingdom (2019–2022)"
                                            },
                                            {
                                                "example_id": "9b8e149b-c250-424b-a257-447b396f02c8",
                                                "sense_id": "3739e8e0-8e98-3aaf-b43c-e1ddbbb38adf",
                                                "text": "2000 January, Frank McCourt (interviewee), Morning Edition, National Public Radio\nIt's not like a Russian novel, where you read nine hundred forty-three pages and then finally Boris the peasant decides to commit suicide, and you wish he’d done it on page four. It’s not like that at all."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f09272b-f96a-3100-aa9e-205d7d9f6ff3",
                                        "entry_id": "c3939961-49c7-305c-a5e1-7ce6f8b13b7d",
                                        "glosses": [
                                            "A person of Russian descent."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2ee3ce55-3760-42ba-a672-617cc4de635a",
                        "source_entry_id": "b3f14913-cdb7-39c2-bef3-0337c20eb0c1",
                        "source_sense_id": "a8d41366-259d-33c0-800e-f6aa12e614ec",
                        "target_lang_word": "Boris",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Boris",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "701fcefa-52e9-30cf-bd2f-7e352545dff8",
                                        "entry_id": "09f8a359-af9c-37a0-932f-dbac3d6d943e",
                                        "glosses": [
                                            "Prénom masculin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ac13ff4-ae47-45fe-9ddd-7ccfc510e1b5",
                                                "sense_id": "701fcefa-52e9-30cf-bd2f-7e352545dff8",
                                                "text": "À l’occasion du 35ᵉ anniversaire de l’exploration spatiale soviétique, le directeur du Centre de recherche Nilmach (Nijnaya Salda, oblast de Sverdlovsk), Boris Nekrassov, a émis l’espoir qu’un projet d’éclairage par réflecteurs placés en orbite géostationnaire dans l’espace pour capter les rayons solaires et les renvoyer sur des points placés à la surface de la terre serait bientôt réactivé."
                                            },
                                            {
                                                "example_id": "7c75d36b-a1b4-4895-8424-e878e986d053",
                                                "sense_id": "701fcefa-52e9-30cf-bd2f-7e352545dff8",
                                                "text": "« La déforestation annuelle a augmenté de 75 % depuis son arrivée au pouvoir, par rapport à la décennie précédente », indique Boris Patentreger, directeur France de Mighty Earth, ONG qui agit pour la protection des forêts tropicales."
                                            },
                                            {
                                                "example_id": "9e4883cc-1cfb-46db-9f23-89e8afc0d148",
                                                "sense_id": "701fcefa-52e9-30cf-bd2f-7e352545dff8",
                                                "text": "Sans oublier l’expérimenté Boris Neveu, qui s’est classé 13ᵉ en qualification."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8ece47d2-2eb5-4cb3-a377-9fb042c681ca",
                        "source_entry_id": "b3f14913-cdb7-39c2-bef3-0337c20eb0c1",
