                                "target_lang_sense_clarification": "комп. ячейка памяти"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "寄存器",
                                "target_lang_sense_clarification": "计算机内存单元"
                            }
                        ]
                    }
                }
            ]
        },
        {
