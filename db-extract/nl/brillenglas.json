                ],
                "translations": [
                    {
                        "translation_id": "425029ff-ca29-43ea-b85a-48a86fb11b8a",
                        "source_entry_id": "cd69f60d-2051-3cc1-86ab-5d4c8c8d6ef0",
                        "source_sense_id": "e5483a86-84d9-3bd9-ae0f-fd7354a216d2",
                        "source_sense_description": "de lens van een bril, die oogafwijkingen corrigeert",
                        "target_lang_word": "Brillenglas",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Brillenglas",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "36141418-4476-3add-86df-300aaa515da2",
                                        "entry_id": "ca7cb9e6-03c2-3e68-bee8-4f2cfd196925",
                                        "glosses": [
                                            "Glas einer Brille"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e559a16-905e-48a7-af1b-69c7e40a1b0e",
                                                "sense_id": "36141418-4476-3add-86df-300aaa515da2",
                                                "text": "„Mein Spitzbart war naß, Brillengläser angelaufen, Froschaugen entzündet, hatte rote Flecken in den Achselhöhlen und zwischen den Schenkeln, wußte das, obwohl ich das Rot nicht sehen konnte.“"
                                            },
                                            {
                                                "example_id": "ec281eb4-c88d-4632-bab8-734b6e6becb8",
                                                "sense_id": "36141418-4476-3add-86df-300aaa515da2",
                                                "text": "„Der kraulte in seinen nach innen gebogenen Barthaaren und Tom fielen seine schmutzigen Fingernägel auf, die irgendwie gut zu seinen verschmierten Brillengläsern passten.“"
                                            },
                                            {
                                                "example_id": "3074b72e-80d6-4b80-87a1-4a2d0291db77",
                                                "sense_id": "36141418-4476-3add-86df-300aaa515da2",
                                                "text": "„Plötzlich flogen seine Augenbrauen in die Höhe, so daß die Augen hinter den Brillengläsern aufblühten.“"
                                            },
                                            {
                                                "example_id": "50b9c921-2af7-402a-b7a6-5184529122e2",
                                                "sense_id": "36141418-4476-3add-86df-300aaa515da2",
                                                "text": "„Pierre sah sie durch seine Brillengläser an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
