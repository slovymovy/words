                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9dd07d5c-4e87-4b1e-821e-3423e60cacb1",
                        "source_entry_id": "88a68bb3-efb9-3cb0-89fa-84eb9dfd80bc",
                        "source_sense_description": "дар, умение говорить красиво",
                        "target_lang_word": "eloquence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eloquence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "772cae1a-695d-32f3-bdf5-356012469e04",
                                        "entry_id": "1c06dba6-fe2d-3519-a66f-f253500569fd",
                                        "glosses": [
                                            "The quality of artistry and persuasiveness in speech or writing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ecfd5a3-a77e-43d1-9f4b-0c16a741f831",
                                                "sense_id": "772cae1a-695d-32f3-bdf5-356012469e04",
                                                "text": "speak with eloquence"
                                            },
                                            {
                                                "example_id": "0fc8c876-9371-491d-919c-e8ac3d3ee43a",
                                                "sense_id": "772cae1a-695d-32f3-bdf5-356012469e04",
                                                "text": "express oneself with eloquence"
                                            },
                                            {
                                                "example_id": "3aeef99c-e62a-4994-9d74-8f66ec8651e5",
                                                "sense_id": "772cae1a-695d-32f3-bdf5-356012469e04",
                                                "text": "Thy paleneſſe [var. plainness] moues me more then eloquence,\nAnd heere chooſe I, ioy be the conſequence!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76d6458c-f598-30af-bd55-e0cb297073c1",
                                        "entry_id": "1c06dba6-fe2d-3519-a66f-f253500569fd",
                                        "glosses": [
                                            "An eloquent utterance."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5f535c01-141e-4433-9938-8e59f875c3a5",
                        "source_entry_id": "88a68bb3-efb9-3cb0-89fa-84eb9dfd80bc",
                        "source_sense_description": "дар, умение говорить красиво",
                        "target_lang_word": "Beredsamkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Beredsamkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f180905c-e519-3a3e-8427-486893f32f7a",
                                        "entry_id": "ebb35165-6dcd-3317-86f1-d9186b4b700e",
                                        "glosses": [
                                            "hervorragende sprachliche Ausdrucksfähigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "198113b9-3ec0-44d1-8636-a6709f463a20",
                                                "sense_id": "f180905c-e519-3a3e-8427-486893f32f7a",
                                                "text": "Eine stark ausgeprägte Beredsamkeit kommt Politikern zugute."
                                            },
                                            {
                                                "example_id": "532a100a-ea71-44a9-92fc-186775a6d979",
                                                "sense_id": "f180905c-e519-3a3e-8427-486893f32f7a",
                                                "text": "„Die Poesie als Dienerin der Beredsamkeit: dies war auch der didaktische Grundsatz von Christian Weise, der als Rektor des Gymnasiums zu Zittau und als Verfasser von Schauspielen, Romanen und zahlreichen Lehrbüchern gleichzeitig mit Thomasius und vielleicht wirkungsvoller noch als dieser der deutschen Stilbildung im 18. Jahrhundert den Weg gewiesen hat.“"
                                            },
                                            {
                                                "example_id": "cc1dca8c-7dfb-4833-bc75-1b8e379dc03a",
                                                "sense_id": "f180905c-e519-3a3e-8427-486893f32f7a",
                                                "text": "„Ich konnte mir gut vorstellen, wie das gebieterische Männlein die biederen Pratts mit seiner Beredsamkeit und seinem Ernst gefangen genommen hatte.“"
                                            },
                                            {
                                                "example_id": "25a981f4-be32-48aa-b3b2-771f0375c2c8",
                                                "sense_id": "f180905c-e519-3a3e-8427-486893f32f7a",
                                                "text": "„Seine verliebte Beredsamkeit wuchs in dem Maß, wie er seine Kehle mit Champagner, Zyperwein und Likör befeuchtete.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "05191561-3ece-43f3-a7c0-4d9928e28d08",
                        "source_entry_id": "88a68bb3-efb9-3cb0-89fa-84eb9dfd80bc",
                        "source_sense_description": "дар, умение говорить красиво",
                        "target_lang_word": "Redekunst",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Redekunst",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9cb0f4ca-e4b6-3dc3-81ec-1e3264408a4a",
                                        "entry_id": "249cb7d5-9142-326a-b9c3-35942f57846f",
                                        "glosses": [
                                            "(Lehre von der) Kunst, eine Rede wirkungsvoll zu gestalten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90f46f9d-bd38-4883-b4f1-6d3105f055e7",
                                                "sense_id": "9cb0f4ca-e4b6-3dc3-81ec-1e3264408a4a",
                                                "text": "„Das wichtigste Element ist natürlich der Wille, die Redekunst, die Mimik und die Gestik des Redners.“"
                                            },
                                            {
                                                "example_id": "f65c9575-65e7-48e6-92f9-d88db36e5442",
                                                "sense_id": "9cb0f4ca-e4b6-3dc3-81ec-1e3264408a4a",
                                                "text": "„Die Griechen sahen die Redekunst als eine Vereinigung von Kunst und Wissenschaft an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
