{
    "word_family": [
        "compaction",
        "compactor",
        "compactly",
        "compactness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "81d71a9d-b3b3-3aba-a848-5d950b491455",
                    "sense_definition": "Having all necessary features fitting neatly into a small space.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "small_neat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>compact</w> design of the camera makes it easy to carry in a pocket.",
                            "target_lang_translations": {
                                "ru": "<w>Компактный</w> дизайн камеры позволяет легко носить её в кармане.",
                                "zh": "这款相机的<w>紧凑</w>设计使其很容易装在口袋里携带。"
                            }
                        },
                        {
                            "text": "They live in a <w>compact</w> apartment that is very easy to clean.",
                            "target_lang_translations": {
                                "ru": "Они живут в <w>компактной</w> квартире, которую очень легко убирать.",
                                "zh": "他们住在一间<w>小巧</w>的公寓里，打扫起来非常方便。"
                            }
                        }
                    ],
                    "antonyms": [
                        "spread out"
                    ],
                    "common_phrases": [
                        "compact car",
                        "compact disc",
                        "compact design"
                    ],
                    "target_lang_definitions": {
                        "ru": "Занимающий мало места; имеющий небольшой размер при сохранении всех необходимых функций.",
                        "zh": "指体积小巧，在保持所有必要功能的同时占用空间很少。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "компактный",
                                "target_lang_sense_clarification": "занимающий мало места"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "小巧的",
                                "target_lang_sense_clarification": "形容物体体积小且设计精巧"
                            },
                            {
                                "target_lang_word": "紧凑的",
                                "target_lang_sense_clarification": "形容结构紧密，不占空间"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e294fc40-ab6b-32f1-a4f6-686468504dcf",
                    "sense_definition": "Closely packed or densely constituted; having much material in a small volume.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "dense_packed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soil in the garden was so <w>compact</w> that it was difficult to dig.",
                            "target_lang_translations": {
                                "ru": "Почва в саду была такой <w>плотной</w>, что её было трудно копать.",
                                "zh": "花园里的土壤非常<w>致密</w>，很难挖掘。"
                            }
                        },
                        {
                            "text": "Snow becomes <w>compact</w> and slippery after many people have walked on it.",
                            "target_lang_translations": {
                                "ru": "Снег становится <w>спрессованным</w> и скользким после того, как по нему проходит много людей.",
                                "zh": "雪在经过多人踩踏后变得<w>压实</w>且湿滑。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dense",
                        "solid",
                        "thick",
                        "tight"
                    ],
                    "antonyms": [
                        "loose",
                        "diffuse"
                    ],
                    "common_phrases": [
                        "compact soil",
                        "compact snow"
                    ],
                    "target_lang_definitions": {
                        "ru": "Плотный, спрессованный; состоящий из тесно прилегающих друг к другу частиц.",
                        "zh": "指物质紧密堆积，在较小体积内含有大量物质。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плотный",
                                "target_lang_sense_clarification": "о структуре вещества"
                            },
                            {
                                "target_lang_word": "спрессованный",
                                "target_lang_sense_clarification": "сжатый под давлением"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "致密的",
                                "target_lang_sense_clarification": "形容物质结构紧密"
                            },
                            {
                                "target_lang_word": "压实的",
                                "target_lang_sense_clarification": "形容被挤压在一起的状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b90520d4-81d7-3a7a-a2a1-077fa617ca96",
                    "sense_definition": "Brief and pithy; not verbose.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "concise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author is known for his <w>compact</w> writing style that wastes no words.",
                            "target_lang_translations": {
                                "ru": "Автор известен своим <w>лаконичным</w> стилем письма, в котором нет лишних слов.",
                                "zh": "这位作者以其不浪费词句的<w>简洁</w>文风而闻名。"
                            }
                        },
                        {
                            "text": "She gave a <w>compact</w> summary of the meeting's main points.",
                            "target_lang_translations": {
                                "ru": "Она представила <w>сжатое</w> резюме основных моментов встречи.",
                                "zh": "她对会议要点做了<w>精炼</w>的总结。"
                            }
                        }
                    ],
                    "antonyms": [
                        "diffuse"
                    ],
                    "common_phrases": [
                        "compact style"
                    ],
                    "target_lang_definitions": {
                        "ru": "Краткий, сжатый, лаконичный (о стиле изложения).",
                        "zh": "指言简意赅，不冗长。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лаконичный",
                                "target_lang_sense_clarification": "краткий и выразительный"
                            },
                            {
                                "target_lang_word": "сжатый",
                                "target_lang_sense_clarification": "без лишних слов"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "简洁的",
                                "target_lang_sense_clarification": "形容文风简练"
                            },
                            {
                                "target_lang_word": "精炼的",
                                "target_lang_sense_clarification": "形容表达言之有物且简短"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "22f57a23-895a-351e-b0c6-095c753a1c1d",
                    "sense_definition": "Of a topological space: such that every open cover has a finite subcover.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "math_topology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In this mathematical theorem, the set must be <w>compact</w> and non-empty.",
                            "target_lang_translations": {
                                "ru": "В этой математической теореме множество должно быть <w>компактным</w> и непустым.",
                                "zh": "在这个数学定理中，该集合必须是<w>紧致</w>且非空的。"
                            }
                        },
                        {
                            "text": "A closed interval on the real line is a classic example of a <w>compact</w> set.",
                            "target_lang_translations": {
                                "ru": "Замкнутый интервал на вещественной прямой — классический пример <w>компактного</w> множества.",
                                "zh": "实数轴上的闭区间是<w>紧致</w>集合的经典例子。"
                            }
                        }
                    ],
                    "antonyms": [
                        "noncompact"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Топологическое пространство, в котором из любого открытого покрытия можно выделить конечное подпокрытие.",
                        "zh": "拓扑学术语，指一个空间中任何开覆盖都存在有限子覆盖。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "компактный",
                                "target_lang_sense_clarification": "математический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "紧致的",
                                "target_lang_sense_clarification": "数学拓扑学概念"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "537d7daf-d98d-3c0b-b589-6d4587606faf",
                    "sense_definition": "An automobile that is larger than a subcompact but smaller than an intermediate car.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "small_neat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to rent a <w>compact</w> for our road trip to save money on gas.",
                            "target_lang_translations": {
                                "ru": "Мы решили арендовать <w>компактный автомобиль</w> для нашей поездки, чтобы сэкономить на бензине.",
                                "zh": "为了节省油费，我们决定租一辆<w>紧凑型轿车</w>去公路旅行。"
                            }
                        },
                        {
                            "text": "Parking in the city is much easier when you drive a <w>compact</w>.",
                            "target_lang_translations": {
                                "ru": "Парковаться в городе намного проще, когда водишь <w>малолитражку</w>.",
                                "zh": "开<w>紧凑型轿车</w>在城里停车会容易得多。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "drive a compact",
                        "rent a compact"
                    ],
                    "target_lang_definitions": {
                        "ru": "Автомобиль, который больше малолитражного, но меньше среднего класса.",
                        "zh": "一种比微型车大但比中型车小的汽车类型。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "компактный автомобиль",
                                "target_lang_sense_clarification": "тип кузова"
                            },
                            {
                                "target_lang_word": "малолитражка",
                                "target_lang_sense_clarification": "разг. небольшой автомобиль"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "紧凑型轿车",
                                "target_lang_sense_clarification": "汽车分类"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0bd49805-8093-3f63-b621-c8b4e67854ca",
                    "sense_definition": "An official agreement or contract between two or more parties.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "agreement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two nations signed a <w>compact</w> to reduce trade barriers and promote peace.",
                            "target_lang_translations": {
                                "ru": "Две страны подписали <w>пакт</w> о снижении торговых барьеров и укреплении мира.",
                                "zh": "两国签署了一项<w>协定</w>，以减少贸易壁垒并促进和平。"
                            }
                        },
                        {
                            "text": "The mayor spoke about the social <w>compact</w> that exists between the government and its citizens.",
                            "target_lang_translations": {
                                "ru": "Мэр говорил об общественном <w>договоре</w>, который существует между правительством и гражданами.",
                                "zh": "市长谈到了政府与公民之间存在的社会<w>契约</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "agreement",
                        "contract",
                        "pact",
                        "treaty"
                    ],
                    "common_phrases": [
                        "social compact",
                        "sign a compact"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальное соглашение или договор между двумя или более сторонами.",
                        "zh": "双方或多方之间达成的正式协议或契约。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "договор",
                                "target_lang_sense_clarification": "официальное соглашение"
                            },
                            {
                                "target_lang_word": "пакт",
                                "target_lang_sense_clarification": "торжественный договор"
                            },
                            {
                                "target_lang_word": "соглашение",
                                "target_lang_sense_clarification": "взаимная договоренность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "契约",
                                "target_lang_sense_clarification": "正式的法律或社会协议"
                            },
                            {
                                "target_lang_word": "协定",
                                "target_lang_sense_clarification": "双方达成的正式约定"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "90b7cd1b-9211-3bb1-bd2d-825860aa415c",
                    "sense_definition": "A small folding case containing a mirror and face powder.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "small_neat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She took a small silver <w>compact</w> from her purse to check her makeup.",
                            "target_lang_translations": {
                                "ru": "Она достала из сумочки маленькую серебряную <w>пудреницу</w>, чтобы проверить макияж.",
                                "zh": "她从钱包里拿出一个银色的小<w>粉饼盒</w>来检查妆容。"
                            }
                        },
                        {
                            "text": "The vintage <w>compact</w> was a beautiful accessory from the 1950s.",
                            "target_lang_translations": {
                                "ru": "Винтажная <w>пудреница</w> была прекрасным аксессуаром 1950-х годов.",
                                "zh": "这个复古<w>粉饼盒</w>是20世纪50年代一件精美的配饰。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая коробочка с зеркальцем и пудрой.",
                        "zh": "一种带有镜子和粉饼的小型折叠化妆盒。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пудреница",
                                "target_lang_sense_clarification": "косметическая принадлежность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "粉饼盒",
                                "target_lang_sense_clarification": "化妆用品"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2bc144b7-d9de-3262-99ca-0a2d8401537c",
                    "sense_definition": "To make something more dense or solid by pressing it together.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dense_packed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Construction workers used a heavy machine to <w>compact</w> the dirt before laying the foundation.",
                            "target_lang_translations": {
                                "ru": "Строители использовали тяжелую машину, чтобы <w>утрамбовать</w> землю перед закладкой фундамента.",
                                "zh": "建筑工人在打地基前使用重型机械将泥土<w>压实</w>。"
                            }
                        },
                        {
                            "text": "The garbage truck is designed to <w>compact</w> waste so it takes up less space.",
                            "target_lang_translations": {
                                "ru": "Мусоровоз предназначен для того, чтобы <w>спрессовывать</w> отходы, чтобы они занимали меньше места.",
                                "zh": "垃圾车的设计旨在将废物<w>压缩</w>，以减少其占用的空间。"
                            }
                        }
                    ],
                    "synonyms": [
                        "compress",
                        "condense"
                    ],
                    "common_phrases": [
                        "compact the soil",
                        "compact trash"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать что-либо более плотным или твердым путем сжатия.",
                        "zh": "通过挤压使某物变得更致密或坚实。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уплотнять",
                                "target_lang_sense_clarification": "делать плотным"
                            },
                            {
                                "target_lang_word": "спрессовывать",
                                "target_lang_sense_clarification": "сжимать в ком"
                            },
                            {
                                "target_lang_word": "трамбовать",
                                "target_lang_sense_clarification": "уплотнять ударами или давлением"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "压实",
                                "target_lang_sense_clarification": "通过压力使物体紧密"
                            },
                            {
                                "target_lang_word": "压缩",
                                "target_lang_sense_clarification": "减小体积使其紧密"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}