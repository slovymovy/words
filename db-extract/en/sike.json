            {
                "entry_id": "f754b711-cc20-34f1-86b7-23561e579acc",
                "word": "sike",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "14ed6f6d-6bcc-4fd3-a40e-37d592e5b410",
                        "entry_id": "f754b711-cc20-34f1-86b7-23561e579acc",
                        "tags": [
                            "plural"
                        ],
                        "form": "sikes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cda9139d-5273-3bf4-962d-cb0eae1812f7",
                        "entry_id": "f754b711-cc20-34f1-86b7-23561e579acc",
                        "glosses": [
                            "A gutter or ditch; a small stream that frequently dries up in the summer; the marshy ground or ditch through which such a stream flows."
                        ],
                        "tags": [
                            "Northumbria",
                            "Scotland"
                        ],
                        "examples": [
                            {
                                "example_id": "e4aed215-1d52-455e-a2b9-57a9ca22a251",
                                "sense_id": "cda9139d-5273-3bf4-962d-cb0eae1812f7",
                                "text": "The swankies lap thro' mire and syke, Wow as their heads did birr!"
                            },
                            {
                                "example_id": "989bdb5b-3fb8-4ee6-96e5-0742b3083bff",
                                "sense_id": "cda9139d-5273-3bf4-962d-cb0eae1812f7",
                                "text": "[...] a great gathering o' their folk at the Miry-sikes, […]"
                            },
                            {
                                "example_id": "ce1a9fb9-df66-4255-ac17-6c0fe4643366",
                                "sense_id": "cda9139d-5273-3bf4-962d-cb0eae1812f7",
                                "text": "It neither grew in syke nor ditch, Nor yet in ony sheugh;[…]"
                            },
                            {
                                "example_id": "5d480c34-596f-435e-953d-4173c8f272d4",
                                "sense_id": "cda9139d-5273-3bf4-962d-cb0eae1812f7",
                                "text": "The wind made wave the red weed on the dike. Bedoven in dankès deep was every sike;[…]"
                            },
                            {
                                "example_id": "994db4d6-5a34-4ef1-be7d-90012f1326a7",
                                "sense_id": "cda9139d-5273-3bf4-962d-cb0eae1812f7",
                                "text": "[…] hills and mountains, moss or mure, bank or syke, sea or shore,[…]"
                            },
                            {
                                "example_id": "5cb4801c-c1a3-4ac4-a9e5-c0dbe251cb2d",
                                "sense_id": "cda9139d-5273-3bf4-962d-cb0eae1812f7",
                                "text": "The march of that herding is to come from the Rispie syke to the point at Blood syke Bottom to the stone syke-head."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
