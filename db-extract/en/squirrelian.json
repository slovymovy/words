                        ],
                        "examples": [
                            {
                                "example_id": "3889d94c-fe20-485c-b9e1-a7605d49c92b",
                                "sense_id": "5d8b36f3-3387-3409-891d-f3881840108c",
                                "text": "When they rest from their squirrelian revolutions, and die in the Lord, and their works do follow them, these are what will follow them: […]"
                            },
                            {
                                "example_id": "87387282-daf0-4a46-867f-2df26951d502",
                                "sense_id": "5d8b36f3-3387-3409-891d-f3881840108c",
                                "text": "One such individual living in California's Yosemite National Park concluded, after what must have been a tremendous bit of squirrelian cogitation, that summer time was too precious to waste by gathering and burying nuts piecemeal."
                            },
                            {
                                "example_id": "4327fc6a-054b-411d-9862-59542fd3f8d1",
                                "sense_id": "5d8b36f3-3387-3409-891d-f3881840108c",
                                "text": "Collectively, these groups constitute the regiments of the red-squirrelian defence force."
                            }
                        ]
                    }
