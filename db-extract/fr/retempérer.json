                "senses": [
                    {
                        "sense_id": "740f5c74-b1f2-339e-a153-b091e56d1828",
                        "entry_id": "35b93551-8fd5-31da-8c0b-1d3758c42f0d",
                        "glosses": [
                            "Tempérer à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f7b9769-50c9-4d0c-a6bd-911bce0fd883",
                                "sense_id": "740f5c74-b1f2-339e-a153-b091e56d1828",
                                "text": "Il y fut hébergé chez son ami le marquis de Lavradio, vice-roi du Brésil, et c'est là qu'il commença à retempérer ses forces, tout en profitant de son séjour pour tenter d'en finir avec les problèmes embrouillés de la succession du colonel Matias Barbosa, et donner une meilleure administration aux propriétés qui n'avaient pas encore trouvé acquéreur."
                            },
                            {
                                "example_id": "23c4efaa-72a4-4e34-bbfa-06c3d7689d81",
                                "sense_id": "740f5c74-b1f2-339e-a153-b091e56d1828",
                                "text": "César Pompon a sa dignité. Elle veut la guerre, elle l'aura ! » « César, calme-toi ! » retempère Angèle qui s'en retourne à la cuisine."
                            }
                        ]
                    }
