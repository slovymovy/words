                "senses": [
                    {
                        "sense_id": "508a2661-2730-30c9-ad9b-20aa09ab78ca",
                        "entry_id": "a293b5e9-1113-32c8-9023-47c6fd3777c4",
                        "glosses": [
                            "Traiter au sélénium."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47fd5a4a-d1a9-4388-b370-e5cb2446d8ed",
                                "sense_id": "508a2661-2730-30c9-ad9b-20aa09ab78ca",
                                "text": "La surface est limée et polie ; pour la sélénier, on la chauffe sur un bec Bunsen et on la frotte avec un crayon de sélénium."
                            },
                            {
                                "example_id": "af0af58c-d89f-417f-a0d3-b1e6f3ef73a4",
                                "sense_id": "508a2661-2730-30c9-ad9b-20aa09ab78ca",
                                "text": "Ces plants, peu aptes à absorber les éléments nutritifs du sol, ne pouvaient significativement absorber le Se qui s'y trouvait. Ces résultats montrent que l'on aura intérêt à sélénier les plants avant leur installation en forêt si l'on veut un effet répulsif immédiat."
                            }
                        ]
                    }
