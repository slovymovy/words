                "senses": [
                    {
                        "sense_id": "40afbb2d-dad7-39c6-9fdf-81e1df79a695",
                        "entry_id": "95104c99-5700-3e87-9520-3a42db62bf8e",
                        "glosses": [
                            "Texte d’où sont délibérément exclues certaines lettres de l’alphabet."
                        ],
                        "tags": [
                            "rhetoric"
                        ],
                        "examples": [
                            {
                                "example_id": "e37ca8b3-ea66-4d76-88a9-81be866d3ed6",
                                "sense_id": "40afbb2d-dad7-39c6-9fdf-81e1df79a695",
                                "text": "La difficulté d'écrire un lipogramme dépend des lettres que l'on souhaite éviter."
                            },
                            {
                                "example_id": "2b730bdf-276b-47b7-91c5-ba33fc4edabc",
                                "sense_id": "40afbb2d-dad7-39c6-9fdf-81e1df79a695",
                                "text": "Extrait de La Disparition, par Georges Perec, voici un lipogramme excluant la lettre e : « Là où nous vivions jadis, il n’y avait ni autos, ni taxis, ni autobus : nous allions parfois, mon cousin m’accompagnait, voir Linda qui habitait dans un canton voisin.»"
                            },
                            {
                                "example_id": "24233dbb-e088-4901-8c10-1ef5677c4e8e",
                                "sense_id": "40afbb2d-dad7-39c6-9fdf-81e1df79a695",
                                "text": "« constitutionnalisassions » est le plus long mot lipogramme en « e » (il n’en comporte aucun)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6b913db2-0574-470f-8161-3ea7cc783b3c",
                        "source_entry_id": "95104c99-5700-3e87-9520-3a42db62bf8e",
                        "source_sense_id": "40afbb2d-dad7-39c6-9fdf-81e1df79a695",
                        "target_lang_word": "Leipogramm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Leipogramm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "18022eb7-d0d4-338a-bac8-c9e1367f5327",
                                        "entry_id": "f8b74376-0b7d-3b0c-89ca-10476c4d8367",
                                        "glosses": [
                                            "Text, bei dem bewusst ein bestimmter Buchstabe (oder mehrere) nie verwendet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdb73fa6-764b-4709-96c0-5a39346789a1",
                                                "sense_id": "18022eb7-d0d4-338a-bac8-c9e1367f5327",
                                                "text": "„Ein Leipogramm (manchmal auch ‚Lipogramm‘ genannt) ist also eine Schreibart, die bewußt einen oder mehrere Buchstaben meidet, aus einfacher literarischer Spielerei, um Klangmalerei zu erzielen oder aus sonstigen Motiven.“"
                                            },
                                            {
                                                "example_id": "c448cc60-f845-4da6-8db8-4c47f18f3e60",
                                                "sense_id": "18022eb7-d0d4-338a-bac8-c9e1367f5327",
                                                "text": "„Sie dichten Leipogramme, bei denen es verboten ist, Labiale (Laute, die mit den Lippen gebildet werden, also b, p, m) zu verwenden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
