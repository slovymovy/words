                                        "glosses": [
                                            "im Pazifik gelegene Insel, Territorium der USA"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74870cfb-5072-42bb-b232-2705416fd1c2",
                                                "sense_id": "b6548d00-be5c-3dc5-88f3-2705d68678a4",
                                                "text": "Die Insel Guam ist Teil der Marianen."
                                            }
