        "fr-extract.jsonl": [
            {
                "entry_id": "3c10c233-6e4c-39e8-9da8-ccc5f1a467d7",
                "word": "légrefass",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "53a7e058-ef3f-3182-90e0-f4772df96d62",
                        "entry_id": "3c10c233-6e4c-39e8-9da8-ccc5f1a467d7",
                        "glosses": [
                            "Très gros tonneau, pouvant contenir plusieurs hectolitres."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "8db0bb26-16e4-47bc-8cc2-a8ece963ab0c",
                                "sense_id": "53a7e058-ef3f-3182-90e0-f4772df96d62",
                                "text": "Toutes les vignes chargées de ce fruit bienfaisant que le ciel offre aux infortunés pour leur faire oublier leur misère ; le bruit des tonneaux, des cuves, les légrefass qu’on relie de toutes parts ; le chant des vendangeuses dont ces coteaux retentissent ; la marche continuelle de ceux qui portent la vendange au pressoir ; … : tout conspire à lui donner un air de fête ; et cette fête n’en devient que plus belle à la réflexion, quand on songe qu’elle est la seule où les hommes aient su joindre l’agréable à l’utile."
                            },
                            {
                                "example_id": "e36f4cff-82db-4478-9bdb-3543cee0f756",
                                "sense_id": "53a7e058-ef3f-3182-90e0-f4772df96d62",
                                "text": "Les ouvrages qui dépendent de l’art du tonnelier sont sans doute remarquables … ; mais l’on ne peut voir sans étonnement ces tonnes monstrueuses, qui contiennent quelques centaines de muids de liqueur, connues en Allemagne sous le nom de foudres, ou de légrefass."
                            },
                            {
                                "example_id": "e5fb9a98-df7e-4129-acd0-1c4c0b8adce4",
                                "sense_id": "53a7e058-ef3f-3182-90e0-f4772df96d62",
                                "text": "On fait les légrefass ronds ou ovales, mais plus ordinairement ronds, comme plus faciles à construire, moins sujets à couler, & plus durables."
                            },
                            {
                                "example_id": "84b7836e-3229-4076-8c1e-3f824d5fc0b3",
                                "sense_id": "53a7e058-ef3f-3182-90e0-f4772df96d62",
                                "text": "Remplissez vos tonneaux et légrefass de vin nouveau tous les huit jours, pendant le premier mois, après qu'il a cessé de bouillir, tous les 15 jours les deux mois suivans^([sic]), et ensuite comme les vieux tous les mois."
                            }
                        ]
                    }
                ],
