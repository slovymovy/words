                "senses": [
                    {
                        "sense_id": "ae2f6acd-4a37-3c5c-ab2e-22615e32b732",
                        "entry_id": "636031e3-389e-33e9-89ba-8ae78d00e56a",
                        "glosses": [
                            "Wikifier plus que nécessaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b9f0b3e-6c23-4cf6-8338-fbc06d76e544",
                                "sense_id": "ae2f6acd-4a37-3c5c-ab2e-22615e32b732",
                                "text": "Il est vrai que j'ai une tendance récurrente à sur-wikifier."
                            },
                            {
                                "example_id": "8528e3a3-6142-4e38-bd96-44ec6551af3f",
                                "sense_id": "ae2f6acd-4a37-3c5c-ab2e-22615e32b732",
                                "text": "Tiens, à propos Pixel, pourquoi tu as sur-wikifié le début du résumé, avec des LI comme sol, poussière, ferme etc.. ?"
                            },
                            {
                                "example_id": "5266451f-e164-4d55-b4cc-ca66cf4d42c5",
                                "sense_id": "ae2f6acd-4a37-3c5c-ab2e-22615e32b732",
                                "text": "Remerciements en retour sur vos travaux: très complets et renseignés. Parmi ceux-ci (très nombreux), pourriez-vous m'en indiquez qq uns à \"sur-wikifier\"?"
                            }
                        ]
