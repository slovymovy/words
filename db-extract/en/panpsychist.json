                "senses": [
                    {
                        "sense_id": "6fcd130e-926b-3b1b-ba13-beec64819b7b",
                        "entry_id": "e8f16eab-49dc-3231-8fdf-a8b3a8043278",
                        "glosses": [
                            "Pertaining to, or in accordance with, the doctrine of panpsychism."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85534455-8fe9-4a60-a874-39e083d728b9",
                                "sense_id": "6fcd130e-926b-3b1b-ba13-beec64819b7b",
                                "text": "1984, Timothy Sprigge, Santayana and Panpsychism, in Overheard in Seville: Bulletin of the Santayana Society, No. 2: Fall 1984, page 1,\nSantayana was certainly not a panpsychist. However, I believe that there are panpsychist tendencies in his work."
                            },
                            {
                                "example_id": "c94203ed-978e-4843-af1f-12245067e953",
                                "sense_id": "6fcd130e-926b-3b1b-ba13-beec64819b7b",
                                "text": "Meditational practices are quite consistent with, and even conducive to, a panpsychist outlook, but the aim of panpsychism is not to attain enlightenment."
                            },
                            {
                                "example_id": "14e97db2-e1f5-41b2-b5fe-54fe6e6e5eae",
                                "sense_id": "6fcd130e-926b-3b1b-ba13-beec64819b7b",
                                "text": "However, seeds have been planted for a panpsychist reading in the suggestion that in order to truly move beyond the consciousness-object distinction Merleau-Ponty's ontology would need to be more panpsychist than those of Leibniz and Scheler, not less."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bc6e1ee7-d0c0-468a-90fd-4f9252317b25",
                        "source_entry_id": "e8f16eab-49dc-3231-8fdf-a8b3a8043278",
