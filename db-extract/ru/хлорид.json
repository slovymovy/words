                                        "glosses": [
                                            "een verbinding van chloor waarin dit element een oxidatiegetal van -1 bezit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "145d9df7-2440-45df-8388-2c24602c6cd2",
                                                "sense_id": "f5d63d4b-9b22-3340-85e9-6a36f10a51bf",
                                                "text": "Keukenzout is verreweg het bekendste chloride, maar ook een organische verbinding zoals trichloorethaan kan als een chloride beschouwd worden."
                                            }
