                                "example_id": "816494bb-4a17-4d3e-89c1-74869303b106",
                                "sense_id": "c4881d7b-562d-3871-a640-5d45542efdb3",
                                "text": "„Von März bis September des Jahres bereiste er England und Schottland, wo er über siebzigmal öffentlich sprach.“"
                            },
                            {
                                "example_id": "3d4550f0-9f40-440a-8422-88cdb0d2be11",
                                "sense_id": "c4881d7b-562d-3871-a640-5d45542efdb3",
                                "text": "„Der Bildschirm wird nicht wie auf Monitoren siebzigmal in der Sekunde ausgelöscht und neu beschrieben.“"
                            },
                            {
                                "example_id": "d045d2a2-fc6f-40b7-a00c-e4baa4cd8e16",
                                "sense_id": "c4881d7b-562d-3871-a640-5d45542efdb3",
                                "text": "„Teilweise ist die Kriminalitätsdichte der Innenstadt siebzigmal so hoch wie jene der Randgebiete“"
                            },
                            {
                                "example_id": "fe45b33e-524a-4bad-b7ae-dde65a814339",
                                "sense_id": "c4881d7b-562d-3871-a640-5d45542efdb3",
                                "text": "„Sein Kohlhaas jedoch ist wesentlich eine Geschichte über Dresden und über sächsische Zustände; mehr als siebzigmal wird die Stadt in der Buch-Fassung genannt[.]“"
                            }
                        ],
