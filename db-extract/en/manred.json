                        "examples": [
                            {
                                "example_id": "9ca41723-0641-47f0-98d8-4f5320a33eea",
                                "sense_id": "9f4823c6-caf9-39a1-910f-1b8240d3522e",
                                "text": "They were made of the manred, that is, of the elements in the extremities of their particles and smallest atom … God was in each of the particles of the manred, […]"
                            },
                            {
                                "example_id": "52739225-a06c-4f2a-a6ee-208a6abad5f4",
                                "sense_id": "9f4823c6-caf9-39a1-910f-1b8240d3522e",
                                "text": "God pronounce his ineffable name, and Manred, the primal substance of the Universe, was formed. Manred was composed of thousands of teeming atoms in each of which God was present, and each was part of God."
                            }
                        ]
