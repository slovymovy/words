                                                "example_id": "1fbef429-d897-4767-ad4a-2c58f6e4e0f0",
                                                "sense_id": "5744695e-67f1-31e7-97dd-a23a203175e2",
                                                "text": "Nos reímos horrores con la rutina del comediante."
                                            }
