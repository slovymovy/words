                "senses": [
                    {
                        "sense_id": "20fc3178-930d-3c79-b8a7-e1c7339be350",
                        "entry_id": "78a8aa48-8184-39c4-98da-f1e4396898e9",
                        "glosses": [
                            "star vasthoudend aan een bepaald geloof"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3cc036c9-129d-419b-8ac5-693860407a11",
                                "sense_id": "20fc3178-930d-3c79-b8a7-e1c7339be350",
                                "text": "Orthodoxe christenen."
                            }
                        ]
                    },
                    {
                        "sense_id": "d42222aa-783c-3b91-a445-2d91dfe11bcc",
                        "entry_id": "78a8aa48-8184-39c4-98da-f1e4396898e9",
                        "glosses": [
                            "star vasthoudend aan bepaalde opvattingen of gewoontes die algemeen zijn aanvaard"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33b9916f-c2d8-4e93-b563-da9c78cdee87",
                                "sense_id": "d42222aa-783c-3b91-a445-2d91dfe11bcc",
                                "text": "Een orthodoxe manier van werken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b107e5f2-fd7e-4893-9443-de3279c8a2c1",
                        "source_entry_id": "78a8aa48-8184-39c4-98da-f1e4396898e9",
                        "source_sense_id": "20fc3178-930d-3c79-b8a7-e1c7339be350",
                        "source_sense_description": "star vasthoudend aan een bepaald geloof",
                        "target_lang_word": "orthodox",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "orthodox",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "44be6360-2c9e-3593-9971-8c5f21ffbd64",
                                        "entry_id": "b0aae26e-1bd0-3c0e-9baa-d581e3c3970c",
                                        "glosses": [
                                            "die orthodoxe(n) Kirche(n) betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "548e810f-5692-4cb5-b832-bd04451528da",
                                                "sense_id": "44be6360-2c9e-3593-9971-8c5f21ffbd64",
                                                "text": "Bei den orthodoxen Kirchen handelt es sich um eine Gruppe von Kirchen, die in Kirchenverständnis, Lehre und Kult weitgehend übereinstimmen."
                                            },
                                            {
                                                "example_id": "1bdfa3f1-a51b-46b1-b1d5-3b286987bfb5",
                                                "sense_id": "44be6360-2c9e-3593-9971-8c5f21ffbd64",
                                                "text": "„Bereits unter den Zaren hatte die orthodoxe Kirche es nicht leicht, den heidnischen, kirchenfeindlichen Aberglauben zu bekämpfen.“"
                                            },
                                            {
                                                "example_id": "708a430a-ff99-419c-a06f-ba3976790a7f",
                                                "sense_id": "44be6360-2c9e-3593-9971-8c5f21ffbd64",
                                                "text": "„Bald verlieren sich die Spuren der wikingischen Kultur oder gehen in einer neuen auf: Skandinavische und slawische Elemente vermischen sich unter starkem Einfluss des Byzantinischen Reiches, von dem die Rus gegen Ende des 10. Jahrhunderts das orthodoxe Christentum übernehmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6741adec-a004-3faf-a819-4cd1e037f759",
                                        "entry_id": "b0aae26e-1bd0-3c0e-9baa-d581e3c3970c",
                                        "glosses": [
                                            "streng der Lehre folgend, rechtgläubig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00227994-2a54-4a7b-b6f7-0dfb42511f53",
                                                "sense_id": "6741adec-a004-3faf-a819-4cd1e037f759",
                                                "text": "„Denn ohne orthodoxes Dogma und orthodoxen Glauben ist es nicht möglich, dass wir ein orthodoxes Leben in wahrer Gottesverehrung führen.“"
                                            },
                                            {
                                                "example_id": "36ece819-206e-451e-8ef7-43d065dea2be",
                                                "sense_id": "6741adec-a004-3faf-a819-4cd1e037f759",
                                                "text": "„Orthodoxe Muslime sahen diese Toleranz nicht gern, sie regten sich aber noch weit mehr darüber auf, dass Akbar sich anmaßte, in Glaubensdingen verbindliche Urteile zu fällen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "6bbbca93-e634-3cc2-989f-6d40795e6aac",
                                        "entry_id": "b0aae26e-1bd0-3c0e-9baa-d581e3c3970c",
                                        "glosses": [
                                            "strikt gemäß Lehrmeinungen, Dogmen"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6997eccd-5829-4c1d-8feb-e1580db7c7b8",
                                                "sense_id": "6bbbca93-e634-3cc2-989f-6d40795e6aac",
                                                "text": "„Und nicht als orthodoxer Marxist, noch weniger als praktischer Agitator, dringt er dialektisch ins Dasein der Angestellten, sondern weil dialektisch eindringen heißt: entlarven.“"
                                            },
                                            {
                                                "example_id": "18803edd-b3e1-4713-ad9e-255530790106",
                                                "sense_id": "6bbbca93-e634-3cc2-989f-6d40795e6aac",
                                                "text": "„Solche Ausbrüche aus dem hermetischen Zirkel orthodoxen Lebens aber gibt es nicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b175252-b40a-44a9-a323-22e0790aa9b8",
                        "source_entry_id": "78a8aa48-8184-39c4-98da-f1e4396898e9",
                        "source_sense_id": "20fc3178-930d-3c79-b8a7-e1c7339be350",
                        "source_sense_description": "star vasthoudend aan een bepaald geloof",
                        "target_lang_word": "strenggläubig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "strenggläubig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dffa99ef-41f9-3206-ae63-01f1607fe9ca",
                                        "entry_id": "cdb642ef-f353-3294-be99-8abe714e4210",
                                        "glosses": [
                                            "sehr fromm, sich streng an die Grundsätze und Vorschriften des Glaubens haltend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c699248-4fbb-4bc4-a169-a4c614b5ff00",
                                                "sense_id": "dffa99ef-41f9-3206-ae63-01f1607fe9ca",
                                                "text": "„Mit dem Wandel des Christentums von der strenggläubigen Minderheit zur Massenkirche wurden Strafen reduziert, zum Beispiel entstand das Sakrament der Beichte, und daher ist die Exkommunikation und somit die Rekonziliation selten geworden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
