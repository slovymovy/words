                        "sense_id": "4b1e561d-2502-3a8f-9a0f-f37d52951ae0",
                        "entry_id": "c42a046d-01ba-34ee-8cfa-95647d64e1b1",
                        "glosses": [
                            "To overpraise; to praise highly."
                        ],
                        "tags": [
                            "obsolete",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "22808b0b-3aa5-4316-a6e4-c52ca08ddc37",
                                "sense_id": "4b1e561d-2502-3a8f-9a0f-f37d52951ae0",
                                "text": "If you were men, as men you are in show,\nYou would not use a gentle lady so;\nTo vow, and swear, and superpraise my parts,\nWhen, I am sure, you hate me with your hearts."
                            },
                            {
                                "example_id": "1288dc93-861f-4676-a0c4-b225d4907cce",
                                "sense_id": "4b1e561d-2502-3a8f-9a0f-f37d52951ae0",
                                "text": "1599, Uncredited translator, A Spiritual Doctrine Conteining a Rule to Live Wel, with Divers Praiers and Meditations, by Louis of Granada, Louan, published in English Recusant Literature, Volume 204, 1974, p. 178,\nBlessed art thou in the holie temple of thie glorie, and superpraised and superglorious for euer."
                            }
                        ]
                    }
