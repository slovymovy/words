                },
                {
                    "sense_id": "68ac9233-0db3-3e7e-8744-c1d62c3e2847",
                    "sense_definition": "Motif, sujet ou cause de ressentiment et d'amertume, généralement employé au pluriel.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sentiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a enfin décidé d'oublier ses <w>rancœurs</w> passées pour renouer le dialogue avec ses proches."
                        },
                        {
                            "text": "Lors de cette réunion houleuse, chacun a exprimé ses <w>rancœurs</w> accumulées depuis des années."
