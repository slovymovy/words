                "senses": [
                    {
                        "sense_id": "fc0091ff-c274-35f2-821c-6ac92ee3e506",
                        "entry_id": "048c7518-9d0f-3803-8c09-c767d778af67",
                        "glosses": [
                            "Dangerously fast; hell-for-leather."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b32cfbb-9042-4b1d-9050-4e9c10720018",
                                "sense_id": "fc0091ff-c274-35f2-821c-6ac92ee3e506",
                                "text": "breakneck pace"
                            },
                            {
                                "example_id": "1db89ce4-e2e5-4b8b-9b52-ea7f0d5413e1",
                                "sense_id": "fc0091ff-c274-35f2-821c-6ac92ee3e506",
                                "text": "He came running around the corner at a breakneck pace and couldn't stop in time to avoid hitting the fruit stand."
                            },
                            {
                                "example_id": "1c5ab9da-1473-4026-8fff-4254971f547d",
                                "sense_id": "fc0091ff-c274-35f2-821c-6ac92ee3e506",
                                "text": "The line to Dunières conists of a series of breakneck descents almost invariably ended by a violent curve and followed immediately by a panting climb, on which the engine barked thunderously but failed unhappily to maintain its booked speed of 13 m.p.h."
                            },
                            {
                                "example_id": "6fd39a9b-9ff6-4b38-8863-292810655a73",
                                "sense_id": "fc0091ff-c274-35f2-821c-6ac92ee3e506",
                                "text": "The use of machine learning in this field is hardly new, but the breakneck pace at which it is improving is worrying, Lund says: “With the advent of ChatGPT, the future is bleak.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "92b9c5c7-5b45-48d1-9a16-3264c2f4500c",
                        "source_entry_id": "048c7518-9d0f-3803-8c09-c767d778af67",
                        "source_sense_id": "fc0091ff-c274-35f2-821c-6ac92ee3e506",
                        "source_sense_description": "dangerously fast; hell-for-leather",
                        "target_lang_word": "halsbrekend",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "halsbrekend",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "30268439-2171-329f-80cb-d90053408631",
                                        "entry_id": "b5e1f349-95cd-3466-87d8-df3608c34dac",
                                        "glosses": [
                                            "iets wat zo gevaarlijk is om te doen dat je eraan zou kunnen doodgaan, dus heel erg gevaarlijk"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41e44ee1-daf7-4e81-abb4-9926e7c50581",
                                                "sense_id": "30268439-2171-329f-80cb-d90053408631",
                                                "text": "Geen van hen haalde het zelfs maar tot halverwege het eerste huis waar licht brandde. Ze verspeelden Jens van der Heijden bijna en het kostte Grim een halsbrekende toer waarbij hij zijn eigen leven op het spel zette om hem terug te halen. Eerder had hij hen bijna alle drie verspeeld, maar Claire had de tegenwoordigheid van geest om net voor de dorpsgrens te roepen dat hij de wagen stop moest zetten om te voet verder te gaan... gewoon voor het geval dat."
                                            },
                                            {
                                                "example_id": "1b2cc9f5-349d-404e-867b-43e2a4ce035b",
                                                "sense_id": "30268439-2171-329f-80cb-d90053408631",
                                                "text": "Dat is allemaal wel een beetje veel en ook door het halsbrekende tempo en de extreem hoge grappendichtheid wordt de film soms wat vermoeiend. Maar zelfs dan behoudt het geheel een grootse charme, óók doordat er geen woord wordt gesproken en de poppenpersonages zich volledig uitdrukken met hun mimiek, gegrom en gemompel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a8eef989-290d-4c0b-95aa-449a8ba63fad",
                        "source_entry_id": "048c7518-9d0f-3803-8c09-c767d778af67",
