                "senses": [
                    {
                        "sense_id": "91fac476-2de8-3dc6-afa5-0bcde01a48b3",
                        "entry_id": "4c4da7c8-13e4-34da-8ab6-e2703b2b367d",
                        "glosses": [
                            "Frau, die die traditionell dem Samichlaus zugeschriebene Rolle einnimmt oder so verkleidet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d440d455-6f26-409b-8a05-7df8384c034e",
                                "sense_id": "91fac476-2de8-3dc6-afa5-0bcde01a48b3",
                                "text": "„Hier sagt der Chlaus, was er von Samichläusinnen hält.“"
                            },
                            {
                                "example_id": "90773de4-ce5e-4bab-bc60-34071a13a185",
                                "sense_id": "91fac476-2de8-3dc6-afa5-0bcde01a48b3",
                                "text": "„Als Überraschung trat die Präsidentin als Samichläusin auf.“"
                            },
                            {
                                "example_id": "2289337c-296c-48ca-bbfb-772e8641d205",
                                "sense_id": "91fac476-2de8-3dc6-afa5-0bcde01a48b3",
                                "text": "„Sollte man als Samichlaus oder Samichläusin trotz Kälte lieber Velo oder Töffli nehmen?“"
                            },
                            {
                                "example_id": "e6071629-2e18-4a6f-a30f-8e7679b718be",
                                "sense_id": "91fac476-2de8-3dc6-afa5-0bcde01a48b3",
                                "text": "„Ist es in Zeiten von Wokeness und Gendern überhaupt noch erlaubt, den Samichlaus und nicht die Samichläusin zu feiern?“"
                            },
                            {
                                "example_id": "bae5565e-66cf-4d12-a1cc-e72b28c4302d",
                                "sense_id": "91fac476-2de8-3dc6-afa5-0bcde01a48b3",
                                "text": "„Auf Wunsch spricht auch Samichläusin Manuela Walser von der Chlaus-Gruppe Böttstein/Kleindöttingen Hochdeutsch, die vor allem Familien besucht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
