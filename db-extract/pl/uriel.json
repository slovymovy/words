                        "examples": [
                            {
                                "example_id": "8d7ab9b9-6b8f-4173-938b-0cac1c3c6c9f",
                                "sense_id": "653a60f6-a290-396c-93ca-a1fb4cded7a2",
                                "text": "Daleki krewny mojego znajomego ma na imię Uriel."
                            },
                            {
                                "example_id": "2e8e9a84-3ceb-4006-9047-0ce1a4f45cad",
                                "sense_id": "653a60f6-a290-396c-93ca-a1fb4cded7a2",
                                "text": "Uriel Górka, kanclerz wielki koronny i biskup poznański, uchodził za mecenasa kultury humanistycznej."
                            },
                            {
                                "example_id": "2f6e5791-f46d-4349-a4de-a0b1027d9813",
                                "sense_id": "653a60f6-a290-396c-93ca-a1fb4cded7a2",
                                "text": "Urielowie dzień swego patrona, czyli imieniny, obchodzą 22 stycznia."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
