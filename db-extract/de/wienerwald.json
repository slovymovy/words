                "senses": [
                    {
                        "sense_id": "f0928fbe-9df1-319e-b7ee-1fd9fee06f47",
                        "entry_id": "83d1bc63-3d03-3a14-a80c-b77269ad0de2",
                        "glosses": [
                            "nordöstlicher Ausläufer der Alpen in Niederösterreich und Wien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1b3f1fd-44c5-468b-a9e4-31c7b477026a",
                                "sense_id": "f0928fbe-9df1-319e-b7ee-1fd9fee06f47",
                                "text": "Der Wienerwald reicht bis in das Stadtgebiet von Wien."
                            },
                            {
                                "example_id": "480c12b6-7395-46ff-a246-e2a6736a7a3d",
                                "sense_id": "f0928fbe-9df1-319e-b7ee-1fd9fee06f47",
                                "text": "„Der generalüberholte Behälter sichert die Wasserversorgung in Döbling mitsamt dem Krapfenwaldlbad, versorgt aber auch im Wienerwald einzelne Wohnhäuser und Gasthäuser.“"
                            },
                            {
                                "example_id": "5addba7b-c3b7-4f2e-ac66-784b642b47ad",
                                "sense_id": "f0928fbe-9df1-319e-b7ee-1fd9fee06f47",
                                "text": "„1314 war es nämlich, als der Habsburgische Herzog hungernd durch den Wienerwald irrte und danach die Kartause Mauerbach errichten ließ – ein Kloster für einen Prior und zwölf Mönche, die hier in der Abgeschiedenheit ihr Schweigegelübde lebten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
