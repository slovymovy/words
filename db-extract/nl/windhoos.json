                    },
                    {
                        "form_id": "aec2b033-fd71-4bba-944b-7a1e691ddd1c",
                        "entry_id": "6e484739-b23c-366e-99b9-0831bcc7e717",
                        "tags": [
                            "diminutive",
                            "plural"
                        ],
                        "form": "windhoosjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9bf1f734-58da-37fe-a4c5-f590e230e143",
                        "entry_id": "6e484739-b23c-366e-99b9-0831bcc7e717",
                        "glosses": [
                            "heftige wervelwind die maar kort duurt, maar veel schade kan aanrichten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58f0fbbe-b112-4d7a-80b6-da3dcc32f968",
                                "sense_id": "9bf1f734-58da-37fe-a4c5-f590e230e143",
                                "text": "Een windhoos heeft in Zwitserland een treinwagon uit de rails geblazen. Het ongeluk gebeurde ten noorden van het dorp Lenk in Berner Oberland. De wagon is op zijn kant naast het spoor terechtgekomen en er zijn acht gewonden gevallen. Maar de burgemeester van Lenk, René Müller, zei dat het naar omstandigheden goed is afgelopen."
                            },
                            {
                                "example_id": "406e34ba-b1e4-4a20-9f27-c3939238f696",
                                "sense_id": "9bf1f734-58da-37fe-a4c5-f590e230e143",
                                "text": "De Limburger beleefde halverwege de sessie een opvallend moment, toen hij even zomaar van de baan schoot. Waarschijnlijk lag dat aan een windhoos, al maakte Verstappen over de teamradio ook melding van problemen met de banden."
                            },
                            {
                                "example_id": "e87b8de6-a0ca-461e-961b-13957e98e12f",
                                "sense_id": "9bf1f734-58da-37fe-a4c5-f590e230e143",
                                "text": "Door een windhoos boven het Zeeuwse Zierikzee zijn maandag één dode en zeven gewonden gevallen, meldt de veiligheidsregio Zeeland. Eerder was sprake van ongeveer tien gewonden. De windhoos zorgde voor veel schade. Tien tot twintig huurhuizen raakten tijdelijk onbewoonbaar."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0d0c2d88-5801-4ab6-abaf-cbb9b075c922",
                        "source_entry_id": "6e484739-b23c-366e-99b9-0831bcc7e717",
                        "source_sense_id": "9bf1f734-58da-37fe-a4c5-f590e230e143",
                        "target_lang_word": "whirlwind",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "whirlwind",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0c1cf21d-e3ed-3833-90fa-ec154fcd2466",
                                        "entry_id": "564053ca-fcc8-33ce-b0c4-0b84e517b6f8",
                                        "glosses": [
                                            "A windstorm of limited extent, such as a tornado, dust devil, or waterspout, characterized by an inward spiral motion of the air with an upward current in the center; a vortex of air."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a364923-ac71-45a1-b838-f6b93393348b",
                                                "sense_id": "0c1cf21d-e3ed-3833-90fa-ec154fcd2466",
                                                "text": "VVhile in the mean time there iſſued out on the Eaſt-ſide a ſtrong VVind, but pure and refreſhing, vvhich dividing into ſeveral parts that turned round became ſo many innocuous VVhirl-vvinds of ſincere Air, tinctured only vvith a cool refreſhing ſmell, as if it had paſſed over ſome large field of Lilies and Roſes."
                                            },
                                            {
                                                "example_id": "6efd9c1c-da23-4a71-bf1e-67a6c49b38f5",
                                                "sense_id": "0c1cf21d-e3ed-3833-90fa-ec154fcd2466",
                                                "text": "And his hoofs ground the rocks to fire and dust, / His strong sides made the torrents rise in spray, / And turbulence, as if a whirlwind’s gust / Surrounded us; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e749bbca-00e8-3a1e-9234-054eb71cebdd",
                                        "entry_id": "564053ca-fcc8-33ce-b0c4-0b84e517b6f8",
                                        "glosses": [
                                            "A person or body of objects or events sweeping violently onward."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a13eebb-21f2-4a59-8083-3999b90ad529",
                                                "sense_id": "e749bbca-00e8-3a1e-9234-054eb71cebdd",
                                                "text": "Once he got that new scooter he turned into a whirlwind and damaged all the flowers."
                                            },
                                            {
                                                "example_id": "6b1fe629-2c2a-4726-840d-3ecb6ab470c7",
                                                "sense_id": "e749bbca-00e8-3a1e-9234-054eb71cebdd",
                                                "text": "The weeks leading up to the convention were a whirlwind of preparation and hurried activity."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "whirlwind",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "11db4172-ae9a-37d7-bbe1-2f8fa8629c75",
                                        "entry_id": "56958650-cb05-345d-96a7-97b93b0eb11c",
                                        "glosses": [
                                            "Rapid and minimal."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f40f1bd3-b58f-4e9b-bb99-3a64f05fb728",
                                                "sense_id": "11db4172-ae9a-37d7-bbe1-2f8fa8629c75",
                                                "text": "a whirlwind tour, a whirlwind romance"
                                            },
                                            {
                                                "example_id": "a70e0b6d-082d-4cfd-ae7b-bac85ffb9d63",
                                                "sense_id": "11db4172-ae9a-37d7-bbe1-2f8fa8629c75",
                                                "text": "So you aren't deserting the Caversham ship. They'll understand. After all, their courtship was pretty whirlwind itself."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
