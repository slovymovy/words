                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt a sharp <w>shooting</w> in her lower back when she tried to lift the box.",
