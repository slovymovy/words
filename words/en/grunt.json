{
    "word_family": [
        "grunter",
        "gruntingly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cfa56807-3130-3c85-af2a-8e0101397aff",
                    "sense_definition": "To make a short, low, guttural sound, often to express effort, pain, or lack of interest.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vocal_sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The weightlifter began to <w>grunt</w> loudly as he tried to lift the heavy barbell above his head.",
                            "target_lang_translations": {
                                "ru": "Тяжелоатлет начал громко <w>кряхтеть</w>, пытаясь поднять тяжелую штангу над головой."
                            }
                        },
                        {
                            "text": "He would only <w>grunt</w> in response whenever I asked him how his long day at work was.",
                            "target_lang_translations": {
                                "ru": "Он только <w>хмыкал</w> в ответ каждый раз, когда я спрашивал его, как прошел длинный рабочий день."
                            }
                        }
                    ],
                    "common_phrases": [
                        "grunt in response",
                        "grunt with effort"
                    ],
                    "target_lang_definitions": {
                        "ru": "Издавать короткий, низкий, гортанный звук, часто выражая усилие, боль или отсутствие интереса."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кряхтеть",
                                "target_lang_sense_clarification": "от физического усилия или боли"
                            },
                            {
                                "target_lang_word": "хмыкать",
                                "target_lang_sense_clarification": "в ответ, выражая безразличие"
                            },
                            {
                                "target_lang_word": "ворчать",
                                "target_lang_sense_clarification": "невнятно бормотать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cd2af984-de59-3dc7-8cde-5938f84356df",
                    "sense_definition": "To release intestinal gas through the anus.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "bodily_function",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boy asked his friends who just <w>grunted</w> after they smelled something unpleasant in the small room.",
                            "target_lang_translations": {
                                "ru": "Мальчик спросил друзей, кто только что <w>перданул</w>, почувствовав неприятный запах в маленькой комнате."
                            }
                        },
                        {
                            "text": "It is considered very rude to <w>grunt</w> during a formal dinner with your colleagues.",
                            "target_lang_translations": {
                                "ru": "Считается очень грубым <w>портить воздух</w> во время официального ужина с коллегами."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal or vulgar usage for flatulence"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выпускать кишечные газы через задний проход (вульгарно)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пердеть",
                                "target_lang_sense_clarification": "грубое, вульгарное"
                            },
                            {
                                "target_lang_word": "бздеть",
                                "target_lang_sense_clarification": "просторечное, вульгарное"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "df77bb73-d1c7-3a84-8ebc-83aafe81896e",
                    "sense_definition": "A short, deep sound made in the throat, often showing disapproval or reluctance to speak.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vocal_sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old man gave a short <w>grunt</w> of disapproval when he saw the messy state of the kitchen.",
                            "target_lang_translations": {
                                "ru": "Старик издал короткое неодобрительное <w>хмыканье</w>, увидев беспорядок на кухне."
                            }
                        },
                        {
                            "text": "I tried to start a conversation, but all I got was a noncommittal <w>grunt</w> from my teenage son.",
                            "target_lang_translations": {
                                "ru": "Я пытался завязать разговор, но в ответ от сына-подростка услышал лишь неопределенное <w>бурчание</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "grunt of disapproval",
                        "low grunt"
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткий, глубокий звук, издаваемый горлом, часто выражающий неодобрение или нежелание говорить."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хмыканье",
                                "target_lang_sense_clarification": "звук недовольства или сомнения"
                            },
                            {
                                "target_lang_word": "ворчание",
                                "target_lang_sense_clarification": "невнятный звук недовольства"
                            },
                            {
                                "target_lang_word": "бурчание",
                                "target_lang_sense_clarification": "недовольное бормотание"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5969f0b6-d99c-32f5-8d97-c88e89d103f6",
                    "sense_definition": "The characteristic snorting sound made by a pig.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "animal_sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We could hear the loud <w>grunt</w> of a pig coming from the barn as we walked past.",
                            "target_lang_translations": {
                                "ru": "Проходя мимо сарая, мы услышали громкое свиное <w>хрюканье</w>."
                            }
                        },
                        {
                            "text": "The hungry animal let out a satisfied <w>grunt</w> when the farmer finally poured the feed into the trough.",
                            "target_lang_translations": {
                                "ru": "Голодное животное издало довольное <w>хрюканье</w>, когда фермер наконец насыпал корм в корыто."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pig grunt"
                    ],
                    "target_lang_definitions": {
                        "ru": "Характерный звук, издаваемый свиньей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хрюканье",
                                "target_lang_sense_clarification": "звук свиньи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d01ef6f-3492-3a42-b898-823876acbd33",
                    "sense_definition": "A low-ranking soldier, especially an infantryman.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "person_type",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The veteran told stories about his difficult time serving as a <w>grunt</w> during the war in Vietnam.",
                            "target_lang_translations": {
                                "ru": "Ветеран рассказывал истории о тяжелых временах службы простым <w>пехотинцем</w> во время войны во Вьетнаме."
                            }
                        },
                        {
                            "text": "He cannot make that kind of strategic decision because he is just a <w>grunt</w> in the infantry.",
                            "target_lang_translations": {
                                "ru": "Он не может принимать такие стратегические решения, потому что он всего лишь рядовой <w>солдат</w> в пехоте."
                            }
                        }
                    ],
                    "common_phrases": [
                        "infantry grunt"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "military slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Солдат низкого звания, особенно пехотинец."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пехотинец",
                                "target_lang_sense_clarification": "рядовой боец"
                            },
                            {
                                "target_lang_word": "солдафон",
                                "target_lang_sense_clarification": "грубый солдат"
                            },
                            {
                                "target_lang_word": "рабочая лошадка",
                                "target_lang_sense_clarification": "переносное значение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "49087457-306d-36e9-a0c3-17e15bc36406",
                    "sense_definition": "A person who performs routine, menial, or boring tasks.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "person_type",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company hired a few <w>grunts</w> to handle the data entry while the managers focused on strategy.",
                            "target_lang_translations": {
                                "ru": "Компания наняла несколько <w>чернорабочих</w> для ввода данных, пока менеджеры сосредоточились на стратегии."
                            }
                        },
                        {
                            "text": "I am tired of being the office <w>grunt</w> and doing all the paperwork that nobody else wants.",
                            "target_lang_translations": {
                                "ru": "Мне надоело быть офисной <w>шестеркой</w> и делать всю бумажную работу, которую никто другой не хочет."
                            }
                        }
                    ],
                    "synonyms": [
                        "gofer",
                        "lackey",
                        "peon"
                    ],
                    "common_phrases": [
                        "office grunt",
                        "grunt work"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage for a worker"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, выполняющий рутинную, черную или скучную работу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чернорабочий",
                                "target_lang_sense_clarification": "выполняющий тяжелую работу"
                            },
                            {
                                "target_lang_word": "пешка",
                                "target_lang_sense_clarification": "мелкий исполнитель"
                            },
                            {
                                "target_lang_word": "шестерка",
                                "target_lang_sense_clarification": "пренебрежительно о подчиненном"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5708502c-ceea-3f17-8585-b40ae77460c8",
                    "sense_definition": "The mechanical power or torque of a vehicle's engine.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "power",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new truck has plenty of <w>grunt</w> for towing heavy trailers up steep mountain roads.",
                            "target_lang_translations": {
                                "ru": "У нового грузовика достаточно <w>мощи</w> для буксировки тяжелых прицепов по крутым горным дорогам."
                            }
                        },
                        {
                            "text": "The lack of bottom-end <w>grunt</w> makes this car feel a bit sluggish when accelerating from a stop.",
                            "target_lang_translations": {
                                "ru": "Отсутствие <w>тяги</w> на низких оборотах делает этот автомобиль немного вялым при разгоне с места."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bottom-end grunt",
                        "engine grunt"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in automotive contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Механическая мощность или крутящий момент двигателя автомобиля."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мощь",
                                "target_lang_sense_clarification": "сила двигателя"
                            },
                            {
                                "target_lang_word": "тяга",
                                "target_lang_sense_clarification": "крутящий момент"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a1e39632-0467-3b7c-8137-f6af42520620",
                    "sense_definition": "A traditional American dessert consisting of steamed fruit and dumplings.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "For dessert, we enjoyed a warm blueberry <w>grunt</w> topped with a dollop of fresh whipped cream.",
                            "target_lang_translations": {
                                "ru": "На десерт мы наслаждались теплым черничным <w>грантом</w> с порцией свежих взбитых сливок."
                            }
                        },
                        {
                            "text": "The recipe for this apple <w>grunt</w> has been passed down through our family for several generations.",
                            "target_lang_translations": {
                                "ru": "Рецепт этого яблочного <w>гранта</w> передавался в нашей семье из поколения в поколение."
                            }
                        }
                    ],
                    "synonyms": [
                        "fungy",
                        "fungee"
                    ],
                    "common_phrases": [
                        "blueberry grunt"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily North American"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Традиционный американский десерт из тушеных фруктов и клецок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грант",
                                "target_lang_sense_clarification": "название десерта"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e8e52f3-c255-3d6d-9e1c-55f95c03d5ad",
                    "sense_definition": "Any of various saltwater fish that make a grunting sound when caught.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "While fishing near the coral reef, we caught a small <w>grunt</w> that made a strange noise.",
                            "target_lang_translations": {
                                "ru": "Рыбача у кораллового рифа, мы поймали небольшую <w>рыбу-ворчуна</w>, которая издавала странный звук."
                            }
                        },
                        {
                            "text": "The <w>grunt</w> is a common species found in the warm tropical waters of the Atlantic Ocean.",
                            "target_lang_translations": {
                                "ru": "<w>Ронка</w> — распространенный вид, обитающий в теплых тропических водах Атлантического океана."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Любая из различных морских рыб, издающих хрюкающий звук при поимке."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рыба-ворчун",
                                "target_lang_sense_clarification": "семейство ронковые"
                            },
                            {
                                "target_lang_word": "ронка",
                                "target_lang_sense_clarification": "биологическое название"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}