                        ],
                        "form": "die Jagdhörner"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "50997fba-7a10-3bc8-ba50-238f9457b976",
                        "entry_id": "6c9546ae-adea-3175-ab44-295fec45aa0e",
                        "glosses": [
                            "Signalhorn aus Horn, Holz oder Metall, das während der Jagd eingesetzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3994e19e-78e3-4c19-90b2-4c586255dab4",
                                "sense_id": "50997fba-7a10-3bc8-ba50-238f9457b976",
                                "text": "Der Jäger trug eine Jagdtasche und ein Jagdhorn um seine Schulter."
                            },
                            {
                                "example_id": "49e0d5e1-2880-453c-8ce9-97635470eb6c",
                                "sense_id": "50997fba-7a10-3bc8-ba50-238f9457b976",
                                "text": "Im Wald erschallen die Jagdhörner."
                            },
                            {
                                "example_id": "0dfe64f6-3e59-4438-a870-7cca49f8ee2b",
                                "sense_id": "50997fba-7a10-3bc8-ba50-238f9457b976",
                                "text": "„Nun erschallen Jagdhörner.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "186033b5-dfc7-3e35-806d-9ce0514ec37c",
                        "entry_id": "6c9546ae-adea-3175-ab44-295fec45aa0e",
                        "glosses": [
                            "Blasinstrument, das dem Waldhorn ähnelt"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "d5ffc0b2-ca75-4dc2-8178-c6bb1310cc73",
                                "sense_id": "186033b5-dfc7-3e35-806d-9ce0514ec37c",
                                "text": "„Und wo Hoffmann in einem Brief an Hippel die Flöten, Klarinetten und Jagdhörner erwähnt, die in der Silvesternacht vom Turm herabschallen, ist es wiederum ihr Echo, das ihn über die Jahre hinweg erreicht, die ihn von der Kindheit trennen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "81cccb7f-11d4-4730-a550-4b949b24d0bc",
                        "source_entry_id": "6c9546ae-adea-3175-ab44-295fec45aa0e",
                        "source_sense_id": "50997fba-7a10-3bc8-ba50-238f9457b976",
                        "source_sense_description": "Signalhorn aus Horn, Holz oder Metall, das während der Jagd eingesetzt wird",
                        "target_lang_word": "hunting horn",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hunting horn",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "01bc1324-2833-316e-a5e4-ec879d2cea8d",
                                        "entry_id": "77a7a54b-4d76-3425-92b4-4295ff624feb",
                                        "glosses": [
                                            "A bugle, being either simply curved (especially in heraldry), or having from one (in e.g. some Roman horns) to three (in many modern musical horns) spirals, on which signals are blown during a hunt."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "791a6828-009d-42e7-9724-9f2b35fa7f98",
                        "source_entry_id": "6c9546ae-adea-3175-ab44-295fec45aa0e",
                        "source_sense_id": "50997fba-7a10-3bc8-ba50-238f9457b976",
                        "source_sense_description": "Signalhorn aus Horn, Holz oder Metall, das während der Jagd eingesetzt wird",
                        "target_lang_word": "trompe de chasse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trompe de chasse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "abe04bb3-3141-3842-9216-c0cf66af0e46",
                                        "entry_id": "0375a0ab-befa-333e-b70b-dcc23c740720",
                                        "glosses": [
                                            "Instrument à vent de forme évasée utilisé notamment pour les chasses à courre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "607a3d37-578e-44f7-b74b-43670d85bfeb",
                                                "sense_id": "abe04bb3-3141-3842-9216-c0cf66af0e46",
                                                "text": "Un autre jour, comme il traversait un bois, il entendit un cri devant lui. Il donna trois ou quatre coups de sa trompe de chasse, et le bruit cessa."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35b59975-10df-383a-aeef-f5ffaf9d578b",
                                        "entry_id": "0375a0ab-befa-333e-b70b-dcc23c740720",
                                        "glosses": [
                                            "Meuble représentant l’instrument de musique du même nom dans les armoiries. Quand l’embouchure est d’un autre émail, il est dit enguiché ou embouché. Lorsqu’il est muni d'un sangle éventuellement d'un autre émail, il est dit lié. Sa représentation est souvent similaire à celle du cor de chasse, ce qui peut être source de confusion entre les deux instruments. À rapprocher de cor, cor de chasse, cornet, grêlier, huchet, olifant et trompe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6985f59c-57a8-48ee-9647-260ce42f7c16",
                                                "sense_id": "35b59975-10df-383a-aeef-f5ffaf9d578b",
                                                "text": "Écartelé en sautoir : au 1, d’azur à une trompe de chasse d’or ; au 2, de gueules à une benoîte commune d’or aux cinq pointes d’argent ; au 3, de gueules à une croix de saint Maurice d’or ; au 4, d’azur à une fontaine héraldique d’or remplie d’azur et traversée par une source d’argent, qui est de la commune de Blason ville fr Beaumont-en-Verdunois (Meuse).svg → voir illustration « armoiries avec une trompe de chasse »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ab8ea16c-0f16-4661-ac74-be5cf251ba68",
                        "source_entry_id": "6c9546ae-adea-3175-ab44-295fec45aa0e",
                        "source_sense_id": "50997fba-7a10-3bc8-ba50-238f9457b976",
                        "source_sense_description": "Signalhorn aus Horn, Holz oder Metall, das während der Jagd eingesetzt wird",
                        "target_lang_word": "trompe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trompe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e1dec7a4-9416-3304-b16e-2726ce703505",
                                        "entry_id": "c38db6a2-de42-3d92-b1da-cd83b1934310",
                                        "glosses": [
                                            "Trompette."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79d744c2-d671-4b24-ac18-450493a87063",
                                                "sense_id": "e1dec7a4-9416-3304-b16e-2726ce703505",
                                                "text": "On entendit au loin, très loin, tout au fond du val, le son rauque de la trompe, qu’on emploie d’habitude, à bord des chalands, pour prévenir l’éclusier de la station prochaine."
                                            },
                                            {
                                                "example_id": "a6b4e965-542d-4f46-9838-08f947c09904",
                                                "sense_id": "e1dec7a4-9416-3304-b16e-2726ce703505",
                                                "text": "Dix ou vingt mille cornes, klaxons et trompes proclament éperdument la mobilisation du plaisir."
                                            },
                                            {
                                                "example_id": "f361a0a4-b14d-4634-944e-804a8dcf469a",
                                                "sense_id": "e1dec7a4-9416-3304-b16e-2726ce703505",
                                                "text": "Les trompes allègres et volontaires…"
                                            },
                                            {
                                                "example_id": "c299f7a4-37ea-4f7b-8ab9-0909c4f513f1",
                                                "sense_id": "e1dec7a4-9416-3304-b16e-2726ce703505",
                                                "text": "Le bon Piqueur doit sçauoir bien parler en cris, & langages plaisans aux chiens, crier, hucher, & houpper ses compagnons, forhuer en mots longs, & sonner de la trompe."
                                            },
                                            {
                                                "example_id": "35833e79-702b-44ab-9303-1cdf725bb8fe",
                                                "sense_id": "e1dec7a4-9416-3304-b16e-2726ce703505",
                                                "text": "Publier à son de trompe : Publier quelque chose au son de la trompette, l’annoncer à grand fracas, le raconter à beaucoup de gens, afin que cela se divulgue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3a1c274-d57d-3c3a-90ce-d7a50d016cda",
                                        "entry_id": "c38db6a2-de42-3d92-b1da-cd83b1934310",
                                        "glosses": [
                                            "Trompe de chasse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5460ebd5-4287-4192-9a14-67f3c92b602e",
                                                "sense_id": "f3a1c274-d57d-3c3a-90ce-d7a50d016cda",
                                                "text": "« Monsieur Kiefer ! Est-ce bien le jour du cor de chasse ?\n— Non, monsieur. De toute façon, si je puis me permettre, il ne s’agit pas d’un cor mais d’une trompe. L’un se porte sous le bras et envoie le son par-devant ; l’autre, enroulée à trois tours et demi, se porte sur l’épaule ou en écharpe, et envoie le son par-derrière. Le cor a disparu au profit de la trompe dite d’Orléans."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4fd55c56-d916-3bdb-bdbc-ad4807fcb380",
                                        "entry_id": "c38db6a2-de42-3d92-b1da-cd83b1934310",
                                        "glosses": [
                                            "Klaxon."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5ebdb2f-2622-41bc-ad45-9a22dcfafaa5",
                                                "sense_id": "4fd55c56-d916-3bdb-bdbc-ad4807fcb380",
                                                "text": "Comme ils achevaient le plat en question, qui était une somptueuse omelette au rhum, le bruit lointain d’une trompe d’automobile retentit."
                                            },
                                            {
                                                "example_id": "4bf11918-60b7-4dd2-9cf8-89ff3ddff5d9",
                                                "sense_id": "4fd55c56-d916-3bdb-bdbc-ad4807fcb380",
                                                "text": "Comme un écho, la trompe d’une auto, dehors, sonna en arpège."
                                            },
                                            {
                                                "example_id": "0698ac51-e27b-4451-b394-d266276d99fe",
                                                "sense_id": "4fd55c56-d916-3bdb-bdbc-ad4807fcb380",
                                                "text": "Il avait beau klaxonner abondamment, cela ne faisait apparaître aux portes que des ménagères avec des casseroles. La trompe de notre voiture avait le même son que celle du laitier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c26822b4-8ace-39f9-96fd-032996ea59e2",
                                        "entry_id": "c38db6a2-de42-3d92-b1da-cd83b1934310",
                                        "glosses": [
                                            "Prolongement nasal chez les proboscidiens (éléphant, tapir)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "863e37dc-5cd0-4cc7-956a-51ce17498de9",
                                                "sense_id": "c26822b4-8ace-39f9-96fd-032996ea59e2",
                                                "text": "La trompe de l’éléphant sert à pomper et rejeter l’eau mais a aussi une fonction préhensile."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20d259c9-0bcd-3975-99c9-9e7485fd8da8",
                                        "entry_id": "c38db6a2-de42-3d92-b1da-cd83b1934310",
                                        "glosses": [
                                            "Bouche de certains insectes, avec laquelle ils sucent et tirent leur nourriture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "711f95a2-8d7c-4980-88b4-e73a4859f0bf",
                                                "sense_id": "20d259c9-0bcd-3975-99c9-9e7485fd8da8",
                                                "text": "Les maxilles comprennent les palpes maxillaires placés latéralement, souvent nuls, et les galeae formant la trompe ou glossothèque, de dimensions très variables ; elle peut atteindre ou dépasser les premiers segments abdominaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "618fb415-aa99-3b5b-8c62-afd3c3421e61",
                                        "entry_id": "c38db6a2-de42-3d92-b1da-cd83b1934310",
                                        "glosses": [
                                            "Se dit de certains conduits recourbés et évasés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b5d10aa-35a8-44e4-9d65-bd0dc858bbfd",
                                                "sense_id": "618fb415-aa99-3b5b-8c62-afd3c3421e61",
                                                "text": "trompe d’Eustache: canal de communication entre la bouche et le tympan de l’oreille."
                                            },
