                                        "sense_id": "26e5b11f-a12d-3e84-823c-1795d804a83f",
                                        "entry_id": "decc0021-69cb-3310-8210-52d271583fc0",
                                        "glosses": [
                                            "A number of atoms in a series, which combine to form a molecule."
