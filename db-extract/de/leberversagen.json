                        "examples": [
                            {
                                "example_id": "38efac99-ba97-47ee-b3e1-4494e14a2865",
                                "sense_id": "44cc1427-ab85-389f-828c-69997ceae1e1",
                                "text": "„In ein oder zwei Jahren wärt ihr alle tot gewesen, gestorben an Leberversagen, Männern oder Geburt.“"
                            },
                            {
                                "example_id": "46986639-eec3-4818-b6bd-61ce9542246c",
                                "sense_id": "44cc1427-ab85-389f-828c-69997ceae1e1",
                                "text": "„Aufgrund seiner Verletzungen, der unzureichenden Ernährung und der mangelnden Sauberkeit rechnete der Mediziner mit einem zeitnahen Leberversagen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
