                        "examples": [
                            {
                                "example_id": "b4354508-c961-4e89-a055-e3f1fed6d3d2",
                                "sense_id": "d8c62425-57c8-3cc9-b1f2-a12bf8267af3",
                                "text": "Cicero in his Offices declares his opinion , that a vendor ought not to appoint a puffer to raise the price"
                            }
                        ]
                    },
                    {
                        "sense_id": "0bafd3e1-c1ae-37e3-b742-0ff73a51c50a",
                        "entry_id": "c9da5d15-e07b-3c79-9c67-ffaf9842ad94",
