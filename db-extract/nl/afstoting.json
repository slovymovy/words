                    {
                        "sense_id": "c0b11110-7b21-394a-a63c-678b87bad6f0",
                        "entry_id": "e53b583d-d856-33ca-aa08-4fed0d6fd4ca",
                        "glosses": [
                            "een kracht die twee voorwerpen zich van elkaar doet verwijderen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "284d0cdc-4449-4de7-9d7e-22836fed5d2b",
                                "sense_id": "c0b11110-7b21-394a-a63c-678b87bad6f0",
                                "text": "Wanneer twee magnetische noordpolen bij elkaar in de buurt komen heeft dat afstoting ten gevolge."
                            }
                        ]
                    },
                    {
                        "sense_id": "bf5f4f2d-5a2e-3909-bc60-3017a87db078",
                        "entry_id": "e53b583d-d856-33ca-aa08-4fed0d6fd4ca",
                        "glosses": [
                            "een proces van vernietiging waaraan een lichaamsvreemd voorwerp door het immuunsysteem onderworpen wordt"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "965075f1-f8af-307b-a4ee-8cec32696457",
                        "entry_id": "e53b583d-d856-33ca-aa08-4fed0d6fd4ca",
                        "glosses": [
                            "proces van laten sterven van iets dat ergens in leeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d25b121c-2afd-43b2-adc8-9d9c9d4b6170",
                                "sense_id": "965075f1-f8af-307b-a4ee-8cec32696457",
                                "text": "Hittestress leidt tot afstoting van algen die het koraal van voedingsstoffen voorzien en het koraal kleur geven. Als de verbleking te lang duurt, sterft het koraal af."
                            }
                        ]
                    }
                ],
