                                                "sense_id": "900a52b1-243b-3b6e-a6db-26a7eb2ec99c",
                                                "text": "Der Fensterputzer steht auf der letzten Sprosse der Leiter."
                                            },
                                            {
                                                "example_id": "754a4f1a-0000-4832-a3ab-659525295e8f",
                                                "sense_id": "900a52b1-243b-3b6e-a6db-26a7eb2ec99c",
                                                "text": "Viele Fenster sind mit Sprossen verziert."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fa9f8426-f54d-3c11-aef4-14697453a1c7",
                                        "entry_id": "ef0660df-9099-3694-ba4e-b1c761dccc74",
                                        "glosses": [
                                            "Spitze eines Rehgeweihs"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a45dfff2-a3d8-47d4-a509-e15d5788e95f",
                                                "sense_id": "fa9f8426-f54d-3c11-aef4-14697453a1c7",
                                                "text": "Je mehr Sprossen ein Geweih besitzt, um so wertvoller wird es."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "42f63a61-14c5-3ecb-927f-7ae46c203915",
                                        "entry_id": "ef0660df-9099-3694-ba4e-b1c761dccc74",
                                        "glosses": [
                                            "junger Trieb an einer Pflanze; junger, neu wachsender Teil einer Pflanze"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0267da7f-f06c-4a99-885d-086ba4611b45",
                                                "sense_id": "42f63a61-14c5-3ecb-927f-7ae46c203915",
                                                "text": "Der Gärtner hat einige Sprossen abgeschnitten."
                                            },
                                            {
                                                "example_id": "ee080006-601b-47b7-9b1a-c4bd0a68867d",
                                                "sense_id": "42f63a61-14c5-3ecb-927f-7ae46c203915",
                                                "text": "So schenkte meine Frau mir drei männliche Sprossen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "86c3052b-0e84-3af5-b56d-e4e4d09adb8a",
                                        "entry_id": "ef0660df-9099-3694-ba4e-b1c761dccc74",
                                        "glosses": [
                                            "dunkler Punkt auf der Haut, hauptsächlich im Gesicht, teils auch auf den Armen; Sommersprosse"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
