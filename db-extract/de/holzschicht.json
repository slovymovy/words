                ],
                "senses": [
                    {
                        "sense_id": "b25de8a4-7934-3b8e-833e-08dc53b63119",
                        "entry_id": "38bb9faa-d39e-34c7-9106-97dae8b6e21f",
                        "glosses": [
                            "Schicht aus Holz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fc64429-3ced-4818-b9fd-864acce0c8ad",
                                "sense_id": "b25de8a4-7934-3b8e-833e-08dc53b63119",
                                "text": "„Die alten, massiven Holzdecken wurden entsorgt, weil sie nicht mehr den heutigen Brandschutzvorschriften entsprechen. Übrig geblieben ist eine dünne Holzschicht für die Optik – dahinter verbergen sich moderne Aluminiumwaben.“"
                            },
                            {
                                "example_id": "4e64f686-3fbf-49ca-bd20-4da99396568e",
                                "sense_id": "b25de8a4-7934-3b8e-833e-08dc53b63119",
                                "text": "„Entscheidend für den Erfolg ist die richtige Kombination der Hölzer wie Pappel, Esche oder Buche und die richtige Ausrichtung der Furnierlage. Zwischen den Holzschichten einlaminierte Metall- oder Polymerfolien sollen die Struktur zudem unfallsicher machen.“"
                            },
                            {
                                "example_id": "71fc78b6-63b7-4044-8f25-2681283d21a6",
                                "sense_id": "b25de8a4-7934-3b8e-833e-08dc53b63119",
                                "text": "„Zu Beginn jedes Frühjahrs bilden Bäume in den gemäßigten Zonen eine neue Holzschicht, deren Dicke mit den herrschenden Umwelt- und Wachstumsbedingungen variiert.“"
                            },
                            {
                                "example_id": "2662ae73-c265-44ef-9939-12722781160a",
                                "sense_id": "b25de8a4-7934-3b8e-833e-08dc53b63119",
                                "text": "„Heute wird meistens »schichtverleimt«: dünne Holzschichten werden miteinander verklebt und gleichzeitig gekrümmt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
