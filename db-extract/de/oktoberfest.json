                    }
                ],
                "senses": [
                    {
                        "sense_id": "3ddc111d-c64c-3fab-8731-2594ed153ac7",
                        "entry_id": "d277c645-6674-3cc0-9a22-a5c70e1b886c",
                        "glosses": [
                            "Volksfest im September oder Oktober"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ce43920-d23f-49ac-9c37-e16beb639289",
                                "sense_id": "3ddc111d-c64c-3fab-8731-2594ed153ac7",
                                "text": "Ich war schon lange nicht mehr auf einem Oktoberfest."
                            },
                            {
                                "example_id": "340f67dd-3600-4798-a09e-9988751786da",
                                "sense_id": "3ddc111d-c64c-3fab-8731-2594ed153ac7",
                                "text": "„Wie ich der Tagespresse entnehme, lädt ein westdeutsches Reisebüro zum Oktoberfest nach Moskau ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "96b50a83-2cec-33e7-8f35-4d69a402736c",
                        "entry_id": "d277c645-6674-3cc0-9a22-a5c70e1b886c",
                        "glosses": [
                            "größtes Volksfest der Welt, das zwei Wochen dauert und seit 1810 jährlich von Ende September bis Anfang Oktober in München stattfindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c2721f1-063d-4373-a6ec-4511bac31bd3",
                                "sense_id": "96b50a83-2cec-33e7-8f35-4d69a402736c",
                                "text": "Am Wochenende besuchen sehr viele Menschen das Oktoberfest."
                            },
                            {
                                "example_id": "fdd62571-d88f-47e6-b047-400418cb938d",
                                "sense_id": "96b50a83-2cec-33e7-8f35-4d69a402736c",
                                "text": "„Dort ging auch gerade das Oktoberfest zu Ende.“"
                            },
                            {
                                "example_id": "e2bc1b45-a4f1-4f38-a5bf-287ee31d085f",
                                "sense_id": "96b50a83-2cec-33e7-8f35-4d69a402736c",
                                "text": "„Die Stadt des Oktoberfests wurde zu einem Zentrum für Musik, Kino und Mode.“"
                            },
                            {
                                "example_id": "08bb57e8-347f-4e18-b097-ebe44680ff08",
                                "sense_id": "96b50a83-2cec-33e7-8f35-4d69a402736c",
                                "text": "„Auf dem Oktoberfest war ich leider noch nicht.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ef0bf5a5-5cd2-4335-8258-75dadd1c76fb",
                        "source_entry_id": "d277c645-6674-3cc0-9a22-a5c70e1b886c",
                        "source_sense_id": "3ddc111d-c64c-3fab-8731-2594ed153ac7",
                        "source_sense_description": "Volksfest im September oder Oktober",
                        "target_lang_word": "Oktoberfest",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Oktoberfest",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c597db29-1630-3be7-934d-612d76fc1440",
                                        "entry_id": "dc4b5c93-16bb-3954-afd5-b00925750cca",
                                        "glosses": [
                                            "A two-week public festival in Munich (Bavaria, southern Germany), held yearly in late September and early October, known especially for the large party tents in which revellers consume beer on long benches."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7758acb-d199-4762-99ca-0f58035d5ebe",
                                                "sense_id": "c597db29-1630-3be7-934d-612d76fc1440",
                                                "text": "These Oktoberfests always resulted in bitter physical complaints, (“My liver is swelled to the thickness of seven inches, and I have spiders in my urine”), but they served for him the same peculiar function that all-night country-club gin parties were serving elsewhere."
                                            },
                                            {
                                                "example_id": "f1f2db97-1682-4c22-b742-3a5cafb0bd2e",
                                                "sense_id": "c597db29-1630-3be7-934d-612d76fc1440",
                                                "text": "Joe Rogers writes that he and Jean are headed for Germany and are quite pleased with the prospect. They must have heard about these Oktoberfests."
                                            },
                                            {
                                                "example_id": "f339d88b-cd86-45b8-ac6f-9c30f9ebd7ab",
                                                "sense_id": "c597db29-1630-3be7-934d-612d76fc1440",
                                                "text": "This includes interpreters for many of the world’s languages and 50 dirndl-clad waitresses versed in the intricacies of serving at Munich Oktoberfests."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
