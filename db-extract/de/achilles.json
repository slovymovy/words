                                "sense_id": "497f519f-15a8-348f-8afa-495c36dcccc3",
                                "text": "Die Achilles haben sich im Studium kennengelernt."
                            },
                            {
                                "example_id": "bf0be613-fea3-448f-874b-137d70c99d84",
                                "sense_id": "497f519f-15a8-348f-8afa-495c36dcccc3",
                                "text": "Heute gibt es bei Achilles Feuerzangenbowle."
                            },
                            {
                                "example_id": "a17929b7-2a9f-4d53-9761-85c235fdce3e",
                                "sense_id": "497f519f-15a8-348f-8afa-495c36dcccc3",
                                "text": "„Es ist gut, dass es Dauerläufer Achim Achilles gibt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
