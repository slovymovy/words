                    {
                        "sense_id": "9da6147d-f6ae-3a2f-a010-5b65c805aa94",
                        "entry_id": "84557e3c-2998-3bb7-b538-c67d82226edc",
                        "glosses": [
                            "Titre des monarques de Valachie et de Moldavie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f468d86-0ae5-43a7-b5de-7e52840b1a80",
                                "sense_id": "9da6147d-f6ae-3a2f-a010-5b65c805aa94",
                                "text": "Son arrière-grand-père avait été hospodar, ce qui équivaut au titre de sous-préfet en France."
                            },
                            {
                                "example_id": "ef4cc9b1-2088-46e7-9e05-a3041bf35ac7",
                                "sense_id": "9da6147d-f6ae-3a2f-a010-5b65c805aa94",
                                "text": "Il se dépeuple — ah ! où sont maintenant les papes, les explorateurs, les hospodars, les académiciens, les sars, les Mandrin ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "254950ce-4c71-3e53-b19a-3d586d60024a",
                        "entry_id": "84557e3c-2998-3bb7-b538-c67d82226edc",
                        "glosses": [
                            "Notable, personnage puissant."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "8476689b-b5d3-455e-b24b-3bf2f0604ce5",
                                "sense_id": "254950ce-4c71-3e53-b19a-3d586d60024a",
                                "text": "Elle avait donc tenté de s’aboucher avec des hospodars de la halle au blé, des gens riches si jamais il en fût !"
                            }
                        ]
                    }
                ],
