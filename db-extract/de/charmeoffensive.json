                "senses": [
                    {
                        "sense_id": "4dfa51f1-eb88-305a-95a0-8acde9ce5ab6",
                        "entry_id": "fbfa2438-ad1b-3eac-b0f4-038c9a9d8fb5",
                        "glosses": [
                            "aktiver Versuch, beispielsweise durch eine Kampagne, eine Person, Partei oder andere Organisation besonders freundlich auf Menschen wirken zu lassen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f34d564-44e8-4a52-b7f5-374acaec9ffe",
                                "sense_id": "4dfa51f1-eb88-305a-95a0-8acde9ce5ab6",
                                "text": "Inzwischen hat auch die Bundesregierung die antideutsche Stimmung in Teilen der südeuropäischen Bevölkerung [infolge der Austeritätspolitik] erkannt. Jetzt soll eine Charmeoffensive das angekratzte Image der Deutschen in Griechenland aufpolieren."
                            },
                            {
                                "example_id": "e8680837-7ed0-4d4d-a314-b80702d14874",
                                "sense_id": "4dfa51f1-eb88-305a-95a0-8acde9ce5ab6",
                                "text": "Positives Image kann man kaufen. Das glaubt zumindest China, das weltweit eine große Charmeoffensive startet."
                            },
                            {
                                "example_id": "5249f8c2-207d-459b-b06c-8fc26e142807",
                                "sense_id": "4dfa51f1-eb88-305a-95a0-8acde9ce5ab6",
                                "text": "Bis zum Schluss bemühte sich Kanadas Premier Justin Trudeau als Gastgeber [des G7-Gipfels 2018] in einer beispiellosen Charmeoffensive darum, den amerikanischen Präsidenten umzustimmen und von seinem protektionistischen Frontalkurs gegen seine engsten Verbündeten abzubringen. Vergebens."
                            },
                            {
                                "example_id": "270dbc77-a11e-4771-afbe-21abc023e67b",
                                "sense_id": "4dfa51f1-eb88-305a-95a0-8acde9ce5ab6",
                                "text": "Die SNCF betont, dass die Befragung keine rechtliche Grundlage habe und antwortet mit einer Charmeoffensive: Vergrätzte Pendler und Reisende sollen durch vergünstigte Tickets wiedergewonnen werden, kündigte SNCF-Chef Guillaume Pepy an."
                            },
                            {
                                "example_id": "a8803d14-7b78-4e9a-bc54-da6edd7cbd13",
                                "sense_id": "4dfa51f1-eb88-305a-95a0-8acde9ce5ab6",
                                "text": "Der spanische Politologe Salvador Llaudes wundert sich nicht über die Charmeoffensive der britischen Botschaft in Madrid. Sie sei ein Versuch der Spaltung […]"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
