{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "325bcaf0-97a3-32f1-8628-4f8163e80bfa",
                    "sense_definition": "Computer-generated imagery; visual content or special effects created using computer software, typically in films, television, and video games.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "visual_effects",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The latest science-fiction film relied heavily on <w>CGI</w> to create the alien worlds.",
                            "target_lang_translations": {
                                "zh": "最新的这部科幻电影严重依赖<w>电脑特效</w>来构建外星世界。"
                            }
                        },
                        {
                            "text": "Some viewers complained that poor <w>CGI</w> ruined the action sequence.",
                            "target_lang_translations": {
                                "zh": "一些观众抱怨拙劣的<w>电脑特效</w>毁掉了那个动作场面。"
                            }
                        }
                    ],
                    "synonyms": [
                        "CG"
                    ],
                    "common_phrases": [
                        "heavy CGI",
                        "poor CGI"
                    ],
                    "target_lang_definitions": {
                        "zh": "计算机合成图像；通常指在电影、电视和电子游戏中利用计算机软件制作的视觉特效或画面"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "电脑生成图像",
                                "target_lang_sense_clarification": "计算机生成的视觉特效或画面"
                            },
                            {
                                "target_lang_word": "电脑特效",
                                "target_lang_sense_clarification": "电影或影视剧中的计算机特效"
                            },
                            {
                                "target_lang_word": "CGI",
                                "target_lang_sense_clarification": "常用英文缩写代指计算机特效"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "157416eb-190f-3faf-9b30-065cd32ce4d3",
                    "sense_definition": "To generate or alter visual elements using computer-generated imagery.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "visual_effects",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The filmmakers decided to <w>CGI</w> the background instead of building practical sets.",
                            "target_lang_translations": {
                                "zh": "电影制作人决定<w>用电脑合成</w>背景，而不是搭建实景。"
                            }
                        },
                        {
                            "text": "When a Transformer turns into a car, do you think it is a real car or was it also <w>CGIed</w>?",
                            "target_lang_translations": {
                                "zh": "当变形金刚变成汽车时，你觉得那是真车还是也是<w>用电脑特效制作</w>的？"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "使用计算机生成图像技术制作或修改视觉画面"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "用电脑特效制作",
                                "target_lang_sense_clarification": "通过计算机技术生成画面"
                            },
                            {
                                "target_lang_word": "用电脑合成",
                                "target_lang_sense_clarification": "利用计算机软件合成视觉效果"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "1ebf5936-3e78-3215-8210-680daab63879",
                    "sense_definition": "Common Gateway Interface; a standard protocol enabling web servers to execute external programs and generate dynamic content.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "web_technology",
                    "name_type": "technology_or_software_name",
                    "examples": [
                        {
                            "text": "Early interactive websites often used a <w>CGI</w> script to process submitted form data.",
                            "target_lang_translations": {
                                "zh": "早期的交互式网站经常使用<w>CGI</w>脚本来处理提交的表单数据。"
                            }
                        },
                        {
                            "text": "The server executes the program via <w>CGI</w> and returns the generated output to the browser.",
                            "target_lang_translations": {
                                "zh": "服务器通过<w>通用网关接口</w>执行程序，并将生成的输出返回给浏览器。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "CGI script"
                    ],
                    "target_lang_definitions": {
                        "zh": "通用网关接口；一种允许网络服务器执行外部程序并生成动态网页内容的标准协议"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "通用网关接口",
                                "target_lang_sense_clarification": "Web服务器与外部程序交互的标准协议"
                            },
                            {
                                "target_lang_word": "CGI",
                                "target_lang_sense_clarification": "通用网关接口缩写"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}