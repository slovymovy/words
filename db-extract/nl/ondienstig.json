                        "source_sense_id": "24f9eb08-2e52-3085-b60d-7c53d4368723",
                        "target_lang_word": "abortive",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abortive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ea74664d-9132-395d-9ffa-61f7b689e8da",
                                        "entry_id": "86e641ed-3ef0-3210-b48d-17434e8df12e",
                                        "glosses": [
                                            "Produced by abortion; born prematurely and therefore unnatural."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2f9a68c-b6a1-4a46-bf27-11f08f8d10e8",
                                                "sense_id": "ea74664d-9132-395d-9ffa-61f7b689e8da",
                                                "text": "an abortive child"
                                            },
                                            {
                                                "example_id": "cabea537-b998-48b2-8052-9b1526766a29",
                                                "sense_id": "ea74664d-9132-395d-9ffa-61f7b689e8da",
                                                "text": "Thou elvish-marked, abortive, rooting hog!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a7a6b39-59a7-3eeb-a063-0c7a9df98bbc",
                                        "entry_id": "86e641ed-3ef0-3210-b48d-17434e8df12e",
                                        "glosses": [
                                            "Coming to nothing; failing in its effect. ."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35b52b28-b889-46d7-afde-9c5edeb73c36",
                                                "sense_id": "3a7a6b39-59a7-3eeb-a063-0c7a9df98bbc",
                                                "text": "He made a salutation, or, to speak nearer the truth, an ill-defined, abortive attempt at curtsy."
                                            },
                                            {
                                                "example_id": "49c2d07d-14c8-47e8-b68e-186d7b3d821a",
                                                "sense_id": "3a7a6b39-59a7-3eeb-a063-0c7a9df98bbc",
                                                "text": "an abortive attempt"
                                            },
                                            {
                                                "example_id": "623f6612-5613-4944-b00f-196d5f51a817",
                                                "sense_id": "3a7a6b39-59a7-3eeb-a063-0c7a9df98bbc",
                                                "text": "[…] and with utter loss of being / Threatens him, plung'd in that abortive gulf."
                                            },
                                            {
                                                "example_id": "ee0e5b98-b931-419d-b4ad-0852ed865187",
                                                "sense_id": "3a7a6b39-59a7-3eeb-a063-0c7a9df98bbc",
                                                "text": "The king in vain excused his hasty retreats and abortive enterprises"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dee5f8cc-9ea2-3ca5-bae6-f8ae58548b88",
                                        "entry_id": "86e641ed-3ef0-3210-b48d-17434e8df12e",
                                        "glosses": [
                                            "Imperfectly formed or developed; rudimentary; sterile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c91b986a-cfaa-4d14-b1ad-ca0f1b8569e8",
                                                "sense_id": "dee5f8cc-9ea2-3ca5-bae6-f8ae58548b88",
                                                "text": "an abortive ovule"
                                            },
                                            {
                                                "example_id": "d6899e5e-9cca-485b-9372-db17aea5162f",
                                                "sense_id": "dee5f8cc-9ea2-3ca5-bae6-f8ae58548b88",
                                                "text": "an abortive organ"
                                            },
                                            {
                                                "example_id": "6be1c5d6-444b-4ebf-aa02-15987a1637e3",
                                                "sense_id": "dee5f8cc-9ea2-3ca5-bae6-f8ae58548b88",
                                                "text": "an abortive stamen"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5cb38a3-646c-3edd-aafa-38cfb0a7ece2",
                                        "entry_id": "86e641ed-3ef0-3210-b48d-17434e8df12e",
                                        "glosses": [
                                            "Causing abortion; abortifacient."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a178b2d4-0a7f-4c90-a25e-f31e467bc78f",
                                                "sense_id": "f5cb38a3-646c-3edd-aafa-38cfb0a7ece2",
                                                "text": "abortive medicines"
                                            },
                                            {
                                                "example_id": "dd277542-1b81-46ce-a03a-8dc4fb0446f0",
                                                "sense_id": "f5cb38a3-646c-3edd-aafa-38cfb0a7ece2",
                                                "text": "Each country may have a different prevalence of infectious abortive agents. The most common agents of abortion in cattle are Brucella spp., Campylobacter spp., Chlamydiaceae, Coxiella burnetii, Leptospira spp., […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "783a06ab-26b9-38a2-bf2b-f5efa8457a41",
                                        "entry_id": "86e641ed-3ef0-3210-b48d-17434e8df12e",
                                        "glosses": [
                                            "Cutting short; acting to halt or slow the progress (of a disease)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa6ef3f1-30d3-4002-bb13-300b8663011a",
                                                "sense_id": "783a06ab-26b9-38a2-bf2b-f5efa8457a41",
                                                "text": "abortive treatment of typhoid fever"
                                            },
                                            {
                                                "example_id": "08da286c-9519-4407-b810-cafb1e6badfc",
                                                "sense_id": "783a06ab-26b9-38a2-bf2b-f5efa8457a41",
                                                "text": "Even with prophylaxis, children often experience episodic breakthrough headaches that require abortive treatment. […] Abortive therapies in the ED include dopamine antagonists and anti-inflammatory agents."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea6747da-e046-36f2-a5c0-96a1d90d8139",
                                        "entry_id": "86e641ed-3ef0-3210-b48d-17434e8df12e",
                                        "glosses": [
                                            "Having a short and mild progression, without pronounced symptoms."
                                        ],
                                        "tags": [
                                            "of a disease"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6e558cb8-f043-3a17-bf6c-f51587e38991",
                                        "entry_id": "86e641ed-3ef0-3210-b48d-17434e8df12e",
                                        "glosses": [
                                            "Made from the skin of a still-born animal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ba0a5a8-0459-483d-8d22-d798e33cc8b6",
                                                "sense_id": "6e558cb8-f043-3a17-bf6c-f51587e38991",
                                                "text": "abortive vellum"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "abortive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "431510a8-3442-3a4d-9de9-d8d4d83a6245",
                                        "entry_id": "5e308545-7565-3704-b19a-bf5ced3db21d",
                                        "glosses": [
                                            "Someone or something born or brought forth prematurely; an abortion."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "79a46c5f-a37d-3271-869a-6864637ab0b1",
                                        "entry_id": "5e308545-7565-3704-b19a-bf5ced3db21d",
                                        "glosses": [
                                            "A fruitless effort."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0825fc44-db31-35c2-a2be-bd44959c223a",
                                        "entry_id": "5e308545-7565-3704-b19a-bf5ced3db21d",
                                        "glosses": [
                                            "A medicine that causes abortion, an abortifacient."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a057519a-9c49-350b-b133-b059b432f572",
                                        "entry_id": "5e308545-7565-3704-b19a-bf5ced3db21d",
                                        "glosses": [
                                            "A medicine or treatment acting to halt or slow the progress of a disease."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90b8a087-a0bf-446c-bdbe-29b68b398282",
                                                "sense_id": "a057519a-9c49-350b-b133-b059b432f572",
                                                "text": "Naphthalin was praised by Rosbach as an abortive in typhoid fever; Kraemer in 1886, Wilcox in 1887, Sehwald in 1889 and Wolff of Philadelphia in 1891 confirmed Rosbach's observations."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "abortive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9d571b47-fa84-38ae-adbd-8d8d78e0455b",
                                        "entry_id": "6e736e2c-7684-3c15-ab8f-16283153bfae",
                                        "glosses": [
                                            "To cause an abortion; to render without fruit."
                                        ],
