                ],
                "senses": [
                    {
                        "sense_id": "a16535a2-af48-3ba2-8abd-7fef5894d73f",
                        "entry_id": "4030e318-4e5d-3aa7-9823-5206333cdcf2",
                        "glosses": [
                            "niet onder controle te houden, niet in bedwang te houden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8654e92c-367f-4adc-971e-bc52ec244372",
                                "sense_id": "a16535a2-af48-3ba2-8abd-7fef5894d73f",
                                "text": "Als een rivier door een steen geraakt wordt, beschouwt de rivier dat als gewoon de zoveelste commotie in zijn toch al woelige stroom. Niets bijzonders. Niets onhanteerbaars."
                            },
                            {
                                "example_id": "541d4446-0c2e-42b6-925b-4d52a5358a4e",
                                "sense_id": "a16535a2-af48-3ba2-8abd-7fef5894d73f",
                                "text": "Monsters representeren het biologisch onmogelijke, datgene wat slechts bestaat in fantasie, dromen, angstwanen en mythen. Het biologische is ongrijpbaarder en griezeliger dan het mechanische omdat het leeft: het evolueert, verandert, reageert en is dus onvoorspelbaar en onhanteerbaar."
                            },
                            {
                                "example_id": "816e8cd4-37bc-49bf-a613-518c202ce186",
                                "sense_id": "a16535a2-af48-3ba2-8abd-7fef5894d73f",
                                "text": "Volgens een patiënte, die enkele jaren in de kliniek zat en nu onder een soepeler regime valt, is het een koud kunstje om aan drugs te komen. ,,Altijd is er wel iemand die wat heeft. Het personeel staat dit oogluikend toe, bang als ze zijn dat de patiënten zonder hun shot nog onhanteerbaarder zijn."
                            }
                        ]
                    },
                    {
                        "sense_id": "70f5ee5b-3dfa-31a6-a32d-de0d65dcc16b",
                        "entry_id": "4030e318-4e5d-3aa7-9823-5206333cdcf2",
                        "glosses": [
                            "ongemakkelijk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "543894e7-3f03-4586-a050-512e84d2bffe",
                                "sense_id": "70f5ee5b-3dfa-31a6-a32d-de0d65dcc16b",
                                "text": "Die heel lange woorden (spaghettislingerwoorden?) maken we natuurlijk niet, want ze worden op den duur onhanteerbaar. Maar het zijn wel perfecte Nederlandse woorden, gemunt volgens de regels van de kunst."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9e932611-f9ad-4ef2-8e4f-e3277a6673a6",
                        "source_entry_id": "4030e318-4e5d-3aa7-9823-5206333cdcf2",
                        "source_sense_id": "a16535a2-af48-3ba2-8abd-7fef5894d73f",
                        "source_sense_description": "onbestuurbaar",
                        "target_lang_word": "unmanageable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unmanageable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "10151933-e832-34a5-9121-b9f964c591ed",
                                        "entry_id": "a0396ee0-01dc-3935-9a38-571e3d8f8234",
                                        "glosses": [
                                            "Not manageable; not readily submitting to handling or management; not easily restrained, governed, or directed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f15b4226-f37c-4d84-aee3-178dc1697eaa",
                                                "sense_id": "10151933-e832-34a5-9121-b9f964c591ed",
                                                "text": "Meanwhile, the everyday landscape becomes more nightmarish and unmanageable each year."
                                            },
                                            {
                                                "example_id": "ca67d6d0-4074-4ec9-b151-a527a2515d3c",
                                                "sense_id": "10151933-e832-34a5-9121-b9f964c591ed",
                                                "text": "It is time the international community faced the reality: we have an unmanageable, unfair, distortionary global tax regime. It is a tax system that is pivotal in creating the increasing inequality that marks most advanced countries today […]."
                                            },
                                            {
                                                "example_id": "8799cdea-aaa2-4d65-99db-ac789f2b6de6",
                                                "sense_id": "10151933-e832-34a5-9121-b9f964c591ed",
                                                "text": "It says the station's four ticket office windows were closed, with passengers directed to the five ticket machines, which \"resulted in chaos\". The TSSA reported: \"Within four minutes the queues were unmanageable, and the ticket office was forced to reopen for customers, who were said to be unimpressed.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
