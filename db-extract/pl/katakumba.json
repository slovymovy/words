                                                "text": "Meronyms: crypt, ossuary"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4581ae79-ebc2-401d-9f31-0cf12b97491c",
                        "source_entry_id": "e21a3f1d-2b8e-3a67-bf53-896a05a07b77",
                        "source_sense_id": "a23f79d9-f531-3e8c-9e17-5b3bad18eebd",
