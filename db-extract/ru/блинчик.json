                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8b9f1efa-e691-36fa-944d-d811549453d0",
                                        "entry_id": "ec5e3b12-2a93-3590-a6ea-1ed8007b498a",
                                        "glosses": [
                                            "Rubber in sheets, used especially for shoe soles."
                                        ],
                                        "tags": [
