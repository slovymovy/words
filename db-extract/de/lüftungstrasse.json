                "senses": [
                    {
                        "sense_id": "9f0f0091-eece-3e2f-b521-1fa7aedfc34e",
                        "entry_id": "f94bdd09-9742-371e-b40f-0ba922e2f134",
                        "glosses": [
                            "gebündelter Verlauf von lüftungstechnischen Versorgungsleitungen für Luft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a371c08a-8004-4a71-bde4-582fbde65b79",
                                "sense_id": "9f0f0091-eece-3e2f-b521-1fa7aedfc34e",
                                "text": "„Obwohl beim Bau der Lüftungstrasse für die Technikzentrale 1 unerwartete Schwierigkeiten bei der Querung eines Fernwärmebauwerkes auftraten, sollen die Lüftungstrasse und parallel dazu die Versorgung der Technikzentrale mit Nieder- und Mittelspannungskabel bis Monatsmitte fertiggestellt sein.“"
                            },
                            {
                                "example_id": "e97a8d15-3404-4e6d-88a1-73e880e8ae98",
                                "sense_id": "9f0f0091-eece-3e2f-b521-1fa7aedfc34e",
                                "text": "„Die beschriebenen räumlichen Kollisionen zwischen einer Kabeltrasse und einer Lüftungstrasse müssten also nach der og. Beschreibung der Grundleistungen bei der Integration der Fachplanungen in die Objektplanung auffallen; dafür bekommt der Objektplaner schließlich auch Honorar durch Einbezug der Kosten der Technischen Ausrüstung in seine anrechenbaren Kosten.“"
                            },
                            {
                                "example_id": "61d11317-3d56-42b7-aed1-4c906c0fa4e0",
                                "sense_id": "9f0f0091-eece-3e2f-b521-1fa7aedfc34e",
                                "text": "„Die Führung der Lüftungstrasse dort ist nicht mehr möglich.“"
                            },
                            {
                                "example_id": "f6e1724e-32cf-484b-8756-36dcae106149",
                                "sense_id": "9f0f0091-eece-3e2f-b521-1fa7aedfc34e",
                                "text": "„Ein Ausweichrohrstück mit variablen Querschnitt dient zum Umgehen eines sich auf der Lüftungstrasse in Lüftungssystemen befindenden Hindernisses, z.B. wenn Kanäle sich kreuzen.“"
                            },
                            {
                                "example_id": "a57aa3f7-73e1-4fb8-9622-4159d3fdd55f",
                                "sense_id": "9f0f0091-eece-3e2f-b521-1fa7aedfc34e",
                                "text": "„Horizontale Leitungsführung im Gangbereich sorgt für höhere Flexibilität und optimierte Infrastruktur, die Lüftungstrasse wird ringförmig geführt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
