                ],
                "senses": [
                    {
                        "sense_id": "55ecffd5-cd37-30ef-ba8e-19dfc491896b",
                        "entry_id": "a90ab38b-e8c9-3a99-8991-45f49fc43535",
                        "glosses": [
                            "о ветре, морозе и т. п.: пронизывающий холодом; ледяной"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "4a8d73a5-67ef-39cb-bf25-538d56f38658",
                        "entry_id": "a90ab38b-e8c9-3a99-8991-45f49fc43535",
                        "glosses": [
                            "перен. приводящий в состояние оцепенения; парализующий"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3f9831f-9f62-4565-987d-b629669f92e1",
                                "sense_id": "4a8d73a5-67ef-39cb-bf25-538d56f38658",
                                "text": "Мне памятны звуки музыки во время народных гуляний на площадях Москвы и леденящий душу свист сбрасываемых на неё фашистских бомб, а затем гул взрывов, звон падающего оконного стекла…"
                            },
                            {
                                "example_id": "5f647a18-fa45-4476-a229-a11312abd142",
                                "sense_id": "4a8d73a5-67ef-39cb-bf25-538d56f38658",
                                "text": "Юноша клонился всё круче, не выпуская из побелевших пальцев то, что осталось от рюмки, ― и осколок медленно елозил по мокрому фаянсу, издавая леденящий скрежет."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "51d4c7c4-98d1-4931-9fd1-6f5681d77568",
                        "source_entry_id": "a90ab38b-e8c9-3a99-8991-45f49fc43535",
                        "source_sense_description": "о ветре, морозе и т. п.: пронизывающий холодом; ледяной",
                        "target_lang_word": "glaçant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glaçant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "17f8c7b2-229a-3c3b-9fe8-fecebae5d7ec",
                                        "entry_id": "99ea8a2f-41c8-3c97-991b-b48742f50a46",
                                        "glosses": [
                                            "Qui glace."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fb86878-7317-4f64-9efe-a5a3c056a814",
                                                "sense_id": "17f8c7b2-229a-3c3b-9fe8-fecebae5d7ec",
                                                "text": "Un froid glaçant."
                                            },
                                            {
                                                "example_id": "3f7a4588-cdd1-4500-a973-fe58c8726224",
                                                "sense_id": "17f8c7b2-229a-3c3b-9fe8-fecebae5d7ec",
                                                "text": "Une bise glaçante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01fd2a77-1490-3890-ae51-365b34feb08d",
                                        "entry_id": "99ea8a2f-41c8-3c97-991b-b48742f50a46",
                                        "glosses": [
                                            "Qui manque de chaleur humaine."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26ff4e8e-a800-4dbd-a37d-cde379a5f7c6",
                                                "sense_id": "01fd2a77-1490-3890-ae51-365b34feb08d",
                                                "text": "Abord glaçant."
                                            },
                                            {
                                                "example_id": "23bef40b-8404-4a99-8c23-0cfb7d00ddb1",
                                                "sense_id": "01fd2a77-1490-3890-ae51-365b34feb08d",
                                                "text": "Politesse glaçante."
                                            },
                                            {
                                                "example_id": "2e69ac80-57f9-4b5f-ae03-e9597b5abb39",
                                                "sense_id": "01fd2a77-1490-3890-ae51-365b34feb08d",
                                                "text": "Telle est la figure tutélaire de mon enfance, qui nourrit, soigne, console, rassure : l’image même de la sécurité, pour moi que la peur domine désormais, dans le monde glaçant où nous avons été jetées ma mère et moi."
                                            },
                                            {
                                                "example_id": "d26c7dfc-42f5-40dc-bf58-f402fa943d70",
                                                "sense_id": "01fd2a77-1490-3890-ae51-365b34feb08d",
                                                "text": "Certaines sont spontanées, d'autres sont complètement travaillées, toutes sont glaçantes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2fe82d4-96be-392f-a76e-e9176afd3817",
                                        "entry_id": "99ea8a2f-41c8-3c97-991b-b48742f50a46",
                                        "glosses": [
                                            "Qui terrifie ou choque jusqu'au figement."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a0cc1d6-c856-4f17-a720-2224d6d234c1",
                                                "sense_id": "d2fe82d4-96be-392f-a76e-e9176afd3817",
                                                "text": "Samedi matin, le cadavre d’un détenu gisait sur le toit du bâtiment, aux murs blancs maculés de glaçantes traces de sang."
                                            },
                                            {
                                                "example_id": "495d2be4-7a34-46f0-9b97-af51dac4dbc5",
                                                "sense_id": "d2fe82d4-96be-392f-a76e-e9176afd3817",
                                                "text": "Derrière ces mots officiels se cache une vérité glaçante : le pays prépare systématiquement sa jeunesse à un futur où la guerre ne sera pas conjoncturelle, mais structurelle, un mode de vie imposé, presque glorifié."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "glaçant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "15ccee27-d9bc-3105-a4b3-82068550602a",
                                        "entry_id": "02c8e32c-6bea-3470-8cd4-511ea0a816ba",
                                        "glosses": [
                                            "Participe présent de glacer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
