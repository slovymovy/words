                                        "entry_id": "28c2364d-a341-37fe-bd88-766620617ed3",
                                        "glosses": [
                                            "een tijdperk waarin informatie centraal staat"
                                        ],
                                        "tags": [
                                            "media"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d51e9784-7d72-45e3-a2dd-72f785c52b5e",
                                                "sense_id": "6d5dcddb-52b5-32fe-b337-4999402cfc5c",
                                                "text": "Dit alles maakt dat we langzaam van een informatietijdperk naar een conceptueel tijdperk evolueren."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a74fcb4-789c-38ba-b6e6-b73c44d2f308",
                                        "entry_id": "28c2364d-a341-37fe-bd88-766620617ed3",
                                        "glosses": [
                                            "meer specifiek de periode sinds het einde van de 20e eeuw waarin steeds meer informatie digitaal verspreid werd, in tegenstelling tot het papiertijdperk"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b862c79-fa3d-4863-adac-d50008d44342",
                                                "sense_id": "5a74fcb4-789c-38ba-b6e6-b73c44d2f308",
                                                "text": "Bij het voortschrijden in het informatietijdperk komen regeringen wellicht steeds voor nieuwe problemen te staan."
                                            }
                                        ]
                                    }
                                ]
                            }
