                    },
                    {
                        "translation_id": "2ce7d2fd-4f01-44fd-8678-34c12e6d42a5",
                        "source_entry_id": "b1f8519d-e5dd-3408-b1c4-2428de774c24",
                        "source_sense_id": "00710880-9424-337a-ad85-41a397ff1fd3",
                        "target_lang_word": "dépôt",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dépôt",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "69267b12-b9b3-3f69-8183-a496c921f478",
                                        "entry_id": "f5b76e9f-c635-378f-b41d-c3a4005cd9a5",
                                        "glosses": [
                                            "Action de déposer, de placer une chose en quelque endroit, ou de remettre, de confier une chose à quelqu’un."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccddf135-e337-4763-aeee-52fda1541561",
                                                "sense_id": "69267b12-b9b3-3f69-8183-a496c921f478",
                                                "text": "Le dépôt du corps dans ce caveau n’est que provisoire."
                                            },
                                            {
                                                "example_id": "27df6f00-1b66-485d-99d1-b71b2efb8ed4",
                                                "sense_id": "69267b12-b9b3-3f69-8183-a496c921f478",
                                                "text": "Le dépôt de cette pétition a été fait sur le bureau de la Chambre."
                                            },
                                            {
                                                "example_id": "8692d57a-4813-49df-894d-26184c53f2d4",
                                                "sense_id": "69267b12-b9b3-3f69-8183-a496c921f478",
                                                "text": "Faire le dépôt d’une somme entre les mains d’un officier ministériel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fdf534c5-01eb-360d-8083-3ddfe3fa490a",
                                        "entry_id": "f5b76e9f-c635-378f-b41d-c3a4005cd9a5",
                                        "glosses": [
                                            "Ce qui est déposé, placement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2f7461d-24fd-4bf4-92ad-3d457a184e13",
                                                "sense_id": "fdf534c5-01eb-360d-8083-3ddfe3fa490a",
                                                "text": "Les petits déposants prenaient peur et retiraient leurs dépôts. Une immense thésaurisation d’or commençait dans tout le pays."
                                            },
                                            {
                                                "example_id": "1c46a873-17e7-41e3-bfda-b56465646cb7",
                                                "sense_id": "fdf534c5-01eb-360d-8083-3ddfe3fa490a",
                                                "text": "On a ordonné que le dépôt serait porté au greffe."
                                            },
                                            {
                                                "example_id": "40553ad9-bd3b-41ba-b0c5-1470468d9a30",
                                                "sense_id": "fdf534c5-01eb-360d-8083-3ddfe3fa490a",
                                                "text": "Retirer un dépôt."
                                            },
                                            {
                                                "example_id": "590ef0e2-63b3-43bc-bd39-420e31b623fe",
                                                "sense_id": "fdf534c5-01eb-360d-8083-3ddfe3fa490a",
                                                "text": "La Caisse des dépôts et consignations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b108ae6c-46d3-3ff9-b2ef-8600eaf01867",
                                        "entry_id": "f5b76e9f-c635-378f-b41d-c3a4005cd9a5",
                                        "glosses": [
                                            "Convention faite en déposant quelque chose entre les mains de quelqu’un, caution."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f49a670-d4d6-42c1-8d85-bf4718a5a0aa",
                                                "sense_id": "b108ae6c-46d3-3ff9-b2ef-8600eaf01867",
                                                "text": "Le dépôt est un contrat de bonne foi."
                                            },
                                            {
                                                "example_id": "5ed7f1e3-7650-4cec-b13f-12d1afe88c0d",
                                                "sense_id": "b108ae6c-46d3-3ff9-b2ef-8600eaf01867",
                                                "text": "Violer la foi du dépôt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "371681c7-2365-3060-8961-f77302bf6e62",
                                        "entry_id": "f5b76e9f-c635-378f-b41d-c3a4005cd9a5",
                                        "glosses": [
                                            "Lieu où l’on entrepose des objets ou des marchandises."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae7ca4cf-a251-4add-bbe1-e3949c4df26d",
                                                "sense_id": "371681c7-2365-3060-8961-f77302bf6e62",
                                                "text": "Le dépôt des archives."
                                            },
                                            {
                                                "example_id": "a8134f40-d6a4-48b6-8d46-ce9a9006992b",
                                                "sense_id": "371681c7-2365-3060-8961-f77302bf6e62",
                                                "text": "Dépôt d’armes."
                                            },
                                            {
                                                "example_id": "519d0dd2-9365-426d-9db8-5ac7b4a45fdc",
                                                "sense_id": "371681c7-2365-3060-8961-f77302bf6e62",
                                                "text": "La Première ministre, Élisabeth Borne, a annoncé, mardi, la réquisition du personnel nécessaire à la réouverture des deux dépôts d’ExxonMobil toujours bloqués, même après l’accord salarial trouvé lundi avec les deux syndicats majoritaires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ce7d243-468f-35f6-a72d-c6a754bce510",
                                        "entry_id": "f5b76e9f-c635-378f-b41d-c3a4005cd9a5",
                                        "glosses": [
                                            "Entrepôt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64f86cde-07c2-485c-87ec-c02746008070",
                                                "sense_id": "4ce7d243-468f-35f6-a72d-c6a754bce510",
                                                "text": "C’est le seul dépôt de ces marchandises qu’il y ait dans la ville."
                                            },
                                            {
                                                "example_id": "c4fc9fa9-0a8a-4733-b2c1-73420f6a9f32",
                                                "sense_id": "4ce7d243-468f-35f6-a72d-c6a754bce510",
                                                "text": "Ce propriétaire a établi un dépôt de ses vins à tel endroit."
                                            },
                                            {
                                                "example_id": "63d9f018-59ec-4f2f-b13a-76b4de182ef8",
                                                "sense_id": "4ce7d243-468f-35f6-a72d-c6a754bce510",
                                                "text": "Dépôt de pompes à incendie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0153a19a-c846-39d4-b9df-c5c6e84a7cdd",
                                        "entry_id": "f5b76e9f-c635-378f-b41d-c3a4005cd9a5",
                                        "glosses": [
                                            "Remise pour les locomotives ou autres véhicules."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4522d53a-ab73-4abf-b6e4-5fba7b67f3b1",
                                                "sense_id": "0153a19a-c846-39d4-b9df-c5c6e84a7cdd",
                                                "text": "Jacques était là, debout sur la plate-forme [de la locomotive], attendant pour rentrer au dépôt."
                                            },
                                            {
                                                "example_id": "f81133d1-ca3d-4137-9045-377b7d9167d3",
                                                "sense_id": "0153a19a-c846-39d4-b9df-c5c6e84a7cdd",
                                                "text": "Un autobus à vide fonce vers son dépôt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ad05174-50ab-3214-92d9-af8c56934ffe",
                                        "entry_id": "f5b76e9f-c635-378f-b41d-c3a4005cd9a5",
                                        "glosses": [
                                            "Lieu où l’on organise les cadres et où l’on exerce les recrues."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a84fd49-9c75-4727-be13-c9387c0527dc",
                                                "sense_id": "0ad05174-50ab-3214-92d9-af8c56934ffe",
                                                "text": "Et le dernier des Scaër, qui s'est engagé au mois de juillet, n'a pas encore vu le feu. On l'a d'abord envoyé dans un dépôt, pour y apprendre à faire l'exercice."
                                            },
                                            {
                                                "example_id": "52f36840-bbdf-4c8a-8eb2-3d45437f88fd",
                                                "sense_id": "0ad05174-50ab-3214-92d9-af8c56934ffe",
                                                "text": "L’effectif de la brigade n’avait pas varié : il s’était maintenu au chiffre de 6.000 hommes, grâce à l’apport régulier des dépôts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f0794cb-75f4-3c4f-a5f7-a7b593a121de",
                                        "entry_id": "f5b76e9f-c635-378f-b41d-c3a4005cd9a5",
                                        "glosses": [
                                            "Soldats, recrues qui sont en ce lieu."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45873f57-0de9-440e-ac5c-920b6a685b25",
                                                "sense_id": "0f0794cb-75f4-3c4f-a5f7-a7b593a121de",
                                                "text": "Le dépôt a reçu l’ordre de partir sur-le-champ."
                                            },
                                            {
                                                "example_id": "5efbffbf-2902-43ad-8524-8a10befe18a9",
                                                "sense_id": "0f0794cb-75f4-3c4f-a5f7-a7b593a121de",
                                                "text": "Il fait partie du dépôt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bff4b947-43d7-30e4-8124-125a0ec38a06",
                                        "entry_id": "f5b76e9f-c635-378f-b41d-c3a4005cd9a5",
                                        "glosses": [
                                            "Sédiment qu’un fluide dépose au fond du vase où il a séjourné pendant quelque temps.\\n#*Le dépôt de l’urine.\\n#*Il y a un dépôt au fond de la bouteille.\\n#*Un léger dépôt n’altère en rien la qualité de ce produit, phrase justifiante inscrite sur l’emballage de certains produits de commerce."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c400a663-608b-392f-8e71-88e82d19b1ec",
                                        "entry_id": "f5b76e9f-c635-378f-b41d-c3a4005cd9a5",
                                        "glosses": [
                                            "Amas d’humeurs qui se forme en quelque endroit du corps, abcès."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a4e6d85-7b58-4232-8e5d-54b61d2e39ad",
                                                "sense_id": "c400a663-608b-392f-8e71-88e82d19b1ec",
                                                "text": "Il faut donner un coup de bistouri en cet endroit, il s’y est fait un dépôt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d58a76e7-b0c2-3870-8ad3-717db0cf8ca5",
                                        "entry_id": "f5b76e9f-c635-378f-b41d-c3a4005cd9a5",
                                        "glosses": [
                                            "Masses de matières minérales, formées à la surface du Globe par les eaux, les glaciers, les vents, les êtres organisés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1044eb06-797d-44ec-bbb7-3cd0eae57141",
                                                "sense_id": "d58a76e7-b0c2-3870-8ad3-717db0cf8ca5",
                                                "text": "I. Essai des tourbes de Sécheval. — Il existe dans les arrondissements de Rocroy et de Mézières des dépôts considérables de tourbe exploitée pour les usages domestiques."
                                            },
                                            {
                                                "example_id": "8e8ea467-a140-4d0e-a1dd-ca144e98b632",
                                                "sense_id": "d58a76e7-b0c2-3870-8ad3-717db0cf8ca5",
                                                "text": "On voit dès lors qu'il n'est point indifférent de représenter une coquille d'une manière ou d'une autre, et qu'il importe au zoologiste ou au paléontologue de donner aux géologues des points de comparaison sur lesquels ceux-ci puissent s'appuyer pour reconnaître l'état des couches à l'instant où les êtres qui y sont enfermés ont été recouvert de nouveaux dépôts."
                                            },
                                            {
                                                "example_id": "9de9e00a-e540-4382-9010-d43ac4bd0a7d",
                                                "sense_id": "d58a76e7-b0c2-3870-8ad3-717db0cf8ca5",
                                                "text": "Les dépôts sont horizontaux dans la carrière de Saulces-aux-Tournelles, mais dans les carrières ouvertes le long du chemin qui monte vers Maheru apparaissent des discordances dans la stratification, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b85fb2da-bfcb-31a5-b308-5336c14265d7",
                                        "entry_id": "f5b76e9f-c635-378f-b41d-c3a4005cd9a5",
                                        "glosses": [
                                            "Stockage centralisé d'un logiciel de gestion de versions."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7adeccbb-0f4b-38fa-aa1f-308351891b0a",
                                        "entry_id": "f5b76e9f-c635-378f-b41d-c3a4005cd9a5",
                                        "glosses": [
                                            "Endroit où sont gardées provisoirement des personnes mises en examen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa7db7b1-728a-4870-9ae4-a1bfd3f709f8",
                                                "sense_id": "7adeccbb-0f4b-38fa-aa1f-308351891b0a",
                                                "text": "Il y avait un manège de vélocipèdes. Blanche, avec ses manies de faire toujours à sa tête, chahutait là-dessus en montrant ses mollets et tout. On lui avait dit : Ne fais donc pas ça, tu verras qu’un jour ou l’autre tu te feras ramasser. Ça y était : qu’est-ce que j’avais dit ! Au Dépôt, il y a la visite, elle n’avait pas passé saine et on l’avait envoyée se soigner à Saint-Lazare."
                                            },
                                            {
                                                "example_id": "6f89c237-38cf-46c0-bff1-a025e53cf86d",
                                                "sense_id": "7adeccbb-0f4b-38fa-aa1f-308351891b0a",
                                                "text": "Il est pris, il ne peut plus s’échapper. Il faut agir maintenant et agir vite, nous allons le mener au Dépôt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "80fee496-a6f9-4624-b874-2cedf99c86ee",
                        "source_entry_id": "b1f8519d-e5dd-3408-b1c4-2428de774c24",
                        "source_sense_id": "00710880-9424-337a-ad85-41a397ff1fd3",
                        "target_lang_word": "entrepôt",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "entrepôt",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "012462d5-6bce-3423-99a6-eeafa7eb517d",
                                        "entry_id": "77eb08d5-3456-3e10-8f6a-5ede0a5992b9",
                                        "glosses": [
                                            "Lieu où l’on met des marchandises en dépôt."
                                        ],
                                        "tags": [
                                            "Logistique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67e2064f-92da-4ab7-87ad-9ad5abbec3d9",
                                                "sense_id": "012462d5-6bce-3423-99a6-eeafa7eb517d",
                                                "text": "« C’est un choc, mais nous nous réjouissons qu’il n’y ait pas de blessé », a déclaré Shaoul Abramczyk, président du groupe Les Halles Mandar, à qui appartenait l’entrepôt."
                                            },
                                            {
                                                "example_id": "1da2bdfe-d2df-4cab-91f7-b58358cad940",
                                                "sense_id": "012462d5-6bce-3423-99a6-eeafa7eb517d",
                                                "text": "Çà et là, ce sont des magasins, des entrepôts, des chais, ou bien le cube de béton d'une cave coopérative, sévère comme un blockhaus...."
                                            },
                                            {
                                                "example_id": "74357947-60fe-41df-84c4-d769e58fd63b",
                                                "sense_id": "012462d5-6bce-3423-99a6-eeafa7eb517d",
                                                "text": "Les entreprises de messagerie et de messagerie express exploitent des entrepôts locaux et régionaux qu'elles utilisent pour les opérations de groupage."
                                            },
                                            {
                                                "example_id": "d1e10a4c-8b34-4a80-8ae3-d3a078b8240d",
                                                "sense_id": "012462d5-6bce-3423-99a6-eeafa7eb517d",
                                                "text": "L’image aérienne vient d'en révéler l'importance en mettant en évidence une grande avenue, des monuments, et surtout, les horrea, grands entrepôts d'état, généralement associés à une activité portuaire."
                                            },
                                            {
                                                "example_id": "a70aafc2-2cb5-467b-a7e3-32553733a509",
                                                "sense_id": "012462d5-6bce-3423-99a6-eeafa7eb517d",
                                                "text": "La colère monte chez les routiers, mais aussi parmi les salariés des bases d’entrepôts logistiques et ceux des transports sanitaires, qui ne s’estiment pas protégés contre le coronavirus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d53ba9f7-0aa9-3ac5-a4a3-c31cf8f3c957",
                                        "entry_id": "77eb08d5-3456-3e10-8f6a-5ede0a5992b9",
                                        "glosses": [
                                            "Lieu où les marchandises peuvent rester déposées jusqu’à ce qu’on les exporte ou qu’on en acquitte les droits."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b775fe0d-7e58-4b3d-9a8e-a2b232b90baf",
                                                "sense_id": "d53ba9f7-0aa9-3ac5-a4a3-c31cf8f3c957",
                                                "text": "Marchandises en entrepôt."
                                            },
                                            {
                                                "example_id": "666d17ea-95d9-4cbc-ba93-3d5d161e5a37",
                                                "sense_id": "d53ba9f7-0aa9-3ac5-a4a3-c31cf8f3c957",
                                                "text": "Porter des marchandises à l’entrepôt."
                                            },
                                            {
                                                "example_id": "6178753f-58fc-4162-9609-1c7dad30b214",
                                                "sense_id": "d53ba9f7-0aa9-3ac5-a4a3-c31cf8f3c957",
                                                "text": "L’entrepôt des vins, des eaux-de-vie."
                                            },
                                            {
                                                "example_id": "de2961e1-c9ac-4c99-b812-a4b01f21b540",
                                                "sense_id": "d53ba9f7-0aa9-3ac5-a4a3-c31cf8f3c957",
                                                "text": "Entrepôt réel, entrepôt fictif. L’entrepôt réel est le magasin public, l’entrepôt fictif est le magasin privé où l’on entrepose des marchandises."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7fb8b20-8c86-3c48-9039-e513131b9fdf",
                                        "entry_id": "77eb08d5-3456-3e10-8f6a-5ede0a5992b9",
                                        "glosses": [
                                            "Magasin où l’on vend quelque marchandise pour le compte de l’état."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cdf02217-c72a-41e7-bf73-1d5f55c7f903",
                                                "sense_id": "c7fb8b20-8c86-3c48-9039-e513131b9fdf",
                                                "text": "Un entrepôt de tabac."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afbfe3ee-67f3-352b-a697-9a27822cad9c",
                                        "entry_id": "77eb08d5-3456-3e10-8f6a-5ede0a5992b9",
                                        "glosses": [
                                            "Ville, d’un pays, où les marchandises sont déposées temporairement jusqu’à ce qu’on les expédie au lieu de leur consommation."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c781e797-5d35-423e-ae55-9d6712ff5736",
                                                "sense_id": "afbfe3ee-67f3-352b-a697-9a27822cad9c",
                                                "text": "Alexandrie fut longtemps l’entrepôt du commerce de l’Europe et de l’Asie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d5e0ab3-5693-3f7a-9606-f51ea43696ab",
                                        "entry_id": "77eb08d5-3456-3e10-8f6a-5ede0a5992b9",
                                        "glosses": [
                                            "Base, centre de données."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ac11608-26ad-40f9-8eb3-3b1adf839b0a",
                                                "sense_id": "5d5e0ab3-5693-3f7a-9606-f51ea43696ab",
                                                "text": "On y découvre que la Direction générale des finances publiques a en effet constitué « une équipe spécialisée qui réunit progressivement dans un entrepôt unique des données issues des applications professionnelles, personnelles et patrimoniales de la DGFiP ». Et c’est cet entrepôt qui sera nourri progressivement par les données de sources ouvertes, comme le précise cette fois le DPT 2019."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
