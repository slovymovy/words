                "senses": [
                    {
                        "sense_id": "a4b031db-e5a2-31c0-9c23-8bf7a0baf8e3",
                        "entry_id": "c93a2f50-788b-372a-9be9-1c931240eb08",
                        "glosses": [
                            "Einzelraumfeuerungsanlage als Wärmespeicher aus mineralischen Speichermaterialien, vor allem Lehm, Lehmsteinen, Lehmmörtel und Lehmputz und weiteren Materialien wie zum Beispiel Schamottsteine, Backsteine oder Dachziegel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "271e6f6c-3bbc-428b-83c7-09b13fa7cc3d",
                                "sense_id": "a4b031db-e5a2-31c0-9c23-8bf7a0baf8e3",
                                "text": "„Vor dem Fenster tanzen dicke Schneeflocken vorbei, lautlos und sanft. Ein Wintermärchen. Im breiten Lehmofen bullert es, und zu fressen und zu saufen haben sie auch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0bbc31ef-4b5d-3a69-bbb4-86ca4df45369",
                        "entry_id": "c93a2f50-788b-372a-9be9-1c931240eb08",
                        "glosses": [
                            "Ton-Brennofen zur Keramikherstellung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7d51e17-b31f-4fdd-a45e-567f72665006",
                                "sense_id": "0bbc31ef-4b5d-3a69-bbb4-86ca4df45369",
                                "text": "Mit seinen Studenten baut er Lehmöfen nach, brennt Tonkrüge und backt Brot."
                            }
                        ],
