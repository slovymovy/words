                    {
                        "form_id": "551b9c2f-48d4-4e8b-9323-df00e3f77f6a",
                        "entry_id": "2ceb7769-7885-39b8-8e8b-3bf2b500aeb0",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Todeskampf"
                    },
                    {
                        "form_id": "71588031-bd0a-4dec-8a1a-a599c6f151a2",
                        "entry_id": "2ceb7769-7885-39b8-8e8b-3bf2b500aeb0",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Todeskämpfe"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "98d4d895-a2a9-3357-a326-e077f61e09a0",
                        "entry_id": "2ceb7769-7885-39b8-8e8b-3bf2b500aeb0",
                        "glosses": [
                            "(qualvolles) Ringen mit dem bevorstehenden Tod, Untergang, Vergehen"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "11018d4b-668a-4ec5-8429-39b8c17d7755",
                                "sense_id": "98d4d895-a2a9-3357-a326-e077f61e09a0",
                                "text": "Nach stundenlangem Todeskampf erlag er den Verletzungen."
                            },
                            {
                                "example_id": "13489f6f-9ef2-4336-a78e-91f3f126f17f",
                                "sense_id": "98d4d895-a2a9-3357-a326-e077f61e09a0",
                                "text": "„Mitten im Wintersechseck strahlt der helle Stern Beteigeuze im Orion, ein Roter Riesenstern, also eine sterbende Sonne, die sich im Todeskampf aufbläht.“"
                            },
                            {
                                "example_id": "b8786fff-d8f7-4f50-ba42-8b1cd13b7c08",
                                "sense_id": "98d4d895-a2a9-3357-a326-e077f61e09a0",
                                "text": "„Mit einer unerträglichen sinnlichen Genauigkeit schildert Camus den Todeskampf, der keinen Trost zulässt.“"
                            },
                            {
                                "example_id": "2c662771-5919-4ecc-af90-ec6dbddee3e4",
                                "sense_id": "98d4d895-a2a9-3357-a326-e077f61e09a0",
                                "text": "„Der Comanchee sprach mit gebrochener schwacher Stimme, aber mit einem Ausdrucke auf seinem vom Todeskampfe entstellten Gesicht, der hinlänglich verriet, daß er seine neuen Brüder nichts weniger als fähig halte, sich diesem edlern Gebrauche seiner Nation zu unterwerfen.“"
                            },
                            {
                                "example_id": "6af5648a-215e-41f2-8e72-364d30737664",
                                "sense_id": "98d4d895-a2a9-3357-a326-e077f61e09a0",
                                "text": "„Der Bär fuhr noch mit letzter Kraftanstrengung im Todeskampf in die Höhe, wehrte nicht einmal den beiden Hunden Poppy und Watch – Harpers Hund – die sich auf ihn warfen, sondern sprang die steile Uferbank hinab in den Fluß, und Bär, Roberts, Poppy und Watch verschwanden gleichzeitig in dem über ihnen zusammenschlagenden, trüben Petite-Jeanne.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f92d6a33-25bb-407d-834c-9f50c77bc896",
                        "source_entry_id": "2ceb7769-7885-39b8-8e8b-3bf2b500aeb0",
                        "source_sense_id": "98d4d895-a2a9-3357-a326-e077f61e09a0",
                        "source_sense_description": "(qualvolles) Ringen mit dem bevorstehenden Tod, übertragen: Untergang, Vergehen",
                        "target_lang_word": "agony",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "agony",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5213f6d0-f87e-3fe4-adcc-fa7d780688d0",
                                        "entry_id": "ee9025ae-975d-3654-a56f-f52bb4396551",
                                        "glosses": [
                                            "Extreme pain."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "723b121d-81e2-4693-995a-4552060ea779",
                                                "sense_id": "5213f6d0-f87e-3fe4-adcc-fa7d780688d0",
                                                "text": "When the weight fell on her foot, she cried out in agony."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d9cf6fd-b2ba-39e1-9ad3-9c18fed8674a",
                                        "entry_id": "ee9025ae-975d-3654-a56f-f52bb4396551",
                                        "glosses": [
                                            "The sufferings of Jesus Christ in the Garden of Gethsemane (often capitalized)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ed246e8-ed65-4f71-a696-b71bc52480b5",
                                                "sense_id": "8d9cf6fd-b2ba-39e1-9ad3-9c18fed8674a",
                                                "text": "And being in an agonie, he prayed more earneſtly,[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f060095-9c25-3e1e-af79-ddddd73be450",
                                        "entry_id": "ee9025ae-975d-3654-a56f-f52bb4396551",
                                        "glosses": [
                                            "Violent contest or striving."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8663c127-2396-4e36-9781-60b85d9220e8",
                                                "sense_id": "8f060095-9c25-3e1e-af79-ddddd73be450",
                                                "text": "The world is convulsed by the agonies of great nations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1fdbf37-1206-3099-a371-7df1eb01601b",
                                        "entry_id": "ee9025ae-975d-3654-a56f-f52bb4396551",
                                        "glosses": [
                                            "Paroxysm of joy; keen emotion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b3f89e7-f096-4ec1-b285-60cb8493c4af",
                                                "sense_id": "e1fdbf37-1206-3099-a371-7df1eb01601b",
                                                "text": "With cries and agonies of wild delight."
                                            }
                                        ]
                                    },
