                        "examples": [
                            {
                                "example_id": "6bf0c76d-5265-4efb-9cb3-c3ffaec5f4b2",
                                "sense_id": "ae854c8f-bb50-3cb6-ac98-3e633e229202",
                                "text": "Dr. Creeton, [Robert Creighton] the Scotchman, […] ripped up Hugh Peters (calling him the execrable skellum), his preaching and stirring up the maids of the city to bring in their bodkins and thimbles."
                            },
                            {
                                "example_id": "f2faad98-d1a8-4914-b49c-91c2d92dcbc3",
                                "sense_id": "ae854c8f-bb50-3cb6-ac98-3e633e229202",
                                "text": "O Tam! had'st thou but been sae wise,\nAs taen thy ain wife Kate's advice!\nShe tauld thee weel thou was a skellum,\nA blethering, blustering, drunken blellum;\nThat frae November till October,\nAe market-day thou was na sober."
                            }
                        ]
