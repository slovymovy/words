                                        "glosses": [
                                            "das Hundertfache des metrischen Hohlmaßes von einem Kubikdezimeter (1 dm³ = 1 l), als Volumeneinheit meist bei Flüssigkeiten oder Gasen verwendet, 100 Liter"
                                        ],
                                        "tags": [],
