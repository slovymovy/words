                "forms": [
                    {
                        "form_id": "c11839e5-4ab2-40b5-810f-35dff6c2d354",
                        "entry_id": "5d21e968-20f3-3248-9d9f-2baba0e94896",
                        "tags": [
                            "plural",
                            "masculine",
