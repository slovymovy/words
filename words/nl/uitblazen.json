{
    "word_family": [
        "blazen",
        "uitblazer",
        "uitblazing"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bd379a83-8a03-3def-959b-f979ce3f42f1",
                    "sense_definition": "Even rusten om weer op krachten te komen na een inspanning.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "rusten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na die lange wandeling in de bergen moesten we even <w>uitblazen</w> op een bankje.",
                            "target_lang_translations": {
                                "en": "After that long hike in the mountains, we had to <w>catch our breath</w> on a bench for a moment."
                            }
                        },
                        {
                            "text": "Het is heerlijk om een weekendje <w>uit</w> te <w>blazen</w> aan de kust.",
                            "target_lang_translations": {
                                "en": "It is wonderful to <w>unwind</w> for a weekend at the coast."
                            }
                        }
                    ],
                    "synonyms": [
                        "op adem komen",
                        "verademen"
                    ],
                    "common_phrases": [
                        "even uitblazen",
                        "lekker uitblazen"
                    ],
                    "target_lang_definitions": {
                        "en": "To rest for a moment to recover one's strength after an effort."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "catch one's breath",
                                "target_lang_sense_clarification": "to rest after exertion"
                            },
                            {
                                "target_lang_word": "take a breather",
                                "target_lang_sense_clarification": "to take a short break"
                            },
                            {
                                "target_lang_word": "unwind",
                                "target_lang_sense_clarification": "to relax after a busy period"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1cf920f0-f6cd-3506-b6c3-504573464362",
                    "sense_definition": "Iets doven door er lucht tegenaan te blazen.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "doven",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het kind mocht alle kaarsjes op de verjaardagstaart in één keer <w>uitblazen</w>.",
                            "target_lang_translations": {
                                "en": "The child was allowed to <w>blow out</w> all the candles on the birthday cake at once."
                            }
                        },
                        {
                            "text": "Vergeet niet de kaars <w>uit</w> te <w>blazen</w> voordat je naar bed gaat.",
                            "target_lang_translations": {
                                "en": "Don't forget to <w>blow out</w> the candle before you go to bed."
                            }
                        }
                    ],
                    "common_phrases": [
                        "kaarsjes uitblazen"
                    ],
                    "target_lang_definitions": {
                        "en": "To extinguish something by blowing air against it."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "blow out",
                                "target_lang_sense_clarification": "to extinguish a flame"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5f08d77c-a413-3da0-92c5-f42478b0968c",
                    "sense_definition": "Lucht of rook krachtig uit de mond naar buiten drijven.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ademen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij nam een trekje van zijn sigaret en begon de rook langzaam <w>uit</w> te <w>blazen</w>.",
                            "target_lang_translations": {
                                "en": "He took a puff of his cigarette and began to slowly <w>blow out</w> the smoke."
                            }
                        },
                        {
                            "text": "De oude man zou die nacht vredig zijn laatste adem <w>uitblazen</w>.",
                            "target_lang_translations": {
                                "en": "The old man would peacefully <w>breathe</w> his last that night."
                            }
                        }
                    ],
                    "common_phrases": [
                        "de laatste adem uitblazen",
                        "rook uitblazen"
                    ],
                    "target_lang_definitions": {
                        "en": "To forcefully expel air or smoke from the mouth."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "exhale",
                                "target_lang_sense_clarification": "to breathe out"
                            },
                            {
                                "target_lang_word": "blow out",
                                "target_lang_sense_clarification": "to expel smoke or air"
                            },
                            {
                                "target_lang_word": "breathe one's last",
                                "target_lang_sense_clarification": "to die"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "257777e7-07aa-3786-8a59-2a5f04739eb2",
                    "sense_definition": "Iets leegmaken of reinigen door er lucht doorheen te persen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "reinigen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Voor het knutselen moesten we eerst de eieren voorzichtig <w>uitblazen</w>.",
                            "target_lang_translations": {
                                "en": "Before crafting, we first had to carefully <w>blow</w> the eggs."
                            }
                        },
                        {
                            "text": "De monteur moest de verstopte leiding grondig <w>uitblazen</w> met perslucht.",
                            "target_lang_translations": {
                                "en": "The mechanic had to thoroughly <w>blow out</w> the clogged pipe with compressed air."
                            }
                        }
                    ],
                    "synonyms": [
                        "doorblazen",
                        "leegblazen",
                        "schoonblazen"
                    ],
                    "common_phrases": [
                        "eieren uitblazen"
                    ],
                    "target_lang_definitions": {
                        "en": "To empty or clean something by forcing air through it."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "blow out",
                                "target_lang_sense_clarification": "to clean or empty with air"
                            },
                            {
                                "target_lang_word": "blow",
                                "target_lang_sense_clarification": "to empty an egg"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "153afc67-93c5-3fce-b90f-50de4067ce3a",
                    "sense_definition": "Glas in de gewenste vorm brengen door middel van blaastechnieken.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ambacht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de glasblazerij konden we zien hoe de vakman een prachtige vaas zat <w>uit</w> te <w>blazen</w>.",
                            "target_lang_translations": {
                                "en": "In the glassworks, we could see how the craftsman was <w>blowing</w> a beautiful vase."
                            }
                        },
                        {
                            "text": "Het glas moet voorzichtig worden <w>uitgeblazen</w> voordat het afkoelt en hard wordt.",
                            "target_lang_translations": {
                                "en": "The glass must be carefully <w>blown</w> before it cools and hardens."
                            }
                        }
                    ],
                    "common_phrases": [
                        "glas uitblazen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technische term in de glasindustrie"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To shape glass into a desired form using blowing techniques."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "blow",
                                "target_lang_sense_clarification": "to shape glass"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e4013148-793c-396d-adef-462378dbfdde",
                    "sense_definition": "Het betalen van rekeningen of gemaakte onkosten.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "betalen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na het diner moesten we de flinke rekening nog even <w>uitblazen</w>.",
                            "target_lang_translations": {
                                "en": "After dinner, we still had to <w>cough up</w> the hefty bill."
                            }
                        },
                        {
                            "text": "Hij had niet verwacht dat hij zoveel onkosten zou moeten <w>uitblazen</w> deze maand.",
                            "target_lang_translations": {
                                "en": "He hadn't expected that he would have to <w>shell out</w> for so many expenses this month."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informeel gebruik voor betalen"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To pay bills or incurred expenses."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cough up",
                                "target_lang_sense_clarification": "to pay money reluctantly"
                            },
                            {
                                "target_lang_word": "shell out",
                                "target_lang_sense_clarification": "to pay a large amount"
                            },
                            {
                                "target_lang_word": "blow out",
                                "target_lang_sense_clarification": "to spend a lot of money"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}