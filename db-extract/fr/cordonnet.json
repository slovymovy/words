            {
                "entry_id": "806ee381-cb8d-367f-af5b-e3361266fd44",
                "word": "cordonnet",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "48a55750-c1b6-49ee-96a9-eae4b5b4b76b",
                        "entry_id": "806ee381-cb8d-367f-af5b-e3361266fd44",
                        "tags": [
                            "plural"
                        ],
                        "form": "cordonnets"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c0a3ec6c-52d5-358b-b85c-c356219e05f9",
                        "entry_id": "806ee381-cb8d-367f-af5b-e3361266fd44",
                        "glosses": [
                            "Petit cordon, tresse, petit ruban, pour attacher ou pour enfiler quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb4ff5b4-111f-4861-b66e-771d323b7bd5",
                                "sense_id": "c0a3ec6c-52d5-358b-b85c-c356219e05f9",
                                "text": "Je me rappelle mon désespoir, quand je fus seul et couché, mes sanglots, et ce sac de bonbons que fermait un cordonnet doré, posé sur un chaise à côte de mon lit, et dont on avait eu la naïveté de croire qu’il me consolerait."
                            },
                            {
                                "example_id": "b7ddfe0a-756e-470e-8745-2b231fb29c85",
                                "sense_id": "c0a3ec6c-52d5-358b-b85c-c356219e05f9",
                                "text": "Elle était entièrement recouverte d’un voile bleu du sud maintenu par une fibule d’argent sur l’os de l’épaule, décoré de cordonnets multicolores ornés de clinquants, de cornalines et de pièces d’argent démonétisées."
                            },
                            {
                                "example_id": "b1dfd753-7f4c-46af-a424-ef2983eabec8",
                                "sense_id": "c0a3ec6c-52d5-358b-b85c-c356219e05f9",
                                "text": "Glisser une perle de bois à l’extrémité du cordonnet, passer le ruban d’organza de 25 cm."
                            },
                            {
                                "example_id": "88cb1bc0-1b75-447f-99d4-f09cc090075f",
                                "sense_id": "c0a3ec6c-52d5-358b-b85c-c356219e05f9",
                                "text": "D’abord ils aiment à employer, pour l’arrangement de leur coiffure, la pommade de Simomoura et les cordonnets de Tsyôzi."
                            }
                        ]
                    },
                    {
                        "sense_id": "3d378239-c089-30d1-9508-0bd0a3557795",
                        "entry_id": "806ee381-cb8d-367f-af5b-e3361266fd44",
                        "glosses": [
                            "Marque qui est empreinte sur la tranche des pièces d’or et d’argent."
                        ],
