                                "target_lang_sense_clarification": "zufriedenes Gefühl durch die Freude an etwas"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "63757bfa-1094-3f48-813d-7051daf32f7e",
                    "sense_definition": "To give someone a lot of pleasure or enjoyment.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verb_transitive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The magician's tricks <w>delighted</w> the audience for hours.",
                            "target_lang_translations": {
                                "ru": "Фокусы иллюзиониста часами <w>восхищали</w> публику.",
                                "nl": "De trucs van de goochelaar <w>verblijdden</w> het publiek urenlang.",
                                "pl": "Sztuczki magika <w>zachwycały</w> publiczność przez wiele godzin.",
                                "de": "Die Tricks des Zauberers <w>erfreuten</w> das Publikum stundenlang."
                            }
                        },
                        {
                            "text": "It would <w>delight</w> me to join you for dinner tonight.",
                            "target_lang_translations": {
                                "ru": "Меня <w>обрадует</w> возможность поужинать с вами сегодня.",
                                "nl": "Het zou mij <w>verblijden</w> om vanavond met u mee te eten.",
                                "pl": "Z <w>przyjemnością</w> dołączę do was na kolację dzisiaj wieczorem.",
                                "de": "Es würde mich <w>freuen</w>, heute Abend mit Ihnen zu essen."
                            }
                        }
                    ],
                    "synonyms": [
                        "please",
                        "gladden",
                        "gratify",
                        "cheer",
                        "exhilarate"
                    ],
                    "antonyms": [
                        "displease",
                        "bore"
                    ],
                    "common_phrases": [
                        "delight the eye",
                        "delight the senses",
                        "delight the audience"
                    ],
                    "target_lang_definitions": {
                        "ru": "Доставлять кому-либо большое удовольствие или радость.",
                        "nl": "Iemand veel plezier of vermaak bezorgen.",
                        "pl": "Sprawiać komuś dużą przyjemność lub radość.",
                        "de": "Jemandem viel Freude oder Vergnügen bereiten."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "восхищать",
                                "target_lang_sense_clarification": "вызывать чувство восторга"
                            },
                            {
                                "target_lang_word": "радовать",
                                "target_lang_sense_clarification": "доставлять радость"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "behagen",
                                "target_lang_sense_clarification": "iemand welgevallig zijn"
                            },
                            {
                                "target_lang_word": "verblijden",
                                "target_lang_sense_clarification": "iemand blij maken"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "cieszyć",
                                "target_lang_sense_clarification": "sprawiać komuś radość"
                            },
                            {
                                "target_lang_word": "zachwycać",
                                "target_lang_sense_clarification": "wprawiać w stan zachwytu"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "erfreuen",
                                "target_lang_sense_clarification": "bei jemandem Freude hervorrufen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ca6b8db1-bfb0-3286-b4fc-83f4e842901e",
                    "sense_definition": "To get great pleasure from something; to enjoy something very much.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verb_intransitive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>delights</w> in telling stories to her grandchildren.",
                            "target_lang_translations": {
                                "ru": "Она <w>обожает</w> рассказывать истории своим внукам.",
                                "nl": "Zij <w>geniet</w> ervan om verhalen te vertellen aan haar kleinkinderen.",
                                "pl": "Ona <w>uwielbia</w> opowiadać historie swoim wnukom.",
                                "de": "Sie <w>erfreut</w> sich daran, ihren Enkeln Geschichten zu erzählen."
                            }
                        },
                        {
                            "text": "The cat <w>delights</w> in chasing the laser pointer around the room.",
                            "target_lang_translations": {
                                "ru": "Кот с <w>наслаждением</w> гоняется за лазерной указкой по комнате.",
                                "nl": "De kat <w>geniet</w> ervan om achter de laserlamp door de kamer aan te jagen.",
                                "pl": "Kot <w>rozkoszuje</w> się gonieniem za wskaźnikiem laserowym po pokoju.",
                                "de": "Die Katze <w>erfreut</w> sich daran, dem Laserpointer durch den Raum hinterherzujagen."
                            }
                        }
                    ],
                    "synonyms": [
                        "rejoice"
                    ],
                    "common_phrases": [
                        "delight in"
                    ],
                    "target_lang_definitions": {
                        "ru": "Получать огромное удовольствие от чего-либо; очень любить делать что-либо.",
                        "nl": "Groot plezier beleven aan iets; ergens erg van genieten.",
                        "pl": "Czerpać wielką przyjemność z czegoś; bardzo coś lubić.",
                        "de": "Große Freude an etwas haben; etwas sehr genießen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наслаждаться",
                                "target_lang_sense_clarification": "испытывать удовольствие от процесса"
                            },
                            {
                                "target_lang_word": "обожать",
                                "target_lang_sense_clarification": "очень сильно любить что-то делать"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "genieten",
                                "target_lang_sense_clarification": "plezier beleven aan een activiteit"
                            },
                            {
                                "target_lang_word": "zich vermaken",
                                "target_lang_sense_clarification": "leuke tijd hebben met iets"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "cieszyć się",
                                "target_lang_sense_clarification": "odczuwać radość z czegoś"
                            },
                            {
                                "target_lang_word": "rozkoszować się",
                                "target_lang_sense_clarification": "czerpać wielką przyjemność z procesu"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "sich erfreuen an",
                                "target_lang_sense_clarification": "etwas genießen oder Freude an etwas haben"
                            },
                            {
                                "target_lang_word": "genießen",
                                "target_lang_sense_clarification": "etwas mit Freude erleben"
