                    {
                        "translation_id": "8e509bfb-8522-4aaf-b5a7-2ed8e529a1dc",
                        "source_entry_id": "a26e2c1c-f36c-3e16-b8ce-bc1aae19a835",
                        "source_sense_id": "e7b13dad-8584-3d89-b6a3-51ffb4bb5e18",
                        "source_sense_description": "vlak en vrij van hindernissen gemaakt",
                        "target_lang_word": "praticable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "praticable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9934c6ad-1ced-39bd-ad76-b73087345ea7",
                                        "entry_id": "99976deb-da0d-3169-97a7-1566c5737d89",
                                        "glosses": [
                                            "Partie, le plus souvent mobile, d’un décor, qui n’est pas seulement figurée, mais aménagée de telle sorte que l’on puisse y aller et venir, monter et descendre comme dans une construction réelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9129064-bd25-466d-be3e-1164b93ccc38",
                                                "sense_id": "9934c6ad-1ced-39bd-ad76-b73087345ea7",
                                                "text": "Cette fois, les praticables s’effondraient en se tordant, les dessous flambaient pour tout de bon."
                                            },
                                            {
                                                "example_id": "abadf622-54c3-42ac-bd27-0f42ca347928",
                                                "sense_id": "9934c6ad-1ced-39bd-ad76-b73087345ea7",
                                                "text": "L’homme au carnet avait quitté sa place et lestement escaladé les marches du praticable qui reliait le plateau à la salle."
                                            },
                                            {
                                                "example_id": "b4164a0c-1261-4986-b5ba-930ad7787f1e",
                                                "sense_id": "9934c6ad-1ced-39bd-ad76-b73087345ea7",
                                                "text": "Et ce fut l'entrée de Manola... Il resta un instant sur le haut du praticable avant de descendre."
                                            },
                                            {
                                                "example_id": "edc29a49-a5ec-48bf-b317-40fc208007eb",
                                                "sense_id": "9934c6ad-1ced-39bd-ad76-b73087345ea7",
                                                "text": "Un praticable d’un mètre de hauteur supportait une table équipée de micros et trois chaises."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78604330-ab14-34fe-87b4-03d0d0dc83e6",
                                        "entry_id": "99976deb-da0d-3169-97a7-1566c5737d89",
                                        "glosses": [
                                            "Zone délimitée au sol sur laquelle les gymnastes réalisent un enchaînement acrobatique en gymnastique artistique ou rythmique."
                                        ],
                                        "tags": [
                                            "Gymnastique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ea2fdce-fa76-467d-bfd2-19f75508048b",
                                                "sense_id": "78604330-ab14-34fe-87b4-03d0d0dc83e6",
                                                "text": "En principe, le praticable sur lequel nous faisions notre mouvement au sol était constitué de ressorts, au dessus desquels il y avait un plancher et le tout était recouvert de tapis moelleux et d’une moquette."
                                            },
                                            {
                                                "example_id": "e635ed86-78c0-4a67-8915-c5f65df6122d",
                                                "sense_id": "78604330-ab14-34fe-87b4-03d0d0dc83e6",
                                                "text": "Ils espèrent imiter Simone Biles, la reine de la gym, qui a vite retrouvé un niveau époustouflant, malgré deux ans loin des praticables."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "praticable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eb8d9db2-8f3e-32c1-b1be-9c698360043b",
                                        "entry_id": "8c30cc89-b53c-3049-89f8-eaa640d8c143",
                                        "glosses": [
                                            "Qui peut être pratiqué, qui peut être employé, dont on peut se servir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8a49d41-ab50-44ba-aff6-79097eed83e8",
                                                "sense_id": "eb8d9db2-8f3e-32c1-b1be-9c698360043b",
                                                "text": "Il a employé tous les moyens praticables pour venir à bout de cette affaire. Si la chose est praticable, on s’en occupera."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c33b5db-18c5-3138-856a-1ac16f1c8166",
                                        "entry_id": "8c30cc89-b53c-3049-89f8-eaa640d8c143",
                                        "glosses": [
                                            "Par lequel on peut passer aisément."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd5cc897-910c-4a70-aff5-5a1157481bc2",
                                                "sense_id": "0c33b5db-18c5-3138-856a-1ac16f1c8166",
                                                "text": "Le sentier du bois conduit à un marais, et, de là, à un gué qui peut être praticable, les pluies ayant cessé."
                                            },
                                            {
                                                "example_id": "fe689746-c021-4235-bbf5-ab3af20b2b29",
                                                "sense_id": "0c33b5db-18c5-3138-856a-1ac16f1c8166",
                                                "text": "Les cours d’eau étaient peu nombreux et facilement praticables."
                                            },
                                            {
                                                "example_id": "2f16256f-e56b-4dd8-a6a1-1d2aea245c9a",
                                                "sense_id": "0c33b5db-18c5-3138-856a-1ac16f1c8166",
                                                "text": "Quant aux routes du Simplon et du Saint-Gothard, […], il ne faudrait que quelques heures pour les détruire ; car on a déjà assez de peine à les maintenir praticables dans la belle saison."
                                            },
                                            {
                                                "example_id": "1d0741e9-5edb-4eac-a3b3-1e476216001e",
                                                "sense_id": "0c33b5db-18c5-3138-856a-1ac16f1c8166",
                                                "text": "Elles ont aplani pour le passage de l’armée fortunée les parties mauvaises de leurs chemins qu’elles ont rendus praticables."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9cf345e-7791-3bc6-afd3-cd817b2c3192",
                                        "entry_id": "8c30cc89-b53c-3049-89f8-eaa640d8c143",
                                        "glosses": [
                                            "Qualifie une porte ou fenêtre du décor, qui n’est pas seulement figurée, et que l’on peut ouvrir ou fermer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "573904f3-356c-4445-9c2c-9c288b411965",
                                                "sense_id": "e9cf345e-7791-3bc6-afd3-cd817b2c3192",
                                                "text": "Porte, fenêtre praticable."
                                            },
                                            {
                                                "example_id": "71f22960-fbe1-4c76-a0ff-653f16ee9522",
                                                "sense_id": "e9cf345e-7791-3bc6-afd3-cd817b2c3192",
                                                "text": "La scène représente le cabinet d’un commissaire de police. À droite, une fenêtre praticable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6eb1ca8f-f283-38a9-b7d5-425abb333052",
                                        "entry_id": "8c30cc89-b53c-3049-89f8-eaa640d8c143",
                                        "glosses": [
                                            "Qualifie une personne avec laquelle il est facile et agréable d’entretenir des relations."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6dfef62a-f480-4481-a542-4dffcfea2c9b",
                                                "sense_id": "6eb1ca8f-f283-38a9-b7d5-425abb333052",
                                                "text": "Cet homme n’est pas praticable dans le commerce de la vie. — Son humeur quelquefois n’est pas praticable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
