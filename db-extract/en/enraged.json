                        ],
                        "examples": [
                            {
                                "example_id": "f87c64e8-73fe-43bd-aa6b-6dbc02c4d1ca",
                                "sense_id": "39126e2c-1eb4-3180-b761-d9b9a5b299bb",
                                "text": "Of thirty bare yeares haue I\ntwice twenty bin enraged,\n& of forty bin three tymes fifteene\nin durance soundlie caged,\nOn yͤ lordlie loftes of Bedlam\nwith stubble softe & dainty,\nbraue braceletts Strong, sweet whips ding dong\nwith wholesome hunger plenty"
                            }
                        ]
