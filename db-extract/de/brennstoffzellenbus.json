                ],
                "senses": [
                    {
                        "sense_id": "fe45eaef-f0fa-3df7-bf35-75ebdf169317",
                        "entry_id": "acc79a14-9a56-3cdf-9349-e369328595e2",
                        "glosses": [
                            "elektrisch angetriebener Autobus, bei dem die für den Antrieb benötigte elektrische Energie mit Hilfe einer Brennstoffzelle aus Wasserstoff erzeugt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39c2af83-0ca4-418b-8c90-68b7d7143ebe",
                                "sense_id": "fe45eaef-f0fa-3df7-bf35-75ebdf169317",
                                "text": "„Wasserstoff ist schneller getankt als Akkus geladen, und mit den 600 Liter fassenden Tanks, wie sie der Brennstoffzellenbus Toyota Sora nutzt, schafft man auch akzeptable Reichweiten.“"
                            },
                            {
                                "example_id": "311942a5-8b71-489f-a5cc-e3b2588f833e",
                                "sense_id": "fe45eaef-f0fa-3df7-bf35-75ebdf169317",
                                "text": "„Der Wiesbadener Brennstoffzellenbus soll nach einer Testphase und Schulungszeit für die Fahrer auf Linien mit einer eher längeren Strecke eingesetzt werden.“"
                            },
                            {
                                "example_id": "cdd324d2-a7af-414f-8571-0bfaed056447",
                                "sense_id": "fe45eaef-f0fa-3df7-bf35-75ebdf169317",
                                "text": "„Noch fehlt im Kreis Groß-Gerau eine passende Wasserstofftankstelle. Und auch die für die beabsichtigte Flottenumrüstung benötigten Brennstoffzellenbusse existieren bis dato nur auf dem Papier.“"
                            },
                            {
                                "example_id": "3499983f-35ab-48ff-8f08-4c951e773b7d",
                                "sense_id": "fe45eaef-f0fa-3df7-bf35-75ebdf169317",
                                "text": "„Japans Regierung hilft auch kräftig bei einem weiteren Toyota-Projekt namens SORA. Die Buchstaben stehen für Sky, Ocean, River und Air (Himmel, Ozean, Fluss und Luft). Sie kleben an einem Brennstoffzellenbus, dessen Produktion im nächsten Jahr beginnen soll.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
