                    {
                        "sense_id": "accfdd86-627c-3480-8938-62283d7c0617",
                        "entry_id": "2869f3ad-69a1-3b22-a260-a5a3a69ffd3c",
                        "glosses": [
                            "in jeweils stumpfen Winkeln zu den angrenzenden zueinander rechtwinkeligen Flächen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c417156-977c-4ac6-8cca-e85884a62ac6",
                                "sense_id": "accfdd86-627c-3480-8938-62283d7c0617",
                                "text": "„Markantes Kennzeichen des Gebäudes sind die auf vier Etagen übereck gezogenen arrondierten Balkone, die von einer vollständig geschlossenen Balustrade begrenzt werden und an die Formensprache des Bauhaus erinnern.“"
                            },
                            {
                                "example_id": "e3a36a36-82e7-4c1a-a1f4-c0c229c9c6f8",
                                "sense_id": "accfdd86-627c-3480-8938-62283d7c0617",
                                "text": "„Nicht allein deshalb, weil auf dem Bild anscheinend jegliches Motiv fehlte, auch die Platzierung provozierte: Es hing übereck unter der Decke, an jener Stelle, an der in russischen Zimmern normalerweise Ikonen hingen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
