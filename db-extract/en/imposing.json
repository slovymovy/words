                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "imposant",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c90acf9a-8f92-32ea-aa6b-1043618eff4a",
                                        "entry_id": "f7d84dd4-c722-3eca-95a9-c4b2e22bdabf",
                                        "glosses": [
                                            "durch seine Abmessungen einen starken Eindruck, Respekt oder Bewunderung bei jemandem hinterlassend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b55d9f5-afc8-4139-883c-32e564ab4654",
                                                "sense_id": "c90acf9a-8f92-32ea-aa6b-1043618eff4a",
                                                "text": "„Die Pyramiden von Gizeh sind so imposant, einfach unglaublich, wie haben die Ägypter die damals nur gebaut?“"
                                            },
                                            {
                                                "example_id": "92eed728-2206-49f3-9032-41f88dd696fb",
                                                "sense_id": "c90acf9a-8f92-32ea-aa6b-1043618eff4a",
                                                "text": "„Ich habe noch nie einen derart imposanten Ringer gesehen, 2,10 Meter groß, 130 kg schwer und dabei scheinbar nur aus Muskeln bestehend.“"
                                            },
                                            {
                                                "example_id": "1fdde23f-278e-42bc-8d77-8cda1f7026b1",
                                                "sense_id": "c90acf9a-8f92-32ea-aa6b-1043618eff4a",
                                                "text": "Das Bauwerk [die Kathedrale Saint-Nicolas] erhebt sich imposant neben dem Boulevard du Tsarévitch, benannt nach dem Thronfolger Nicolaj Alexandrowitsch, der in Nizza starb und in einer Kapelle hinter der Kathedrale begraben liegt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c4c82887-a00a-4405-8417-7cf8ef1be9fe",
