                                        "entry_id": "bb0ed2bf-3143-39ff-8697-26903fdde220",
                                        "glosses": [
                                            "osoba, která se zabývá ovlivňováním veřejně činných osob, aby rozhodovaly ve prospěch konkrétní zájmové skupiny namísto veřejného zájmu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
