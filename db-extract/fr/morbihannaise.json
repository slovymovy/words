                        "glosses": [
                            "Habitante du Morbihan, département français situé en Bretagne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea2e77ba-d8a1-4fb0-b88d-a00a20f88980",
                                "sense_id": "60a24674-ce25-3269-9a24-27d54d32828b",
                                "text": "Dernière rescapée des quatorze fugueuses dont faisait partie la Costarmoricaine Audrey Cordon Ragot, la Morbihannaise Marie Le Net a été reprise dans la descente vers Rosheim à 4 km de l'arrivée."
                            },
                            {
                                "example_id": "9018af0c-7ad1-4326-ba3d-b7c32783e30f",
                                "sense_id": "60a24674-ce25-3269-9a24-27d54d32828b",
                                "text": "Après avoir disputé le Tour de France, la Morbihannaise va couper un peu avant de renouer avec la compétition le 14 août lors de la Picto-Charentaise."
                            }
                        ]
                    }
