            {
                "entry_id": "dbbd6b39-b4ff-312d-b033-df98704b0bac",
                "word": "côlon",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b242b2b5-f121-4336-878b-5cbccad71b6a",
                        "entry_id": "dbbd6b39-b4ff-312d-b033-df98704b0bac",
                        "tags": [
