{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "366b0de9-74a5-3b28-9f4f-8456ce33672d",
                    "sense_definition": "A fawning, servile follower.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "servant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The corrupt politician was surrounded by a group of <w>lackeys</w> who agreed with everything he said.",
                            "target_lang_translations": {
                                "ru": "Коррумпированный политик был окружен группой <w>холуёв</w>, которые соглашались со всем, что он говорил."
                            }
                        },
                        {
                            "text": "He refused to act as a <w>lackey</w> for the company director just to get a promotion.",
                            "target_lang_translations": {
                                "ru": "Он отказался <w>прислуживать</w> директору компании только ради повышения."
                            }
                        }
                    ],
                    "synonyms": [
                        "bootlicker",
                        "flunkey",
                        "minion",
                        "stooge",
                        "sycophant",
                        "toady",
                        "yes man"
                    ],
                    "target_lang_definitions": {
                        "ru": "Угодливый, подобострастный последователь или прислужник."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "холу́й",
                                "target_lang_sense_clarification": "презрительное обозначение человека, готового на всё ради выгоды"
                            },
                            {
                                "target_lang_word": "лаке́й",
                                "target_lang_sense_clarification": "переносное значение: человек, прислуживающий кому-либо из корыстных побуждений"
                            },
                            {
                                "target_lang_word": "при́хвостень",
                                "target_lang_sense_clarification": "бранное слово для обозначения угодливого помощника"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "57030b33-863e-3965-8bea-fd6282539c21",
                    "sense_definition": "A footman or liveried male servant.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "servant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wealthy aristocrat arrived at the ball accompanied by his personal <w>lackey</w>.",
                            "target_lang_translations": {
                                "ru": "Богатый аристократ прибыл на бал в сопровождении своего личного <w>лакея</w>."
                            }
                        },
                        {
                            "text": "In the nineteenth century, every noble household employed a <w>lackey</w> to open the carriage door.",
                            "target_lang_translations": {
                                "ru": "В девятнадцатом веке в каждом дворянском доме был <w>лакей</w>, который открывал дверцу кареты."
                            }
                        }
                    ],
                    "synonyms": [
                        "footman",
                        "servant"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Refers to a historical role of a liveried servant."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Слуга в ливрее, сопровождающий господина."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лаке́й",
                                "target_lang_sense_clarification": "историческое название слуги в богатом доме"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d9571f38-43df-3159-b04a-147f52a10f46",
                    "sense_definition": "To act in a servile or fawning manner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "servant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He would <w>lackey</w> to his superiors in hopes of gaining their favor.",
                            "target_lang_translations": {
                                "ru": "Он <w>пресмыкался</w> перед начальством в надежде заслужить их расположение."
                            }
                        },
                        {
                            "text": "It is beneath his dignity to <w>lackey</w> for someone he does not respect.",
                            "target_lang_translations": {
                                "ru": "Ниже его достоинства <w>заискивать</w> перед тем, кого он не уважает."
                            }
                        }
                    ],
                    "synonyms": [
                        "toady"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вести себя подобострастно или угодливо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пресмыка́ться",
                                "target_lang_sense_clarification": "унижаться перед кем-либо"
                            },
                            {
                                "target_lang_word": "заи́скивать",
                                "target_lang_sense_clarification": "стараться заслужить чье-то расположение лестью"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "668ec693-8397-3e2d-85f6-cd5ec8f42b9a",
                    "sense_definition": "To attend or wait upon someone obsequiously.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "servant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The attendants were seen <w>lackeying</w> the queen as she walked through the palace halls.",
                            "target_lang_translations": {
                                "ru": "Видели, как слуги <w>прислуживали</w> королеве, когда она шла по дворцовым залам."
                            }
                        },
                        {
                            "text": "He spent his entire career <w>lackeying</w> the wealthy elite of the city.",
                            "target_lang_translations": {
                                "ru": "Он провел всю свою карьеру, <w>прислуживая</w> богатой элите города."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in older literary contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Услужливо прислуживать кому-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прислуживать",
                                "target_lang_sense_clarification": "выполнять чьи-либо поручения в подобострастной манере"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "90441cc4-8d1a-3407-a3b7-73ffbb0c319a",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The historian discovered a document signed by a man named <w>Lackey</w>.",
                            "target_lang_translations": {
                                "ru": "Историк обнаружил документ, подписанный человеком по фамилии <w>Лэки</w>."
                            }
                        },
                        {
                            "text": "Professor <w>Lackey</w> will be giving a lecture on linguistics this afternoon.",
                            "target_lang_translations": {
                                "ru": "Профессор <w>Лэки</w> сегодня днем прочтет лекцию по лингвистике."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Лэ́ки",
                                "target_lang_sense_clarification": "транслитерация фамилии"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}