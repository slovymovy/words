                                                "example_id": "472fd5ec-9747-48df-a992-7ae65390ce4d",
                                                "sense_id": "dc320370-7aa2-3731-8319-2c976e413eef",
                                                "text": "Maffio. – Ah ! massacre ! ah ! fer et sang ! j’obtiendrai justice de vous !"
                                            }
                                        ]
                                    }
                                ]
                            },
