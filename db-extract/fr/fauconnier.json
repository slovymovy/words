                                        "sense_id": "f825e034-7d7e-398c-962b-8c9fe309eb6c",
                                        "entry_id": "e6a02acb-30bc-3fee-a48a-acff01ff27df",
                                        "glosses": [
                                            "A peddler, a huckster, a person who sells easily transportable goods."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31e99dd1-f0aa-4ba2-bb83-33ebcb46eaa0",
                                                "sense_id": "f825e034-7d7e-398c-962b-8c9fe309eb6c",
                                                "text": "The other [witness] was one Sim Doolittle, the fish hawker from Allerfoot, jogging home in his fish cart from Gledsmuir fair."
                                            },
                                            {
                                                "example_id": "c05029be-891b-4bfc-b8ac-eea77a2d1ebc",
                                                "sense_id": "f825e034-7d7e-398c-962b-8c9fe309eb6c",
                                                "text": "First-generation hawkers were mostly immigrants from China, and to a smaller extent from India and the Malay Archipelago. A 1950 Hawkers Inquiry Commission report stated that 84 per cent of the hawkers in Singapore were Chinese."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "adeb84b3-9a6d-3514-8e35-9cf34dc64a55",
                                        "entry_id": "e6a02acb-30bc-3fee-a48a-acff01ff27df",
                                        "glosses": [
                                            "Any dragonfly of the family Aeshnidae; a darner."
