                        "entry_id": "953c777b-5f08-3038-ab8f-6d0d880040bb",
                        "glosses": [
                            "A body position, typically associated with the practice of yoga."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "087c28ba-7127-4e2f-b064-c780ec6dd241",
                                "sense_id": "b80bf4c9-8a4e-3728-92c6-72509f56a991",
                                "text": "She had taught him several yoga asanas and now every morning he obediently performed them while he thought of her sitting somewhere out among the olives beyond the tower in the lotus pose which seemed to cost her no effort at all, intoning the Aum […]"
                            }
                        ]
                    },
