                "senses": [
                    {
                        "sense_id": "59a9ae8e-9bda-318c-9b7d-a2363b896d5e",
                        "entry_id": "2465aeb1-6a61-3533-a957-f7ed3902ad16",
                        "glosses": [
                            "jemand, der nach der ersten Hälfte eines Wettbewerbs an der ersten Stelle liegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8727d6fb-a74e-4778-bc03-7ea17b2e4a59",
                                "sense_id": "59a9ae8e-9bda-318c-9b7d-a2363b896d5e",
                                "text": "„Marcel Hirscher fädelte als Halbzeitführender im Nachtslalom in Madonna ein.“"
                            },
                            {
                                "example_id": "21ccfbfb-ed8e-4345-91af-8f2bec9ba728",
                                "sense_id": "59a9ae8e-9bda-318c-9b7d-a2363b896d5e",
                                "text": "„Es war der insgesamt sechste Sieg für Hirscher auf dem Chuenisbärgli (jeweils drei im RTL und Slalom), und er war ein hartes Stück Arbeit. 0,11 Sekunden Vorsprung hatte der Salzburger als Halbzeitführender auf seinen ersten Verfolger Kristoffersen.“"
                            },
                            {
                                "example_id": "56201530-cd47-4071-b3c4-b27640a6ba30",
                                "sense_id": "59a9ae8e-9bda-318c-9b7d-a2363b896d5e",
                                "text": "„Bereits zweimal reiste Schlierenzauer als Halbzeitführender nach Innsbruck, verspielte den Sieg aber noch.“"
                            },
                            {
                                "example_id": "1ed33b48-ccc3-4678-9c21-b3241246887c",
                                "sense_id": "59a9ae8e-9bda-318c-9b7d-a2363b896d5e",
                                "text": "„0,11 Sekunden Vorsprung hatte der Salzburger als Halbzeitführender auf seinen ersten Verfolger Kristoffersen.“"
                            },
                            {
                                "example_id": "df106a9c-a9e1-4f68-9d78-3fe76e725bd5",
                                "sense_id": "59a9ae8e-9bda-318c-9b7d-a2363b896d5e",
                                "text": "„Nun geht Diethart am Freitag (14 Uhr, Liveticker SPIEGEL ONLINE) als Halbzeitführender in die Qualifikation für das Springen in Innsbruck, er hat 11,5 Punkte Vorsprung auf seinen Verfolger Thomas Morgenstern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
