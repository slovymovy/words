                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "31f65c9a-76c0-39b0-b966-9c25b94d12cf",
                                        "entry_id": "62461868-6281-3dc3-837f-f43a303d75e9",
                                        "glosses": [
                                            "Purification."
