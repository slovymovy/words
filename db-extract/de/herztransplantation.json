                "senses": [
                    {
                        "sense_id": "c469bd64-9831-3efd-82ff-d1e337262bd9",
                        "entry_id": "a0cb9d78-ce58-3d2e-b525-8eac4a7e65d4",
                        "glosses": [
                            "Einpflanzung eines Spenderherzens in den Körper eines lebenden Menschen, bei gleichzeitiger Entfernung seines erkrankten Herzens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35720d9c-654c-4c67-a0e6-06aaece6b38c",
                                "sense_id": "c469bd64-9831-3efd-82ff-d1e337262bd9",
                                "text": "„Die erste Herztransplantation fand in der Nacht von Samstag auf Sonntag statt, vom 2. auf den 3. Dezember 1967.“"
                            },
                            {
                                "example_id": "196cba87-21c2-4e91-8d6d-e556accaf7d8",
                                "sense_id": "c469bd64-9831-3efd-82ff-d1e337262bd9",
                                "text": "„Der Gewinner des Eurovision Song Contest, der portugiesische Sänger Salvador Sobral, soll Berichten zufolge nach seiner Herztransplantation auf der Intensivstation liegen.“"
                            },
                            {
                                "example_id": "e821e8d5-843a-4ce7-9109-8a000c3faa9e",
                                "sense_id": "c469bd64-9831-3efd-82ff-d1e337262bd9",
                                "text": "„Zwei Jahre nach der sensationellen ersten Herztransplantation von Dr. Barnard, war diese Operation nun auch in Deutschland gelungen.“"
                            },
                            {
                                "example_id": "236b9d9b-e357-49ea-afb0-a02fc6f457d2",
                                "sense_id": "c469bd64-9831-3efd-82ff-d1e337262bd9",
                                "text": "„Schon als Kind war ich von Herztransplantationen fasziniert gewesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
