                    {
                        "form_id": "d43a8bff-4ffb-4d07-b722-11480d778433",
                        "entry_id": "7015441a-9ea0-304f-bfa4-69c4dbc5a5b3",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "че́шках"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "61c0ce9b-4ed0-341c-b233-15e3384e5f94",
                        "entry_id": "7015441a-9ea0-304f-bfa4-69c4dbc5a5b3",
                        "glosses": [
                            "женск. к чех: гражданка, жительница или уроженка Чехии"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c0bb82f-7f1a-4982-94df-b15841405d72",
                                "sense_id": "61c0ce9b-4ed0-341c-b233-15e3384e5f94",
                                "text": "Одно жаль, она чешка, плохо говорит по-русски, и я боюсь, что Даша будет говорить с акцентом."
                            },
                            {
                                "example_id": "ad634e73-4df6-4ab5-8ee9-0b3a1f961fc7",
                                "sense_id": "61c0ce9b-4ed0-341c-b233-15e3384e5f94",
                                "text": "Она ― родом чешка, крепкого заграничного качества и до сих пор моложава и деятельна с проблесками прежней миловидности немецкого типа…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4a24d024-87f0-4118-88a4-6752ed349599",
                        "source_entry_id": "7015441a-9ea0-304f-bfa4-69c4dbc5a5b3",
                        "source_sense_id": "61c0ce9b-4ed0-341c-b233-15e3384e5f94",
                        "target_lang_word": "Czech woman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "7a8a0c67-1d98-429b-aa17-4104272cd09c",
                        "source_entry_id": "7015441a-9ea0-304f-bfa4-69c4dbc5a5b3",
                        "source_sense_id": "61c0ce9b-4ed0-341c-b233-15e3384e5f94",
                        "target_lang_word": "Tschechin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tschechin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3a653003-9b24-39a6-a110-53114f2205f8",
                                        "entry_id": "b65a7bd9-07be-387f-ae0a-207d93df773d",
                                        "glosses": [
                                            "Bürgerin von Tschechien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4de57f4c-770b-4874-a55b-a8e046ade6e7",
                                                "sense_id": "3a653003-9b24-39a6-a110-53114f2205f8",
                                                "text": "„Ein paar ärmlich aufgeputzte Tschechinnen an der Bar konnte man für etwas Geld mit aufs Zimmer nehmen.“"
                                            },
                                            {
                                                "example_id": "11b89f60-97f2-4f5f-b8ec-f9948874086c",
                                                "sense_id": "3a653003-9b24-39a6-a110-53114f2205f8",
                                                "text": "Der Tscheche hat den Hut verloren und die Tschechin hat's gemerkt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6b4da412-a2c9-40c1-bc3f-24853ccf1117",
                        "source_entry_id": "7015441a-9ea0-304f-bfa4-69c4dbc5a5b3",
                        "source_sense_id": "61c0ce9b-4ed0-341c-b233-15e3384e5f94",
                        "target_lang_word": "Tchèque",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tchèque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "227afb10-6191-35b9-a4c0-fc603c5d0f3f",
                                        "entry_id": "7287bb30-9cb1-3c28-8879-b793cbcc77bc",
                                        "glosses": [
                                            "Habitant ou originaire de la République tchèque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "452974ab-d7e7-46c8-b648-15c49ed7a275",
                                                "sense_id": "227afb10-6191-35b9-a4c0-fc603c5d0f3f",
                                                "text": "Les possibles repreneurs, le Tchèque Daniel Kretinsky, le Français Marc Ladreit de Lacharrière et le fonds britannique Attestor, assurent vouloir axer leur stratégie sur le commerce de proximité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22932041-2ac5-37ee-8301-416b533bdca0",
                                        "entry_id": "7287bb30-9cb1-3c28-8879-b793cbcc77bc",
                                        "glosses": [
                                            "Habitant de la Bohême."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d3a90c9-bdda-46b6-a302-2352cc6c38df",
                                                "sense_id": "22932041-2ac5-37ee-8301-416b533bdca0",
                                                "text": "La crainte de voir se rapprocher un jour les Slovaques et les Tchèques a toujours hanté les Magyars; à l’exemple des Allemands, ils ne dédaignent pas de faire appel à la science […]."
                                            },
                                            {
                                                "example_id": "cbb23698-45ce-4feb-9c6f-b3d14f0a40ce",
                                                "sense_id": "22932041-2ac5-37ee-8301-416b533bdca0",
                                                "text": "Les habitants de la Moravie se définissent comme Moraves et non comme Tchèques. La loi reconnaît la citoyenneté (par définition tchèque) et la nationalité tchèque, mais pas morave qui est considérée comme une composante de la nation tchèque par le législateur en particulier et les ethnolinguistes en général."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
