                    },
                    {
                        "translation_id": "979f9147-8949-4b54-8fd5-fa7d4ec15c7f",
                        "source_entry_id": "4506e3d2-99fe-31f5-9cd2-0ae2aafdede3",
                        "source_sense_description": "не видя, не глядя",
                        "target_lang_word": "sans rien voir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "be144cff-3064-439e-acbe-f58dcca11878",
                        "source_entry_id": "4506e3d2-99fe-31f5-9cd2-0ae2aafdede3",
                        "source_sense_description": "наугад",
                        "target_lang_word": "au hasard",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "au hasard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1853cbad-2cf4-3d29-9749-0c154851363c",
                                        "entry_id": "a5752be6-fdc9-34de-914a-af9aad6222eb",
                                        "glosses": [
                                            "À l’aventure, inconsidérément, ou en faisant confiance au hasard."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7148b69d-7408-4c7c-968d-5ecc50876713",
                                                "sense_id": "1853cbad-2cf4-3d29-9749-0c154851363c",
                                                "text": "Henri posa son porte-plume sur la table et ses regards errèrent au hasard."
                                            },
                                            {
                                                "example_id": "0bbe132b-cb37-41d7-bb9b-214bd639cead",
                                                "sense_id": "1853cbad-2cf4-3d29-9749-0c154851363c",
                                                "text": "– Le hasard ne fait rien au hasard, ajouta Robert. J’ai entendu cela un jour dans un film et cette phrase ne m’a pas quitté. Je devais en couver l’idée. Cet inconnu qui parlait l’a mise au monde. Finalement le hasard et le moins trompeur des dieux.."
                                            },
                                            {
                                                "example_id": "8f3686b3-407f-4afa-9b01-6437dc7fc7ec",
                                                "sense_id": "1853cbad-2cf4-3d29-9749-0c154851363c",
                                                "text": "Ne connaissant pas la route, ils étaient obligés d’aller, de marcher au hasard."
                                            },
                                            {
                                                "example_id": "c6b647c6-8928-47c5-baff-cad45202dece",
                                                "sense_id": "1853cbad-2cf4-3d29-9749-0c154851363c",
                                                "text": "Il ne sait pas jouer, il jette ses cartes au hasard."
                                            },
                                            {
                                                "example_id": "c2a34541-474b-46a8-ade1-442fedb48443",
                                                "sense_id": "1853cbad-2cf4-3d29-9749-0c154851363c",
                                                "text": "Répondre au hasard."
                                            },
                                            {
                                                "example_id": "5824e4c2-4e45-4a2a-ab5c-9bca6a4c158e",
                                                "sense_id": "1853cbad-2cf4-3d29-9749-0c154851363c",
                                                "text": "C’est un écervelé qui parle toujours au hasard."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bc65da0f-9811-44c6-84dc-0d332aee1ab6",
                        "source_entry_id": "4506e3d2-99fe-31f5-9cd2-0ae2aafdede3",
                        "source_sense_description": "наугад",
                        "target_lang_word": "au petit bonheur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "au petit bonheur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "74667745-4a8e-3526-a3dd-af52a7b57881",
                                        "entry_id": "571a8d15-8719-3d9d-a068-255a02cf3444",
                                        "glosses": [
                                            "En faisant confiance au hasard, au sort, sans préparation ni réflexion préalable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c8b52cc-50b1-49d8-bd96-23b3433d5ec6",
                                                "sense_id": "74667745-4a8e-3526-a3dd-af52a7b57881",
                                                "text": "La fille à tout le monde a bon cœur,\nElle me donne, au petit bonheur,\nLes petits bouts de sa peau, bien cachés,\nQue les autres n’ont pas touchés."
                                            },
                                            {
                                                "example_id": "94a924ce-8bd0-4a86-b993-de9878626e15",
                                                "sense_id": "74667745-4a8e-3526-a3dd-af52a7b57881",
                                                "text": "Sur le palier qui empestait la poudre et les gravats, les bastos avaient ricoché au petit bonheur."
                                            },
                                            {
                                                "example_id": "bf19c034-2b7a-4b45-bd4b-28bc3396935f",
                                                "sense_id": "74667745-4a8e-3526-a3dd-af52a7b57881",
                                                "text": "Ces hommes-là se comportaient comme des individus chargés d’une électricité mystérieuse, extérieure, et qui la dépensaient au petit bonheur, ou plus exactement au petit malheur."
                                            },
                                            {
                                                "example_id": "2c285e8f-f4b7-4b75-a6ee-0a0ba44943f7",
                                                "sense_id": "74667745-4a8e-3526-a3dd-af52a7b57881",
                                                "text": "Au départ, vous aviez cinq voix, Coignet cinq, et les autres suffrages se répartissaient au petit bonheur sur vos concurrents."
                                            },
                                            {
                                                "example_id": "78c61f77-1716-4e71-ac90-d91844532172",
                                                "sense_id": "74667745-4a8e-3526-a3dd-af52a7b57881",
                                                "text": "Car la réalité est un piètre conteur. Elle entame ses récits au petit bonheur, en général bien avant le début de l’action, marche à l’aventure et décroche avant d’avoir dénoué les fils de l’intrigue…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d106b3c9-adcc-4200-98ea-d4ebc205a6cf",
                        "source_entry_id": "4506e3d2-99fe-31f5-9cd2-0ae2aafdede3",
                        "source_sense_description": "наугад",
                        "target_lang_word": "aveuglément",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aveuglément",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "54dcaabb-6c7f-39eb-9fa4-2c53ecd8dc15",
                                        "entry_id": "06748e19-7c90-310c-9cda-e91cfc90ab33",
                                        "glosses": [
                                            "En aveugle, sans réflexion ni examen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6685280-aa02-44a4-982a-5db00ea7e68e",
                                                "sense_id": "54dcaabb-6c7f-39eb-9fa4-2c53ecd8dc15",
                                                "text": "Ô juges malheureux, qui dans nos faibles mains Tenons aveuglément le glaive et la balance."
                                            },
                                            {
                                                "example_id": "f36325df-e42a-4ddd-a6fc-e2b78f28df21",
                                                "sense_id": "54dcaabb-6c7f-39eb-9fa4-2c53ecd8dc15",
                                                "text": "Il aime aveuglément sa patrie et son père."
                                            },
                                            {
                                                "example_id": "fc785f86-4266-4d17-9556-d647b14700a5",
                                                "sense_id": "54dcaabb-6c7f-39eb-9fa4-2c53ecd8dc15",
                                                "text": "Car, puisque la fortune aveuglément dispose De tout…"
                                            },
                                            {
                                                "example_id": "d355f511-21f7-43c4-87fa-9e4dac3cde52",
                                                "sense_id": "54dcaabb-6c7f-39eb-9fa4-2c53ecd8dc15",
                                                "text": "Puis tous s’étaient engagés à paraître ne rien savoir vis-à-vis de leur chef et à lui obéir aveuglément comme par le passé."
                                            },
                                            {
                                                "example_id": "e8d84a90-0d8d-4191-bf5b-bfef41c187cc",
                                                "sense_id": "54dcaabb-6c7f-39eb-9fa4-2c53ecd8dc15",
                                                "text": "Heureusement tous les cossons n’étaient pas partis. Il y a des cépages peu hâtifs qui prudemment n’ont pas « débourré » — et, chose remarquable, ce ne sont pas ceux dits « du pays » qu'on s'obstine, aveuglément, à recommander."
                                            },
                                            {
                                                "example_id": "0368a924-9ad3-40ee-a164-f34d3a7b9525",
                                                "sense_id": "54dcaabb-6c7f-39eb-9fa4-2c53ecd8dc15",
                                                "text": "Dans une démocratie, aucun homme sensé ne veut renoncer à son droit à exercer son jugement personnel ; sachant son chef de même nature que lui, il ne peut lui faire aveuglément confiance ; par conséquent, il veut diriger lui-même."
                                            },
                                            {
                                                "example_id": "481febde-9155-4089-aacd-72213d70a7f7",
                                                "sense_id": "54dcaabb-6c7f-39eb-9fa4-2c53ecd8dc15",
                                                "text": "N’accusons pas aveuglément le naturel des habitants de l’île la plus célèbre du monde."
                                            },
                                            {
                                                "example_id": "f7f1d15b-1257-49c9-8356-afedb7f65671",
                                                "sense_id": "54dcaabb-6c7f-39eb-9fa4-2c53ecd8dc15",
                                                "text": "L’âme, de son dessein jusque-là possédée, s’attache aveuglément à sa première idée."
                                            },
                                            {
                                                "example_id": "ea4c2a9f-cbbd-4a73-a6b0-d7fc5365246b",
                                                "sense_id": "54dcaabb-6c7f-39eb-9fa4-2c53ecd8dc15",
                                                "text": "Suivons aveuglément ma triste destinée."
                                            },
                                            {
                                                "example_id": "363a9238-3a3f-4719-be44-5fca3939988a",
                                                "sense_id": "54dcaabb-6c7f-39eb-9fa4-2c53ecd8dc15",
                                                "text": "J’accepte aveuglément cette gloire avec joie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
