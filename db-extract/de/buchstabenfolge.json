                "senses": [
                    {
                        "sense_id": "e506b87f-ffc7-3fff-b5a2-2d5a3b85080e",
                        "entry_id": "78668187-ae7e-30c1-b1b0-37769b583d94",
                        "glosses": [
                            "Aufeinanderfolge von Buchstaben in einer beliebigen schriftsprachlichen Einheit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "178be8c1-5fae-43dd-b0ab-4592fb098edf",
                                "sense_id": "e506b87f-ffc7-3fff-b5a2-2d5a3b85080e",
                                "text": "Nicht jede theoretisch vorstellbare Buchstabenfolge kommt auch tatsächlich vor."
                            },
                            {
                                "example_id": "8120970e-e175-4fad-ac0a-c0a19ee4ec7e",
                                "sense_id": "e506b87f-ffc7-3fff-b5a2-2d5a3b85080e",
                                "text": "„Die ersten zehn Buchstabenfolgen im Deutschen (einschl. ihrer Umkehrung) bilden mithin bereits ein Drittel aller Buchstabenverbindungen überhaupt; die ersten 20 machen fast die Hälfte, die ersten 40 genau Zweidrittel aus.“"
                            },
                            {
                                "example_id": "a26ea5ad-2663-464b-8c98-e097127cf27f",
                                "sense_id": "e506b87f-ffc7-3fff-b5a2-2d5a3b85080e",
                                "text": "„Denn wie man es in diesem Zeitalter liebte, in Anagrammen zu rätseln, so sah man in der Orthographie weit mehr als eine zweckmäßige Konvention, glaubte man doch, in der Buchstabenfolge die Signaturen der Dinge erkennen zu können.“"
                            },
                            {
                                "example_id": "bda19cc4-283a-44a6-bd61-6022e595f013",
                                "sense_id": "e506b87f-ffc7-3fff-b5a2-2d5a3b85080e",
                                "text": "„Er gehörte in der Schule zu jenen Kindern, die den eigenen Familiennamen lange nicht schreiben konnten und wegen der schwer auszusprechenden Buchstabenfolge von den Mitschülern gehänselt wurde.“"
                            },
                            {
                                "example_id": "ebe2deec-0dba-49da-85d8-7ea9663a2880",
                                "sense_id": "e506b87f-ffc7-3fff-b5a2-2d5a3b85080e",
                                "text": "„Zwar gab es schon Bemühungen einiger Rechtschreibreformer, das q beziehungsweise qu abzuschaffen, da der Lautwert eben auch durch die Buchstabenfolge kw beziehungsweise kv wiedergegeben werden könnte, doch die Tradition ist bei uns (anders als etwa in skandinavischen Ländern, wo nur einige Fremdwörter noch ein qu enthalten) so stabil, dass diese Versuche fehlschlugen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
