                "senses": [
                    {
                        "sense_id": "0860ea43-da5c-36aa-b5ee-82aa345a0d35",
                        "entry_id": "721269a3-7b5b-33eb-ae2e-dc6c3666c441",
                        "glosses": [
                            "ohne Dinge und/oder Personen; leer"
                        ],
                        "tags": [
                            "meist prädikativ"
                        ],
                        "examples": [
                            {
                                "example_id": "2e901251-86de-4a27-9667-2a3abd4e01d8",
                                "sense_id": "0860ea43-da5c-36aa-b5ee-82aa345a0d35",
                                "text": "„We dworze pusto : bo drzwi od ganku zamknięto / Zaszczepkami, i kołkiem zaszczepki przetknięto.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bd620f89-b45d-4d1b-ba71-223145b7393c",
                        "source_entry_id": "721269a3-7b5b-33eb-ae2e-dc6c3666c441",
                        "source_sense_id": "0860ea43-da5c-36aa-b5ee-82aa345a0d35",
                        "source_sense_description": "meist prädikativ: ohne Dinge und/oder Personen; leer",
                        "target_lang_word": "leer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "leer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2fa1c0af-0691-3d6e-8705-205aeb8d43c6",
                                        "entry_id": "599320e9-f111-3faf-8820-abd0c1445951",
                                        "glosses": [
                                            "(fast) ohne (physischen) Inhalt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea1d2a39-e419-4733-ba8a-efbf11c74e62",
                                                "sense_id": "2fa1c0af-0691-3d6e-8705-205aeb8d43c6",
                                                "text": "Die Flasche ist leer."
                                            },
                                            {
                                                "example_id": "dc51fd13-9449-410a-9dc0-4f03533467b4",
                                                "sense_id": "2fa1c0af-0691-3d6e-8705-205aeb8d43c6",
                                                "text": "»Ich trinke nur noch mein Glas leer, dann gehe ich.«"
                                            },
                                            {
                                                "example_id": "3bed726c-b311-494f-928f-2b446ee33d80",
                                                "sense_id": "2fa1c0af-0691-3d6e-8705-205aeb8d43c6",
                                                "text": "»Mein Magen ist leer, ich muss unbedingt etwas essen.«"
                                            },
                                            {
                                                "example_id": "ce8ef427-8edd-4d23-893f-a99956b0ba38",
                                                "sense_id": "2fa1c0af-0691-3d6e-8705-205aeb8d43c6",
                                                "text": "„Die Großen schicken ihre Diener nach Wasser; aber wenn sie zum Brunnen kommen, finden sie kein Wasser und bringen ihre Gefäße leer zurück.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ed7f0ebf-95a9-3227-bd07-e51fc64ed081",
                                        "entry_id": "599320e9-f111-3faf-8820-abd0c1445951",
                                        "glosses": [
                                            "ohne Menschen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "492c780d-6f83-4bcf-a084-cb60b68f57fb",
                                                "sense_id": "ed7f0ebf-95a9-3227-bd07-e51fc64ed081",
                                                "text": "Die Straßen sind heute leer."
                                            },
                                            {
                                                "example_id": "6f1b9cb3-5055-49c6-bd75-72a4c8d3b829",
                                                "sense_id": "ed7f0ebf-95a9-3227-bd07-e51fc64ed081",
                                                "text": "Das Kino ist heute noch leerer als sonst."
                                            },
                                            {
                                                "example_id": "323beb05-81f3-493c-b188-c52db8ba757b",
                                                "sense_id": "ed7f0ebf-95a9-3227-bd07-e51fc64ed081",
                                                "text": "Die Kirchen in Deutschland sind leer, keiner geht mehr zum Gottesdienst, außer zu Weihnachten."
                                            },
                                            {
                                                "example_id": "6b1dcb47-a274-476d-b21b-7d96a5cde89e",
                                                "sense_id": "ed7f0ebf-95a9-3227-bd07-e51fc64ed081",
                                                "text": "[COVID-19-Pandemie:] „In der Hausarztpraxis Dr. von Specht ist es auffällig leer. Eine Patientin ist zur Kontrolle da, ansonsten ist wenig Betrieb.“"
                                            },
                                            {
                                                "example_id": "6c7a2a6c-ace2-4c1c-82c5-6282485f16ed",
                                                "sense_id": "ed7f0ebf-95a9-3227-bd07-e51fc64ed081",
                                                "text": "„In Rhauderfehn im Landkreis Leer ist am Sonntagabend ein leer stehendes Einfamilienhaus abgebrannt.“"
                                            },
                                            {
                                                "example_id": "b43f5e06-424c-4bb4-9698-a07fde56daf0",
                                                "sense_id": "ed7f0ebf-95a9-3227-bd07-e51fc64ed081",
                                                "text": "„Die Ferienorte an Schleswig-Holsteins Küsten sind wie ausgestorben. Gästehäuser und Hotels stehen leer, Restaurants und Läden bleiben geschlossen.“"
                                            },
                                            {
                                                "example_id": "41503ee9-264b-4a05-8530-366fa57d27be",
                                                "sense_id": "ed7f0ebf-95a9-3227-bd07-e51fc64ed081",
                                                "text": "„Die Zahl der Flüchtlinge, die in Bayern ankommen, ist stark gesunken. Und das hat Folgen. In Schwaben stehen viele Erstaufnahmeeinrichtungen leer.“"
                                            },
                                            {
                                                "example_id": "935bad8f-ae95-4577-9e7c-78aae0da6f31",
                                                "sense_id": "ed7f0ebf-95a9-3227-bd07-e51fc64ed081",
                                                "text": "„An welchem Tage sind die Werkstätten am leersten und wird am wenigsten gearbeitet?“"
                                            },
                                            {
                                                "example_id": "5297de14-e883-4172-9bf2-04bf19156f08",
                                                "sense_id": "ed7f0ebf-95a9-3227-bd07-e51fc64ed081",
                                                "text": "„Seit heute sind alle Schulen und Kitas geschlossen. […] Selbst die Spielplätze bleiben fast leer.“"
                                            },
                                            {
                                                "example_id": "b47b350a-5a5c-489f-9d13-9665df011583",
                                                "sense_id": "ed7f0ebf-95a9-3227-bd07-e51fc64ed081",
                                                "text": "„Ich habe Völker ausgerottet, ihre Burgen verwüstet und ihre Gassen so leer gemacht, dass niemand darauf geht; ihre Städte sind zerstört, dass niemand mehr darin wohnt.“"
                                            },
                                            {
                                                "example_id": "0c9f99b8-5bc7-4070-a1e2-a4bb97fb3271",
                                                "sense_id": "ed7f0ebf-95a9-3227-bd07-e51fc64ed081",
                                                "text": "„Und Jonatan sprach zu ihm: Morgen ist Neumond; da wird man dich vermissen, wenn dein Platz leer bleibt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "403dae47-8c04-3715-bd1b-47d2e4f12873",
                                        "entry_id": "599320e9-f111-3faf-8820-abd0c1445951",
                                        "glosses": [
                                            "ohne Mimik und Gesten; ohne geistigen Gehalt; ohne Substanz/Tiefgang"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17fdac07-0200-44e7-a105-fa97cb7a95d1",
                                                "sense_id": "403dae47-8c04-3715-bd1b-47d2e4f12873",
                                                "text": "Ich fühle mich so leer."
                                            },
                                            {
                                                "example_id": "653bf053-f728-45c6-8e9f-e1fd5646660b",
                                                "sense_id": "403dae47-8c04-3715-bd1b-47d2e4f12873",
                                                "text": "»Lass eine Zeile leer, dann sieht dein Bericht besser aus.«"
                                            },
                                            {
                                                "example_id": "5bb01e10-4833-4a87-ab43-f9d5a16f4c3b",
                                                "sense_id": "403dae47-8c04-3715-bd1b-47d2e4f12873",
                                                "text": "[Charleston-Massaker:] „Und Stewart brachte nichts in seine Sendung mit als Traurigkeit und ein leeres Blatt Papier, auf dem er wie besessen herumkritzelte - als hoffe er, sein Bleistift könne die Frage beantworten: Warum?“"
                                            },
                                            {
                                                "example_id": "0072c2a9-7258-485f-9c68-d4787315555a",
                                                "sense_id": "403dae47-8c04-3715-bd1b-47d2e4f12873",
                                                "text": "[Palästinensische Frage:] „»Mal gab es eine französische, eine amerikanische, eine arabische Initiative - aber das alles ist am Ende doch leeres Gerede«, sagt der 50-Jährige.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
