                    ]
                },
                {
                    "sense_id": "6b3f9e7a-7fe5-3acd-a9ee-cd70a4406e10",
                    "sense_definition": "Qui est touché par une révélation ou une inspiration religieuse ou spirituelle.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mystique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce mystique <w>illuminé</w> affirmait avoir reçu une révélation divine au cours d'une nuit de prière."
                        },
                        {
                            "text": "Ce prédicateur étrange s'exprimait d'une voix vibrante comme s'il était un esprit <w>illuminé</w>."
