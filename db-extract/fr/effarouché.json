                        "glosses": [
                            "Qui a peur ; qui est effrayé."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b4845cfe-b1f1-3f9a-afd1-95c1cf473a06",
                        "entry_id": "fd934cd4-ddfe-3888-a29a-c55c4429c989",
                        "glosses": [
                            "Qui montre de la peur."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "ee1bdfaa-171d-4397-bb1d-dc3adc54fc19",
                                "sense_id": "b4845cfe-b1f1-3f9a-afd1-95c1cf473a06",
                                "text": "[…] ; il me semble n’y avoir vu encore que des visages effarouchés ou rébarbatifs. Peut-être aussi les Parisiens ont-ils peur de l’orage."
                            },
                            {
                                "example_id": "4e0ec189-5666-4ca6-a374-6287595f8d7a",
                                "sense_id": "b4845cfe-b1f1-3f9a-afd1-95c1cf473a06",
                                "text": "Moricet. — Bien ! bien ! (Entraînant doucement Léontine à droite, deuxième plan.) Allons, venez, belle effarouchée !"
                            }
                        ]
                    },
                    {
                        "sense_id": "480f921d-1af5-3438-b4f3-e9e523e193e0",
                        "entry_id": "fd934cd4-ddfe-3888-a29a-c55c4429c989",
                        "glosses": [
                            "Se dit d’un chat représenté dressé sur les pattes arrières. À rapprocher d’acculé, cabré, effaré, effrayé, forcené et furieux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bcd43b0-702b-4946-be6c-6b1226402ec9",
                                "sense_id": "480f921d-1af5-3438-b4f3-e9e523e193e0",
                                "text": "Écartelé : au premier d’azur semé de fleurs de lys d’or, au deuxième de gueules au temple antique d’argent maçonné et ouvert de sable, au troisième losangé d’or et de gueules, au quatrième d’argent au chat effarouché de sable allumé de sinople, qui est de Genainville → voir illustration « chat effarouché »"
                            }
                        ]
                    }
