                "senses": [
                    {
                        "sense_id": "7b513de5-3591-3d8f-9e1e-3432fab8ad14",
                        "entry_id": "e1fbb24a-a940-3d5b-a632-e23f41424734",
                        "glosses": [
                            "церк. духовное лицо, заведующее ризницей; хранитель церковной утвари"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5fecad2-b5ec-481b-affe-6497614776eb",
                                "sense_id": "7b513de5-3591-3d8f-9e1e-3432fab8ad14",
                                "text": "Духовное лицо, заведующее ризницей, называется ризничим, а в кафедральных соборах — это соборный ключарь."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4a74d484-5e7b-4885-9cca-ce951c5265be",
                        "source_entry_id": "e1fbb24a-a940-3d5b-a632-e23f41424734",
                        "source_sense_id": "7b513de5-3591-3d8f-9e1e-3432fab8ad14",
                        "target_lang_word": "sacristan",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sacristan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "67435c05-7a38-3b92-9738-de0671f93e37",
                                        "entry_id": "e130134f-83ea-3a2f-94b6-aaad8e741b46",
                                        "glosses": [
                                            "The person who maintains the sacristy and the sacred objects it contains."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ba3b748-f30d-4314-8543-b571936bdd5c",
                                                "sense_id": "67435c05-7a38-3b92-9738-de0671f93e37",
                                                "text": "And hence the custom and law began\nThat still at dawn the sacristan,\nWho duly pulls the heavy bell,\nFive and forty beads must tell\nBetween each stroke"
                                            },
                                            {
                                                "example_id": "ee79d4c1-e753-4ebb-ab50-872274645435",
                                                "sense_id": "67435c05-7a38-3b92-9738-de0671f93e37",
                                                "text": "[…] every evening as the temple was closed for the night the sacristan paused: \"Pindar to supper with the god!\" he cried."
                                            },
                                            {
                                                "example_id": "63c00b8f-1559-43f4-8031-d2fa1aecfb87",
                                                "sense_id": "67435c05-7a38-3b92-9738-de0671f93e37",
                                                "text": "The church was looked after by an old sacristan who lived in a cottage on the shore of the lake."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
