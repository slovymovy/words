                                    {
                                        "sense_id": "435b8521-b161-3e51-ba67-db4e0767cead",
                                        "entry_id": "e4c24030-b3a8-30e5-b18d-5672bba49517",
                                        "glosses": [
                                            "État d’une tige, d’un tronc qui a des nœuds."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d351b73b-7019-3495-8c25-57cdfc6e346e",
                                        "entry_id": "e4c24030-b3a8-30e5-b18d-5672bba49517",
                                        "glosses": [
                                            "État d’une tige, d’un tronc qui a des nœuds.",
                                            "Ces nœuds."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef6b8adc-4da1-43d9-8476-114d6e4c929e",
                                                "sense_id": "d351b73b-7019-3495-8c25-57cdfc6e346e",
                                                "text": "Son visage n’allait pas, je ne sais comment : un assemblage fortuit de traits qui m’évoquait simplement un visage humain, à la façon des creux et des nodosités gris qui bosselaient le tronc de mon hêtre, ou des dessins du bois sur la tête du lit, chez ma grand-mère qui, si je les regardais sous le mauvais angle au clair de lune, me montraient un vieillard à la bouche grande ouverte, comme s’il était en train de hurler."
                                            },
                                            {
                                                "example_id": "587220f5-b0d8-4031-94d9-923be45cfa16",
                                                "sense_id": "d351b73b-7019-3495-8c25-57cdfc6e346e",
                                                "text": "Le tronc de cet arbre est couvert de nodosités."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fbb2153-89a0-34ee-a8c1-f0f5dcd80308",
                                        "entry_id": "e4c24030-b3a8-30e5-b18d-5672bba49517",
                                        "glosses": [
                                            "Boursouflures symbiotiques produites sur les poils absorbants des racines de certaines plantes par des bactéries, leur permettant la fixation de l’azote."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d77803a0-ba78-3d90-b18e-8d9537c6ca05",
                                        "entry_id": "e4c24030-b3a8-30e5-b18d-5672bba49517",
                                        "glosses": [
                                            "Boursouflures symbiotiques produites sur les poils absorbants des racines de certaines plantes par des bactéries, leur permettant la fixation de l’azote.",
                                            "Ces nœuds."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d9a3b1d-7ac4-4783-aeb2-b1295d4f967f",
                                                "sense_id": "d77803a0-ba78-3d90-b18e-8d9537c6ca05",
                                                "text": "La formation d’une nodosité peut entraver celle d’autres nodosités ; plus elle est grosse plus elle a de pouvoir inhibiteur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7cca7ed-03a6-3b98-a877-da088d2299d8",
                                        "entry_id": "e4c24030-b3a8-30e5-b18d-5672bba49517",
                                        "glosses": [
                                            "État d’une partie du corps qui présente des nodus. Il se dit, par extension, de ces nodus eux-mêmes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b89dfad0-080e-32e0-8764-58737aad62cd",
                                        "entry_id": "e4c24030-b3a8-30e5-b18d-5672bba49517",
                                        "glosses": [
                                            "État d’une partie du corps qui présente des nodus. Il se dit, par extension, de ces nodus eux-mêmes.",
                                            "Ces nodus."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60c864f7-b8e9-4bfb-a2cd-542e1041075d",
                                                "sense_id": "b89dfad0-080e-32e0-8764-58737aad62cd",
                                                "text": "Il a des nodosités aux doigts de la main."
                                            }
                                        ]
                                    }
                                ]
                            }
