        "ru-extract.jsonl": [
            {
                "entry_id": "8d2abc47-52da-377a-9cff-9516b1c7a881",
                "word": "вплоть",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "28db8ede-ce62-3ae3-82d4-6654bc2bdbf1",
                        "entry_id": "8d2abc47-52da-377a-9cff-9516b1c7a881",
                        "glosses": [
                            "устар. и прост. предельно близко; вплотную к чему-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "029404be-13ac-46c5-80d6-2046437c996c",
                                "sense_id": "28db8ede-ce62-3ae3-82d4-6654bc2bdbf1",
                                "text": "Мы хотели, к вечеру подойдя вплоть к морскому берегу, отдохнуть немного,.."
                            },
                            {
                                "example_id": "79721952-d776-4d8e-864d-8fb3e2867942",
                                "sense_id": "28db8ede-ce62-3ae3-82d4-6654bc2bdbf1",
                                "text": "Митя скорыми и длинными своими шагами подступил вплоть к столу."
                            },
                            {
                                "example_id": "16e00c31-a808-4135-8fc1-3d31f1ae5e65",
                                "sense_id": "28db8ede-ce62-3ae3-82d4-6654bc2bdbf1",
                                "text": "Положив, как всегда, свои скулы на ладони, он пристально смотрел на птицу, утомлённую прыжками, она прижалась вплоть к стволу дерева,.."
                            }
                        ]
                    },
                    {
                        "sense_id": "5ee04fc6-fdf7-34eb-819e-c68b59919b72",
                        "entry_id": "8d2abc47-52da-377a-9cff-9516b1c7a881",
                        "glosses": [
                            "продолжая (продолжаясь) до какого-либо предела (в пространстве или во времени)"
                        ],
                        "tags": [
                            "в знач. предлога, в сочет. с до"
                        ],
                        "examples": [
                            {
                                "example_id": "88ba8941-2612-4b41-a4dd-6316f9847cc6",
                                "sense_id": "5ee04fc6-fdf7-34eb-819e-c68b59919b72",
                                "text": "И ну-ну-ну, ну-ну-ну; по всем по трём, вплоть до Питера, к Корзинкину прямо на двор."
                            },
                            {
                                "example_id": "001a3bee-caa2-427b-9ac2-da9e7541f085",
                                "sense_id": "5ee04fc6-fdf7-34eb-819e-c68b59919b72",
                                "text": "В глухую полночь, когда все вокруг меня засыпало, я высекал огонь, вынимал из-под полу моё сокровище и принимался читать вплоть до утра."
                            }
                        ]
                    },
                    {
                        "sense_id": "199972f8-a0d7-3230-a33c-435d36299ae6",
                        "entry_id": "8d2abc47-52da-377a-9cff-9516b1c7a881",
                        "glosses": [
                            "включая кого-либо, что-либо"
                        ],
                        "tags": [
                            "в знач. предлога, в сочет. с до"
                        ],
                        "examples": [
                            {
                                "example_id": "fd625623-54d7-4305-8e15-abb632ef6b3a",
                                "sense_id": "199972f8-a0d7-3230-a33c-435d36299ae6",
                                "text": "Дальнейшая моя линия поведения ни для кого не ясна, вплоть до меня самого."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "84df673e-bb7c-4c62-aa75-26211e052917",
                        "source_entry_id": "8d2abc47-52da-377a-9cff-9516b1c7a881",
                        "source_sense_description": "продолжая (продолжаясь) до какого-либо предела",
                        "target_lang_word": "up to",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "up to",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "713b0a83-c254-3104-8166-cd596cb16c69",
                                        "entry_id": "2f89b312-2f42-357c-b9fd-6dd5031fa2bc",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see up, to."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "730cf113-ba5d-4333-ba41-8778237f9f82",
                                                "sense_id": "713b0a83-c254-3104-8166-cd596cb16c69",
                                                "text": "She went up to the third floor."
                                            },
                                            {
                                                "example_id": "c7231f3c-7a78-456d-88ab-39d416b4d25a",
                                                "sense_id": "713b0a83-c254-3104-8166-cd596cb16c69",
                                                "text": "Go up to the counter and ask."
                                            },
                                            {
                                                "example_id": "3dcc495f-4028-4ad3-8747-143a05ffaa9a",
                                                "sense_id": "713b0a83-c254-3104-8166-cd596cb16c69",
                                                "text": "But the little old woman walked up to Dorothy, made a low bow and said, in a sweet voice, “You are welcome, most noble Sorceress, to the land of the Munchkins.[…]”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6359f136-0c5a-3f97-a938-7f7bf1247f74",
                                        "entry_id": "2f89b312-2f42-357c-b9fd-6dd5031fa2bc",
                                        "glosses": [
                                            "Capable, ready or equipped, having sufficient material preconditions for, possibly willpower (at a particular moment)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e448e97-ed4f-4805-bb88-245dab56eb20",
                                                "sense_id": "6359f136-0c5a-3f97-a938-7f7bf1247f74",
                                                "text": "to feel up to it"
                                            },
                                            {
                                                "example_id": "ed62054a-b55f-4063-9700-17f05c222ba7",
                                                "sense_id": "6359f136-0c5a-3f97-a938-7f7bf1247f74",
                                                "text": "Are you up to lifting something that heavy?"
                                            },
                                            {
                                                "example_id": "369c0610-42cf-406a-88cd-82709de94285",
                                                "sense_id": "6359f136-0c5a-3f97-a938-7f7bf1247f74",
                                                "text": "Are you up to the challenge?"
                                            },
                                            {
                                                "example_id": "b8f8f41e-aa6e-4964-b9ec-b1130bfb1a73",
                                                "sense_id": "6359f136-0c5a-3f97-a938-7f7bf1247f74",
                                                "text": "Are you up to going to the beach?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f46513a9-87b9-3ba4-903d-6667b59635c3",
                                        "entry_id": "2f89b312-2f42-357c-b9fd-6dd5031fa2bc",
                                        "glosses": [
                                            "As much as; no more than (also with of)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9e8cec8-1e2b-40f1-bf30-c73908b5bdf6",
                                                "sense_id": "f46513a9-87b9-3ba4-903d-6667b59635c3",
                                                "text": "You can make up to five copies."
                                            },
                                            {
                                                "example_id": "8207d9e7-37d2-4049-bfb8-a9620d464e05",
                                                "sense_id": "f46513a9-87b9-3ba4-903d-6667b59635c3",
                                                "text": "Violators may face a fine of up to $300."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "716dff05-13a9-362a-91da-1acee4faf079",
                                        "entry_id": "2f89b312-2f42-357c-b9fd-6dd5031fa2bc",
                                        "glosses": [
                                            "Until."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffdf33ac-a906-4e85-aed0-46f2fa418579",
                                                "sense_id": "716dff05-13a9-362a-91da-1acee4faf079",
                                                "text": "Up to that point, I liked her."
                                            },
                                            {
                                                "example_id": "e42062da-a460-4bd1-972c-90539821f754",
                                                "sense_id": "716dff05-13a9-362a-91da-1acee4faf079",
                                                "text": "I've read up to chapter 5."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13b1050d-b83e-30d9-877f-16a0921207b0",
                                        "entry_id": "2f89b312-2f42-357c-b9fd-6dd5031fa2bc",
                                        "glosses": [
                                            "Within the responsibility of, to be attributed to the sphere of influence of, having someone or something as authoritative in."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f3638b4-631b-4760-83a3-02dc98f55ff1",
                                                "sense_id": "13b1050d-b83e-30d9-877f-16a0921207b0",
                                                "text": "It’s up to you whether to get the blue one or the red one."
                                            },
                                            {
                                                "example_id": "417a6d7b-6160-49d6-b18b-7b70b5c3aba9",
                                                "sense_id": "13b1050d-b83e-30d9-877f-16a0921207b0",
                                                "text": "It's up to the prosecution to prove that the defendant is guilty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87db2a45-c3da-3875-b300-878a779b6396",
                                        "entry_id": "2f89b312-2f42-357c-b9fd-6dd5031fa2bc",
                                        "glosses": [
                                            "Doing, involved in."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d5c86bf-44ab-4d71-a8b5-364bef963e89",
                                                "sense_id": "87db2a45-c3da-3875-b300-878a779b6396",
                                                "text": "to be up to"
                                            },
                                            {
                                                "example_id": "b536ca42-b7b8-4532-9464-04ff219703e7",
                                                "sense_id": "87db2a45-c3da-3875-b300-878a779b6396",
                                                "text": "to get up to"
                                            },
                                            {
                                                "example_id": "8d4d87cc-7061-4b33-8286-97f8d1c9c2ec",
                                                "sense_id": "87db2a45-c3da-3875-b300-878a779b6396",
                                                "text": "What are you up to today?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6244d9ab-d5e9-39dc-bd5c-5b4e4fc00213",
                                        "entry_id": "2f89b312-2f42-357c-b9fd-6dd5031fa2bc",
                                        "glosses": [
                                            "Doing, involved in.",
                                            "Devising, scheming (planning something mischievous or inappropriate)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b4cca5f-9ac7-4d20-88ab-97fd2ea14ddf",
                                                "sense_id": "6244d9ab-d5e9-39dc-bd5c-5b4e4fc00213",
                                                "text": "He looked like a man up to no good."
                                            },
                                            {
                                                "example_id": "de50ed8e-6275-4e2d-b73c-a1180e83aea3",
                                                "sense_id": "6244d9ab-d5e9-39dc-bd5c-5b4e4fc00213",
                                                "text": "What are you kids up to with all that toilet paper?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "004ee91c-3ee4-3c2c-a476-e3dc95948139",
                                        "entry_id": "2f89b312-2f42-357c-b9fd-6dd5031fa2bc",
                                        "glosses": [
                                            "Considering all members of an equivalence class the same."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cabc3dcf-f502-4e4d-9532-91211bccbf19",
                                                "sense_id": "004ee91c-3ee4-3c2c-a476-e3dc95948139",
                                                "text": "There’s only one rooted tree with two leaves, up to ordering."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a9a4c0d-bf0f-3341-a52b-8c83dcf3cb51",
                                        "entry_id": "2f89b312-2f42-357c-b9fd-6dd5031fa2bc",
                                        "glosses": [
                                            "Familiar with the meaning of; able to understand."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2214db59-dc5a-4467-9c9d-c263e834bd3f",
                                                "sense_id": "9a9a4c0d-bf0f-3341-a52b-8c83dcf3cb51",
                                                "text": "“Oh,” said Mr. Pickwick. “My what, did you say?”\n“Your chummage ticket,” replied Mr. Roker; “you’re up to that?”\n“Not quite,” replied Mr. Pickwick, with a smile.\n“Why,” said Mr. Roker, “it’s as plain as Salisbury. You’ll have a chummage ticket upon twenty-seven in the third, and them as is in the room will be your chums.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3e8f865-3b01-32f1-91af-d27f6bffad4f",
                                        "entry_id": "2f89b312-2f42-357c-b9fd-6dd5031fa2bc",
                                        "glosses": [
                                            "Taught by; in the class of."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc91ee67-22da-49b8-bc83-bbac4b81dee5",
                                                "sense_id": "a3e8f865-3b01-32f1-91af-d27f6bffad4f",
                                                "text": "I was up to Mr. Wayte, and, although he was a fairly easy and by no means strict master, […]"
                                            },
                                            {
                                                "example_id": "7bded13c-5721-40b6-8e25-205accb0b9d3",
                                                "sense_id": "a3e8f865-3b01-32f1-91af-d27f6bffad4f",
                                                "text": "I was up to Mr. Luxmoore, who was to be a lifelong friend. The last days of my last half were like a dream. I was hardly conscious of the reality of things, and I did not yet fully realise that my Eton life was coming to an end […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
