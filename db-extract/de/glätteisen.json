                                        "entry_id": "24f6fee9-82b2-319a-97d0-b2c99b2fe614",
                                        "glosses": [
                                            "A meteorite consisting primarily of metallic iron (mixed with a small amount of nickel), as opposed to one composed mainly of stony material."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ff2871b-c4b4-4bda-963e-3650607e02b8",
                                                "sense_id": "8f3081fe-02fc-3c4a-950c-ee88f0c1b934",
                                                "text": "Irons and stony irons can be much larger than stony meteorites and are much more visually striking, but make up only a few percent of all meteorites."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc5fb39f-330f-3a2c-bb6c-0f5163cbec37",
                                        "entry_id": "24f6fee9-82b2-319a-97d0-b2c99b2fe614",
                                        "glosses": [
                                            "A safety curtain in a theatre."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "03d3831b-e9ac-3aa8-9fff-afcaa39d16c2",
                                        "entry_id": "24f6fee9-82b2-319a-97d0-b2c99b2fe614",
                                        "glosses": [
                                            "Dumb bombs, those without guidance systems."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "iron",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bcf4f3f2-75d3-3d6f-a2b6-19e2e050b3cc",
                                        "entry_id": "c831a9de-730f-3cdd-8868-b980fbc3cac7",
                                        "glosses": [
                                            "Made of the metal iron."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "30ddee95-6c96-3909-ac88-ef5a746aa99c",
                                        "entry_id": "c831a9de-730f-3cdd-8868-b980fbc3cac7",
                                        "glosses": [
                                            "Strong (as of will), inflexible."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a4522aa-cd88-4e0d-8103-9bb4edb75154",
                                                "sense_id": "30ddee95-6c96-3909-ac88-ef5a746aa99c",
                                                "text": "She had an iron will."
                                            },
                                            {
                                                "example_id": "26ffe555-d714-46be-ab45-7b94daa7b62d",
                                                "sense_id": "30ddee95-6c96-3909-ac88-ef5a746aa99c",
                                                "text": "He held on with an iron grip."
                                            },
                                            {
                                                "example_id": "c6897a13-1e5e-4642-b513-cf16547bc073",
                                                "sense_id": "30ddee95-6c96-3909-ac88-ef5a746aa99c",
                                                "text": "an iron constitution"
                                            },
                                            {
                                                "example_id": "03177db4-6282-4bc0-affa-d7869e95eb47",
                                                "sense_id": "30ddee95-6c96-3909-ac88-ef5a746aa99c",
                                                "text": "Iron men"
                                            },
                                            {
                                                "example_id": "a41125c5-0cb7-4ab1-862c-5e9f0aab16ae",
                                                "sense_id": "30ddee95-6c96-3909-ac88-ef5a746aa99c",
                                                "text": "[…]the fruit-garden, where every tree and walk had a remembrance—those iron links of affection."
                                            },
                                            {
                                                "example_id": "23231b1f-a93c-462b-b814-8c49f881807c",
                                                "sense_id": "30ddee95-6c96-3909-ac88-ef5a746aa99c",
                                                "text": "The faces of the gods are iron and their mouths set hard. There is no hope from the gods."
                                            },
                                            {
                                                "example_id": "ad55d36e-d2fc-44df-9724-181ede5a5d20",
                                                "sense_id": "30ddee95-6c96-3909-ac88-ef5a746aa99c",
                                                "text": "And it is symptomatic of the many paradoxes of Lederer's life that of all the people in the room, Brotherhood is the one whom he would most wish to serve, if ever he had the opportunity, even though — or perhaps because — his occasional efforts to ingratiate himself with his adopted hero have met with iron rebuff."
                                            },
                                            {
                                                "example_id": "274b4a6b-e833-426b-9869-a1bbe3a079e5",
                                                "sense_id": "30ddee95-6c96-3909-ac88-ef5a746aa99c",
                                                "text": "But in her speech, Truss said she would exert an “iron discipline” over public spending, hinting at possible austerity to come. “I believe in sound money and a lean state,” she said."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "iron",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ad7bb0a9-dca0-3152-bbaf-d3beacfe72ad",
                                        "entry_id": "69e2a3ed-a766-3d89-9b27-f2c06755af0f",
                                        "glosses": [
                                            "To pass an iron over (clothing or some other item made of cloth) in order to remove creases."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20fad3d9-7a9a-45f1-a291-4adfcf576e35",
                                                "sense_id": "ad7bb0a9-dca0-3152-bbaf-d3beacfe72ad",
                                                "text": "You'd be wise to iron that shirt before you wear it."
                                            },
                                            {
                                                "example_id": "be195c53-c545-4b68-a8ff-cb46464022c9",
                                                "sense_id": "ad7bb0a9-dca0-3152-bbaf-d3beacfe72ad",
                                                "text": "Out of that tub had come the day before - Tess felt it with a dreadful sting of remorse - the very white frock upon her back which she had so carelessly greened about the skirt on the damping grass - which had been wrung up and ironed by her mother's own hands."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8e2da95-7c9d-358b-ab45-13455dd19dcb",
                                        "entry_id": "69e2a3ed-a766-3d89-9b27-f2c06755af0f",
                                        "glosses": [
                                            "To engage in such pressing of clothing."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b833357d-0f1e-4add-b23f-058ecd003295",
                                                "sense_id": "b8e2da95-7c9d-358b-ab45-13455dd19dcb",
                                                "text": "They were washing and ironing all morning."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e88d0dfe-7428-3c3d-9c1b-71bbe52d010c",
                                        "entry_id": "69e2a3ed-a766-3d89-9b27-f2c06755af0f",
                                        "glosses": [
                                            "To shackle with irons; to fetter or handcuff."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a6fc137-c2a5-423b-b117-4ac964f1618f",
                                                "sense_id": "e88d0dfe-7428-3c3d-9c1b-71bbe52d010c",
                                                "text": "[...] is it he who is ironed like a malefactor—who is to be dragged on a hurdle to the common gallows—to die a lingering and cruel death, and to be mangled by the hand of the most outcast of wretches?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "600dc97e-e207-314b-908a-31c69aa77bb6",
                                        "entry_id": "69e2a3ed-a766-3d89-9b27-f2c06755af0f",
                                        "glosses": [
                                            "To furnish, clad, or arm with iron."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81648a32-e19d-43fb-98e9-3568670f5109",
                                                "sense_id": "600dc97e-e207-314b-908a-31c69aa77bb6",
                                                "text": "to iron a wagon"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
