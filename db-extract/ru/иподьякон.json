                        "cross_references": [
                            {
                                "target_word": "Subdiakon",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a3eb2247-33a4-30a3-8f08-ef6c01148e5a",
                                        "entry_id": "fc5898fc-6e82-3d7d-880e-fba6eb1facc2",
                                        "glosses": [
                                            "jemand, der die erste der höheren Weihen empfangen hat und damit auf der Weihestufe unter der des Diakons steht (vom 3. Jahrhundert bis 1972)"
                                        ],
                                        "tags": [
                                            "Katholizismus"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7fde8789-6c0c-4d91-b29f-53bf367ae5da",
                                                "sense_id": "a3eb2247-33a4-30a3-8f08-ef6c01148e5a",
                                                "text": "Der Subdiakon trug bei der Feier der Heiligen Messe zum Zeichen seines Amtes den Manipel."
                                            },
                                            {
                                                "example_id": "84e40226-06bb-4fce-b8a6-567b379ea45d",
                                                "sense_id": "a3eb2247-33a4-30a3-8f08-ef6c01148e5a",
                                                "text": "„3. Während der Oktav wird die Messe feierlich gehalten mit zwei Altardienern, Diakon und Subdiakon, und Weihrauch wird verwendet zur Opferung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a177b6de-bdbc-3c4d-8295-045724490b23",
                                        "entry_id": "fc5898fc-6e82-3d7d-880e-fba6eb1facc2",
                                        "glosses": [
                                            "Amtsträger einer Stufe der niederen Weihen"
                                        ],
                                        "tags": [
                                            "Ostkirchen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01f474bb-c47d-4572-af6e-edc54eb37e17",
                                                "sense_id": "a177b6de-bdbc-3c4d-8295-045724490b23",
                                                "text": "„Immer wieder öffnet sich die Tür und nacheinander erscheinen Diakone, Subdiakone und mehrere Frauen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
