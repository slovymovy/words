                "senses": [
                    {
                        "sense_id": "027132f9-8d6c-3c4c-b97c-44d2ab900065",
                        "entry_id": "53c6444a-bb0c-3ac4-b924-a370f4ac5bae",
                        "glosses": [
                            "miasto i gmina w północnej Francji"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7d2502b-3368-434d-b62b-d9bc114c1cfa",
                                "sense_id": "027132f9-8d6c-3c4c-b97c-44d2ab900065",
                                "text": "Tkaniny te wyprodukowano w dalekim Arras."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f163e5ed-795b-49ee-8fb5-2b28763d9000",
                        "source_entry_id": "53c6444a-bb0c-3ac4-b924-a370f4ac5bae",
                        "source_sense_id": "027132f9-8d6c-3c4c-b97c-44d2ab900065",
                        "target_lang_word": "Arras",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Arras",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8c68dc4c-d121-3be6-9980-f1f5978d1a5d",
                                        "entry_id": "6e18cb38-59d6-30fc-a07a-1fb278029d31",
                                        "glosses": [
                                            "Commune, ville et chef-lieu de département français, situé dans le département du Pas-de-Calais."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25195996-1e6d-45d7-8359-0ae21d13bd31",
                                                "sense_id": "8c68dc4c-d121-3be6-9980-f1f5978d1a5d",
                                                "text": "Aucune classe d'hommes n’alimenta de plus de victimes les bûchers du moyen âge. Les Vaudois d’Arras eurent leurs martyrs, comme ceux de Lyon."
                                            },
                                            {
                                                "example_id": "67f87953-07ea-4aa9-acce-f3fc64c4d965",
                                                "sense_id": "8c68dc4c-d121-3be6-9980-f1f5978d1a5d",
                                                "text": "Il est débarqué d’Arras. Il avait là-bas une étude d’avoué."
                                            },
                                            {
                                                "example_id": "243cbdec-42bd-4048-bbe9-4005b452cd9e",
                                                "sense_id": "8c68dc4c-d121-3be6-9980-f1f5978d1a5d",
                                                "text": "Le 18, départ pour Arras, avec arrêt à Gouy-Servins, à 3 km. derrière Ablain-Saint-Nazaire."
                                            },
                                            {
                                                "example_id": "c927c655-973c-409e-b4fb-25a1775c3f45",
                                                "sense_id": "8c68dc4c-d121-3be6-9980-f1f5978d1a5d",
                                                "text": "Mais le seul nom qui ait été sauvé de l’oubli, dans la poésie profane, est celui de ce médiocre rimeur de Mathieu-le-Juif, d’Arras, qui vivait au XIIIᵉ siècle."
                                            },
                                            {
                                                "example_id": "f3bcfcf5-1984-4e1b-b686-c60581857a02",
                                                "sense_id": "8c68dc4c-d121-3be6-9980-f1f5978d1a5d",
                                                "text": "Mes parents allèrent passer quelques jours à Arras et je n’en profitai pas."
                                            },
                                            {
                                                "example_id": "66b4e5fb-a38d-4957-832b-6ffa1b36cf60",
                                                "sense_id": "8c68dc4c-d121-3be6-9980-f1f5978d1a5d",
                                                "text": "Nous ne sûmes pas davantage que la reprise de quelques kilomètres au nord d’Arras, en mai 1915, avait coûté aux Français sous Pétain environ quatre cent mille hommes, et la bataille de la Somme, qui dura quatre mois, plus ou moins, environ un million de part et d’autre au cours d’une avance en profondeur de dix kilomètres."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
