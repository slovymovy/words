                    {
                        "translation_id": "2e1214aa-4548-42b2-b0d6-10f75bf069c7",
                        "source_entry_id": "9b188423-952c-38ee-9827-2c114e76c1d1",
                        "source_sense_description": "зверёк подсемейства полёвковых семейства хомяков",
                        "target_lang_word": "lemming",
