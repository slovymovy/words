                ],
                "senses": [
                    {
                        "sense_id": "6353cd70-d5f3-3f4c-a948-03cd694ba845",
                        "entry_id": "4502a271-a15f-3d84-8950-e2435be966d0",
                        "glosses": [
                            "niezależny od jakiejś grupy osób i niezaangażowany w jej sprawy; niebiorący w czymś bezpośredniego udziału"
                        ],
                        "tags": [
                            "also"
                        ],
                        "examples": [
                            {
                                "example_id": "5531e8fc-efd3-4353-9669-b29cf72eb664",
                                "sense_id": "6353cd70-d5f3-3f4c-a948-03cd694ba845",
                                "text": "Jak mógł twierdzić, że on, osoba postronna, lepiej od niej wie, jak było naprawdę!"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "05391c02-fb79-40cb-be41-581572af7e2c",
                        "source_entry_id": "4502a271-a15f-3d84-8950-e2435be966d0",
                        "source_sense_id": "6353cd70-d5f3-3f4c-a948-03cd694ba845",
                        "target_lang_word": "сторонний",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "сторонний",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "888bc1fa-32dd-3abc-85a7-7c6313c773a8",
                                        "entry_id": "5f5722d0-9560-394b-94e1-3bce674f29df",
                                        "glosses": [
                                            "устар. расположенный в стороне, боковой"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4045036f-a310-3b33-bc21-41d491b9557e",
                                        "entry_id": "5f5722d0-9560-394b-94e1-3bce674f29df",
                                        "glosses": [
                                            "разг. то же, что посторонний; чужой"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "715d8bf5-ea96-4a30-b24b-49bee5f9f801",
                                                "sense_id": "4045036f-a310-3b33-bc21-41d491b9557e",
                                                "text": "И кругом ― перешёптывания, сторонние взгляды. Что это было?"
                                            },
                                            {
                                                "example_id": "4901acd4-652f-46e6-97ee-20157b0002c9",
                                                "sense_id": "4045036f-a310-3b33-bc21-41d491b9557e",
                                                "text": "И никого не пускать в дом стороннего, особенно купцов!"
                                            },
                                            {
                                                "example_id": "bddda3de-469d-4801-b3cb-02b3b4bc917b",
                                                "sense_id": "4045036f-a310-3b33-bc21-41d491b9557e",
                                                "text": "Но со стороны некому было посмотреть, да и нет в этом мире сторонних."
                                            },
                                            {
                                                "example_id": "ec063628-2d6d-4a1a-a55b-93d403e2c5b6",
                                                "sense_id": "4045036f-a310-3b33-bc21-41d491b9557e",
                                                "text": "Пока шёл процесс в первой инстанции, столичные власти запретили вселение любых сторонних лиц в коммуналки."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "171d9157-28eb-42b4-bef8-e02522847ea8",
                        "source_entry_id": "4502a271-a15f-3d84-8950-e2435be966d0",
                        "source_sense_id": "6353cd70-d5f3-3f4c-a948-03cd694ba845",
                        "target_lang_word": "посторонний",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "посторонний",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "04bb9411-a268-37d5-9517-bd712cd329b8",
                                        "entry_id": "89b9a492-4dd8-3925-81dd-0c72d1af035f",
                                        "glosses": [
                                            "чужой, не состоящий в близких отношениях с кем-либо"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1e7e3a01-a79b-3ac2-9e3a-07437c81406c",
                                        "entry_id": "89b9a492-4dd8-3925-81dd-0c72d1af035f",
                                        "glosses": [
                                            "принадлежащий чужим, исходящий от чужих"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ec8042a-8352-4867-8c83-6a630a371377",
                                                "sense_id": "1e7e3a01-a79b-3ac2-9e3a-07437c81406c",
                                                "text": "Любовь для бывшего моего жениха есть дело постороннее, теперь он для меня посторонняя вещь…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a2402d5-0ea9-3387-a02a-ed375e67131d",
                                        "entry_id": "89b9a492-4dd8-3925-81dd-0c72d1af035f",
                                        "glosses": [
                                            "не имеющий к чему-либо прямого отношения; побочный"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ba2efff-4eab-40f2-8b31-8cab30889b8b",
                                                "sense_id": "9a2402d5-0ea9-3387-a02a-ed375e67131d",
                                                "text": "В четверг говорили, чтобы никто посторонние вещи в школу не таскал, а сегодня какой-то военный придёт."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "посторонний",
                                "target_lang_code": "ru",
                                "target_senses": [
