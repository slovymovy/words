                ],
                "senses": [
                    {
                        "sense_id": "8cc9efa7-98b6-3884-85e0-5a35fe786913",
                        "entry_id": "3992777a-b0dd-37b5-9ea2-ccf9282b2d70",
                        "glosses": [
                            "Fruit sec déhiscent, formé par un carpelle isolé, se présentant comme une capsule contenant les graines de certaines plantes. Il a une seule fente de déhiscence."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "347390c8-a6ef-342e-8d5b-5f093c22e951",
                        "entry_id": "3992777a-b0dd-37b5-9ea2-ccf9282b2d70",
                        "glosses": [
                            "Glande en forme de petit sac interne dans l’épaisseur d’un tégument."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f53335f-8dc2-4765-af9e-c55509dbc1cf",
                                "sense_id": "347390c8-a6ef-342e-8d5b-5f093c22e951",
                                "text": "Les lésions de la fièvre typhoïde intéressent l'appareil lymphatique, depuis le tissu lymphoïde intestinal (follicules clos et plaques de Peyer) jusqu'aux ganglions mésentériques et à la rate."
                            },
                            {
                                "example_id": "f57e1d5e-8d93-4788-95e3-a7463e3e9383",
                                "sense_id": "347390c8-a6ef-342e-8d5b-5f093c22e951",
                                "text": "Beaucoup de gens pensent que les cicatrices ne représentent qu’un problème esthétique, mais \"le tissu cicatriciel n'a pas de follicules pileux ni de glandes sudoripares, il est inflexible et plus faible que la peau.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "c024174e-e580-37da-aebb-67e46d3d9364",
                        "entry_id": "3992777a-b0dd-37b5-9ea2-ccf9282b2d70",
                        "glosses": [
                            "Cocon de ver à soie."
                        ],
                        "tags": [
                            "Soierie"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "21cee5b7-19ec-3b38-8b32-d5d9e526a479",
                        "entry_id": "3992777a-b0dd-37b5-9ea2-ccf9282b2d70",
                        "glosses": [
                            "Petit feuillet d’impression."
                        ],
                        "tags": [
                            "Papeterie",
                            "Imprimerie"
                        ],
                        "examples": []
                    }
                ],
