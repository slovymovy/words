                ],
                "senses": [
                    {
                        "sense_id": "95e4c167-a685-3393-8535-6ea888745191",
                        "entry_id": "2f37adad-f370-3cfc-af6c-58a02c913ed8",
                        "glosses": [
                            "meist flüssigkeitsbasierte Technik, die etwas kühlen/abkühlen soll; meist bestehend aus Leitungen, Wärmetauscher(n), Pumpe(n) und einem Kühlmedium; oft verwendet bei Motoren, Kraftwerken, in der Gebäudetechnik und in der Raumfahrt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e180f678-5ce6-43ac-8b5d-86e2b3b4b1c6",
                                "sense_id": "95e4c167-a685-3393-8535-6ea888745191",
                                "text": "Wenn im Auto das Kühlsystem immer wieder Flüssigkeit verliert, muss man in die Werkstatt fahren."
                            },
                            {
                                "example_id": "4e119cf6-c62e-481f-94aa-eb1de3c3ad9a",
                                "sense_id": "95e4c167-a685-3393-8535-6ea888745191",
                                "text": "Vor dem Winter sollte man den Frostschutz im Kühlsystem des Autos prüfen."
                            },
                            {
                                "example_id": "e3244bdc-1127-4e8a-8121-498d3f7e4a9c",
                                "sense_id": "95e4c167-a685-3393-8535-6ea888745191",
                                "text": "Das körpereigene Kühlsystem beim Menschen kann nur funktionieren, wenn man genug getrunken hat."
                            },
                            {
                                "example_id": "e199200c-c944-4e23-9ebf-869587ec16e5",
                                "sense_id": "95e4c167-a685-3393-8535-6ea888745191",
                                "text": "Das Kühlsystem der Bobbahn in Oberhof enthält 36 Tonnen Ammoniak."
                            },
                            {
                                "example_id": "c32df137-590a-4d7d-abdb-938f28894e13",
                                "sense_id": "95e4c167-a685-3393-8535-6ea888745191",
                                "text": "[Das Stadion Al Janoub in Katar] „verfügt über 40.000 Sitzplätze, ein schließbares Dach und – wie alle Stadien - ein umfassendes Kühlsystem für die gesamte Arena.“"
                            },
                            {
                                "example_id": "bc96246f-8197-4c2c-b57f-e5eb7d54a3d0",
                                "sense_id": "95e4c167-a685-3393-8535-6ea888745191",
                                "text": "[Wien:] „Über ein eigenes Fernkältenetz wird das auf etwa fünf bis sechs Grad Celsius abgekühlte Wasser direkt zu den Kundinnen und Kunden transportiert. Über die hauseigenen Kühlsysteme wird es dann in den Gebäuden verteilt.“"
                            },
                            {
                                "example_id": "b8ffefbf-41cd-4148-b740-ebfcaa333c97",
                                "sense_id": "95e4c167-a685-3393-8535-6ea888745191",
                                "text": "„»Wir hatten zum Beispiel technische Probleme, dass uns Pumpen ausgefallen sind oder Ventile eingefroren sind im Kühlsystem.«“"
                            },
                            {
                                "example_id": "cc3eb3f2-d943-4bc2-b169-bbee6864449f",
                                "sense_id": "95e4c167-a685-3393-8535-6ea888745191",
                                "text": "[Autorennen:] „Leclerc musste die 2. Trainingseinheit wegen eines Problems im Kühlsystem vorzeitig beenden.“",
                                "translation": "[Kraftwerke:]"
                            },
                            {
                                "example_id": "f3b66322-0f16-4d51-acfe-cebd4b9deec6",
                                "sense_id": "95e4c167-a685-3393-8535-6ea888745191",
                                "text": "[Fukushima/Japan 2011:] „Das Kühlsystem des Kraftwerks fiel aus; in drei der sechs Reaktoren kam es zur Kernschmelze.“"
                            },
                            {
                                "example_id": "4e39f26d-0111-4a7e-8d5a-3566bab586a1",
                                "sense_id": "95e4c167-a685-3393-8535-6ea888745191",
                                "text": "„Nach rund einer Woche wurde der Fehler im Kühlsystem des Atomkraftwerks gefunden.“"
                            },
                            {
                                "example_id": "ac8bd5f2-d677-45ff-a708-9b366247fca2",
                                "sense_id": "95e4c167-a685-3393-8535-6ea888745191",
                                "text": "[Tschernobyl im russischen Krieg gegen die Ukraine:] „Die Kühlsysteme mussten zuletzt mithilfe von Notstromaggregaten betrieben werden.“"
                            },
                            {
                                "example_id": "dd367839-a2a2-411b-9c58-f47d696cc1b6",
                                "sense_id": "95e4c167-a685-3393-8535-6ea888745191",
                                "text": "[AKW Fessenheim: Damals waren] „die Steuerstäbe zum Abschalten des Reaktors nach einer Überflutung in Block 1 nicht mehr manövrierfähig, so dass der Block durch die Einleitung von Bor ins Kühlsystem abgeschaltet werden musste.“"
                            },
                            {
                                "example_id": "a5c888d4-9a88-4286-8cdb-273d4794981b",
                                "sense_id": "95e4c167-a685-3393-8535-6ea888745191",
                                "text": "[28. März 1979:] „In Harrisburg, der Hauptstadt des Bundesstaates Pennsylvania, hat es im Kernkraftwerk Three Mile Island einen Unfall im Kühlsystem gegeben.“"
                            },
                            {
                                "example_id": "97524f1b-aeed-4600-99c5-327d0954fdbd",
                                "sense_id": "95e4c167-a685-3393-8535-6ea888745191",
                                "text": "„Und schon wieder gerät die Atom-Ruine von Fukushima in die Schlagzeilen. Eines der Kühlsysteme des Abklingbeckens ist für 3 Stunden ausgefallen.“",
                                "translation": "[Raumfahrt:]"
                            },
                            {
                                "example_id": "5a55ffc0-d8b4-4f8f-8034-bb84fe7b323c",
                                "sense_id": "95e4c167-a685-3393-8535-6ea888745191",
                                "text": "„Der saure Geruch, den Grissom wahrgenommen hatte, stammte höchstwahrscheinlich von älteren Lecks im Kühlsystem.“"
                            },
                            {
                                "example_id": "51b31b50-a529-4345-a584-02d8ffcd6d1d",
                                "sense_id": "95e4c167-a685-3393-8535-6ea888745191",
                                "text": "„Überschüssige Wärmeleistung von bis zu 106,8 kW kann über das Kühlsystem in den Weltraum abgegeben werden.“"
                            },
                            {
                                "example_id": "ff59868f-46e5-4c55-9c02-a5bc8b12a739",
                                "sense_id": "95e4c167-a685-3393-8535-6ea888745191",
                                "text": "„Der Ausstieg hatte sich wegen eines Problems mit einem Kühlsystem um gut eine Stunde verzögert.“"
                            },
                            {
                                "example_id": "1681afc4-5a62-4f7c-8727-f7944c7486d7",
                                "sense_id": "95e4c167-a685-3393-8535-6ea888745191",
                                "text": "„Am 24. Dezember 2013 installierten Astronauten der ISS-Expedition 38 eine neue Ammoniakpumpe für das Kühlsystem der Station. Das fehlerhafte Kühlsystem war Anfang desselben Monats ausgefallen.“"
                            },
                            {
                                "example_id": "73da9250-a61b-467e-87fb-e457c6e47a69",
                                "sense_id": "95e4c167-a685-3393-8535-6ea888745191",
                                "text": "„Mehr als sechs Stunden lang nahmen die beiden Reparaturen am Kühlsystem der Station vor und ersetzten eine Außenkamera.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
