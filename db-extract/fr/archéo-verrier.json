                        "sense_id": "814ba006-8b0b-36de-b56f-c8e8274a1410",
                        "entry_id": "ad7758b2-e337-3beb-8728-d5a6b4f73a97",
                        "glosses": [
                            "Spécialiste des techniques antiques de fabrication du verre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "889fab7f-5999-4d82-8cd2-bdd4a8df460b",
                                "sense_id": "814ba006-8b0b-36de-b56f-c8e8274a1410",
                                "text": "Pour animer la résidence qui s’est déroulée du 24 avril au 27 mai, les organisateurs faisaient appel à des archéo-verriers du groupe Les Infondus : François Dubois et Chloé Grevaz, pour la construction d’un four antique, et l’artiste plasticienne Zoé Joliclercq."
                            },
                            {
                                "example_id": "07e8a8af-87e4-4c91-b1d8-3a08435fab55",
                                "sense_id": "814ba006-8b0b-36de-b56f-c8e8274a1410",
                                "text": "L’objectif de la résidence pour l’artiste est de produire une œuvre utilisant le verre produit en collaboration avec les archéo-verriers, en tout ou partie."
                            },
                            {
                                "example_id": "281fecba-161f-48b9-9d3a-d2ed69f53f50",
                                "sense_id": "814ba006-8b0b-36de-b56f-c8e8274a1410",
                                "text": "Ce duo « d’archéo-verriers » construira, selon les méthodes antiques, un four à verre dans les jardins de l’Abbaye Saint André."
                            }
                        ]
                    }
