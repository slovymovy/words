                "entry_id": "fd1a9699-5ab9-3b43-967d-8c8ed0ca70f0",
                "word": "privatization",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "b048b870-72cf-4c97-aacf-42f13dbe9a79",
