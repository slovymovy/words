                        "glosses": [
                            "Ça suffit. C'est assez."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "443e9730-0a51-408e-88cd-7e341aedc3da",
                                "sense_id": "f579fba8-db18-3580-a268-49a964b5a071",
                                "text": "Je finis ça et puis basta."
                            },
                            {
                                "example_id": "7f823a50-7484-4395-a46f-15a9faae10e2",
                                "sense_id": "f579fba8-db18-3580-a268-49a964b5a071",
                                "text": "Il n’y a rien à ajouter, basta."
                            },
                            {
                                "example_id": "bc496e7e-e162-4d0d-9d61-5570b85257cd",
                                "sense_id": "f579fba8-db18-3580-a268-49a964b5a071",
                                "text": "Quelques semaines plus tard, mon fils me rappelait à l’ordre : un chat s’appelait un chat. Grand-mère s’était suicidée, oui, foutue en l’air, elle avait baissé le rideau, déclaré forfait, lâché l’affaire, elle avait dit stop, basta, terminado, et elle avait de bonnes raisons d’en arriver là."
                            }
                        ]
                    }
