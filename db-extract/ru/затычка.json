                    },
                    {
                        "sense_id": "a642536c-0da9-3d57-b73b-77a112923817",
                        "entry_id": "3543f048-72d6-3e2a-b1d1-96789e24bd50",
                        "glosses": [
                            "разг. предмет для затыкания какого-либо отверстия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35397d82-b01e-48e4-83f0-2f0263d668c0",
                                "sense_id": "a642536c-0da9-3d57-b73b-77a112923817",
                                "text": "Пошёл через денёк портной в погреб за пивом, смотрит: затычка у бочонка вынута и кто-то пиво уж пробовал."
                            }
                        ]
                    },
                    {
                        "sense_id": "97d9d09d-b264-31e9-b104-e6e076bb08d0",
                        "entry_id": "3543f048-72d6-3e2a-b1d1-96789e24bd50",
                        "glosses": [
                            "разг. о том, кого используют в случае необходимости для замены кого-либо, выполнения мелких поручений и т. п."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "7e8368a7-a836-3426-87c8-a01b4254f58f",
                        "entry_id": "3543f048-72d6-3e2a-b1d1-96789e24bd50",
                        "glosses": [
                            "комп. жарг. о непроизводительной и, как правило, дешёвой видеокарте"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8d71926c-0817-4fec-a18b-948f8bedec60",
