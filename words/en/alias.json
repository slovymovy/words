                },
                {
                    "sense_id": "a4878ce1-c984-3ab0-8d06-41c3ac263651",
                    "sense_definition": "To create a distortion in a signal or image because the sampling frequency is too low.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "signal processing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If the sample rate is too low, the high-frequency sounds will <w>alias</w> into the lower range.",
                            "target_lang_translations": {
                                "ru": "Если частота дискретизации слишком низкая, высокочастотные звуки будут <w>искажаться</w>, переходя в нижний диапазон."
                            }
                        },
                        {
                            "text": "The digital camera began to <w>alias</w> when capturing the fine patterns on the fabric.",
                            "target_lang_translations": {
                                "ru": "Цифровая камера начала <w>выдавать муар</w> при съемке мелких узоров на ткани."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "scientific"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Создавать искажение в сигнале или изображении из-за слишком низкой частоты дискретизации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подвергаться алиасингу",
                                "target_lang_sense_clarification": "о сигнале"
                            },
                            {
                                "target_lang_word": "искажаться",
                                "target_lang_sense_clarification": "из-за наложения частот"
                            }
                        ]
                    }
                }
            ]
        }
    ]
