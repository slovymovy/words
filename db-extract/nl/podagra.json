                                        "entry_id": "a3f9f887-bb2f-3063-b570-409ee7b8e828",
                                        "glosses": [
                                            "Alternative form of gote (“sluice, ditch, drain; vault”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
