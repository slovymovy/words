                            {
                                "example_id": "5af5afbd-b0cb-40f4-921a-7c43a8f2df69",
                                "sense_id": "bc23b1f1-11c0-3fbe-9016-0189dec78af1",
                                "text": "Griekse politie pakt verkeerde 'vliegtuigkaper' op: De man die in Griekenland is aangehouden omdat hij in 1985 betrokken zou zijn geweest bij een vliegtuigkaping, blijkt de verkeerde persoon te zijn. De Griekse politie zette de 65-jarige man vorige week vast tijdens zijn vakantie op het eiland Mykonos."
                            },
                            {
                                "example_id": "c8ce580a-bfc9-4c34-9c02-00eacd8f3183",
                                "sense_id": "bc23b1f1-11c0-3fbe-9016-0189dec78af1",
                                "text": "Vliegtuigkaper van Cuba naar VS: Een Amerikaan die in de jaren 80 met een gekaapt vliegtuig naar Cuba vloog, keert vandaag terug naar de VS."
                            }
                        ]
                    }
