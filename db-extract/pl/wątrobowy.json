                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "683044ee-e134-42e5-8eee-1881ea9920a0",
                        "source_entry_id": "91c070d0-7014-3494-a91c-3ce26a84d730",
                        "source_sense_id": "e38c59d6-3933-3128-ac34-b39ab0a466d2",
                        "target_lang_word": "hepatic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hepatic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "29d81237-0955-362b-9746-87d86b4fdd4b",
                                        "entry_id": "e625555d-cd09-3fed-a52f-4630cebec714",
                                        "glosses": [
                                            "Of or relating to the liver."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a9f3c566-e52c-3368-81f1-779ba5c2117b",
                                        "entry_id": "e625555d-cd09-3fed-a52f-4630cebec714",
                                        "glosses": [
                                            "Acting on or occurring in the liver."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "95ee7293-8de5-3a9d-aff0-5872421664b9",
                                        "entry_id": "e625555d-cd09-3fed-a52f-4630cebec714",
                                        "glosses": [
                                            "Of a deep brownish-red color like that of the liver."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c793281-6c36-4a31-be3d-18affe2a6fdb",
                                                "sense_id": "95ee7293-8de5-3a9d-aff0-5872421664b9",
                                                "text": "Polyhydrite, a silicate of oxide of iron from Breitenbrun, Saxony, is of a hepatic color, vitreous lustre and opaque"
                                            },
                                            {
                                                "example_id": "127fd718-f590-4254-9e0e-b8988e997b99",
                                                "sense_id": "95ee7293-8de5-3a9d-aff0-5872421664b9",
                                                "text": "In fact bis weakness was for alcoholic stimulants. Hence his liver was carefully examined. It was not of the usual hepatic color ; in this case it presented a deep purple-black"
                                            },
                                            {
                                                "example_id": "4d47d5a8-2a04-4bc4-9557-1236ea755611",
                                                "sense_id": "95ee7293-8de5-3a9d-aff0-5872421664b9",
                                                "text": "Among the most striking ot the internal modifications is the gradual change of the liver from the characteristic hepatic color to a bright green."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hepatic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b383139b-56ca-3c03-9584-21b269ea6a65",
                                        "entry_id": "b9732c7f-9c33-3bd6-ba98-2367fdc8f68f",
                                        "glosses": [
                                            "Any compound that acts on the liver."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d60011da-b4c7-3691-b321-06583fac8630",
                                        "entry_id": "b9732c7f-9c33-3bd6-ba98-2367fdc8f68f",
                                        "glosses": [
                                            "A liverwort (kind of plant)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0967ea87-523d-4e40-8469-1a48f2529c93",
                                                "sense_id": "d60011da-b4c7-3691-b321-06583fac8630",
                                                "text": "There is now such an immense \"microliterature\" on hepatics that, beyond a certain point I have given up trying to integrate (and evaluate) every minor paper published—especially narrowly floristic papers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "afaf472f-e922-48e5-a309-4c104a040649",
                        "source_entry_id": "91c070d0-7014-3494-a91c-3ce26a84d730",
                        "source_sense_id": "e38c59d6-3933-3128-ac34-b39ab0a466d2",
