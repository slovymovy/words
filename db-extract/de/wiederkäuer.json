                ],
                "senses": [
                    {
                        "sense_id": "c72cd341-f7ce-3ccd-b899-d8efc2957161",
                        "entry_id": "a05b0343-2fb5-3624-9401-aceb5da29621",
                        "glosses": [
                            "Säugetier, dessen Magen in vier Abschnitte geteilt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e421de9-2418-4dff-b206-d88d396df106",
                                "sense_id": "c72cd341-f7ce-3ccd-b899-d8efc2957161",
                                "text": "„Die Pest der kleinen Wiederkäuer ist eine gefährliche übertragbare Viruserkrankung, an der vor allem Schafe und Ziegen schwer erkranken und meist auch sterben.“"
                            },
                            {
                                "example_id": "c54415a4-10dc-4b3c-a2f9-31bf710cf836",
                                "sense_id": "c72cd341-f7ce-3ccd-b899-d8efc2957161",
                                "text": "Auch der kleinste aller Wiederkäuer, der Zwerghirsch, ist, wiewohl selten, versteinert gefunden worden."
                            },
                            {
                                "example_id": "67fafef0-a090-4847-8e15-41325eb1bff5",
                                "sense_id": "c72cd341-f7ce-3ccd-b899-d8efc2957161",
                                "text": "[Klimakrise:] „Methan entsteht vor allem durch den Stoffwechsel von Wiederkäuern, insbesondere Rindern, und durch den Reisanbau.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "46cc6f97-eba9-436f-8697-9df7735df26d",
                        "source_entry_id": "a05b0343-2fb5-3624-9401-aceb5da29621",
                        "source_sense_id": "c72cd341-f7ce-3ccd-b899-d8efc2957161",
                        "source_sense_description": "Zoologie: Säugetier, dessen Magen in vier Abschnitte geteilt ist",
                        "target_lang_word": "ruminant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ruminant",
