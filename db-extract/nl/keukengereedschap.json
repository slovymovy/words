                            {
                                "example_id": "8c9e22c3-2d68-4ef2-851a-cf096e892a8c",
                                "sense_id": "4a7b6e59-5107-3bff-994a-377f3e6a484e",
                                "text": "Het favoriete product van de baas zelf? „Onze ijsmachine. Een betaalbaar keukengereedschap waarmee je tot in de eeuwigheid het heerlijkste ijs maakt.”"
                            },
                            {
                                "example_id": "db839e91-ee87-43dc-a045-cbb75dc26c86",
                                "sense_id": "4a7b6e59-5107-3bff-994a-377f3e6a484e",
                                "text": "Een mes is daarom niet alleen het meest compacte, maar ook het onontbeerlijkste keukengereedschap en voor menig thuiskok ook het begeerlijkste."
                            }
                        ]
                    },
                    {
                        "sense_id": "990aad25-1a36-3a26-8a4b-5e0f7f64552f",
                        "entry_id": "a27535d0-2bbb-3611-8238-ac8becf8a4e8",
                        "glosses": [
