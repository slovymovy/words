                "translations": [
                    {
                        "translation_id": "644fab39-cb9f-41b7-8c9c-77aea6a57092",
                        "source_entry_id": "3181d36e-d8b9-3692-974e-29fdc038b285",
                        "source_sense_id": "461b9c36-5dcb-3b56-ad55-53569742c5bc",
                        "target_lang_word": "Hashemite",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hashemite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f8769ed7-7bfc-32e1-b6c4-70becceab0a9",
                                        "entry_id": "a83733d1-0fe8-32f5-b0c4-15a090a41afb",
                                        "glosses": [
                                            "One who lays claim to being a direct descendant of Hashim, the great grandfather of the Islamic prophet Muhammad."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Hashemite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "71e1b803-a9c3-3710-8b9b-9042d05924bc",
                                        "entry_id": "a6604a2c-1c45-370d-9b41-d3a4e0c03f1c",
                                        "glosses": [
                                            "Relating to or being descendants of Hashim."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58b0e410-f9bf-40c2-8ccc-1c18bff13cee",
                                                "sense_id": "71e1b803-a9c3-3710-8b9b-9042d05924bc",
                                                "text": "In 1924 the Hashemite King Hussein was driven out of the Hedjaz by Ibn Saud, and a state of war sprang up between the new kingdoms of Saudi Arabia and Trans-Jordan."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d52487af-c95b-47be-a263-da9426936dec",
                        "source_entry_id": "3181d36e-d8b9-3692-974e-29fdc038b285",
                        "source_sense_id": "461b9c36-5dcb-3b56-ad55-53569742c5bc",
                        "target_lang_word": "hášimovský",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "c1e8a5e2-86cd-4951-b3f5-3874ddc937b0",
                        "source_entry_id": "3181d36e-d8b9-3692-974e-29fdc038b285",
                        "source_sense_id": "461b9c36-5dcb-3b56-ad55-53569742c5bc",
                        "target_lang_word": "hachémite",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hachémite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "53a04c7b-7f06-3c89-887b-0f9edfddcf7d",
                                        "entry_id": "bcc84b47-a2a2-3757-87e6-271d1368f493",
                                        "glosses": [
                                            "Relatif à la dynastie hachémite, famille régnante en Jordanie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d66e6a6a-aadc-44bf-867a-400056285c78",
                                                "sense_id": "53a04c7b-7f06-3c89-887b-0f9edfddcf7d",
                                                "text": "Si, sur le papier, la Jordanie est le pays de la région où le nombre de violations directes a été le plus faible, le respect de la liberté de la presse et de la culture dans le royaume hachémite n’est en aucun cas satisfaisant."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hachémite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ac6226d6-2fa9-3a73-8ab6-fac39a7c5ce6",
                                        "entry_id": "a5472787-adff-35c8-b430-fa6ee27204cc",
                                        "glosses": [
                                            "Membre de la famille régnante de Jordanie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fd15513-fd43-47c7-b7ec-37796510b4d3",
                                                "sense_id": "ac6226d6-2fa9-3a73-8ab6-fac39a7c5ce6",
                                                "text": "En mettant en valeur le seul caractère arabe de l’Irak et en faisant roi Fayçal, un hachémite appartenant à la communauté sunnite minoritaire, les Britanniques avaient, dès 1920, construit une entité excluant les chiites et les Kurdes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a657078b-7ca6-419b-b682-b4ddbb75b4c8",
                        "source_entry_id": "3181d36e-d8b9-3692-974e-29fdc038b285",
                        "source_sense_id": "461b9c36-5dcb-3b56-ad55-53569742c5bc",
                        "target_lang_word": "haschemitisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "haschemitisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f71bb0e9-8ea3-31c7-b946-fd71421d75f2",
                                        "entry_id": "a2a6b36b-deec-3c1d-8f9c-040ee70f0165",
                                        "glosses": [
                                            "die arabische Herrscherfamilie der Haschemiten betreffend, zu ihnen gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc9ca318-1c7b-4349-bd01-78fbb0edf629",
                                                "sense_id": "f71bb0e9-8ea3-31c7-b946-fd71421d75f2",
                                                "text": "„Der Club mit den verstaubten, alten Ledersesseln und der dunklen Holztäfelung stammte vermutlich noch aus der Zeit, als Glubb Pascha dem haschemitischen Heer britische Disziplin eintrichtern wollte.“"
                                            },
                                            {
                                                "example_id": "3189d4f3-ef5b-48cd-aa58-cf0fc549c27a",
                                                "sense_id": "f71bb0e9-8ea3-31c7-b946-fd71421d75f2",
                                                "text": "„Abdullah war ein Sprössling der haschemitischen Königsfamilie aus dem Hidjas – wo die heiligen muslimischen Städte Mekka und Medina liegen –, die im Ersten Weltkrieg auf Seiten der Briten gekämpft hatte.“"
                                            },
                                            {
                                                "example_id": "9fcf414a-7c8f-453c-afa0-8b9b9b6f0412",
                                                "sense_id": "f71bb0e9-8ea3-31c7-b946-fd71421d75f2",
                                                "text": "„1970 führten die Flugzeugentführungen der PFLP und die palästinensischen Exzesse in Jordanien zu einer katastrophalen Konfrontation mit dem haschemitischen Regime, die die Widerstandsbewegung nicht gewinnen konnte.“"
                                            },
                                            {
                                                "example_id": "69f4c618-edbd-422a-8744-25f307f61a50",
                                                "sense_id": "f71bb0e9-8ea3-31c7-b946-fd71421d75f2",
                                                "text": "„Abeds Vater hatte einen jordanischen Pass aus der Zeit, als das Westjordanland vom haschemitischen Königshaus kontrolliert wurde, also konnte Abed es in Jordanien versuchen.“"
                                            },
                                            {
                                                "example_id": "a51a1465-4398-47c5-a79c-7adb76249552",
                                                "sense_id": "f71bb0e9-8ea3-31c7-b946-fd71421d75f2",
                                                "text": "„Damit war für den haschemitischen König die Gefahr gebannt, die auch von den moderateren Teilen der PLO für seine Herrschaft ausgegangen war, da die jordanische Bevölkerung infolge von Flucht, Vertreibung und Einwanderung zu diesem Zeitpunkt schon mehrheitlich palästinensisch bzw. palästinensischer Abstammung war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
