                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98afd60f-43b2-499d-926e-e058806da84e",
                                "sense_id": "e050d787-c46d-3cb6-94e6-64f104383936",
                                "text": "Op beelden van het incident is te zien hoe de beveiligers van Erdogan op een groep demonstranten - die leuzen tegen de president scanderen - afrennen en die aanvallen."
                            },
                            {
                                "example_id": "329d5df6-17d7-43d7-9ea1-7e9788f0b1e8",
                                "sense_id": "e050d787-c46d-3cb6-94e6-64f104383936",
                                "text": "Twee wilde zwijnen hebben in het Duitse stadje Heide verschillende mensen aangevallen. Op beveiligingsbeelden is te zien hoe de zwijnen op mensen in een winkel afrennen en proberen te bijten."
                            }
                        ]
                    },
                    {
                        "sense_id": "34545bf8-3eaa-3512-800c-bcc473f3f5c4",
                        "entry_id": "f5bb208f-caf9-3690-a62b-be5fe5fcb03b",
