                    ],
                    "target_lang_definitions": {
                        "ru": "Определенный район города или поселка, а также люди, которые там живут.",
                        "nl": "Een bepaald deel van een stad of dorp en de mensen die er wonen.",
                        "pl": "Określony obszar miasta lub miasteczka oraz ludzie, którzy w nim mieszkają.",
                        "de": "Ein bestimmtes Gebiet einer Stadt und die Menschen, die dort leben.",
                        "fr": "Un quartier particulier d'une ville ou d'un village et les personnes qui y vivent.",
                        "it": "Una zona specifica di una città o di un paese e le persone che vi abitano.",
                        "cs": "Určitá oblast města nebo vesnice a lidé, kteří v ní žijí.",
                        "tr": "Bir kasaba veya şehrin belirli bir bölgesi ve orada yaşayan insanlar.",
                        "es": "Una zona particular de un pueblo o ciudad y las personas que viven allí.",
                        "zh": "城镇或城市中的特定区域，以及居住在那里的人们。",
                        "ja": "町や都市の特定の一地域と、そこに住む人々。",
                        "pt": "Uma zona determinada de uma cidade ou vila e as pessoas que nela vivem."
                    },
