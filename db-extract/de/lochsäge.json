                "senses": [
                    {
                        "sense_id": "10a7d3a3-9634-3fc3-a8be-460c3d807807",
                        "entry_id": "5f792c67-b841-3dc7-b4b5-13a0c864a824",
                        "glosses": [
                            "in Verbindung mit einer Bohrmaschine genutzte Säge, mit welcher kreisrunde Löcher begrenzter Tiefe in verschiedene Materialien gesägt werden können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b446e80-7cd5-4b00-9e71-f2147864fb02",
                                "sense_id": "10a7d3a3-9634-3fc3-a8be-460c3d807807",
                                "text": "„Eine gewisse Ausdauer aber ist gefragt: Fuchsschwanz, Raspel und Sandpapier sind immer im Einsatz. Für Verbindungen, Gelenke und Montage von Rädern ist die Bohrmaschine unerlässlich, eine helfende Hand dürfte da willkommen sein, besonders wenn mit der Lochsäge Räder produziert werden müssen.“"
                            }
                        ],
