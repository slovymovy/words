            "pos": "noun",
            "senses": [
                {
                    "sense_id": "01b6f51c-4798-3fa0-87a9-c281b9aec86b",
                    "sense_definition": "teren pokryty lodem przeznaczony do rekreacyjnej jazdy na łyżwach lub ślizgania się",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "lodowisko",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W każdą zimową sobotę dzieci chętnie chodzą na miejską <w>ślizgawkę</w>.",
                            "target_lang_translations": {
                                "ru": "Каждую зимнюю субботу дети с удовольствием ходят на городской <w>каток</w>."
                            }
                        },
                        {
                            "text": "W parku zrobiono bezpłatną <w>ślizgawkę</w> dla wszystkich mieszkańców miasta.",
                            "target_lang_translations": {
                                "ru": "В парке сделали бесплатный <w>каток</w> для всех жителей города."
                            }
                        }
                    ],
                    "synonyms": [
                        "lodowisko"
                    ],
                    "common_phrases": [
                        "miejska ślizgawka",
                        "ślizgawka na lodzie",
                        "chodzić na ślizgawkę"
                    ],
                    "target_lang_definitions": {
                        "ru": "ледяная площадка для катания на коньках или скольжения"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "каток",
                                "target_lang_sense_clarification": "ледяная площадка"
                            },
                            {
                                "target_lang_word": "ледяная дорожка",
                                "target_lang_sense_clarification": "для скольжения на подошвах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "969a8d94-b52c-31e2-a986-81f5b74adc06",
                    "sense_definition": "urządzenie do zabawy z pochyłym torem do zjeżdżania",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "zabawa",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na osiedlowym placu zabaw zamontowano nową, kolorową <w>ślizgawkę</w> dla dzieci.",
                            "target_lang_translations": {
                                "ru": "На детской площадке во дворе установили новую, красочную <w>горку</w> для детей."
                            }
                        },
                        {
                            "text": "Chłopiec szybko wszedł po drabince i zjechał z wysokiej <w>ślizgawki</w>.",
                            "target_lang_translations": {
                                "ru": "Мальчик быстро поднялся по лесенке и съехал с высокой <w>горки</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "zjeżdżalnia"
                    ],
                    "common_phrases": [
                        "ślizgawka dla dzieci",
                        "zjechać ze ślizgawki"
                    ],
                    "target_lang_definitions": {
                        "ru": "детское игровое сооружение с наклонным спуском для катания"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "горка",
                                "target_lang_sense_clarification": "детская горка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3aec3e48-12ed-3f5d-bf69-4610b2b1f8d7",
                    "sense_definition": "śliska, oblodzona powierzchnia drogi lub chodnika",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "oblodzenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Po wieczornych opadach marznącego deszczu na jezdni zrobiła się niebezpieczna <w>ślizgawka</w>.",
                            "target_lang_translations": {
                                "ru": "После вечернего ледяного дождя на проезжей части возникла опасная <w>гололедица</w>."
                            }
                        },
                        {
                            "text": "Musimy iść bardzo ostrożnie, ponieważ cały chodnik zamienił się w prawdziwą <w>ślizgawkę</w>.",
                            "target_lang_translations": {
                                "ru": "Нам нужно идти очень осторожно, потому что весь тротуар превратился в настоящий <w>каток</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "gołoledź",
                        "ślizgawica"
                    ],
                    "common_phrases": [
                        "prawdziwa ślizgawka",
                        "ślizgawka na drodze"
                    ],
                    "target_lang_definitions": {
                        "ru": "скользкая, покрытая льдом поверхность дороги или тротуара"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гололедица",
                                "target_lang_sense_clarification": "лед на дороге"
                            },
                            {
                                "target_lang_word": "каток",
                                "target_lang_sense_clarification": "о скользкой дороге"
                            },
                            {
                                "target_lang_word": "гололёд",
                                "target_lang_sense_clarification": "обледенение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c9367a6a-907c-345d-baf7-65432c0da16e",
                    "sense_definition": "zabawa polegająca na ślizganiu się po lodzie lub oblodzonej nawierzchni",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "aktywność",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wracając ze szkoły do domu, urządziliśmy sobie wesołą <w>ślizgawkę</w> na zamarzniętej ścieżce.",
                            "target_lang_translations": {
                                "ru": "Возвращаясь из школы домой, мы устроили себе весёлое <w>катание</w> на замёрзшей дорожке."
                            }
                        },
                        {
                            "text": "Dzieci miały świetną <w>ślizgawkę</w> na ubitym śniegu przed budynkiem szkoły.",
                            "target_lang_translations": {
                                "ru": "Дети отлично <w>покатались по льду</w> на утрамбованном снегу перед зданием школы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "urządzić ślizgawkę",
                        "dobra ślizgawka"
                    ],
                    "traits": [
