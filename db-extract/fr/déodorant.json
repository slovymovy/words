            {
                "entry_id": "f773b832-98ec-3677-a6ab-3eb5408c9ff3",
                "word": "déodorant",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f7b64497-04db-4945-8023-cb94914d3689",
                        "entry_id": "f773b832-98ec-3677-a6ab-3eb5408c9ff3",
                        "tags": [
                            "plural"
                        ],
                        "form": "déodorants"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "78be1387-550e-3143-86fc-cc1b01a5127b",
                        "entry_id": "f773b832-98ec-3677-a6ab-3eb5408c9ff3",
                        "glosses": [
                            "Produit cosmétique destiné à masquer les mauvaises odeurs de la transpiration ou à régulariser celle-ci. Il existe sous plusieurs formes : bâtons, sticks, sprays, à bille, etc."
                        ],
                        "tags": [
                            "Cosmétologie"
                        ],
                        "examples": [
                            {
                                "example_id": "abced6ec-a066-41cf-b80e-cd3ea0570b64",
                                "sense_id": "78be1387-550e-3143-86fc-cc1b01a5127b",
                                "text": "Tous les matins, dans la salle de bains, les déodorants font pschitt. S’asperger les aisselles est un geste, a priori quotidien, pour la majorité d’entre nous. En attestent les ventes de déos en France."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7aa3157e-8369-4db2-a7a6-cc4e56ce57af",
                        "source_entry_id": "f773b832-98ec-3677-a6ab-3eb5408c9ff3",
                        "source_sense_id": "78be1387-550e-3143-86fc-cc1b01a5127b",
                        "target_lang_word": "Deodorant",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Deodorant",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dd19e361-ba23-3501-a3db-ba50bc06a39d",
                                        "entry_id": "c3038eb3-eb5c-3f75-9dfa-d9fc3e460cb0",
                                        "glosses": [
                                            "ein häufig unter den Achseln aufgebrachtes Mittel zur Bekämpfung von Körpergeruch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c6f253b-03ef-4a11-8bff-9108a72fc00c",
                                                "sense_id": "dd19e361-ba23-3501-a3db-ba50bc06a39d",
                                                "text": "„Verstohlen schnüffelte Stefan an seinen Achselhöhlen, um sich zu vergewissern, dass da kein muffiger Geruch durch das Deodorant drang.“"
                                            },
                                            {
                                                "example_id": "c06cc1d7-ca05-4d67-a472-21052d41e006",
                                                "sense_id": "dd19e361-ba23-3501-a3db-ba50bc06a39d",
                                                "text": "„Die Hygienewitze, die sozusagen vom neuen Zeitalter des Waschzwangs und des Deodorants abgelöst wurden, spiegeln gern auch den Gegensatz zwischen Stadt und Land, zwischen Misthaufen und Plumpsklo auf der einen, Dusche und WC auf der anderen Seite.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "41b9b7aa-c179-445c-a746-507acd44776e",
                        "source_entry_id": "f773b832-98ec-3677-a6ab-3eb5408c9ff3",
                        "source_sense_id": "78be1387-550e-3143-86fc-cc1b01a5127b",
                        "target_lang_word": "deodorant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "deodorant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0b60725e-4be2-323d-bd47-8e3064ddb741",
                                        "entry_id": "9722bc2e-0008-30ef-97b1-855f9419e834",
                                        "glosses": [
                                            "Any agent acting to eliminate, reduce, mask, or control odor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91826a00-a669-4ce3-80bf-718a94138565",
                                                "sense_id": "0b60725e-4be2-323d-bd47-8e3064ddb741",
                                                "text": "The only apparent difference between Playtex deodorant and nondeodorant tampons was the deodorant, yet the deodorant tampons did not stimulate the production of TSST-1."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1e8d2f7-adf2-3d02-b936-a75091ab9254",
                                        "entry_id": "9722bc2e-0008-30ef-97b1-855f9419e834",
                                        "glosses": [
                                            "Any agent acting to eliminate, reduce, mask, or control odor.",
                                            "An odor-controlling substance applied to the underarm to counteract odor from perspiration."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05e45910-f84f-4808-ab81-6fe4e921d741",
                                                "sense_id": "e1e8d2f7-adf2-3d02-b936-a75091ab9254",
                                                "text": "Banned are newspapers and books, noncotton clothing, after-shave lotions and deodorants, all nonorganic or processed foods[…]."
                                            }
                                        ]
                                    }
                                ]
                            },
