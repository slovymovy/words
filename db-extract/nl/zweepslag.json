                        "sense_id": "76cda726-63e6-37a9-90af-388053ddb2f7",
                        "entry_id": "c6c9edef-df56-3369-ab0b-6a4759bb5f56",
                        "glosses": [
                            "slag met een zweep"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6275c7d9-7202-4762-994a-4cdff81d9d3b",
                                "sense_id": "76cda726-63e6-37a9-90af-388053ddb2f7",
                                "text": "zweepslagen worden soms gegeven als lijfstraf (vooral in islamitische landen)."
                            },
                            {
                                "example_id": "6b854596-3bc5-4757-99c1-34d30cabbf54",
                                "sense_id": "76cda726-63e6-37a9-90af-388053ddb2f7",
                                "text": "Saoedi-Arabië moet wetten intrekken die toelaten dat kinderen worden gestenigd, amputaties ondergaan, zweepslagen krijgen of terechtgesteld worden. Die oproep komt van het Comité voor de Rechten van het Kind van de Verenigde Naties, dat vrijdag een rapport publiceerde over Saoedi-Arabië"
                            },
                            {
                                "example_id": "3417f647-d678-4c71-a93b-ccfd42b22c0b",
                                "sense_id": "76cda726-63e6-37a9-90af-388053ddb2f7",
                                "text": "We zouden allemaal zweepslagen krijgen en weggestuurd worden."
                            },
                            {
                                "example_id": "d1d183a7-1373-45ac-9923-f3245629008f",
                                "sense_id": "76cda726-63e6-37a9-90af-388053ddb2f7",
                                "text": "De mensen zwegen toen ze naar de zweepslagen luisterden die door de bewakers van Pilatus werden toegediend, en toen Jezus voor de tweede keer verscheen, droeg hij alleen een lendendoek en bloedde zijn gehavende lichaam."
                            }
                        ]
                    },
                    {
                        "sense_id": "ce8e6bc3-f102-30af-858d-cf6f8807e5b4",
                        "entry_id": "c6c9edef-df56-3369-ab0b-6a4759bb5f56",
                        "glosses": [
                            "plotselinge en heftige spierpijn in een kuit"
                        ],
