                                    },
                                    {
                                        "sense_id": "fcffebee-af9f-3b45-9f4d-05fa4027ed07",
                                        "entry_id": "31c2da96-9ea2-3911-9048-d963e4685aa4",
                                        "glosses": [
                                            "To serve as an opposing point against."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ab7db8b-f215-4c6a-9287-ff5d7d5250da",
                                                "sense_id": "fcffebee-af9f-3b45-9f4d-05fa4027ed07",
                                                "text": "[…] the dominant discourse on theory and method in the study of religions remains stuck on the debate about reductionism, which is in turn bent on representing the debate about theory and method in the study of religions as a choice between an unscientific phenomenology or an unsympathetic positivism (for phenomenology the idea that explanation is always 'bad' is perfectly counterpointed by the idea that religion is always 'good')."
                                            }
                                        ]
                                    }
