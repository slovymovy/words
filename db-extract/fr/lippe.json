                                    {
                                        "sense_id": "25e9072d-bc01-3470-9c96-b2bbddd5effd",
                                        "entry_id": "33f60ff2-3c00-3bbf-b6a3-9fb84f1189b6",
                                        "glosses": [
                                            "Organ am Rand des Mundes; Teil und Abschluss des Mundes nach außen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "456806fa-e780-4747-8080-ab1e27ad07c8",
                                                "sense_id": "25e9072d-bc01-3470-9c96-b2bbddd5effd",
                                                "text": "Er biss sich auf die Lippe."
                                            },
                                            {
                                                "example_id": "0b9aa31b-f664-42ac-91e7-717136b75305",
                                                "sense_id": "25e9072d-bc01-3470-9c96-b2bbddd5effd",
                                                "text": "Ihre Lippen waren rau und aufgesprungen."
                                            },
                                            {
                                                "example_id": "28a01aa6-831c-4de1-a54d-eed7cf3e848f",
                                                "sense_id": "25e9072d-bc01-3470-9c96-b2bbddd5effd",
                                                "text": "„Sie hält es an die Lippen und wischt sich dann die Mundwinkel aus.“"
                                            },
                                            {
                                                "example_id": "537796d8-5b27-4dd2-84ec-51afb227b53e",
                                                "sense_id": "25e9072d-bc01-3470-9c96-b2bbddd5effd",
                                                "text": "„Die Lippen sahen borkig aus.“"
                                            },
                                            {
                                                "example_id": "7779f9be-f8d7-4fea-bf0f-ea7537ef82dc",
                                                "sense_id": "25e9072d-bc01-3470-9c96-b2bbddd5effd",
                                                "text": "„Paul presste die Lippen zusammen, schaute für einen Moment frustriert seitlich nach unten und konnte nicht glauben, was Lindsay da an Schlussfolgerungen bereithielt.“"
                                            },
                                            {
                                                "example_id": "f7c71bb7-0628-4a97-b90e-de8334f00f46",
                                                "sense_id": "25e9072d-bc01-3470-9c96-b2bbddd5effd",
                                                "text": "„Von Gesichtsfarbe war es ganz hell, die Lippen waren schön rot.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "30f21460-211e-393b-b3cf-3872a6151843",
                                        "entry_id": "33f60ff2-3c00-3bbf-b6a3-9fb84f1189b6",
                                        "glosses": [
                                            "Teil der Blütenblätter der Lippenblütler (Lamiaceae)"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b657f199-11b4-35d1-bc32-685f4367bda1",
