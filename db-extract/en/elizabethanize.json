                "senses": [
                    {
                        "sense_id": "cbd0c701-2f4f-35e7-87bc-32f9a8dc65ba",
                        "entry_id": "17bab1ce-422d-3806-a2ed-7cde1660a1f0",
                        "glosses": [
                            "Alternative form of Elizabethanize."
                        ],
                        "tags": [
                            "alt-of",
                            "alternative"
                        ],
                        "examples": [
                            {
                                "example_id": "ae553840-83c7-41a9-bda6-77957b60f367",
                                "sense_id": "cbd0c701-2f4f-35e7-87bc-32f9a8dc65ba",
                                "text": "In plot and characterization and the resulting significance of theme, his changes are the most vital; for here he undertook to humanize and to elizabethanize the story."
                            },
                            {
                                "example_id": "acd083e8-8651-4c0b-9ef6-590f3fa30dc7",
                                "sense_id": "cbd0c701-2f4f-35e7-87bc-32f9a8dc65ba",
                                "text": "Brook explains his choices concerning the changes made at Bouffes du Nord as a desire to \"elizabethanize\" it: This dilapidated theatre is something which for me, creates conditions that are not at all an imitation of Elizabethan theatre but a real reflection of the possibilities offered by the Elizabethan theatre, because today this abandoned theatre is like a place at the same time neutral because it does not belong anymore to its tradition and, like the Elizabethan theatre, it is a place impregnated by life.”"
                            },
                            {
                                "example_id": "cd1a06cc-b7d5-4f6a-aca4-22350bd6e1ae",
                                "sense_id": "cbd0c701-2f4f-35e7-87bc-32f9a8dc65ba",
                                "text": "Both Waith and Holloway object to twentieth-century Shakespcares, and have done their best to elizabethanize themselves and us."
                            }
                        ]
                    }
                ],
