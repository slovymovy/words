                            {
                                "example_id": "c5cfc879-a0fe-4e3a-8649-672f91bc54a3",
                                "sense_id": "90ad3a61-b430-30a8-af0c-9db8b993b29d",
                                "text": "Het is weer de drieënveertig die het niet doet, kunnen we die niet simpel vervangen?"
                            },
                            {
                                "example_id": "851ae377-768c-4a99-9d26-c727076bf4f5",
                                "sense_id": "90ad3a61-b430-30a8-af0c-9db8b993b29d",
                                "text": "Haar vierenveertigste verjaardag was een belangrijk moment, want haar leven werd heel anders toen ze de drieënveertig eenmaal voorbij was."
                            }
                        ]
                    },
                    {
