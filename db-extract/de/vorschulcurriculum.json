                ],
                "senses": [
                    {
                        "sense_id": "7f558e1b-d18b-3af8-8aa7-80f9375310e5",
                        "entry_id": "88d11a16-1821-3821-a1c4-ca9cde61f207",
                        "glosses": [
                            "Gesamtheit festgelegter (pädagogischer) Ziele im Rahmen der Erziehung in einer Vorschule"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b4d0493-343a-4ee7-a922-7271358a38b6",
                                "sense_id": "7f558e1b-d18b-3af8-8aa7-80f9375310e5",
                                "text": "„Das letzte Kindergartenjahr soll im Norden obligatorisch und kostenlos sein. Es müsse mit einem ‚systematischen Vorschulcurriculum‘ verbunden werden.“"
                            },
                            {
                                "example_id": "712a8533-6828-46e7-9bd2-3abf768b4a25",
                                "sense_id": "7f558e1b-d18b-3af8-8aa7-80f9375310e5",
                                "text": "„Auf der anderen Seite waren auch die Befürworter dieser Neuerungen im Vorschulcurriculum der Überzeugung, dass es keinen Sinn macht, Vorschulkinder auf traditionelle Weise in Mathematik zu unterrichten.“"
                            },
                            {
                                "example_id": "3442103b-c7da-4cff-9ed5-dd3fc6402eb8",
                                "sense_id": "7f558e1b-d18b-3af8-8aa7-80f9375310e5",
                                "text": "„Das Kind nahm an fünf Tagen an dem normalen Vorschulcurriculum aus dem GRAY-Programm teil, die Mutter kam einmal in der Woche […].“"
                            },
                            {
                                "example_id": "760bff40-41aa-4925-8a49-f5740155d4bb",
                                "sense_id": "7f558e1b-d18b-3af8-8aa7-80f9375310e5",
                                "text": "„Im schwedischen Vorschulcurriculum wird deutlich, wie stark die Förderung und Integration von Kindern mit Migrationhintergrund bereits im vorschulischen Bereich Berücksichtigung findet und damit einerseits den wissenschaftlichen Erkenntnissen zur Kindesentwicklung auch curricular entspricht und so andererseits den einwanderungspolitischen Gegebenheiten Rechnung trägt.“"
                            },
                            {
                                "example_id": "b142c01c-ae7f-45e3-8522-2082a635b87b",
                                "sense_id": "7f558e1b-d18b-3af8-8aa7-80f9375310e5",
                                "text": "„In einer experimentellen Langzeitstudie mit drei verschiedenen Vorschulcurricula zeigten die Kinder, die am Curriculum nach dem Modell der direkten Instruktion teilgenommen hatten, weniger prosoziales und mehr antisoziales Verhalten und fielen im Jugend— und frühen Erwachsenenalter durch häufigere Delinquenz auf (Schweinhart & Weikart, 1997).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
