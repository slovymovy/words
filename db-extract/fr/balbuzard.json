                "senses": [
                    {
                        "sense_id": "dbdc7ff1-297b-3a8c-9e7e-c261bbeaa3bd",
                        "entry_id": "30b12ed5-757d-3d09-9116-f8d027458be4",
                        "glosses": [
                            "Espèce d'oiseau rapace diurne (falconiforme) de la famille des accipitridés, piscivore et de taille moyenne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb671fc8-7756-4855-bf1a-0e730ec7982d",
                                "sense_id": "dbdc7ff1-297b-3a8c-9e7e-c261bbeaa3bd",
                                "text": "Autrefois commun sur les rivières et étangs français, le balbuzard a disparu de la France continentale au début du XXᵉ siècle."
                            },
                            {
                                "example_id": "5b82e657-969a-43d1-9626-15d2c8a3cc33",
                                "sense_id": "dbdc7ff1-297b-3a8c-9e7e-c261bbeaa3bd",
                                "text": "Les Balbuzards nichent souvent en colonies, et le couple défend un territoire de 50 m autour du nid."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d4e23dd9-f904-4ee7-ad76-87ef5672203b",
                        "source_entry_id": "30b12ed5-757d-3d09-9116-f8d027458be4",
                        "source_sense_id": "dbdc7ff1-297b-3a8c-9e7e-c261bbeaa3bd",
                        "target_lang_word": "Fischadler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fischadler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "71166e2f-c9e2-34a1-b9a9-6c7313a452d0",
                                        "entry_id": "5d7f37a8-bb09-353d-965f-c093798d6c07",
                                        "glosses": [
                                            "Raubvogel der Art Pandion haliaetus, der Fisch frisst und weißes Gefieder an der Bauchseite hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9da3439f-708a-4746-92c6-c45019d0ce12",
                                                "sense_id": "71166e2f-c9e2-34a1-b9a9-6c7313a452d0",
                                                "text": "„Ein Fischadler stieß auf den See herab.“"
                                            },
                                            {
                                                "example_id": "e05e06b1-3f1b-4580-90f2-78f546938040",
                                                "sense_id": "71166e2f-c9e2-34a1-b9a9-6c7313a452d0",
                                                "text": "„Ich sehe den Fischadler – Kalasääski – seit man ihn hier auf den Inseln erwähnte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2a1e8958-a8ad-4a3c-be28-eb0926d23e22",
                        "source_entry_id": "30b12ed5-757d-3d09-9116-f8d027458be4",
                        "source_sense_id": "dbdc7ff1-297b-3a8c-9e7e-c261bbeaa3bd",
                        "target_lang_word": "osprey",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
