{
    "word_family": [
        "moody",
        "moodiness",
        "moodily"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "36bf8745-b73a-357a-9b69-d08ba7c1e133",
                    "sense_definition": "A temporary state of mind or feeling.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "emotional state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have been in a bad <w>mood</w> since I was dumped by my ex-boyfriend.",
                            "target_lang_translations": {
                                "ru": "У меня плохое <w>настроение</w> с тех пор, как меня бросил мой бывший парень.",
                                "de": "Ich habe schlechte <w>Laune</w>, seit mein Ex-Freund mich verlassen hat.",
                                "zh": "自从被前男友甩了之后，我一直<w>心情</w>不好。"
                            }
                        },
                        {
                            "text": "She is in a great <w>mood</w> because she just passed her driving test.",
                            "target_lang_translations": {
                                "ru": "Она в отличном <w>настроении</w>, потому что только что сдала экзамен по вождению.",
                                "de": "Sie ist in großartiger <w>Stimmung</w>, weil sie gerade ihre Fahrprüfung bestanden hat.",
                                "zh": "她刚通过了驾照考试，<w>心情</w>好极了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "humor",
                        "spirit",
                        "temperament",
                        "frame of mind"
                    ],
                    "common_phrases": [
                        "bad mood",
                        "good mood",
                        "in the mood"
                    ],
                    "target_lang_definitions": {
                        "ru": "Временное состояние ума или чувство.",
                        "de": "Ein vorübergehender Gemütszustand oder ein Gefühl.",
                        "zh": "一种暂时的心理状态或感受。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "настроение",
                                "target_lang_sense_clarification": "душевное состояние"
                            },
                            {
                                "target_lang_word": "расположение духа",
                                "target_lang_sense_clarification": "эмоциональное состояние"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Stimmung",
                                "target_lang_sense_clarification": "allgemeiner emotionaler Zustand"
                            },
                            {
                                "target_lang_word": "Laune",
                                "target_lang_sense_clarification": "momentane Verfassung"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "心情",
                                "target_lang_sense_clarification": "个人的心理状态"
                            },
                            {
                                "target_lang_word": "情绪",
                                "target_lang_sense_clarification": "情感状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ebe2bdab-ea39-3060-9594-120e301945c1",
                    "sense_definition": "A state of mind where one is receptive or disposed to doing something specific.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "disposition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am not in the <w>mood</w> for running today because I am too tired.",
                            "target_lang_translations": {
                                "ru": "Я сегодня не в <w>настроении</w> бегать, потому что слишком устал.",
                                "de": "Ich habe heute keine <w>Lust</w> zu laufen, weil ich zu müde bin.",
                                "zh": "我今天太累了，没<w>兴致</w>跑步。"
                            }
                        },
                        {
                            "text": "Are you in the <w>mood</w> for a movie or would you rather go out?",
                            "target_lang_translations": {
                                "ru": "У тебя есть <w>настроение</w> посмотреть кино или ты бы лучше куда-нибудь сходил?",
                                "de": "Hast du <w>Lust</w> auf einen Film oder möchtest du lieber ausgehen?",
                                "zh": "你有<w>兴致</w>看电影吗，还是想出去走走？"
                            }
                        }
                    ],
                    "common_phrases": [
                        "in the mood for",
                        "not in the mood"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние ума, при котором человек восприимчив или склонен к выполнению чего-то конкретного.",
                        "de": "Ein Geisteszustand, in dem man empfänglich oder bereit ist, etwas Bestimmtes zu tun.",
                        "zh": "想要做某事的心理倾向或意愿。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "настроение",
                                "target_lang_sense_clarification": "желание что-либо делать"
                            },
                            {
                                "target_lang_word": "расположение",
                                "target_lang_sense_clarification": "склонность к действию"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Lust",
                                "target_lang_sense_clarification": "Bereitschaft oder Verlangen, etwas zu tun"
                            },
                            {
                                "target_lang_word": "in Stimmung sein",
                                "target_lang_sense_clarification": "bereit sein, etwas zu unternehmen"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "兴致",
                                "target_lang_sense_clarification": "做某事的兴趣或愿望"
                            },
                            {
                                "target_lang_word": "心情",
                                "target_lang_sense_clarification": "做某事的意愿"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "654834cd-af70-3af8-ad38-853af1d76372",
                    "sense_definition": "The prevailing atmosphere or attitude of a group of people or a place.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "atmosphere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A good politician always senses the <w>mood</w> of the crowd before speaking.",
                            "target_lang_translations": {
                                "ru": "Хороший политик всегда чувствует <w>настрой</w> толпы перед выступлением.",
                                "de": "Ein guter Politiker spürt immer die <w>Stimmung</w> der Menge, bevor er spricht.",
                                "zh": "优秀的政治家在演讲前总能感知到群众的<w>情绪</w>。"
                            }
                        },
                        {
                            "text": "The national <w>mood</w> changed significantly after the new law was announced.",
                            "target_lang_translations": {
                                "ru": "Национальное <w>настроение</w> значительно изменилось после объявления нового закона.",
                                "de": "Die nationale <w>Stimmung</w> änderte sich deutlich, nachdem das neue Gesetz verkündet wurde.",
                                "zh": "新法律宣布后，全国的<w>氛围</w>发生了显著变化。"
                            }
                        }
                    ],
                    "synonyms": [
                        "vibe",
                        "spirit"
                    ],
                    "common_phrases": [
                        "mood of the crowd",
                        "national mood",
                        "public mood"
                    ],
                    "target_lang_definitions": {
                        "ru": "Преобладающая атмосфера или отношение группы людей или места.",
                        "de": "Die vorherrschende Atmosphäre oder Einstellung einer Gruppe von Menschen oder an einem Ort.",
                        "zh": "特定群体或场所中普遍存在的氛围或态度。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "настроение",
                                "target_lang_sense_clarification": "общественное мнение или дух"
                            },
                            {
                                "target_lang_word": "атмосфера",
                                "target_lang_sense_clarification": "обстановка в коллективе или месте"
                            },
                            {
                                "target_lang_word": "настрой",
                                "target_lang_sense_clarification": "преобладающее отношение"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Stimmung",
                                "target_lang_sense_clarification": "Atmosphäre in einer Gruppe oder an einem Ort"
                            },
                            {
                                "target_lang_word": "Atmosphäre",
                                "target_lang_sense_clarification": "allgemeine Umgebungswirkung"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "氛围",
                                "target_lang_sense_clarification": "环境或群体中的气氛"
                            },
                            {
                                "target_lang_word": "情绪",
                                "target_lang_sense_clarification": "群体共同的心理倾向"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "770e2e42-2d28-320e-ac17-9cd66163ad40",
                    "sense_definition": "The emotional character or atmosphere of a work of art, music, or literature.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "atmosphere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dark lighting in the film helps to create a somber <w>mood</w>.",
                            "target_lang_translations": {
                                "ru": "Мрачное освещение в фильме помогает создать гнетущую <w>атмосферу</w>.",
                                "de": "Die dunkle Beleuchtung im Film hilft dabei, eine düstere <w>Stimmung</w> zu erzeugen.",
                                "zh": "电影中昏暗的灯光有助于营造一种忧郁的<w>基调</w>。"
                            }
                        },
                        {
                            "text": "Whatever the <w>mood</w> of her music, her fans always get the message.",
                            "target_lang_translations": {
                                "ru": "Каким бы ни было <w>настроение</w> её музыки, её фанаты всегда понимают посыл.",
                                "de": "Egal welche <w>Stimmung</w> ihre Musik vermittelt, ihre Fans verstehen immer die Botschaft.",
                                "zh": "无论她的音乐是什么<w>基调</w>，粉丝们总能领会其中的含义。"
                            }
                        }
                    ],
                    "synonyms": [
                        "vibe"
                    ],
                    "common_phrases": [
                        "somber mood",
                        "romantic mood"
                    ],
                    "target_lang_definitions": {
                        "ru": "Эмоциональный характер или атмосфера произведения искусства, музыки или литературы.",
                        "de": "Der emotionale Charakter oder die Atmosphäre eines Kunstwerks, eines Musikstücks oder eines literarischen Werks.",
                        "zh": "艺术、音乐或文学作品所传达的情感基调或氛围。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "настроение",
                                "target_lang_sense_clarification": "эмоциональный фон произведения"
                            },
                            {
                                "target_lang_word": "атмосфера",
                                "target_lang_sense_clarification": "дух произведения"
                            },
                            {
                                "target_lang_word": "тональность",
                                "target_lang_sense_clarification": "характер произведения"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Stimmung",
                                "target_lang_sense_clarification": "emotionaler Grundton eines Werks"
                            },
                            {
                                "target_lang_word": "Atmosphäre",
                                "target_lang_sense_clarification": "die durch ein Werk erzeugte Wirkung"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "基调",
                                "target_lang_sense_clarification": "作品的情感色彩"
                            },
                            {
                                "target_lang_word": "氛围",
                                "target_lang_sense_clarification": "作品营造的意境"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b8b448d6-23e0-321e-99cc-6d40e8e2d7d5",
                    "sense_definition": "A period of being angry, sullen, or gloomy.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotional state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is in a <w>mood</w> with me today and refuses to answer my calls.",
                            "target_lang_translations": {
                                "ru": "Он сегодня не в <w>духе</w> и отказывается отвечать на мои звонки.",
                                "de": "Er ist heute schlecht auf mich zu sprechen und weigert sich, meine Anrufe anzunehmen.",
                                "zh": "他今天在跟我<w>闹情绪</w>，拒绝接听我的电话。"
                            }
                        },
                        {
                            "text": "Don't mind him; he's just in one of his <w>moods</w> again.",
                            "target_lang_translations": {
                                "ru": "Не обращай на него внимания, у него просто опять плохое <w>настроение</w>.",
                                "de": "Beachte ihn nicht; er hat nur wieder eine seiner <w>Launen</w>.",
                                "zh": "别理他，他又在<w>闹情绪</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "huff",
                        "pet",
                        "temper"
                    ],
                    "antonyms": [
                        "good humour",
                        "good mood",
                        "good spirits"
                    ],
                    "common_phrases": [
                        "in a mood"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used with 'in a' to imply a negative state"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Период гнева, угрюмости или уныния.",
                        "de": "Eine Phase von Ärger, Griesgrämigkeit oder Niedergeschlagenheit.",
                        "zh": "一段感到愤怒、郁闷或阴郁的时期。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плохое настроение",
                                "target_lang_sense_clarification": "состояние раздражения"
                            },
                            {
                                "target_lang_word": "дурное расположение духа",
                                "target_lang_sense_clarification": "угрюмость"
                            },
                            {
                                "target_lang_word": "каприз",
                                "target_lang_sense_clarification": "переменчивое состояние"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "schlechte Laune",
                                "target_lang_sense_clarification": "Zustand von Gereiztheit"
                            },
                            {
                                "target_lang_word": "Missmut",
                                "target_lang_sense_clarification": "Gefühl von Unzufriedenheit oder Griesgrämigkeit"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "闹情绪",
                                "target_lang_sense_clarification": "表现出不满或任性"
                            },
                            {
                                "target_lang_word": "坏脾气",
                                "target_lang_sense_clarification": "易怒或郁闷的状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7ef6e9bc-666c-3283-be2a-e3f1458deac2",
                    "sense_definition": "A specific feeling, experience, or aesthetic that is highly relatable or captures a particular moment.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "slang usage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Staying in bed all Sunday with a box of pizza is a whole <w>mood</w>.",
                            "target_lang_translations": {
                                "ru": "Пролежать в постели всё воскресенье с коробкой пиццы — это целое <w>настроение</w>.",
                                "de": "Den ganzen Sonntag mit einer Pizza im Bett zu bleiben, ist ein echtes <w>Lebensgefühl</w>.",
                                "zh": "周日整天躺在床上吃披萨，简直太有<w>共鸣</w>了。"
                            }
                        },
                        {
                            "text": "I think I can speak for us all when I say this shirt is a <w>mood</w>.",
                            "target_lang_translations": {
                                "ru": "Думаю, я выражу общее мнение, если скажу, что эта рубашка — просто <w>вайб</w>.",
                                "de": "Ich glaube, ich spreche für uns alle, wenn ich sage, dass dieses Shirt einfach ein <w>Vibe</w> ist.",
                                "zh": "我想我能代表大家说，这件衬衫简直太有<w>氛围感</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "vibe",
                        "big mood"
                    ],
                    "common_phrases": [
                        "whole mood"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Common in internet culture"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Специфическое чувство, опыт или эстетика, которые очень близки кому-то или точно передают момент.",
                        "de": "Ein spezifisches Gefühl, Erlebnis oder eine Ästhetik, die sehr nachvollziehbar ist oder einen bestimmten Moment einfängt.",
                        "zh": "一种极具共鸣感或能捕捉特定瞬间的感受、体验或审美。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вайб",
                                "target_lang_sense_clarification": "сленг: атмосфера или состояние"
                            },
                            {
                                "target_lang_word": "жиза",
                                "target_lang_sense_clarification": "сленг: узнаваемая ситуация"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Vibe",
                                "target_lang_sense_clarification": "umgangssprachlich für Atmosphäre oder Lebensgefühl"
                            },
                            {
                                "target_lang_word": "Stimmung",
                                "target_lang_sense_clarification": "im Sinne eines treffenden Lebensgefühls"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "共鸣",
                                "target_lang_sense_clarification": "引起强烈心理认同"
                            },
                            {
                                "target_lang_word": "氛围感",
                                "target_lang_sense_clarification": "网络用语，指某种特定的意境"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b593abdb-d3e6-3b9d-8cf4-553df05ee842",
                    "sense_definition": "A category of verb forms used to indicate the speaker's attitude toward the factuality or likelihood of what is being said.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "grammar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The indicative <w>mood</w> is the most frequently encountered verb form in English.",
                            "target_lang_translations": {
                                "ru": "Изъявительное <w>наклонение</w> — самая часто встречающаяся форма глагола в английском языке.",
                                "de": "Der Indikativ ist der im Englischen am häufigsten vorkommende <w>Modus</w>.",
                                "zh": "陈述<w>语气</w>是英语中最常见的动词形式。"
                            }
                        },
                        {
                            "text": "In the sentence 'If I were you', the verb is in the subjunctive <w>mood</w>.",
                            "target_lang_translations": {
                                "ru": "В предложении «If I were you» глагол стоит в сослагательном <w>наклонении</w>.",
                                "de": "Im Satz 'If I were you' steht das Verb im Konjunktiv <w>Modus</w>.",
                                "zh": "在“If I were you”这句话中，动词使用的是虚拟<w>语气</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "grammatical mood",
                        "mode"
                    ],
                    "common_phrases": [
                        "subjunctive mood",
                        "indicative mood",
                        "imperative mood"
                    ],
                    "target_lang_definitions": {
                        "ru": "Категория глагольных форм, используемая для обозначения отношения говорящего к фактичности или вероятности сказанного.",
                        "de": "Eine Kategorie von Verbformen, die die Einstellung des Sprechers zur Faktizität oder Wahrscheinlichkeit des Gesagten ausdrückt.",
                        "zh": "动词的一种语法范畴，用于表示说话人对所说内容的事实性或可能性的态度。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наклонение",
                                "target_lang_sense_clarification": "грамматическая категория"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Modus",
                                "target_lang_sense_clarification": "grammatische Kategorie"
                            },
                            {
                                "target_lang_word": "Aussageweise",
                                "target_lang_sense_clarification": "grammatischer Fachbegriff"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "语气",
                                "target_lang_sense_clarification": "语法中的动词形式"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "f70df70b-a860-383b-bfb1-f37ab3a05944",
                    "sense_definition": "An exclamation used to indicate that the speaker finds a situation or feeling very relatable.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "slang usage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "—I am feeling very exhausted today. —<w>Mood</w>.",
                            "target_lang_translations": {
                                "ru": "— Я сегодня чувствую себя очень истощённым. — <w>Жиза</w>.",
                                "de": "— Ich fühle mich heute sehr erschöpft. — Fühle ich.",
                                "zh": "—我今天感觉精疲力竭。—<w>真实</w>。"
                            }
                        },
                        {
                            "text": "When she said she just wanted to sleep for a week, I thought, '<w>Mood</w>.'",
