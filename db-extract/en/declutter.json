                    {
                        "translation_id": "f073233e-0339-4921-a1c7-773ec17acf7f",
                        "source_entry_id": "40932fec-7524-3081-8d81-988694589215",
                        "source_sense_id": "4210cb44-b5e5-357f-b4a2-3bbe42be73ca",
                        "source_sense_description": "Translations",
                        "target_lang_word": "désencombrer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
