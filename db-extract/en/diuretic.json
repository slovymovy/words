                "senses": [
                    {
                        "sense_id": "a3fa0f8e-d997-3ab6-9954-cc493a424557",
                        "entry_id": "122a0437-bd09-3cc3-aad6-9f8aa21c724f",
                        "glosses": [
                            "Increasing the amount or frequency of urination."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dca1c2ac-4eae-4776-a575-5da240e4b9e3",
                                "sense_id": "a3fa0f8e-d997-3ab6-9954-cc493a424557",
                                "text": "Blackcurrant leaf has a diuretic action [11,12,14], therefore it should not be taken concurrently with diuretics indicated for cardiac or renal insufficiency except on medical advice."
                            },
                            {
                                "example_id": "e3452d6b-8b27-47af-8089-db6f319e8539",
                                "sense_id": "a3fa0f8e-d997-3ab6-9954-cc493a424557",
                                "text": "Further experiments are needed to elaborate the exact mechanisms of the hypotensive and diuretic effects of diterpene kaurenoids."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5818b845-13fa-4272-9cd4-a92ab392725a",
                        "source_entry_id": "122a0437-bd09-3cc3-aad6-9f8aa21c724f",
