                "senses": [
                    {
                        "sense_id": "52ea94ae-22bb-3ab2-96d4-458ef321823c",
                        "entry_id": "d815d18b-558a-35f4-9f8d-fde7f0695b16",
                        "glosses": [
                            "To convene, to cause to assemble for a meeting."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "7e19b03a-edab-4475-b569-65dbd8f40099",
                                "sense_id": "52ea94ae-22bb-3ab2-96d4-458ef321823c",
                                "text": "Hail thou,—of leisure sweet the sire!—\nWho, round the bright, domestic fire,\nDost link fond hearts in strongest ties,\nAnd kindle hopes, and mingle sighs,\nOr 'neath the taper's glancing light\nConvoke the banquet's festive rite."
                            },
                            {
                                "example_id": "614f1f5f-3e13-4b96-a8a6-9331d5430d36",
                                "sense_id": "52ea94ae-22bb-3ab2-96d4-458ef321823c",
                                "text": "The dream makes such an impression on the king that he convokes his council of state, whose members are thoroughly alarmed by his report."
                            }
                        ]
                    },
                    {
                        "sense_id": "0491ddd2-9a67-3f6d-888d-89d724ef9ff4",
                        "entry_id": "d815d18b-558a-35f4-9f8d-fde7f0695b16",
                        "glosses": [
                            "To call together."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "58471722-9b98-494b-b047-417044662689",
                        "source_entry_id": "d815d18b-558a-35f4-9f8d-fde7f0695b16",
                        "source_sense_description": "convene",
                        "target_lang_word": "einberufen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "einberufen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b03ea929-40cf-3b7d-b133-f789db24bc0a",
                                        "entry_id": "a539973b-e247-3285-9286-9c7b3ad714ad",
                                        "glosses": [
                                            "(eine Versammlung) zusammenkommen lassen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e46c894a-57a8-44a4-9ea3-ad7aa605bdd4",
                                                "sense_id": "b03ea929-40cf-3b7d-b133-f789db24bc0a",
                                                "text": "Mitte des Monats wird eine Sondersitzung einberufen."
                                            },
                                            {
                                                "example_id": "b762435e-226e-4b64-a1fe-d85828f34c46",
                                                "sense_id": "b03ea929-40cf-3b7d-b133-f789db24bc0a",
                                                "text": "„Aus besonderen Anlässen können zur Erreichung bestimmter Ziele auch andere Lehrerkonferenzen, wie zB Konferenzen der Lehrer für einen Unterrichtsgegenstand, einberufen werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d8af5017-698b-30cd-80e5-39e7914eec4d",
                                        "entry_id": "a539973b-e247-3285-9286-9c7b3ad714ad",
                                        "glosses": [
                                            "jemanden amtlich zum Militärdienst verpflichten"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f556120e-4432-46ac-9be1-ad8b3cddfed8",
                                                "sense_id": "d8af5017-698b-30cd-80e5-39e7914eec4d",
                                                "text": "Bereits mit 16 Jahren wurde er ins Heer einberufen."
                                            },
                                            {
                                                "example_id": "95a969f6-46d8-446f-a29a-219761fd82ba",
                                                "sense_id": "d8af5017-698b-30cd-80e5-39e7914eec4d",
                                                "text": "„In das Bundesheer dürfen nur österreichische Staatsbürger einberufen werden, die das 18. Lebensjahr vollendet haben und die notwendige körperliche und geistige Eignung für eine im Bundesheer in Betracht kommende Verwendung besitzen.“"
                                            },
                                            {
                                                "example_id": "00f19544-2c9a-4699-85cc-314f16a60a78",
                                                "sense_id": "d8af5017-698b-30cd-80e5-39e7914eec4d",
                                                "text": "[Russlands Krieg gegen die Ukraine 2022:] „Seit Beginn der Teilmobilmachung in Russland sind viele Männer im wehrfähigen Alter ins Ausland geflohen, damit sie nicht zum Krieg gegen die Ukraine einberufen werden.“"
                                            },
                                            {
                                                "example_id": "55045d63-5257-42bb-8007-824fcbe3b19a",
                                                "sense_id": "d8af5017-698b-30cd-80e5-39e7914eec4d",
                                                "text": "[Russlands Krieg gegen die Ukraine 2022:] „Als die Teilmobilmachung von Wladimir Putin angeordnet wurde, dachte Olga aus Murmask im hohen Norden sofort, dass es nicht dabei bleibe und man alle Wehrfähigen einberufen werde.“"
                                            },
                                            {
                                                "example_id": "fe9fd39a-6b4b-46af-9b7b-5fe88f437b38",
                                                "sense_id": "d8af5017-698b-30cd-80e5-39e7914eec4d",
                                                "text": "[Russlands Krieg gegen die Ukraine 2022:] „»Gut, dass er nun weg ist. Wenigstens mache ich mir jetzt keine Sorgen mehr, dass sie ihn erwischen und einberufen«, gibt Olga zu.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc04df87-cb6c-4fb0-8b8b-69cc99a0dd46",
