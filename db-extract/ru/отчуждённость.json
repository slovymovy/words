                    {
                        "sense_id": "87f339f5-e40c-3c88-94bc-b8ea88db7bb6",
                        "entry_id": "453a98cf-f9a6-33f5-a974-41289ecf355f",
                        "glosses": [
                            "свойство по значению прилагательного отчуждённый"
                        ],
                        "tags": [],
