                                        "entry_id": "60b62030-61cf-37bb-a955-d14d9b44d353",
                                        "glosses": [
                                            "A peer; an aristocrat; ranks range from baron to king to emperor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc1c4fa8-552c-4080-abfd-b985797861df",
                                                "sense_id": "ae760865-e2f8-35e0-82d5-535c8cc0fd33",
                                                "text": "The King [...] sit at the head of the royal table with his elder warriors and advisers, noblemen and noblewomen."
                                            }
                                        ]
