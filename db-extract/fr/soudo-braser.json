                        "glosses": [
                            "Assembler par soudo-brasage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b02b4097-7e40-4954-bf44-6506ce3c5657",
                                "sense_id": "5e82aa4b-fa83-317f-8d9f-57d6e1b162ce",
                                "text": "Soudo-braser consiste à assembler deux pièces métalliques par l’intermédiaire d'un joint de métal, la soudure ou la brasure, fondue entre les deux parties à réunir."
                            },
                            {
                                "example_id": "6e5250d8-8100-49f1-8a4f-fc1afadfaf73",
                                "sense_id": "5e82aa4b-fa83-317f-8d9f-57d6e1b162ce",
                                "text": "Elles peuvent se soudo-braser, c’est-à-dire s’assembler avec du laiton spécial."
                            }
                        ]
                    }
