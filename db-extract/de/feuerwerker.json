                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72fc0e6f-6a7e-49c6-bb4b-e4b39e49b683",
                                "sense_id": "35367335-7d05-37d3-adb8-a3e50da41da8",
                                "text": "„Mit riesigen Leuchtfontänen am höchsten Haus der Welt begrüßten die Einwohner der taiwanesischen Hauptstadt Taipeh das Jahr 2007. Feuerwerker hatten am 508 Meter hohen Taipeh 101 Leuchteffekte installiert und um 17 MEZ auf die Sekunde genau gezündet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
