                        "target_lang_word": "Strafpredigt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Strafpredigt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a4980adb-4e9e-3524-88f9-db3588c628d6",
                                        "entry_id": "f93c68ab-73a4-304b-b5c4-295ffb9fe25e",
                                        "glosses": [
                                            "eine Rede oder Ansprache, bei der jemand heftig kritisiert wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3126cea7-ef24-4a13-9008-e648cd1f763f",
                                                "sense_id": "a4980adb-4e9e-3524-88f9-db3588c628d6",
                                                "text": "„Eine zornige Strafpredigt ergoss sich über ihn.“"
                                            },
                                            {
                                                "example_id": "77a24a75-5d54-4b93-be42-d3623279187d",
                                                "sense_id": "a4980adb-4e9e-3524-88f9-db3588c628d6",
                                                "text": "„Die Offiziere kamen nun zurück und hielten uns eine Strafpredigt.“"
                                            },
                                            {
                                                "example_id": "2bea5211-7599-402d-a67f-03c2ceb9474d",
                                                "sense_id": "a4980adb-4e9e-3524-88f9-db3588c628d6",
                                                "text": "„Im Beisein aller unserer Kameraden hielt uns darauf der Rektor eine kleine Strafpredigt; dann gebot er seinen Schergen, die hinter uns standen, seinen Befehl zu vollstrecken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
