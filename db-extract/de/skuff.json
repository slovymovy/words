                    {
                        "translation_id": "c63da681-d5c0-40d9-a318-c78db3ec6ade",
                        "source_entry_id": "fde3b010-447f-30a8-b6c0-a092a0eefd0e",
                        "source_sense_id": "60ba229b-68ed-31ca-a1b5-8b1125ee6718",
                        "source_sense_description": "durch trockene Siebungen von Marihuana gewonnenes Harzpulver",
                        "target_lang_word": "kif",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kif",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "67a816f9-9305-30b5-aa75-83febe7418ed",
                                        "entry_id": "958b381c-a730-3847-858e-699e2e561eb9",
                                        "glosses": [
                                            "A kind of cannabis smoked in Morocco and Algeria, for narcotic or intoxicating effect."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9fb87f33-0ff0-43f0-886a-330f035e4f66",
                                                "sense_id": "67a816f9-9305-30b5-aa75-83febe7418ed",
                                                "text": "‘Some taxi driver, a Maghrebian…he suddenly swerved. They smoke kief, you know.’"
                                            },
                                            {
                                                "example_id": "fbb53db5-3584-4764-abeb-ffe4b7de3c6f",
                                                "sense_id": "67a816f9-9305-30b5-aa75-83febe7418ed",
                                                "text": "The kief, which is the flower and seeds of the plant, is the strongest, and a pipe of it half the size of a common English tobacco-pipe, is sufficient to intoxicate."
                                            },
                                            {
                                                "example_id": "fab19cf6-9952-4a0a-89f5-937947d32068",
                                                "sense_id": "67a816f9-9305-30b5-aa75-83febe7418ed",
                                                "text": "I perceived the odour of kif, and recognised the voices of Selam the Second, Abd-el-Rhaman, and others; it was an Arab orgie in full swing."
                                            },
                                            {
                                                "example_id": "9a5b2583-277f-4318-8146-187377285957",
                                                "sense_id": "67a816f9-9305-30b5-aa75-83febe7418ed",
                                                "text": "The trade goods – Persian rugs, salt, muskets, kif – trailed out behind them over the dunes, still lashed to the backs of rotting animals."
                                            },
                                            {
                                                "example_id": "fb37e499-56f0-4258-b465-8a09863f11b1",
                                                "sense_id": "67a816f9-9305-30b5-aa75-83febe7418ed",
                                                "text": "[…]then hung around the special Silver-Key-Members’ Lounge with the other ladies[…]smoking kif and making extremely delicate and oblique fun of their husbands’ sexual idiosyncrasies, […]"
                                            },
                                            {
                                                "example_id": "17e04401-a862-4a03-9cf4-10a30412e1cc",
                                                "sense_id": "67a816f9-9305-30b5-aa75-83febe7418ed",
                                                "text": "Kif melts the brain; dexemyl sharpens the edges. (Kif makes you drift—makes you forget what someone said a minute before–hard to follow a long story or joke, […])"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca84c98f-63d3-3e37-831c-b032ffa44c05",
                                        "entry_id": "958b381c-a730-3847-858e-699e2e561eb9",
                                        "glosses": [
                                            "The state of relaxed stupor induced by cannabis."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
