                "senses": [
                    {
                        "sense_id": "a913c4f5-3e16-3b0a-a4ef-2b05f526825d",
                        "entry_id": "47b98f38-75f6-338e-bf70-2ba7c852e9c2",
                        "glosses": [
                            "een omlijsting om werkstukken van slappe materialen (textiel) ter bewerking op te spannen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a782363-e774-4284-8710-6a191edf5f58",
                                "sense_id": "a913c4f5-3e16-3b0a-a4ef-2b05f526825d",
                                "text": "Het raamwerk is voorzien van spieën om het doek na te spannen."
                            }
                        ]
                    },
                    {
                        "sense_id": "50168729-7d3d-3d2c-ad50-c80aa45c86ea",
                        "entry_id": "47b98f38-75f6-338e-bf70-2ba7c852e9c2",
                        "glosses": [
                            "een lichte, open maar stevige constructie van buizen of balken waar onderdelen aan vastgezet kunnen worden, die in een stabiele onderlinge positie moeten blijven"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "0a05ef81-9935-3a3a-ae62-d87cde68a6c8",
                        "entry_id": "47b98f38-75f6-338e-bf70-2ba7c852e9c2",
                        "glosses": [
                            "een in een muur verankerde constructie van balken waarin de ramen en deuren zijn gemonteerd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cae370d1-2639-4390-9066-5219616f9847",
                                "sense_id": "0a05ef81-9935-3a3a-ae62-d87cde68a6c8",
                                "text": "In het raamwerk is slechts één bovenlicht voorzien."
                            }
                        ]
                    },
                    {
                        "sense_id": "81788399-0311-3870-9769-32bdd008faaf",
                        "entry_id": "47b98f38-75f6-338e-bf70-2ba7c852e9c2",
                        "glosses": [
                            "een structuur die nog moet worden ingevuld, maar waarvan de begrenzing van het geheel, en het onderlinge verband van onderdelen, reeds is vastgesteld"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "61963193-c358-4ed0-a3d7-f432d5653539",
                                "sense_id": "81788399-0311-3870-9769-32bdd008faaf",
                                "text": "De commissie heeft een raamwerk als basis voor de nieuwe regeling, opgesteld."
                            }
                        ]
                    }
