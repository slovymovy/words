                        "glosses": [
                            "Donner un caractère surhumain à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b6bf39c-a949-48be-a39a-6298c4704319",
                                "sense_id": "4af5ef7c-2587-389f-9c00-8da5bd07dc64",
                                "text": "ll rêve de sur-humaniser une humanité errante, frappée du sceau de la détresse."
                            },
                            {
                                "example_id": "593c1c2e-462d-4e9d-9b83-ca2d55a18be4",
                                "sense_id": "4af5ef7c-2587-389f-9c00-8da5bd07dc64",
                                "text": "Tout de même, je crois que l’auteur, ici, force légèrement la note, dépasse la mesure; et qu’à vouloir généraliser sur soi-même, un personnage risque parfois de se sur-humaniser, ou dé-féminiser, comme l’on voudra."
                            }
                        ]
