                ],
                "senses": [
                    {
                        "sense_id": "4bd6e939-6f33-349a-9704-679877c7c09b",
                        "entry_id": "7d66cbcb-ef35-36ba-89e2-76f70d06a7ea",
                        "glosses": [
                            "Migration/Umzug der Landbevölkerung in urbane/städtische Gebiete"
                        ],
                        "tags": [
                            "Soziologie"
                        ],
                        "examples": [
                            {
                                "example_id": "dfba38c5-6235-44b0-8de8-c74b97bf8f6a",
                                "sense_id": "4bd6e939-6f33-349a-9704-679877c7c09b",
                                "text": "„Unter dem Begriff Landflucht wird man im wesentlichen den Uebergang von Menschen, die in der Landwirtschaft erwerbstätig sind, zu anderen, nichtlandwirtschaftlichen Berufen erblicken.“"
                            },
                            {
                                "example_id": "56229fd0-647e-45da-a30a-54606f5f43a5",
                                "sense_id": "4bd6e939-6f33-349a-9704-679877c7c09b",
                                "text": "„Während Dörfer im Umland der Großstädte prosperieren, leiden anderswo ganze Regionen massiv unter Landflucht, vor allem im Osten. Prognosen zufolge könnten manche Landkreise in Brandenburg bis 2035 fast ein Drittel der Bevölkerung verlieren.“"
                            },
                            {
                                "example_id": "8853ffb6-dece-42f7-91d9-f23a9b05ac24",
                                "sense_id": "4bd6e939-6f33-349a-9704-679877c7c09b",
                                "text": "„Viele von ihnen begehen Landflucht und ziehen in die Stadt, in der Hoffnung auf ein wirtschaftlich und sozial besseres Leben. Das Gegenteil trifft jedoch ein. Die Armenviertel in den Vororten der Großstädte wachsen unaufhaltsam.“"
                            },
                            {
                                "example_id": "12629fbb-839f-4d72-9224-b27af27fd7f4",
                                "sense_id": "4bd6e939-6f33-349a-9704-679877c7c09b",
                                "text": "„Landfluchten aus bestimmten Regionen habe es zwar auch im 19. und 20. Jahrhundert gegeben, ohne dass dies ‚zu einem völligen Desaster geführt hat‘.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6770fed4-cdbf-40f0-81d3-860ce09b4619",
                        "source_entry_id": "7d66cbcb-ef35-36ba-89e2-76f70d06a7ea",
                        "source_sense_id": "4bd6e939-6f33-349a-9704-679877c7c09b",
                        "source_sense_description": "Soziologie: Migration/Umzug der Landbevölkerung in urbane/städtische Gebiete",
                        "target_lang_word": "exode rural",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exode rural",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e70e861a-097d-3d13-a68e-70dc0f86381b",
                                        "entry_id": "79fb5819-2dc4-3115-bd03-d73d80c79a41",
                                        "glosses": [
                                            "Déplacement de population des zones rurales vers les zones urbaines."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83253ee6-bfee-4859-bfc4-4a6ddfc5c02b",
                                                "sense_id": "e70e861a-097d-3d13-a68e-70dc0f86381b",
                                                "text": "Résumons-nous : l’homme ne peut pas se passer de la ville. Sans elle l’exode rural n’aurait pas de débouché."
                                            },
                                            {
                                                "example_id": "05716cf0-ca9f-47bc-b98c-2e99abe2267c",
                                                "sense_id": "e70e861a-097d-3d13-a68e-70dc0f86381b",
                                                "text": "L’exode rural et les premières vagues de la modernisation rompent l'équilibre démographique et social : à nouveau les campagnes se vident au profit des villes (la population rurale passe de 47,6 % de la population française en 1936 à 37,4 % en 1962) et deviennent de plus en plus agricoles."
                                            },
                                            {
                                                "example_id": "3f2aee8b-2856-44a0-844e-6ee5ae5c915d",
                                                "sense_id": "e70e861a-097d-3d13-a68e-70dc0f86381b",
                                                "text": "La plus massive des migrations intérieures a été au XIXᵉ siècle pour les PID et au XXᵉ pour les PVD l’exode rural. Ce mouvement des campagnes vers les villes se poursuit encore aujourd’hui dans nombre de pays des Suds alors même qu’il a tendance à s’inverser dans les pays du Nord."
                                            },
                                            {
                                                "example_id": "22906e69-502b-42ee-9871-351aaf3e1cc7",
                                                "sense_id": "e70e861a-097d-3d13-a68e-70dc0f86381b",
                                                "text": "Ainsi, le lit de l'Oued Bouskoura à Casablanca a vu s'établir de nombreuses populations à la suite de vagues d’exodes ruraux, ou le quartier Koulima à Tétouan, situé dans un point bas régulièrement touché par les inondations."
                                            },
                                            {
                                                "example_id": "bf812ade-7e81-4cfd-b823-5386342f7b1b",
                                                "sense_id": "e70e861a-097d-3d13-a68e-70dc0f86381b",
                                                "text": "Les années 1920 sont marquées par un exode rural important qui préoccupe toujours plus les élites civiles et religieuses."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
