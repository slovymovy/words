                "senses": [
                    {
                        "sense_id": "bb2b462f-ab4a-3e87-bb88-949703cf6f4b",
                        "entry_id": "54e2e944-6aae-3c02-8c2b-278be4ba5331",
                        "glosses": [
                            "digitaler Arbeitsplatz in der persönlichen Wohnstätte"
                        ],
                        "tags": [
                            "Arbeitswelt",
                            "Plural selten"
                        ],
                        "examples": [
                            {
                                "example_id": "aeab9efb-2ed2-4a5e-9f76-f37789fbfcc1",
                                "sense_id": "bb2b462f-ab4a-3e87-bb88-949703cf6f4b",
                                "text": "Im Homeoffice kann man sich auch um die Familie kümmern."
                            },
                            {
                                "example_id": "9d3722a9-94a9-497b-afed-e909e032af2b",
                                "sense_id": "bb2b462f-ab4a-3e87-bb88-949703cf6f4b",
                                "text": "Im ehemaligen Kinderzimmer habe ich mir ein Homeoffice eingerichtet."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "452bb2bb-9d5b-364a-8668-4918747d38d7",
                        "entry_id": "54e2e944-6aae-3c02-8c2b-278be4ba5331",
                        "glosses": [
                            "Arbeitsform, bei welcher digital von der persönlichen Wohnstätte aus gearbeitet wird"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "6ecd6992-016b-49c3-9e6e-aea0d8f2bdd0",
                                "sense_id": "452bb2bb-9d5b-364a-8668-4918747d38d7",
                                "text": "Im Homeoffice kann man sich auch um die Familie kümmern."
                            },
                            {
                                "example_id": "156872e2-9c08-44f3-bfad-4b3a4d72e4ed",
                                "sense_id": "452bb2bb-9d5b-364a-8668-4918747d38d7",
                                "text": "Beim Homeoffice ist besondere Konzentration gefragt."
                            },
                            {
                                "example_id": "59fabd3d-3781-4f94-bca3-94877f55f5c4",
                                "sense_id": "452bb2bb-9d5b-364a-8668-4918747d38d7",
                                "text": "Viele Unternehmen bieten ihren Beschäftigten Homeoffice an."
                            },
                            {
                                "example_id": "a1d9f0cf-8a2e-4f13-87c6-87a319041a4a",
                                "sense_id": "452bb2bb-9d5b-364a-8668-4918747d38d7",
                                "text": "Bitte denken Sie daran, dass ich freitags immer im Homeoffice bin und hier in der Firma nicht erreichbar."
                            },
                            {
                                "example_id": "025f1380-b43f-4117-bbbe-705fc9140520",
                                "sense_id": "452bb2bb-9d5b-364a-8668-4918747d38d7",
                                "text": "„Der Fachbegriff für das umgangssprachliche Homeoffice ist also Telearbeit. Die Arbeitsstättenverordnung bestimmt nicht nur, dass der Arbeitgeber fest eingerichtete Computerarbeitsplätze, Möbel und sonstige Arbeitsmittel im Privatbereich der Beschäftigten einrichten muss, sondern der Chef muss außerdem eine wöchentliche Arbeitszeit und die Dauer des Homeoffice festlegen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ec46ebc8-54f8-42f5-9efa-fcba62294953",
                        "source_entry_id": "54e2e944-6aae-3c02-8c2b-278be4ba5331",
                        "source_sense_id": "bb2b462f-ab4a-3e87-bb88-949703cf6f4b",
                        "source_sense_description": "digitaler Arbeitsplatz in der persönlichen Wohnstätte",
                        "target_lang_word": "home office",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "home office",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f0a8d7c2-c446-34a8-afba-f5613ba15bf5",
                                        "entry_id": "2ae5492f-71e3-3d5a-ad86-143d82a18a68",
                                        "glosses": [
                                            "The headquarters of an organization."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72430c7a-bf16-4694-b412-479168c777a1",
                                                "sense_id": "f0a8d7c2-c446-34a8-afba-f5613ba15bf5",
                                                "text": "In this type of company, the development of capabilities and the decisions to diffuse them globally are essentially made in the company's home office."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5857c2ac-1c54-3e7a-b320-6e34d64e5099",
                                        "entry_id": "2ae5492f-71e3-3d5a-ad86-143d82a18a68",
                                        "glosses": [
                                            "A room, in a person's home, equipped as an office so that the person may work from home."
                                        ],
