                                            {
                                                "example_id": "58ae32e8-e616-4d9a-8ad6-0bb45d9fa331",
                                                "sense_id": "3b4dc62a-ccf1-3a24-978b-7efa8b4e2c4d",
                                                "text": "„Der Begriff der Antinomie läßt sich bis zu Plutarch und Quintilian zurückverfolgen, hat aber erst bei Kant seine philosophisch relevante Ausprägung gewonnen.“"
                                            },
                                            {
                                                "example_id": "514acd51-1ef7-429b-916f-871010972736",
                                                "sense_id": "3b4dc62a-ccf1-3a24-978b-7efa8b4e2c4d",
                                                "text": "„Es liegt nahe, sich zu fragen, ob man als Nichtbeteiligter in Bezug auf Extrembergsteigen überhaupt eine Meinung entwickeln kann, die relevant ist, als nie annähernd in diese Situationen Hineinversetzter.“"
                                            }
