                "senses": [
                    {
                        "sense_id": "c0eac674-9562-306b-9150-4f6525c904ff",
                        "entry_id": "368aeaf5-a323-3111-8f3c-8433512722bf",
                        "glosses": [
                            "расширение какого-либо явления, процесса или объекта до международного масштаба"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "157f015d-3da3-4940-8c49-a03f442eaffd",
                                "sense_id": "c0eac674-9562-306b-9150-4f6525c904ff",
                                "text": "Интернационализация торговли."
                            },
                            {
                                "example_id": "bead9cdb-f8b5-497a-9b23-ccb7255b53e4",
                                "sense_id": "c0eac674-9562-306b-9150-4f6525c904ff",
                                "text": "Интернационализация деятельности компании."
                            },
                            {
                                "example_id": "cd1e0fb3-6a2d-4a13-bf35-f956cb7c9d64",
                                "sense_id": "c0eac674-9562-306b-9150-4f6525c904ff",
                                "text": "Интернационализация преступности."
                            },
                            {
                                "example_id": "e474e391-4e85-470b-88ff-552f2eefbc11",
                                "sense_id": "c0eac674-9562-306b-9150-4f6525c904ff",
                                "text": "Происходит интернационализация конфликтов на этнической почве."
                            }
                        ]
                    },
                    {
                        "sense_id": "eef66aa0-8c1e-3060-a592-7a952cda1969",
                        "entry_id": "368aeaf5-a323-3111-8f3c-8433512722bf",
                        "glosses": [
                            "комп. добавление в программный продукт функций и настроек, которые в случае надобности позволят адаптировать его к языковым и культурным особенностям различных регионов"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "32bfc1cf-6052-4617-867a-8a2a8714d9cb",
                        "source_entry_id": "368aeaf5-a323-3111-8f3c-8433512722bf",
                        "target_lang_word": "internationalization",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "internationalization",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0f54798d-6387-3645-a505-6b16ac29a186",
                                        "entry_id": "1a9dfdf6-a259-39b2-abdc-1f74614c8f64",
                                        "glosses": [
                                            "The conversion of something in order to make it international."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a1a2e2e-b410-4871-9bd6-95e197f813f6",
                                                "sense_id": "0f54798d-6387-3645-a505-6b16ac29a186",
                                                "text": "Before the union of the Scottish Crown with that of England, it had for a brief period been united with that of France. On this occasion, a complete legal internationalization was effected."
                                            },
                                            {
                                                "example_id": "6b2d7536-8a37-44a9-95f6-f3f981758e05",
                                                "sense_id": "0f54798d-6387-3645-a505-6b16ac29a186",
                                                "text": "I must say that the Liverpool Chamber of Commerce looks upon this step towards international coinage as part of an internationalization of the weights, measures, and coins."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f54669ff-cc64-3c47-a359-bf3286cd163b",
                                        "entry_id": "1a9dfdf6-a259-39b2-abdc-1f74614c8f64",
                                        "glosses": [
                                            "The act or process of making a product suitable for international markets, typically by making text messages easily translatable and ensuring support of non-Latin character sets, languages, and regions."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "10b66eac-77ca-484b-ae93-a1b70b6b380b",
                        "source_entry_id": "368aeaf5-a323-3111-8f3c-8433512722bf",
                        "target_lang_word": "i18n",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "i18n",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "44dd6396-0770-33bd-9ee0-e8b3e5f9a0b3",
                                        "entry_id": "ce41cf90-2944-30fd-9119-8644cb446aaf",
                                        "glosses": [
                                            "Abbreviation of internationalization."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f39a0e1-589a-46bd-b32c-fe2ed13ea186",
                                                "sense_id": "44dd6396-0770-33bd-9ee0-e8b3e5f9a0b3",
                                                "text": "Don't convert between Unicode and other code pages/character sets. If you follow these two rules, you'll run into few I18N-related security issues; in fact, you can jump to the next chapter if these two rules hold true for your application!"
                                            },
                                            {
                                                "example_id": "1bab30f0-4d07-4c2d-8b87-6d21149ce148",
                                                "sense_id": "44dd6396-0770-33bd-9ee0-e8b3e5f9a0b3",
                                                "text": "After our tour through the translation components we can now make our Python code “i18n-aware”. A typical task is identifying all the places where a (Unicode) string needs to be turned into an i18n message or where the appropriate TAL […]"
                                            },
                                            {
                                                "example_id": "16999372-f49d-4208-bebb-4ba5c64f42f4",
                                                "sense_id": "44dd6396-0770-33bd-9ee0-e8b3e5f9a0b3",
                                                "text": "AngularJS comes with support for I18n and L10n for date, number, and currency. No surprises here!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5975cb83-4b38-43b0-ae2d-0472fe035103",
                        "source_entry_id": "368aeaf5-a323-3111-8f3c-8433512722bf",
                        "target_lang_word": "Internationalisierung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Internationalisierung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "26f15b9e-fc4d-39c5-9d52-2adf4bf57a36",
                                        "entry_id": "12700215-c5cf-3919-ab36-ade4b60b34cb",
                                        "glosses": [
                                            "Ausweitung von Handlungsmöglichkeiten über nationale Grenzen hinaus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df2d3ceb-88c2-4b0e-a729-30dc336fd2c5",
                                                "sense_id": "26f15b9e-fc4d-39c5-9d52-2adf4bf57a36",
                                                "text": "„Die zunehmende Globalisierung, geprägt durch die Internationalisierung des Arbeitsmarktes, führte dazu, dass die neue Lingua franca Englisch wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9a476a4a-571e-4c52-b01f-b413081e8120",
                        "source_entry_id": "368aeaf5-a323-3111-8f3c-8433512722bf",
                        "target_lang_word": "internationalisation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "internationalisation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "efc7c885-86bb-3604-aea8-47c7e47734dc",
                                        "entry_id": "a2055c26-04a6-34de-a8fc-339617664561",
                                        "glosses": [
                                            "Action d’internationaliser, ou résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7d20474-62f3-4d15-b22f-fda9fb4c7e0b",
                                                "sense_id": "efc7c885-86bb-3604-aea8-47c7e47734dc",
                                                "text": "À la lueur de ce que nous venons d’avancer, nous pourrions plutôt dire qu’il est le premier peintre florentin « déflorentinisé », son élève Sebastiano Galeotti accentuant ce processus d’internationalisation des manières."
                                            },
                                            {
                                                "example_id": "04568369-ab75-437e-9e9f-f2f5eaf01032",
                                                "sense_id": "efc7c885-86bb-3604-aea8-47c7e47734dc",
                                                "text": "Peu d’entreprises sont capables de réussir l’internationalisation de manière autonome."
                                            },
                                            {
                                                "example_id": "4bf4f9f6-8057-427b-ab5c-7d423078f980",
                                                "sense_id": "efc7c885-86bb-3604-aea8-47c7e47734dc",
                                                "text": "Plus largement, comme le souligne François Grin, professeur à l’université de Genève, l’ internationalisation est très régulièrement confondue avec anglicisation dans les pays traditionnellement non anglophones. Les représentations qui conduisent à cette mise en avant de la langue anglaise sont multiples : faciliter les échanges et les coopérations, rendre plus attractifs les établissements, attirer plus d’étudiants et contribuer à la circulation de connaissances scientifiques. Toutefois, ces effets potentiellement positifs à court terme sont susceptibles de provoquer des contreparties négatives à plus long terme qui font débat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "401ec79e-781d-379c-ba59-13f790384844",
                                        "entry_id": "a2055c26-04a6-34de-a8fc-339617664561",
                                        "glosses": [
                                            "Action d’internationaliser, ou résultat de cette action.",
                                            "Processus d’adaptation d'un logiciel qui permet notamment de le traduire pour le rendre disponible dans différentes langues, dans différents fuseaux horaires ou de prendre en compte différents référentiels culturels (par exemple, les différents séparateurs décimaux ou de milliers) sans nécessiter le développement d'une version spécifique à chaque marché ; également abrégé en i18n, en référence au nombre de lettres du mot."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05d989e3-f37c-4111-b3f1-15f02883d493",
                                                "sense_id": "401ec79e-781d-379c-ba59-13f790384844",
                                                "text": "C’est l’internationalisation de MS Windows et MS Word qui a permis cette réduction importante du nombre de versions et la possibilité pour Microsoft de publier en même temps des versions très différentes de ces produits […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
