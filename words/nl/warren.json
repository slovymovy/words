                {
                    "sense_id": "232097e6-af89-3197-a3d7-2be2ba7626ae",
                    "sense_definition": "In de war brengen of verstrikt doen raken.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "confusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De stormwind <w>warde</w> haar haren tot een grote kluwen.",
                            "target_lang_translations": {
                                "en": "The storm wind <w>tangled</w> her hair into a big clump.",
                                "ru": "Штормовой ветер <w>спутал</w> её волосы в большой колтун.",
                                "de": "Der Sturmwind <w>verwehte</w> ihre Haare zu einem einzigen großen Knäuel."
                            }
                        },
                        {
                            "text": "Zijn gedachten <w>warden</w> door de schokkende gebeurtenissen.",
                            "target_lang_translations": {
                                "en": "His thoughts were <w>confused</w> by the shocking events.",
                                "ru": "Его мысли <w>путались</w> из-за шокирующих событий.",
                                "de": "Seine Gedanken <w>gerieten in Verwirrung</w> durch die schockierenden Ereignisse."
                            }
                        }
                    ],
                    "synonyms": [
                        "verwarren",
                        "verstrikken"
                    ],
                    "antonyms": [
                        "ontwarren"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "het werkwoord wordt in deze vorm weinig meer gebruikt; 'verwarren' is gebruikelijker"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To confuse or cause to become entangled.",
                        "ru": "Приводить в беспорядок, запутывать (волосы, нити) или сбивать с толку (мысли).",
                        "de": "Durcheinanderbringen, verwirren oder verheddern."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to tangle",
                                "target_lang_sense_clarification": "to make hair or threads knotted"
                            },
                            {
                                "target_lang_word": "to confuse",
                                "target_lang_sense_clarification": "to make thoughts unclear"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "спутывать",
                                "target_lang_sense_clarification": "приводить в беспорядок (о волосах, нитках)"
                            },
                            {
                                "target_lang_word": "путать",
                                "target_lang_sense_clarification": "сбивать с толку, вносить неясность"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "verwirren",
                                "target_lang_sense_clarification": "Gedanken durcheinanderbringen"
                            },
                            {
                                "target_lang_word": "verheddern",
                                "target_lang_sense_clarification": "Haare oder Fäden verknoten"
                            },
                            {
                                "target_lang_word": "verwirren",
                                "target_lang_sense_clarification": "in Unordnung bringen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b1acf6af-fb9a-38d9-b86a-849ed90b92cb",
                    "sense_definition": "Gekaakte haring in zout rondwentelen.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fishery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De vissers <w>warden</w> de haringen vakkundig in de tonnen.",
                            "target_lang_translations": {
                                "en": "The fishermen skillfully <w>roused</w> the herrings in the barrels.",
                                "ru": "Рыбаки умело <w>пересыпали солью</w> сельдь в бочках.",
                                "de": "Die Fischer <w>salzten</w> die Heringe fachmännisch in den Fässern <w>ein</w>."
                            }
                        },
                        {
                            "text": "Na het kaken moet je de vis goed <w>warren</w> met zout.",
                            "target_lang_translations": {
                                "en": "After gutting, you must <w>mix</w> the fish well with salt.",
                                "ru": "После потрошения нужно хорошо <w>перемешать</w> рыбу с солью.",
                                "de": "Nach dem Kehlen muss man den Fisch gut mit Salz <w>durchmengen</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To roll gutted herring in salt.",
                        "ru": "Перемешивать или обваливать потрошеную сельдь в соли.",
                        "de": "Ausgenommenen Hering in Salz wälzen oder mengend einsalzen."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to rouse",
                                "target_lang_sense_clarification": "technical term for mixing herring with salt"
                            },
                            {
                                "target_lang_word": "to toss in salt",
                                "target_lang_sense_clarification": "culinary action"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "пересыпать солью",
                                "target_lang_sense_clarification": "технологический процесс обработки рыбы"
                            },
                            {
                                "target_lang_word": "обваливать в соли",
                                "target_lang_sense_clarification": "кулинарное действие"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "einsalzen",
                                "target_lang_sense_clarification": "Heringe mit Salz vermengen"
                            },
                            {
                                "target_lang_word": "in Salz wälzen",
                                "target_lang_sense_clarification": "Fisch beim Verarbeiten mit Salz bedecken"
                            }
                        ]
                    }
                }
            ]
