                        "examples": [
                            {
                                "example_id": "11e93e57-3c48-4cc6-9e4a-ad6e1a26cc54",
                                "sense_id": "26bd04a0-4039-357c-90a2-fc142f12cd53",
                                "text": "Bovendien wordt beklemtoond dat godsdienst en geloof voornamelijk een symbolische betekenis hebben. Ze zijn verwant aan poëzie, een talige verbeelding die zingeving oproept. Het levensgevoel wordt erdoor geprikkeld, maar het gaat niet om waarheid. Godsdienst creëert dan slechts een voorstellingswereld die ons helpt oriëntatie en houvast te vinden in de wisselvalligheden van het leven."
                            }
