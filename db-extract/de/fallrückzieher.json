                            {
                                "example_id": "7f7f1dba-1dcd-4747-b1dd-e28471882523",
                                "sense_id": "706ba7d4-7cbe-3162-b3e3-ea7f5b4347b0",
                                "text": "Eine Minute später wurde ein spektakulärer Fallrückzieher von Dirk Kuyt abgeblockt."
                            },
                            {
                                "example_id": "735e3472-54b3-4cb1-b10d-445434cdf89c",
                                "sense_id": "706ba7d4-7cbe-3162-b3e3-ea7f5b4347b0",
                                "text": "Per Fallrückzieher erzielt Preuß am 17. März 2007 den Siegtreffer gegen Bayern München."
                            },
                            {
                                "example_id": "e1adb901-1148-4e96-8077-27fb7bfbca2d",
                                "sense_id": "706ba7d4-7cbe-3162-b3e3-ea7f5b4347b0",
                                "text": "Für den FC04 hatten abermals Gerber, Andreas \"Zecke\" Neuendorf und Robert Braber mit einem Fallrückzieher weitere Chancen."
                            }
                        ],
                        "sense_index_json": "\"1\""
