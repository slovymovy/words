                ],
                "senses": [
                    {
                        "sense_id": "021f9ca9-071f-339a-9120-93063424d2bb",
                        "entry_id": "b5604289-8e9f-3875-87c3-02f162551d73",
                        "glosses": [
                            "Zweitplatzierung in einer Meisterschaft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23440018-0807-48ed-aea1-df256b7161fa",
                                "sense_id": "021f9ca9-071f-339a-9120-93063424d2bb",
                                "text": "„Zwei Jahre nach dem Wechsel feiern Schalke und Fischer mit der Vizemeisterschaft und dem Pokalsieg bereits die ersten Erfolge.“"
                            },
                            {
                                "example_id": "cac07426-79a4-4191-9ca1-69bb6e73d006",
                                "sense_id": "021f9ca9-071f-339a-9120-93063424d2bb",
                                "text": "„In den Jahren seit Heynckes' Abgang dümpelte Athletic meist im Mittelfeld, erreichte aber in der Saison 1997/98 mit der Vizemeisterschaft einen großen Erfolg.“"
                            },
                            {
                                "example_id": "85489a75-6598-452e-9eaf-fa2709b19c53",
                                "sense_id": "021f9ca9-071f-339a-9120-93063424d2bb",
                                "text": "„Während die kleineren jüdischen Vereine im Aufbau begriffen waren, feierte die Fußballabteilung der Hakoah mit der Vizemeisterschaft in der Saison 1921/22 ihren ersten großen Erfolg.“"
                            },
                            {
                                "example_id": "0a2c776e-b140-472f-940a-85f7cccdfd51",
                                "sense_id": "021f9ca9-071f-339a-9120-93063424d2bb",
                                "text": "„Ehe er zum FC Bayern kam, hatte er den 1. FC Köln zur Meisterschaft und Vizemeisterschaft geführt und damit seinen Ruf als Erfolgstrainer begründet.“"
                            },
                            {
                                "example_id": "61f3524f-013b-4e78-b171-e1fefd299235",
                                "sense_id": "021f9ca9-071f-339a-9120-93063424d2bb",
                                "text": "„Sportlich gipfelte der Erfolg in der Vizemeisterschaft und dem Finale der Champions League.“"
                            },
                            {
                                "example_id": "3e43e3bf-369d-4d15-b933-ba86827394c2",
                                "sense_id": "021f9ca9-071f-339a-9120-93063424d2bb",
                                "text": "„Sein größter Erfolg in Wolfsburg war der DFB-Pokalsieg im Jahr 2015 mit dem Sieg gegen Borussia Dortmund sowie die Vizemeisterschaft in der gleichen Saison hinter Rekordmeister FC Bayern München.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
