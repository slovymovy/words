                                "target_senses": [
                                    {
                                        "sense_id": "fc503832-863d-31be-a5e0-b4ea791012bc",
                                        "entry_id": "6394e94e-a128-3464-a2c3-41c4c9ffdcda",
                                        "glosses": [
                                            "Ville et commune du canton de Genève en Suisse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c49a7807-a1dc-41e1-9172-8e1eff0a20ad",
                                                "sense_id": "fc503832-863d-31be-a5e0-b4ea791012bc",
                                                "text": "Il y eut des plats à ravir la pensée !… des nouilles d’une délicatesse inédite, une féra de Genève à la vraie sauce genevoise, et une crème pour plum-pudding à étonner le fameux docteur qui l’a, dit-on, inventée à Londres."
                                            },
                                            {
                                                "example_id": "a5789cb5-5f1b-408f-808f-468f50ec0d47",
                                                "sense_id": "fc503832-863d-31be-a5e0-b4ea791012bc",
                                                "text": "Ce n’est pas seulement pour admirer le célèbre panorama du Mont-Blanc qu’il faut venir à Genève."
                                            },
                                            {
                                                "example_id": "a194a7c1-13cc-404f-a2eb-29a36f7ada10",
                                                "sense_id": "fc503832-863d-31be-a5e0-b4ea791012bc",
                                                "text": "Jacques Monceau de Tournai avait étudié à Genève en 1566 et y avait exercé le ministère ; appelé au pastorat d’Anvers, il vint visiter Lille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84aa8c24-92c0-3ff8-998c-481e89d94b4e",
                                        "entry_id": "6394e94e-a128-3464-a2c3-41c4c9ffdcda",
