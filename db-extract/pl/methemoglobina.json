                        "sense_id": "d4cc00d5-a191-36f1-ac4f-958dad3f82ac",
                        "entry_id": "ada99743-d446-3edf-8bee-b2191ec39cc4",
                        "glosses": [
                            "forma hemoglobiny zawierająca żelazo na trzecim stopniu utlenienia i niezdolna przez to do przenoszenia tlenu w organizmie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10e13e43-57ce-4f94-a5d1-2b183aa05433",
                                "sense_id": "d4cc00d5-a191-36f1-ac4f-958dad3f82ac",
                                "text": "W krwiobiegu NO łączy się chętnie z żelazem hemoglobiny tworząc methemoglobinę, która rozkłada się następnie z powrotem do hemoglobiny oraz nieaktywnych azotanów i azotynów, wydalanych następnie przez nerki."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
