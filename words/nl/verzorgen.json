                {
                    "sense_id": "e5f82bbe-e9b2-39cb-b3b0-a4d1bc605d8a",
                    "sense_definition": "erop toezien dat een persoon of een dier het nodige verkrijgt",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "zorg dragen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>verzorgde</w> de vissen in zijn aquarium altijd trouwhartig.",
                            "target_lang_translations": {
                                "en": "He always faithfully <w>looked after</w> the fish in his aquarium.",
                                "ru": "Он всегда преданно <w>ухаживал</w> за рыбками в своем аквариуме."
                            }
                        },
                        {
                            "text": "De verpleegster moet de zieke patiënt de hele dag goed <w>verzorgen</w>.",
                            "target_lang_translations": {
                                "en": "The nurse must <w>care for</w> the sick patient well all day long.",
                                "ru": "Медсестра должна хорошо <w>ухаживать</w> за больным пациентом весь день."
                            }
                        }
                    ],
                    "synonyms": [
                        "verplegen",
                        "zorgen voor"
                    ],
                    "antonyms": [
                        "verwaarlozen"
                    ],
                    "common_phrases": [
                        "een patiënt verzorgen",
                        "de planten verzorgen",
                        "een wond verzorgen"
                    ],
                    "target_lang_definitions": {
                        "en": "to ensure that a person or animal receives what is necessary; to look after or tend to someone or something",
                        "ru": "заботиться о ком-либо или чем-либо, обеспечивая необходимый уход и внимание"
                    },
