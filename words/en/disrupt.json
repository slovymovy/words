{
    "word_family": [
        "disruption",
        "disruptive",
        "disruptor"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5c6b7af7-ef00-3b52-a059-a19bc5af71b9",
                    "sense_definition": "To interrupt or impede the progress or normal flow of something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "interrupt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy snow began to <w>disrupt</w> travel across the entire country.",
                            "target_lang_translations": {
                                "ru": "Сильный снегопад начал <w>нарушать</w> транспортное сообщение по всей стране."
                            }
                        },
                        {
                            "text": "Irregular sleeping habits can <w>disrupt</w> services and affect your overall health.",
                            "target_lang_translations": {
                                "ru": "Нерегулярный сон может <w>сбивать</w> работу организма и влиять на ваше общее здоровье."
                            }
                        }
                    ],
                    "common_phrases": [
                        "disrupt services",
                        "disrupt travel",
                        "disrupt development"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прерывать или препятствовать прогрессу или нормальному течению чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нарушать",
                                "target_lang_sense_clarification": "нормальный ход процесса или движения"
                            },
                            {
                                "target_lang_word": "прерывать",
                                "target_lang_sense_clarification": "останавливать выполнение чего-либо"
                            },
                            {
                                "target_lang_word": "сбивать",
                                "target_lang_sense_clarification": "мешать ритму или графику"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "62c195ba-c48e-3675-b72a-67d7a2148d41",
                    "sense_definition": "To throw an event, system, or process into confusion or disorder.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "interrupt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A group of protesters tried to <w>disrupt</w> the meeting by shouting loudly.",
                            "target_lang_translations": {
                                "ru": "Группа протестующих пыталась <w>сорвать</w> собрание громкими выкриками."
                            }
                        },
                        {
                            "text": "Hecklers <w>disrupted</w> the speech and caused a great deal of confusion.",
                            "target_lang_translations": {
                                "ru": "Крикуны из толпы <w>прервали</w> речь и вызвали сильное замешательство."
                            }
                        }
                    ],
                    "synonyms": [
                        "dislocate"
                    ],
                    "common_phrases": [
                        "disrupt the meeting",
                        "disrupt the peace"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приводить мероприятие, систему или процесс в состояние замешательства или беспорядка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "срывать",
                                "target_lang_sense_clarification": "мероприятие или встречу"
                            },
                            {
                                "target_lang_word": "дезорганизовать",
                                "target_lang_sense_clarification": "вносить беспорядок в систему"
                            },
                            {
                                "target_lang_word": "вносить разлад",
                                "target_lang_sense_clarification": "нарушать спокойствие или порядок"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "10c07956-d904-333e-b9ab-ee25eaa5407f",
                    "sense_definition": "To change a traditional industry or market by using new technology or innovative business methods.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "innovation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "New startups often aim to <w>disrupt</w> the market with cheaper digital alternatives.",
                            "target_lang_translations": {
                                "ru": "Новые стартапы часто стремятся <w>взорвать</w> рынок более дешевыми цифровыми альтернативами."
                            }
                        },
                        {
                            "text": "The internet makes it easier for small companies to <w>disrupt</w> the industry and challenge big brands.",
                            "target_lang_translations": {
                                "ru": "Интернет упрощает небольшим компаниям задачу по <w>трансформации</w> индустрии и вызову крупным брендам."
                            }
                        }
                    ],
                    "common_phrases": [
                        "disrupt the market",
                        "disrupt the industry"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "business context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Изменять традиционную отрасль или рынок, используя новые технологии или инновационные методы ведения бизнеса."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "производить переворот",
                                "target_lang_sense_clarification": "в индустрии или на рынке"
                            },
                            {
                                "target_lang_word": "подрывать",
                                "target_lang_sense_clarification": "устоявшиеся рыночные модели"
                            },
                            {
                                "target_lang_word": "трансформировать",
                                "target_lang_sense_clarification": "радикально менять правила игры"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3abf53fa-8225-3b76-8cab-0516769a33ac",
                    "sense_definition": "Torn apart or severed; broken asunder.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "broken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The geologist examined the <w>disrupt</w> rock layers caused by the ancient earthquake.",
                            "target_lang_translations": {
                                "ru": "Геолог изучил <w>разорванные</w> слои породы, возникшие в результате древнего землетрясения."
                            }
                        },
                        {
                            "text": "In rare botanical descriptions, a <w>disrupt</w> leaf appears as if it were torn.",
                            "target_lang_translations": {
                                "ru": "В редких ботанических описаниях <w>рассеченный</w> лист выглядит так, будто он был разорван."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used as an adjective in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Разорванный на части или отделенный; разбитый вдребезги."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разорванный",
                                "target_lang_sense_clarification": "о слоях или структурах"
                            },
                            {
                                "target_lang_word": "разрушенный",
                                "target_lang_sense_clarification": "о геологических пластах"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}