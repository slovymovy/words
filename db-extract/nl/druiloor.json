                                                "sense_id": "96a7d88f-43f0-3613-8163-40b3eb89fc9f",
                                                "text": "Celui-là a tout d’un mollasson et rien d’un molosse comme Henri."
                                            }
                                        ]
                                    }
                                ]
                            }
