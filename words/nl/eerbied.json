    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "31744d93-ed8e-3cd4-923b-ea54695c3812",
                    "sense_definition": "Een diep gevoel van bewondering en ontzag voor iemand of iets.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "respect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij had veel <w>eerbied</w> voor de oude man vanwege zijn wijsheid.",
                            "target_lang_translations": {
                                "en": "He had great <w>respect</w> for the old man because of his wisdom."
                            }
                        },
                        {
                            "text": "De studenten toonden diepe <w>eerbied</w> tijdens de herdenkingsceremonie.",
                            "target_lang_translations": {
                                "en": "The students showed deep <w>reverence</w> during the memorial ceremony."
                            }
                        }
                    ],
                    "synonyms": [
                        "acht",
                        "hoogachting",
                        "respect"
                    ],
                    "antonyms": [
                        "minachting",
                        "oneerbiedigheid"
                    ],
                    "common_phrases": [
                        "diepe eerbied",
                        "eerbied tonen"
                    ],
                    "target_lang_definitions": {
                        "en": "A deep feeling of admiration and awe for someone or something."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "respect",
                                "target_lang_sense_clarification": "an attitude of consideration or high regard"
                            },
                            {
                                "target_lang_word": "reverence",
                                "target_lang_sense_clarification": "deep respect or veneration"
                            },
                            {
                                "target_lang_word": "veneration",
                                "target_lang_sense_clarification": "great respect; looking up to someone"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4a7bd8ad-722a-363f-aa43-5d913a9752ba",
                    "sense_definition": "De erkenning van de waarde of rechten van anderen; het handelen volgens bepaalde regels of waarden.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "respect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Uit <w>eerbied</w> voor de wet volgde hij alle instructies nauwkeurig op.",
                            "target_lang_translations": {
                                "en": "Out of <w>respect</w> for the law, he followed all instructions accurately."
                            }
                        },
                        {
                            "text": "Men moet <w>eerbied</w> voor de natuur hebben om haar te kunnen behouden.",
                            "target_lang_translations": {
                                "en": "One must have <w>regard</w> for nature in order to be able to preserve it."
                            }
                        }
                    ],
                    "synonyms": [
                        "eerbieding",
                        "respect"
                    ],
                    "antonyms": [
                        "schending"
                    ],
                    "common_phrases": [
                        "uit eerbied voor",
                        "met alle eerbied"
                    ],
                    "target_lang_definitions": {
                        "en": "The recognition of the value or rights of others; acting according to certain rules or values."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "respect",
                                "target_lang_sense_clarification": "observing a custom, rule, or right"
                            },
                            {
                                "target_lang_word": "regard",
                                "target_lang_sense_clarification": "attention to or consideration for something"
                            },
                            {
                                "target_lang_word": "deference",
                                "target_lang_sense_clarification": "polite submission and respect"
                            }
                        ]
                    }
                }
            ]
        }
    ]
