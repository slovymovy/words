                "senses": [
                    {
                        "sense_id": "ef730750-a55d-3b91-b141-9b0e4c7805d0",
                        "entry_id": "e8ab49ea-b68f-3725-9a2c-524b17d0cd1b",
                        "glosses": [
                            "En faveur de l’élargissement du droit de vote aux femmes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5670ea2-73be-4865-b38c-bf80c8ace4fd",
                                "sense_id": "ef730750-a55d-3b91-b141-9b0e4c7805d0",
                                "text": "La femme et le prolétaire : ce rapprochement, fréquent depuis Flora Tristan, vise ici à justifier la tactique suffragiste, en rappelant les conséquences pour les ouvriers de l’acquisition en 1848 de droit de vote."
                            },
                            {
                                "example_id": "85566a2b-664d-4c0a-b3ab-440e53834111",
                                "sense_id": "ef730750-a55d-3b91-b141-9b0e4c7805d0",
                                "text": "Le désir d’aider son prochain, quelque respectable qu’il soit, est une étape sur le chemin de la revendication suffragiste."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4c00ce2b-5279-4d84-a83d-4715b10b1dda",
                        "source_entry_id": "e8ab49ea-b68f-3725-9a2c-524b17d0cd1b",
                        "source_sense_id": "ef730750-a55d-3b91-b141-9b0e4c7805d0",
                        "target_lang_word": "suffragist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "suffragist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "813462e2-ad02-3741-99dc-621c4d01161e",
                                        "entry_id": "3e8adf13-071b-3c56-a284-08985b8a6a58",
                                        "glosses": [
                                            "A person who promotes suffrage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af52b54d-a8ab-44c2-8733-61f5d95245a7",
                                                "sense_id": "813462e2-ad02-3741-99dc-621c4d01161e",
                                                "text": "Other suffragists (like Susan B. Anthony and Alva Vanderbilt Belmont) and “suffragents” helped make the referendum a reality here. Ms. [Elaine] Weiss called New York “the linchpin” that put our country on the path to pass the 19th Amendment in 1920, granting women across the United States the right to vote."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e5a2b36-d9c0-3903-8c18-18de5795818e",
                                        "entry_id": "3e8adf13-071b-3c56-a284-08985b8a6a58",
                                        "glosses": [
                                            "One who votes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "suffragist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "64ce15db-f961-39ec-9674-17b086042700",
                                        "entry_id": "32e36c10-18a2-3e0e-98e4-96b6760df00a",
                                        "glosses": [
                                            "Of, relating to, or promoting suffrage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c69d90d4-cec6-4511-a38c-e89f605c0cf7",
                                                "sense_id": "64ce15db-f961-39ec-9674-17b086042700",
                                                "text": "On June 4 the first speech was made by Senator [James Wolcott] Wadsworth [Jr.] of New York, whose very clever attack upon suffragist tactics was followed by an appeal to the economic fears and prejudices of his own prosperous class: […]"
                                            },
                                            {
                                                "example_id": "1a3ae7bb-e612-4d8b-bbb4-45c062cfd78b",
                                                "sense_id": "64ce15db-f961-39ec-9674-17b086042700",
                                                "text": "She [Isabella Stewart Gardner] lived during one of the most tumultuous eras in American history, an era that included the Civil War, Reconstruction, the explosion of industrial capitalism and the rise of the socialist, trade-union, Populist, suffragist and transcendentalist movements."
                                            },
                                            {
                                                "example_id": "ad0f6332-06ba-4947-9a98-66add36fb986",
                                                "sense_id": "64ce15db-f961-39ec-9674-17b086042700",
                                                "text": "In examples that start from the nation’s earliest days — through suffragist movements, racial integration and the legalization of abortion — some of the biggest opponents of women’s rights have been women."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "65aa7a40-2f12-4b18-83f4-b1c3f783e371",
