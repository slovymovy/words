                                                "sense_id": "6f378a5b-9611-3eea-b28e-4b7733d0abef",
                                                "text": "Xenia Robertson, formerly known as Xenia Isaamov, is from Ukraine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c161545-c00f-3c79-8913-eeedf626bc30",
                                        "entry_id": "ce83b181-883c-3f84-9e01-088129f201e8",
                                        "glosses": [
                                            "previously; once"
                                        ],
