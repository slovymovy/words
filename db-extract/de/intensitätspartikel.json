                        "glosses": [
                            "eine Klasse der Partikeln, die den Intensitätsgrad einer Eigenschaft oder eines Sachverhalts ausdrückt."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c3c5d45-d886-46f2-815c-83b74894ebfa",
                                "sense_id": "5a661bee-0c27-3264-b803-13c39351f300",
                                "text": "Der Begriff Intensitätspartikel wird in Duden. Die Grammatik. (2005) als bedeutungsgleich mit Steigerungspartikel und Gradpartikel dargestellt."
                            },
                            {
                                "example_id": "f8d1c577-727c-46f5-9ff1-0c718371f6eb",
                                "sense_id": "5a661bee-0c27-3264-b803-13c39351f300",
                                "text": "Zu den Intensitätspartikeln gehören u.a. \"sehr\", \"wenig\", \"einigermaßen\", \"überaus\"."
                            }
                        ],
