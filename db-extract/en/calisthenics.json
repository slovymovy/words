                        "glosses": [
                            "Physical exercises with the participation of a multitude of muscles and often minimal equipment (thus, usually bodyweight exercises); strength training aspects and cardio aspects are both involved, and stamina is often a focus."
                        ],
                        "tags": [
                            "in-plural",
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "5a77fcdc-f6e0-474e-9bb3-99dbbb446642",
                                "sense_id": "80816071-089e-3ffb-95f8-e2cc64f22157",
                                "text": "Just before sacktime, the Captain stood beside his sleeping bag doing his daily calisthenics; stripped down to his flaming red long johns, […]"
                            }
                        ]
                    },
