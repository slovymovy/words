                    }
                ],
                "translations": [
                    {
                        "translation_id": "a93c3b52-7ae8-4d7a-a0bd-6bf22d3caf5f",
                        "source_entry_id": "5b3a377c-7357-379c-9c54-e597d4b31f84",
                        "source_sense_description": "of or pertaining to butter",
                        "target_lang_word": "butyreux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "butyreux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e5011846-577f-363b-8561-26d786cf12b7",
                                        "entry_id": "538c4c3b-11a0-37fa-8542-224e8232fc5a",
                                        "glosses": [
                                            "Qui a la nature ou l’apparence du beurre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80ac1d06-fe04-42e6-ba85-18215bf1a6e9",
                                                "sense_id": "e5011846-577f-363b-8561-26d786cf12b7",
                                                "text": "[…] ces différentes qualités du lait sont relatives à la quantité plus ou moins grande des parties butyreuses, caséeuses et séreuses qui le composent"
                                            },
                                            {
                                                "example_id": "1dc38136-d78c-4d89-8ab4-58697b6def04",
                                                "sense_id": "e5011846-577f-363b-8561-26d786cf12b7",
                                                "text": "Il restait au fond du verre une sorte de crème épaisse et presque butyreuse."
                                            },
                                            {
                                                "example_id": "8aebf6b3-5176-404e-bb05-7dde17c26d9d",
                                                "sense_id": "e5011846-577f-363b-8561-26d786cf12b7",
                                                "text": "Ces molécules blanchâtres , confondues avec les parties butyreuses, jaunies par la bile qui domine alors sur la matière , composent ensemble la masse des excremens qui ressemble beaucoup à des œufs brouillés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "88a15809-d7f3-47df-8414-dce6038b316f",
                        "source_entry_id": "5b3a377c-7357-379c-9c54-e597d4b31f84",
                        "source_sense_description": "of or pertaining to butter",
                        "target_lang_word": "butyrique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "butyrique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "61d051f8-e819-31e1-a748-9bd09bdf4f79",
                                        "entry_id": "faa63899-b592-391c-a174-ae4af01b1911",
                                        "glosses": [
                                            "Relatif à la matière grasse du lait."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8890c6c-e5b9-4d9d-bebf-5fded659be62",
                                                "sense_id": "61d051f8-e819-31e1-a748-9bd09bdf4f79",
                                                "text": "Acide butyrique: acide de formule chimique C₃H₇-CO₂H, présent dans le beurre et dans la sueur."
                                            },
                                            {
                                                "example_id": "6a3504f4-2d6b-43f5-869f-d3cf8135cafe",
                                                "sense_id": "61d051f8-e819-31e1-a748-9bd09bdf4f79",
                                                "text": "Fermentation butyrique: transformation de l’acide lactique, de sucres ou de matières amylacées en acide butyrique, alcool butylique etc. Cette fermentation est redoutée dans les industries alimentaires (brasseries, fromageries)."
                                            },
                                            {
                                                "example_id": "2d8b6c47-fbbb-4ad6-bf36-0b1f8176cee1",
                                                "sense_id": "61d051f8-e819-31e1-a748-9bd09bdf4f79",
                                                "text": "Ce sont bien en effet, tout au moins durant les premiers temps de la putréfaction, des asticots puisqu’il s’agit de larves de diptères, notamment de Calliphora vomitoria qui n’est autre que la grosse mouche bleue, de Curtonevra stabulans aux mœurs rurales, de Phora atterrima et d’Ophyra cadaverica lesquelles n’apparaissent que lorsque la fermentation ammoniacale succède aux fermentations butyrique et caséique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
