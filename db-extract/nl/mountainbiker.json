                            {
                                "example_id": "7bae6dc7-ace7-4c77-8257-524a13c142e7",
                                "sense_id": "c16e4c1d-0a03-364c-bc97-4a8b697f8925",
                                "text": "Twan van Gendt vertelt dat hij op de WK in Papendal zijn laatste wedstrijd als BMX'er heeft gereden. De wereldkampioen van 2019 stopt echter nog niet als sporter. Hij gaat verder als mountainbiker."
                            },
                            {
                                "example_id": "e7328b3b-92d2-4861-8048-22a0052bce35",
                                "sense_id": "c16e4c1d-0a03-364c-bc97-4a8b697f8925",
                                "text": "Van der Poel deed als mountainbiker mee aan de Olympische Spelen in Tokio. Daar moest hij afstappen na een harde valpartij in de openingsfase van de wedstrijd."
                            }
                        ]
