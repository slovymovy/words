                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1243c3de-d5db-3806-b07f-087ed3b614fd",
                                        "entry_id": "82868dac-893a-3a4a-953f-448e8f5223b5",
                                        "glosses": [
                                            "Of, pertaining to, or derived from, citrus fruit."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4e86b79-5c67-4000-99a5-785170de1a2a",
                                                "sense_id": "1243c3de-d5db-3806-b07f-087ed3b614fd",
                                                "text": "An orange-scented road to Harbor was what Christine expected, because three times the aroma had accompanied her escapes. The first was on foot, the second by bus, and each time the orange trees lining the road marked her flight with a light citric perfume."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a0cdf1b8-5961-4407-aac5-58235afc1611",
                        "source_entry_id": "04f46ddd-87f3-345c-903a-cb81d19f2001",
                        "source_sense_description": "содержащий в себе лимонную кислоту",
                        "target_lang_word": "citrique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "citrique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1884f3d4-954e-3006-b59d-f566110de901",
                                        "entry_id": "be00f317-74f2-3fc8-9501-f17428f119ba",
                                        "glosses": [
                                            "Qualifie un acide qu’on trouve dans le citron et dans certains autres fruits."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "df2376f0-7b5f-3f42-b10e-ef1313195ad4",
                                        "entry_id": "be00f317-74f2-3fc8-9501-f17428f119ba",
                                        "glosses": [
                                            "Définition manquante ou à compléter. (Ajouter)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f7ca2ca-cd54-42e4-afa6-16ef05c043c5",
                                                "sense_id": "df2376f0-7b5f-3f42-b10e-ef1313195ad4",
                                                "text": "Ses saveurs de pamplemousse, de citron, d’orange et de noix rendent sa bouche éclatante et piquante, mais sa richesse de texture et ses notes de craie tempèrent son côté citrique."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "citrique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bfa87c80-3a96-3269-b317-ecf5f333b1f2",
                                        "entry_id": "86f81fdd-cbfe-3496-9fd1-dc0eda2cd7d6",
                                        "glosses": [
                                            "Agrume, fruit à hespéride."
                                        ],
                                        "tags": [
                                            "Très rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a8b68a0-0f90-4a7a-92b3-d69aef473918",
                                                "sense_id": "bfa87c80-3a96-3269-b317-ecf5f333b1f2",
                                                "text": "[…] on aurait changé cette phrase, toujours en Iran, par bostan buy « parfum du jardin », comme nom d’un nouveau citrique venant d’Inde et au-delà, […]"
                                            },
                                            {
                                                "example_id": "0acbff0b-cf5d-4f0e-baf0-11db7448c6f1",
                                                "sense_id": "bfa87c80-3a96-3269-b317-ecf5f333b1f2",
                                                "text": "Ils s’occupent surtout des fleurs ornementales, des citriques, de fruits tropicaux, de la noix de macadamia, de légumes de contre-saison."
                                            },
                                            {
                                                "example_id": "45215f1c-699e-4dea-8ca3-4c29dd619ac9",
                                                "sense_id": "bfa87c80-3a96-3269-b317-ecf5f333b1f2",
                                                "text": "COLOGNE : Nom donné à une fragrance légère contenant des essences volatiles, principalement des citriques, lavandes et herbes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
