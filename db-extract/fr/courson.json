                "senses": [
                    {
                        "sense_id": "afe5eaf3-4fd7-3887-86db-479f26487691",
                        "entry_id": "21209176-fa9d-391b-b2bc-061048b0e9e8",
                        "glosses": [
                            "Village et ancienne commune française, située dans le département du Calvados intégrée à la commune de Noues de Sienne en janvier 2017."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34eb8dd3-42b8-4fad-b995-1e158145c1ec",
                                "sense_id": "afe5eaf3-4fd7-3887-86db-479f26487691",
                                "text": "La création de commune(s) nouvelle(s) sur le territoire séverin s'accélère. Réuni en milieu de semaine dernière, le groupe de dix communes composé de Saint-Sever-Calvados, Champ-du-Boult, Le Gast, Courson, Fontenermont, Mesnil-Clinchamps, Le Mesnil-Caussois, Le Mesnil-Benoist, Saint-Manvieu-Bocage et Sept-Frères, soit une population totale de 4 600 habitants, a délibéré pour procéder au choix du nom de la future entité.\nQuarante-trois propositions avaient été déposées dans les différentes mairies et une majorité s'est dégagée autour de la dénomination « Noues-de-Sienne »."
                            }
                        ]
                    }
                ],
