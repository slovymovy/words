                        ]
                    },
                    {
                        "sense_id": "62033af9-2702-3a0f-8d97-3a5d700e82af",
                        "entry_id": "801ca45c-af95-3c75-b6e2-6c2a95855562",
                        "glosses": [
                            "to promote, to market, to hype"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e2b41a2-1034-4399-a7b1-7649e86ef8e5",
                                "sense_id": "62033af9-2702-3a0f-8d97-3a5d700e82af",
                                "text": "как раскрути́ть свой сайт в Google",
                                "translation": "how to make your site have a good ranking in Google search results",
                                "english": "how to make your site have a good ranking in Google search results"
                            }
                        ]
                    },
                    {
                        "sense_id": "28de2f24-7603-397d-b8c2-796b727fcd75",
                        "entry_id": "801ca45c-af95-3c75-b6e2-6c2a95855562",
                        "glosses": [
                            "to persuade someone into doing something (often with deceit), to hustle someone into doing something/out of their money, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c9c62ea-0729-4676-b0be-05ce983fa0cd",
                                "sense_id": "28de2f24-7603-397d-b8c2-796b727fcd75",
                                "text": "Францу́зские журнали́сты раскрути́ли сексуа́льную актри́су на небольшо́й экспериме́нт.",
                                "translation": "French journalists (photographers) persuaded the sexy actress to do a little experiment.",
                                "english": "French journalists (photographers) persuaded the sexy actress to do a little experiment."
                            },
                            {
                                "example_id": "2ac15503-22a9-4cf8-a054-e9f34e340762",
                                "sense_id": "28de2f24-7603-397d-b8c2-796b727fcd75",
                                "text": "стриптизёрша \"раскрути́ла\" клие́нта на 100 до́лларов",
                                "translation": "the stripper \"took\" the client for 100 dollars / the stripper hustled the client out of 100 dollars total",
                                "english": "the stripper \"took\" the client for 100 dollars / the stripper hustled the client out of 100 dollars total"
                            }
                        ]
                    }
