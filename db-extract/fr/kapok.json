                                        "glosses": [
                                            "杜仲 (dùzhòng)之別名。"
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18090b94-010e-403e-a77e-b5e687deb604",
                                                "sense_id": "3890dbfd-e074-3861-b75d-922688d7f3c2",
                                                "text": "昔有杜仲服此得道，因以名之……其皮中有銀絲如綿，故曰木綿。"
                                            },
                                            {
                                                "example_id": "988b0532-cf63-40fb-a583-9b26afdb78a5",
                                                "sense_id": "3890dbfd-e074-3861-b75d-922688d7f3c2",
                                                "text": "昔有杜仲服此得道，因以名之……其皮中有银丝如绵，故曰木绵。"
                                            }
                                        ]
                                    }
