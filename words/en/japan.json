                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the old novel, the character hoped to be <w>japanned</w> after finishing university.",
                            "target_lang_translations": {
                                "ru": "В старом романе персонаж надеялся быть <w>рукоположенным</w> после окончания университета.",
