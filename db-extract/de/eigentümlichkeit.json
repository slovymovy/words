                    }
                ],
                "senses": [
                    {
                        "sense_id": "3a0ec34d-cd32-3866-ba16-551c25c63dc9",
                        "entry_id": "2e5363c8-5ff1-322c-aa66-9dc2b4305d94",
                        "glosses": [
                            "etwas, das vom Gewöhnlichen abweicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d5236f7-9947-4692-9fcf-2575d0c92b86",
                                "sense_id": "3a0ec34d-cd32-3866-ba16-551c25c63dc9",
                                "text": "„Martin Luther gründete seine sprachliche Leistung auf das Meißnische, die Verkehrssprache seiner Heimat, deren Wortschatz und lautliche Eigentümlichkeiten er gebrauchte und weitgehend bewahrte.“"
                            },
                            {
                                "example_id": "48fd3e0c-8e74-4bb0-b2fe-d42df34dbfb2",
                                "sense_id": "3a0ec34d-cd32-3866-ba16-551c25c63dc9",
                                "text": "„Versprecher haben zwei Eigentümlichkeiten: Einerseits sind sie ganz alltägliche sprachliche Pannen, ungeplant und ugewollt.“"
                            },
                            {
                                "example_id": "421c48d2-b490-4ae6-9db5-bfe964ee2b27",
                                "sense_id": "3a0ec34d-cd32-3866-ba16-551c25c63dc9",
                                "text": "„Und gerade diese Eigentümlichkeit der Speranskijschen Verstandeswelt zog den Fürsten Andrej so sehr an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "61e84a4c-09bb-439a-bb4b-f1b7fda90ab0",
                        "source_entry_id": "2e5363c8-5ff1-322c-aa66-9dc2b4305d94",
                        "source_sense_id": "3a0ec34d-cd32-3866-ba16-551c25c63dc9",
                        "source_sense_description": "etwas, das vom Gewöhnlichen abweicht",
                        "target_lang_word": "unusualness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unusualness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7aa04e1b-75a6-3031-9ba8-e54fc443beea",
                                        "entry_id": "554a03f6-9f1f-3dc0-8942-1cb75e8dae41",
                                        "glosses": [
                                            "The condition or state of being unusual."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "337f0865-e135-441e-ad7a-6f598e1d2f68",
                                                "sense_id": "7aa04e1b-75a6-3031-9ba8-e54fc443beea",
                                                "text": "The pale, inscrutable determinateness, and flinchless intrepidity of Pierre, now began to domineer upon them; for any social unusualness or greatness is sometimes most impressive in the retrospect."
                                            },
                                            {
                                                "example_id": "0b72b2fe-059a-4146-b737-56bccc35703b",
                                                "sense_id": "7aa04e1b-75a6-3031-9ba8-e54fc443beea",
                                                "text": "`Was it a housekeeper?' He was the rouseabout, wearing his best clothes with awful unusualness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a89de266-235c-3c9c-b25d-6c0735f4855f",
                                        "entry_id": "554a03f6-9f1f-3dc0-8942-1cb75e8dae41",
                                        "glosses": [
                                            "Something unusual; an aberration."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
