                },
                {
                    "sense_id": "e86e607e-7a07-388f-86ba-50951619e782",
                    "sense_definition": "Een gevoel van onrust of angst over mogelijke problemen of gevaar.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mentale_onrust",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik maak me geen <w>zorgen</w> over de toekomst.",
                            "target_lang_translations": {
                                "en": "I don't have any <w>worries</w> about the future.",
                                "ru": "Я не <w>беспокоюсь</w> о будущем."
                            }
                        },
                        {
                            "text": "Geldgebrek is een grote <w>zorg</w> voor veel gezinnen.",
                            "target_lang_translations": {
