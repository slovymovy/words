                ],
                "translations": [
                    {
                        "translation_id": "e068b55a-6b88-4511-a27c-67a5316d06ea",
                        "source_entry_id": "9746e7e0-91f0-3a23-860d-c39444da2302",
                        "source_sense_description": "делать чистым посредством мытья",
                        "target_lang_word": "wash away",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wash away",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5f109601-1639-3a06-8350-bd718c66e03b",
                                        "entry_id": "a1559b9f-0787-32cb-9c0d-1e5601d8b196",
                                        "glosses": [
                                            "To eliminate or destroy by fast-moving water, such as a flood or a high sea."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b2d720a-ccf6-4989-9a84-01c59d4df16e",
                                                "sense_id": "5f109601-1639-3a06-8350-bd718c66e03b",
                                                "text": "The main East Coast line from Edinburgh to Berwick was blocked at Cockburnspath and Grantshouse by flood water, which washed away part of an embankment, and by the collapse of about 300 tons of rubble on to the track."
                                            },
                                            {
                                                "example_id": "272516c3-8821-4bcf-80d0-835ef0ec2de2",
                                                "sense_id": "5f109601-1639-3a06-8350-bd718c66e03b",
                                                "text": "Thousands were left homeless as the flood waters washed away the eastern part of the city."
                                            },
                                            {
                                                "example_id": "0fc38270-1ca6-4972-9bcf-ac7560c4116c",
                                                "sense_id": "5f109601-1639-3a06-8350-bd718c66e03b",
                                                "text": "The price of deforestation over the centuries is that floodwater comes up so high at times that low bridges are liable to be washed away. On the Szechuan side, it is Hsiushan county. On the Kweichow side, the Sungtao Miao Autonomous County.",
                                                "translation": "Travels in China, 1966-71",
                                                "english": "Travels in China, 1966-71"
                                            },
                                            {
                                                "example_id": "f4d474ef-f41d-48c3-ab38-fed19fcf503c",
                                                "sense_id": "5f109601-1639-3a06-8350-bd718c66e03b",
                                                "text": "Floods in northern India, mostly in the small state of Uttarakhand, have wrought disaster on an enormous scale. The early, intense onset of the monsoon on June 14th swelled rivers, washing away roads, bridges, hotels and even whole villages. Rock-filled torrents smashed vehicles and homes, burying victims under rubble and sludge."
                                            },
                                            {
                                                "example_id": "cd8f4daa-47df-4556-8a54-5eec5221d562",
                                                "sense_id": "5f109601-1639-3a06-8350-bd718c66e03b",
                                                "text": "Services between Glasgow Queen Street and Edinburgh Waverley via Falkirk High are currently suspended, following a 30-metre breach of the Union Canal that occurred on August 12 after torrential rain and thunderstorms. The thousands of gallons of water that cascaded onto the railway line below washed away track, ballast and overhead line equipment, and undermined embankments along a 300-metre section of Scotland's busiest rail link."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20a32a14-0172-31af-b845-40ff798f7998",
                                        "entry_id": "a1559b9f-0787-32cb-9c0d-1e5601d8b196",
                                        "glosses": [
                                            "To eliminate."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef739807-1723-4437-a9e0-d5e666a0d49e",
                                                "sense_id": "20a32a14-0172-31af-b845-40ff798f7998",
                                                "text": "This latest piece of information, if true, will wash away all doubt."
                                            },
                                            {
                                                "example_id": "bdd9e5a0-a230-42ab-af19-e5cbae9e4c65",
                                                "sense_id": "20a32a14-0172-31af-b845-40ff798f7998",
                                                "text": "Why would this shared history be so easily washed away? In her introduction, Colley directed us away from the notion that nations were characterised by cultural and ethnic homogeneity – of “blood and soil” – and towards Benedict Anderson’s definition of a nation as an “imagined community”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
