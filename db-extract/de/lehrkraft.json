                "senses": [
                    {
                        "sense_id": "331ae0b8-85b0-3919-8f97-a1d88844dad8",
                        "entry_id": "59657410-459a-34df-9cf6-99deb9842c0d",
                        "glosses": [
                            "Person, die Lehrveranstaltungen durchführt; jemand, der unterrichtet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "540be530-aa07-4636-8934-af027272be00",
                                "sense_id": "331ae0b8-85b0-3919-8f97-a1d88844dad8",
                                "text": "Die Volkshochschule sucht eine Lehrkraft für Italienisch."
                            },
                            {
                                "example_id": "113335b0-2fb3-47c2-9e45-6cb1c987ac91",
                                "sense_id": "331ae0b8-85b0-3919-8f97-a1d88844dad8",
                                "text": "Wenn der Rechtsanspruch [auf Ganztagsbetreuung von Schülern in Schulen] umgesetzt werden soll, bräuchte Deutschland bis zum Schuljahr 2025/2026 zusätzlich 102.000 Lehrkräfte."
                            },
                            {
                                "example_id": "12a1230b-ab36-44b7-9639-b99084cee94c",
                                "sense_id": "331ae0b8-85b0-3919-8f97-a1d88844dad8",
                                "text": "„Die Handreichung ‚Curriculare Grundlagen – Deutsch als Zweitsprache’ richtet sich an alle Lehrkräfte, die im schulischen Kontext insbesondere mit neu zugewanderten Schülerinnen und Schülern arbeiten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f8cea095-4bb2-4de5-958f-b23b2a5ca635",
                        "source_entry_id": "59657410-459a-34df-9cf6-99deb9842c0d",
                        "source_sense_id": "331ae0b8-85b0-3919-8f97-a1d88844dad8",
                        "source_sense_description": "Person, die Lehrveranstaltungen durchführt; jemand, der unterrichtet",
                        "target_lang_word": "teacher",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "teacher",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f8e8b785-db93-3cac-8a85-a269abd82528",
                                        "entry_id": "5acd136e-a9fd-33ab-b4d2-8bc54f7a0152",
                                        "glosses": [
                                            "A person who teaches, especially one employed in a school; preceptor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19e92361-5f11-4969-8ff5-a04dbf8f6707",
                                                "sense_id": "f8e8b785-db93-3cac-8a85-a269abd82528",
                                                "text": "One particularly damaging, but often ignored, effect of conflict on education is the proliferation of attacks on schools[…]as children, teachers or school buildings become the targets of attacks. Parents fear sending their children to school. Girls are particularly vulnerable to sexual violence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7771e451-2706-3a08-88ef-2240644984c1",
                                        "entry_id": "5acd136e-a9fd-33ab-b4d2-8bc54f7a0152",
                                        "glosses": [
                                            "The index finger; the forefinger."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "324b0443-aec3-3b56-8dcc-4ae3a0f50d41",
                                        "entry_id": "5acd136e-a9fd-33ab-b4d2-8bc54f7a0152",
                                        "glosses": [
                                            "An indication; a lesson."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97e36397-f27a-40a7-aefa-f25a84d7bcb6",
                                                "sense_id": "324b0443-aec3-3b56-8dcc-4ae3a0f50d41",
                                                "text": "But if the last two years are a teacher, look for the bombastic tweets to resume before sunrise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c88bf4bc-88ec-3de0-a165-8ad8a3de67ae",
                                        "entry_id": "5acd136e-a9fd-33ab-b4d2-8bc54f7a0152",
                                        "glosses": [
                                            "The second highest office in the Aaronic priesthood, held by priesthood holders of at least the age of 14."
                                        ],
                                        "tags": [
                                            "Mormonism"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3a8f04e5-8b2d-4ade-9d2c-24af462aa1b2",
                        "source_entry_id": "59657410-459a-34df-9cf6-99deb9842c0d",
                        "source_sense_id": "331ae0b8-85b0-3919-8f97-a1d88844dad8",
                        "source_sense_description": "Person, die Lehrveranstaltungen durchführt; jemand, der unterrichtet",
                        "target_lang_word": "enseignant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enseignant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cedd76bf-a2f7-3fd2-85f5-6d759291dd49",
                                        "entry_id": "8bcca08e-4707-3e5a-9468-8cd97899320a",
                                        "glosses": [
                                            "Celui qui est chargé d’enseigner aux autres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3e24aa6-849d-407e-b2ab-5eb7273ff1d0",
                                                "sense_id": "cedd76bf-a2f7-3fd2-85f5-6d759291dd49",
                                                "text": "Après avoir occupé un poste d’enseignant pendant huit ans, il postula pour devenir directeur."
                                            },
                                            {
                                                "example_id": "14fc85a5-67e5-4970-900a-0a494b4aadc8",
                                                "sense_id": "cedd76bf-a2f7-3fd2-85f5-6d759291dd49",
                                                "text": "Par malheur, l’enseignant remplacé a recours à de l’argent scolaire pour récompenser ses élèves, alors que vous avez de la peine à respecter votre budget."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "enseignant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2c4e8c29-3475-31af-a4d3-f396203dc6bb",
                                        "entry_id": "8e4e0ad2-3e1f-3217-97c4-bcda1c9d3424",
                                        "glosses": [
                                            "Qui contient un enseignement, une leçon."
                                        ],
