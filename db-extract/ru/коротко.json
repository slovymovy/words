        "ru-extract.jsonl": [
            {
                "entry_id": "b6ba85b2-4699-32e4-9cf6-0e5a418569ef",
                "word": "коротко",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1c9677e6-bd08-3612-bfce-a092118bbdad",
                        "entry_id": "b6ba85b2-4699-32e4-9cf6-0e5a418569ef",
                        "glosses": [
                            "в течение небольшого времени, быстро или сжато"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8a42249-8cd5-410f-be27-57da1b4731b4",
                                "sense_id": "1c9677e6-bd08-3612-bfce-a092118bbdad",
                                "text": "Извозчик ответил коротко, но сильно."
                            }
                        ]
                    },
                    {
                        "sense_id": "0c1b6efb-e6c0-3c9a-978a-7b92b47e06e0",
                        "entry_id": "b6ba85b2-4699-32e4-9cf6-0e5a418569ef",
                        "glosses": [
                            "на небольшую длину"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb52463f-82fc-4029-baf9-993910ba35d4",
                                "sense_id": "0c1b6efb-e6c0-3c9a-978a-7b92b47e06e0",
                                "text": "Волосы его были коротко острижены."
                            }
                        ]
                    },
                    {
                        "sense_id": "25e65474-eb14-39b0-934d-abb8815c1712",
                        "entry_id": "b6ba85b2-4699-32e4-9cf6-0e5a418569ef",
                        "glosses": [
                            "перен. близко, непосредственно"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68187453-18f5-4962-90da-23f1b262cabc",
                                "sense_id": "25e65474-eb14-39b0-934d-abb8815c1712",
                                "text": "Александр Александрович познакомился с поэтом в 1819 году в доме Оленина, они близко сошлись, были коротко знакомы, но дружбы между ними не было."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ba30c6c6-a2f5-44df-a547-c322536f1a4a",
                        "source_entry_id": "b6ba85b2-4699-32e4-9cf6-0e5a418569ef",
                        "source_sense_description": "кратко",
                        "target_lang_word": "briefly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "briefly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3c975e3c-eec0-37f3-8b98-35229c1f6f31",
                                        "entry_id": "370e528a-0351-3623-83a4-f966fcd8b66f",
                                        "glosses": [
                                            "In a brief manner, summarily."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f3987ca-0857-464f-bccd-f7b1770fc945",
                                                "sense_id": "3c975e3c-eec0-37f3-8b98-35229c1f6f31",
                                                "text": "He covered the subject briefly in his book."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c2bb8e6-18d8-30ac-b70e-8816f0a6cf78",
                                        "entry_id": "370e528a-0351-3623-83a4-f966fcd8b66f",
                                        "glosses": [
                                            "For a brief period."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a17e64b-159c-4242-9341-55bc729af470",
                                                "sense_id": "9c2bb8e6-18d8-30ac-b70e-8816f0a6cf78",
                                                "text": "He only worked here briefly."
                                            },
                                            {
                                                "example_id": "c2226221-32cb-4f2f-8ae3-168c425de687",
                                                "sense_id": "9c2bb8e6-18d8-30ac-b70e-8816f0a6cf78",
                                                "text": "Instead, ddakji was played for dramatic effect earlier in the season — pitting two men who had forged a sweet bond against each other, making one of them briefly believe he’d been eliminated by his friend."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e82da8f4-d89e-38d4-baf5-3b8c95af90d5",
                                        "entry_id": "370e528a-0351-3623-83a4-f966fcd8b66f",
                                        "glosses": [
                                            "To be brief, in short."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8d54d18-28e3-4bdc-a227-34d9111bdf7a",
                                                "sense_id": "e82da8f4-d89e-38d4-baf5-3b8c95af90d5",
                                                "text": "Briefly, I am not happy about what happened, but no one will be losing their job."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "15ef65dd-4e52-418d-bece-e8ec851650b0",
                        "source_entry_id": "b6ba85b2-4699-32e4-9cf6-0e5a418569ef",
