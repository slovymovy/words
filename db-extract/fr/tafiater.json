                "senses": [
                    {
                        "sense_id": "39edd8dd-c438-30ce-a934-1bfe55338ad3",
                        "entry_id": "9dbc4725-6a06-3644-a0af-a7b62671ab3e",
                        "glosses": [
                            "Boire (du tafia, de l'alcool)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d3c05ab-56f9-42d2-918d-03afeadae52b",
                                "sense_id": "39edd8dd-c438-30ce-a934-1bfe55338ad3",
                                "text": "Mais tout compte fait de sa part cela aurait été mal venu car il n'était pas le dernier à tafiater."
                            },
                            {
                                "example_id": "40afe4ac-c3cf-4aec-a80a-cf6300f1cec6",
                                "sense_id": "39edd8dd-c438-30ce-a934-1bfe55338ad3",
                                "text": "Deux jours sans rien avaler et ensuite quatre côtelettes d'agneau à la file, un litre de margaux à jeun puis tisanes pour le foie, et on s'étonne, et moi le caviste je veux vous dire que pour tafiater, elle tafiate, qu'elle va ruiner Monsieur rien qu'avec ce qu'elle tafiate, tant qu'on ne l'aura pas internée soit tant qu'elle ne sera pas distendue comme une outre because usage des spiritueux, il se mettra la cervelle en citronnade pour regagner l'argent qu'elle lui boit, et il la lâchera pas, che cosa è amor — (...)"
                            }
                        ]
                    }
