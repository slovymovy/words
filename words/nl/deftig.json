{
    "word_family": [
        "deftigheid"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f316c078-d1d1-3c63-bd2b-9de64042b2e0",
                    "sense_definition": "keurig en goed verzorgd in uiterlijk of gedrag",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "netjes",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij ziet er altijd erg <w>deftig</w> uit in zijn nieuwe pak.",
                            "target_lang_translations": {
                                "en": "He always looks very <w>smart</w> in his new suit."
                            }
                        },
                        {
                            "text": "Voor het diner trokken ze hun <w>deftige</w> kleren aan.",
                            "target_lang_translations": {
                                "en": "They put on their <w>formal</w> clothes for the dinner."
                            }
                        }
                    ],
                    "common_phrases": [
                        "deftige kleren"
                    ],
                    "target_lang_definitions": {
                        "en": "neat and well-groomed in appearance or behavior"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "smart",
                                "target_lang_sense_clarification": "well-dressed and neat"
                            },
                            {
                                "target_lang_word": "proper",
                                "target_lang_sense_clarification": "behaving in a correct and respectable way"
                            },
                            {
                                "target_lang_word": "respectable",
                                "target_lang_sense_clarification": "having a good reputation and appearance"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "01fad5b6-2edd-31c7-a6e1-e2562258bdb6",
                    "sense_definition": "behorend tot of passend bij een hogere sociale klasse",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij wonen in een <w>deftige</w> buurt met grote villa's.",
                            "target_lang_translations": {
                                "en": "They live in a <w>posh</w> neighborhood with large villas."
                            }
                        },
                        {
                            "text": "In die <w>deftige</w> buurt staan alleen maar dure huizen.",
                            "target_lang_translations": {
                                "en": "In that <w>upscale</w> neighborhood, there are only expensive houses."
                            }
                        }
                    ],
                    "common_phrases": [
                        "deftige buurt",
                        "deftige familie"
                    ],
                    "target_lang_definitions": {
                        "en": "belonging to or appropriate for a higher social class"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "posh",
                                "target_lang_sense_clarification": "elegant or stylish in an upper-class way"
                            },
                            {
                                "target_lang_word": "genteel",
                                "target_lang_sense_clarification": "polite and refined, often related to high social class"
                            },
                            {
                                "target_lang_word": "aristocratic",
                                "target_lang_sense_clarification": "characteristic of the aristocracy"
                            },
                            {
                                "target_lang_word": "upscale",
                                "target_lang_sense_clarification": "relating to wealthy people or neighborhoods"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d8fb2611-107f-3bff-b9a2-c675cc73d15f",
                    "sense_definition": "met veel uiterlijk vertoon van waardigheid of status",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>deftige</w> man sprak met een heel bekakt accent.",
                            "target_lang_translations": {
                                "en": "The <w>stately</w> man spoke with a very posh accent."
                            }
                        },
                        {
                            "text": "Hij maakte een <w>deftige</w> indruk op de aanwezige gasten.",
                            "target_lang_translations": {
                                "en": "He made a <w>dignified</w> impression on the guests present."
                            }
                        }
                    ],
                    "synonyms": [
                        "statig"
                    ],
                    "common_phrases": [
                        "deftige man",
                        "deftige indruk"
                    ],
                    "target_lang_definitions": {
                        "en": "with a lot of outward display of dignity or status"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stately",
                                "target_lang_sense_clarification": "impressive and dignified in appearance"
                            },
                            {
                                "target_lang_word": "dignified",
                                "target_lang_sense_clarification": "showing a composed or serious manner"
                            },
                            {
                                "target_lang_word": "grand",
                                "target_lang_sense_clarification": "impressive in size or appearance"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1f74ea9a-08c9-3bd6-9a7b-0b217770fc68",
                    "sense_definition": "beheerst en waardig in de manier van doen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gedrag",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is belangrijk om <w>deftige</w> manieren te hebben aan tafel.",
                            "target_lang_translations": {
                                "en": "It is important to have <w>proper</w> manners at the table."
                            }
                        },
                        {
                            "text": "Zij gedroeg zich op een zeer <w>deftige</w> wijze tijdens de ceremonie.",
                            "target_lang_translations": {
                                "en": "She behaved in a very <w>dignified</w> manner during the ceremony."
                            }
                        }
                    ],
                    "common_phrases": [
                        "deftige manieren"
                    ],
                    "target_lang_definitions": {
                        "en": "composed and dignified in one's manner of acting"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dignified",
                                "target_lang_sense_clarification": "having an attitude of respectability and poise"
                            },
                            {
                                "target_lang_word": "decorous",
                                "target_lang_sense_clarification": "polite and restrained"
                            },
                            {
                                "target_lang_word": "refined",
                                "target_lang_sense_clarification": "showing good education and manners"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "062eac55-a493-3a41-b781-cbae84407005",
                    "sense_definition": "overdreven plechtig of gewichtig op een vervelende manier",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "gedrag",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn <w>deftige</w> gedrag begon de andere gasten te irriteren.",
                            "target_lang_translations": {
                                "en": "His <w>pompous</w> behavior began to irritate the other guests."
                            }
                        },
                        {
                            "text": "Doe niet zo <w>deftig</w> en praat gewoon normaal tegen ons.",
                            "target_lang_translations": {
                                "en": "Don't be so <w>stuffy</w> and just talk to us normally."
                            }
                        }
                    ],
                    "synonyms": [
                        "statig"
                    ],
                    "common_phrases": [
                        "deftig gedrag"
                    ],
                    "target_lang_definitions": {
                        "en": "excessively solemn or self-important in an annoying way"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pompous",
                                "target_lang_sense_clarification": "affectedly grand or self-important"
                            },
                            {
                                "target_lang_word": "stuffy",
                                "target_lang_sense_clarification": "excessively conventional or formal"
                            },
                            {
                                "target_lang_word": "pretentious",
                                "target_lang_sense_clarification": "attempting to impress by affecting greater importance than is possessed"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "97ef829f-fcd0-39b9-81e9-5d95553436fb",
                    "sense_definition": "in een behoorlijke of vrij grote mate",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "graad",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De wasmachine is <w>deftig</w> kapot en moet worden vervangen.",
                            "target_lang_translations": {
                                "en": "The washing machine is <w>properly</w> broken and needs to be replaced."
                            }
                        },
                        {
                            "text": "Het heeft vannacht <w>deftig</w> gevroren op het platteland.",
                            "target_lang_translations": {
                                "en": "It froze <w>considerably</w> in the countryside last night."
                            }
                        }
                    ],
                    "synonyms": [
                        "aardig",
                        "behoorlijk",
                        "nogal"
                    ],
                    "common_phrases": [
                        "deftig kapot"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "voornamelijk in België gebruikt"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to a considerable or fairly large degree (mainly Belgian Dutch)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "quite",
                                "target_lang_sense_clarification": "to a certain degree"
                            },
                            {
                                "target_lang_word": "considerably",
                                "target_lang_sense_clarification": "to a noteworthy extent"
                            },
                            {
                                "target_lang_word": "properly",
                                "target_lang_sense_clarification": "thoroughly or completely (informal)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "df45bc86-218f-3139-8301-4428f890b537",
                    "sense_definition": "zonder enige schaamte of terughoudendheid",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "gedrag",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij zat <w>deftig</w> te eten terwijl de anderen nog wachtten.",
                            "target_lang_translations": {
                                "en": "He sat there eating <w>boldly</w> while the others were still waiting."
                            }
                        },
                        {
                            "text": "Ze liepen <w>deftig</w> door de afzetting heen zonder te vragen.",
                            "target_lang_translations": {
                                "en": "They <w>brazenly</w> walked through the barrier without asking."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "without any shame or restraint"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "boldly",
                                "target_lang_sense_clarification": "in a confident and courageous or impudent way"
                            },
                            {
                                "target_lang_word": "brazenly",
                                "target_lang_sense_clarification": "in a bold and shameless way"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}