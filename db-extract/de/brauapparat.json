                "senses": [
                    {
                        "sense_id": "2a02c8b4-85d5-3d1a-90be-02e94697c145",
                        "entry_id": "baa7fe67-9c77-333f-831c-c7a25b5b2f5e",
                        "glosses": [
                            "Apparatur zur Herstellung von Bier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1fbd74e5-9e20-488a-af28-649000e32e04",
                                "sense_id": "2a02c8b4-85d5-3d1a-90be-02e94697c145",
                                "text": "„Diese kocht man im Brauapparat, nachdem man den Hopfen zugesetzt hat, der das Sauerwerden der Würze verhindern soll.“"
                            },
                            {
                                "example_id": "22baab7c-9713-4a28-a169-e80cba2b8e95",
                                "sense_id": "2a02c8b4-85d5-3d1a-90be-02e94697c145",
                                "text": "„Von den ausgestellten Brauapparaten ist in erster Linie die eiserne Maischmafchine zu 40 Zentner Malz von A. Münnich und Comp. in Chemnitz (Sachsen) zu nennen.“"
                            },
                            {
                                "example_id": "e446ef05-18f1-40a3-bea3-cc477bfbc77e",
                                "sense_id": "2a02c8b4-85d5-3d1a-90be-02e94697c145",
                                "text": "Zwei Publikationen des nahezu gleichen Zitats:",
                                "translation": "„Einiges frisches Fleisch hoffte ich noch aufnehmen zu können, bevor wir die oberen Grönlandsküsten erreichten; auch nahm ich einige Fässer Malz und einen Brauapparat mit.“"
                            },
                            {
                                "example_id": "4d172b45-13ca-4be2-97d8-6440ac3536ee",
                                "sense_id": "2a02c8b4-85d5-3d1a-90be-02e94697c145",
                                "text": "„Eine angebliche Verbesserung, der Bierstein, Getreidestein oder das Zeilithoid, hat viel Lärm gemacht, weil er als ein festgewordener, aber in Wasser löslicher, gehopfter Malzertract die Brauerei auch ohne Brauapparat Jedermann zugänglich machen soll.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
