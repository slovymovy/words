                                                "sense_id": "637db3ec-5752-343c-a29d-02918de19740",
                                                "text": "The fable of the rods, which, when united in a bundle, no strength could bend."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b07fcd7c-8cc0-3e9d-9167-f6b73c71c312",
                                        "entry_id": "12503837-cfcf-3442-baec-c42790034b4c",
                                        "glosses": [
                                            "A package wrapped or tied up for carrying."
                                        ],
