                                    {
                                        "sense_id": "e8934d94-3161-322d-bc63-72253f247853",
                                        "entry_id": "608924b3-2aae-3c1c-ab72-b827327baa0e",
                                        "glosses": [
                                            "An archipelago and country in Southern Europe, in the Mediterranean Sea. Official name: Republic of Malta. Capital: Valletta."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eec74741-0896-415b-ae80-cb70f3f946c4",
                                                "sense_id": "e8934d94-3161-322d-bc63-72253f247853",
                                                "text": "Over the following decades, the EEC became the European Union, and expanded from the original six nations to today’s 27 members, from Finland in the north to Malta in the south."
                                            },
                                            {
                                                "example_id": "fa2907b8-fbaf-4345-94f4-08ee43efe1de",
                                                "sense_id": "e8934d94-3161-322d-bc63-72253f247853",
                                                "text": "And so far just two member states, Malta and Finland, are on track to meet their resettling obligations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fcf465a8-2998-39aa-81e5-caddb46ac4d8",
                                        "entry_id": "608924b3-2aae-3c1c-ab72-b827327baa0e",
                                        "glosses": [
                                            "The largest island in the Maltese Archipelago."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a421a554-2b38-327a-85e7-7d7cbdbd36dd",
                                        "entry_id": "608924b3-2aae-3c1c-ab72-b827327baa0e",
                                        "glosses": [
                                            "A small city, the county seat of Phillips County, Montana, United States."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e95774c9-f312-4539-b9c9-9b462295eea7",
                        "source_entry_id": "84352db7-108d-3b89-b02c-10e58714e93c",
                        "target_lang_word": "Malta",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
