                            "trait_type": "colloquial",
                            "comment": "emploi familier, souvent dans une question"
                        }
                    ]
                },
                {
                    "sense_id": "1243124c-1b51-37e3-ae74-cf2ef541bfff",
                    "sense_definition": "Faire un bruit doux et harmonieux, en parlant de l'eau ou d'éléments de la nature.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "produire des sons mélodieux",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le ruisseau <w>chante</w> doucement entre les pierres."
