                                                "example_id": "3c019c12-fb5c-4c2f-b16f-680499450385",
                                                "sense_id": "3f912a90-51bb-3950-b51e-80b3797ce6cc",
                                                "text": "Bright hopes, that erst the bosom warmed."
                                            }
                                        ]
                                    },
