                    {
                        "sense_id": "a87a619c-5242-3165-9364-f2b1a4cc6794",
                        "entry_id": "f671960b-52ee-3a22-9108-844cccb1f528",
                        "glosses": [
                            "Having been said or done again."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f2ab037-8265-4e0f-bb1a-de57ddd741da",
                                "sense_id": "a87a619c-5242-3165-9364-f2b1a4cc6794",
                                "text": "The repeated exposure, over decades, to most taxa here treated has resulted in repeated modifications of both diagnoses and discussions, as initial ideas of the various taxa underwent—often repeated—conceptual modification."
                            },
                            {
                                "example_id": "1509e121-f00c-4c73-a964-bf459a6f4217",
                                "sense_id": "a87a619c-5242-3165-9364-f2b1a4cc6794",
                                "text": "The repeated exposure, over decades, to most taxa here treated has resulted in repeated modifications of both diagnoses and discussions, as initial ideas of the various taxa underwent—often repeated—conceptual modification."
                            }
