                "senses": [
                    {
                        "sense_id": "c0f7fae8-4b93-385a-a0bd-ff1bdcda1142",
                        "entry_id": "3d96887d-51ce-32b4-82ba-d13ae3a489d7",
                        "glosses": [
                            "Faire perdre ses forces à, affaiblir, diminuer le pouvoir de quelqu'un."
                        ],
                        "tags": [
                            "Belgique"
                        ],
                        "examples": [
                            {
                                "example_id": "68b69cd7-1fab-4a0c-aa8b-f032c4232011",
                                "sense_id": "c0f7fae8-4b93-385a-a0bd-ff1bdcda1142",
                                "text": "Pour en finir avec l’obstacle que Vandenpeereboom avait créé, Delcour choisit de déforcer la loi, sachant bien que celle-ci ne pourrait plus opérer, résister, discriminer entre ses applications, si autour de Bruxelles ne subsistait plus de vrai rural, de rural proprement dit, de “purement rural”."
                            },
                            {
                                "example_id": "c7f6922b-707e-4dad-bb5f-cd2ea1508b83",
                                "sense_id": "c0f7fae8-4b93-385a-a0bd-ff1bdcda1142",
                                "text": "Déforcer l’État-Nation serait donc déforcer la démocratie."
                            },
                            {
                                "example_id": "66bf5c6f-4220-447b-bcc9-d0274b35f14a",
                                "sense_id": "c0f7fae8-4b93-385a-a0bd-ff1bdcda1142",
                                "text": "Vous n’avez pas peur de déforcer votre autorité ?"
                            }
                        ]
                    }
