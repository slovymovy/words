                ],
                "senses": [
                    {
                        "sense_id": "23f46adf-8e45-3247-80e1-8b2360849099",
                        "entry_id": "19a5bce0-aa9d-347c-8c83-9c1287ee9463",
                        "glosses": [
                            "Vorgang, etwas (zum Beispiel eine Botschaft oder einen Brief) an jemanden zu schicken, zu senden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81f434eb-f67c-4099-82c8-a6d53ded4f85",
                                "sense_id": "23f46adf-8e45-3247-80e1-8b2360849099",
                                "text": "„Das kann schriftlich mittels Zuleitung von Dokumenten oder mündlich erfolgen.“"
                            },
                            {
                                "example_id": "a57ca490-4da9-4c18-8f8b-ce73156b9ea1",
                                "sense_id": "23f46adf-8e45-3247-80e1-8b2360849099",
                                "text": "„Die Zuleitung von Informationen ist seither erheblich verbessert worden, so dass die Parlamente inzwischen die Gelegenheit haben, ihre Stellungnahmen zu verfassen, bevor auf europäischer Ebene entschieden wird […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6dddd1b1-5b39-3660-a656-980073f930cd",
                        "entry_id": "19a5bce0-aa9d-347c-8c83-9c1287ee9463",
                        "glosses": [
                            "Vorgang, etwas (zum Beispiel Flüssiges) an einen Ort transportieren/lenken (leiten), an dem es Verwendung findet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5def1309-d7e1-4b80-9f04-9f618d5b7a27",
                                "sense_id": "6dddd1b1-5b39-3660-a656-980073f930cd",
                                "text": "„Von deren Existenz zeugen historische Abbildungen des Kirchenraumes sowie heute noch am Kirchenfußboden erkennbare gekappte Rohre, die zur Zuleitung des Gases dienten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "7f5dc073-77b6-3f3d-b844-d9f2e6b734db",
                        "entry_id": "19a5bce0-aa9d-347c-8c83-9c1287ee9463",
                        "glosses": [
                            "Rohr beziehungsweise Leitung, durch die etwas an einen Ort geleitet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7427cf2d-139d-4b76-97f6-211e1a92c0c0",
                                "sense_id": "7f5dc073-77b6-3f3d-b844-d9f2e6b734db",
                                "text": "„Die Zuleitung war durch Rost verstopft gewesen, der Installateur hatte sie vor ein paar Tagen gereinigt.“"
                            },
                            {
                                "example_id": "7d54b3b8-e193-4b87-8863-cf0f3556b9d5",
                                "sense_id": "7f5dc073-77b6-3f3d-b844-d9f2e6b734db",
                                "text": "„Das Wasser wird dem Behälter durch die Zuleitung zugeführt.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
