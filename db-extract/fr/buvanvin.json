                        "examples": [
                            {
                                "example_id": "44e9237c-d34c-4138-a24d-a543b6159205",
                                "sense_id": "f3eefa24-dcfc-32ae-b55b-93b5ea377503",
                                "text": "Manquablement il était à cras, barmayait de gauche à droite comme un buvanvin et à tout moment pensait tomber en bave."
                            },
                            {
                                "example_id": "1e57facb-1457-45f7-bdf9-640caf1dc3d8",
                                "sense_id": "f3eefa24-dcfc-32ae-b55b-93b5ea377503",
                                "text": "Ni joueur - sauf qu'aux boules ; ni fenassu - ben qu'il se fût marié sur le tard, à quand ses vieux mourirent ; ni buvanvin - quoiqu'il prenait de beaujolais ce qu'est honnête d'en prendre, pareil vous et moi, pas vrai ?"
                            }
                        ]
                    }
