                        "examples": [
                            {
                                "example_id": "36c5f04e-e4a0-46f1-bb3b-645c0551eea9",
                                "sense_id": "a7ccabd4-bdc7-3641-8950-43f12a6bdd6a",
                                "text": "We moesten de bergstroom oversteken om bij de kampeerplaats te komen."
