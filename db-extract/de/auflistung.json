                "senses": [
                    {
                        "sense_id": "683065bc-90c5-38bf-b554-c6543a439220",
                        "entry_id": "23edd679-3515-3461-820d-ba0f07cc476c",
                        "glosses": [
                            "listenartige Anordnung von Informationen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d3b8bc8-2246-474b-901e-147d1acb0de4",
                                "sense_id": "683065bc-90c5-38bf-b554-c6543a439220",
                                "text": "Hier finden Sie eine Auflistung unserer Sponsoren."
                            },
                            {
                                "example_id": "c8aae5db-2b9c-4263-97a8-b393d2d11b8f",
                                "sense_id": "683065bc-90c5-38bf-b554-c6543a439220",
                                "text": "„In Lernets Baron Bagge gibt es eine Auflistung ungarischer Ortsnamen, die so suggestiv wirkt wie leise wirbelnde pentatonische Musik.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4ac0f17b-de1a-4139-b002-72e5c8fb2988",
                        "source_entry_id": "23edd679-3515-3461-820d-ba0f07cc476c",
                        "source_sense_id": "683065bc-90c5-38bf-b554-c6543a439220",
                        "source_sense_description": "listenartige Anordnung von Informationen",
                        "target_lang_word": "список",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "список",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "50dc659e-a0c5-349c-b39a-633793aae484",
                                        "entry_id": "2878930b-eecb-3556-8059-b6be229b33c6",
                                        "glosses": [
                                            "письменное перечисление чего-либо (кого-либо); перечень"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "561b2f63-76f7-479a-b616-3f3ec5d33172",
                                                "sense_id": "50dc659e-a0c5-349c-b39a-633793aae484",
                                                "text": "По излиянии многих слёз и по долгом терзании просил я одного из моих друзей, чтоб постарался он достать мне список всех растерзанных в тот день невольников .."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d047a696-c8f4-3df8-8191-ead982d606ac",
                                        "entry_id": "2878930b-eecb-3556-8059-b6be229b33c6",
                                        "glosses": [
                                            "рукописная копия какого-либо оригинала (текста или изображения)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e679a0b-2a88-474f-ab0e-809fc0fb677f",
                                                "sense_id": "d047a696-c8f4-3df8-8191-ead982d606ac",
                                                "text": "Впрочем, коль подлинник есть неподражаемым, толь и список."
                                            },
                                            {
                                                "example_id": "584889a8-1e42-41ee-8e7f-1c437a561ae6",
                                                "sense_id": "d047a696-c8f4-3df8-8191-ead982d606ac",
                                                "text": "Изнемогающие от страшной беды жители решили по обету сделать список иконы смоленской Богоматери."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f653889d-99dd-3c43-97b7-d93d8f056821",
                                        "entry_id": "2878930b-eecb-3556-8059-b6be229b33c6",
                                        "glosses": [
                                            "документ, содержащий перечень каких-либо сведений, также перен."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
