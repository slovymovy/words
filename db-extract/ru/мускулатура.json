                    },
                    {
                        "translation_id": "b8f1b6f7-9daf-47e6-bb76-28bdcbf4413a",
                        "source_entry_id": "ce09372c-642c-3d98-9668-b8647444f58d",
                        "source_sense_id": "a71c882b-14cc-3c41-b66b-babbc6fedaf9",
                        "target_lang_word": "Muskulatur",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Muskulatur",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "26df495d-64c0-36f6-a14e-b2e5db473199",
                                        "entry_id": "6a04508b-7e49-3de5-9890-7f20abc88c00",
                                        "glosses": [
                                            "Gesamtheit der Muskeln in einem Körper oder in einem bestimmten Bereich des Körpers"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7cbd3d75-9080-4d8f-b79c-fe47868128e8",
                                                "sense_id": "26df495d-64c0-36f6-a14e-b2e5db473199",
                                                "text": "„Da alle Bewegungen des Körpers eine gewisse Spannungslage der Muskulatur erfordern, beeinflusst der Tonus also auch die Stimmgebung unmittelbar.“"
                                            },
                                            {
                                                "example_id": "491cad7c-257d-4cc4-b218-81a9c930ca12",
                                                "sense_id": "26df495d-64c0-36f6-a14e-b2e5db473199",
                                                "text": "„Jede Woche kommt eine Krankengymnastin, die Lucas Muskulatur stimuliert.“"
                                            },
                                            {
                                                "example_id": "bba1362a-bea8-4d8b-862e-3cd527427e3c",
                                                "sense_id": "26df495d-64c0-36f6-a14e-b2e5db473199",
                                                "text": "„Sie taten es gebückt, und die ausgeprägte Muskulatur ihrer Rücken zeigte, dass dies ihre überwiegende Arbeitshaltung war, ob sie nun wuschen, kochten, fegten oder ihre Kinder badeten.“"
                                            },
                                            {
                                                "example_id": "43eab494-e36a-4ad3-9e48-14e563ae8ff6",
                                                "sense_id": "26df495d-64c0-36f6-a14e-b2e5db473199",
                                                "text": "„Der Knochenbau war nicht sehr stark, die Muskulatur wenig ausgebildet, sodass Kant genötigt war, seine Kleider durch künstliche Mittel zu befestigen, weil sie unmittelbar an seinem Körper keinen Halt fanden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
