                    {
                        "translation_id": "ddbe15de-d333-4448-9ec9-97ab6895c929",
                        "source_entry_id": "95c0e622-2eed-3e88-ab0f-df1400487d8e",
                        "source_sense_description": "odd, eccentric, and/or extreme person",
                        "target_lang_word": "Spinner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Spinner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b2f4068e-6559-35bc-ae56-6fcc0cee622b",
                                        "entry_id": "9401c525-9a36-3253-a7a2-84fd81fcceb8",
                                        "glosses": [
                                            "Person, die das Spinnen betreibt, in einer Spinnerei arbeitet, Garn herstellt"
                                        ],
                                        "tags": [
                                            "Berufsbezeichnung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1099095-8b2d-45c2-9af0-177fe1940b87",
                                                "sense_id": "b2f4068e-6559-35bc-ae56-6fcc0cee622b",
                                                "text": "Ein Spinner arbeitet in einer Firma, die Garn für Textilien herstellt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cf03dbbe-86ea-3901-b2c2-8a2e8de61ce5",
                                        "entry_id": "9401c525-9a36-3253-a7a2-84fd81fcceb8",
                                        "glosses": [
                                            "Person, die unsinnige Gedanken, Vorstellungen hat, äußert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a6f1b58-05ea-48a1-a9aa-55e0499948fb",
                                                "sense_id": "cf03dbbe-86ea-3901-b2c2-8a2e8de61ce5",
                                                "text": "Alle halten ihn für einen Spinner."
                                            },
                                            {
                                                "example_id": "8b9d76db-47d8-48b0-923e-9996493bbe5e",
                                                "sense_id": "cf03dbbe-86ea-3901-b2c2-8a2e8de61ce5",
                                                "text": "Als liebevolle Anmahnung eines zu brüskierenden Verhaltens: Du bist aber schon ein kleiner Spinner."
                                            },
                                            {
                                                "example_id": "ba85227c-9eb5-4564-a4a9-79ff18c0d8a3",
                                                "sense_id": "cf03dbbe-86ea-3901-b2c2-8a2e8de61ce5",
                                                "text": "Ein Spinner ist einer, der in seinen Erzählungen z.B. Seemannsgarn hinzu-\"spinnt\" (Pseudologie, oder Wahrnehmungserweiterungen bei Schlafmangel, Mangelernährung (Hunger, Durst), Bleivergiftung (durch damalige Dosenkonserven) oder Drogenkonsum (Bier, Wein, harter Tobak) entsteht)"
                                            },
                                            {
                                                "example_id": "8d995385-4490-4f75-85dd-10be12cceb39",
                                                "sense_id": "cf03dbbe-86ea-3901-b2c2-8a2e8de61ce5",
                                                "text": "„Die Spinner am Rande und die Migranten müssen sich nicht dem Mainstream anpassen, im Gegenteil, es ist erlaubt, dass sie ihn ändern.“"
                                            },
                                            {
                                                "example_id": "e381c320-30cc-44e3-8ea0-2ab6a7294f28",
                                                "sense_id": "cf03dbbe-86ea-3901-b2c2-8a2e8de61ce5",
                                                "text": "Bis zur Offenlegung der Prototypen von Area 51 waren UFO-sichtende Menschen in der Wüste Nevadas oft als Alte Fantasten oder versoffene Spinner abgetan."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ae908d1a-e66d-3b02-9d8b-6050013bc418",
                                        "entry_id": "9401c525-9a36-3253-a7a2-84fd81fcceb8",
                                        "glosses": [
                                            "Person, die Lügen erzählt und dadurch auch Intrigen \\\"strickt\\\" beziehungsweise \\\"spinnt\\"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60e20845-0d01-409e-a128-27fd5cd0c7d0",
                                                "sense_id": "ae908d1a-e66d-3b02-9d8b-6050013bc418",
                                                "text": "Bis zur Offenlegung der Prototypen von Area 51 waren UFO-sichtende Menschen in der Wüste Nevadas oft als Alte Fantasten oder versoffene Spinner abgetan."
                                            },
                                            {
                                                "example_id": "ae46ba79-815e-454c-bdaa-0e89828c340d",
                                                "sense_id": "ae908d1a-e66d-3b02-9d8b-6050013bc418",
                                                "text": "Das hat er erzählt? Was für ein Spinner."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "c4d770c1-ad90-34fc-8741-377bf2a6cc88",
                                        "entry_id": "9401c525-9a36-3253-a7a2-84fd81fcceb8",
                                        "glosses": [
                                            "löffel- oder weidenblattförmiger, auf einer Stahldrahtachse rotierender künstlicher Angelköder"
                                        ],
                                        "tags": [
                                            "Angelfischerei"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a72187d5-9bce-4c08-a512-9a7ae6453617",
                                                "sense_id": "c4d770c1-ad90-34fc-8741-377bf2a6cc88",
                                                "text": "Mit einem Spinner kann man gut Barsche fangen."
                                            },
                                            {
                                                "example_id": "15a3b35a-ba31-4eea-813a-dcbfdf8265ea",
                                                "sense_id": "c4d770c1-ad90-34fc-8741-377bf2a6cc88",
                                                "text": "„Ob seiner wesensgemäßen Effekthascherei bleibt der Spinner dem Finnen suspekt, in jedem Fall steht er nach Ansehen und Einsatz weit hinter dem Wobbler zurück.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "9dbef401-d82b-32d2-ac2d-fdb3db318628",
                                        "entry_id": "9401c525-9a36-3253-a7a2-84fd81fcceb8",
                                        "glosses": [
                                            "Nachtfalter aus unterschiedlichen Familien, deren Raupen sich in dicht gesponnenen Kokons verpuppen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff1d2cf9-2321-4bfe-8e55-ff5f828e7f2d",
                                                "sense_id": "9dbef401-d82b-32d2-ac2d-fdb3db318628",
                                                "text": "Einige Spinner sind Schädlinge, andere sind Nutztiere."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "717fb1a6-0d2f-4a17-b75c-3b6b25bd0293",
                        "source_entry_id": "95c0e622-2eed-3e88-ab0f-df1400487d8e",
