                                            {
                                                "example_id": "5ecc2d5c-7f3c-4406-b458-3262b904ae97",
                                                "sense_id": "e74dfaa7-4d8e-3caa-a741-e864000143f5",
                                                "text": "Le soir, à la maison, j’essaye de l’imiter, vêtu d’une seule queue de panthère — un don de la fourreuse de ma mère."
                                            }
                                        ]
                                    }
                                ]
