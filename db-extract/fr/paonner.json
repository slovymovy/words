                ],
                "senses": [
                    {
                        "sense_id": "89250151-d691-3030-8c50-5f44fbc8d05c",
                        "entry_id": "4d6fa43c-c428-32b0-901b-7c01297301e1",
                        "glosses": [
                            "Faire la roue (pour le paon)."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "eb7d3d6d-f8b2-3990-a65d-9e393420d16b",
                        "entry_id": "4d6fa43c-c428-32b0-901b-7c01297301e1",
                        "glosses": [
                            "Crier (pour le paon)."
                        ],
                        "tags": [
                            "Parfois"
                        ],
                        "examples": [
                            {
                                "example_id": "6eee17a1-c46c-4e6c-98d2-b991bcae9164",
                                "sense_id": "eb7d3d6d-f8b2-3990-a65d-9e393420d16b",
                                "text": "Il y avait beaucoup de bruit qui venait d'en bas, elle entendait distinctement des gens qui criaient, de la volaille qui s'encourait, le cri d'un paon : « Léééééééééooooon », paonnait-il à tue tête."
                            }
                        ]
                    },
                    {
                        "sense_id": "05c4c998-6802-32f4-822c-a285bdd46e84",
                        "entry_id": "4d6fa43c-c428-32b0-901b-7c01297301e1",
                        "glosses": [
                            "Se pavaner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08837405-879c-49c9-9f13-00a55f9e3a57",
                                "sense_id": "05c4c998-6802-32f4-822c-a285bdd46e84",
                                "text": "— Faites-les d’abord chanter séparément, dis-je au Méridional (tout épanoui de paonner au milieu de nous)."
                            },
                            {
                                "example_id": "64ee9a9c-f367-4726-ae14-9198e7ddeb72",
                                "sense_id": "05c4c998-6802-32f4-822c-a285bdd46e84",
                                "text": "Les prisonniers inscrits au programme se considéraient comme des vedettes viennoises en tournée chez des barbares. Ils paonnaient avec un air supérieur de cabotins et réclamaient des rations doubles."
                            },
                            {
                                "example_id": "ea3adbba-647e-4f8c-a99c-b60cdc969431",
                                "sense_id": "05c4c998-6802-32f4-822c-a285bdd46e84",
                                "text": "Il ne s’était pas diverti à paraître dans les salons, hauts lieux du papillonnage, où paonnaient des sots éventés et des sirènes plâtrées, et où cancanaient des caillettes d’alcôve et des potiches au ventre rembourré."
                            },
                            {
                                "example_id": "2b085bc9-988f-48e0-a2a9-6bb38847e268",
                                "sense_id": "05c4c998-6802-32f4-822c-a285bdd46e84",
                                "text": "Je « paonnais » en la faisant asseoir près de moi."
                            }
                        ]
                    }
                ],
