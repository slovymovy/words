                "senses": [
                    {
                        "sense_id": "adad1901-3ab4-357c-b599-fb216296ae03",
                        "entry_id": "701bea5a-23fa-33ce-a718-dba8e5e617a9",
                        "glosses": [
                            "автомоб. спортивный автомобиль, выделяющийся эксклюзивным оснащением, динамическими характеристиками и ценой"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f23f233-d760-408a-9ba2-62eb84617d16",
                                "sense_id": "adad1901-3ab4-357c-b599-fb216296ae03",
                                "text": "В желании удивить не только эффектным дизайном, но и необычным для суперкара техническим решением швейцарцы не одиноки."
                            }
                        ]
                    }
                ],
