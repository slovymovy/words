                    }
                ],
                "senses": [
                    {
                        "sense_id": "aa1742e3-3d47-34b9-876f-482a7e6579c4",
                        "entry_id": "77fef5dd-9dfe-33e8-90e3-20bf971b1f64",
                        "glosses": [
                            "Qui est écailleux, couvert de squames."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e757d11-0c92-4f05-b278-3cff969f5def",
                                "sense_id": "aa1742e3-3d47-34b9-876f-482a7e6579c4",
                                "text": "Tige squameuse."
                            },
                            {
                                "example_id": "b8b9651f-e0b6-442d-ad0b-c7e1ac7dcfb5",
                                "sense_id": "aa1742e3-3d47-34b9-876f-482a7e6579c4",
                                "text": "Ah ! l’affreux, le hideux, le squameux, venimeux, écumeux, écumant, glapissant crapaud !…"
                            },
                            {
                                "example_id": "690cdd40-f03d-4694-b705-2b7967465685",
                                "sense_id": "aa1742e3-3d47-34b9-876f-482a7e6579c4",
                                "text": "Le python tourne lentement sa hideuse tête squameuse vers cette proie inattentive."
                            },
                            {
                                "example_id": "33119bc0-0ca7-46d7-b35d-49aead561292",
                                "sense_id": "aa1742e3-3d47-34b9-876f-482a7e6579c4",
                                "text": "Ils m’étaient soumis, ces dragons ; je souriais de les voir se déformer et grandir, enlaçant tout de leurs corps squameux."
                            }
                        ]
                    },
                    {
                        "sense_id": "ff50a2b2-cd8b-3314-98c5-b2a81b3fa1f2",
                        "entry_id": "77fef5dd-9dfe-33e8-90e3-20bf971b1f64",
                        "glosses": [
                            "Qui a l’aspect d’une écaille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5da537c3-13f0-48ac-93dd-b9787fa1a947",
                                "sense_id": "ff50a2b2-cd8b-3314-98c5-b2a81b3fa1f2",
                                "text": "La portion squameuse du temporal."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a258fc39-990d-43bb-a975-e976a466f04d",
                        "source_entry_id": "77fef5dd-9dfe-33e8-90e3-20bf971b1f64",
                        "target_lang_word": "schuppig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schuppig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3ab33334-93c9-358d-b6cd-da655c003627",
                                        "entry_id": "f3fead26-721a-3c88-880b-dfaeb1bee1c8",
                                        "glosses": [
                                            "uneben, oftmals durch kleine, hochstehende Hautablösungen gekennzeichnet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9af80b7a-5047-487d-885c-cb31a47e8bc0",
                                                "sense_id": "3ab33334-93c9-358d-b6cd-da655c003627",
                                                "text": "„Das Gesicht ist rot und schuppig und zeigt dicke Lidfalten.“"
                                            },
                                            {
                                                "example_id": "e34c4eef-9170-430a-a260-691ff6c7e7c3",
                                                "sense_id": "3ab33334-93c9-358d-b6cd-da655c003627",
                                                "text": "„Wenn also der Körper zu wenig Selen zur Verfügung hat, dann kann es dazu kommen, dass er beispielsweise eine schuppige Haut hat, keine Kinder kriegen kann, nicht groß und kräftig heranwächst, sich leichter eine Erkältung einfängt oder auch dass er schneller herzkrank wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6f4cb2d5-49b1-361b-ab8a-562c43791d99",
                                        "entry_id": "f3fead26-721a-3c88-880b-dfaeb1bee1c8",
                                        "glosses": [
                                            "mit Schuppen bedeckt"
                                        ],
                                        "tags": [
                                            "bei Fischen oder Reptilien"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0179aaf-d857-4fe7-b8a2-fa8c797edf9e",
                                                "sense_id": "6f4cb2d5-49b1-361b-ab8a-562c43791d99",
                                                "text": "„Fisch und Vitamine? Nein, die schuppigen Tiere kräftigen das Immunsystem vor allem durch das Spurenelement Selen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3fadbbe8-f6cf-4aec-b8c7-deb4c9172877",
                        "source_entry_id": "77fef5dd-9dfe-33e8-90e3-20bf971b1f64",
                        "target_lang_word": "squamous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "squamous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1c8dae6d-b07d-32e3-92e6-9263ca2b7847",
                                        "entry_id": "78b6564f-ed37-337d-99de-a66a3868288f",
                                        "glosses": [
                                            "Covered with, made of, or resembling scales; scaly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c4f04d2-7344-4867-ad27-ebb3824a6354",
                                                "sense_id": "1c8dae6d-b07d-32e3-92e6-9263ca2b7847",
                                                "text": "In the squamous heads of Scabius, Knapweed, and the elegant Jacea Pinea, and in the Scaly composure of the Oak-Rose, which some years most aboundeth."
                                            },
                                            {
                                                "example_id": "40177b68-7ad2-4ca4-8ff9-707c7c294359",
                                                "sense_id": "1c8dae6d-b07d-32e3-92e6-9263ca2b7847",
                                                "text": "I might call it gigantic - tentacled - proboscidian - octopus-eyed - semi-amorphous - plastic - partly squamous and partly rugose - ugh!"
                                            },
                                            {
                                                "example_id": "506bd84e-8da3-4d3c-bc8b-afd2f1c947da",
                                                "sense_id": "1c8dae6d-b07d-32e3-92e6-9263ca2b7847",
                                                "text": "We spread the papers on the least squamous section of the floor and lay down; the smell was not so bad at ground level."
                                            },
                                            {
                                                "example_id": "1a216feb-b0ba-42e4-8d06-d55af95cfe2e",
                                                "sense_id": "1c8dae6d-b07d-32e3-92e6-9263ca2b7847",
                                                "text": "(And we'll never find out whether the last thought to pass through the mind of the captain of the Thresher was, \"It's squamous and rugose,\" or simply, \"It's squamous!\")"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ecef402d-89f1-3f42-ae6f-d28b54513cf5",
                                        "entry_id": "78b6564f-ed37-337d-99de-a66a3868288f",
                                        "glosses": [
                                            "Of or pertaining to the squamosal bone; squamosal"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "90f0f585-077c-31e3-9d3c-e67c52716327",
                                        "entry_id": "78b6564f-ed37-337d-99de-a66a3868288f",
                                        "glosses": [
                                            "Of or pertaining to an epithelium with cells that are wider than their height (flat and scale-like)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
