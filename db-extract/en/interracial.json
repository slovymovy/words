                                "example_id": "f247e04f-9081-4521-bcd1-26b4ecb31e0f",
                                "sense_id": "9b09c1b6-fced-3581-afc1-b8fd9f25772b",
                                "text": "Interracial struggle against Europid people is a para-Marxist notion."
                            },
                            {
                                "example_id": "744dc8ff-9344-4830-a967-dcd24988ac7b",
                                "sense_id": "9b09c1b6-fced-3581-afc1-b8fd9f25772b",
                                "text": "In Spike Lee’s story of interracial romance, Jungle Fever (June), Wesley Snipes plays a young buppie New York architect whose affair with his Italian-American secretary (Annabella Sciorra) threatens his marriage and her relationship to her family."
                            },
                            {
                                "example_id": "59e61bc6-64cb-4e7a-b956-b1fcf907cea0",
                                "sense_id": "9b09c1b6-fced-3581-afc1-b8fd9f25772b",
                                "text": "Like their American counterparts, German officials frowned on interracial sexual fraternization."
                            }
                        ]
