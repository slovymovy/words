                                    {
                                        "sense_id": "0b108e97-0f8b-3eb0-a192-2f76db4cd267",
                                        "entry_id": "b9db8a79-f461-3551-b550-ff3832ac0864",
                                        "glosses": [
                                            "A hard white translucent ceramic, originally made by firing kaolin, quartz, and feldspar at high temperatures but now also inclusive of similar artificial materials; also often (figurative) such a material as a symbol of the fragility, elegance, etc. traditionally associated with porcelain goods."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff496c59-25a6-489e-b649-fbdadf25c644",
                                                "sense_id": "0b108e97-0f8b-3eb0-a192-2f76db4cd267",
                                                "text": "Tableware and toilets are both made of porcelain."
                                            },
                                            {
                                                "example_id": "a7834126-28a4-4c96-8b84-4fbdda79f2ee",
                                                "sense_id": "0b108e97-0f8b-3eb0-a192-2f76db4cd267",
                                                "text": "Any power rail needs to be well insulated from earth, to minimise current leakage, and so the two power rails on the Underground sit on curiously genteel and antique-looking porcelain pots."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d1ba667-298f-330c-ad37-cd2762c8a7e1",
                                        "entry_id": "b9db8a79-f461-3551-b550-ff3832ac0864",
                                        "glosses": [
                                            "Synonym of china: porcelain tableware."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c93cbae6-cf13-4212-a533-fe8350e97975",
                                                "sense_id": "7d1ba667-298f-330c-ad37-cd2762c8a7e1",
                                                "text": "iij. potts of Erthe payntid, callyd Porseland."
                                            },
                                            {
                                                "example_id": "bdb87784-cd30-4467-a605-3ca09df5c4be",
                                                "sense_id": "7d1ba667-298f-330c-ad37-cd2762c8a7e1",
                                                "text": "He set the table with our porcelain and stemware."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89be6de7-2f78-3fb2-8132-8c32d9a33d8d",
                                        "entry_id": "b9db8a79-f461-3551-b550-ff3832ac0864",
                                        "glosses": [
                                            "Synonym of kaolin: the kind of clay traditionally used in China to manufacture porcelain."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49dafdce-c6bf-45aa-bdd9-4bd9e3637668",
                                                "sense_id": "89be6de7-2f78-3fb2-8132-8c32d9a33d8d",
                                                "text": "[...] that earthen or pliable matter commonly called porcellan, which is pure white,... wherof vessels of all kinds are very curiously framed..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2e66499-5859-3cf7-a659-39146e975ada",
                                        "entry_id": "b9db8a79-f461-3551-b550-ff3832ac0864",
                                        "glosses": [
                                            "An object made of porcelain, (particularly) art objects or items of tableware."
                                        ],
                                        "tags": [
                                            "countable",
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4ae4eeb-2ed6-4e9a-a198-f08f930e7f52",
                                                "sense_id": "c2e66499-5859-3cf7-a659-39146e975ada",
                                                "text": "The museum has an extensive collection of rare Chinese porcelains."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a314982-1574-3aa8-ba33-0819e640c049",
                                        "entry_id": "b9db8a79-f461-3551-b550-ff3832ac0864",
                                        "glosses": [
                                            "Synonym of cowrie."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a3efa58-a1ff-48bf-931d-2531cc0ed684",
                                                "sense_id": "3a314982-1574-3aa8-ba33-0819e640c049",
                                                "text": "In the kingdomes of Caiacan and Carazan, certaine sea shels are currant, which some men terme Porcelline."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fcf98e3-a455-3643-8350-0051cce13f98",
                                        "entry_id": "b9db8a79-f461-3551-b550-ff3832ac0864",
                                        "glosses": [
                                            "Synonym of wampum: strings of shells, beads, etc. used as ornamentation or currency; the composite shells, beads, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4fc485f0-6b11-446c-9736-1235a5ea3193",
                                                "sense_id": "2fcf98e3-a455-3643-8350-0051cce13f98",
                                                "text": "We mett severall gangs of men to our greatest disadvantage, ffor we weare forced to sing, and those that came to see us gave porcelaine to those that most did us injury."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4995dc1c-9c64-30ea-8370-a9867725160a",
                                        "entry_id": "b9db8a79-f461-3551-b550-ff3832ac0864",
                                        "glosses": [
                                            "A kind of pigeon with deep brown and off-white feathers."
                                        ],
