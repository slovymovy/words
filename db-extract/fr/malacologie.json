        "fr-extract.jsonl": [
            {
                "entry_id": "38b45346-5e7a-33d9-a96e-44b0f1cbbd31",
                "word": "malacologie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "904daebf-bd06-4d6e-a885-6133ae44fc0c",
                        "entry_id": "38b45346-5e7a-33d9-a96e-44b0f1cbbd31",
                        "tags": [
                            "plural"
                        ],
                        "form": "malacologies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "31be6cf7-a458-3378-9461-f68c6483a70e",
                        "entry_id": "38b45346-5e7a-33d9-a96e-44b0f1cbbd31",
                        "glosses": [
                            "Branche de la zoologie consacrée à l’étude des mollusques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c613417-4590-4744-921b-380ff03a5c90",
                                "sense_id": "31be6cf7-a458-3378-9461-f68c6483a70e",
                                "text": "En échange de mes menus services, il m’initiait à la malacologie et me donnait quantité de coquilles de mollusques terrestres et d’eau douce pour que je fasse chez moi une collection en règle."
                            },
                            {
                                "example_id": "664a76c5-02df-42ba-bdad-cb94a8ddbb98",
                                "sense_id": "31be6cf7-a458-3378-9461-f68c6483a70e",
                                "text": "Ces premiers éléments de connaissance ont été présentés lors du colloque national de malacologie continentale qui s’est tenu à Laon fin mars et seront publiés dans le journal Malaco."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aa7ce0b0-aac8-4ff4-a5bb-b1f67d7dc1fb",
                        "source_entry_id": "38b45346-5e7a-33d9-a96e-44b0f1cbbd31",
                        "source_sense_id": "31be6cf7-a458-3378-9461-f68c6483a70e",
                        "target_lang_word": "malacology",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "malacology",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aa25ce98-54cb-375d-aca4-f76613353c0b",
                                        "entry_id": "d9557c44-5978-3927-9ae4-43bf2c440cc2",
                                        "glosses": [
                                            "The study of molluscs."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eeb78ba3-3a12-4a31-b0f5-773ccf443779",
                                                "sense_id": "aa25ce98-54cb-375d-aca4-f76613353c0b",
                                                "text": "But the circumstances which the Baron Cuvier† so justly adduces as tending to retard the progress of Malacology in general, seem especially to have contributed to obscure the history of Nautilus Pompilius."
                                            },
                                            {
                                                "example_id": "1aab1b13-e5b5-4a1b-a83e-455d303be45d",
                                                "sense_id": "aa25ce98-54cb-375d-aca4-f76613353c0b",
                                                "text": "[…]their chronogeny will long remain one of the most difficult problems in Malacology."
                                            },
                                            {
                                                "example_id": "e1f2325c-77d1-4aaf-ba57-c9ffaff176a5",
                                                "sense_id": "aa25ce98-54cb-375d-aca4-f76613353c0b",
                                                "text": "The first steps in the age determination of mammals by the number of annual layers were made when, in ichthyology and malacology, it has already become to routine practice to use annual layers for ageing animals and for back-calculating the growth of individuals."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
