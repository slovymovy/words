                ],
                "senses": [
                    {
                        "sense_id": "7ed30973-c629-3f33-b866-241c87c1a6ff",
                        "entry_id": "e7932153-77ae-3bed-8c6c-8999cec95c4f",
                        "glosses": [
                            "Engloutir."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "94b7a0c3-413c-4d85-ae4a-22f46a765275",
                                "sense_id": "7ed30973-c629-3f33-b866-241c87c1a6ff",
                                "text": "Il avoit à dos un bois d’aunes, dont le fond étoit un marais tout propre à gloutir hommes & chevaux."
                            },
                            {
                                "example_id": "f4ba6708-49b5-4dca-ade4-e7c283da7b6f",
                                "sense_id": "7ed30973-c629-3f33-b866-241c87c1a6ff",
                                "text": "L’apothicaire termine de gloutir son potage."
                            },
                            {
                                "example_id": "1bbf4e87-31f4-471f-9398-08b6fd9deda1",
                                "sense_id": "7ed30973-c629-3f33-b866-241c87c1a6ff",
                                "text": "Tu y bondis, gourmand, tu t’aplatis au sol pour gloutir tout son saoul, mais, audit instant, choit du haut du sapin, sur ton sinciput, l’actif nid qui illico t’assoupit à jamais, t’irradiant dans la proportion maxima."
                            }
                        ]
                    }
