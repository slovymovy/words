                                        "entry_id": "fc54ce91-0977-39db-9a37-504eb8eb9332",
                                        "glosses": [
                                            "Aéronef en forme de parachute en plus allongé, auquel est attaché un siège appelé sellette."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d1c5cf3-aec3-4cdd-80a2-914bce194ab1",
                                                "sense_id": "2b59b0b0-d7e8-37e3-a3e7-006f33f63c38",
                                                "text": "Le parapente a bien failli partir en décrochage quand son pilote a trop tiré sur les freins."
                                            },
                                            {
                                                "example_id": "e96ada29-edaa-419b-a851-b23987be5bbc",
                                                "sense_id": "2b59b0b0-d7e8-37e3-a3e7-006f33f63c38",
                                                "text": "Il replie son parapente et le range dans son sac."
                                            },
                                            {
                                                "example_id": "41e61025-daa6-44ce-8ffd-f54445d440c3",
                                                "sense_id": "2b59b0b0-d7e8-37e3-a3e7-006f33f63c38",
                                                "text": "Dans ce cas le constructeur n’a que le choix d’agir sur l’instabilité de l’aile s’il ne veut pas avoir un parapente impossible à faire tourner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2901274-863a-3de4-81f4-0f31bac8310f",
                                        "entry_id": "fc54ce91-0977-39db-9a37-504eb8eb9332",
                                        "glosses": [
