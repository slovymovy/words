                        "entry_id": "01599618-3314-3e43-b188-64aa5e4c7356",
                        "glosses": [
                            "iemand die door de ene staat is aangesteld om deze staat bij een andere staat te vertegenwoordigen."
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "bd2920e0-a360-49c9-964e-72648d9a4902",
                                "sense_id": "ed03d037-0d51-31f8-85ba-2b9c64983afb",
                                "text": "Turkije heeft zondag de ambassadeur van het Vaticaan op het matje geroepen nadat de paus zondag de Armeense volkerenmoord in 1915 tot \"de eerste genocide van de twintigste eeuw\" bestempelde."
                            },
                            {
                                "example_id": "71af7879-d270-4b5a-91dd-8dfb83eb90da",
                                "sense_id": "ed03d037-0d51-31f8-85ba-2b9c64983afb",
                                "text": "Hij is de Franse ambassadeur in Wellington op Nieuw-Zeeland, ga nu gauw opendoen."
                            }
                        ]
                    },
                    {
                        "sense_id": "2ae3ae2a-5953-355f-a5f6-00c00cd8cca9",
                        "entry_id": "01599618-3314-3e43-b188-64aa5e4c7356",
                        "glosses": [
                            "iemand die vaak namens een sector of belangenorganisatie die sector probeert te vertegenwoordigen"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "3d8c19f7-a765-45bd-afd9-df7a04d32cc2",
                                "sense_id": "2ae3ae2a-5953-355f-a5f6-00c00cd8cca9",
                                "text": "Paul van Vliet is lange tijd ambassadeur van UNICEF geweest."
                            }
                        ]
                    },
                    {
                        "sense_id": "3ac42d3a-bdb4-362a-a676-11dc86f4dee4",
                        "entry_id": "01599618-3314-3e43-b188-64aa5e4c7356",
                        "glosses": [
                            "supporter van iets of iemand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb212a2a-4a22-4351-847c-77e15123994f",
                                "sense_id": "3ac42d3a-bdb4-362a-a676-11dc86f4dee4",
                                "text": "Addie LaRue bedankt haar ambassadeurs! 'Ik kan me geen beter boek wensen om het jaar mee te beginnen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "653ee4a4-4a42-40bc-a3fc-3f86ef8abf07",
                        "source_entry_id": "01599618-3314-3e43-b188-64aa5e4c7356",
                        "source_sense_id": "ed03d037-0d51-31f8-85ba-2b9c64983afb",
                        "source_sense_description": "iemand die door de ene staat is aangesteld om deze staat bij een andere staat te vertegenwoordigen",
                        "target_lang_word": "Botschafter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Botschafter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "870181ed-3c3b-3a90-94e5-b46c6cf10cfd",
                                        "entry_id": "865da52c-f0a2-3727-8742-c9bf3a953275",
                                        "glosses": [
                                            "oberster diplomatischer Vertreter eines Staates im Ausland"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "394848ef-400c-4d20-a911-1a7f6f5d5575",
                                                "sense_id": "870181ed-3c3b-3a90-94e5-b46c6cf10cfd",
                                                "text": "Der Botschafter ist der persönliche Repräsentant des Staatsoberhauptes seiner Nation."
                                            },
                                            {
                                                "example_id": "2279db65-7557-4c8e-9d63-6b2ee66d80af",
                                                "sense_id": "870181ed-3c3b-3a90-94e5-b46c6cf10cfd",
                                                "text": "„Plötzlich sprang ein gut gekleideter Mann auf das Trittbrett des Wagens, spuckte den Botschafter an, schlug dessen Diener und flüchtete.“"
                                            },
                                            {
                                                "example_id": "8efb702c-bb8b-4f12-9e57-078350eb1e7e",
                                                "sense_id": "870181ed-3c3b-3a90-94e5-b46c6cf10cfd",
                                                "text": "„Da scheint eine der ersten Amtshandlungen des neuen Präsidenten nur folgerichtig: Noch am Tag seiner Vereidigung setzte Trump von seinem Vorgänger ernannte Botschafter ab.“"
                                            },
                                            {
                                                "example_id": "fa42c153-21e1-4fdb-afa7-cc1d6c65f1cd",
                                                "sense_id": "870181ed-3c3b-3a90-94e5-b46c6cf10cfd",
                                                "text": "„Doch bevor die neue Regierung überhaupt im Amt war, mauschelte er mit dem russischen Botschafter.“"
                                            },
                                            {
                                                "example_id": "aea7a68b-bda5-447f-8bec-d14addadcde7",
                                                "sense_id": "870181ed-3c3b-3a90-94e5-b46c6cf10cfd",
                                                "text": "„Er hatte unseren Außenminister gesehen und Englands Botschafter und den Botschafter Frankreichs, er hatte Hochrufe ausgebracht und mit allen zusammen gesungen, doch dann hatte man unvermutet die Menge angewiesen, in Anbetracht eines eventuellen Luftangriffs so schnell wie möglich auseinanderzugehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2ceef50c-4b09-4a74-8221-7b11420355c7",
                        "source_entry_id": "01599618-3314-3e43-b188-64aa5e4c7356",
                        "source_sense_id": "ed03d037-0d51-31f8-85ba-2b9c64983afb",
                        "source_sense_description": "iemand die door de ene staat is aangesteld om deze staat bij een andere staat te vertegenwoordigen",
