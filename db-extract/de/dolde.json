                "senses": [
                    {
                        "sense_id": "2e0c3e08-0491-37f4-aa81-2237f49d3e82",
                        "entry_id": "a36a7078-9491-317d-b799-b0851a5a4efc",
                        "glosses": [
                            "Blütenstandstyp einer Traube mit tellerförmig angeordneten Blüten (Blütendolde)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0669c09-ed6c-4d97-8920-a6a8529d01a2",
                                "sense_id": "2e0c3e08-0491-37f4-aa81-2237f49d3e82",
                                "text": "Der Fliederbeerbaum hat jetzt so schöne Dolden, die ja voller Blüten sind, das wird noch eine sehr gute Ernte in diesem Jahr."
                            },
                            {
                                "example_id": "358fc830-fd1a-40e4-b23a-729871fb35df",
                                "sense_id": "2e0c3e08-0491-37f4-aa81-2237f49d3e82",
                                "text": "„Jeder Fremde der kam, wenn er nicht zufällig ein Kenner war, nahm diese Dolden für richtige Aloeblüten, und der Schloßherr hütete sich wohl, diesen Glauben, der eine Quelle der Erheiterung für ihn war, zu zerstören.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
