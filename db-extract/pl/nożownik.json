                                            {
                                                "example_id": "9907b88a-9a94-4732-abea-31f0bc650353",
                                                "sense_id": "5616daec-3f40-3196-982a-f3f954386e4e",
                                                "text": "Children go through a phase of compound acquisition in which they invent cutthroats spontaneously before dropping the habit again."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cutthroat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1a26d80a-04e3-337d-ae1b-18b0e097e40a",
                                        "entry_id": "6ce38645-8f81-38b8-bba3-7ca0a40ddadc",
                                        "glosses": [
                                            "Involving the cutting of throats."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4a010d43-b590-3ad1-9cb2-ea49e42d1746",
                                        "entry_id": "6ce38645-8f81-38b8-bba3-7ca0a40ddadc",
                                        "glosses": [
                                            "Of or relating to a card game where everyone plays for him or herself rather than playing with a partner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32fcb61b-c75c-4845-8a82-9c4654f2ec66",
                                                "sense_id": "4a010d43-b590-3ad1-9cb2-ea49e42d1746",
                                                "text": "He found that playing cutthroat Spades was much more difficult than playing with a partner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a54a99ac-54f6-39d7-ba7f-f1c05920e31a",
                                        "entry_id": "6ce38645-8f81-38b8-bba3-7ca0a40ddadc",
                                        "glosses": [
                                            "Ruthlessly competitive, dog-eat-dog."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91b598ec-bf58-4711-b166-c9b72681e60d",
                                                "sense_id": "a54a99ac-54f6-39d7-ba7f-f1c05920e31a",
                                                "text": "Law is a cutthroat business, you always have to look out to see who is trying to outdo you."
                                            },
                                            {
                                                "example_id": "ecede780-e397-41da-a58c-d34cc0c5b51a",
                                                "sense_id": "a54a99ac-54f6-39d7-ba7f-f1c05920e31a",
                                                "text": "More specifically, Scrabblers are diehard, competitive, and occasionally cutthroat players who treat the game like it's chess or baseball..."
                                            },
                                            {
                                                "example_id": "d8507804-7e0f-434d-9fe9-1e6d5ecfe859",
                                                "sense_id": "a54a99ac-54f6-39d7-ba7f-f1c05920e31a",
                                                "text": "While these esports are often framed as battles of mental strategies and mechanical skills, how players juggle their hundreds, or thousands, of simultaneously ticking clocks and timers defines their ability to succeed in cutthroat competitions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a15a2167-b3b7-41b2-b693-fd6983dd5569",
                        "source_entry_id": "993fe944-5a07-3a0e-8e9c-0abbcef265b1",
                        "source_sense_id": "767deada-da5c-3dfa-b63c-03b649e8a808",
                        "target_lang_word": "poignardeur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "poignardeur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f83d5402-e1bb-3e74-aa72-44a41851f5d0",
                                        "entry_id": "9b68aac3-8c06-3110-a979-e504633c054c",
                                        "glosses": [
                                            "Celui qui poignarde."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "111f6eb9-a8f7-4db3-b995-b7238045b439",
                                                "sense_id": "f83d5402-e1bb-3e74-aa72-44a41851f5d0",
                                                "text": "Le poignardeur de la reine de Suède s’appelle Sentinelli [celui qui poignarda Monaldeschi]."
                                            },
                                            {
                                                "example_id": "5fb67fdc-0952-422e-9019-5d3a8eeeb4d1",
                                                "sense_id": "f83d5402-e1bb-3e74-aa72-44a41851f5d0",
                                                "text": "L'on n'insistera pas trop sur l'identité du « poignardeur » en chef de cette fine équipe, intouchable judiciairement et dont la réputation en matière de lancer du couteau dans le dos des autres n'est plus à faire."
                                            },
                                            {
                                                "example_id": "a668c3c9-4842-41bc-b6e5-9e00b0b2d4aa",
                                                "sense_id": "f83d5402-e1bb-3e74-aa72-44a41851f5d0",
                                                "text": "Qui écrit des choses admirables ? Des cons qui n’ont rien compris. Les pas cons écrivent des choses UTILES. Contre les Arabes, par exemple, contre le tsunami, contre Allègre, contre le ministre de l’Immigration et ses charters, contre la mévente du vin de Champagne, contre les poignardeurs de leurs petits camarades dans la cour de l’école mais faut les comprendre, contre le sionisme mais, là aussi, faut les comprendre…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c06a0ec8-cee4-4243-8524-d598caec6e1a",
                        "source_entry_id": "993fe944-5a07-3a0e-8e9c-0abbcef265b1",
                        "source_sense_id": "767deada-da5c-3dfa-b63c-03b649e8a808",
                        "target_lang_word": "Messerstecher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Messerstecher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f536b251-a1c4-37ae-9980-8c7c63b98a4c",
                                        "entry_id": "566d9cff-4335-3607-ad2e-e616ec73d41b",
                                        "glosses": [
                                            "(männliche^☆) Person, die im Zuge eines Streits mit einem Messer zusticht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d60e51c0-21c8-437c-80c8-d2d95568a247",
                                                "sense_id": "f536b251-a1c4-37ae-9980-8c7c63b98a4c",
                                                "text": "„Der Messerstecher, der am Donnerstag die Verkäuferin eines Getränkemarktes im hessischen Alsfeld erstochen hat, ist offenbar gefasst.“"
                                            },
                                            {
                                                "example_id": "d203c34b-9eac-4935-8806-882c2c6a7526",
                                                "sense_id": "f536b251-a1c4-37ae-9980-8c7c63b98a4c",
                                                "text": "„Ich war doppelt froh. Zum einen, dass wir den Täter finden konnten. Zum anderen, dass wir den Messerstecher nicht im Beisein der Libanesen festnehmen mussten.“"
                                            },
                                            {
                                                "example_id": "22836d13-eb78-4b93-9ebd-9bdddfd70b0f",
                                                "sense_id": "f536b251-a1c4-37ae-9980-8c7c63b98a4c",
                                                "text": "„In jüngster Zeit nutzt das Sondereinsatzkommando der Polizei in München Kettenhemden als Schutz vor Messerstechern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
