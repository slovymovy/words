                        "glosses": [
                            "ein nach dem Kaiser benannter Monat im altrömischen Kalender"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2e65a91-2d27-4ce7-a77d-0b84835426c3",
                                "sense_id": "791956e6-9ca8-356b-aa54-78e4b72025bc",
                                "text": "„Der Augustus war der sechste Monat des altrömischen Kalenders und Vorläufer des heutigen Monats August.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8bf2d92b-a8fd-3d8c-a567-04831a2c291a",
                        "entry_id": "a6a99923-73df-3013-9635-f361c11b3610",
                        "glosses": [
                            "ein Ehrentitel der römischen Kaiser"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bce18d5d-f223-481a-9729-9a30bd1c2503",
                                "sense_id": "8bf2d92b-a8fd-3d8c-a567-04831a2c291a",
                                "text": "„Der Ehrenname Augustus wurde 27 v. Chr. erstmals Octavian verliehen und war – wie auch der Titel Caesar – im Römischen und frühen Byzantinischen Reich bis Anfang des 7. Jahrhunderts Bestandteil der Kaiser-Titulatur.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
