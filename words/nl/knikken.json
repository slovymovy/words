{
    "word_family": [
        "knik",
        "knikje",
        "knikarm",
        "knikpunt",
        "knikverbinding",
        "knikbeweging"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "809e9e0e-e47c-392f-8124-551c563d5d38",
                    "sense_definition": "een verticale beweging met het hoofd maken om iets te bevestigen of iemand te groeten",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "hoofdbeweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toen ik vroeg of hij wilde komen, bleef hij even stil en <w>knikte</w> toen ja.",
                            "target_lang_translations": {
                                "en": "When I asked if he wanted to come, he remained silent for a moment and then <w>nodded</w> yes."
                            }
                        },
                        {
                            "text": "Hij <w>knikte</w> een snelle groet in het voorbijgaan naar zijn oude buurman.",
                            "target_lang_translations": {
                                "en": "He <w>nodded</w> a quick greeting to his old neighbor as he passed by."
                            }
                        }
                    ],
                    "synonyms": [
                        "ja knikken",
                        "toeknikken"
                    ],
                    "antonyms": [
                        "schudden"
                    ],
                    "common_phrases": [
                        "vriendelijk knikken",
                        "even knikken"
                    ],
                    "target_lang_definitions": {
                        "en": "to make a vertical movement with the head to confirm something or to greet someone"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "nod",
                                "target_lang_sense_clarification": "to move the head up and down in agreement or greeting"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b5eb454b-5697-3d6d-8362-b87384aa37ac",
                    "sense_definition": "het onvrijwillig buigen van de knieën, vaak door zwakte, angst of vermoeidheid",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "lichaamsreactie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ze voelt haar knieën <w>knikken</w> en zoekt snel steun bij een stevige stoel.",
                            "target_lang_translations": {
                                "en": "She feels her knees <w>buckle</w> and quickly looks for support from a sturdy chair."
                            }
                        },
                        {
                            "text": "Na de lange marathon begon hij door zijn benen te <w>knikken</w> van pure uitputting.",
                            "target_lang_translations": {
                                "en": "After the long marathon, his legs began to <w>give way</w> from pure exhaustion."
                            }
                        }
                    ],
                    "synonyms": [
                        "doorzakken",
                        "beven"
                    ],
                    "common_phrases": [
                        "knieën knikken"
                    ],
                    "target_lang_definitions": {
                        "en": "the involuntary bending of the knees, often due to weakness, fear, or fatigue"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "buckle",
                                "target_lang_sense_clarification": "when knees give way due to weakness or pressure"
                            },
                            {
                                "target_lang_word": "shake",
                                "target_lang_sense_clarification": "when legs tremble from fear or exhaustion"
                            },
                            {
                                "target_lang_word": "give way",
                                "target_lang_sense_clarification": "to suddenly bend or collapse"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e3bc654-1d7e-376d-9f59-83f674735f6e",
                    "sense_definition": "het maken van een scherpe, hoekige buiging in een voorwerp of lijn",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "vormverandering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door de enorme hitte begon het metaal van de rails gevaarlijk te <w>knikken</w>.",
                            "target_lang_translations": {
                                "en": "Due to the extreme heat, the metal of the rails began to <w>buckle</w> dangerously."
                            }
                        },
                        {
                            "text": "Je moet de slang niet te ver <w>knikken</w>, want dan stopt de watertoevoer direct.",
                            "target_lang_translations": {
                                "en": "You shouldn't <w>kink</w> the hose too much, because then the water supply stops immediately."
                            }
                        }
                    ],
                    "synonyms": [
                        "buigen",
                        "omknikken"
                    ],
                    "common_phrases": [
                        "hoekig knikken"
                    ],
                    "target_lang_definitions": {
                        "en": "making a sharp, angular bend in an object or line"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "kink",
                                "target_lang_sense_clarification": "to form a sharp twist or bend in something like a hose or wire"
                            },
                            {
                                "target_lang_word": "buckle",
                                "target_lang_sense_clarification": "to bend or collapse under heat or pressure"
                            },
                            {
                                "target_lang_word": "bend",
                                "target_lang_sense_clarification": "to curve or angle sharply"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "eb0da961-5fba-387d-a7bd-2308703c1086",
                    "sense_definition": "meervoud van het zelfstandig naamwoord <w>knik</w>; meerdere scherpe buigingen of korte hoofdbewegingen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De weg naar het dorp heeft vele scherpe <w>knikken</w> waar je voorzichtig moet rijden.",
                            "target_lang_translations": {
                                "en": "The road to the village has many sharp <w>bends</w> where you have to drive carefully."
                            }
                        },
                        {
                            "text": "Met een paar korte <w>knikken</w> gaf de directeur aan dat hij het voorstel begreep.",
                            "target_lang_translations": {
                                "en": "With a few short <w>nods</w>, the director indicated that he understood the proposal."
                            }
                        }
                    ],
                    "synonyms": [
                        "buigingen",
                        "bochten"
                    ],
                    "common_phrases": [
                        "scherpe knikken"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural of knik"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "plural of the noun 'knik'; multiple sharp bends or short head movements"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "nods",
                                "target_lang_sense_clarification": "multiple movements of the head"
                            },
                            {
                                "target_lang_word": "kinks",
                                "target_lang_sense_clarification": "multiple sharp bends in a line or object"
                            },
                            {
                                "target_lang_word": "bends",
                                "target_lang_sense_clarification": "sharp turns in a road or path"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}