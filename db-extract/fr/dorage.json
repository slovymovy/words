                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2d3e80a3-eebe-3350-85e7-3157855ede09",
                        "entry_id": "d64c8781-639c-3a33-86de-9aa6397f2dc9",
                        "glosses": [
                            "Action de donner à un objet la couleur, l'aspect, de l'or."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93d49a50-66d2-48c7-adcc-d4e134940bf9",
                                "sense_id": "2d3e80a3-eebe-3350-85e7-3157855ede09",
                                "text": "Comme pour le minaï, le lajvardina est une technique de petit feu, mais le décor se contente de peinture de couleurs rouge, noir et blanc, plus un dorage à froid, sur une glaçure transparent bleue ou turquoise."
                            },
                            {
                                "example_id": "bd5c7404-72b4-41dc-b055-3e07d6da104b",
                                "sense_id": "2d3e80a3-eebe-3350-85e7-3157855ede09",
                                "text": "En effet, depuis longtemps, la Manufacture Nationale de Sèvres emploie, par inspiration purement empirique, du nitrate de bismuth pour le dorage de la porcelaine."
                            }
                        ]
                    }
