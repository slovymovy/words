                                        "glosses": [
                                            "A high-level programming language first developed in the 1950s for scientific, engineering, and numerical computation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3778562f-c043-497c-9882-337fe19fa6d8",
                                                "sense_id": "e43cf428-6946-31c5-847f-dfe246c0f9c6",
                                                "text": "He was the defiant homesteader, the crusty senior member of a research team who understood Algol and Fortran but couldn't read the secrets of his own heart."
                                            },
                                            {
                                                "example_id": "7f8bc5a3-87e4-4cd0-8d0c-421af132b6c4",
                                                "sense_id": "e43cf428-6946-31c5-847f-dfe246c0f9c6",
                                                "text": "In addition to the Fortran operators that are intrinsic (built in), there may be user-defined operators in expressions."
                                            }
                                        ]
