                "senses": [
                    {
                        "sense_id": "000c748e-66cf-3206-95ff-076c8e0742d2",
                        "entry_id": "e05da6ff-d136-33e8-9b57-c17de428bb9e",
                        "glosses": [
                            "andere Bezeichnung für Senfkorn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ef51334-6107-4bf6-8733-d6204bce810d",
                                "sense_id": "000c748e-66cf-3206-95ff-076c8e0742d2",
                                "text": "„Im 4. Jahrhundert wurde Senf dann zum beliebten Würzmittel, indem man gemahlene Senfsaat mit Honig, Olivenöl und Essig mischte.“"
                            },
                            {
                                "example_id": "06e44025-40b3-4a6d-8621-84cb94259638",
                                "sense_id": "000c748e-66cf-3206-95ff-076c8e0742d2",
                                "text": "„Aromatisch duften die Idlis, die Reiskuchen mit Senfsaat-Kokosnuss-Chutney, die Frau Sivaraman für ihre Gäste gekocht hat.“"
                            },
                            {
                                "example_id": "2adfed24-e157-4d26-88bd-0e738e4798e7",
                                "sense_id": "000c748e-66cf-3206-95ff-076c8e0742d2",
                                "text": "„[..] Aber woher kommen Senfsaat, Branntweinessig, Honig, Zucker und Salz?“"
                            },
                            {
                                "example_id": "e2ca9c53-e123-4d15-b4cc-d2918c93390a",
                                "sense_id": "000c748e-66cf-3206-95ff-076c8e0742d2",
                                "text": "„[..] Einen TL Senfsaat, die frische Chilischote, Limettenblätter und die Ingwerwürfel darin einige Minuten anbraten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
