                    {
                        "translation_id": "1d5ccb9c-a74b-430b-a9a8-5b1ea52b7ec9",
                        "source_entry_id": "8c5596a3-497e-36af-8d2a-8bf9c9f220fa",
                        "source_sense_id": "1c1a29fd-c65e-3c27-bacd-bf9de7169479",
                        "source_sense_description": "study of literary style",
                        "target_lang_word": "Stilistik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stilistik",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b96f67d3-f6a3-3afe-8e3b-7a5af40c0e2f",
                                        "entry_id": "8f3c0aba-3fb5-3caf-8293-60c688bc91a5",
                                        "glosses": [
                                            "Erforschung und Lehre des Stils"
                                        ],
                                        "tags": [
                                            "Literaturwissenschaft",
                                            "Stilistik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6f6a7d4-739d-4e4a-aa4c-fe5fb16e7adc",
                                                "sense_id": "b96f67d3-f6a3-3afe-8e3b-7a5af40c0e2f",
                                                "text": "Die Stilistik untersucht Stil unter vielen verschiedenen Aspekten (besonderer Stil eines Werkes, Stilmerkmale einer Gattung, etc.) und vergleicht Stile miteinander."
                                            },
                                            {
                                                "example_id": "8693a5a6-f8dd-47b0-8575-090247bae617",
                                                "sense_id": "b96f67d3-f6a3-3afe-8e3b-7a5af40c0e2f",
                                                "text": "„Spricht z. B. die Stilistik von Stilnormen, Stilelementen, Stilzügen, um die stilistische Textqualität zu bestimmen, so muß sie auf lexikologische Kategorien zurückgreifen; denn stilistische Qualitäten beruhen auch auf den lexikalischen Eigenschaften der Sprachmittel.“"
                                            },
                                            {
                                                "example_id": "72008535-bdaa-4c8c-a5cb-9d5774af2083",
                                                "sense_id": "b96f67d3-f6a3-3afe-8e3b-7a5af40c0e2f",
                                                "text": "„Die Stilistik ihrerseits geht zurück auf die Rhetorik, die antike Lehre von der (öffentlichen) Lehre.“"
                                            },
                                            {
                                                "example_id": "0091a9ed-5f47-46f4-b4a6-4ea93b75ec93",
                                                "sense_id": "b96f67d3-f6a3-3afe-8e3b-7a5af40c0e2f",
                                                "text": "„Bücher über Stilistik neigen dazu, uns vom Gebrauch des Zeichens grundsätzlich abzuraten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
