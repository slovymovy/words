                        "glosses": [
                            "Qualifie une fièvre qui dure mais dont on ne connaît pas la cause."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9840826-2dcf-4bcd-a40d-13d845f7927c",
                                "sense_id": "d9a3a6d7-d66f-3590-81c6-c7ec51335439",
                                "text": "De la fièvre synoque simple. Cette fièvre ressemble beaucoup à la fièvre éphèmère, dont elle ne diffère que parce qu'elle se prolonge ordinairement jusqu'au septième jour. Du reste elle commence par un léger frisson, suivi plutôt ou plus tard d'une chaleur médiocre, avec insomnie, et un peu de mal de tête, mais sans redoublemens, ou avec une très-légère augmentation de fièvre le soir."
                            }
                        ]
                    }
                ],
