                    {
                        "translation_id": "ea886213-a1c0-4c12-baa4-2d86af92d5e2",
                        "source_entry_id": "9c4dabe4-5d5c-39ea-a1c7-c7ceb0b86b7c",
                        "source_sense_description": "architectural element",
                        "target_lang_word": "Ziergiebel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ziergiebel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8321eb19-44f6-3cf8-b49f-0b704650b0ee",
                                        "entry_id": "974b01db-8d09-3291-9b5b-21eb335815a5",
                                        "glosses": [
                                            "ein Giebel, der lediglich zur Dekoration dient und dabei über den Dachraum hinausragt oder gar keinen Dachraum hinter sich hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5180d101-70c5-49ff-a088-5b5af26a8207",
                                                "sense_id": "8321eb19-44f6-3cf8-b49f-0b704650b0ee",
                                                "text": "Während des Sturms brach der Ziergiebel unseres Nachbarhauses und fiel auf die Straße."
                                            },
                                            {
                                                "example_id": "dc8902cd-feaa-42cc-a160-48e93fa8d151",
                                                "sense_id": "8321eb19-44f6-3cf8-b49f-0b704650b0ee",
                                                "text": "Das Rathaus von Stralsund beeindruckt durch seine imposanten Ziergiebel."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3c342dfc-eb3e-4942-805a-367677748dbe",
                        "source_entry_id": "9c4dabe4-5d5c-39ea-a1c7-c7ceb0b86b7c",
                        "source_sense_description": "architectural element",
                        "target_lang_word": "Giebel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Giebel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ebd1d278-e1ea-3989-bc90-ea35c46f3bce",
                                        "entry_id": "a0f03131-5ea9-3fa2-8617-17e101aa8459",
                                        "glosses": [
                                            "der Wandteil zwischen den Schrägen eines Satteldaches"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c754b287-a409-46f3-bac9-051f4c705e73",
                                                "sense_id": "ebd1d278-e1ea-3989-bc90-ea35c46f3bce",
                                                "text": "Giebel können sehr hoch sein."
                                            },
                                            {
                                                "example_id": "58811657-47c5-467b-b839-b8891df18186",
                                                "sense_id": "ebd1d278-e1ea-3989-bc90-ea35c46f3bce",
                                                "text": "Manche Häuser stehen mit dem Giebel zur Straße."
                                            },
                                            {
                                                "example_id": "d41fdf20-b155-4558-be03-6ff3f2d9a9cd",
                                                "sense_id": "ebd1d278-e1ea-3989-bc90-ea35c46f3bce",
                                                "text": "Im Trend liegen jetzt große Glasflächen in der Hausfassade selbst, die eine Außenwand komplett transparent machen, einen Giebel von Kopf bis Fuß durchsichtig werden lassen oder dem Wohnbereich mit Galerie eine Lichtinsel verschaffen."
                                            },
                                            {
                                                "example_id": "a0e8b8aa-5f30-4350-92ad-1a2684dc7b49",
                                                "sense_id": "ebd1d278-e1ea-3989-bc90-ea35c46f3bce",
                                                "text": "„Ein langes, gelbes Gebäude, das inmitten eines Parks stand, fiel ihr ins Auge und Häuser mit kunstvollen Giebeln und Turmzimmern, die über den Dächern aufragten.“"
                                            },
                                            {
                                                "example_id": "091ccd52-9c12-4ada-a67f-4cbdf8ab3ffc",
                                                "sense_id": "ebd1d278-e1ea-3989-bc90-ea35c46f3bce",
                                                "text": "„An den Giebeln freilich, die oft mit spielerischen Türmchen und Figuren aus Stuck verziert waren, zeigten sich Bruchstellen und Löcher, auch fehlten häufig die Butzenscheiben in den schmalen Fenstern, die im Erdgeschoß vergittert waren.“"
                                            },
                                            {
                                                "example_id": "15d3d420-8ac2-47ca-99e0-7227ce9fd5fd",
                                                "sense_id": "ebd1d278-e1ea-3989-bc90-ea35c46f3bce",
                                                "text": "„Jón Hreggvidsson, der schwarze Dieb, hat sich rittlings auf den First gesetzt, seine Beine schlenkern über dem Giebel, und er singt ältere Pontus-Reime.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Giebel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "83954b9b-8186-34b3-9219-a53d0b6e113d",
                                        "entry_id": "bee0318f-197b-3c99-aee3-3e909e402010",
                                        "glosses": [
                                            "Fisch, der der Gattung der Karpfenfische, carassius gibelio angehört"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "990045a0-9e27-4b0f-96aa-92ff727f09b5",
                                                "sense_id": "83954b9b-8186-34b3-9219-a53d0b6e113d",
                                                "text": "Der Goldfisch ist eine ostasiatische Zierform des Giebels."
                                            },
                                            {
                                                "example_id": "fc7fc060-9e42-464c-a468-dbf983529d41",
                                                "sense_id": "83954b9b-8186-34b3-9219-a53d0b6e113d",
                                                "text": "„In der Mark Brandenburg und Pommern heisst dieser Fisch Giebel; in Preussen Gieben; in Schlesien kleiner Karafs und Giblichen; und in Sachsen Steinkarausch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
