                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>vraag</w> me af hoe laat de trein vertrekt.",
                            "target_lang_translations": {
                                "en": "I <w>wonder</w> what time the train leaves.",
                                "ru": "Я <w>спрашиваю</w> себя (интересуюсь), во сколько отправляется поезд.",
                                "pl": "<w>Zastanawiam się</w>, o której godzinie odjeżdża pociąg.",
                                "de": "Ich <w>frage</w> mich, um wie viel Uhr der Zug abfährt.",
                                "fr": "Je me <w>demande</w> à quelle heure le train part.",
                                "it": "Mi <w>chiedo</w> a che ora parta il treno.",
                                "cs": "<w>Ptám se</w> sám sebe, v kolik hodin ten vlak odjíždí.",
                                "tr": "Trenin saat kaçta kalkacağını <w>merak ediyorum</w>.",
                                "es": "Me <w>pregunto</w> a qué hora sale el tren."
                            }
                        },
                        {
                            "text": "Ik <w>vraag</w> om hulp omdat ik het niet alleen kan.",
                            "target_lang_translations": {
                                "en": "I <w>ask</w> for help because I cannot do it alone.",
                                "ru": "Я <w>прошу</w> о помощи, потому что не могу справиться один.",
                                "pl": "<w>Proszę</w> o pomoc, ponieważ nie poradzę sobie sam.",
                                "de": "Ich <w>bitte</w> um Hilfe, weil ich es nicht alleine schaffe.",
                                "fr": "Je <w>demande</w> de l'aide parce que je ne peux pas le faire tout seul.",
                                "it": "<w>Chiedo</w> aiuto perché non posso farcela da solo.",
                                "cs": "<w>Prosím</w> o pomoc, protože to sám nezvládnu.",
                                "tr": "Tek başıma yapamadığım için yardım <w>istiyorum</w>.",
                                "es": "<w>Pido</w> ayuda porque no puedo hacerlo solo."
                            }
