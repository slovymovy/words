                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "topographie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le musée conserve un grand plan en <w>relief</w> de la forteresse construit sous Louis XIV."
                        },
                        {
                            "text": "Les stratèges militaires étudiaient le <w>relief</w> topographique avant de lancer l'offensive sur la vallée."
