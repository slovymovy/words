                "senses": [
                    {
                        "sense_id": "7df5be2c-a5a4-37ec-a40e-b4f0dce8f2f4",
                        "entry_id": "78fc48df-4abd-3360-91fa-ee65f48e8a6f",
                        "glosses": [
                            "stipule"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c49bd885-db57-444e-a19d-ce08fc088aeb",
                                "sense_id": "7df5be2c-a5a4-37ec-a40e-b4f0dce8f2f4",
                                "text": "Серге́й Ива́нович любова́лся всё вре́мя красото́ю загло́хшего от листвы́ ле́са, ука́зывая бра́ту то на тёмную с тени́стой стороны́, пестре́ющую жёлтыми прили́стниками, гото́вящуюся к цве́ту ста́рую ли́пу, то на изумру́дом блестя́щие молоды́е побе́ги дере́в ны́нешнего го́да.",
                                "translation": "Sergey Ivanovitch was all the while admiring the beauty of the woods, which were a tangled mass of leaves, pointing out to his brother now an old lime tree on the point of flowering, dark on the shady side, and brightly spotted with yellow stipules, now the young shoots of this year's saplings brilliant with emerald.",
                                "english": "Sergey Ivanovitch was all the while admiring the beauty of the woods, which were a tangled mass of leaves, pointing out to his brother now an old lime tree on the point of flowering, dark on the shady side, and brightly spotted with yellow stipules, now the young shoots of this year's saplings brilliant with emerald."
                            }
                        ]
                    }
                ],
