                "senses": [
                    {
                        "sense_id": "a517af81-261b-3b67-b0de-787a33da480b",
                        "entry_id": "a0e49bfe-589f-3184-a0b1-6d21c7e07734",
                        "glosses": [
                            "absichtliche Vernichtung des eigenen Wasserfahrzeugs durch Untergang"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26c34664-a15b-48ec-85ff-0679f2485925",
                                "sense_id": "a517af81-261b-3b67-b0de-787a33da480b",
                                "text": "„Nachdem die Siegermächte die Selbstversenkung zunächst als Bruch der Waffenstillstandsbedingungen und als Ausdruck »ungeheuer bösen Willens« verurteilt hatten, waren am Ende zumindest die Briten gar nicht so unzufrieden damit.“"
                            },
                            {
                                "example_id": "d1fc411c-ddc0-4192-a62d-8bf8bbe0a02b",
                                "sense_id": "a517af81-261b-3b67-b0de-787a33da480b",
                                "text": "„Der Plan sah vor, ein randvoll mit Zement beladenes Schiff unter falscher Flagge in den Kanal zu schicken und diesen durch eine Selbstversenkung zu blockieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e6d99954-0da0-3859-8b31-a512ca7a524d",
                        "entry_id": "a0e49bfe-589f-3184-a0b1-6d21c7e07734",
                        "glosses": [
                            "tiefe Konzentration"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62ae961d-9dac-413e-bb3a-3984e2bcd2a1",
                                "sense_id": "e6d99954-0da0-3859-8b31-a512ca7a524d",
                                "text": "„Die Konzentration nach innen, z. B. die Beobachtung des eigenen Atems, nennt man auch Selbstversenkung.“"
                            },
                            {
                                "example_id": "d87d1956-262b-4216-acd8-58c11eb8cce0",
                                "sense_id": "e6d99954-0da0-3859-8b31-a512ca7a524d",
                                "text": "„Selbstversenkung meint nun einen bestimmten Umgang mit sich und der Welt, den sich ein Mensch errichten kann: seine Hingabe an das Wirken des Geistes in seinem Leibe und in seiner Geschichte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
