                "senses": [
                    {
                        "sense_id": "3252e084-2918-3d70-8cef-de068739787a",
                        "entry_id": "5393d501-ebce-3504-87f7-30e4f670f86e",
                        "glosses": [
                            "im Winter üblicher Himmel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cfa5837-03b3-4115-b985-08ebacddb654",
                                "sense_id": "3252e084-2918-3d70-8cef-de068739787a",
                                "text": "„Das helle Blau des Winterhimmels ging am Horizont in ein tiefes, dunkles Blau über.“"
                            },
                            {
                                "example_id": "412026b6-dea7-43ba-a117-34c423fd201c",
                                "sense_id": "3252e084-2918-3d70-8cef-de068739787a",
                                "text": "„Das baufällige Dach bildete ein wirres Puzzle vor dem Winterhimmel, und im da und dort durchbrochenen Düster konnte er ein paar alte, mit staubigen Einweckgläsern gefüllte Kisten sehen.“"
                            },
                            {
                                "example_id": "90ea486c-4fc5-46ee-b8d3-70b31e30f69d",
                                "sense_id": "3252e084-2918-3d70-8cef-de068739787a",
                                "text": "„Das Gewand des Priesters, einst das Prächtigste im ganzen Dorf, wirkte jetzt so trist wie der Winterhimmel.“"
                            },
                            {
                                "example_id": "8a49f304-98cc-4338-92b4-27a586f3ddbb",
                                "sense_id": "3252e084-2918-3d70-8cef-de068739787a",
                                "text": "„Wenn aber der Winterhimmel klar war und das Firmament über dem weißen, stillen Fjord glitzerte, dann legte sich Skúli zu ihm ins Bett unter dem großen Mansardenfenster, und gemeinsam reisten sie zu den Sternen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
