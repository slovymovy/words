                    {
                        "sense_id": "ddab5191-8732-3b8f-bf0c-f49f62ed83dc",
                        "entry_id": "b950a1c3-a620-3cd2-a075-3d1aa2844bab",
                        "glosses": [
                            "Qui est de la même province."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "510778b2-9e72-34f2-9032-16baadd3dde9",
                        "entry_id": "b950a1c3-a620-3cd2-a075-3d1aa2844bab",
                        "glosses": [
                            "Qualifie les évêques d'une même province ecclésiastique et leurs activités en commun."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "d80be52c-ed88-4ceb-a850-8ef895eba28f",
                                "sense_id": "510778b2-9e72-34f2-9032-16baadd3dde9",
                                "text": "L'an septième de son épiscopat, l'honorable évêque Hincmar tint un synode comprovincial à Soissons, au monastère de Saint-Médard , dans l'église de la Trinité."
                            },
                            {
                                "example_id": "df8c9741-51aa-43fe-851c-1727961963d7",
                                "sense_id": "510778b2-9e72-34f2-9032-16baadd3dde9",
                                "text": "Trèves joue un rôle particulier, sur lequel Hincmar allait revenir à plusieurs reprises, dans les relations avec Reims : les deux métropoles sont comprovinciales."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bcea7552-bfd5-4ab9-b716-972c34164328",
                        "source_entry_id": "b950a1c3-a620-3cd2-a075-3d1aa2844bab",
                        "source_sense_description": "Qui est de la même province.",
                        "target_lang_word": "comprovincial",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "comprovincial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6489b17c-0ef2-301e-b81b-4e84276560ac",
                                        "entry_id": "565a1668-c248-3fa1-a4bb-cf8970eeeea6",
                                        "glosses": [
                                            "Being part of the same province."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32032a7e-7c2a-4032-bc59-22e14ba6651d",
                                                "sense_id": "6489b17c-0ef2-301e-b81b-4e84276560ac",
                                                "text": "He the six Islands, comprouinciall / In auncient times vnto great Britainee, / Shall to the same reduce [...]."
                                            },
                                            {
                                                "example_id": "0ee6bbee-acbf-459f-9146-112103f6e7fe",
                                                "sense_id": "6489b17c-0ef2-301e-b81b-4e84276560ac",
                                                "text": "Inthronization, in ancient times, immediately succeeded the rite of consecration; the new bishop being honourably placed in his episcopal chair by the prelates assembled for his consecration. […] Symeon of Thessalonica states, that the rite of inthronization was formerly celebrated with great solemnity by all the comprovincial bishops."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "comprovincial",
                                "target_lang_code": "en",
                                "target_senses": [
