                                    {
                                        "sense_id": "bc2837db-ad42-364d-a10c-4a040508b7bb",
                                        "entry_id": "a789650c-7248-3b87-bc9e-e05dcc758267",
                                        "glosses": [
                                            "Connaissance préliminaire d’une science, d’une profession, d’un art."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "349b09c2-b674-4650-87ae-3f8b07d1ce01",
                                                "sense_id": "bc2837db-ad42-364d-a10c-4a040508b7bb",
                                                "text": "Initiation à la philosophie, à la chimie."
                                            },
                                            {
                                                "example_id": "3bcbca03-b340-4913-81dc-a262ae15365e",
                                                "sense_id": "bc2837db-ad42-364d-a10c-4a040508b7bb",
                                                "text": "Initiation philosophique."
                                            },
                                            {
                                                "example_id": "114e9581-b4dd-4a6c-bf36-ea860a4e8b04",
                                                "sense_id": "bc2837db-ad42-364d-a10c-4a040508b7bb",
                                                "text": "Ce sont des choses que l’on ne peut faire sans une certaine initiation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48aab144-2379-359f-822d-25701e32f881",
                                        "entry_id": "a789650c-7248-3b87-bc9e-e05dcc758267",
                                        "glosses": [
                                            "Phénomène par lequel une enzyme permet le déclenchement d’une réaction chimique."
