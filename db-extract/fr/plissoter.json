                        "glosses": [
                            "Faire des petits plis."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "376c6bf0-089a-412b-b1b7-63d98c605c23",
                                "sense_id": "8bde4368-48ae-324a-9c2a-36daa4e68535",
                                "text": "A l'extrême, les voûtes tendraient à s'aplatir, puis à se plissoter et se fracturer."
                            },
                            {
                                "example_id": "afd62c08-9d5d-4992-82e2-069d2e94d7e7",
                                "sense_id": "8bde4368-48ae-324a-9c2a-36daa4e68535",
                                "text": "Il est remarquable de constater combien ces sédiments, pourtant très durs, peuvent se plissoter sans se rompre."
                            }
                        ]
                    }
