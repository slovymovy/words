                                "target_senses": [
                                    {
                                        "sense_id": "543cbfa0-4edc-3b82-978e-8423d7d2d765",
                                        "entry_id": "dd4d5139-d351-3f28-aead-b1ac16b0a997",
                                        "glosses": [
                                            ": воплощающий какие-либо качества, свойства"
                                        ],
                                        "tags": [
                                            "в знач. прилагательного"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8fb5582-41f1-40a8-9112-a11c53933df6",
                                                "sense_id": "543cbfa0-4edc-3b82-978e-8423d7d2d765",
                                                "text": "И когда приехали на пикник в лес, я была сама кротость, само лукавство и обаяние."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "adf8d0ee-b44a-3f0e-8552-ff84b5d88acf",
                                        "entry_id": "dd4d5139-d351-3f28-aead-b1ac16b0a997",
                                        "glosses": [
                                            "лично, без посторонней помощи; собственными силами и средствами"
                                        ],
                                        "tags": [
                                            "в знач. наречия"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ac4cdd0-9d4c-4c90-b06b-2eb98c36b217",
                                                "sense_id": "adf8d0ee-b44a-3f0e-8552-ff84b5d88acf",
                                                "text": "Сам же к нам навязался в товарищи, неведомо кто, неведомо откуда, — да ещё и спесивится."
                                            },
                                            {
                                                "example_id": "a00fbc96-8379-400b-bc05-dbb226e10294",
                                                "sense_id": "adf8d0ee-b44a-3f0e-8552-ff84b5d88acf",
                                                "text": "Наследники отыщутся сами."
                                            },
                                            {
                                                "example_id": "53544466-f8d4-49b2-aa7d-d1588ad65375",
                                                "sense_id": "adf8d0ee-b44a-3f0e-8552-ff84b5d88acf",
                                                "text": "Все прививки я делаю сам, обрезку — сам, посадки — сам, всё — сам."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8668fd4-02b0-3bcb-8de4-a3ee56624e8f",
                                        "entry_id": "dd4d5139-d351-3f28-aead-b1ac16b0a997",
                                        "glosses": [
                                            ": по личной инициативе, без требования со стороны"
                                        ],
                                        "tags": [
                                            "в знач. наречия"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f6ba1ca-8181-4eb3-ad82-78a43260213e",
                                                "sense_id": "c8668fd4-02b0-3bcb-8de4-a3ee56624e8f",
                                                "text": "Человек свободен… он за всё платит сам: за веру, за неверие, за любовь, за ум."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "667fb29c-0f63-3c6b-8356-0ab1f4c11113",
                                        "entry_id": "dd4d5139-d351-3f28-aead-b1ac16b0a997",
                                        "glosses": [
                                            "непроизвольно, невольно"
                                        ],
                                        "tags": [
                                            "в знач. наречия"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9baad09a-5a89-43ac-bd8c-4c888a73ffaf",
                                                "sense_id": "667fb29c-0f63-3c6b-8356-0ab1f4c11113",
                                                "text": "Рука сама тянется за гармошкой — и сама отдёргивается."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c05630a8-6207-3010-aba9-cf5c46cc7ef7",
                                        "entry_id": "dd4d5139-d351-3f28-aead-b1ac16b0a997",
                                        "glosses": [
                                            "разг., субстантивир. руководитель, хозяин, главный"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b1c4df9-7583-43dc-9643-daf02e1f3547",
                                                "sense_id": "c05630a8-6207-3010-aba9-cf5c46cc7ef7",
                                                "text": "После обеда подойдёт сам и завизирует вашу заявку."
                                            },
                                            {
                                                "example_id": "9ae40329-47d2-4545-aa0e-0f56f327463b",
                                                "sense_id": "c05630a8-6207-3010-aba9-cf5c46cc7ef7",
                                                "text": "Затем появился «сам» — начальник тюрьмы, пожилой, полный, в большой серой бороде, расчёсанной на две стороны."
                                            }
                                        ]
                                    }
                                ]
                            }
