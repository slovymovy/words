                ],
                "senses": [
                    {
                        "sense_id": "87da5dcb-be25-3d3c-8def-54d16ef0985f",
                        "entry_id": "d800ccdc-b6cd-361f-8785-732166918e15",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3409774-826c-44b7-bd05-76cfc9e0899c",
                                "sense_id": "87da5dcb-be25-3d3c-8def-54d16ef0985f",
                                "text": "Frau Fiedler ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "23d75be1-cbb5-46a9-90dd-33141a18651d",
                                "sense_id": "87da5dcb-be25-3d3c-8def-54d16ef0985f",
                                "text": "Herr Fiedler wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "4b5646fc-1425-4ad2-9d5b-baccdb6f1c83",
                                "sense_id": "87da5dcb-be25-3d3c-8def-54d16ef0985f",
                                "text": "Die Fiedlers kommen heute aus der Oberlausitz."
                            },
                            {
                                "example_id": "a50d4f42-e2a8-4f87-80c6-aef3e6ac35c1",
                                "sense_id": "87da5dcb-be25-3d3c-8def-54d16ef0985f",
                                "text": "Der Fiedler trägt nie die Schals, die die Fiedler ihm strickt."
                            },
                            {
                                "example_id": "37809fd4-2d46-40a9-a3f8-2b00248966c6",
                                "sense_id": "87da5dcb-be25-3d3c-8def-54d16ef0985f",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Fiedler kommt, geht der Herr Fiedler.“"
                            },
                            {
                                "example_id": "0a68d633-884e-4f77-b8c9-49c3bdfd90e4",
                                "sense_id": "87da5dcb-be25-3d3c-8def-54d16ef0985f",
                                "text": "Fiedler kommt und geht."
                            },
                            {
                                "example_id": "62ff3ae0-5737-402f-8d9b-289c34efb96a",
                                "sense_id": "87da5dcb-be25-3d3c-8def-54d16ef0985f",
                                "text": "Fiedlers kamen, sahen und siegten."
                            },
                            {
                                "example_id": "c4fc5405-30a0-4cbc-b03d-eabcf8f40965",
                                "sense_id": "87da5dcb-be25-3d3c-8def-54d16ef0985f",
                                "text": "An verregneten Herbsttagen ist Familie Fiedlers liebste Beschäftigung das Bemalen von Hühnereiern."
                            },
                            {
                                "example_id": "033c751f-e689-4140-96de-565369416f24",
                                "sense_id": "87da5dcb-be25-3d3c-8def-54d16ef0985f",
                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Fiedler das Schmücken von Weihnachtsbäumen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
