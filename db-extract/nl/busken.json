                ],
                "senses": [
                    {
                        "sense_id": "5c51dddb-0b62-3cea-9de9-e8a9773e2f21",
                        "entry_id": "f9cdf21a-5b2e-36f3-885e-93b888d77605",
                        "glosses": [
                            "geld verdienen als straatmuzikant"
                        ],
                        "tags": [
                            "unergative"
                        ],
                        "examples": [
                            {
                                "example_id": "e87ac0ad-9d7c-44dd-a1b2-2e5afddc283b",
                                "sense_id": "5c51dddb-0b62-3cea-9de9-e8a9773e2f21",
                                "text": "Op het podium zijn Black Pumas een uit de kluiten gewassen septet, maar de twee heren die écht de lakens uitdelen zijn zanger-gitarist Eric Burton, die het métier leerde door te busken op de straathoeken van zijn thuisstad Austin, en gitarist-producer Adrian Quesada, die ooit toerde in de band van Prince en zijn unieke stempel drukt op de sound van de Pumas."
                            },
                            {
                                "example_id": "5e8127fd-7df1-4b10-b09b-c2102d657876",
                                "sense_id": "5c51dddb-0b62-3cea-9de9-e8a9773e2f21",
                                "text": "Zo sta je als dakloze te busken in de Parijse metrogangen, zo sta je naast acts als Arctic Monkeys en Paul McCartney in „Later... With Jools”."
                            }
                        ]
                    },
                    {
