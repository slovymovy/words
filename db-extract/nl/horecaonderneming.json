                        "examples": [
                            {
                                "example_id": "c811fa99-0943-4125-9c0f-4c08bc96b170",
                                "sense_id": "e7f22ef0-858c-32bc-858d-010fa14b40dd",
                                "text": "Studentenverenigingen met een eigen bar zijn ook een horecaonderneming. Net als die horecazaken worden de verenigingen door bierbrouwerijen financieel aangemoedigd om zo veel mogelijk bier te verkopen. Dat gaat via een korting, de zogenoemde hectoliterbonus."
                            },
                            {
                                "example_id": "71b2d2d1-8f9d-4a95-ac79-b487522b6ce8",
                                "sense_id": "e7f22ef0-858c-32bc-858d-010fa14b40dd",
                                "text": "De horecaonderneming in het fraaie gerestaureerde Jugendstil-pandje heeft de afgelopen jaren verschillende exploitanten gehad. Begin 2016 stapte Gaston Olde Olthof als laatste in als chef-kok en bedrijfsleider. Hij introduceerde ook een ander concept. Square behield zijn naam maar ging van een exclusief en chic restaurant naar een moderne variant dat zich richtte op het brede publiek. Op de benedenverdieping werd onder andere een café-achtige setting gecreëerd voor de ‘Square Gastrobar’."
                            }
                        ]
                    }
