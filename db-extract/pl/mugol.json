                "senses": [
                    {
                        "sense_id": "b3e5448c-999e-3829-a20c-c9893b5aa4a8",
                        "entry_id": "5e34bd92-e4bd-3dcc-84ab-79fc58f2d748",
                        "glosses": [
                            "osoba nieposiadająca magicznych zdolności"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbae9d84-448e-4a66-a2df-8dd541d17988",
                                "sense_id": "b3e5448c-999e-3829-a20c-c9893b5aa4a8",
                                "text": "Już ci powiedziałem, że jak będzie chciał tam pójść, taki wielki mugol jak ty, nie zdoła go powstrzymać."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "ce5c55d1-20ac-345e-83fa-0269b0cbd625",
                        "entry_id": "5e34bd92-e4bd-3dcc-84ab-79fc58f2d748",
                        "glosses": [
                            "osoba ociemniała, głupia"
                        ],
                        "tags": [
                            "pejorative",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "97a240d9-ad45-4ad2-bb80-f81e43fc1813",
                                "sense_id": "ce5c55d1-20ac-345e-83fa-0269b0cbd625",
                                "text": "Marek to jest jednak mugol – znów dostał pałę z matematyki."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "bce6d6e0-1b60-3143-aa8a-ac8b4c1519ce",
                        "entry_id": "5e34bd92-e4bd-3dcc-84ab-79fc58f2d748",
                        "glosses": [
                            "osoba nielubiana"
                        ],
                        "tags": [
                            "pejorative",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "d65637cb-9a18-4726-9f60-2b8ba3d68789",
                                "sense_id": "bce6d6e0-1b60-3143-aa8a-ac8b4c1519ce",
                                "text": "Nie przyjdę na tę imprezę, jeśli będzie tam ten mugol."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "6a14e1df-2064-3462-abd4-8452167d0a71",
                        "entry_id": "5e34bd92-e4bd-3dcc-84ab-79fc58f2d748",
                        "glosses": [
                            "osoba kierująca się racjonalnymi przesłankami, niewierząca w zjawiska nadprzyrodzone i rzeczy, których nie można wytłumaczyć naukowymi metodami"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "00606134-8b39-4a05-b602-9d4bcb7b8a33",
                                "sense_id": "6a14e1df-2064-3462-abd4-8452167d0a71",
                                "text": "Jest takim mugolem, że nie wierzy nawet w UFO."
                            }
                        ],
                        "sense_index_json": "\"1.4\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c7b7584b-59f0-46d1-9f16-1fd19734a6ef",
                        "source_entry_id": "5e34bd92-e4bd-3dcc-84ab-79fc58f2d748",
                        "source_sense_id": "b3e5448c-999e-3829-a20c-c9893b5aa4a8",
                        "target_lang_word": "Muggle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Muggle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fe7c0361-5c82-37ee-9f04-476af6b3900f",
                                        "entry_id": "da5df6c5-bf8b-3a95-8367-db7f1c23ec04",
                                        "glosses": [
                                            "A person who has no magical abilities."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36a4e5cb-4168-4717-8669-21ce3fe287ef",
                                                "sense_id": "fe7c0361-5c82-37ee-9f04-476af6b3900f",
                                                "text": "The magical and the muggle are separated by a river, wide and deep. I could see across, but I couldn't get across, [...]."
                                            },
                                            {
                                                "example_id": "33d9bc4b-24ad-4227-911c-e9751671f729",
                                                "sense_id": "fe7c0361-5c82-37ee-9f04-476af6b3900f",
                                                "text": "Once again, THE magic-working Karmidee, marginalized by THE Muggle-ish Normals, are threatened by a coup in THE city's government [...]"
                                            },
                                            {
                                                "example_id": "33d87e9c-38b5-42af-9840-7bd306484fb1",
                                                "sense_id": "fe7c0361-5c82-37ee-9f04-476af6b3900f",
                                                "text": "In her second outing as a witch — the first being Practical Magic (1998) — Nicole Kidman plays Isabel, a witch who's trying to settle down to the Muggle life of a suburban housewife."
                                            },
                                            {
                                                "example_id": "01097d9e-167e-46b2-851e-8982ffdf991f",
                                                "sense_id": "fe7c0361-5c82-37ee-9f04-476af6b3900f",
                                                "text": "It could all be deadly earnest if she didn't have a sense of humor. My favorite sentence is a chapter title: \"Every time you hear a bell, a Muggle has turned magical.\""
                                            },
                                            {
                                                "example_id": "cabd8722-a606-42bf-8dcb-4ca697df9a2c",
                                                "sense_id": "fe7c0361-5c82-37ee-9f04-476af6b3900f",
                                                "text": "As it was nearing Halloween, we were able to join a potions class where we could change liquids into myriad colours with the addition of substances like dragon spit (muggle’s lemon juice)."
                                            },
                                            {
                                                "example_id": "201c18e6-1437-4c24-ad04-2cd5d45a33ee",
                                                "sense_id": "fe7c0361-5c82-37ee-9f04-476af6b3900f",
                                                "text": "There's another guy playing [Bob] Dylan as a formal poet facing some kind of muggle inquisition, but this is the movie's briefest and least consequential thread."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73b094d5-6fa2-31af-992a-268686383463",
                                        "entry_id": "da5df6c5-bf8b-3a95-8367-db7f1c23ec04",
                                        "glosses": [
                                            "A person who lacks a particular ability or skill; a non-specialist; (also) a person who is not a member of a group; an outsider or cowan."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a542cab5-a9cd-4131-881f-4d95c8274bd2",
                                                "sense_id": "73b094d5-6fa2-31af-992a-268686383463",
                                                "text": "[...] I have finally worked out that the word ECNALUBMA in back-to-front writing translates as 'get out of my way, you Muggle motorist'."
                                            },
                                            {
                                                "example_id": "916002c5-c6b6-4c76-8ff6-fa7e7268595c",
                                                "sense_id": "73b094d5-6fa2-31af-992a-268686383463",
                                                "text": "This video game won’t appeal to muggles."
                                            },
                                            {
                                                "example_id": "1ead9475-ded4-43c1-996d-59524336bd67",
                                                "sense_id": "73b094d5-6fa2-31af-992a-268686383463",
                                                "text": "Some activists might know little of this ‘exterior’, such is their facility to move between activist spaces and places without having to encounter the ever-increasingly one-dimensional world in which the ‘muggles’ live."
                                            },
                                            {
                                                "example_id": "478b82d8-cfd4-496a-9c57-ad2ab53d1e02",
                                                "sense_id": "73b094d5-6fa2-31af-992a-268686383463",
                                                "text": "But to me, remembering what it was like to be a beginner is also an exercise in humility. I see a lot of people wanting to push ahead, faster, in all directions, and I find this to be… woefully out of step with even the Muggles who know me, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0dd25157-31aa-3993-b263-c0015214b783",
                                        "entry_id": "da5df6c5-bf8b-3a95-8367-db7f1c23ec04",
                                        "glosses": [
                                            "A person who lacks a particular ability or skill; a non-specialist; (also) a person who is not a member of a group; an outsider or cowan.",
                                            "A person not involved in the pastime of geocaching."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "627f8399-24ec-4747-aa62-f9dbd463b985",
                                                "sense_id": "0dd25157-31aa-3993-b263-c0015214b783",
                                                "text": "At some point when you're out geocaching, you'll run into Muggles. The trouble with Muggles is they have no idea what the sport of geocaching is all about. If they see you find a cache, they might get into the cache after you leave—to see what you were up to."
                                            },
                                            {
                                                "example_id": "653ebedf-8678-48ea-91c4-caf5b7a19fd0",
                                                "sense_id": "0dd25157-31aa-3993-b263-c0015214b783",
                                                "text": "Try not to let the muggles see you find a Cache."
                                            },
                                            {
                                                "example_id": "bdd4af3c-bec3-4297-aab7-fcce0f6a41c1",
                                                "sense_id": "0dd25157-31aa-3993-b263-c0015214b783",
                                                "text": "Use Stealth. Commonly used in a place with a high muggle-to-geocacher ratio."
                                            },
                                            {
                                                "example_id": "c58ae2a1-91b4-4583-9211-9c5efb2c6395",
                                                "sense_id": "0dd25157-31aa-3993-b263-c0015214b783",
                                                "text": "Each time we made a find [Teresa] Hinton would check there were no muggles, or non-geocachers, around before taking the container from its hiding place."
                                            },
                                            {
                                                "example_id": "0f984746-ea65-4995-867b-a26d18efbe53",
                                                "sense_id": "0dd25157-31aa-3993-b263-c0015214b783",
                                                "text": "Caches can be hidden in a disguised container, or very small package, and one element of difficulty is hiding caches in urban locations, where the hunter will have to avoid being spotted by ‘muggles’ – the name given to those unaware of the sport. Muggles will be surprised at the scale of the secret game taking place under their noses."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b909f0e8-4a37-4a73-87ba-d19ac7e79524",
                        "source_entry_id": "5e34bd92-e4bd-3dcc-84ab-79fc58f2d748",
                        "source_sense_id": "b3e5448c-999e-3829-a20c-c9893b5aa4a8",
                        "target_lang_word": "moldu",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "moldu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "71d0042c-9eaa-301b-8dad-6ef3ff2d67ee",
                                        "entry_id": "6b38c191-54e6-32db-a8b3-1c95343361b0",
                                        "glosses": [
                                            "Personne ne possédant pas de pouvoirs magiques."
                                        ],
                                        "tags": [
                                            "Fantastique",
                                            "Univers de Harry Potter"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7aec261-1d5c-4a8c-8bdc-99fe38ab4ac9",
                                                "sense_id": "71d0042c-9eaa-301b-8dad-6ef3ff2d67ee",
                                                "text": "Chaque année, c’est pareil ! La gare est pleine de moldus !"
                                            },
                                            {
                                                "example_id": "493772a8-f40f-49b8-89e1-bc1ce1c8d9d0",
                                                "sense_id": "71d0042c-9eaa-301b-8dad-6ef3ff2d67ee",
                                                "text": "Avis aux Moldus, fans de la saga Harry Potter : l’école de magie bretonne du Rocher-Portail, située à Maen Roch (Ille-et-Vilaine), rouvre ses portes pour la saison estivale dès aujourd’hui"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b71716d5-bacc-4fd3-8c79-b45239df7cc4",
                        "source_entry_id": "5e34bd92-e4bd-3dcc-84ab-79fc58f2d748",
