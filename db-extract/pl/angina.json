                                        "sense_id": "cb28a2a3-db7c-31a2-a280-08169a947140",
                                        "entry_id": "ec904e3c-eaf8-3bc6-9fd3-a8892f9bc649",
                                        "glosses": [
                                            "Bezeichnung für ein Gefühl der Enge und Beklemmung"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "883dbd1a-49be-39c2-9d4c-c3d7eddf3c39",
                                        "entry_id": "ec904e3c-eaf8-3bc6-9fd3-a8892f9bc649",
                                        "glosses": [
                                            "Krankheit, die mit dem Gefühl von Enge und Beklemmung einhergeht, insbesondere die infektiöse Entzündung des Rachens und der Mandeln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "840ca076-a397-4648-8d51-3bd2190550c7",
                                                "sense_id": "883dbd1a-49be-39c2-9d4c-c3d7eddf3c39",
                                                "text": "„Ich bekam immer wieder Angina mit sehr hohem Fieber.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5165af04-de8f-4425-8cb0-674fb1266dbe",
                        "source_entry_id": "2c59e265-8164-31bc-8c6f-a827e9381ff9",
                        "source_sense_id": "cc2c0003-c479-36c2-899a-fbbbdfcc3d82",
                        "target_lang_word": "ангина",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ангина",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "88475ad0-4a93-3c11-a585-80c14db02872",
                                        "entry_id": "5ed7ba67-2482-3dc8-b8cd-1fc53428ad33",
                                        "glosses": [
                                            "мед. острое инфекционное заболевание, для которого характерно воспаление лимфоидных образований глоточного кольца, чаще всего — миндалин"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e644645c-e6fe-4b2e-8177-462017f15d36",
                                                "sense_id": "88475ad0-4a93-3c11-a585-80c14db02872",
                                                "text": "Захворал Кома, говорят ― ангиной. Если не врут, то ангина ничего. У Татьяны были неприятности: Мишу хотели перевозить в больницу, Татьяна отстояла."
                                            },
                                            {
                                                "example_id": "94e5ec8c-a18c-43fc-ab29-59f7c899ca86",
                                                "sense_id": "88475ad0-4a93-3c11-a585-80c14db02872",
                                                "text": "А в августе 1995-го он слёг. Врачи сказали: «Ангина!» Его лечили от ангины, а это оказался дифтерит."
                                            },
                                            {
                                                "example_id": "9cd13e96-675c-46cb-943a-e285e90a88dc",
                                                "sense_id": "88475ad0-4a93-3c11-a585-80c14db02872",
                                                "text": "Ты выбегаешь на улицу без шарфа. Ангина за ангиной. В пятнадцать лет мне удаляют гланды, оберегая от осложнений на сердце."
                                            },
                                            {
                                                "example_id": "58cdd460-dc5f-4651-ad1b-4fdca09ed180",
                                                "sense_id": "88475ad0-4a93-3c11-a585-80c14db02872",
                                                "text": "Он [Андрюша] жил в интернате, мёрз, беспрестанно болел ангинами и в первые месяцы очень хотел вернуться домой, к Бабане."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
