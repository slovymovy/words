                        "form": "die Mayener"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "15bf3831-d553-3d82-b3bb-a5b3c26e9172",
                        "entry_id": "cd84bada-d3d4-3cef-ade6-9cc438b32281",
                        "glosses": [
                            "in der Stadt Mayen lebende oder aus Mayen stammende Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88db57ec-1c34-4bff-b14e-b78c6793ce61",
                                "sense_id": "15bf3831-d553-3d82-b3bb-a5b3c26e9172",
                                "text": "„Sie wollte den Mayenern stolz ihren kleinen Sohn […] vorführen und zeigen, wie fein er angezogen war, […]“"
                            },
                            {
                                "example_id": "fe19d58e-4c4c-4366-b479-b5b3990686c9",
                                "sense_id": "15bf3831-d553-3d82-b3bb-a5b3c26e9172",
                                "text": "„Vor vielen hundert Jahren begannen die Mayener eine Kirche zu bauen, weil sie sehr gläubig waren.“"
                            },
                            {
                                "example_id": "d6a3bdf9-3585-4d1b-9edc-5d5abdfcbae8",
                                "sense_id": "15bf3831-d553-3d82-b3bb-a5b3c26e9172",
                                "text": "„Die Mayener gelten als pfiffig und selbstbewusst.“"
                            },
                            {
                                "example_id": "80ef58ae-1c6e-4733-aa68-ee2e74bad663",
                                "sense_id": "15bf3831-d553-3d82-b3bb-a5b3c26e9172",
                                "text": "„Boufflers, der französische General, scheint aber von den Mayenern keine besonderen Anstrengungen besorgt zu haben, forderte vielmehr von ihnen am […] Tag vor seinem Abzug aus Coblenz […] die Lieferung von 700 Malter Hafer, 250 Wagen Heu und 100 Kühen.“"
                            },
                            {
                                "example_id": "f7c0a691-a437-469e-bcf1-b712628efbd0",
                                "sense_id": "15bf3831-d553-3d82-b3bb-a5b3c26e9172",
                                "text": "„Mit der Währungsreform vom 20. Juni 1948 verbesserte sich die Lebenssituation deutlich. […] Dies bot den Mayenern Gelegenheit, bei Märkten und Festen Ausgleich und Ablenkung zu finden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
