                    {
                        "sense_id": "6a8b99bc-de8d-3c91-8d90-386791b86568",
                        "entry_id": "25da9a0c-83f6-3f9a-8e19-9c8a2d86ec99",
                        "glosses": [
                            "Jacke, die man zum Schlafen über der sonstigen Nachtwäsche trägt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9849e810-6b3b-4734-ba08-15d47e0a38ae",
                                "sense_id": "6a8b99bc-de8d-3c91-8d90-386791b86568",
                                "text": "Binde lieber die Nachtjacke zu, ich will in Ruhe schlafen."
                            },
                            {
                                "example_id": "0997f942-29f2-43e1-8487-5f47e03643b7",
                                "sense_id": "6a8b99bc-de8d-3c91-8d90-386791b86568",
                                "text": "„Sie sass, mit Nachtjacke und Haube bekleidet, im Lehnstuhl.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8d1ab184-e4d4-47b4-858b-cdb35a8cdb3d",
                        "source_entry_id": "25da9a0c-83f6-3f9a-8e19-9c8a2d86ec99",
                        "source_sense_id": "6a8b99bc-de8d-3c91-8d90-386791b86568",
                        "source_sense_description": "Jacke, die man zum Schlafen über der sonstigen Nachtwäsche trägt",
                        "target_lang_word": "pyjama",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pyjama",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "655f7521-cc9a-32cf-b5e8-0d428c46ae0b",
                                        "entry_id": "e31d0eb4-2ec7-3e2b-bd6a-a68f825139a1",
                                        "glosses": [
                                            "Costume d’intérieur fait le plus souvent d’une étoffe légère, qui se compose d’une veste non ajustée et d’un pantalon très ample, et qui se porte aussi comme vêtement de nuit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70db9288-51a8-4b51-8212-ad886c76ab16",
                                                "sense_id": "655f7521-cc9a-32cf-b5e8-0d428c46ae0b",
                                                "text": "Il agit donc sur la tirette, le rideau se releva brusquement, et alors, à la stupéfaction générale, on vit saint Jean-Baptiste, en pyjama bleu de ciel, […]"
                                            },
                                            {
                                                "example_id": "9bf728b3-621d-4860-b8f4-3c9b13baa3f2",
                                                "sense_id": "655f7521-cc9a-32cf-b5e8-0d428c46ae0b",
                                                "text": "Elle rangeait sa chambre tous les matins, et elle éprouvait un ravissement inconnu à caresser la soie de son pyjama."
                                            },
                                            {
                                                "example_id": "3292377a-cd29-49dc-ad2b-705a1cd87b70",
                                                "sense_id": "655f7521-cc9a-32cf-b5e8-0d428c46ae0b",
                                                "text": "On apercevait une grande pièce en désordre, la table encore dressée pour le petit déjeuner, un pyjama jeté sur un divan."
                                            },
                                            {
                                                "example_id": "452cd15d-b2f5-4f44-9529-514e945a64fe",
                                                "sense_id": "655f7521-cc9a-32cf-b5e8-0d428c46ae0b",
                                                "text": "Je n'ai jamais compris pourquoi les pyjamas avaient des poches."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc2a6a60-3163-358b-8545-44c3bbc2ba77",
                                        "entry_id": "e31d0eb4-2ec7-3e2b-bd6a-a68f825139a1",
                                        "glosses": [
                                            "Costume porté dans les années 1930 par certaines femmes dans les stations balnéaires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c4c7318-f0c5-4fc0-b645-02ac4cab43f3",
                                                "sense_id": "dc2a6a60-3163-358b-8545-44c3bbc2ba77",
                                                "text": "Les femmes portaient alors des pyjamas de plage très seyants, de couleurs variées : blancs, bleu marine, bleu turquoise, mais cachant le corps que l’on devinait souple, détendu, attirant d’abandon sensuel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
