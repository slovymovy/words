    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "926d0b73-6867-36d3-8c55-b1fa66bb2619",
                    "sense_definition": "Cacher un objet pour qu'il ne soit pas trouvé ou le mettre en lieu sûr.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "dissimuler",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a décidé de <w>planquer</w> ses clés sous un pot de fleurs dans le jardin."
                        },
                        {
                            "text": "Où est-ce que tu as <w>planqué</w> les cadeaux d'anniversaire pour les enfants ?"
                        }
                    ],
                    "synonyms": [
                        "cacher",
                        "dissimuler"
                    ],
                    "antonyms": [
                        "montrer",
                        "exposer"
                    ],
                    "common_phrases": [
                        "planquer son argent",
                        "planquer les clés"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "familier"
                        }
                    ]
                },
                {
                    "sense_id": "d63b9987-52a7-3a08-bd32-558effe3f06c",
                    "sense_definition": "Se cacher ou se mettre à l'abri pour échapper à quelqu'un ou à un danger.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "dissimuler",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'enfant est allé se <w>planquer</w> derrière le canapé pendant la partie de cache-cache."
                        },
                        {
                            "text": "Dès qu'il y a une tâche pénible à faire, tout le monde se <w>planque</w> immédiatement."
                        }
                    ],
                    "synonyms": [
                        "se cacher",
                        "s'abriter"
                    ],
                    "antonyms": [
                        "se montrer",
                        "apparaître"
                    ],
                    "common_phrases": [
                        "se planquer derrière",
                        "se planquer au fond"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "familier"
                        }
                    ]
                },
                {
                    "sense_id": "be831e54-8d52-3d7b-b10f-b1020a569f18",
                    "sense_definition": "Dissimuler ou accumuler de l'argent dans un endroit discret ou un compte secret.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet homme d'affaires a <w>planqué</w> une grande partie de sa fortune dans un paradis fiscal."
                        },
                        {
                            "text": "Ils préfèrent <w>planquer</w> leurs économies sous un matelas plutôt que de les confier à une banque."
                        }
                    ],
                    "synonyms": [
                        "dissimuler",
                        "thésauriser"
                    ],
                    "antonyms": [
                        "dépenser",
                        "investir"
                    ],
                    "common_phrases": [
                        "planquer du fric",
                        "planquer ses économies"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "familier"
                        }
                    ]
                },
                {
