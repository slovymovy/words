                "senses": [
                    {
                        "sense_id": "b721c454-2594-34e6-b888-3a076444b0e5",
                        "entry_id": "9194c47a-2c63-3257-8c34-9f0492b7b801",
                        "glosses": [
                            "Kapellengebäude, das am Ufer steht und für Gottesdienste einer Gemeinde genutzt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce627a85-3005-44cb-81ad-d69ab33b9cb9",
                                "sense_id": "b721c454-2594-34e6-b888-3a076444b0e5",
                                "text": "„Der Altenkirchener Dichterpfarrer Gotthard Ludwig Kosegarten hat den Bau der Uferkapelle initiiert, um die auch immer mehr von auswärtigen besuchten Ufergottesdienste auch bei schlechter Witterung feiern zu können.“"
                            },
                            {
                                "example_id": "4dc116d1-9a73-45d1-a401-bad62e9b1df0",
                                "sense_id": "b721c454-2594-34e6-b888-3a076444b0e5",
                                "text": "„Mit seinen Hausmarken und der kleinen Uferkapelle, die eng mit der Persönlichkeit Kosegartens verbunden ist, hat das vermutlich slawische Vitt viel zu berichten.“"
                            },
                            {
                                "example_id": "c5425223-926d-4cd4-9809-9ed7948525c9",
                                "sense_id": "b721c454-2594-34e6-b888-3a076444b0e5",
                                "text": "„Und was die Uferkapelle und die Grabhügel auf Spegelö betrifft, die du erwähnst: sie gehen auf den Schiffbruch der mit Salz beladenen Fregatte Gerda im Jahre 1715 zurück.“"
                            },
                            {
                                "example_id": "70c7aa35-171b-4d6f-ab93-fef043b24079",
                                "sense_id": "b721c454-2594-34e6-b888-3a076444b0e5",
                                "text": "„Die Uferkapelle in der Ortschaft Au westlich der Aubrücke besitzt einen rechteckigen Grundriss, ein schindelgedecktes Satteldach und einen Dachreiter mit Pyramidenhelm über der Giebelfront.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
