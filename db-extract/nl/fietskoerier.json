                        "entry_id": "6484dcc9-9193-3e5f-9537-d2e928decbb4",
                        "glosses": [
                            "iemand die beroepshalve dingen rondbrengt op de fiets"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15d528d4-8ba7-48c2-b25c-ee334280e775",
                                "sense_id": "e48333e6-2946-3879-affb-1d26aa64b182",
                                "text": "Volgens mij versturen ze dat pakketje per fietskoerier."
                            }
                        ]
