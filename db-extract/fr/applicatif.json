                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6220f1b4-137b-44ee-8e0f-4e7f45b4b7f7",
                                                "sense_id": "d652bcff-26e4-3f8c-996d-dcaa66d6a2ca",
                                                "text": "It remains a puzzle why some languages allow multiple applicatives while others prohibit them. In Salish, examples of multiple applicatives are attested in Columbian, Lushootseed, Tillamook, and the three Northern Interior languages."
                                            }
                                        ]
