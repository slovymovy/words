                "senses": [
                    {
                        "sense_id": "5826beb6-a552-348a-84f5-5524e1a4b221",
                        "entry_id": "41171f8d-d12b-39ef-b0ff-a24120afca26",
                        "glosses": [
                            "Effectuer une transduction."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60ca3d37-42ee-4c31-97c5-4271bb7c54fd",
                                "sense_id": "5826beb6-a552-348a-84f5-5524e1a4b221",
                                "text": "Parallèlement aux KIR, il existe également à la surface des lymphocytes NK des récepteurs qui transduisent des signaux activateurs de la cytolyse."
                            },
                            {
                                "example_id": "be1269e7-91e9-488b-bcca-9ed9581e405c",
                                "sense_id": "5826beb6-a552-348a-84f5-5524e1a4b221",
                                "text": "Mythologies et idéologies traversent les frontières, des fragments de codes culturels sont transduits ici et là, et l’invariance de la culture, source générative de la complexité sociale, se trouve sans cesse perturbée."
                            },
                            {
                                "example_id": "611c1305-44c5-4a02-9f04-40998a35e06e",
                                "sense_id": "5826beb6-a552-348a-84f5-5524e1a4b221",
                                "text": "Il n’avait pas échangé, il avait transduit, comme seuls savaient le faire les AnimauxVilles, en se glissant dans une maille qui reliait deux nœuds très proches."
                            }
                        ]
                    }
