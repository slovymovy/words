                        "entry_id": "3e2ec8e4-5cbc-3651-9221-dd109c992835",
                        "glosses": [
                            "Douzième mois du calendrier républicain, correspondant généralement à l’espace compris entre le 18 août et le 17 septembre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6e02d9c-c5bf-4f3a-a72b-42e57b288bd2",
                                "sense_id": "e1242a93-dc6c-37da-abee-8c652b24fcbb",
                                "text": "Le mois de fructidor était suivi des jours complémentaires."
                            },
                            {
                                "example_id": "a65938a7-8164-429a-8097-ae7468583f67",
                                "sense_id": "e1242a93-dc6c-37da-abee-8c652b24fcbb",
                                "text": "Il participe au coup d'État de fructidor contre le Directoire, offrant sans le vouloir le chemin du pouvoir à Bonaparte."
                            }
                        ]
                    }
                ],
