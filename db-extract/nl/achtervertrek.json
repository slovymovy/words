                "senses": [
                    {
                        "sense_id": "b1491026-8716-370f-8b24-840025ade61a",
                        "entry_id": "22bce41f-1112-315c-b041-ee8687e84477",
                        "glosses": [
                            "een ruimte die aan de achterkant van een gebouw is gelegen; vertrek dat niet uitziet op de openbare weg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da5819cd-74d2-441b-8f86-b65393553024",
                                "sense_id": "b1491026-8716-370f-8b24-840025ade61a",
                                "text": "Een schemerig grijs licht valt door het raam naar binnen terwijl ze door de winkel loopt, het zware gordijn opzijtrekt en het achtervertrek in stapt."
                            },
                            {
                                "example_id": "57f89c58-3aa1-4186-9e5f-f6e9bc8a1de8",
                                "sense_id": "b1491026-8716-370f-8b24-840025ade61a",
                                "text": "Het valt niet meer na te gaan wanneer de benaming gemeengoed werd, maar nog immer heet het achtervertrek op de eerste etage waar hij zijn moede hoofd te ruste legde de Verlaine-kamer."
                            },
                            {
                                "example_id": "30cc0864-77b0-4cf7-b9ae-dae7d71fec04",
                                "sense_id": "b1491026-8716-370f-8b24-840025ade61a",
                                "text": "Anna drentelt intussen naar het donkere achtervertrek en bekijkt er de vele klokken die aan de wanden hangen, dan de horloges die vóór de meester liggen en tot zichtbare ergernis van madame Lepelletier zet zij zich onbekommerd op een hoek van de werktafel tegenover de klokkenmaker."
                            }
                        ]
                    }
