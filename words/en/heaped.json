{
    "word_family": [
        "heap"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7e874d29-e4aa-39c6-87a3-e252249abfe8",
                    "sense_definition": "Formed into a pile or mound.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "pile",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>heaped</w> dishes were waiting to be washed in the kitchen sink.",
                            "target_lang_translations": {
                                "pl": "W zlewie kuchennym czekała na umycie <w>sterta</w> naczyń."
                            }
                        },
                        {
                            "text": "She looked at the <w>heaped</w> laundry on the chair and sighed.",
                            "target_lang_translations": {
                                "pl": "Spojrzała na <w>usypaną</w> na krześle stertę prania i westchnęła."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Uformowany w stos lub kopiec."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "sterta",
                                "target_lang_sense_clarification": "rzeczownik określający ułożone w stos przedmioty"
                            },
                            {
                                "target_lang_word": "usypany",
                                "target_lang_sense_clarification": "przymiotnik opisujący coś ułożonego w kopiec"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "56d6c1ba-6705-316b-b0b4-f6a37fb1332a",
                    "sense_definition": "Filled to the point of forming a mound above the rim of a container.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pile",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Add a <w>heaped</w> teaspoon of sugar to the coffee.",
                            "target_lang_translations": {
                                "pl": "Dodaj do kawy <w>czubatą</w> łyżeczkę cukru."
                            }
                        },
                        {
                            "text": "The recipe calls for two <w>heaped</w> tablespoons of flour.",
                            "target_lang_translations": {
                                "pl": "Przepis wymaga dwóch <w>czubatych</w> łyżek mąki."
                            }
                        }
                    ],
                    "synonyms": [
                        "heaping"
                    ],
                    "common_phrases": [
                        "heaped teaspoon",
                        "heaped tablespoon"
                    ],
                    "target_lang_definitions": {
                        "pl": "Wypełniony tak, że zawartość tworzy kopczyk ponad krawędzią naczynia."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "czubaty",
                                "target_lang_sense_clarification": "określenie miary z górką, np. łyżeczka"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d3b94d67-4acb-3187-b128-cd076a0dce72",
                    "sense_definition": "Simple past and past participle of <w>heap</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>heaped</w> the firewood against the wall of the cabin.",
                            "target_lang_translations": {
                                "pl": "<w>Usypał</w> stos drewna opałowego przy ścianie chaty."
                            }
                        },
                        {
                            "text": "They have <w>heaped</w> praise upon the young athlete for her performance.",
                            "target_lang_translations": {
                                "pl": "<w>Obsypali</w> młodą sportsmenkę pochwałami za jej występ."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "grammatical form"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Czas przeszły i imiesłów czasu przeszłego od czasownika 'układać w stos'."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "usypać",
                                "target_lang_sense_clarification": "układać coś w stos lub kopiec"
                            },
                            {
                                "target_lang_word": "nagromadzić",
                                "target_lang_sense_clarification": "zebrać dużą ilość czegoś w jednym miejscu"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}