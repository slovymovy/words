                        "sense_id": "746d6da3-8aac-388f-a5f0-fe3ad4d25402",
                        "entry_id": "fede830c-5fc6-36b8-9f33-740c8c1c7767",
                        "glosses": [
                            "Qui se rapporte à André Malraux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7512d8a5-0b76-4898-b09b-7128187cf15a",
                                "sense_id": "746d6da3-8aac-388f-a5f0-fe3ad4d25402",
                                "text": "L’imaginaire dans la pensée malrucienne de l’art"
                            }
                        ]
                    },
                    {
                        "sense_id": "4128f77b-4940-3ee6-a55a-eb7e6d3b1d5d",
                        "entry_id": "fede830c-5fc6-36b8-9f33-740c8c1c7767",
                        "glosses": [
                            "Qui imite ou évoque André Malraux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e04f3cf2-b61f-4961-ba8a-99ef1a11d744",
                                "sense_id": "4128f77b-4940-3ee6-a55a-eb7e6d3b1d5d",
                                "text": "Une envolée malrucienne, un ton malrucien."
                            },
                            {
                                "example_id": "23471867-338b-4979-866f-f6816c2c90ac",
                                "sense_id": "4128f77b-4940-3ee6-a55a-eb7e6d3b1d5d",
                                "text": "Ainsi, l’alliance que le président Chirac sut nouer pour le futur musée du quai Branly entre un magicien des institutions d’art tel que Germain Viatte et l’ethnologue Maurice Godelier, pour en confier ensuite la direction à Stéphane Martin, un énarque éclairé, est tout à fait dans la tradition malrucienne des grands commis culturels."
                            }
                        ]
                    }
