{
    "word_family": [
        "inject",
        "injector",
        "injective"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f1ffad7b-3df2-3c7a-9759-03679e64476d",
                    "sense_definition": "The act of putting a drug or other substance into a person's body using a needle and a syringe.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The nurse gave the patient a quick <w>injection</w> in the arm.",
                            "target_lang_translations": {
                                "ru": "Медсестра сделала пациенту быстрый <w>укол</w> в руку.",
                                "zh": "护士给病人的手臂做了一次快速<w>注射</w>。"
                            }
                        },
                        {
                            "text": "Many people are afraid of needles and find getting a medical <w>injection</w> very stressful.",
                            "target_lang_translations": {
                                "ru": "Многие люди боятся иголок и считают получение медицинской <w>инъекции</w> большим стрессом.",
                                "zh": "许多人害怕针头，觉得医疗<w>注射</w>压力很大。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "medical injection",
                        "daily injection",
                        "painless injection"
                    ],
                    "target_lang_definitions": {
                        "ru": "Введение лекарства или другого вещества в организм человека с помощью иглы и шприца.",
                        "zh": "通过针头和注射器将药物或其他物质注入人体内的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "инъекция",
                                "target_lang_sense_clarification": "медицинская процедура"
                            },
                            {
                                "target_lang_word": "укол",
                                "target_lang_sense_clarification": "разговорное название инъекции"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "注射",
                                "target_lang_sense_clarification": "医学程序"
                            },
                            {
                                "target_lang_word": "打针",
                                "target_lang_sense_clarification": "口语表达"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c3cdee71-4c60-3389-a0bc-72af05e90c75",
                    "sense_definition": "The act of providing a large amount of money to a business or project to help it succeed.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The struggling startup received a massive cash <w>injection</w> from a new investor.",
                            "target_lang_translations": {
                                "ru": "Испытывающий трудности стартап получил огромное денежное <w>вливание</w> от нового инвестора.",
                                "zh": "这家陷入困境的初创公司从一位新投资者那里获得了巨额资金<w>注入</w>。"
                            }
                        },
                        {
                            "text": "Without a significant capital <w>injection</w>, the company will likely go bankrupt by the end of the year.",
                            "target_lang_translations": {
                                "ru": "Без значительной <w>инъекции</w> капитала компания, скорее всего, обанкротится к концу года.",
                                "zh": "如果没有大量的资本<w>注入</w>，该公司很可能会在年底前破产。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cash injection",
                        "capital injection",
                        "financial injection"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предоставление большой суммы денег бизнесу или проекту для обеспечения его успеха.",
                        "zh": "为企业或项目提供大量资金以帮助其成功。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вливание",
                                "target_lang_sense_clarification": "финансовое вложение"
                            },
                            {
                                "target_lang_word": "инъекция",
                                "target_lang_sense_clarification": "переносное значение в экономике"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "注入",
                                "target_lang_sense_clarification": "资金投入"
                            },
                            {
                                "target_lang_word": "投入",
                                "target_lang_sense_clarification": "资金或资源"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "80889ab4-e751-3e40-a414-dfdbf63d7aff",
                    "sense_definition": "The process of forcing fuel into an engine cylinder at high pressure.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mechanical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Modern cars use electronic fuel <w>injection</w> to improve efficiency and performance.",
                            "target_lang_translations": {
                                "ru": "В современных автомобилях используется электронный <w>впрыск</w> топлива для повышения эффективности и производительности.",
                                "zh": "现代汽车使用电子燃油<w>喷射</w>系统来提高效率和性能。"
                            }
                        },
                        {
                            "text": "The mechanic explained that the direct <w>injection</w> system was clogged with carbon deposits.",
                            "target_lang_translations": {
                                "ru": "Механик объяснил, что система прямого <w>впрыска</w> была забита нагаром.",
                                "zh": "技工解释说，直喷系统被积碳堵塞了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "fuel injection",
                        "direct injection",
                        "electronic injection"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс принудительной подачи топлива в цилиндр двигателя под высоким давлением.",
                        "zh": "在高压下将燃料强制送入发动机气缸的过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "впрыск",
                                "target_lang_sense_clarification": "подача топлива в двигатель"
                            },
                            {
                                "target_lang_word": "впрыскивание",
                                "target_lang_sense_clarification": "технический процесс"
                            },
                            {
                                "target_lang_word": "инъекция",
                                "target_lang_sense_clarification": "технический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "喷射",
                                "target_lang_sense_clarification": "燃油系统"
                            },
                            {
                                "target_lang_word": "喷油",
                                "target_lang_sense_clarification": "技术过程"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f3d8ab3-0782-3143-84dd-61e81fc5740e",
                    "sense_definition": "The act of inserting malicious code into a computer program or database to exploit a vulnerability.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The website was vulnerable to a SQL <w>injection</w> attack that exposed user data.",
                            "target_lang_translations": {
                                "ru": "Сайт был уязвим для атак типа SQL-<w>инъекция</w>, которые раскрыли данные пользователей.",
                                "zh": "该网站容易受到SQL<w>注入</w>攻击，导致用户数据泄露。"
                            }
                        },
                        {
                            "text": "Developers must sanitize all user inputs to prevent code <w>injection</w> by hackers.",
                            "target_lang_translations": {
                                "ru": "Разработчики должны очищать все вводимые пользователем данные, чтобы предотвратить <w>внедрение</w> кода хакерами.",
                                "zh": "开发人员必须清理所有用户输入，以防止黑客进行代码<w>注入</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "code injection",
                        "SQL injection",
                        "malicious injection"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вставка вредоносного кода в компьютерную программу или базу данных для использования уязвимости.",
                        "zh": "将恶意代码插入计算机程序或数据库以利用漏洞的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "инъекция",
                                "target_lang_sense_clarification": "ИТ-термин, например, SQL-инъекция"
                            },
                            {
                                "target_lang_word": "внедрение",
                                "target_lang_sense_clarification": "внедрение кода"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "注入",
                                "target_lang_sense_clarification": "计算机安全术语"
                            },
                            {
                                "target_lang_word": "植入",
                                "target_lang_sense_clarification": "代码植入"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aa9c0ca7-0af3-3398-b9d4-d82d236b9119",
                    "sense_definition": "A mathematical function that maps distinct elements of its domain to distinct elements of its codomain.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In set theory, an <w>injection</w> ensures that no two different inputs produce the same output.",
                            "target_lang_translations": {
                                "ru": "В теории множеств <w>инъекция</w> гарантирует, что никакие два разных входных значения не дадут один и тот же результат.",
                                "zh": "在集合论中，<w>单射</w>确保没有两个不同的输入产生相同的输出。"
                            }
                        },
                        {
                            "text": "The professor proved that the mapping was an <w>injection</w> by showing it was one-to-one.",
                            "target_lang_translations": {
                                "ru": "Профессор доказал, что это отображение является <w>инъекцией</w>, показав, что оно взаимно однозначно.",
                                "zh": "教授通过证明该映射是一一对应的，从而证明了它是一个<w>单射</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "injective function"
                    ],
                    "common_phrases": [
                        "mathematical injection"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "mathematical term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Математическая функция, которая сопоставляет различные элементы своей области определения с различными элементами своей области значений.",
                        "zh": "一种将定义域中的不同元素映射到陪域中不同元素的数学函数。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "инъекция",
                                "target_lang_sense_clarification": "математическое отображение"
                            },
                            {
                                "target_lang_word": "инъективная функция",
                                "target_lang_sense_clarification": "математический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "单射",
                                "target_lang_sense_clarification": "数学术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aea06b9e-4e13-3cdb-8550-624db221e6c0",
                    "sense_definition": "The act of placing a spacecraft into a specific orbit or trajectory.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "aerospace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The trans-lunar <w>injection</w> maneuver was executed perfectly by the ground control team.",
                            "target_lang_translations": {
                                "ru": "Маневр <w>выведения</w> на траекторию к Луне был безупречно выполнен наземной группой управления.",
                                "zh": "地面控制团队完美地执行了地月转移轨道<w>入轨</w>机动。"
                            }
                        },
                        {
                            "text": "After the launch, the satellite achieved successful <w>injection</w> into its intended geostationary orbit.",
                            "target_lang_translations": {
                                "ru": "После запуска спутник успешно осуществил <w>выход</w> на намеченную геостационарную орбиту.",
                                "zh": "发射后，卫星成功实现了预定的地球静止轨道<w>入轨</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "orbital injection",
                        "trans-lunar injection"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вывод космического аппарата на определенную орбиту или траекторию.",
                        "zh": "将航天器送入特定轨道或轨迹的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выведение",
                                "target_lang_sense_clarification": "на орбиту"
                            },
                            {
                                "target_lang_word": "инъекция",
                                "target_lang_sense_clarification": "аэрокосмический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "入轨",
                                "target_lang_sense_clarification": "航天术语"
                            },
                            {
                                "target_lang_word": "发射",
                                "target_lang_sense_clarification": "进入轨道过程"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "85736e5b-5001-3959-b645-e37a95afad44",
                    "sense_definition": "The abnormal redness or swelling of a body part due to increased blood flow.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "medical_pathology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor noted significant conjunctival <w>injection</w> in the patient's left eye.",
                            "target_lang_translations": {
                                "ru": "Врач отметил значительную конъюнктивальную <w>инъекцию</w> в левом глазу пациента.",
                                "zh": "医生注意到病人左眼有明显的结膜<w>充血</w>。"
                            }
                        },
                        {
                            "text": "Severe <w>injection</w> of the blood vessels can be a sign of acute inflammation.",
                            "target_lang_translations": {
                                "ru": "Сильная <w>инъекция</w> кровеносных сосудов может быть признаком острого воспаления.",
                                "zh": "血管严重<w>充血</w>可能是急性炎症的征兆。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "conjunctival injection"
                    ],
                    "target_lang_definitions": {
                        "ru": "Аномальное покраснение или отек части тела из-за усиленного кровотока.",
                        "zh": "由于血流量增加而导致的身体部位异常发红或肿胀。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "инъекция",
                                "target_lang_sense_clarification": "патологическое расширение сосудов"
                            },
                            {
                                "target_lang_word": "гиперемия",
                                "target_lang_sense_clarification": "медицинский термин для покраснения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "充血",
                                "target_lang_sense_clarification": "医学病理"
                            }
                        ]
                    }
                }
            ]
        }
    ]
