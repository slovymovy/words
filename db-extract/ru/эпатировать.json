                                            {
                                                "example_id": "99e8badc-aa6b-429f-89ea-07ed94f3fe77",
                                                "sense_id": "fdb69253-a162-3bfd-83b5-f1cd12b8a39d",
                                                "text": "Ammonium nitrate can detonate if severely shocked."
