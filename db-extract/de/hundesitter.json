                "senses": [
                    {
                        "sense_id": "07904355-bd17-3e3b-9f85-372ee2aa90f3",
                        "entry_id": "5a1cac06-faf4-325b-bb57-27c57eef5c11",
                        "glosses": [
                            "jemand, der gegen Bezahlung einen oder mehrere Hunde beaufsichtigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d6c4dfe-f4d8-4cfc-83ac-6d997487ff5b",
                                "sense_id": "07904355-bd17-3e3b-9f85-372ee2aa90f3",
                                "text": "„In den Geschäftsbedingungen sei festgeschrieben, dass - beispielsweise im Krankheitsfall - für den Ersatz eines Hundesitters zu sorgen ist.“"
                            },
                            {
                                "example_id": "ce558c5e-fc39-4ebf-889c-e79e672a9e7a",
                                "sense_id": "07904355-bd17-3e3b-9f85-372ee2aa90f3",
                                "text": "„Sportprogramm und zusätzliche Spaziergänge brauchten Hundesitter jedenfalls nicht.“"
                            },
                            {
                                "example_id": "65d22d29-9db8-4285-9abe-2888c05328ea",
                                "sense_id": "07904355-bd17-3e3b-9f85-372ee2aa90f3",
                                "text": "„Da etwa Hundesitter seltener Mitglied einer Gewerkschaft sind, profitieren sie auch kaum von den höheren Tariflöhnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
