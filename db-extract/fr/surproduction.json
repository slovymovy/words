                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d54eaae5-84c9-4460-9559-fa039ad8a2e9",
                                                "sense_id": "fe35388c-e70c-3100-9db3-39fba10d191b",
                                                "text": "Mrs. Carmichael had her fifth, looked at the job with repulsion, / Said to the midwife 'Take it away; I'm through with overproduction'."
                                            }
