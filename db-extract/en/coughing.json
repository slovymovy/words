    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "63827690-e997-34f2-a3e4-c7e76af08b90",
                "word": "coughing",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "c9bea53f-3eea-4e5e-8ab7-0a8465e18fc9",
                        "entry_id": "63827690-e997-34f2-a3e4-c7e76af08b90",
                        "tags": [
                            "plural"
                        ],
                        "form": "coughings"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e0d46a48-b28c-3379-bc5b-0d4de1aaf0a3",
                        "entry_id": "63827690-e997-34f2-a3e4-c7e76af08b90",
                        "glosses": [
                            "A cough; the act of coughing."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26992e73-8bbc-4397-bd17-7dfcf14710c6",
                                "sense_id": "e0d46a48-b28c-3379-bc5b-0d4de1aaf0a3",
                                "text": "The good signor's little address was received in a variety of ways: there were titterings and coughings, and there were also a few instances of noble and generous response to poor Leonard's action […]"
                            },
                            {
                                "example_id": "7510294e-d10d-439a-b4ed-8d2dacb08684",
                                "sense_id": "e0d46a48-b28c-3379-bc5b-0d4de1aaf0a3",
                                "text": "\"I've been directed here to find Miss Susan Pike,\" the man outside explained, between fresh coughings. ¶ \"Well, then, mog your boots out of this as quick as ever you can!\" my Aunt replied, with great promptitude. \"You won't find her here!\""
                            },
                            {
                                "example_id": "2592603f-3264-4785-912c-f5857ee92722",
                                "sense_id": "e0d46a48-b28c-3379-bc5b-0d4de1aaf0a3",
                                "text": "One saint's day in mid-term a certain newly appointed suffragan-bishop came to the school chapel, and there preached on “The Inner Life.” He at once secured attention by his informal method, and when presently the coughing of Jarvis and another boy interrupted the sermon, he altogether captivated his audience with a remark about cough lozenges being cheap and easily procurable."
                            },
                            {
                                "example_id": "4fc06367-8db7-47a1-8fa5-d924d5a5c263",
                                "sense_id": "e0d46a48-b28c-3379-bc5b-0d4de1aaf0a3",
                                "text": "He would also have been exposed to the coughings and shufflings, comings and goings, questions and answers, wailings and slammings, snivellings and sneezings, etc., which figured so prominently in the reference room […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "a7f45605-9ce6-30d4-8a8d-56048aadfc52",
                        "entry_id": "63827690-e997-34f2-a3e4-c7e76af08b90",
                        "glosses": [
                            "A repetitive vocalisation of a bird or other animal that resembles human coughing."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db87e844-3f46-43f9-8288-fe6b5795b8b2",
                                "sense_id": "a7f45605-9ce6-30d4-8a8d-56048aadfc52",
                                "text": "The nocturnal sounds of the mountains were new to him, yet they fell upon his ears like the soft voice of a half-forgotten love. Many he intuitively sensed—ah, there was one that was familiar indeed; the distant coughing of Sheeta, the leopard; but there was a strange note in the final wail which made him doubt."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
