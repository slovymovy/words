                ],
                "senses": [
                    {
                        "sense_id": "b927a20c-ed91-35a4-82a9-04b421824f53",
                        "entry_id": "6a0d8044-f3bc-3176-9788-242922ff5ee2",
                        "glosses": [
                            "Wort, das nur im Singular vorkommt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53c27a8c-5d67-4c7f-947e-f4c0ad8ae196",
                                "sense_id": "b927a20c-ed91-35a4-82a9-04b421824f53",
                                "text": "Ein geläufiges Beispiel für ein Singularetantum im Deutschen ist das Wort Hunger. Weitere Singulariatantum sind: Gold, Obst, Vieh. Siehe auch die :Kategorie:Singularetantum (Deutsch)"
                            },
                            {
                                "example_id": "20317916-9bc7-401c-9f9d-554598f3891a",
                                "sense_id": "b927a20c-ed91-35a4-82a9-04b421824f53",
                                "text": "Denn erst gute 100 Jahre, nachdem das Singularetantum Kultur eine wichtige Rolle für die Neufassung der Geschichte der Menschheit bei Herder spielte, wurde der Plural Kulturen zuerst bei Jacob Burckhardt in die Sprache der Geisteswissenschaften eingeführt und dann durch Friedrich Nietzsche aufgenommen und verbreitet."
                            },
                            {
                                "example_id": "e92a2ec4-cbb3-4e53-a6d9-b5c96c1153a5",
                                "sense_id": "b927a20c-ed91-35a4-82a9-04b421824f53",
                                "text": "Zu bestimmten Substantiven: „In den Grammatiken sind sie als Singulariatantum erfaßt.“"
                            },
                            {
                                "example_id": "249afa35-c4c9-45c9-aa66-699c98b95d3f",
                                "sense_id": "b927a20c-ed91-35a4-82a9-04b421824f53",
                                "text": "Singulariatantum sind z. B. Vieh, Obst, Kälte, Vertrauen; hier sind hauptsächlich Stoffbezeichnungen und Abstrakta vertreten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
