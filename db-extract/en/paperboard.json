                                "target_senses": [
                                    {
                                        "sense_id": "5a8d9746-891f-3cf1-a960-970298429672",
                                        "entry_id": "3077df0f-7894-3bf5-b42b-9818b832a751",
                                        "glosses": [
                                            "вид толстой, плотной бумаги"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27a920d8-2095-453a-a700-c674c0bb0f60",
                                                "sense_id": "5a8d9746-891f-3cf1-a960-970298429672",
                                                "text": "Даже она, сухопарая и продолговатая хозяйка, приличным образом подкрасившись, рисовалась в столовой, производя приятный для слуха шум накрахмаленною, как картон, юбкою."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8df94286-d12e-3d58-997b-7441f3bf6dba",
                                        "entry_id": "3077df0f-7894-3bf5-b42b-9818b832a751",
                                        "glosses": [
                                            "рисунок, эскиз, набросок на картоне"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a1f8ef6-e164-4fa3-84d7-af64f0d17cb8",
                                                "sense_id": "8df94286-d12e-3d58-997b-7441f3bf6dba",
                                                "text": "Гагин раскрыл мне все свои картоны. В них было много жизни и правды, что-то свободное и широкое; но ни один из них не был окончен, и рисунок показался мне небрежен и неверен."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c6d8cef-8d23-3395-89f5-32c4aacb94cc",
                                        "entry_id": "3077df0f-7894-3bf5-b42b-9818b832a751",
                                        "glosses": [
                                            "устар. шляпная коробка, изготовленная из картона"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b402f66-070b-4f17-9707-b1b65854dca1",
                                                "sense_id": "0c6d8cef-8d23-3395-89f5-32c4aacb94cc",
                                                "text": "Княгиня сидит на канапе, на которой стоит картон с лентами."
                                            },
                                            {
                                                "example_id": "f8a9f2e2-317f-431a-b2d8-6517a6bd90b5",
                                                "sense_id": "0c6d8cef-8d23-3395-89f5-32c4aacb94cc",
                                                "text": "У него подмышкой голова сахару; в одной руке бутылка, в другой дамский картон."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
