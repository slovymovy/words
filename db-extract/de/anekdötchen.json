                        ],
                        "examples": [
                            {
                                "example_id": "b687a12e-1384-48ef-b52a-ec3e49f30b06",
                                "sense_id": "0f032443-e082-34c7-9720-90d19754afe0",
                                "text": "„.Aus dieser Zeit reiht sie abends beim Essen Anekdötchen an Anekdötchen.“"
                            },
                            {
                                "example_id": "1bc1fab7-8219-4c86-b2e2-1508fcbe1337",
                                "sense_id": "0f032443-e082-34c7-9720-90d19754afe0",
                                "text": "„Von großen Meistern werden häufig Anekdötchen aufgetischt, die so kindisch erfunden oder mit so alberner Unwissenheit nacherzählt sind, daß sie mich immer, wenn ich sie anhören muß, kränken und ärgern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
