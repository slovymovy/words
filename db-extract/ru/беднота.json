                        "entry_id": "ceb63e9b-1b33-3b40-a8b2-04e94f97fb86",
                        "glosses": [
                            "разг. то же, что бедность (нужда, недостаток)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4acdfd2d-1459-4d2a-95de-45c1e4b28a68",
                                "sense_id": "86731de9-d93b-3843-9bef-2cf106828efb",
                                "text": "Беднота его комнаты поразила даже Вильгельма."
                            }
                        ]
