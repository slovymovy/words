                "senses": [
                    {
                        "sense_id": "b22c1d2f-e60b-384d-b1e6-5f1266a0d829",
                        "entry_id": "da69b115-164e-3155-bf55-a089b87b1907",
                        "glosses": [
                            "владелец промышленного предприятия; руководящий работник, специалист, работающий в промышленности"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "596268f6-2272-30df-92ef-2ab12b352c55",
                        "entry_id": "da69b115-164e-3155-bf55-a089b87b1907",
                        "glosses": [
                            "устар. тот, кто занимался промыслом; ремесленник"
                        ],
                        "tags": [],
