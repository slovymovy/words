                                        "sense_id": "f949eed0-082d-3af2-a4fc-5b579bb61d3c",
                                        "entry_id": "f46f789e-0118-3004-88ac-1ff802a039de",
                                        "glosses": [
                                            "Any of several North American freshwater fish, of the genus Coregonus, used as food."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a8109075-8c32-3b0e-8b91-1f92c9cc8fec",
                                        "entry_id": "f46f789e-0118-3004-88ac-1ff802a039de",
                                        "glosses": [
                                            "Any of several other fish, such as whiting (Merlangius merlangus) or menhaden (Brevoortia spp. and Ethmidium spp.)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5d84a4ff-29e5-325d-b7a3-bba9a9ab8529",
                                        "entry_id": "f46f789e-0118-3004-88ac-1ff802a039de",
                                        "glosses": [
                                            "Any of several species of demersal fish with fins, particularly cod, whiting, and haddock, as opposed to the oily or pelagic fishes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ae3f21f9-7e34-3c81-9ef6-f2ac2bffe874",
                                        "entry_id": "f46f789e-0118-3004-88ac-1ff802a039de",
                                        "glosses": [
                                            "The beluga (both the sturgeon and the whale)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "whitefish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "32484ab4-4121-3e86-8e12-1b4b3ef73b8c",
                                        "entry_id": "f9402386-26c4-35c2-980b-549fbb2e18b5",
                                        "glosses": [
                                            "To fish for whitefish."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e850ce75-6a9c-401b-983e-ab844f0335ad",
                                                "sense_id": "32484ab4-4121-3e86-8e12-1b4b3ef73b8c",
                                                "text": "“Perhaps he went whitefishing after he had his supper.”"
                                            },
                                            {
                                                "example_id": "1c3db0a7-d188-44af-b936-36aae1aee55f",
                                                "sense_id": "32484ab4-4121-3e86-8e12-1b4b3ef73b8c",
                                                "text": "“Bill” is said to have whitefished on the lake since Paul Bunyan and his big blue ox first plowed it out."
                                            },
                                            {
                                                "example_id": "bb1dd93a-c60b-4c18-9a48-4e4dd47040b2",
                                                "sense_id": "32484ab4-4121-3e86-8e12-1b4b3ef73b8c",
                                                "text": "Beth and I whitefished in the broken ice along the banks of the Clark, a fire of driftwood roaring in the wind with the coffeepot set among the coals."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
