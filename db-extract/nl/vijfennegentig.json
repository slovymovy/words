                        "examples": [
                            {
                                "example_id": "3c26a1ad-23ec-4f53-8860-f65ff08d02f2",
                                "sense_id": "48c47399-c0b1-3953-b4e0-0ee2350aaf17",
                                "text": "Het is weer de vijfennegentig die het niet doet, kunnen we die niet simpel vervangen?"
                            },
                            {
                                "example_id": "7d5cf413-2e56-4e87-9324-00a38575f3c5",
                                "sense_id": "48c47399-c0b1-3953-b4e0-0ee2350aaf17",
                                "text": "Haar zesennegentigste verjaardag was een belangrijk moment, want haar leven werd heel anders toen ze de vijfennegentig eenmaal voorbij was."
                            }
                        ]
                    },
                    {
                        "sense_id": "9647b9f4-e98a-3cda-88a4-d7c7a33b63c0",
                        "entry_id": "92ab10bf-b8c9-35c0-bf10-d78e03439850",
                        "glosses": [
