                        "glosses": [
                            "proces dat onlosmakelijk verbonden is met het (biologische) leven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f06bfba5-a86b-4417-b6c8-a1957457fcd6",
                                "sense_id": "92cf6386-bd28-337e-a24c-881ea9ad1c13",
                                "text": "In etappes, met de ene na de andere lichaamsfunctie die uitviel."
                            },
                            {
                                "example_id": "15c7e787-ec2a-4e71-acbb-4e7ac275ac6a",
                                "sense_id": "92cf6386-bd28-337e-a24c-881ea9ad1c13",
                                "text": "De ervaringen in onze regio zijn wellicht ook bruikbaar in andere regio’s. Want we weten, bijvoorbeeld uit onderzoek van Machteld Huber, dat niet alleen de lichaamsfuncties en het dagelijks functioneren iemands gezondheid bepalen, maar juist ook zingeving en sociaal-maatschappelijke participatie van grote betekenis zijn. Juist daar kunnen maatschappelijke organisaties en kerken ”matchen” en een onschatbare rol spelen."
                            }
                        ]
                    }
