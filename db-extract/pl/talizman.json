                                        "sense_id": "a955ba27-6aaa-37fc-88ee-58cff543ba44",
                                        "entry_id": "4b1b2dcf-d280-32d0-b6ff-3642c7d98868",
                                        "glosses": [
                                            "A mullah (Islamic religious scholar)."
                                        ],
                                        "tags": [
                                            "India",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
