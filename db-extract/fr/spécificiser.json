                "senses": [
                    {
                        "sense_id": "6b068d4d-cd96-32dd-be90-099ee9c08d9f",
                        "entry_id": "54fe0e84-b48d-3339-a4f4-521591800c05",
                        "glosses": [
                            "Donner un caractère spécifique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6be9598-f6d7-4fda-920c-810a6e072a99",
                                "sense_id": "6b068d4d-cd96-32dd-be90-099ee9c08d9f",
                                "text": "Y a-t-il un avantage à segmenter ou \"spécificiser\" les sorties ou au contraire à les \"fartleckiser\" quelle qu'en soit la longueur, donc pas simplement pour la SL ?"
                            },
                            {
                                "example_id": "ab7473a5-475c-4f2b-abc2-bfa272634588",
                                "sense_id": "6b068d4d-cd96-32dd-be90-099ee9c08d9f",
                                "text": "Je suis tout et d'abord con, mais pas spécificisé."
                            }
                        ]
                    },
                    {
                        "sense_id": "a07d062e-3673-3e24-94f1-eade36919a8d",
                        "entry_id": "54fe0e84-b48d-3339-a4f4-521591800c05",
                        "glosses": [
                            "Traiter par un médicament spécifique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b024ceb-1e7a-4192-9751-dc3b13fa79d1",
                                "sense_id": "a07d062e-3673-3e24-94f1-eade36919a8d",
                                "text": "Ces cas ne sont que trop commun : ils se présentent toutes les fois que le malade qu’on veut spécificiser ou dépurer est déjà frappé de gastrite quand il invoque les secours du médecin : mais ces cas sont trop connus pour nous arrêter."
                            }
                        ]
                    }
