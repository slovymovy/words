                "senses": [
                    {
                        "sense_id": "4d8f0f87-2f7b-371b-bd58-6c2d2f147fe2",
                        "entry_id": "556c2a6a-9bab-3edf-8797-0b7a4de52809",
                        "glosses": [
                            "Qui est coupé plusieurs fois."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f98d947b-cab2-3f13-bb5e-16cbb124b58c",
                        "entry_id": "556c2a6a-9bab-3edf-8797-0b7a4de52809",
                        "glosses": [
                            "Qui est coupé plusieurs fois.",
                            "Qualifie une voix, un phrasé, dont le déroulement est heurté, souvent par des sanglots, par la colère, par l'émotion, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc4d47e1-9976-4a1e-b0ec-874fc25fb874",
                                "sense_id": "f98d947b-cab2-3f13-bb5e-16cbb124b58c",
                                "text": "Toutes ces paroles étaient entrecoupées de caresses délirantes qui étourdirent mes sens et ma raison au point que je ne craignis point pour la consoler de proférer un effroyable blasphème, et de lui dire que je l’aimais autant que Dieu."
                            },
                            {
                                "example_id": "f89acf22-676e-4767-ad9c-e6b2bf5a4479",
                                "sense_id": "f98d947b-cab2-3f13-bb5e-16cbb124b58c",
                                "text": "Je ne vous crains pas, sire chevalier, répondit Rébecca ; mais sa voix entrecoupée semblait contredire ce qu’il y avait d’héroïque dans ses paroles."
                            },
                            {
                                "example_id": "4208e9d5-7ab3-42f5-8903-18e5c09a0916",
                                "sense_id": "f98d947b-cab2-3f13-bb5e-16cbb124b58c",
                                "text": "Vénus lui répondit d’une voix douce, mais entrecoupée de profonds soupirs :"
                            }
                        ]
                    },
                    {
                        "sense_id": "22c06347-f281-379d-a5e0-0c27167dbc2e",
                        "entry_id": "556c2a6a-9bab-3edf-8797-0b7a4de52809",
                        "glosses": [
                            "Qui est coupé plusieurs fois.",
                            "Se dit d'un terrain qui est traversé sur plusieurs endroits."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6562d55b-cf0f-4902-a982-9009a8855a4c",
                                "sense_id": "22c06347-f281-379d-a5e0-0c27167dbc2e",
                                "text": "Nous arrivons sur un terrain entrecoupé de bouquets d'arbres où toute trace de la rivière disparaît."
                            }
                        ]
                    }
                ],
