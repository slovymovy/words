                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19289701-bede-4d88-b2ce-da5812c457e5",
                                "sense_id": "626eae02-e25a-3f13-bbd8-ac1e359a39c1",
                                "text": "Au rez-de -chaussée de l’immeuble, il y a un petit mandir. Chamdi sait que c’est un temple parce que, tandis que tout l’immeuble est marron, cette partie est peinte en orange."
                            },
                            {
                                "example_id": "8dbdf44b-9244-462b-844b-86d0e1d1ca17",
                                "sense_id": "626eae02-e25a-3f13-bbd8-ac1e359a39c1",
                                "text": "L’un des plus grands temples jaïns de la vieille ville, le mandir de Shantinath date du milieu du XVIIᵉ siècle."
                            },
                            {
                                "example_id": "19e70f70-3015-4f49-96f8-b0c300935b04",
                                "sense_id": "626eae02-e25a-3f13-bbd8-ac1e359a39c1",
                                "text": "Nous prévoyons la construction d’une synagogue et d’un centre culturel juif en 2022-2023 et, il y aura la construction d’un mandir hindou en 2023-2024."
                            }
                        ]
