        "fr-extract.jsonl": [
            {
                "entry_id": "af69f3c9-4676-34bc-903d-f73e81542e6f",
                "word": "Axel",
                "pos": "name",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "537b48bd-3469-4afe-8d40-56ef711b28b5",
                        "entry_id": "af69f3c9-4676-34bc-903d-f73e81542e6f",
                        "tags": [
                            "feminine"
                        ],
                        "form": "Axelle"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "726359bb-0179-3118-a3a9-45a53af4b13a",
                        "entry_id": "af69f3c9-4676-34bc-903d-f73e81542e6f",
                        "glosses": [
                            "Prénom masculin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "182a84f5-3f74-4d99-b293-052cffb78853",
                                "sense_id": "726359bb-0179-3118-a3a9-45a53af4b13a",
                                "text": "Dylan Groenewegen s’est imposé hier lors de la deuxième étape de l’Arctic Race, la course la plus septentrionale du monde, le Français Axel Zingle conservant son maillot de leader."
                            },
                            {
                                "example_id": "26b14843-e1c9-4c92-8dc5-f1a5b1085648",
                                "sense_id": "726359bb-0179-3118-a3a9-45a53af4b13a",
                                "text": "« C’est du jamais vu », se félicite Axel Dauchez, président de Make.org, qui héberge la consultation."
                            },
                            {
                                "example_id": "5f2b182e-a3ec-4878-a69c-796662e77286",
                                "sense_id": "726359bb-0179-3118-a3a9-45a53af4b13a",
                                "text": "On se souvient d’Axel Disasi qui affirmait en début de Mondial n’être pas venu pour « profiter du soleil »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d274f26a-aea5-47b7-ad59-32cd744c5e39",
                        "source_entry_id": "af69f3c9-4676-34bc-903d-f73e81542e6f",
                        "source_sense_id": "726359bb-0179-3118-a3a9-45a53af4b13a",
