                "senses": [
                    {
                        "sense_id": "0b97ffa0-f76e-3ad0-a814-d93c1631be19",
                        "entry_id": "9ecdd1ce-66d7-3175-a67c-f3dfc8c44616",
                        "glosses": [
                            "op een boze manier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28cfc993-ad86-4be6-a0d7-219f0f57c79a",
                                "sense_id": "0b97ffa0-f76e-3ad0-a814-d93c1631be19",
                                "text": "Door bozig te vertrekken brengt hij zijn \"America first\"-boodschap voor het voetlicht."
                            },
                            {
                                "example_id": "b4672a37-acf6-4d56-b284-15bea31ef55b",
                                "sense_id": "0b97ffa0-f76e-3ad0-a814-d93c1631be19",
                                "text": "\"Hela, hou ’s op\", zeg ik quasi bozig. \"Opeens allemaal tegelijk praten, daar heb ik een broertje dood aan.\""
                            },
                            {
                                "example_id": "12898719-9ddd-4672-8d93-a5a0a33c3a1b",
                                "sense_id": "0b97ffa0-f76e-3ad0-a814-d93c1631be19",
                                "text": "Hij keek me bozig aan en verweet me dat ik alweer met mijn hoofd bij de volgende trail zat, waardoor ik de PCT veel minder intens zou ervaren."
                            }
                        ]
                    }
