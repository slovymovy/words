{
    "word_family": [
        "project",
        "projection",
        "projective",
        "projectionist"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1b092993-e534-3336-931d-565ffa10ffb2",
                    "sense_definition": "An optical device that projects a beam of light, especially one used to project an image or moving images onto a screen.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "optical_devices",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher turned on the <w>projector</w> to show the presentation to the class.",
                            "target_lang_translations": {
                                "ru": "Учитель включил <w>проектор</w>, чтобы показать презентацию классу."
                            }
                        },
                        {
                            "text": "We need a high-quality digital <w>projector</w> for the movie night in the garden.",
                            "target_lang_translations": {
                                "ru": "Нам нужен качественный цифровой <w>проектор</w> для кинопоказа в саду."
                            }
                        }
                    ],
                    "synonyms": [
                        "beamer"
                    ],
                    "common_phrases": [
                        "digital projector",
                        "overhead projector",
                        "movie projector",
                        "slide projector"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оптический прибор, проецирующий изображение или видео на экран."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проектор",
                                "target_lang_sense_clarification": "оптическое устройство"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "887a1d56-9078-3577-aed7-4dd986919744",
                    "sense_definition": "A machine or device that launches or shoots something out.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "launching_devices",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The naval vessel was equipped with a specialized depth charge <w>projector</w> for defense.",
                            "target_lang_translations": {
                                "ru": "Военный корабль был оснащен специальным <w>бомбометом</w> для глубинных бомб в целях обороны."
                            }
                        },
                        {
                            "text": "Engineers designed a new <w>projector</w> to launch small probes into the atmosphere.",
                            "target_lang_translations": {
                                "ru": "Инженеры разработали новый <w>метатель</w> для запуска небольших зондов в атмосферу."
                            }
                        }
                    ],
                    "synonyms": [
                        "launcher",
                        "thrower"
                    ],
                    "common_phrases": [
                        "depth charge projector"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Техническое устройство или механизм для запуска или выбрасывания чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "метатель",
                                "target_lang_sense_clarification": "устройство для запуска"
                            },
                            {
                                "target_lang_word": "бомбомет",
                                "target_lang_sense_clarification": "в военно-морском деле"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af0c78f2-3fa5-34f3-b6f7-fc79b1716337",
                    "sense_definition": "A person who ascribes their own feelings, impulses, or thoughts to others.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "psychology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As a chronic <w>projector</w>, he often accused his colleagues of the very laziness he felt himself.",
                            "target_lang_translations": {
                                "ru": "Как хронический <w>проектор</w>, он часто обвинял коллег в той самой лени, которую чувствовал сам."
                            }
                        },
                        {
                            "text": "Psychologists observe that <w>projectors</w> attempt to get rid of unwanted feelings by seeing them in others.",
                            "target_lang_translations": {
                                "ru": "Психологи отмечают, что <w>проекторы</w> пытаются избавиться от нежелательных чувств, видя их в других людях."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "psychological"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, приписывающий свои собственные чувства или мысли другим людям."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проектор",
                                "target_lang_sense_clarification": "в психологии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0671eb48-58d8-3190-a846-cdec451f1c68",
                    "sense_definition": "A person who forms schemes or designs; a promoter or planner of a project.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "planners",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>projector</w> of the new canal scheme struggled to find enough investors.",
                            "target_lang_translations": {
                                "ru": "<w>Проектировщик</w> новой схемы канала изо всех сил пытался найти достаточно инвесторов."
                            }
                        },
                        {
                            "text": "History remembers him as a visionary <w>projector</w> who dreamed of building cities in the desert.",
                            "target_lang_translations": {
                                "ru": "История помнит его как дальновидного <w>прожектера</w>, мечтавшего строить города в пустыне."
                            }
                        }
                    ],
                    "synonyms": [
                        "planner",
                        "schemer",
                        "promoter"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "often used for historical schemes"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, составляющий планы или схемы; инициатор или проектировщик проекта."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проектировщик",
                                "target_lang_sense_clarification": "составитель планов"
                            },
                            {
                                "target_lang_word": "прожектер",
                                "target_lang_sense_clarification": "составитель неосуществимых планов"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}