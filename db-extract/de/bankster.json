                ],
                "senses": [
                    {
                        "sense_id": "c60929ea-e43e-3f0e-aecd-22ef88e59fc3",
                        "entry_id": "3c1b0a7e-2cc6-3343-b2f5-4b347103671b",
                        "glosses": [
                            "korrupter Banker"
                        ],
                        "tags": [
                            "casual",
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "f3bf3fe7-a234-4643-990f-faec0b6dd8a0",
                                "sense_id": "c60929ea-e43e-3f0e-aecd-22ef88e59fc3",
                                "text": "„Die Kaltschnäuzigkeit der „Bankster“, ihre atemberaubend vulgäre Sprache und ihre dummdreisten Erpressungsversuche gegenüber handzahmen Aufsichtsbehörden - jeder kann all das nun mit eigenen Ohren hören, und viele sehen ihre schlimmsten Befürchtungen über die Auswüchse im Finanzgeschäft bestätigt.“"
                            },
                            {
                                "example_id": "1ce1f738-ccc1-4945-9f1d-73a8d2ffa474",
                                "sense_id": "c60929ea-e43e-3f0e-aecd-22ef88e59fc3",
                                "text": "„Einer zwitschert in die Runde, es laufe ihm eiskalt den Rücken herunter, wenn ein „Whistleblower in die Klapse“ gehe, während die „Bankster ungeschoren“ davonkämen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a317bd94-43c2-4bb6-8609-2e55b5e573f7",
                        "source_entry_id": "3c1b0a7e-2cc6-3343-b2f5-4b347103671b",
                        "source_sense_id": "c60929ea-e43e-3f0e-aecd-22ef88e59fc3",
                        "source_sense_description": "salopp, abwertend: korrupter Banker",
                        "target_lang_word": "bankster",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bankster",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f9b2d7db-8e89-33b1-8ef7-cb30c382db80",
                                        "entry_id": "b44b6f3c-f689-3edb-9ae2-e7e1104ec79e",
                                        "glosses": [
                                            "A banker who is seen as criminally irresponsible, or as extorting bailout money from the taxpayers."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3457676e-a663-409b-8e2c-c9d94f0f0ce4",
                                                "sense_id": "f9b2d7db-8e89-33b1-8ef7-cb30c382db80",
                                                "text": "Hearing Sir Fred the Shred and the rest of them utter some hedged half-apologies has not made the public feel any warmer to the banksters."
                                            },
                                            {
                                                "example_id": "be049aee-8f4e-4308-9b56-c18243b9384d",
                                                "sense_id": "f9b2d7db-8e89-33b1-8ef7-cb30c382db80",
                                                "text": "Stop supporting bums abroad. Stop all foreign aid, which is aid to banksters and their bonds and their export industries."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
