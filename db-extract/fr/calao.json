                                        "entry_id": "d4c94e76-31f8-3479-a0f5-6c0b9bb82c03",
                                        "glosses": [
                                            "Any of various birds of the family Bucerotidae, with bills resembling a cow's horns. Many species have a casque above the bill, and many imprison their young in a tree."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1451ca83-25c3-4e86-a5f4-8b7ce8353acb",
                                                "sense_id": "55b8f772-c532-3ee6-9415-353de6622f17",
                                                "text": "I saw what they were, hornbills, white head with a black streak of feather on top, a long grey tail, and a huge red beak that curved down, bigger than his head."
                                            }
                                        ]
                                    }
                                ]
