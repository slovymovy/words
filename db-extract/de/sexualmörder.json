                "senses": [
                    {
                        "sense_id": "7d2207c2-8d55-31bc-a172-586e4709b6c2",
                        "entry_id": "aab7f20c-253b-3d21-8701-aedd95ac5c9a",
                        "glosses": [
                            "Person, die aus sexuellen Motiven Morde begeht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37aee7e3-35af-4989-ace2-fe5024a6f268",
                                "sense_id": "7d2207c2-8d55-31bc-a172-586e4709b6c2",
                                "text": "„Und selbst ICH werde von Presse und Öffentlichkeit als Sexualmörder betrachtet!“"
                            },
                            {
                                "example_id": "def5073e-774c-4809-b840-19fbcd888eb9",
                                "sense_id": "7d2207c2-8d55-31bc-a172-586e4709b6c2",
                                "text": "„Beispielsweise gab man uns Fotos und Dossiers über Kinderschänder oder Sexualmörder und diskutierte, wie eine solche Person bei einer Geiselnahme reagieren würde.“"
                            },
                            {
                                "example_id": "156574c7-24a5-477f-9308-c153e77154f8",
                                "sense_id": "7d2207c2-8d55-31bc-a172-586e4709b6c2",
                                "text": "„›Nein, Detective. Ich kann mir nicht vorstellen, dass Got einem Sexualmörder eine solche Macht verleiht.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
