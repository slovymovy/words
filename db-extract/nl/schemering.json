        "nl-extract.jsonl": [
            {
                "entry_id": "fa696906-070c-34c2-92f7-7a22f17d25ba",
                "word": "schemering",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "a9d4d579-70b3-424d-9a7e-a47177ff649f",
                        "entry_id": "fa696906-070c-34c2-92f7-7a22f17d25ba",
                        "tags": [
                            "plural"
                        ],
                        "form": "schemeringen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f6aa6dce-b7d7-3b6d-a598-ce0c8a568e72",
                        "entry_id": "fa696906-070c-34c2-92f7-7a22f17d25ba",
                        "glosses": [
                            "toestand tussen dag en nacht, waarin het niet echt licht of donker is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1aa9a67-ea8c-4ca8-a17c-811e6cdf5012",
                                "sense_id": "f6aa6dce-b7d7-3b6d-a598-ce0c8a568e72",
                                "text": "In de schemering was de rand van het bos niet meer goed te zien."
                            },
                            {
                                "example_id": "9610740f-3b80-4d72-983c-6d537f002b21",
                                "sense_id": "f6aa6dce-b7d7-3b6d-a598-ce0c8a568e72",
                                "text": "Het festivalseizoen brengt een geheel andere sfeer met zich mee dan touren: overdag het zonnetje, ’s avonds de schemering."
                            }
                        ]
                    },
                    {
                        "sense_id": "346b5cab-e7a1-34fc-abf5-8869cb0abd6e",
                        "entry_id": "fa696906-070c-34c2-92f7-7a22f17d25ba",
                        "glosses": [
                            "tijd van de dag waarop het licht dan wel donker wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c3a07d8-c363-4e6b-a089-b2e156fe3b0e",
                                "sense_id": "346b5cab-e7a1-34fc-abf5-8869cb0abd6e",
                                "text": "Tijdens de schemering heb je de beste kans reeën te zien."
                            },
                            {
                                "example_id": "8b44360a-0a0e-4dad-a457-d9b69f94f36b",
                                "sense_id": "346b5cab-e7a1-34fc-abf5-8869cb0abd6e",
                                "text": "Overal kwamen dieren uit het bos tevoorschijn terwijl ik in de schemering afdaalde naar de groene vallei waar een rivier doorheen liep."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a17435ea-c572-4330-be09-b7a76176c262",
                        "source_entry_id": "fa696906-070c-34c2-92f7-7a22f17d25ba",
                        "source_sense_id": "346b5cab-e7a1-34fc-abf5-8869cb0abd6e",
                        "source_sense_description": "de tijd van de dag waarop het licht dan wel donker wordt",
                        "target_lang_word": "Dämmerung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dämmerung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fcdde1db-870b-3df4-9bb4-747976c54139",
                                        "entry_id": "72d46aaf-fa49-3def-b210-bec63b91552d",
                                        "glosses": [
                                            "ein Lichtphänomen aufgrund des Sonnenlichts; der Übergang zwischen Tag und Nacht (unmittelbar nach Sonnenuntergang) oder umgekehrt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b2279a9-19aa-49f6-9a53-53e00ad51936",
                                                "sense_id": "fcdde1db-870b-3df4-9bb4-747976c54139",
                                                "text": "Als sie aus dem Haus ging, war die Dämmerung bereits hereingebrochen."
                                            },
                                            {
                                                "example_id": "1d5fcf22-7207-43b0-9ecd-3a21ae1911d9",
                                                "sense_id": "fcdde1db-870b-3df4-9bb4-747976c54139",
                                                "text": "„Die Dämmerung kroch langsam über den Berg.“"
                                            },
                                            {
                                                "example_id": "31455010-9fd1-4c8a-ac4b-c05c12d4900f",
                                                "sense_id": "fcdde1db-870b-3df4-9bb4-747976c54139",
                                                "text": "„Die Dämmerung schlich in die Grabenwinkel.“"
                                            },
                                            {
                                                "example_id": "69d9e3f1-dc91-43fb-a0d8-21eaa20e2c54",
                                                "sense_id": "fcdde1db-870b-3df4-9bb4-747976c54139",
                                                "text": "„Die Dämmerung setzt ein, der Abendhimmel wird milchig.“"
                                            },
                                            {
                                                "example_id": "2e0595c4-063c-47ed-a453-4fd6768f0fa6",
                                                "sense_id": "fcdde1db-870b-3df4-9bb4-747976c54139",
                                                "text": "„Frieda, durch ihre Märsche nach Glowitz ermutigt, hat in der Dämmerung die Schwester heimlich besucht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1aa8e488-8b20-4766-ae7b-174000d557c8",
                        "source_entry_id": "fa696906-070c-34c2-92f7-7a22f17d25ba",
                        "source_sense_id": "346b5cab-e7a1-34fc-abf5-8869cb0abd6e",
                        "source_sense_description": "de tijd van de dag waarop het licht dan wel donker wordt",
                        "target_lang_word": "twilight",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "twilight",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a9d76f7c-754c-3722-b9b7-ae38e584a7c1",
                                        "entry_id": "8a288260-972d-324c-bd4f-61f4e79622c3",
                                        "glosses": [
                                            "The soft light in the sky seen before the rising and (especially) after the setting of the sun, occasioned by the illumination of the earth’s atmosphere by the direct rays of the sun and their reflection on the earth."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "139c654f-2701-43e8-b196-eb9ecdaefdf8",
                                                "sense_id": "a9d76f7c-754c-3722-b9b7-ae38e584a7c1",
                                                "text": "Near-synonym: half-light"
                                            },
                                            {
                                                "example_id": "9e841ad3-a0d3-4997-8e06-93b3e952020e",
                                                "sense_id": "a9d76f7c-754c-3722-b9b7-ae38e584a7c1",
                                                "text": "I could just make out her face in the twilight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59b56e68-0eb1-3728-a74a-eaaf0d1aaa23",
                                        "entry_id": "8a288260-972d-324c-bd4f-61f4e79622c3",
                                        "glosses": [
                                            "The time when said light is visible; the period between daylight and darkness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a8c779b-0bc2-4e22-8281-dc9676ab6da3",
                                                "sense_id": "59b56e68-0eb1-3728-a74a-eaaf0d1aaa23",
                                                "text": "It was twilight by the time I got back home."
                                            },
                                            {
                                                "example_id": "e99ecff9-5aa3-43d4-b499-f5f9a4fb4378",
                                                "sense_id": "59b56e68-0eb1-3728-a74a-eaaf0d1aaa23",
                                                "text": "At twilight in the summer there is never anybody to fear—man, woman, or cat—in the chambers and at that hour the mice come out. They do not eat parchment or foolscap or red tape, but they eat the luncheon crumbs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3f480d1-670b-3255-8edb-ccc82ad2dabb",
                                        "entry_id": "8a288260-972d-324c-bd4f-61f4e79622c3",
                                        "glosses": [
                                            "Any faint light through which something is seen."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "399a1ac8-1115-4635-bb06-df847497f4f0",
                                                "sense_id": "b3f480d1-670b-3255-8edb-ccc82ad2dabb",
                                                "text": "Two women, Eusabio’s wife and sister, looked on from the deep twilight of the hut."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af7fea1b-4fb8-3ce8-bf7c-201dde43ab51",
                                        "entry_id": "8a288260-972d-324c-bd4f-61f4e79622c3",
                                        "glosses": [
                                            "The time when the sun is less than 18° below the horizon."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1ae92643-6155-35fd-a2d6-552f04e3602d",
                                        "entry_id": "8a288260-972d-324c-bd4f-61f4e79622c3",
                                        "glosses": [
                                            "An in-between or fading condition through which something is perceived."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89174f90-27e3-4411-bce4-b801125cf05f",
                                                "sense_id": "1ae92643-6155-35fd-a2d6-552f04e3602d",
                                                "text": "“They have not enough heart,” said Edith, with a smile. The very twilight of a smile: so singularly were its light and darkness blended."
                                            },
                                            {
                                                "example_id": "65f71247-2743-449d-9f57-000396575ad9",
                                                "sense_id": "1ae92643-6155-35fd-a2d6-552f04e3602d",
                                                "text": "The twilight of one's life"
                                            },
                                            {
                                                "example_id": "20609165-7131-49e6-88a1-0b45937db4a6",
                                                "sense_id": "1ae92643-6155-35fd-a2d6-552f04e3602d",
                                                "text": ", Book IV, Chapter XIV\nThe twilight […] of probability."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "twilight",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "81688866-86b4-3777-91dd-4f9e828e0d3c",
                                        "entry_id": "b8a596a1-148b-35a1-a9a3-2120f4e89c3c",
                                        "glosses": [
                                            "Pertaining to or resembling twilight; faintly illuminated; obscure."
                                        ],
