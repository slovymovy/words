                "senses": [
                    {
                        "sense_id": "69458336-78b6-3081-8d43-6f33ca155406",
                        "entry_id": "39acf0e0-5b26-39dc-a00c-07b12a02b5af",
                        "glosses": [
                            "unangenehmes Gefühl (Schmerz) am Hals oder im Rachen aufgrund einer Entzündung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6ef9ff6-af48-4852-9672-312634da38ce",
                                "sense_id": "69458336-78b6-3081-8d43-6f33ca155406",
                                "text": "„Als sie am frühen Morgen aufgestanden war, hatte sie ein leichtes Halskratzen verspürt.“"
                            },
                            {
                                "example_id": "1d2368da-57c2-4562-bef0-6f9461f5bb8c",
                                "sense_id": "69458336-78b6-3081-8d43-6f33ca155406",
                                "text": "„Man spürt vielleicht nicht mehr als weitere milde Körperschmerzen, leichtes Fieber, Halskratzen und Kopfweh, aber wenn sich das mit Symptomen mischt, die bereits bestanden, kann das Ganze unübersichtlich werden.“"
                            },
                            {
                                "example_id": "435da801-5129-4aa7-b2a0-795a3a5041e8",
                                "sense_id": "69458336-78b6-3081-8d43-6f33ca155406",
                                "text": "„Feinstaubpartikel können zu Augenreizungen und Halskratzen führen und in schweren Fällen Atemwegs- und Herzerkrankungen auslösen.“"
                            },
                            {
                                "example_id": "a5703df5-3e33-4f30-9fa5-232289594ced",
                                "sense_id": "69458336-78b6-3081-8d43-6f33ca155406",
                                "text": "„In letzter Zeit haben sich zu der zunehmenden Heiserkeit jedoch ein ständiges Halskratzen, ein Räusperzwang und ein quälender Husten gesellt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
