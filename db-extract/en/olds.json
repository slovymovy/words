                    {
                        "sense_id": "f5e9ff9e-1cca-335c-a98b-4164b1e52d8f",
                        "entry_id": "ff6ec724-df27-3019-9097-019a8d8f5ecc",
                        "glosses": [
                            "Anyone portrayed in the context as not young; for example, anyone older than the speaker's audience of coevals; often, middle-aged adults or older adults."
                        ],
                        "tags": [
                            "humorous",
                            "often",
                            "plural",
                            "plural-normally",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "087d3b3b-3ed1-4ede-b26c-91116f1fd635",
                                "sense_id": "f5e9ff9e-1cca-335c-a98b-4164b1e52d8f",
                                "text": "Her friends at school snicker at how the olds are clueless about TikTok trends. But they can't shame us olds about it very effectively, because we're old enough to know that today's trends too shall pass."
                            },
                            {
                                "example_id": "e0f99ffd-8bdf-45e1-b3fb-dfc39b8cdc92",
                                "sense_id": "f5e9ff9e-1cca-335c-a98b-4164b1e52d8f",
                                "text": "Don't ask me what the kids consider cool at the moment — I'm just an old."
                            }
                        ]
                    }
