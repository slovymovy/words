                        "entry_id": "095ade44-7de9-32a8-ab98-a427f5ab85fa",
                        "glosses": [
                            "Any of four species of long-billed migratory wading birds in the genus Limosa, of the family Scolopacidae."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e2799a1-0f6e-46aa-bf0e-d33d76d62f0e",
                                "sense_id": "1c3d9bec-afc8-364a-8a9b-def103daaad7",
                                "text": "My foot-boy shall eat pheasants, calvered salmons, / Knots, godwits, lampreys: I myself will have / The beards of barbels, served instead of salads […]"
                            }
                        ]
                    }
                ],
