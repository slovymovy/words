                                        "entry_id": "ab9f46b1-af14-3fa9-b955-216da6a8dc88",
                                        "glosses": [
                                            "systeem waarbij men bij verbranding zowel gebruik maakt van de ontstane warmte als van de mechanische energie die ermee kan worden opgewekt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "000e68ea-444e-4acb-a5b6-872a6e644ebb",
                                                "sense_id": "fed953ac-7e19-3441-8be1-8e70534c0aac",
                                                "text": "Voor warmtekracht is de daling nog opvallender. Vorig jaar was er nog een record van 16 miljoen certificaten in omloop. Daar blijven er eind dit jaar nog 5 miljoen van over."
                                            },
                                            {
                                                "example_id": "e8ceac00-bcd8-4c2f-9a42-c572f1f5c2f4",
                                                "sense_id": "fed953ac-7e19-3441-8be1-8e70534c0aac",
                                                "text": "\"Warmtekracht kan kerncentrales vervangen\""
                                            }
                                        ]
                                    },
