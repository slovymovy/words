                                            {
                                                "example_id": "19439509-838f-4c07-a8f5-7f18bd96f0a1",
                                                "sense_id": "05ae5e71-6d9d-3965-a4f7-c3ed2a3d357b",
                                                "text": "We decorated the Christmas tree with tinsel and baubles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65f0ee3f-e15c-3726-8cac-36d7c0c4924a",
                                        "entry_id": "1eba4706-2563-30ca-9801-9409f85897db",
                                        "glosses": [
                                            "To improve the appearance of an interior of, as a house, room, or office."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "878904ed-8862-41b9-b500-297fb27b446e",
                                                "sense_id": "65f0ee3f-e15c-3726-8cac-36d7c0c4924a",
                                                "text": "There's some paint left over from when we decorated the guest bedroom."
                                            },
                                            {
                                                "example_id": "db1bb10d-5d19-4332-ac07-eddf83f91632",
                                                "sense_id": "65f0ee3f-e15c-3726-8cac-36d7c0c4924a",
                                                "text": "We moved in over a month ago but we still haven't gotten started on decorating."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11285176-2049-3be0-b432-fedd62cec629",
                                        "entry_id": "1eba4706-2563-30ca-9801-9409f85897db",
                                        "glosses": [
                                            "To improve the appearance of an interior of, as a house, room, or office."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "532e7501-a641-4966-bc3e-b6306ce8d1bb",
                                                "sense_id": "11285176-2049-3be0-b432-fedd62cec629",
                                                "text": "People tend to decorate for the holidays or special events."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "215a109a-22f3-37a1-94d9-d669f52c55b8",
                                        "entry_id": "1eba4706-2563-30ca-9801-9409f85897db",
                                        "glosses": [
                                            "To honor by providing a medal, ribbon, or other adornment."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1a4f2b0-cf62-440f-80ac-94f12f52ee2b",
                                                "sense_id": "215a109a-22f3-37a1-94d9-d669f52c55b8",
                                                "text": "He was a decorated soldier who served in three wars."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ddd31ce-3716-3e52-876d-594254ede746",
                                        "entry_id": "1eba4706-2563-30ca-9801-9409f85897db",
                                        "glosses": [
                                            "To extend a method, etc. by attaching some further code item."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6a46e22-df5e-4c27-855a-c7138e0ca1d8",
