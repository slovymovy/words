                "senses": [
                    {
                        "sense_id": "4fa07444-1711-3d51-8062-b388907f900e",
                        "entry_id": "2301cde0-63db-3ca1-ba82-d30fcc28d0eb",
                        "glosses": [
                            "aan de basis staande"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4fd100f-1a88-405e-8075-b7cbf907a587",
                                "sense_id": "4fa07444-1711-3d51-8062-b388907f900e",
                                "text": "Kinderombudsman Margrite Kalverboer zegt dat als staatssecretaris Mark Harbers de uitzetting van de kinderen Lili en Howick naar Armenië doorzet, hij fundamentele rechten van kinderen schendt"
                            },
                            {
                                "example_id": "b06d9822-cbff-422b-bea7-1c2c55e67f1d",
                                "sense_id": "4fa07444-1711-3d51-8062-b388907f900e",
                                "text": "Maar als ik zonder te liften in dit tempo zou doorlopen, was het wel van belang dat er iets fundamenteels zou veranderen. Met al mijn lange rustpauzes in elk dorp zou ik nooit voor het vallen van de eerste sneeuw aankomen in Canada."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7999391d-6f5b-45d5-8931-5dc83a0f5177",
                        "source_entry_id": "2301cde0-63db-3ca1-ba82-d30fcc28d0eb",
                        "source_sense_id": "4fa07444-1711-3d51-8062-b388907f900e",
                        "source_sense_description": "aan de basis staande",
                        "target_lang_word": "fundamental",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fundamental",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5f313ddd-59a9-37e5-87ce-64593cd90bb0",
                                        "entry_id": "4d5c2714-3b27-3cb1-99de-85107f064a8f",
                                        "glosses": [
                                            "grundlegend; die Grundlage, das Fundament betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8013a882-e858-4e8d-8a20-30a2bb228047",
                                                "sense_id": "5f313ddd-59a9-37e5-87ce-64593cd90bb0",
                                                "text": "Das Vertrauen ist fundamental in einer Beziehung."
                                            },
                                            {
                                                "example_id": "289fb270-ecfe-444b-91e5-9652b0bf89ef",
                                                "sense_id": "5f313ddd-59a9-37e5-87ce-64593cd90bb0",
                                                "text": "„Der Naturforscher Charles Darwin (1809-1882) beschrieb grundlegende Mechanismen der Evolution und erkannte, dass Anpassung, Veränderung und Selektion fundamental für die Entwicklung von Leben sind.“"
                                            },
                                            {
                                                "example_id": "858dbaf3-bd42-4dde-9eb2-24c4f114f153",
                                                "sense_id": "5f313ddd-59a9-37e5-87ce-64593cd90bb0",
                                                "text": "[Russischer Angriffskrieg auf die Ukraine 2022:] „Kurz nach Kriegsbeginn ruft der deutsche Bundeskanzler eine fundamentale Änderung der deutschen Außenpolitik aus: \"Zeitenwende\" nennt Olaf Scholz das in einer Rede vor dem Deutschen Bundestag.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "860be1e2-1a83-499c-bb8d-3138988f4909",
                        "source_entry_id": "2301cde0-63db-3ca1-ba82-d30fcc28d0eb",
                        "source_sense_id": "4fa07444-1711-3d51-8062-b388907f900e",
