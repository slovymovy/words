                ],
                "senses": [
                    {
                        "sense_id": "ae9721ca-2042-3d11-b489-2f6b3428fc55",
                        "entry_id": "62da7f51-6994-3723-a9d4-3af984804234",
                        "glosses": [
                            "Bezeichnung für die mit der ehemaligen Sowjetunion verbündeten und von ihr dominierten Länder, vor allem in Mittel- und Osteuropa"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5987673d-2900-4029-bcf7-ff109bdc9e46",
                                "sense_id": "ae9721ca-2042-3d11-b489-2f6b3428fc55",
                                "text": "„Hier wurden jahrzehntelang Traktoren für den gesamten Ostblock gebaut.“"
                            },
                            {
                                "example_id": "9cb64468-56a9-4dfb-94d9-5ca2d2527cfa",
                                "sense_id": "ae9721ca-2042-3d11-b489-2f6b3428fc55",
                                "text": "„Offiziell war »Gazeta Wyborcza« da, um über die erste freie Wahl im ganzen Ostblock zu berichten, enthielt aber auch den diskreten Hinweis, daß das Volk zum ersten Mal die »Wahl« zwischen der Wahrheit und der Propaganda hatte.“"
                            },
                            {
                                "example_id": "9b813fd5-8517-49e7-9c5e-a5dfbe8e4e09",
                                "sense_id": "ae9721ca-2042-3d11-b489-2f6b3428fc55",
                                "text": "„Mit der Auflösung des Ostblocks war auch das Mengistu-Regime am Ende (1993).“"
                            },
                            {
                                "example_id": "696a989b-2526-4dae-ae78-f864d457b080",
                                "sense_id": "ae9721ca-2042-3d11-b489-2f6b3428fc55",
                                "text": "„Die Romvölker machen in den Ländern des Ostblocks politisch kaum auf sich aufmerksam, obwohl sie insgesamt einen Bevölkerungsanteil im Millionenbereich stellen.“"
                            },
                            {
                                "example_id": "e1657658-f86b-4cf3-987a-4bb79e607b22",
                                "sense_id": "ae9721ca-2042-3d11-b489-2f6b3428fc55",
                                "text": "[Breschnew-Doktrin:] „Breschnews Nachfolger Michail Gorbatschow hob im Jahr 1989 die Doktrin auf. Daraufhin zerfiel der Ostblock.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
