                        "entry_id": "27b1b0f0-a2dd-3fda-ba73-9a5092d9e500",
                        "glosses": [
                            "Qui a tendance à former une rosette."
                        ],
                        "tags": [
                            "Très rare"
                        ],
                        "examples": [
                            {
                                "example_id": "0660cc2a-4c61-420e-9a8e-c90c35240335",
                                "sense_id": "01442946-d674-38a3-a1cf-a94eeaf09868",
                                "text": "Coloris de la fleur variable : violet, violet bleuâtre, … blanc avec éperon rosulé."
                            }
                        ]
                    },
                    {
                        "sense_id": "ebdc3dc1-321c-33b6-b79c-e9bb5bca7441",
                        "entry_id": "27b1b0f0-a2dd-3fda-ba73-9a5092d9e500",
                        "glosses": [
                            "Qui tire sur le rose."
                        ],
                        "tags": [
                            "Très rare"
                        ],
                        "examples": [
                            {
                                "example_id": "34f25f09-a98f-4c87-bb5d-8ee70bc33134",
                                "sense_id": "ebdc3dc1-321c-33b6-b79c-e9bb5bca7441",
                                "text": "Pétales d'un blanc souvent rosulé, largement ovales ou rhomboïdaux […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cd150be3-7b31-49f3-9274-50776160bfe7",
                        "source_entry_id": "27b1b0f0-a2dd-3fda-ba73-9a5092d9e500",
                        "source_sense_id": "01442946-d674-38a3-a1cf-a94eeaf09868",
                        "source_sense_description": "Formant une rosette",
                        "target_lang_word": "rosulate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rosulate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7001f162-a2df-32a2-bcb8-6a38aab42e56",
                                        "entry_id": "4a3ef609-f939-30f5-b170-e10b672cc0c8",
                                        "glosses": [
                                            "Arranged in small rose-like clusters."
                                        ],
                                        "tags": [
                                            "of leaves and bracts"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03f32151-67fc-493b-8b40-b3e664718280",
                                                "sense_id": "7001f162-a2df-32a2-bcb8-6a38aab42e56",
                                                "text": "It appears to claim a very close relationship to the preceding species, differing chiefly in the tiny leaves being rather more rosulate than caudiculate, and in not being adpressed, but rather the reverse; its petals, also, are narrower."
                                            },
                                            {
                                                "example_id": "fa54330a-d9d2-4ef2-85d3-7dc328e3ed77",
                                                "sense_id": "7001f162-a2df-32a2-bcb8-6a38aab42e56",
                                                "text": "In young plants, the leaves are often more or less arranged in four vertical ranks, but become more rosulate with age."
                                            },
                                            {
                                                "example_id": "9938246d-11a2-4691-92dd-114debc3bd43",
                                                "sense_id": "7001f162-a2df-32a2-bcb8-6a38aab42e56",
                                                "text": "[…]differs from the typical form in having smaller, shorter more rosulate milky-green leaves, shorter sheaths, greenish-yellow buds, straighter flowers and narrower more or less unicoloured yellowish racemes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ba529664-0e5d-4a47-bef5-9bcdf1a2f241",
                        "source_entry_id": "27b1b0f0-a2dd-3fda-ba73-9a5092d9e500",
                        "source_sense_id": "ebdc3dc1-321c-33b6-b79c-e9bb5bca7441",
                        "source_sense_description": "Tirant sur le rose",
                        "target_lang_word": "roseate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "roseate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "411d947c-3b0d-3efb-838f-2803bd42a65d",
                                        "entry_id": "acd97314-ad19-3bc1-aecd-590504bf73b3",
                                        "glosses": [
                                            "Like the rose flower; pink; rosy."
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6c10759-3310-49a7-908d-256e8326da2c",
                                                "sense_id": "411d947c-3b0d-3efb-838f-2803bd42a65d",
                                                "text": "The countess took the roseate palm and snowy fingers of this lovely child."
                                            },
                                            {
                                                "example_id": "459d2f29-2737-4189-bf78-166e82907e3f",
                                                "sense_id": "411d947c-3b0d-3efb-838f-2803bd42a65d",
                                                "text": "Now the rum, as has been said, was criminally overproof, and they had had no intoxicants for a long time. And so a couple of stiff drinks produced a beautiful and generous expansion of soul. The mean cabin became larger, the fire warmer and more cheerful, and life generally of a more roseate hue. They began to feel the prodigal Thanksgiving spirit, and to regret their limited opportunities for satisfying it."
                                            },
                                            {
                                                "example_id": "14c2cd76-bb75-4742-ac7e-b8a64722e08e",
                                                "sense_id": "411d947c-3b0d-3efb-838f-2803bd42a65d",
                                                "text": "On Professor Solanka’s street, well-heeled white youths lounged in baggy garments on roseate stoops, stylishly simulating indigence while they waited for the billionairedom that would surely be along sometime soon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d012916-ba49-3225-ba2e-7486bfe80706",
                                        "entry_id": "acd97314-ad19-3bc1-aecd-590504bf73b3",
                                        "glosses": [
                                            "Full of roses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60f70418-bfb3-4171-8023-80e611050c6a",
                                                "sense_id": "2d012916-ba49-3225-ba2e-7486bfe80706",
                                                "text": "To fund the purchase, he had to sell a late Renoir, The Judgment of Paris, with its depiction of weighty ladies frolicking in a roseate garden."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9a041de-7aea-33d1-a671-67f7cc1eba86",
                                        "entry_id": "acd97314-ad19-3bc1-aecd-590504bf73b3",
                                        "glosses": [
                                            "Excessively optimistic."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f815ad9b-2f88-4929-8482-ed52f438621c",
                                                "sense_id": "d9a041de-7aea-33d1-a671-67f7cc1eba86",
                                                "text": "Viewed from this perspective, the behaviour of the digital giants looks rather different from the roseate hallucinations of Wired magazine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
