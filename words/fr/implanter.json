            "senses": [
                {
                    "sense_id": "05f9a2b2-ec8b-3b89-adf2-0cdac91f7794",
                    "sense_definition": "Établir ou installer une entreprise, un commerce ou une activité dans un lieu déterminé.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "installation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'entreprise souhaite <w>implanter</w> une nouvelle usine dans le nord du pays."
                        },
                        {
                            "text": "De nombreuses boutiques internationales ont choisi de s'<w>implanter</w> au centre-ville."
                        }
                    ],
                    "common_phrases": [
