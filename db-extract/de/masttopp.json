                "senses": [
                    {
                        "sense_id": "66108d56-ce88-3ead-9b1b-6563ac534e8d",
                        "entry_id": "41c5dbbe-c7a2-3a43-8455-aa07a6601d20",
                        "glosses": [
                            "Spitze eines Mastes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a96fa8c-c6f0-4b86-903b-ee71aad65d40",
                                "sense_id": "66108d56-ce88-3ead-9b1b-6563ac534e8d",
                                "text": "Der Abstand vom Kiel bis zum Masttopp ist auf 14 Meter begrenzt."
                            },
                            {
                                "example_id": "e6ac564d-3528-476c-8de1-371f48c41c65",
                                "sense_id": "66108d56-ce88-3ead-9b1b-6563ac534e8d",
                                "text": "Das Boot führte ein gut sichtbares Licht am Masttopp, ganz wie es der Vorschrift entsprach."
                            },
                            {
                                "example_id": "18e6fafc-c72d-44ba-b49a-64146235f20d",
                                "sense_id": "66108d56-ce88-3ead-9b1b-6563ac534e8d",
                                "text": "„Bald begann ich die Takelage der Brigg aufzuentern und zu den Masttopps aufzusteigen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4a1d00b0-30fd-472b-ba4c-5a272fabc02a",
                        "source_entry_id": "41c5dbbe-c7a2-3a43-8455-aa07a6601d20",
                        "source_sense_id": "66108d56-ce88-3ead-9b1b-6563ac534e8d",
                        "source_sense_description": "Spitze eines Mastes",
                        "target_lang_word": "masthead",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "masthead",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d2495e22-881b-3770-bcb2-5b0463c23f91",
                                        "entry_id": "0acf4530-f364-32eb-89f6-88e87d18fef0",
                                        "glosses": [
                                            "The top of a mast."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2a63d68-ecfc-4458-b102-a26e0caf89af",
                                                "sense_id": "d2495e22-881b-3770-bcb2-5b0463c23f91",
                                                "text": "In most American whalemen the mast-heads are manned almost simultaneously with the vessel’s leaving her port; even though she may have fifteen thousand miles, and more, to sail ere reaching her proper cruising ground."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81e2d130-de6b-3c3d-9edd-6bef87d810d4",
                                        "entry_id": "0acf4530-f364-32eb-89f6-88e87d18fef0",
                                        "glosses": [
                                            "A list of a newspaper or other periodical's main staff, contributing writers, publisher, circulation, advertising rates etc."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ac9b7b33-c3f0-3d86-8ac3-602d58fce41d",
                                        "entry_id": "0acf4530-f364-32eb-89f6-88e87d18fef0",
                                        "glosses": [
                                            "The title (normally in a large and distinctive font) of a newspaper or other periodical at the top of the front page; (by extension) the publication itself or the rights to it."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2e71ac9-8593-448f-8c38-9fd9cfd30900",
                                                "sense_id": "ac9b7b33-c3f0-3d86-8ac3-602d58fce41d",
                                                "text": "Maree said she felt worse after articles were written about the video, including by this masthead."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd90827c-4563-368e-81b3-cc93072824b4",
                                        "entry_id": "0acf4530-f364-32eb-89f6-88e87d18fef0",
                                        "glosses": [
                                            "The logo of a broadcaster used in an ident."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "masthead",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "669664a5-09e2-34ff-bac2-21cde0a376ee",
                                        "entry_id": "5f2df56e-f602-3462-bb07-ee6c28edd106",
                                        "glosses": [
                                            "To send to the masthead as a punishment."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ef6953b-e368-4ade-b09f-ecd4102f9fa9",
                                                "sense_id": "669664a5-09e2-34ff-bac2-21cde0a376ee",
                                                "text": "“I was mast-headed, sir.”\n“Mast-headed! how - for what?”"
                                            },
                                            {
                                                "example_id": "4ecacf44-cde5-4381-adc1-39ff7b1dda22",
                                                "sense_id": "669664a5-09e2-34ff-bac2-21cde0a376ee",
                                                "text": "When the ship happened to be in a warm climate, mastheading constituted a fairly mild punishment; indeed, many regarded it as rather a relief from duty. But in inclement weather the experience was most unpleasant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c633883-6b5c-3788-9233-d43bde412dbe",
                                        "entry_id": "5f2df56e-f602-3462-bb07-ee6c28edd106",
                                        "glosses": [
                                            "To furnish (a newspaper) with a masthead."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4302044-f05a-4ce5-98d3-523736bc894b",
                                                "sense_id": "0c633883-6b5c-3788-9233-d43bde412dbe",
                                                "text": "It was mastheaded as \"Palatka's Only Independent Home-Owned Newspaper.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
