                ],
                "senses": [
                    {
                        "sense_id": "eb56c5a3-7927-3179-b954-a7f201980c0d",
                        "entry_id": "b404f43e-fd03-3770-a858-e7911c4d640c",
                        "glosses": [
                            "Décliner toute responsabilité, refuser toute intervention."
                        ],
                        "tags": [
                            "Par plaisanterie"
                        ],
                        "examples": [
                            {
                                "example_id": "6ee8bffe-b4d0-4a5b-81fa-8ea1ddc31456",
                                "sense_id": "eb56c5a3-7927-3179-b954-a7f201980c0d",
                                "text": "Quant à la différence de degré, elle ne se pose pas, car les autorités françaises poncepilatent sur le sort des expulsés."
                            },
                            {
                                "example_id": "f894c4e1-a424-482b-a4a1-7794e591ee3b",
                                "sense_id": "eb56c5a3-7927-3179-b954-a7f201980c0d",
                                "text": "Évidemment, tant que ça ne leur tombe pas rôti dans la bec, les journalistes n’enquêtent pas et les parquetiers s’en poncepilatent le coquillard..."
                            },
                            {
                                "example_id": "8e92bd5c-6d5b-4d80-b626-e67f324ed449",
                                "sense_id": "eb56c5a3-7927-3179-b954-a7f201980c0d",
                                "text": "Je m’en lave les pieds ! poncepilata Tarazousthra en trempant ses sandales dans une flaque d’eau."
                            }
                        ]
                    }
