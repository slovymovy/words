                "senses": [
                    {
                        "sense_id": "4a079f4e-5596-3b7e-accc-6e3bc04cd54c",
                        "entry_id": "5c52a29c-d9ab-39da-850c-87ce8fa1260f",
                        "glosses": [
                            "Rückschau auf das vorhergehende Halbjahr"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c01ec292-f1b1-44a8-8efb-41f2bf29aec7",
                                "sense_id": "4a079f4e-5596-3b7e-accc-6e3bc04cd54c",
                                "text": "„Neben dieser Arbeitsbesprechung am Wochenende kennt die Jena-Plan-Schule den Halbjahresrückblick, der von großer Außenwirkung ist.“"
                            },
                            {
                                "example_id": "0be4bff7-31ce-43b2-95e6-4ff9a4cde1b0",
                                "sense_id": "4a079f4e-5596-3b7e-accc-6e3bc04cd54c",
                                "text": "„Ein Halbjahresrückblick auf die Musik der Landeshauptstadt ergibt im ganzen ein erfreuliches Bild, erfreulich vor allem, weil neben dem Bewährtem auch das Neue steht und neben der Routine sich auch der Versuch voll behauptet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
