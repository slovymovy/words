                    },
                    {
                        "translation_id": "d4b1f750-202c-4b04-a41f-ce2f37fce976",
                        "source_entry_id": "719ce59c-11ad-3553-8f5e-1ec016eb5db8",
                        "source_sense_id": "71bab4e1-0817-335d-9b21-191dcec544b3",
