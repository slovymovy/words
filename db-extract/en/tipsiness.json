                "translations": [
                    {
                        "translation_id": "416d80ff-9c5a-4a8b-b61b-305128129cdc",
                        "source_entry_id": "4f1448e9-a672-33ca-953e-22f45b62881a",
                        "source_sense_id": "f5183f72-e36e-3184-9b8b-4e54dedaecde",
                        "source_sense_description": "the property of being tipsy",
                        "target_lang_word": "goguette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "goguette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "40f519e4-503e-3536-9ffe-0ae336c92dc7",
                                        "entry_id": "ef8e525e-34ec-30ae-83d9-7f972e89fd5c",
                                        "glosses": [
                                            "Joyeux festin où la liberté est de règle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b572376-c171-4e79-bdf4-51ff0de18f13",
                                                "sense_id": "40f519e4-503e-3536-9ffe-0ae336c92dc7",
                                                "text": "Par chaque fenêtre on apercevait des tablées de monde endimanché, et des cris sortaient des maisons en goguette."
                                            },
                                            {
                                                "example_id": "426b086a-77b9-4466-a61e-138d57b2ca5d",
                                                "sense_id": "40f519e4-503e-3536-9ffe-0ae336c92dc7",
                                                "text": "Certains caboulots, ici, ne ferment jamais réellement, et quelle que soit l’heure, vous apercevez toujours […] des noceurs, des gens en goguette."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e2cf444-cbbd-3812-8f8b-238c5a17bb6c",
                                        "entry_id": "ef8e525e-34ec-30ae-83d9-7f972e89fd5c",
                                        "glosses": [
                                            "Plaisanterie, propos joyeux, allant parfois jusqu’à être offensant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0ab08cf-6139-4edb-a6bb-df5d6384eae4",
                                                "sense_id": "0e2cf444-cbbd-3812-8f8b-238c5a17bb6c",
                                                "text": "Que de goguettes,\nQue d’amourettes !\nJamais de dettes,\nPoint de nœuds constants."
                                            },
                                            {
                                                "example_id": "885a438f-2f7f-4085-a657-8397f74af3b0",
                                                "sense_id": "0e2cf444-cbbd-3812-8f8b-238c5a17bb6c",
                                                "text": "La noce réveilla un peu les plaisantins. On en fit des goguettes. Puis on en fit moins."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e024ace-1c3b-310f-b309-7d51031e8b67",
                                        "entry_id": "ef8e525e-34ec-30ae-83d9-7f972e89fd5c",
                                        "glosses": [
                                            "Société chantante, sociétés organisant des soirées chantantes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5888cc62-5dab-443c-8ec4-c3f0e2a2122d",
                                                "sense_id": "5e024ace-1c3b-310f-b309-7d51031e8b67",
                                                "text": "La goguette a disparu presque tout à fait, et les jeunes ne se figurent pas ce qu’étaient ces réunions amicales des amateurs de la chanson."
                                            },
                                            {
                                                "example_id": "27f635e4-fdd1-4e7f-a8d9-ef97caeb9e0a",
                                                "sense_id": "5e024ace-1c3b-310f-b309-7d51031e8b67",
                                                "text": "Des goguettes nouvelles, nous n’en parlons pas, il y en a par centaines."
                                            },
                                            {
                                                "example_id": "b7120f32-08ec-4eda-8435-c4b79a2c4ff1",
                                                "sense_id": "5e024ace-1c3b-310f-b309-7d51031e8b67",
                                                "text": "C’était la légende, le troupier français parcourant le monde, entre sa belle et une bouteille de bon vin, la conquête de la terre faite en chantant des refrains de goguette."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce3989a8-150c-3a7c-8303-98ecae76b53e",
                                        "entry_id": "ef8e525e-34ec-30ae-83d9-7f972e89fd5c",
                                        "glosses": [
                                            "Cabaret où se réunit une société chantante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0007c811-b707-4996-9543-e44542f7a659",
                                                "sense_id": "ce3989a8-150c-3a7c-8303-98ecae76b53e",
                                                "text": "La blouse et la redingote s’asseyaient à la même table et l’on trinquait.\nLe dimanche, nous allions dans une goguette, la Lyre chansonnière ou les Enfants du Luth : je ne me rappelle plus bien."
                                            },
                                            {
                                                "example_id": "a2d60a9e-05de-4084-99cd-f656d812e09a",
                                                "sense_id": "ce3989a8-150c-3a7c-8303-98ecae76b53e",
                                                "text": "Et, vous le savez, ce ne sont point tant les paroles mâles que l’accent viril qui font peur à l’Empire. On me supprimerait tout aussi bien pour un article de vous sur la goguette de Romainville que pour un article d’un autre sur le gouvernement de M. Rouher."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b0171d71-6b6c-4b6b-8d63-29e8ce468c35",
                        "source_entry_id": "4f1448e9-a672-33ca-953e-22f45b62881a",
                        "source_sense_id": "f5183f72-e36e-3184-9b8b-4e54dedaecde",
                        "source_sense_description": "the property of being tipsy",
                        "target_lang_word": "griserie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "griserie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8a35a756-300e-3c4c-8234-4f12707a0c83",
                                        "entry_id": "8ffe9aec-374c-35db-8c96-e3fc1b26e103",
                                        "glosses": [
                                            "Action de se griser ou d'être grisé"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "556317af-b426-4131-b5dc-01277396a69b",
                                                "sense_id": "8a35a756-300e-3c4c-8234-4f12707a0c83",
                                                "text": "Il était encore sous le coup du grand enchantement, de la griserie intense de l'arrivée, et il s'y abandonnait voluptueusement."
                                            },
                                            {
                                                "example_id": "2bacc985-91a6-44b5-a241-61299b72b9eb",
                                                "sense_id": "8a35a756-300e-3c4c-8234-4f12707a0c83",
                                                "text": "La griserie libère un autre homme dans le buveur, elle délie une seconde nature qui n'entretient aucun rapport avec le tempérament premier."
                                            },
                                            {
                                                "example_id": "067d3b9e-0655-41d3-8ad5-529b177ed5be",
                                                "sense_id": "8a35a756-300e-3c4c-8234-4f12707a0c83",
                                                "text": "Pendant des années, j’ai bu comme tout le monde, au gré des soirées, des choses plus ou moins fortes, dans l’espoir d’atteindre la griserie qui aurait rendu l’existence acceptable : la gueule de bois a été mon principal résultat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
