                                "cs": "Musím si <w>na chvilku</w> odskočit do obchodu pro chleba.",
                                "tr": "Ekmek almak için <w>bir anlığına</w> markete gitmem gerekiyor.",
                                "es": "Tengo que ir <w>un momento</w> a la tienda a comprar pan.",
                                "zh": "我得<w>一会儿</w>去趟商店买面包。"
                            }
                        },
                        {
                            "text": "Wacht <w>eventjes</w> op mij bij de ingang van het park.",
                            "target_lang_translations": {
                                "en": "Wait <w>a moment</w> for me at the entrance of the park.",
                                "ru": "Подожди меня <w>минутку</w> у входа в парк.",
                                "pl": "Poczekaj <w>chwilkę</w> na mnie przy wejściu do parku.",
                                "de": "Warte <w>einen Moment</w> am Eingang des Parks auf mich.",
                                "fr": "Attends-moi <w>un moment</w> à l'entrée du parc.",
                                "it": "Aspettami <w>un momento</w> all'ingresso del parco.",
                                "cs": "Počkej na mě <w>na chvilku</w> u vchodu do parku.",
                                "tr": "Parkın girişinde beni <w>birazcık</w> bekle.",
                                "es": "Espérame <w>un ratito</w> en la entrada del parque.",
                                "zh": "在公园入口处<w>等我一会儿</w>。"
                            }
