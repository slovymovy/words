                ],
                "senses": [
                    {
                        "sense_id": "dbf134fe-0ae2-3bc4-8268-8cb3d93f4995",
                        "entry_id": "2cba9472-f029-3535-a10c-171ed108c0b7",
                        "glosses": [
                            "anhaltendes Schießen der Artillerie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d69528a6-dcea-4f3b-89d8-e111f770ff8a",
                                "sense_id": "dbf134fe-0ae2-3bc4-8268-8cb3d93f4995",
                                "text": "„Unterdessen war das Artilleriefeuer noch stärker geworden und dröhnte im Tal ununterbrochen.“"
                            },
                            {
                                "example_id": "f0539c9e-f1b3-4410-b070-2ab88eee6d64",
                                "sense_id": "dbf134fe-0ae2-3bc4-8268-8cb3d93f4995",
                                "text": "„Das Artilleriefeuer donnert wie ein aufziehendes Gewitter, vereinzelt knattern Maschinengewehre und singen Flugzeugmotoren dazwischen.“"
                            },
                            {
                                "example_id": "3efacbce-f4f8-4719-bbdc-2eb988c382f2",
                                "sense_id": "dbf134fe-0ae2-3bc4-8268-8cb3d93f4995",
                                "text": "„Als die Alliierten im Frühjahr 1945 hier den Rhein überquerten und Breisach von sich selbst und Deutschland und dem Führer befreiten, war die Stadt zu 85 Prozent durch Artilleriefeuer zerstört.“"
                            },
                            {
                                "example_id": "3ca7f777-f7f8-4322-b56b-1cf18e669d24",
                                "sense_id": "dbf134fe-0ae2-3bc4-8268-8cb3d93f4995",
                                "text": "„Am Morgen des 30. April riss schweres Artilleriefeuer die Bewohner des Führerbunkers aus dem Schlaf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
