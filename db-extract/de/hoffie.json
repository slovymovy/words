                "senses": [
                    {
                        "sense_id": "b29daa87-36f8-3bec-81ff-12740408ae0e",
                        "entry_id": "215bc04d-d666-362c-8dff-fc45d6639646",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3e97541-8c83-4e7f-8a1e-47f10afe5efb",
                                "sense_id": "b29daa87-36f8-3bec-81ff-12740408ae0e",
                                "text": "Frau Hoffie ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "bfe95bcf-7eba-47e0-b2eb-3235b7ca1718",
                                "sense_id": "b29daa87-36f8-3bec-81ff-12740408ae0e",
                                "text": "Herr Hoffie wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "af5cde2c-d27d-4f9e-8589-aec3507a913a",
                                "sense_id": "b29daa87-36f8-3bec-81ff-12740408ae0e",
                                "text": "Die Hoffies kommen heute aus dem Spessart."
                            },
                            {
                                "example_id": "2c015534-8f6a-4db0-9424-e22c385cabb2",
                                "sense_id": "b29daa87-36f8-3bec-81ff-12740408ae0e",
                                "text": "Der Hoffie trägt nie die Schals, die die Hoffie ihm strickt."
                            },
                            {
                                "example_id": "8003e713-4144-4813-8f7a-8cbdbb4cc85a",
                                "sense_id": "b29daa87-36f8-3bec-81ff-12740408ae0e",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hoffie kommt, geht der Herr Hoffie.“"
                            },
                            {
                                "example_id": "5992be4d-52a8-4f22-9d43-ab8d7555dd4c",
                                "sense_id": "b29daa87-36f8-3bec-81ff-12740408ae0e",
                                "text": "Hoffie kommt und geht."
                            },
                            {
                                "example_id": "579c5af1-0e28-4290-994f-8d1ed0513e06",
                                "sense_id": "b29daa87-36f8-3bec-81ff-12740408ae0e",
                                "text": "Hoffies kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
