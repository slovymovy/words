                                    {
                                        "sense_id": "11284e24-9f95-3ea9-bb02-2e667a6ea674",
                                        "entry_id": "5d8cc82d-d5a7-3431-8897-9dce9579f81a",
                                        "glosses": [
                                            "Leave, formal permission for some action, (originally and particularly)"
                                        ],
