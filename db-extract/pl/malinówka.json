                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "6949d87e-cb19-3b53-b5d2-128647f00337",
                        "entry_id": "8bcc7cee-c635-33ba-9903-4fd730182281",
                        "glosses": [
                            "jabłko koloru malinowoczerwonego, owoc malinówki (1.2)"
                        ],
                        "tags": [
                            "cuk."
                        ],
                        "examples": [
                            {
                                "example_id": "0e4ac8d5-a293-4d61-a6e2-194e12466781",
                                "sense_id": "6949d87e-cb19-3b53-b5d2-128647f00337",
                                "text": "Malinówki już dojrzały. Idź do sadu i zerwij trochę. Damy w prezencie Jadzi."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a00a9726-6ccb-4e75-962e-715c6c45b75e",
                        "source_entry_id": "8bcc7cee-c635-33ba-9903-4fd730182281",
                        "source_sense_id": "bd0ffe99-d51a-333d-ba46-b1cc57452f71",
                        "target_lang_word": "малиновка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "малиновка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "85888846-b303-360f-b208-2d2cd0ac8586",
                                        "entry_id": "f61a3188-3d77-3f81-b819-263e83d03ab3",
                                        "glosses": [
                                            "орнитол. небольшая перелётная светло-серая певчая птица семейства мухоловковых; лат. Erithacus rubecula"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "067eb968-776e-4ef6-9874-284eba38a8e5",
                                                "sense_id": "85888846-b303-360f-b208-2d2cd0ac8586",
                                                "text": "Слышу, малиновка где-то запела, за нею другая, // И раздалися в кустах голоса, будто праздник великий // Вольные птички встречали…"
                                            },
                                            {
                                                "example_id": "7f0b88ea-1b0f-470f-9b65-3be1f6d72d90",
                                                "sense_id": "85888846-b303-360f-b208-2d2cd0ac8586",
                                                "text": "Малиновки заслышав голосок, // Припомню я забытые свиданья, // В три жердочки берёзовый мосток // Над тихою речушкой без названья."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "малиновка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "1f946651-1714-35c8-894c-033303935216",
                                        "entry_id": "c91de325-437f-3cc9-b772-9ecbced1839d",
                                        "glosses": [
                                            "наливка, приготовленная из малины"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17d41141-03fe-4f12-a766-7366e24e0c65",
                                                "sense_id": "1f946651-1714-35c8-894c-033303935216",
                                                "text": "Тут были: ерофеич, перцовка, полыновка, малиновка, рябиновка и кабацкий ром, пахнущий сургучом."
                                            }
                                        ]
                                    }
                                ]
