                    },
                    {
                        "translation_id": "87b6e3fe-aea3-4851-bd67-660590aec51c",
                        "source_entry_id": "398ef421-cdef-3a6e-85ba-5d0911641e8c",
                        "source_sense_description": "характерные громкие звуки, издаваемые лошадьми",
                        "target_lang_word": "hennissement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hennissement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7a897b58-ff4b-3e7c-a373-318e920c54de",
                                        "entry_id": "9115ec49-ed00-38ee-927a-527902720ace",
                                        "glosses": [
                                            "Le cri particulier du cheval ou du zèbre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6c4e25c-ee2c-4481-a6a5-ec09ac82e941",
                                                "sense_id": "7a897b58-ff4b-3e7c-a373-318e920c54de",
                                                "text": "Étouffant dans mon burnous sur lequel le sable continuait de tomber en pluie, tenue éveillée par les hennissements de frayeur et les ruades de mon pauvre cheval attaché à un piquet […], je ne parvins plus à me rendormir."
                                            },
                                            {
                                                "example_id": "df3c09b9-b963-42f2-8a61-82a05bf5b38f",
                                                "sense_id": "7a897b58-ff4b-3e7c-a373-318e920c54de",
                                                "text": "Le rugissement des lions, le hennissement des chevaux, le braiement des ânes, le bêlement des béliers, le mugissement des taureaux, le grognement des cochons, des sangliers et des verrats, le raîment des cerfs, la voix grêle des gazelles, le murmure amoureux des rongeurs, les cris inarticulés des singes, les hautes clameurs des alouettes, le triste hurlement des hyènes, le glapissement des renards, le gromellement des blaireaux, &c. ; enfin tous ces accens divers dont résonnent les forêts et les déserts sauvages, ne sont dans les animaux que l’expression des desirs^([sic]) d’amour."
                                            },
                                            {
                                                "example_id": "58d12352-5ac7-42cf-be3e-ee61861cad35",
                                                "sense_id": "7a897b58-ff4b-3e7c-a373-318e920c54de",
                                                "text": "Pousser en avant ! répondit résolument doña Jesusita, en enfonçant les éperons dans le ventre de son cheval, qui poussa un hennissement de fureur et reprit sa course frénétique."
                                            },
                                            {
                                                "example_id": "d76eaccd-357f-4e58-b3d4-1aa75457df45",
                                                "sense_id": "7a897b58-ff4b-3e7c-a373-318e920c54de",
                                                "text": "Le samedi, particulièrement jour où de partout accourus, et des villages riverains du fleuve et des hameaux perchés à la crête des monts, les varlets de ferme affluent sur les places et dans les rues, aiguillonnant, ceux-ci, une paire de petits bœufs secs et nerveux, cinglant, ceux-là, une attelée de roussins pileux, et d’autres chassant devant eux, à coups de gaule, des bandes de porcelets, une rumeur inhabituelle, confondant ensemble les hennissements aigres des chevaux, les rauques rudissements des bourriquets, les abois des chiens, les meuglements des bêtes à cornes, le cacardement des oies, tout l’orchestre familier des écuries, des basses-cours et des étables s’élève jusque par delà les toits."
                                            },
                                            {
                                                "example_id": "214c1ef4-a27d-440a-b8ea-95fd76bbf83a",
                                                "sense_id": "7a897b58-ff4b-3e7c-a373-318e920c54de",
                                                "text": "Ses rues, dans le silence d’un lieu désert, attendent le claquement des volets, l’ouverture des portes, le hennissement des chevaux, l’essor d’une marmaille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33b66f79-528e-332b-8234-6ee73ab2fc32",
                                        "entry_id": "9115ec49-ed00-38ee-927a-527902720ace",
                                        "glosses": [
                                            "Bruit qui y ressemble."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6be0df1-b5d4-442a-945b-b139ee659d60",
                                                "sense_id": "33b66f79-528e-332b-8234-6ee73ab2fc32",
                                                "text": "Puis, d’immenses étendues de terrain se dessinaient à perte de vue, des jungles où ne manquaient ni les serpents ni les tigres qu’épouvantaient les hennissements du train […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
