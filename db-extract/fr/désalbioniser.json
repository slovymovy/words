                "senses": [
                    {
                        "sense_id": "d372d876-4b21-30b6-a0d4-e36b9f6841aa",
                        "entry_id": "5e43d6c3-7b11-3843-a8de-8f16fb29853e",
                        "glosses": [
                            "Faire perdre son caractère anglais à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0cb7433-eee5-42b0-8769-05860142786a",
                                "sense_id": "d372d876-4b21-30b6-a0d4-e36b9f6841aa",
                                "text": "Ce qu’un colonel pharaonique avait réussi par-delà les mers, c’est-à-dire l’union de l’Égypte désalbionisée et de la Syrie, pourquoi, lui, ne le ferait-il pas par delà des Alpes ?"
                            },
                            {
                                "example_id": "77d3d2f5-b985-4a26-9345-2f8cf309cba2",
                                "sense_id": "d372d876-4b21-30b6-a0d4-e36b9f6841aa",
                                "text": "Les hibs ont-ils décidé de désalbioniser la mf ?"
                            },
                            {
                                "example_id": "2a6e46fc-bbc2-4f63-add3-d9aeabc84830",
                                "sense_id": "d372d876-4b21-30b6-a0d4-e36b9f6841aa",
                                "text": "Des beautés de tous les pays, mais surtout des Anglaises, y viennent humblement consulter les oracles du goût et se désalbioniser."
                            }
                        ]
                    }
                ],
