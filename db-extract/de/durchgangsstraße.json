                "senses": [
                    {
                        "sense_id": "1ebed16a-9059-3878-bfac-4e262f824d1f",
                        "entry_id": "9ab99fc3-43b8-3679-933a-119c2282f34b",
                        "glosses": [
                            "Straße, die effektiv vom Ortseingang zum Ortsausgang führt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9799af24-1c12-42ee-a50c-d1840206aaf5",
                                "sense_id": "1ebed16a-9059-3878-bfac-4e262f824d1f",
                                "text": "„Tirau ist ursprünglich eine Farmerstadt, hat aber in den letzten Jahren begonnen, ihr Einkommen aus ihrer Lage an einer überregionalen Durchgangsstraße zu ziehen.“"
                            },
                            {
                                "example_id": "8b31e8e2-6607-4aa4-9c25-86d952bedca2",
                                "sense_id": "1ebed16a-9059-3878-bfac-4e262f824d1f",
                                "text": "„Ein greller, gelber Schein fiel von den Schaufenstern auf das Gedränge der Durchgangsstraße und tauchte die Passanten in ein gespenstisches, zitterndes Licht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
