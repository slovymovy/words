                    {
                        "translation_id": "ee3fd209-07e1-4135-b428-2b3c0d73938a",
                        "source_entry_id": "c680c494-9a74-3e67-b684-8ae9efa382b8",
                        "source_sense_description": "of or relating to etymology",
