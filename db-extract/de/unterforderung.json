                "senses": [
                    {
                        "sense_id": "aaca2b73-b0f8-378e-a070-d1f0e6d30fba",
                        "entry_id": "3b3ff598-2092-305b-a7bb-8596ae7f3449",
                        "glosses": [
                            "Zustand für eine Person, der zu einfache Aufgaben gestellt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e2d8ea7-b2a3-4422-99a4-7c8044a1234b",
                                "sense_id": "aaca2b73-b0f8-378e-a070-d1f0e6d30fba",
                                "text": "„Monotone Arbeiten werden als intellektuelle Unterforderung wahrgenommen.“"
                            },
                            {
                                "example_id": "63303a4d-5732-4ab8-8161-6ccdf990a645",
                                "sense_id": "aaca2b73-b0f8-378e-a070-d1f0e6d30fba",
                                "text": "„Eine dauerhafte Unterforderung setzt Kinder unter Stress, macht sie unzufrieden und unruhig.“"
                            },
                            {
                                "example_id": "84c3f514-b9cd-4e8c-8940-15c65075a189",
                                "sense_id": "aaca2b73-b0f8-378e-a070-d1f0e6d30fba",
                                "text": "„Eine dauernde Unterforderung und der daraus resultierende Mangel an Motivation kann zur kompletten Leistungsverweigerung führen.“"
                            },
                            {
                                "example_id": "49a74c87-80a6-4b4d-8ba3-6f06c8849a81",
                                "sense_id": "aaca2b73-b0f8-378e-a070-d1f0e6d30fba",
                                "text": "„Wenn die Hochbegabung nicht erkannt wird oder eine angemessene Förderung ausbleibt, kann es zur Unterforderung kommen, insbesondere in der Schule.“"
                            },
                            {
                                "example_id": "e84a762a-b452-45ab-80a4-ff16de5da21e",
                                "sense_id": "aaca2b73-b0f8-378e-a070-d1f0e6d30fba",
                                "text": "„Heute weiss man jedoch, dass diese Grenze von IQ 130 fliessend ist und in der Realität etwa 15 Prozent der Schulkinder an Unterforderung leiden.“"
                            },
                            {
                                "example_id": "10621e7c-6ac9-4d9e-95c9-45786b0b5c20",
                                "sense_id": "aaca2b73-b0f8-378e-a070-d1f0e6d30fba",
                                "text": "„In manchen Schulen gehören Wochenpläne mit unterschiedlichen Schwierigkeitsstufen zum Schulalltag, was für hochbegabte Kinder ein großer Gewinn sein kann, um Unterforderung und Langeweile zu vermeiden.“"
                            },
                            {
                                "example_id": "61dac88e-3b44-4247-afa8-d50b4f1ba530",
                                "sense_id": "aaca2b73-b0f8-378e-a070-d1f0e6d30fba",
                                "text": "„Viele hochbegabte Kinder können schlecht mit ihren Fähigkeiten umgehen. Sie haben soziale Probleme und kämpfen mit Unterforderung.“"
                            },
                            {
                                "example_id": "0667f1d3-c8e4-4717-96d9-54ce6955c1f0",
                                "sense_id": "aaca2b73-b0f8-378e-a070-d1f0e6d30fba",
                                "text": "„Unterforderung bei der Arbeit kann krank machen.“"
                            },
                            {
                                "example_id": "a6a0a653-9c40-46eb-97d1-351220d57095",
                                "sense_id": "aaca2b73-b0f8-378e-a070-d1f0e6d30fba",
                                "text": "„Langeweile und Unterforderung im Arbeitsalltag können genauso krankmachen wie Stress und Überlastung.“"
                            },
                            {
                                "example_id": "86c3f9d6-7c69-4bbf-9441-33ecf35a89b7",
                                "sense_id": "aaca2b73-b0f8-378e-a070-d1f0e6d30fba",
                                "text": "„Daher ist es wenig verwunderlich, wenn Menschen bei Unterforderung schnell zu ihrem Smartphone greifen, um sich abzulenken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
