                ],
                "senses": [
                    {
                        "sense_id": "bf397c25-8226-313c-9ad3-15a000ed0804",
                        "entry_id": "f2e93637-5db5-3d88-90bd-afe81fe771ed",
                        "glosses": [
                            "Gesamtheit der Personen, die auf dem Land wohnen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52d4aed1-6072-4664-8009-2f95c983b4f3",
                                "sense_id": "bf397c25-8226-313c-9ad3-15a000ed0804",
                                "text": "„Meistens handelt es sich bei diesen Leuten um Intelligenzler, Städter, aber mittlerweile hat diese Sitte auch die Landbevölkerung befallen.“"
                            },
                            {
                                "example_id": "c85d483a-668a-4fe6-9343-c73ff2a1f2cc",
                                "sense_id": "bf397c25-8226-313c-9ad3-15a000ed0804",
                                "text": "„Die Landbevölkerung betrügen sie durch Quacksalberei und Geldwechsel.“"
                            },
                            {
                                "example_id": "ddc6091a-f528-4873-915a-8e280cd6777d",
                                "sense_id": "bf397c25-8226-313c-9ad3-15a000ed0804",
                                "text": "„Er dachte an Gandhis Reaktion auf den Kommentar von Karl Marx zur Enteignung der Landbevölkerung.“"
                            },
                            {
                                "example_id": "bd93d9ae-4a3f-4a4f-a722-60ddb73fccf8",
                                "sense_id": "bf397c25-8226-313c-9ad3-15a000ed0804",
                                "text": "„Für ein paar Jahrzehnte wurde die Ausbeutung der Landbevölkerung noch schlimmer, als sie in nachhussitischer Zeit schon gewesen war.“"
                            },
                            {
                                "example_id": "b3f46d6f-3389-4885-9a37-508b05757a7e",
                                "sense_id": "bf397c25-8226-313c-9ad3-15a000ed0804",
                                "text": "„In den Folgejahren gab es immer wieder Fälle, bei denen Einzelpersonen vom Militär Land oder Pachtparzellen erhielten, ohne dass dabei die dort seit Generationen lebende Landbevölkerung berücksichtigt wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
