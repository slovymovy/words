                "senses": [
                    {
                        "sense_id": "b5075919-d33b-3f36-82a4-d488947ecbc2",
                        "entry_id": "b7c09c41-4c2d-3b76-968d-e2eaf50a656f",
                        "glosses": [
                            "kobieta cierpiąca na bulimię"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d152f488-9999-48c7-8081-9afc7a98e4fe",
                                "sense_id": "b5075919-d33b-3f36-82a4-d488947ecbc2",
                                "text": "Bulimiczka też żyje pod presją norm. Jedzenie jest dla niej formą słabości i ulegania. Jej choroba jest kompromisem między pragnieniem przyjemności („jedzenie jest takie dobre\") a obroną przed nim"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "651ee5e4-72bc-41f7-963b-98ede3f11e50",
                        "source_entry_id": "b7c09c41-4c2d-3b76-968d-e2eaf50a656f",
                        "source_sense_id": "b5075919-d33b-3f36-82a4-d488947ecbc2",
