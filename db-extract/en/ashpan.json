                        "sense_id": "22f73bed-0817-3353-8810-fd92b8fba438",
                        "entry_id": "48e6a059-e99f-3a77-ba5f-a840e3de1218",
                        "glosses": [
                            "A container beneath a boiler's furnace, catching ash and clinker that falls through the firebars"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "540c7cab-59b3-33a8-84d0-e78e9ff86702",
                        "entry_id": "48e6a059-e99f-3a77-ba5f-a840e3de1218",
                        "glosses": [
                            "A container that fits below the grate of a domestic fireplace."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "094993a9-6cd7-3ca8-9f7d-acbe163ac45d",
                        "entry_id": "48e6a059-e99f-3a77-ba5f-a840e3de1218",
                        "glosses": [
                            "A large pan below the grate and firebox of a steam locomotive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66618dea-ee64-4f9d-8992-cc7ab374ec6d",
                                "sense_id": "094993a9-6cd7-3ca8-9f7d-acbe163ac45d",
                                "text": "They have been fitted with a complete rocking grate and a hopper ashpan so that the ashes can be released without the necessity for a man to go underneath the engine."
                            },
                            {
                                "example_id": "4b64abdd-dffa-4f6c-a42e-b284282029d0",
                                "sense_id": "094993a9-6cd7-3ca8-9f7d-acbe163ac45d",
                                "text": "A new ashpan has been fitted, however, with four bottom doors for self-emptying, and a rocking grate with twelve rocking sections."
                            },
                            {
                                "example_id": "16666a89-7111-4db8-b8d3-ced417cd43e5",
                                "sense_id": "094993a9-6cd7-3ca8-9f7d-acbe163ac45d",
                                "text": "During the day conditions worsened quickly—for example, a 2-6-0 on the Uckfield line suddenly encountered flood water high enough to enter its ashpan and extinguish its fire—until lock gates up-river at Barcombe gave way and a tidal wave rolled down the valley meeting head-on a spring tide rolling up from the coast."
                            }
                        ]
                    }
                ],
