                ],
                "senses": [
                    {
                        "sense_id": "24a04c88-ce46-3769-9ae7-6b8bd1551afd",
                        "entry_id": "025391b8-cf5d-378d-b75a-49c394be9aaf",
                        "glosses": [
                            "Geschütz, das gegen angreifende Flugkörper eingesetzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7fefd74-937d-44a3-ae30-cbf631319ed0",
                                "sense_id": "24a04c88-ce46-3769-9ae7-6b8bd1551afd",
                                "text": "„Zwischen den Hecken hatte der Gegner mehrere 2-Zentimeter-Flakgeschütze aufgestellt, und ihre Läufe spucken weiße Wolken zu uns herauf.“"
                            },
                            {
                                "example_id": "526fb90d-82d2-43ec-851f-91dc9d860d45",
                                "sense_id": "24a04c88-ce46-3769-9ae7-6b8bd1551afd",
                                "text": "„Die Ermittler stießen auf ein ziemlich gut sortiertes Waffenlager: ein Torpedo, mehrere Handfeuerwaffen, ein Maschinengewehr, ein 8,8-Zentimeter-Flakgeschütz - und einen Wehrmachtspanzer, laut F.'s Anwalt Peter Gramsch das \"Herzstück der Sammlung\". Typ Panther, zwei Meter breit, fünf Meter lang, 43 Tonnen schwer.“"
                            },
                            {
                                "example_id": "b8ccdc44-7cd8-44df-9afe-6da39df93411",
                                "sense_id": "24a04c88-ce46-3769-9ae7-6b8bd1551afd",
                                "text": "„Nach Informationen der Deutschen Presse-Agentur befindet sich in dem Gebäude auch ein Flakgeschütz.“"
                            },
                            {
                                "example_id": "cf180893-8305-4f46-a830-338321540b98",
                                "sense_id": "24a04c88-ce46-3769-9ae7-6b8bd1551afd",
                                "text": "„Auf den als Schwalbennester bezeichneten Betonplattformen, von denen aus die Flakgeschütze Flieger abgeschossen hatten, sollten Breker-mäßige Riesenskulpturen über Wien schauen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
