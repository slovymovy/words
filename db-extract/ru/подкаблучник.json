                ],
                "translations": [
                    {
                        "translation_id": "2ae43c89-8a29-41cb-a319-ffadfebcc524",
                        "source_entry_id": "9247f0e6-3e03-359b-a65e-a5eb7ea300c4",
                        "source_sense_id": "d607f979-045d-366e-9d90-72eea0cda776",
                        "target_lang_word": "henpecked",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "henpecked",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e74099a3-a000-3b4f-8077-48f23d30898c",
                                        "entry_id": "078b50db-e55d-348a-8340-d416437fc3c2",
                                        "glosses": [
                                            "Intimidated or overwhelmed by a nagging or overbearing matriarch, wife, or girlfriend."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "091594af-8543-4a91-bb18-345019e99d27",
                                                "sense_id": "e74099a3-a000-3b4f-8077-48f23d30898c",
                                                "text": "\"I noticed that he addressed her as 'My dear,' very genially, without any trace of resentment.... The quickness of the transition made me vaguely ask myself whether he were henpecked,—a shocking conjecture, which I instantly dismissed.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bae7b3df-2f18-4d16-a7c3-9625e82171e0",
                        "source_entry_id": "9247f0e6-3e03-359b-a65e-a5eb7ea300c4",
                        "source_sense_id": "d607f979-045d-366e-9d90-72eea0cda776",
                        "target_lang_word": "someone who’s henpecked",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "335dd599-a32e-4617-be34-7806c763af7a",
                        "source_entry_id": "9247f0e6-3e03-359b-a65e-a5eb7ea300c4",
                        "source_sense_id": "d607f979-045d-366e-9d90-72eea0cda776",
                        "target_lang_word": "Pantoffelheld",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pantoffelheld",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6ad784d0-19ab-33b6-b178-fc534fd338a7",
                                        "entry_id": "a35d5496-1a20-3832-9c2d-e77f4abd1399",
                                        "glosses": [
                                            "Ehemann, der sich von seiner Ehefrau beherrschen lässt und im häuslichen Bereich keinerlei Einfluss ausüben kann"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory",
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17000746-5e27-4ee4-b049-a636e87172c7",
                                                "sense_id": "6ad784d0-19ab-33b6-b178-fc534fd338a7",
                                                "text": "Diese ausgelassenen Skatbrüder da drüben sind zu Hause bestimmt allesamt bloß Pantoffelhelden."
                                            },
                                            {
                                                "example_id": "df29239d-22d1-4991-b4ed-ae57d94b3998",
                                                "sense_id": "6ad784d0-19ab-33b6-b178-fc534fd338a7",
                                                "text": "„Der Draufgänger und Lebenskünstler wurde unter ihrer Fuchtel – und der ihrer Mutter – offenbar zum zahmen Pantoffelhelden.“"
                                            },
                                            {
                                                "example_id": "bd827a4d-7914-4f91-984a-995f962b35cf",
                                                "sense_id": "6ad784d0-19ab-33b6-b178-fc534fd338a7",
                                                "text": "„Luis war ihrem Urteil nach ein Pantoffelheld ohne Persönlichkeit, der in Carlota vernarrt gewesen war, und hinter dieser Hingabe verbarg er seine Unfähigkeit, sie zu befriedigen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc796791-d288-4692-b894-60fa5ce71e32",
                        "source_entry_id": "9247f0e6-3e03-359b-a65e-a5eb7ea300c4",
                        "source_sense_id": "d607f979-045d-366e-9d90-72eea0cda776",
                        "target_lang_word": "jemand, der unter dem Pantoffel steht",
