                "senses": [
                    {
                        "sense_id": "887fcdde-c4f8-3070-a37c-eb0fe99907ff",
                        "entry_id": "df12d5ab-dd95-3cab-8e6f-55bdcd59cbc4",
                        "glosses": [
                            "de planten die door de mens ergens zijn geplant of neergezet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cdf6a0ab-7557-4b50-acb1-ed9e6f34d630",
                                "sense_id": "887fcdde-c4f8-3070-a37c-eb0fe99907ff",
                                "text": "Tentje Psychiater Menno Oosterhoff (61) en leerkracht Dineke Linzel (51) wonen met hun kinderen Joël (16), Paulus (15) en Lasse (11) in „een holletje” op het Groningse platteland. Toen ze het huis in ’91 kochten was het „heel keurig”, wit en licht. Het eerste jaar woonde het stel in een tentje in de tuin „om te genieten van de vijver vol kikkers”. Nadat de tuin was beplant met „de halve flora van Nederland” moest het huis gezellig worden."
                            },
                            {
                                "example_id": "c88050a7-40a2-4bcd-b930-5d3364a498ce",
                                "sense_id": "887fcdde-c4f8-3070-a37c-eb0fe99907ff",
                                "text": "Portret van een Tuin is gewijd aan zeventiende-eeuwse moestuin op landgoed Dordwijk in de Dordtse kern Dubbeldam. Decennialang verkeerde die in geheel verwaarloosde staat, totdat Daan van der Have zich erover ontfermde. Hij besteedde twintig jaar aan de reconstructie, grondverbetering en de nieuwe beplanting ervan. Om dat levenswerk tot in perfectie uit te voeren, ontwikkelde de nu 65-jarige horecaondernemer (mede-oprichter van Hotel New York in Rotterdam en Villa Augustus in Dordrecht) zich gedurende die periode stukje bij beetje tot een allround-tuinder."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "89b2a543-d778-4e8a-93a0-63d2ddc146c2",
                        "source_entry_id": "df12d5ab-dd95-3cab-8e6f-55bdcd59cbc4",
                        "source_sense_id": "887fcdde-c4f8-3070-a37c-eb0fe99907ff",
                        "source_sense_description": "de planten die door de mens ergens zijn geplant of neergezet",
                        "target_lang_word": "vegetation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vegetation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "54a96443-d5dc-3730-bb9b-381dec904e4f",
                                        "entry_id": "7d1823dd-cb34-3003-8911-47d78c2259a0",
                                        "glosses": [
                                            "Plants, taken collectively."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80534228-f533-422e-81d0-f127c0277b91",
                                                "sense_id": "54a96443-d5dc-3730-bb9b-381dec904e4f",
                                                "text": "There were large amounts of vegetation in the forest."
                                            },
                                            {
                                                "example_id": "3dc21717-c23c-4f6e-b85f-5740e83944ba",
                                                "sense_id": "54a96443-d5dc-3730-bb9b-381dec904e4f",
                                                "text": "Thus the growth of vegetation, though effected in a greater or less degree by the strong wind, the violent rain, and the heat and glare of the noonday sun, is yet still more effectually promoted by the mild action of the gentler breezes, the softly descending dew, and the less intense heat."
                                            },
                                            {
                                                "example_id": "25ce5aa0-f94c-4f1d-94ac-151e49c93aea",
                                                "sense_id": "54a96443-d5dc-3730-bb9b-381dec904e4f",
                                                "text": "As soon as the faintest ray of light reaches a seedling, heliotropism will guide it through any crack in the soil, or through an entangled mass of overlying vegetation; […]"
                                            },
                                            {
                                                "example_id": "a9568ce0-e723-4826-b553-7c8e60e094d9",
                                                "sense_id": "54a96443-d5dc-3730-bb9b-381dec904e4f",
                                                "text": "Similarity of vegetation on meadows was the result of heavy grazing and trampling by large numbers of driveway sheep before the study was begun."
                                            },
                                            {
                                                "example_id": "2d1a025a-ffd2-462f-92b7-22719c8d9672",
                                                "sense_id": "54a96443-d5dc-3730-bb9b-381dec904e4f",
                                                "text": "As towns continue to grow, replanting vegetation has become a form of urban utopia and green roofs are spreading fast."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c70d8d1-8553-3025-a3bf-62937cb7ca3e",
                                        "entry_id": "7d1823dd-cb34-3003-8911-47d78c2259a0",
                                        "glosses": [
                                            "An abnormal verrucous or fibrinous growth"
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "657e2cf4-b871-3622-886d-17b95e4839f3",
                                        "entry_id": "7d1823dd-cb34-3003-8911-47d78c2259a0",
                                        "glosses": [
                                            "The act or process of vegetating, or growing as a plant does; vegetable growth."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b4b5d34e-7263-4118-b6bc-0e1ae35dd6fd",
                        "source_entry_id": "df12d5ab-dd95-3cab-8e6f-55bdcd59cbc4",
                        "source_sense_id": "887fcdde-c4f8-3070-a37c-eb0fe99907ff",
