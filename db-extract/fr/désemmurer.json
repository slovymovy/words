                ],
                "senses": [
                    {
                        "sense_id": "3dafbff8-c2b2-33c5-b9c6-4e173e22fb4e",
                        "entry_id": "f9cbb6c4-fc19-3b33-bd79-978235b79711",
                        "glosses": [
                            "Faire cesser d'être emmuré, libérer ce qui était emmuré."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5d6db0c-27cd-4199-92e4-8e27bd57aa20",
                                "sense_id": "3dafbff8-c2b2-33c5-b9c6-4e173e22fb4e",
                                "text": "Les Henrouille eux, n’en revenaient pas d’avoir passé à travers la vie rien que pour avoir une maison et comme des gens qu’on vient de désemmurer ça les étonnait."
                            },
                            {
                                "example_id": "37be4fe3-d616-4f15-8c08-00e5f2ffbf8d",
                                "sense_id": "3dafbff8-c2b2-33c5-b9c6-4e173e22fb4e",
                                "text": "Elles ne suffiraient pas à le désemmurer, si elles n’étaient suppléées par ses propres diligences."
                            },
                            {
                                "example_id": "1f92f5d7-9631-43ce-adc1-bc4e46817448",
                                "sense_id": "3dafbff8-c2b2-33c5-b9c6-4e173e22fb4e",
                                "text": "Cette vérité n’est, elle aussi, qu’une possibilité démentie par la réalité actuelle, mais qui pourrait se désemmurer moyennant la conscience des hommes."
                            }
                        ]
                    }
                ],
