                "senses": [
                    {
                        "sense_id": "05437d63-aba6-3fbd-b9cd-60917b9c3c0b",
                        "entry_id": "6deaff11-59d3-382b-9644-312254f9a523",
                        "glosses": [
                            "eine rote Rebsorte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89d487d0-64a7-4d0a-b713-ea9eff3c6ea0",
                                "sense_id": "05437d63-aba6-3fbd-b9cd-60917b9c3c0b",
                                "text": "Der Blaufränkisch ist ein richtiger „Mitteleuropäer“. Diese alte heimische Sorte ist eine Kreuzung aus der Blauen Zimmettraube und Weißer Heunisch."
                            },
                            {
                                "example_id": "39bba8f2-a072-46ef-9f94-b6a5978384aa",
                                "sense_id": "05437d63-aba6-3fbd-b9cd-60917b9c3c0b",
                                "text": "„Dieser Blaufränkisch der Brüder […] besticht durch die spitze Frucht, den angenehmen Gaumen und vor allem durch die reichlich Tannine im Abgang.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ce90cf16-5d4a-3e58-8df9-1f57f88de8c1",
                        "entry_id": "6deaff11-59d3-382b-9644-312254f9a523",
                        "glosses": [
                            "Wein aus Trauben der Rebsorte [1]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83ceb47a-7243-4d64-acf4-598cb070b548",
                                "sense_id": "ce90cf16-5d4a-3e58-8df9-1f57f88de8c1",
                                "text": "Es kommt regelmäßig vor, dass mir guter Wein ins Haus flattert. Aber unlängst stand sogar „Guter Blaufränkisch“ auf dem Etikett."
                            },
                            {
                                "example_id": "21eaa9f9-e910-41d5-8972-22195387a00e",
                                "sense_id": "ce90cf16-5d4a-3e58-8df9-1f57f88de8c1",
                                "text": "Man wird in Göttlesbrunn, Höflein und Arbesthal nämlich Wein kaufen wollen, vor allem roten – Zweigelt, Blaufränkisch, auch Cabernet Sauvignon."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
