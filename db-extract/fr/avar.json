            {
                "entry_id": "9a1deaa7-574f-3f72-a951-d49698aa6d9d",
                "word": "Avar",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3043166e-1400-4ad1-9493-16beb727ac56",
                        "entry_id": "9a1deaa7-574f-3f72-a951-d49698aa6d9d",
                        "tags": [
                            "plural"
                        ],
                        "form": "Avars"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "508d91eb-1bfd-370c-8d23-efe022ec95a0",
                        "entry_id": "9a1deaa7-574f-3f72-a951-d49698aa6d9d",
                        "glosses": [
                            "Personne du peuple originaire du Caucase."
                        ],
                        "tags": [
                            "Ethnonymie"
                        ],
                        "examples": [
                            {
                                "example_id": "0d204981-e128-4156-90cc-7540070a739f",
                                "sense_id": "508d91eb-1bfd-370c-8d23-efe022ec95a0",
                                "text": "On y dénombre au total plus de trois millions de personnes et les Daghestanais se présentent eux-mêmes comme la somme de ces populations. Les plus nombreux sont les Avars, viennent ensuite les Darguines, les Koumyks, les Lezghiens, les Russes, les Laks"
                            }
                        ]
                    },
                    {
                        "sense_id": "97896f16-be51-3a1e-b56c-42644fa801b0",
                        "entry_id": "9a1deaa7-574f-3f72-a951-d49698aa6d9d",
                        "glosses": [
                            "Membre d'un peuple turc de cavaliers nomades originaires de Mongolie, qui menaçait la Chine au IIIe siècle et qui se sont installés par la suite dans le Caucase."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "098fe92a-2270-4a7a-8853-6ec49693ca88",
                                "sense_id": "97896f16-be51-3a1e-b56c-42644fa801b0",
                                "text": "Les Avars réfugiés dans le Caucase ont constitué un État appelé aux XVIIe et XVIIIe siècles par les Ottomans, Avaristan."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8d6d5bd8-739f-4797-9ec4-242457fea6c6",
                        "source_entry_id": "9a1deaa7-574f-3f72-a951-d49698aa6d9d",
                        "target_lang_word": "Aware",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aware",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6086efcc-98ae-3b4a-9a10-b31ec8ad58cf",
                                        "entry_id": "5c5d0095-8b2e-3a0d-ab80-ba3d81c679e4",
                                        "glosses": [
                                            "Angehöriger eines ursprünglich aus Zentralasien stammenden, einflussreichen Volkes, das in Mittel- und Osteuropa siedelte"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0fc65b35-30a2-4125-806f-751c8488a9c1",
                                                "sense_id": "6086efcc-98ae-3b4a-9a10-b31ec8ad58cf",
                                                "text": "„Die Beute, die die fränkischen Heere im Reich der Awaren machten, war so groß, daß drei Transporte notwendig waren, um sie nach Aachen zu bringen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
