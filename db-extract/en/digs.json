            {
                "entry_id": "6303cf31-be24-396c-bd06-4c39a6e999d3",
                "word": "digs",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "dbaebbae-5299-3750-b791-fee2bfd4745f",
                        "entry_id": "6303cf31-be24-396c-bd06-4c39a6e999d3",
                        "glosses": [
                            "Lodgings; place of accommodation."
                        ],
                        "tags": [
                            "colloquial",
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "f19d6da8-0fe3-45b1-aa45-450f132d168b",
                                "sense_id": "dbaebbae-5299-3750-b791-fee2bfd4745f",
                                "text": "Corley at the first go-off was inclined to suspect it was something to do with Stephen being fired out of his digs for bringing in a bloody tart off the street."
                            },
                            {
                                "example_id": "1d4325e8-13ad-4fbf-b5f1-b77edef1b439",
                                "sense_id": "dbaebbae-5299-3750-b791-fee2bfd4745f",
                                "text": "Our new digs are at the corner of Market and Castro – a great and gay neighborhood that will be a pleasure to work in. The new office has room for four women to work comfortably, a tiny deck and back yard, and looks out on two trees."
                            }
                        ]
                    },
                    {
                        "sense_id": "38ee66dc-eb0b-3feb-b3b7-08ac9d3bb177",
                        "entry_id": "6303cf31-be24-396c-bd06-4c39a6e999d3",
                        "glosses": [
                            "Clothes."
                        ],
                        "tags": [
                            "colloquial",
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "b5fd35fb-ec48-4809-998c-0bddd2ab1df3",
                                "sense_id": "38ee66dc-eb0b-3feb-b3b7-08ac9d3bb177",
                                "text": "For example, when “army digs” are in, the Jocks wear them; when designer jeans are fashionable, those who can afford them wear them."
                            },
                            {
                                "example_id": "1c7ba58b-48ce-4caa-b753-aec1f5ba1687",
                                "sense_id": "38ee66dc-eb0b-3feb-b3b7-08ac9d3bb177",
                                "text": "I donned my new digs and found a trash can in which to dump my stinky old clothes."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
