                "senses": [
                    {
                        "sense_id": "cb385a4b-1afe-345b-b319-ac9f6709fc72",
                        "entry_id": "749589d4-63ef-3cdb-b38d-171dc07328f4",
                        "glosses": [
                            "Schuh, der für jemanden eigens nach seinen Körpermaßen gearbeitet wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9bc38fff-75f7-40ef-93ac-8fe3c9ac6fb8",
                                "sense_id": "cb385a4b-1afe-345b-b319-ac9f6709fc72",
                                "text": "„Mehr als 1000 Kunden hat er derzeit, 400 davon sind als Bezieher von Maßschuhen registriert.“"
                            },
                            {
                                "example_id": "9f135e55-db5b-407e-9e2e-41be1a9aed3c",
                                "sense_id": "cb385a4b-1afe-345b-b319-ac9f6709fc72",
                                "text": "„Oder über die vierzig Stunden und unzähligen Arbeitsschritte, die er in einen Maßschuh investiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
