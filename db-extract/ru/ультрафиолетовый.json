                ],
                "senses": [
                    {
                        "sense_id": "8668fb7b-b264-3828-9927-87c769e55f92",
                        "entry_id": "527c1d41-23f8-3616-abad-a30c7b413ba5",
                        "glosses": [
                            "относящийся к ультрафиолету, связанный с ним"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "458ec2b2-65ee-48f6-be32-6ced015fbf4e",
                                "sense_id": "8668fb7b-b264-3828-9927-87c769e55f92",
                                "text": "Источниками получения ультрафиолетовых лучей служат ртутная кварцевая лампа или искровой разрядник"
                            }
                        ]
                    },
                    {
                        "sense_id": "d5cd86d5-36d6-35b2-be24-753dd4f8768f",
                        "entry_id": "527c1d41-23f8-3616-abad-a30c7b413ba5",
                        "glosses": [
                            "физ. перен. относящийся к пределу бесконечно большой энергии"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9970e7e5-5d83-429b-b8d8-9f78669c540c",
                                "sense_id": "d5cd86d5-36d6-35b2-be24-753dd4f8768f",
                                "text": "Ультрафиолетовая расходимость в ведущем и следующем за ним порядках не допускает возможности перенормировки."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3e3f3568-4663-4680-94cb-af45ab78a46a",
                        "source_entry_id": "527c1d41-23f8-3616-abad-a30c7b413ba5",
                        "target_lang_word": "ultraviolet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ultraviolet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d879c0da-5643-37e7-ab32-b6562a697fcd",
                                        "entry_id": "f975b366-f393-3752-ac89-6c2867627185",
                                        "glosses": [
                                            "Of electromagnetic radiation beyond (higher in frequency than) light visible to the human eye; radiation with wavelengths from 380 to 10 nanometres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80d222e7-c087-45f7-91dc-3882a1ea1c48",
                                                "sense_id": "d879c0da-5643-37e7-ab32-b6562a697fcd",
                                                "text": "Micron said in a statement that it would bring extreme ultraviolet (EUV) technology to Japan, becoming the first semiconductor company to do so, and expected to invest up to 500 billion yen ($3.6 billion) with support from the Japanese government."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8edba317-4a3b-3a02-b39e-fa43d9b09402",
                                        "entry_id": "f975b366-f393-3752-ac89-6c2867627185",
                                        "glosses": [
                                            "Relating to very high energies or very small distances or time spans."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "156e0a7f-1a02-459d-a28f-33e8abaf208f",
                                                "sense_id": "8edba317-4a3b-3a02-b39e-fa43d9b09402",
                                                "text": "A one-loop Feynman graph that represents a virtual process. In the limit in which the virtual process involves short distances or high momenta, one may find an ultraviolet divergence in the corresponding amplitude."
                                            },
                                            {
                                                "example_id": "99d6ca49-1b0a-410b-be2b-cbfc1e0d1ca4",
                                                "sense_id": "8edba317-4a3b-3a02-b39e-fa43d9b09402",
                                                "text": "Some have advocated the search for a new theory of quantum gravity, a theory which does not suffer from ultraviolet infinity problems."
                                            },
                                            {
                                                "example_id": "47b251d2-2fd3-4520-8e04-8c1f003163f0",
                                                "sense_id": "8edba317-4a3b-3a02-b39e-fa43d9b09402",
                                                "text": "Since current gravitational observations are insensitive to quantum effects, one may wonder why an ultraviolet completion of the gravity theory is needed if inflation, in fact, occurs several orders of magnitude below the Planck scale."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ultraviolet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "46422cab-bab4-3c73-9b15-006727e7c461",
                                        "entry_id": "72d88ffd-e668-318b-8cd9-27bd0c2fd7e7",
                                        "glosses": [
                                            "Ultraviolet colour."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
