                    }
                ],
                "senses": [
                    {
                        "sense_id": "de30e1bd-be2e-3ffb-a523-f4f40b599de8",
                        "entry_id": "4ace6966-4318-3f0d-98a4-e68da1720a88",
                        "glosses": [
                            "Caractère d’une proposition, d’une action, d’un sentiment contraire à la logique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59f8dadf-6224-408c-bad3-8ac3983ba56f",
                                "sense_id": "de30e1bd-be2e-3ffb-a523-f4f40b599de8",
                                "text": "L’illogisme d’une argumentation, d’une conduite."
                            },
                            {
                                "example_id": "7cf6b630-571b-4e49-8404-802d29aabc43",
                                "sense_id": "de30e1bd-be2e-3ffb-a523-f4f40b599de8",
                                "text": "[…] c’est l’histoire du petit homme qui se baisse pour passer sous l’Arc de Triomphe : ici l’illogisme est accompagné d’une vanité également risible et rendue pleinement et instantanément sensible par l’évidence, qui nous apparaît immédiate et absolue."
                            },
                            {
                                "example_id": "d0645600-7dbe-44b8-9767-08b6bea796bb",
                                "sense_id": "de30e1bd-be2e-3ffb-a523-f4f40b599de8",
                                "text": "Avec cet illogisme qui n’est pas particulier à maman, qui est le fait de toutes les femmes, selon Donzac, elle protesta que c’était le tort que j’avais, et que mon devoir eût été de m’en mêler."
                            }
                        ]
                    }
                ],
