        "fr-extract.jsonl": [
            {
                "entry_id": "bcdc7578-2687-36a2-a44c-57a34801303c",
                "word": "labo",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6ca45571-a142-4abd-9326-e5d0a49602d6",
                        "entry_id": "bcdc7578-2687-36a2-a44c-57a34801303c",
                        "tags": [
                            "plural"
                        ],
                        "form": "labos"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a65b324d-454c-3427-8e50-a81292b50469",
                        "entry_id": "bcdc7578-2687-36a2-a44c-57a34801303c",
                        "glosses": [
                            "Laboratoire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f892e19-6515-4503-9108-d7f2d58ed42b",
                                "sense_id": "a65b324d-454c-3427-8e50-a81292b50469",
                                "text": "En fin d’après-midi, Quasar était de retour dans le labo de neurochimie."
                            },
                            {
                                "example_id": "1e954125-996f-4842-b10e-cf85cbb33c1a",
                                "sense_id": "a65b324d-454c-3427-8e50-a81292b50469",
                                "text": "Il a signé des accords avec plusieurs grosses pharmas, et mobilise pratiquement tous les moyens du labo pour eux… on ne fait plus que de la recherche à très court terme…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "452de1db-b646-499b-ab5c-fb3e08ec52a5",
                        "source_entry_id": "bcdc7578-2687-36a2-a44c-57a34801303c",
                        "source_sense_id": "a65b324d-454c-3427-8e50-a81292b50469",
                        "target_lang_word": "Labor",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Labor",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ef07f6f1-5ddc-3630-97db-32bf3c8de2af",
                                        "entry_id": "20f13d8c-79b8-30ca-bfcc-57b11d47e85c",
                                        "glosses": [
                                            "Räumlichkeit oder Einrichtung, in der wissenschaftliche, technische und medizinische Untersuchungen, Analysen und Versuche durchgeführt werden"
                                        ],
                                        "tags": [
                                            "Forschung",
                                            "Wissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54de3424-b3c5-4b7a-af42-c9b8fcf6eaa8",
                                                "sense_id": "ef07f6f1-5ddc-3630-97db-32bf3c8de2af",
                                                "text": "Die Arbeit im Labor war erfolgreich."
                                            },
                                            {
                                                "example_id": "ca60989b-5971-4b95-ae39-f0b309bdad0b",
                                                "sense_id": "ef07f6f1-5ddc-3630-97db-32bf3c8de2af",
                                                "text": "„Das Laboratorium ist kein modernes Labor aus Glas, mit Sauberkeit, Helle und Luft, es ist ein Spelunkenwinkel eines tüterigen Erfinders, der in einem Wust von Geräten, Ideen, Schutt und Schmutz ertrinkt.“"
                                            },
                                            {
                                                "example_id": "175e1019-5ff1-4292-aa60-d1f88e0dcc93",
                                                "sense_id": "ef07f6f1-5ddc-3630-97db-32bf3c8de2af",
                                                "text": "„Das Labor wurde zum Reinraum deklariert, der nur in kompletter Vermummung betreten werden durfte.“"
                                            },
                                            {
                                                "example_id": "fc1bfc6a-c446-4e3e-a77d-091e52749de9",
                                                "sense_id": "ef07f6f1-5ddc-3630-97db-32bf3c8de2af",
                                                "text": "„Thomas wanderte in die Küche zurück, um nach seinem Süppchen zu sehen, schnitt das Entenfleisch in Stücke und wanderte zurück ins Labor, um nach seinen Barren zu sehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "43e21563-44f8-44fd-9916-17a70923ca41",
                        "source_entry_id": "bcdc7578-2687-36a2-a44c-57a34801303c",
                        "source_sense_id": "a65b324d-454c-3427-8e50-a81292b50469",
                        "target_lang_word": "lab",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lab",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "94f931a7-1b30-385f-a480-a9e306bb8aac",
                                        "entry_id": "723f5586-d0e9-3cd0-a601-ab948ec8fb5f",
                                        "glosses": [
                                            "A laboratory."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd2a2749-e807-449a-a89d-aa1bb77955c2",
                                                "sense_id": "94f931a7-1b30-385f-a480-a9e306bb8aac",
                                                "text": "I was working in the lab late one night\nWhen my eyes beheld an eerie sight\nFor my monster, from his slab, began to rise\nAnd suddenly, to my surprise\nHe did the Mash\nHe did the Monster Mash."
                                            },
                                            {
                                                "example_id": "97edc03d-3d8e-44ac-80b7-93a9972814f9",
                                                "sense_id": "94f931a7-1b30-385f-a480-a9e306bb8aac",
                                                "text": "A man dressed as a lab tech, his blue scrubs startlingly pale against the vivid red and black chaos, moved into sight from behind the SUV. He carried an assault rifle."
                                            },
                                            {
                                                "example_id": "fdca92d6-1c6e-4bfb-84ba-8fbc3d321eb8",
                                                "sense_id": "94f931a7-1b30-385f-a480-a9e306bb8aac",
                                                "text": "The NIAID supports projects at universities and research organizations around the United States as well as a network of 21 NIAID labs across the country."
                                            },
                                            {
                                                "example_id": "f6fee6f0-c97e-4c4a-8f9e-56adac636e91",
                                                "sense_id": "94f931a7-1b30-385f-a480-a9e306bb8aac",
                                                "text": "Since the lab has been \"doged,\" a petition posted to Change.org by Evgeny Stambulchik asked for signatures to oppose the layoff of the NIST Atomic Spectroscopy Group and has garnered 2,500 signatures as of reporting time. There is also a campaign website."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6797c318-9ade-3d80-bd08-d544c2607137",
                                        "entry_id": "723f5586-d0e9-3cd0-a601-ab948ec8fb5f",
                                        "glosses": [
                                            "Laboratory experiment, test, investigation or result."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f5b1611-466c-4552-a8ae-646684958c18",
                                                "sense_id": "6797c318-9ade-3d80-bd08-d544c2607137",
                                                "text": "I dropped my mixture while doing my lab, so I had to start over."
                                            }
                                        ]
                                    }
                                ]
                            },
