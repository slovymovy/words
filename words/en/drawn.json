                {
                    "sense_id": "5cf46a62-fd9a-3095-b918-cafad4c59c61",
                    "sense_definition": "Pulled or moved by a specific source of power, usually used in combination words.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tourists enjoyed a ride through the city in a horse-<drawn> carriage.",
                            "target_lang_translations": {
                                "ru": "Туристы наслаждались поездкой по городу в экипаже, <запряженном> лошадьми.",
                                "pl": "Turyści cieszyli się przejażdżką po mieście powozem <konnym>.",
                                "es": "Los turistas disfrutaron de un paseo por la ciudad en un carruaje <tirado> por caballos."
                            }
                        },
                        {
                            "text": "Farmers used a tractor-<drawn> plow to prepare the large field for planting.",
                            "target_lang_translations": {
                                "ru": "Фермеры использовали плуг, <буксируемый> трактором, чтобы подготовить большое поле к посадке.",
                                "pl": "Rolnicy użyli pługa <ciągnionego> przez traktor, aby przygotować duże pole do siewu.",
                                "es": "Los agricultores usaron un arado <remolcado> por un tractor para preparar el campo grande para la siembra."
                            }
                        }
                    ],
                    "common_phrases": [
                        "horse-drawn",
                        "tractor-drawn"
                    ],
                    "target_lang_definitions": {
                        "ru": "Перемещаемый определенным источником тяги (обычно используется в составных словах).",
                        "pl": "Ciągnięty lub poruszany przez określone źródło mocy (zwykle w złożeniach).",
                        "es": "Que es movido o arrastrado por una fuente de energía específica, usado generalmente en palabras compuestas."
                    },
