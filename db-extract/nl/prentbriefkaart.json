                "senses": [
                    {
                        "sense_id": "001fb700-5e66-32ba-99ca-cdd926019225",
                        "entry_id": "c6f62209-a38c-3f0c-9515-b1512a24658f",
                        "glosses": [
                            "briefkaart waarbij aan één kant een foto of tekening staat en aan de andere zijde tekst en adres geschreven kan worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16ef76e0-59ac-4063-b2f2-ae3b3229f255",
                                "sense_id": "001fb700-5e66-32ba-99ca-cdd926019225",
                                "text": "Ik kreeg een prentbriefkaart met een foto van de Eiffeltoren van mijn vrienden, die in Parijs op vakantie zijn."
                            },
                            {
                                "example_id": "d7875e5f-ba9c-4960-a752-2c7b92b638d2",
                                "sense_id": "001fb700-5e66-32ba-99ca-cdd926019225",
                                "text": "Met een serie vrolijke prentbriefkaarten op de website EUMostWanted.eu probeert Europol achter de verblijfplaats te komen van Europa's gevaarlijkste voortvluchtige criminelen. De Europese politieorganisatie vraagt het publiek de briefkaarten zoveel mogelijk te delen om zo te achterhalen waar deze figuren zitten."
                            },
                            {
                                "example_id": "ee441d12-5083-4eb3-8362-d865bbd17fbe",
                                "sense_id": "001fb700-5e66-32ba-99ca-cdd926019225",
                                "text": "En als toetje spoorde Van Oldenborgh de prentbriefkaart op die Sirocko had gevonden met een ijzige Rijn - volgens Sirocko uit 1963, volgens Google uit 1929. Het bleek een souvenir uit die heuglijke winter: achterop stond de tekst dat het voor het eerst sinds 1895 was dat de Rijn weer kon worden overgestoken. Dat jaar komt niet voor in de lijst van Sirocko (1914 wel)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a591ace2-3f58-41c7-bca1-2b0f405ca61a",
                        "source_entry_id": "c6f62209-a38c-3f0c-9515-b1512a24658f",
                        "source_sense_id": "001fb700-5e66-32ba-99ca-cdd926019225",
                        "source_sense_description": "briefkaart waarbij aan één kant een foto of tekening staat en aan de andere zijde tekst en adres geschreven kunnen worden",
                        "target_lang_word": "Ansichtskarte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ansichtskarte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6650d9c3-386f-3ba4-a912-04c7a3de2978",
                                        "entry_id": "b731ff9e-ecdb-337c-9a38-8c121f67c4e1",
                                        "glosses": [
                                            "Postkarte mit der Abbildung eines Gebäudes, Ortes oder Ähnliches auf der Rückseite (Bildseite)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d98fe0d-b1fe-4e66-94c5-9fc0f91fa702",
                                                "sense_id": "6650d9c3-386f-3ba4-a912-04c7a3de2978",
                                                "text": "Schau, eine Ansichtskarte aus New York mit der Freiheitsstatue drauf!"
                                            },
                                            {
                                                "example_id": "6cf9da3c-6fe7-4274-a8d7-e9846a29d1e9",
                                                "sense_id": "6650d9c3-386f-3ba4-a912-04c7a3de2978",
                                                "text": "„Ich hatte weitere Ansichtskarten einstecken, damit sie sehen konnte, wie die jetzt kaputten Kirchen und Giebelhäuser früher ausgesehen hatten.“"
                                            },
                                            {
                                                "example_id": "c3d010c0-da7d-440f-9574-5665d1aa2272",
                                                "sense_id": "6650d9c3-386f-3ba4-a912-04c7a3de2978",
                                                "text": "„Oben in der Nähe der Brücke entdeckte ich einen Kiosk mit vielen Ansichtskarten von der Umgebung.“"
                                            },
                                            {
                                                "example_id": "476072b1-f46b-48a1-8f1a-ba108331dde4",
                                                "sense_id": "6650d9c3-386f-3ba4-a912-04c7a3de2978",
                                                "text": "„Nachhause schrieb ich eine Ansichtskarte mit dem Maschsee vornedrauf.“"
                                            },
                                            {
                                                "example_id": "829b5853-40e6-4edb-8646-9deaee470653",
                                                "sense_id": "6650d9c3-386f-3ba4-a912-04c7a3de2978",
                                                "text": "„Die Sammlung selbst umfaßt inzwischen mehr als 400 teils farbige Post- und Ansichtskarten des gesamten Eichsfeldes, von denen in diesem Bildband circa 130 auf Alt-Duderstadt bezogene Ansichtskarten veröffentlicht werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
