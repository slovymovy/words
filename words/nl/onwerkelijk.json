{
    "word_family": [
        "werkelijk",
        "werkelijkheid",
        "onwerkelijkheid"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3407be54-9000-3ab4-9007-040e568d224c",
                    "sense_definition": "Niet echt of bestaand; lijkend op een illusie of droom.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "onwerkelijk-illusie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het voelde heel <w>onwerkelijk</w> om na al die jaren weer terug te zijn in mijn geboortedorp.",
                            "target_lang_translations": {
                                "en": "It felt very <w>unreal</w> to be back in my native village after all those years."
                            }
                        },
                        {
                            "text": "De stilte in de verlaten stad gaf een <w>onwerkelijk</w> gevoel aan de wandeling.",
                            "target_lang_translations": {
                                "en": "The silence in the deserted city gave an <w>unreal</w> feeling to the walk."
                            }
                        }
                    ],
                    "synonyms": [
                        "irreëel",
                        "onecht"
                    ],
                    "antonyms": [
                        "werkelijk"
                    ],
                    "common_phrases": [
                        "een onwerkelijk gevoel",
                        "onwerkelijk mooi"
                    ],
                    "target_lang_definitions": {
                        "en": "Not real or existing; resembling an illusion or dream."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "unreal",
                                "target_lang_sense_clarification": "not real or substantial, dreamlike"
                            },
                            {
                                "target_lang_word": "illusory",
                                "target_lang_sense_clarification": "based on or producing an illusion"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0e45d1e2-0014-3709-bab0-800da4f64f9e",
                    "sense_definition": "Buitengewoon vreemd of dromerig, alsof het niet tot de realiteit behoort.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "onwerkelijk-illusie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kleuren van de zonsondergang boven de woestijn waren zo fel dat het bijna <w>onwerkelijk</w> leek.",
                            "target_lang_translations": {
                                "en": "The colors of the sunset over the desert were so bright that it seemed almost <w>surreal</w>."
                            }
                        },
                        {
                            "text": "Het was een <w>onwerkelijke</w> situatie toen iedereen plotseling stopte met praten.",
                            "target_lang_translations": {
                                "en": "It was a <w>surreal</w> situation when everyone suddenly stopped talking."
                            }
                        }
                    ],
                    "synonyms": [
                        "surreëel",
                        "surrealistisch"
                    ],
                    "common_phrases": [
                        "een onwerkelijke situatie"
                    ],
                    "target_lang_definitions": {
                        "en": "Extremely strange or dreamlike, as if not belonging to reality."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "surreal",
                                "target_lang_sense_clarification": "having the disorienting, hallucinatory quality of a dream"
                            },
                            {
                                "target_lang_word": "unreal",
                                "target_lang_sense_clarification": "incredibly strange or hard to believe"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e27f4c8a-a9f2-3eae-a1ef-0cce5408d3d0",
                    "sense_definition": "Slechts in de verbeelding bestaand; niet feitelijk gebeurd.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "onwerkelijk-illusie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn angst bleek achteraf gebaseerd te zijn op een volkomen <w>onwerkelijk</w> scenario.",
                            "target_lang_translations": {
                                "en": "In hindsight, his fear turned out to be based on a completely <w>unreal</w> scenario."
                            }
                        },
                        {
                            "text": "Zij beschreef een <w>onwerkelijke</w> wereld die ze zelf had bedacht voor haar nieuwe boek.",
                            "target_lang_translations": {
                                "en": "She described an <w>imaginary</w> world that she had made up herself for her new book."
                            }
                        }
                    ],
                    "synonyms": [
                        "irreëel"
                    ],
                    "antonyms": [
                        "werkelijk",
                        "waargebeurd"
                    ],
                    "common_phrases": [
                        "een onwerkelijk scenario"
                    ],
                    "target_lang_definitions": {
                        "en": "Existing only in the imagination; not having actually occurred."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "unreal",
                                "target_lang_sense_clarification": "imaginary, not existing in reality"
                            },
                            {
                                "target_lang_word": "imaginary",
                                "target_lang_sense_clarification": "existing only in the imagination"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}