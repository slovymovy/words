                    {
                        "sense_id": "b0cfe153-4613-3c6b-8bb1-0ff7e0ddcc3e",
                        "entry_id": "6f97bc31-4751-3b1f-b7e5-d6b51b41a315",
                        "glosses": [
                            "Devenu riche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fe7025a-18dc-4958-8c3f-37b014cda264",
                                "sense_id": "b0cfe153-4613-3c6b-8bb1-0ff7e0ddcc3e",
                                "text": "Charles de Bernage, spéculateur enrichi et futur candidat à la députation, n'avait jamais eu le temps de s'apercevoir qu'il lui manquait quelque chose."
                            }
                        ]
                    },
                    {
                        "sense_id": "f849f15e-17ff-3860-a963-879533040229",
                        "entry_id": "6f97bc31-4751-3b1f-b7e5-d6b51b41a315",
                        "glosses": [
                            "Dont la valeur a été augmentée."
