                "senses": [
                    {
                        "sense_id": "015200b7-e977-3b05-b4c9-f8a6bdcbe470",
                        "entry_id": "4271d2f2-855b-37a3-99dc-d68a039b71e6",
                        "glosses": [
                            "Consideration of past times."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "100fc49c-d6b1-4d6d-922f-18105c21b2ae",
                                "sense_id": "015200b7-e977-3b05-b4c9-f8a6bdcbe470",
                                "text": "My mind, calmer and stronger now than last night, made for itself some imperious rules, prohibiting under deadly penalties all weak retrospect of happiness past; commanding a patient journeying through the wilderness of the present..."
                            },
                            {
                                "example_id": "fae6ae5c-1ab4-468e-b474-479fdc350ae5",
                                "sense_id": "015200b7-e977-3b05-b4c9-f8a6bdcbe470",
                                "text": "Whether, like Colin, in retrospect Willie Lee and Baptist would feel that what has vanished was greater than what was achieved, is not something we can predict."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f38491b2-1d87-4a38-af75-03a04acb81e4",
                        "source_entry_id": "4271d2f2-855b-37a3-99dc-d68a039b71e6",
                        "source_sense_id": "015200b7-e977-3b05-b4c9-f8a6bdcbe470",
                        "source_sense_description": "consideration of past times",
                        "target_lang_word": "rétrospection",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rétrospection",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c0c74eb0-dda5-3ffe-8df8-26f193d433e2",
                                        "entry_id": "0849d0f9-2a2f-3c9c-8a84-84f2a1a886ca",
                                        "glosses": [
                                            "Action de regarder en arrière, dans le passé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b82accc-c1e0-4b45-9cbc-58a606f65e79",
                                                "sense_id": "c0c74eb0-dda5-3ffe-8df8-26f193d433e2",
                                                "text": "- Si vous aviez échoué dans l’édition, que feriez-vous aujourd’hui ?\n- Je ne me pose jamais ce genre de question. Je suis dans l’action, et non pas dans la rétrospection."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "00bb9363-9961-4de6-a042-7eb31ed09732",
