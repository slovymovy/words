                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "serviette de plage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "87439d15-c954-34dd-982d-951512cc0b2b",
                                        "entry_id": "54b95920-5d91-302f-84ef-36a27075d2b3",
                                        "glosses": [
                                            "Grand drap de bain que l’on pose sur le sable ou les galets de la plage pour s’y étendre, et s’essuyer après la baignade."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13f14726-6c24-4117-9713-e5b983113f7e",
                                                "sense_id": "87439d15-c954-34dd-982d-951512cc0b2b",
                                                "text": "On récupère une serviette de plage, son peignoir, ce qu’elle aura laissé ostensiblement au bord de l’eau."
                                            },
                                            {
                                                "example_id": "d61f3dc7-d2d7-480b-aeb9-cd654e2c6206",
                                                "sense_id": "87439d15-c954-34dd-982d-951512cc0b2b",
                                                "text": "Assise sur sa serviette de plage, Mado, jeune femme épanouie, détaille avec sévérité son corps potelé, dont un minuscule maillot de bain dissimule mal les rondeurs."
                                            },
                                            {
                                                "example_id": "7ea02645-1513-4dcd-a47c-9c33c33620c1",
                                                "sense_id": "87439d15-c954-34dd-982d-951512cc0b2b",
                                                "text": "Il a fini de me mettre de la crème. Il s’essuie les mains, s’allonge. La façon qu’il a d’appuyer la joue contre sa serviette de plage…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
