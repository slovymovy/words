                                        "entry_id": "96ae0edb-8fd5-3824-a036-99fd10fd022c",
                                        "glosses": [
                                            "Commonwealth standard spelling of pedophile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
