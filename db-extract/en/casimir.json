                                            {
                                                "example_id": "4d1bfe8c-4c37-465d-b51b-6f81bbee6a4f",
                                                "sense_id": "c7e3fc2d-e0ff-3bbe-a877-db0e3a0ed7e2",
                                                "text": "Au croisement de la route de Forcalquier, je rencontre l’équipe à Casimir qui revenait de Niozelles, sa louée finie et, ça, c’est des choses qui s’arrosent."
                                            },
                                            {
                                                "example_id": "53cd6786-1188-4b65-896f-84d6592f7cce",
                                                "sense_id": "c7e3fc2d-e0ff-3bbe-a877-db0e3a0ed7e2",
                                                "text": "Elle hériterait sûrement de ses huit cents hectares, ou plutôt ce serait son fils Casimir qui hériterait, puisqu’elle était sous la dépendance de cette brute qui n’avait jamais rien fait que de chasser la palombe en octobre, pour le compte du vieux de Lassus."
                                            }
                                        ]
                                    }
                                ]
                            }
