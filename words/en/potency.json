{
    "word_family": [
        "potent",
        "potential",
        "potentiality",
        "impotent",
        "impotence",
        "omnipotent",
        "omnipotence"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c884d05f-253c-3e96-85c4-f8f9eb449258",
                    "sense_definition": "The strength, effectiveness, or concentration of something such as a medicine, drug, or chemical.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "strength_and_capacity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The medicine loses its <w>potency</w> if it is stored in direct sunlight.",
                            "target_lang_translations": {
                                "zh": "如果存放在阳光直射的地方，这种药会丧失<w>药效</w>。"
                            }
                        },
                        {
                            "text": "Scientists tested the <w>potency</w> of the new vaccine against several variants.",
                            "target_lang_translations": {
                                "zh": "科学家测试了这种新疫苗针对几种变异株的<w>效力</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "strength",
                        "effectiveness",
                        "efficacy"
                    ],
                    "common_phrases": [
                        "full potency",
                        "loss of potency"
                    ],
                    "target_lang_definitions": {
                        "zh": "（药物、毒药或化学物质等的）效力，药效，效能"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "效力",
                                "target_lang_sense_clarification": "指药品、毒药或化学品产生的有效作用与强度"
                            },
                            {
                                "target_lang_word": "药效",
                                "target_lang_sense_clarification": "专指药物的作用或有效程度"
                            },
                            {
                                "target_lang_word": "效能",
                                "target_lang_sense_clarification": "事物的效率、功用或化学浓度强度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bb6cc9a6-c2be-3cc1-99ef-e97e24d5266d",
                    "sense_definition": "Power, influence, or authority, especially the power to affect thoughts or actions.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "strength_and_capacity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The political speech had tremendous emotional <w>potency</w> and moved the crowd.",
                            "target_lang_translations": {
                                "zh": "那场政治演讲具有巨大的情感<w>感染力</w>，打动了现场的群众。"
                            }
                        },
                        {
                            "text": "Even after many centuries, the ancient symbol retained its symbolic <w>potency</w>.",
                            "target_lang_translations": {
                                "zh": "历经数个世纪，这一古老符号依然保留着其象征性的<w>力量</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "power",
                        "might",
                        "force"
                    ],
                    "target_lang_definitions": {
                        "zh": "力量，影响力，感染力"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "力量",
                                "target_lang_sense_clarification": "思想、话语或象征等拥有的影响或推动能力"
                            },
                            {
                                "target_lang_word": "影响力",
                                "target_lang_sense_clarification": "左右或促成他人思想、行为的能力"
                            },
                            {
                                "target_lang_word": "感染力",
                                "target_lang_sense_clarification": "指情感或表达打动人心的力量"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "da4d97fc-7aef-376a-b8e1-240b89d921a0",
                    "sense_definition": "A person's sexual virility, specifically the physiological ability to achieve an erection or sexual orgasm.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sexual_virility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient was concerned that the prescribed medication might impair his sexual <w>potency</w>.",
                            "target_lang_translations": {
                                "zh": "患者担心所开的处方药可能会损害他的<w>性能力</w>。"
                            }
                        },
                        {
                            "text": "Ancient remedies often claimed to restore youthful <w>potency</w> in older men.",
                            "target_lang_translations": {
                                "zh": "古代补方常声称能让年长男子恢复年轻时的<w>性能力</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "virility"
                    ],
                    "antonyms": [
                        "impotence"
                    ],
                    "common_phrases": [
                        "sexual potency"
                    ],
                    "target_lang_definitions": {
                        "zh": "（男性的）性能力，勃起能力"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "性能力",
                                "target_lang_sense_clarification": "指生理上的勃起或进行性行为的能力"
                            },
                            {
                                "target_lang_word": "生殖能力",
                                "target_lang_sense_clarification": "指生育与繁衍的能力"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4d4476db-ed3b-3894-84f7-0b7a8a47badb",
                    "sense_definition": "The ability or potential capacity to perform an action or develop in a particular way.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "strength_and_capacity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The philosopher discussed the <w>potency</w> of the human mind to generate new ideas.",
                            "target_lang_translations": {
                                "zh": "哲学家探讨了人类大脑产生新想法的<w>潜能</w>。"
                            }
                        },
                        {
                            "text": "Stem cells have the inherent <w>potency</w> to develop into various specialized tissue types.",
                            "target_lang_translations": {
                                "zh": "干细胞具有分化为各种特化组织类型的固有<w>潜能</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "potentiality",
                        "capacity"
                    ],
                    "target_lang_definitions": {
                        "zh": "潜能，潜能性，分化潜能"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "潜能",
                                "target_lang_sense_clarification": "潜在的能力或发展可能性"
                            },
                            {
                                "target_lang_word": "潜能性",
                                "target_lang_sense_clarification": "发展、成为某种事物的潜在属性"
                            },
                            {
                                "target_lang_word": "分化潜能",
                                "target_lang_sense_clarification": "生物学中指干细胞等分化形成不同细胞类型的能力"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "87f1b7cf-d3d5-39bf-af6a-bf72a400626c",
                    "sense_definition": "The cardinality or size of a set.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Two sets are considered equivalent if they share the same <w>potency</w>.",
                            "target_lang_translations": {
                                "zh": "如果两个集合具有相同的<w>势</w>，则认为它们是等价的。"
                            }
                        },
                        {
                            "text": "In set theory, mathematicians study the <w>potency</w> of different infinite collections.",
                            "target_lang_translations": {
                                "zh": "在集合论中，数学家研究不同无穷集合的<w>基数</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cardinality"
                    ],
                    "target_lang_definitions": {
                        "zh": "【数学】集合的基数，势"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "势",
                                "target_lang_sense_clarification": "集合论中表示集合大小或元素数量的基数"
                            },
                            {
                                "target_lang_word": "基数",
                                "target_lang_sense_clarification": "刻画集合元素多少的概念"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}