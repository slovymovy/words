                "senses": [
                    {
                        "sense_id": "fd29f0a8-4943-361d-b007-c7e4b745a22b",
                        "entry_id": "df5d24e7-5aec-3a2c-9622-b38b6153c260",
                        "glosses": [
                            "Libérer (quelqu’un) de son endoctrinement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ec09001-403d-4c70-824e-df42039973a0",
                                "sense_id": "fd29f0a8-4943-361d-b007-c7e4b745a22b",
                                "text": "L’accompagner dans un premier temps pour l’obliger à faire ce qu’il voudrait éviter et le solliciter progressivement à faire tout seul est une bonne façon de le désendoctriner de ses peurs irrationnelles."
                            },
                            {
                                "example_id": "e20abc5f-4141-4449-828a-f28cae64e48b",
                                "sense_id": "fd29f0a8-4943-361d-b007-c7e4b745a22b",
                                "text": "L’idéal serait que les enfants sud-soudanais fréquentent, avec d’autres enfants, une école laïque, sans être inféodé à une obédience quelconque, qu’elle soit protestante, catholique, ou coranique, ceci afin de les désendoctriner !"
                            }
                        ]
                    }
