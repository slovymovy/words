                    {
                        "translation_id": "61c6f61d-5230-4645-9745-9f996fcd62c1",
                        "source_entry_id": "646ed005-c6a4-38f1-8f8f-9a516affc39a",
                        "source_sense_id": "c8a3652c-7553-3249-8972-11ba693ea169",
                        "source_sense_description": "Währungseinheit in verschiedenen, meist arabischsprachigen Ländern",
