                                        "entry_id": "a169214b-10af-3c9e-8085-f4b34f92c6d1",
                                        "glosses": [
                                            "Issue aménagée pour une évacuation rapide en cas d’urgence, telle qu’un incendie."
                                        ],
                                        "tags": [
                                            "Sécurité"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae47c1af-ec12-44fc-8b21-e2535d8ca551",
                                                "sense_id": "aa1d6722-b03f-3b96-a77b-03175b280886",
                                                "text": "J’ai marqué d’une croix la clôture de ta cour\nJe suis rentré chez moi par la sortie de secours\nJe me suis dis tout bas, non ce n’est pas mon jour\nSon cœur est un détroit, ses yeux un carrefour"
                                            }
