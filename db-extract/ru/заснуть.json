                ],
                "translations": [
                    {
                        "translation_id": "81a3beb3-cd71-49b3-99aa-3640887464cf",
                        "source_entry_id": "f655842c-14a4-3881-beb5-5378ad1a5e03",
                        "source_sense_id": "fc9caa5e-90e8-3c10-9deb-9c630b087546",
                        "target_lang_word": "fall asleep",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fall asleep",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8de53397-b402-34da-9747-b3e576e8f216",
                                        "entry_id": "ce1bc5c2-142a-30fe-b95f-9b4915c06578",
                                        "glosses": [
                                            "To pass from a state of wakefulness into sleep."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39785160-66b6-4f90-b20b-30eac0a86c44",
                                                "sense_id": "8de53397-b402-34da-9747-b3e576e8f216",
                                                "text": "She wakened in sharp panic, bewildered by the grotesquerie of some half-remembered dream in contrast with the harshness of inclement fact, drowsily realizing that since she had fallen asleep it had come on to rain smartly out of a shrouded sky."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6846a1e-0f3c-3a5c-ab65-63d9bcad0f54",
                                        "entry_id": "ce1bc5c2-142a-30fe-b95f-9b4915c06578",
                                        "glosses": [
                                            "To be affected by paresthesia; to go numb."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e4bf3c5-1bcd-4f24-ada3-8aeffe7fa553",
                                                "sense_id": "e6846a1e-0f3c-3a5c-ab65-63d9bcad0f54",
                                                "text": "My left leg has fallen asleep!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fff85ea3-0756-3ebe-bb90-f20b54342b3d",
                                        "entry_id": "ce1bc5c2-142a-30fe-b95f-9b4915c06578",
                                        "glosses": [
                                            "To die (often seen on gravestones)."
                                        ],
                                        "tags": [
                                            "euphemistic",
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8f3e23c-f5de-4590-be96-630838b2ab25",
                                                "sense_id": "fff85ea3-0756-3ebe-bb90-f20b54342b3d",
                                                "text": "And he kneeled downe, and cried with a loud voice, Lord lay not this sinne to their charge. And when he had said this, he fell asleepe. And Saul was consenting vnto his death."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ed01ac1e-46b8-42dc-9e6e-a06c63422ffa",
                        "source_entry_id": "f655842c-14a4-3881-beb5-5378ad1a5e03",
                        "source_sense_id": "fc9caa5e-90e8-3c10-9deb-9c630b087546",
                        "target_lang_word": "go to sleep",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "go to sleep",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a7222465-d3bf-3bbc-899d-ed388c10ced0",
                                        "entry_id": "b8241e77-8389-3214-8da3-68a47d8260c1",
                                        "glosses": [
                                            "To fall asleep."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd4f657a-1e38-4acf-85f6-cbf9777e8c30",
                                                "sense_id": "a7222465-d3bf-3bbc-899d-ed388c10ced0",
                                                "text": "I go to sleep at the same hour every night, no matter when I go to bed."
                                            },
                                            {
                                                "example_id": "d54f71ed-c7b0-4c4f-a8cc-802c8e3b205f",
                                                "sense_id": "a7222465-d3bf-3bbc-899d-ed388c10ced0",
                                                "text": "After this, with the disheartening failures after the Railway Mania, railway projection in east Cornwall went to sleep."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10d2ae35-7f48-3522-961c-1b5745918424",
                                        "entry_id": "b8241e77-8389-3214-8da3-68a47d8260c1",
                                        "glosses": [
                                            "To be affected by paresthesia; to go numb."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4dcf5355-d57d-416e-993b-3669c61ee73b",
                                                "sense_id": "10d2ae35-7f48-3522-961c-1b5745918424",
                                                "text": "My left leg has gone to sleep!"
                                            }
                                        ]
                                    },
                                    {
