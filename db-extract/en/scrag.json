                "senses": [
                    {
                        "sense_id": "b97ddb64-6a84-3bf9-a961-fac9b62bd2b5",
                        "entry_id": "48855ad0-5356-3435-b3e8-110e4c8a1128",
                        "glosses": [
                            "A thin or scrawny person or animal."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "4e0aed00-5615-40cf-a4d6-ca7d8f73c595",
                                "sense_id": "b97ddb64-6a84-3bf9-a961-fac9b62bd2b5",
                                "text": "In any event he might have wakened the long scrag by so doing."
                            }
                        ]
                    },
                    {
                        "sense_id": "0eda126b-afe9-3396-9652-44a37ec328d4",
                        "entry_id": "48855ad0-5356-3435-b3e8-110e4c8a1128",
                        "glosses": [
                            "The lean end of a neck of mutton; the scrag end."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "f8f69983-e64d-48cf-946f-f886047a233a",
                                "sense_id": "0eda126b-afe9-3396-9652-44a37ec328d4",
                                "text": "The butcher and the porkman painted up only the leanest scrags of meat; the baker, the coarsest of meagre loaves."
                            }
                        ]
                    },
                    {
                        "sense_id": "6b8b73a7-4cc3-3616-a357-7de7fe4107d3",
                        "entry_id": "48855ad0-5356-3435-b3e8-110e4c8a1128",
                        "glosses": [
                            "The neck, especially of a sheep."
                        ],
                        "tags": [
