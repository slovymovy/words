                "senses": [
                    {
                        "sense_id": "77283026-961d-3d34-88c4-ea982f9c1e30",
                        "entry_id": "ed715639-abb2-3016-9b77-6def0eb397d1",
                        "glosses": [
                            "Person, die die militärische Befehlsgewalt über einen Militärverband hat"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "c418f276-257e-4f74-ba53-aafcadf26521",
                                "sense_id": "77283026-961d-3d34-88c4-ea982f9c1e30",
                                "text": "„Die Vorgänge auf dem Kontinent wurden von den römischen Statthaltern und Militärbefehlshabern in Britannien aufmerksam registriert.“"
                            },
                            {
                                "example_id": "8fafa782-9c88-4766-84d6-1eda8d255f6a",
                                "sense_id": "77283026-961d-3d34-88c4-ea982f9c1e30",
                                "text": "„Weil er keinen geeigneten Nachfolger fand, beförderte Churchill kurzerhand den General Lord Wavell, der schon als Militärbefehlshaber vor Ort war, zum Vizekönig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8a1969b8-2a75-3797-87b0-c6b7959b0797",
                        "entry_id": "ed715639-abb2-3016-9b77-6def0eb397d1",
                        "glosses": [
                            "„hohe Dienststellung in von der Wehrmacht besetzten Ländern im Zweiten Weltkrieg“"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    },
