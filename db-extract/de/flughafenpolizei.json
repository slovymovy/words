                                        "examples": [
                                            {
                                                "example_id": "3fc194ad-bc70-4965-8cf1-b10293d7cf1a",
                                                "sense_id": "c0051b5c-2521-3955-861b-b62bbf6b67dc",
                                                "text": "Maar ik gaf niet op en na nieuwe brieven naar alle mogelijke instanties werd me uiteindelijk audiëntie verleend door de luchthavenpolitie en de luchthavenautoriteiten en kon ik de kwestie uitleggen."
                                            },
