                                        "glosses": [
                                            "The science, technique, or process used to make a classification."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ca9c64c-61ec-4ada-97f6-e9ed6ca04158",
                                                "sense_id": "a74d28bf-0f49-3dac-80f1-959172b41553",
                                                "text": "Holonym: ontology (relational rather than solely hierarchical)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1b5f9f3-6867-35cb-9ebe-e9aafc3ec39e",
                                        "entry_id": "feec3712-4fbc-34c6-9f67-b0a6923263a8",
                                        "glosses": [
                                            "A classification; especially, a classification in a hierarchical system."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "224c3e21-7ba0-4794-a310-f53a7ecb8624",
                                                "sense_id": "e1b5f9f3-6867-35cb-9ebe-e9aafc3ec39e",
                                                "text": "Very little exists in the annals of the interwebs about Tostitos Hint of Lime. Many nights I’ve sucked down crusty mossed fingertips and typed away in a green-out (like a blackout, but from eating too much Tostitos Hint of Lime), searching for a like-minded fanclub, historical taxonomy, or even a press release."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc909a9e-711b-3042-a72c-ec1fce0b9fe4",
                                        "entry_id": "feec3712-4fbc-34c6-9f67-b0a6923263a8",
                                        "glosses": [
                                            "The science of finding, describing, classifying and naming organisms."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "83682da8-3171-43a2-9ea6-216733843a8d",
                        "source_entry_id": "b43ca70c-638e-393f-9441-fce28338e02f",
