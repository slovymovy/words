                ],
                "translations": [
                    {
                        "translation_id": "50f58bec-61fa-42db-9cbc-49189ef5dfb0",
                        "source_entry_id": "92091a76-8059-3f10-99bf-8b43cc5204c2",
                        "source_sense_id": "9f435abb-638f-3c16-93ee-c1b6495dedb6",
                        "target_lang_word": "somewhere",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "somewhere",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b95e87a1-f78d-3e66-8c37-50d9e5330bb2",
                                        "entry_id": "86e5b850-9929-3dbd-9155-66a2df04b22c",
                                        "glosses": [
                                            "In an uncertain or unspecified location."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c09c7815-a34f-4211-b258-707700464130",
                                                "sense_id": "b95e87a1-f78d-3e66-8c37-50d9e5330bb2",
                                                "text": "I must have left my glasses somewhere."
                                            },
                                            {
                                                "example_id": "4f5493c3-bf64-4497-b89f-7bbf2a8f37ee",
                                                "sense_id": "b95e87a1-f78d-3e66-8c37-50d9e5330bb2",
                                                "text": "I've hidden candy somewhere in this room."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f7c7978-a05a-314f-b7d6-eed41f6a431f",
                                        "entry_id": "86e5b850-9929-3dbd-9155-66a2df04b22c",
                                        "glosses": [
                                            "To an uncertain or unspecified location."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88cf080b-c0c0-401c-93d3-4df937ba2e0d",
                                                "sense_id": "0f7c7978-a05a-314f-b7d6-eed41f6a431f",
                                                "text": "He plans to go somewhere warm for his vacation."
                                            },
                                            {
                                                "example_id": "31f42e79-251c-428c-ab3b-eb0693a71cc6",
                                                "sense_id": "0f7c7978-a05a-314f-b7d6-eed41f6a431f",
                                                "text": "I have to go somewhere at lunch. Can I meet you at 2?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23f969d1-68af-324b-87ce-f237d38dbcf3",
                                        "entry_id": "86e5b850-9929-3dbd-9155-66a2df04b22c",
                                        "glosses": [
                                            "At some unspecified point."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "593452c6-5a6e-4786-a00f-83b7861a20c7",
                                                "sense_id": "23f969d1-68af-324b-87ce-f237d38dbcf3",
                                                "text": "I don't remember the exact number, but it was somewhere between 200 and 300."
                                            },
                                            {
                                                "example_id": "7c8f23ac-1c44-4d6a-97db-1a62754046ba",
                                                "sense_id": "23f969d1-68af-324b-87ce-f237d38dbcf3",
                                                "text": "When a train has to ascend the incline, it first runs down, engine first, from the station about 60 or 70 yards. Then comes behind it the aforesaid truck, or one similar, which, being attached to an endless wire rope, a communication is made by means of the electric telegraph to the engineman at the top of the incline, when the fixed engine begins to work, and the train, partly pulled by the locomotive before, and partly pushed by the truck behind, rapidly ascends, taking somewhere about three minutes to get up."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "somewhere",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "894a65a8-5b8d-3597-9cb4-c1e8a34a1ef6",
                                        "entry_id": "b218b425-90eb-3f21-be78-81d033f5e6f5",
                                        "glosses": [
                                            "Unspecified or unknown (unlocated) place or location."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e82ba24-e5ba-4e1a-b2cc-78f77929a771",
                                                "sense_id": "894a65a8-5b8d-3597-9cb4-c1e8a34a1ef6",
                                                "text": "We have come from somewhere and we are going somewhere, but because life is an unending circle, we are again going to come from a somewhere, and we are again going to go to a somewhere, and this will go on, and on, and on."
                                            },
                                            {
                                                "example_id": "3437451b-da52-4422-b228-e788278abca0",
                                                "sense_id": "894a65a8-5b8d-3597-9cb4-c1e8a34a1ef6",
                                                "text": "A courting owl hoots in the somewheres of the night and another answers its call further off."
                                            },
                                            {
                                                "example_id": "3ad56f2d-0c4b-4d9a-a750-72a2ff4f611c",
                                                "sense_id": "894a65a8-5b8d-3597-9cb4-c1e8a34a1ef6",
                                                "text": "[…] and it transports the person to a somewhere, a somewhere that the music dictates."
                                            },
                                            {
                                                "example_id": "f48f350b-69e1-4ffa-b958-6f10fc80c7a2",
                                                "sense_id": "894a65a8-5b8d-3597-9cb4-c1e8a34a1ef6",
                                                "text": "This is essentialised place: a somewhere that is nowhere and yet everywhere."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0f6ada2-758d-3b40-9f56-55cdd009b0a0",
                                        "entry_id": "b218b425-90eb-3f21-be78-81d033f5e6f5",
                                        "glosses": [
                                            "A person with strong cultural or social ties to a specific place."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
