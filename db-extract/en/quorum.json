                "senses": [
                    {
                        "sense_id": "9cd81dc3-3608-327b-b01f-99d626dfd315",
                        "entry_id": "5ac0e327-3337-316d-9c62-85b5f7f8ce3e",
                        "glosses": [
                            "beschlussfähige Anzahl von Mitgliedern einer Gruppe oder Organisation"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21be8f90-0865-40f5-965d-49101e8178af",
                                "sense_id": "9cd81dc3-3608-327b-b01f-99d626dfd315",
                                "text": "The problem is this: Under the Constitution, each house of Congress requires a quorum of half its members to do any official business.",
                                "translation": "Das Problem ist dies: Auf Grund der Verfassung benötigt jedes Haus des Kongresses eine Mindestanzahl der Hälfte ihrer Mitglieder, um irgendeine dienstliche Angelegenheit zu erledigen."
                            },
                            {
                                "example_id": "abfc36b6-4fa6-446b-a69d-f424ce8775ca",
                                "sense_id": "9cd81dc3-3608-327b-b01f-99d626dfd315",
                                "text": "The proposal needed the backing from 30 percent of all investors, and the presence of one-third for a quorum.",
                                "translation": "Der Vorschlag bedurfte der Unterstützung von 30 Prozent aller Investoren und die Anwesenheit von einem Drittel für eine Beschlussfähigkeit."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8390a747-088d-392f-adc9-57d8eb69aae4",
                        "entry_id": "5ac0e327-3337-316d-9c62-85b5f7f8ce3e",
                        "glosses": [
                            "eine ausgewählte Gruppe von Personen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0a6d7ac-f292-4340-ac4d-fb6d3d5ddbb5",
                                "sense_id": "8390a747-088d-392f-adc9-57d8eb69aae4",
                                "text": "They are using the same resources as the Hummer owner and as said by more than one member of the quorum, individual efforts are at best symbolic.",
                                "translation": "Sie verwenden die gleichen Ressourcen wie der Eigentümer von Hummer und wie von mehr als einem Mitglied der Gruppe gesagt, sind individuelle Anstrengungen bestenfalls symbolisch."
