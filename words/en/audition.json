{
    "word_family": [
        "audible",
        "audience",
        "audit",
        "auditor",
        "auditorium",
        "auditory"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d4d304f7-0198-3f24-aa18-e628fab45d4a",
                    "sense_definition": "A short performance by an actor, singer, or musician to demonstrate their suitability for a role.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "performance_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was very nervous before her <w>audition</w> for the school play.",
                            "target_lang_translations": {
                                "ru": "Она очень нервничала перед своим <w>прослушиванием</w> для школьной пьесы.",
                                "tr": "Okul oyunu için yapılacak <w>seçme</w> öncesinde çok heyecanlıydı.",
                                "zh": "在参加学校话剧的<w>试镜</w>前，她非常紧张。"
                            }
                        },
                        {
                            "text": "The director decided to hold an <w>audition</w> to find the perfect actor.",
                            "target_lang_translations": {
                                "ru": "Режиссер решил провести <w>пробы</w>, чтобы найти идеального актера.",
                                "tr": "Yönetmen mükemmel oyuncuyu bulmak için bir <w>seçme</w> yapmaya karar verdi.",
                                "zh": "导演决定举行一场<w>试镜</w>来寻找完美的演员。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tryout",
                        "casting"
                    ],
                    "common_phrases": [
                        "go to an audition",
                        "hold an audition",
                        "pass an audition"
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткое выступление актера, певца или музыканта для демонстрации их пригодности на роль.",
                        "tr": "Bir oyuncu, şarkıcı veya müzisyenin bir role uygunluğunu göstermek için yaptığı kısa performans.",
                        "zh": "演员、歌手或音乐家为展示其是否适合某个角色而进行的简短表演。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прослушивание",
                                "target_lang_sense_clarification": "процесс демонстрации навыков (музыка, театр)"
                            },
                            {
                                "target_lang_word": "пробы",
                                "target_lang_sense_clarification": "тестирование актеров (кино, театр)"
                            },
                            {
                                "target_lang_word": "кастинг",
                                "target_lang_sense_clarification": "отбор исполнителей (современный термин)"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "seçme",
                                "target_lang_sense_clarification": "oyuncu veya müzisyen seçmeleri"
                            },
                            {
                                "target_lang_word": "audition",
                                "target_lang_sense_clarification": "sanat sektöründe deneme çekimi/seçmesi"
                            },
                            {
                                "target_lang_word": "deneme çekimi",
                                "target_lang_sense_clarification": "sinema ve tiyatroda oyuncu seçimi"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "试镜",
                                "target_lang_sense_clarification": "演员为争取角色进行的表演测试"
                            },
                            {
                                "target_lang_word": "试演",
                                "target_lang_sense_clarification": "表演者为展示能力进行的简短演出"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b884d2a5-42e5-3a35-a738-86693c8ad85a",
                    "sense_definition": "The power or faculty of hearing.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "hearing_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor performed a test to check the patient's <w>audition</w>.",
                            "target_lang_translations": {
                                "ru": "Врач провел тест, чтобы проверить <w>слух</w> пациента.",
                                "tr": "Doktor hastanın <w>işitme</w> yeteneğini kontrol etmek için bir test yaptı.",
                                "zh": "医生进行了一项测试以检查病人的<w>听力</w>。"
                            }
                        },
                        {
                            "text": "His <w>audition</w> was impaired after the loud explosion.",
                            "target_lang_translations": {
                                "ru": "Его <w>слух</w> ухудшился после громкого взрыва.",
                                "tr": "Yüksek patlamadan sonra onun <w>duyma</w> yetisi zarar gördü.",
                                "zh": "那声巨响过后，他的<w>听力</w>受损了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hearing"
                    ],
                    "antonyms": [
                        "deafness"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "standard meaning is now hearing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Способность или дар слышать.",
                        "tr": "İşitme gücü veya yeteneği.",
                        "zh": "听觉能力或听力。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слух",
                                "target_lang_sense_clarification": "физическая способность слышать"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "işitme",
                                "target_lang_sense_clarification": "duyma yeteneği"
                            },
                            {
                                "target_lang_word": "duyma",
                                "target_lang_sense_clarification": "sesleri algılama yeteneği"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "听力",
                                "target_lang_sense_clarification": "生理上的听觉功能"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "650ea33c-334b-3568-8a51-b69206c2b7f4",
                    "sense_definition": "The act of listening or being heard.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "hearing_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The speech was intended for <w>audition</w> by a large crowd.",
                            "target_lang_translations": {
                                "ru": "Речь предназначалась для <w>прослушивания</w> большой толпой.",
                                "tr": "Konuşma büyük bir kalabalığın <w>dinlemesi</w> için hazırlanmıştı.",
                                "zh": "这段演讲旨在让一大群人<w>聆听</w>。"
                            }
                        },
                        {
                            "text": "He spoke clearly to ensure the <w>audition</w> of his message.",
                            "target_lang_translations": {
                                "ru": "Он говорил четко, чтобы обеспечить <w>восприятие на слух</w> своего сообщения.",
                                "tr": "Mesajının net şekilde <w>işitilmesini</w> sağlamak için anlaşılır konuştu.",
                                "zh": "他说话很清晰，以确保他的信息能被<w>听见</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "literary usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт слушания или процесс восприятия на слух.",
                        "tr": "Dinleme veya duyulma eylemi.",
                        "zh": "倾听或被听到的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слушание",
                                "target_lang_sense_clarification": "процесс восприятия звуков"
                            },
                            {
                                "target_lang_word": "прослушивание",
                                "target_lang_sense_clarification": "действие по восприятию речи или звуков"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "dinleme",
                                "target_lang_sense_clarification": "kulak kabartma, işitme eylemi"
                            },
                            {
                                "target_lang_word": "işitilme",
                                "target_lang_sense_clarification": "sesin başkaları tarafından duyulması"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "聆听",
                                "target_lang_sense_clarification": "专注地听"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "72eb7f14-d368-3910-83a1-4888aaf7aa3f",
                    "sense_definition": "Something that is heard.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "hearing_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The strange sound was a disturbing <w>audition</w> in the night.",
                            "target_lang_translations": {
                                "ru": "Странный звук был тревожным <w>услышанным явлением</w> в ночи.",
                                "tr": "O garip ses, gecenin içinde rahatsız edici bir <w>duyuntu</w> idi.",
                                "zh": "那个奇怪的声响是夜里令人不安的<w>声音</w>。"
                            }
                        },
                        {
                            "text": "Every <w>audition</w> from the street below distracted him.",
                            "target_lang_translations": {
                                "ru": "Каждый <w>звук</w> с улицы внизу отвлекал его.",
                                "tr": "Aşağıdaki sokaktan gelen her <w>ses</w> onun dikkatini dağıtıyordu.",
                                "zh": "楼下街道传来的每一个<w>声音</w>都让他分心。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "rarely used"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "То, что слышится; звук.",
                        "tr": "Duyulan bir şey; ses.",
                        "zh": "被听到的声音。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "звук",
                                "target_lang_sense_clarification": "физическое явление"
                            },
                            {
                                "target_lang_word": "услышанное",
                                "target_lang_sense_clarification": "то, что было воспринято слухом"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ses",
                                "target_lang_sense_clarification": "duyulan algı veya gürültü"
                            },
                            {
                                "target_lang_word": "duyulan şey",
                                "target_lang_sense_clarification": "işitilen algı"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "声音",
                                "target_lang_sense_clarification": "听到的声响"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c6176005-3041-3361-8a75-bdb0f9cd3647",
                    "sense_definition": "To perform a short piece to show one's suitability for a role.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "performance_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I plan to <w>audition</w> for the lead role in the musical.",
                            "target_lang_translations": {
                                "ru": "Я планирую <w>пробоваться</w> на главную роль в мюзикле.",
                                "tr": "Müzikaldeki başrol için <w>seçmelere katılmayı</w> planlıyorum.",
                                "zh": "我计划为这部音乐剧的男主角去<w>试镜</w>。"
                            }
                        },
                        {
                            "text": "She decided to <w>audition</w> for the school choir.",
                            "target_lang_translations": {
                                "ru": "Она решила <w>пройти прослушивание</w> в школьный хор.",
                                "tr": "Okul korosunun <w>seçmelerine girmeye</w> karar verdi.",
                                "zh": "她决定去参加学校合唱团的<w>试镜</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "audition for a part",
                        "audition for a show"
                    ],
                    "target_lang_definitions": {
                        "ru": "Исполнять короткий номер, чтобы показать свою пригодность на роль.",
                        "tr": "Bir role uygunluğunu göstermek için kısa bir performans sergilemek, seçmelere katılmak.",
                        "zh": "通过表演简短片段来展示自己适合某个角色。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пробоваться",
                                "target_lang_sense_clarification": "проходить испытание на роль"
                            },
                            {
                                "target_lang_word": "проходить прослушивание",
                                "target_lang_sense_clarification": "участвовать в отборе"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "seçmelere katılmak",
                                "target_lang_sense_clarification": "bir rol için performans sergilemek"
                            },
                            {
                                "target_lang_word": "deneme çekimine girmek",
                                "target_lang_sense_clarification": "oyunculuk seçmelerine katılmak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "试镜",
                                "target_lang_sense_clarification": "参加角色选拔"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f17f8184-6a5b-3766-b6a7-03e05dc11479",
                    "sense_definition": "To evaluate a performer's skill for a specific role.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "performance_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to <w>audition</w> several dancers for the new video.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>прослушать</w> нескольких танцоров для нового видео.",
                                "tr": "Yeni video için birkaç dansçı <w>deneğimiz</w> gerekiyor.",
                                "zh": "我们需要为新视频<w>面试</w>几位舞者。"
                            }
                        },
                        {
                            "text": "The casting director will <w>audition</w> actors all day tomorrow.",
                            "target_lang_translations": {
                                "ru": "Кастинг-директор будет <w>прослушивать</w> актеров весь завтрашний день.",
                                "tr": "Kast direktörü yarın bütün gün oyuncular için <w>seçme yapacak</w>.",
                                "zh": "选角导演明天一整天都要<w>面试</w>演员。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "audition actors",
                        "audition for a role"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оценивать мастерство исполнителя для конкретной роли.",
                        "tr": "Belirli bir rol için bir sanatçının yeteneğini değerlendirmek, seçme yapmak.",
                        "zh": "评估表演者是否适合某个特定角色。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прослушивать",
                                "target_lang_sense_clarification": "оценивать кандидата на роль"
                            },
                            {
                                "target_lang_word": "проводить пробы",
                                "target_lang_sense_clarification": "организовывать отбор актеров"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "seçme yapmak",
                                "target_lang_sense_clarification": "adayları değerlendirmek"
                            },
                            {
                                "target_lang_word": "denemek",
                                "target_lang_sense_clarification": "oyuncunun yeteneğini sınamak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "面试",
                                "target_lang_sense_clarification": "对表演者进行选拔评估"
                            },
                            {
                                "target_lang_word": "选拔",
                                "target_lang_sense_clarification": "挑选合适的人选"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}