                                "target_word": "schubladisieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8c4bb80b-2822-37f8-9e42-52c79285cf54",
                                        "entry_id": "1b7082e3-e2f9-3104-8d48-42a0d2189a4e",
                                        "glosses": [
                                            "eine Sache nicht weiter betreiben; sich nicht mehr mit einer Sache beschäftigen"
                                        ],
                                        "tags": [
                                            "Austrian German",
                                            "Swiss Standard German",
                                            "humorous",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3ead2bb-89f1-4ec8-b31a-5adde45d00a8",
                                                "sense_id": "8c4bb80b-2822-37f8-9e42-52c79285cf54",
                                                "text": "„Ich schubladisiere meine Beschreibung und warte auf bessere Zeiten (neue Sammlung, bessere Beschreibung, Gebrauch von anderen Büchern, von Zeitschriften, usw.).“"
                                            },
                                            {
                                                "example_id": "16e7fa81-e058-4ca8-bd21-8bd4b4df89e1",
                                                "sense_id": "8c4bb80b-2822-37f8-9e42-52c79285cf54",
                                                "text": "„Deshalb so spät, da der Offizier seinen Akt schubladisiert gehabt hätte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
