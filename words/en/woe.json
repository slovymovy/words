{
    "word_family": [
        "woeful",
        "woebegone",
        "woefully"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5d25df93-14e0-3931-a4ab-3774bc8a10e0",
                    "sense_definition": "Great sadness, distress, or misery.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "sadness_and_trouble",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old man's face was a picture of <w>woe</w> as he spoke of his lost home.",
                            "target_lang_translations": {
                                "pl": "Twarz starca była obrazem <w>żałości</w>, gdy mówił o swoim utraconym domu.",
                                "zh": "当老人谈起他失去的家园时，脸上写满了<w>悲伤</w>。"
                            }
                        },
                        {
                            "text": "She listened to his tale of <w>woe</w> with deep sympathy and patience.",
                            "target_lang_translations": {
                                "pl": "Wysłuchała jego opowieści o <w>niedoli</w> z głębokim współczuciem i cierpliwością.",
                                "zh": "她怀着深切的同情和耐心，听他讲述自己的<w>苦难</w>经历。"
                            }
                        }
                    ],
                    "synonyms": [
                        "grief",
                        "sorrow",
                        "misery",
                        "sadness",
                        "dejection",
                        "distress"
                    ],
                    "antonyms": [
                        "joy",
                        "fortune"
                    ],
                    "common_phrases": [
                        "tale of woe"
                    ],
                    "target_lang_definitions": {
                        "pl": "Wielki smutek, cierpienie lub nieszczęście.",
                        "zh": "极度的悲伤、痛苦或苦难。"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "żałość",
                                "target_lang_sense_clarification": "uczucie dojmującego smutku"
                            },
                            {
                                "target_lang_word": "cierpienie",
                                "target_lang_sense_clarification": "ból psychiczny lub fizyczny"
                            },
                            {
                                "target_lang_word": "smutek",
                                "target_lang_sense_clarification": "głębokie przygnębienie"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "悲伤",
                                "target_lang_sense_clarification": "感到极度难过的情绪"
                            },
                            {
                                "target_lang_word": "痛苦",
                                "target_lang_sense_clarification": "身心受到的折磨"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "437c20c4-9bbe-3dc2-ae87-fa316bc20368",
                    "sense_definition": "Troubles, problems, or misfortunes.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "sadness_and_trouble",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company's financial <w>woes</w> began with the sudden drop in global demand.",
                            "target_lang_translations": {
                                "pl": "Finansowe <w>kłopoty</w> firmy zaczęły się od nagłego spadku globalnego popytu.",
                                "zh": "这家公司的财务<w>困境</w>始于全球需求的突然下降。"
                            }
                        },
                        {
                            "text": "He decided to forget his economic <w>woes</w> for one evening and enjoy the party.",
                            "target_lang_translations": {
                                "pl": "Postanowił na jeden wieczór zapomnieć o swoich <w>troskach</w> ekonomicznych i dobrze się bawić na przyjęciu.",
                                "zh": "他决定今晚暂时忘掉经济上的<w>烦恼</w>，好好享受派对。"
                            }
                        }
                    ],
                    "synonyms": [
                        "calamity",
                        "disaster",
                        "hardship",
                        "adversity",
                        "trouble"
                    ],
                    "antonyms": [
                        "benefit",
                        "boon"
                    ],
                    "common_phrases": [
                        "financial woes",
                        "economic woes"
                    ],
                    "target_lang_definitions": {
                        "pl": "Kłopoty, problemy lub niepowodzenia.",
                        "zh": "麻烦、问题或不幸的遭遇。"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "niedola",
                                "target_lang_sense_clarification": "zły los, bieda"
                            },
                            {
                                "target_lang_word": "nieszczęście",
                                "target_lang_sense_clarification": "niepomyślny zbieg zdarzeń, kłopoty"
                            },
                            {
                                "target_lang_word": "troski",
                                "target_lang_sense_clarification": "problemy i zmartwienia"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "苦难",
                                "target_lang_sense_clarification": "艰难困苦的境遇"
                            },
                            {
                                "target_lang_word": "困境",
                                "target_lang_sense_clarification": "难以摆脱的麻烦处境"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "17da25aa-a88d-34fc-816b-1c103f26fd66",
                    "sense_definition": "A curse or malediction.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient text pronounced a solemn <w>woe</w> upon anyone who dared to disturb the tomb.",
                            "target_lang_translations": {
                                "pl": "Starożytny tekst rzucał uroczyste <w>przekleństwo</w> na każdego, kto odważyłby się zakłócić spokój grobowca.",
                                "zh": "那篇古老的文字对任何胆敢打扰陵墓的人发出了庄严的<w>诅咒</w>。"
                            }
                        },
                        {
                            "text": "He uttered a bitter <w>woe</w> against those who had betrayed his trust.",
                            "target_lang_translations": {
                                "pl": "Wypowiedział gorzkie <w>złorzeczenie</w> przeciwko tym, którzy zawiedli jego zaufanie.",
                                "zh": "他向那些背叛他信任的人发出了痛苦的<w>哀叹</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "curse",
                        "malediction"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used primarily in literary or biblical contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Przekleństwo lub złorzeczenie.",
                        "zh": "诅咒或灾祸的预言。"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "przekleństwo",
                                "target_lang_sense_clarification": "maledykcja, potępienie"
                            },
                            {
                                "target_lang_word": "biada",
                                "target_lang_sense_clarification": "zapowiedź nieszczęścia lub kary"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "灾祸",
                                "target_lang_sense_clarification": "预示将要发生的不幸"
                            },
                            {
                                "target_lang_word": "诅咒",
                                "target_lang_sense_clarification": "对某人施加的恶毒言语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fa371850-e0a4-3df9-ba3a-04e5b03d85d5",
                    "sense_definition": "Sorrowful; miserable; feeling or showing great distress.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt wondrous <w>woe</w> when he realized his companion had departed.",
                            "target_lang_translations": {
                                "pl": "Poczuł niezwykły <w>smutek</w>, kiedy zdał sobie sprawę, że jego towarzysz odszedł.",
                                "zh": "当意识到同伴已经离去时，他感到无比<w>忧伤</w>。"
                            }
                        },
                        {
                            "text": "I am <w>woe</w> for the trouble I have caused you during this difficult time.",
                            "target_lang_translations": {
                                "pl": "Jest mi niezmiernie <w>przykro</w> z powodu kłopotów, jakie sprawiłem ci w tym trudnym czasie.",
                                "zh": "在这段艰难时期给你添了麻烦，我感到非常<w>悲惨</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sorrowful",
                        "miserable",
                        "unhappy",
                        "woeful",
                        "sad"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used as an adjective in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Zasmucony, nieszczęśliwy, pełen boleści (użycie archaiczne).",
                        "zh": "悲伤的；痛苦的；感到或表现出极度忧伤的（古语）。"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "strapiony",
                                "target_lang_sense_clarification": "pełen troski i smutku"
                            },
                            {
                                "target_lang_word": "nieszczęśliwy",
                                "target_lang_sense_clarification": "odczuwający głęboki smutek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "忧伤",
                                "target_lang_sense_clarification": "形容心情沉重悲痛"
                            },
                            {
                                "target_lang_word": "悲惨",
                                "target_lang_sense_clarification": "形容处境或心情极度不幸"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "f5fbc55b-0c54-3e4d-a6f7-731496b62cdf",
                    "sense_definition": "An exclamation of grief, distress, or lamentation.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Oh, <w>woe</w>, that we should live to see such a tragic day!",
                            "target_lang_translations": {
                                "pl": "O, <w>biada</w>, że przyszło nam dożyć tak tragicznego dnia!",
                                "zh": "噢，<w>哀哉</w>，我们竟然活到了目睹如此悲剧的一天！"
                            }
                        },
                        {
                            "text": "Alas and <w>woe</w>, the great library was completely destroyed by the fire.",
                            "target_lang_translations": {
                                "pl": "Ach, <w>biada</w>, wielka biblioteka została całkowicie zniszczona przez pożar.",
                                "zh": "唉，<w>悲乎</w>，这座伟大的图书馆被大火彻底摧毁了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "alas"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Mainly found in historical or poetic texts"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Wykrzyknik wyrażający żal, cierpienie lub lament.",
                        "zh": "表示悲痛、苦恼或哀叹的感叹词。"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "biada",
                                "target_lang_sense_clarification": "wykrzyknik ubolewania"
                            },
                            {
                                "target_lang_word": "biada mi",
                                "target_lang_sense_clarification": "wyraz rozpaczy"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "哀哉",
                                "target_lang_sense_clarification": "表示极度悲痛的感叹"
                            },
                            {
                                "target_lang_word": "悲乎",
                                "target_lang_sense_clarification": "古语中表示哀叹的词"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}