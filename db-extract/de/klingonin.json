                                        "sense_id": "7e9cbbca-d251-3b9a-bfae-08be153b6cb2",
                                        "entry_id": "72f11103-1366-3f1e-8e0a-492ab0109b3b",
                                        "glosses": [
                                            "An artificial language created by Marc Okrand for the film Star Trek II: The Wrath of Khan."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
