        "nl-extract.jsonl": [
            {
                "entry_id": "508bcab0-6b19-37dd-8d28-f4d685e9e50f",
                "word": "binnenrennen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d6d245db-c716-3624-856a-9facbabc291b",
                        "entry_id": "508bcab0-6b19-37dd-8d28-f4d685e9e50f",
                        "glosses": [
                            "met grote haast ergens te voet ingaan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67f7027f-afc5-4e1d-addb-4849ea931677",
                                "sense_id": "d6d245db-c716-3624-856a-9facbabc291b",
                                "text": "Volgens ooggetuigen hadden de jongens voorafgaand aan de steekpartij ruzie. \"Ik zag hem in blinde paniek de school binnenrennen, met zijn hand op zijn nek."
                            },
                            {
                                "example_id": "01214f07-1c45-4203-8a1e-6742e373835c",
                                "sense_id": "d6d245db-c716-3624-856a-9facbabc291b",
                                "text": "Een man hoorde daar 's avonds veel geschreeuw bij Wassjop, een wasserette in Tilburg. Hij zag twee overvallers met een koevoet en vuurwapen de wasserette binnenrennen en waarschuwde direct de politie."
                            },
                            {
                                "example_id": "e73bbb10-8167-469c-b75f-df24fb632159",
                                "sense_id": "d6d245db-c716-3624-856a-9facbabc291b",
                                "text": "Ook Ton Poot van speelgoedwinkel De Wissel heeft de boot gemist. \"Vorige week kwam er een rits kinderen binnenrennen voor fidget spinners. Ik wist niet eens wat het waren.\" Hij heeft inmiddels bijna 150 stuks besteld, die naar verwachting na het weekend worden geleverd."
                            }
                        ]
                    }
                ],
