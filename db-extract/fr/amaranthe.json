                        "form": "amaranthes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f94d20e0-7275-3a0b-8005-835eae2c8f15",
                        "entry_id": "e925fe36-c228-369b-aa79-6af3f8d528c8",
                        "glosses": [
                            "Variante de amarante."
                        ],
                        "tags": [
                            "alt-of",
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "8f83182e-ff37-4ed2-b5a2-66ca9184996a",
                                "sense_id": "f94d20e0-7275-3a0b-8005-835eae2c8f15",
                                "text": "Les amaranthes sont des plantes allogames auto-fertiles."
                            },
                            {
                                "example_id": "ebb507c8-4cef-4768-af41-6759d79b365f",
                                "sense_id": "f94d20e0-7275-3a0b-8005-835eae2c8f15",
                                "text": "Au dehors, les foins blondissaient prêts à mûrir. Le bois des plus vieux sarments éclatait ; la vigne montrait ses premiers bourgeons. Les blés étaient verts : ils s’étendaient au loin dans la plaine onduleuse, où les sainfoins se teignaient d’amaranthe, où les colzas éblouissaient la vue comme des carrés d’or."
                            },
                            {
                                "example_id": "9a3a46d8-0a88-415f-882d-eecd8170b9c0",
                                "sense_id": "f94d20e0-7275-3a0b-8005-835eae2c8f15",
                                "text": "De petites traînées de fleurettes jettent des zébrures imperceptibles d’amaranthe effacée sur la verdure des champs."
                            },
                            {
                                "example_id": "3aa32790-5b3d-471f-b4a2-6452f3310ae0",
                                "sense_id": "f94d20e0-7275-3a0b-8005-835eae2c8f15",
                                "text": "Un cas a été signalé en 2011 dans le sud de l’Australie sur le sisymbre d’Orient (Sisymbrium orientale) et aux États-Unis, un cas dans le Nebraska sur une amaranthe (Amaranthus palmeri)."
                            },
                            {
                                "example_id": "2ae4de0e-3b96-4fbd-b4f6-4dde7a3692bd",
                                "sense_id": "f94d20e0-7275-3a0b-8005-835eae2c8f15",
                                "text": "Les tables pouvaient contenir cinq ou six cents personnes ; les nappes étaient couvertes de feuilles découpées et de fleurs d’amaranthes."
                            }
                        ]
                    }
                ],
