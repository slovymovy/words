                                                "example_id": "b0b62489-bf00-4794-bb46-7c6fa175900d",
                                                "sense_id": "f176a253-9348-33bb-b931-4937c8bf1a9e",
                                                "text": "Pismo wychodziło drukowane identyczną czcionką, z identyczną winietą i zachowaniem ciągłości numeracji"
                                            },
                                            {
                                                "example_id": "d809f989-8bf8-4193-93e3-c653754aa545",
                                                "sense_id": "f176a253-9348-33bb-b931-4937c8bf1a9e",
                                                "text": "Zaczął publikować swoje teksty pod zaczerpniętą od Arystotelesa winietą: Muzyka łagodzi obyczaje"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "1a347379-5f86-312c-95f1-a49a2e2a5f24",
                                        "entry_id": "b948c02c-ba04-3915-b9e4-99a7b9c78861",
                                        "glosses": [
                                            "ozdobny drukarski ornament"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e852f496-6047-45e3-8086-db2b9fd28826",
                                                "sense_id": "1a347379-5f86-312c-95f1-a49a2e2a5f24",
                                                "text": "Usłużny subiekt otwiera dalsze składy, wypełnione aż po sufit książkami, rycinami, fotografiami. Te winiety, te ryciny przechodzą stokrotnie najśmielsze nasze marzenia"
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "aab7473d-eab7-3226-81a5-0f84b5c7c186",
                                        "entry_id": "b948c02c-ba04-3915-b9e4-99a7b9c78861",
                                        "glosses": [
                                            "naklejka umieszczana na szybie samochodu po opłaceniu pozwolenia na poruszanie się po krajowych autostradach, będąca dowodem tej opłaty"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b021ef4-752c-4922-bd2f-fe7800671631",
                                                "sense_id": "aab7473d-eab7-3226-81a5-0f84b5c7c186",
                                                "text": "W wielu krajach europejskich korzystanie z autostrad i dróg ekspresowych wymaga wykupienia winiety"
                                            }
                                        ],
                                        "sense_index_json": "\"1.3\""
                                    },
                                    {
                                        "sense_id": "8d1b5157-f8df-37d2-83df-cca2374080d2",
                                        "entry_id": "b948c02c-ba04-3915-b9e4-99a7b9c78861",
                                        "glosses": [
                                            "nadruk, często ozdobny, znajdujący się na odwrocie tekturki, na którą w 2. połowie XIX i na początku XX w. naklejano fotografię"
                                        ],
