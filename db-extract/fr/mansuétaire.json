                "senses": [
                    {
                        "sense_id": "7e39843b-6473-3b5d-a513-711d1c66efbe",
                        "entry_id": "380c5066-e0b8-3e8f-b9ce-ef0b93eeceef",
                        "glosses": [
                            "Dresseur d'animaux sauvages."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "f598405b-5f79-4956-8f00-c3f47ad074fd",
                                "sense_id": "7e39843b-6473-3b5d-a513-711d1c66efbe",
                                "text": "Les Manſuétaires étoient ceux qui apprivoiſoient les lions, les ours, les léopards, & les autres bêtes féroces, que ces Princes nourriſſoient pour leur plaiſir. C'étoient des Officiers, des Valets de la Ménagerie de ces Princes."
                            },
                            {
                                "example_id": "f3d9ac55-07c8-437d-a4bc-f1bc5eec296b",
                                "sense_id": "7e39843b-6473-3b5d-a513-711d1c66efbe",
                                "text": "Avec les lions, nos mansuétaires n'étaient pas en retard. Ils les tondaient comme des caniches, leur saupoudraient la crinière de poudre d'or, les harnachaient magnifiquement et les attelaient à des quadriges."
                            },
                            {
                                "example_id": "811e3966-cb6b-4950-96a1-5d4805cab3db",
                                "sense_id": "7e39843b-6473-3b5d-a513-711d1c66efbe",
                                "text": "Le mansuétaire, bas officier de la maison impériale à Rome, en charge des bêtes sauvages destinées aux « divertissements animaliers », doit leur apprendre à parader dans l’arène avant de combattre selon un processus à respecter."
                            }
                        ]
                    }
