                "senses": [
                    {
                        "sense_id": "06978d06-2ae3-3c0e-9826-6e7f5b2ab4f6",
                        "entry_id": "adb7dd06-258e-3e59-b41a-b657a5b82281",
                        "glosses": [
                            "Rendre élastique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60eb5b77-0bf5-4488-899e-7a3e22c33a7b",
                                "sense_id": "06978d06-2ae3-3c0e-9826-6e7f5b2ab4f6",
                                "text": "L'enfant-brasier, lui, possède l'art de perturber le temps, d'élasticiser l'espace."
                            },
                            {
                                "example_id": "cc78a944-5166-4c5d-9107-08e9430b1a76",
                                "sense_id": "06978d06-2ae3-3c0e-9826-6e7f5b2ab4f6",
                                "text": "Ces petits jeux entre le français et l'allemand servent à élasticiser le bavardage, mais le bavardage garde toute sa colle."
                            },
                            {
                                "example_id": "54cf99ed-3f6e-48ae-b08e-7fa395e00153",
                                "sense_id": "06978d06-2ae3-3c0e-9826-6e7f5b2ab4f6",
                                "text": "Tout le monde est d’accord lorsqu’il est question d’élasticiser l’existence, l’étirer jusqu’à l’infini"
                            }
                        ]
                    }
