                                        "entry_id": "ce73c169-df24-3882-8026-e4b73fdc11f2",
                                        "glosses": [
                                            "Variété linguistique, d'origine sociale, géographique ou temporelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "756166b8-1b05-45b2-8d72-06fc7fabecca",
                                                "sense_id": "9d6c5c39-4ba1-32a1-939f-a01376952e91",
                                                "text": "Nous suggérons que chaque forme interlectale est produite dans un lecte à dominante soit française, soit créole."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6e16cb1-826f-3468-97f6-28d6173eeeda",
                                        "entry_id": "ce73c169-df24-3882-8026-e4b73fdc11f2",
                                        "glosses": [
                                            "Variante phonologique, syntaxique ou sémantique."
                                        ],
                                        "tags": [
                                            "Plus rare"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
