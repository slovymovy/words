                        "entry_id": "b5aac3d4-f540-3caf-bad5-7f4beb054a88",
                        "glosses": [
                            "koszenie łąki i suszenie traw w celu uzyskania siana"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71e3c1fe-f43e-4d93-9aa6-14bbddc9bc94",
                                "sense_id": "a2a67b90-eb7c-3515-9ff5-80313c2bc57a",
                                "text": "Nad domostwami trzepotały się gołębie, z łąk bliskich biła świeżość i woń sianokosów"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "f6fb1a4a-de91-3b50-8ae9-c939da2e0972",
                        "entry_id": "b5aac3d4-f540-3caf-bad5-7f4beb054a88",
                        "glosses": [
                            "okres, w którym wykonuje się te prace"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e856232b-330d-477d-affb-8c3071a22cf9",
                                "sense_id": "f6fb1a4a-de91-3b50-8ae9-c939da2e0972",
                                "text": "Sianokosy skończyły się w tym roku dosyć wcześnie."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f236e8b9-030c-4bb9-9944-ff461aa59c0b",
                        "source_entry_id": "b5aac3d4-f540-3caf-bad5-7f4beb054a88",
                        "source_sense_id": "a2a67b90-eb7c-3515-9ff5-80313c2bc57a",
                        "target_lang_word": "haymaking",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "haymaking",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dc16e99e-048d-36b4-931b-c8b154a12c8d",
                                        "entry_id": "21e0527c-a044-37d9-8b0a-ff99eb2e349e",
                                        "glosses": [
                                            "The cutting of grass and subsequently curing it to make hay as fodder for animals."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8bc98ad8-6d5f-4b4f-8c82-4274473e8ca2",
                                                "sense_id": "dc16e99e-048d-36b4-931b-c8b154a12c8d",
                                                "text": "The red-painted farm-houses, peculiar to Norway, lay picturesquely scattered on the higher points of the undulating valley, where men and women were busy hay-making."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8d48916-c7be-3f91-b789-71e480cac844",
                                        "entry_id": "21e0527c-a044-37d9-8b0a-ff99eb2e349e",
                                        "glosses": [
                                            "Taking full advantage of an opportunity while it lasts"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f19bc38e-239c-444f-bc30-95e3e8188440",
                                                "sense_id": "d8d48916-c7be-3f91-b789-71e480cac844",
                                                "text": "In their haymaking days, the Spoonful created a string of '60s chestnuts: \"Do You Believe In Magic?\", \"You Didn't Have To Be So Nice,\" \"Daydream,\" \"Summer In The City,\" \"Nashville Cats.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9f55eaa5-4e04-45ba-a7fb-9771552aefc9",
                        "source_entry_id": "b5aac3d4-f540-3caf-bad5-7f4beb054a88",
                        "source_sense_id": "a2a67b90-eb7c-3515-9ff5-80313c2bc57a",
