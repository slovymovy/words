                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc4aa4dd-6dde-4995-95ae-e57a2904e836",
                                "sense_id": "8d560b06-d35b-3ae8-8947-eea729654cc4",
                                "text": "Des soirs d’été où on allait chercher le lait à la ferme voisine – en contrepoint le brinquebalement de la boîte de métal dont la petite chaîne danse."
                            },
                            {
                                "example_id": "c2636c36-bd51-49ba-9cd5-e9c0f84ad9d9",
                                "sense_id": "8d560b06-d35b-3ae8-8947-eea729654cc4",
                                "text": "L’éternité à vivre ici, dans le brinquebalement du train qui s’alentit."
                            },
                            {
                                "example_id": "369f448a-c414-4f12-ba44-a250f5782012",
                                "sense_id": "8d560b06-d35b-3ae8-8947-eea729654cc4",
                                "text": "Dans le brinquebalement fastidieux du métro, on voit un garçon qui dodeline de la tête avec un grand sourire aux lèvres, une fille qui parle fiévreusement, puis qui écoute en approuvant."
                            }
                        ]
                    }
