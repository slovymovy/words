                                                "example_id": "291e1588-7b24-4fd0-9ed0-6149164b20fe",
                                                "sense_id": "5655cfe3-3ecf-3903-b408-de3c8d9157ce",
                                                "text": "We had to put on our goggles as it was snowing outside."
                                            },
