                ],
                "senses": [
                    {
                        "sense_id": "2f58b6b0-074b-3edf-9f1c-0b2afca54f0d",
                        "entry_id": "116b19ec-5f6f-3434-8281-c4671a78f411",
                        "glosses": [
                            "Bewegung durch die Luft mit einem Hängegleiter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bb2f63e-5f5a-4036-b368-a65ab9100bb4",
                                "sense_id": "2f58b6b0-074b-3edf-9f1c-0b2afca54f0d",
                                "text": "„Die Landung, der technisch anspruchsvollste Teil eines Drachenflugs, wird nicht mehr geschildert, und der Leser fragt sich, wie der psychisch und wohl auch flugtechnisch total überforderte Mann wohl gelandet sein mag.“"
                            },
                            {
                                "example_id": "a471fdcf-494b-46c5-b438-f37a7b121739",
                                "sense_id": "2f58b6b0-074b-3edf-9f1c-0b2afca54f0d",
                                "text": "„Beim Drachenflug ist es besonders wichtig, den Windeinfluss zu berücksichtigen, da schon relativ geringe Gegenwindgeschwindigkeiten zu einer drastischen Verschlechterung der Gleitzahl führen.“"
                            },
                            {
                                "example_id": "c5f1a60b-ecaf-46fb-83f7-bd9b54e74a6a",
                                "sense_id": "2f58b6b0-074b-3edf-9f1c-0b2afca54f0d",
                                "text": "„Diese große Anfangsgeschwindigkeit ermöglicht dem Flugfisch ein Gleiten mit den großen Tragflächen der gespreizten Seitenflossen in Form eines passiven Drachenfluges.“"
                            },
                            {
                                "example_id": "80e9e058-350d-4393-ad56-b20417670f0b",
                                "sense_id": "2f58b6b0-074b-3edf-9f1c-0b2afca54f0d",
                                "text": "„Mit Flair 30, einem superleichten Gleiter (36 Kilogramm), schlug der Erfinder schließlich eine Brücke zwischen Segelflug und Drachenflug.“"
                            },
                            {
                                "example_id": "6303bb69-9fa3-47e0-bb06-684ef879ebc9",
                                "sense_id": "2f58b6b0-074b-3edf-9f1c-0b2afca54f0d",
                                "text": "„Idealwetter für Drachenflüge gibt es in unserer Region an acht von zehn Tagen - und nicht nur im Herbst.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
