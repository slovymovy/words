                ],
                "senses": [
                    {
                        "sense_id": "ed0c4d12-d83a-30c0-b02a-ce815dd67abb",
                        "entry_id": "4c090e84-ed7d-3c3d-9b1c-579a2ba9f4eb",
                        "glosses": [
                            "städtebaulich oder landschaftlich unästhetisches oder funktionell mangelhaftes Bauwerk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "487b2118-46ea-4326-b8c3-3d9d4e237656",
                                "sense_id": "ed0c4d12-d83a-30c0-b02a-ce815dd67abb",
                                "text": "Vieles von dem, was in den 50er- bis 70er-Jahren gebaut wurde, gilt heute schlicht als Bausünde."
                            },
                            {
                                "example_id": "35846b33-f1c5-4d07-a174-ec95da737f66",
                                "sense_id": "ed0c4d12-d83a-30c0-b02a-ce815dd67abb",
                                "text": "Am Südstrand stehen drei Hotelbauten …, ansonsten blieb die Insel von größeren Bausünden verschont."
                            },
                            {
                                "example_id": "c29cd47b-efd4-4a57-9346-bd79faef697f",
                                "sense_id": "ed0c4d12-d83a-30c0-b02a-ce815dd67abb",
                                "text": "Nach rund sechsjähriger Umbauzeit erstrahlt das Moskauer Opernhaus wieder im Glanz der Zarenzeit. Sowjetische Bausünden wurden beseitigt."
                            },
                            {
                                "example_id": "9bccf3d2-fba6-45f6-ae84-f1375aff4876",
                                "sense_id": "ed0c4d12-d83a-30c0-b02a-ce815dd67abb",
                                "text": "„Und wer nur der Bilderrahmenperspektive des Architekten folgt, sich Scheuklappen anlegt und nicht umdreht, übersieht auch die Bausünden hinter der Landzunge mit Benidorms Altstadt und der Plaça del Castel, von deren Festung aus einst Angriffe von Piraten abgewehrt wurden.“"
                            },
                            {
                                "example_id": "c4921a60-29ea-4d80-b2d3-19195f14aad8",
                                "sense_id": "ed0c4d12-d83a-30c0-b02a-ce815dd67abb",
                                "text": "Da sieht Nürnberg eher wie eine Stadt aus, die im Zweiten Weltkrieg fast völlig zerbombt wurde und immer noch die Narben ihrer Vergangenheit trägt. Schöne Fachwerkhäuser stehen direkt neben grässlichen Bausünden aus den 1960er Jahren."
                            },
                            {
                                "example_id": "ee912654-3234-45f8-bce1-3626b355880a",
                                "sense_id": "ed0c4d12-d83a-30c0-b02a-ce815dd67abb",
                                "text": "Die weiß-blau verkleidete Bausünde aus den 70er-Jahren ist wegen ihres exponierten Platzes am Wasser dennoch das Wahrzeichen von Schleswig."
                            },
                            {
                                "example_id": "7be3dbd8-d428-4242-bdb2-05ffc900d452",
                                "sense_id": "ed0c4d12-d83a-30c0-b02a-ce815dd67abb",
                                "text": "Er [der Planer und Denkmalpfleger Dieter Burghaus] ist fassungslos angesichts des ECE-Projektes auf dem \"Fackelrondell\": „Für mich die größte Bausünde der letzten paar hundert Jahre, die Kaiserslautern hier begeht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "54aaee0d-8f5d-46ea-bf85-c2f7ee371a74",
