                        "examples": [
                            {
                                "example_id": "2c4b4423-e655-44c8-8ca3-5f4b3cd7e838",
                                "sense_id": "b18fc702-a6e2-3acc-832b-fab9d1f04894",
                                "text": "„Sie aßen im Il Buco, einem kleinen Straßenrestaurant in der Via Sant'Ignazio in der Nähe des Pantheons.“"
                            },
                            {
                                "example_id": "1b08c120-6389-48b1-ab29-e03dd8e7adf1",
                                "sense_id": "b18fc702-a6e2-3acc-832b-fab9d1f04894",
                                "text": "„Sie passierten Straßenrestaurants und eine Bushaltestelle, schlenderten vorbei an streunenden Hunden, die auf dem Marktplatz schliefen, und Hühnern, die auf einer Müllhalde nach Käfern pickten.“"
                            }
