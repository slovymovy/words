                                "target_senses": [
                                    {
                                        "sense_id": "9d334d8d-f5ef-3462-a83e-d2c54de2e72a",
                                        "entry_id": "e8c33ec5-9b88-3ec2-9d81-ce35acc2d424",
                                        "glosses": [
                                            "Any of a particular class of topological soliton that can be used to model certain properties of a nucleon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efa60d14-2904-4279-872f-4f629deab4c5",
                                                "sense_id": "9d334d8d-f5ef-3462-a83e-d2c54de2e72a",
                                                "text": "No conclusive results are available yet; the hope is that the skyrmion would be stabilized at R#92;approx#92;lambda#95;c, where the gradient expansion breaks down and yet the skyrmion may still carry the quark quantum numbers."
                                            },
                                            {
                                                "example_id": "524ecb46-bb45-4771-ad9b-e795b0700494",
                                                "sense_id": "9d334d8d-f5ef-3462-a83e-d2c54de2e72a",
                                                "text": "The properties of nuclear matter at high densities have been investigated in many ways. Castillejo et al. studied Skyrmion matter by placing SU(2) hedgehog Skyrmions on a lattice and show that the deconfinement phase transition and the chiral symmetry restoration occur above a critical density [11]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d344ed6e-2ea8-3765-9ec7-604d79a8e3d8",
                                        "entry_id": "e8c33ec5-9b88-3ec2-9d81-ce35acc2d424",
                                        "glosses": [
                                            "A type of topological soliton that occurs in magnetic materials and magnetic thin films."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
