{
    "word_family": [
        "crewmember",
        "crewman",
        "crewer"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5b4112c3-0199-3007-9c3a-17d5402e4536",
                    "sense_definition": "A group of people, often staff, who operate a large facility or vehicle such as a ship, airplane, or train.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "functional_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The flight <w>crew</w> prepared the cabin for landing.",
                            "target_lang_translations": {
                                "ru": "Лётный <w>экипаж</w> подготовил салон к посадке.",
                                "tr": "Uçuş <w>mürettebatı</w> kabini iniş için hazırladı.",
                                "zh": "飞行<w>机组人员</w>为着陆做好了客舱准备。"
                            }
                        },
                        {
                            "text": "If you need assistance, please ask a member of the <w>crew</w>.",
                            "target_lang_translations": {
                                "ru": "Если вам нужна помощь, пожалуйста, обратитесь к члену <w>экипажа</w>.",
                                "tr": "Yardıma ihtiyacınız olursa, lütfen <w>mürettebattan</w> birine sorun.",
                                "zh": "如果您需要帮助，请询问<w>机组人员</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ship's company",
                        "complement",
                        "team",
                        "staff"
                    ],
                    "common_phrases": [
                        "cabin crew",
                        "flight crew",
                        "ground crew",
                        "train crew"
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа людей, управляющих транспортным средством, например судном, самолётом или поездом.",
                        "tr": "Gemi, uçak veya tren gibi bir taşıtı veya büyük bir tesisi işleten personel/görevli grubu.",
                        "zh": "指在大型设施或交通工具（如船只、飞机或火车）上工作的操作人员或服务人员。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "экипаж",
                                "target_lang_sense_clarification": "самолёта, судна, танка"
                            },
                            {
                                "target_lang_word": "команда",
                                "target_lang_sense_clarification": "судна"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "mürettebat",
                                "target_lang_sense_clarification": "gemi, uçak vb."
                            },
                            {
                                "target_lang_word": "ekip",
                                "target_lang_sense_clarification": "görevli grubu"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "机组人员",
                                "target_lang_sense_clarification": "飞机上的工作人员"
                            },
                            {
                                "target_lang_word": "船员",
                                "target_lang_sense_clarification": "船上的工作人员"
                            },
                            {
                                "target_lang_word": "乘务组",
                                "target_lang_sense_clarification": "交通工具上的服务人员"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "367af9c2-a6de-3ace-8c8e-54d2f6a91828",
                    "sense_definition": "A group of people working together on a specific physical task or job.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "functional_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The construction <w>crew</w> repaired the bridge over the weekend.",
                            "target_lang_translations": {
                                "ru": "Строительная <w>бригада</w> отремонтировала мост за выходные.",
                                "tr": "İnşaat <w>ekibi</w> hafta sonu köprüyü tamir etti.",
                                "zh": "施工<w>队</w>在周末修复了桥梁。"
                            }
                        },
                        {
                            "text": "A skeleton <w>crew</w> remained at the factory during the holidays.",
                            "target_lang_translations": {
                                "ru": "На заводе во время праздников осталась лишь дежурная <w>бригада</w>.",
                                "tr": "Tatillerde fabrikada yalnızca nöbetçi bir <w>ekip</w> kaldı.",
                                "zh": "假期期间，工厂只留下了少数<w>值班人员</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "team",
                        "gang",
                        "squad",
                        "workforce"
                    ],
                    "common_phrases": [
                        "skeleton crew",
                        "road crew",
                        "construction crew",
                        "emergency crew"
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа людей, работающих вместе над конкретной физической задачей.",
                        "tr": "Belirli bir fiziksel işte veya görevde birlikte çalışan insan grubu.",
                        "zh": "指为完成特定体力劳动或工作而共同协作的一群人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бригада",
                                "target_lang_sense_clarification": "рабочая, строительная"
                            },
                            {
                                "target_lang_word": "команда",
                                "target_lang_sense_clarification": "группа работников"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ekip",
                                "target_lang_sense_clarification": "çalışma grubu"
                            },
                            {
                                "target_lang_word": "takım",
                                "target_lang_sense_clarification": "iş grubu"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "施工队",
                                "target_lang_sense_clarification": "建筑或工程团队"
                            },
                            {
                                "target_lang_word": "工作组",
                                "target_lang_sense_clarification": "执行特定任务的团队"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "be27a19f-4081-39b2-827e-d0e62cfbcf78",
                    "sense_definition": "The group of technical workers on a film, television, or stage production who are not actors.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "functional_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cast and <w>crew</w> celebrated after the final scene was filmed.",
                            "target_lang_translations": {
                                "ru": "Актёры и <w>съёмочная группа</w> праздновали после съёмки последней сцены.",
                                "tr": "Oyuncular ve <w>ekip</w> son sahne çekildikten sonra kutlama yaptı.",
                                "zh": "最后一个镜头拍完后，演员和<w>摄制组</w>进行了庆祝。"
                            }
                        },
                        {
                            "text": "She works on the camera <w>crew</w> for a major news channel.",
                            "target_lang_translations": {
                                "ru": "Она работает в операторской <w>группе</w> крупного новостного канала.",
                                "tr": "Büyük bir haber kanalında kamera <w>ekibinde</w> çalışıyor.",
                                "zh": "她在一家大型新闻频道的<w>摄像组</w>工作。"
                            }
                        }
                    ],
                    "synonyms": [
                        "staff",
                        "stagehands"
                    ],
                    "common_phrases": [
                        "cast and crew",
                        "film crew",
                        "camera crew",
                        "sound crew"
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа технических специалистов на съёмках фильма, телепередачи или в театре (исключая актёров).",
                        "tr": "Film, televizyon veya tiyatro yapımında oyuncular dışında kalan teknik çalışanlar grubu.",
                        "zh": "指电影、电视或舞台制作中，除演员以外的幕后技术工作人员。"
                    },
                    "translations": {
                        "ru": [
                            {
