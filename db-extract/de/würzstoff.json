                                    {
                                        "sense_id": "8d4c3991-0947-305d-898d-d396bc9f9e66",
                                        "entry_id": "ee41d266-cc5d-31a6-a2c6-ed3f1dcb4047",
                                        "glosses": [
                                            "Élaboration produite à partir d’épices, de plantes aromatiques ou d’autres ingrédients que l’on mêle aux aliments pour en rehausser le goût."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21c3d4b5-aaa4-451d-b27d-1421677f08ce",
                                                "sense_id": "8d4c3991-0947-305d-898d-d396bc9f9e66",
                                                "text": "Le plomb dans le gibier servi sur table est un condiment qui peut être ajouté après la cuisson."
                                            },
                                            {
                                                "example_id": "76c8f46b-f135-4b34-b012-c404e279bbf7",
                                                "sense_id": "8d4c3991-0947-305d-898d-d396bc9f9e66",
                                                "text": "C'est eux également qui importèrent le poivre, condiment devenu si rare, qu'on l'utilisa comme monnaie."
                                            },
                                            {
                                                "example_id": "386964c1-b934-4fc7-89fc-b9aaecfe16fc",
                                                "sense_id": "8d4c3991-0947-305d-898d-d396bc9f9e66",
                                                "text": "Il existe une multitude de condiments, de la mayonnaise au ketchup en passant par la sauce soja et le Tabasco. Ponzu, chimichurri, vinaigrette… la liste est infinie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eab23cb6-f671-3e55-aa71-fd97150340fc",
                                        "entry_id": "ee41d266-cc5d-31a6-a2c6-ed3f1dcb4047",
                                        "glosses": [
                                            "Ce qui ajoute de l'intérêt à quelque chose."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f42ffe7-dc65-4432-9d76-19e3ff4424dd",
                                                "sense_id": "eab23cb6-f671-3e55-aa71-fd97150340fc",
                                                "text": "La flatterie fait partie de cette Éloquence tant célébrée, et davantage encore de la Médecine, et au plus haut point de la Poésie. Elle est le miel et le condiment de toutes les relations entre les hommes."
                                            }
                                        ]
                                    }
                                ]
                            }
