                "senses": [
                    {
                        "sense_id": "1ad5cf4d-cc7a-3814-a332-5a77f2ddaace",
                        "entry_id": "779c8915-6e63-3614-96f5-8bc7a3230cef",
                        "glosses": [
                            "finanzielle Zuwendung einer öffentlichen Institution zum Ausgleich für den Wasserschaden wegen Flutwassers"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "0a6eeb14-dead-4ce2-92f1-6ad8b2183d5e",
                                "sense_id": "1ad5cf4d-cc7a-3814-a332-5a77f2ddaace",
                                "text": "„Nach [den Förderrichtlinien] kann Flutgeld nur dort eingesetzt werden, wo eine hochwassersichere Investition gegeben ist.“"
                            },
                            {
                                "example_id": "cdc5f2f6-47aa-4e70-803a-5d673bd495f1",
                                "sense_id": "1ad5cf4d-cc7a-3814-a332-5a77f2ddaace",
                                "text": "„Knapp anderthalb Jahre nach der Juniflut von 2013 hängen zahlreiche Städte und Gemeinden in Sachsen bei der Beantragung von Flutgeldern hinterher.“"
                            },
                            {
                                "example_id": "b33c59c7-c868-4701-8079-936a3fc9750c",
                                "sense_id": "1ad5cf4d-cc7a-3814-a332-5a77f2ddaace",
                                "text": "„Crimmitschau zahlt Flutgeld an etwa zwei Dutzend Haushalte[.] Knapp zwei Dutzend Haushalte in Crimmitschau erhalten nach der Juni-Flut eine städtische Soforthilfe.“"
                            },
                            {
                                "example_id": "2ff8db04-251a-4119-b46d-2330de94f24b",
                                "sense_id": "1ad5cf4d-cc7a-3814-a332-5a77f2ddaace",
                                "text": "„Nicht mehr Gegenstand der Verhandlung war der Vorwurf, Nicolaus habe mit Flutgeldern einen Privatweg an ihrem Haus saniert.“"
                            },
                            {
                                "example_id": "aeddb20b-5602-4d69-8742-ebf3d50ae74c",
                                "sense_id": "1ad5cf4d-cc7a-3814-a332-5a77f2ddaace",
                                "text": "„Dass Diller auch sauber mit Flutgeld umgehen könne, habe er mit seinem ‚Fährgut‘ in der Nachbarschaft bewiesen.“"
                            },
                            {
                                "example_id": "299d56b9-19a5-49b2-9985-b9fa42e71a76",
                                "sense_id": "1ad5cf4d-cc7a-3814-a332-5a77f2ddaace",
                                "text": "„Hier wird das erste Flutgeld bezahlt“ (Überschrift)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "bda476ac-9243-3134-af5b-51fee5c0aa05",
                        "entry_id": "779c8915-6e63-3614-96f5-8bc7a3230cef",
                        "glosses": [
                            "durch die Folgen einer Überflutung stark verschmutztes und/oder aufgeweichtes, nicht mehr benutzbares Papiergeld"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3679db33-b0a8-4044-9152-0d8371f52047",
                                "sense_id": "bda476ac-9243-3134-af5b-51fee5c0aa05",
                                "text": "„Kann die Bundesbank das Flutgeld waschen?“"
                            },
                            {
                                "example_id": "20f1a5b6-fd1f-4159-82b7-6b854535c1ea",
                                "sense_id": "bda476ac-9243-3134-af5b-51fee5c0aa05",
                                "text": "„‚Die erste große Welle Flutgeld ist abgearbeitet. Die Anträge kamen vor allem von Banken und Firmen‘, bilanziert Horst Werner Hofmann, stellvertretender Leiter des Nationalen Analysezentrums.“"
                            },
                            {
                                "example_id": "3f247970-ac1c-4023-b4c6-51fbc885063c",
                                "sense_id": "bda476ac-9243-3134-af5b-51fee5c0aa05",
                                "text": "„Bislang sind über 65 Millionen Euro an sogenanntem Flutgeld eingereicht worden, wie die Bundesbank der Deutschen Presse-Agentur mitteilte.“"
                            },
                            {
                                "example_id": "922bad35-30ad-4048-8472-6707db789de8",
                                "sense_id": "bda476ac-9243-3134-af5b-51fee5c0aa05",
                                "text": "„Privatleute können das Flutgeld bei der Bundesbank oder bei ihrer Geschäftsbank einreichen sowie per Post schicken.“"
                            },
                            {
                                "example_id": "fc3d9e65-109e-4dbd-b0bc-e244339bcd19",
                                "sense_id": "bda476ac-9243-3134-af5b-51fee5c0aa05",
                                "text": "„Neben der Feuchtigkeit sind Flutgelder häufig zusätzlich kontaminiert, etwa mit Schlamm, Abwässern oder Heizöl.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
