                "senses": [
                    {
                        "sense_id": "123c708c-4dad-3fb3-8ec7-27703f7bf67d",
                        "entry_id": "bfc2359d-1e26-38dd-a840-f2c9df705546",
                        "glosses": [
                            "Dampf, der beim Abschuss einer Feuerwaffe entsteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf9628e6-dae0-4274-a5af-af6a8fb8561d",
                                "sense_id": "123c708c-4dad-3fb3-8ec7-27703f7bf67d",
                                "text": "„Es roch nach Wirsing, Pulverdampf und Tod.“"
                            },
                            {
                                "example_id": "c3ed770a-790e-4d6d-997d-152da6a8888b",
                                "sense_id": "123c708c-4dad-3fb3-8ec7-27703f7bf67d",
                                "text": "„Auch den Pulverdampf von Eylau und Friedland hatte er gerochen.“"
                            },
                            {
                                "example_id": "706f3ba6-16a2-47ac-8ffc-1cf3b277ffc2",
                                "sense_id": "123c708c-4dad-3fb3-8ec7-27703f7bf67d",
                                "text": "„Die ganze Luft war von Pulverdampf erfüllt.“"
                            },
                            {
                                "example_id": "bff78e55-41df-4355-a49f-ee060652e49b",
                                "sense_id": "123c708c-4dad-3fb3-8ec7-27703f7bf67d",
                                "text": "„Ihre Hände rochen nach Pulverdampf, aber um sie zu waschen, reichte die Zeit nicht – Abteilungschef Crawfords Anordnung hatte gelautet: sofort.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
