                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "personne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce garde forestier est réputé pour être un excellent <w>fusil</w> dans toute la région."
                        },
                        {
                            "text": "Le vieux chasseur reste le meilleur <w>fusil</w> de la commune."
                        }
                    ],
                    "common_phrases": [
                        "bon fusil",
                        "fin fusil"
