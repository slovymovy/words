                                "target_senses": [
                                    {
                                        "sense_id": "46d0b089-1a14-37c9-a1c6-832837d334c3",
                                        "entry_id": "200dbfec-2540-366c-8ed9-dff57adf5dfc",
                                        "glosses": [
                                            "Tireur d’élite, embusqué, isolé, dans un contexte d’affrontement armé."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "018d5e68-02ba-48c6-a336-183a827ce213",
                                                "sense_id": "46d0b089-1a14-37c9-a1c6-832837d334c3",
                                                "text": "La Yougoslavie était à feu et à sang, les balles de tireurs invisibles, les snipers, zébraient les rues."
                                            },
                                            {
                                                "example_id": "65929f65-0334-4651-ac1f-6948dcdbfc91",
                                                "sense_id": "46d0b089-1a14-37c9-a1c6-832837d334c3",
                                                "text": "Certains vétérans de l’armée d’Israël tiennent cette guerre d’usure pour la plus dure de toutes celles qu’ils eurent à livrer car il fallait être sur le qui-vive à tout instant et ne jamais baisser sa garde : celui qui, rendu claustrophobe par le confinement du bunker, sortait respirer à l’air libre avait de grandes chances d’être abattu par un sniper égyptien."
                                            },
                                            {
                                                "example_id": "cf6f3337-1181-493e-9e16-1d39cd35331c",
                                                "sense_id": "46d0b089-1a14-37c9-a1c6-832837d334c3",
                                                "text": "Les snipers sont les héros, ceux sur lesquels on fait des films, ceux que décrit Stephen Hunter dans ses romans, mais ce sont les spotters qui font le vrai boulot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40fd78c8-8013-336f-9729-803a0ef6e951",
                                        "entry_id": "200dbfec-2540-366c-8ed9-dff57adf5dfc",
                                        "glosses": [
                                            "Par ellipse, arme utilisée par ce dernier."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "sniper",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dac9b5a0-4732-3214-9780-e223e70a476e",
                                        "entry_id": "09ef4641-92f5-3838-9fc2-2839d974e07a",
                                        "glosses": [
                                            "Émettre une enchère juste avant la fin prévue des enchères, pour empêcher les autres de surenchérir, dans les systèmes de vente aux enchères sur Internet."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cc5fb28f-364e-32a4-8c80-1ad09a7ef7e6",
                                        "entry_id": "09ef4641-92f5-3838-9fc2-2839d974e07a",
                                        "glosses": [
                                            "Jouer avec un fusil de précision."
                                        ],
                                        "tags": [
                                            "Jeux vidéo"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da0dee32-5fb1-463b-8c40-d1cd1936ab69",
                                                "sense_id": "cc5fb28f-364e-32a4-8c80-1ad09a7ef7e6",
                                                "text": "Aujourd'hui, je vais sniper pour essayer d’améliorer ma précision."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce66b4f8-e1e0-3369-be71-c32b5fd6347c",
                                        "entry_id": "09ef4641-92f5-3838-9fc2-2839d974e07a",
                                        "glosses": [
                                            "Tuer un adversaire, généralement avec un fusil de précision, à longue distance."
                                        ],
                                        "tags": [
                                            "Jeux vidéo"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1871548-e78a-406b-8d48-2e38351b96e9",
                                                "sense_id": "ce66b4f8-e1e0-3369-be71-c32b5fd6347c",
                                                "text": "Je me suis fait sniper à l’autre bout de la carte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2ca42b3-b1a8-3c5c-b04d-3b7b08542815",
                                        "entry_id": "09ef4641-92f5-3838-9fc2-2839d974e07a",
                                        "glosses": [
                                            "Prendre quelqu'un sur le fait lorsqu’il ne s’y attend pas."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf281463-4c73-4ceb-a9b4-2a7da181feed",
                                                "sense_id": "f2ca42b3-b1a8-3c5c-b04d-3b7b08542815",
                                                "text": "Le prof a snipé un élève qui essayait de tricher."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
