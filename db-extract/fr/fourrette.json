                        "examples": [
                            {
                                "example_id": "ad03190d-d9c2-46f4-a7bf-f18ff0e9b2d6",
                                "sense_id": "be6ad041-14dc-33aa-adb1-ac280abd98a4",
                                "text": "Là où ça se complique, c’est pour la fourrette, les vilaines sont jamais disponibles aux bonnes heures, pourtant y’a pas d’autre boulot où le pétrissage de miches accapare autant."
                            },
                            {
                                "example_id": "ab855fdc-0549-4eb8-881b-aa41ad8fc224",
                                "sense_id": "be6ad041-14dc-33aa-adb1-ac280abd98a4",
                                "text": "J’ai un ticket avec la patronne du Transat. Tout à l’œil : à la fois l’anisette et la fourrette."
                            },
                            {
                                "example_id": "3c0fe4fa-c1f1-4f2a-82c5-b2a566641517",
                                "sense_id": "be6ad041-14dc-33aa-adb1-ac280abd98a4",
                                "text": "Cette fois, c’est plus la furia bramée, mais la fourrette langoureuse, juste ponctuée de soupirs, avec, çà et là, une légère exclamation de politesse."
                            },
                            {
                                "example_id": "139d27ed-4b48-4258-9454-7cf589d47db6",
                                "sense_id": "be6ad041-14dc-33aa-adb1-ac280abd98a4",
                                "text": "In petto, je me dis que cette Mélanie était un véritable shaker à foutre. Trois fourrettes et un bon coup de techno là-dessus, bonjour le cocktail !"
                            }
                        ]
                    }
