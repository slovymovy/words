                                                "example_id": "a6a254f9-df57-43a0-b48f-7e8f0a60066c",
                                                "sense_id": "a81cdd93-2ea2-3a20-b20f-d5fb93d59204",
                                                "text": "Gee, you didn't have to kick me!"
