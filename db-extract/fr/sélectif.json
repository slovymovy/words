                                        ]
                                    },
                                    {
                                        "sense_id": "8bca6d15-07ab-3b86-b77e-ddcaf9e814d5",
                                        "entry_id": "4711b71c-a889-335b-8abf-d8b51c5cc9cb",
                                        "glosses": [
                                            "Choosy, fussy or discriminating when selecting."
                                        ],
                                        "tags": [
                                            "of a person"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b07bce2-4b4e-4bd8-8f6d-e01b1a2d5828",
                                                "sense_id": "8bca6d15-07ab-3b86-b77e-ddcaf9e814d5",
