                    },
                    {
                        "translation_id": "22a05050-8d12-432b-94b6-7be5354b681c",
                        "source_entry_id": "228cc3f4-9b47-38f2-ab3e-7b66def96fb0",
                        "target_lang_word": "Novize",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Novize",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7329031e-178e-34da-a419-ab3d9406faa3",
                                        "entry_id": "2d82bdd8-e8ba-3eb5-8581-6694d38c3356",
                                        "glosses": [
                                            "Anwärter, der sich im Kloster auf das Leben als Ordensmann vorbereitet, aber noch keine zeitlichen oder ewigen Gelübde abgelegt hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f184daf3-57b1-4ccb-a740-2be334f80698",
                                                "sense_id": "7329031e-178e-34da-a419-ab3d9406faa3",
                                                "text": "Die Novizen erhalten durch einen Novizenmeister oder ein sonst dazu bestelltes Mitglied des Konvents mit feierlicher Profess Unterricht."
                                            },
                                            {
                                                "example_id": "62863b69-f424-4dd0-a3f7-ed6e653f482d",
                                                "sense_id": "7329031e-178e-34da-a419-ab3d9406faa3",
                                                "text": "Die meisten Jungen und Männer zwischen acht und 20 Jahren gehen als Novizen zeitweise in ein Kloster."
                                            },
                                            {
                                                "example_id": "a425bd95-f093-4bca-bd98-07887ebc1854",
                                                "sense_id": "7329031e-178e-34da-a419-ab3d9406faa3",
                                                "text": "Den Mönchen im elsässischen Trappisten-Kloster Oelenburg fehlt es an Nachwuchs. Ein frisch eingetroffener Novize ist ihre große Hoffnung."
                                            },
                                            {
                                                "example_id": "d6eff017-56ac-48d4-8950-4e380eea37ad",
                                                "sense_id": "7329031e-178e-34da-a419-ab3d9406faa3",
                                                "text": "Ein Zustrom junger Männer, oft mit Hochschulbildung und zu einem guten Teil aus dem ehemaligen Ostblock, hat die Reihen der Mönche und Novizen wieder dichter gefüllt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1a1ac62f-fb64-312e-8217-7b61019ea5c0",
                                        "entry_id": "2d82bdd8-e8ba-3eb5-8581-6694d38c3356",
                                        "glosses": [
                                            "Person, die neu in einem bestimmten Gebiet ist und noch keine besonderen Erfahrungen gesammelt hat"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d30fb384-596a-4ce6-b8e4-ff024be95e7c",
                                                "sense_id": "1a1ac62f-fb64-312e-8217-7b61019ea5c0",
                                                "text": "Josef Pröll, als Parteichef der ÖVP ähnlich ein Novize wie Faymann in der SPÖ, übertrumpft den Kanzler in allen nur denkbaren Kategorien."
                                            },
                                            {
                                                "example_id": "018b7e72-3e8a-4ad0-9480-4dce30422701",
                                                "sense_id": "1a1ac62f-fb64-312e-8217-7b61019ea5c0",
                                                "text": "Viel mehr Anknüpfungspunkte zwischen altem und neuem Job gibt es tatsächlich nicht – in der Ölbranche ist Svanberg ein Novize."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Novize",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8e6d9a88-442e-34ff-b5ee-1984925c3f86",
                                        "entry_id": "4133b681-3aac-37ad-9639-e31c7dd32919",
                                        "glosses": [
                                            "Frau, die bereits im Kloster lebt und sich auf das Leben als Ordensfrau vorbereitet, aber noch keine zeitlichen oder ewigen Gelübde abgelegt hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc951251-f7cb-419d-a08e-09aa1c63b19a",
                                                "sense_id": "8e6d9a88-442e-34ff-b5ee-1984925c3f86",
                                                "text": "Poggio staunt und nach einer Weile fragt er die Novize, ob sie nicht die Gertrude sei, von der ihm Hans von Splügen erzählt habe?"
                                            },
                                            {
                                                "example_id": "d0c87f26-a872-4e43-a532-20e878845817",
                                                "sense_id": "8e6d9a88-442e-34ff-b5ee-1984925c3f86",
                                                "text": "„Hier sollte sie einige Zeit unter dem Schirm der allgemein geachteten Frau leben, bis im Kloster Raum für die neue Novize gemacht, und sonst noch Manches, was vorher zu ordnen war, gethan seyn würde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bec007da-9eb5-36f8-9f50-a8fb7e2464bf",
                                        "entry_id": "4133b681-3aac-37ad-9639-e31c7dd32919",
                                        "glosses": [
                                            "weibliche Person, die neu in einem bestimmten Gebiet ist und noch keine besonderen Erfahrungen gesammelt hat"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3ecc4bb4-f188-437c-b2d5-e077a841b1ff",
                        "source_entry_id": "228cc3f4-9b47-38f2-ab3e-7b66def96fb0",
                        "target_lang_word": "novice",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "novice",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "84613212-e5f3-397e-ba35-c53563b9526b",
                                        "entry_id": "55d332f9-1300-3dde-a7e7-5967b01c6547",
                                        "glosses": [
                                            "Qui est peu exercé, peu expérimenté en une activité, un métier, une profession."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64351b12-49e9-4a58-87b8-7c4445a4633e",
                                                "sense_id": "84613212-e5f3-397e-ba35-c53563b9526b",
                                                "text": "Une fois remontée l’avenue de Paris, la commune avait installé d’un côté une vaste aire de jeux pour les enfants, regroupant les classiques balançoires, tape-fesses et structures décoratives, ainsi qu’un pumptrack pouvant accueillir divers amateurs, plus ou moins novices."
                                            },
                                            {
                                                "example_id": "b0a5720b-59b7-42ea-9612-c928c393f1e7",
                                                "sense_id": "84613212-e5f3-397e-ba35-c53563b9526b",
                                                "text": "Sur le port, les amateurs, des plus novices aux plus aguerris pourront se balader le long des mythiques tonneaux exposés en plein air et découvrir l’art de l’assemblage et du dodinage, pour comprendre comment est façonné ce célèbre vermouth !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d08bc93e-9ebe-3b04-8aca-4adbdd74a702",
                                        "entry_id": "55d332f9-1300-3dde-a7e7-5967b01c6547",
                                        "glosses": [
                                            "Personne qui n’a point encore la connaissance du monde."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f8f0a11-2bca-4a12-8c26-089de39cc3b5",
                                                "sense_id": "d08bc93e-9ebe-3b04-8aca-4adbdd74a702",
                                                "text": "Un jeune homme encore novice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94af6d15-bac8-3a61-b7aa-14d5c4d4a8c5",
                                        "entry_id": "55d332f9-1300-3dde-a7e7-5967b01c6547",
                                        "glosses": [
                                            "Se dit des choses prises pour la personne."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d24ce99-d73a-4f7d-971a-c168aad385a6",
                                                "sense_id": "94af6d15-bac8-3a61-b7aa-14d5c4d4a8c5",
                                                "text": "Une main, une plume novice."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "novice",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8a3253f7-199d-324f-bdfa-912bca92fa7c",
                                        "entry_id": "01e15445-bac2-3204-a03f-d7b5664b69bc",
                                        "glosses": [
                                            "Celui, celle qui a pris nouvellement l’habit de religion dans un monastère ou couvent pour y passer un temps d’épreuve avant de faire profession."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bc465a9-62d9-430c-8fce-b23149cc5c2c",
                                                "sense_id": "8a3253f7-199d-324f-bdfa-912bca92fa7c",
                                                "text": "Un jeune novice."
                                            },
                                            {
                                                "example_id": "21f95393-0892-48e5-a928-c5094c258fdf",
                                                "sense_id": "8a3253f7-199d-324f-bdfa-912bca92fa7c",
                                                "text": "La maîtresse des novices."
                                            },
                                            {
                                                "example_id": "e8c8785b-a119-488c-aabc-8b7d9185803e",
                                                "sense_id": "8a3253f7-199d-324f-bdfa-912bca92fa7c",
                                                "text": "Prendre l’habit de novice."
                                            },
                                            {
                                                "example_id": "0da33c4e-566d-410c-94dd-5dd7637e4a79",
                                                "sense_id": "8a3253f7-199d-324f-bdfa-912bca92fa7c",
                                                "text": "Et le silence revint brusquement tandis que les filles chuchotaient que le diable avait pris une novice pour l'emporter avant qu'elle ait pu mettre ses voiles blancs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6411d8cf-60b0-3cde-810d-4e001e599918",
                                        "entry_id": "01e15445-bac2-3204-a03f-d7b5664b69bc",
                                        "glosses": [
                                            "Qui a peu d'expérience ou de connaissances pour accomplir les tâches demandées."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22d09a6d-f33d-4fad-bd62-b4bdaa3fd2df",
                                                "sense_id": "6411d8cf-60b0-3cde-810d-4e001e599918",
                                                "text": "Il vient seulement d’entrer en fonctions, aussi a-t-il une ferveur de novice."
                                            },
                                            {
                                                "example_id": "261c86b0-c335-4c58-b087-f755979aaa3f",
                                                "sense_id": "6411d8cf-60b0-3cde-810d-4e001e599918",
                                                "text": "« …. Un pêcheur expérimenté y aura fort possiblement plus de succès qu’un novice », ajoutait-il."
                                            },
                                            {
                                                "example_id": "75f49f53-2a8e-4cd1-a2b1-3b9d69c31015",
                                                "sense_id": "6411d8cf-60b0-3cde-810d-4e001e599918",
                                                "text": "Ferveur de novice : L’empressement, l’ardeur qu’on met à remplir les obligations d’un nouvel état."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49c35f55-6bc5-3b98-b6d1-01f1c4deae62",
                                        "entry_id": "01e15445-bac2-3204-a03f-d7b5664b69bc",
                                        "glosses": [
                                            "Jeune marin mineur plus ancien que le mousse mais qui n’est pas encore matelot."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04c0782f-144a-4b9f-abef-e82557dbc21e",
                                                "sense_id": "49c35f55-6bc5-3b98-b6d1-01f1c4deae62",
                                                "text": "Le reste de l’équipage, composé d’officiers-majors, de maistrance, de matelots, de novices et de mousses, varie de trente-cinq à cinquante hommes, selon le tonnage du vaisseau."
                                            }
                                        ]
                                    }
                                ]
                            }
