                    {
                        "sense_id": "462f8b7a-cdbf-3e1e-93ac-c28d0438abe6",
                        "entry_id": "14b0c3a2-ddb4-36bc-8343-5d3cc8108b52",
                        "glosses": [
                            "Klebstoff aus stärkehaltigen Lebensmitteln und Wasser"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "722b5d18-a595-47d0-a917-06e3ddca8590",
                                "sense_id": "462f8b7a-cdbf-3e1e-93ac-c28d0438abe6",
                                "text": "„Charly pauste Maria und Josef und die Krippe und Ochs und Esel aus einem WeihnachtskrippenAusschneidebogen auf Laubsägebretter, sägte sie aus und klebte die farbigen Vorlagen mit Mehlpapp auf das Holz.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "7c0f7243-1e70-3606-b48c-bb9958d3d541",
                        "entry_id": "14b0c3a2-ddb4-36bc-8343-5d3cc8108b52",
                        "glosses": [
                            "No glosses available"
                        ],
                        "tags": [
                            "no-gloss"
                        ],
                        "examples": [
                            {
                                "example_id": "1633548a-1065-4f88-9770-5d52ecb7f21d",
                                "sense_id": "7c0f7243-1e70-3606-b48c-bb9958d3d541",
                                "text": "„Auch Matti nimmt kein Blatt vor den Mund und erzählt, wie er seinem vormaligen Herrn, Pappmann, der seinen Leuten nur Mehlpapp zu essen gab, rebellische Geister (d. h. rebellischen Geist) auf den Hof zauberte, die erst beim Geruch von Fleisch wieder Ruhe gaben (IV, 1617).“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
