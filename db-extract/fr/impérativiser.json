                "senses": [
                    {
                        "sense_id": "099a15e4-550b-3a3a-b26a-26a96b0aaac5",
                        "entry_id": "6cf7e960-c9ad-3701-b357-09be7d9db509",
                        "glosses": [
                            "Donner un caractère impératif à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ba3702b-6281-4773-8a0e-3a91ff5fccaf",
                                "sense_id": "099a15e4-550b-3a3a-b26a-26a96b0aaac5",
                                "text": "Ainsi, nous ne pourrons plus utiliser quoi que ce soit de récursif, et devrons tout “impérativiser”."
                            },
                            {
                                "example_id": "3bfc6c4f-8532-467c-ba7c-82e4470bc0bc",
                                "sense_id": "099a15e4-550b-3a3a-b26a-26a96b0aaac5",
                                "text": "il est question d'impérativiser les critères de la Charte de la Qualité (qualification des interprètes ou codeurs diplômés, coût de l'accessibilité , etc.)."
                            },
                            {
                                "example_id": "fd9374cc-96fd-45ac-89e2-63c23e92d570",
                                "sense_id": "099a15e4-550b-3a3a-b26a-26a96b0aaac5",
                                "text": "Mais ceci n’est pas surprenant, compte tenu du caractère pragmatique de ce qui détermine à la fois ce qui peut être un Ergatif et ce qui peut être impérativisé."
                            }
                        ]
                    }
