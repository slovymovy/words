                "translations": [
                    {
                        "translation_id": "9e6d4409-bb9f-430c-97de-80d22f29f42d",
                        "source_entry_id": "813ec22a-4a05-3d57-bd8a-62a656d2a91f",
                        "source_sense_id": "abdec7fe-7bbd-398c-8e79-1a379c6900f1",
                        "source_sense_description": "psychische Störung: Angst vor Menschen",
                        "target_lang_word": "anthropophobia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anthropophobia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "382c17f3-add9-36de-8378-4d9d62a823fa",
                                        "entry_id": "73e3d396-4a13-33fc-8683-95a67d576bbd",
                                        "glosses": [
                                            "A profound fear of human beings, or of human society."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "552becd2-5d8d-4238-b995-9a7bebe7796e",
                                                "sense_id": "382c17f3-add9-36de-8378-4d9d62a823fa",
                                                "text": "The affection is unlike anthropophobia, because this is characterized by dislike of men, and decided aversion to sexual intercourse."
                                            },
                                            {
                                                "example_id": "c923b590-084d-4b88-8fc6-96ef329deb70",
                                                "sense_id": "382c17f3-add9-36de-8378-4d9d62a823fa",
                                                "text": "It was when anthropophobia set in, when he was made uneasy by people who walked too close to him, that, sagely viewing his list and seeing how many phobias were now checked, he permitted himself to rest."
                                            },
                                            {
                                                "example_id": "8453c097-955e-4cc0-9d40-fb378ca8c7e7",
                                                "sense_id": "382c17f3-add9-36de-8378-4d9d62a823fa",
                                                "text": "He was suffering from anthropophobia, a typical Japanese symptom which shows alienation, and liberation, from the embracing community."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a13be8c8-5fd9-4fe6-8050-f09a64454f5f",
                        "source_entry_id": "813ec22a-4a05-3d57-bd8a-62a656d2a91f",
                        "source_sense_id": "abdec7fe-7bbd-398c-8e79-1a379c6900f1",
                        "source_sense_description": "psychische Störung: Angst vor Menschen",
                        "target_lang_word": "anthropophobie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anthropophobie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "539d1bfb-d650-3929-a034-86eb3af1b770",
                                        "entry_id": "e45219ca-9d80-31f4-a152-75dc00560f29",
                                        "glosses": [
                                            "Aversion pour les humains."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2cfff3ca-ea19-4f95-8f35-b79e22eb3aae",
                                                "sense_id": "539d1bfb-d650-3929-a034-86eb3af1b770",
                                                "text": "C’était en général assez bref, assez douloureux, mais cela lui donnait l’impression d’être encore humaine, ne fût-ce qu'en comparaison de l’anthropophobie du sociologue."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fe4aedda-7f71-4353-8ab7-daa03903d344",
                        "source_entry_id": "813ec22a-4a05-3d57-bd8a-62a656d2a91f",
