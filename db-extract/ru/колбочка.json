                    }
                ],
                "senses": [
                    {
                        "sense_id": "2ffaf27e-bdb5-3250-993a-98ba768f5bc3",
                        "entry_id": "fcab3eb5-2534-3b2c-a985-69bee1459daa",
                        "glosses": [
                            "небольшая колба"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1b01fee-8d96-4d3e-a754-8cf992881ed9",
                                "sense_id": "2ffaf27e-bdb5-3250-993a-98ba768f5bc3",
                                "text": "Трубочки из легкоплавкого стекла требуются для изготовления колбочек и пипеток."
                            }
                        ]
                    },
                    {
                        "sense_id": "95bbb293-8870-3ed5-99e3-27e6f1d708f7",
                        "entry_id": "fcab3eb5-2534-3b2c-a985-69bee1459daa",
                        "glosses": [
                            "анат. светочувствительный рецептор сетчатки глаза, возбуждающийся при ярком свете"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc37f351-04d4-42d6-8426-09d61f1113af",
                                "sense_id": "95bbb293-8870-3ed5-99e3-27e6f1d708f7",
                                "text": "Обычно в глазу есть три вида колбочек, и колбочки каждого вида содержат свой особый пигмент."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "96af6e33-f7d0-4c3a-953b-790fd7746234",
                        "source_entry_id": "fcab3eb5-2534-3b2c-a985-69bee1459daa",
                        "source_sense_description": "сосуд",
                        "target_lang_word": "retort",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "retort",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dd559a11-c01b-322a-92d0-085e02326008",
                                        "entry_id": "d11e11d4-f3a3-3cb8-8343-8836282228b0",
                                        "glosses": [
                                            "A sharp or witty reply, or one which turns an argument against its originator; a comeback."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f82e37f2-9a50-4d3b-9ad3-e15771d8c180",
                                                "sense_id": "dd559a11-c01b-322a-92d0-085e02326008",
                                                "text": "He countered her insult with a clever retort."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "retort",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "40ce7274-7c5b-3cd0-bfc5-a1d7c64d88e7",
                                        "entry_id": "2d32271f-2b1e-36db-b7f9-f14aa58f72fd",
                                        "glosses": [
                                            "To say something sharp or witty in answer to a remark or accusation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5c0699d-c74d-4b31-b8bf-304c4a7b7dad",
                                                "sense_id": "40ce7274-7c5b-3cd0-bfc5-a1d7c64d88e7",
                                                "text": "“It is a pity,” he retorted with aggravating meekness, “that they do not use a little common sense. The case resembles that of Columbus' egg, and is every bit as simple.[…]”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2bc8bb0-d70a-369e-a9a9-df443b10d26c",
                                        "entry_id": "2d32271f-2b1e-36db-b7f9-f14aa58f72fd",
                                        "glosses": [
                                            "To make a remark which reverses an argument upon its originator; to return, as an argument, accusation, censure, or incivility."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab29852a-22be-45ce-bd98-fdfe10114536",
                                                "sense_id": "a2bc8bb0-d70a-369e-a9a9-df443b10d26c",
                                                "text": "to retort the charge of vanity"
                                            },
                                            {
                                                "example_id": "12615b7a-dce6-4932-afb0-038280fcc94f",
                                                "sense_id": "a2bc8bb0-d70a-369e-a9a9-df443b10d26c",
                                                "text": "And with retorted scorn his back he turned."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1165e809-d855-3c86-8aff-c21ef62dbbd5",
                                        "entry_id": "2d32271f-2b1e-36db-b7f9-f14aa58f72fd",
                                        "glosses": [
                                            "To bend or curve back."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1fcfa779-28f5-4580-896a-22ff5a13cf42",
                                                "sense_id": "1165e809-d855-3c86-8aff-c21ef62dbbd5",
                                                "text": "a retorted line"
                                            },
                                            {
                                                "example_id": "06cd211c-7879-4318-8a28-5780e81a0a58",
                                                "sense_id": "1165e809-d855-3c86-8aff-c21ef62dbbd5",
                                                "text": "With retorted head, pruned themselves as they floated."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1b451ea-525f-3e46-a16c-9b28efc1cd2e",
                                        "entry_id": "2d32271f-2b1e-36db-b7f9-f14aa58f72fd",
                                        "glosses": [
                                            "To throw back; to reverberate; to reflect."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb38f23d-1089-4776-9845-e77c265a0294",
                                                "sense_id": "e1b451ea-525f-3e46-a16c-9b28efc1cd2e",
                                                "text": "As when his virtues, shining upon others, / Heat them and they retort that heat again / To the first giver."
                                            },
                                            {
                                                "example_id": "a51b4be5-44cb-45de-8ef7-9aa15b1ab66d",
                                                "sense_id": "e1b451ea-525f-3e46-a16c-9b28efc1cd2e",
                                                "text": "Glasses were filled, arresting the trooper on a theme of passion; the pariahdom of the country cop, whose self-respect is to retort the law's blackmail for blackmail levied on his self-respect."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "retort",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8be0a113-b4ef-3db6-95a9-9822b4f3dd4a",
                                        "entry_id": "27b58339-5c68-3215-8442-3912ac28573b",
                                        "glosses": [
                                            "A flask with a rounded base and a long neck that is bent down and tapered, used to heat a liquid for distillation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "435383bd-6d9e-483c-a567-9d6071ea26bc",
                                                "sense_id": "8be0a113-b4ef-3db6-95a9-9822b4f3dd4a",
                                                "text": "A large curved retort was boiling furiously in the bluish flame of a Bunsen burner, and the distilled drops were condensing into a two-litre measure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86940d79-253c-33fd-9e57-c0ff054c3cd5",
                                        "entry_id": "27b58339-5c68-3215-8442-3912ac28573b",
                                        "glosses": [
                                            "An airtight vessel in which material is subjected to high temperatures in the chemical industry or as part of an industrial manufacturing process, especially during the smelting and forging of metal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b96d90c2-68fa-314a-aa07-f8947cd588e4",
                                        "entry_id": "27b58339-5c68-3215-8442-3912ac28573b",
                                        "glosses": [
                                            "A pressure cooker."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98dc5a11-ec9c-49af-bd31-2d0e9a9040b6",
                                                "sense_id": "b96d90c2-68fa-314a-aa07-f8947cd588e4",
                                                "text": "The retort is above boiling water. Beneath is a furnace. To the right a man is removing the chips from which the camphor has been extracted."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6381c185-86e7-3c80-bc14-b51d1bf2b41a",
                                        "entry_id": "27b58339-5c68-3215-8442-3912ac28573b",
                                        "glosses": [
                                            "A crematory furnace."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "retort",
