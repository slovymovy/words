                "senses": [
                    {
                        "sense_id": "eb6f3aab-78a7-3a01-b23d-4893612b5de1",
                        "entry_id": "eb457faf-7a28-3237-8b93-6cc593953de1",
                        "glosses": [
                            "ritueel geoorloofd, volgens joodse spijswetten (joodse godsdienstige voorschriften) bereid (dus voedsel zonder varkensvlees) en daarom geschikt voor consumptie"
                        ],
                        "tags": [
                            "Jiddisch-Hebreeuws"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "77edea7c-fec4-377f-9670-def22b2163e2",
                        "entry_id": "eb457faf-7a28-3237-8b93-6cc593953de1",
                        "glosses": [
                            "'in de haak'"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87a46e85-bffa-46af-bdd3-9f89533675a8",
                                "sense_id": "77edea7c-fec4-377f-9670-def22b2163e2",
                                "text": "volgens mij is dit zaakje niet helemaal koosjer"
                            },
                            {
                                "example_id": "55242be2-77b7-4f63-b801-378107315e82",
                                "sense_id": "77edea7c-fec4-377f-9670-def22b2163e2",
                                "text": "Een jubileum waar niemand bij stil staat, verdient die naam misschien niet. Een herdenking met één deelnemer, dat klinkt niet koosjer. Toch grijp ik de gelegenheid, omdat het kinderboek dat precies 25 jaar geleden verscheen, met elke verhuizing mee mocht: Plinius Pinguïn (1990) van Boudewijn Büch (1948-2002), met tekeningen van Pauline Drost."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "316eb482-f73e-435c-b615-5457a16f5ad9",
                        "source_entry_id": "eb457faf-7a28-3237-8b93-6cc593953de1",
                        "target_lang_word": "koscher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "koscher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "76d24bb6-8e10-3f31-963d-ca52f928bac3",
                                        "entry_id": "3b23c8f8-7697-3e6b-89fe-816a3e88a8ba",
                                        "glosses": [
                                            "den jüdischen Speisegesetzen entsprechend rein und daher zum Verzehr erlaubt"
                                        ],
                                        "tags": [
                                            "jüdische Religion; Judaismus"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f21daefa-3a87-4e8f-95ff-d76c1780a558",
                                                "sense_id": "76d24bb6-8e10-3f31-963d-ca52f928bac3",
                                                "text": "„Aber ich kann beschwören, daß ich an Juden nie Fleisch verkauft habe, das nicht »koscher« (nach den rituellen Vorschriften erlaubt) war.“"
                                            },
                                            {
                                                "example_id": "fef5f24a-7de6-4a32-9113-fb1bef068f54",
                                                "sense_id": "76d24bb6-8e10-3f31-963d-ca52f928bac3",
                                                "text": "„Doch eigentlich geht es in dieser Geschichte um vier Männer, die eine ziemlich verrückte Geschäftsidee hatten: in der ostdeutschen Provinz koscheres Bier zu produzieren. \"Simcha\", das Pils aus Hartmannsdorf nahe Chemnitz, ist nach Auskunft des Deutschen Brauer-Bundes das einzige koschere Bier Deutschlands und \"erfährt ganz aktuell eine große Nachfrage\".“"
                                            },
                                            {
                                                "example_id": "91de4992-2a08-454f-acfa-591647605f1d",
                                                "sense_id": "76d24bb6-8e10-3f31-963d-ca52f928bac3",
                                                "text": "„Generell gesprochen ist die jüdische Küche sehr schmackhaft. Und das vor allem dank der koscher, das heißt: genau ausgesuchten und reinen Zutaten, die Standards genügen müssen, an denen selbst strenge Biobauernhöfe scheitern können.“"
                                            },
                                            {
                                                "example_id": "29f8c34a-7f26-40d4-b1be-601cbe94c5da",
                                                "sense_id": "76d24bb6-8e10-3f31-963d-ca52f928bac3",
                                                "text": "„Der israelische Rabbi Schlomo Mahfud erklärte die aus dem afrikanischen Tier hergestellten Produkte für koscher, wie die Tageszeitung Jediot Ahronot berichtete.[…]Giraffenfleisch ist nach den Regeln des Judentums koscher, weil die Tiere Wiederkäuer und Paarhufer sind.“"
                                            },
                                            {
                                                "example_id": "4bd969ab-c4ab-4220-85c2-c95866f3e77e",
                                                "sense_id": "76d24bb6-8e10-3f31-963d-ca52f928bac3",
                                                "text": "„Es war gar nicht so leicht, in Buenos Aires koscheres Fleisch zu bekommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "02b241e8-b99d-3ecb-9eb3-5ec74d18335b",
                                        "entry_id": "3b23c8f8-7697-3e6b-89fe-816a3e88a8ba",
                                        "glosses": [
                                            "in tadellosem Zustand; fehlerfrei; unbedenklich"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b17334d5-3191-4e5c-afbd-bce21f0080eb",
                        "source_entry_id": "eb457faf-7a28-3237-8b93-6cc593953de1",
                        "target_lang_word": "kosher",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kosher",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9a0840c7-2476-3bad-8983-2ec1a3332e8f",
                                        "entry_id": "569b4762-ed4a-30e4-9b84-6ce114ca2ef6",
                                        "glosses": [
                                            "Fit for use or consumption, in accordance with Jewish law (especially relating to food)."
                                        ],
                                        "tags": [
                                            "Judaism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db5ed7d2-5ab1-4da4-b737-f577b9f594fd",
                                                "sense_id": "9a0840c7-2476-3bad-8983-2ec1a3332e8f",
                                                "text": "Only in New York can you find a good, kosher hamburger!"
                                            },
                                            {
                                                "example_id": "b01acfe5-2247-4f2f-9db8-3ab38ecdc7e6",
                                                "sense_id": "9a0840c7-2476-3bad-8983-2ec1a3332e8f",
                                                "text": "David's mother kept a kosher kitchen, with separate sets of dishes for meat and for dairy."
                                            },
                                            {
                                                "example_id": "2bed2844-f49a-4aae-95fc-1da586f76908",
                                                "sense_id": "9a0840c7-2476-3bad-8983-2ec1a3332e8f",
                                                "text": "In order for a suit to be kosher, it cannot contain both wool and linen together."
                                            },
                                            {
                                                "example_id": "7cda442c-2744-48c4-976f-b682d39f210a",
                                                "sense_id": "9a0840c7-2476-3bad-8983-2ec1a3332e8f",
                                                "text": "Admirers of Israel’s kosher and nonkosher wines need the 2007 edition of “Rogov’s Guide to Israeli Wines” (Toby Press, $19.95)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7899d40-c4c0-3c21-a407-b5d640dc7c31",
                                        "entry_id": "569b4762-ed4a-30e4-9b84-6ce114ca2ef6",
                                        "glosses": [
                                            "Observant of the rules of kashrut (of a person or establishment)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99645633-d255-4ea6-b799-7ca537e5bf07",
                                                "sense_id": "d7899d40-c4c0-3c21-a407-b5d640dc7c31",
                                                "text": "\"Are you kosher?\" \"No, I love to eat scallops.\""
                                            },
                                            {
                                                "example_id": "3c499de0-6f16-4d26-90fe-45fd48985644",
                                                "sense_id": "d7899d40-c4c0-3c21-a407-b5d640dc7c31",
                                                "text": "\"Is this restaurant kosher?\" \"No, we serve pork.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "973e5a58-9d2b-3d3f-80d9-745d5fff715b",
                                        "entry_id": "569b4762-ed4a-30e4-9b84-6ce114ca2ef6",
                                        "glosses": [
                                            "In accordance with standards or usual practice."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2edc102-c27b-4345-b34a-fde870d01b74",
                                                "sense_id": "973e5a58-9d2b-3d3f-80d9-745d5fff715b",
                                                "text": "Is what I have done kosher with Mr. Smith?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "kosher",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c056446e-eba2-3290-955c-8ac4b1e363ca",
                                        "entry_id": "a852f7c6-02b0-3672-9892-4174854445d7",
                                        "glosses": [
                                            "In a kosher manner; in accordance with kashrut."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19c2579a-111f-4028-806c-d2aaf0ee0fa6",
                                                "sense_id": "c056446e-eba2-3290-955c-8ac4b1e363ca",
                                                "text": "Just like eating halal is not a choice for our Muslim brothers and sisters, for us, eating kosher is not voluntary; it’s who we are and as necessary as the oxygen we need for sustenance."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "kosher",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "745319d3-b1f5-3589-bfeb-79f0c4e24920",
                                        "entry_id": "94745b54-ba91-39d6-9597-558f1a59b4a6",
                                        "glosses": [
                                            "To kasher; to prepare (for example, meat) in conformity with the requirements of the Jewish law."
                                        ],
