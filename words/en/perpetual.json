                },
                {
                    "sense_id": "aae1f7a9-6aa1-3191-9307-f498ff819d94",
                    "sense_definition": "Occurring repeatedly or continuing without interruption.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "continuous",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The office was filled with the <w>perpetual</w> noise of ringing phones and typing.",
                            "target_lang_translations": {
                                "ru": "Офис был наполнен <w>постоянным</w> шумом телефонных звонков и стука клавиш.",
                                "tr": "Ofis, çalan telefonların ve yazı yazmanın <w>sürekli</w> gürültüsüyle doluydu."
                            }
                        },
                        {
                            "text": "He lived in a state of <w>perpetual</w> fear that his secret would be discovered.",
                            "target_lang_translations": {
                                "ru": "Он жил в состоянии <w>постоянного</w> страха, что его секрет будет раскрыт.",
                                "tr": "Sırrının ortaya çıkacağı <w>sürekli</w> korkusu içinde yaşıyordu."
                            }
                        }
