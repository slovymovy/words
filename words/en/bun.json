                            {
                                "target_lang_word": "ягодицы",
                                "target_lang_sense_clarification": "анатомический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "屁股",
                                "target_lang_sense_clarification": "口语称呼"
                            },
                            {
                                "target_lang_word": "臀部",
