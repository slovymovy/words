                "senses": [
                    {
                        "sense_id": "c21be21e-2ec2-39e7-a735-18ac0a9412d4",
                        "entry_id": "4ed2ff6d-6204-360d-a156-17a8ac8604e3",
                        "glosses": [
                            "eine Methode der Impfung, bei der der Impfstoff über den Mund aufgenommen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eaefb9b6-77cf-49b6-a1fb-131559ba627a",
                                "sense_id": "c21be21e-2ec2-39e7-a735-18ac0a9412d4",
                                "text": "Die Schluckimpfung wurde durch ein Stück Zuckerwürfel versüßt."
                            },
                            {
                                "example_id": "55728af8-d2da-4415-b8c1-11e57b3db859",
                                "sense_id": "c21be21e-2ec2-39e7-a735-18ac0a9412d4",
                                "text": "„Zur Schluckimpfung mußten wir uns in einer langen Schlange aufstellen.“"
                            },
                            {
                                "example_id": "fb637813-7954-4741-a794-911b2e28c6f9",
                                "sense_id": "c21be21e-2ec2-39e7-a735-18ac0a9412d4",
                                "text": "Bei den großen Impfkampagnen [gegen Polio, der Kinderlähmung] setzt die Weltgesundheitsorganisation auf die Schluckimpfung."
                            }
                        ],
                        "sense_index_json": "\"1\""
