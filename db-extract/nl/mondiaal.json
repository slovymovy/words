                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16ecf01a-fed7-4678-bdc7-6a6cf4d72081",
                                "sense_id": "9204068a-ac26-3e48-baf5-cc60f16f2070",
                                "text": "Politici gaan voorbij aan de echt belangrijke mondiale vraagstukken."
                            },
                            {
                                "example_id": "4e868be2-2445-43fe-9a3c-ca61d220ab60",
                                "sense_id": "9204068a-ac26-3e48-baf5-cc60f16f2070",
                                "text": "Terrorisme is een mondiaal probleem."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "938df60e-034f-4e63-ab2b-51d256737966",
                        "source_entry_id": "3ddc2806-1b14-370c-a24a-0a5ec98c7131",
                        "source_sense_id": "9204068a-ac26-3e48-baf5-cc60f16f2070",
                        "source_sense_description": "met betrekking tot of geldend voor de gehele wereld",
                        "target_lang_word": "global",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "global",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e952dd44-2633-3ff7-988d-889beeab0af7",
                                        "entry_id": "21507353-8795-3dce-a664-172738ea8ed7",
                                        "glosses": [
                                            "Concerning all parts of the world."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e84bd8d-b6f9-46ea-8cd8-46d3173253d2",
                                                "sense_id": "e952dd44-2633-3ff7-988d-889beeab0af7",
                                                "text": "Some rights are more global than others; social rights in particular do not seem to globalise easily."
                                            },
                                            {
                                                "example_id": "46c74395-9edc-46c8-8739-0b6610b0fea9",
                                                "sense_id": "e952dd44-2633-3ff7-988d-889beeab0af7",
                                                "text": "It is time the international community faced the reality: we have an unmanageable, unfair, distortionary global tax regime. It is a tax system that is pivotal in creating the increasing inequality that marks most advanced countries today […]."
                                            },
                                            {
                                                "example_id": "30b66d24-649e-4433-a34f-a8351c939af4",
                                                "sense_id": "e952dd44-2633-3ff7-988d-889beeab0af7",
                                                "text": "Pollution is a global problem."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02d45a81-b963-361b-bf0a-9057df314182",
                                        "entry_id": "21507353-8795-3dce-a664-172738ea8ed7",
                                        "glosses": [
                                            "Pertaining to the whole of something; total, universal"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "369006aa-e6d0-4a18-b842-ff878e8a2143",
                                                "sense_id": "02d45a81-b963-361b-bf0a-9057df314182",
                                                "text": "The first account that is created when you sign up is the global Administrator."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e77c209f-23c0-334d-b1f4-a9a03d99a7cc",
                                        "entry_id": "21507353-8795-3dce-a664-172738ea8ed7",
                                        "glosses": [
                                            "Pertaining to the whole of something; total, universal:",
                                            "Of a variable, accessible by all parts of a program."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a23cd5b-1a4d-4670-9ab0-ff5afda2f4d8",
                                                "sense_id": "e77c209f-23c0-334d-b1f4-a9a03d99a7cc",
                                                "text": "Global variables keep support engineers employed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f52e273c-0ed8-36a2-a931-f75b91f38323",
                                        "entry_id": "21507353-8795-3dce-a664-172738ea8ed7",
                                        "glosses": [
                                            "Pertaining to the whole of something; total, universal:",
                                            "Which has to be considered in its entirety."
