        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "a875ddcd-a6c1-3c58-9908-0fd471435898",
                "word": "Sonya",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "eff4ffe3-50a0-3e34-9ea1-c9015ef65f1d",
                        "entry_id": "a875ddcd-a6c1-3c58-9908-0fd471435898",
                        "glosses": [
                            "A female given name from Russian Соня (Sonja)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e790021b-30a2-4fd7-9a44-f4d79e489686",
                                "sense_id": "eff4ffe3-50a0-3e34-9ea1-c9015ef65f1d",
                                "text": "It was Valery who had named her firstborn Sonya, after the figure skater Sonja Henie. \"She moves through space so smoothly! She has such freedom!\" she explained to Ray, the child's father. \"Anything you want, honey,\" he replied, with a half-smile."
                            },
                            {
                                "example_id": "0ad3ce88-225a-4fd1-bce3-4cf8a13a591e",
                                "sense_id": "eff4ffe3-50a0-3e34-9ea1-c9015ef65f1d",
                                "text": "He said nothing, then asked, “Is Sonya your real name?”\n“Harinderjeet.”\n“A good name. A strong name.”\nHe could see her face in the bar's surface, frowning as she returned the card to her purse. “Is Sonya not a nice name?”\nHe felt her leaning in.\n“A sexy name?”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
