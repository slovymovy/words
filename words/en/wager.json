{
    "word_family": [
        "wage"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8c38af8a-8c11-357c-9192-8d884b218e3b",
                    "sense_definition": "An arrangement to risk money or other possessions on the outcome of an unpredictable event; a bet.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "betting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He placed a substantial <w>wager</w> on the outcome of the championship match.",
                            "target_lang_translations": {
                                "cs": "Na výsledek finálového zápasu uzavřel vysokou <w>sázku</w>."
                            }
                        },
                        {
                            "text": "She won her friendly <w>wager</w> after predicting the correct score.",
                            "target_lang_translations": {
                                "cs": "Vyhrála svou přátelskou <w>sázku</w>, když správně předpověděla skóre."
                            }
                        }
                    ],
                    "common_phrases": [
                        "place a wager",
                        "make a wager",
                        "win a wager",
                        "lose a wager"
                    ],
                    "target_lang_definitions": {
                        "cs": "Dohoda o vsazení peněz nebo jiného majetku na výsledek nejisté události; sázka."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "sázka",
                                "target_lang_sense_clarification": "dohoda o výsledku události"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d55fafcb-3e9f-3e5a-86e5-524ebc65b127",
                    "sense_definition": "The money or thing pledged as a stake in a bet.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "betting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The winner collected the total <w>wager</w> from the table after the round.",
                            "target_lang_translations": {
                                "cs": "Vítěz po skončení kola posbíral ze stolu celou <w>sázku</w>."
                            }
                        },
                        {
                            "text": "He risked his entire <w>wager</w> on a single spin of the wheel.",
                            "target_lang_translations": {
                                "cs": "Celý svůj <w>vklad</w> vsadil na jediné zatočení kolem."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Peníze nebo věc vložená do hry jako sázka; vklad."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "sázka",
                                "target_lang_sense_clarification": "vsazená částka"
                            },
                            {
                                "target_lang_word": "vklad",
                                "target_lang_sense_clarification": "finanční obnos vložený do hry"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cef50d6c-d448-306b-88ba-ea6ad5a55eef",
                    "sense_definition": "A formal contract or agreement between parties in which a sum of money is paid depending on an uncertain event.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "betting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The legal dispute concerned whether the signed agreement constituted an unlawful <w>wager</w>.",
                            "target_lang_translations": {
                                "cs": "Právní spor se týkal toho, zda podepsaná dohoda představovala nezákonnou <w>sázku</w>."
                            }
                        },
                        {
                            "text": "Under old statutes, an unwritten <w>wager</w> could not be enforced in court.",
                            "target_lang_translations": {
                                "cs": "Podle starých zákonů nebylo možné ústní <w>sázkovou smlouvu</w> vymáhat u soudu."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Formální dohoda či smlouva mezi stranami o vyplacení peněžité částky v závislosti na nejisté události."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "sázka",
                                "target_lang_sense_clarification": "smluvní sázka"
                            },
                            {
                                "target_lang_word": "sázková smlouva",
                                "target_lang_sense_clarification": "právní termín"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f4074b7-9ade-3e0c-bd7e-7db36c46cf64",
                    "sense_definition": "An offer or pledge to make a formal oath, especially in an archaic legal procedure.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "legal_oath",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The defendant sought to clear his name through a <w>wager</w> of law.",
                            "target_lang_translations": {
                                "cs": "Obžalovaný se snažil očistit své jméno pomocí <w>očistné přísahy</w>."
                            }
                        },
                        {
                            "text": "Such medieval procedures allowed the accused to produce a <w>wager</w> backed by witnesses.",
                            "target_lang_translations": {
                                "cs": "Tyto středověké postupy umožňovaly obviněnému složit <w>přísahu</w> podpořenou svědky."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wager of law"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in historical or legal contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Nabídka nebo závazek složit formální přísahu, zejména v historickém právním řízení."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "očistná přísaha",
                                "target_lang_sense_clarification": "historické právo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cd39a80b-8d6c-3ef3-a014-ad8c111bf5c3",
                    "sense_definition": "A person who engages in or carries out something, such as war or conflict.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "agent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient monarch was remembered as a relentless <w>wager</w> of destructive wars.",
                            "target_lang_translations": {
                                "cs": "Starověký panovník byl připomínán jako neúnavný <w>strůjce</w> ničivých válek."
                            }
                        },
                        {
                            "text": "She preferred peaceful diplomacy and was no <w>wager</w> of conflicts.",
                            "target_lang_translations": {
                                "cs": "Dávala přednost mírové diplomacii a nebyla žádnou <w>strůjkyní</w> konfliktů."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Osoba, která vede nebo rozpoutává něco, například válku nebo konflikt."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "strůjce války",
                                "target_lang_sense_clarification": "kdo vede válku"
                            },
                            {
                                "target_lang_word": "původce konfliktu",
                                "target_lang_sense_clarification": "kdo vede konflikt"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "df485c1b-7ed9-3d7d-a71d-b2822d9bbbf0",
                    "sense_definition": "To risk money or something of value on the unknown result of an event; to bet.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "betting_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to <w>wager</w> a hundred dollars on his favorite horse.",
                            "target_lang_translations": {
                                "cs": "Rozhodl se <w>vsadit</w> sto dolarů na svého oblíbeného koně."
                            }
                        },
                        {
                            "text": "They often <w>wager</w> small amounts just to make the game more exciting.",
                            "target_lang_translations": {
                                "cs": "Často <w>vsázejí</w> malé částky jen proto, aby byla hra napínavější."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wager on"
                    ],
                    "target_lang_definitions": {
                        "cs": "Riskovat peníze nebo něco cenného na nejistý výsledek nějaké události; vsadit (se)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "vsadit",
                                "target_lang_sense_clarification": "peníze na výsledek"
                            },
                            {
                                "target_lang_word": "vsadit si",
                                "target_lang_sense_clarification": "uzavřít sázku na něco"
                            },
                            {
                                "target_lang_word": "vsadit se",
                                "target_lang_sense_clarification": "uzavřít sázku s někým"
                            },
                            {
                                "target_lang_word": "uzavřít sázku",
                                "target_lang_sense_clarification": "vstoupit do sázky"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "36e0ab2f-e88e-3303-9175-0a6dec3b08bc",
                    "sense_definition": "To feel confident enough to guess or assume something; to dare say.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "supposition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I would <w>wager</w> that the train will be late again today.",
                            "target_lang_translations": {
                                "cs": "<w>Vsadil bych se</w>, že vlak bude mít dnes zase zpoždění."
                            }
                        },
                        {
                            "text": "She did not say anything, but I <w>wager</w> she knows the whole truth.",
                            "target_lang_translations": {
                                "cs": "Neřekla nic, ale <w>vsadím se</w>, že ví celou pravdu."
                            }
                        }
                    ],
                    "synonyms": [
                        "lay odds"
                    ],
                    "common_phrases": [
                        "wager that"
                    ],
                    "target_lang_definitions": {
                        "cs": "Být si natolik jistý, že si člověk troufá něco odhadnout či tvrdit; vsadit se (přeneseně)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "vsadit se",
                                "target_lang_sense_clarification": "být si jistý, troufat si tvrdit"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "5a9a8c97-26d0-3c57-a8e1-a343053344ef",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Wager</w> was invited to give a speech at the opening ceremony.",
                            "target_lang_translations": {
                                "cs": "Pan <w>Wager</w> byl vyzván, aby pronesl řeč na slavnostním zahájení."
                            }
                        },
                        {
                            "text": "Records indicate that the <w>Wager</w> family settled in this region during the eighteenth century.",
                            "target_lang_translations": {
                                "cs": "Záznamy naznačují, že se rodina <w>Wagerových</w> usadila v této oblasti v průběhu osmnáctého století."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Příjmení."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "Wager",
                                "target_lang_sense_clarification": "vlastní jméno / příjmení"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}