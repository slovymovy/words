                                            {
                                                "example_id": "84accdcd-5af2-4526-bf3f-ae8c09decf13",
                                                "sense_id": "301e1158-b358-3a2d-8205-ac261502bc63",
                                                "text": "J'ai épousé un gouer, un mécréant pas circoncis."
                                            },
                                            {
                                                "example_id": "60f24d9a-6f5c-4b27-9436-f791bf48d6e6",
                                                "sense_id": "301e1158-b358-3a2d-8205-ac261502bc63",
                                                "text": "Et là des Allemands ­emmènent Joseph aux toilettes pour voir s’il est circoncis. Et ils l’ont gardé."
                                            },
                                            {
                                                "example_id": "0d634088-640b-4d88-b62d-31c3f2ce5b8a",
                                                "sense_id": "301e1158-b358-3a2d-8205-ac261502bc63",
                                                "text": "Si vous n’êtes pas circoncis, tirez doucement le prépuce vers l’arrière pour découvrir le gland."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73cf50a5-a7e6-340a-a5f2-f71a4bff74a2",
                                        "entry_id": "fec957db-d6fe-3b58-af53-6b4541652877",
                                        "glosses": [
                                            "Juif."
                                        ],
                                        "tags": [
