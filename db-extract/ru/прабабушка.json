                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d4b50a81-b32d-4c39-8103-7f198e134d57",
                        "source_entry_id": "3599c4e9-fa23-3cd0-a630-81a5b190cd18",
                        "source_sense_id": "18155ff7-712c-3c14-8e95-902559ede198",
                        "target_lang_word": "Urgroßmutter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Urgroßmutter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5d1f7fad-5154-34aa-a266-66a3f77e2082",
                                        "entry_id": "cb9493ff-7d41-3e9a-884f-aa26c81b4bfa",
                                        "glosses": [
                                            "die Mutter des Großvaters oder der Großmutter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9c84c52-f314-48a6-9799-413e915d71f3",
                                                "sense_id": "5d1f7fad-5154-34aa-a266-66a3f77e2082",
                                                "text": "Ich habe keine Urgroßmutter mehr."
                                            },
                                            {
                                                "example_id": "3743dcb7-6f0f-4be0-aa80-5ff74f9dadd6",
                                                "sense_id": "5d1f7fad-5154-34aa-a266-66a3f77e2082",
                                                "text": "„Zum Glück ist da die sanfte, gebrechliche Urgroßmutter, die ihr von der Sklaverei erzählt und von den sechzehn Kindern, die sie von ihrem weißen Herrn bekommen hat.“"
                                            },
                                            {
                                                "example_id": "1acdb64c-1af8-491a-a2c6-d63f8422f16e",
                                                "sense_id": "5d1f7fad-5154-34aa-a266-66a3f77e2082",
                                                "text": "„Meine Großeltern und meine Urgroßmutter hatten schon 1930 ihre Heimat verlassen müssen, als immer mehr Muslime Opfer der Gewalt serbischer Nationalisten wurden.“"
                                            },
                                            {
                                                "example_id": "ce7c5863-59ee-49d5-bfa6-95d7fbb371b6",
                                                "sense_id": "5d1f7fad-5154-34aa-a266-66a3f77e2082",
                                                "text": "„Dort saß schon Urgroßvater Jacob, der zweite Mann von Horsts Urgroßmutter mütterlicherseits, mit seiner Machorka-Pfeife.“"
                                            },
                                            {
                                                "example_id": "57ad45fd-a188-4d97-a6f2-2fbaa4cbec02",
                                                "sense_id": "5d1f7fad-5154-34aa-a266-66a3f77e2082",
                                                "text": "„Oma Kreft allerdings schüttelt den Kopf, nachdem sie abwechselnd den Täufling und seine Urgroßmutter gemustert hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Urgroßmutter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c10f05f3-25d3-3211-a355-4651f8999585",
                                        "entry_id": "e1605fdf-77f5-32c8-852f-70cff2e4c66a",
                                        "glosses": [
                                            "(eigene) Urgroßmutter"
                                        ],
                                        "tags": [
                                            "familiär"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b019e0a-f2e0-45c0-ae68-7d9c4e332536",
                                                "sense_id": "c10f05f3-25d3-3211-a355-4651f8999585",
                                                "text": "Urgroßmutters Ungarischer Gulasch ist unschlagbar."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7e5fd99e-e6c1-4769-bef1-48071ce6d70a",
                        "source_entry_id": "3599c4e9-fa23-3cd0-a630-81a5b190cd18",
                        "source_sense_id": "18155ff7-712c-3c14-8e95-902559ede198",
                        "target_lang_word": "Uroma",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Uroma",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "03477b52-6478-3dcf-85aa-33242f3670b2",
                                        "entry_id": "8e3a06a1-7008-3c2d-aabe-25f54a2455a6",
                                        "glosses": [
                                            "Mutter eines Großelternteils"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0bdb41f8-9e76-4bb5-b232-59e49c9ec325",
                                                "sense_id": "03477b52-6478-3dcf-85aa-33242f3670b2",
                                                "text": "Meine Uroma habe ich nicht mehr kennengelernt, sie starb schon vor meiner Geburt."
                                            },
                                            {
                                                "example_id": "508520cb-a677-4044-98c8-680b96eaf4fb",
                                                "sense_id": "03477b52-6478-3dcf-85aa-33242f3670b2",
                                                "text": "„Uroma Mina war in den letzten Jahren richtig gebrechlich geworden.“"
                                            },
                                            {
                                                "example_id": "bc067fae-5984-4e7d-b45a-dd4d5d3df29a",
                                                "sense_id": "03477b52-6478-3dcf-85aa-33242f3670b2",
                                                "text": "„Meine Uroma Hedwig wurde von allen Heddel genannt,…“"
                                            },
                                            {
                                                "example_id": "a160f49d-201a-4c63-b789-cb7c7d210d65",
                                                "sense_id": "03477b52-6478-3dcf-85aa-33242f3670b2",
                                                "text": "„Es sind nicht viele Fotos, die Oma und Uroma als junges Mädchen zeigen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "21e601ad-660b-499c-87fc-59c96616ec29",
                        "source_entry_id": "3599c4e9-fa23-3cd0-a630-81a5b190cd18",
