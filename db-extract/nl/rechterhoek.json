                        "glosses": [
                            "plaats waar twee zijdes bij elkaar komen aan de rechterkant"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a80a5524-f9e7-4fdc-a1af-5f552a879e1c",
                                "sense_id": "22cb4516-5605-3ff6-8572-100808182825",
                                "text": "Al na dertig seconden wipte Abhishek de bal knap tussen twee Oranje-verdedigers door, die met z'n tweeën instapten, en schoof de bal rustig in de rechterhoek. Oranje liet zich er niet gek door maken en kwam na zeven minuten alweer op gelijke hoogte."
                            },
                            {
                                "example_id": "7805e84e-ad76-451c-8af7-3f2091304852",
                                "sense_id": "22cb4516-5605-3ff6-8572-100808182825",
                                "text": "Colombia was van tevoren dan ook bevreesd voor een afstraffing. Maar dat werd het in het broeierige Alajuela zeker niet. Bij de Duitse vrouwen ging veel mis en ze kwamen nauwelijks door de stugge defensie van Colombia heen. Drie minuten voor tijd viel de verdiende goal voor Colombia toen een schot van invalster Mariana Muñoz in de rechterhoek verdween."
                            }
                        ]
                    }
