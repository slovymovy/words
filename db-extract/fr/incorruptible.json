        "fr-extract.jsonl": [
            {
                "entry_id": "f15f225b-3bc8-37ea-aa2c-b48d473e6917",
                "word": "incorruptible",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f4e54021-86c9-461a-8b67-b668d13f05a3",
                        "entry_id": "f15f225b-3bc8-37ea-aa2c-b48d473e6917",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "incorruptibles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7f3b2ba2-29ac-3c09-99dd-ac8a88d1109d",
                        "entry_id": "f15f225b-3bc8-37ea-aa2c-b48d473e6917",
                        "glosses": [
                            "Qui n’est pas sujet à corruption."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff46c5fe-49ce-418b-86ab-5bb5dfffffe4",
                                "sense_id": "7f3b2ba2-29ac-3c09-99dd-ac8a88d1109d",
                                "text": "Bienheureux celui-là parmi tous les vivants !\nL’incorruptible sang coulera dans ses veines ;\nIl se réveillera sur les cimes sereines\nOù sont les Dieux, plus haut que la neige et les vents."
                            },
                            {
                                "example_id": "daed3775-5955-4579-8aff-b1853d9a339e",
                                "sense_id": "7f3b2ba2-29ac-3c09-99dd-ac8a88d1109d",
                                "text": "Une magnifique lumière, la lumière d’un beau jour verse ses ondes incorruptibles dans ce lieu sordide et éclaire cet homme. Au dehors, elle répand sa splendeur sur toutes les misères d’un quartier populeux."
                            },
                            {
                                "example_id": "f05e7b62-7fad-4b3e-910c-ca1020fee038",
                                "sense_id": "7f3b2ba2-29ac-3c09-99dd-ac8a88d1109d",
                                "text": "L’empire romain, centralisé, indiscuté et unique a ébaudi les barbares par une architecture colossale de pierre, donc incorruptible."
                            }
                        ]
                    },
                    {
                        "sense_id": "29e2dfa9-cd16-36c1-9629-28a93c487fbd",
                        "entry_id": "f15f225b-3bc8-37ea-aa2c-b48d473e6917",
                        "glosses": [
                            "Qui est incapable de se laisser corrompre pour agir contre son devoir."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "ca171250-f3ec-4712-9613-34e62e5bc828",
                                "sense_id": "29e2dfa9-cd16-36c1-9629-28a93c487fbd",
                                "text": "C’était la confidente toute particulière de Marguerite, qui n’avait aucun secret pour elle, et l’on prétendait qu’au nombre des mystères qu’enfermait son incorruptible fidélité il y en avait de si terribles que c’étaient ceux-là qui la forçaient de garder les autres."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "517bba6e-f974-4b87-ba4d-b593c27e7dc2",
                        "source_entry_id": "f15f225b-3bc8-37ea-aa2c-b48d473e6917",
                        "target_lang_word": "unbestechlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unbestechlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "409527e8-4c57-3bb5-b324-49d18843e5d5",
                                        "entry_id": "5833f345-a3f1-3731-a440-e6b4a77681e0",
                                        "glosses": [
                                            "nicht bestechlich, nicht zu bestechen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1383e7a5-a8f5-4ea4-99bb-f12064770a74",
                                                "sense_id": "409527e8-4c57-3bb5-b324-49d18843e5d5",
                                                "text": "„Er geißelte scharf jene Verräter des Volksglückes, die nicht unbestechlich sind, keine reinen Hände haben und ihre Kräfte, welche sie dem Dienste des bedrängten Vaterlandes weihen sollten, an Tändeleien der Liehe vergeuden.“"
                                            },
                                            {
                                                "example_id": "3d35e38f-860c-4f2c-9739-0dd78968e682",
                                                "sense_id": "409527e8-4c57-3bb5-b324-49d18843e5d5",
                                                "text": "„Es war eine schmerzliche Lehre, die ihm das Mädchen damals erteilt hatte; aber böse hatte Doktor Herzfeld ihr doch nicht sein können, als er sich von ihr abwandte. Denn er fühlte, daß jene eben unbestechlich war und um Vorteile nicht ihre Seele verkaufte, ihre junge Seele, die den anderen, den Ihrigen, der Jugend gehörte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "43f08b00-da9e-4179-ab36-7dbefb1f7480",
