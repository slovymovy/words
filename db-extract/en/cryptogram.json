                "senses": [
                    {
                        "sense_id": "e8eb1847-ed6b-35dc-9325-c19a07d3e3d0",
                        "entry_id": "529fca24-ddb1-33d4-aba5-2e12d7247e7f",
                        "glosses": [
                            "Encrypted text."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "912d6e2e-962e-41d7-8e48-78f486593737",
                                "sense_id": "e8eb1847-ed6b-35dc-9325-c19a07d3e3d0",
                                "text": "It's a big help in solving cryptograms if you know how a cryptogram is constructed. The constructor normally uses two alphabets, one for plaintext, one for the substitute cipher letters."
                            },
                            {
                                "example_id": "1bf6d5b4-f2ba-4d22-8323-b535fa2fba0f",
                                "sense_id": "e8eb1847-ed6b-35dc-9325-c19a07d3e3d0",
                                "text": "To anyone who does not know the key, the five characters of the cryptogram are different but the genuine receiver is in no danger of confusion."
                            },
                            {
                                "example_id": "0faa99a4-57f2-463e-b8fa-1d574155685c",
                                "sense_id": "e8eb1847-ed6b-35dc-9325-c19a07d3e3d0",
                                "text": "Indeed, Willaert was unable to read Charles's musical notation because it was actually a musical cryptogram passing for a madrigal, making absolutely no sense to a mere musician's naked eye, despite his towering talent."
                            }
                        ]
                    },
                    {
                        "sense_id": "a0373b19-e768-3154-ac5a-b41a06ce5876",
                        "entry_id": "529fca24-ddb1-33d4-aba5-2e12d7247e7f",
                        "glosses": [
                            "A type of word puzzle in which text encoded by a simple cipher is to be decoded."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b58ff596-c92e-4db1-a012-b58f973166ce",
                                "sense_id": "a0373b19-e768-3154-ac5a-b41a06ce5876",
                                "text": "You already know this if you are an amateur codebreaker. On the comics pages of many newspapers, you will find a little puzzle known as a cryptogram. It's usually a famous quotation that has been encrypted in a very straightforward way […]"
                            }
                        ]
                    }
