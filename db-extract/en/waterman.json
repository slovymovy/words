                        "entry_id": "a8d44f73-e78c-3767-aa5f-9711cca4ecd3",
                        "glosses": [
                            "A seaman, a sailor."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "308a456e-d6f8-3264-a8d5-9faafeff29f1",
                        "entry_id": "a8d44f73-e78c-3767-aa5f-9711cca4ecd3",
                        "glosses": [
                            "A man who lives or works on the water; a boatman."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c261802a-fc93-32b8-8308-1c9f073e1dde",
                        "entry_id": "a8d44f73-e78c-3767-aa5f-9711cca4ecd3",
                        "glosses": [
                            "Someone who distributes or supplies water for a living; a water-carrier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a19c12fd-6732-4659-a69a-51920fd00a82",
                                "sense_id": "c261802a-fc93-32b8-8308-1c9f073e1dde",
                                "text": "An elderly sheik shared this little ceremony with us, and afterwards benignly gave the waterman a coin and made him spurt scented water on his face and beard."
                            }
                        ]
                    },
                    {
                        "sense_id": "04e09587-a99f-38f9-bb29-f4151fe6a69e",
                        "entry_id": "a8d44f73-e78c-3767-aa5f-9711cca4ecd3",
                        "glosses": [
                            "Specifically, an attendant on cab stands who supplies water to the horses."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "24b048f7-3e78-4f0e-8afb-dd9382140f74",
                                "sense_id": "04e09587-a99f-38f9-bb29-f4151fe6a69e",
                                "text": "‘Here you are, sir,’ shouted a strange specimen of the human race, in a sackcloth coat, and apron of the same, who, with a brass label and number round his neck, looked as if he were catalogued in some collection of rarities. This was the waterman."
                            }
                        ]
                    },
