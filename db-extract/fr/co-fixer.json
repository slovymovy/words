                "senses": [
                    {
                        "sense_id": "68e9785d-db4f-3a2c-8857-21b567b4dc57",
                        "entry_id": "d21bb29d-94dd-390b-a0f4-83ba4b7c9613",
                        "glosses": [
                            "Variante de cofixer."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "3e8d076e-3f58-42ca-952e-4d5c2e53f8bb",
                                "sense_id": "68e9785d-db4f-3a2c-8857-21b567b4dc57",
                                "text": "Cette mission doit co-fixer, co-planifier et co-construire des moyens d'actions au service du projet de la personne accueillie."
                            },
                            {
                                "example_id": "38b62459-602f-4055-b409-c7e1abfbf472",
                                "sense_id": "68e9785d-db4f-3a2c-8857-21b567b4dc57",
                                "text": "Le cas échéant, co-fixer des objectifs scolaires et éducatifs."
                            },
                            {
                                "example_id": "97bbcb3f-1b2e-4ca3-9586-01c5d561bf04",
                                "sense_id": "68e9785d-db4f-3a2c-8857-21b567b4dc57",
                                "text": "Il était intéressant, en particulier, de se demander si le sérum de ces malades, des actinomycosiques par exemple, n'exerçait pas une action co-agglutinante ou co-fixatrice sur la sporotrichum, de la même façon que le sérum des sujets atteints d'affections paratyphoïdes peut co-agglutiner ou co-fixer le bacille d'Eherlh et inversement."
                            }
                        ]
                    }
                ],
