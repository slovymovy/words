                    {
                        "sense_id": "a1cdf134-dafc-3509-b048-6897a7334b8d",
                        "entry_id": "9b759ed1-be2b-31d5-b869-d4ab39e43fb4",
                        "glosses": [
                            "Autre orthographe de mollasse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "820aaa6f-b379-428d-b375-45e86a80918d",
                                "sense_id": "a1cdf134-dafc-3509-b048-6897a7334b8d",
                                "text": "Le portrait d'une femme avachie au teint pâle et à la posture molasse semble vouloir m'attirer par un sourire jocondesque."
                            },
                            {
                                "example_id": "0b62e9eb-8ee7-418b-b49f-217d1d21d8cd",
                                "sense_id": "a1cdf134-dafc-3509-b048-6897a7334b8d",
                                "text": "… il assume sans renâcler sa vie d'outil domestique, sorte de mollusque informe, poulpe molasse, étroniforme, …."
                            }
                        ]
                    }
                ],
