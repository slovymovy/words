                                        "entry_id": "b3b77ac2-b25f-3f8d-92a6-c43ae05272a9",
                                        "glosses": [
                                            "vylákání důvěrných údajů pomocí rozesílání podvodných e-mailů, za účelem okradení oběti"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d85195d0-1e3d-4b46-ba9b-585092c4fa91",
                                                "sense_id": "43373704-fce6-32cd-95e2-fdf1fc216a61",
                                                "text": "Před časem jsme se věnovali zrodu phishingu a padl slib, že se k tématu rhybaření ještě vrátíme. Phishing, tedy podsouvání návnad nic netušícím uživatelům s cílem získat jejich přístupové, osobní či platební údaje, patří totiž dnes k nejpopulárnějším aktivitám kybernetických zločinců a gangů."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "267f7cd4-237b-41da-9a57-9b2134dff5b1",
