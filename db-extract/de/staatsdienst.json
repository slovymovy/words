                        ],
                        "form": "die Staatsdienste"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6db2fa8d-73b9-3b8a-9b42-c39137666ee9",
                        "entry_id": "f1efb703-a7fc-3f42-b609-9f6bf68e0bc0",
                        "glosses": [
                            "berufliche Tätigkeit bei einer Institution des Staates"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0bde6a6c-c9a3-4d1b-b0fd-063180f311cf",
                                "sense_id": "6db2fa8d-73b9-3b8a-9b42-c39137666ee9",
                                "text": "„Ähnliche Berichte schickten US-Diplomaten aus Marokko, wo Dutzende Hochschulabsolventen campieren, um in den Staatsdienst übernommen zu werden…“"
                            },
                            {
                                "example_id": "4ad3860b-e09b-4411-a57e-31e229109a97",
                                "sense_id": "6db2fa8d-73b9-3b8a-9b42-c39137666ee9",
                                "text": "„Statt im Staatsdienst fanden sie sich in Staatsgefängnissen oder in Strafkolonien wieder.“"
                            },
                            {
                                "example_id": "688d961b-243e-4bc2-b509-6751493ebab8",
                                "sense_id": "6db2fa8d-73b9-3b8a-9b42-c39137666ee9",
                                "text": "„Es lag klar zu Tage, dass für den alten Grafen eine Stellung im Staatsdienst allein noch Rettung bedeuten konnte; so fuhr er nach Petersburg, um sich eine Stellung zu suchen und, wie er selbst sagte, den jungen Mädchen zum letzten Mal Gelegenheit zum Amüsement zu geben .“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "69d0bb7e-291b-4be5-8d9f-f57401284dc7",
                        "source_entry_id": "f1efb703-a7fc-3f42-b609-9f6bf68e0bc0",
                        "source_sense_id": "6db2fa8d-73b9-3b8a-9b42-c39137666ee9",
                        "source_sense_description": "berufliche Tätigkeit bei einer Institution des Staates",
                        "target_lang_word": "civil service",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "civil service",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3cb72696-ec00-3ad0-bc00-e9c135ff3915",
                                        "entry_id": "46cea67e-3aff-3031-93f9-7658095f4622",
                                        "glosses": [
                                            "In parliamentary forms of government, the branches of government that are not military, legislative, or judicial, but work to apply its laws and regulations."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e19431a3-9e64-33ea-9b5c-ff5e7f000a11",
                                        "entry_id": "46cea67e-3aff-3031-93f9-7658095f4622",
                                        "glosses": [
                                            "The body of civilian employees of any level of government, not subject to political appointment and removal, normally hired and promoted largely on the basis of competitive examination."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f4fe506c-2571-4c51-923f-03fde7aefba8",
                        "source_entry_id": "f1efb703-a7fc-3f42-b609-9f6bf68e0bc0",
                        "source_sense_id": "6db2fa8d-73b9-3b8a-9b42-c39137666ee9",
                        "source_sense_description": "berufliche Tätigkeit bei einer Institution des Staates",
                        "target_lang_word": "public service",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "public service",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "22d228fd-0230-35b6-9f7d-bc1a712208b2",
                                        "entry_id": "5a7c5138-fa0c-3c9e-a977-4e37a180bbbb",
                                        "glosses": [
                                            "A service performed for the public good."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b83b0bc-919f-4491-871b-e270731655bc",
                                                "sense_id": "22d228fd-0230-35b6-9f7d-bc1a712208b2",
                                                "text": "They feel that public service is a noble calling that calls for every citizen in one way or another."
                                            },
                                            {
                                                "example_id": "37c4111a-3442-4d7b-a02d-a75bbeab847c",
                                                "sense_id": "22d228fd-0230-35b6-9f7d-bc1a712208b2",
                                                "text": "They provide counseling as a public service."
                                            },
                                            {
                                                "example_id": "3ee9e9d9-bc5a-40b9-b208-02863c6d8a53",
                                                "sense_id": "22d228fd-0230-35b6-9f7d-bc1a712208b2",
                                                "text": "This has been a public service announcement from the Advertising Council."
                                            },
                                            {
                                                "example_id": "78654f6a-e9ac-44e8-8a2d-442bfca2217a",
                                                "sense_id": "22d228fd-0230-35b6-9f7d-bc1a712208b2",
                                                "text": "A Hypocrite may put on the World in many specious Duties, to the Ruin of the Public, but never can be a Condidate^([sic]) for Fame, without doing a Public Service, a general Good ev’n by the very Hypocrisy […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca2f95bb-62af-359b-a091-c183ec419e7a",
                                        "entry_id": "5a7c5138-fa0c-3c9e-a977-4e37a180bbbb",
                                        "glosses": [
                                            "A service such as health care, transport, or waste removal provided to the general public, often by the government."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30503d42-5bec-4fd7-8549-60a7e885a72d",
                                                "sense_id": "ca2f95bb-62af-359b-a091-c183ec419e7a",
                                                "text": "In order to grant the rich these pleasures, the social contract is reconfigured. The welfare state is dismantled. Essential public services are cut so that the rich may pay less tax. […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f79646d9-5161-38c0-850b-d31ad4ceeb52",
                                        "entry_id": "5a7c5138-fa0c-3c9e-a977-4e37a180bbbb",
                                        "glosses": [
                                            "The organisation, department or business providing such a service."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "66b9e020-a47e-3fb5-b364-315b8c144e0b",
                                        "entry_id": "5a7c5138-fa0c-3c9e-a977-4e37a180bbbb",
                                        "glosses": [
                                            "Government employment, especially in the civil service."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3342d12e-67d0-4db1-b308-018ef91e0297",
                                                "sense_id": "66b9e020-a47e-3fb5-b364-315b8c144e0b",
                                                "text": "In spite of more than three decades of public service, I knew I was an unknown quantity to many of my countrymen and to much of the world when I assumed office."
                                            },
                                            {
                                                "example_id": "33ecf36f-caad-4fa6-a735-ed5aa1a52594",
                                                "sense_id": "66b9e020-a47e-3fb5-b364-315b8c144e0b",
                                                "text": "We know that there are people in much lower offices in public service who adhere to those principles without question and without problems. Does my right hon. Friend find it regrettable that the Prime Minister does not?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
