                "forms": [],
                "senses": [
                    {
                        "sense_id": "89256909-9137-314a-b7e4-b7c975dcc71e",
                        "entry_id": "a0ba0d7d-6027-39b9-a506-3f79ae05799e",
                        "glosses": [
                            "An oblast or federal subject in Russia; an exclave on the Baltic Sea, between Poland and Lithuania."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "90c6f50d-ed61-312d-8a16-22a9a9bd77a9",
                        "entry_id": "a0ba0d7d-6027-39b9-a506-3f79ae05799e",
                        "glosses": [
                            "A city, the administrative center of Kaliningrad Oblast, Russia, formerly called Königsberg."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e47f4837-e15a-46ae-852a-e31baf50eaa8",
                                "sense_id": "90c6f50d-ed61-312d-8a16-22a9a9bd77a9",
                                "text": "As a second-year student at Kharkiv University, I took a summer job as a conductor of the train that ran from Novorossiysk on the Russian Black Sea coast to Kaliningrad in the Baltics - a 48-hour journey via Kharkiv, from where the train originated."
                            }
                        ]
                    }
                ],
