                                        "entry_id": "04f4f4c9-20d2-3a3c-98b9-c8b083f3c309",
                                        "glosses": [
                                            "Fluss in Tschechien, ein Nebenfluss der Elbe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5e8e06e-58fb-49ee-9408-ba242e8767d1",
                                                "sense_id": "b64ba75c-1e23-3948-a224-ffd703b90c10",
                                                "text": "Prag liegt an der Moldau."
                                            },
                                            {
                                                "example_id": "e5044866-36d7-4363-8b2c-eec38c4d4e1d",
                                                "sense_id": "b64ba75c-1e23-3948-a224-ffd703b90c10",
                                                "text": "In der Nähe von Mělník mündet die Moldau in die Elbe."
                                            },
                                            {
                                                "example_id": "8294a353-1718-4991-9d27-4244e55dabd3",
                                                "sense_id": "b64ba75c-1e23-3948-a224-ffd703b90c10",
                                                "text": "Wir überquerten die Moldau."
                                            },
                                            {
                                                "example_id": "ae408346-131e-41c2-b2bd-48c8f7777d07",
                                                "sense_id": "b64ba75c-1e23-3948-a224-ffd703b90c10",
                                                "text": "Die Kinder versuchten, in der Moldau zu baden."
                                            }
                                        ],
