                        "cross_references": [
                            {
                                "target_word": "Halloween",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "509c7b15-525b-3775-91b7-21895754371c",
                                        "entry_id": "62b02a7b-6b60-3eba-b015-18f2fccf53cc",
                                        "glosses": [
                                            "The eve of All Hallows' Day; October 31st; celebrated (mostly in English-speaking countries) by children going door-to-door in costume and soliciting candy with menaces."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "292e6f7c-7948-4c86-8227-5c3a63435e48",
                                                "sense_id": "509c7b15-525b-3775-91b7-21895754371c",
                                                "text": "They all get dressed up in scary costumes at Halloween."
                                            },
                                            {
                                                "example_id": "b58f05fd-5846-44cf-ab32-833c0a4510f0",
                                                "sense_id": "509c7b15-525b-3775-91b7-21895754371c",
                                                "text": "1987, Kai Hansen, \"Halloween\", Helloween, Keeper Of The Seven Keys: Part 1.\nBlack is the night full of fright / You'll be missing the day / What will be here very soon / Changing your way / A knock at your door / It is real or is it a dream / On trembling legs you open the door / And you scream... on Halloween"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d46b2449-b4c3-4d38-abb8-0eb949c91a12",
                        "source_entry_id": "8039c5cb-0a27-369b-8236-c438ae1b9610",
                        "source_sense_id": "a12de83f-1de4-3e47-9d8b-6d62c53b3130",
                        "target_lang_word": "Halloween",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "6e170d92-2574-4bc7-8520-3031610813ac",
                        "source_entry_id": "8039c5cb-0a27-369b-8236-c438ae1b9610",
                        "source_sense_id": "a12de83f-1de4-3e47-9d8b-6d62c53b3130",
                        "target_lang_word": "Halloween",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Halloween",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1a58d165-d79b-37d2-a9cd-87c688a9a634",
                                        "entry_id": "2c9f9de0-3fcb-3745-aa6f-aee2ed4963bc",
                                        "glosses": [
                                            "der Abend des 31. Oktobers, also der Vorabend von Allerheiligen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4163cd07-466c-4dc6-8705-23821fa65f9c",
                                                "sense_id": "1a58d165-d79b-37d2-a9cd-87c688a9a634",
                                                "text": "„In den letzten Jahren hat sich Halloween in Deutschland zu einer festen Tradition entwickelt.“"
                                            },
                                            {
                                                "example_id": "b60fdf26-2448-411b-8bc3-5255501bb634",
                                                "sense_id": "1a58d165-d79b-37d2-a9cd-87c688a9a634",
                                                "text": "„Auf jeden Fall hat die Popularisierung von Halloween auch den Kürbis wieder ganz nach vorne gebracht.“"
                                            },
                                            {
                                                "example_id": "e757ce99-bcb8-4ff3-852d-bbb8ffcfe08d",
                                                "sense_id": "1a58d165-d79b-37d2-a9cd-87c688a9a634",
                                                "text": "„Allen voran ist heute - als vermeintlich keltisches Erbe - Halloween sowohl in den USA als auch in Europa populär geworden.“"
                                            },
                                            {
                                                "example_id": "92eac4f5-3de1-4d09-a806-710712a299f4",
                                                "sense_id": "1a58d165-d79b-37d2-a9cd-87c688a9a634",
                                                "text": "„Jeder ist in diesen Tagen mit Halloween beschäftigt, dem großen amerikanischen Geisterfest, dem rituellen Übergang zu Dunkelheit, Kälte und Tod.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
