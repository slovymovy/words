                        "examples": [
                            {
                                "example_id": "8a8b037b-214d-4f4b-808a-c76dd3acef3a",
                                "sense_id": "c59169bc-423c-3da6-bdb3-9903abeba1e6",
                                "text": "Reddingsteams zoeken in het 316 meter diepe kratermeer naar overlevenden. De helikopter zou op 100 meter diepte liggen. Reddingswerkers hebben door de dichte mist moeite het gebied te bereiken."
                            },
                            {
                                "example_id": "7891cf23-ec81-4e2f-9f82-ba4e508831b2",
                                "sense_id": "c59169bc-423c-3da6-bdb3-9903abeba1e6",
                                "text": "De temperatuur van het kratermeer is in een paar weken tijd gestegen van 25 naar 46 graden Celsius. Het alarmeringsniveau voor de Ruapehu is bijgesteld van \"gemiddeld\" naar \"verhoogd onrustig\"."
                            }
                        ]
                    }
