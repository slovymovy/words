                    {
                        "sense_id": "1aaf07ca-c095-3d79-9758-7e23adef13d6",
                        "entry_id": "c5d4f9f4-e5ab-31ce-8cff-fdf525caa6ed",
                        "glosses": [
                            "Briefmarke, speziell für die Brieftaubenpost/Taubenpost"
                        ],
                        "tags": [
                            "Postwesen"
                        ],
                        "examples": [
                            {
                                "example_id": "ca370dee-2046-4945-9a16-7dfbd7871df6",
                                "sense_id": "1aaf07ca-c095-3d79-9758-7e23adef13d6",
                                "text": "„Die probeweise hergestellten Taubenpostbriefmarken zierten eine Brieftaube, die – wie auf den neuseeländischen Taubenpostmarken – einen Brief im Schnabel hielt..“"
                            },
                            {
                                "example_id": "7d01032b-fb7c-4395-9585-c581eadd5850",
                                "sense_id": "1aaf07ca-c095-3d79-9758-7e23adef13d6",
                                "text": "„Es wurde dafür 1898 sogar eine dreieckige Taubenpostmarke ausgegeben.“"
                            },
                            {
                                "example_id": "c34dde41-e9ac-4b5d-b9be-ab100a550bbf",
                                "sense_id": "1aaf07ca-c095-3d79-9758-7e23adef13d6",
                                "text": "„Taubenpostmarken der Great Barrier Pigeongram Agency und des Original Great Barrier Pigeongram Service aus dem 19. Jahrhundert sowie philatelistische Würdigung des 100. Jubiläums der Taubenpost von 1997 (…).“"
                            }
                        ],
