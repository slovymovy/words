                                "target_senses": [
                                    {
                                        "sense_id": "d139fbea-2bb0-3dac-b996-0818e1eb919e",
                                        "entry_id": "0a252941-c573-324b-afe3-47f43de31ff4",
                                        "glosses": [
                                            "Brei aus Kichererbsen mit verschiedenen Gewürzen und Ölen, der traditionell im arabischen Raum und Israel als Vorspeise mit Fladenbrot gegessen wird"
                                        ],
                                        "tags": [
                                            "orientalische Küche"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b90633da-ff56-436a-80e3-aa68fcd0c079",
                                                "sense_id": "d139fbea-2bb0-3dac-b996-0818e1eb919e",
                                                "text": "„Das Steak in Scheiben schneiden und zusammen mit dem Salat, der Kresse, dem Hummus und der sauren Sahne auf dem Wrap anrichten.“"
                                            },
                                            {
                                                "example_id": "c18ea376-41c5-412e-b04a-7d864e242c44",
                                                "sense_id": "d139fbea-2bb0-3dac-b996-0818e1eb919e",
                                                "text": "„Abends saßen alle zusammen bei einem großen Abendessen mit Hammelfleisch, Hummus und Tabouleh und schauten sich den Empfang des sächsischen Ministerpräsidenten beim Bildungsminister von Abu Dhabi an.“"
                                            },
                                            {
                                                "example_id": "1123bd1f-252b-4a7c-9052-aaffdcc2ae54",
                                                "sense_id": "d139fbea-2bb0-3dac-b996-0818e1eb919e",
                                                "text": "„Durch den Rauch des Spießbraters lief ich am Hummus-Mann vorüber, er schloß gerade sein Geschäft, denn es war schon Nachmittag, und Hummus ist das arabische Frühstück.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
