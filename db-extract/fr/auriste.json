                                "target_senses": [
                                    {
                                        "sense_id": "2a0ac7ce-8ef5-3189-8216-d5fdcdf2f41a",
                                        "entry_id": "f6f8b47c-dc45-3128-ad36-c4faf9b7e438",
                                        "glosses": [
                                            "A doctor specializing in otology."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f577d86b-e9c3-4673-b05a-3edf5c99eb60",
                                                "sense_id": "2a0ac7ce-8ef5-3189-8216-d5fdcdf2f41a",
                                                "text": "“We need to identify children early and provide them with hearing tools and training by the time they are 6 months,” said Dr. John Greinwald, a pediatric otologist at Cincinnati Children’s Hospital Medical Center."
                                            },
                                            {
                                                "example_id": "c1ba9b32-6aeb-4cb7-8929-b555635563cf",
                                                "sense_id": "2a0ac7ce-8ef5-3189-8216-d5fdcdf2f41a",
                                                "text": "Today's teenagers are siphoning dangerous levels of membrane-damaging noise directly into their eardrums, with long-term effects that otologists prophesy will be disastrous for their hearing and lead to an epidemic of middle-aged deafness in the next thirty years."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e4f317e3-ca44-455c-b51f-9502f6a0a912",
                        "source_entry_id": "e5c6c7fc-efad-39b7-b1c0-105f1d26a871",
                        "source_sense_id": "ad255a5a-48b0-3ba6-8718-7342b3c748ee",
                        "target_lang_word": "otólogo",
