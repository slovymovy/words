                        "source_entry_id": "83474d12-8538-350a-aaf9-563417218ba1",
                        "source_sense_id": "1f299179-ef27-38c9-a7e2-b601599cea0e",
                        "target_lang_word": "theosophic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "theosophic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1b07f2b0-2225-3085-9460-eb7661e94a05",
                                        "entry_id": "9c091f54-b1bc-320f-bd55-1f6ec0304e11",
                                        "glosses": [
                                            "Of, or relating to theosophy."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b520167-34ec-4092-8492-4369be592e5d",
                                                "sense_id": "1b07f2b0-2225-3085-9460-eb7661e94a05",
                                                "text": "Thus, while the mystic of the theopathetic species is content to contemplate, to feel, or to act, suffering under Deity in his sublime passivity, the mysticism I term theosophic aspires to know and believes itself in possession of a certain supernatural divine faculty for that purpose."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5a13c9c4-da5b-4381-ab22-4f224888fd85",
                        "source_entry_id": "83474d12-8538-350a-aaf9-563417218ba1",
                        "source_sense_id": "1f299179-ef27-38c9-a7e2-b601599cea0e",
                        "target_lang_word": "théosophique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "théosophique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "44ab6264-37d1-3300-97c0-adc3e59c3687",
                                        "entry_id": "3c153604-78dd-3e86-8dc1-9aa564180812",
                                        "glosses": [
                                            "Qui appartient à la théosophie, aux théosophes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa893c9e-6fc8-47e9-87be-4aea3d67d537",
                                                "sense_id": "44ab6264-37d1-3300-97c0-adc3e59c3687",
                                                "text": "Cependant, les démons transcendants à proprement parler, les esprits sans chair ni sang, ne rencontrent aucune croyance, même chez le nazi, et lorsqu’ils semblent la trouver ailleurs, dans les cercles théosophiques, alors ce n’est plus l’authentique, la mystique, l’ancienne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
