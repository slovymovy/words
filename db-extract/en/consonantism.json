                        "entry_id": "31cd99b1-787f-38c0-b639-9bf9579e1567",
                        "glosses": [
                            "The consonant system of a language or dialect."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "2d842b33-7eb8-3fc1-a5d0-a8b4bed84589",
                        "entry_id": "31cd99b1-787f-38c0-b639-9bf9579e1567",
                        "glosses": [
                            "The consonants, sequence of consonants, or the quality peculiar to the consonants of a given word or group of words."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "266214c7-d4fa-4c5c-a12e-244d098ea578",
                                "sense_id": "2d842b33-7eb8-3fc1-a5d0-a8b4bed84589",
                                "text": "Still unexplained are geminate *-ll- in type 4, and the aberrant consonantism in type 3, where the *-r- found in the other forms appears to have been replaced with *-θ-"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8e8d9364-6189-40bd-86ad-4816ef1b0694",
                        "source_entry_id": "31cd99b1-787f-38c0-b639-9bf9579e1567",
                        "source_sense_description": "consonant sounds of a language",
                        "target_lang_word": "Konsonantismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Konsonantismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bbc4fe89-4ff3-39aa-addb-255be4844f5c",
                                        "entry_id": "cb90b7a7-2b42-3eb1-879e-ed11f4d9c8dc",
                                        "glosses": [
                                            "Menge oder System der Konsonanten einer Sprache oder einer sprachlichen Einheit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2251e85-66b6-4480-81c1-b2d00058f8fa",
                                                "sense_id": "bbc4fe89-4ff3-39aa-addb-255be4844f5c",
                                                "text": "„Den Gesamtbestand der Vokale einer Sprache, auch den Vokalbestand eines Wortes, nennt man häufig Vokalismus; entsprechend verwendet wird Konsonantismus.“"
                                            },
                                            {
                                                "example_id": "da1391b5-f288-4dea-8a06-71fc80ffcaeb",
                                                "sense_id": "bbc4fe89-4ff3-39aa-addb-255be4844f5c",
                                                "text": "„Im Mittelpunkt des sprachhistoriographischen Interesses bezüglich der Veränderungen des Konsonantismus steht für diese Epoche und darüber hinaus für die gesamte (hoch)deutsche Sprachgeschichte die II. Lautverschiebung.“"
                                            },
                                            {
                                                "example_id": "c139f33f-e927-42b4-b86f-5af3ff262fd8",
                                                "sense_id": "bbc4fe89-4ff3-39aa-addb-255be4844f5c",
                                                "text": "„Zwei in demselben Wort stehende ähnliche oder (vor allem im Konsonantismus) gleiche Silben bzw. Wortstücke können »Silbenschichtung« (Haplologie) erleiden, d. h. das eine der beiden gleichartigen Elemente wird ausgestoßen.“"
                                            },
                                            {
                                                "example_id": "3c6c69be-d431-4710-9a71-0a0da84a9c23",
                                                "sense_id": "bbc4fe89-4ff3-39aa-addb-255be4844f5c",
                                                "text": "„Die zwei hier beschriebenen Gegensätze bilden den minimalen Konsonantismus, der in keiner lebendigen Völkersprache fehlen darf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
