                                "target_lang_word": "抓获",
                                "target_lang_sense_clarification": "逮捕"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "choper",
                                "target_lang_sense_clarification": "attraper (familier)"
                            },
                            {
                                "target_lang_word": "coincer",
                                "target_lang_sense_clarification": "arrêter (familier)"
                            }
                        ]
                    }
                }
            ]
        },
        {
