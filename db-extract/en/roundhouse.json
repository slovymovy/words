        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "2e2d7fab-4c28-3014-9b8e-3eb12db16729",
                "word": "roundhouse",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "a91328f6-7e6a-4bb5-9982-a2c29a3a9668",
                        "entry_id": "2e2d7fab-4c28-3014-9b8e-3eb12db16729",
                        "tags": [
                            "plural"
                        ],
                        "form": "roundhouses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "462a5ec5-fadb-39c6-b685-3e076ca8f043",
                        "entry_id": "2e2d7fab-4c28-3014-9b8e-3eb12db16729",
                        "glosses": [
                            "A circular prison, especially a small local lockup or station house."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42c4fc25-96e5-41ca-8a8d-8e11afdfcc46",
                                "sense_id": "462a5ec5-fadb-39c6-b685-3e076ca8f043",
                                "text": "[T]he gentlemen in the coffee room insisted upon the watch being called, or a constable. With considerable difficulty the two heroes were carried off to the round-house, and there lodged for the night."
                            }
                        ]
                    },
                    {
                        "sense_id": "a53cb2fb-333c-3683-aa49-1faf01ce16de",
                        "entry_id": "2e2d7fab-4c28-3014-9b8e-3eb12db16729",
                        "glosses": [
                            "The uppermost room or cabin of any note upon the stern of a ship."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "377d8274-9e8a-3a08-9ecb-5c40ad4c4949",
                        "entry_id": "2e2d7fab-4c28-3014-9b8e-3eb12db16729",
                        "glosses": [
                            "A privy near the bow of a vessel, especially as reserved for officers."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "94e9f562-8722-3807-9f52-a0576930ae4c",
                        "entry_id": "2e2d7fab-4c28-3014-9b8e-3eb12db16729",
                        "glosses": [
                            "A circular building in which locomotives are housed, sometimes with a turntable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "209c38f9-af23-419a-8731-7ad6ac6604b4",
                                "sense_id": "94e9f562-8722-3807-9f52-a0576930ae4c",
                                "text": "Crewe North Motive Power Depot is to be modernised completely. This includes the provision of a new coaling plant, ash handling plant, and two new locomotive sheds of the latest roundhouse type, each with 32 roads radiating from a 70-ft. dia. turntable."
                            },
                            {
                                "example_id": "4953f1f6-b774-41c6-8e1b-ef95f26aaa27",
                                "sense_id": "94e9f562-8722-3807-9f52-a0576930ae4c",
                                "text": "Archaeologists working on HS2 in Birmingham have uncovered the remains of what is believed to be the world's oldest railway roundhouse at Curzon Street station."
                            }
                        ]
                    },
                    {
                        "sense_id": "8929af08-cde2-3e25-aad4-05768e2d20f1",
                        "entry_id": "2e2d7fab-4c28-3014-9b8e-3eb12db16729",
                        "glosses": [
                            "A prehistoric dwelling typical of northwest Europe in the Iron Age and Bronze Age."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4383d52-43a1-4392-9c2a-223af29e65f6",
                                "sense_id": "8929af08-cde2-3e25-aad4-05768e2d20f1",
                                "text": "A central stone slab cist containing the burial was surrounded by a circles of stones placed on edge, probably to represent the round house in which the deceased had lived."
                            }
                        ]
                    },
                    {
                        "sense_id": "5e114a58-92e7-385e-b6aa-76859bc8d532",
                        "entry_id": "2e2d7fab-4c28-3014-9b8e-3eb12db16729",
                        "glosses": [
                            "A punch or kick delivered with an exaggerated sweeping movement."
                        ],
                        "tags": [
                            "US"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "cf2fcc40-45f8-3c05-a4c6-950fdaaa73d6",
                        "entry_id": "2e2d7fab-4c28-3014-9b8e-3eb12db16729",
                        "glosses": [
                            "In the game of pinochle, a meld consisting of a queen and king in each of the four suits."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
