                        "examples": [
                            {
                                "example_id": "311d2633-041a-4748-82c4-5a4fb6264840",
                                "sense_id": "0cb4a115-5d78-3fe1-9479-a6fd7a54f7e7",
                                "text": "Dat is toch al een reden om blij te zijn, nietwaar?' Hij lacht en gaat verder voor Mia kan reageren: 'Gelukkig zijn er nu moderne methoden om inzicht te verwerven die in de plaats kunnen komen van bekentenissen. In twee woorden: zorgvuldige informatievergaring."
                            },
                            {
                                "example_id": "6b6f06d8-555c-4cb0-ac97-78a7e1cf94ad",
                                "sense_id": "0cb4a115-5d78-3fe1-9479-a6fd7a54f7e7",
                                "text": "Daarover zegt het hof: \"Over de massale instroom van vluchtelingen in Nederland vond een publiek debat plaats. De vrijheid van informatievergaring werd door de weigering van COA om PowNed toegang te verlenen, zodanig beperkt, dat voor de verzwijging door de journaliste van haar hoedanigheid een voldoende zwaarwegende reden bestond.\""
                            },
                            {
                                "example_id": "3de77226-3462-45a4-8fc9-760c4be8698d",
                                "sense_id": "0cb4a115-5d78-3fe1-9479-a6fd7a54f7e7",
                                "text": "Ook adviseerde hij volgens Struijs minister Ard van der Steur van Veiligheid en Justitie over meer en slimmere informatievergaring via 'sensoren', zoals mobiele telefoons en camera's."
                            }
                        ]
                    }
