                "senses": [
                    {
                        "sense_id": "00ecbeb6-e53e-35a5-ab77-b5f8232a3103",
                        "entry_id": "f2e84028-5509-35cc-a5c9-23fb4119f6b2",
                        "glosses": [
                            "Gliedsatz, speziell Adverbialsatz (Umstandssatz), der einen Grund, eine Ursache angibt"
                        ],
                        "tags": [
                            "special"
                        ],
                        "examples": [
                            {
                                "example_id": "cefe8530-d3a1-45c5-bd3a-c1b5b2c646e0",
                                "sense_id": "00ecbeb6-e53e-35a5-ab77-b5f8232a3103",
                                "text": "In dem Satz „Ich komme, weil ich dir helfen will“ ist der Gliedsatz „weil ich dir helfen will“ ein Kausalsatz; er gibt Grund/Ursache für das Kommen an. Viele Kausalsätze werden mit „da“ oder „weil“ eingeleitet."
                            },
                            {
                                "example_id": "356b9640-93a8-4753-a312-8bafa0f8cf16",
                                "sense_id": "00ecbeb6-e53e-35a5-ab77-b5f8232a3103",
                                "text": "„Der Kausalsatz enthält den tatsächlichen Grund, warum sich der im Trägersatz wiedergegebene Sachverhalt vollzieht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
