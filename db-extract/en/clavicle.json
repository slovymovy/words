                ],
                "senses": [
                    {
                        "sense_id": "e00e410c-f29d-33ea-82e1-68955b02309c",
                        "entry_id": "8678580a-a24d-354c-8861-72967c540254",
                        "glosses": [
                            "The collarbone; the prominent bone at the top of the chest between the shoulder and the neck connecting the shoulder and the breastbone."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da2acf06-5fb6-4803-8ca6-91e22e362473",
                                "sense_id": "e00e410c-f29d-33ea-82e1-68955b02309c",
                                "text": "Mr. Trump then used his free hand to lunge towards Bobby Engel, and, when Mr. Ornato had recounted the story to me, he had motioned towards his clavicles."
                            },
                            {
                                "example_id": "fea59d2d-89d5-4d81-90b9-ee0dcf6af3e8",
                                "sense_id": "e00e410c-f29d-33ea-82e1-68955b02309c",
                                "text": "And you worked a lot too. You were thin from biking around all day; your protruding clavicles collected rainwater."
                            }
                        ]
                    },
                    {
                        "sense_id": "fbeed80f-eec2-3e13-875f-866fbd3ec561",
                        "entry_id": "8678580a-a24d-354c-8861-72967c540254",
                        "glosses": [
                            "The upper part of a spiral shell."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "ee4c446c-2bff-4db3-9cf5-8b2e4f0158f6",
                                "sense_id": "fbeed80f-eec2-3e13-875f-866fbd3ec561",
                                "text": "The Voluta is a ſimple ſhell, having no hinge, formed of one piece, and of a figure approaching to conic, but short; the clavicle being uſually depreſſed, in all very ſhort: the mouth is long, perpendicular, and narrow: the animal inhabiting this ſhell is a limax."
                            }
                        ]
                    }
                ],
