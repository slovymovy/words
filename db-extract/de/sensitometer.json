                                "example_id": "9f74bb8d-026f-4f4d-88aa-19bbc5562af5",
                                "sense_id": "2812c444-39b7-3662-a275-6b7040c20eb8",
                                "text": "„Beim Erstellen einer Filmkennlinie wird mit Hilfe eines Sensitometers eine Folge von abgestuften Belichtungen realisiert und auf den Film aufbelichtet.“"
                            },
                            {
                                "example_id": "ca7befd1-2512-4bdc-982b-ec63ce75d77d",
                                "sense_id": "2812c444-39b7-3662-a275-6b7040c20eb8",
                                "text": "„Zur Belichtung bedient man sich eines Sensitometers, das einen Stufenkeil mit 21 verschiedenen Schwärzungsfeldern besitzt.“"
                            }
                        ],
