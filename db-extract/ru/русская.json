                "senses": [
                    {
                        "sense_id": "28cb89b1-708c-36f5-8784-dd605975f22b",
                        "entry_id": "790cca83-a803-370d-bdd9-f6ddc4da83cc",
                        "glosses": [
                            "женск. к русский; представительница восточнославянского народа, составляющего самый многочисленный коренной народ России"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4ab304e-18d3-4f83-a9ef-b5e7328cadad",
                                "sense_id": "28cb89b1-708c-36f5-8784-dd605975f22b",
                                "text": "Мой дед первый перешёл из магометанства в христианство и женился на русской."
                            },
                            {
                                "example_id": "6ace0518-54bd-4344-99cd-eeaba12d61f0",
                                "sense_id": "28cb89b1-708c-36f5-8784-dd605975f22b",
                                "text": "Ведь англичанка не похожа на француженку, немка на русскую, а у ней и меняется лицо, и все одно лицо, ― какая странная!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
