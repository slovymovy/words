                    {
                        "translation_id": "6fbc938d-03be-4243-bc5d-8c06caa5aa7a",
                        "source_entry_id": "f6e82419-146b-321a-b4d9-0e4803ddda0f",
                        "source_sense_description": "object-oriented programming",
                        "target_lang_word": "ковариантность",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ковариантность",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "ddc46df5-e155-395e-8bb3-c54c6329c9f8",
                                        "entry_id": "2feefbc8-d57b-385d-8229-f0fe4e30bf0e",
                                        "glosses": [
                                            "матем., физ., филос. свойство по значению прилагательного ковариантный; сопряжённая изменчивость"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a0e100b-3a3a-4c7c-937a-0396c4caf4c5",
                                                "sense_id": "ddc46df5-e155-395e-8bb3-c54c6329c9f8",
                                                "text": "Ясно, что из принципа относительности вытекает ковариантность уравнений, но обратное не имеет места: ковариантность дифференциальных уравнений возможна и тогда, когда принцип относительности не выполняется."
                                            },
                                            {
                                                "example_id": "a4ba004f-eaf8-4e1e-af9f-deb2c010ffc4",
                                                "sense_id": "ddc46df5-e155-395e-8bb3-c54c6329c9f8",
                                                "text": "В физике установлена ковариантность законов природы относительно преобразований Лоренца."
                                            },
                                            {
                                                "example_id": "a187374e-1d58-4f12-9eca-4b45c26f2bca",
                                                "sense_id": "ddc46df5-e155-395e-8bb3-c54c6329c9f8",
                                                "text": "Математическим выражением принципа относительности является свойство ковариантности основных законов механики по отношению к преобразованиям Галилея. Под «ковариантностью» понимается следующее: все входящие в формулы величины обладают определёнными трансформационными свойствами по отношению к рассматриваемым преобразованиям и обе части выражающих эти законы равенств преобразуются одинаково, поэтому из справедливости равенства в одной инерциальной системе отчёта автоматически следует, что это равенство будет справедливым и в любой другой инерциальной системе, как и требует принцип относительности."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ac028a5-ad7c-396c-8c65-ad68702fe118",
                                        "entry_id": "2feefbc8-d57b-385d-8229-f0fe4e30bf0e",
                                        "glosses": [
                                            "прогр. сохранение иерархии наследования исходных типов в производных типах в том же порядке"
                                        ],
                                        "tags": [],
                                        "examples": [
