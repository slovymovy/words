                        "glosses": [
                            "overheidsinstelling die zorgt voor kinderen die niet of onvoldoende goed door de eigen ouders verzorgd kunnen worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d2140a8-0547-4814-b3a6-871ae3413e9c",
                                "sense_id": "92ff6379-f34d-3ce7-b37c-665ad55d5f82",
                                "text": "Voogdijraad - een liefdadige instelling onder de beschermheerschap van de tsaar, die weeshuizen, huizen voor doven, blinden, etc. bestuurde, en afhankelijk was van giften van de adel."
                            },
                            {
                                "example_id": "106efd18-233e-4a01-acbc-f249f49a1672",
                                "sense_id": "92ff6379-f34d-3ce7-b37c-665ad55d5f82",
                                "text": "\"Daarnaast komen er elk jaar nog een aantal jongeren zonder studiebeurs, op eigen houtje. Voor deze minderjarigen gelden tegenwoordig strenge regels van de voogdijraad en de kinderbescherming zowel op Curaçao als in Nederland. Zonder de juiste papieren komt een kind Nederland niet in.De jongeren die naar Nederland komen hebben vaak op goede scholen gezeten, zijn heel beleefd. Maar ze worstelen wel met een enorm cultuurverschil.\""
                            }
                        ]
                    }
