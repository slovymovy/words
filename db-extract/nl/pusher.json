                        "entry_id": "6fd52de0-cd59-3eaa-8874-efa97fbeb7c4",
                        "glosses": [
                            "iemand die aanzet tot drugsgebruik"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5902e37c-cca5-4dbd-a05c-1ea0bf37b6e0",
                        "source_entry_id": "6fd52de0-cd59-3eaa-8874-efa97fbeb7c4",
                        "source_sense_id": "2a22875b-94a2-3e5f-8e64-d9f788285c32",
