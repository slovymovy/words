                        "cross_references": [
                            {
                                "target_word": "antisocialist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bcca77c0-d950-3535-9448-bcd1ea5232d4",
                                        "entry_id": "d0ffd041-63db-3119-83bd-598ad60c702e",
                                        "glosses": [
                                            "One who opposes socialism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54f89fb0-c70e-44f3-a9f2-3bcaa2cc56d0",
                                                "sense_id": "bcca77c0-d950-3535-9448-bcd1ea5232d4",
                                                "text": "Hayden's problem here, I think, is an excessive consistency: not being a socialist, or at least not wanting to take his political stand on that principle, he assumes he must, then, be an antisocialist."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "antisocialist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a98538c6-d382-3284-8ba0-e671491f79c9",
                                        "entry_id": "6f7ad683-ba58-3f2d-bc66-a5206779b61e",
                                        "glosses": [
                                            "Opposed to socialism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3aa83e1d-a59f-49e7-98f3-28a73c430a72",
                                                "sense_id": "a98538c6-d382-3284-8ba0-e671491f79c9",
                                                "text": "Labor could scarcely barter with a party that adopted an antisocialist stance or trade support in return for concessions with a party terming itself antisocialist."
                                            },
                                            {
                                                "example_id": "401a8d22-6760-4352-b9cd-211dcbb474a2",
                                                "sense_id": "a98538c6-d382-3284-8ba0-e671491f79c9",
                                                "text": "One year later, the responses were even more antisocialist: 64 percent, no; 15 percent, yes; and 21 percent, undecided or with no opinion."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
