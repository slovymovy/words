                                    {
                                        "sense_id": "a6cac721-e740-3193-b8e3-536039f23f52",
                                        "entry_id": "3b3379c9-9cab-3640-9294-49c57b029f4b",
                                        "glosses": [
                                            "dat iets niet van je af te nemen is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e795790-2167-4c23-a30d-394b6d3e5051",
                                                "sense_id": "a6cac721-e740-3193-b8e3-536039f23f52",
                                                "text": "De moedertaal maakt onvervreemdbaar deel uit van identiteit en cultuur."
