                        "wzięty pisarz",
                        "wzięty lekarz"
                    ],
                    "target_lang_definitions": {
                        "en": "highly successful, popular, and consequently in high demand or sought-after for work"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sought-after",
                                "target_lang_sense_clarification": "in high demand, popular"
                            },
                            {
                                "target_lang_word": "in-demand",
                                "target_lang_sense_clarification": "frequently hired, heavily requested"
                            },
                            {
                                "target_lang_word": "popular",
                                "target_lang_sense_clarification": "widely liked and successful"
                            }
                        ]
                    }
                }
            ]
        },
