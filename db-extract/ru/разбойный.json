                        "source_entry_id": "b28ecafa-fcf7-3e76-b417-f5063970c6f0",
                        "target_lang_word": "loupežný",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "034b456a-0260-42a7-bc8d-d2a21ed8737e",
                        "source_entry_id": "b28ecafa-fcf7-3e76-b417-f5063970c6f0",
                        "target_lang_word": "loupeživý",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "loupeživý",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "d4341838-21f9-3737-ada0-1f6e11e232f3",
                                        "entry_id": "974d598b-33a0-3dcc-8277-6a2abcaeb3dd",
                                        "glosses": [
                                            "často nebo opakovaně páchající loupež, resp. olupující druhé"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5ca5f0f-6b13-4251-bc7a-908233077854",
                                                "sense_id": "d4341838-21f9-3737-ada0-1f6e11e232f3",
                                                "text": "Žel, není známo jak zabránit loupeživým esoterikům únosy vědeckých termínů. Ojedinělý výkon předvádí američan David Wagner, který zcizil relativistické fyzice \"TACHYON\"."
                                            },
                                            {
                                                "example_id": "2590397d-2b62-4227-a055-13c9567998d5",
                                                "sense_id": "d4341838-21f9-3737-ada0-1f6e11e232f3",
                                                "text": "Při svých loupeživých nájezdech dihanové chytají pro své ženy ptáky a motýly s pestrobarevnými kresbami na křídlech, na břehu řeky Kongo sbírají plže s ulitami stočenými podle zlatého řezu; z úžasu nad jejich krásou je zabíjejí a napichují do svých sbírek."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "loupeživý",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "200f05a2-ae15-3b08-9a7f-cdb4e68d612e",
                                        "entry_id": "826dd9c2-0e08-32ef-b813-22311bda4023",
