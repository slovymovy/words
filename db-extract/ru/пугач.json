                "senses": [
                    {
                        "sense_id": "1fcff641-2e04-3cf9-adac-d6ad4f24ecc3",
                        "entry_id": "bd9109cc-5e3b-3acb-8b86-f830e12e08b1",
                        "glosses": [
                            "народное название филина"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93c61182-92a2-4be4-be75-60c4892c0086",
                                "sense_id": "1fcff641-2e04-3cf9-adac-d6ad4f24ecc3",
                                "text": "Эхо прокатилось по просекам и смолкло. Пугач раздирающе ухнул и стих."
                            },
                            {
                                "example_id": "cbdc2e24-cc7e-4386-bbf9-3efa471233a1",
                                "sense_id": "1fcff641-2e04-3cf9-adac-d6ad4f24ecc3",
                                "text": "Слева от них, в тёмном ельнике болота, гулко крикнул пугач ― тишина всколыхнулась и снова застыла, как масло."
                            }
                        ]
                    }
                ],
