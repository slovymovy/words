                "senses": [
                    {
                        "sense_id": "40aecb84-708d-3f05-8728-b979f181d6bc",
                        "entry_id": "00a61d21-5a99-3631-8b69-5d55d636a38b",
                        "glosses": [
                            "Qui est partagé en branches, en rameaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af802ee2-697d-4795-aa71-b6febdeaefc9",
                                "sense_id": "40aecb84-708d-3f05-8728-b979f181d6bc",
                                "text": "… oyez-vous point s'ébattre, dans la cour de votre Louvre, ces passereaux gourmands emmi cette vigne rameuse et feuillue?"
                            },
                            {
                                "example_id": "80a41f7c-58a0-4565-9f81-235fa11efe75",
                                "sense_id": "40aecb84-708d-3f05-8728-b979f181d6bc",
                                "text": "À l’intérieur de la courbe s’élevait un chêne solitaire, rameux, énorme et bas, autour du tronc duquel régnait un banc de bois."
                            }
                        ]
                    },
                    {
                        "sense_id": "b792f4f2-eed1-3307-aeb1-ff053ec79765",
                        "entry_id": "00a61d21-5a99-3631-8b69-5d55d636a38b",
                        "glosses": [
                            "En forme de branches d’arbre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "987d2363-f59b-4e69-b395-6a14bd71fbd2",
                                "sense_id": "b792f4f2-eed1-3307-aeb1-ff053ec79765",
                                "text": "Le keratophyte rameux ou en forme de branches d’arbre ; il ressemble à un arbrisseau branchu ; les intervalles des branches dans la pétrification sont remplis par la pierre même ou par le roc, dans lequel le keratophyte se trouve."
                            }
                        ]
                    },
                    {
                        "sense_id": "bdc2da15-e2b1-3450-b1c3-2e210e58c436",
                        "entry_id": "00a61d21-5a99-3631-8b69-5d55d636a38b",
                        "glosses": [
                            "En forme de branches d’arbre.",
                            "Se dit des bois des cervidés."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "8f7d36e2-7a15-4690-b8e0-7ba4bbc45d36",
                                "sense_id": "bdc2da15-e2b1-3450-b1c3-2e210e58c436",
                                "text": "Le bois rameux d’un vieux cerf."
                            },
                            {
                                "example_id": "66fdfe70-2211-4881-8c01-78f54dcd0b5c",
                                "sense_id": "bdc2da15-e2b1-3450-b1c3-2e210e58c436",
                                "text": "Ô guerriers énervés qui chassez par les monts\nLes grands élans rameux source de l’abondance,\nVos pères sont couchés dans les épais limons :\nLeur suaire est d’écume et leur tombe est immense."
                            }
                        ]
                    },
                    {
                        "sense_id": "1aaed88d-90ef-3188-b8c4-24e4fe7b7997",
                        "entry_id": "00a61d21-5a99-3631-8b69-5d55d636a38b",
                        "glosses": [
                            "Qui présente des embranchements, des ramifications, un fractionnement."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": []
                    }
