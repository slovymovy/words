                        ],
                        "form": "wipers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3d7cb13d-1270-3bcc-a192-2160434fabd6",
                        "entry_id": "fddda58d-2292-3acb-a30f-4193557fe354",
                        "glosses": [
                            "Someone who wipes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd2c7fea-6f0a-4e0a-94e1-b680d349353a",
                                "sense_id": "3d7cb13d-1270-3bcc-a192-2160434fabd6",
                                "text": "So, Willy, let you and me be wipers / Of scores out with all men — especially pipers!"
                            }
                        ]
                    },
                    {
                        "sense_id": "9a39556c-b342-34d7-ab10-f295a99204f6",
                        "entry_id": "fddda58d-2292-3acb-a30f-4193557fe354",
                        "glosses": [
                            "Something, such as a towel, that is used for wiping."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "7bdfc7ac-0fbb-37ef-99a9-8e1155c413b9",
                        "entry_id": "fddda58d-2292-3acb-a30f-4193557fe354",
                        "glosses": [
                            "Something, such as a windscreen wiper, that is designed for wiping."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2e60cc8-0f1f-49b4-93e6-569c1e3aaced",
                                "sense_id": "7bdfc7ac-0fbb-37ef-99a9-8e1155c413b9",
                                "text": "Using her hands like windshield wipers, she tried to flick snow away from her mouth. When she clawed at her chest and neck, the crumbs maddeningly slid back onto her face. She grew claustrophobic."
                            }
                        ]
                    },
                    {
                        "sense_id": "efb5c520-7052-3a02-bc79-f6e5395899d9",
                        "entry_id": "fddda58d-2292-3acb-a30f-4193557fe354",
                        "glosses": [
                            "A movable electric contact in some devices."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "83b3b319-ce5d-3b5b-b6d2-67395bea0ce3",
                        "entry_id": "fddda58d-2292-3acb-a30f-4193557fe354",
                        "glosses": [
                            "A program or process that erases data."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "3650c30c-f686-3673-9b04-68b64bf93d63",
                        "entry_id": "fddda58d-2292-3acb-a30f-4193557fe354",
                        "glosses": [
                            "A junior role in the engine room of a ship, someone who wipes down machinery and generally keeps it clean."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "186c0d21-070e-3969-8bc1-4e2f87efe02e",
                        "entry_id": "fddda58d-2292-3acb-a30f-4193557fe354",
                        "glosses": [
                            "An impertinent young man."
                        ],
                        "tags": [
                            "obsolete",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "fc1b12bb-dec2-450e-89d3-e16cb2037007",
                                "sense_id": "186c0d21-070e-3969-8bc1-4e2f87efe02e",
                                "text": "I ask you now, ain't honesty a-written on my feechurs? / I say the wiper should be scorched who'd rob his feller-creatures."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "66108e1d-013c-49ae-be85-88f12be95b39",
                        "source_entry_id": "fddda58d-2292-3acb-a30f-4193557fe354",
                        "source_sense_description": "someone who wipes",
                        "target_lang_word": "tergicristallo",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
