                ],
                "senses": [
                    {
                        "sense_id": "8115d2d3-2797-3fb6-b891-e249a5158972",
                        "entry_id": "c2f135fb-6387-35dd-94fa-34704b8b4660",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41e28206-a7e2-42fb-abb5-ac34c8b37384",
                                "sense_id": "8115d2d3-2797-3fb6-b891-e249a5158972",
                                "text": "Frau Neuenschwander ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "7ba6ba65-b9f6-4e3c-a02e-59f8848464c2",
                                "sense_id": "8115d2d3-2797-3fb6-b891-e249a5158972",
                                "text": "Herr Neuenschwander wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "d4223618-38d2-4422-9318-d02563c47ff8",
                                "sense_id": "8115d2d3-2797-3fb6-b891-e249a5158972",
                                "text": "Die Neuenschwanders fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "8ce04b64-03db-42cf-bb95-8b3ea82baf15",
                                "sense_id": "8115d2d3-2797-3fb6-b891-e249a5158972",
                                "text": "Der Neuenschwander trägt nie die Schals, die die Neuenschwander ihm strickt."
                            },
                            {
                                "example_id": "4dafa2cc-e2c9-40d8-b33a-e5fd44fff594",
                                "sense_id": "8115d2d3-2797-3fb6-b891-e249a5158972",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Neuenschwander kommt, geht der Herr Neuenschwander.“"
                            },
                            {
                                "example_id": "665ae9ed-22c1-4cc6-9ac5-587861fb1747",
                                "sense_id": "8115d2d3-2797-3fb6-b891-e249a5158972",
                                "text": "Neuenschwander kommt und geht."
                            },
                            {
                                "example_id": "dafd51a2-5fb9-43f1-acfd-1c11b2448bb4",
                                "sense_id": "8115d2d3-2797-3fb6-b891-e249a5158972",
                                "text": "Neuenschwanders kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
