                ],
                "senses": [
                    {
                        "sense_id": "e40f59f6-4295-38da-9529-63a14835f51d",
                        "entry_id": "620f5928-55fe-3692-8531-dbeca734e862",
                        "glosses": [
                            "Tamiser à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5948f6c-e64d-46fa-a1f1-45c471cc03a0",
                                "sense_id": "e40f59f6-4295-38da-9529-63a14835f51d",
                                "text": "Aussi faut-il la soumettre encore une fois à l'action des râpes et la retamiser ensuite, pour extraire à peu près toute la fécule qu'elle renferme."
                            },
                            {
                                "example_id": "8f92bc9f-0121-47de-a604-11924b7a636f",
                                "sense_id": "e40f59f6-4295-38da-9529-63a14835f51d",
                                "text": "Retamiser à sec sur 2 tamis superposés, nᵒ 80 au-dessus, 300 au-dessous : on récolte ainsi les sables grossiers et les sables fins; peser."
                            },
                            {
                                "example_id": "f338cfd5-9508-4b98-890a-5864881575f5",
                                "sense_id": "e40f59f6-4295-38da-9529-63a14835f51d",
                                "text": "Ils avaient tamisé du sable pour recueillir le plus fin qui servirait à faire le mortier. Les débris étaient retamisés sur un tamis aux mailles plus grosses qui laissaient passer les gravillons. Il ne restait plus que la caillasse qui servirait à faire le béton."
                            }
                        ]
                    }
                ],
