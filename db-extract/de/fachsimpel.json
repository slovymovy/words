                ],
                "senses": [
                    {
                        "sense_id": "34676718-7369-3337-9990-11c2d64e311b",
                        "entry_id": "229f285a-3e89-303b-82db-d486ef80aee5",
                        "glosses": [
                            "einfach strukturierter naiver Mensch, der nicht über die Grenzen eines Fachgebiets hinausblickt beziehungsweise dort nicht über einschlägige Kompetenzen verfügt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77253120-5198-40c7-91cd-b6e79b14bd6e",
                                "sense_id": "34676718-7369-3337-9990-11c2d64e311b",
                                "text": "„Fach als erstes Wortglied bedeutet Fachgelehrsamkeit; brachte ein Fuchs zur Unzeit seine junge Fuchsweisheit an, so zog er sich die Schelte Fachsimpel zu.“"
                            },
                            {
                                "example_id": "3a0523c3-7589-4c0b-a70a-7cb44e5e0747",
                                "sense_id": "34676718-7369-3337-9990-11c2d64e311b",
                                "text": "„Er soll ja nicht bloßer Fachmensch, oder wie der Student das so treffend nennt: kein Fachsimpel sein; das gibt später im Leben die bornierten Spezialisten, die einseitigen Juristen oder Oberlehrer, aber keine allgemein gebildete, keine wirklich wissenschaftliche, überhaupt keine gebildete Menschen.“"
                            },
                            {
                                "example_id": "bb9d4d49-3824-44db-8fcc-a205c8efe42d",
                                "sense_id": "34676718-7369-3337-9990-11c2d64e311b",
                                "text": "„Sich über Facharroganz hinwegzusetzen, war eine Zeitlang Hitlers Stärke, bis er eines Tages selber zum Fachsimpel wurde.“"
                            },
                            {
                                "example_id": "e5a3ed70-e374-4121-a4ec-516da16695da",
                                "sense_id": "34676718-7369-3337-9990-11c2d64e311b",
                                "text": "„Die Landesgerichtsdirektoren und Räte, diese traurigen Fachsimpel, diese blühenden Rindviecher, wie armselig ihre Gaudi war.“"
                            },
                            {
                                "example_id": "a055e1ea-0777-4f2d-95df-4a906382d87b",
                                "sense_id": "34676718-7369-3337-9990-11c2d64e311b",
                                "text": "„Hausdörfer lachte nervös. Ach, du Schätzchen, ich bin doch nicht bloß so’n Fachsimpel?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
