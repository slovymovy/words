                        "examples": [
                            {
                                "example_id": "4d177b09-ada0-4576-8dc2-1aa900dcfdcd",
                                "sense_id": "ab5aca9e-f9e9-3b51-93ce-d13ae4632c59",
                                "text": "L’énergie thermique est produite par des panneaux photovoltaïques en toiture. Lesquels chauffent la neige stockée dans un fondoir : le refuge dispose d’un réservoir d’eau d’une capacité de 20 000 litres."
                            },
                            {
                                "example_id": "42fee0de-f3bf-46ac-8e79-391fe9cf359b",
                                "sense_id": "ab5aca9e-f9e9-3b51-93ce-d13ae4632c59",
                                "text": "Devant le Théâtre Outremont, un ouvrier pelletait des débris près d'un fondoir à bitume qui ronflait bruyamment; deux autres, sur la toiture, hissaient un seau fumant au bout d'un câble."
                            }
