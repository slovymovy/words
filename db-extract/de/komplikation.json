                ],
                "senses": [
                    {
                        "sense_id": "4e202296-a036-362c-b2a9-2b72ff518f4c",
                        "entry_id": "39fdad81-1396-3a69-9c41-8f938ea3ee6c",
                        "glosses": [
                            "etwas, das ein Vorhaben schwieriger macht als geplant"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef97e362-7b8e-48ed-870d-039dd3c8cd71",
                                "sense_id": "4e202296-a036-362c-b2a9-2b72ff518f4c",
                                "text": "Bei der Herzoperation kam es zu Komplikationen."
                            },
                            {
                                "example_id": "5d40ca10-f7a7-4e09-a818-ebf5746295cf",
                                "sense_id": "4e202296-a036-362c-b2a9-2b72ff518f4c",
                                "text": "„Eine 59 Jahre alte Frau starb an der Komplikation.“"
                            },
                            {
                                "example_id": "221dfc79-1939-4d6f-8aca-360d05917410",
                                "sense_id": "4e202296-a036-362c-b2a9-2b72ff518f4c",
                                "text": "Wenn man eine Bank überfallen will, ist ein zusätzlicher Wachmann eine zusätzliche Komplikation."
                            },
                            {
                                "example_id": "0e6c492e-ccaf-4742-b42e-f3079cd35bd0",
                                "sense_id": "4e202296-a036-362c-b2a9-2b72ff518f4c",
                                "text": "„Liszt aber konnte und wollte keine Komplikationen erkennen.“"
                            },
                            {
                                "example_id": "651fead0-2a40-482a-9db6-2d9eb0896f75",
                                "sense_id": "4e202296-a036-362c-b2a9-2b72ff518f4c",
                                "text": "„Wie bei jedem Eingriff in den Körper kann es auch bei der Einnahme der Abtreibungspille zu Komplikationen kommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "cdbf2f8d-fadb-3e4f-ae69-d0e539b3c222",
                        "entry_id": "39fdad81-1396-3a69-9c41-8f938ea3ee6c",
                        "glosses": [
                            "Funktion eines mechanischen Uhrwerks, die über die Anzeige von Stunden, Minuten und Sekunden hinausgeht"
                        ],
                        "tags": [
                            "Uhrmacherei"
                        ],
                        "examples": [
                            {
                                "example_id": "e8c0131b-a9c5-4f45-956c-7ff37bc3643a",
                                "sense_id": "cdbf2f8d-fadb-3e4f-ae69-d0e539b3c222",
                                "text": "Je nach Komplikation und Hersteller, kann sich der Preis einer guten Armbanduhr leicht vervielfachen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
