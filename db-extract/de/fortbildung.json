                    },
                    {
                        "form_id": "dac2b554-1f91-4316-bd8f-60662753b794",
                        "entry_id": "be175cba-d77b-38be-84c9-116b859a684d",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Fortbildungen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8d1bb279-6bcf-3fa8-baf0-2eaa5a132aac",
                        "entry_id": "be175cba-d77b-38be-84c9-116b859a684d",
                        "glosses": [
                            "Erweiterung von Kenntnissen oder Fertigkeiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cef7ae31-196b-41d2-8204-7301025cd160",
                                "sense_id": "8d1bb279-6bcf-3fa8-baf0-2eaa5a132aac",
                                "text": "„Die studierte Ethnologin war oft für den WDR in Afghanistan unterwegs und ist dort auch engagiert in der Fortbildung von Journalistinnen.“"
                            },
                            {
                                "example_id": "52d38c2e-ff00-421b-8c75-c0de5d9a1a79",
                                "sense_id": "8d1bb279-6bcf-3fa8-baf0-2eaa5a132aac",
                                "text": "Fortbildung ist ein Prozess, der ein Leben lang anhält."
                            },
                            {
                                "example_id": "ec6d904e-b8a9-4fd5-a17b-5a2a74481d18",
                                "sense_id": "8d1bb279-6bcf-3fa8-baf0-2eaa5a132aac",
                                "text": "[Ein Rettungssanitäter muss] „jährlich mindestens 30 Zeitstunden Fortbildung im Rettungsdienst nachweisen, damit er weiterhin im Rettungsdienst bzw. Krankentransport eingesetzt werden darf.“"
                            },
                            {
                                "example_id": "56a16886-f8d8-4ab9-8fd9-5b61ea222acf",
                                "sense_id": "8d1bb279-6bcf-3fa8-baf0-2eaa5a132aac",
                                "text": "[Consultants:] „Nach wie vor überwiegen Betriebswirtschaftler, Juristen und Wirtschaftsinformatiker in der Branche, doch auch Psychologen und Geisteswissenschaftler haben bei entsprechender Fortbildung im Studium eine reelle Chance, in eine Consulting-Firma einzusteigen.“"
                            },
                            {
                                "example_id": "faeb641d-2729-45b1-997c-884a838194d4",
                                "sense_id": "8d1bb279-6bcf-3fa8-baf0-2eaa5a132aac",
                                "text": "„Die permanente Fortbildung und ein aktueller Kenntnisstand des Produktmarktes sowie dessen Entwicklung sind für den Finanzberater daher elementar.“"
                            },
                            {
                                "example_id": "c703546e-d60d-4247-a169-008b2d02b300",
                                "sense_id": "8d1bb279-6bcf-3fa8-baf0-2eaa5a132aac",
                                "text": "[Rettungssanitäter:] „Eine Fortbildung zum Thema Kindernotfälle ist nicht verpflichtend.“"
                            },
                            {
                                "example_id": "3625e038-7014-4f83-854e-b831b99e9adc",
                                "sense_id": "8d1bb279-6bcf-3fa8-baf0-2eaa5a132aac",
                                "text": "[Schlagzeile:] „Freiwillige Feuerwehr fordert bessere Aus- und Fortbildung“"
                            },
                            {
                                "example_id": "d9ea7aa9-aa3a-493d-a27e-885405a9ac08",
                                "sense_id": "8d1bb279-6bcf-3fa8-baf0-2eaa5a132aac",
                                "text": "„Frauen, die während der Kindererziehung vielleicht im Büro oder Teilzeit gearbeitet haben, könnten in höherem Alter durch gezielte Fortbildung oft auch höher qualifizierte und besser bezahlte Jobs ausfüllen.“"
                            },
                            {
                                "example_id": "1401861b-9dc6-4ac0-8a31-a7f61d94e138",
                                "sense_id": "8d1bb279-6bcf-3fa8-baf0-2eaa5a132aac",
                                "text": "7. September 1965: „In der Bundesrepublik Deutschland tritt das Leistungsförderungsgesetz zur Förderung der beruflichen Fortbildung in Kraft.“"
                            },
                            {
                                "example_id": "ee0aaa06-be15-47ba-8d40-c337974617f5",
                                "sense_id": "8d1bb279-6bcf-3fa8-baf0-2eaa5a132aac",
                                "text": "„Eine Fortbildung bringt Menschen in höhere Positionen und sogar bis zu 500 Euro mehr Geld - so das Ergebnis der Studie mit 1.000 Befragten.“"
                            },
                            {
                                "example_id": "0a1dce0b-ddfe-401f-822f-3df325d83709",
                                "sense_id": "8d1bb279-6bcf-3fa8-baf0-2eaa5a132aac",
                                "text": "„Gerade im Gesundheitswesen sind Fortbildungen auf Grund ständig neuer Erkenntnisse in Medizin, und neuerdings auch der Pflegeforschung, sehr wichtig.“"
                            },
                            {
                                "example_id": "951e35fb-353c-49ba-bf67-43b7379d6331",
                                "sense_id": "8d1bb279-6bcf-3fa8-baf0-2eaa5a132aac",
                                "text": "„Durch Fortbildung werden keine neuen Abschlüsse erworben, es wird meist nur erfolgreiche Teilnahme bescheinigt.“"
                            },
                            {
                                "example_id": "bbc5e1a9-f263-4949-b654-40993e1f4c97",
                                "sense_id": "8d1bb279-6bcf-3fa8-baf0-2eaa5a132aac",
                                "text": "„Seit dem 1. Juli 2004 besteht die Pflicht zur fachlichen Fortbildung für alle Vertragszahnärzte in Deutschland,“ […]."
                            },
                            {
                                "example_id": "c9ecfba2-4944-41d5-806b-b39bca7e252d",
                                "sense_id": "8d1bb279-6bcf-3fa8-baf0-2eaa5a132aac",
                                "text": "„Der Nachweis über die Fortbildung kann durch Fortbildungszertifikate der Kammern der Ärzte, der Zahnärzte sowie Psychotherapeuten und Kinder- und Jugendlichenpsychotherapeuten erbracht werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9964706e-329f-3116-a5e1-ad5df44eeeac",
                        "entry_id": "be175cba-d77b-38be-84c9-116b859a684d",
                        "glosses": [
                            "Lehrgang, um [1] zu erreichen; oft beruflich veranlasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "570dee33-5c78-4595-96aa-651b912c1f64",
                                "sense_id": "9964706e-329f-3116-a5e1-ad5df44eeeac",
                                "text": "Nächste Woche bin ich auf einer Fortbildung."
                            },
                            {
                                "example_id": "6d8a6dbe-cd61-4e7f-bd27-5ef45d359874",
                                "sense_id": "9964706e-329f-3116-a5e1-ad5df44eeeac",
                                "text": "„Kennengelernt hat sich das Ehepaar bei einer Fortbildung.“"
                            },
                            {
                                "example_id": "f4aaa4a8-623e-4888-80ca-ace53e81766b",
                                "sense_id": "9964706e-329f-3116-a5e1-ad5df44eeeac",
                                "text": "[Schweizer Ärzteverbände:] „Sie machen Umfragen zur Arbeitsbelastung, organisieren Fortbildungen und fördern Forschung und Entwicklung.“"
                            },
                            {
                                "example_id": "2b894408-ca90-4e89-828f-e0a8cbeb6726",
                                "sense_id": "9964706e-329f-3116-a5e1-ad5df44eeeac",
                                "text": "[Coronapandemie 2020:] „Sämtliche Projekte und Fortbildungen werden abgesagt - zunächst.“"
                            },
                            {
                                "example_id": "42ff852d-98fe-4772-8a8d-c7d5b7e300e0",
                                "sense_id": "9964706e-329f-3116-a5e1-ad5df44eeeac",
                                "text": "„Senta Pollinger hat lange auf ihre Fortbildung warten müssen, aber jetzt sitzt sie endlich in dem Seminar für Kriminologie und Psychologie in Ainring“ […]."
                            },
                            {
                                "example_id": "c38d8a07-d95f-4e7b-a9d7-c155c879a1e9",
                                "sense_id": "9964706e-329f-3116-a5e1-ad5df44eeeac",
                                "text": "[Lehrerfortbildung:] „Die vierstündigen Fortbildungen werden als Kombination aus Live- und Online-Veranstaltungen angeboten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
