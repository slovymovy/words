                "senses": [
                    {
                        "sense_id": "ddc384c5-68ad-3078-b65d-0b35c208e7b3",
                        "entry_id": "84d6b014-fcde-3d6c-852e-f3fa21d2431d",
                        "glosses": [
                            "Eskalation, bei der Menschen verletzt oder getötet werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ade39de-e1ac-472f-a005-a6633dd9a240",
                                "sense_id": "ddc384c5-68ad-3078-b65d-0b35c208e7b3",
                                "text": "Das Militär zeigt verstärkt Präsenz, damit es nicht zu weiterem Blutvergießen kommt."
                            },
                            {
                                "example_id": "b3e17b28-1b6e-4eb7-85d2-1d16ca561358",
                                "sense_id": "ddc384c5-68ad-3078-b65d-0b35c208e7b3",
                                "text": "Die Regierung tut alles, um unnötiges Blutvergießen zu vermeiden."
                            },
                            {
                                "example_id": "9ffb7b5c-7096-4f41-81f8-a23f886314e2",
                                "sense_id": "ddc384c5-68ad-3078-b65d-0b35c208e7b3",
                                "text": "„Wir haben kein Recht, die Arbeiterschaft zu einem Kampf aufzurufen, der zur sicheren Niederlage, zu sinnlosem Blutvergießen führt.“"
                            },
                            {
                                "example_id": "3300406e-0b35-4f22-a37c-48fa72b45157",
                                "sense_id": "ddc384c5-68ad-3078-b65d-0b35c208e7b3",
                                "text": "„Das innerangolanische Blutvergießen dauerte bis 2002, mehr als eine halbe Million Menschen kamen dabei um.“"
                            },
                            {
                                "example_id": "b5fa239f-f39f-4ce1-8935-adb36f608046",
                                "sense_id": "ddc384c5-68ad-3078-b65d-0b35c208e7b3",
                                "text": "„Wir brauchen nicht noch mehr Gewalt, Blutvergießen nach dem Blutvergießen.“"
                            },
                            {
                                "example_id": "ef8fe4de-6bfe-4a48-80de-d26d5b4c08ef",
                                "sense_id": "ddc384c5-68ad-3078-b65d-0b35c208e7b3",
                                "text": "„An dem Treffen bei Ostrowa, von dem die Geschichtsbücher später schrieben, es sei das erste nennenswerte Blutvergießen des russischen Feldzuges gewesen, nahm Martins Batterie teil.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
