                "senses": [
                    {
                        "sense_id": "e451323f-92a9-3552-a54d-48e425a2695f",
                        "entry_id": "563bd275-3c63-34fc-bbf3-748471912264",
                        "glosses": [
                            "Simplifier de façon extrêmement importante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17451f0c-5354-4ec1-862e-895df7f34128",
                                "sense_id": "e451323f-92a9-3552-a54d-48e425a2695f",
                                "text": "Plutôt que d’ultra-simplifier l’opération de vente extérieure et de rendre plus ou moins passives les entreprises \"exportatrices\", cette méthode de vente tente au contraire de les associer activement aux diverses phases de l’exportation."
                            },
                            {
                                "example_id": "f1e13e17-e0ba-446e-a405-84ba86b64afe",
                                "sense_id": "e451323f-92a9-3552-a54d-48e425a2695f",
                                "text": "encore faut-il que celles-ci n’aillent pas jusqu’à ultra-simplifier les problèmes en les réduisant à des « questions de rats » comme le dénonce en substance Bertalanffy."
                            }
                        ]
                    }
