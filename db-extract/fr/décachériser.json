                "senses": [
                    {
                        "sense_id": "fbb3bca5-5bd3-3666-8723-f687f640f1bf",
                        "entry_id": "586668ad-05ec-33d2-a4ce-37c616afa9f3",
                        "glosses": [
                            "Faire perdre son caractère cacher à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1007b0a3-e061-4837-afc5-32780ce47b1d",
                                "sense_id": "fbb3bca5-5bd3-3666-8723-f687f640f1bf",
                                "text": "Après l'abattage rituel, la Pologne veut décachériser son armée."
                            },
                            {
                                "example_id": "7b2e8864-aec7-40df-ba34-14ed36bfb354",
                                "sense_id": "fbb3bca5-5bd3-3666-8723-f687f640f1bf",
                                "text": "ET SURTOUT cela peut-il décachériser la vaisselle (il est déjà passé au lave-vaisselle) ?"
                            },
                            {
                                "example_id": "c034d6a8-321a-49a2-b147-6aa7aeb6bc0e",
                                "sense_id": "fbb3bca5-5bd3-3666-8723-f687f640f1bf",
                                "text": "Donc si on veut maintenant manger cacher, on doit cachériser l'évier aussi, parce que sinon dès qu'on fera la vaisselle, notre nouvelle vaisselle cacher va se décachériser en recevant les éléments non-cachers qui étaient présents dans les parois de l'évier depuis le passé, non ?"
                            }
                        ]
                    }
