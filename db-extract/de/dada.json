                                "target_senses": [
                                    {
                                        "sense_id": "6cfe462f-adfe-3110-978e-7f0869b95e8a",
                                        "entry_id": "af2cfd78-7f24-3ed0-8d70-a62233fae26b",
                                        "glosses": [
                                            "The cultural movement of Dada."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d630ba28-0887-4de0-8b66-fd896b7f9daa",
                                                "sense_id": "6cfe462f-adfe-3110-978e-7f0869b95e8a",
                                                "text": "What is Dadaism? Its official organ, published at Zurich, tells us, mystifyingly at first, that “Dada” doesn't mean anything."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8744d598-f3b1-45f1-ab35-5851bd7fa553",
                        "source_entry_id": "7d617021-4c6d-39b6-a9a6-97f47298210c",
                        "source_sense_id": "ee2a0219-ed0b-3cd5-a763-7494e96719fe",
                        "source_sense_description": "literarische und künstlerische Bewegung nach dem 1. Weltkrieg",
                        "target_lang_word": "dada",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dada",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "37a64206-7fde-3ea1-a16c-c0565116a93b",
                                        "entry_id": "183df5fd-a49b-3d17-9b4a-9b0a17d5edfd",
                                        "glosses": [
                                            "Cheval."
                                        ],
                                        "tags": [
                                            "childish"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e0f8b54-ce7e-499f-9649-5e9637c5ef38",
                                                "sense_id": "37a64206-7fde-3ea1-a16c-c0565116a93b",
                                                "text": "C'était pourtant réjouissant et distrayant de voir courir les dadas sans être obligé de passer au guichet pour lâcher son fric."
                                            },
                                            {
                                                "example_id": "ceb0edc4-5dd0-4ea6-b280-744a805dc7d8",
                                                "sense_id": "37a64206-7fde-3ea1-a16c-c0565116a93b",
                                                "text": "Le cheval “rose” de Rouen est devenu un dada couleur mastic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6a90775-4f05-34e5-b46e-ab4ebbeabc03",
                                        "entry_id": "183df5fd-a49b-3d17-9b4a-9b0a17d5edfd",
                                        "glosses": [
                                            "Petit cheval à bascule en bois."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c583c214-3ba7-4c5a-9ca5-d0ef0ff69ed3",
                                                "sense_id": "e6a90775-4f05-34e5-b46e-ab4ebbeabc03",
                                                "text": "Je veux aller à dada !"
                                            },
                                            {
                                                "example_id": "05cbe045-5534-416f-9c0f-4d79ec3e9995",
                                                "sense_id": "e6a90775-4f05-34e5-b46e-ab4ebbeabc03",
                                                "text": "« Hue-dada ! Hue-dada ! » hurlait Bonbon en faisant claquer ses deux pieds et le fer de la pelle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc66b4e4-4be9-37db-94d0-20757b90cb7a",
                                        "entry_id": "183df5fd-a49b-3d17-9b4a-9b0a17d5edfd",
                                        "glosses": [
                                            "Sujet qui intéresse beaucoup ; idée fixe."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "172aedda-14e5-4ec5-b0f7-8e34ccaed2a4",
                                                "sense_id": "fc66b4e4-4be9-37db-94d0-20757b90cb7a",
                                                "text": "— Je viens, reprit l’artiste dont la figure se dilata comme se dilate celle d’un homme de qui l’on flatte le dada, de terminer la figure allégorique de l’Harmonie."
                                            },
                                            {
                                                "example_id": "807058ce-85e1-4ac7-8855-988cd19de1f9",
                                                "sense_id": "fc66b4e4-4be9-37db-94d0-20757b90cb7a",
                                                "text": "Cette dette de trois milliards était son dada ; elle expliquait le cas avec un grand luxe de détails, faisait tout un cours d’histoire, et des rougeurs d’enthousiasme montaient à ses joues, molles et jaunes d’ordinaire comme de la cire."
                                            },
                                            {
                                                "example_id": "cece5782-8214-4005-b0ee-a9c7501dfb24",
                                                "sense_id": "fc66b4e4-4be9-37db-94d0-20757b90cb7a",
                                                "text": "Vous savez bien ce qu'on appelle un dada, c’est-à-dire une idée fixe qui vous revient toujours en tête, et qui vous mène quelquefois plus loin que vous ne voudriez aller."
                                            },
                                            {
                                                "example_id": "a0354795-5822-44ef-bb49-4e65dcc16b7a",
                                                "sense_id": "fc66b4e4-4be9-37db-94d0-20757b90cb7a",
                                                "text": "Toujours chevauchant leur dada (foncer, avec des armées mobiles), nos pontifes de l’X, général Langlois en tête, ne rêvaient que canon léger."
                                            },
                                            {
                                                "example_id": "541a058b-13c4-4873-bad0-e8d98feb2bdf",
                                                "sense_id": "fc66b4e4-4be9-37db-94d0-20757b90cb7a",
                                                "text": "Péteurs ou roteurs, rigolos ou plaideurs, stratèges ou despotes, atrabilaires ou taquins, tous, selon leur tempérament ou leur humeur, débridaient leurs dadas."
                                            },
                                            {
                                                "example_id": "d859f59e-b638-487b-8048-fd0be1101ee4",
                                                "sense_id": "fc66b4e4-4be9-37db-94d0-20757b90cb7a",
                                                "text": "Ils étaient toute une bande, une fine équipe. Ils se connaissaient bien ; ils avaient, déteignant les uns sur les autres, des habitudes communes, des goûts, des souvenirs communs. Ils avaient leur vocabulaire, leurs signes, leurs dadas."
                                            },
                                            {
                                                "example_id": "3d952d4a-ccaf-4a9d-b907-31437175c98d",
                                                "sense_id": "fc66b4e4-4be9-37db-94d0-20757b90cb7a",
                                                "text": "J’aimais ça biner les betteraves, c’était mon dada, ma vie. C’était un plaisir pour moi de démarier les betteraves."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa726c7c-42ef-3c2a-b211-10b5f06d6974",
                                        "entry_id": "183df5fd-a49b-3d17-9b4a-9b0a17d5edfd",
                                        "glosses": [
                                            "Mouvement artistique fondé sur le rejet des règles, conventions et contraintes idéologiques, artistiques ou politiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "705c2e0e-585d-41e2-8b7e-5788d1d18aa7",
                                                "sense_id": "fa726c7c-42ef-3c2a-b211-10b5f06d6974",
                                                "text": "Tout produit du dégoût susceptible de devenir une négation est dada ; abolition de la logique, danse des impuissants de la création : dada; toute hiérarchie et équation sociale installée pour les valeurs par nos valets : dada ; le choc précis des lignes parallèles se rapprochant indéfiniment – moyen pour le combat : dada."
                                            },
                                            {
                                                "example_id": "4b3b0b9d-f808-453d-a1cd-f05abc695693",
                                                "sense_id": "fa726c7c-42ef-3c2a-b211-10b5f06d6974",
                                                "text": "Si, succédant au mouvement dada, le surréalisme promeut le rêve et la révolution, les nouvelles bohèmes qui voient le jour dans le domaine des arts plastiques et en littérature affirment moins leur volonté de transformer la société qu’elles n’assument leur marginalité, tandis que les expérimentations menées sur scène et à l’écran soulèvent la question de la place du spectateur."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dada",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "325d999f-be93-3d2d-8dfe-3076663cbec5",
                                        "entry_id": "2d833342-b912-31b4-904d-4e38a375f834",
                                        "glosses": [
                                            "Anciennement esclave noire travaillant en tant que nourrice. Actuellement nourrice."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98a46415-8e7b-407e-8208-e80e3746bb23",
                                                "sense_id": "325d999f-be93-3d2d-8dfe-3076663cbec5",
                                                "text": "Quand elle a eu deux ans, elle s'est mise à dormir avec sa dada."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a44b8bba-0e59-4009-a8c1-3781d005df5b",
                        "source_entry_id": "7d617021-4c6d-39b6-a9a6-97f47298210c",
                        "source_sense_id": "ee2a0219-ed0b-3cd5-a763-7494e96719fe",
                        "source_sense_description": "literarische und künstlerische Bewegung nach dem 1. Weltkrieg",
                        "target_lang_word": "dadaïsme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dadaïsme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c153089a-0d8f-35e7-be3d-3483a408cbf4",
                                        "entry_id": "17f741ff-8642-32ef-829e-1c3c5966ad36",
                                        "glosses": [
                                            "Courant artistique et intellectuel, apparu en 1916, qui remet en cause les conventions et les contraintes du début du XXᵉ siècle (Duchamp, Man Ray, Picabia) sur des supports variés : collage, peinture, objet « N’est art que ce que l’artiste dit être de l’art »."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c0a385f-bd69-456e-8ac4-fb591d271bca",
                                                "sense_id": "c153089a-0d8f-35e7-be3d-3483a408cbf4",
                                                "text": "Issues de domaines culturels et linguistiques particulièrement chers à Jolas, ces avant-gardes ont fortement influencé transition, qui a aussi bien adopté leur combat pour une vision autre de la « réalité », que la quête spirituelle poursuivie plus particulièrement par le dadaïsme et l’expressionnisme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
