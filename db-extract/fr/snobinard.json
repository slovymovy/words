                        "examples": [
                            {
                                "example_id": "5e8de026-4d52-4a8b-b166-8965727f3807",
                                "sense_id": "8170a601-95ce-39cd-9d1f-6ffac6c71300",
                                "text": "Il m’énerve avec ses façons snobinardes et ses airs supérieurs."
                            },
                            {
                                "example_id": "72d8988e-a07b-43d1-8142-f0872dfdd9a0",
                                "sense_id": "8170a601-95ce-39cd-9d1f-6ffac6c71300",
                                "text": "Elle trouvait que les rapports étaient plus simples « chez les nègres » et qu’on n’y était pas aussi « snobinard » et coincé » que chez nous."
                            }
                        ]
                    }
                ],
