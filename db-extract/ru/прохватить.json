                "senses": [
                    {
                        "sense_id": "73e89bb0-5e94-3ab4-9e58-a0cd5857c9e6",
                        "entry_id": "8efa391f-3ba6-35e7-9da0-05dd0e4e9d76",
                        "glosses": [
                            "пронизать, проникнуть внутрь"
                        ],
                        "tags": [
                            "о холоде, сырости и т. п."
                        ],
                        "examples": [
                            {
                                "example_id": "f4419b51-8041-4816-9df4-341c2f6ec1cf",
                                "sense_id": "73e89bb0-5e94-3ab4-9e58-a0cd5857c9e6",
                                "text": "Ускользнут ли часы из кармана, // До костей ли прохватит мороз // Под воинственный гром барабана, // Не жалею: я истинный Росс!"
                            }
                        ]
                    },
                    {
                        "sense_id": "1dd0ce5e-09ab-3cf5-b7a4-eeb2b58f0cc6",
                        "entry_id": "8efa391f-3ba6-35e7-9da0-05dd0e4e9d76",
                        "glosses": [
                            "пробрать, пронять"
                        ],
                        "tags": [
                            "о дрожи, страхе и т. п."
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "5f0c94f3-cf62-3d2f-82dc-5e4a2e800340",
                        "entry_id": "8efa391f-3ba6-35e7-9da0-05dd0e4e9d76",
                        "glosses": [
                            "безл. вызвать простуду, продув, просквозив"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "bccd6087-92ce-371d-a7a0-9fd64fe1cddf",
                        "entry_id": "8efa391f-3ba6-35e7-9da0-05dd0e4e9d76",
                        "glosses": [
                            "нанести сквозную или глубокую рану; прокусить, прорезать"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "334ad192-0b48-343a-bbe5-fca9fc7ce175",
                        "entry_id": "8efa391f-3ba6-35e7-9da0-05dd0e4e9d76",
                        "glosses": [
                            "соединить, скрепить чем-либо проходящим насквозь"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "385a7006-68a8-3f30-839d-3d4ada2e5270",
                        "entry_id": "8efa391f-3ba6-35e7-9da0-05dd0e4e9d76",
                        "glosses": [
                            "раскритиковать, разбранить, осмеять (в печати, на собрании и т. п.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab7d49f5-21e0-4838-8804-7d6566ef8897",
                                "sense_id": "385a7006-68a8-3f30-839d-3d4ada2e5270",
                                "text": "Люся говорит: — Видишь ли, у нас есть разные неполадки… Ну, например, двоечники или лентяи, их надо прохватить. Понял? Надо про них выступить, чтобы все смеялись, это на них подействует отрезвляюще."
                            },
                            {
                                "example_id": "8844a7bd-c740-407f-89af-7d3d40f4514d",
                                "sense_id": "385a7006-68a8-3f30-839d-3d4ada2e5270",
                                "text": "Ай да Андрюшка, здорово прохватил!"
                            }
                        ]
                    }
                ],
