            "senses": [
                {
                    "sense_id": "1916f5b4-0845-3b99-8970-33a060f74b45",
                    "sense_definition": "Gruppe von drei Personen, die gemeinsam handeln oder zusammen Musik machen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "gruppe",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die drei Freunde treten bei dem Konzert als eingespieltes <w>Trio</w> auf."
                        },
                        {
                            "text": "Das erfolgreiche <w>Trio</w> konnte alle anstehenden Aufgaben zügig erledigen."
                        }
                    ],
                    "synonyms": [
                        "Terzett"
                    ],
                    "antonyms": [
                        "Duo",
                        "Quartett",
                        "Quintett",
                        "Sextett"
                    ],
                    "common_phrases": [
                        "als Trio auftreten",
                        "ein unschlagbares Trio"
                    ]
                },
                {
                    "sense_id": "0977e786-78b9-3535-a835-be970bee2b5e",
                    "sense_definition": "Musikstück, das für drei Stimmen oder Instrumente komponiert ist",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "musikstueck",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das Orchester spielte ein anspruchsvolles <w>Trio</w> für Violine, Flöte und Klavier."
                        },
                        {
                            "text": "Er hat für die feierliche Veranstaltung ein eigenes <w>Trio</w> komponiert."
                        }
                    ],
                    "antonyms": [
                        "Duett",
                        "Duo",
                        "Quartett"
                    ],
                    "common_phrases": [
