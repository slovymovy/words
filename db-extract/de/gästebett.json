                "senses": [
                    {
                        "sense_id": "59983643-27f2-3368-87c2-6618db9c718e",
                        "entry_id": "1f9812c1-3380-3f85-8695-17f47023bcf7",
                        "glosses": [
                            "Bett, das für Gäste vorgesehen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c20a7f8-86a5-46ad-b142-dd0d747985f0",
                                "sense_id": "59983643-27f2-3368-87c2-6618db9c718e",
                                "text": "„Nachdem man dem Piranha das Gesicht abgeputzt hatte, wurde er in ein Gästebett verfrachtet und schön zugedeckt.“"
                            },
                            {
                                "example_id": "e544d715-88f4-4333-8752-93047dbf32b8",
                                "sense_id": "59983643-27f2-3368-87c2-6618db9c718e",
                                "text": "„Es war bereits weit nach Mitternacht, als ich den Versuch, einzuschlafen, endgültig aufgab und unter dem Berg von Kissen in Jeans mittelalterlichem Gästebett hervorkroch.“"
                            },
                            {
                                "example_id": "dfa19d43-2e63-4892-9b02-ecd3dd2eadbe",
                                "sense_id": "59983643-27f2-3368-87c2-6618db9c718e",
                                "text": "„In einem standen ein Schreibtisch und Bücherregale, in einem anderen stand ein Gästebett und im dritten war sein und Ásas Schlafzimmer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
