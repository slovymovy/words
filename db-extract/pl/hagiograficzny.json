                "translations": [
                    {
                        "translation_id": "55fcd640-330c-4a90-a2c3-dd05bbb14a1f",
                        "source_entry_id": "e8639865-38b7-313e-a293-8c03d9e19e26",
                        "source_sense_id": "9464b8bb-0a7f-3099-8b3a-0c6b30ba40d9",
                        "target_lang_word": "hagiographic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hagiographic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e609d739-bef6-3f1a-94d0-93ed23e51d3d",
                                        "entry_id": "74456b3b-25be-3001-abfe-818cc23e06c7",
                                        "glosses": [
                                            "Of or pertaining to hagiography."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edf8f3f2-8927-4e00-9ef6-1542352d906c",
                                                "sense_id": "e609d739-bef6-3f1a-94d0-93ed23e51d3d",
                                                "text": "But the stakes are clearly higher than in the hagiographic viewpoint expressed in [Girard, 1971] and a change of syntax (as the one coming from linear logic) may occur from disturbing semantics."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e87897d-a603-34cb-9ec0-ff9420e1b7f1",
                                        "entry_id": "74456b3b-25be-3001-abfe-818cc23e06c7",
                                        "glosses": [
                                            "Uncritically reverent; adulating."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d554b7f-bf6e-43db-898a-703455b36b3d",
                                                "sense_id": "3e87897d-a603-34cb-9ec0-ff9420e1b7f1",
                                                "text": "“Chairman Xi is a world leader. His book on governance has sold out in many countries across the world,” Zhong gushed, parroting the unashamedly hagiographic bulletins in which the party news agency Xinhua excels."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "02e7525b-77b3-4601-8679-1b138789518f",
                        "source_entry_id": "e8639865-38b7-313e-a293-8c03d9e19e26",
                        "source_sense_id": "9464b8bb-0a7f-3099-8b3a-0c6b30ba40d9",
                        "target_lang_word": "hagiographique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hagiographique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b09f44e6-27e7-3e87-84ca-27cf2da775d9",
                                        "entry_id": "b45c2c6d-0669-357a-8e46-95f34ddb7be8",
                                        "glosses": [
                                            "Qui concerne les choses saintes, l’hagiographie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5570bd10-40df-42ac-b8ac-fea4ea6159b5",
                                                "sense_id": "b09f44e6-27e7-3e87-84ca-27cf2da775d9",
                                                "text": "Un récit hagiographique tend à décrire la vie d'une personne pieuse ou d'un saint d'une manière excessivement élogieuse."
                                            },
                                            {
                                                "example_id": "6264d24c-d808-4d8f-9c83-54d3f50702ae",
                                                "sense_id": "b09f44e6-27e7-3e87-84ca-27cf2da775d9",
                                                "text": "Ces saints et ces saintes ont tous une auréole en disque, à leur nom, qui s'accorde avec les médailles décoratives (hagiographiques et non antiquisantes) placées sur les montants du premier étage ; […]."
                                            },
                                            {
                                                "example_id": "efa6be7b-54d6-4698-85fb-161dc8b84fea",
                                                "sense_id": "b09f44e6-27e7-3e87-84ca-27cf2da775d9",
                                                "text": "Certains historiens d'aujourd'hui se font cependant moins hagiographique^([sic]) , qualifiant la reine Élisabeth 1ʳᵉ de souveraine plutôt indécise dont le succès s'expliquerait pas la qualité des personnages qui l'ont entourée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
