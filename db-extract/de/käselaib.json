                "senses": [
                    {
                        "sense_id": "8c2dad6f-f47e-3c61-b27f-abe8dbebba52",
                        "entry_id": "5a0e5f47-2b44-3d85-bad8-43df53bfc5bb",
                        "glosses": [
                            "größeres, rundes Stück Käse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c8a7315-5d75-4745-830d-b03955a2d42c",
                                "sense_id": "8c2dad6f-f47e-3c61-b27f-abe8dbebba52",
                                "text": "„Um den Käselaib zu schützen, wird er nach einer ersten Trockenphase in ein Salzbad gelegt oder in Trockensalz gewendet.“"
                            },
                            {
                                "example_id": "eca737cc-029a-4e45-a9ce-bc0ecc9b8d74",
                                "sense_id": "8c2dad6f-f47e-3c61-b27f-abe8dbebba52",
                                "text": "„Schulte verbrachte einen Tag damit, Requisiten zu kaufen, darunter einen Käselaib für 120 Euro, eine große Schweinshaxe und 15 Dosen Sauerkraut.“"
                            },
                            {
                                "example_id": "373a3f58-6ba1-4b14-a230-95d880c47eb5",
                                "sense_id": "8c2dad6f-f47e-3c61-b27f-abe8dbebba52",
                                "text": "„Wie gelb ein Käse ist, hängt vom Futter der Kühe und der Reifezeit des Käselaibs ab.“"
                            },
                            {
                                "example_id": "8eb04516-5935-4204-9432-a3dcd2fa0b47",
                                "sense_id": "8c2dad6f-f47e-3c61-b27f-abe8dbebba52",
                                "text": "„Sie verkaufen ihre Käselaibe lieber auf Märkten oder auch privat unter der Hand und verzichten dabei auf die offizielle D. O.-Kennzeichnung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
