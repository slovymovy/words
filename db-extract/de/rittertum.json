                "senses": [
                    {
                        "sense_id": "c205e348-da08-3752-8f46-bc677b4e254f",
                        "entry_id": "556526bf-53ef-34e2-b2ab-bb1fcbdf8955",
                        "glosses": [
                            "Chevalerie, institution militaire et religieuse du Moyen Âge qui imposait à ses membres la bravoure, la loyauté, la protection des faibles et la courtoisie envers les dames."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2fbf1887-a9ad-4832-b957-801538ae358b",
                                "sense_id": "c205e348-da08-3752-8f46-bc677b4e254f",
                                "text": "Die Waffenübungen, die einen Teil des Alltags des Ritters ausmachten, galten einerseits als Vorbereitung für die Schlacht, andererseits aber auch als Training für die glanzvolle Selbstdarstellung des Rittertums im Turnier.",
                                "translation": "Les exercices d'armes, qui faisaient partie du quotidien des chevaliers, servaient d’une part à les préparer au combat, mais d'autre part aussi à les entraîner à se mettre en valeur lors des tournois chevaleresques."
                            }
                        ]
                    }
