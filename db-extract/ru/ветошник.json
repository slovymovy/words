                        "entry_id": "9139ed0c-46e5-34a8-8d4e-0b14139f2222",
                        "glosses": [
                            "rag-and-bone man, ragman"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11855dc2-29d9-4434-886d-a7eefbb9e686",
                                "sense_id": "37df0336-d7ca-343b-b3f8-65ac8a9260ca",
                                "text": "Пуд тря́пок и бума́ги ве́тошники покупа́ли по двугри́венному, желе́зо — то́же, пуд косте́й по гри́веннику, по во́семь копе́ек.",
                                "translation": "The rag-and-bone men gave twenty copecks for thirty-six pounds of rags and paper, the same for metal, and eight or ten copecks for the same weight in bones.",
                                "english": "The rag-and-bone men gave twenty copecks for thirty-six pounds of rags and paper, the same for metal, and eight or ten copecks for the same weight in bones."
                            }
                        ]
                    }
