                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1b15af7-57b0-4c81-b3d6-3a7f29b57ecf",
                                "sense_id": "82e445d4-521d-3a0d-9db1-c47661de82b8",
                                "text": "„Du hast mich bisher jung und froh gekannt, und nun glaubst du, daß ich in deiner Abwesenheit leichtsinnig und verführbar sein werde.“"
