    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a55d07e9-224c-3ac3-8cc4-0e83c943cc6c",
                    "sense_definition": "Aplatir, briser ou déformer quelque chose en exerçant une forte pression ou un choc violent.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "impact_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il utilise une fourchette pour <w>écraser</w> des pommes de terre dans son assiette."
                        },
                        {
                            "text": "Prends garde à ne pas <w>écraser</w> les fruits fragiles au fond du panier."
                        }
                    ],
                    "synonyms": [
                        "écrabouiller"
                    ],
                    "common_phrases": [
                        "écraser une cigarette",
                        "écraser des pommes de terre"
                    ]
                },
                {
                    "sense_id": "9f2c8a9f-2d91-3cec-b5ab-dbfe44b659b0",
                    "sense_definition": "Heurter ou rouler sur quelqu'un ou un animal avec un véhicule.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "impact_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le petit chat a failli se faire <w>écraser</w> par une voiture sur cette route étroite."
                        },
                        {
                            "text": "Regarde bien à gauche et à droite avant de traverser pour ne pas te faire <w>écraser</w>."
                        }
                    ],
                    "common_phrases": [
