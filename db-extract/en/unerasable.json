                        "sense_id": "b7f8532b-fccc-3bcb-8596-799a6b542929",
                        "entry_id": "5bb8eb50-71ce-3ad0-9453-bd88bd512664",
                        "glosses": [
                            "That cannot be erased; indelible."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "47fd7bc1-8f1b-42da-922d-774afdd5e9eb",
                                "sense_id": "b7f8532b-fccc-3bcb-8596-799a6b542929",
                                "text": "He hesitated at first to read it – as if he feared that what he would read on the screen would remain for eternity unerasable."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ebea070f-a024-41d2-a74b-a433ed11cf06",
