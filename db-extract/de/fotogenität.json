                ],
                "senses": [
                    {
                        "sense_id": "a62e602c-3203-33cf-a7c1-0fe361332114",
                        "entry_id": "39a29535-3306-32b9-a4b3-54a2ad19ebde",
                        "glosses": [
                            "Eigenschaft, auf Aufnahmen (Fotos) ein ansprechendes Äußeres zu zeigen, zu einem gelungenen Bild beizutragen, das eine gewisse Ausstrahlung hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc60007f-180f-4370-8341-c43684a6dbef",
                                "sense_id": "a62e602c-3203-33cf-a7c1-0fe361332114",
                                "text": "„Fotogenität meint, daß sich auf der zweidimensionalen Fläche ein Eigenleben entfaltet, welches nicht exakt mit dem ursprünglichen, wirklichen Objekt in Deckung zu bringen ist.“"
                            },
                            {
                                "example_id": "ecc99a4c-13fa-434a-912f-4e788f8a2574",
                                "sense_id": "a62e602c-3203-33cf-a7c1-0fe361332114",
                                "text": "„Tisses Kamera entdeckte die Fotogenität von Industrielandschaften, sie zeigte die Wirkung eines Fabrikhofes.“"
                            },
                            {
                                "example_id": "da35dd95-9174-4280-bb8d-0086317e2ee4",
                                "sense_id": "a62e602c-3203-33cf-a7c1-0fe361332114",
                                "text": "„Die Formel für Fotogenität lautet wie folgt: Schönheit + Anmut + das gewisse Etwas + Kamerarealität = Fotogenität.“"
                            },
                            {
                                "example_id": "ed123687-f1d2-44b9-92d6-924f8570e380",
                                "sense_id": "a62e602c-3203-33cf-a7c1-0fe361332114",
                                "text": "„Die Frage nach der Schönheit des Modells lässt sich wirklich nur subjektiv beurteilen, Fotogensein ist hingegen mit ‚schön‘ oder ‚hübsch‘ NICHT gleichzusetzen. Für Fotogenität existiert sogar tatsächlich eine Formel!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
