                                    {
                                        "sense_id": "ac328cdf-e271-3482-90e6-d274c13a9197",
                                        "entry_id": "aa8be1f3-913c-328a-bb3a-e40a7655e5f3",
                                        "glosses": [
                                            "A smooth, chewy, sticky confection made by heating sugar and other ingredients until the sugars polymerize and become sticky."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06949f1f-789f-4760-9400-de5d2d5a2dc6",
                                                "sense_id": "ac328cdf-e271-3482-90e6-d274c13a9197",
                                                "text": "The usual technique for making caramel is to mix table sugar with some water, then heat until the water has boiled off and the molten sugar colors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ea67b20-4ccf-3f18-8ff0-ae02cc69b728",
                                        "entry_id": "aa8be1f3-913c-328a-bb3a-e40a7655e5f3",
                                        "glosses": [
                                            "A (sometimes hardened) piece of this confection."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1df79133-a0c3-431f-a49b-e84c848303b9",
                                                "sense_id": "0ea67b20-4ccf-3f18-8ff0-ae02cc69b728",
                                                "text": "Caramel has a rich, complex flavor and consistency, viscous and sticky and creamy all at once, that works well with most sweets and fruits, with coffee and chocolate, and even with salt: the prized caramels of Brittany are made with a notable dose of sea salt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9a771b1-ec3a-371e-a500-e04be6967565",
                                        "entry_id": "aa8be1f3-913c-328a-bb3a-e40a7655e5f3",
                                        "glosses": [
                                            "A yellow-brown color, like that of caramel."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "caramel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ace78b66-2b96-30c1-bad4-a1b9309a069a",
                                        "entry_id": "df25ddbe-e8da-3bb9-aab8-4cd01eb668fd",
                                        "glosses": [
                                            "Of a yellow-brown color."
