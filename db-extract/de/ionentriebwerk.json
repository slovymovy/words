                        "entry_id": "e97419f2-153f-33d9-a7f4-6e0b1c58d70e",
                        "glosses": [
                            "Antrieb, bei dem der Ausstoß eines Ionenstrahls für die Fortbewegung genutzt wird"
                        ],
                        "tags": [
                            "Raumfahrt"
                        ],
                        "examples": [
                            {
                                "example_id": "fc5df578-33ea-4fdc-9e32-9e4f6dc102fd",
                                "sense_id": "f8b3e55f-e8b9-39d4-afe1-9bbbfb7756f9",
                                "text": "„Sie hat nämlich kein chemisches Triebwerk an Bord, sondern ein Ionentriebwerk, das nur einen Schub von 70 Millinewton erreicht.“"
                            },
                            {
                                "example_id": "ac893e66-951f-45b1-baf3-86be0a81f7c4",
                                "sense_id": "f8b3e55f-e8b9-39d4-afe1-9bbbfb7756f9",
                                "text": "„Ionentriebwerke beschleunigen elektrisch geladene Partikel und stoßen sie entgegen der Flugrichtung aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
