                "senses": [
                    {
                        "sense_id": "3f524194-dd8f-32cd-9419-bc211def1382",
                        "entry_id": "c7954b40-c996-3224-9b5c-07c862c5e5ab",
                        "glosses": [
                            "Vokal, bei dem der Luftstrom durch die Nase austritt"
                        ],
                        "tags": [
                            "speziell Phonetik"
                        ],
                        "examples": [
                            {
                                "example_id": "dbc10ffc-b899-451f-9380-b56bad2ad7e2",
                                "sense_id": "3f524194-dd8f-32cd-9419-bc211def1382",
                                "text": "Das Deutsche kennt Nasalvokale nur in Fremdwörtern; z.B. in \"Balkon\" [balkɔ̃], das aus dem Französischen stammt."
                            },
                            {
                                "example_id": "9157ecf2-352c-444d-ab38-85521a810405",
                                "sense_id": "3f524194-dd8f-32cd-9419-bc211def1382",
                                "text": "Nasalvokale kommen u.a. im Französischen und im Polnischen vor."
                            },
                            {
                                "example_id": "f2197be6-cf82-45f5-85aa-b16b37688e4b",
                                "sense_id": "3f524194-dd8f-32cd-9419-bc211def1382",
                                "text": "„In 2.1.1. wurden die Nasalvokale des Deutschen, die in jüngeren französischen Lehnwörtern auftreten, beschrieben.“"
                            },
                            {
                                "example_id": "6a7b83eb-f628-43e7-a24f-593cc00180c0",
                                "sense_id": "3f524194-dd8f-32cd-9419-bc211def1382",
                                "text": "„Die vier Nasalvokale werden unterschiedlich realisiert.“"
                            },
                            {
                                "example_id": "08913dfc-8e20-4222-bfac-410d8e7afe80",
                                "sense_id": "3f524194-dd8f-32cd-9419-bc211def1382",
                                "text": "„Diese Feststellung, die JAKOBSON explizit auf die Aneignung der Nasalvokale und Liquidae bezieht, ist in dieser Verallgemeinerung wohl unstrittig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
