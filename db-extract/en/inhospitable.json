                        "cross_references": [
                            {
                                "target_word": "onherbergzaam",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "52a42491-cd1c-3bb3-8f7a-1c5382ed7aef",
                                        "entry_id": "b0a01e8d-a6a4-3b7d-baa0-9af6e9100a33",
                                        "glosses": [
                                            "een streek: woest en zonder goede verblijfplaatsen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bfd8376-5c96-42fc-8de5-8635694954ec",
                                                "sense_id": "52a42491-cd1c-3bb3-8f7a-1c5382ed7aef",
                                                "text": "Wij hebben deze vakantie een lange wandeltocht gemaakt door een mooie maar onherbergzame streek."
                                            },
                                            {
                                                "example_id": "cba81d0b-9d33-451f-9706-01a8f1d95ef4",
                                                "sense_id": "52a42491-cd1c-3bb3-8f7a-1c5382ed7aef",
                                                "text": "Weinigen die een goed woord overhebben voor de Amerikaanse monstertrucks: benzineslurpende speeltjes van te rijke boys with toys, die patserig uitpakken met hun pk’s. Maar in Texas winnen de ronkende motoren dezer dagen aan sympathie. In onherbergzaam gebied komen de trucks nu eenmaal goed van pas en blijken ze een uitstekend hulpmiddel om bewoners te evacueren, die door de overstromingen als gevolg van de orkaan Harvey ingesloten raakten."
                                            },
                                            {
                                                "example_id": "932ccf97-5b11-4fef-b13e-c5f2b4dd950a",
                                                "sense_id": "52a42491-cd1c-3bb3-8f7a-1c5382ed7aef",
                                                "text": "Samen met haar familie legde Uzbeki in 2015 een tocht van duizenden kilometers af om van de stad Kunduz in Afghanistan naar Zweden te komen. Op hun tocht trokken ze door de meest onherbergzame gebieden in landen als Iran, Turkije en Griekenland en werd de hoogbejaarde vrouw om beurten gedragen door haar zoon en kleinzonen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "627e307a-26ae-4592-94a2-c46a0247e202",
                        "source_entry_id": "1b257710-2939-3826-b4fe-844a709b0f97",
                        "source_sense_description": "Not offering shelter",
                        "target_lang_word": "inhospitalier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inhospitalier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b2e68b90-0602-32ce-ae9d-b7a9308e869e",
                                        "entry_id": "b040d132-ee09-3290-9629-67b48100e811",
                                        "glosses": [
                                            "Qui n’est pas hospitalier, qui n’exerce pas l’hospitalité, qui est inhumain envers les étrangers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "956aceb1-fe11-4f65-bab1-cc369bd896a5",
                                                "sense_id": "b2e68b90-0602-32ce-ae9d-b7a9308e869e",
                                                "text": "Irrité de ces préparatifs de la part de l’ermite, lesquels avaient évidemment pour objet d’appuyer ses intentions inhospitalières, le chevalier frappa la porte."
                                            },
                                            {
                                                "example_id": "ae6644e1-532f-4530-9927-4c6f081dd6c6",
                                                "sense_id": "b2e68b90-0602-32ce-ae9d-b7a9308e869e",
                                                "text": "Autrefois, […], ces Bochjesmen, menteurs et inhospitaliers, ne recherchaient que le meurtre et le pillage, et profitaient habituellement du sommeil de leurs ennemis pour les massacrer."
                                            },
                                            {
                                                "example_id": "96511096-5242-48aa-9c7b-c2f444957980",
                                                "sense_id": "b2e68b90-0602-32ce-ae9d-b7a9308e869e",
                                                "text": "Sur la côte inhospitalière de l’Atlantique battue par les vents et la houle du large, à mi-chemin environ entre le cap Spartel et Mogador, s'ouvre une baie spacieuse, entre un promontoire rocheux et une presqu’île frangée d'écume."
                                            },
                                            {
                                                "example_id": "8368e0a6-8e06-4cda-ba27-6a89512994ae",
                                                "sense_id": "b2e68b90-0602-32ce-ae9d-b7a9308e869e",
                                                "text": "En dehors de certaines zones très touristiques comme l’arrière-pays provençal ou la Dordogne, les habitants des zones rurales sont en général inhospitaliers, agressifs et stupides."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
