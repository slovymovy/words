                                        "glosses": [
                                            "Un des deux skis utilisés pour cette activité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67f6668b-7c49-4cbc-9f4a-b4f14201e599",
                                                "sense_id": "7633d2e7-a088-3102-a025-be3e23c3c5ca",
                                                "text": "Le Parmelan et Sous-Dine reçoivent deux sortes de visiteurs, selon qu’ils sont chaussés de skis de fond, ou de skis alpins munis de fixations dégageant le talon."
                                            }
