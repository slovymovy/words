                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "7340c499-0b63-301b-953b-181bb9da8a48",
                        "entry_id": "b5ca0e06-c6e8-375f-a8be-ae03b684c606",
                        "glosses": [
                            "A hole formed by a pig when it roots in the ground."
