                        "examples": [
                            {
                                "example_id": "53eaeff7-b50e-404f-a115-067d44fc9b55",
                                "sense_id": "b6a42d11-1bc0-3b00-bc92-ff33b61fad20",
                                "text": "„Alice wollte Ferris die Kreuzfahrerburg in Kerak zeigen – eine Festung, die der brutale Renaud de Chatillon im 12. Jahrhundert zu seinem Hauptquartier gemacht hatte.“"
                            },
                            {
                                "example_id": "cb0642c2-a9bb-4262-8c75-5c3efc009bb7",
                                "sense_id": "b6a42d11-1bc0-3b00-bc92-ff33b61fad20",
                                "text": "„Sechs oder sieben Jahre nach ihrem Eintreffen in Palästina bauten die Neuankömmlinge den Kibbuz am Fuß einer abgelegenen Kreuzfahrerburg in Galiläa auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
