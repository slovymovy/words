                "senses": [
                    {
                        "sense_id": "22a6d2ba-b125-3d9d-bfd0-91ea81442e33",
                        "entry_id": "1bd2ee15-33b2-343c-b440-e6492b33c086",
                        "glosses": [
                            "Person, die bewacht, bewahrt, verteidigt (schützt)"
                        ],
                        "tags": [
                            "literary",
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "a6bfee22-be94-4fde-afc3-c14e6bf2532b",
                                "sense_id": "22a6d2ba-b125-3d9d-bfd0-91ea81442e33",
                                "text": "Sie sind hier die Schützer der Ordnung, von Hab und Gut, von Leib und Leben."
                            },
                            {
                                "example_id": "62f8e8ce-31f8-4df0-a483-c285767b0e32",
                                "sense_id": "22a6d2ba-b125-3d9d-bfd0-91ea81442e33",
                                "text": "„[…], so war er dennoch ein gesegneter, hochbegnadigter Prediger des Evangeliums und vor allem ein treuer, furchtloser, unermüdlicher Schützer, Fürsprecher und Vertheidiger des bedrängten Volkes, […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ee63852e-af10-35fe-ba37-a14d47eb9f08",
                        "entry_id": "1bd2ee15-33b2-343c-b440-e6492b33c086",
                        "glosses": [
                            "Bekleidungsstück, das eine Körperpartie bedeckt, wärmt und vor Verletzung schützt"
                        ],
                        "tags": [
                            "short-form"
                        ],
                        "examples": [
                            {
                                "example_id": "8976f513-9e41-45c3-bc07-1008b513938b",
                                "sense_id": "ee63852e-af10-35fe-ba37-a14d47eb9f08",
                                "text": "Der Kleine braucht noch einen regenfesten Anzug und Schützer für die Knie."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
