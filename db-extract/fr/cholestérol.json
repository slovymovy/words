                                "target_senses": [
                                    {
                                        "sense_id": "22a5b9c8-1051-35f3-9692-005a5b1a37cc",
                                        "entry_id": "431f15eb-8cfd-39f4-81bf-3c0f13198ffb",
                                        "glosses": [
                                            "ein Lipid, Bestandteil tierischer Plasmamembranen"
                                        ],
                                        "tags": [
                                            "Biochemie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23934a06-7341-47b7-8601-227b96bfb3ae",
                                                "sense_id": "22a5b9c8-1051-35f3-9692-005a5b1a37cc",
                                                "text": "Cholesterin spielt eine lebenswichtige Rolle im menschlichen Organismus."
                                            },
                                            {
                                                "example_id": "99d4319c-76b2-465b-93ce-96a4003c0273",
                                                "sense_id": "22a5b9c8-1051-35f3-9692-005a5b1a37cc",
                                                "text": "„Die anderen schmieren sich bioaktives Streichfett unnötigerweise aufs Brot - und das, obwohl neuere Studien darauf hindeuten, dass zu viele der pflanzlichen Blutfettsenker die Arterien womöglich ähnlich verkalken lassen wie das Cholesterin selbst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "97ed6d73-d86d-4178-a499-a15e4c78a67a",
                        "source_entry_id": "6aed625d-1d62-31a4-95ec-81bc4d7823fb",
