                ],
                "senses": [
                    {
                        "sense_id": "fb7b0280-8ba1-3ee2-8770-4d6442dc02b9",
                        "entry_id": "0517bc11-863a-3d06-b0c3-448af054e97a",
                        "glosses": [
                            "een gevoel dat iemand aanzet tot krabben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ac682f6-ea0d-461f-b281-78c737162b30",
                                "sense_id": "fb7b0280-8ba1-3ee2-8770-4d6442dc02b9",
                                "text": "De processierups is al jarenlang met een forse opmars bezig. Het probleem zit 'm daarbij vooral in de afgestoten brandhaartjes, die bij aanraking een jeukerig en branderig gevoel geven."
                            },
                            {
                                "example_id": "63c0f819-551b-4aaf-a745-c7906a3bfc4d",
                                "sense_id": "fb7b0280-8ba1-3ee2-8770-4d6442dc02b9",
                                "text": "Als 68-jarige man heb ik vreselijk last van rusteloze benen. Elke avond rond zes uur krijg ik een jeukerig gevoel in de benen. Elke tien seconden moet ik mijn spieren kortstondig ongecontroleerd bewegen. Alleen lopen helpt enigszins."
                            }
                        ]
                    },
                    {
                        "sense_id": "58d69a9a-0e40-39d0-b722-914faf04e36b",
                        "entry_id": "0517bc11-863a-3d06-b0c3-448af054e97a",
                        "glosses": [
                            "irritant"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b92dd9b6-d5e8-4535-bc9f-d5ab71641f6d",
                                "sense_id": "58d69a9a-0e40-39d0-b722-914faf04e36b",
                                "text": "Het menu blijkt een eclectisch ratjetoe van gerechtjes om te delen - shared dining zegt de serveerster, een nogal jeukerige benaming voor deze tapas- of smörgåsbordachtige opzet."
                            },
                            {
                                "example_id": "883fc308-b517-45de-8249-0a2313f28c60",
                                "sense_id": "58d69a9a-0e40-39d0-b722-914faf04e36b",
                                "text": "Waar ik op kantoor dus echt helemaal jeukerig van word, is dat ge-sorry de godganselijke dag. „Sorry maar ik zet even het raam open”, „sorry, maar ik haal even koffie”, „sorry, maar ik heb gisteren tien tenen knoflook gegeten”, „sorry maar ik heb open tbc maar ga toch tegenover je zitten blaffen.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bf2f7e19-018a-4b55-a7b7-f28240e2f8ce",
                        "source_entry_id": "0517bc11-863a-3d06-b0c3-448af054e97a",
                        "source_sense_id": "fb7b0280-8ba1-3ee2-8770-4d6442dc02b9",
                        "target_lang_word": "scratchy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scratchy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "973b8578-fef9-3dc1-8caf-6de6e64ddb55",
                                        "entry_id": "37299e33-c475-3601-aa67-9c8372eb709a",
                                        "glosses": [
                                            "Characterized by scratches."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aeefcf7b-a6d3-4b98-a2a0-ff5567219da9",
                                                "sense_id": "973b8578-fef9-3dc1-8caf-6de6e64ddb55",
                                                "text": "An indulgent playmate, Grannie would lay aside the long scratchy-looking letter she was writing (heavily crossed ‘to save notepaper’) and enter into the delightful pastime of ‘a chicken from Mr Whiteley's’."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e43d2e9-9d10-3608-8941-03f10be5bb2e",
                                        "entry_id": "37299e33-c475-3601-aa67-9c8372eb709a",
                                        "glosses": [
                                            "Irritating; itchy."
                                        ],
                                        "tags": [
                                            "of a sore throat"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6c013a54-8d50-3793-9ac2-6c22c7e2b9e4",
                                        "entry_id": "37299e33-c475-3601-aa67-9c8372eb709a",
                                        "glosses": [
                                            "Noisy, lossy; marred by white noise or static as a result of poor or low signal, interference or unfavourable atmospheric conditions."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2cfa0109-b6ad-4b7f-8bb1-7bc2a7b1fcb0",
                                                "sense_id": "6c013a54-8d50-3793-9ac2-6c22c7e2b9e4",
                                                "text": "The FM station two hundred miles away was receivable, but the audio was too scratchy to positively identify."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e83ecfe5-766d-3ae4-ac22-f9d9cf1bdf62",
                                        "entry_id": "37299e33-c475-3601-aa67-9c8372eb709a",
                                        "glosses": [
                                            "Having popping and/or crackling sounds due to excessive wear, especially from scratch marks."
                                        ],
                                        "tags": [
                                            "of a phonograph record"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4212207-d51d-42bb-9282-8a00632fd391",
                                                "sense_id": "e83ecfe5-766d-3ae4-ac22-f9d9cf1bdf62",
                                                "text": "Once he almost fell asleep, and then the little record player started up in his mother and father's bedroom. Mom was playing her scratchy Elvis 45s again."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f15675d8-56f4-32cc-9d71-ec1ea49c2f27",
                                        "entry_id": "37299e33-c475-3601-aa67-9c8372eb709a",
                                        "glosses": [
                                            "Irritable; tetchy."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7583cd4-1e98-41a1-9c03-345bde4a8571",
                                                "sense_id": "f15675d8-56f4-32cc-9d71-ec1ea49c2f27",
                                                "text": "'Now, now, don't get scratchy,' said Casali. 'You've got enough troubles of your own. […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c0c53df3-ff5b-402e-973e-e916674b57aa",
                        "source_entry_id": "0517bc11-863a-3d06-b0c3-448af054e97a",
                        "source_sense_id": "fb7b0280-8ba1-3ee2-8770-4d6442dc02b9",
                        "target_lang_word": "itching",
                        "target_lang_code": "en",
