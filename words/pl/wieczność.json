{
    "word_family": [
        "wieczny",
        "wiecznie",
        "uwiecznić",
        "uwiecznienie",
        "przedwieczny"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6382a412-4bf6-3d11-80a3-f1a2fe784da7",
                    "sense_definition": "Bardzo długi czas, który wydaje się nie mieć końca; często używane w przesadni.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "time_duration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Czekaliśmy na ten autobus chyba całą <w>wieczność</w>.",
                            "target_lang_translations": {
                                "ru": "Мы ждали этого автобуса, кажется, целую <w>вечность</w>.",
                                "en": "We waited for that bus for what felt like an <w>eternity</w>."
                            }
                        },
                        {
                            "text": "Naprawa tego starego komputera trwa <w>wieczność</w>.",
                            "target_lang_translations": {
                                "ru": "Ремонт этого старого компьютера длится <w>вечность</w>.",
                                "en": "Repairing this old computer is taking an <w>eternity</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "wieki"
                    ],
                    "antonyms": [
                        "mgnienie oka"
                    ],
                    "common_phrases": [
                        "cała wieczność",
                        "trwać wieczność"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "używane hiperbolicznie"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень долгое время, которое кажется бесконечным; часто используется как преувеличение.",
                        "en": "A very long time that seems endless; often used hyperbolically."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вечность",
                                "target_lang_sense_clarification": "очень долгое время"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "eternity",
                                "target_lang_sense_clarification": "a very long time, hyperbolic"
                            },
                            {
                                "target_lang_word": "ages",
                                "target_lang_sense_clarification": "a very long time"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "da9fe963-5b33-38e8-a500-4c14c03aa508",
                    "sense_definition": "Nieskończone trwanie bez początku i końca; istnienie poza czasem.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "infinity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Według wielu religii dusza człowieka trwa przez całą <w>wieczność</w>.",
                            "target_lang_translations": {
                                "ru": "Согласно многим религиям, душа человека будет жить всю <w>вечность</w>.",
                                "en": "According to many religions, the human soul endures for all <w>eternity</w>."
                            }
                        },
                        {
                            "text": "Filozofowie od dawna próbują zdefiniować pojęcie <w>wieczności</w>.",
                            "target_lang_translations": {
                                "ru": "Философы давно пытаются определить понятие <w>вечности</w>.",
                                "en": "Philosophers have long tried to define the concept of <w>eternity</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "nieskończoność"
                    ],
                    "antonyms": [
                        "doczesność"
                    ],
                    "common_phrases": [
                        "na wieczność",
                        "przez wieczność"
                    ],
                    "target_lang_definitions": {
                        "ru": "Бесконечное существование без начала и конца; бытие вне времени.",
                        "en": "Infinite duration without beginning or end; timeless existence."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вечность",
                                "target_lang_sense_clarification": "бесконечность"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "eternity",
                                "target_lang_sense_clarification": "infinite time, timelessness"
                            },
                            {
                                "target_lang_word": "perpetuity",
                                "target_lang_sense_clarification": "endless duration"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f2849a4-7f89-39af-931a-b06aa4fac77f",
                    "sense_definition": "Życie po śmierci; bytowanie duszy w zaświatach.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "afterlife",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wierni modlą się o szczęśliwą <w>wieczność</w> dla zmarłych.",
                            "target_lang_translations": {
                                "ru": "Верующие молятся о счастливой <w>вечности</w> для усопших.",
                                "en": "The faithful pray for a blessed <w>eternity</w> for the deceased."
                            }
                        },
                        {
                            "text": "Po długiej chorobie artysta odszedł do <w>wieczności</w>.",
                            "target_lang_translations": {
                                "ru": "После продолжительной болезни художник ушел в <w>вечность</w>.",
                                "en": "After a long illness, the artist passed into <w>eternity</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "życie wieczne"
                    ],
                    "antonyms": [
                        "doczesność"
                    ],
                    "common_phrases": [
                        "odejść do wieczności",
                        "próg wieczności"
                    ],
                    "target_lang_definitions": {
                        "ru": "Жизнь после смерти; существование души в загробном мире.",
                        "en": "Life after death; existence of the soul in the afterlife."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вечность",
                                "target_lang_sense_clarification": "загробная жизнь"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "eternity",
                                "target_lang_sense_clarification": "the afterlife"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}