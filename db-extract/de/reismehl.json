                                "example_id": "1a2b9510-3c54-48e9-9a4d-9d6af6f4adc9",
                                "sense_id": "5c1699d4-60d6-32a1-97e7-8cabc5589915",
                                "text": "„Reismehl eignet sich nicht zum Backen, da ihm das Gluten fehlt.“"
                            },
                            {
                                "example_id": "5b9ed39c-2523-4519-a60b-df527255f16d",
                                "sense_id": "5c1699d4-60d6-32a1-97e7-8cabc5589915",
                                "text": "„Neuerdings verwenden die Frauen anstelle von Reismehl häufig industriell gefertigtes Steinpulver, Kreide oder dickflüssigen Farbstoff.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
