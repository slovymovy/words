                    {
                        "translation_id": "5a479024-1713-402d-8944-9498f118ae0d",
                        "source_entry_id": "c903feac-d1d7-3f35-96a2-78259a4e1dd4",
                        "source_sense_id": "b84951ce-dd99-3cfb-99ce-7ffb0abb255b",
