                                            {
                                                "example_id": "21c76a37-649c-4e11-a45c-c1f79f4e92a1",
                                                "sense_id": "a4148a54-475e-32b2-8bff-86561460e776",
                                                "text": "It says here on your resume that your last job was as a streetcorner apple vendor and that you haven't worked since the thirties."
                                            },
                                            {
                                                "example_id": "7b30cb00-c318-4c6a-ae95-184444ef653d",
                                                "sense_id": "a4148a54-475e-32b2-8bff-86561460e776",
                                                "text": "The Road to Glory, while not the best, was likewise not the least of the thirties films which may justly be called \"anti-war\" in both intent and execution."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ee007f7-ff00-3a5b-b1b9-b8b669319106",
                                        "entry_id": "32e4dd9a-6e8c-3b91-a7bc-7a82f9df5030",
                                        "glosses": [
                                            "The decade of one's life from age 30 through age 39."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "761f6cac-9a75-4d1e-8298-8005c342b7ee",
                                                "sense_id": "0ee007f7-ff00-3a5b-b1b9-b8b669319106",
                                                "text": "He looked to be in his thirties."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64dbf472-424c-36b0-9926-359b0fac074e",
                                        "entry_id": "32e4dd9a-6e8c-3b91-a7bc-7a82f9df5030",
                                        "glosses": [
                                            "The range between 30 and 39."
                                        ],
                                        "tags": [
                                            "plural",
