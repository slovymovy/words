{
    "word_family": [
        "sturdiness",
        "sturdily"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "50d40302-4640-335c-b83e-14715b723dad",
                    "sense_definition": "Strong and solid in structure or physical build, capable of withstanding pressure or wear.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_strength",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was a <w>sturdy</w> building, able to withstand strong winds and cold weather.",
                            "target_lang_translations": {
                                "ru": "Это было <w>прочное</w> здание, способное выдержать сильные ветры и холодную погоду."
                            }
                        },
                        {
                            "text": "The <w>sturdy</w> table did not wobble even when we placed heavy boxes on it.",
                            "target_lang_translations": {
                                "ru": "<w>Крепкий</w> стол даже не пошатнулся, когда мы поставили на него тяжелые коробки."
                            }
                        }
                    ],
                    "synonyms": [
                        "hardy"
                    ],
                    "antonyms": [
                        "flimsy",
                        "weak",
                        "fragile"
                    ],
                    "common_phrases": [
                        "sturdy building",
                        "sturdy pair of boots",
                        "sturdy construction"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прочный и надежный по структуре или физическому телосложению, способный выдерживать давление или износ."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крепкий",
                                "target_lang_sense_clarification": "о телосложении или конструкции"
                            },
                            {
                                "target_lang_word": "прочный",
                                "target_lang_sense_clarification": "о материалах и вещах"
                            },
                            {
                                "target_lang_word": "добротный",
                                "target_lang_sense_clarification": "качественно сделанный"
                            },
                            {
                                "target_lang_word": "мощный",
                                "target_lang_sense_clarification": "о строениях или технике"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "df60fbc7-d85d-3ca6-a469-371ccaf732bf",
                    "sense_definition": "Showing determination and firmness in character, beliefs, or actions.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "character_trait",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The community showed <w>sturdy</w> resistance against the unfair new laws.",
                            "target_lang_translations": {
                                "ru": "Община оказала <w>стойкое</w> сопротивление несправедливым новым законам."
                            }
                        },
                        {
                            "text": "He was a man of <w>sturdy</w> independence who refused to ask for help.",
                            "target_lang_translations": {
                                "ru": "Он был человеком <w>непоколебимой</w> независимости и отказывался просить о помощи."
                            }
                        }
                    ],
                    "synonyms": [
                        "hardy"
                    ],
                    "antonyms": [
                        "irresolute",
                        "wavering"
                    ],
                    "common_phrases": [
                        "sturdy independence",
                        "sturdy resistance",
                        "sturdy support"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проявляющий решительность и твердость в характере, убеждениях или действиях."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стойкий",
                                "target_lang_sense_clarification": "о сопротивлении или характере"
                            },
                            {
                                "target_lang_word": "непоколебимый",
                                "target_lang_sense_clarification": "о независимости или вере"
                            },
                            {
                                "target_lang_word": "решительный",
                                "target_lang_sense_clarification": "о действиях"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a22b32e2-155c-3550-ae64-461bb53758e9",
                    "sense_definition": "Stubbornly or foolishly persistent in an opinion or course of action.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "character_trait",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>sturdy</w> sinner refused to repent despite the warnings of the priest.",
                            "target_lang_translations": {
                                "ru": "<w>Упрямый</w> грешник отказывался каяться, несмотря на предостережения священника."
                            }
                        },
                        {
                            "text": "No one was so <w>sturdy</w> as to gainsay the king's direct command.",
                            "target_lang_translations": {
                                "ru": "Никто не был настолько <w>дерзок</w>, чтобы перечить прямому приказу короля."
                            }
                        }
                    ],
                    "antonyms": [
                        "compliant",
                        "yielding"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in older literature to mean stubborn"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Упрямо или глупо настойчивый в своем мнении или образе действий (устаревшее)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "упрямый",
                                "target_lang_sense_clarification": "не желающий уступать"
                            },
                            {
                                "target_lang_word": "непокорный",
                                "target_lang_sense_clarification": "отказывающийся подчиняться"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "896d545b-e8b5-3a06-85a9-c96b933f7aa6",
                    "sense_definition": "A parasitic disease in sheep and other animals caused by tapeworm larvae in the brain, leading to staggering.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "veterinary_disease",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer noticed several sheep in the flock were suffering from <w>sturdy</w>.",
                            "target_lang_translations": {
                                "ru": "Фермер заметил, что несколько овец в стаде страдали от <w>вертячки</w>."
                            }
                        },
                        {
                            "text": "Veterinary records indicate that <w>sturdy</w> is often fatal if the cysts are not removed.",
                            "target_lang_translations": {
                                "ru": "Ветеринарные записи указывают на то, что <w>ценуроз</w> часто приводит к летальному исходу, если кисты не удалены."
                            }
                        }
                    ],
                    "synonyms": [
                        "gid",
                        "turnsick"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "used in agricultural contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Паразитарное заболевание овец и других животных, вызываемое личинками ленточного червя в мозгу, приводящее к шаткой походке."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вертячка",
                                "target_lang_sense_clarification": "ветеринарный термин"
                            },
                            {
                                "target_lang_word": "ценуроз",
                                "target_lang_sense_clarification": "научное название болезни"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "e5050269-30c6-3619-8b67-858f532e0904",
                    "sense_definition": "An English surname derived from the Middle English word for strong or reckless.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The local library was named after the <w>Sturdy</w> family who donated the land.",
                            "target_lang_translations": {
                                "ru": "Местная библиотека была названа в честь семьи <w>Стерди</w>, которая пожертвовала землю."
                            }
                        },
                        {
                            "text": "Professor <w>Sturdy</w> published a groundbreaking paper on medieval history.",
                            "target_lang_translations": {
                                "ru": "Профессор <w>Стерди</w> опубликовал новаторскую работу по средневековой истории."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English origin"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Английская фамилия, происходящая от среднеанглийского слова, означающего «сильный» или «безрассудный»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Стерди",
                                "target_lang_sense_clarification": "транслитерация фамилии"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}