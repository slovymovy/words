                        "glosses": [
                            "The state or fact of being nothing; nothingness, nullity; nonexistence."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "fddb131d-d7a1-4e96-9e2b-725a337c6ea5",
                                "sense_id": "6c26812f-e769-32c5-a476-3f006850878a",
                                "text": "Paeans and even poems have been written to the esoteric nature of the smallest building blocks of matter: how they manifest as everywhere and nowhere, seem to have come out of emptiness, and at the ultimate level seem to be distilled from pure nihility."
                            }
                        ]
                    },
