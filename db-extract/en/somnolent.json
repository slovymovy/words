                        "form": "most somnolent"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "180999eb-ff81-31fd-91b0-9205e6e776b8",
                        "entry_id": "a0b36908-c0eb-3a5a-bc0f-01e5135442cc",
                        "glosses": [
                            "Drowsy or sleepy."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca18b10e-2746-4d13-a3e5-ffacd0aa613d",
                                "sense_id": "180999eb-ff81-31fd-91b0-9205e6e776b8",
                                "text": "One minute she was gazing at a mockup of a space capsule, safely surrounded by old, somnolent men; […]"
                            },
                            {
                                "example_id": "9b36d6d3-e745-4409-9235-eeed85a3d1cc",
                                "sense_id": "180999eb-ff81-31fd-91b0-9205e6e776b8",
                                "text": "[…]; and in chronicling the passing parade of Harry's life, the books have also created a Kodachrome-sharp picture of American life - the psychic ups and downs, enthusiasms and reversals experienced by this nation as it moved from the somnolent 50's through the upheavals of the 60's and 70's into the uncertainties of the 80's."
                            },
                            {
                                "example_id": "88ece87a-4de3-4ec2-98c2-a7fb9f6807d1",
                                "sense_id": "180999eb-ff81-31fd-91b0-9205e6e776b8",
                                "text": "My tiger is deep\nin somnolent sleep\ndreaming of chases remembered!\nHis keen eyes are glinting!\nHe dreams of a sprinting\nsambar who'll soon be dismembered!"
                            }
                        ]
                    },
                    {
                        "sense_id": "d4a304e3-4a19-3c50-81a8-517f381290c7",
                        "entry_id": "a0b36908-c0eb-3a5a-bc0f-01e5135442cc",
                        "glosses": [
                            "Causing literal or figurative sleepiness."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "6db887db-941c-4ed3-b493-cb4bc36fe0a8",
                                "sense_id": "d4a304e3-4a19-3c50-81a8-517f381290c7",
                                "text": "As she reached toward the last few fiddleheads growing on the second hummock, her hand froze. She heard the somnolent buzzing of flies again."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f0647dac-0fc8-483a-92b8-87b20fae1052",
                        "source_entry_id": "a0b36908-c0eb-3a5a-bc0f-01e5135442cc",
