{
    "word_family": [
        "curieux",
        "curieusement"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c109f23a-637a-3a04-8055-589fc95bd490",
                    "sense_definition": "Désir ou empressement naturel de voir, d'apprendre ou de découvrir des choses nouvelles.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "envie_de_savoir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette exposition sur l'espace a éveillé la <w>curiosité</w> de tous les élèves de la classe."
                        },
                        {
                            "text": "Elle a posé plusieurs questions simplement par <w>curiosité</w>, sans aucune mauvaise intention."
                        }
                    ],
                    "synonyms": [
                        "intérêt"
                    ],
                    "antonyms": [
                        "indifférence",
                        "désintérêt"
                    ],
                    "common_phrases": [
                        "par curiosité",
                        "éveiller la curiosité",
                        "curiosité intellectuelle"
                    ]
                },
                {
                    "sense_id": "a54f23cd-5024-316e-816e-ff9be7368967",
                    "sense_definition": "Chose, fait ou phénomène remarquable, rare ou étrange qui attire l'attention.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "chose_rare",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet ancien château constitue la principale <w>curiosité</w> architecturale de la région."
                        },
                        {
                            "text": "Le guide nous a présenté les nombreuses <w>curiosités</w> naturelles de cette île volcanique."
                        }
                    ],
                    "synonyms": [
                        "singularité",
                        "rareté",
                        "attraction"
                    ],
                    "common_phrases": [
                        "curiosité locale",
                        "cabinet de curiosités"
                    ]
                },
                {
                    "sense_id": "0125d632-5bf7-3abc-9a1b-46b011b8fcf8",
                    "sense_definition": "Désir excessif ou indiscret de connaître les secrets ou les affaires d'autrui.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "envie_de_savoir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son voisin surveillait toujours ses allées et venues avec une <w>curiosité</w> très agaçante."
                        },
                        {
                            "text": "Il a refusé de répondre pour punir la <w>curiosité</w> indiscrète de ses collègues."
                        }
                    ],
                    "synonyms": [
                        "indiscrétion",
                        "inquisition"
                    ],
                    "antonyms": [
                        "discrétion"
                    ],
                    "common_phrases": [
                        "curiosité malsaine",
                        "satisfaire sa curiosité"
                    ]
                },
                {
                    "sense_id": "e1bb441e-43ef-3a6f-bc4e-0c0a5274b431",
                    "sense_definition": "Goût particulier pour la recherche et la collection d'objets rares, précieux ou insolites.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "chose_rare",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce passionné d'art ancien possédait de remarquables objets de <w>curiosité</w> dans son salon."
                        },
                        {
                            "text": "Amateur éclairé de <w>curiosité</w>, il remplissait ses vitrines de coquillages et de médailles rares."
                        }
                    ],
                    "synonyms": [
                        "collectionnisme"
                    ],
                    "common_phrases": [
                        "objets de curiosité",
                        "marchand de curiosités"
                    ]
                }
            ]
        }
    ]
}