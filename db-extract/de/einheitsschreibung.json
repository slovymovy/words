                            {
                                "example_id": "9b891b1f-b888-4eaf-b3ee-56906e090b59",
                                "sense_id": "ebf4c06f-5380-31da-8cc1-c9d232659bcc",
                                "text": "„Im Deutschen Reich kam es 1876 und 1901 zu orthographischen Konferenzen, von denen die erste nichts, die zweite aber immerhin die Einheitsschreibung im ganzen Reich brachte, jeweils unter starker Beteiligung des Schulmeisters Konrad Duden.“"
                            },
                            {
                                "example_id": "c01c9efc-b320-47bf-a46a-f6674747acac",
                                "sense_id": "ebf4c06f-5380-31da-8cc1-c9d232659bcc",
                                "text": "„Er führte die Einheitsschreibung zunächst in Deutschland und in der Folge im gesamten deutschen Sprachraum herbei.“"
                            }
                        ],
