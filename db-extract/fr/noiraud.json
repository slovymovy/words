                        "glosses": [
                            "Celui qui a le teint brun et les cheveux noirs."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "d2332fb0-4e82-4137-83fc-d22e62e4721e",
                                "sense_id": "3f4559e1-af4c-316e-beb9-d290089e9a41",
                                "text": "Le noiraud ne me quittait pas des yeux."
                            }
                        ]
