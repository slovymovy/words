                    {
                        "translation_id": "0a4f3da7-ed0d-4a3f-a725-4514d85f41d6",
                        "source_entry_id": "d8732672-b10f-3416-a504-bdf4812ac0c8",
                        "source_sense_description": "Иноязычные аналоги",
                        "target_lang_word": "Raphaël",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Raphaël",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f04a3898-f10b-36ed-baac-45cf7f7e542b",
                                        "entry_id": "cf58735c-dc92-32b2-9ec6-f5c7c3914662",
                                        "glosses": [
                                            "Prénom masculin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fab4f231-3bbf-4317-8519-2a2bed0585d7",
                                                "sense_id": "f04a3898-f10b-36ed-baac-45cf7f7e542b",
                                                "text": "Ils dormaient tous les deux sur la banquette du fond, Raphaël et Méthode."
                                            },
                                            {
                                                "example_id": "973b0f28-97fe-41fe-a231-71e52afcde4a",
                                                "sense_id": "f04a3898-f10b-36ed-baac-45cf7f7e542b",
                                                "text": "Le maire divers droite de Soyaux, François Nebout, était sur la même longueur d’onde que l’élu d’opposition d’extrême gauche Raphaël Manzanas."
                                            },
                                            {
                                                "example_id": "b7cb16ef-fffa-45ee-905c-055fb2eec67a",
                                                "sense_id": "f04a3898-f10b-36ed-baac-45cf7f7e542b",
                                                "text": "Raphaël Ruegger souligne également l’impact bénéfique et immédiat de l’infrastructure."
                                            },
                                            {
                                                "example_id": "3623b75f-ee98-43d6-984c-703fe2cfb9c8",
                                                "sense_id": "f04a3898-f10b-36ed-baac-45cf7f7e542b",
                                                "text": "Pour ne pas céder à la tentation du diable comme il le disait dans des moments d’épreuves difficiles, Raphaël se lava ponce-pilatement les mains."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Raphaël",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d18b3f9a-4185-3880-b43a-d7eeb181ae7d",
                                        "entry_id": "490760a7-8f9f-329f-b054-f16a732bd069",
                                        "glosses": [
                                            "Raphaël, archange mentionné dans l’Ancien Testament."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5588559f-22c0-4315-a4ac-fd391595bc47",
                                                "sense_id": "d18b3f9a-4185-3880-b43a-d7eeb181ae7d",
                                                "text": "Malgré ses airs moresques, Cordoue est pourtant bonne chrétienne et placée sous la protection spéciale de l’archange Raphaël. Du balcon de notre parador, nous voyions s’élever un monument assez bizarre en l’honneur de ce patron céleste ; nous eûmes envie de l’examiner de plus près. L’archange Raphaël, du haut de sa colonne, l’épée à la main, les ailes déployées, scintillant de dorure, semble une sentinelle veillant éternellement sur la ville confiée à sa garde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb8c91e0-f891-366e-8459-65ff09dc27e5",
                                        "entry_id": "490760a7-8f9f-329f-b054-f16a732bd069",
                                        "glosses": [
                                            "Raphaël, peintre de la Renaissance italienne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88561a16-30a0-4224-9b22-d8c17bbfc39d",
                                                "sense_id": "bb8c91e0-f891-366e-8459-65ff09dc27e5",
                                                "text": "Quand bien même, dès lors, la figure ne serait pas de Raphaël, elle demeurerait raphaëlesque."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d15cd690-21cf-3a4f-8143-4752c0e55ae7",
                                        "entry_id": "490760a7-8f9f-329f-b054-f16a732bd069",
                                        "glosses": [
                                            "Tableau peint par Raphaël."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21233ccb-a7f2-431b-a419-0b275625ce73",
                                                "sense_id": "d15cd690-21cf-3a4f-8143-4752c0e55ae7",
                                                "text": "Le charme irrésistible des Raphaël provient de la profondeur des caractères et des expressions ; mais ici l’enveloppe est plus mâle et plus énergique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
