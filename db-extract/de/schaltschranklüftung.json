                "senses": [
                    {
                        "sense_id": "af1a4170-f790-36cd-b1f5-a7592ceccc72",
                        "entry_id": "3a181e8b-b286-3934-a3f6-c802dc87a0ca",
                        "glosses": [
                            "selbsttätige, technische Lüftung eines Schaltschranks"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2414d50-b1e0-438f-9ace-97f309b853e7",
                                "sense_id": "af1a4170-f790-36cd-b1f5-a7592ceccc72",
                                "text": "„Ein abgerundetes und ganzheitliches Bild des Objekts entsteht aber erst dann, wenn zu der Begutachtung der Wärmebilder und der optischen Sichtprüfung auch die Wechselwirkung zwischen Last, der Anordnung von Bauteilen, Erwärmung, Berührungsschutz, Oberwellenproblematik sowie der Schaltschranklüftung und ihrer Klimatisierung berücksichtigt werden.“"
                            },
                            {
                                "example_id": "9f2464f4-db78-4df7-b0c9-0c3a0e75f929",
                                "sense_id": "af1a4170-f790-36cd-b1f5-a7592ceccc72",
                                "text": "„In Güntner Schaltschränken ist eine ausreichend dimensionierte Schaltschranklüftung vorgesehen.“"
                            },
                            {
                                "example_id": "fdf48d78-9a16-461c-a9bb-67fffd07391c",
                                "sense_id": "af1a4170-f790-36cd-b1f5-a7592ceccc72",
                                "text": "„Bei Außenaufstellung sind Schaltschranklüftung und –heizung erforderlich.“"
                            },
                            {
                                "example_id": "28701505-c928-4181-8e6f-4808f8851e23",
                                "sense_id": "af1a4170-f790-36cd-b1f5-a7592ceccc72",
                                "text": "„Ganzheitlich … wird Elektro-Thermografie betrieben, wenn neben der reinen Fehlersuche anhand der Wärmebilder und der optischen Sichtprüfung auch Wechselwirkungen zwischen Last, Erwärmung, der Anordnung von Bauteilen und Berührungsschutz und der Schaltschranklüftung und -klimatisierung sowie die Oberwellenproblematik in die Messung einbezogen wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
