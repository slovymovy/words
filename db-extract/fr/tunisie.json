        "fr-extract.jsonl": [
            {
                "entry_id": "ababd0c7-1a74-3994-aa9e-1b6cdc6fe5fc",
                "word": "Tunisie",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "23597dce-d26e-397d-b528-20888a3db6be",
                        "entry_id": "ababd0c7-1a74-3994-aa9e-1b6cdc6fe5fc",
                        "glosses": [
                            "Pays d’Afrique du Nord situé dans l'Est du Maghreb au nord-est de l'Algérie et au nord-ouest de la Libye. Sa capitale est Tunis."
                        ],
                        "tags": [
                            "Pays"
                        ],
                        "examples": [
                            {
                                "example_id": "c58d0c2f-f626-41ef-b2aa-4a5888d3c52a",
                                "sense_id": "23597dce-d26e-397d-b528-20888a3db6be",
                                "text": "La variante sur le Hodna, baptisée Étincelle, visait à couper l’approvisionnement des katibas de Kabylie en provenance de Tunisie par le Hodna et les Aurès."
                            },
                            {
                                "example_id": "bb3b442c-71fc-4cde-a540-bc7da70aa672",
                                "sense_id": "23597dce-d26e-397d-b528-20888a3db6be",
                                "text": "La Tunisie avait un conflit de frontières avec l’Algérie, puisqu’elle contestait le tracé frontalier hérité de la colonisation, et revendiquait la zone avoisinant la célèbre « borne 233 »."
                            },
                            {
                                "example_id": "c94bba52-fe78-4b4b-a8f0-17ea0e16437d",
                                "sense_id": "23597dce-d26e-397d-b528-20888a3db6be",
                                "text": "Mon père, Fernand, était un solide Bourguignon de Châtillon-sur-Seine et ma mère, Yvonne, une Française d’origine italienne dont la famille était installée en Tunisie depuis longtemps."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "938f978e-38de-458e-8cfd-2876d3c86aab",
                        "source_entry_id": "ababd0c7-1a74-3994-aa9e-1b6cdc6fe5fc",
                        "source_sense_id": "23597dce-d26e-397d-b528-20888a3db6be",
                        "target_lang_word": "Tunesien",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tunesien",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f69788ec-8ae2-30f5-b4fa-5033d619d520",
                                        "entry_id": "b00173de-0721-38e0-bde8-c15d438e26cc",
                                        "glosses": [
                                            "Staat in Nordafrika"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddfdf139-1271-49fa-b93d-284926b29ed8",
                                                "sense_id": "f69788ec-8ae2-30f5-b4fa-5033d619d520",
                                                "text": "Die Einwohnerzahl Tunesiens beträgt etwa 10 Millionen."
                                            },
                                            {
                                                "example_id": "a3972b4f-c518-448f-9a80-ac8a176d9d95",
                                                "sense_id": "f69788ec-8ae2-30f5-b4fa-5033d619d520",
                                                "text": "Das Tunesien der Neuzeit ist eine Präsidialrepublik."
                                            },
                                            {
                                                "example_id": "b5105ce6-bf9d-40d9-9f71-2fb6a20a8a8e",
                                                "sense_id": "f69788ec-8ae2-30f5-b4fa-5033d619d520",
                                                "text": "Tunis ist die Hauptstadt von Tunesien."
                                            },
                                            {
                                                "example_id": "702365a3-7fdb-44ed-beab-a4590a0aaab5",
                                                "sense_id": "f69788ec-8ae2-30f5-b4fa-5033d619d520",
                                                "text": "„Die letzten Kilometer in Tunesien führten mich über den außerirdisch anmutenden Chott el Jerid, einen riesigen Salzsee, der in allen denkbaren Schattierungen von Pink und Lila das Sonnenlicht reflektierte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
