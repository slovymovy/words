                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "really",
                                "target_lang_sense_clarification": "used in reassuring negations (e.g., 'nee hoor')"
                            },
                            {
                                "target_lang_word": "sure",
                                "target_lang_sense_clarification": "used in friendly affirmations (e.g., 'ja hoor')"
                            },
                            {
                                "target_lang_word": "though",
                                "target_lang_sense_clarification": "sentence-final softener"
                            }
