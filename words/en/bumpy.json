{
    "word_family": [
        "bump",
        "bumper"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c9b1a955-bcd4-3e3b-933a-d6e527dc08ee",
                    "sense_definition": "Having a surface that is uneven or covered with small raised areas.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "surface_texture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old road was very <w>bumpy</w> because of all the potholes.",
                            "target_lang_translations": {
                                "ru": "Старая дорога была очень <w>ухабистой</w> из-за всех этих ям."
                            }
                        },
                        {
                            "text": "She felt the <w>bumpy</w> texture of the wall under her hand.",
                            "target_lang_translations": {
                                "ru": "Она почувствовала под рукой <w>неровную</w> текстуру стены."
                            }
                        }
                    ],
                    "synonyms": [
                        "uneven",
                        "rough"
                    ],
                    "antonyms": [
                        "smooth",
                        "flat"
                    ],
                    "common_phrases": [
                        "bumpy road",
                        "bumpy surface"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий неровную поверхность или покрытый небольшими выпуклостями."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неровный",
                                "target_lang_sense_clarification": "общий термин для обозначения отсутствия гладкости"
                            },
                            {
                                "target_lang_word": "ухабистый",
                                "target_lang_sense_clarification": "часто используется для описания дорог с ямами и кочками"
                            },
                            {
                                "target_lang_word": "бугристый",
                                "target_lang_sense_clarification": "покрытый буграми или выпуклостями"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e50948f-20a6-39f4-b3f0-d8cfbfc71cb8",
                    "sense_definition": "Characterized by sudden jolts or irregular movements.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We had a very <w>bumpy</w> flight due to the strong winds.",
                            "target_lang_translations": {
                                "ru": "У нас был очень <w>тряский</w> полет из-за сильного ветра."
                            }
                        },
                        {
                            "text": "The car ride was <w>bumpy</w> on the dirt track.",
                            "target_lang_translations": {
                                "ru": "Поездка на машине по грунтовой дороге была <w>тряской</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "rough",
                        "jolting"
                    ],
                    "antonyms": [
                        "smooth"
                    ],
                    "common_phrases": [
                        "bumpy ride",
                        "bumpy flight"
                    ],
                    "target_lang_definitions": {
                        "ru": "Характеризующийся резкими толчками или нерегулярными движениями."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тряский",
                                "target_lang_sense_clarification": "о поездке или полете, сопровождающемся сильной тряской"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}