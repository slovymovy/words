                "senses": [
                    {
                        "sense_id": "aa5a5666-1f61-3046-b4b4-457da69a4f4f",
                        "entry_id": "fc9d5602-6f4c-3181-8aac-8dc09adc5ae7",
                        "glosses": [
                            "To drift on top of."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61922143-8661-4abf-8fab-571931ba0783",
                                "sense_id": "aa5a5666-1f61-3046-b4b4-457da69a4f4f",
                                "text": "Green be those downs and dells above the sea, Smooth-green for ever, by the plough unhurt, Nor overdrifted by their neighbouring sands, Where first I saw you ;"
                            },
                            {
                                "example_id": "035b586b-2bfa-4060-bf1c-0957417ad3b1",
                                "sense_id": "aa5a5666-1f61-3046-b4b4-457da69a4f4f",
                                "text": "Overdrifting of snow forms huge drifts or overdrifts, the shearing of which usually starts an avalanche."
                            },
                            {
                                "example_id": "2ad2b642-cb25-40b4-a781-7bc1e0fc9052",
                                "sense_id": "aa5a5666-1f61-3046-b4b4-457da69a4f4f",
                                "text": "It seemed as if the sand had not had time to overdrift the detritus of one campaign before a new deposit of ruin had been left behind."
                            }
                        ]
                    },
                    {
                        "sense_id": "12e6e712-4339-3e7d-b8b0-64178111d1ca",
                        "entry_id": "fc9d5602-6f4c-3181-8aac-8dc09adc5ae7",
                        "glosses": [
                            "To drift too far."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ae2e7c9-defa-4c33-9f2f-55aac7e25eb6",
                                "sense_id": "12e6e712-4339-3e7d-b8b0-64178111d1ca",
                                "text": "Accordingly, there is the tendency of the power stroke to overdrift the cessation of the travel signal."
                            }
                        ]
                    }
