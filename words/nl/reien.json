                    ],
                    "synonyms": [
                        "sjorren"
                    ],
                    "common_phrases": [
                        "strak reien"
                    ],
                    "target_lang_definitions": {
                        "fr": "Attacher ou serrer fermement avec une corde"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "amarrer",
                                "target_lang_sense_clarification": "fixer avec une corde"
                            },
                            {
