                "entry_id": "174e56c6-34b9-3b38-8a46-4fdfdd3b2a4f",
                "word": "twerk",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "6b95697e-ef1e-4664-840c-3973ece691d4",
                        "entry_id": "174e56c6-34b9-3b38-8a46-4fdfdd3b2a4f",
