                "senses": [
                    {
                        "sense_id": "3dcd4ff9-2564-3ae5-a947-90b510ff8e9f",
                        "entry_id": "5d6829af-110d-33e6-8277-780387d79c73",
                        "glosses": [
                            "kostbares Schmuckstück, das sich im Besitz des Herrscherhauses befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4bfaeb4f-9e44-45e0-b516-2c30975afbdc",
                                "sense_id": "3dcd4ff9-2564-3ae5-a947-90b510ff8e9f",
                                "text": "„Eine der Amazonen überreicht Hippovera die Kronjuwelen des Königs, während der Zwerg sich weiterhin ungeniert umsieht.“"
                            },
                            {
                                "example_id": "ceae88bf-d28d-482b-8eab-7aac1ba9f563",
                                "sense_id": "3dcd4ff9-2564-3ae5-a947-90b510ff8e9f",
                                "text": "„In Spanien verwahrt man die Kronjuwelen des Königs von Aragon auf der Templerburg Monzon.“"
                            },
                            {
                                "example_id": "6b730799-80fd-40be-add6-f67b1ebfd5b6",
                                "sense_id": "3dcd4ff9-2564-3ae5-a947-90b510ff8e9f",
                                "text": "„Seit der Abdankung des Schahs schwebt in Persien die Streitfrage, ob die kostbaren Kronjuwelen persönliches Eigentum des Herrschers sind oder nicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d803cec5-2e55-39bf-9aea-37508b3a900b",
                        "entry_id": "5d6829af-110d-33e6-8277-780387d79c73",
                        "glosses": [
                            "etwas besonders Wertvolles"
                        ],
                        "tags": [
                            "figurative",
                            "gehoben"
                        ],
                        "examples": [
                            {
                                "example_id": "517f6177-bdec-4cd2-afb8-a3440781638d",
                                "sense_id": "d803cec5-2e55-39bf-9aea-37508b3a900b",
                                "text": "„VW ging an die Börse und wurde zum Kronjuwel und politischem Vorzeigeunternehmen.“"
                            },
                            {
                                "example_id": "1220cb15-8cf0-46ef-93c9-2ffc0672d4e2",
                                "sense_id": "d803cec5-2e55-39bf-9aea-37508b3a900b",
                                "text": "„Jede Seele ist Eins mit Allem, aber sie ist auch wie ein einzelnes Kronjuwel, wie ein Diamant in der Krone des Göttlichen.“"
                            },
                            {
                                "example_id": "a845e0f2-c14b-4173-b5d1-4f82c1b15832",
                                "sense_id": "d803cec5-2e55-39bf-9aea-37508b3a900b",
                                "text": "„Die Wasserkraftwerke, einst Kronjuwel helvetischer Ingenieurskunst, trudeln auf Swissair-Kurs.“"
                            },
                            {
                                "example_id": "158232a2-cb95-44ac-9391-fa516ec4c566",
                                "sense_id": "d803cec5-2e55-39bf-9aea-37508b3a900b",
                                "text": "„Die Sandsteinstatue ist das Kronjuwel des Museums, das ein paar hundert Meter oberhalb der Grabung liegt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "cef6b3b0-d32a-3397-8ef6-f8d456694b31",
                        "entry_id": "5d6829af-110d-33e6-8277-780387d79c73",
                        "glosses": [
                            "Schambereich mit den äußeren Geschlechtsorganen beim Mann"
                        ],
                        "tags": [
                            "colloquial",
                            "figurative",
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "7c1e9f18-7e7f-43b1-812c-6958149098eb",
                                "sense_id": "cef6b3b0-d32a-3397-8ef6-f8d456694b31",
                                "text": "„Fass mich noch einmal an, und ich verpasse dir einen Tritt in die Kronjuwelen.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
