    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e094fd19-7568-3c09-a483-60f54024e626",
                    "sense_definition": "Disorderly and boisterous",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "loud_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>raucous</w> crowd cheered loudly as the band walked onto the stage.",
                            "target_lang_translations": {
                                "nl": "De <w>luidruchtige</w> menigte juichte hard toen de band het podium opkwam."
                            }
                        },
                        {
                            "text": "A <w>raucous</w> group of teenagers caused a disturbance in the quiet library.",
                            "target_lang_translations": {
                                "nl": "Een <w>luidruchtige</w> groep tieners veroorzaakte overlast in de stille bibliotheek."
                            }
                        }
                    ],
                    "synonyms": [
                        "rowdy"
                    ],
                    "common_phrases": [
                        "raucous crowd",
                        "raucous party"
                    ],
                    "target_lang_definitions": {
                        "nl": "Wanordelijk en luidruchtig"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "luidruchtig",
                                "target_lang_sense_clarification": "verwijst naar onaangenaam veel lawaai makend gedrag"
                            },
                            {
                                "target_lang_word": "uitgelaten",
                                "target_lang_sense_clarification": "verwijst naar zeer vrolijk en luidruchtig gedrag"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "745c9641-abec-3fa7-ac78-24704fbefce3",
                    "sense_definition": "Loud and annoying",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "loud_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>raucous</w> noise from the construction site kept everyone awake all night.",
                            "target_lang_translations": {
                                "nl": "Het <w>lawaaierige</w> geluid van de bouwplaats hield iedereen de hele nacht wakker."
                            }
                        },
                        {
                            "text": "She complained about the <w>raucous</w> music playing next door until three in the morning.",
                            "target_lang_translations": {
                                "nl": "Ze klaagde over de <w>lawaaierige</w> muziek die tot drie uur 's nachts bij de buren speelde."
                            }
                        }
                    ],
                    "common_phrases": [
                        "raucous noise",
                        "raucous laughter"
                    ],
                    "target_lang_definitions": {
                        "nl": "Luid en storend"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "lawaaierig",
                                "target_lang_sense_clarification": "verwijst naar storend geluid of lawaai"
                            },
                            {
                                "target_lang_word": "luidruchtig",
                                "target_lang_sense_clarification": "verwijst naar geluid dat als storend wordt ervaren"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b513c1be-d4c5-3bd7-82f6-798f42512977",
                    "sense_definition": "Harsh and rough-sounding",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bird made a <w>raucous</w> cry that echoed through the empty forest.",
                            "target_lang_translations": {
                                "nl": "De vogel slaakte een <w>schorre</w> kreet die door het lege bos echode."
                            }
                        },
                        {
                            "text": "He spoke with a <w>raucous</w> voice that sounded like gravel grinding together.",
                            "target_lang_translations": {
                                "nl": "Hij sprak met een <w>schorre</w> stem die klonk als grind dat over elkaar schuurt."
                            }
                        }
                    ],
                    "common_phrases": [
                        "raucous cry",
                        "raucous voice"
                    ],
                    "target_lang_definitions": {
                        "nl": "Hees en schor klinkend"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "schor",
                                "target_lang_sense_clarification": "verwijst naar een hese, ruwe stem of klank"
                            },
                            {
                                "target_lang_word": "hees",
                                "target_lang_sense_clarification": "verwijst naar een ruw en onzuiver geluid"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}