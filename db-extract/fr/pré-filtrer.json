                ],
                "senses": [
                    {
                        "sense_id": "2454fdf6-1ece-380d-a2dd-80e723659f26",
                        "entry_id": "7a29ab70-bf0d-333d-b0d3-c4681f3781d9",
                        "glosses": [
                            "Filtrer au préalable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bca6d7f3-ea95-4cec-8663-66c4a6227173",
                                "sense_id": "2454fdf6-1ece-380d-a2dd-80e723659f26",
                                "text": "Si la génération d'événements s'avère trop gourmande en ressources, il est possible de pré-filtrer ces événements pour éviter de les générer."
                            },
                            {
                                "example_id": "5b6ed57d-d5c9-478d-8b69-015aab7401e8",
                                "sense_id": "2454fdf6-1ece-380d-a2dd-80e723659f26",
                                "text": "Si l'eau est trouble ou contient des particules il est préférable de la pré-filtrer ou de la faire décanter pour se débarrasser de ces particules."
                            },
                            {
                                "example_id": "2cf5fda8-6843-4831-9cd9-28111c2ea47f",
                                "sense_id": "2454fdf6-1ece-380d-a2dd-80e723659f26",
                                "text": "Modération ou pré-filtrage : vous reconnaissez qu'Intel peut ou non modérer ou pré-filtrer le Contenu utilisateur."
                            }
                        ]
                    }
