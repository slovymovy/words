            "pos": "verb",
            "senses": [
                {
                    "sense_id": "24cd1b1f-00ea-3cc1-b93d-f6c691ba6160",
                    "sense_definition": "Faire ou mettre un signe, un repère ou une trace sur un objet.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "trace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pense à <w>marquer</w> la page avec un signet avant de fermer ton livre."
                        },
                        {
                            "text": "Elle utilise un feutre rouge pour <w>marquer</w> les dates importantes sur son calendrier."
                        }
                    ],
                    "synonyms": [
                        "cocher",
                        "signaler"
                    ],
                    "antonyms": [
                        "effacer"
                    ],
                    "common_phrases": [
                        "marquer la page",
                        "marquer d'une croix"
                    ]
                },
                {
                    "sense_id": "d2a22871-0351-3806-bc23-f2a48fc3f2ca",
                    "sense_definition": "Inscrire un point ou un but lors d'une compétition sportive ou d'un jeu.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'attaquant a réussi à <w>marquer</w> un but décisif pendant les dernières minutes du match."
                        },
                        {
                            "text": "Si notre équipe veut gagner ce tournoi, nous devons absolument <w>marquer</w> plus de points."
                        }
                    ],
                    "synonyms": [
                        "inscrire"
                    ],
                    "antonyms": [
                        "encaisser"
                    ],
                    "common_phrases": [
                        "marquer un but",
                        "marquer un point",
                        "marquer un essai"
                    ]
                },
                {
                    "sense_id": "41dd933f-bdc2-3c4e-99c8-0fc243d2e7c4",
                    "sense_definition": "Laisser une empreinte durable dans l'esprit, l'histoire ou la mémoire.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "influence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette découverte scientifique majeure va profondément <w>marquer</w> l'histoire de la médecine."
                        },
                        {
                            "text": "Son discours émouvant a su <w>marquer</w> les esprits de tous les spectateurs réunis hier."
                        }
                    ],
                    "synonyms": [
                        "impressionner",
                        "toucher",
                        "bouleverser"
                    ],
                    "common_phrases": [
                        "marquer les esprits",
                        "marquer son temps",
                        "marquer le coup"
                    ]
                },
                {
                    "sense_id": "3e9e0aea-a751-3ed8-ba5b-ef2564faf5cb",
                    "sense_definition": "Indiquer ou afficher une mesure, une heure ou un état.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "indication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'horloge du salon <w>marque</w> midi et tous les enfants se préparent pour le déjeuner."
                        },
                        {
                            "text": "Le thermomètre extérieur <w>marque</w> une température très basse en cette saison d'hiver."
                        }
                    ],
                    "synonyms": [
                        "indiquer",
                        "afficher",
                        "montrer"
                    ],
                    "common_phrases": [
                        "marquer l'heure"
                    ]
                },
                {
                    "sense_id": "e641f265-81d4-3878-bb6b-a271980754b2",
                    "sense_definition": "Exprimer ou témoigner une émotion, une intention ou une attitude.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur a tenu à lui <w>marquer</w> sa reconnaissance pour son investissement sans faille."
                        },
                        {
                            "text": "Face à cette annonce inattendue, elle n'a pu s'empêcher de <w>marquer</w> une vive surprise."
                        }
                    ],
                    "synonyms": [
                        "témoigner",
                        "manifester",
                        "montrer"
                    ],
                    "antonyms": [
                        "dissimuler",
                        "cacher"
                    ],
                    "common_phrases": [
                        "marquer son accord",
                        "marquer son désaccord"
                    ]
                },
                {
                    "sense_id": "9210cd0a-72a5-3419-89bd-99ab8b2fba99",
                    "sense_definition": "Laisser une trace visible ou une lésion sur le corps ou sur une surface fragile.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "trace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette chute à vélo lui a <w>marqué</w> le front d'une petite cicatrice durable."
                        },
                        {
                            "text": "Ce bois tendre et délicat <w>marque</w> très facilement au moindre choc accidentel."
                        }
                    ],
                    "synonyms": [
                        "meurtrir",
                        "tacher"
                    ],
                    "common_phrases": [
                        "marquer le visage"
                    ]
                }
            ]
        }
