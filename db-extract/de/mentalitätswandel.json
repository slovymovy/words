                        "examples": [
                            {
                                "example_id": "5fe598b8-8eb4-4994-bc74-8b544283ab48",
                                "sense_id": "ab150771-f240-30ac-ad06-90f895a359a6",
                                "text": "„Mit der militärischen Abrüstung müsse eine Abrüstung in den Köpfen einhergehen, ein grundstürzender Mentalitätswandel.“"
                            },
                            {
                                "example_id": "2b156dca-3ffa-42bc-988b-d55cc9fa79fa",
                                "sense_id": "ab150771-f240-30ac-ad06-90f895a359a6",
                                "text": "„Dieser Mentalitätswandel leitete die sprachliche Assimilation an das Hochdeutsche und den allmählichen Rückgang des Jiddischen im deutschen Sprachraum ein.“"
                            }
                        ],
