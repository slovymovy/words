                    {
                        "translation_id": "da65ca9f-1b62-4db6-b76b-bb0fca37a3ac",
                        "source_entry_id": "c76ef435-8dbe-3335-b36f-132669d11a0c",
                        "source_sense_id": "f52415f9-5e17-3333-b595-f92684332bfb",
                        "target_lang_word": "светлый",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "светлый",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "4943355d-4674-398a-94f5-22be2da1287e",
                                        "entry_id": "c6fbbfa5-6ca1-388b-b846-7d2f6846ca85",
                                        "glosses": [
                                            "хорошо освещённый, либо наполненный светом"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6a7eee2-6e32-40b3-8859-99f3601f2a78",
                                                "sense_id": "4943355d-4674-398a-94f5-22be2da1287e",
                                                "text": "Просторный светлый зал ресторана способен вместить любое торжественное мероприятие."
                                            },
                                            {
                                                "example_id": "632a0a1c-bec2-4432-81e9-1514b99a11b0",
                                                "sense_id": "4943355d-4674-398a-94f5-22be2da1287e",
                                                "text": "Светлыми водами пои́шь людей, пои́шь стада."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2aa36963-4f17-38df-a324-9a365a7c9efb",
                                        "entry_id": "c6fbbfa5-6ca1-388b-b846-7d2f6846ca85",
                                        "glosses": [
                                            "хорошо отражающий падающий свет или прозрачный"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6985ffad-da0f-4606-8380-c3a608629efb",
                                                "sense_id": "2aa36963-4f17-38df-a324-9a365a7c9efb",
                                                "text": "Светлые продукты нефти."
                                            },
                                            {
                                                "example_id": "75b046d1-c0c0-48bc-b2a5-5c6d4f229cb4",
                                                "sense_id": "2aa36963-4f17-38df-a324-9a365a7c9efb",
                                                "text": "Резко пахло курительными палочками, светлый дым которых то стелился над плитами пола, то завивался спиральными струями вокруг бедер Тиллоттамы, увлекаемый стремительным вращением танцовщицы."
                                            },
                                            {
                                                "example_id": "2b007ac2-eb89-4cf2-89ef-c7a49d1acd17",
                                                "sense_id": "2aa36963-4f17-38df-a324-9a365a7c9efb",
                                                "text": "Светлое стекло."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43315a78-84a1-3adc-892a-2e6de4d0d6d9",
                                        "entry_id": "c6fbbfa5-6ca1-388b-b846-7d2f6846ca85",
                                        "glosses": [
                                            "испускающий яркий свет"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a298a909-6c61-3b3e-8ecb-050a25c60598",
                                        "entry_id": "c6fbbfa5-6ca1-388b-b846-7d2f6846ca85",
                                        "glosses": [
                                            "бледный, тусклый, ненасыщенный"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa3d362d-5162-4e4e-8930-2b3e1013c743",
                                                "sense_id": "a298a909-6c61-3b3e-8ecb-050a25c60598",
                                                "text": "Контрольный отпечаток вышел чересчур светлым."
                                            },
                                            {
                                                "example_id": "953430de-998f-4705-8e5c-473096aca057",
                                                "sense_id": "a298a909-6c61-3b3e-8ecb-050a25c60598",
                                                "text": "Светлая синева северного неба."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40239ae6-1dd8-3019-8c2d-587c063a83fd",
                                        "entry_id": "c6fbbfa5-6ca1-388b-b846-7d2f6846ca85",
                                        "glosses": [
                                            "перен. радостный, счастливый, вызывающий положительные эмоции"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "280670c7-3502-4792-949d-3b5d28daa662",
                                                "sense_id": "40239ae6-1dd8-3019-8c2d-587c063a83fd",
                                                "text": "Светлый праздник."
                                            },
                                            {
                                                "example_id": "286ab394-2570-4516-8abe-047ed509c8df",
                                                "sense_id": "40239ae6-1dd8-3019-8c2d-587c063a83fd",
                                                "text": "Похоже, для меня началась светлая полоса в жизни."
                                            },
                                            {
                                                "example_id": "9880d108-d957-4f12-addd-35ab8afdf6a0",
                                                "sense_id": "40239ae6-1dd8-3019-8c2d-587c063a83fd",
                                                "text": "Прямое сама вся благородство: // Божие ты, ей! све́тло изводство."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51017504-56ee-34f8-88ad-5fe679e6c61c",
                                        "entry_id": "c6fbbfa5-6ca1-388b-b846-7d2f6846ca85",
                                        "glosses": [
                                            "перен., книжн. об умственных способностях — ясный, проницательный, не одурманенный"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88277eb5-199e-4dd9-842e-79e95f0b1f9d",
                                                "sense_id": "51017504-56ee-34f8-88ad-5fe679e6c61c",
                                                "text": "Светел был твой ум, и зорки были очи."
                                            },
                                            {
                                                "example_id": "4d9dac2b-2033-4704-b40c-c56739a34cb1",
                                                "sense_id": "51017504-56ee-34f8-88ad-5fe679e6c61c",
                                                "text": "Светлая голова."
                                            },
                                            {
                                                "example_id": "3e05606d-3581-4072-81fe-68a29713d304",
                                                "sense_id": "51017504-56ee-34f8-88ad-5fe679e6c61c",
                                                "text": "Вы любите напев их стройный, // Ум русский, светлый и спокойный, // Простосердечный и прямой."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc6788c3-6d6e-39f8-84dd-47dbc0293f21",
                                        "entry_id": "c6fbbfa5-6ca1-388b-b846-7d2f6846ca85",
                                        "glosses": [
