                "senses": [
                    {
                        "sense_id": "804c1ba5-f5fd-317c-8e0a-4b41493e9fd3",
                        "entry_id": "41241d2b-e07c-3b44-b3cc-ca852422cae9",
                        "glosses": [
                            "Unterteilung eines bestimmten Bereichs in mehrere sinnvolle Teilbereiche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0dae9e7-46a6-41f7-836a-ceea798978b0",
                                "sense_id": "804c1ba5-f5fd-317c-8e0a-4b41493e9fd3",
                                "text": "Der örtliche Träger der öffentlichen Jugendhilfe hat eine soziale Staffelung der Elternbeiträge vorzusehen."
                            },
                            {
                                "example_id": "e6fea89c-aa55-48a1-b14e-f66de49ad5d6",
                                "sense_id": "804c1ba5-f5fd-317c-8e0a-4b41493e9fd3",
                                "text": "„Am aufschlussreichsten von allem aber war, dass sie keine gesellschaftliche Staffelung kannten, keine soziale Hierarchie, nicht einmal irgendwelche Statusgruppen, jedenfalls soweit Everett es feststellen konnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
