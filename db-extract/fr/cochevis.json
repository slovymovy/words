                                "example_id": "cf894d70-0541-4fec-8171-8f31ce7464f2",
                                "sense_id": "04050b62-4b1d-3cdb-9461-f849833316e0",
                                "text": "Le cochevis de Thékla est légèrement plus petit que le cochevis huppé, sa huppe est plus courte mais plus fournie."
                            },
                            {
                                "example_id": "084935fa-50bb-4866-8151-beef9eaf111d",
                                "sense_id": "04050b62-4b1d-3cdb-9461-f849833316e0",
                                "text": "Surtout sédentaire, présent toute l’année, le Cochevis se rapproche des habitations en hiver."
                            }
                        ]
                    }
