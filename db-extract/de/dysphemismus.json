                                                "sense_id": "ec1b2b05-d5ad-34fb-b48d-9d3dceb6ff88",
                                                "text": "Dysfemismen worden door veel mensen als asociaal taalgebruik gezien."
                                            },
                                            {
                                                "example_id": "0e0ac69c-3e10-477a-8a25-4c36e1d38c7a",
                                                "sense_id": "ec1b2b05-d5ad-34fb-b48d-9d3dceb6ff88",
                                                "text": "'Sodemieter op' is een sterk dysfemisme."
                                            }
