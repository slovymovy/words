                    {
                        "sense_id": "034be308-b1c1-31f4-a804-63f8809fdc2f",
                        "entry_id": "bcca1588-928d-3939-a4ee-cd020f5547d9",
                        "glosses": [
                            "verende plank waar vanaf je je kunt afzetten om een sprong te maken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92b2bafc-86b4-44b6-ba43-9d150e469dec",
                                "sense_id": "034be308-b1c1-31f4-a804-63f8809fdc2f",
                                "text": "Hij nam een aanloop, sprong op de springplank en maakte daarna zijn oefening op het turntoestel."
                            }
                        ]
                    },
                    {
                        "sense_id": "84f8e554-fdb5-3c34-a8d9-9708bb772423",
                        "entry_id": "bcca1588-928d-3939-a4ee-cd020f5547d9",
                        "glosses": [
                            "uitvalsbasis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "724ae69d-1bdf-459f-8d78-ecfc42868310",
                                "sense_id": "84f8e554-fdb5-3c34-a8d9-9708bb772423",
                                "text": "Het zomerhuisje diende als springplank voor tochtjes door het mooie berglandschap."
                            }
                        ]
                    },
                    {
                        "sense_id": "5c0bd786-2f68-37ec-8790-b24b77660814",
                        "entry_id": "bcca1588-928d-3939-a4ee-cd020f5547d9",
                        "glosses": [
                            "iets wat dient om hogerop te komen in de maatschappij"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a83c8f5-6ccd-4ba5-b2e4-9675de816705",
                                "sense_id": "5c0bd786-2f68-37ec-8790-b24b77660814",
                                "text": "Deze baan was een goede springplank om directeur te worden."
                            },
                            {
                                "example_id": "a2a19761-aef4-42f2-a14c-8f1970549775",
                                "sense_id": "5c0bd786-2f68-37ec-8790-b24b77660814",
                                "text": "Voor Doyen leek de deal met Twente al in het eerste seizoen een jackpot te worden. Twente, dat een springplank voor Doyen moest worden naar de Nederlande en Duitse competitie, eindigde als derde in de eredivisie. Achter Ajax en Feyenoord, maar vóór PSV. We hebben onze investering al bijna terug, appte een van de Arifs op 1 juni 2014 over Twente aan een ondergeschikte. „Alles wat er bij komt is winst”."
                            }
                        ]
                    }
