                    ],
                    "common_phrases": [
                        "souder au chalumeau"
                    ]
                },
                {
                    "sense_id": "ba845600-96cb-3669-ac1a-612ffbb9865c",
                    "sense_definition": "Rapprocher étroitement des personnes pour créer une forte cohésion ou solidarité.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "union_figurée",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette épreuve difficile a permis de <w>souder</w> une équipe désormais inséparable."
                        },
                        {
                            "text": "Les activités partagées réussissent toujours à <w>souder</w> le groupe d'étudiants."
                        }
                    ],
                    "common_phrases": [
