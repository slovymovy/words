                        ],
                        "examples": [
                            {
                                "example_id": "32a3233c-1229-446c-88f8-4efe59c8b09f",
                                "sense_id": "17452837-45c1-3e01-8c94-8ba361db99b7",
                                "text": "C’est ici que se trouvait l'ancienne ligne de démarcation séparant le Vietnam du Nord et le Vietnam du Sud. Les procapitalistes et les communistes convaincus ne se mélangent pas plus qu’avant la réunification, d’où la faiblesse du trafic."
                            }
                        ]
