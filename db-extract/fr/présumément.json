        "fr-extract.jsonl": [
            {
                "entry_id": "3327b0d9-c809-3c6e-bc4b-1796c7ff010d",
                "word": "présumément",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4e21f14c-4bbf-3639-9f61-90bf33539f97",
                        "entry_id": "3327b0d9-c809-3c6e-bc4b-1796c7ff010d",
                        "glosses": [
                            "De façon probable, comme on peut le présumer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d230bcbd-9f4b-4f9c-aadf-78f7ada1ceb6",
                                "sense_id": "4e21f14c-4bbf-3639-9f61-90bf33539f97",
                                "text": "Une jeune femme de Laval, Mouna Diab, fait de nouveau face à la justice pour avoir présumément commis des infractions en lien avec le Hezbollah, une entité inscrite comme terroriste au Canada depuis le 10 décembre 2002."
                            },
                            {
                                "example_id": "0a629180-d3a1-4c80-8f25-8e7f1c68686d",
                                "sense_id": "4e21f14c-4bbf-3639-9f61-90bf33539f97",
                                "text": "Les trois métallos, dont le leader de la CFDT Edouard Martin, ont été interrogés pendant près de deux heures sur des menaces de mort qu’ils auraient présumément proférées mercredi, lors du blocage des bâtiments administratifs du site, a indiqué une source policière."
                            },
                            {
                                "example_id": "bf1c5dad-6750-4f59-b2d2-63f77b3d5100",
                                "sense_id": "4e21f14c-4bbf-3639-9f61-90bf33539f97",
                                "text": "La reconnaissance d’un méfait constituerait déjà une petite victoire pour ceux et celles qui considèrent que l’homme n’a jamais pleinement payé le prix de ses frasques. Un argument fort en faveur d’un pardon réside dans son effet présumément unificateur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "48bf3307-c393-4339-b36f-74a97cd73443",
                        "source_entry_id": "3327b0d9-c809-3c6e-bc4b-1796c7ff010d",
                        "source_sense_id": "4e21f14c-4bbf-3639-9f61-90bf33539f97",
                        "target_lang_word": "wahrscheinlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wahrscheinlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ba38597f-b3ff-3f53-9e55-8b195c361f13",
                                        "entry_id": "252cda78-13d9-36ab-afac-67c6d85ebac5",
                                        "glosses": [
                                            "in relativ hohem Grad möglich, mit ziemlicher Sicherheit anzunehmen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8d09120-6432-4bbf-978d-ee510a221a85",
                                                "sense_id": "ba38597f-b3ff-3f53-9e55-8b195c361f13",
                                                "text": "Der wahrscheinliche Mörder wurde gestern verhaftet."
                                            },
                                            {
                                                "example_id": "3ecb03b3-54a3-48f1-8873-d4192e5ba8a6",
                                                "sense_id": "ba38597f-b3ff-3f53-9e55-8b195c361f13",
                                                "text": "„Würde die Raumsonde auf der Erde aufsetzen, stieße sie wahrscheinlich sofort auf Leben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "wahrscheinlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "295fdf40-0a96-3acf-8bc6-476450283bbb",
                                        "entry_id": "f50e0ab4-8c6c-33c2-bd49-cf18e56f0a98",
                                        "glosses": [
                                            "mit ziemlicher Sicherheit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "452a0630-1821-4151-8b2c-db35c5997c13",
                                                "sense_id": "295fdf40-0a96-3acf-8bc6-476450283bbb",
                                                "text": "Sie wird wahrscheinlich erst morgen reisen."
                                            },
                                            {
                                                "example_id": "bfa11702-72c9-4d43-bbfd-21d937328488",
                                                "sense_id": "295fdf40-0a96-3acf-8bc6-476450283bbb",
                                                "text": "Morgen wird es wahrscheinlich schneien."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3e026d15-c7a6-4a8a-b922-4e89657699db",
                        "source_entry_id": "3327b0d9-c809-3c6e-bc4b-1796c7ff010d",
                        "source_sense_id": "4e21f14c-4bbf-3639-9f61-90bf33539f97",
                        "target_lang_word": "wohl",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wohl",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "83c19993-86ca-358a-bb7f-5cee9e130f1e",
                                        "entry_id": "9472fc5d-c609-3f9a-8d90-f613450b0fc4",
                                        "glosses": [
                                            "gut, gesund, angenehm, behaglich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9fc29b78-a345-4056-8661-65895bf2de67",
                                                "sense_id": "83c19993-86ca-358a-bb7f-5cee9e130f1e",
                                                "text": "„Befiehl dem Herrn deine Wege und hoffe auf ihn, er wird's wohl machen.“"
                                            },
                                            {
                                                "example_id": "4f989761-9add-4fbb-956c-c0802ea6ede3",
                                                "sense_id": "83c19993-86ca-358a-bb7f-5cee9e130f1e",
                                                "text": "Der Urlaub tat ihm wohl."
                                            },
                                            {
                                                "example_id": "651a6f4b-c561-4883-8bbe-8656278a0085",
                                                "sense_id": "83c19993-86ca-358a-bb7f-5cee9e130f1e",
                                                "text": "„Er setzte sich aufs Sofa, den Apparat im Blick. So war ihm wohler.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "wohl",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "66e8aa13-1dd4-32a3-83dc-810ffc000fcb",
                                        "entry_id": "bdd375ea-bc76-3478-b578-5e366339190f",
                                        "glosses": [
                                            "wahrscheinlich, vermutlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec492a79-ca01-4f3a-87f9-9f7a779c3fa4",
                                                "sense_id": "66e8aa13-1dd4-32a3-83dc-810ffc000fcb",
                                                "text": "Es wird wohl leider nichts daran zu ändern sein."
                                            },
                                            {
                                                "example_id": "888265c9-d077-422b-9e90-11f65909ea79",
                                                "sense_id": "66e8aa13-1dd4-32a3-83dc-810ffc000fcb",
                                                "text": "Wenn die gesetzliche Sommerzeit beginnt oder endet, kann man die Zeit nicht umstellen, die Uhren wohl."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a428acc8-9176-30e2-a1cf-d7c9b4c94326",
                                        "entry_id": "bdd375ea-bc76-3478-b578-5e366339190f",
                                        "glosses": [
                                            "doch"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
