                        "glosses": [
                            "To console again."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "627acc17-7f17-4cb5-b5d1-824493657261",
                                "sense_id": "3bb315bf-b168-3a42-a525-88422a54bcdb",
                                "text": "The vexation he showed at having caused such a disappointment, struck me as amiably characteristic — and in the course of the evening he every now and then threw out some word of admiration to reconsole mamma.\""
                            },
                            {
                                "example_id": "40121354-7a8a-4ad5-a07b-338812860e87",
                                "sense_id": "3bb315bf-b168-3a42-a525-88422a54bcdb",
                                "text": "Since this much will feed from 4 to 6. and you're apt to have leftovers, you can keep it to reheat and reconsole yourself with the next evening."
                            },
                            {
                                "example_id": "c6113a8d-c397-4762-b608-ed844681f301",
                                "sense_id": "3bb315bf-b168-3a42-a525-88422a54bcdb",
                                "text": "The Perfects increasingly emphasized obedience and hierarchy, and developed a ritual to reconsole those among them who had fallen from the pure way."
                            }
                        ]
                    }
