        "fr-extract.jsonl": [
            {
                "entry_id": "3f272225-bb1a-3814-80de-b83b250785d0",
                "word": "Paraclet",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5acf1b63-6725-39db-bcf7-9695aef35690",
                        "entry_id": "3f272225-bb1a-3814-80de-b83b250785d0",
                        "glosses": [
                            "Autre nom du Saint-Esprit."
                        ],
                        "tags": [],
                        "note": "Toujours déterminé avec l’article défini le",
                        "examples": [
                            {
                                "example_id": "cb74e5ae-3139-4c04-acd3-0927e8b20805",
                                "sense_id": "5acf1b63-6725-39db-bcf7-9695aef35690",
                                "text": "Inséparable du Père et du Fils, l’Esprit saint n’en est pas moins présent à la vie des disciples, alors même que le départ de Jésus les laisserait quasiment « orphelins », s’il n’y avait justement le Paraclet pour les défendre contre le monde et leur donner de vivre en communion avec le Père et le Fils."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "99b24c8b-01a0-3f66-b046-5a46c5079ac8",
                "word": "paraclet",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8de565f4-c476-4ac1-a937-0a51c2986dee",
                        "entry_id": "99b24c8b-01a0-3f66-b046-5a46c5079ac8",
                        "tags": [
                            "plural"
                        ],
                        "form": "paraclets"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7e948ced-db46-3b42-9554-3782c8bc73e3",
                        "entry_id": "99b24c8b-01a0-3f66-b046-5a46c5079ac8",
                        "glosses": [
                            "Consolateur protecteur, intercesseur, nom parfois donné au Saint-Esprit, troisième personne de la Trinité."
                        ],
                        "tags": [
                            "Biblical"
                        ],
                        "examples": [
                            {
                                "example_id": "51373346-a5bd-45fa-b6d4-4082d9beefac",
                                "sense_id": "7e948ced-db46-3b42-9554-3782c8bc73e3",
                                "text": "Dans la coction de cette destinée, la mise au monde, je parle du monde, prend la place éminente, celle du ciel, celle du paraclet !"
                            },
                            {
                                "example_id": "8776b318-797a-41a8-abdb-086420b391a3",
                                "sense_id": "7e948ced-db46-3b42-9554-3782c8bc73e3",
                                "text": "Il y a des vies qui constituent des appels à vivre. Des « paraclets », disait le poète anglais Hopkins. On peut appliquer le mot à Fanon en le dépouillant de son contexte religieux et mystique. Celui qui réveille, et celui qui encourage. Et, celui qui somme l’homme d’accomplir sa tâche d’homme et de s’accomplir lui-même, en accomplissant sa propre pensée."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a384bca1-8d77-4825-8900-434713290012",
                        "source_entry_id": "99b24c8b-01a0-3f66-b046-5a46c5079ac8",
                        "source_sense_id": "7e948ced-db46-3b42-9554-3782c8bc73e3",
