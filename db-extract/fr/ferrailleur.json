                    },
                    {
                        "form_id": "58d09e05-413e-4804-895a-86d117f2c1b8",
                        "entry_id": "2ebd7118-4762-3bb0-b328-6d19917fade9",
                        "tags": [
                            "feminine"
                        ],
                        "form": "ferrailleuse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d52f57f0-00fd-361c-9c5f-1ace9d6eb266",
                        "entry_id": "2ebd7118-4762-3bb0-b328-6d19917fade9",
                        "glosses": [
                            "Celui qui se bat souvent à l’épée, qui en cherche les occasions."
                        ],
                        "tags": [
                            "dated",
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "10d115a3-b0c5-44e0-b1b5-7c06eaf9812e",
                                "sense_id": "d52f57f0-00fd-361c-9c5f-1ace9d6eb266",
                                "text": "Fi ! monsieur de Wardes, continua Raoul, il ne sied point d’être ainsi ferrailleur quand nous avons des édits contre les duels."
                            },
                            {
                                "example_id": "aa7c4694-e36d-4b3a-bf7f-8037d4fb51aa",
                                "sense_id": "d52f57f0-00fd-361c-9c5f-1ace9d6eb266",
                                "text": "Un coup d'épée galamment donné à un certain Alphonse Leduc, professeur de guitare à Nantes, … me posa en ferrailleur et en duelliste. On me citait comme une fine lame."
                            }
                        ]
                    },
                    {
                        "sense_id": "0ff59baa-c979-3cb3-b5f1-6b7fe9ffc223",
                        "entry_id": "2ebd7118-4762-3bb0-b328-6d19917fade9",
                        "glosses": [
                            "Celui qui aime la dispute, qui en cherche les occasions."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "41862801-6a25-3514-90fe-0f83d353948f",
                        "entry_id": "2ebd7118-4762-3bb0-b328-6d19917fade9",
                        "glosses": [
                            "Marchand de ferraille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7936da46-05c4-4ee6-96ae-d485cdf9913e",
                                "sense_id": "41862801-6a25-3514-90fe-0f83d353948f",
                                "text": "Pour peindre ce quartier, il suffira de dire que les propriétaires de certaines maisons habitées par des industriels sans industries, par de dangereux ferrailleurs, par des indigents livrés à des métiers périlleux, n’osent pas y réclamer leurs loyers, et ne trouvent pas d’huissiers qui veuillent expulser les locataires insolvables."
                            }
                        ]
                    },
                    {
                        "sense_id": "6aaf18e9-7047-38b8-ae16-051a9c0216d6",
                        "entry_id": "2ebd7118-4762-3bb0-b328-6d19917fade9",
                        "glosses": [
                            "Entreprise de recyclage des métaux."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "111e3da2-4324-3092-9713-5a35b52cd599",
                        "entry_id": "2ebd7118-4762-3bb0-b328-6d19917fade9",
                        "glosses": [
                            "Ouvrier qui s’occupe du ferraillage ^([1])."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "33d8bc10-9a23-4b97-885e-991bfc2a196d",
                        "source_entry_id": "2ebd7118-4762-3bb0-b328-6d19917fade9",
                        "source_sense_id": "41862801-6a25-3514-90fe-0f83d353948f",
                        "source_sense_description": "Personne qui vend de la ferraille.",
                        "target_lang_word": "Schrotthändler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schrotthändler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "881976ab-ee54-34d0-a6ff-2b55a64507fa",
                                        "entry_id": "5c46d275-2570-3f53-8566-7de4ede0edee",
                                        "glosses": [
                                            "jemand, der professionell Schrott kauft und verkauft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f79a111-c85c-4b5e-835e-633ebf352098",
                                                "sense_id": "881976ab-ee54-34d0-a6ff-2b55a64507fa",
                                                "text": "Der Schrotthändler verkaufte seinen Kupferschrott an eine Schmelzhütte."
                                            },
                                            {
                                                "example_id": "32c4b4bd-0038-49ed-b176-8600ab5190ce",
                                                "sense_id": "881976ab-ee54-34d0-a6ff-2b55a64507fa",
                                                "text": "„Mit diesem ungewöhnlichen Fund hatte ein amerikanischer Schrotthändler im mittleren Westen der USA sicher nicht gerechnet.“"
                                            },
                                            {
                                                "example_id": "66bbbac1-4946-445f-bb8f-4d0a1ed961bd",
                                                "sense_id": "881976ab-ee54-34d0-a6ff-2b55a64507fa",
                                                "text": "„Einem gewissenhaften Kassenarzt war es geglückt, einen geizigen Schrotthändler, der aus dem letzten Loch gepfiffen hatte, noch mal auf die Beine zu bringen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
