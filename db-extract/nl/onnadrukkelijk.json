                            {
                                "example_id": "063decc7-d809-4b00-8046-c36b2c333376",
                                "sense_id": "9804dfde-4740-3629-b298-ba6c5211341e",
                                "text": "Hoe hij onnadrukkelijk het gesprek beheerst had, en hoe goed hij daarbij in vorm was geweest."
                            },
                            {
                                "example_id": "02d2f32e-2fac-4069-8a30-cfe1712aff70",
                                "sense_id": "9804dfde-4740-3629-b298-ba6c5211341e",
                                "text": "Regisseur Johan Nijenhuis, koning van de Nederlandse romcom (releatiecomedie-red), bewijst onnadrukkelijk zijn vakmanschap: met een goed script maakt hij een goede film. Dat mag best vaker zijn ambitie zijn.”"
                            }
                        ]
