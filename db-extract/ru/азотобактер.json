                "senses": [
                    {
                        "sense_id": "9b048022-0e4b-3045-9427-03a801069d38",
                        "entry_id": "81b8b6d7-437f-38df-9e95-969d2fc6a47b",
                        "glosses": [
                            "микробиол. род аэробных свободноживущих бактерий, связывающих азот воздуха и синтезирующих из этого азота белок своих клеток"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5444c62-acdf-4f5e-b0bd-5ffa13111f77",
                                "sense_id": "9b048022-0e4b-3045-9427-03a801069d38",
                                "text": "При благоприятных условиях азотобактер может синтезировать до 70 кг азота на гектар."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "86441d5d-159d-4cbd-be91-a7fe4c4e9ac1",
                        "source_entry_id": "81b8b6d7-437f-38df-9e95-969d2fc6a47b",
                        "source_sense_id": "9b048022-0e4b-3045-9427-03a801069d38",
                        "target_lang_word": "azotobacter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "azotobacter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "765026ca-15ee-3b0a-8369-b518c70c6967",
                                        "entry_id": "2e5e6a86-145b-329b-bdd7-ce23f134adfa",
                                        "glosses": [
                                            "Any of various nitrogen-fixing bacteria in the genus Azotobacter."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a9893dc-9a83-49f6-a1ad-8ae8451ae754",
                                                "sense_id": "765026ca-15ee-3b0a-8369-b518c70c6967",
                                                "text": "I believe, and this belief is based upon tentative facts, that the azotobacter are at the same time nitrifiers, i. e., that they possess a double function"
                                            },
                                            {
                                                "example_id": "b3c13954-55d4-4d32-934a-78fc173ae2eb",
                                                "sense_id": "765026ca-15ee-3b0a-8369-b518c70c6967",
                                                "text": "Investigations in this laboratory have shown that the presence or absence of Azotobacter in natural soils is very closely associated with, if not dependent upon, the absolute reaction of the soil solution"
                                            },
                                            {
                                                "example_id": "579e046e-8337-4732-a7d6-ea64b23a5434",
                                                "sense_id": "765026ca-15ee-3b0a-8369-b518c70c6967",
                                                "text": "It is therefore not surprising that azotobacters, introduced into soils of unwatered crops in semi-arid zones will die out rather rapidly."
                                            },
                                            {
                                                "example_id": "b0f6289c-eb33-4fa0-ab2f-44c7c6712f7d",
                                                "sense_id": "765026ca-15ee-3b0a-8369-b518c70c6967",
                                                "text": "They are usually motile, oval or spherical bacteria that form thick-walled cysts and may produce large quantities of capsular slime. Azotobacter is found in slightly acidic (A. beijerinckii) to neutral alkaline (A. chroococcum) soil."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "04fd7b77-8f09-4326-b699-ac68417d0bca",
                        "source_entry_id": "81b8b6d7-437f-38df-9e95-969d2fc6a47b",
                        "source_sense_id": "9b048022-0e4b-3045-9427-03a801069d38",
