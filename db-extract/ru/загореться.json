                                "sense_id": "02b9d0d3-131c-300e-9461-cdf2f42cd8ef",
                                "text": "загоре́лся спор",
                                "translation": "an argument broke out",
                                "english": "an argument broke out"
                            }
                        ]
                    },
                    {
                        "sense_id": "523d60d0-0b07-3ae9-bbaf-15b1ac03e76a",
                        "entry_id": "7e477fb1-99e3-3225-a026-64459acec0ce",
                        "glosses": [
                            "to be eager (for), to light up"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "4af4f25a-6863-41dc-be1f-d53980cff188",
                                "sense_id": "523d60d0-0b07-3ae9-bbaf-15b1ac03e76a",
                                "text": "он загоре́лся э́той иде́ей",
                                "translation": "he got enthusiastic about/over the idea",
                                "english": "he got enthusiastic about/over the idea"
                            },
                            {
                                "example_id": "fd019bdb-9f16-4c68-8a9d-9e63631555a8",
                                "sense_id": "523d60d0-0b07-3ae9-bbaf-15b1ac03e76a",
                                "text": "его́ глаза́ загоре́лись",
                                "translation": "his eyes lit up [blazed]",
                                "english": "his eyes lit up [blazed]"
                            },
                            {
                                "example_id": "5e7a47ad-c825-4d9b-97c7-8726415ba06f",
                                "sense_id": "523d60d0-0b07-3ae9-bbaf-15b1ac03e76a",
                                "text": "его́ глаза́ загоре́лись жела́нием (гне́вом)",
                                "translation": "his eyes kindled with desire (anger)",
                                "english": "his eyes kindled with desire (anger)"
                            }
                        ]
                    },
                    {
                        "sense_id": "f3e3108e-45ac-38cc-ab35-804886d6d205",
                        "entry_id": "7e477fb1-99e3-3225-a026-64459acec0ce",
                        "glosses": [
                            "to feel an urge"
                        ],
                        "tags": [
                            "figuratively",
                            "impersonal"
                        ],
                        "examples": [
                            {
                                "example_id": "072a2b25-155f-488c-b2b7-465a5b5b7b62",
                                "sense_id": "f3e3108e-45ac-38cc-ab35-804886d6d205",
                                "text": "ему́ загоре́лось сде́лать э́то",
                                "translation": "he couldn't wait to do it; he felt a burning desire to do it",
                                "english": "he couldn't wait to do it; he felt a burning desire to do it"
                            },
                            {
                                "example_id": "5c209fa1-61d9-495c-8d6b-f4bee4d72680",
                                "sense_id": "f3e3108e-45ac-38cc-ab35-804886d6d205",
                                "text": "что э́то тебе́ так загоре́лось туда́ пое́хать?",
                                "translation": "why is it so urgent for you to go there?",
                                "english": "why is it so urgent for you to go there?"
                            }
                        ]
                    },
