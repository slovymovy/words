                    {
                        "sense_id": "1b850ab1-66d6-3682-afd5-2be7faa3e229",
                        "entry_id": "e1abc664-93b8-3c59-ab38-30705ec86a8c",
                        "glosses": [
                            "gespannte Lage, Zustand mit Spannungen (Streitigkeiten) zwischen Menschen (gehoben für Unfrieden)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "440aa172-bcd4-4ad8-855d-99d19d0c2c6b",
                                "sense_id": "1b850ab1-66d6-3682-afd5-2be7faa3e229",
                                "text": "„Unfriede herrscht auf der Erde.“"
                            },
                            {
                                "example_id": "0cd89c60-d27e-4a8c-99e4-926126d7ac15",
                                "sense_id": "1b850ab1-66d6-3682-afd5-2be7faa3e229",
                                "text": "„So hatte der Unfriede begonnen, und nun war die Lage völlig außer Kontrolle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0e25b951-4545-4043-9d94-2b5f65e139c2",
                        "source_entry_id": "e1abc664-93b8-3c59-ab38-30705ec86a8c",
                        "source_sense_id": "1b850ab1-66d6-3682-afd5-2be7faa3e229",
                        "source_sense_description": "gespannte Lage, Zustand mit Spannungen (Streitigkeiten) zwischen Menschen (gehoben für Unfrieden)",
                        "target_lang_word": "discord",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "discord",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0f13c51b-e831-3a44-aa04-07a22dc57732",
                                        "entry_id": "2f50358d-eae5-37be-8e5b-4f3fe0e7ea75",
                                        "glosses": [
                                            "Lack of concord, agreement, harmony; disaccord."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a614192e-1815-4cab-9877-0e05306d77e1",
                                                "sense_id": "0f13c51b-e831-3a44-aa04-07a22dc57732",
                                                "text": "A false witnesse that speaketh lies; and him that soweth discord among brethren."
                                            },
                                            {
                                                "example_id": "12552804-c273-420e-94f2-8eac71a02e8e",
                                                "sense_id": "0f13c51b-e831-3a44-aa04-07a22dc57732",
                                                "text": "The proposition is peace. Not peace through the medium of war; not peace to be hunted through the labyrinth of intricate and endless negotiations; not peace to arise out of universal discord, fomented from principle, in all parts of the empire; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79977b35-1026-3e1f-8c8e-d0547e9f42cd",
                                        "entry_id": "2f50358d-eae5-37be-8e5b-4f3fe0e7ea75",
                                        "glosses": [
                                            "Tension or strife resulting from a lack of agreement; dissension."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7fa9c8ba-3df6-3996-9c59-6a55da872a2c",
                                        "entry_id": "2f50358d-eae5-37be-8e5b-4f3fe0e7ea75",
                                        "glosses": [
                                            "Any harsh noise, or confused mingling of sounds."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06f7c523-bb1e-47e4-88ad-a535ae7705a9",
                                                "sense_id": "7fa9c8ba-3df6-3996-9c59-6a55da872a2c",
                                                "text": "[…] For a Diſcord it ſelfe is but a Harſhneſſe of Diuers Sounds Meeting."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c956c9ad-8468-3cb8-9d9f-ca927f8c282c",
                                        "entry_id": "2f50358d-eae5-37be-8e5b-4f3fe0e7ea75",
                                        "glosses": [
                                            "An inharmonious combination of simultaneously sounded tones; a dissonance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "discord",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "00a57a0e-ca70-37d4-ba82-3d2f65777ba7",
                                        "entry_id": "38e41a84-2857-384f-bad0-5984eaad285f",
                                        "glosses": [
                                            "To disagree; to fail to agree or harmonize; clash."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c624d2e-451d-4dba-8837-74aacca1ef10",
                                                "sense_id": "00a57a0e-ca70-37d4-ba82-3d2f65777ba7",
                                                "text": "[…] Sometimes the one Iarring and diſcording with the other, and making a Confuſion; […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
