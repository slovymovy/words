{
    "word_family": [
        "aggravate",
        "aggravation"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "98e88d03-3a2a-38b4-9057-d9d706345b90",
                    "sense_definition": "Feeling frustrated, annoyed, or angry.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotional_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt <w>aggravated</w> by the constant noise coming from his neighbor's apartment.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал себя <w>раздраженным</w> из-за постоянного шума, доносившегося из квартиры соседа."
                            }
                        },
                        {
                            "text": "The <w>aggravated</w> customer demanded to speak with the manager immediately.",
                            "target_lang_translations": {
                                "ru": "<w>Раздраженный</w> клиент потребовал немедленно позвать менеджера."
                            }
                        }
                    ],
                    "synonyms": [
                        "aggro"
                    ],
                    "common_phrases": [
                        "feel aggravated"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувствующий разочарование, раздражение или гнев."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раздраженный",
                                "target_lang_sense_clarification": "испытывающий досаду или гнев"
                            },
                            {
                                "target_lang_word": "озлобленный",
                                "target_lang_sense_clarification": "находящийся в состоянии сильного раздражения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e7adf4ed-e5ca-3f63-8c17-3433eb2b5d1a",
                    "sense_definition": "Having become worse, more severe, or more intense.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient's <w>aggravated</w> condition required immediate medical attention from the specialists.",
                            "target_lang_translations": {
                                "ru": "<w>Обострившееся</w> состояние пациента потребовало немедленной медицинской помощи специалистов."
                            }
                        },
                        {
                            "text": "His <w>aggravated</w> injury prevented him from participating in the championship game.",
                            "target_lang_translations": {
                                "ru": "Его <w>усугубившаяся</w> травма помешала ему принять участие в чемпионской игре."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ставший хуже, более серьезным или интенсивным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обострившийся",
                                "target_lang_sense_clarification": "о состоянии, которое стало более тяжелым"
                            },
                            {
                                "target_lang_word": "усугубленный",
                                "target_lang_sense_clarification": "сделанный более тяжелым или серьезным"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a3ae988d-1304-396e-b79d-4c0baa15fb6f",
                    "sense_definition": "Describing a crime that is made more serious by additional factors.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "legal_term",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The suspect was charged with <w>aggravated</w> assault after using a weapon during the fight.",
                            "target_lang_translations": {
                                "ru": "Подозреваемому было предъявлено обвинение в <w>тяжком</w> телесном повреждении после того, как он использовал оружие во время драки."
                            }
                        },
                        {
                            "text": "The judge sentenced him for <w>aggravated</w> robbery due to the violence involved.",
                            "target_lang_translations": {
                                "ru": "Судья приговорил его за <w>разбой</w> (грабеж с отягчающими обстоятельствами) из-за применения насилия."
                            }
                        }
                    ],
                    "common_phrases": [
                        "aggravated assault",
                        "aggravated robbery"
                    ],
                    "target_lang_definitions": {
                        "ru": "Описание преступления, которое становится более тяжким из-за дополнительных обстоятельств."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тяжкий",
                                "target_lang_sense_clarification": "о преступлении с отягчающими обстоятельствами"
                            },
                            {
                                "target_lang_word": "с отягчающими обстоятельствами",
                                "target_lang_sense_clarification": "юридический термин для квалификации преступления"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ecf6df57-5fd7-3977-8b3f-f2094b1a5190",
                    "sense_definition": "Past tense and past participle of <w>aggravate</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The loud music <w>aggravated</w> his headache throughout the entire afternoon.",
                            "target_lang_translations": {
                                "ru": "Громкая музыка <w>усиливала</w> его головную боль в течение всего дня."
                            }
                        },
                        {
                            "text": "She has <w>aggravated</w> the situation by refusing to listen to any advice.",
                            "target_lang_translations": {
                                "ru": "Она <w>усугубила</w> ситуацию, отказавшись слушать любые советы."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "grammatical form"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола «ухудшать» или «раздражать»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "усугубил",
                                "target_lang_sense_clarification": "сделал ситуацию хуже"
                            },
                            {
                                "target_lang_word": "раздражал",
                                "target_lang_sense_clarification": "вызывал чувство досады"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}