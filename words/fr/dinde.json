                {
                    "sense_id": "970ee0cd-6d36-3b55-8340-1376ea1ba53b",
                    "sense_definition": "Gros oiseau gallinacé domestique élevé pour sa chair, femelle du dindon.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le fermier nourrit les <w>dindes</w> et les poulets tous les matins dans la cour."
                        },
                        {
                            "text": "Une grosse <w>dinde</w> se promène tranquillement au milieu du pré."
                        }
                    ],
                    "common_phrases": [
                        "élever des dindes"
                    ]
                },
                {
                    "sense_id": "f76b54fb-8df8-32de-a074-fd88df9457f4",
                    "sense_definition": "Viande issue de cette volaille, préparée pour la consommation humaine.",
