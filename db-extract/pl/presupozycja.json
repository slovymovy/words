                        "sense_id": "e27af761-9c8c-37ad-9412-39603b4f4739",
                        "entry_id": "d4155f61-bf83-3dd9-9805-4eef507e2443",
                        "glosses": [
                            "metoda sugerowania ukrytych treści za pomocą takich zdań"
                        ],
                        "tags": [
                            "psychology"
                        ],
                        "examples": [
                            {
                                "example_id": "0c768185-efcf-4d11-b06a-312ba2ee0ad7",
                                "sense_id": "e27af761-9c8c-37ad-9412-39603b4f4739",
                                "text": "Presupozycja jest ważnym elementem technik manipulacji."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
