                "senses": [
                    {
                        "sense_id": "717ffa9b-a5c8-3a56-ad05-63db67af0abd",
                        "entry_id": "87130db3-b14e-391e-bce4-8c708ea260a7",
                        "glosses": [
                            "Armee, die privat unterhalten wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77b30f0c-45be-42fb-82ac-ee6dbfbdd9e1",
                                "sense_id": "717ffa9b-a5c8-3a56-ad05-63db67af0abd",
                                "text": "„Und wenn diese Machtbeweise nicht fruchten, steht Stanleys Privatarmee mit 1000 Schnellfeuergewehren und einem Dutzend kleiner Kanonen bereit.“"
                            },
                            {
                                "example_id": "28b1d4a6-fa6b-458e-b3c2-aa85cb84c19d",
                                "sense_id": "717ffa9b-a5c8-3a56-ad05-63db67af0abd",
                                "text": "„Sie unterhielt Privatarmeen mit Tausenden von Söldnern, und ihre Verwaltungsorgane ließen so gut wie keine lokale Autonomie zu.“"
                            },
                            {
                                "example_id": "dc202d67-0daf-4613-9bc5-8e3c907569b8",
                                "sense_id": "717ffa9b-a5c8-3a56-ad05-63db67af0abd",
                                "text": "„Der ganze Kriegsmüll, der bei uns herumlag, ließ mich glauben, wir könnten damit eine Privatarmee ausrüsten.“"
                            },
                            {
                                "example_id": "38998b44-d180-41c0-820b-84d8e6c3c356",
                                "sense_id": "717ffa9b-a5c8-3a56-ad05-63db67af0abd",
                                "text": "„Er und andere Politiker legten sich frühzeitig gewaltbereite Privatarmeen aus arbeitslosen Jugendlichen zu, die sie als Stoßtrupps unter anderem gegen Rivalen in den eigenen Reihen einsetzten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
