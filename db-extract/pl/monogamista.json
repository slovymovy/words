                        "glosses": [
                            "mężczyzna żyjący w monogamii"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "59a7ec4e-cb07-30e5-9657-7686da469b07",
                        "entry_id": "918d057e-99bf-3698-b922-cbcdc26be7a0",
