{
    "word_family": [
        "parliamentary",
        "parliamentarian"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "48bca385-be6d-3874-bb76-7be996604567",
                    "sense_definition": "The group of people who are elected to make and change the laws of a country.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "legislature_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to run for <w>parliament</w> to help improve her community.",
                            "target_lang_translations": {
                                "ru": "Она решила баллотироваться в <w>парламент</w>, чтобы помочь улучшить жизнь своего сообщества.",
                                "zh": "她决定竞选<w>议会</w>议员，以帮助改善她的社区。"
                            }
                        },
                        {
                            "text": "The new law was debated in <w>parliament</w> for several weeks.",
                            "target_lang_translations": {
                                "ru": "Новый закон обсуждался в <w>парламенте</w> несколько недель.",
                                "zh": "这项新法律在<w>议会</w>中辩论了几个星期。"
                            }
                        }
                    ],
                    "synonyms": [
                        "legislature",
                        "assembly",
                        "congress"
                    ],
                    "common_phrases": [
                        "member of parliament",
                        "act of parliament",
                        "dissolve parliament",
                        "run for parliament"
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа людей, избранных для разработки и изменения законов страны.",
                        "zh": "由选举产生、负责制定和修改国家法律的团体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "парламент",
                                "target_lang_sense_clarification": "законодательный орган"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "议会",
                                "target_lang_sense_clarification": "国家立法机构"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e56f9076-236c-349e-a2ef-f5f44c5aaf70",
                    "sense_definition": "A specific period of time during which a legislative assembly meets before being dissolved.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "legislature_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fifth <w>parliament</w> was dissolved after only two years in session.",
                            "target_lang_translations": {
                                "ru": "Пятый <w>парламент</w> был распущен всего через два года работы.",
                                "zh": "第五<w>届</w>议会在开会仅两年后就被解散了。"
                            }
                        },
                        {
                            "text": "Many important reforms were passed during the last <w>parliament</w>.",
                            "target_lang_translations": {
                                "ru": "Многие важные реформы были приняты во время работы прошлого <w>парламента</w>.",
                                "zh": "许多重要的改革是在上一<w>届</w>议会期间通过的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "session"
                    ],
                    "common_phrases": [
                        "hung parliament",
                        "long parliament"
                    ],
                    "target_lang_definitions": {
                        "ru": "Определенный период времени, в течение которого законодательное собрание заседает до роспуска.",
                        "zh": "立法机关在解散前进行会议的特定任期。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "созыв",
                                "target_lang_sense_clarification": "период полномочий"
                            },
                            {
                                "target_lang_word": "парламент",
                                "target_lang_sense_clarification": "состав законодательного органа"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "届",
                                "target_lang_sense_clarification": "议会任期"
                            },
                            {
                                "target_lang_word": "会期",
                                "target_lang_sense_clarification": "议会开会期间"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "88c614a0-936b-3374-9cde-00d403f7ef8e",
                    "sense_definition": "A formal conference or council, historically summoned by a monarch to discuss important matters.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "legislature_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king summoned a <w>parliament</w> of barons to request funds for the war.",
                            "target_lang_translations": {
                                "ru": "Король созвал <w>парламент</w> из баронов, чтобы запросить средства на войну.",
                                "zh": "国王召集了一个由男爵组成的<w>议事会</w>，以请求战争经费。"
                            }
                        },
                        {
                            "text": "In the 13th century, a <w>parliament</w> was often just a meeting to raise cash.",
                            "target_lang_translations": {
                                "ru": "В XIII веке <w>парламент</w> часто был просто собранием для сбора денег.",
                                "zh": "在13世纪，<w>议事会</w>通常只是为了筹集资金而召开的会议。"
                            }
                        }
                    ],
                    "synonyms": [
                        "council"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "refers to historical councils rather than modern legislatures"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальное совещание или совет, исторически созываемый монархом для обсуждения важных вопросов.",
                        "zh": "历史上由君主召集，用于讨论重要事务的正式会议或委员会。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "парламент",
                                "target_lang_sense_clarification": "историческое собрание"
                            },
                            {
                                "target_lang_word": "совет",
                                "target_lang_sense_clarification": "совещательный орган"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "议事会",
                                "target_lang_sense_clarification": "历史上的咨询机构"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1b8c6c99-cc59-3593-b46c-df922b5e29d4",
                    "sense_definition": "A group of owls or rooks gathered together.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We were lucky enough to see a <w>parliament</w> of owls in the old barn.",
                            "target_lang_translations": {
                                "ru": "Нам посчастливилось увидеть <w>стаю</w> сов в старом сарае.",
                                "zh": "我们很幸运，在旧谷仓里看到了一<w>群</w>猫头鹰。"
                            }
                        },
                        {
                            "text": "A <w>parliament</w> of rooks settled on the bare branches of the tree.",
                            "target_lang_translations": {
                                "ru": "<w>Стая</w> грачей уселась на голые ветки дерева.",
                                "zh": "一<w>群</w>秃鼻乌鸦落在了光秃秃的树枝上。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "parliament of owls",
                        "parliament of rooks"
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа сов или грачей, собравшихся вместе.",
                        "zh": "一群聚集在一起的猫头鹰或秃鼻乌鸦。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стая",
                                "target_lang_sense_clarification": "группа птиц"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一群",
                                "target_lang_sense_clarification": "用于描述特定鸟类聚集的量词"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cb48182b-dcb4-339e-9930-cde43b98a774",
                    "sense_definition": "A type of thin, crisp gingerbread cake.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children enjoyed eating sweet <w>parliament</w> cakes after their lessons.",
                            "target_lang_translations": {
                                "ru": "Дети с удовольствием ели сладкие <w>парламентские пряники</w> после уроков.",
                                "zh": "孩子们课后喜欢吃甜的<w>姜饼</w>。"
                            }
                        },
                        {
                            "text": "He bought a piece of <w>parliament</w> from the stall at the fair.",
                            "target_lang_translations": {
                                "ru": "Он купил кусочек <w>парламентского пряника</w> в ларьке на ярмарке.",
                                "zh": "他在集市的摊位上买了一块<w>姜饼</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "parliament cake"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "refers to a specific old-fashioned type of cake"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Разновидность тонкого хрустящего имбирного пряника.",
                        "zh": "一种薄而脆的姜饼。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "парламентский пряник",
                                "target_lang_sense_clarification": "кондитерское изделие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "姜饼",
                                "target_lang_sense_clarification": "一种传统糕点"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "2b40a329-1a18-3721-8144-236b236a12b0",
                    "sense_definition": "The specific legislative body of the United Kingdom or England.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "legislature_group",
                    "name_type": "organization_name",
                    "examples": [
                        {
                            "text": "The Prime Minister will address <w>Parliament</w> regarding the new policy tomorrow.",
                            "target_lang_translations": {
                                "ru": "Завтра премьер-министр выступит перед <w>Парламентом</w> по поводу новой политики.",
                                "zh": "首相明天将就新政策向<w>英国议会</w>发表讲话。"
                            }
                        },
                        {
                            "text": "Tourists often visit the Houses of <w>Parliament</w> when they are in London.",
                            "target_lang_translations": {
                                "ru": "Туристы часто посещают здание <w>Парламента</w>, когда бывают в Лондоне.",
                                "zh": "游客在伦敦时经常参观<w>英国议会</w>大厦。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "Houses of Parliament"
                    ],
                    "target_lang_definitions": {
                        "ru": "Законодательный орган Соединенного Королевства или Англии.",
                        "zh": "英国或英格兰的特定立法机构。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Парламент",
                                "target_lang_sense_clarification": "государственный орган Великобритании"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "英国议会",
                                "target_lang_sense_clarification": "英国国家立法机构"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}