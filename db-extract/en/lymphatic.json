                    {
                        "translation_id": "3bbc20e4-faaf-4005-83eb-6fd7f5a24dd1",
                        "source_entry_id": "09f4d174-5f8b-32a4-9938-f69a022fb85b",
                        "source_sense_description": "pertaining to lymph or lymphatic system",
                        "target_lang_word": "lymfatisch",
