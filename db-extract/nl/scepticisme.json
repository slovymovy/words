                                    {
                                        "sense_id": "06e3232e-0566-345f-8477-738117ceff41",
                                        "entry_id": "7aa6f088-24ef-3744-b730-cd7039343f01",
                                        "glosses": [
                                            "A studied attitude of questioning and doubt."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc649d90-35cf-4ac2-ac81-dd0da0c1d746",
                                                "sense_id": "06e3232e-0566-345f-8477-738117ceff41",
                                                "text": "Ever since El Martinez started asking to be called by the gender-neutral pronouns “they/them” in the ninth grade, they have fielded skepticism in a variety of forms and from a multitude of sources about what it means to identify as nonbinary."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26583a33-2749-3658-b76f-4a538b196e89",
                                        "entry_id": "7aa6f088-24ef-3744-b730-cd7039343f01",
                                        "glosses": [
                                            "The doctrine that absolute knowledge is not possible."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "43b90b75-0b26-3c86-ad51-1be2002bbaec",
                                        "entry_id": "7aa6f088-24ef-3744-b730-cd7039343f01",
                                        "glosses": [
                                            "A methodology that starts from a neutral standpoint and aims to acquire certainty through scientific or logical observation."
                                        ],
