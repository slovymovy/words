                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "prison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de oude <w>gevangen</w> van de stad werden vroeger veel mensen vastgehouden.",
                            "target_lang_translations": {
                                "en": "In the city's old <w>prisons</w>, many people used to be held.",
                                "ru": "В старых городских <w>тюрьмах</w> раньше содержалось много людей."
                            }
                        },
                        {
                            "text": "De verhalen over de middeleeuwse <w>gevangen</w> zijn vaak erg grimmig.",
                            "target_lang_translations": {
                                "en": "The stories about medieval <w>dungeons</w> are often very grim.",
                                "ru": "Рассказы о средневековых <w>темницах</w> часто очень мрачные."
                            }
                        }
                    ],
                    "synonyms": [
                        "gevangenissen"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "gevang is minder gebruikelijk dan gevangenis"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "plural form of the noun 'gevang' (prison)",
                        "ru": "множественное число существительного gevang (тюрьма)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "prisons",
                                "target_lang_sense_clarification": "dated or literary term for jails"
                            },
                            {
                                "target_lang_word": "dungeons",
                                "target_lang_sense_clarification": "historical places of confinement"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "тюрьмы",
                                "target_lang_sense_clarification": "устаревшее или литературное обозначение мест заключения"
                            },
                            {
                                "target_lang_word": "темницы",
                                "target_lang_sense_clarification": "исторические места заключения"
                            }
                        ]
