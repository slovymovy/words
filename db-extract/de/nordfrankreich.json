                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91a23b81-e0f6-4535-b060-e97fbcc1411f",
                                "sense_id": "d9ac08ee-4021-32c1-b485-77fb2f775b7d",
                                "text": "„In vielen früheren Bergarbeiterstädten in Nordfrankreich regiert der Frust, weil der Strukturwandel dort nicht gelingt.“"
                            },
                            {
                                "example_id": "a299a5c3-8c37-49e3-a91e-7d424c347a48",
                                "sense_id": "d9ac08ee-4021-32c1-b485-77fb2f775b7d",
                                "text": "„In Nordfrankreich haben offenbar schwer bewaffnete Männer einen Gefangenentransporter überfallen, um einen Häftling zu befreien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
