                        "glosses": [
                            "een hoeveelheid geld die men zeker ontvangt ook als het tegenzit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "593a537f-cef7-4482-9ce2-303f79d9214a",
                                "sense_id": "aab32bcc-5df0-3142-b623-7006b6516187",
                                "text": "Sterre ging vorig jaar augustus meer verdienen en had daardoor volgens de toenmalige regels recht op het wettelijke minimumloon per maand. Maar dat recht vervalt onder de nieuwe regels. Om een inkomensval te voorkomen stelde het ministerie van Sociale Zaken een garantiebedrag in, dat het inkomen tot op het oude niveau aanvult."
                            },
                            {
                                "example_id": "ed7df9af-c119-47e5-989f-789e58fcce86",
                                "sense_id": "aab32bcc-5df0-3142-b623-7006b6516187",
                                "text": "Zoals al eerder was aangekondigd, komen meer hypotheken voor garantie in aanmerking: de grens van het garantiebedrag stijgt van 265.000 naar 290.000 euro. Voor huizen met energiebesparende voorzieningen gaat een plafond gelden van 307.400 euro."
                            }
                        ]
                    }
