            {
                "entry_id": "3ecddbbf-c8d1-3025-9656-75c4098ae011",
                "word": "supercomputer",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "2b24e118-da9e-424b-b150-ea5246b8eb5a",
