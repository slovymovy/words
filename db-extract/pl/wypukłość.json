                                                "example_id": "61767d18-6f64-4eff-934c-76543eb26f6a",
                                                "sense_id": "c7bfefc9-4c9c-327b-8ac1-1b8da1a0ece2",
                                                "text": "„Nachdem in mehreren Anläufen die zweifelsfrei höchste Stelle des Kibo ermittelt werden konnte, kommt es am 6. Oktober 1889 endlich und ohne weitere Umstände zur Erstbesteigung der höchsten Erhebung des Kilimandscharo-Massivs durch Meyer und Putscheller.“"
                                            },
                                            {
                                                "example_id": "0f89f186-0a16-477c-a35b-21a00687119a",
                                                "sense_id": "c7bfefc9-4c9c-327b-8ac1-1b8da1a0ece2",
                                                "text": "„Die Erhebung sei aber keine natürliche, sondern bestehe aus lauter Trümmern des letzten Krieges.“"
                                            },
                                            {
                                                "example_id": "559243a6-26b9-4f60-a017-9789c7e68b79",
                                                "sense_id": "c7bfefc9-4c9c-327b-8ac1-1b8da1a0ece2",
                                                "text": "„Nun wehte die deutsche Fahne auf der höchsten Erhebung des Kontinents.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "41a1cd16-3abd-3273-b8e1-b0a810ebcc34",
                                        "entry_id": "7bbd7977-60a2-3f4a-a573-e6290419df98",
                                        "glosses": [
                                            "Verfahren, mittels dessen bestimmte Erkenntnisse gewonnen werden können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "857eb99c-009f-42dd-b262-e560903bbc59",
                                                "sense_id": "41a1cd16-3abd-3273-b8e1-b0a810ebcc34",
                                                "text": "Einer neuen Erhebung zufolge sind 80% aller Statistiken falsch."
                                            },
                                            {
                                                "example_id": "3024cd1b-8719-4488-a493-84a40c732f4b",
                                                "sense_id": "41a1cd16-3abd-3273-b8e1-b0a810ebcc34",
                                                "text": "Die Erhebung der Daten war langwierig, manche Unterlagen waren kaum noch zu lesen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "21df33b2-d268-3bc9-91ce-1cad04ff9e9c",
                                        "entry_id": "7bbd7977-60a2-3f4a-a573-e6290419df98",
                                        "glosses": [
                                            "Aufstand, Widerstand gegen etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d2f7f61-c1fe-4d88-a2a5-e348f82b814a",
                                                "sense_id": "21df33b2-d268-3bc9-91ce-1cad04ff9e9c",
                                                "text": "Barrikaden wurden errichtet, aber es waren bereits genügend Truppen nach Frankfurt beordert worden, und nach sechsstündigem Kampf war die Erhebung niedergeschlagen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "cafe445b-3291-30c4-a17d-e828c8749cf5",
                                        "entry_id": "7bbd7977-60a2-3f4a-a573-e6290419df98",
                                        "glosses": [
                                            "Forderungsstellung und -vollzug durch den Staat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fef84964-c655-4ce8-822f-f5745c7f20e9",
                                                "sense_id": "cafe445b-3291-30c4-a17d-e828c8749cf5",
                                                "text": "Um die Erhebung der Mehrwertsteuer zu erleichtern, wurde in Griechenland 2010 eine rigorose Quittungspflicht eingeführt."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "14027f76-3f76-489e-908b-3793f586c7b6",
                        "source_entry_id": "ac4cc373-b263-3f13-a74b-12cac2c8bcda",
                        "source_sense_id": "758fb60a-c1e5-3b6a-a08a-f7c137aac365",
                        "target_lang_word": "Unebenheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unebenheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "14e059a6-246f-3091-950a-6335292c2e79",
                                        "entry_id": "d4167a10-5c63-3583-b289-61c881323f9a",
                                        "glosses": [
                                            "höhere und/der niedrigere Stelle auf einer Fläche"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ee80b14-f051-4ea0-bfa7-52affa49b1d0",
                                                "sense_id": "14e059a6-246f-3091-950a-6335292c2e79",
                                                "text": "„\"Diese Unebenheit hier, das war ein kleiner Schaden im Stein, der beschliffen wurde\", erklärt sie eine Besonderheit.“"
                                            },
                                            {
                                                "example_id": "32fe903d-73b8-47aa-b0c7-76a29e8064f6",
                                                "sense_id": "14e059a6-246f-3091-950a-6335292c2e79",
                                                "text": "„Fast jede Schiffsschraube hat an einem bestimmten Blatt eine Unebenheit.“"
                                            },
                                            {
                                                "example_id": "86b4fff1-d238-4d2c-93ce-2ef5cea34c12",
                                                "sense_id": "14e059a6-246f-3091-950a-6335292c2e79",
                                                "text": "„Jede Unebenheit der Straße, jeder Stoß des Wagens setzt sich wie ein Messerstich fort.“"
                                            },
                                            {
                                                "example_id": "9bd711dc-f203-4f0a-a0fe-2f492d8f0269",
                                                "sense_id": "14e059a6-246f-3091-950a-6335292c2e79",
                                                "text": "„Um die Mittagsstunde des 22. Oktober marschierte Pierre auf der schmutzigen, glitschigen Strasse und sah dabei auf seine Füsse und die Unebenheiten des Weges.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
