                        "entry_id": "1365b091-7e11-3412-8172-7d9b6de5616f",
                        "glosses": [
                            "Shame; disgrace."
                        ],
                        "tags": [
                            "Jewish"
                        ],
                        "examples": [
                            {
                                "example_id": "6e805eb4-3ac4-4b29-b5c0-6f2dd67dc02b",
                                "sense_id": "2d407772-b8a5-3827-9529-854f3e06605b",
                                "text": "Oi, it was such a shanda. I should never buy gribenes from a Mohel. It's so chewy."
                            },
                            {
                                "example_id": "d5dd3b42-249d-4071-b000-26ad96d2d20f",
                                "sense_id": "2d407772-b8a5-3827-9529-854f3e06605b",
                                "text": "A shanda is humiliation and embarrassment one's misdeed suffers upon one's family. In our faith, a shanda is a terrible sin."
                            },
                            {
                                "example_id": "e689e676-7f28-4323-83b0-fa564403eefd",
                                "sense_id": "2d407772-b8a5-3827-9529-854f3e06605b",
                                "text": "They don't learn about their heritage. They don't learn about Israel. It's a shanda."
                            },
                            {
                                "example_id": "008f38e5-f731-46c2-925d-9a5394d1b7a1",
                                "sense_id": "2d407772-b8a5-3827-9529-854f3e06605b",
                                "text": "My parents are Orthodox Jews. To them, intermarriage is considered a shanda."
                            }
                        ]
                    }
