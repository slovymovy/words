                ],
                "senses": [
                    {
                        "sense_id": "c11e00ab-5520-39b4-be79-a5c3e31fa30e",
                        "entry_id": "f1685110-0109-3f04-bf2b-6d013789234a",
                        "glosses": [
                            "A spiral or circular dot placed on the forehead of Buddhist images as an auspicious mark."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17e5cc59-b868-4f66-9350-ae3737467ee5",
                                "sense_id": "c11e00ab-5520-39b4-be79-a5c3e31fa30e",
                                "text": "The urna is not worn by all, nor the monastic dress of the magnificent image of the Buddhistic prince on the right side of the great Buddha in the chanḍi Mĕndut."
                            },
                            {
                                "example_id": "059b84e6-79e4-4fba-9ffd-e072c8cd2cfd",
                                "sense_id": "c11e00ab-5520-39b4-be79-a5c3e31fa30e",
                                "text": "The ûrna or mark upon the forehead and the long pierced ear lobes so generally characteristic of Buddhist images are not present in this instance."
                            },
                            {
                                "example_id": "53f6fc20-8480-4dc0-a9dd-39263a2e4d4c",
                                "sense_id": "c11e00ab-5520-39b4-be79-a5c3e31fa30e",
                                "text": "Between the eyes is a curl of hair (urna), one of the identifying features of a Buddha, and the thing that looks like a nose is a miraculous light emanating from the urna (it can also be interpreted as the Nepali figure “one”, conveying the unity of all things)."
                            }
                        ]
                    }
                ],
                "translations": [
