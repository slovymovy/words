                "senses": [
                    {
                        "sense_id": "9563cc11-999e-32cd-9619-8e07bf97fa78",
                        "entry_id": "b83fe7e0-5501-3ec5-af5c-d5c7e00a93e9",
                        "glosses": [
                            "ж.-д. разновидность моторвагонного подвижно́го состава, получающего энергию от внешней контактной сети с помощью токоприёмников"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d92065b-7e59-4dc0-b4b6-94cd7425b1b1",
                                "sense_id": "9563cc11-999e-32cd-9619-8e07bf97fa78",
                                "text": "Затем на испытания прибудет девятивагонный электропоезд с наклоняемыми кузовами."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e6d83fe9-af25-4769-a22e-89da4ffec3df",
                        "source_entry_id": "b83fe7e0-5501-3ec5-af5c-d5c7e00a93e9",
                        "source_sense_id": "9563cc11-999e-32cd-9619-8e07bf97fa78",
                        "target_lang_word": "電車",
                        "target_lang_code": "ja",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "電車",
                                "target_lang_code": "ja",
                                "target_senses": [
                                    {
                                        "sense_id": "32eb1678-db2a-3668-acf2-55b746ef7dff",
                                        "entry_id": "d8fd80c3-1552-3156-ab19-c8466b3b5908",
                                        "glosses": [
                                            "外部からの電気を動力として走る列車のうち、1編成中の車両のいくつか又はすべてに動力となる電動機を装備して自走能力をそなえ、機関車の牽引によらずに走行する列車。"
                                        ],
                                        "tags": [
                                            "車両"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dfeb92ca-26eb-311c-892a-11191044f6bf",
                                        "entry_id": "d8fd80c3-1552-3156-ab19-c8466b3b5908",
                                        "glosses": [
                                            "1のうち、特に都市とその近郊を結ぶ近距離に運行されるもの。"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "059085f3-e7ce-3c69-9257-a5ef555caa78",
                                        "entry_id": "d8fd80c3-1552-3156-ab19-c8466b3b5908",
                                        "glosses": [
                                            "路面電車の略。"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c2c78f5-e749-46e9-9fcf-551fab6fa5fe",
                                                "sense_id": "059085f3-e7ce-3c69-9257-a5ef555caa78",
                                                "text": "三四郎が東京で驚いたものはたくさんある。第一電車のちんちん鳴るので驚いた。それからそのちんちん鳴るあいだに、非常に多くの人間が乗ったり降りたりするので驚いた。"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "401d732b-c3ce-3a7e-abd5-9623b98ac252",
                                        "entry_id": "d8fd80c3-1552-3156-ab19-c8466b3b5908",
                                        "glosses": [
                                            "車やバスに対する交通手段としての列車。"
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96bea3b3-f444-416f-9450-1da03b30fc87",
                                                "sense_id": "401d732b-c3ce-3a7e-abd5-9623b98ac252",
                                                "text": "車より電車で行くほうがいいよ。"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
