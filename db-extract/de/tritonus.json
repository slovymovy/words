                "senses": [
                    {
                        "sense_id": "a1fa0d50-ee82-3b10-97c5-ad1ceb2fdcd4",
                        "entry_id": "9a86c175-c347-34c0-8df2-505b74e117c0",
                        "glosses": [
                            "Intervall, das aus drei Ganztönen besteht; gilt ursprünglich nur für die übermäßige Quarte (ü4), wird heute jedoch häufig auch für die verminderte Quinte (v5) verwendet, obwohl dies streng genommen eine enharmonische Vertauschung ist"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "55dc1f66-d52e-4baf-8ee2-58928fbc2617",
                                "sense_id": "a1fa0d50-ee82-3b10-97c5-ad1ceb2fdcd4",
                                "text": "„Um ein Beispiel aus der Harmonik zu geben: Das Wort Tritonus hat den Vorteil, die Unterscheidung zwischen übermäßiger Quart und verminderter Quint zu vermeiden und damit die besonders in neuerer Musik grundlegende Gleichwertigkeit der beiden je nach Kontext unterschiedlich notierten Intervalle zu betonen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c5350f8f-a962-4213-babb-f8763548f164",
                        "source_entry_id": "9a86c175-c347-34c0-8df2-505b74e117c0",
                        "source_sense_id": "a1fa0d50-ee82-3b10-97c5-ad1ceb2fdcd4",
                        "target_lang_word": "tritone",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tritone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b0c5309c-47ab-32e0-890b-0e09ef5a7934",
                                        "entry_id": "ed046270-bbbd-39c0-bfb2-84a708e01430",
                                        "glosses": [
                                            "An interval of three whole tones."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e5b1ade-3036-4566-97db-2f078e22388a",
                                                "sense_id": "b0c5309c-47ab-32e0-890b-0e09ef5a7934",
                                                "text": "The tritone has a pitch ratio close to 17:12."
                                            },
                                            {
                                                "example_id": "f2d1bb2c-63c0-435b-a837-d3cb75ece4a8",
                                                "sense_id": "b0c5309c-47ab-32e0-890b-0e09ef5a7934",
                                                "text": "Near-synonyms: augmented fourth, diminished fifth"
                                            },
                                            {
                                                "example_id": "c134aea8-f5b9-4dae-8f8d-18f584b4e965",
                                                "sense_id": "b0c5309c-47ab-32e0-890b-0e09ef5a7934",
                                                "text": "The mini-epic “Seasons in the Abyss,” with its ringing tritone interval at the beginning, its extended solos, its medium tempo, was as close as Slayer got to a groove."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tritone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dbc4af16-cf44-32fc-9e2a-067e2b3dab24",
                                        "entry_id": "fe1a4659-35ac-3e2c-b03a-04a6d4dff303",
                                        "glosses": [
                                            "A picture printed in three shades."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f81bc251-aca8-4668-bd0d-95d43541bc42",
                                                "sense_id": "dbc4af16-cf44-32fc-9e2a-067e2b3dab24",
                                                "text": "In Photoshop’s Duotone mode you can create monotones, duotones, tritones, and quadtones—grayscale images to which you add one, two, three, or four colors."
                                            },
                                            {
                                                "example_id": "4d52c00e-7a1d-46f2-a456-426c32c7e67f",
                                                "sense_id": "dbc4af16-cf44-32fc-9e2a-067e2b3dab24",
                                                "text": "When using tritones or quadtones (in which three colours are blended together) all the secondary colours are mixed together."
                                            },
                                            {
                                                "example_id": "4296d2e1-6b86-4bcf-b571-f63db8b8fa0b",
                                                "sense_id": "dbc4af16-cf44-32fc-9e2a-067e2b3dab24",
                                                "text": "The two colours need not be black and grey; computer duotones can be created from a greyscale original in any two colours; tritones use three inks and quadtones four."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tritone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3a798e51-4a90-3037-8e69-d42d74803743",
                                        "entry_id": "18b6ae41-2e29-322c-8b99-1dbc27b4a8f8",
                                        "glosses": [
                                            "Having three tones."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9649b22-0f4c-47ef-b351-e3f09a58264d",
                                                "sense_id": "3a798e51-4a90-3037-8e69-d42d74803743",
                                                "text": "The first cotume^([sic]) in which Mrs. Earle appeared was a tritone dress of crepe, with a brown velour cloche and brown calf sling pumps."
                                            },
                                            {
                                                "example_id": "7e65e151-d7e8-451a-b0ce-673c8446e3fb",
                                                "sense_id": "3a798e51-4a90-3037-8e69-d42d74803743",
                                                "text": "Fortrel-and-rayon-linen tritone dress, with drawstring waist."
                                            },
                                            {
                                                "example_id": "5fb5ceb9-fa07-470b-b70a-73f6cb148b32",
                                                "sense_id": "3a798e51-4a90-3037-8e69-d42d74803743",
                                                "text": "Tritone jacket has contrast nylon inserts. 80(Blue/Red/Wht.), 38(Beige/Navy/Red)."
                                            },
                                            {
                                                "example_id": "70a3aa7e-964e-4389-a9c6-7e896d6baf3f",
                                                "sense_id": "3a798e51-4a90-3037-8e69-d42d74803743",
                                                "text": "It is hard to believe that today’s signs may be tomorrow’s beloved ghosts, but sure as my 1970’s polyester tritone shirt and my plebeian 1964 Volvo are now “classics,” it will likely be so."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "feb1e774-09db-4612-810b-31107dd58b26",
                        "source_entry_id": "9a86c175-c347-34c0-8df2-505b74e117c0",
                        "source_sense_id": "a1fa0d50-ee82-3b10-97c5-ad1ceb2fdcd4",
