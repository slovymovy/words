                    {
                        "form_id": "f35f51ec-e2e5-41fd-8bed-0413286c6f6a",
                        "entry_id": "f52c773f-1432-3fa9-b5d7-f4bd0ad8b873",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Sonntagmorgen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6581f566-ff8e-3216-8737-a494a55b73ad",
                        "entry_id": "f52c773f-1432-3fa9-b5d7-f4bd0ad8b873",
                        "glosses": [
                            "der Morgen eines Sonntages"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a878b77-8480-4987-8a53-da34a9e2204d",
                                "sense_id": "6581f566-ff8e-3216-8737-a494a55b73ad",
                                "text": "Sonntagmorgen bleiben wir gern lange im Bett liegen."
                            },
                            {
                                "example_id": "f70f6971-5697-4b3e-bd31-935c0f4d7369",
                                "sense_id": "6581f566-ff8e-3216-8737-a494a55b73ad",
                                "text": "Zum Glück gibt es auch an Sonntagmorgen frische Brötchen."
                            },
                            {
                                "example_id": "d59b2efb-2a22-446f-8c77-34f3d298075d",
                                "sense_id": "6581f566-ff8e-3216-8737-a494a55b73ad",
                                "text": "„Doch an diesem Sonntagmorgen stand eine Tür offen.“"
                            },
                            {
                                "example_id": "8b0f2c40-3a6a-49e4-aef8-c4e16176a4f6",
                                "sense_id": "6581f566-ff8e-3216-8737-a494a55b73ad",
                                "text": "„An einem Sonntagmorgen gegen 1.45 Uhr muss er über das Geländer der Brücke gewuchtet worden sein.“"
                            },
                            {
                                "example_id": "fcf26de6-8dc6-4368-bb8f-4b72ea65267f",
                                "sense_id": "6581f566-ff8e-3216-8737-a494a55b73ad",
                                "text": "„Es war ein Sonntagmorgen und viel zu früh.“"
                            },
                            {
                                "example_id": "96062fef-9b95-4a02-8178-5d06375500f8",
                                "sense_id": "6581f566-ff8e-3216-8737-a494a55b73ad",
                                "text": "„Ein Sonntagmorgen, wie er sein soll: Die Nacht blieb ruhig; mit dem gesättigten Kind im Arm kehre ich aus der Brennerei zurück.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
