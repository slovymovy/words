                                "example_id": "1a48ccaa-6153-4347-a693-80e15b63fb3a",
                                "sense_id": "e5667fb5-5331-386f-80eb-ff1194887222",
                                "text": "L’arolle, le pin des hautes altitudes, poussant au creux de la roche, résistant au froid et aux dureté de la montagne."
                            }
                        ]
