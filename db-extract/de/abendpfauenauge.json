                "senses": [
                    {
                        "sense_id": "2896e672-8d82-38c9-a25c-f51874b6e67f",
                        "entry_id": "a8209fe0-6a32-320a-9269-b2548b4c492b",
                        "glosses": [
                            "Schmetterlingsart aus der Familie der Schwärmer (Sphingidae)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7cc1aa35-2b82-4c6e-a69a-b932f7ed32ee",
                                "sense_id": "2896e672-8d82-38c9-a25c-f51874b6e67f",
                                "text": "„Abendpfauenauge (Smerinthus ocellata) und Tagpfauenauge (Inachis io) zeigen beide eine Schreckfärbung auf den Hinterflügeln.“"
                            },
                            {
                                "example_id": "e1e477f2-691e-4e84-af1a-d51a07029b4c",
                                "sense_id": "2896e672-8d82-38c9-a25c-f51874b6e67f",
                                "text": "„Übrigens: Anders als der Name andeutet, fliegt das Abendpfauenauge bis in die Morgendämmerung hinein, vor allem in Wäldern und Gärten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
