                                "target_senses": [
                                    {
                                        "sense_id": "11c1f976-17fc-373a-bc89-e7bbb944b968",
                                        "entry_id": "9b13e705-3a5a-3056-9ec1-0f50f0e87659",
                                        "glosses": [
                                            "One who practices sodomy; a sodomist."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "772680aa-0e83-4180-af61-1e26deb6bbee",
                                                "sense_id": "11c1f976-17fc-373a-bc89-e7bbb944b968",
                                                "text": "There ſhalbe no whoꝛe of the daughters of Iſrael, noꝛ a Sodomite of the ſonnes of Iſrael."
                                            },
                                            {
                                                "example_id": "44a669de-025d-4ea5-babb-72a936858365",
                                                "sense_id": "11c1f976-17fc-373a-bc89-e7bbb944b968",
                                                "text": "The Avestan texts denounce the sodomite as a demon[…]"
                                            },
                                            {
                                                "example_id": "079df715-b0dc-4a6d-9e8f-11322dce7bf0",
                                                "sense_id": "11c1f976-17fc-373a-bc89-e7bbb944b968",
                                                "text": "For example, when one of his programmers and her husband engaged in oral sex in their own bedroom one night, the next morning she was called into Rife's office, where he called her a slut and a sodomite and told her to clean out the desk."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e9c63f9-ca46-390c-a725-8c183291742c",
                                        "entry_id": "9b13e705-3a5a-3056-9ec1-0f50f0e87659",
                                        "glosses": [
                                            "A native or inhabitant of Sodom."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "24712fa2-70fa-4939-9715-c221c7127f71",
                        "source_entry_id": "1dc9e6af-14a7-3cd4-929d-d8cfb12e7b43",
                        "source_sense_id": "3b8c604a-8963-3d17-b9a1-57798429462b",
