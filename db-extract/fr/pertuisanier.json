                "senses": [
                    {
                        "sense_id": "3608a254-447d-3754-9135-818afc22746a",
                        "entry_id": "8b000c75-cad8-3929-abba-2e30defaeefb",
                        "glosses": [
                            "Soldat armé d’une pertuisane."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17db31a9-9e37-4ca3-be21-e3d718ebe3fa",
                                "sense_id": "3608a254-447d-3754-9135-818afc22746a",
                                "text": "Elle se leva pourtant à l’ordre des pertuisaniers, et marcha d’un pas assez ferme."
                            },
                            {
                                "example_id": "7014d2da-3b5a-4d41-b7ea-45731deff3ad",
                                "sense_id": "3608a254-447d-3754-9135-818afc22746a",
                                "text": "— « Holà ! Holà ! à mon aide ! » Et les pertuisaniers de la porte accoururent."
                            }
                        ]
                    },
                    {
                        "sense_id": "97698eca-2700-332e-9e84-663032680815",
                        "entry_id": "8b000c75-cad8-3929-abba-2e30defaeefb",
                        "glosses": [
                            "Gardien des hommes condamnés aux fers, dans les bagnes."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "82e36c30-5932-4aa4-920b-0be92aa079f2",
                                "sense_id": "97698eca-2700-332e-9e84-663032680815",
                                "text": "Et puis, autour de trois livides prisonniers\nQui vont pieds nus, un gros de hauts pertuisaniers\nEn marche, et leurs fers droits, comme des fers de herse,\nLuisent à contresens des lances de l’averse."
                            }
                        ]
                    }
                ],
