                "translations": [
                    {
                        "translation_id": "2cfe445e-49d7-4434-8357-2f9ad17bd256",
                        "source_entry_id": "44e65352-7fae-3f8b-9f26-bfd5bb494216",
                        "source_sense_id": "d193d49c-e18c-33a9-a471-881208f0155a",
