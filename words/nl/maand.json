    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "30a38a3f-6021-399c-9ae9-1d2504642a5d",
                    "sense_definition": "een tijdsperiode van ongeveer dertig dagen",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "tijdseenheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De pup blijkt precies een <w>maand</w> oud te zijn.",
                            "target_lang_translations": {
                                "en": "The puppy turns out to be exactly one <w>month</w> old.",
                                "ru": "Оказывается, щенку ровно один <w>месяц</w>."
                            }
                        },
                        {
                            "text": "Je moet binnen een <w>maand</w> schriftelijk reageren op de klacht.",
                            "target_lang_translations": {
                                "en": "You must respond to the complaint in writing within a <w>month</w>.",
                                "ru": "Вы должны письменно ответить на жалобу в течение <w>месяца</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "binnen een maand",
                        "volgende maand",
                        "vorige maand"
                    ],
                    "target_lang_definitions": {
                        "en": "a period of time of approximately thirty days",
                        "ru": "период времени продолжительностью около тридцати дней"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "month",
                                "target_lang_sense_clarification": "a period of 30 or 31 days"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "месяц",
                                "target_lang_sense_clarification": "период времени в 30 дней"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c490e2cd-cb5c-3b17-89f5-91a19059c88c",
                    "sense_definition": "elk van de twaalf benoemde tijdvakken waarin een jaar verdeeld wordt",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "kalender",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik ben geboren in de <w>maand</w> juli.",
                            "target_lang_translations": {
                                "en": "I was born in the <w>month</w> of July.",
                                "ru": "Я родился в <w>месяце</w> июле."
                            }
                        },
                        {
                            "text": "Januari is meestal de koudste <w>maand</w> van het jaar.",
                            "target_lang_translations": {
                                "en": "January is usually the coldest <w>month</w> of the year.",
                                "ru": "Январь обычно самый холодный <w>месяц</w> в году."
                            }
                        }
                    ],
                    "common_phrases": [
                        "de maand juli",
                        "elke maand"
                    ],
                    "target_lang_definitions": {
                        "en": "each of the twelve named periods into which a year is divided",
                        "ru": "каждый из двенадцати именованных периодов, на которые делится год"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "month",
                                "target_lang_sense_clarification": "calendar month such as January or July"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "месяц",
                                "target_lang_sense_clarification": "календарный месяц, например, январь или июль"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}