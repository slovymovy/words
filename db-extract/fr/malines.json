                                        "entry_id": "fc7d0a61-4b1b-37b1-9624-f2aab24e2151",
                                        "glosses": [
                                            "A kind of lace made at, or originating in, Mechelen, having a bobbin ground and designs outlined by thread or flat cord."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4829420-699d-431e-840b-f01b54f52f18",
                                                "sense_id": "eaf12681-83fc-3711-9c46-eca3f95b101b",
                                                "text": "And if disputes of empire rise between / Mechlin, the queen of lace, and Colberteen."
                                            },
                                            {
                                                "example_id": "f57c6be3-b516-4a2e-a6f2-eb1b84e25c42",
                                                "sense_id": "eaf12681-83fc-3711-9c46-eca3f95b101b",
                                                "text": "[…]“Only think, my dear, of my having got that frightful great rent in my best Mechlin so charmingly mended, before I left Bath, that one can hardly see where it was."
                                            },
                                            {
                                                "example_id": "2627b9f2-70bc-4cee-97da-60346553aa07",
                                                "sense_id": "eaf12681-83fc-3711-9c46-eca3f95b101b",
                                                "text": "People like the moth, / Of mechlin, frames, / Duties of gossamer, / And eider names."
                                            }
                                        ]
                                    }
                                ]
                            }
