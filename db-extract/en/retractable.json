                                            {
                                                "example_id": "847b97da-3aa0-42b5-a1d1-f42cc110dbcf",
                                                "sense_id": "1e44ce9a-276d-31be-a283-a2c1e9743053",
                                                "text": "Un cordon rétractable, une mine rétractable."
