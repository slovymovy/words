{
    "word_family": [
        "beetling",
        "beetle-browed"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "171a0e3c-4195-3a8f-93e6-45b047ff683a",
                    "sense_definition": "Any of numerous species of insect in the order Coleoptera characterized by a pair of hard, shell-like front wings which cover and protect a pair of rear wings when at rest.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "insect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A shiny black <w>beetle</w> crawled slowly across the garden path.",
                            "target_lang_translations": {
                                "ru": "Блестящий черный <w>жук</w> медленно полз по садовой дорожке."
                            }
                        },
                        {
                            "text": "The scientist carefully studied the wings of the rare <w>beetle</w> under a microscope.",
                            "target_lang_translations": {
                                "ru": "Ученый внимательно изучал крылья редкого <w>жука</w> под микроскопом."
                            }
                        }
                    ],
                    "synonyms": [
                        "bug"
                    ],
                    "target_lang_definitions": {
                        "ru": "Насекомое из отряда жесткокрылых, характеризующееся парой твердых передних крыльев, защищающих задние крылья."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жук",
                                "target_lang_sense_clarification": "насекомое"
                            },
                            {
                                "target_lang_word": "жесткокрылое",
                                "target_lang_sense_clarification": "энтомологический термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "23418b4c-ef23-37ea-bb80-6f22fe629d46",
                    "sense_definition": "A small car, the Volkswagen Beetle, known for its distinctive rounded shape.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vehicle",
                    "name_type": "brand_or_product_name",
                    "examples": [
                        {
                            "text": "My grandfather still drives his classic yellow <w>Beetle</w> every weekend.",
                            "target_lang_translations": {
                                "ru": "Мой дедушка до сих пор каждые выходные ездит на своем классическом желтом <w>«Жуке»</w>."
                            }
                        },
                        {
                            "text": "The parking lot was full of modern cars, but one vintage <w>Beetle</w> stood out.",
                            "target_lang_translations": {
                                "ru": "Парковка была забита современными машинами, но один винтажный <w>«Жук»</w> выделялся на их фоне."
                            }
                        }
                    ],
                    "synonyms": [
                        "Bug"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой автомобиль марки Volkswagen Beetle, известный своей характерной округлой формой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "«Жук»",
                                "target_lang_sense_clarification": "модель автомобиля Volkswagen"
                            },
                            {
                                "target_lang_word": "Фольксваген Жук",
                                "target_lang_sense_clarification": "полное название модели"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7ac4232f-62ff-352d-a693-03b4567eb497",
                    "sense_definition": "A type of mallet with a large wooden head, used to drive wedges or beat pavements.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The worker used a heavy wooden <w>beetle</w> to drive the stakes into the ground.",
                            "target_lang_translations": {
                                "ru": "Рабочий использовал тяжелую деревянную <w>киянку</w>, чтобы вбить колья в землю."
                            }
                        },
                        {
                            "text": "He swung the <w>beetle</w> with great force to flatten the uneven stones.",
                            "target_lang_translations": {
                                "ru": "Он с большой силой взмахнул <w>трамбовкой</w>, чтобы выровнять неровные камни."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тип молотка с большой деревянной головкой, используемый для забивания клиньев или трамбовки мостовых."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "киянка",
                                "target_lang_sense_clarification": "деревянный молоток"
                            },
                            {
                                "target_lang_word": "трамбовка",
                                "target_lang_sense_clarification": "инструмент для уплотнения"
                            },
                            {
                                "target_lang_word": "баба",
                                "target_lang_sense_clarification": "тяжелый молот для забивания свай"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f313f70e-66bd-3437-9d3b-edc89187e3d3",
                    "sense_definition": "Archaic spelling of <w>betel</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "plant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old text described the local custom of chewing <w>beetle</w> leaves after dinner.",
                            "target_lang_translations": {
                                "ru": "В старом тексте описывался местный обычай жевать листья <w>бетеля</w> после обеда."
                            }
                        },
                        {
                            "text": "He offered his guests some <w>beetle</w> and lime as a sign of hospitality.",
                            "target_lang_translations": {
                                "ru": "Он предложил гостям немного <w>бетеля</w> с известью в знак гостеприимства."
                            }
                        }
                    ],
                    "common_phrases": [
                        "beetle leaf"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "spelling of betel"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Архаичное написание слова «бетель» (растение)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бетель",
                                "target_lang_sense_clarification": "растение"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f01c80a2-9663-39f8-882a-408d58123311",
                    "sense_definition": "To move away quickly or to scurry away.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As soon as the meeting ended, he <w>beetled</w> off to catch his train.",
                            "target_lang_translations": {
                                "ru": "Как только собрание закончилось, он <w>удрал</w>, чтобы успеть на поезд."
                            }
                        },
                        {
                            "text": "The children <w>beetled</w> away when they heard their mother calling them for dinner.",
                            "target_lang_translations": {
                                "ru": "Дети <w>разбежались</w>, услышав, что мама зовет их обедать."
                            }
                        }
                    ],
                    "synonyms": [],
                    "common_phrases": [
                        "beetle off",
                        "beetle away"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used with 'off' or 'away'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстро уйти или поспешно убежать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удрать",
                                "target_lang_sense_clarification": "быстро уйти"
                            },
                            {
                                "target_lang_word": "смыться",
                                "target_lang_sense_clarification": "поспешно скрыться"
                            },
                            {
                                "target_lang_word": "побежать",
                                "target_lang_sense_clarification": "семенить"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f3e79809-c7df-3996-b852-0440ab92f1e4",
                    "sense_definition": "To loom over or to extend and jut out above something else.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dark cliffs <w>beetle</w> over the narrow path along the shore.",
                            "target_lang_translations": {
                                "ru": "Темные скалы <w>нависают</w> над узкой тропинкой вдоль берега."
                            }
                        },
                        {
                            "text": "He sat there silently, <w>beetling</w> his brows in deep concentration.",
                            "target_lang_translations": {
                                "ru": "Он сидел молча, в глубокой концентрации <w>нахмурив</w> брови."
                            }
                        }
                    ],
                    "synonyms": [],
                    "common_phrases": [
                        "beetle over",
                        "beetling brows"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Нависать над чем-либо или выступать вперед."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нависать",
                                "target_lang_sense_clarification": "о скалах или бровях"
                            },
                            {
                                "target_lang_word": "хмурить",
                                "target_lang_sense_clarification": "о бровях"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d3d502ee-f0f7-343a-9268-191372cc2edb",
                    "sense_definition": "To beat with a heavy mallet or to finish fabric by hammering it.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The workers had to <w>beetle</w> the cotton cloth to give it a smooth finish.",
                            "target_lang_translations": {
                                "ru": "Рабочим приходилось <w>отбивать</w> хлопковую ткань, чтобы придать ей гладкость."
                            }
                        },
                        {
                            "text": "In the old mill, they would <w>beetle</w> the fabric for hours using heavy machinery.",
                            "target_lang_translations": {
                                "ru": "На старой мельнице ткань часами <w>лощили</w> с помощью тяжелых механизмов."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical or industrial usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Бить тяжелым молотком или отделывать ткань путем простукивания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отбивать",
                                "target_lang_sense_clarification": "ткань или материал"
                            },
                            {
                                "target_lang_word": "лощить",
                                "target_lang_sense_clarification": "придавать блеск ткани ударами"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "42b85740-19fb-3238-b747-cdc44b5de8cb",
                    "sense_definition": "Protruding, jutting, or overhanging.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old man had thick, <w>beetle</w> brows that hid his eyes.",
                            "target_lang_translations": {
                                "ru": "У старика были густые, <w>нависшие</w> брови, скрывавшие его глаза."
                            }
                        },
                        {
                            "text": "We stood under the <w>beetle</w> crag to stay dry during the sudden rainstorm.",
                            "target_lang_translations": {
                                "ru": "Мы стояли под <w>выступающим</w> утесом, чтобы не промокнуть во время внезапного ливня."
                            }
                        }
                    ],
                    "common_phrases": [
                        "beetle brows"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выступающий, нависающий или торчащий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нависший",
                                "target_lang_sense_clarification": "о бровях или утесе"
                            },
                            {
                                "target_lang_word": "выступающий",
                                "target_lang_sense_clarification": "о форме"
                            }
                        ]
