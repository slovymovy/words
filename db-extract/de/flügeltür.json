                "senses": [
                    {
                        "sense_id": "e335bc36-cc81-3522-8099-419cc9be29a7",
                        "entry_id": "8af88b20-97a1-3065-9d8d-b17bb08ba6a6",
                        "glosses": [
                            "eine Tür, die aus zwei frei schwingenden Türflügeln besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f97a33f9-62d3-4bdb-90ed-5172e67363ba",
                                "sense_id": "e335bc36-cc81-3522-8099-419cc9be29a7",
                                "text": "Da die Halterung der einen Flügeltür nicht mehr in Ordnung war, konnte man die Tür durch einfaches schubsen öffnen."
                            },
                            {
                                "example_id": "64393664-ac18-49a7-909e-7119b01165fa",
                                "sense_id": "e335bc36-cc81-3522-8099-419cc9be29a7",
                                "text": "„Es wurde im Wohnzimmer aufgestellt, neben die Flügeltür, die in den anderen Raum, das sogenannte Eßzimmer, führte.“"
                            },
                            {
                                "example_id": "19d0ec82-3485-465b-9f1d-78d6a1504f7e",
                                "sense_id": "e335bc36-cc81-3522-8099-419cc9be29a7",
                                "text": "„Eine verglaste Flügeltür führte auf einen Balkon.“"
                            },
                            {
                                "example_id": "d5077603-9de3-4df5-ad1f-0fefe4396965",
                                "sense_id": "e335bc36-cc81-3522-8099-419cc9be29a7",
                                "text": "„Auf der Rückseite gelangte man über eine Treppe und durch eine Flügeltür mit kleinen Fenstern ins Innere des Wagens.“"
                            },
                            {
                                "example_id": "2bcd9ce4-6f79-4ecf-afd2-a4bcee3fb74b",
                                "sense_id": "e335bc36-cc81-3522-8099-419cc9be29a7",
                                "text": "„Im Blaumann stand er neben der großen Flügeltür, hörte zu und lächelte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
