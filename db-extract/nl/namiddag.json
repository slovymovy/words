                ],
                "senses": [
                    {
                        "sense_id": "1f44bd00-c22c-3db2-9fb5-20eb9c1de194",
                        "entry_id": "db0ea4d1-630c-32ee-8d2d-a3baca6dbec3",
                        "glosses": [
                            "tijd aan het einde van de middag of in het tweede deel van de middag, ongeveer van 16.00 tot 18.00 uur"
                        ],
                        "tags": [
                            "tijdrekening",
                            "in Nederland"
                        ],
                        "examples": [
                            {
                                "example_id": "be8c237f-0d21-4afb-a6e0-88da7ead8606",
                                "sense_id": "1f44bd00-c22c-3db2-9fb5-20eb9c1de194",
                                "text": "„Het was een bewolkte, zwoele namiddag; de matrozen hingen lui op het dek rond of staarden wezenloos over het loodkleurige water. Queequeg en ik waren rustig een zogenaamde zwaardmat aan het weven als extra sjorring voor onze sloep. Om ons heen was alles zo stil en gedempt en toch ook vervuld van wat ging komen en in de lucht hing zo’n mijmerachtige betovering dat die zwijgende mannen stuk voor stuk in hun eigen onzichtbare ik leken op te gaan."
                            }
                        ]
                    },
                    {
                        "sense_id": "94a1d708-6483-3812-bb84-4bd4def77034",
                        "entry_id": "db0ea4d1-630c-32ee-8d2d-a3baca6dbec3",
                        "glosses": [
                            "tijd na het middaguur, 12.00 uur"
                        ],
                        "tags": [
                            "tijdrekening"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5709ebc1-d18a-4e2a-a3b0-4127d327fdc4",
                        "source_entry_id": "db0ea4d1-630c-32ee-8d2d-a3baca6dbec3",
                        "source_sense_id": "1f44bd00-c22c-3db2-9fb5-20eb9c1de194",
                        "source_sense_description": "tijd aan het einde van de middag",
                        "target_lang_word": "Nachmittag",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nachmittag",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "60db1462-a603-3b2e-ad62-a5022a02a3c7",
                                        "entry_id": "60e21b15-3c35-3db0-b274-1009be644181",
                                        "glosses": [
                                            "die Zeit vom Mittag bis zum Abend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74847c6c-6422-4a99-b9fc-63e3060e60e3",
                                                "sense_id": "60db1462-a603-3b2e-ad62-a5022a02a3c7",
                                                "text": "Unser Flug startet am Nachmittag."
                                            },
                                            {
                                                "example_id": "d93fba9e-5db4-444a-96e2-954167d7b7f9",
                                                "sense_id": "60db1462-a603-3b2e-ad62-a5022a02a3c7",
                                                "text": "„Endlich, am späten Nachmittag, kamen Flugzeuge, einige Spitfire und Mustangs, die aus Richtung Flensburg oder Schleswig hereindrehten, um im Tiefflug über uns hinwegzuflitzen und auf die Nordsee hinaus zu verschwinden.“"
                                            },
                                            {
                                                "example_id": "568e0c89-a4f1-4573-a029-b316d870e033",
                                                "sense_id": "60db1462-a603-3b2e-ad62-a5022a02a3c7",
                                                "text": "„Wir landeten am späten Nachmittag in einer kleinen sandigen Bucht.“"
                                            },
                                            {
                                                "example_id": "891a48c0-c6be-41e9-aaca-fa00a80baa80",
                                                "sense_id": "60db1462-a603-3b2e-ad62-a5022a02a3c7",
                                                "text": "„Es ging dann schon auf den Nachmittag zu, und ich hatte nun auch etwas Hunger.“"
                                            },
                                            {
                                                "example_id": "1bb69aa5-972d-49d0-8431-556a123c7e2f",
                                                "sense_id": "60db1462-a603-3b2e-ad62-a5022a02a3c7",
                                                "text": "„Eines Nachmittags saß ich bei offenem Fenster in meiner Bücherstube.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "59d5b319-d2eb-4628-bff8-f7200a3472c9",
                        "source_entry_id": "db0ea4d1-630c-32ee-8d2d-a3baca6dbec3",
                        "source_sense_id": "1f44bd00-c22c-3db2-9fb5-20eb9c1de194",
                        "source_sense_description": "tijd aan het einde van de middag",
                        "target_lang_word": "afternoon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "afternoon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "19f64ca6-090b-34d5-92bd-26607a7dc2fc",
                                        "entry_id": "46adf88c-efa5-3198-8cf1-d4fa850036e9",
                                        "glosses": [
                                            "The part of the day from noon or lunchtime until sunset, evening, or suppertime or 6pm."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "972b1f26-3f33-494a-b108-71d7157ac73a",
                                                "sense_id": "19f64ca6-090b-34d5-92bd-26607a7dc2fc",
                                                "text": "Theſe men ſerue God in the forenoone, and the diuell in the after noone;"
                                            },
                                            {
                                                "example_id": "cc14f815-e88b-466e-afd3-d6ab3eaae020",
                                                "sense_id": "19f64ca6-090b-34d5-92bd-26607a7dc2fc",
                                                "text": "The Celebrity, by arts unknown, induced Mrs. Judge Short and two other ladies to call at Mohair on a certain afternoon when Mr. Cooke was trying a trotter on the track. The three returned wondering and charmed with Mrs. Cooke; they were sure she had had no hand in the furnishing of that atrocious house."
                                            },
                                            {
                                                "example_id": "a2488def-90cf-4754-ac10-48480cc0721e",
                                                "sense_id": "19f64ca6-090b-34d5-92bd-26607a7dc2fc",
                                                "text": "If the afternoon was fine they strolled together in the park, very slowly, and with pauses to draw breath wherever the ground sloped upward. The slightest effort made the patient cough. He would stand leaning on his stick and holding a hand to his side, and when the paroxysm had passed it left him shaking."
                                            },
                                            {
                                                "example_id": "093b5bc8-e1af-4a97-a21f-9ecc324e9747",
                                                "sense_id": "19f64ca6-090b-34d5-92bd-26607a7dc2fc",
                                                "text": "Here the stripped panelling was warmly gold and the pictures, mostly of the English school, were mellow and gentle in the afternoon light."
                                            },
                                            {
                                                "example_id": "d7d60b46-8549-4985-a822-92c8123f3888",
                                                "sense_id": "19f64ca6-090b-34d5-92bd-26607a7dc2fc",
                                                "text": "And I love to live so pleasantly/Live this life of luxury/Lazing on a sunny afternoon/In the summertime"
                                            },
                                            {
                                                "example_id": "30a859b9-8e47-4ce4-a0c2-5cad16d19790",
                                                "sense_id": "19f64ca6-090b-34d5-92bd-26607a7dc2fc",
                                                "text": "For several days, Mr. Sammler returning on the customary bus late afternoons from the Forty-second Street Library had been watching a pickpocket at work […] Mr. Sammler if he had not been a tall straphanger would not with his one good eye have seen these things happening."
                                            },
                                            {
                                                "example_id": "5843193a-959a-4655-8c91-1347e21d8246",
                                                "sense_id": "19f64ca6-090b-34d5-92bd-26607a7dc2fc",
                                                "text": "We all sat in stuffy classrooms and had men in tweedy sportscoats ruin our afternoons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b5795cd-6a76-3bf3-a324-52a9829f00f6",
                                        "entry_id": "46adf88c-efa5-3198-8cf1-d4fa850036e9",
                                        "glosses": [
                                            "The later part of anything, often with implications of decline."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7bb11e8e-e652-4a06-8b29-f93cec377159",
                                                "sense_id": "3b5795cd-6a76-3bf3-a324-52a9829f00f6",
                                                "text": "Buck.[…]Theſe both put by a poore petitioner\nA care-crazd mother of a many children,\nA beauty-waining and diſtreſſed widow,\nEuen in the afternoone of her beſt daies\nMade priſe and purchaſe of his luſtfull eye,\nSeduc t the pitch and height of al his thoughts,\nTo baſe declenſion and loathd bigamie,\nBy her in his vnlawfull bed he got."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ced42529-bc1a-344c-bcd5-de934d7a2159",
                                        "entry_id": "46adf88c-efa5-3198-8cf1-d4fa850036e9",
                                        "glosses": [
                                            "A party or social event held in the afternoon."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "afternoon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3f80c621-e974-38c6-92d1-a46df1df58f1",
                                        "entry_id": "d6a9ce3f-ec65-3557-b242-5a4bd49becc9",
                                        "glosses": [
                                            "In the afternoon."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "not-comparable",
                                            "singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "070c071e-6759-4aab-9a72-cb30d3f913ab",
                                                "sense_id": "3f80c621-e974-38c6-92d1-a46df1df58f1",
                                                "text": "I stayd at home till noone, and recᵈ of Crowders for 3 loods of shilling 2l. 8s.; and afternoone I went with my wife to Wakefeild, where by yᵉ way I spent at Toppitt 8d., and wee lay at Jackson’s all night."
                                            },
                                            {
                                                "example_id": "84c208b6-2b55-477a-857d-91ea6842b0d4",
                                                "sense_id": "3f80c621-e974-38c6-92d1-a46df1df58f1",
                                                "text": "Afterwards […] they adjourned the court till two in the afternoon, and so went to prayers. Afternoon they called over the names of the rest of the college, demys, chaplains, &c."
                                            },
                                            {
                                                "example_id": "d885a899-2603-4ff6-bdc6-1ef84d476566",
                                                "sense_id": "3f80c621-e974-38c6-92d1-a46df1df58f1",
                                                "text": "Afternoon we came to Fuchen, or Xucheu, as others call it, where we were forced to stay to have the boat search’d by the Mandarine or customer."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "afternoon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1dcf4b17-288f-3a86-b8d5-112b4223f193",
                                        "entry_id": "7514c459-f49c-33be-9e58-fdf7408c01da",
                                        "glosses": [
                                            "Ellipsis of good afternoon."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d9e90942-8c94-4c6f-a74f-c465625dbb6b",
                        "source_entry_id": "db0ea4d1-630c-32ee-8d2d-a3baca6dbec3",
                        "source_sense_id": "1f44bd00-c22c-3db2-9fb5-20eb9c1de194",
                        "source_sense_description": "tijd aan het einde van de middag",
                        "target_lang_word": "après-midi",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "après-midi",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "da366f37-4c57-348e-b3cb-a91eaa6d8fc5",
                                        "entry_id": "397b8d62-f27e-3550-953e-89f63d787fd6",
                                        "glosses": [
                                            "Partie de la journée qui s’écoule entre le midi et le coucher de soleil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fce1617-fcd9-4dfb-bf99-a6b7fb4e20ac",
                                                "sense_id": "da366f37-4c57-348e-b3cb-a91eaa6d8fc5",
                                                "text": "En effet ils furent rois toute une matinée où les tentures carminées se relevèrent sur les maisons, et toute l’après-midi, où ils s’avancèrent du côté des jardins de palmes."
                                            },
                                            {
                                                "example_id": "c852666d-a29a-4508-9b8e-930513c181e5",
                                                "sense_id": "da366f37-4c57-348e-b3cb-a91eaa6d8fc5",
                                                "text": "Le lendemain, l’après-midi fut encore une fois ensoleillé et brûlant. Je me rappelai des après-midi pareils, il y avait bien des années […]"
                                            },
                                            {
                                                "example_id": "6eea85ac-6c8b-4590-bd43-e792bf406b90",
                                                "sense_id": "da366f37-4c57-348e-b3cb-a91eaa6d8fc5",
                                                "text": "[…] il fut convenu qu’ils feraient à quatre une joyeuse partie de campagne, et qu’après un pique-nique on passerait indolemment l’après-midi sous les arbres et dans les fougères des bois situés entre Ashford et Maidstone."
                                            },
                                            {
                                                "example_id": "577f6789-b8f5-4d57-94f0-5b923e0b2b9f",
                                                "sense_id": "da366f37-4c57-348e-b3cb-a91eaa6d8fc5",
                                                "text": "Nombre de nos après-midi s’écoulaient dans les cinémas."
                                            },
                                            {
                                                "example_id": "6cd88881-7364-4846-bacd-79aa7db53677",
                                                "sense_id": "da366f37-4c57-348e-b3cb-a91eaa6d8fc5",
                                                "text": "Après un gigot flageolets avalé chez belle-maman, qu’il appelle « ma mère », monsieur met à profit l’après-midi dominical pour s’immerger dans la comptabilité familiale."
                                            },
                                            {
                                                "example_id": "188854a0-a344-4d13-b51f-c6c0c75456a8",
                                                "sense_id": "da366f37-4c57-348e-b3cb-a91eaa6d8fc5",
                                                "text": "Sur le trottoir, devant l’école primaire, tous les après-midi, un groupe de six à huit femmes installait un stand de petites tables bancales."
                                            },
                                            {
                                                "example_id": "769ead0a-bac7-42f5-88cd-a9e1fcba90a2",
                                                "sense_id": "da366f37-4c57-348e-b3cb-a91eaa6d8fc5",
                                                "text": "Elle téléphona donc à son ex-secrétaire et fit du shopping pendant tout un après-midi avec elle. Ce fut son premier après-midi agréable depuis deux ans et demi !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8733f514-e43c-32ce-82ad-fa14bace7f8b",
                                        "entry_id": "397b8d62-f27e-3550-953e-89f63d787fd6",
                                        "glosses": [
                                            "Les heures de midi à 17 heures, avec le cadran de 12 heures sont dites de l’après-midi, celles de 18 heures à minuit étant dites du soir, pour éviter l’ambiguïté avec celles du matin."
                                        ],
                                        "tags": [
                                            "especially"
