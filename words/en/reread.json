{
    "word_family": [
        "reader",
        "reading",
        "unread"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c5278d8b-0db8-3b88-93f1-a07c63991609",
                    "sense_definition": "To read a text again from the beginning or another time.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "read_again",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I often <w>reread</w> my favorite childhood stories when I feel nostalgic.",
                            "target_lang_translations": {
                                "pl": "Często <w>czytam ponownie</w> moje ulubione bajki z dzieciństwa, kiedy czuję nostalgię."
                            }
                        },
                        {
                            "text": "You should <w>reread</w> the instructions carefully before starting the exam.",
                            "target_lang_translations": {
                                "pl": "Powinieneś uważnie <w>przeczytać jeszcze raz</w> instrukcje przed rozpoczęciem egzaminu."
                            }
                        }
                    ],
                    "common_phrases": [
                        "reread the contract",
                        "reread a book",
                        "reread the letter"
                    ],
                    "target_lang_definitions": {
                        "pl": "Czytać tekst ponownie, od początku lub jeszcze raz."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "przeczytać ponownie",
                                "target_lang_sense_clarification": "dokonać ponownego czytania"
                            },
                            {
                                "target_lang_word": "czytać ponownie",
                                "target_lang_sense_clarification": "czynność czytania kolejny raz"
                            },
                            {
                                "target_lang_word": "przeczytać jeszcze raz",
                                "target_lang_sense_clarification": "przeczytać powtórnie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "60ab863b-8d66-33fa-b5b3-414777da1ca7",
                    "sense_definition": "To interpret or analyze a work, event, or concept in a new or different way.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "reinterpretation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Modern scholars often <w>reread</w> historical documents through a contemporary political lens.",
                            "target_lang_translations": {
                                "pl": "Współcześni badacze często <w>odczytują na nowo</w> dokumenty historyczne przez pryzmat współczesnej polityki."
                            }
                        },
                        {
                            "text": "Her latest critical essay aims to <w>reread</w> the classic novel as an environmental allegory.",
                            "target_lang_translations": {
                                "pl": "Jej najnowszy esej krytyczny ma na celu <w>odczytanie na nowo</w> tej klasycznej powieści jako alegorii ekologicznej."
                            }
                        }
                    ],
                    "common_phrases": [
                        "reread through a lens",
                        "reread as an allegory"
                    ],
                    "target_lang_definitions": {
                        "pl": "Interpretować lub analizować dzieło, wydarzenie bądź pojęcie w nowy lub odmienny sposób."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "odczytać na nowo",
                                "target_lang_sense_clarification": "zreinterpretować, spojrzeć w nowy sposób"
                            },
                            {
                                "target_lang_word": "reinterpretować",
                                "target_lang_sense_clarification": "dokonać nowej interpretacji"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7518d530-4c88-3f70-a262-c3ac0bfd89f4",
                    "sense_definition": "An instance or act of reading something again.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "read_again",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Upon a second <w>reread</w>, I noticed several details that I had missed before.",
                            "target_lang_translations": {
                                "pl": "Przy <w>powtórnej lekturze</w> zauważyłem kilka szczegółów, które wcześniej mi umknęły."
                            }
                        },
                        {
                            "text": "This classic novel definitely deserves a thorough <w>reread</w>.",
                            "target_lang_translations": {
                                "pl": "Ta klasyczna powieść zdecydowanie zasługuje na dokładne <w>ponowne przeczytanie</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "rereading"
                    ],
                    "common_phrases": [
                        "deserves a reread",
                        "upon a reread"
                    ],
                    "target_lang_definitions": {
                        "pl": "Akt lub przypadek ponownego przeczytania czegoś."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "ponowne przeczytanie",
                                "target_lang_sense_clarification": "akt czytania jeszcze raz"
                            },
                            {
                                "target_lang_word": "powtórna lektura",
                                "target_lang_sense_clarification": "kolejne czytanie tekstu"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}