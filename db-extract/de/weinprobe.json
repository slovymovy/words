                "senses": [
                    {
                        "sense_id": "29d4925b-9d54-3cc0-b49b-46a5f36100c7",
                        "entry_id": "41aafc9e-55b2-35ef-a291-6b467596806a",
                        "glosses": [
                            "Möglichkeit der Verkostung für eine kleine Runde von und für Weinspezialisten, Sommeliers oder Liebhaber, um die Qualität zumeist mehrerer Weine zu beurteilen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1692fa60-24a9-4b0e-8a91-89459ade70ef",
                                "sense_id": "29d4925b-9d54-3cc0-b49b-46a5f36100c7",
                                "text": "Viele Winzer bieten ihren Kunden Weinproben an."
                            },
                            {
                                "example_id": "f5f2a872-96b0-4616-98c9-4d0a194d990d",
                                "sense_id": "29d4925b-9d54-3cc0-b49b-46a5f36100c7",
                                "text": "„Im Herbst befindet sich das ganze Dorf auf einer permanenten Weinprobe.“"
                            },
                            {
                                "example_id": "9e75745d-2ec2-4319-9767-c97c849c9ecb",
                                "sense_id": "29d4925b-9d54-3cc0-b49b-46a5f36100c7",
                                "text": "„Weil wir zu Abend gegessen und gleichzeitig eine Weinprobe gemacht haben, haben wir viel länger für das Abendessen gebraucht als sonst.“"
                            },
                            {
                                "example_id": "ece5ed89-841c-4152-a9d3-20a7f34b5ac2",
                                "sense_id": "29d4925b-9d54-3cc0-b49b-46a5f36100c7",
                                "text": "„Immerhin war er einverstanden, dass wir zu einer Weinprobe anhielten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
