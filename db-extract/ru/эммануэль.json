                "translations": [
                    {
                        "translation_id": "9a24633f-d988-4877-9337-477b8cb7db28",
                        "source_entry_id": "69395bd9-c7f1-3d51-9577-19496a14a237",
                        "source_sense_id": "1aaeee62-1a7f-3267-8e1b-e51afbc58b1d",
                        "target_lang_word": "Emmanuel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Emmanuel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1998f248-d700-3a5d-88bf-985a55854805",
                                        "entry_id": "c3edc0fb-4a9f-300f-b688-c20b3c0f8367",
                                        "glosses": [
                                            "Immanuel (Biblical figure whose birth is foretold)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8ed20e4-7b04-4fe2-8f0d-6f5eeca1acaa",
                                                "sense_id": "1998f248-d700-3a5d-88bf-985a55854805",
                                                "text": "Behold, a virgin shall be with child, and shall bring forth a son, and they shall call his name Emmanuel, which being interpreted is, God with us."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff23b8e6-1150-3bbf-a770-ab3a36b44eda",
                                        "entry_id": "c3edc0fb-4a9f-300f-b688-c20b3c0f8367",
                                        "glosses": [
                                            "Immanuel (Biblical figure whose birth is foretold).",
                                            "Immanuel (this figure, regarded by Christians as the Christ)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "efc5092b-0ee7-35eb-be3f-06f3a623c1e9",
                                        "entry_id": "c3edc0fb-4a9f-300f-b688-c20b3c0f8367",
                                        "glosses": [
                                            "A male given name from Hebrew of Biblical origin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6963b16-29c1-41d4-83aa-6ebd6c5db60e",
                                                "sense_id": "efc5092b-0ee7-35eb-be3f-06f3a623c1e9",
                                                "text": "Cade. What is thy name? / Clerk. Emmanuel. / Dick. They use to write it on the top of letters. 'Twill go hard with you."
                                            },
                                            {
                                                "example_id": "e3e59cd8-81bd-4696-842c-ee754fcad321",
                                                "sense_id": "efc5092b-0ee7-35eb-be3f-06f3a623c1e9",
                                                "text": "Some call their sons Emmanuel : this is too bold. The name is proper to Christ, therefore not to be communicated to any creature."
                                            },
                                            {
                                                "example_id": "8e07cd26-847e-4dc3-82eb-b4de2441ec8f",
                                                "sense_id": "efc5092b-0ee7-35eb-be3f-06f3a623c1e9",
                                                "text": "Whether a Hidalgo candidacy can galvanize the left and throw open an election in which Emmanuel Macron, the centrist president, and Marine Le Pen, the rightist candidate, remain favorites is unclear."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b0d9e71-43cc-3267-9db4-eb5572b104f3",
                                        "entry_id": "c3edc0fb-4a9f-300f-b688-c20b3c0f8367",
                                        "glosses": [
                                            "A surname."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "de435c4a-464c-3a68-a396-8429692a41bd",
                                        "entry_id": "c3edc0fb-4a9f-300f-b688-c20b3c0f8367",
                                        "glosses": [
                                            "Ellipsis of Emmanuel College, Cambridge."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis",
                                            "informal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f5fff898-fb11-4e93-a786-5cbfc80c2478",
                        "source_entry_id": "69395bd9-c7f1-3d51-9577-19496a14a237",
                        "source_sense_id": "1aaeee62-1a7f-3267-8e1b-e51afbc58b1d",
