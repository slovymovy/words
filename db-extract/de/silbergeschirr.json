                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0879fd5e-27a5-4109-bcf3-24464bd95e19",
                                "sense_id": "e6959dcf-0494-3b52-8e73-bfafb0c07ca2",
                                "text": "Mechthild: „Wir haben nur etwas Blech um das Silbergeschirr gemacht, damit es nicht beschädigt wird!“"
                            },
                            {
                                "example_id": "acd8981c-daa9-49e4-ba76-cbfabc9c854d",
                                "sense_id": "e6959dcf-0494-3b52-8e73-bfafb0c07ca2",
                                "text": "„Die Tafel war mit Silbergeschirr gedeckt, und seine Diener trugen Livree.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
