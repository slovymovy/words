                "senses": [
                    {
                        "sense_id": "9e90632d-b1ce-3c11-bdac-1766c67add04",
                        "entry_id": "431e23be-3b14-355a-99dd-84af149738f4",
                        "glosses": [
                            "жарг., пренебр. милиционер, полицейский или любой другой сотрудник правоохранительных органов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab4e231c-5abc-46c9-b720-f8ee2fdc6d61",
                                "sense_id": "9e90632d-b1ce-3c11-bdac-1766c67add04",
                                "text": "— Ты ловкий, в натуре, мусорок, тебя один Фрощ чуял."
                            },
                            {
                                "example_id": "be13daec-a102-4795-ad8b-98a05dee24fb",
                                "sense_id": "9e90632d-b1ce-3c11-bdac-1766c67add04",
                                "text": "[Павел (Вячеслав Разбегаев), муж, 41, 1965] Похоже / нам предстоит беседа с населением микросхемы. Отойди ко мне за спину. [Талиб1 (Антон Черняков), муж] Ну что / приехал / мусорок / да? [Талиб2 (Денис Салаутин), муж, 38, 1968] Да / засел прочно. [Талиб1 (Антон Черняков), муж] А прям тянет в землю мусорка́-то / да?"
                            }
                        ]
                    }
