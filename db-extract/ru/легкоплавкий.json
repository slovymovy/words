                "senses": [
                    {
                        "sense_id": "ecaebd00-3e49-3a13-b814-5e6e6f0ce894",
                        "entry_id": "71287e68-c05e-3ddd-a629-1c87fa977a53",
                        "glosses": [
                            "(о материалах) плавящийся при сравнительно невысоких температурах"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7aa899b1-1baa-4121-9e32-56c582058ad4",
                                "sense_id": "ecaebd00-3e49-3a13-b814-5e6e6f0ce894",
                                "text": "Петрохимический сдвиг трахитоидов идет в целом в сторону развития более легкоплавких образований."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "994277a1-4eb2-4164-8613-4041c709b4fb",
                        "source_entry_id": "71287e68-c05e-3ddd-a629-1c87fa977a53",
                        "source_sense_id": "ecaebd00-3e49-3a13-b814-5e6e6f0ce894",
                        "target_lang_word": "fusible",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fusible",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "92fdb32f-9c54-317e-a055-618af4794780",
                                        "entry_id": "f6ad8a1b-7883-35ab-9f5f-d7fac01ba586",
                                        "glosses": [
                                            "Able to be fused or melted."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db2ad7d4-2af5-441d-a3a1-e6f147f71ff7",
                                                "sense_id": "92fdb32f-9c54-317e-a055-618af4794780",
                                                "text": "Although a fusible plug is provided in the firebox crown of every locomotive, so that by melting if the inner firebox crown becomes uncovered, and thereby releasing steam at full pressure into the firebox, the fire may be extinguished and the crew given an unmistakable warning of the danger, there is no absolute guarantee that the plug will melt."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fusible",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "79bb027f-c613-3f48-8bde-43710043b2af",
                                        "entry_id": "90bc755f-67db-37fb-a943-166a5e055eee",
                                        "glosses": [
                                            "Any substance that can be fused or melted."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c8d8101-0339-4f07-8e71-94105027b79c",
                                                "sense_id": "79bb027f-c613-3f48-8bde-43710043b2af",
                                                "text": "Try any fusibles you have on hand, making sure that they aren't too stiff for the project you have in mind."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
