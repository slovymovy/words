        "fr-extract.jsonl": [
            {
                "entry_id": "9bd25e7d-5863-330e-9dbf-caaac66eac01",
                "word": "appentis",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7c4b0fb6-c679-3600-b70c-e36ff92b9b73",
                        "entry_id": "9bd25e7d-5863-330e-9dbf-caaac66eac01",
                        "glosses": [
                            "Demi-comble, toit en manière d’auvent à un seul égout, appuyé contre une muraille et soutenu en avant par des piliers ou des poteaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5a60efc-50ba-4c48-97f7-2fd812e2e42b",
                                "sense_id": "7c4b0fb6-c679-3600-b70c-e36ff92b9b73",
                                "text": "L’assaillant trouvait un premier obstacle formé d’une barrière de bois couverte d’un appentis."
                            },
                            {
                                "example_id": "f8bcb222-5590-4286-83d3-c7f8554cb22d",
                                "sense_id": "7c4b0fb6-c679-3600-b70c-e36ff92b9b73",
                                "text": "Le réduit est en appentis : on ne peut se tenir debout qu’à l’entrée."
                            },
                            {
                                "example_id": "8593e5ce-b0e6-4025-8222-4585b8292c69",
                                "sense_id": "7c4b0fb6-c679-3600-b70c-e36ff92b9b73",
                                "text": "Une petite pluie froide faisait furtivement briller la couverture d’un appentis et tinter sur le zinc, à de rares intervalles, de pesantes gouttes d’eau qui s’échappaient d’une chanlatte percée."
                            },
                            {
                                "example_id": "7a564afd-d8f8-4932-810d-a2d7b1bf1352",
                                "sense_id": "7c4b0fb6-c679-3600-b70c-e36ff92b9b73",
                                "text": "Pendant ce temps là, dans toute la région des Fens, la police frappait aux portes des maisons, fouillait les greniers et les appentis."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4e560db1-62aa-4dd3-b47b-d8f3a1096b4b",
                        "source_entry_id": "9bd25e7d-5863-330e-9dbf-caaac66eac01",
                        "source_sense_id": "7c4b0fb6-c679-3600-b70c-e36ff92b9b73",
                        "target_lang_word": "lean-to",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lean-to",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "98eed550-4a11-3622-bfe8-9baaad77f43a",
                                        "entry_id": "b1f840ac-ee2c-35c6-9c5d-1e8aad2de5e0",
                                        "glosses": [
                                            "A shelter with a sloped roof; also a building with a similar construction attached to the side of a building as an extension."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c480b213-f895-43dc-b64d-6ac3f0f11752",
                                                "sense_id": "98eed550-4a11-3622-bfe8-9baaad77f43a",
                                                "text": "Now we was in the lean-to, and heard trampings close by outside. So we crept to the door, and Tom stopped us there and put his eye to the crack, but couldn't make out nothing, it was so dark"
                                            },
                                            {
                                                "example_id": "7e46abbb-9e96-43bd-a429-cd39ef9baa65",
                                                "sense_id": "98eed550-4a11-3622-bfe8-9baaad77f43a",
                                                "text": "His shirt, an ordinary Crimean flannel, was exquisitely clean, and outside the \"lean-to\" another was drying on a bush."
                                            },
                                            {
                                                "example_id": "6ee0fd0e-1111-4ae0-8eb5-43ab3bb5fece",
                                                "sense_id": "98eed550-4a11-3622-bfe8-9baaad77f43a",
                                                "text": "Philander went into the next room, which was just a lean-to hitched on to the end of the shanty, and came back with a salt mackerel that dripped brine like a rainstorm. Then he put the coffee pot on the stove and rummaged out a loaf of dry bread and some hardtack."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b5cf2df1-d9ac-41f1-a8d1-221e8cb890be",
