                    {
                        "translation_id": "08e6615f-f1b0-4046-aea4-8632cafbc458",
                        "source_entry_id": "70299856-d267-352f-a627-c8aa4a569a37",
                        "target_lang_word": "主人公",
                        "target_lang_code": "ja",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "主人公",
                                "target_lang_code": "ja",
                                "target_senses": [
                                    {
                                        "sense_id": "72d49a96-b8a4-3683-afcd-68e2592ed825",
                                        "entry_id": "46b1fe43-141a-34b8-9c4c-89fa4c780207",
                                        "glosses": [
                                            "映画・演劇・小説などの中心人物。"
                                        ],
                                        "tags": [
                                            "フィクション"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85be8b10-c446-4b0c-95a4-a8c36067adce",
                                                "sense_id": "72d49a96-b8a4-3683-afcd-68e2592ed825",
                                                "text": "昔「羅生門」と云ふ小説を書いた時、主人公の下人の頬には、大きい面皰のある由を書いた。"
                                            },
                                            {
                                                "example_id": "32dfdcb7-b4d2-494d-801c-1c4cf2079cf4",
                                                "sense_id": "72d49a96-b8a4-3683-afcd-68e2592ed825",
                                                "text": "基本法として、国民、消費者こそが主人公という根本的な哲学を欠く本法案では、国民が望む高度情報通信ネットワーク社会の形成とはならないということを指摘して、私の反対討論を終わります。"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aaabc8e0-8885-3490-ba42-36b185b6bb32",
                                        "entry_id": "46b1fe43-141a-34b8-9c4c-89fa4c780207",
                                        "glosses": [
                                            "「主人」の敬称。"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1aa6678-e550-497d-9893-685b8256cf5e",
                                                "sense_id": "aaabc8e0-8885-3490-ba42-36b185b6bb32",
                                                "text": "末輩刑事とて、当の大使館の主人公の顔を知らぬ筈はない。"
                                            },
                                            {
                                                "example_id": "c7ea1dde-5869-4ea1-8976-822c17e4e4bc",
                                                "sense_id": "aaabc8e0-8885-3490-ba42-36b185b6bb32",
