                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf8bb8e9-8704-4429-8050-96936de57a8c",
                                                "sense_id": "fbcd2872-8f84-3228-abb4-cec236503bc1",
                                                "text": "As friends, we go way back: we met in primary school."
                                            }
                                        ]
