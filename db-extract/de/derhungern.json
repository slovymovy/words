                ],
                "senses": [
                    {
                        "sense_id": "2456db6f-796b-30f9-aa78-aed24241efaf",
                        "entry_id": "42760126-14c8-3574-9363-4053363d1e9c",
                        "glosses": [
                            "verhungern"
                        ],
                        "tags": [
                            "Bavarian"
                        ],
                        "examples": [
                            {
                                "example_id": "45d5b2c9-01fd-4e17-8bac-ee33bde6cd70",
                                "sense_id": "2456db6f-796b-30f9-aa78-aed24241efaf",
                                "text": "„Und Appetit, der wär' doch dau, su möißt' s' jo öiz derhungern nau.“"
                            },
                            {
                                "example_id": "2eafa8db-8e9a-46e3-8a4d-7815f6d6dd9a",
                                "sense_id": "2456db6f-796b-30f9-aa78-aed24241efaf",
                                "text": "„Seinö Kinda lossta dahungan und dafrian“"
                            },
                            {
                                "example_id": "1cae698b-0a47-4365-9e5a-caee37ed844b",
                                "sense_id": "2456db6f-796b-30f9-aa78-aed24241efaf",
                                "text": "„Na hättst dei Muatta aa ned dahoam dahungern und dafriern lassen solln!“"
                            },
                            {
                                "example_id": "24c93527-8201-42a2-8c3e-d398b124f596",
                                "sense_id": "2456db6f-796b-30f9-aa78-aed24241efaf",
                                "text": "„Dahoam in Afrika dahungern d'Leit und Sie essn a Suppn um 9 Euro.“"
                            },
                            {
                                "example_id": "8811cfee-1052-46ec-a697-cb460bb0f658",
                                "sense_id": "2456db6f-796b-30f9-aa78-aed24241efaf",
                                "text": "„Die älteste Schwester, die Mirl, war beim Pfarrer in Mariapfarr Dirn und hat mir auch manchmal Brot zugesteckt: »daß der Bub nicht ganz derhungert!«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a61399ab-2df5-4be7-bbc8-ef0c180b6ce1",
                        "source_entry_id": "42760126-14c8-3574-9363-4053363d1e9c",
                        "source_sense_id": "2456db6f-796b-30f9-aa78-aed24241efaf",
                        "source_sense_description": "bairisch: verhungern",
                        "target_lang_word": "verhungern",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verhungern",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2c25c0ce-633a-3b56-bcf3-6ef401ae4b68",
                                        "entry_id": "4b10b97b-7929-35ca-bcde-9761468d1039",
                                        "glosses": [
                                            "aufgrund von Nahrungsmangel sterben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba87f4d2-e18c-4c18-8fd1-3f44ad8d4bf9",
                                                "sense_id": "2c25c0ce-633a-3b56-bcf3-6ef401ae4b68",
                                                "text": "In der belagerten syrischen Stadt Madaja verhungern weiterhin Menschen."
                                            },
                                            {
                                                "example_id": "a52f8bf4-6b43-40b0-bff2-59d113c95db7",
                                                "sense_id": "2c25c0ce-633a-3b56-bcf3-6ef401ae4b68",
                                                "text": "Ein Beobachtungsteam habe ihm am Morgen aus der Stadt Mundri berichtet, dort würden die Menschen schon verhungern, berichtete der Leiter der internationalen Beobachtungsmission (JMEC), Festus Mogae, am Dienstag in Juba."
                                            },
                                            {
                                                "example_id": "e30aaf32-7033-4fb0-aded-aea492f37ed5",
                                                "sense_id": "2c25c0ce-633a-3b56-bcf3-6ef401ae4b68",
                                                "text": "Alle fünf Sekunden verhungert ein Kind unter zehn Jahren - in einer Welt, die einen irrwitzigen Überfluss produziert und eigentlich viel mehr Menschen ernähren könnte."
                                            },
                                            {
                                                "example_id": "473a30f8-8974-49c6-9619-16171d72ec70",
                                                "sense_id": "2c25c0ce-633a-3b56-bcf3-6ef401ae4b68",
                                                "text": "Vor den Augen ihres Mannes und ihrer Tochter soll die Frau über Wochen hinweg verhungert und verdurstet sein."
                                            },
                                            {
                                                "example_id": "93a9b5ec-98a7-4396-a6d7-523a5b6ef1b4",
                                                "sense_id": "2c25c0ce-633a-3b56-bcf3-6ef401ae4b68",
                                                "text": "Weil er nach dem Essen nicht \"Amen\" sagen wollte, hat eine Sekte im US-Bundesstaat Maryland einen etwa 15 Monate alten Buben verhungern lassen."
                                            },
                                            {
                                                "example_id": "cce3e7a7-b7e7-4ff9-b814-fec7ff27ba7b",
                                                "sense_id": "2c25c0ce-633a-3b56-bcf3-6ef401ae4b68",
                                                "text": "„An der Universität Münster sind sie dem Tod [der Hummeln] auf die Schliche gekommen. Über Jahre sammelten sie knapp 11.000 verendete Tiere. Die Hummeln waren weder krank noch überaltert: Sie waren schlichtweg verhungert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
