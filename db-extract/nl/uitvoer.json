                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "8b538e3c-9755-4a97-b2d8-30a83d3ae03d",
                                "sense_id": "1d2738fe-dbbe-3767-bf63-348de8575620",
                                "text": "De uitvoer van het programma was niet wat ik verwachtte.",
                                "translation": "The output of the program was not what I expected.",
                                "english": "The output of the program was not what I expected."
                            },
                            {
                                "example_id": "1ee42e09-9d6d-4670-b170-8c92c193f554",
                                "sense_id": "1d2738fe-dbbe-3767-bf63-348de8575620",
                                "text": "Kun je de uitvoer van dat script controleren?",
                                "translation": "Can you check the output of that script?",
                                "english": "Can you check the output of that script?"
                            },
                            {
                                "example_id": "f0a63552-e233-4d2d-91d0-c40e1c8d5728",
                                "sense_id": "1d2738fe-dbbe-3767-bf63-348de8575620",
                                "text": "Deze code heeft een onverwachte uitvoer geproduceerd.",
                                "translation": "This code produced an unexpected output.",
                                "english": "This code produced an unexpected output."
                            }
                        ]
                    },
                    {
                        "sense_id": "22e82aea-9406-3091-844f-195d0e395011",
                        "entry_id": "ed97daa8-9a37-3252-a94e-29e552b7abea",
                        "glosses": [
