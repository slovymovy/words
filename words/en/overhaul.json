{
    "word_family": [
        "overhauler",
        "overhauling"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "189fae26-de5b-3ad1-a26f-05cb98305d0a",
                    "sense_definition": "To modernize, repair, renovate, or revise completely.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "renovation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mechanic will <w>overhaul</w> the engine to ensure it runs like new again.",
                            "target_lang_translations": {
                                "ru": "Механик <w>проведет капитальный ремонт</w> двигателя, чтобы он снова работал как новый."
                            }
                        },
                        {
                            "text": "The government plans to <w>overhaul</w> the education system to improve student outcomes.",
                            "target_lang_translations": {
                                "ru": "Правительство планирует <w>коренным образом пересмотреть</w> систему образования, чтобы улучшить результаты учащихся."
                            }
                        }
                    ],
                    "synonyms": [
                        "renovate",
                        "remodel",
                        "revamp",
                        "reconstruct"
                    ],
                    "common_phrases": [
                        "overhaul the system",
                        "completely overhaul",
                        "overhaul the engine"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полностью модернизировать, ремонтировать, обновлять или пересматривать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "капитально ремонтировать",
                                "target_lang_sense_clarification": "о технике или зданиях"
                            },
                            {
                                "target_lang_word": "пересматривать",
                                "target_lang_sense_clarification": "о системе или правилах"
                            },
                            {
                                "target_lang_word": "перебирать",
                                "target_lang_sense_clarification": "разбирать и собирать заново для ремонта"
                            },
                            {
                                "target_lang_word": "реорганизовать",
                                "target_lang_sense_clarification": "структурно изменять"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b322c879-f1ef-382f-9b2c-b52c98e750e5",
                    "sense_definition": "To pass, overtake, or travel past.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The faster ship began to <w>overhaul</w> the smaller vessel as they neared the harbor.",
                            "target_lang_translations": {
                                "ru": "Более быстрое судно начало <w>обгонять</w> меньшее судно по мере приближения к гавани."
                            }
                        },
                        {
                            "text": "In the final lap of the race, the runner managed to <w>overhaul</w> his opponent.",
                            "target_lang_translations": {
                                "ru": "На последнем круге забега бегуну удалось <w>опередить</w> своего соперника."
                            }
                        }
                    ],
                    "synonyms": [
                        "overtake",
                        "outstrip",
                        "pass"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обогнать, опередить или пройти мимо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обгонять",
                                "target_lang_sense_clarification": "в гонке или движении"
                            },
                            {
                                "target_lang_word": "опережать",
                                "target_lang_sense_clarification": "двигаться быстрее другого"
                            },
                            {
                                "target_lang_word": "настигать",
                                "target_lang_sense_clarification": "догонять и перегонять"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ed7eeaf-f30b-3a9d-932d-a03faf641cfb",
                    "sense_definition": "To search a ship for contraband goods.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "inspection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The customs officers were ordered to <w>overhaul</w> the suspicious vessel for illegal cargo.",
                            "target_lang_translations": {
                                "ru": "Таможенникам было приказано <w>досмотреть</w> подозрительное судно на предмет незаконного груза."
                            }
                        },
                        {
                            "text": "During the war, naval patrols would <w>overhaul</w> any merchant ship found in restricted waters.",
                            "target_lang_translations": {
                                "ru": "Во время войны морские патрули <w>осматривали</w> любое торговое судно, обнаруженное в закрытых водах."
                            }
                        }
                    ],
                    "synonyms": [
                        "inspect",
                        "search"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "primarily used in historical or nautical contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Осматривать судно на предмет контрабанды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "досматривать",
                                "target_lang_sense_clarification": "официальный осмотр судна"
                            },
                            {
                                "target_lang_word": "инспектировать",
                                "target_lang_sense_clarification": "проверять на наличие нарушений"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1052ae7e-9761-34c5-a4c8-d7867137007d",
                    "sense_definition": "A major repair, renovation, or revision.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "renovation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old factory is closed while it undergoes a complete <w>overhaul</w> of its machinery.",
                            "target_lang_translations": {
                                "ru": "Старый завод закрыт на время полного <w>капитального ремонта</w> оборудования."
                            }
                        },
                        {
                            "text": "The company's website needs a major <w>overhaul</w> to attract more customers.",
                            "target_lang_translations": {
                                "ru": "Сайту компании требуется серьезная <w>переработка</w>, чтобы привлечь больше клиентов."
                            }
                        }
                    ],
                    "synonyms": [
                        "renovation",
                        "reconstruction",
                        "reorganization"
                    ],
                    "common_phrases": [
                        "complete overhaul",
                        "major overhaul",
                        "undergo an overhaul"
                    ],
                    "target_lang_definitions": {
                        "ru": "Капитальный ремонт, реконструкция или полная переработка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "капитальный ремонт",
                                "target_lang_sense_clarification": "полное восстановление техники"
                            },
                            {
                                "target_lang_word": "пересмотр",
                                "target_lang_sense_clarification": "коренное изменение системы"
                            },
                            {
                                "target_lang_word": "реконструкция",
                                "target_lang_sense_clarification": "обновление структуры"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fc772faa-851e-3bc2-932a-d067e21dfec3",
                    "sense_definition": "The process after a fire is extinguished where firefighters search for hot spots.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "firefighting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "During the <w>overhaul</w>, the crew found a small fire still burning inside the wall.",
                            "target_lang_translations": {
                                "ru": "Во время <w>проверки после тушения</w> команда обнаружила небольшой очаг огня, все еще горевший внутри стены."
                            }
                        },
                        {
                            "text": "The fire chief insisted on a thorough <w>overhaul</w> to prevent any chance of reignition.",
                            "target_lang_translations": {
                                "ru": "Начальник пожарной охраны настоял на тщательной <w>разборке конструкций</w>, чтобы исключить любую возможность повторного возгорания."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс после тушения пожара, при котором пожарные ищут скрытые очаги возгорания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разборка конструкций",
                                "target_lang_sense_clarification": "поиск скрытых очагов тления"
                            },
                            {
                                "target_lang_word": "проливка",
                                "target_lang_sense_clarification": "завершающая стадия тушения"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}