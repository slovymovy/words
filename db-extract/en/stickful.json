                "senses": [
                    {
                        "sense_id": "6493647e-6444-3785-820d-d7379bedc8a5",
                        "entry_id": "856ef559-ac11-3c8c-9c20-e8db4320724f",
                        "glosses": [
                            "As much type as fills a composing stick."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "da1d8991-0abd-4359-9a4a-79bd150c5c11",
                                "sense_id": "6493647e-6444-3785-820d-d7379bedc8a5",
                                "text": "That first morning it took me half an hour to set my first stickful, a dozen lines."
                            },
                            {
                                "example_id": "302b8eca-d466-4ccc-a669-ca396fad635f",
                                "sense_id": "6493647e-6444-3785-820d-d7379bedc8a5",
                                "text": "Stickful after stickful is placed on this galley, until it also is full."
                            },
                            {
                                "example_id": "eb61337c-3d2d-472e-9fb8-51dc53631438",
                                "sense_id": "6493647e-6444-3785-820d-d7379bedc8a5",
                                "text": "Football stories may be divided into three general classes: the brief summary story of a stickful or a trifle more; the usual football story of a half column or less; and the long story that may be run through a column or more, depending upon the importance of the game."
                            }
                        ]
                    },
                    {
                        "sense_id": "0b9c6b68-e7f7-317f-8e77-6bb7e60e7f9a",
                        "entry_id": "856ef559-ac11-3c8c-9c20-e8db4320724f",
                        "glosses": [
                            "An amount that is held on one stick."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7197b097-a798-4f80-bb6e-813c1da39b8b",
                                "sense_id": "0b9c6b68-e7f7-317f-8e77-6bb7e60e7f9a",
                                "text": "I started with old headman and passed a good smoking hot stickful of meat to everyone, about twenty or twenty-five of them altogether in the order what I guessed their ages was."
                            },
                            {
                                "example_id": "a9fbe3ae-f642-4e71-840e-afef0e78476e",
                                "sense_id": "0b9c6b68-e7f7-317f-8e77-6bb7e60e7f9a",
                                "text": "If you scoop a stickful up and then tap the stick smartly on the edge of the pot, most of it will fall off the stick."
                            },
                            {
                                "example_id": "0a6b9be8-65d9-409a-96c2-e8d3f74d9d20",
                                "sense_id": "0b9c6b68-e7f7-317f-8e77-6bb7e60e7f9a",
                                "text": "And Elsie the Elk looked as if she had mange, and the candy floss had gone up to eighty-five pence for a mean little stickful, and the bus ride was rotten because the driver wouldn't let them open the windows all the way, or sing at all loudly."
                            },
                            {
                                "example_id": "3cf60536-a34d-4bd8-bb3b-f5bca3ac26aa",
                                "sense_id": "0b9c6b68-e7f7-317f-8e77-6bb7e60e7f9a",
                                "text": "Frank stuck a dollop onto the end of his stick and pushed it into the gap that surrounded Bob. “Ooooh.”, Bob cried, “That tickles!” Stickful after stickful, Frank went about his work, whistling as he did so."
                            }
                        ]
                    }
