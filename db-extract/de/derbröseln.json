                                                "example_id": "421f7d0d-9042-4927-b533-2bdeea08fbce",
                                                "sense_id": "a7aced0e-7b45-36af-990c-c94eb8acdf85",
                                                "text": "Ihn hat es beim letzten Hochwasser erwischt."
                                            }
