                        "glosses": [
                            "Eigenschaft/Handlungsweise, die in deutlichem Maße ungesetzliches (illegitimes) Verhalten zeigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93413cd1-abc2-4130-ad15-a27165f9c067",
                                "sense_id": "5f242b03-bf9b-3a44-8134-ca104b431535",
                                "text": "„Sarru-kenu ‚rechtmäßiger König‘, war wohl ein Thronname, den er erst anläßlich seines Regierungsantrittes annahm, um die Illegitimität seiner Thronfolge zu verdunkeln.“"
                            }
