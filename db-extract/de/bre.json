                        "sense_id": "f4599d87-562c-37ca-8fda-ef511831f127",
                        "entry_id": "c05c3ad8-3ccb-30d6-a6a5-92269c82f668",
                        "glosses": [
                            "bro"
                        ],
                        "tags": [
