                    {
                        "form_id": "eb27526f-2ea2-4467-b591-42252d2b344d",
                        "entry_id": "3c6f81f2-7f5b-38e4-a3e0-d72a4c90de0a",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "das Holzhaus"
                    },
                    {
                        "form_id": "0db6f485-2d64-4c7b-8340-9a90f295a6f1",
                        "entry_id": "3c6f81f2-7f5b-38e4-a3e0-d72a4c90de0a",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Holzhäuser"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2d475008-6307-3eac-abec-6465308d2be0",
                        "entry_id": "3c6f81f2-7f5b-38e4-a3e0-d72a4c90de0a",
                        "glosses": [
                            "Haus, das vollständig aus Holz gebaut wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff4cfee7-f85e-41ad-bca5-2c46f09a95f7",
                                "sense_id": "2d475008-6307-3eac-abec-6465308d2be0",
                                "text": "Das neugebaute Holzhaus war kostengünstiger als ein Steinhaus."
                            },
                            {
                                "example_id": "2641fb03-5b22-4f6f-9932-d1f993747aee",
                                "sense_id": "2d475008-6307-3eac-abec-6465308d2be0",
                                "text": "„Es bestand aus vielleicht fünfzig Holzhäusern, von denen ein paar etwa aus der Zeit um 1800 waren, Martin zufolge.“"
                            },
                            {
                                "example_id": "2031d39b-1f1b-4f98-9ee4-3973e6f2e563",
                                "sense_id": "2d475008-6307-3eac-abec-6465308d2be0",
                                "text": "„Das Holzhaus steht noch immer, obwohl sich dort gewiß vieles verändert hat, seit ich wegging.“"
                            },
                            {
                                "example_id": "5a9abfcc-ea36-4887-8e18-49008fb17fe8",
                                "sense_id": "2d475008-6307-3eac-abec-6465308d2be0",
                                "text": "„Dennoch blieb es ihm ein Rätsel, warum die Färinger mit ihren Holzhäusern so glücklich waren.“"
                            },
                            {
                                "example_id": "f7925456-c77a-47e9-a55e-dea53fd5a6b8",
                                "sense_id": "2d475008-6307-3eac-abec-6465308d2be0",
                                "text": "„Das Schiff lag am südlichen Ende vor Anker, in Victoria, dem Verwaltungszentrum der Insel, das aber nur aus wenigen einfachen Holzhäusern bestand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
