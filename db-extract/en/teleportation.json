                                                "sense_id": "7197ffc3-b667-3aa6-b799-947c1d95c422",
                                                "text": "Star Trek: Beam me up, Scotty!!! There's no intelligent life down here"
                                            },
                                            {
                                                "example_id": "c4495a7d-5c2d-4230-ac87-0221c8a00090",
                                                "sense_id": "7197ffc3-b667-3aa6-b799-947c1d95c422",
                                                "text": "Teleportatie van elektronen stap dichterbij"
                                            }
