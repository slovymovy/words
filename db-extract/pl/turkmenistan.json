                                        "examples": [
                                            {
                                                "example_id": "4d406901-ac7b-4ff7-bec3-a217737cb655",
                                                "sense_id": "b0744b98-7f7d-3b36-9477-0b40bfd6c5d4",
                                                "text": "„Turkmenistan wird in weiten Teilen von Trockengebieten dominiert und beherbergt immer noch zahlreiche größere Tierarten, die für Steppengebiete charakteristisch sind.“"
                                            },
                                            {
                                                "example_id": "f9f0c883-49ac-415e-880d-8796e1ba37fd",
                                                "sense_id": "b0744b98-7f7d-3b36-9477-0b40bfd6c5d4",
                                                "text": "Das heutige Turkmenistan ist nicht für Pressefreiheit bekannt."
                                            },
                                            {
                                                "example_id": "faf79754-f068-4104-beb0-01ca6a91bf5d",
                                                "sense_id": "b0744b98-7f7d-3b36-9477-0b40bfd6c5d4",
                                                "text": "Aschgabat ist die Hauptstadt von Turkmenistan."
                                            },
                                            {
                                                "example_id": "0387a5e2-6ba4-467e-b761-5f2a52a085a5",
                                                "sense_id": "b0744b98-7f7d-3b36-9477-0b40bfd6c5d4",
                                                "text": "„[…] Turkmenistan mit den viertgrößten Erdgasreserven der Welt ist Chinas wichtigster Erdgaslieferant.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
