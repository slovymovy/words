                "senses": [
                    {
                        "sense_id": "e9e498e0-16db-31e6-b502-3bd76c835c2a",
                        "entry_id": "6e68d3a0-ffde-3982-9c10-bf3ba6243097",
                        "glosses": [
                            "Affranchir (un courrier) à l’avance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e457512c-9945-49fd-83a6-da0829fc1343",
                                "sense_id": "e9e498e0-16db-31e6-b502-3bd76c835c2a",
                                "text": "Puis elle se dévêtit, rangea le déguisement au complet dans la boîte prêtée par la boutique de location. Lia l’avait fait pré-affranchir et comptait la poster sur le chemin de l’aéroport."
                            },
                            {
                                "example_id": "e564e31a-4fe9-4365-b596-59c4cf536c8b",
                                "sense_id": "e9e498e0-16db-31e6-b502-3bd76c835c2a",
                                "text": "Je n'ai toujours pas compris (ils n'ont pas su m'expliquer) comment allait être remplacée la lettre max! (avec la possibilité de pré-affranchir ou pas, d'utiliser le prêt-à-poster ou pas)"
                            },
                            {
                                "example_id": "7483acbe-fdb6-4875-a99b-3c6298763be4",
                                "sense_id": "e9e498e0-16db-31e6-b502-3bd76c835c2a",
                                "text": "Vous pouvez désormais expédier vos colis depuis votre boîte aux lettres, à condition de pré-affranchir en ligne."
                            }
                        ]
                    }
                ],
