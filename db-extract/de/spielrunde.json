                "senses": [
                    {
                        "sense_id": "f6b9a2ca-7144-34bb-a8e8-0459113fc498",
                        "entry_id": "2b40ad46-e7a8-32a3-b9a5-4c7ef51e2019",
                        "glosses": [
                            "Kreis von Personen, die sich zum gemeinsamen Gesellschaftsspiel zusammenfinden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45f8a536-068d-4f41-91d1-ebd6176fadb0",
                                "sense_id": "f6b9a2ca-7144-34bb-a8e8-0459113fc498",
                                "text": "„Oder er sagt überhaupt nichts, zeigt seinen Unmut, hörbar mit den Zähnen knirschend, und wirft böse Blicke auf die ganze Spielrunde.“"
                            },
                            {
                                "example_id": "d44c6bb1-e66f-48a2-b43c-2737c60061b4",
                                "sense_id": "f6b9a2ca-7144-34bb-a8e8-0459113fc498",
                                "text": "„Die Spielregel gibt der Spielrunde beim ‚Abenteuer unter Wasser’ eine ganze Anzahl von Rätseln auf.“"
                            },
                            {
                                "example_id": "ad3e15e2-6b1d-4fdf-aa74-00d038e8c276",
                                "sense_id": "f6b9a2ca-7144-34bb-a8e8-0459113fc498",
                                "text": "„Aber das kann man ja durch Vereinbarung in der Spielrunde ändern.“"
                            },
                            {
                                "example_id": "3ffdd672-28fd-411a-9348-8e42f45adc22",
                                "sense_id": "f6b9a2ca-7144-34bb-a8e8-0459113fc498",
                                "text": "„Auf daß die ehrlichen Leute dieser Spielrunde wenigstens in puncto Schadenfreude auf ihre Rechnung kommen.“"
                            },
                            {
                                "example_id": "1b4dd3d5-bb4b-40a8-9d32-192408ea5cea",
                                "sense_id": "f6b9a2ca-7144-34bb-a8e8-0459113fc498",
                                "text": "„Die ersten Überraschungen erlebt die Spielrunde schon beim Auspacken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "45a91b8f-8226-3862-ba3a-eecef20f4434",
                        "entry_id": "2b40ad46-e7a8-32a3-b9a5-4c7ef51e2019",
                        "glosses": [
                            "Abfolge mehrerer Spieleinheiten oder Teil eines Turniers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16b5f5ee-3cb7-40cc-8381-53d2957b2e9b",
                                "sense_id": "45a91b8f-8226-3862-ba3a-eecef20f4434",
                                "text": "„Will man die ‚Tellermagie’ mehrfach zelebrieren, müssen vor Spielbeginn alle Kandidaten aus dem Raum gebeten und zu jeder Spielrunde einzeln hereingeholt werden.“"
                            },
                            {
                                "example_id": "cfeb98ab-9b6b-4334-8c04-7fcbaf0bca9f",
                                "sense_id": "45a91b8f-8226-3862-ba3a-eecef20f4434",
                                "text": "„Das Spiel selbst läuft in Runden ab; jede Spielrunde hat folgende Phasen […].“"
                            },
                            {
                                "example_id": "fafeacec-38c3-4865-8c76-c9182f9b6ab0",
                                "sense_id": "45a91b8f-8226-3862-ba3a-eecef20f4434",
                                "text": "„Wenn ein Kind nach einer Spielrunde ‚Noch mal’ ruft, weiß ich, dass es funktioniert, sagt Steffen Bogen. Schnappt Hubi, ein anderes preisgekröntes Spiel von ihm, bei dem man in einem Labyrinth ein Gespenst fangen muss, war nach eineinhalb Jahren fertig.“"
                            },
                            {
                                "example_id": "4cabdf35-b7b7-4d51-ac5d-be6e0eb91318",
                                "sense_id": "45a91b8f-8226-3862-ba3a-eecef20f4434",
                                "text": "„Dann sollte die DFL erwägen, diese Spielrunde abzuschaffen oder wenigstens auf ein einziges Spiel zu reduzieren.“"
                            },
                            {
                                "example_id": "738d4f76-0094-4690-8ef8-fa1b995a7772",
                                "sense_id": "45a91b8f-8226-3862-ba3a-eecef20f4434",
                                "text": "„Dort stand er anfangs ebenfalls in der Kritik und nach dem peinlichen Pokal-Aus in Elversberg unmittelbar vor seiner ersten kompletten Spielrunde gar kurz vor dem Rauswurf.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
