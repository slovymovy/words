        "fr-extract.jsonl": [
            {
                "entry_id": "f1ea29a5-0568-3e70-9db9-02a0a7e368a3",
                "word": "Dniepr",
                "pos": "name",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e979ae9f-ea5d-4bc1-b1ad-aa53dcc28c49",
                        "entry_id": "f1ea29a5-0568-3e70-9db9-02a0a7e368a3",
                        "tags": [
                            "Fleuve"
                        ],
                        "form": "Dniéper"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "05c8638c-b29d-34c4-aa29-d9868316ac2c",
                        "entry_id": "f1ea29a5-0568-3e70-9db9-02a0a7e368a3",
                        "glosses": [
                            "Fleuve traversant la Biélorussie, la Russie et l’Ukraine pour se jeter dans la mer Noire."
                        ],
                        "tags": [
                            "Cours d’eau"
                        ],
                        "examples": [
                            {
                                "example_id": "df099a17-e6a3-4abc-aca4-964082dab12f",
                                "sense_id": "05c8638c-b29d-34c4-aa29-d9868316ac2c",
                                "text": "Le Dniepr est le troisième plus long fleuve d’Europe."
                            },
                            {
                                "example_id": "38a04266-8115-4040-b819-69787706bb2b",
                                "sense_id": "05c8638c-b29d-34c4-aa29-d9868316ac2c",
                                "text": "La Bérézina se jette dans le Dniepr."
                            },
                            {
                                "example_id": "c5b2168d-b9af-4fc6-ab9f-129ab2096704",
                                "sense_id": "05c8638c-b29d-34c4-aa29-d9868316ac2c",
                                "text": "La première nouvelle, « Confluence imaginaire », constitue un récit alterné nous entraînant des confluents du Rhône à ceux du Dniepr, sur des chemins que parcourt à vélo le narrateur, un jeune Français, tantôt seul lorsqu'il est en France et tantôt avec son ami ukrainien."
                            }
                        ]
                    },
                    {
                        "sense_id": "8cc9b270-107a-32cc-ae48-f7b9a7fcaca6",
                        "entry_id": "f1ea29a5-0568-3e70-9db9-02a0a7e368a3",
                        "glosses": [
                            "Variante de Dnipro."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6dcc2f10-0428-4272-97d8-ff41d65a7b4d",
                        "source_entry_id": "f1ea29a5-0568-3e70-9db9-02a0a7e368a3",
                        "source_sense_description": "Fleuve",
                        "target_lang_word": "Dnepr",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dnepr",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "27c4e575-1d93-3ffb-a831-296ca7219c72",
                                        "entry_id": "286cc3da-5d0c-3371-9c27-25d3833772ce",
                                        "glosses": [
                                            "mit 2.201 Kilometern der drittlängste Fluss in Europa, der durch Russland, Weißrussland und die Ukraine führt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33452132-f0ee-4d79-ab00-dce695e0be29",
                                                "sense_id": "27c4e575-1d93-3ffb-a831-296ca7219c72",
                                                "text": "„Die Wolga mag inzwischen als Seele Rußlands gelten; die Wiege der Russen, auch der Weißrussen und Ukrainer, bleibt der Dnepr.“"
                                            },
                                            {
                                                "example_id": "f0a0a4a6-fa3e-4ea8-b869-29fb5981b6be",
                                                "sense_id": "27c4e575-1d93-3ffb-a831-296ca7219c72",
                                                "text": "„Eine gute Fahrtstunde südlich von Dnipro liegt die Großstadt Saporischschja an einer weiteren strategisch entscheidenden Stelle am Fluss Dnepr, der die Ost- und die Westukraine teilt.“"
                                            },
                                            {
                                                "example_id": "7e3ddf7c-c0b2-4fdd-afc5-4fbc7b6f07a8",
                                                "sense_id": "27c4e575-1d93-3ffb-a831-296ca7219c72",
                                                "text": "„Russische Truppen rückten in die Hafenstadt Cherson an der Mündung des Dnepr ins Schwarze Meer ein und nahmen die Hafenstadt Mariupol am Asowschen Meer unter Feuer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
