                        "glosses": [
                            "Celui qui prépare un examen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f393a6c-303b-4dbf-b303-cc1ef428fe2e",
                                "sense_id": "fc68f9d4-8a67-3d59-8201-613d9d93cb4b",
                                "text": "Le spectre des attitudes est large, du bachoteur archi-préparé avec cinq pages de question sur un cahier milimétré, au parfait dilettante se disant « après tout, on verra bien ! »"
                            },
                            {
                                "example_id": "9a8e9b5f-1652-4227-bc24-d244ff319be1",
                                "sense_id": "fc68f9d4-8a67-3d59-8201-613d9d93cb4b",
                                "text": "Avec un objectif en tête, en se fixant des priorités et en dosant ses efforts, on fait souvent mieux, et avec une vie bien plus agréable, que la bachoteuse du premier rang qui a appris le bouquin par cœur."
                            }
                        ]
                    }
