                                "sense_id": "ec1ba1be-4a9e-346e-9af8-f8b497d19108",
                                "text": "„Die Kernfusion ist eine Kernreaktion, bei der zwei Atomkerne zu einem neuen Kern verschmelzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
