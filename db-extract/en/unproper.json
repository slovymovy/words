                        "entry_id": "d7c41ef6-9e51-37d1-9903-99701614decf",
                        "glosses": [
                            "Improper, not according with good standards of behaviour; indecent, indecorous."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "e3112c85-6c6c-4a54-b696-1c2e7842a8ed",
                                "sense_id": "479d3519-3ee3-35c5-b73d-d3f938f9301b",
                                "text": "His equally unproper brother, City Planner Charles W. II, shocked purists in the 19303 by building a flat-topped house in Ipswich."
