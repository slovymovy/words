                        "translation_id": "47ec5a16-0df5-41cc-bc4d-8236e7296095",
                        "source_entry_id": "7a32a948-6de6-32ad-b44e-7bdf126661f5",
                        "source_sense_id": "75905182-d7b9-3d07-8408-8b21c308eaf6",
