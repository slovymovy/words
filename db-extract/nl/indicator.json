                                    {
                                        "sense_id": "2bd9b872-1f84-3b4b-8661-bf0b4c66b32e",
                                        "entry_id": "5937aa73-f44b-3423-83e4-a0237009b898",
                                        "glosses": [
                                            "Hilfsmittel, das die Verfolgung intransparenter Abläufe ermöglicht, indem es das Erreichen oder Verlassen bestimmter Zustände anzeigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2389d293-2430-4672-8ea8-3c3c641db132",
                                                "sense_id": "2bd9b872-1f84-3b4b-8661-bf0b4c66b32e",
                                                "text": "Der Artikel ist ein Indikator für die Groß- und Kleinschreibung eines Wortes."
                                            },
                                            {
                                                "example_id": "16767d46-dedd-449d-90db-1e92fda77d08",
                                                "sense_id": "2bd9b872-1f84-3b4b-8661-bf0b4c66b32e",
                                                "text": "Eine gefrorene Autoscheibe ist ein Indikator für tiefe Temperaturen und damit für mögliches Glatteis auf der Straße."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "763a841e-7c85-32ec-a32b-c624a4ae50c7",
                                        "entry_id": "5937aa73-f44b-3423-83e4-a0237009b898",
                                        "glosses": [
                                            "Umstand, Merkmal, was als Anzeichen für eine bestimmte Entwicklung, einen eingetretenen Zustand oder Ähnlichem dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7300fa91-5eb2-4668-9612-4dab33a2614b",
                                                "sense_id": "763a841e-7c85-32ec-a32b-c624a4ae50c7",
                                                "text": "Der Artikel ist ein Indikator für die Groß- und Kleinschreibung eines Wortes."
                                            },
                                            {
                                                "example_id": "9a7e1ef9-1697-46f9-8459-62078a015ec6",
                                                "sense_id": "763a841e-7c85-32ec-a32b-c624a4ae50c7",
                                                "text": "Eine gefrorene Autoscheibe ist ein Indikator für tiefe Temperaturen und damit für mögliches Glatteis auf der Straße."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "bbe1e8ba-8ed6-380f-920a-cc5df035736e",
                                        "entry_id": "5937aa73-f44b-3423-83e4-a0237009b898",
                                        "glosses": [
                                            "‘Anzeiger’ für bestimmte chemische Reaktionen beziehungsweise physikalische Prozesse (19. Jahrhundert)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abce7b79-a341-4066-8a18-1e9c12956472",
                                                "sense_id": "bbe1e8ba-8ed6-380f-920a-cc5df035736e",
                                                "text": "Lackmus kann als Indikator eingesetzt werden."
                                            },
                                            {
                                                "example_id": "0fc27bfa-bfd8-4b7c-a9ae-45816da97e4b",
                                                "sense_id": "bbe1e8ba-8ed6-380f-920a-cc5df035736e",
                                                "text": "„Setzt man dem Wasser etwas Phenolphtalein als Indikator zu, erkennt man, dass der Natriumtropfen eine rote Farbspur hinterlässt. Es hat sich also eine alkalische Lösung gebildet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "4304f186-3ff1-3e13-b58c-fd7aecd68662",
                                        "entry_id": "5937aa73-f44b-3423-83e4-a0237009b898",
                                        "glosses": [
                                            "Anzeigegerät ohne quantitative Aussage"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4694fe56-1410-4c0a-89dc-2610ea0334ff",
                                                "sense_id": "4304f186-3ff1-3e13-b58c-fd7aecd68662",
                                                "text": "Ein Batterietester als Indikator dient zur Ermittlung, ob eine ausreichend große elektrische Spannung vorhanden ist."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "e86ece4b-dc46-3d04-bd8c-0ce304a7192f",
                                        "entry_id": "5937aa73-f44b-3423-83e4-a0237009b898",
                                        "glosses": [
                                            "Gerät, das qualitativ oder quantitativ physikalische Werte anzeigt"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4e379cb-1d88-460c-a08c-1c7850b816d9",
                                                "sense_id": "e86ece4b-dc46-3d04-bd8c-0ce304a7192f",
                                                "text": "Der erste Indikator zur Ermittlung des Druckverlaufes war ein Messgerät zur Ermittlung des Druckverlaufes in einem Zylinder und wurde von James Watt im Jahre 1782 erfunden."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "61598d05-c551-4b95-9100-da6ef82b5aee",
