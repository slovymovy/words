                ],
                "senses": [
                    {
                        "sense_id": "6cba3d42-b1e7-386f-9420-7c3bce99c88e",
                        "entry_id": "ac5b46aa-4eb9-3da6-be58-39dea7085fd2",
                        "glosses": [
                            "Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "146c426d-4964-479c-83f6-9a08f3e79746",
                                "sense_id": "6cba3d42-b1e7-386f-9420-7c3bce99c88e",
                                "text": "Frau Juel ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "5432d265-ab9b-43ca-b7d6-3771c405ad1a",
                                "sense_id": "6cba3d42-b1e7-386f-9420-7c3bce99c88e",
                                "text": "Herr Juel wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "3c987ae4-6f29-4161-8a1e-0e40ac56a405",
                                "sense_id": "6cba3d42-b1e7-386f-9420-7c3bce99c88e",
                                "text": "Die Juels fahren heute nach Rotterdam."
                            },
                            {
                                "example_id": "4867fc0f-b072-47fe-813d-9eef1ba98afb",
                                "sense_id": "6cba3d42-b1e7-386f-9420-7c3bce99c88e",
                                "text": "Der Juel trägt nie die Pullover, die die Juel ihm strickt."
                            },
                            {
                                "example_id": "4c9417e6-0cb2-413f-8524-73cb58630820",
                                "sense_id": "6cba3d42-b1e7-386f-9420-7c3bce99c88e",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Juel kommt, geht der Herr Juel.“"
                            },
                            {
                                "example_id": "1a5aa0dd-d798-4994-bb98-315405b59dd3",
                                "sense_id": "6cba3d42-b1e7-386f-9420-7c3bce99c88e",
                                "text": "Juel kommt und geht."
                            },
                            {
                                "example_id": "f320a68c-b777-4891-a7c6-9c4eaf6375c2",
                                "sense_id": "6cba3d42-b1e7-386f-9420-7c3bce99c88e",
                                "text": "Juels kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
