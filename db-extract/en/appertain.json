                ],
                "senses": [
                    {
                        "sense_id": "48627dc0-5b2e-3fd2-b712-a76ba480b05b",
                        "entry_id": "f61822c1-e754-3344-b943-a20737f18af0",
                        "glosses": [
                            "To belong to or be a part of, whether by right, nature, appointment, or custom; to relate to."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8529c770-02a2-4f74-875a-6dadcce885ef",
                                "sense_id": "48627dc0-5b2e-3fd2-b712-a76ba480b05b",
                                "text": "McInnis reached down and gently raised the old man's head to face him. \"Edwin Falkirk, I hereby relieve you of the Directorship of Site-43 under my authority as Administrator of the SCP Foundation. Your security clearance credentials will be revoked in full, and all privileges appertaining to your position are rescinded.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "393189ef-2618-3a8b-afe6-9dd60daf2705",
                        "entry_id": "f61822c1-e754-3344-b943-a20737f18af0",
                        "glosses": [
                            "To belong as a part, right, possession, attribute, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7e0012b-77b5-46e5-849a-cc69be5dd8c1",
                                "sense_id": "393189ef-2618-3a8b-afe6-9dd60daf2705",
                                "text": "Also the rule of false position, with dyuers examples not onely vulgar, but some appertaynyng to the rule of Algeber."
                            },
                            {
                                "example_id": "00f38edf-f7df-49ef-bd92-bfbea1df6676",
                                "sense_id": "393189ef-2618-3a8b-afe6-9dd60daf2705",
                                "text": "In this great stretch of country there is no sign of life, nor of anything appertaining to life. There is no bird in the steel-blue heaven, no movement upon the dull, grey earth—above all, there is absolute silence. Listen as one may, there is no shadow of a sound in all that mighty wilderness; nothing but silence—complete and heart-subduing silence."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d3a84bf6-3f47-404e-a816-8d66bdd32525",
                        "source_entry_id": "f61822c1-e754-3344-b943-a20737f18af0",
                        "source_sense_description": "to belong to or be a part of, whether by right, nature, appointment, or custom; to relate to",
                        "target_lang_word": "appartenir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "appartenir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a86c5a93-a865-32c4-95bc-48e5ff677b55",
                                        "entry_id": "4a567b9f-8b94-3f36-b107-4665a64a63c0",
                                        "glosses": [
                                            "Être la propriété légitime de quelqu’un, que celui à qui est la chose l’ait en sa possession ou non."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "954b0a49-2663-4ed7-9ad5-7ad7d6f47119",
                                                "sense_id": "a86c5a93-a865-32c4-95bc-48e5ff677b55",
                                                "text": "Donc, primitivement, il y avait eu là quatre maisons distinctes qui n'en faisaient plus qu'une et qui devaient appartenir maintenant au même propriétaire."
                                            },
                                            {
                                                "example_id": "12883c67-3c3b-46d5-a83c-6c9d657c42b2",
                                                "sense_id": "a86c5a93-a865-32c4-95bc-48e5ff677b55",
                                                "text": "Il m’en appartient une moitié."
                                            },
                                            {
                                                "example_id": "8178116b-5604-45e6-910b-7d628a06ab03",
                                                "sense_id": "a86c5a93-a865-32c4-95bc-48e5ff677b55",
                                                "text": "La nue-propriété de cette maison m’appartient."
                                            },
                                            {
                                                "example_id": "221f6252-5a23-4c8c-80c4-fcbc398a2e17",
                                                "sense_id": "a86c5a93-a865-32c4-95bc-48e5ff677b55",
                                                "text": "L’usufruit de ce domaine m’appartient."
                                            },
                                            {
                                                "example_id": "8c8011d0-5fdb-4707-8117-79845a288a3e",
                                                "sense_id": "a86c5a93-a865-32c4-95bc-48e5ff677b55",
                                                "text": "Cela nous appartient de droit et en toute propriété."
                                            },
                                            {
                                                "example_id": "76176c31-a31e-4c8d-a90a-b689b4ac993d",
                                                "sense_id": "a86c5a93-a865-32c4-95bc-48e5ff677b55",
                                                "text": "L’homme sage et libre s’appartient."
                                            },
                                            {
                                                "example_id": "7aefd5f3-f23b-4163-b8e8-e162b8243844",
                                                "sense_id": "a86c5a93-a865-32c4-95bc-48e5ff677b55",
                                                "text": "J’ai tant d’occupations que je ne m’appartiens plus."
                                            },
                                            {
                                                "example_id": "ac2c19ba-7356-4827-a391-7b99a4a6a8dc",
                                                "sense_id": "a86c5a93-a865-32c4-95bc-48e5ff677b55",
                                                "text": "Une femme, dès qu’elle se marie, cesse de s’appartenir."
                                            },
                                            {
                                                "example_id": "f8579a89-8a19-4dd2-846a-ffcdd29790a7",
                                                "sense_id": "a86c5a93-a865-32c4-95bc-48e5ff677b55",
                                                "text": "L’heure approchait., ils en avaient l’intuition affolante, qui les verrait s’appartenir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebf1f277-c558-3d69-9f54-533a622d6e67",
                                        "entry_id": "4a567b9f-8b94-3f36-b107-4665a64a63c0",
                                        "glosses": [
                                            "Être parent de quelqu’un ou attaché à son service."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5b3e62a-1cbf-4d8b-bda9-29ace83da7ee",
                                                "sense_id": "ebf1f277-c558-3d69-9f54-533a622d6e67",
                                                "text": "Dorante.— Monsieur, vous avez sans doute reçu de nos nouvelles ; j’appartiens à monsieur Dorante qui me suit, et qui m’envoie toujours devant, vous assurer de ses respects, en attendant qu’il vous en assure lui-même."
                                            },
                                            {
                                                "example_id": "20a8b77d-2a4c-46af-a01b-1ef03494d646",
                                                "sense_id": "ebf1f277-c558-3d69-9f54-533a622d6e67",
                                                "text": "Dans les seuls évêchés de Dol, Saint-Malo et Saint-Brieuc, quatorze feudataires dont les revenus nobles propres allaient de 1500 à 40 livres monnaie appartenaient à la maison du vicomte de Rohan."
                                            },
                                            {
                                                "example_id": "b38fbaab-a56d-491e-9d11-4969792152b2",
                                                "sense_id": "ebf1f277-c558-3d69-9f54-533a622d6e67",
                                                "text": "Il appartient à d’honnêtes parents."
                                            },
                                            {
                                                "example_id": "d6fc683f-8d21-413f-8655-93bb95ea24da",
                                                "sense_id": "ebf1f277-c558-3d69-9f54-533a622d6e67",
                                                "text": "Il appartenait aux plus grands seigneurs du royaume."
                                            },
                                            {
                                                "example_id": "0265a3c8-fde1-47f2-9187-b46717e724d3",
                                                "sense_id": "ebf1f277-c558-3d69-9f54-533a622d6e67",
                                                "text": "L’honneur que j’ai de vous appartenir."
                                            },
                                            {
                                                "example_id": "b1dc9b5d-a272-4bc6-a061-7522fcb40ae5",
                                                "sense_id": "ebf1f277-c558-3d69-9f54-533a622d6e67",
                                                "text": "Par respect pour la maison à laquelle j’appartiens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07fce084-d645-33c3-8156-b1f75816d797",
                                        "entry_id": "4a567b9f-8b94-3f36-b107-4665a64a63c0",
                                        "glosses": [
                                            "Être le droit, le privilège ou le propre, le caractère particulier de quelqu’un ou quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a458323d-f2d5-4a02-8729-effeac65bff9",
                                                "sense_id": "07fce084-d645-33c3-8156-b1f75816d797",
                                                "text": "Le droit de faire grâce appartient ordinairement au chef de l’état."
                                            },
                                            {
                                                "example_id": "a2190a2a-d3c6-43ac-a8cf-ce1a73a817c0",
                                                "sense_id": "07fce084-d645-33c3-8156-b1f75816d797",
                                                "text": "Les honneurs qui vous appartiennent."
                                            },
                                            {
                                                "example_id": "b288ce80-2845-4366-acf4-e8c8869ca80f",
                                                "sense_id": "07fce084-d645-33c3-8156-b1f75816d797",
                                                "text": "Ces droits appartiennent à ma charge."
                                            },
                                            {
                                                "example_id": "0082d419-e282-46f4-8397-37b7833e50c3",
                                                "sense_id": "07fce084-d645-33c3-8156-b1f75816d797",
                                                "text": "La connaissance de cette affaire appartient à tel juge."
                                            },
                                            {
                                                "example_id": "6503b82c-ad87-489f-94da-c5e3ebd1e727",
                                                "sense_id": "07fce084-d645-33c3-8156-b1f75816d797",
                                                "text": "Ils ont attribué à la matière ce qui n’appartient qu’à l’esprit, à l’âme."
                                            },
                                            {
                                                "example_id": "5293518c-b467-433b-aa26-1a76c8876f19",
                                                "sense_id": "07fce084-d645-33c3-8156-b1f75816d797",
                                                "text": "La perfection n’appartient qu’à Dieu seul."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c92cea9c-567f-3929-afda-b77cc1c958f3",
                                        "entry_id": "4a567b9f-8b94-3f36-b107-4665a64a63c0",
                                        "glosses": [
                                            "Incomber."
                                        ],
                                        "tags": [
                                            "impersonal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3083defe-a27a-4b19-8243-94be1138816a",
                                                "sense_id": "c92cea9c-567f-3929-afda-b77cc1c958f3",
                                                "text": "Il appartient aux pères de châtier leurs enfants."
                                            },
                                            {
                                                "example_id": "a4e718e8-d456-440d-8da3-308b3e2c78f4",
                                                "sense_id": "c92cea9c-567f-3929-afda-b77cc1c958f3",
                                                "text": "Il ne vous appartient pas de le reprendre."
                                            },
                                            {
                                                "example_id": "40b513d0-f104-4432-93dd-64b8d7c6bd60",
                                                "sense_id": "c92cea9c-567f-3929-afda-b77cc1c958f3",
                                                "text": "Il n’appartient qu’à un prince de faire une si grosse dépense."
                                            },
                                            {
                                                "example_id": "23be6826-e232-41ae-aaab-34ac8ad64292",
                                                "sense_id": "c92cea9c-567f-3929-afda-b77cc1c958f3",
                                                "text": "Il appartient au service à l’origine du projet de texte de verser au dossier une fiche justifiant de la nécessité de recueillir les contreseings retenus dans son projet et de préciser, le cas échéant, les raisons pour lesquelles il y aurait lieu de recueillir des contreseings autres que juridiquement nécessaires."
                                            },
                                            {
                                                "example_id": "b6770df4-d8f9-408d-99b3-405ea5b34cb1",
                                                "sense_id": "c92cea9c-567f-3929-afda-b77cc1c958f3",
                                                "text": "Il n’appartient qu’à peu de gens de sentir, de comprendre cela : Il n’est donné qu’à peu de gens, etc."
                                            },
                                            {
                                                "example_id": "c1afe237-4875-42d5-b845-7d3ec22150d6",
                                                "sense_id": "c92cea9c-567f-3929-afda-b77cc1c958f3",
                                                "text": "Il n’appartient qu’au génie de concevoir une telle pensée : Le génie seul est capable de concevoir une telle pensée, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1192153f-5cff-3a08-b1aa-007ea4633cb7",
                                        "entry_id": "4a567b9f-8b94-3f36-b107-4665a64a63c0",
                                        "glosses": [
                                            "Par manière de reproche."
                                        ],
                                        "tags": [
                                            "ironic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "866b7d78-1881-4963-bc73-32dca2e10e03",
                                                "sense_id": "1192153f-5cff-3a08-b1aa-007ea4633cb7",
                                                "text": "Il vous appartient bien de… : Vous êtes bien hardi de…"
                                            },
                                            {
                                                "example_id": "ab69b61d-5c9c-44b8-9560-c481d974ae4a",
                                                "sense_id": "1192153f-5cff-3a08-b1aa-007ea4633cb7",
                                                "text": "Il vous appartient bien de vous plaindre, après tout ce que vous avez fait."
                                            },
                                            {
                                                "example_id": "374e6404-7850-4fa0-ab07-4db7473f407f",
                                                "sense_id": "1192153f-5cff-3a08-b1aa-007ea4633cb7",
                                                "text": "Ainsi qu’il appartiendra : Terme de procédure, formule qui signifie « selon qu’il sera convenable »."
                                            },
                                            {
                                                "example_id": "975fa24a-f657-4713-9986-4033ea66c21a",
                                                "sense_id": "1192153f-5cff-3a08-b1aa-007ea4633cb7",
                                                "text": "Pour être statué ce qu’il appartiendra."
                                            },
                                            {
                                                "example_id": "eea4bb8e-1f90-4d61-8d21-285e0fb25127",
                                                "sense_id": "1192153f-5cff-3a08-b1aa-007ea4633cb7",
                                                "text": "À tous ceux qu’il appartiendra : À tous ceux qui y auront intérêt ou qui voudront en prendre connaissance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84e8ca16-cfe0-3648-9576-bfeb362491b8",
                                        "entry_id": "4a567b9f-8b94-3f36-b107-4665a64a63c0",
                                        "glosses": [
                                            "Faire partie de."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31f43e3c-7530-4d14-9cb1-d66bf0dfff16",
                                                "sense_id": "84e8ca16-cfe0-3648-9576-bfeb362491b8",
                                                "text": "Le Groenland, qui a la chance d'appartenir au Danemark, est, après l'Australie, la plus grande île du monde ; son étendue correspond approximativement au quart de celle de l'Europe."
                                            },
                                            {
                                                "example_id": "490bd665-1889-4b11-a5de-f8873df61f60",
                                                "sense_id": "84e8ca16-cfe0-3648-9576-bfeb362491b8",
                                                "text": "Henri s'était rapidement familiarisé avec la plupart de ces messieurs. Grâce à Tacherot, il était accepté ; il appartenait maintenant à leur monde."
                                            },
                                            {
                                                "example_id": "0301cc68-a6da-48da-8cb7-55275305a2bb",
                                                "sense_id": "84e8ca16-cfe0-3648-9576-bfeb362491b8",
                                                "text": "Il avait appartenu, en qualité de porteur, à une troupe d'acrobates de cirque, puis s'était entraîné au tapis, en vue d'un numéro de « flic-flac » avec rattrape sur les épaules."
                                            },
                                            {
                                                "example_id": "5ee088b5-c027-4bcf-945d-ba03e23cc533",
                                                "sense_id": "84e8ca16-cfe0-3648-9576-bfeb362491b8",
                                                "text": "Mais, dans la société compliquée que j’habitais désormais, j’avais tôt compris que chaque saison exigeait son uniforme et qu’il y avait des styles et des modes et des mouvements et que chacun s’y pliait et que si l’on voulait « appartenir », il valait mieux porter certaines cravates et certains tissus, certaines couleurs et certaines formes."
                                            },
                                            {
                                                "example_id": "b7c03781-3505-4c7f-906b-ab75a0f56cae",
                                                "sense_id": "84e8ca16-cfe0-3648-9576-bfeb362491b8",
                                                "text": "J’appartenais – comme ils disaient sur le campus. To belong : appartenir. Faire corps avec."
                                            },
                                            {
                                                "example_id": "006c121f-c9f2-4446-acc2-48258146db8d",
                                                "sense_id": "84e8ca16-cfe0-3648-9576-bfeb362491b8",
                                                "text": "Un membre séparé du corps auquel il appartient."
                                            },
                                            {
                                                "example_id": "7aad93d9-5cfb-43e3-bfc5-d9c5a661db73",
                                                "sense_id": "84e8ca16-cfe0-3648-9576-bfeb362491b8",
                                                "text": "On a trouvé le bras qui appartient à cette statue mutilée."
                                            },
                                            {
                                                "example_id": "929853be-34a8-4a36-90c0-86a3e15a144b",
                                                "sense_id": "84e8ca16-cfe0-3648-9576-bfeb362491b8",
                                                "text": "Cet animal, cette plante appartient à tel genre."
                                            },
                                            {
                                                "example_id": "4339dddd-884e-4402-a753-0cfc7f215acb",
                                                "sense_id": "84e8ca16-cfe0-3648-9576-bfeb362491b8",
                                                "text": "Ce soldat appartient à tel régiment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38c87220-3ce6-3504-a286-a73d74e1bc5e",
                                        "entry_id": "4a567b9f-8b94-3f36-b107-4665a64a63c0",
                                        "glosses": [
                                            "Avoir une relation nécessaire ou de convenance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c89dd432-60b8-481c-85a8-f7fcff3fb38f",
                                                "sense_id": "38c87220-3ce6-3504-a286-a73d74e1bc5e",
                                                "text": "Cette question appartient à la philosophie."
                                            },
                                            {
                                                "example_id": "575cb7fd-2f23-4e59-bce6-ee11213b8340",
                                                "sense_id": "38c87220-3ce6-3504-a286-a73d74e1bc5e",
                                                "text": "Cela appartient à la matière que je traite."
                                            },
                                            {
                                                "example_id": "bae6ac4e-d767-412d-882d-db835768e8ef",
                                                "sense_id": "38c87220-3ce6-3504-a286-a73d74e1bc5e",
                                                "text": "Cela appartient à la grammaire."
                                            },
                                            {
                                                "example_id": "08b82da5-aeab-48b2-9a99-ec3e2da6914b",
                                                "sense_id": "38c87220-3ce6-3504-a286-a73d74e1bc5e",
                                                "text": "Cela n’appartient pas à mon sujet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f7cc9fc-bc53-39ba-a325-53addc2da26a",
                                        "entry_id": "4a567b9f-8b94-3f36-b107-4665a64a63c0",
                                        "glosses": [
                                            "Être élément de"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce5a953c-d5b7-4161-ba6a-c7f64565aa9f",
                                                "sense_id": "4f7cc9fc-bc53-39ba-a325-53addc2da26a",
                                                "text": "-2 appartient à l'ensemble Z des entiers relatifs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "36ebd2dd-7df6-4ef3-a928-4d5186abc251",
