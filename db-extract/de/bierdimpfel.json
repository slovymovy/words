                "senses": [
                    {
                        "sense_id": "6bd2ec72-2240-3474-8aeb-7c3579fe51ee",
                        "entry_id": "c83c404f-f710-369e-af00-3f9f1315307a",
                        "glosses": [
                            "jemand, der regelmäßig in einer Wirtschaft sitzt und dabei viel Bier trinkt"
                        ],
                        "tags": [
                            "bayrisch",
                            "meist abwertend"
                        ],
                        "examples": [
                            {
                                "example_id": "ced0a5c3-e491-4b75-82c9-d8572d104292",
                                "sense_id": "6bd2ec72-2240-3474-8aeb-7c3579fe51ee",
                                "text": "„Wie? Ausgerechnet die rückständigen Münchner stürzten die Monarchie? Diese Bierdimpfel ließen es zu, dass ihre Stadt zu einer Probebühne für sozialistische Utopien wurde? Wie passt das zusammen?“"
                            },
                            {
                                "example_id": "94d686a2-800a-4a6c-ab41-a8f0eceba210",
                                "sense_id": "6bd2ec72-2240-3474-8aeb-7c3579fe51ee",
                                "text": "„Polts Humor stapft breit und behäbig daher, und die seufzende Quintessenz lautet, daß es immer weniger urige, bescheidene Bierdimpfel gibt, auch in Bayern.“"
                            },
                            {
                                "example_id": "633004f1-5c46-4bed-a87d-b4fa575dae40",
                                "sense_id": "6bd2ec72-2240-3474-8aeb-7c3579fe51ee",
                                "text": "„Viele Münchner Bierdimpfeln kennen ihn, den Traum:»Begebe dich nach Andechs!«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
