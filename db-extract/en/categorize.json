                        "cross_references": [
                            {
                                "target_word": "classer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "86cbccb2-a968-3613-8850-030aa9ddfd78",
                                        "entry_id": "c8991916-89c7-380c-b56a-985b9bdefdb5",
                                        "glosses": [
                                            "Ranger, distribuer par classes. Ranger des éléments suivant des critères ou des caractères communs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d9ad0ec-e9c6-46f2-a51f-484c654d5b6b",
                                                "sense_id": "86cbccb2-a968-3613-8850-030aa9ddfd78",
                                                "text": "Il procédait par l’observation, analysant et classant des faits (instantiæ Naturæ, comme on les désignait assez pédantesquement), et les transformant en lois générales."
                                            },
                                            {
                                                "example_id": "6bcf1267-52a5-4298-81ea-6d5573f6c3df",
                                                "sense_id": "86cbccb2-a968-3613-8850-030aa9ddfd78",
                                                "text": "Le safran est un produit agricole classé dans la famille des épices, 2012 Wikipedia"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e8b5701-99bd-301c-a6ef-15c55f9bcb4c",
                                        "entry_id": "c8991916-89c7-380c-b56a-985b9bdefdb5",
                                        "glosses": [
                                            "Mettre dans un certain ordre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "610aaf2e-17cc-4f0b-80dd-42202ddd392e",
                                                "sense_id": "1e8b5701-99bd-301c-a6ef-15c55f9bcb4c",
                                                "text": "Je classai tous les articles que j’avais gardés sur les sujets les plus divers : l’assassinat de Sharon Tate, un hôtel à la pointe du Raz, des interviews de Roy Orbison."
                                            },
                                            {
                                                "example_id": "9eab1d71-6eb1-4087-b3c4-3171c39de0b3",
                                                "sense_id": "1e8b5701-99bd-301c-a6ef-15c55f9bcb4c",
                                                "text": "Cet animal a été classé parmi les rongeurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8afdc11d-e44c-35d4-b3a1-0343dfd8e292",
                                        "entry_id": "c8991916-89c7-380c-b56a-985b9bdefdb5",
                                        "glosses": [
                                            "Assigner un rang."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a012fd45-9f5f-4404-aa2e-d5d1422f5639",
                                                "sense_id": "8afdc11d-e44c-35d4-b3a1-0343dfd8e292",
                                                "text": "Il est classé 123ᵉ au concours de l’X."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9c0463e-68b1-3e63-9ab6-df59077e2ad2",
                                        "entry_id": "c8991916-89c7-380c-b56a-985b9bdefdb5",
                                        "glosses": [
                                            "Assigner à un groupe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d319a3c4-c8c0-4e90-b75b-f268d358cf6f",
                                                "sense_id": "d9c0463e-68b1-3e63-9ab6-df59077e2ad2",
                                                "text": "A leurs doigts sans cal, brillent de belles bagues d'or ou d'argent. Au poignet, de grosses montres frimeuses et sophistiquées classent leurs propriétaires ; elles peuvent aussi donner l'heure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1aaaa30-be0d-3b38-9a29-21e50703cf13",
                                        "entry_id": "c8991916-89c7-380c-b56a-985b9bdefdb5",
                                        "glosses": [
                                            "Estimer, évaluer."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0b56711-924d-42de-bcfe-6b1211b9a2ed",
                                                "sense_id": "f1aaaa30-be0d-3b38-9a29-21e50703cf13",
                                                "text": "L’Iliade est classée parmi les chefs-d’œuvre de l’esprit humain.."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6fb6bfca-6488-38da-beaf-fcb282155aef",
                                        "entry_id": "c8991916-89c7-380c-b56a-985b9bdefdb5",
                                        "glosses": [
                                            "Laisser sans suite, abandonner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c449c555-5dc2-42d4-b545-371dd9bfdf66",
                                                "sense_id": "6fb6bfca-6488-38da-beaf-fcb282155aef",
                                                "text": "Ils ont classé l’affaire, le crime demeurera impuni."
                                            },
                                            {
                                                "example_id": "ea1c00ab-3b1c-44af-ada5-e67cfd752feb",
                                                "sense_id": "6fb6bfca-6488-38da-beaf-fcb282155aef",
                                                "text": "Un préfet nommé par Emmanuel Macron à la tête d’un service de police administrative du ministère de l’intérieur a personnellement classé une enquête concernant des prestations suspectes durant la campagne présidentielle du chef de l’État en 2017, et ce contre l’avis de trois de ses chefs et sous-directeurs qui réclamaient tous des poursuites administratives."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42159140-50dd-360b-af9d-3c4fa611e476",
                                        "entry_id": "c8991916-89c7-380c-b56a-985b9bdefdb5",
                                        "glosses": [
                                            "Avec valeur passive : être classé."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13793139-5a40-4e4e-b1a1-b6471de91a72",
                                                "sense_id": "42159140-50dd-360b-af9d-3c4fa611e476",
                                                "text": "Ses idées se classent, se groupent et se coordonnent"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77bb0d47-6b09-31ad-a2a3-c72232878416",
                                        "entry_id": "c8991916-89c7-380c-b56a-985b9bdefdb5",
                                        "glosses": [
                                            "Avec valeur passive : occuper une certaine position dans le classement d’un examen, d’une compétition."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f4e3359-c06e-40a5-abbb-32e6c40e456c",
                                                "sense_id": "77bb0d47-6b09-31ad-a2a3-c72232878416",
                                                "text": "Bjorn Borg s’est classé premier de l’ATP en 1979, 1980 et 1981.’'"
                                            },
                                            {
                                                "example_id": "0babe6c9-5545-4e76-aca9-38d382b5e88a",
                                                "sense_id": "77bb0d47-6b09-31ad-a2a3-c72232878416",
                                                "text": "Mon voisin s’est classé pour la demi-finale de pétanque individuelle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b316f40e-6593-48e2-8726-33476a0e3220",
                        "source_entry_id": "7ef64089-70e8-363d-97a1-9f9af1306c74",
                        "source_sense_id": "05bcc10b-2cfe-301d-9aae-9346fc31056b",
