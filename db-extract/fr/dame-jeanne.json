                        "examples": [
                            {
                                "example_id": "c3b6d985-5408-4675-af15-be639a942334",
                                "sense_id": "ccd83f2b-5cec-33c0-beb0-87e05b9c1888",
                                "text": "Les trois autres s'occupaient à décoiffer une énorme dame-jeanne de vin de Collioure; c'étaient les laquais de ces messieurs.",
                                "translation": "The three others were busy uncorking an enormous demijohn of Collioure wine; they were these gentlemen's lackeys.",
                                "english": "The three others were busy uncorking an enormous demijohn of Collioure wine; they were these gentlemen's lackeys."
                            },
                            {
                                "example_id": "a8f0e463-123d-45e5-bbd6-4446e169683e",
                                "sense_id": "ccd83f2b-5cec-33c0-beb0-87e05b9c1888",
                                "text": "[…] Seulement, le soir, après le dîner, on avait posé sur la table une dame-jeanne d'une cinquantaine de litres, qu'il s'agissait de vider, avant d'aller se mettre au lit. Ils étaient dix, et déjà le père Bambousse renversait d'une seule main la dame-jeanne, d'où ne coulait plus qu'un mince filet rouge.",
                                "translation": "[…] but, in the evening, after dinner, a demijohn of around fifty litres had been placed on the table, which they had set to emptying before going to bed. There were ten of them, and already old Bambousse knocked over the demijohn with one hand, and only a small red trickle came out.",
                                "english": "[…] but, in the evening, after dinner, a demijohn of around fifty litres had been placed on the table, which they had set to emptying before going to bed. There were ten of them, and already old Bambousse knocked over the demijohn with one hand, and only a small red trickle came out."
                            }
                        ]
                    }
