                        "entry_id": "9b9e7053-a3f8-37d0-a446-db1324ca096b",
                        "glosses": [
                            "A pattern that emerges when two grids are superimposed over one another, sometimes unintended or undesirable in many applications, such as in weaving, screenprinting, and halftoning."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "3c092464-3006-3e2e-beff-fcbecb92c3e8",
                        "entry_id": "9b9e7053-a3f8-37d0-a446-db1324ca096b",
                        "glosses": [
                            "A fabric, often silk, which has a watery or wavelike appearance."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "803aefaa-6793-4e12-9f5b-92ad7922ec5a",
                        "source_entry_id": "9b9e7053-a3f8-37d0-a446-db1324ca096b",
