                                                "example_id": "72a00484-7044-4758-9cde-1a982356e9ed",
                                                "sense_id": "875c6e7d-4622-3bd5-a2a9-4493cc38eae9",
                                                "text": "Tygrys natychmiast zamachnął się łapą. Tomek błyskawicznie zarzucił na nią pętlę arkanu. Drapieżnik niemal zwinął się w kabłąk, szarpnął liną, wtedy syn Nucziego uchwycił pętlą tylną nogę. Po chwili Wilmowski uwięził w ten sam sposób drugą przednią"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c2ae8303-39fb-4153-b235-1761a3c00cc5",
                        "source_entry_id": "36969421-482a-311a-885e-bf0bb4573cf4",
                        "source_sense_id": "0640e7ad-ec02-3a1a-8974-cdae02b40290",
                        "target_lang_word": "lasso",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lasso",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "84935cc6-a62f-31fa-ac3c-bb508460d0fc",
                                        "entry_id": "9ccf1f15-d8f1-36d2-a6ec-223931dd115a",
                                        "glosses": [
                                            "Longue lanière en forme de boucle dont se servent les gardiens de troupeaux, comme les cow-boys ou les gardians, pour s’emparer des chevaux, des bœufs sauvages, en la leur lançant autour du corps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e256dee8-c7e2-4f6d-a191-87f018ed00f7",
                                                "sense_id": "84935cc6-a62f-31fa-ac3c-bb508460d0fc",
                                                "text": "Tout en faisant cet aparté entre ses dents, le vaquero déroula le lasso qu’il portait attaché à sa ceinture et se mit à courir dans la direction du cavalier."
                                            },
                                            {
                                                "example_id": "c57e175b-fd59-49d5-9890-3c0aee6677ca",
                                                "sense_id": "84935cc6-a62f-31fa-ac3c-bb508460d0fc",
                                                "text": "Le commandant du dirigeable qui surveillait ce quartier essaya de faire arracher au lasso le drapeau hissé sur Morgan Hall."
                                            },
                                            {
                                                "example_id": "d72813e1-971a-4727-9338-eb8be2fbf5e1",
                                                "sense_id": "84935cc6-a62f-31fa-ac3c-bb508460d0fc",
                                                "text": "Plus loin, un jeune adolescent à cheval, vêtu d'un « poncho » aux brillantes couleurs avec le traditionnel lasso pendu à l'arçon de sa selle, me salua d'un « buenos dias »."
                                            },
                                            {
                                                "example_id": "6e4a02da-03b8-42e1-bf66-d2eee3d2a331",
                                                "sense_id": "84935cc6-a62f-31fa-ac3c-bb508460d0fc",
                                                "text": "Montons sur ce large bureau, allons, mes souvenirs de westerns! Comment attraper un plafonnier au lasso? Oups! Raté!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3c62c87-9237-39ba-a8a6-d8725cc1c96e",
                                        "entry_id": "9ccf1f15-d8f1-36d2-a6ec-223931dd115a",
                                        "glosses": [
                                            "Tout outil concret ou métaphorique permettant la capture matérielle ou la saisie conceptuelle de quelque objet physique ou mental."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26d15775-842c-4980-9cea-58832fb2a6f0",
                                                "sense_id": "b3c62c87-9237-39ba-a8a6-d8725cc1c96e",
                                                "text": "Je vous vois déjà venir avec votre sale logique qui prend au lasso les chevaux sauvages de l’imagination."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7030f0d2-3863-3b26-9b3a-106394ba1a15",
                                        "entry_id": "9ccf1f15-d8f1-36d2-a6ec-223931dd115a",
                                        "glosses": [
                                            "Structure intermédiaire formée lors de l’épissage de certains introns."
                                        ],
                                        "tags": [
                                            "Génétique"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
