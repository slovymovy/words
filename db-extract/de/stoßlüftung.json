                "senses": [
                    {
                        "sense_id": "e1b4708d-79c6-31b0-be8c-511ee166163f",
                        "entry_id": "45ef3618-c60d-3950-bcf7-79f242efbecb",
                        "glosses": [
                            "das Stoßlüften; Öffnen eines Fensters und kurzzeitige, intensive Lüftung des Raumes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "815ab0b4-dff5-4dba-bd83-c73a1b3babb4",
                                "sense_id": "e1b4708d-79c6-31b0-be8c-511ee166163f",
                                "text": "„Deutlich günstiger ist die Stoßlüftung über kurzzeitig weit geöffnete Fenster, idealerweise mit Durchzug.“"
                            },
                            {
                                "example_id": "0ece3c15-693f-4aba-ad5d-a84cb9d6418c",
                                "sense_id": "e1b4708d-79c6-31b0-be8c-511ee166163f",
                                "text": "„Bleibt das Fenster nachts geschlossen, sollten Sie nach dem Aufstehen mit weit geöffnetem Fenster lüften (Stoßlüftung).“"
                            },
                            {
                                "example_id": "7fcfcac3-56a9-456b-90d6-70d29f0461f3",
                                "sense_id": "e1b4708d-79c6-31b0-be8c-511ee166163f",
                                "text": "„Die Stoßlüftung ist ein kurzer Lüftungsvorgang mit raschem, intensiven Luftwechsel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
