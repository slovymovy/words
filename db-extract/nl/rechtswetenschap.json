                                        "examples": [
                                            {
                                                "example_id": "4206904e-08f5-47fe-9590-7753e4b2b9f8",
                                                "sense_id": "719fd93e-59c4-34d4-aea7-a74052b4383a",
                                                "text": "There is considerable jurisprudence to the effect that only the evidence that was before the initial decision-maker should be considered by the Court on judicial review."
                                            },
                                            {
                                                "example_id": "a5b5ca5a-4526-4d89-b10f-f95a0fabae0c",
                                                "sense_id": "719fd93e-59c4-34d4-aea7-a74052b4383a",
                                                "text": "The concept of consent can be complicated, so much so that it is the subject of considerable jurisprudence and a formal definition in the Criminal Code."
                                            }
                                        ]
                                    }
                                ]
                            }
