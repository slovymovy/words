                                "example_id": "1892ef7d-5792-4619-8b59-2c0497f97054",
                                "sense_id": "aa673b62-5bef-3897-a98b-a264aeab2cc3",
                                "text": "Hij gaf hem de garantie dat alle schade vergoed zou worden."
