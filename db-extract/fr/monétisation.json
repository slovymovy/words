                        "sense_id": "a44306ad-e462-31a6-9086-51dc635a2757",
                        "entry_id": "28802c68-2c85-30ea-b39e-31602651edb5",
                        "glosses": [
                            "Action de transformer en monnaie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c72a8b93-dc35-46c2-9a3d-5f600a561082",
                                "sense_id": "a44306ad-e462-31a6-9086-51dc635a2757",
                                "text": "Le commerce de l’or et de l’argent fut interdit sous peine de mort ; on réserva ces métaux, par un accaparement d’urgence, à la monétisation."
                            },
                            {
                                "example_id": "d7e39fef-62cf-4bd4-ad24-b0530895f07a",
                                "sense_id": "a44306ad-e462-31a6-9086-51dc635a2757",
                                "text": "Aujourd’hui c’est la vie qui est collectée, que ce soit votre sommeil ou votre poids, pour faire l’objet d’une monétisation continue."
                            }
                        ]
                    },
                    {
                        "sense_id": "4a16da0e-ec0c-37ef-b1d0-bdc0981c7eca",
                        "entry_id": "28802c68-2c85-30ea-b39e-31602651edb5",
                        "glosses": [
                            "Financement, transformation en source de gain financier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48b22441-5888-43fc-8cd9-52b6efaf507a",
                                "sense_id": "4a16da0e-ec0c-37ef-b1d0-bdc0981c7eca",
                                "text": "Framasoft s'est toujours positionné comme étant anti-pub. C'est pourquoi il n'y a pas de monétisation par la pub prévue pour l'instant."
                            }
                        ]
