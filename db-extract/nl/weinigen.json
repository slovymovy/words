                                    {
                                        "sense_id": "b55f02f9-c736-3ce1-90fd-9bff5f27f392",
                                        "entry_id": "87bb9603-49e9-3498-987d-b7d27c79fcdb",
                                        "glosses": [
                                            "An indefinite, but usually small, number of."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a791a6b-6a83-4121-a44f-b28dc8d9829c",
                                                "sense_id": "b55f02f9-c736-3ce1-90fd-9bff5f27f392",
                                                "text": "There are a few cars (=some, but a relatively small number) in the street."
                                            },
                                            {
                                                "example_id": "15c65b62-9f53-4e99-b666-da70a72d50d3",
                                                "sense_id": "b55f02f9-c736-3ce1-90fd-9bff5f27f392",
                                                "text": "Quite a few people (=a significant number) were pleasantly surprised."
                                            },
                                            {
                                                "example_id": "1a1a5f45-430e-448d-85b7-9d0f36665379",
                                                "sense_id": "b55f02f9-c736-3ce1-90fd-9bff5f27f392",
                                                "text": "I think he's had a few drinks."
                                            },
                                            {
                                                "example_id": "97a9ca77-5edf-4138-ab97-71326a93549c",
                                                "sense_id": "b55f02f9-c736-3ce1-90fd-9bff5f27f392",
                                                "text": "The few cheapest hotels I could find are the farthest too."
                                            },
                                            {
                                                "example_id": "01f73da1-8113-4db6-bcff-f81d6d3beae1",
                                                "sense_id": "b55f02f9-c736-3ce1-90fd-9bff5f27f392",
                                                "text": "No sooner has a [synthetic] drug been blacklisted than chemists adjust their recipe and start churning out a subtly different one. These “legal highs” are sold for the few months it takes the authorities to identify and ban them, and then the cycle begins again."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "225f9514-9d42-38bb-96bd-da176d396ee1",
                                        "entry_id": "87bb9603-49e9-3498-987d-b7d27c79fcdb",
                                        "glosses": [
                                            "Not many; a small (in comparison with another number stated or implied) but somewhat indefinite number of."
                                        ],
                                        "tags": [
                                            "used alone"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9e8f93a-8659-403f-8f6a-f646ec45e51c",
                                                "sense_id": "225f9514-9d42-38bb-96bd-da176d396ee1",
                                                "text": "Very few did she have not to go there, did she?"
                                            },
                                            {
                                                "example_id": "41ae4ca8-da26-45b6-8583-47447280de67",
                                                "sense_id": "225f9514-9d42-38bb-96bd-da176d396ee1",
                                                "text": "I was expecting a big crowd at the party, but very few people (=almost none) turned up."
                                            },
                                            {
                                                "example_id": "211c8fee-5eb3-4278-957e-0f35817aa200",
                                                "sense_id": "225f9514-9d42-38bb-96bd-da176d396ee1",
                                                "text": "Your men are valiant but their number few,\nAnd cannot terrifie his mightie hoſt, […]"
                                            },
                                            {
                                                "example_id": "ccd0fafb-25e9-4e20-b629-f18399d6118c",
                                                "sense_id": "225f9514-9d42-38bb-96bd-da176d396ee1",
                                                "text": "Already we're seeing fewer cache misses by avoiding creating cache entries for the idle task and expect to see even fewer with changes to the TLB reload code to uncache the page tables."
                                            },
                                            {
                                                "example_id": "cd349cfb-bddf-46ea-8690-c878912aa44b",
                                                "sense_id": "225f9514-9d42-38bb-96bd-da176d396ee1",
                                                "text": "However, the above passage could have been written more efficiently — if Strunkian concision, using the fewest words possible, is understood as the measure of verbal efficiency."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2d95ddc-bdcc-3f1c-8a17-8a4b9ccdf8df",
                                        "entry_id": "87bb9603-49e9-3498-987d-b7d27c79fcdb",
                                        "glosses": [
                                            "Obscuring one to two oktas (eighths) of the sky."
                                        ],
                                        "tags": [
                                            "of clouds"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e53e236-3ba5-480b-8382-077126096be0",
                                                "sense_id": "d2d95ddc-bdcc-3f1c-8a17-8a4b9ccdf8df",
                                                "text": "Tonight: A few clouds. Increasing cloudiness overnight."
                                            },
                                            {
                                                "example_id": "0840dc49-85cb-4753-a682-ffc0ff283a44",
                                                "sense_id": "d2d95ddc-bdcc-3f1c-8a17-8a4b9ccdf8df",
                                                "text": "NOAA definition of the term few clouds: An official sky cover classification for aviation weather observations, descriptive of a sky cover of 1/8 to 2/8. This is applied only when obscuring phenomena aloft are present--that is, not when obscuring phenomena are surface-based, such as fog."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73a6f468-8bcf-3ad2-9264-3251012648b7",
                                        "entry_id": "87bb9603-49e9-3498-987d-b7d27c79fcdb",
                                        "glosses": [
                                            "(US?) Having a 10 percent chance of measurable precipitation (0.01 inch); used interchangeably with isolated."
                                        ],
