                ],
                "senses": [
                    {
                        "sense_id": "2bfade0e-56d7-3b92-8d69-939b9fd5f783",
                        "entry_id": "91ea9fc7-d50f-30de-928f-60dbeda494c4",
                        "glosses": [
                            "fehlerhafte Zusammensetzung der vier Körpersäfte (gelbe und schwarze Galle, Blut und Schleim)"
                        ],
                        "tags": [
                            "historical",
                            "special"
                        ],
                        "examples": [
                            {
                                "example_id": "1acd3fb7-e60e-4317-b7d8-65472dc77c5b",
                                "sense_id": "2bfade0e-56d7-3b92-8d69-939b9fd5f783",
                                "text": "Man meinte, dass gegen Dyskrasien Schröpfen und Aderlass helfen wüden."
                            },
                            {
                                "example_id": "830c8aa2-269d-4ca4-944d-22a03c0b457f",
                                "sense_id": "2bfade0e-56d7-3b92-8d69-939b9fd5f783",
                                "text": "„Auch ist ihr Gebrauch in jenen Hautausschlägen, Verbildungen und Geschwülsten von grossem Nutzen, denen eine Dyskrasie der Säfte zum Grunde liegt, und die eine Neigung zur Colliquation und fauligen Degeneration offenbaren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5ac9936d-322e-3dd3-8233-fce2895c26d4",
                        "entry_id": "91ea9fc7-d50f-30de-928f-60dbeda494c4",
                        "glosses": [
                            "fehlerhafte Zusammensetzung von Blut und Körpersäften"
                        ],
                        "tags": [
                            "bis ca 1850 zu Virchows Zellularpathologie"
                        ],
                        "examples": [
                            {
                                "example_id": "3f5019e8-06f4-4046-9325-694a74bf5202",
                                "sense_id": "5ac9936d-322e-3dd3-8233-fce2895c26d4",
                                "text": "Eine Gerinnungsstörung des Blutes konnte man auch als Dyskrasie bezeichnen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
