                        ]
                    },
                    {
                        "translation_id": "45bc3fff-14b7-42e2-96e9-3a7a70e69628",
                        "source_entry_id": "222054a9-95d3-30f5-9822-504c6daf5698",
                        "source_sense_id": "bc05f0fb-107c-340d-9f59-f9a78ea888c3",
                        "source_sense_description": "Architektur, spätmittelalterlich: alternative Bezeichnung für den Lettner",
                        "target_lang_word": "chancel screen",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "046c2cf5-d927-4b00-8720-b926705f37d3",
                        "source_entry_id": "222054a9-95d3-30f5-9822-504c6daf5698",
                        "source_sense_id": "bc05f0fb-107c-340d-9f59-f9a78ea888c3",
                        "source_sense_description": "Architektur, spätmittelalterlich: alternative Bezeichnung für den Lettner",
                        "target_lang_word": "jube",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jube",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "26948fb4-9d11-35a6-8616-fbe07a49383c",
                                        "entry_id": "b4a4b767-637e-3655-bab5-2a95164c3a5a",
                                        "glosses": [
                                            "A type of gelatine-based confection; its ingredients and consistency vary between countries."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76829e45-4ee2-4cea-b29a-21200ff82b40",
                                                "sense_id": "26948fb4-9d11-35a6-8616-fbe07a49383c",
                                                "text": "As the scum forms on the top remove it, or the jubes will not be clear."
                                            },
                                            {
                                                "example_id": "1f86c25b-9420-4d14-b402-a639ba3bc89e",
                                                "sense_id": "26948fb4-9d11-35a6-8616-fbe07a49383c",
                                                "text": "[…]for example, barley sugar, menthol jubes, honey and glycerine jubes, eucalyptus jubes, voice jubes, &c)."
                                            },
                                            {
                                                "example_id": "0be13cda-feb2-4ed0-92d6-77e9ad39f998",
                                                "sense_id": "26948fb4-9d11-35a6-8616-fbe07a49383c",
                                                "text": "Unlike other jellies and jubes, which are made with gelatine, Pectin Jellies are made with natural pectin."
                                            },
                                            {
                                                "example_id": "e33214b2-9a87-405c-9929-245904f6adff",
                                                "sense_id": "26948fb4-9d11-35a6-8616-fbe07a49383c",
                                                "text": "Ros′s father′s main preoccupations in his nursing home were to have a box of man-sized tissues beside his bed and plenty of his favourite fruit-flavoured jubes beside the jumbo Kleenex."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "jube",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6218f5dd-fe4d-3129-a91e-bb076cef8bfb",
                                        "entry_id": "e7f6ca24-80ea-3bae-bd9e-9e1b7b7208d2",
                                        "glosses": [
                                            "Alternative spelling of jubé (rood screen)"
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1694a650-4008-4c9f-baa8-5d3780824aa9",
                                                "sense_id": "6218f5dd-fe4d-3129-a91e-bb076cef8bfb",
                                                "text": "1932, Henry Suzzallo, William Waite Beardsley, “Jube”, entry in The National encyclopedia, Volume 6, page 19,\nIn the 13th century the jube became primarily a screen enclosing the choir, […] ."
                                            },
                                            {
                                                "example_id": "bb80b980-d2d3-4b9c-9069-b4f31b6b256c",
                                                "sense_id": "6218f5dd-fe4d-3129-a91e-bb076cef8bfb",
                                                "text": "2009, Arthur Leon Imbert De Saint-Amand, The Duchess of Berry and the Court of Charles X, page 66,\nIn the middle of the nave was erected a magnificent jube, where the throne of Charles X. was placed."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "jube",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8f41e971-112d-3993-b6f9-53aaef1515d2",
                                        "entry_id": "7e47181e-e5b6-3373-a39c-fa46afd43d68",
                                        "glosses": [
                                            "An open drainage channel of a type common in Tehran."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49f40f91-a825-4440-b5aa-d199a7d6fce1",
                                                "sense_id": "8f41e971-112d-3993-b6f9-53aaef1515d2",
                                                "text": "The seasons in Tehran are colored with torpor.[…]Fear the narrow, icy streets with their treacherous jubes on either side."
                                            },
                                            {
                                                "example_id": "ba9509e4-f211-410a-98c7-8aba47712d24",
                                                "sense_id": "8f41e971-112d-3993-b6f9-53aaef1515d2",
                                                "text": "The existing provision for storm water drainage comprises lined open channels known locally as jubes. The jubes were originally constructed to perform the dual functions of surface water drainage and irrigation of roadside planting within the city."
                                            },
                                            {
                                                "example_id": "1d7c9adf-19d6-4327-a5dd-e8e2fbec33d4",
                                                "sense_id": "8f41e971-112d-3993-b6f9-53aaef1515d2",
                                                "text": "They merely didn′t comprehend that treated city tap water was safer than well or jube water. Moreover, we thought it was bizarre when we observed household servants in the affluent northside washing their villa′s dishes in the jubes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dbcffa79-7d93-40fc-a040-771a3a7f7297",
                        "source_entry_id": "222054a9-95d3-30f5-9822-504c6daf5698",
                        "source_sense_id": "bc05f0fb-107c-340d-9f59-f9a78ea888c3",
                        "source_sense_description": "Architektur, spätmittelalterlich: alternative Bezeichnung für den Lettner",
                        "target_lang_word": "jubé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jubé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b432d68a-6b58-3bdc-9775-93629c6562cf",
                                        "entry_id": "43de50a7-66ae-3328-9381-f719330b2213",
                                        "glosses": [
                                            "Tribune en forme de galerie, qui fait écran entre la nef et le chœur liturgique d’une église, du haut duquel était lu l’évangile. Les jubés sont surmontés d'une crucifixion."
                                        ],
                                        "tags": [
                                            "Avant le concile de Trente"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00251cb7-af05-414e-90d7-30a9431a52aa",
                                                "sense_id": "b432d68a-6b58-3bdc-9775-93629c6562cf",
                                                "text": "Au-dessus de la porte, où seraient les orgues, se tient un jubé pour les hommes, avec un escalier tournant qui retentit sous les sabots."
                                            },
                                            {
                                                "example_id": "3e01e541-69c2-4d24-a8b1-c1b19b96851d",
                                                "sense_id": "b432d68a-6b58-3bdc-9775-93629c6562cf",
                                                "text": "Un jubé extraordinairement riche et fouillé sépare l’église du chœur. Le chœur forme ainsi une seconde église plus intime, plus ornée et plus sainte."
                                            },
                                            {
                                                "example_id": "8f32ab69-4cfa-43c1-a4b9-1d02a45af87b",
                                                "sense_id": "b432d68a-6b58-3bdc-9775-93629c6562cf",
                                                "text": "Le bâtiment était grand et sombre : une importante chapelle conventuelle, abandonnée depuis un demi-siècle et qui, désaffectée, gardait toutes les apparences d'une église, avec ses fenêtres gothiques, ses vitraux colorés, ses hauts piliers de pierre grise, son jubé, ses galeries."
                                            },
                                            {
                                                "example_id": "e43e2b4f-e67d-41d1-9404-1bde2bda66cc",
                                                "sense_id": "b432d68a-6b58-3bdc-9775-93629c6562cf",
                                                "text": "À l'intérieur, quatre colonnes corinthiennes et les colonnettes cannelées du chancel supportent le jubé de bois, orné de panneaux en bas-relief polychrome."
                                            },
                                            {
                                                "example_id": "57c7b93b-9483-48fa-8db6-d9bfa28cf88c",
                                                "sense_id": "b432d68a-6b58-3bdc-9775-93629c6562cf",
                                                "text": "Il montrait l'emplacement où se trouveraient jubé, culot, ciborium et sacraire et émaillait ses explications de considérations historiques et architecturales concernant la particularité des voussures et l'atypie du déambulatoire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "770e88ce-5de1-38c5-84b2-752d3e20a23d",
                                        "entry_id": "43de50a7-66ae-3328-9381-f719330b2213",
                                        "glosses": [
                                            "La tribune d'orgue située dans le fond de la nef."
                                        ],
                                        "tags": [
                                            "Belgique",
                                            "Luxembourg",
                                            "Québec"
                                        ],
                                        "examples": []
