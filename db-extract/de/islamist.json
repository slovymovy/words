                                    {
                                        "sense_id": "ae8f5b2f-4141-37a6-89db-93be20e1d6e5",
                                        "entry_id": "cf8616a8-ee3c-3e0b-bb69-ec9e1aab007a",
                                        "glosses": [
                                            "Motivated by fundamentalist Muslim beliefs, particularly in the political sphere."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce55a4d2-dcc4-4b10-b9d6-d95ae7527b8c",
                                                "sense_id": "ae8f5b2f-4141-37a6-89db-93be20e1d6e5",
                                                "text": "I hope you good, loyal Americans understand that in the long run the Islamist extremists are going to win. Because you can't beat numbers, and you can't beat fanaticism—the willingness to die for an idea."
                                            },
                                            {
                                                "example_id": "514bb989-48f8-42d6-ae6e-1a577de84be5",
                                                "sense_id": "ae8f5b2f-4141-37a6-89db-93be20e1d6e5",
                                                "text": "In January, Boko Haram struck Fotokol, a Cameroonian town separated by only a bridge from Gambarou, Nigeria, a stronghold of the Islamist extremists. The attackers killed more than 400 people."
                                            }
                                        ]
