                            {
                                "target_lang_word": "папа",
                                "target_lang_sense_clarification": "наиболее употребительное, нейтральное"
                            },
                            {
                                "target_lang_word": "батя",
                                "target_lang_sense_clarification": "разговорное, фамильярное"
                            },
                            {
                                "target_lang_word": "отец",
                                "target_lang_sense_clarification": "формальное"
                            }
                        ],
                        "zh": [
                            {
