                "senses": [
                    {
                        "sense_id": "759c24d3-e935-3d6b-a842-9550a46f4ef1",
                        "entry_id": "cb9ef9e0-1485-39be-acef-6d85c30b9827",
                        "glosses": [
                            "waarvan de bladeren meer oppervlak hebben dan verwante soorten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9bce1ba8-2638-4c0e-8b08-1fbd3298df9d",
                                "sense_id": "759c24d3-e935-3d6b-a842-9550a46f4ef1",
                                "text": "De grootbladige soort, Rumex acetosa, is een veredelde vorm van de soort die overal in Europa in het wild groeit; de Franse soort is R. scutatus, met kleiner blad en volgens kenners fijner van smaak."
                            }
                        ]
                    },
                    {
                        "sense_id": "5cc5bd14-f924-3f52-a512-165624fa97c5",
                        "entry_id": "cb9ef9e0-1485-39be-acef-6d85c30b9827",
                        "glosses": [
                            "met bladeren die veel oppervlak hebben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c356370-28e4-4224-bc78-7c200d2364e8",
                                "sense_id": "5cc5bd14-f924-3f52-a512-165624fa97c5",
                                "text": "In gras herkent de computer onkruid als volgt: hij herkent de patronen tussen gewassen. Tussen grassprieten is die afstand klein. De computer telt deze afstanden. Als er een grootbladig onkruidgewas tussen zit, registreert de computer een onderbreking van dat patroon."
                            },
                            {
                                "example_id": "0753ccef-e27a-4b0b-b882-634f6bf20a21",
                                "sense_id": "5cc5bd14-f924-3f52-a512-165624fa97c5",
                                "text": "Hij toont grote koperen platen waarop grootbladige planten wegzinken in bruin en donkergoud."
                            }
                        ]
                    }
                ],
