                ],
                "senses": [
                    {
                        "sense_id": "99132e84-f264-34d0-988a-c1a632a6cd80",
                        "entry_id": "30bd8001-8c44-32df-894e-8b6287245658",
                        "glosses": [
                            "Monsieur, comme titre."
                        ],
                        "tags": [
                            "obsolete",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "8e9f3c4e-374e-4d5b-9532-0cd99962caa9",
                                "sense_id": "99132e84-f264-34d0-988a-c1a632a6cd80",
                                "text": "Par un usage général fort ancien, on a toléré certaines abréviations comme n’étant pas nuisibles, telles que celles de Mʳ ou sʳ pour Monsieur ou sieur ; Mᵉ pour maître ; Mᵐᵉ ou Dᵉ pour Madame ou dame ; MM. pour Messieurs ; fol., rᵒ, vᵒ, cᵉ, vol., nᵒ pour folio, recto, verso, case, volume, numéro ; led., lad., lesd. pour ledit, ladite et lesdits ou lesdites."
                            },
                            {
                                "example_id": "e25fc6e8-a236-4e06-8b2c-4f43ad639e06",
                                "sense_id": "99132e84-f264-34d0-988a-c1a632a6cd80",
                                "text": "En l’année 1669, il y eut une grande dissension entre Mʳ de la Noue et Mʳ de Baronval pour les honneurs de l’église."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "ab9e3a27-85a0-36b3-a915-27752c415698",
                "word": "Mr",
