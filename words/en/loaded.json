                },
                {
                    "sense_id": "f2ed5b06-8304-3ce3-9745-f30e6f333d9b",
                    "sense_definition": "Weighted or altered to produce a specific, usually unfair, result.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "biased",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gambler was caught playing with <w>loaded</w> dice in the casino.",
                            "target_lang_translations": {
                                "ru": "Игрока поймали за игрой <w>шулерскими</w> костями в казино.",
                                "zh": "那个赌徒在赌场里因使用<w>作弊</w>骰子被抓住了。"
                            }
                        },
                        {
                            "text": "It felt like the dice were <w>loaded</w> against us from the very beginning.",
                            "target_lang_translations": {
                                "ru": "Казалось, что кости были <w>подстроены</w> против нас с самого начала.",
                                "zh": "感觉就像从一开始，骰子就被<w>做了手脚</w>，对我们不利。"
                            }
                        }
                    ],
                    "synonyms": [
