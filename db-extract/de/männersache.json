                            {
                                "example_id": "4ffc0c85-64a5-407e-b172-00ff0ba01534",
                                "sense_id": "c0b793d7-7e37-3bee-8737-e2a4a5475b2e",
                                "text": "„In Nandgaon waren religiöse Angelegenheiten Männersache.“"
                            },
                            {
