                                        "examples": [
                                            {
                                                "example_id": "47e3b7f7-57a4-4b26-84c8-ed3bf7a9b207",
                                                "sense_id": "349521e0-c4f3-38d8-8d71-ef5a5a8b4f3b",
                                                "text": "„Ein Kibbuznik erhielt seine Kleidung aus dem kollektiven Fundus und nahm seine Mahlzeiten im gemeinsamen Speisesaal ein.[…]Als im Januar 1949 die erste Nationalversammlung (knesset) zusammentrat, waren dreiundzwanzig der hundertzwanzig Abgeordneten Kibbuzniks.[…]Der Lebensstandard eines Kibbuzniks wird heute bestimmt von seiner Leistung - ein schwerer Schlag gegen den inneren Zusammenhalt des Kollektivs.“"
                                            },
                                            {
                                                "example_id": "cef342c2-f32e-4d66-ad61-6821078f71c5",
                                                "sense_id": "349521e0-c4f3-38d8-8d71-ef5a5a8b4f3b",
                                                "text": "„Viele von ihnen wurden von den marxistischen Kibbuzniks der Hashomer Ha-Tza'ir gejagt, die ihre Häuser schnell und effizient plünderten und sprengten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
