                ],
                "senses": [
                    {
                        "sense_id": "5895a9a6-45a0-38f8-bb0f-57d829cf326c",
                        "entry_id": "38933d79-e19f-3153-852b-6e7b7281defb",
                        "glosses": [
                            "Einheit zur Angabe einer Differenz zwischen zwei Prozentsätzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e2766fc-3bfd-4b3e-a42e-7612ae6ba9f1",
                                "sense_id": "5895a9a6-45a0-38f8-bb0f-57d829cf326c",
                                "text": "Die Partei verlor fast fünf Prozentpunkte im Vergleich zur letzten Wahl."
                            },
                            {
                                "example_id": "99baf96e-297e-4bd1-8db1-2af2274aae5c",
                                "sense_id": "5895a9a6-45a0-38f8-bb0f-57d829cf326c",
                                "text": "„Ein Plus von fünf Prozentpunkten maß der stern-RTL-Wahltrend in den Tagen nach der Operation Neustart für die Sozialdemokraten; statt auf 21 kämen sie nun bundesweit auf 26 Prozent.“"
                            },
                            {
                                "example_id": "ebf2fb61-978a-4b7a-941f-2e54c057a26b",
                                "sense_id": "5895a9a6-45a0-38f8-bb0f-57d829cf326c",
                                "text": "Das Wachstum fällt in diesem Jahr um einen halben Prozentpunkt auf nur noch 1,5 Prozent."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3476d727-f107-432b-8fe0-b733b10764ff",
                        "source_entry_id": "38933d79-e19f-3153-852b-6e7b7281defb",
                        "source_sense_id": "5895a9a6-45a0-38f8-bb0f-57d829cf326c",
                        "source_sense_description": "Einheit zur Angabe einer Differenz zwischen zwei Prozentsätzen",
                        "target_lang_word": "percentage point",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "percentage point",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e8f2eb9e-ac37-3121-ac5d-e4322acfc06f",
                                        "entry_id": "159827cb-d3ea-3273-9221-0f18a7a25f05",
                                        "glosses": [
                                            "One hundredth of a given value, used to measure the difference between two percentages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15654be7-3095-4e7a-9746-8c9fe5498e00",
                                                "sense_id": "e8f2eb9e-ac37-3121-ac5d-e4322acfc06f",
                                                "text": "The difference between 20 percent and 30 percent is 10 percentage points, not 10 percent. In fact, an increase from 20 to 30 percent is an increase of 50 percent. Only if, for example, 20 percent of buyers choose a certain company's products in one year and 22 percent do so the next year, can one speak of an increase of 10 percent."
                                            },
                                            {
                                                "example_id": "449766c9-bbd3-4b06-9531-44fdc6456fde",
                                                "sense_id": "e8f2eb9e-ac37-3121-ac5d-e4322acfc06f",
                                                "text": "Economics is a messy discipline: too fluid to be a science, too rigorous to be an art. Perhaps it is fitting that economists’ most-used metric, gross domestic product (GDP), is a tangle too. GDP measures the total value of output in an economic territory. Its apparent simplicity explains why it is scrutinised down to tenths of a percentage point every month."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e2209857-9e75-4b47-9d24-cc90b9528619",
                        "source_entry_id": "38933d79-e19f-3153-852b-6e7b7281defb",
                        "source_sense_id": "5895a9a6-45a0-38f8-bb0f-57d829cf326c",
                        "source_sense_description": "Einheit zur Angabe einer Differenz zwischen zwei Prozentsätzen",
                        "target_lang_word": "point de pourcentage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "point de pourcentage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c658269c-32f8-34d0-924e-7d727b24d2f2",
                                        "entry_id": "7eebd6b6-7e76-3151-a8bb-7d1ab9282fa7",
                                        "glosses": [
                                            "Unité de la différence de deux pourcentages calculée par la soustraction des deux valeurs indiquées en pour cent. Par exemple, la différence entre 20 % et 30 % est de 10 points de pourcentage, non pas de 10 %."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c05ff9a-63bf-466b-a759-65c78c2bc21b",
                                                "sense_id": "c658269c-32f8-34d0-924e-7d727b24d2f2",
                                                "text": "La Cour juge approprié de baser le taux des intérêts moratoires sur le taux d’intérêt de la facilité de prêt marginal de la Banque centrale européenne majoré de trois points de pourcentage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
