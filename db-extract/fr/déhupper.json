                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "8792374b-4c06-4c1d-9ac7-17264dd04ed7",
                                "sense_id": "9b5177a2-1978-3c62-98d5-9f491c8ec3f6",
                                "text": "C’est une vieille fille du Midi. Une ancienne cocotte déhuppée qui a « fait » la guerre, de façon toute particulière il est vrai."
                            }
                        ]
