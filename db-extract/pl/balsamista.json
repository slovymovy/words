                            {
                                "example_id": "83ba9cfe-632d-4aa7-9063-97b9da7eeedb",
                                "sense_id": "2948b5ca-70d6-3197-85cf-2731ebdfbf00",
                                "text": "Tak przygotowaną mumię balsamiści włożą do drewnianej, zdobionej trumny w kształcie człowieka."
                            }
                        ],
