{
    "word_family": [
        "heavy",
        "heaviness"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "a81b2771-0c69-3395-b007-70195c92de27",
                    "sense_definition": "To a considerable degree or great extent.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The success of the project relies <w>heavily</w> on the support of local businesses.",
                            "target_lang_translations": {
                                "ru": "Успех проекта <w>сильно</w> зависит от поддержки местного бизнеса.",
                                "zh": "项目的成功<w>很大程度上</w>依赖于当地企业的支持。"
                            }
                        },
                        {
                            "text": "She was <w>heavily</w> involved in organizing the charity event last year.",
                            "target_lang_translations": {
                                "ru": "Она была <w>активно</w> вовлечена в организацию благотворительного мероприятия в прошлом году.",
                                "zh": "她去年<w>深度</w>参与了慈善活动的组织工作。"
                            }
                        }
                    ],
                    "synonyms": [
                        "greatly",
                        "extensively",
                        "profoundly",
                        "intensely",
                        "largely",
                        "strongly"
                    ],
                    "antonyms": [
                        "slightly",
                        "lightly",
                        "minimally"
                    ],
                    "common_phrases": [
                        "rely heavily on",
                        "heavily influenced",
                        "heavily involved",
                        "drink heavily"
                    ],
                    "target_lang_definitions": {
                        "ru": "В значительной степени или очень сильно.",
                        "zh": "在很大程度上或非常强烈地。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сильно",
                                "target_lang_sense_clarification": "очень, интенсивно"
                            },
                            {
                                "target_lang_word": "в значительной степени",
                                "target_lang_sense_clarification": "формально"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "很大程度上",
                                "target_lang_sense_clarification": "表示程度深"
                            },
                            {
                                "target_lang_word": "非常",
                                "target_lang_sense_clarification": "表示程度高"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "32a6da90-5245-365f-9792-d2d777180ecd",
                    "sense_definition": "With great weight, force, or impact.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was so tired that she sat down <w>heavily</w> on the sofa.",
                            "target_lang_translations": {
                                "ru": "Она так устала, что <w>тяжело</w> опустилась на диван.",
                                "zh": "她太累了，<w>重重地</w>坐在了沙发上。"
                            }
                        },
                        {
                            "text": "The large box fell <w>heavily</w> to the floor with a loud thud.",
                            "target_lang_translations": {
                                "ru": "Большая коробка <w>тяжело</w> упала на пол с громким стуком.",
                                "zh": "大箱子<w>沉重地</w>掉在地上，发出一声巨响。"
                            }
                        }
                    ],
                    "synonyms": [
                        "forcefully",
                        "weightily",
                        "ponderously",
                        "hard",
                        "solidly"
                    ],
                    "antonyms": [
                        "lightly",
                        "gently"
                    ],
                    "common_phrases": [
                        "fall heavily",
                        "land heavily",
                        "tread heavily",
                        "step heavily"
                    ],
                    "target_lang_definitions": {
                        "ru": "С большим весом, силой или шумом.",
                        "zh": "带有很大的重量、力度或冲击力。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тяжело",
                                "target_lang_sense_clarification": "с большим весом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "沉重地",
                                "target_lang_sense_clarification": "形容动作沉重"
                            },
                            {
                                "target_lang_word": "重重地",
                                "target_lang_sense_clarification": "形容力度大"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c82e2df-8511-3536-a7ce-bf11b6272613",
                    "sense_definition": "In a slow and laboured manner, especially referring to breathing.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The runner began to breathe <w>heavily</w> as he reached the top of the hill.",
                            "target_lang_translations": {
                                "ru": "Бегун начал <w>тяжело</w> дышать, когда добрался до вершины холма.",
                                "zh": "当跑步者到达山顶时，他开始<w>沉重地</w>喘气。"
                            }
                        },
                        {
                            "text": "He sighed <w>heavily</w> when he realized he had to start the work all over again.",
                            "target_lang_translations": {
                                "ru": "Он <w>тяжело</w> вздохнул, когда понял, что ему придётся начинать работу заново.",
                                "zh": "当意识到必须从头开始工作时，他<w>沉重地</w>叹了口气。"
                            }
                        }
                    ],
                    "synonyms": [
                        "laboriously",
                        "hard",
                        "deeply",
                        "loudly"
                    ],
                    "antonyms": [
                        "easily",
                        "lightly"
                    ],
                    "common_phrases": [
                        "breathe heavily",
                        "sigh heavily",
                        "pant heavily"
                    ],
                    "target_lang_definitions": {
                        "ru": "Медленно и с трудом (обычно о дыхании).",
                        "zh": "缓慢且费力地，通常指呼吸或叹气。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тяжело",
                                "target_lang_sense_clarification": "с трудом"
                            },
                            {
                                "target_lang_word": "с трудом",
                                "target_lang_sense_clarification": "прилагая усилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "沉重地",
                                "target_lang_sense_clarification": "形容呼吸或叹气"
                            },
                            {
                                "target_lang_word": "费力地",
                                "target_lang_sense_clarification": "形容动作吃力"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bcc911bf-710e-3506-b12c-4b2cb1b40ef8",
                    "sense_definition": "In a way that is thick, solid, or substantial in physical build or appearance.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The security guard was a <w>heavily</w> built man who looked very intimidating.",
                            "target_lang_translations": {
                                "ru": "Охранник был <w>плотно</w> сложенным мужчиной, который выглядел очень устрашающе.",
                                "zh": "保安是个<w>壮实</w>的男人，看起来非常吓人。"
                            }
                        },
                        {
                            "text": "His arms were <w>heavily</w> muscled from years of working at the construction site.",
                            "target_lang_translations": {
                                "ru": "Его руки были <w>сильно</w> накачаны из-за многолетней работы на стройке.",
                                "zh": "由于在建筑工地工作多年，他的手臂肌肉非常<w>结实</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "thickly",
                        "stoutly",
                        "solidly"
                    ],
                    "antonyms": [
                        "slenderly",
                        "slightly"
                    ],
                    "common_phrases": [
                        "heavily built",
                        "heavily muscled"
                    ],
                    "target_lang_definitions": {
                        "ru": "О человеке или предмете, имеющем крупное, плотное строение.",
                        "zh": "指人或物体体格粗壮、结实。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мощно",
                                "target_lang_sense_clarification": "о телосложении"
                            },
                            {
                                "target_lang_word": "плотно",
                                "target_lang_sense_clarification": "о фигуре"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "壮实",
                                "target_lang_sense_clarification": "形容体格"
                            },
                            {
                                "target_lang_word": "结实",
                                "target_lang_sense_clarification": "形容肌肉或体型"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4e204ea6-1149-3402-b9d2-59c3f4d84d48",
                    "sense_definition": "In a manner designed for heavy duty, protection, or combat.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers were <w>heavily</w> armed and ready for the mission.",
                            "target_lang_translations": {
                                "ru": "Солдаты были <w>тяжело</w> вооружены и готовы к выполнению задания.",
                                "zh": "士兵们<w>重型</w>武装，准备执行任务。"
                            }
                        },
                        {
                            "text": "The president traveled in a <w>heavily</w> armoured vehicle for safety.",
                            "target_lang_translations": {
                                "ru": "Президент передвигался в <w>тяжело</w> бронированном автомобиле ради безопасности.",
                                "zh": "为了安全，总统乘坐一辆<w>重型</w>装甲车出行。"
                            }
                        }
                    ],
                    "synonyms": [
                        "strongly",
                        "robustly"
                    ],
                    "antonyms": [
                        "lightly"
                    ],
                    "common_phrases": [
                        "heavily armed",
                        "heavily guarded",
                        "heavily fortified",
                        "heavily armoured"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оснащённый мощной защитой или вооружением.",
                        "zh": "指配备了重型武器或强力防护装备。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тяжело",
                                "target_lang_sense_clarification": "о вооружении или броне"
                            },
                            {
                                "target_lang_word": "сильно",
                                "target_lang_sense_clarification": "об укреплении"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "重型",
                                "target_lang_sense_clarification": "指装备级别"
                            },
                            {
                                "target_lang_word": "严密",
                                "target_lang_sense_clarification": "指防御程度"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}