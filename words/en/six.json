{
    "word_family": [
        "sixth",
        "sixteen",
        "sixty",
        "sixfold"
    ],
    "entries": [
        {
            "pos": "numeral",
            "senses": [
                {
                    "sense_id": "ceaccddc-c4c8-30f5-a8bc-5b24a6f7c557",
                    "sense_definition": "A numerical value equal to 6; the number following five and preceding seven.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "number",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child is <w>six</w> years old and just started primary school.",
                            "target_lang_translations": {
                                "ru": "Ребёнку <w>шесть</w> лет, и он только что пошёл в начальную школу."
                            }
                        },
                        {
                            "text": "I need to buy <w>six</w> eggs to finish baking this cake.",
                            "target_lang_translations": {
                                "ru": "Мне нужно купить <w>шесть</w> яиц, чтобы закончить печь этот торт."
                            }
                        }
                    ],
                    "common_phrases": [
                        "six years old",
                        "six eggs"
                    ],
                    "target_lang_definitions": {
                        "ru": "Число 6; количество, следующее за пятью и предшествующее семи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шесть",
                                "target_lang_sense_clarification": "кардинальное числительное 6 (количество)"
                            },
                            {
                                "target_lang_word": "шестеро",
                                "target_lang_sense_clarification": "собирательное числительное: «шестеро» (обычно о людях/одушевлённых)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "54e08b03-3e7c-3df5-af71-210aa62d71a0",
                    "sense_definition": "The time of day representing six o'clock.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The morning prayers begin at a quarter to <w>six</w> every day.",
                            "target_lang_translations": {
                                "ru": "Утренние молитвы каждый день начинаются в четверть <w>шестого</w>."
                            }
                        },
                        {
                            "text": "I usually wake up at <w>six</w> o'clock to go for a run.",
                            "target_lang_translations": {
                                "ru": "Обычно я просыпаюсь в <w>шесть</w> часов, чтобы пойти на пробежку."
                            }
                        }
                    ],
                    "common_phrases": [
                        "six o'clock",
                        "quarter to six"
                    ],
                    "target_lang_definitions": {
                        "ru": "Время суток — шесть часов (6:00)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шесть",
                                "target_lang_sense_clarification": "время: шесть часов (6:00)"
                            },
                            {
                                "target_lang_word": "шесть часов",
                                "target_lang_sense_clarification": "как «шесть часов» (о времени на циферблате)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6745cf32-8787-333a-a1bd-a1af73c60f5f",
                    "sense_definition": "A group or set consisting of six elements or people.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The protesters were organized in <w>sixes</w> to march through the city.",
                            "target_lang_translations": {
                                "ru": "Протестующих организовали в <w>шестёрки</w>, чтобы они прошли маршем через город."
                            }
                        },
                        {
                            "text": "At least <w>six</w> people are feared dead after the incident.",
                            "target_lang_translations": {
                                "ru": "После инцидента опасаются, что погибло как минимум <w>шесть</w> человек."
                            }
                        }
                    ],
                    "common_phrases": [
                        "in sixes",
                        "at least six"
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа или набор, состоящий из шести элементов (людей/предметов)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шестёрка",
                                "target_lang_sense_clarification": "группа/набор из шести предметов или людей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e84bc976-b659-3846-9d64-aa6bc45ea9e0",
                    "sense_definition": "The digit or figure 6.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "digit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The number on the door was a large brass <w>six</w>.",
                            "target_lang_translations": {
                                "ru": "Номером на двери была большая латунная <w>шестёрка</w>."
                            }
                        },
                        {
                            "text": "Make sure you write the <w>six</w> clearly so it is not confused with a zero.",
                            "target_lang_translations": {
                                "ru": "Убедись, что ты чётко пишешь <w>шестёрку</w>, чтобы её не спутали с нулём."
                            }
                        }
                    ],
                    "common_phrases": [
                        "number six"
                    ],
                    "target_lang_definitions": {
                        "ru": "Цифра (знак) 6."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шестёрка",
                                "target_lang_sense_clarification": "цифра 6; знак «6»"
                            },
                            {
                                "target_lang_word": "цифра шесть",
                                "target_lang_sense_clarification": "в нейтральной формулировке: «цифра 6»"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "003a4381-52dd-3b78-881d-3fd0745f4d71",
                    "sense_definition": "In cricket, a hit that crosses the boundary without bouncing, scoring six runs.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The batsman hit a <w>six</w> over the long-on boundary to win the match.",
                            "target_lang_translations": {
                                "ru": "Бэтсмен ударил <w>шестёрку</w> через границу в районе лонг-она и выиграл матч."
                            }
                        },
                        {
                            "text": "His impressive century featured twelve <w>sixes</w> and several boundaries.",
                            "target_lang_translations": {
                                "ru": "В его впечатляющей сотне было двенадцать <w>шестёрок</w> и несколько ударов за границу."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hit a six"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Common in cricket-playing regions"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В крикете: удар, при котором мяч пересекает границу поля без отскока и приносит 6 ранов (очков)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шестёрка",
                                "target_lang_sense_clarification": "крикет: удар на шесть (мяч улетает за границу без отскока)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5129408e-7866-35dc-b4e0-c787281841fa",
                    "sense_definition": "The area directly behind someone or something; the rear side.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pilot shouted to his wingman to watch his <w>six</w> during the dogfight.",
                            "target_lang_translations": {
                                "ru": "Пилот крикнул ведомому, чтобы тот прикрыл его <w>хвост</w> во время воздушного боя."
                            }
                        },
                        {
                            "text": "Don't worry about the intruders; I will cover your <w>six</w> while you move forward.",
                            "target_lang_translations": {
                                "ru": "Не беспокойся о нарушителях: я прикрою твой <w>хвост</w>, пока ты продвигаешься вперёд."
                            }
                        }
                    ],
                    "common_phrases": [
                        "watch your six",
                        "cover my six"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Military and aviation origin"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Пространство прямо позади кого-либо/чего-либо; задняя сторона (в военном и авиационном жаргоне)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шесть",
                                "target_lang_sense_clarification": "авиац./воен. сленг: задняя полусфера, «сзади» (как на циферблате)"
                            },
                            {
                                "target_lang_word": "хвост",
                                "target_lang_sense_clarification": "разг.: «хвост», то есть прямо сзади"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "c208c4a9-9f7c-3c2a-9c01-f6f9fcf8ba58",
                    "sense_definition": "An abbreviation for MI6, the British secret intelligence service.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "organization",
                    "name_type": "organization_name",
                    "examples": [
                        {
                            "text": "He claimed to be working for <w>Six</w> on a top-secret mission in Europe.",
                            "target_lang_translations": {
                                "ru": "Он утверждал, что работает на <w>МИ-6</w> в рамках сверхсекретной миссии в Европе."
                            }
                        },
                        {
                            "text": "The novel describes the inner workings of <w>Six</w> during the Cold War.",
                            "target_lang_translations": {
                                "ru": "В романе описывается внутренняя работа <w>МИ-6</w> во времена холодной войны."
                            }
                        }
                    ],
                    "synonyms": [
                        "MI6"
                    ],
                    "common_phrases": [
                        "working for Six"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used within intelligence circles or fiction"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Разговорное/условное обозначение MI6 — британской Секретной разведывательной службы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "МИ-6",
                                "target_lang_sense_clarification": "разг. обозначение британской разведслужбы MI6 (внутри сообщества/в художественных текстах)"
                            },
                            {
                                "target_lang_word": "Шесть",
                                "target_lang_sense_clarification": "калька прозвища: «Шесть» (как название организации в тексте)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "10f80701-75e2-36de-b221-c80ab95966c0",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Six</w> was invited to the gala as a guest of honor.",
                            "target_lang_translations": {
                                "ru": "Мистера <w>Сикса</w> пригласили на гала-вечер в качестве почётного гостя."
                            }
                        },
                        {
                            "text": "The family history of the <w>Sixes</w> can be traced back several centuries.",
                            "target_lang_translations": {
                                "ru": "Историю семьи <w>Сиксов</w> можно проследить на протяжении нескольких столетий."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Rare family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Сикс",
                                "target_lang_sense_clarification": "фамилия (передача по-русски обычно транслитерацией)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}