                                        "entry_id": "b1a4f2fd-04cc-3f9e-ae29-887ad4d399f1",
                                        "glosses": [
                                            "Madero o barra resistente que se fija en posición inclinada en algún lugar para asegurar o sostener un muro, pared, etc., de una estructura o edificio que puede derrumbarse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7a22364-f264-4bd6-a64a-3eaa64771e34",
                                                "sense_id": "a0204446-efd9-327f-a8a9-58d94f02b602",
                                                "text": "Este día me puse manos a la obra y coloqué dos puntales o estacas bajo el techo de la cueva y dos tablas cruzadas sobre cada uno."
                                            }
                                        ],
