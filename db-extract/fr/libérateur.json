                            {
                                "target_word": "freeing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d10bca9f-705d-3219-b8f0-e2df02d50927",
                                        "entry_id": "91dc6d61-e14d-3eec-9ea8-d61954a96cc1",
                                        "glosses": [
                                            "The act of making something free; liberation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8126e679-d060-41db-9ef5-802daf4b7abd",
                                                "sense_id": "d10bca9f-705d-3219-b8f0-e2df02d50927",
                                                "text": "However again, in these freeings of voices it should be observed that the African American Southern voice and character is framed within the freed European American Southern voice."
                                            },
                                            {
                                                "example_id": "4fac760b-1077-4af4-a079-c54a755c9eb1",
                                                "sense_id": "d10bca9f-705d-3219-b8f0-e2df02d50927",
                                                "text": "The freeing of funding from a never-ending pipeline of expensive road schemes is going to happen over time, and will allow mult-modal schemes to be funded first."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "freeing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4945692c-eb1e-3c30-a621-ee3be726ed30",
                                        "entry_id": "ce3525ac-22fd-3c4b-95c2-4fbe1a5d7af3",
                                        "glosses": [
                                            "Making one free; causing someone to experience freedom."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81c76b0b-4392-4bf9-86f0-574c034cae47",
                                                "sense_id": "4945692c-eb1e-3c30-a621-ee3be726ed30",
                                                "text": "Reimagining a ’90s-style “cool” Marvel bad guy as a Universal Monster-style antihero is a great, potentially freeing idea for a superhero picture, providing the opportunity to connect otherwise disparate eras of comics and genre movies."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
