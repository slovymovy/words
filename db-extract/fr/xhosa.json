        "fr-extract.jsonl": [
            {
                "entry_id": "d921dc08-9a0d-3e17-b83d-789fea36726a",
                "word": "xhosa",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1a5243b1-7064-482a-9c88-93e211e5b6b0",
                        "entry_id": "d921dc08-9a0d-3e17-b83d-789fea36726a",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "xhosas"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "46b6ff81-245f-3a08-b7aa-d1f62f384b8d",
                        "entry_id": "d921dc08-9a0d-3e17-b83d-789fea36726a",
                        "glosses": [
                            "Qui concerne les Xhosas, peuple d’Afrique du Sud."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd43c164-555d-4dc6-a865-ebd98789cc44",
                                "sense_id": "46b6ff81-245f-3a08-b7aa-d1f62f384b8d",
                                "text": "Elle garda le billet et donna les roses à l’infirmière xhosa qui, depuis trois jours, la chouchoutait."
                            },
                            {
                                "example_id": "d4be5dbe-3afd-4989-970d-bbaf1fdf563e",
                                "sense_id": "46b6ff81-245f-3a08-b7aa-d1f62f384b8d",
                                "text": "Contestations, razzias et contre-razzias, périodes de calme ; déplacements incessants de frontière de part et d’autre de plusieurs rivières ; affrontements des fermiers boers et des éleveurs xhosas, des Anglais (parfois) et Xhosas, des Boers du Grand Trek et de certains clans xhosas, matabélés et zoulous ; tous ces événements se succédèrent jusqu’au milieu du XIXᵉ siècle, fin des guerres de frontière que furent ces nombreuses « guerres cafres »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3c89f30a-457b-480b-90a8-b9a631551a78",
                        "source_entry_id": "d921dc08-9a0d-3e17-b83d-789fea36726a",
                        "source_sense_id": "46b6ff81-245f-3a08-b7aa-d1f62f384b8d",
                        "target_lang_word": "Xhosa",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Xhosa",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a6628879-6921-3f33-b265-decf16c57fc7",
                                        "entry_id": "b7a909ba-7a9c-33b7-98d3-ab242adba7de",
                                        "glosses": [
                                            "Any member of a Bantu people from South Africa, most of whom live in the Eastern Cape."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2bcf376-1dae-4186-9dce-2e1eb97e93d9",
                                                "sense_id": "a6628879-6921-3f33-b265-decf16c57fc7",
                                                "text": "my father remained aloof from Christianity and instead reserved his own faith for the great spirit of the Xhosas, Qamata, the God of his fathers."
                                            },
                                            {
                                                "example_id": "2b799402-ca61-406f-a61e-8c4c1789f2d8",
                                                "sense_id": "a6628879-6921-3f33-b265-decf16c57fc7",
                                                "text": "In many Xhosa households, Wednesday is umngqusho day. It's the way we all grew up. Like Fridays in the Eastern Cape are always dumplings with meat day."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a505cc2f-c21d-3090-8998-6cc42f6b26dc",
                                        "entry_id": "b7a909ba-7a9c-33b7-98d3-ab242adba7de",
                                        "glosses": [
                                            "The language of these people, a Bantu language related to Zulu."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc5d8a94-1383-417a-9222-f0cec0b53b3c",
                                                "sense_id": "a505cc2f-c21d-3090-8998-6cc42f6b26dc",
                                                "text": "“With the food packages that we drop off, we are adding messages in the local dialect of Xhosa, because this is predominately for the Xhosa areas,” Kolisi said."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
