                    "frequency": "High",
                    "semantic_group_id": "textile",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après la lessive, elle a étendu le <w>linge</w> propre dans le jardin pour le faire sécher."
                        },
                        {
                            "text": "Il faut ramasser le <w>linge</w> sale qui traîne dans la chambre avant de passer l'aspirateur."
                        }
                    ],
                    "common_phrases": [
                        "linge de maison",
                        "linge propre",
                        "linge sale",
                        "étendre le linge"
                    ]
                },
                {
                    "sense_id": "fb5c5114-de65-34b0-81d7-bd81b81d45ce",
                    "sense_definition": "Morceau de tissu utilisé pour essuyer, frotter ou nettoyer une surface.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "chiffon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a passé un <w>linge</w> humide sur la table de la cuisine pour enlever les taches."
                        },
                        {
                            "text": "Utilisez un <w>linge</w> doux pour nettoyer la vitre sans laisser de traces."
                        }
                    ],
                    "synonyms": [
                        "chiffon",
                        "torchon"
                    ],
                    "common_phrases": [
