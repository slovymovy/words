                    "sense_id": "c7e01777-beda-396a-b9c0-7c37c766bc9a",
                    "sense_definition": "форма предложного падежа единственного числа мужского или среднего рода прилагательного <w>целый</w>",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы мечтали о <целом> месяце отдыха на море.",
                            "target_lang_translations": {
                                "en": "We dreamed of a <w>whole</w> month of rest by the sea.",
                                "zh": "我们梦想着在海边度过<w>整个</w>月的假期。"
                            }
                        },
                        {
                            "text": "На <целом> свете нет человека добрее моей бабушки.",
                            "target_lang_translations": {
                                "en": "There is no person in the <w>whole</w> world kinder than my grandmother.",
                                "zh": "在<w>整个</w>世界上，没有比我奶奶更善良的人了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "в целом мире",
                        "на целом свете"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "prepositional case"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Prepositional case form of the adjective meaning entire, complete, or intact",
                        "zh": "形容词“整个的”、“全部的”的介词格形式"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "whole",
