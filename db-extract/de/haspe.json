                        "target_lang_word": "hinge",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hinge",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "da85d428-ecd2-3164-8c69-8cc89d6c4aaa",
                                        "entry_id": "b70effe2-1f5d-32e9-9dc4-251d06aa448e",
                                        "glosses": [
                                            "A jointed or flexible device that allows the pivoting of a door etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0dcee306-0c5d-4548-9222-e87c9d4a82ee",
                                                "sense_id": "da85d428-ecd2-3164-8c69-8cc89d6c4aaa",
                                                "text": "The massy portals of the churches swung creaking on their hinges; and some lay dead on the pavement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "300c8627-3660-3648-ba95-4a0133fbe6fa",
                                        "entry_id": "b70effe2-1f5d-32e9-9dc4-251d06aa448e",
                                        "glosses": [
                                            "A naturally occurring joint resembling such hardware in form or action, as in the shell of a bivalve."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8d116ba-db11-44b5-a046-5426e0ce3383",
                                                "sense_id": "300c8627-3660-3648-ba95-4a0133fbe6fa",
                                                "text": "The pedicel of the pollinium is articulated as before by a hinge to the disc; it can move freely only in one direction owing to one end of the disc being upturned."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3cf6966a-69e4-301d-903b-ab5b9769ece5",
                                        "entry_id": "b70effe2-1f5d-32e9-9dc4-251d06aa448e",
                                        "glosses": [
                                            "A stamp hinge, a folded and gummed paper rectangle for affixing postage stamps in an album."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bdb3815a-6a2c-3299-ae25-cdd89ed23cbd",
                                        "entry_id": "b70effe2-1f5d-32e9-9dc4-251d06aa448e",
                                        "glosses": [
                                            "A principle, or a point in time, on which subsequent reasonings or events depend."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "caeae835-fb45-496b-9633-d8af3bceff29",
                                                "sense_id": "bdb3815a-6a2c-3299-ae25-cdd89ed23cbd",
                                                "text": "This argument was the hinge on which the question turned."
                                            },
                                            {
                                                "example_id": "a4ddcc1e-cf80-4f94-8e81-f32ddb04037b",
                                                "sense_id": "bdb3815a-6a2c-3299-ae25-cdd89ed23cbd",
                                                "text": "But let me say, with all deference, that these positions do not appear to me to touch the hinge of the argument before us."
                                            },
                                            {
                                                "example_id": "59c798a0-e901-4906-b9de-cede70db7842",
                                                "sense_id": "bdb3815a-6a2c-3299-ae25-cdd89ed23cbd",
                                                "text": "These grown-up children were at that hinge of life when parents must begin to shrink and fold."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1e56107-8ca2-3122-8798-70d107d4e9f4",
                                        "entry_id": "b70effe2-1f5d-32e9-9dc4-251d06aa448e",
                                        "glosses": [
                                            "The median of the upper or lower half of a batch, sample, or probability distribution."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d7c446f5-587b-380a-9fb7-1df7737b45f3",
                                        "entry_id": "b70effe2-1f5d-32e9-9dc4-251d06aa448e",
                                        "glosses": [
                                            "One of the four cardinal points, east, west, north, or south."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3cea7991-77f0-4761-a6b8-feba703f6604",
                                                "sense_id": "d7c446f5-587b-380a-9fb7-1df7737b45f3",
                                                "text": "If when the Moon is in the Hinge at East, / The Birth breaks forward from its native rest; / Full Eighty Years, if you two Years abate, / This Station gives, and long defers its Fate"
                                            },
                                            {
                                                "example_id": "c9b8fb1b-2adf-47a5-8d9b-b9a59cc8649e",
                                                "sense_id": "d7c446f5-587b-380a-9fb7-1df7737b45f3",
                                                "text": "In ruine reconcil'd: nor slept the winds / Within thir stony caves, but rush'd abroad / From the four hinges of the world, and fell"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae43a0d4-f355-36c6-80cb-a1292207c45f",
                                        "entry_id": "b70effe2-1f5d-32e9-9dc4-251d06aa448e",
                                        "glosses": [
                                            "A movement that presents itself as rotation when an off-centre fixed point is taken into account."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0e54e6bc-47d7-3845-a7be-59cbb8d3f171",
                                        "entry_id": "b70effe2-1f5d-32e9-9dc4-251d06aa448e",
                                        "glosses": [
                                            "In polyamory, a person connected emotionally or sexually to two others who are not connected to each other."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dba8180b-480d-34ca-809b-2ff05d123ad6",
                                        "entry_id": "b70effe2-1f5d-32e9-9dc4-251d06aa448e",
                                        "glosses": [
                                            "To be in poor health; to be out of sorts."
                                        ],
