                                    },
                                    {
                                        "sense_id": "4b213bf4-a8a6-3664-9132-15f479cab091",
                                        "entry_id": "8af775bd-8479-391d-9318-3144974828aa",
                                        "glosses": [
                                            "wissenschaftliches Schema mit sämtlichen Aussagen"
