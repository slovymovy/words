                        "entry_id": "3a9d465f-d328-3215-b387-95a0f807056c",
                        "glosses": [
                            "relacja między wyrazem o treści bardzo szczegółowej i zakresie węższym a wyrazem o treści bardziej ogólnej i szerszym zakresie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82e0adcc-edc1-40f7-bd0e-851e037d0ab5",
                                "sense_id": "7e92e9db-1cd6-33a4-9fc2-2b2a495d0c7b",
                                "text": "Semantyczna podrzędność jednego leksemu względem drugiego nazywamy hiponimią."
                            }
