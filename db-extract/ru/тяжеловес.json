                                "target_senses": [
                                    {
                                        "sense_id": "9d2ec8b0-2828-3f9a-9570-4bb5d3fc96af",
                                        "entry_id": "0f16e8ab-69b4-3be4-a864-cd2d84bf0a94",
                                        "glosses": [
                                            "Véhicule automobile de plus de 3,5 tonnes, conçu pour le transport de marchandises ; camion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a511a7d-a960-4206-a3b8-c6502d272809",
                                                "sense_id": "9d2ec8b0-2828-3f9a-9570-4bb5d3fc96af",
                                                "text": "L’État a choisi le dossier Cofiroute et son tunnel de dix kilomètres à deux niveaux de circulation superposés réservé aux seuls véhicules légers : les poids lourds n’emprunteront pas l'ouvrage, ils auront le leur."
                                            },
                                            {
                                                "example_id": "d4991785-c13d-4a42-9f98-44c510bd1a91",
                                                "sense_id": "9d2ec8b0-2828-3f9a-9570-4bb5d3fc96af",
                                                "text": "Hier, aux alentours de 18 heures, un accident s’est produit sur l’autoroute A63 au niveau de Labouheyre, dans les Landes entre une voiture et un poids lourd."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "356bbd25-e83c-3687-a9fe-f011a094212e",
                                        "entry_id": "0f16e8ab-69b4-3be4-a864-cd2d84bf0a94",
                                        "glosses": [
                                            "Catégorie pour les athlètes plus lourds que la moyenne."
                                        ],
                                        "tags": [
                                            "Sports de combat"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c3923866-af71-3520-a204-adb245d25284",
