                "senses": [
                    {
                        "sense_id": "b3a87a90-6300-3227-9406-cde04132726f",
                        "entry_id": "64c8802d-838b-30ef-8ff4-25829e1ad943",
                        "glosses": [
                            "Qui se rapporte à l’étude des propriétés des sols et des roches ainsi qu’à leurs interactions avec les ouvrages de construction."
                        ],
                        "tags": [
                            "Génie civil"
                        ],
                        "examples": [
                            {
                                "example_id": "5a59651c-1b9e-47cc-8922-a100063f492a",
                                "sense_id": "b3a87a90-6300-3227-9406-cde04132726f",
                                "text": "Cette entreprise, spécialisée en génie des sols, des matériaux et de l’environnement, agissait comme sous-traitant et elle était responsable de l’étude géotechnique des sols."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "1b422d65-4177-3ba8-b700-1fd5305c642a",
                "word": "géotechnique",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ceabf720-bd91-429e-9953-e6756c49c9ab",
                        "entry_id": "1b422d65-4177-3ba8-b700-1fd5305c642a",
                        "tags": [
                            "plural"
                        ],
