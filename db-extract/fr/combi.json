                            "Congo-Kinshasa"
                        ],
                        "examples": [
                            {
                                "example_id": "50da11bb-bc56-4573-b3ea-fe4a9817603a",
                                "sense_id": "96185801-edb1-36b1-bcf0-f067f6a7a022",
                                "text": "Lors d’une course-poursuite, les voleurs ont endommagé plusieurs voitures stationnées et provoqué une collision avec un combi de police, a indiqué mardi le parquet de Bruxelles."
                            },
                            {
                                "example_id": "2819b7f5-e22e-43be-916d-b525b0d4da18",
                                "sense_id": "96185801-edb1-36b1-bcf0-f067f6a7a022",
                                "text": "La pluie qui s’est abattue le samedi dernier dans la capitale, à causer d’importants dégâts matériels et humains, où un gros et géant arbre de la famille des eucalyptus s’est écrasé sur un combi."
                            }
                        ]
                    }
