                        "entry_id": "6e13c00b-a6da-3478-bf1e-23f8d11310fd",
                        "glosses": [
                            "geld dat werkende vrouwen ontvangen tijdens hun zwangerschapsverlof"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f73303a2-c3f6-4462-b2d6-97316928d74a",
                                "sense_id": "5de969e9-7377-3270-9562-954f2a583cb0",
                                "text": "Vrouwelijke zzp'ers die belasting hebben betaald over hun zwangerschapsuitkering, kunnen de fiscus vragen hun aanslag te verminderen. Staatssecretaris Frans Weekers (Financiën) antwoordt dat op vragen van de Tweede Kamerfractie van GroenLinks."
                            },
                            {
                                "example_id": "6e4d5e8a-0f4d-4e4c-996f-28baed198816",
                                "sense_id": "5de969e9-7377-3270-9562-954f2a583cb0",
                                "text": "Het UWV heeft meer dan 18.000 aanvragen binnengekregen van vrouwelijke ondernemers voor een compensatie van hun niet verkregen zwangerschapsuitkering."
                            },
                            {
                                "example_id": "8ce2cb08-44ef-4b1e-8609-70ec139476fb",
                                "sense_id": "5de969e9-7377-3270-9562-954f2a583cb0",
                                "text": "De ministerraad heeft vrijdag het licht op groen gezet voor de stijging van de zwangerschapsuitkering voor zelfstandigen. Ook zelfstandigen die adoptieverlof nemen, zullen hun uitkering zien toenemen."
                            }
                        ]
                    }
