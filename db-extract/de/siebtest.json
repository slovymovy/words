                ],
                "senses": [
                    {
                        "sense_id": "4bede712-eb83-3285-8a4d-426a9f329a91",
                        "entry_id": "42c05584-5c62-36b8-b10f-20abe3839bba",
                        "glosses": [
                            "grobes Verfahren, um die möglicherweise Betroffenen einzugrenzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37165ddd-4b4f-4c58-8baf-af714e4cd7dd",
                                "sense_id": "4bede712-eb83-3285-8a4d-426a9f329a91",
                                "text": "„Es handelt sich folglich um ein Verfahren der Rasterung bzw. um einen Siebtest, um aus einem möglichst großen Ausschnitt der Grundgesamtheit diejenigen Akteure zu identifizieren, die der untersuchten Merkmalsgruppe angehören.“"
                            },
                            {
                                "example_id": "f2eac22f-a9d0-46b2-b127-a9d9b1456e29",
                                "sense_id": "4bede712-eb83-3285-8a4d-426a9f329a91",
                                "text": "„Ein Siebtest muß keine endgültige Diagnose liefern.“"
                            },
                            {
                                "example_id": "2841104a-3700-4eb9-909d-1269247cf531",
                                "sense_id": "4bede712-eb83-3285-8a4d-426a9f329a91",
                                "text": "„Ein Screening ist ein ‚Siebtest‘ und folgt erstmals 1968 von der WHO benannten Kriterien, welche als Grundlage für die Etablierung bevölkerungsbasierter Screeninguntersuchungen zu sehen sind […].“"
                            },
                            {
                                "example_id": "2a9faeff-2a07-4f68-8345-090e8d236355",
                                "sense_id": "4bede712-eb83-3285-8a4d-426a9f329a91",
                                "text": "„Eines der wichtigsten Anwendungsgebiete von OAE-Messungen ist das Neugeborenen-Hörscreening als Siebtest zur Früherkennung angeborener kindlicher Hörstörungen.“"
                            },
                            {
                                "example_id": "29ceda15-9f7b-4327-a473-e0cfc713d433",
                                "sense_id": "4bede712-eb83-3285-8a4d-426a9f329a91",
                                "text": "„Wesentlicher als diese biochemischen Siebteste erscheinen uns für eine umfangreiche Harnsteinprophylaxe allgemeine Maßnahmen, von denen einige aufzuzählen sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
