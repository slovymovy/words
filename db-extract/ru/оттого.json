                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8ccdf62-f749-42cc-98b4-96a7df2c5c49",
                                                "sense_id": "db5dd9b9-3894-3677-93df-c6b66aec3e58",
                                                "text": "Ich werde darum kämpfen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f36c613b-f36a-4c8a-b6da-4d989fc59932",
                        "source_entry_id": "f2036b68-fea9-3759-9c79-027989073f58",
