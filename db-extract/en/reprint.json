                ],
                "senses": [
                    {
                        "sense_id": "e4a50692-dfa8-36e0-81cd-1fc06e7e389d",
                        "entry_id": "9a739f39-60b4-3210-ba8d-111d016bdcc6",
                        "glosses": [
                            "A book, pamphlet or other printed matter that has been published once before but is now being released again."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "745d2a71-63e9-4ea1-8914-2e6e0e969696",
                                "sense_id": "e4a50692-dfa8-36e0-81cd-1fc06e7e389d",
                                "text": "The reprint is much less expensive than a first edition."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d48d3c25-537e-4f1f-922f-c89b41137645",
                        "source_entry_id": "9a739f39-60b4-3210-ba8d-111d016bdcc6",
                        "source_sense_id": "e4a50692-dfa8-36e0-81cd-1fc06e7e389d",
                        "source_sense_description": "printed matter that has been published before but is now being released again",
                        "target_lang_word": "Neuauflage",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Neuauflage",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "12cbb78d-cd5d-3b7a-b85d-6f4da99eb1af",
                                        "entry_id": "a6d6f026-56f8-37fd-a7e4-0de79f1af96b",
                                        "glosses": [
                                            "nochmalige Auflage eines bereits hergestellten Druckwerkes"
                                        ],
                                        "tags": [
                                            "Verlagswesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3191dbd1-669c-4d98-aa5d-1d9be9262c64",
                                                "sense_id": "12cbb78d-cd5d-3b7a-b85d-6f4da99eb1af",
                                                "text": "Aufgrund der großen Nachfrage erfolgt die Neuauflage des Buches."
                                            },
                                            {
                                                "example_id": "cf7b961d-7d80-41f6-bee4-f64f349adb04",
                                                "sense_id": "12cbb78d-cd5d-3b7a-b85d-6f4da99eb1af",
                                                "text": "„Dass seine Arbeit bis heute als grundlegend gelten darf, zeigt die Haltbarkeit seiner Forschungen, die in der Neuauflage mit zwei neuen Unterkapiteln ergänzt wurden, und die weit über die Mechanismen der Machtübernahme hinaus reichen: Was sich in Österreich ereignete, trug zu einer Radikalisierung bei, die Terror und Unterdrückung forcierte und geradewegs in den Krieg mündete.“"
                                            },
                                            {
                                                "example_id": "40fccb59-9331-440b-9a6f-77465a48382f",
                                                "sense_id": "12cbb78d-cd5d-3b7a-b85d-6f4da99eb1af",
                                                "text": "„Im Rahmen dieser Neuauflage wurde außerdem eine Online-Umfrage zur Akzeptanz von Aussprachevarianten durchgeführt, aus der ausgewählte relevante Ergebnisse im Wörterbuchteil publiziert werden.“"
                                            },
                                            {
                                                "example_id": "3a311198-e4cc-490c-862b-6bfc6f4de1f5",
                                                "sense_id": "12cbb78d-cd5d-3b7a-b85d-6f4da99eb1af",
                                                "text": "„Diese Neuauflage des Rechtschreibdudens leistet dazu einen wichtigen Beitrag.“"
                                            },
                                            {
                                                "example_id": "2ec3dcec-674a-4277-a0f6-ea3cb35d1995",
                                                "sense_id": "12cbb78d-cd5d-3b7a-b85d-6f4da99eb1af",
                                                "text": "„Autoren und Redaktion haben sich auch bei der Erarbeitung dieser Neuauflage besonders darum bemüht, schwierige Gegenstände allgemein verständlich darzustellen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "051e068a-69f4-49ef-8078-a254bee28f6e",
                        "source_entry_id": "9a739f39-60b4-3210-ba8d-111d016bdcc6",
                        "source_sense_id": "e4a50692-dfa8-36e0-81cd-1fc06e7e389d",
                        "source_sense_description": "printed matter that has been published before but is now being released again",
                        "target_lang_word": "Neudruck",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Neudruck",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fd71d5b9-c42f-3411-8fa2-9695e1e55fd1",
                                        "entry_id": "18c62272-54f4-3752-bbd7-6c583b13974f",
                                        "glosses": [
                                            "neue Auflage eines bereits vorher erschienenen Druckwerks"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "941074ba-d7c6-4c74-b74a-9f447e492049",
                                                "sense_id": "fd71d5b9-c42f-3411-8fa2-9695e1e55fd1",
                                                "text": "Wegen der großen Nachfrage wurde schon nach kurzer Zeit ein Neudruck nötig."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d0b27ba8-dc5e-38d1-a574-ed2e8ca09099",
                                        "entry_id": "18c62272-54f4-3752-bbd7-6c583b13974f",
                                        "glosses": [
                                            "alle neuen Drucke eines Postwertzeichens, welche von einer staatlichen Postverwaltung mit unveränderten Original– Druckstöcken oder Druckplatten hergestellt wurden"
                                        ],
                                        "tags": [
                                            "Philatelie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2fc9e607-97bf-4266-aa97-e0097d80f693",
                                                "sense_id": "d0b27ba8-dc5e-38d1-a574-ed2e8ca09099",
                                                "text": "Von staatlichen Postverwaltungen werden Neudrucke in Auftrag gegeben."
                                            },
                                            {
                                                "example_id": "2954471a-90d2-4089-951a-4bbeba59ae2b",
                                                "sense_id": "d0b27ba8-dc5e-38d1-a574-ed2e8ca09099",
                                                "text": "Sammler verwenden häufig Neudrucke für Studienzwecke."
                                            },
                                            {
                                                "example_id": "592264fe-3821-4109-90f8-e8dc3fa9b730",
                                                "sense_id": "d0b27ba8-dc5e-38d1-a574-ed2e8ca09099",
                                                "text": "„Der Druckauftrag für den Neudruck der 3-Pfennigmarke erfolgte am 15. April 1880.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "40295b4e-3d11-4294-ab68-5f2c93b81e55",
                        "source_entry_id": "9a739f39-60b4-3210-ba8d-111d016bdcc6",
                        "source_sense_id": "e4a50692-dfa8-36e0-81cd-1fc06e7e389d",
                        "source_sense_description": "printed matter that has been published before but is now being released again",
                        "target_lang_word": "Nachdruck",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nachdruck",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b669b502-97ce-3d0a-aceb-049938e7480b",
                                        "entry_id": "88693a53-8801-30c0-9c13-ef4468bdebc5",
                                        "glosses": [
                                            "eine begeisterte, die eigene innere Bewegung und Zustimmung widerspiegelnde Ausdrucksweise"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39e75134-e1b2-4d82-b029-ae92069ed027",
                                                "sense_id": "b669b502-97ce-3d0a-aceb-049938e7480b",
                                                "text": "„Die Gewerkschaft Vereinigung Cockpit (VC) hat ihre Piloten zu dem Streik aufgerufen, um ihrer Forderung im laufenden Tarifkonflikt Nachdruck zu verleihen.“"
                                            },
                                            {
                                                "example_id": "5d62ea67-98ac-48bf-95eb-0fb249ee86a3",
                                                "sense_id": "b669b502-97ce-3d0a-aceb-049938e7480b",
                                                "text": "„Vor einem so wichtigen Treffen ist es üblich, dass die Länder ihre Standpunkte mit Nachdruck deutlich machen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "67938fc4-2c66-3985-a6e1-bc19be681c7a",
                                        "entry_id": "88693a53-8801-30c0-9c13-ef4468bdebc5",
                                        "glosses": [
                                            "unveränderter Abdruck eines schon einmal veröffentlichten Textes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d44eab8-20c9-4a1e-b6b1-39e2fcf89939",
                                                "sense_id": "67938fc4-2c66-3985-a6e1-bc19be681c7a",
                                                "text": "„Rund 160 Geburtstagsgäste gratulierten Prill, der von seinen Mitarbeitern den Nachdruck einer Gutenberg-Bibel geschenkt bekam.“"
                                            },
                                            {
                                                "example_id": "ee92245f-315e-47ce-a560-6487321504d2",
                                                "sense_id": "67938fc4-2c66-3985-a6e1-bc19be681c7a",
                                                "text": "„Noch bedenklicher aber war die Tatsache, daß sehr früh willkürliche Nachdrucke und vor allem Bearbeitungen mit teilweise eigenmächtigen Änderungen oder Auslassungen und Auswahlausgaben entstanden, die sich um der Wirksamkeit willen auf die besonders galanten Abenteuer beschränkten.“"
                                            },
                                            {
                                                "example_id": "638566f6-ca75-49a7-83d9-034c6352067b",
                                                "sense_id": "67938fc4-2c66-3985-a6e1-bc19be681c7a",
                                                "text": "„Ein Problem sind die Raubdrucker, die gleich nach den ersten Heften verbilligte Nachdrucke auf den Markt bringen.“"
                                            },
                                            {
                                                "example_id": "6883e784-d911-4bc2-bf9e-b4f6c7edd0be",
                                                "sense_id": "67938fc4-2c66-3985-a6e1-bc19be681c7a",
                                                "text": "„Bereits zu Luthers Zeiten gelangten Hunderttausende von Exemplaren unter die Leute: Drucke aus Wittenberg, Nachdrucke aus Augsburg, Leipzig oder Basel, Teildrucke im Kleinformat, einspaltige und zweispaltige, einbändige und mehrbändige Drucke.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5384419a-72e0-478c-9fc4-7d6e3db14b2d",
                        "source_entry_id": "9a739f39-60b4-3210-ba8d-111d016bdcc6",
