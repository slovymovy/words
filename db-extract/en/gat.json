                    {
                        "sense_id": "6a5d8fdc-a925-399c-bb93-480ec0ad4e70",
                        "entry_id": "e8492f42-fc6e-372a-bdfa-87613c82d265",
                        "glosses": [
                            "To shoot someone with a pistol or other handheld firearm."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "01f1d1da-4e4a-4f44-8244-0f98a2217154",
                                "sense_id": "6a5d8fdc-a925-399c-bb93-480ec0ad4e70",
                                "text": "He in a black suit in a coffin, gatted by a junkie for his fake Rolex watch at a taco stand on Western."
                            },
                            {
                                "example_id": "3d23830c-f61d-44ca-b98e-dd07c1a797cc",
                                "sense_id": "6a5d8fdc-a925-399c-bb93-480ec0ad4e70",
                                "text": "Vance's death scene would have a racy romantic glamour, sort of like Dillinger gatted at the Biograph, Pretty Boy slain in the cornfield, Bonnie and Clyde ambushed in their Ford Roadster."
                            },
                            {
                                "example_id": "6f9ac059-ecaf-43b6-bb10-698f7469c75a",
                                "sense_id": "6a5d8fdc-a925-399c-bb93-480ec0ad4e70",
                                "text": "Fact I was chillin' with Notorious BIG when he got gatted. It was a^([sic]) accident. Biggie got in front of my Glock when I was bustin' slugs at some mothaf***a."
                            }
                        ]
                    }
