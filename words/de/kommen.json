                    ]
                },
                {
                    "sense_id": "15d4f226-51b8-3466-ab42-87c5518acfe1",
                    "sense_definition": "an einen bestimmten Platz gelegt werden oder in eine bestimmte Lage geraten",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "platzierung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die sauberen Gläser <w>kommen</w> oben in den rechten Schrank."
                        },
                        {
                            "text": "Nach dem schweren Unfall <w>kam</w> der Fahrer sofort ins Krankenhaus."
                        }
                    ],
                    "common_phrases": [
                        "ins Krankenhaus kommen",
                        "ins Gefängnis kommen"
                    ]
                },
                {
                    "sense_id": "226432a1-b3c8-3f5e-a33e-53fa96e336df",
                    "sense_definition": "sich ereignen, eintreten oder geschehen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "ereignis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Niemand wusste genau, wie es zu diesem plötzlichen Streit <w>kam</w>."
                        },
                        {
                            "text": "Am Ende <w>kam</w> genau das, was viele Experten schon lange erwartet hatten."
                        }
                    ],
                    "common_phrases": [
                        "wie es kommt",
                        "dazu kommen dass"
