                    "frequency": "Low",
                    "semantic_group_id": "nooduitrusting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De passagiers moesten het vliegtuig via de <w>glijbaan</w> verlaten na de noodlanding.",
                            "target_lang_translations": {
                                "en": "The passengers had to leave the plane via the <w>slide</w> after the emergency landing."
                            }
                        },
                        {
                            "text": "Nadat een <w>glijbaan</w> per vergissing is ingezet moet deze op de thuisbasis worden vervangen.",
                            "target_lang_translations": {
