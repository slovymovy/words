                        ]
                    },
                    {
                        "translation_id": "4bb2348b-5555-44b8-ae63-056968ba304b",
                        "source_entry_id": "d8e6e6a3-68b3-3e0a-8896-6e01af9752e6",
                        "source_sense_id": "63109a0a-9dea-3549-b00a-53448725dcee",
                        "target_lang_word": "ménagerie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ménagerie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "38aadc92-e5cf-33bd-a539-0648d1e2c109",
                                        "entry_id": "0e6c3bbc-b1f4-3ddc-afe1-d7f55f025343",
                                        "glosses": [
                                            "Endroit où sont réunis, en vue de l’étude de la zoologie, les principales espèces d’animaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fba6dff1-3cc5-4009-b21a-bd17afcc1673",
                                                "sense_id": "38aadc92-e5cf-33bd-a539-0648d1e2c109",
                                                "text": "…le singe, le tigre, le lion éloignés de leur patrie et enfermés dans nos ménageries ne tardent pas à tomber dans un état de décrépitude complet et sont presque toujours enlevés par la phthisie."
                                            },
                                            {
                                                "example_id": "dcb4707e-fb40-4ee5-ae65-e5d9bab041ed",
                                                "sense_id": "38aadc92-e5cf-33bd-a539-0648d1e2c109",
                                                "text": "Il y a ainsi, pour les boutiquiers et les concierges, comme pour le chasseur dans la campagne, des signes précis de l'heure et du temps qu'il fera dans les promeneurs de ce quartier, où résonnent parfois les appels sauvages poussés par quelque bête de la ménagerie voisine : un ara qui crie, un éléphant qui barrit, un aigle qui trompette, un tigre qui miaule."
                                            },
                                            {
                                                "example_id": "82225c49-5090-45cd-ab28-37276db054da",
                                                "sense_id": "38aadc92-e5cf-33bd-a539-0648d1e2c109",
                                                "text": "La ménagerie se développe sur un autre terrain : les jardins zoologiques des grandes villes, aujourd'hui aménagés en parcs où les bêtes sont présentées en liberté relative."
                                            },
                                            {
                                                "example_id": "8a68b1b9-7ed9-4af8-9231-664134f7a7b8",
                                                "sense_id": "38aadc92-e5cf-33bd-a539-0648d1e2c109",
                                                "text": "Le Jardin des Plantes proprement dit comporte une orangerie, des serres tropicales, un jardin d'hiver, un jardin alpin. Lui sont annexés des galeries de zoologie, botanique, géologie, minéralogie, paléontologie, une ménagerie et un vivarium."
                                            },
                                            {
                                                "example_id": "5d145cde-72b8-4f0a-b146-7a0cc78309c0",
                                                "sense_id": "38aadc92-e5cf-33bd-a539-0648d1e2c109",
                                                "text": "Geoffroy Saint-Hilaire, qui cumulait avec son poste de savant celui de directeur de la Ménagerie, prescrit à tout son personnel d'éviter dorénavant le terme de ménagerie, et de lui préférer celui de jardin zoologique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd28a7eb-6025-38c3-9759-02d47bb8a11f",
                                        "entry_id": "0e6c3bbc-b1f4-3ddc-afe1-d7f55f025343",
                                        "glosses": [
                                            "Collection ambulante d’animaux généralement sauvages que l’on mène de ville en ville, de foire en foire."
                                        ],
                                        "tags": [
                                            "Plus courant"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed3b083d-72b1-4ef7-b67f-4857cf3caece",
                                                "sense_id": "dd28a7eb-6025-38c3-9759-02d47bb8a11f",
                                                "text": "Le maître du cirque de la barrière du Combat profitait des vacances de Pâques pour envoyer ses ours et ses dogues donner quelques représentations à Meaux. Toute cette ménagerie voyageait à pied."
                                            },
                                            {
                                                "example_id": "dba07773-db82-4855-8cbf-4367b13d8ad5",
                                                "sense_id": "dd28a7eb-6025-38c3-9759-02d47bb8a11f",
                                                "text": "On eût dit les ébats d'une ménagerie, quand, après la sortie du dompteur qui les tenait couchés sous sa cravache, les fauves gambadent dans la cage et mordent les barreaux."
                                            },
                                            {
                                                "example_id": "40646e06-33a9-44cc-9e43-136df7546dd7",
                                                "sense_id": "dd28a7eb-6025-38c3-9759-02d47bb8a11f",
                                                "text": "Un noble vieillard, avec des gestes de dompteur, déchaînait un acte de Wagner : la malheureuse bête – l'acte – ressemblait à ces lions de ménagerie, ahuris d'affronter les feux de la rampe, et qu'il faut cravacher pour les faire ressouvenir qu'ils sont pourtant des lions."
                                            },
                                            {
                                                "example_id": "5dd37971-964c-426a-a7f7-d8aa7bfa339f",
                                                "sense_id": "dd28a7eb-6025-38c3-9759-02d47bb8a11f",
                                                "text": "Le public attendait de nous, en plus du spectacle de piste, avec de nombreux groupes de dressage, une ménagerie nombreuse."
                                            },
                                            {
                                                "example_id": "44c073f7-cde6-48db-baf9-1321495c40d4",
                                                "sense_id": "dd28a7eb-6025-38c3-9759-02d47bb8a11f",
                                                "text": "— Il y avait quarante chevaux dans les écuries, sept éléphants sous une tente spéciale et les roulottes-cages de deux groupes de fauves –tigres et lions– abritées sous la tente ménagerie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f59f8a7f-02bc-3795-8783-56fefd0b8c4b",
                                        "entry_id": "0e6c3bbc-b1f4-3ddc-afe1-d7f55f025343",
                                        "glosses": [
                                            "Collection de jouets d’enfants qui reproduisent en réduction les principales espèces d’animaux."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2ff520c-b676-4d3b-9bf7-621858bbcd52",
                                                "sense_id": "f59f8a7f-02bc-3795-8783-56fefd0b8c4b",
                                                "text": "Le petit garçon, à ses pieds, jouait avec une ménagerie de bois."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
