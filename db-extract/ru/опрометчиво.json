        "ru-extract.jsonl": [
            {
                "entry_id": "71136c3a-75e9-3a12-8acd-e83eeb8aca93",
                "word": "опрометчиво",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "bdb4a388-5dcd-31ad-b3f7-4f37cf594daf",
                        "entry_id": "71136c3a-75e9-3a12-8acd-e83eeb8aca93",
                        "glosses": [
                            "наречие к опрометчивый; поспешно, необдуманно, без должной осмотрительности"
                        ],
                        "tags": [
                            "adverb"
                        ],
                        "examples": [
                            {
                                "example_id": "e93bbcd8-0e31-410a-bf9b-6ca50b050df3",
                                "sense_id": "bdb4a388-5dcd-31ad-b3f7-4f37cf594daf",
                                "text": "Вижу сам, что, может быть, весьма и весьма поступил опрометчиво, пренебрегая общественным голосом…"
                            },
                            {
                                "example_id": "5cf03ee4-89fb-40d7-b319-c749a6b8d15d",
                                "sense_id": "bdb4a388-5dcd-31ad-b3f7-4f37cf594daf",
                                "text": "Это было ужасно опрометчиво ― самому, добровольно забраться в логово врага."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2dccedd6-647d-4746-8be1-4d0d97a1b1a3",
                        "source_entry_id": "71136c3a-75e9-3a12-8acd-e83eeb8aca93",
                        "source_sense_id": "bdb4a388-5dcd-31ad-b3f7-4f37cf594daf",
                        "target_lang_word": "recklessly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "recklessly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "541ca3f4-3e33-3cbb-8d67-cd42c410e1d1",
                                        "entry_id": "585cc114-853f-34be-9643-d1225262b5f8",
                                        "glosses": [
                                            "In a rash or reckless manner, without regard for cost or consequence"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff495713-398d-4bb4-9fc3-dd2e8ea2ed92",
                                                "sense_id": "541ca3f4-3e33-3cbb-8d67-cd42c410e1d1",
                                                "text": "Thanks to that penny he had just spent so recklessly [on a newspaper] he would pass a happy hour, taken, for once, out of his anxious, despondent, miserable self. It irritated him shrewdly to know that these moments of respite from carking care would not be shared with his poor wife, with careworn, troubled Ellen."
                                            },
                                            {
                                                "example_id": "8879987f-903d-42ff-af52-44d8d49a7338",
                                                "sense_id": "541ca3f4-3e33-3cbb-8d67-cd42c410e1d1",
                                                "text": "Zoe popped her head up to watch in terror through a little window, as they spread chaos and carnage in their wake, not to mention quite a few broken-off wing mirrors. Burt was driving so recklessly, she was frightened he would kill them both."
                                            },
                                            {
                                                "example_id": "874d59e1-c48f-48f8-adf5-37169dc29ce5",
                                                "sense_id": "541ca3f4-3e33-3cbb-8d67-cd42c410e1d1",
                                                "text": "Brooks was also convicted of 61 counts of recklessly endangering safety with the use of a dangerous weapon, six counts of fatal hit and run, two counts of felony bail jumping and one count of misdemeanor domestic battery."
                                            },
                                            {
                                                "example_id": "40c3e73c-1177-4f92-9533-45282db62fdd",
                                                "sense_id": "541ca3f4-3e33-3cbb-8d67-cd42c410e1d1",
                                                "text": "But some Democrats are raising red flags about DOGE staffers “infiltrating multiple agencies at once,” and “recklessly and haphazardly combining data without any verification or validation,” as one senior House Oversight Committee Democratic staffer put it to CNN."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa0d20ab-5f70-3289-8bbb-1dd5faa8b09f",
                                        "entry_id": "585cc114-853f-34be-9643-d1225262b5f8",
                                        "glosses": [
                                            "With contempt for the rights, feelings, or well-being of others."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9cccffdc-b310-4c11-b56d-b948ec248645",
                        "source_entry_id": "71136c3a-75e9-3a12-8acd-e83eeb8aca93",
                        "source_sense_id": "bdb4a388-5dcd-31ad-b3f7-4f37cf594daf",
                        "target_lang_word": "thoughtlessly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thoughtlessly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a5aaac76-934d-3735-8545-bfde7458d420",
                                        "entry_id": "2e30de60-8757-3e90-96dc-e0f3fea755fa",
                                        "glosses": [
                                            "Done without thinking."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51e9fcfb-479a-4bc8-8229-55e92b1ddfad",
                                                "sense_id": "a5aaac76-934d-3735-8545-bfde7458d420",
                                                "text": "He thoughtlessly invited her to come jogging, as he knew she hated exercise."
                                            },
                                            {
                                                "example_id": "9cf613fd-812b-45bd-bb9b-ba7290e59b16",
                                                "sense_id": "a5aaac76-934d-3735-8545-bfde7458d420",
                                                "text": "The railway ran through the resort's narrow streets up to Weymouth Quay station, with thoughtlessly parked vehicles sometimes having to be bumped out of the way."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a6bc60d0-5020-4e6a-b615-725e06b45545",
                        "source_entry_id": "71136c3a-75e9-3a12-8acd-e83eeb8aca93",
                        "source_sense_id": "bdb4a388-5dcd-31ad-b3f7-4f37cf594daf",
                        "target_lang_word": "inconsidérément",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inconsidérément",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e1bd248e-865e-312e-8e25-4160be9bb2a6",
                                        "entry_id": "1466c825-dbaa-3a3c-8838-8f68ebfb31b6",
                                        "glosses": [
                                            "D’une manière inconsidérée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ff6d388-86ae-4f53-8c9a-1b7bacffa359",
                                                "sense_id": "e1bd248e-865e-312e-8e25-4160be9bb2a6",
                                                "text": "Robert Wells, animé du désir de venger la mort de son père, se précipita inconsidérément au milieu de l’armée du roi, où il fut enveloppé."
                                            },
                                            {
                                                "example_id": "171f43aa-0784-4d17-949b-7d5201c4e738",
                                                "sense_id": "e1bd248e-865e-312e-8e25-4160be9bb2a6",
                                                "text": "Il a parlé inconsidérément, et il ne paraît point de sagesse dans ses discours."
                                            },
                                            {
                                                "example_id": "f3910637-4f30-4766-b2f9-a2b83aefe1a2",
                                                "sense_id": "e1bd248e-865e-312e-8e25-4160be9bb2a6",
                                                "text": "L'abbé de Pont-carré me montra hier ce que vous lui écrivez sur le manteau donné inconsidérément [en cadeau à son valet]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "51da4982-ff06-4e31-a963-26bb3aaf122f",
                        "source_entry_id": "71136c3a-75e9-3a12-8acd-e83eeb8aca93",
                        "source_sense_id": "bdb4a388-5dcd-31ad-b3f7-4f37cf594daf",
                        "target_lang_word": "imprudemment",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "imprudemment",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d16983c9-6dfe-3b68-8794-bee8d1c7c250",
                                        "entry_id": "3dd05cb9-bb0c-31b4-ae72-15c2627ec064",
                                        "glosses": [
                                            "Avec imprudence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ef01ddd-6712-4b23-a976-b8776ac071cd",
                                                "sense_id": "d16983c9-6dfe-3b68-8794-bee8d1c7c250",
                                                "text": "De sorte que désormais il faut que je prenne soigneusement garde de ne prendre pas imprudemment quelque autre chose pour moi."
                                            },
                                            {
                                                "example_id": "805d986a-d1fe-4011-8da8-3b948b221115",
                                                "sense_id": "d16983c9-6dfe-3b68-8794-bee8d1c7c250",
                                                "text": "L'élevage des vers à soie « ne paie plus ». Voilà pourquoi, aujourd'hui, dans le Gard, on arrache les mûriers : on les remplace imprudemment par des vignes...."
                                            },
                                            {
                                                "example_id": "3e0f05fd-108f-44cb-8d96-ca2f99134898",
                                                "sense_id": "d16983c9-6dfe-3b68-8794-bee8d1c7c250",
                                                "text": "La cour d’appel partagea alors les dommages, selon les principes de la faute commune, constatant que la victime s’était imprudemment aventurée sur un boulevard passager, sans prendre les précautions nécessaires."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
