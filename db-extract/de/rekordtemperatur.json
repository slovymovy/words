                "senses": [
                    {
                        "sense_id": "29fe99c1-584d-3b6c-999e-5a3bf9df23fd",
                        "entry_id": "33c394d4-a562-3ade-90a4-97f4475e108c",
                        "glosses": [
                            "höchste oder niedrigste gemessene Temperatur"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc5ad823-f9a0-4435-937b-a2219c3ccceb",
                                "sense_id": "29fe99c1-584d-3b6c-999e-5a3bf9df23fd",
                                "text": "„Das Death Valley ist allerdings wirklich heiß. Es zählt zu den trockensten und heißesten Gebieten Amerikas. Am 10. Juli 1913 wurde eine Rekordtemperatur von 56,7 Grad Celsius gemessen.“"
                            },
                            {
                                "example_id": "88edbcbc-a8db-416b-b31b-483fe898b709",
                                "sense_id": "29fe99c1-584d-3b6c-999e-5a3bf9df23fd",
                                "text": "„Die Rekordtemperaturen in der Antarktis vom Januar 2020 waren ein deutlicher Hinweis, welche Folgen der Rückgang des Eises in der Antarktis und in Grönland zeitigt.“"
                            },
                            {
                                "example_id": "b85058dd-d9cd-4ef7-ac5d-e8dfa6f6b0d6",
                                "sense_id": "29fe99c1-584d-3b6c-999e-5a3bf9df23fd",
                                "text": "„Im Radio wurde stündlich davon gesprochen, dass für die zweite Septemberwoche Rekordtemperaturen erwartet wurden.“"
                            },
                            {
                                "example_id": "9e1ac439-74e8-4e46-a013-025195dd870f",
                                "sense_id": "29fe99c1-584d-3b6c-999e-5a3bf9df23fd",
                                "text": "„Auch in den Dörfern und Städten ächzten Mensch und Tier unter den Rekordtemperaturen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
