                        "entry_id": "a7986d94-6cf6-3412-8af8-e0ff599ebac1",
                        "glosses": [
                            "proceder propagowania nienawiści w mediach"
                        ],
                        "tags": [
                            "colloquial",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "658cd71e-9524-4556-9f5c-8692853f42fd",
                                "sense_id": "17a92989-1ac4-34a1-9ed5-a0ce90df1eb8",
                                "text": "Część dziennikarzy kłamie i uprawia niszczenie polityków. To dziennikarska szczujnia"
