                "senses": [
                    {
                        "sense_id": "2bb794c3-d974-3b72-a1fc-a8b44516ea32",
                        "entry_id": "4bd21e3e-4434-325b-8283-dfbf9e4c8561",
                        "glosses": [
                            "Analyser d’un point de vue psychométrique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89279451-aa60-4452-acbb-30e9af519c82",
                                "sense_id": "2bb794c3-d974-3b72-a1fc-a8b44516ea32",
                                "text": "On peut se demander si cette tentative d’appliquer les indices les plus courants de fiabilité à l’étude du développement ne revient pas à «psychométriser» Piaget pour la deuxième fois."
                            },
                            {
                                "example_id": "1275a253-e050-47f8-94f1-32749c375e21",
                                "sense_id": "2bb794c3-d974-3b72-a1fc-a8b44516ea32",
                                "text": "Une bonne façon de faire consiste à psychométriser, à différentes occasions, des objets ayant certaines caractéristiques communes et certaines différences marquées, afin d’apprendre à distinguer les vibrations propres à chacun."
                            },
                            {
                                "example_id": "8016bf4b-934f-4246-8099-9d59f085a0ed",
                                "sense_id": "2bb794c3-d974-3b72-a1fc-a8b44516ea32",
                                "text": "Le capitaine B… faisant de la peinture, ce carton lui fut remis ; il l’enveloppa soigneusement, pensant le faire psychométriser par Mlle Laplace."
                            }
                        ]
                    }
