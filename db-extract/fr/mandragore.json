                                    {
                                        "sense_id": "8959a844-0787-3f31-9929-74d1f90c7f74",
                                        "entry_id": "2856bf58-d1af-37a5-8065-e605d29404ff",
                                        "glosses": [
                                            "giftige Pflanze mit menschenähnlicher Wurzel: Gemeine Alraune"
                                        ],
                                        "tags": [],
