{
    "word_family": [
        "scuttler"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "92bc97e4-e9a9-37f3-823e-e298ade20f79",
                    "sense_definition": "To move with short, quick steps.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small crab <w>scuttled</w> across the wet sand to hide under a rock.",
                            "target_lang_translations": {
                                "zh": "那只小螃蟹在湿沙地上<w>碎步快跑</w>，躲进了一块岩石下面。",
                                "ru": "Маленький краб <w>семенил</w> по мокрому песку, чтобы спрятаться под камнем."
                            }
                        },
                        {
                            "text": "The frightened mouse <w>scuttled</w> away when it heard the cat approaching.",
                            "target_lang_translations": {
                                "zh": "受惊的老鼠听到猫靠近时<w>疾行</w>逃走了。",
                                "ru": "Испуганная мышь <w>метнулась</w> прочь, услышав, что приближается кошка."
                            }
                        }
                    ],
                    "common_phrases": [
                        "scuttle away",
                        "scuttle across"
                    ],
                    "target_lang_definitions": {
                        "zh": "指小步快速地移动。",
                        "ru": "Передвигаться быстрыми, короткими шагами."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "碎步快跑",
                                "target_lang_sense_clarification": "形容动作急促、小步幅的移动。"
                            },
                            {
                                "target_lang_word": "疾行",
                                "target_lang_sense_clarification": "快速行走或奔跑。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "семенить",
                                "target_lang_sense_clarification": "передвигаться мелкими, частыми шагами."
                            },
                            {
                                "target_lang_word": "бежать вприпрыжку",
                                "target_lang_sense_clarification": "быстрое, суетливое движение."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8ac26c1d-e381-3268-a259-d3bf617f0027",
                    "sense_definition": "To deliberately sink a ship or boat.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "destroy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The captain decided to <w>scuttle</w> the ship to prevent it from being captured by the enemy.",
                            "target_lang_translations": {
                                "zh": "船长决定<w>凿沉</w>这艘船，以防它被敌人俘获。",
                                "ru": "Капитан решил <w>затопить</w> корабль, чтобы он не достался врагу."
                            }
                        },
                        {
                            "text": "They <w>scuttled</w> the old vessel to create an artificial reef for divers.",
                            "target_lang_translations": {
                                "zh": "他们<w>凿沉</w>了那艘旧船，为潜水员创造了一个人工礁石。",
                                "ru": "Они <w>затопили</w> старое судно, чтобы создать искусственный риф для дайверов."
                            }
                        }
                    ],
                    "synonyms": [
                        "destroy",
                        "wreck"
                    ],
                    "common_phrases": [
                        "scuttle a ship"
                    ],
                    "target_lang_definitions": {
                        "zh": "故意凿沉船只。",
                        "ru": "Намеренно затопить судно."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "凿沉",
                                "target_lang_sense_clarification": "特指为了某种目的故意弄沉船只。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "затопить",
                                "target_lang_sense_clarification": "преднамеренно пустить судно ко дну."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8388e3d3-640a-334c-bdeb-732927724845",
                    "sense_definition": "To deliberately cause a plan or project to fail.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "destroy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden scandal <w>scuttled</w> the candidate's chances of winning the election.",
                            "target_lang_translations": {
                                "zh": "突如其来的丑闻<w>破坏</w>了这位候选人赢得选举的机会。",
                                "ru": "Внезапный скандал <w>сорвал</w> шансы кандидата на победу в выборах."
                            }
                        },
                        {
                            "text": "New budget cuts might <w>scuttle</w> the entire research project.",
                            "target_lang_translations": {
                                "zh": "新的预算削减可能会<w>搅黄</w>整个研究项目。",
                                "ru": "Новое сокращение бюджета может <w>провалить</w> весь исследовательский проект."
                            }
                        }
                    ],
                    "synonyms": [
                        "destroy",
                        "wreck"
                    ],
                    "common_phrases": [
                        "scuttle plans"
                    ],
                    "target_lang_definitions": {
                        "zh": "故意破坏计划或项目，使其失败。",
                        "ru": "Намеренно сорвать выполнение плана или проекта."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "破坏",
                                "target_lang_sense_clarification": "指使计划或项目无法顺利进行。"
                            },
                            {
                                "target_lang_word": "搅黄",
                                "target_lang_sense_clarification": "口语中指使事情失败或告吹。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "сорвать",
                                "target_lang_sense_clarification": "помешать осуществлению чего-либо."
                            },
                            {
                                "target_lang_word": "провалить",
                                "target_lang_sense_clarification": "привести к неудаче, краху проекта."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "da9b0e34-aab4-312d-bde7-531c094374a9",
                    "sense_definition": "A container used for carrying coal.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "container",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She filled the metal <w>scuttle</w> with coal to keep the fireplace burning.",
                            "target_lang_translations": {
                                "zh": "她往金属<w>煤斗</w>里装满了煤，以保持壁炉燃烧。",
                                "ru": "Она наполнила металлическое <w>ведро для угля</w>, чтобы поддерживать огонь в камине."
                            }
                        },
                        {
                            "text": "The heavy coal <w>scuttle</w> was placed carefully by the hearth.",
                            "target_lang_translations": {
                                "zh": "沉重的<w>煤斗</w>被小心地放在了炉边。",
                                "ru": "Тяжелое <w>ведро для угля</w> было аккуратно поставлено у очага."
                            }
                        }
                    ],
                    "common_phrases": [
                        "coal scuttle"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Refers to a household object common in the era of coal heating."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "用于搬运煤炭的容器。",
                        "ru": "Емкость для переноски угля."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "煤斗",
                                "target_lang_sense_clarification": "专门用于盛放或搬运煤炭的器具。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "ведро для угля",
                                "target_lang_sense_clarification": "специальный контейнер для переноски угля к печи или камину."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e6876bbd-3a27-356f-9858-0f23bdcd5969",
                    "sense_definition": "A hatch providing access to a roof.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "opening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The maintenance worker climbed through the roof <w>scuttle</w> to inspect the chimney.",
                            "target_lang_translations": {
                                "zh": "维修工爬过<w>屋顶检修口</w>去检查烟囱。",
                                "ru": "Рабочий по обслуживанию вылез через <w>чердачный люк</w>, чтобы осмотреть дымоход."
                            }
                        },
                        {
                            "text": "They opened the <w>scuttle</w> to let fresh air into the attic.",
                            "target_lang_translations": {
                                "zh": "他们打开了<w>屋顶检修口</w>，让新鲜空气进入阁楼。",
                                "ru": "Они открыли <w>люк</w>, чтобы впустить свежий воздух на чердак."
                            }
                        }
                    ],
                    "synonyms": [
                        "roof hatch"
                    ],
                    "common_phrases": [
                        "roof scuttle"
                    ],
                    "target_lang_definitions": {
                        "zh": "通往屋顶的检修口或天窗。",
                        "ru": "Люк или проем для выхода на крышу."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "屋顶检修口",
                                "target_lang_sense_clarification": "用于进出屋顶的开口。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "чердачный люк",
                                "target_lang_sense_clarification": "отверстие для доступа на крышу или чердак."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d22c45ca-3738-3dd0-8000-8e4e61dcc4e8",
                    "sense_definition": "A small hatch or opening in a boat deck.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "opening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sailor opened the deck <w>scuttle</w> to ventilate the cabin below.",
                            "target_lang_translations": {
                                "zh": "水手打开了<w>舱口</w>，为下方的船舱通风。",
                                "ru": "Матрос открыл палубный <w>люк</w>, чтобы проветрить каюту внизу."
                            }
                        },
                        {
                            "text": "Water poured through the open <w>scuttle</w> during the heavy storm.",
                            "target_lang_translations": {
                                "zh": "暴风雨期间，海水从敞开的<w>舱口</w>涌了进来。",
                                "ru": "Во время сильного шторма вода хлынула через открытый <w>люк</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "deck scuttle"
                    ],
                    "target_lang_definitions": {
                        "zh": "船甲板上的小舱口。",
                        "ru": "Небольшой люк или отверстие в палубе судна."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "舱口",
                                "target_lang_sense_clarification": "船只甲板上用于通风或进出的开口。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "люк",
                                "target_lang_sense_clarification": "отверстие в палубе для доступа в трюм или вентиляции."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "56f463a1-3aca-3f3f-b7c2-d8f60ffe0a59",
                    "sense_definition": "A trough on a vehicle between the windshield and the hood.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "vehicle_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Leaves had clogged the <w>scuttle</w>, causing water to leak into the car.",
                            "target_lang_translations": {
                                "zh": "树叶堵塞了<w>导流槽</w>，导致水漏进了车里。",
                                "ru": "Листья забили <w>водосточный желоб</w>, из-за чего вода стала протекать в салон автомобиля."
                            }
                        },
                        {
                            "text": "The wiper motor is located beneath the car's <w>scuttle</w> panel.",
                            "target_lang_translations": {
                                "zh": "雨刷电机位于汽车的<w>导流槽</w>盖板下方。",
                                "ru": "Мотор стеклоочистителей расположен под панелью <w>водосточного желоба</w> автомобиля."
                            }
                        }
                    ],
                    "synonyms": [
                        "cowl"
                    ],
                    "common_phrases": [
                        "scuttle panel"
                    ],
                    "target_lang_definitions": {
                        "zh": "汽车挡风玻璃与引擎盖之间的槽状区域。",
                        "ru": "Углубление в автомобиле между лобовым стеклом и капотом."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "导流槽",
                                "target_lang_sense_clarification": "汽车前部用于排水的区域。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "водосточный желоб",
                                "target_lang_sense_clarification": "зона под лобовым стеклом для отвода воды."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}