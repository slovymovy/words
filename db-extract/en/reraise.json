                                    },
                                    {
                                        "sense_id": "ed245696-c0a1-3f30-a93f-45b8f32bc989",
                                        "entry_id": "d0c59a55-93ee-31fc-a83b-5626cd64c9cd",
                                        "glosses": [
                                            "Aller trouver quelqu’un au lieu où il est, lui écrire, pour l’engager à quelque chose à quoi il ne songeait plus ou qu’il n’avait pas envie de faire."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc37802a-9fec-4b61-b56d-b2ad337d62bb",
                                                "sense_id": "ed245696-c0a1-3f30-a93f-45b8f32bc989",
                                                "text": "Relancer quelqu’un,"
                                            },
                                            {
                                                "example_id": "fc182479-50aa-4ae8-8c9f-f45953f36cb6",
                                                "sense_id": "ed245696-c0a1-3f30-a93f-45b8f32bc989",
                                                "text": "Ils sont venus me relancer chez moi et ils m’ont entraîné avec eux."
                                            },
                                            {
                                                "example_id": "cde625dd-cd79-4ed3-be37-7da584842b27",
                                                "sense_id": "ed245696-c0a1-3f30-a93f-45b8f32bc989",
                                                "text": "C’est un importun qui vient me relancer à toute heure."
                                            },
                                            {
                                                "example_id": "e6a9dfd5-bab7-45bf-a1e3-e3de6eeaffc9",
                                                "sense_id": "ed245696-c0a1-3f30-a93f-45b8f32bc989",
                                                "text": "J’ai eu beau le relancer, je n’en ai rien obtenu."
                                            },
                                            {
                                                "example_id": "ae719f74-8ce7-42f4-9563-dc2dbaa48364",
                                                "sense_id": "ed245696-c0a1-3f30-a93f-45b8f32bc989",
                                                "text": "N’ayant pas de ses nouvelles, je me suis décidé à le relancer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c10c2daf-b3d3-38e3-ac27-ae40e84fc2fa",
                                        "entry_id": "d0c59a55-93ee-31fc-a83b-5626cd64c9cd",
                                        "glosses": [
                                            "Mettre un enjeu supérieur."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d9ed70c5-a8f8-359b-9391-dab14f72a140",
                                        "entry_id": "d0c59a55-93ee-31fc-a83b-5626cd64c9cd",
                                        "glosses": [
                                            "Donner un nouvel élan."
                                        ],
                                        "tags": [
                                            "Économie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35964605-cf0d-4b81-9aa7-38b4b3187651",
                                                "sense_id": "d9ed70c5-a8f8-359b-9391-dab14f72a140",
                                                "text": "Les hommes d’Igor Tudor se relancent totalement dans cette Ligue des champions et marquent leurs premiers points."
                                            },
                                            {
                                                "example_id": "58b2fbaa-ea7a-4b70-9b5f-be9f9f10a68d",
                                                "sense_id": "d9ed70c5-a8f8-359b-9391-dab14f72a140",
