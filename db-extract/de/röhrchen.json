                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "72ca57dc-568b-32bc-bbab-ad0642718b0f",
                        "entry_id": "9538da46-6885-3dd4-9f75-b38be58366b9",
                        "glosses": [
                            "kleine Röhre"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6e84a8a-a360-4534-83c6-6fb527f5c825",
                                "sense_id": "72ca57dc-568b-32bc-bbab-ad0642718b0f",
                                "text": "„Reni eilte von Tisch zu Tisch, um abzuräumen und neue Bestellungen entgegenzunehmen. In ihrem Portemonnaie steckte das Röhrchen mit den K.o. -Tropfen, einer Mischung aus Scopolamin und Atropin. Eva Schmiedinger warf Sauer eine Kußhand zu und zeigte auf den Personaltisch, den sie für ihn gedeckt hatte.“"
                            },
                            {
                                "example_id": "0db768a9-c882-4c5c-acad-277874671594",
                                "sense_id": "72ca57dc-568b-32bc-bbab-ad0642718b0f",
                                "text": "„Diese Wattebällchen, die sich in den Röhrchen befinden, müssen die Patienten einfach in den Mund nehmen und dann in Ruhe darauf rum kauen, um Speichel zu sammeln, was so recht einfach möglich ist.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
