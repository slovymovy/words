{
    "word_family": [
        "plateful",
        "plateless",
        "plater",
        "plating",
        "platelike",
        "platelet",
        "subplate"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dcd54a02-b543-3352-8a13-a2da117b5333",
                    "sense_definition": "A slightly curved but almost flat dish from which food is served or eaten.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "dishware",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She carefully placed the ceramic <w>plate</w> on the dinner table.",
                            "target_lang_translations": {
                                "ru": "Она осторожно поставила керамическую <w>тарелку</w> на обеденный стол."
                            }
                        },
                        {
                            "text": "Please help me wash every <w>plate</w> and bowl in the sink.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, помоги мне вымыть каждую <w>тарелку</w> и миску в раковине."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dinner plate",
                        "ceramic plate",
                        "clean your plate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Слегка изогнутая, но почти плоская посуда, из которой подают или едят пищу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тарелка",
                                "target_lang_sense_clarification": "обычная столовая посуда"
                            },
                            {
                                "target_lang_word": "блюдо",
                                "target_lang_sense_clarification": "большая тарелка для подачи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9948ead3-6886-3669-9787-1de854239a56",
                    "sense_definition": "The amount of food contained on a single dish.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "food_quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was so hungry that he ate a whole <w>plate</w> of pasta.",
                            "target_lang_translations": {
                                "ru": "Он был так голоден, что съел целую <w>тарелку</w> пасты."
                            }
                        },
                        {
                            "text": "The restaurant serves a large <w>plate</w> of fries with every burger.",
                            "target_lang_translations": {
                                "ru": "Ресторан подает большую <w>порцию</w> картофеля фри к каждому бургеру."
                            }
                        }
                    ],
                    "common_phrases": [
                        "plate of food",
                        "full plate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Количество еды, содержащееся в одной тарелке."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тарелка",
                                "target_lang_sense_clarification": "порция еды"
                            },
                            {
                                "target_lang_word": "порция",
                                "target_lang_sense_clarification": "количество еды"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f2c15a3e-f503-382f-8137-691eb0a312b7",
                    "sense_definition": "A metal or plastic sign on a vehicle showing its registration number.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "vehicle_parts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The witness managed to write down the number <w>plate</w> of the speeding car.",
                            "target_lang_translations": {
                                "ru": "Свидетелю удалось записать <w>номерной знак</w> мчащегося автомобиля."
                            }
                        },
                        {
                            "text": "He noticed that the car had personalized <w>plates</w> from another state.",
                            "target_lang_translations": {
                                "ru": "Он заметил, что у машины были именные <w>номера</w> другого штата."
                            }
                        }
                    ],
                    "synonyms": [
                        "rego plates"
                    ],
                    "common_phrases": [
                        "license plate",
                        "number plate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Металлическая или пластиковая табличка на транспортном средстве с его регистрационным номером."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "номерной знак",
                                "target_lang_sense_clarification": "официальный номер авто"
                            },
                            {
                                "target_lang_word": "номер",
                                "target_lang_sense_clarification": "разговорное обозначение знака"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "839bf09f-5589-3de9-8563-6c198deaba6e",
                    "sense_definition": "An agenda of tasks, problems, or responsibilities that one must deal with.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "responsibilities",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "With the new project starting, I already have a full <w>plate</w> this week.",
                            "target_lang_translations": {
                                "ru": "С началом нового проекта у меня на этой неделе и так <w>дел по горло</w>."
                            }
                        },
                        {
                            "text": "The manager has a lot on her <w>plate</w> right now and cannot take more work.",
                            "target_lang_translations": {
                                "ru": "У менеджера сейчас много <w>забот</w>, и она не может брать дополнительную работу."
                            }
                        }
                    ],
                    "common_phrases": [
                        "full plate",
                        "on my plate"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in the idiom 'on one's plate'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Список задач, проблем или обязанностей, с которыми человеку необходимо справиться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дел по горло",
                                "target_lang_sense_clarification": "идиома о большой загруженности"
                            },
                            {
                                "target_lang_word": "забот",
                                "target_lang_sense_clarification": "круг обязанностей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "36b24ae5-5f47-3bfe-a01a-24340c90babe",
                    "sense_definition": "One of the large sections of the Earth's crust that move slowly.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "geology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Earthquakes often occur where two tectonic <w>plates</w> meet and grind together.",
                            "target_lang_translations": {
                                "ru": "Землетрясения часто происходят там, где две тектонические <w>плиты</w> сталкиваются и трутся друг о друга."
                            }
                        },
                        {
                            "text": "Scientists study the movement of each tectonic <w>plate</w> to predict volcanic activity.",
                            "target_lang_translations": {
                                "ru": "Ученые изучают движение каждой тектонической <w>плиты</w>, чтобы предсказать вулканическую активность."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tectonic plate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Один из крупных участков земной коры, которые медленно движутся."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плита",
                                "target_lang_sense_clarification": "тектоническая структура"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "531154a8-f711-37a4-b265-fd61380163d6",
                    "sense_definition": "A flat, thin sheet of metal, glass, or other solid material.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "material_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The workers installed a heavy steel <w>plate</w> to cover the hole in the road.",
                            "target_lang_translations": {
                                "ru": "Рабочие установили тяжелую стальную <w>плиту</w>, чтобы закрыть яму на дороге."
                            }
                        },
                        {
                            "text": "The most expensive part of the solar cell is the silicon <w>plate</w>.",
                            "target_lang_translations": {
                                "ru": "Самая дорогая часть солнечного элемента — это кремниевая <w>пластина</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "steel plate",
                        "metal plate",
                        "glass plate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Плоский тонкий лист металла, стекла или другого твердого материала."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пластина",
                                "target_lang_sense_clarification": "тонкий слой материала"
                            },
                            {
                                "target_lang_word": "плита",
                                "target_lang_sense_clarification": "толстый плоский кусок"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "150bccce-4f82-306c-b34f-6b11847ed852",
                    "sense_definition": "Protective armor made of large metal sheets.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "armor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The knight was encased in full <w>plate</w> before the tournament began.",
                            "target_lang_translations": {
                                "ru": "Рыцарь был облачен в полные <w>латы</w> перед началом турнира."
                            }
                        },
                        {
                            "text": "Heavy <w>plate</w> armor provided excellent protection but was very difficult to move in.",
                            "target_lang_translations": {
                                "ru": "Тяжелые <w>пластинчатые</w> доспехи обеспечивали отличную защиту, но в них было очень трудно двигаться."
                            }
                        }
                    ],
                    "common_phrases": [
                        "full plate",
                        "plate armor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Защитные доспехи, изготовленные из больших металлических листов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "латы",
                                "target_lang_sense_clarification": "цельнометаллический доспех"
                            },
                            {
                                "target_lang_word": "пластины",
                                "target_lang_sense_clarification": "элементы доспеха"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8ae78b21-8ddb-3ba6-8f33-1d2ace9701a6",
                    "sense_definition": "A slang term for a person's foot.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "body_parts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After walking all day, I really need to give my <w>plates</w> a rest.",
                            "target_lang_translations": {
                                "ru": "После целого дня ходьбы мне действительно нужно дать моим <w>копытам</w> отдохнуть."
                            }
                        },
                        {
                            "text": "He sat down on the bench to soothe his aching <w>plates</w>.",
                            "target_lang_translations": {
                                "ru": "Он сел на скамейку, чтобы дать покой своим ноющим <w>ластам</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "plates of meat"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Cockney rhyming slang: plates of meat = feet"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сленговое обозначение ступни человека."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "копыта",
                                "target_lang_sense_clarification": "грубый сленг для ног"
                            },
                            {
                                "target_lang_word": "ласты",
                                "target_lang_sense_clarification": "шутливый сленг для ног"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f44c68d9-0b11-3e12-a9d1-6b8dbb48e8d9",
                    "sense_definition": "To arrange food on a dish in an attractive way before serving.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cooking_actions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef began to <w>plate</w> the main course with great precision.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар начал с большой точностью <w>сервировать</w> основное блюдо."
                            }
                        },
                        {
                            "text": "It is important to <w>plate</w> the dish quickly so the food stays hot.",
                            "target_lang_translations": {
                                "ru": "Важно быстро <w>разложить</w> блюдо по тарелкам, чтобы еда оставалась горячей."
                            }
                        }
                    ],
                    "common_phrases": [
                        "plate the dish"
                    ],
                    "target_lang_definitions": {
                        "ru": "Красиво разложить еду на тарелке перед подачей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сервировать",
                                "target_lang_sense_clarification": "оформлять блюдо"
                            },
                            {
                                "target_lang_word": "выкладывать",
                                "target_lang_sense_clarification": "раскладывать на тарелки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "75ad5801-e0f4-3f6f-8d1b-88b9553403a5",
                    "sense_definition": "To cover an object with a thin layer of metal.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "coating_actions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The jeweler can <w>plate</w> the copper ring with a thin layer of gold.",
                            "target_lang_translations": {
                                "ru": "Ювелир может <w>покрыть</w> медное кольцо тонким слоем золота."
                            }
                        },
                        {
                            "text": "They decided to <w>plate</w> the car's bumpers with chrome for a shiny finish.",
                            "target_lang_translations": {
                                "ru": "Они решили <w>хромировать</w> бамперы автомобиля для блестящей отделки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gold plated",
                        "silver plated"
                    ],
                    "target_lang_definitions": {
                        "ru": "Покрывать объект тонким слоем металла."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плакировать",
                                "target_lang_sense_clarification": "наносить слой металла"
                            },
                            {
                                "target_lang_word": "покрывать",
                                "target_lang_sense_clarification": "наносить напыление"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "e94e0d69-9f40-3b56-9af4-6778825cee38",
                    "sense_definition": "A shortened name for the River Plate (Río de la Plata) in South America.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "geography",
                    "name_type": "geographical_feature",
                    "examples": [
                        {
                            "text": "The British fleet sailed into the shallow waters of the <w>Plate</w> during the conflict.",
                            "target_lang_translations": {
                                "ru": "Во время конфликта британский флот вошел в мелководье <w>Ла-Платы</w>."
                            }
                        },
                        {
                            "text": "Many historical battles took place near the mouth of the <w>Plate</w>.",
                            "target_lang_translations": {
                                "ru": "Многие исторические сражения происходили недалеко от устья <w>Ла-Платы</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "River Plate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращенное название реки Рио-де-ла-Плата в Южной Америке."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Ла-Плата",
                                "target_lang_sense_clarification": "географическое название"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}