                "senses": [
                    {
                        "sense_id": "66eff55f-d36b-34f0-920c-0fc318878edf",
                        "entry_id": "64f6942d-a49e-310e-80d8-984f874a3878",
                        "glosses": [
                            "Sieger bei einem Wettbewerb in einer bestimmten (meist sportlichen) Disziplin, bei dem es um die Weltmeisterschaft geht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e72cf304-3009-476b-bff8-46152fbc17ac",
                                "sense_id": "66eff55f-d36b-34f0-920c-0fc318878edf",
                                "text": "„Österreich ist erstmals Weltmeister im Faustball.“"
                            },
                            {
                                "example_id": "2d31478d-37b7-462d-b6b3-97fff508b6a3",
                                "sense_id": "66eff55f-d36b-34f0-920c-0fc318878edf",
                                "text": "„Der diesjährige Weltmeister im Sandskulpturenbau kommt aus Italien.“"
                            },
                            {
                                "example_id": "65a2528d-3623-4b4c-b570-bac8b60f336b",
                                "sense_id": "66eff55f-d36b-34f0-920c-0fc318878edf",
                                "text": "„Schon jetzt ist die Bundesrepublik Deutschland Weltmeister im Abhören von Telefongesprächen“"
                            },
                            {
                                "example_id": "dbe5c724-1006-4e88-840f-15652d8509b7",
                                "sense_id": "66eff55f-d36b-34f0-920c-0fc318878edf",
                                "text": "„Die Deutschen, international als Weltmeister der Vergangenheitsbewältigung bewundert, haben eín bedeutendes Kapitel ihrer Geschichte links liegen lassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
