                "senses": [
                    {
                        "sense_id": "8daabc41-794e-36fd-bc39-09d92b317b4d",
                        "entry_id": "53f3d36a-a3f3-3f53-9434-075fe49ccfc2",
                        "glosses": [
                            "Pferd, das einer zumeist aus Nordamerika stammenden Pferderasse angehört, welche für die besonderen Bedürfnisse der Cowboys gezüchtet wurde (etwa American Quarter Horse, Appaloosa, Colorado Ranger, Criollo oder Paint Horse), und heute etwa beim Westernreiten eingesetzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ca7b139-b784-4362-b759-54fbda1662c9",
                                "sense_id": "8daabc41-794e-36fd-bc39-09d92b317b4d",
                                "text": "Neben Spring- und Dressurpferden finden Sie in unserem Stall auch eine Auswahl erstklassiger Westernpferde."
                            },
                            {
                                "example_id": "769d3c8d-5fe6-4a83-b4de-3ba6b4b37c5d",
                                "sense_id": "8daabc41-794e-36fd-bc39-09d92b317b4d",
                                "text": "Obwohl Bounty als Friese kein klassisches Westernpferd ist, macht er beim Reining doch eine passable Figur."
                            },
                            {
                                "example_id": "f7ad43fe-ff25-4327-a224-0be383aa78c3",
                                "sense_id": "8daabc41-794e-36fd-bc39-09d92b317b4d",
                                "text": "Die Müllers haben sich zwei Westernpferde angeschafft, um an Wettkämpfen im Westernreiten teilnehmen zu können."
                            },
                            {
                                "example_id": "a2e518b4-15c4-46d4-a6cd-5d3e43598bd3",
                                "sense_id": "8daabc41-794e-36fd-bc39-09d92b317b4d",
                                "text": "Wir wollen unsere Pferdezucht nun auf Westernpferde umstellen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
