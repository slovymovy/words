                    {
                        "translation_id": "90c7d456-78a2-4ad4-b4c8-75f1dc77c0d0",
                        "source_entry_id": "77da33ef-3135-30a9-8bd0-04e7bf8b503c",
                        "source_sense_id": "9fd81897-94ad-33f9-96f1-1b5fa637854b",
                        "source_sense_description": "taxonomic group",
                        "target_lang_word": "taxon",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "taxon",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "63fb33a5-126a-36e4-bc11-8f604d670bca",
                                        "entry_id": "8f4196ed-6b0f-3452-9d77-e4956f0279b6",
                                        "glosses": [
                                            "categorie levende wezens die door gemeenschappelijke kenmerken een samenhangende eenheid binnen een omvattende wetenschappelijke (hiërarchische) indeling vormen; meestal heeft zo'n categorie in die indeling een naam en een plaats (rang) gekregen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1015129b-895a-4430-9e4d-c37f14426657",
                                                "sense_id": "63fb33a5-126a-36e4-bc11-8f604d670bca",
                                                "text": "Zowel de soort Homo sapiens als het geslacht Pan zijn taxa die weer beide gerekend worden tot het taxon Mammalia."
                                            },
                                            {
                                                "example_id": "854741e0-f6b2-4559-96db-ef9c28082b8f",
                                                "sense_id": "63fb33a5-126a-36e4-bc11-8f604d670bca",
                                                "text": "De nieuwe soort, die leefde tijdens het Maastrichtien (70-65 miljoen jaar geleden), wordt op basis van de gevonden restanten door de onderzoekers toegeschreven aan de familie van de Abelisauroidea, een tamelijk raadselachtig taxon dat bekend is van een beperkt aantal gebieden uit het vroegere supercontinent Gondwana (behalve van Madagascar ook van India en Argentinië)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e0960e4-f087-338e-a626-1c8fb3939495",
                                        "entry_id": "8f4196ed-6b0f-3452-9d77-e4956f0279b6",
                                        "glosses": [
                                            "aanduiding voor een type categorie binnen de omvattende wetenschappelijke indeling van levende wezens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a72553ed-6be5-4e94-bf39-aa00e404d7e0",
                                                "sense_id": "0e0960e4-f087-338e-a626-1c8fb3939495",
                                                "text": "Het zal menige lezer verbazen te vernemen, dat alle „Flora's\" samengesteld en beschreven worden aan de hand van geconserveerd materiaal. Dit is nl. de enige verantwoorde methode, omdat er meningsverschil kan bestaan omtrent de omgrenzing van systematische eenheden of taxa (enkelv. taxon), zoals soort (species), geslacht (genus), familie, enz. Daarom moeten determinaties verifieerbaar zijn voor anderen."
                                            },
                                            {
                                                "example_id": "8df27b0f-0c0a-4cb5-a4b8-d5a35a766af5",
                                                "sense_id": "0e0960e4-f087-338e-a626-1c8fb3939495",
                                                "text": "De onderscheiding van phylon, taxon, zuivere lijn en isogenon (Adolf Meyer) is noodzakelijk om logische ordening te brengen in de warwinkel van het biologische soortbegrip."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80a420a0-65b1-3482-b4aa-db28b1252294",
                                        "entry_id": "8f4196ed-6b0f-3452-9d77-e4956f0279b6",
                                        "glosses": [
                                            "onderdeel van een wetenschappelijke indeling met een eigen naam en een plaats (rang) daarin"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a93960e6-6499-4e1d-a9d5-3576093665db",
                                                "sense_id": "80a420a0-65b1-3482-b4aa-db28b1252294",
                                                "text": "De categorische scheiding tussen het taxon ‘taal’ en het taxon ‘dialect’ is wel gangbaar maar niet houdbaar."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "38ec2aa8-7529-413c-8b9d-64a0f7e7e6e1",
                        "source_entry_id": "77da33ef-3135-30a9-8bd0-04e7bf8b503c",
                        "source_sense_id": "9fd81897-94ad-33f9-96f1-1b5fa637854b",
                        "source_sense_description": "taxonomic group",
                        "target_lang_word": "taxon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "taxon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "044a63ca-4276-3996-972a-0d0c61e10a74",
                                        "entry_id": "a4c4afc2-4e2d-3671-965b-240afa12ac66",
                                        "glosses": [
                                            "Entité conceptuelle regroupant des êtres vivants partageant des caractères communs bien définis, et occupant un rang déterminé dans la hiérarchie de la classification biologique (comme l’espèce, le genre ou la famille)."
                                        ],
                                        "tags": [
                                            "Systématique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3150ab16-a118-4aef-8755-7e64b7010d62",
                                                "sense_id": "044a63ca-4276-3996-972a-0d0c61e10a74",
                                                "text": "J’ajoute que, même eu égard au fond, le terme de taxon est préférable à celui de « groupement taxonomique », ce dernier pouvant sembler mettre l’accent sur le travail du classificateur, l’autre au contraire se prêtant mieux à l'interprétation objective de la Nature."
                                            },
                                            {
                                                "example_id": "7458d9ed-77bc-4a12-b7e6-892dd33b5993",
                                                "sense_id": "044a63ca-4276-3996-972a-0d0c61e10a74",
                                                "text": "Dans un certain nombre de complexes polyploïdes, l’aire du taxon diploïde ancestral n’est pas limitée à une des deux chaînes, mais elle est pyrénéo-alpienne."
                                            },
                                            {
                                                "example_id": "c660ae8b-78c0-4cd0-b63f-9800501dad58",
                                                "sense_id": "044a63ca-4276-3996-972a-0d0c61e10a74",
                                                "text": "Les taxons les plus importants sont : règne, embranchement, classe, ordre, famille, genre, espèce, qui sont subdivisés ; d’autres sont sans nom."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "49b6a8e0-8024-4e46-9e29-e29791c0fa5c",
                        "source_entry_id": "77da33ef-3135-30a9-8bd0-04e7bf8b503c",
                        "source_sense_id": "9fd81897-94ad-33f9-96f1-1b5fa637854b",
                        "source_sense_description": "taxonomic group",
                        "target_lang_word": "Taxon",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Taxon",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "30507ba0-021a-3fcc-98fe-8ab902ffee3a",
                                        "entry_id": "58aeb54b-703d-3bdf-9a6c-5fb24b3fe9b2",
                                        "glosses": [
                                            "eine in der Biologie als systematische Einheit erkannte und entsprechend benannte Gruppe von Lebewesen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2b46455-f618-407e-b298-9b374e27c7d9",
                                                "sense_id": "30507ba0-021a-3fcc-98fe-8ab902ffee3a",
                                                "text": "Einige Insekten konnten wir bis zur Art bestimmen, bei anderen mussten wir es bei höheren Taxa bewenden lassen."
                                            },
                                            {
                                                "example_id": "bd832335-4e25-4b6b-b1f9-a3b43e1e4406",
                                                "sense_id": "30507ba0-021a-3fcc-98fe-8ab902ffee3a",
                                                "text": "„Einteilen bedeutet, Lebewesen zu Einheiten zu gruppieren, die Taxa oder Gruppen genannt werden.“"
                                            },
                                            {
                                                "example_id": "b51ccc12-39cd-48fd-a5ba-58bd7905f825",
                                                "sense_id": "30507ba0-021a-3fcc-98fe-8ab902ffee3a",
                                                "text": "„Nicht verschwiegen sei endlich, daß trotz der hier angestrebten Methode eine beträchtliche Anzahl von Taxa ohne befriedigende Etymologie oder gänzlich ungeklärt geblieben sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
