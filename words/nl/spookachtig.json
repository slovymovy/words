{
    "word_family": [
        "spoken",
        "spook",
        "spookhuis",
        "spookrijder",
        "spookstad",
        "spookverhaal"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9c6c00ab-d73f-3fb1-88f7-5ffc1cf03428",
                    "sense_definition": "Een griezelige, beklemmende of angstaanjagende sfeer hebbend; griezelig of mysterieus.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "spookachtig_griezelig",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De mist gaf het verlaten dorp een bijzonder <w>spookachtig</w> aanzien.",
                            "target_lang_translations": {
                                "de": "Der Nebel verlieh dem verlassenen Dorf ein besonders <w>gespenstisches</w> Aussehen."
                            }
                        },
                        {
                            "text": "In het donker klonk er een <w>spookachtige</w> stilte door de lege straten.",
                            "target_lang_translations": {
                                "de": "In der Dunkelheit herrschte eine <w>unheimliche</w> Stille in den leeren Straßen."
                            }
                        }
                    ],
                    "synonyms": [
                        "griezelig",
                        "onheilspellend"
                    ],
                    "common_phrases": [
                        "spookachtige stilte",
                        "spookachtige sfeer"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine unheimliche, beklemmende oder angsteinflößende Atmosphäre habend; gruselig oder mysteriös."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "gespenstisch",
                                "target_lang_sense_clarification": "unheimlich, geisterhaft wirkend"
                            },
                            {
                                "target_lang_word": "unheimlich",
                                "target_lang_sense_clarification": "ein beklemmendes Gefühl auslösend"
                            },
                            {
                                "target_lang_word": "geisterhaft",
                                "target_lang_sense_clarification": "von der Stimmung her an Geister erinnernd"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a1223138-8fc4-3760-84f5-fea91c7bc150",
                    "sense_definition": "Lijkend op of herinnerend aan een spook of schim; vaag, bleek of schimmig van gedaante.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "spookachtig_schimmig",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door het matte raam zagen we slechts een <w>spookachtige</w> gedaante bewegen.",
                            "target_lang_translations": {
                                "de": "Durch das matte Fenster sahen wir nur eine <w>schemenhafte</w> Gestalt sich bewegen."
                            }
                        },
                        {
                            "text": "Zijn bleke gezicht gaf hem een haast <w>spookachtig</w> uiterlijk na de zware ziekte.",
                            "target_lang_translations": {
                                "de": "Sein bleiches Gesicht verlieh ihm nach der schweren Krankheit ein beinahe <w>gespenstisches</w> Aussehen."
                            }
                        }
                    ],
                    "synonyms": [
                        "schimmig"
                    ],
                    "common_phrases": [
                        "spookachtige gedaante",
                        "spookachtige verschijning"
                    ],
                    "target_lang_definitions": {
                        "de": "Einem Gespenst oder Schatten ähnlich; schemenhaft, bleich oder geisterhaft in der Erscheinung."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "geisterhaft",
                                "target_lang_sense_clarification": "in Bezug auf Aussehen oder Gestalt"
                            },
                            {
                                "target_lang_word": "schemenhaft",
                                "target_lang_sense_clarification": "undeutlich, wie ein Schatten"
                            },
                            {
                                "target_lang_word": "gespenstisch",
                                "target_lang_sense_clarification": "blass, unnatürlich wirkend"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}