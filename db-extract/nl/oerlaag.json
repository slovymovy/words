                        "examples": [
                            {
                                "example_id": "ed6d3f26-5a36-4eb9-8211-65a443f1bea5",
                                "sense_id": "86dabcda-7057-3cd5-9a0f-b6cd1ac982b4",
                                "text": "De oorspronkelijke kleuren zijn niet gerestaureerd. De muren waren verschillende keren overgeschilderd en zo was de eerste kleur voor herstel zo goed als onbereikbaar. Wel kon een monster van de oerlaag worden genomen en aan de hand van die kleur werd de verf besteld."
                            }
                        ]
                    },
