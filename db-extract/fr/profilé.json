                                        "examples": [
                                            {
                                                "example_id": "8e08a75f-776c-40f6-b287-14728fad5a9b",
                                                "sense_id": "e1d825ae-6d17-3d00-9225-c57fe3cc37a5",
                                                "text": "I just updated my Facebook profile to show I got engaged."
                                            },
                                            {
                                                "example_id": "cd6cc756-f429-4aea-8dd9-d72bddabebc1",
                                                "sense_id": "e1d825ae-6d17-3d00-9225-c57fe3cc37a5",
                                                "text": "After getting permisssion from my mom, I personal messaged ten different Harveys from her profile who seemed “obviously” Native and lived in Phoenix."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e192647-116f-39b4-a0bd-0113a4b78efb",
                                        "entry_id": "c5bfb21f-ab7a-3756-b9e1-c0bca6a86a40",
                                        "glosses": [
                                            "Reputation, prominence; noticeability."
