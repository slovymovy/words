                                            {
                                                "example_id": "a7e2080b-2ae6-4f77-90c5-96f64250bf86",
                                                "sense_id": "a46a5ada-82fc-3367-a1f0-4100057c3362",
                                                "text": "En réponse à ces réformateurs qui contestent l'autorité de l'Église catholique, le pape Paul III réunit en un concile à Trente, en 1545-1549, en 1551-1552 et en 1562-1563, des clercs catholiques européens."
                                            },
                                            {
                                                "example_id": "6c163586-3041-43d6-a637-be99e356743d",
                                                "sense_id": "a46a5ada-82fc-3367-a1f0-4100057c3362",
                                                "text": "Usage de la langue française, office célébré face au peuple, chant « dégrégorianisé » : les normes fixées quatre siècles plus tôt à Trente étaient détricotées."
                                            }
                                        ]
                                    },
