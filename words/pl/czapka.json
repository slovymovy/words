                    "sense_definition": "Miękkie nakrycie głowy, często z daszkiem, noszone dla ochrony przed zimnem lub słońcem.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zimą zawsze noszę ciepłą <w>czapkę</w>, żeby nie zmarznąć.",
                            "target_lang_translations": {
                                "ru": "Зимой я всегда ношу тёплую <w>шапку</w>, чтобы не замёрзнуть.",
                                "en": "In winter I always wear a warm <w>hat</w> so I don't freeze.",
                                "nl": "'s Winters draag ik altijd een warme <w>muts</w> om het niet koud te krijgen.",
                                "de": "Im Winter trage ich immer eine warme <w>Mütze</w>, um nicht zu frieren.",
                                "fr": "En hiver, je porte toujours un <w>bonnet</w> chaud pour ne pas avoir froid.",
                                "it": "In inverno indosso sempre un <w>berretto</w> caldo per non avere freddo.",
                                "cs": "V zimě nosím vždy teplou <w>čepici</w>, abych nezmrznul.",
                                "tr": "Kışın üşümemek için her zaman sıcak bir <w>bere</w> takarım.",
                                "es": "En invierno siempre llevo un <w>gorro</w> caliente para no tener frío.",
                                "zh": "冬天我总是戴一顶暖和的<w>帽子</w>，以免着凉。"
                            }
                        },
                        {
                            "text": "Mój brat kupił sobie nową <w>czapkę</w> z daszkiem na lato.",
                            "target_lang_translations": {
                                "ru": "Мой брат купил себе новую <w>кепку</w> на лето.",
                                "en": "My brother bought himself a new <w>cap</w> for the summer.",
                                "nl": "Mijn broer heeft een nieuwe <w>pet</w> gekocht voor de zomer.",
                                "de": "Mein Bruder hat sich eine neue <w>Kappe</w> für den Sommer gekauft.",
                                "fr": "Mon frère s'est acheté une nouvelle <w>casquette</w> pour l'été.",
                                "it": "Mio fratello si è comprato un nuovo <w>berretto</w> con visiera per l'estate.",
                                "cs": "Můj bratr si na léto koupil novou <w>kšiltovku</w>.",
                                "tr": "Erkek kardeşim yaz için kendine yeni bir siperlikli <w>şapka</w> aldı.",
                                "es": "Mi hermano se compró una nueva <w>gorra</w> con visera para el verano.",
                                "zh": "我哥哥为夏天买了一顶新的带檐<w>帽子</w>。"
                            }
                        }
