{
    "word_family": [
        "trifling",
        "trifler"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c44b924c-8307-39f0-a8f1-848f3db7d35e",
                    "sense_definition": "Anything that is of little importance or worth.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "insignificance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She gets upset over the smallest <w>trifle</w>.",
                            "target_lang_translations": {
                                "zh": "她常常为最微不足道的<w>小事</w>生气。",
                                "es": "Se molesta por la menor <w>nimiedad</w>."
                            }
                        },
                        {
                            "text": "Do not waste your energy on such <w>trifles</w> when there is real work to do.",
                            "target_lang_translations": {
                                "zh": "有正事要做的时候，别把精力浪费在这些<w>琐事</w>上。",
                                "es": "No malgastes tus energías en semejantes <w>naderías</w> cuando hay trabajo real que hacer."
                            }
                        }
                    ],
                    "synonyms": [
                        "triviality",
                        "bagatelle"
                    ],
                    "common_phrases": [
                        "mere trifle"
                    ],
                    "target_lang_definitions": {
                        "zh": "微不足道的事物或琐事。",
                        "es": "Cosa o asunto de escasa importancia, valor o trascendencia."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "琐事",
                                "target_lang_sense_clarification": "指不重要的小事。"
                            },
                            {
                                "target_lang_word": "小事",
                                "target_lang_sense_clarification": "指价值不高或不重要的事情。"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "nimiedad",
                                "target_lang_sense_clarification": "asunto de muy poca importancia"
                            },
                            {
                                "target_lang_word": "nadería",
                                "target_lang_sense_clarification": "cosa sin valor o trascendencia"
                            },
                            {
                                "target_lang_word": "pequeñez",
                                "target_lang_sense_clarification": "detalle o cosa insignificante"
                            },
                            {
                                "target_lang_word": "menudencia",
                                "target_lang_sense_clarification": "cosa menuda o de poca estimación"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b6ec220f-93a2-3ea4-b0c0-3c170f1a6c4e",
                    "sense_definition": "A very small amount of something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "small_amount",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Add just a <w>trifle</w> of salt to the soup to improve the flavor.",
                            "target_lang_translations": {
                                "zh": "往汤里加<w>一点点</w>盐来提味。",
                                "es": "Añade solo una <w>pizca</w> de sal a la sopa para realzar el sabor."
                            }
                        },
                        {
                            "text": "The room was a <w>trifle</w> too cold for comfort.",
                            "target_lang_translations": {
                                "zh": "房间里<w>稍微</w>有点冷，不太舒服。",
                                "es": "La habitación estaba un <w>poco</w> fría de más para resultar cómoda."
                            }
                        }
                    ],
                    "synonyms": [
                        "bit",
                        "modicum",
                        "smidgen"
                    ],
                    "common_phrases": [
                        "a trifle"
                    ],
                    "target_lang_definitions": {
                        "zh": "极少量；一点点。",
                        "es": "Cantidad muy pequeña o grado leve de algo."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "一点点",
                                "target_lang_sense_clarification": "表示数量非常少。"
                            },
                            {
                                "target_lang_word": "稍微",
                                "target_lang_sense_clarification": "用于程度副词，表示程度很轻。"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "pizca",
                                "target_lang_sense_clarification": "cantidad muy reducida"
                            },
                            {
                                "target_lang_word": "un poco",
                                "target_lang_sense_clarification": "en grado ligero o leve"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "16162965-0b2e-3f2c-8592-89284274666d",
                    "sense_definition": "An English dessert made from custard, fruit, sponge cake, and whipped cream.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We prepared a traditional <w>trifle</w> for the holiday dinner party.",
                            "target_lang_translations": {
                                "zh": "我们为节日晚宴准备了一份传统的<w>英式松糕</w>。",
                                "es": "Preparamos un <w>trifle</w> tradicional para la cena de fiesta."
                            }
                        },
                        {
                            "text": "The layers of the <w>trifle</w> looked beautiful in the glass bowl.",
                            "target_lang_translations": {
                                "zh": "玻璃碗里的<w>英式松糕</w>分层看起来很漂亮。",
                                "es": "Las capas del <w>trifle</w> se veían hermosas en el bol de cristal."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一种英式甜点，由奶油冻、水果、海绵蛋糕和鲜奶油分层制成。",
                        "es": "Postre tradicional inglés hecho con capas de bizcocho, crema pastelera, fruta y nata montada."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "英式松糕",
                                "target_lang_sense_clarification": "指代这种特定的英式分层甜点。"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "trifle",
                                "target_lang_sense_clarification": "nombre del postre tradicional inglés"
                            },
                            {
                                "target_lang_word": "sopa inglesa",
                                "target_lang_sense_clarification": "postre semejante de capas"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c84fa13d-26ec-3379-bf2b-4ebb3b18ade7",
                    "sense_definition": "To inconsequentially toy with something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "toy_with",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He sat at the table and <w>trifled</w> with his pen while thinking.",
                            "target_lang_translations": {
                                "zh": "他坐在桌边，思考时不停地<w>摆弄</w>着手中的笔。",
                                "es": "Se sentó a la mesa y <w>jugueteó</w> con el bolígrafo mientras pensaba."
                            }
                        },
                        {
                            "text": "She <w>trifled</w> with her food because she was not hungry.",
                            "target_lang_translations": {
                                "zh": "因为不饿，她只是漫不经心地<w>摆弄</w>着盘子里的食物。",
                                "es": "Ella <w>jugueteaba</w> con la comida porque no tenía hambre."
                            }
                        }
                    ],
                    "synonyms": [
                        "fiddle"
                    ],
                    "common_phrases": [
                        "trifle with"
                    ],
                    "target_lang_definitions": {
                        "zh": "漫不经心地摆弄或玩弄某物。",
                        "es": "Juguetear o manipular algo de forma distraída y sin un propósito serio."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "摆弄",
                                "target_lang_sense_clarification": "指无目的地玩弄物体。"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "juguetear",
                                "target_lang_sense_clarification": "manipular distraídamente un objeto"
                            },
                            {
                                "target_lang_word": "enredar",
                                "target_lang_sense_clarification": "trastear con algo sin fin concreto"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cc07337d-ed02-3506-9424-79770d7b9233",
                    "sense_definition": "To deal with something or someone as if they were of little importance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "insignificance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should not <w>trifle</w> with the feelings of others.",
                            "target_lang_translations": {
                                "zh": "你不应该<w>戏弄</w>别人的感情。",
                                "es": "No deberías <w>jugar</w> con los sentimientos de los demás."
                            }
                        },
                        {
                            "text": "The manager warned that he would not be <w>trifled</w> with during the meeting.",
                            "target_lang_translations": {
                                "zh": "经理警告说，会议期间不容许任何人<w>轻视</w>他。",
                                "es": "El gerente advirtió que no permitiría que lo <w>trataran a la ligera</w> durante la reunión."
                            }
                        }
                    ],
                    "common_phrases": [
                        "trifle with"
                    ],
                    "target_lang_definitions": {
                        "zh": "轻视或戏弄某人或某事。",
                        "es": "Tratar a alguien o algo con falta de respeto, seriedad o consideración."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "戏弄",
                                "target_lang_sense_clarification": "指不严肃地对待他人感情。"
                            },
                            {
                                "target_lang_word": "轻视",
                                "target_lang_sense_clarification": "指不把某人或某事放在眼里。"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "tratar a la ligera",
                                "target_lang_sense_clarification": "no tomar en serio a alguien o algo"
                            },
                            {
                                "target_lang_word": "jugar con",
                                "target_lang_sense_clarification": "tomarse a broma los sentimientos o la autoridad"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1757aa35-4292-39b1-9026-4edd2b73c73d",
                    "sense_definition": "To squander or waste time.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "waste",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Do not <w>trifle</w> away your youth on unproductive habits.",
                            "target_lang_translations": {
                                "zh": "不要把青春<w>虚度</w>在毫无意义的习惯上。",
                                "es": "No <w>desperdicies</w> tu juventud en hábitos improductivos."
                            }
                        },
                        {
                            "text": "They <w>trifled</w> away the entire afternoon doing nothing of value.",
                            "target_lang_translations": {
                                "zh": "他们整个下午什么有价值的事都没做，就这样<w>虚度</w>了光阴。",
                                "es": "<w>Malgastaron</w> toda la tarde sin hacer nada de valor."
                            }
                        }
                    ],
                    "synonyms": [
                        "fritter"
                    ],
                    "common_phrases": [
                        "trifle away"
                    ],
                    "target_lang_definitions": {
                        "zh": "虚度或浪费时间。",
                        "es": "Malgastar o perder el tiempo en actividades vanas o improductivas."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "虚度",
                                "target_lang_sense_clarification": "指白白浪费时间或光阴。"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "desperdiciar",
                                "target_lang_sense_clarification": "malgastar tiempo o energía"
                            },
                            {
                                "target_lang_word": "malgastar",
                                "target_lang_sense_clarification": "desaprovechar el tiempo"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}