        "fr-extract.jsonl": [
            {
                "entry_id": "a4aa251f-a051-366f-842d-e3948460d726",
                "word": "calorique",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b9fff3cb-90f3-4e23-8aad-918c2fc985fb",
                        "entry_id": "a4aa251f-a051-366f-842d-e3948460d726",
                        "tags": [
                            "plural"
                        ],
                        "form": "caloriques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "125d41d3-6ef2-3655-8a32-592d22c41427",
                        "entry_id": "a4aa251f-a051-366f-842d-e3948460d726",
                        "glosses": [
                            "Relatif aux calories, à la valeur nutritive énergétique."
                        ],
                        "tags": [
                            "Nutrition"
                        ],
                        "examples": [
                            {
                                "example_id": "1dd023a4-cef7-4ffc-9bbf-41ca58655c9a",
                                "sense_id": "125d41d3-6ef2-3655-8a32-592d22c41427",
                                "text": "La valeur calorique de la ration de la Croix-Rouge russe est de 2800-3200 calories pour les malades et de 750-900 calories pour les affamés."
                            },
                            {
                                "example_id": "f273e70b-afa2-46ae-a3c7-63ba36746cec",
                                "sense_id": "125d41d3-6ef2-3655-8a32-592d22c41427",
                                "text": "La valeur calorique des aliments appartenant à la première des catégories désignées ci-dessus doit résulter d'apports se répartissant de la façon suivante:\n. Apport calorique des glucides : 50 à 60 p. 100\n. Apport calorique des protides : 13 à 17 p. 100"
                            }
                        ]
                    },
                    {
                        "sense_id": "172ed14f-f62a-3fa5-a84b-c332bfaab07f",
                        "entry_id": "a4aa251f-a051-366f-842d-e3948460d726",
                        "glosses": [
                            "Se dit d’un aliment riche en kilocalories."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "29b2c348-a37c-432c-8f79-ac6f84ad902f",
                                "sense_id": "172ed14f-f62a-3fa5-a84b-c332bfaab07f",
                                "text": "Fait de pâte feuilletée levée (comme le croissant) à laquelle on ajoute une (voire deux) barres de chocolat, le pain au chocolat est bien évidemment calorique, gras et sucré... mais si bon !"
                            },
                            {
                                "example_id": "6627fbf3-961b-4db4-88e0-c1ee96140d3a",
                                "sense_id": "172ed14f-f62a-3fa5-a84b-c332bfaab07f",
                                "text": "Si la Chine s’est hissée au rang de première puissance châtaignière du monde, c’est à cause de la grande famine des années 60 (30 millions de morts), après laquelle Mao a ordonné de planter à tour de bras des châtaigniers, au motif que Castanea sativa, de son nom latin, est un fruit calorique proche des céréales et plus facile à cultiver."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "790da9da-35e9-41be-a394-51501266ca6a",
                        "source_entry_id": "a4aa251f-a051-366f-842d-e3948460d726",
                        "target_lang_word": "caloric",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "caloric",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0b21d182-31da-36d6-b156-e719d7d76ce7",
                                        "entry_id": "9e014445-4676-38c5-92fa-d7fdcef9a1a9",
                                        "glosses": [
                                            "Relating to calories."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c90651d-49e6-4643-8f54-5be3c14ef8c1",
                                                "sense_id": "0b21d182-31da-36d6-b156-e719d7d76ce7",
                                                "text": "caloric intake"
                                            },
                                            {
                                                "example_id": "965ecf04-f80d-42da-a15c-790e1f8af4d2",
                                                "sense_id": "0b21d182-31da-36d6-b156-e719d7d76ce7",
                                                "text": "This strategy, known as caloric restriction, has been shown to increase the life span of various organisms and reduce their rate of cancer and other age-related ailments."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1571dd6-c447-3a58-834b-3d24bafc7180",
                                        "entry_id": "9e014445-4676-38c5-92fa-d7fdcef9a1a9",
                                        "glosses": [
                                            "Containing calories."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8d19631-0aab-4cc4-b6d8-579585170d7d",
                                                "sense_id": "f1571dd6-c447-3a58-834b-3d24bafc7180",
                                                "text": "Milk is a caloric beverage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e697bf9-d4ec-367f-822a-c7b477d99ee1",
                                        "entry_id": "9e014445-4676-38c5-92fa-d7fdcef9a1a9",
                                        "glosses": [
                                            "Synonym of calorific (“high in calories and thus likely fattening”)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70c41365-4bcd-4bb6-a150-d2aff3a8bc1f",
                                                "sense_id": "7e697bf9-d4ec-367f-822a-c7b477d99ee1",
                                                "text": "a dry, caloric food"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44f4c905-989e-3ddd-b589-04fe2c1c2b2e",
                                        "entry_id": "9e014445-4676-38c5-92fa-d7fdcef9a1a9",
                                        "glosses": [
