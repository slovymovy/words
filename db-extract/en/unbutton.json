                        "target_lang_word": "aufknöpfen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aufknöpfen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e890cd35-8010-3c50-8042-bbb722268a6c",
                                        "entry_id": "c85baae9-524f-3bff-9bb4-9c140011e46d",
                                        "glosses": [
                                            "mit Knöpfen verschlossenes Kleidungsstück öffnen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d650737-2114-449c-983e-2d13f06cf32c",
                                                "sense_id": "e890cd35-8010-3c50-8042-bbb722268a6c",
                                                "text": "Wichtig ist zudem: Achten Sie darauf, dass der Kragen des T-Shirts nie sichtbar ist – auch nicht, wenn Sie das Hemd etwas aufknöpfen."
                                            },
                                            {
                                                "example_id": "6f9e54c4-cb4a-4581-8c68-65fb5c7ea4e1",
                                                "sense_id": "e890cd35-8010-3c50-8042-bbb722268a6c",
                                                "text": "Und dann tauchen überall Promis auf, die einen ganz eigenen Trick gegen Spannerlöcher in der Bluse entwickelt zu haben scheinen: einfach aufknöpfen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a7db78f7-9aa3-370a-bf00-6edaf83991d3",
                                        "entry_id": "c85baae9-524f-3bff-9bb4-9c140011e46d",
                                        "glosses": [
                                            "auf etwas knüpfen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0a04dd1-608a-4c73-9e0f-03ad1839bb82",
                                                "sense_id": "a7db78f7-9aa3-370a-bf00-6edaf83991d3",
                                                "text": "Der Saum lässt sich seitlich aufknöpfen."
                                            },
                                            {
                                                "example_id": "1215f47e-027e-4df8-85b4-b8e2774c68c8",
                                                "sense_id": "a7db78f7-9aa3-370a-bf00-6edaf83991d3",
                                                "text": "Die Fledermausärmel lassen sich mit Druckknöpfen bis zum abgerundeten Saum aufknöpfen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
