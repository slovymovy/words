    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ae1c63c4-4107-39d7-8387-a0b3991f2f07",
                    "sense_definition": "A copy or reproduction of something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "copy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The museum displayed an exact <w>replication</w> of the ancient crown.",
                            "target_lang_translations": {
                                "ru": "В музее была выставлена точная <w>копия</w> древней короны."
                            }
                        },
                        {
                            "text": "This digital <w>replication</w> captures every detail of the original painting.",
                            "target_lang_translations": {
                                "ru": "Эта цифровая <w>репродукция</w> передает каждую деталь оригинальной картины."
                            }
                        }
                    ],
                    "synonyms": [
                        "copy",
                        "reproduction",
                        "duplicate",
                        "replica"
                    ],
                    "common_phrases": [
                        "exact replication",
                        "digital replication"
                    ],
                    "target_lang_definitions": {
