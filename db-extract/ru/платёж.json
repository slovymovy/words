                                    {
                                        "sense_id": "227adf05-289f-3cd4-aabf-4b8b5bfb60bd",
                                        "entry_id": "3ccb6247-fa31-3c56-ae1c-98d59b5df1a5",
                                        "glosses": [
                                            "het overhandigen of overboeken van geld in ruil voor goed of dienst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cd8bb80-5035-480d-8609-b68eb07d8491",
                                                "sense_id": "227adf05-289f-3cd4-aabf-4b8b5bfb60bd",
                                                "text": "De betaling is nog niet binnen."
                                            },
                                            {
                                                "example_id": "a1eb13bf-ab3c-4c0e-870a-d11a15f0bc88",
                                                "sense_id": "227adf05-289f-3cd4-aabf-4b8b5bfb60bd",
                                                "text": "Maar uit het onderzoek van NRC en partners blijkt dat Worldline ook tienduizenden betalingen verzorgt van dubieuze bedrijven die klanten jaarlijks voor tientallen miljoenen euro’s oplichten, met honderden malafide websites."
                                            },
                                            {
                                                "example_id": "09e0ff40-a63b-403e-b89d-6f7d8f5e65be",
                                                "sense_id": "227adf05-289f-3cd4-aabf-4b8b5bfb60bd",
                                                "text": "Achterstallige betalingen, offertes die veel te lang waren blijven liggen, facturen die niet verstuurd waren."
                                            },
                                            {
                                                "example_id": "76e45913-0df9-48ef-a360-ab5a37435b11",
                                                "sense_id": "227adf05-289f-3cd4-aabf-4b8b5bfb60bd",
                                                "text": "Ook in het voetbal ging een principiële strijd vooraf aan de legalisering van betalingen aan spelers in 1885."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
