                                        "examples": [
                                            {
                                                "example_id": "ae5f7634-0c70-4c6f-ad67-f2b729c74c3b",
                                                "sense_id": "b1ec2ffe-ed3b-3f86-99ff-29780eb5fc21",
                                                "text": "Durch den Verkauf von 500 Kugeln Speiseeis zu 1 Euro pro Kugel hatte der Eisverkäufer einen Umsatz von 500 Euro."
                                            },
                                            {
                                                "example_id": "eaea48f5-7adf-4d72-bd0e-60443f4fd4df",
                                                "sense_id": "b1ec2ffe-ed3b-3f86-99ff-29780eb5fc21",
                                                "text": "„Die Baufirmen melden die höchsten Umsätze seit über 20 Jahren.“"
                                            },
                                            {
                                                "example_id": "1f40f3cc-8f94-4519-8027-f8589aa1a463",
                                                "sense_id": "b1ec2ffe-ed3b-3f86-99ff-29780eb5fc21",
                                                "text": "„Der direkte Weg in die Kinderzimmer ist für die Modelleisenbahner nämlich nach wie vor mühsam; nur etwa zehn Prozent des Umsatzes erwirtschaftet Märklin mit Einsteigersets für Kinder.“"
                                            }
