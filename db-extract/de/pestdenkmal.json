                ],
                "senses": [
                    {
                        "sense_id": "728aeb8f-1022-3a18-92a8-9fe72808bcce",
                        "entry_id": "8df30135-9fa7-3c67-b254-9cf2edc132aa",
                        "glosses": [
                            "Objekt, das errichtet wurde, um an die Pest und deren Opfer zu erinnern und zu mahnen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0ccf439-40dc-422e-90d0-71004ce6a5bc",
                                "sense_id": "728aeb8f-1022-3a18-92a8-9fe72808bcce",
                                "text": "„Schon seit Jahrhunderten steht es neben der Geiselsberger Straße, an der Abzweigung zum Weiler Mühlbach: das Pestdenkmal, im Volksmund „Spitziges Stöckl“ genannt.“"
                            },
                            {
                                "example_id": "83c37d3f-fc08-40b4-af90-e8c1a7b3d10d",
                                "sense_id": "728aeb8f-1022-3a18-92a8-9fe72808bcce",
                                "text": "„Als Dankbarkeit bauten die Einwohner Wilhelmsthals, die die Krankheit überlebt haben, ein Pestdenkmal mit einem Schriftzug: GOTT ZV Danc UND Ehre VOR Verbergehen DEN EIN Labsal ZVR Geistigen Staercvung“"
                            },
                            {
                                "example_id": "c1d3983e-26e9-4f39-929c-de8be8d5824d",
                                "sense_id": "728aeb8f-1022-3a18-92a8-9fe72808bcce",
                                "text": "„Weitere Sehenswürdigkeiten sind das barocke Pestdenkmal, das in der Mitte des Palacky-Platzes steht, die Renaissancekirche St. Margareta, die im 18. Jahrhundert im Barockstil umgebaut wurde, die gotische Friedhofskirche des hl. Wenzels aus dem 13. Jahrhundert, die im 18. Jahrhundert ebenfalls im Barockstil umgebaut wurde.“"
                            },
                            {
                                "example_id": "5f084998-85b7-4fa3-aa9d-7f054e1bbc05",
                                "sense_id": "728aeb8f-1022-3a18-92a8-9fe72808bcce",
                                "text": "„Nur wenige Schritte vom Palazzo Guardi liegt die Galleria dell’Accademia, in der viele Werke von berühmten venezianischen und nicht venezianischen Künstlern aufbewahrt werden, die Peggy Guggenheim Collection, die Zattere, der ideale Ort für einen romantischen Spaziergang, und die spektakuläre Kirche “Basilica della Salute”, die von den Venezianern als Pestdenkmal errichtet wurde.“"
                            },
                            {
                                "example_id": "2e211c16-58fb-49f5-ab9d-5e7e856f8bff",
                                "sense_id": "728aeb8f-1022-3a18-92a8-9fe72808bcce",
                                "text": "„Bei den künstlerischen Gegebenheiten muss man die verschiedenen Statuen wie das Pestdenkmal und Statue; Szent Antal Denkmal; Helden Statue und die verschiedenen Steinkruzifixe erwähnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
