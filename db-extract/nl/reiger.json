                        ]
                    },
                    {
                        "translation_id": "b3f89297-395e-4b6f-a84c-5d9632ceb108",
                        "source_entry_id": "eaeff9a6-1cca-3bd8-8682-8e3af76d1de4",
                        "source_sense_id": "c10e9b15-983b-3764-b9e4-35c401defacd",
                        "source_sense_description": "benaming voor ooievaarachtige watervogels uit de familie Ardeidae",
                        "target_lang_word": "héron",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "héron",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d482aa97-d1ed-387e-826b-ef6edec5208f",
                                        "entry_id": "ae83ead1-9426-3bd0-aec4-0b505984c354",
                                        "glosses": [
                                            "Grand oiseau de l’ordre des échassiers, qui a le bec fort long et les jambes fort hautes, et qui vit principalement de poisson."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81b3d0a2-8bd0-4110-b81b-5d9fb1c1a993",
                                                "sense_id": "d482aa97-d1ed-387e-826b-ef6edec5208f",
                                                "text": "Des oiseaux qui parent encore agréablement les rives du Nil sont les hérons. Dans le nombre, on en distingue des espèces blanches, parmi lesquelles sont le garde-bœuf et l’aigrette."
                                            },
                                            {
                                                "example_id": "8e33f3b0-9997-4f88-aec3-9c3e5de7e75d",
                                                "sense_id": "d482aa97-d1ed-387e-826b-ef6edec5208f",
                                                "text": "Les hérons aux ailes de fer et les flamants dont le col se recourbe, traversent les mornes étendues ; les faisans courent sur le sable vert et l’horizon n’est qu’une ligne égale et brune que vient rompre à peine la cime noire d’un pin parasol."
                                            },
                                            {
                                                "example_id": "14ff002d-7767-40cd-9223-ae1c0b9119ec",
                                                "sense_id": "d482aa97-d1ed-387e-826b-ef6edec5208f",
                                                "text": "Patient comme un héron, il connaît les bons endroits, et si la truite veut mordre, vous aurez beau lui crier que c’est l’heure de la soupe, il se fera plus sourd que jamais, et continuera de remuer sa ligne dans un épais nuage de fumée, comme s’il n’existait au monde que sa pipe, sa ligne et la grosse bâdreuse qu’il va tout à l’heure tirer de l’eau, en riant d’un petit rire féroce."
                                            },
                                            {
                                                "example_id": "2e61d730-842c-4a75-b0e2-91d9d40a0d1b",
                                                "sense_id": "d482aa97-d1ed-387e-826b-ef6edec5208f",
                                                "text": "Des cygnes immobiles friment sur les rochers, des goélands désargentés mendient les poissons morts, un héron immobile attend son tour."
                                            },
                                            {
                                                "example_id": "6ba996c0-8170-4265-8adb-c558682aed2b",
                                                "sense_id": "d482aa97-d1ed-387e-826b-ef6edec5208f",
                                                "text": "Vol de héron – les hérons sont nombreux, mais toujours solitaires –, l’oiseau attend le dernier moment pour décoller, battant lourdement ses ailes, planant comme s’il ne parvenait pas à s’élever."
                                            },
                                            {
                                                "example_id": "630d198e-1a03-41a8-aae5-f1a7b218b137",
                                                "sense_id": "d482aa97-d1ed-387e-826b-ef6edec5208f",
                                                "text": "Sa biodiversité est exceptionnelle : hérons, aigrettes, poules d’eau, mais aussi orchidées sauvages, iris jaunes, roseaux…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "edeb2417-44cd-3f0a-b764-8b9e38fa060d",
                                        "entry_id": "ae83ead1-9426-3bd0-aec4-0b505984c354",
                                        "glosses": [
                                            "Meuble représentant l’animal du même nom dans les armoiries. Il est généralement représenté de profil, debout sur ses pattes, les ailes repliées. Il se distingue de la grue par sa posture, le manque de vigilance et parfois par une huppe à l’arrière du crâne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf84ad30-c3a7-499f-a6f4-073a2724000a",
                                                "sense_id": "edeb2417-44cd-3f0a-b764-8b9e38fa060d",
                                                "text": "De gueules au héron d’argent, becqué et membré de sable, qui est de Porcaro du Morbihan → voir illustration « armoiries avec un héron »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
