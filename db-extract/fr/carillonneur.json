        "fr-extract.jsonl": [
            {
                "entry_id": "adf21059-fda8-31cc-8e0a-704041142ec7",
                "word": "carillonneur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3ffe57e4-d15e-45c1-9657-f33d274d83e9",
                        "entry_id": "adf21059-fda8-31cc-8e0a-704041142ec7",
                        "tags": [
