                    {
                        "sense_id": "0149a38e-8658-3da3-becc-b14164a7eabe",
                        "entry_id": "a205807c-5a5b-3b08-95f4-9d19bf394db7",
                        "glosses": [
                            "La lettre ß utilisée en allemand. Elle porte le numéro 223 dans le répertoire Unicode."
                        ],
                        "tags": [
                            "Germanisme"
                        ],
                        "examples": [
                            {
                                "example_id": "24e70bfc-a622-46a2-b633-52a3d49caf4e",
                                "sense_id": "0149a38e-8658-3da3-becc-b14164a7eabe",
                                "text": "L'eszett (prononcé \"essetsette\"), c'est le nom officiel de cette drôle de lettre qui est unique à l'alphabet allemand."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9d6afe40-0778-4053-9a39-290bd49ea2ef",
                        "source_entry_id": "a205807c-5a5b-3b08-95f4-9d19bf394db7",
                        "source_sense_id": "0149a38e-8658-3da3-becc-b14164a7eabe",
                        "source_sense_description": "Lettre ß",
                        "target_lang_word": "Eszett",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eszett",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8edf9a9a-efb4-3e96-9296-3ad6d9a9244f",
                                        "entry_id": "3923b13c-d48d-309a-abd0-e68374e30b19",
                                        "glosses": [
                                            "der deutsche Buchstabe und Konsonant „ß“ für das stimmlose „s“ in der deutschen und österreichischen Rechtschreibung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3516d34a-db44-4839-8bbf-6920f240d5c4",
                                                "sense_id": "8edf9a9a-efb4-3e96-9296-3ad6d9a9244f",
                                                "text": "Das Eszett kam im 14. Jahrhundert als Schreibweise für das „ſs“ auf."
                                            },
                                            {
                                                "example_id": "edefcf5f-bee4-4a32-b64e-2571444ea2a7",
                                                "sense_id": "8edf9a9a-efb4-3e96-9296-3ad6d9a9244f",
                                                "text": "Im Volksmund wird das Eszett auch Ringel-S genannt."
                                            },
                                            {
                                                "example_id": "ee946ca0-a4ec-47ea-befa-26a05a7caf9c",
                                                "sense_id": "8edf9a9a-efb4-3e96-9296-3ad6d9a9244f",
                                                "text": "„Als alles ausgemalt war, fehlte immer noch das große Eszett. Ich fragte Frau Kahlfuß danach, und sie sagte, das gebe es nicht. Es gebe nur das kleine Eszett.“"
                                            },
                                            {
                                                "example_id": "667cf686-e44a-4687-ba2e-112bd0461771",
                                                "sense_id": "8edf9a9a-efb4-3e96-9296-3ad6d9a9244f",
                                                "text": "„Es wird von 26 Grundbuchstaben gesprochen, hinzu kommen dann aber noch meine Feinde auf Erden, die Umlautbuchstaben Ä, Ö, Ü, mit einer weiteren seltsamen Erscheinung, dem Eszett (ß), das man auch »scharfes S«, »Doppel-S« oder »Rucksack-S« nennt.“"
                                            },
                                            {
                                                "example_id": "c43ddc4f-e28b-42fe-ac91-8a9cd2c33b99",
                                                "sense_id": "8edf9a9a-efb4-3e96-9296-3ad6d9a9244f",
                                                "text": "„Apropos ß. Dieses Zeichen ist aus den Frakturschrift-Buchstaben (Lang-, nicht Rund-)s und (Unterlängen-)ʒ als Buchstabenverbindung (Ligatur) entstanden, daher sein Name Es-Zett.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "894745ec-e0e4-49a1-bcbb-5ebbdc5c3b84",
                        "source_entry_id": "a205807c-5a5b-3b08-95f4-9d19bf394db7",
                        "source_sense_id": "0149a38e-8658-3da3-becc-b14164a7eabe",
                        "source_sense_description": "Lettre ß",
                        "target_lang_word": "eszett",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eszett",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "67fb28ef-0863-3492-ad24-ece392e725b1",
                                        "entry_id": "9682dc77-7069-3f7c-bd81-f4e77dfc0411",
                                        "glosses": [
                                            "The name of the Latin-script letter ẞ/ß."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed22812b-0429-452d-b2d0-c1c2b0d1fdd7",
                                                "sense_id": "67fb28ef-0863-3492-ad24-ece392e725b1",
                                                "text": "In fits of concealed despair that went unnoticed even by those close enough to touch, Julien cursed the language of umlauts, eszetts, and gerunds."
                                            },
                                            {
                                                "example_id": "37b4f90e-5f57-4abc-ac14-ca53005d27c5",
                                                "sense_id": "67fb28ef-0863-3492-ad24-ece392e725b1",
                                                "text": "In German, the ß character is called eszett. It’s used in “Straße,” the word for street, and in the expletive “Scheiße.” It’s often transliterated as “ss,” and strangely enough, it’s never had an official uppercase counterpart."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
