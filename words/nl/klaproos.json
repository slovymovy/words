                            },
                            {
                                "target_lang_word": "papaver",
                                "target_lang_sense_clarification": "botanical name"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4113e31a-d7ce-3f70-889a-31d542b55ff5",
                    "sense_definition": "De tere en kwetsbare bloem van de papaverplant.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "bloemen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De blaadjes van de <w>klaproos</w> vallen snel af als je ze plukt.",
                            "target_lang_translations": {
                                "en": "The petals of the <w>poppy</w> fall off quickly if you pick them."
                            }
                        },
                        {
                            "text": "Zodra het begint te regenen klapt de <w>klaproos</w> haar bloemblaadjes dicht.",
                            "target_lang_translations": {
