                "senses": [
                    {
                        "sense_id": "822672a6-b1e3-3593-9621-86f0b43026b9",
                        "entry_id": "d91570c9-3952-3898-ac1d-25e019577db2",
                        "glosses": [
                            "osoba dokonująca prowokacji"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0061e0bb-12e9-486c-8a45-32f876d0451d",
                                "sense_id": "822672a6-b1e3-3593-9621-86f0b43026b9",
                                "text": "Jan jest płatnym prowokatorem na usługach policji i pobiera za to regularne apanaże zupełnie bez skrupułów."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "4ca6a6bd-8afa-307a-8510-9e0400bad789",
                        "entry_id": "d91570c9-3952-3898-ac1d-25e019577db2",
                        "glosses": [
                            "tajny agent działający w jakiejś organizacji, który jej szkodzi"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "65cde2c7-d708-4ed3-9a74-b3c115cfe31e",
                        "source_entry_id": "d91570c9-3952-3898-ac1d-25e019577db2",
                        "source_sense_id": "4ca6a6bd-8afa-307a-8510-9e0400bad789",
                        "target_lang_word": "agent provocateur",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "agent provocateur",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4a22ed61-bcf1-35e8-8c19-85bbdfc272d8",
                                        "entry_id": "11d772f3-05c3-3a0e-b8e0-ca3dad2f5113",
                                        "glosses": [
                                            "A person who secretly disrupts a group's activities from within the group, particularly by encouraging or committing illegal acts to discredit the group or expose them to prosecution; an instigator, troublemaker."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6969061d-8a7d-41f6-9226-4eadbf47e335",
                                                "sense_id": "4a22ed61-bcf1-35e8-8c19-85bbdfc272d8",
                                                "text": "\"This agent-provocateur business is quite foreign to British justice.\""
                                            },
                                            {
                                                "example_id": "c4ad91ee-b1de-4c00-b37b-7f9a0a78935d",
                                                "sense_id": "4a22ed61-bcf1-35e8-8c19-85bbdfc272d8",
                                                "text": "I was told afterwards—quite possibly it was true—that agents provocateurs were touching off masses of explosive in order to increase the general noise and panic."
                                            },
                                            {
                                                "example_id": "98fc54b3-389c-424b-8104-ab9cb2bda5d9",
                                                "sense_id": "4a22ed61-bcf1-35e8-8c19-85bbdfc272d8",
                                                "text": "Suspecting that the man was an agent provocateur sent by the Prince, Pottinger told him that regrettably he had neither the knowledge nor the authority to instruct him in this or any other religion."
                                            },
                                            {
                                                "example_id": "61955e23-49ee-4a46-9170-d216ebc6934d",
                                                "sense_id": "4a22ed61-bcf1-35e8-8c19-85bbdfc272d8",
                                                "text": "The criminalisation of protest has been aided by the director of public prosecution's recent guidelines on prosecuting protesters, which fail to account for the role of the police in prompting violence at demonstrations through tactics such as kettling, the use of batons, agents provocateurs and undercover policing."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d8cc993b-ecd2-43ca-8802-d28fb88adb05",
                        "source_entry_id": "d91570c9-3952-3898-ac1d-25e019577db2",
                        "source_sense_id": "4ca6a6bd-8afa-307a-8510-9e0400bad789",
