                        "examples": [
                            {
                                "example_id": "6f49649b-b277-4084-8400-59b5212d0469",
                                "sense_id": "d9312b25-8551-3e6e-8a42-bdd7d1aa403c",
                                "text": "La diversification du produit se réduit alors souvent à l’aménagement du domaine skiable : snowparks, halfpipes, secteurs pour débutants ou pour enfants, etc."
                            },
                            {
                                "example_id": "724bfc19-eebb-4f3b-9096-0cb75b99aa83",
                                "sense_id": "d9312b25-8551-3e6e-8a42-bdd7d1aa403c",
                                "text": "Dans les halfpipes, très longues rampes sculptées dans la neige, les snowboardeurs s’élancent pour exécuter des rotations qui peuvent aller jusqu’à 1 080° - soit trois tours ! - ou encore, des McTwists (rotation de 540° tête en bas en attrapant sa planche derrière ses pieds)."
                            },
                            {
                                "example_id": "98550f2c-3e07-43b8-8435-7999f59702a3",
                                "sense_id": "d9312b25-8551-3e6e-8a42-bdd7d1aa403c",
                                "text": "« A partir du moment où on fait du halfpipe, on sait qu’on va se mettre des tartes, ça fait partie de notre vie », explique le Français Kevin Rolland, qui partira mardi en quête d’une deuxième médaille olympique après celle de bronze ramenée de Sotchi en 2014."
                            }
                        ]
                    }
