                "senses": [
                    {
                        "sense_id": "ca72dcdf-b632-39a0-b6d4-b089d9629549",
                        "entry_id": "59fda2a5-ac1c-3fc7-9c59-44ab2e5ca08e",
                        "glosses": [
                            "The airstream created by a fast-moving vehicle, experienced by those on that vehicle as a headwind."
                        ],
                        "tags": [
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "d72f011e-b854-4a40-ab68-14b127649784",
                                "sense_id": "ca72dcdf-b632-39a0-b6d4-b089d9629549",
                                "text": "Der Fahrtwind riss am Gehölz. Riss an dürren Halmen. Und riss am trockenen Gras.",
                                "translation": "The vehicle’s airstream ripped at the groves. Ripped at the brittle stalks. Ripped at the dry grass.",
                                "english": "The vehicle’s airstream ripped at the groves. Ripped at the brittle stalks. Ripped at the dry grass."
                            }
                        ]
                    }
