        "fr-extract.jsonl": [
            {
                "entry_id": "a31508da-6012-3ee8-99da-aa36a26912d7",
                "word": "matériellement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6b2fd985-bec8-3b47-97bd-265990cc004d",
                        "entry_id": "a31508da-6012-3ee8-99da-aa36a26912d7",
                        "glosses": [
                            "Dans l’ancienne philosophie scolastique, par rapport à la matière, il est opposé à formellement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a7a35cb-1e8e-41e1-b441-a16c02590bd6",
                                "sense_id": "6b2fd985-bec8-3b47-97bd-265990cc004d",
                                "text": "L’homme est mortel matériellement et immortel formellement."
                            }
                        ]
                    },
                    {
                        "sense_id": "6a78b44b-a13a-3958-a353-0990683bd984",
                        "entry_id": "a31508da-6012-3ee8-99da-aa36a26912d7",
                        "glosses": [
                            "D’une manière matérielle, grossière."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "456676b4-3c75-478c-aad3-5f24a398943f",
                                "sense_id": "6a78b44b-a13a-3958-a353-0990683bd984",
                                "text": "[…] ils ne supportent pas le sous-développement du pays lors de leur séjour estival, mais de l'autre côté ils contribuent matériellement à l'essor du trabendo qui affaiblit toutes les initiatives d'émancipation nationale."
                            },
                            {
                                "example_id": "43bd6c1e-7821-45b1-adcb-5e40255eae62",
                                "sense_id": "6a78b44b-a13a-3958-a353-0990683bd984",
                                "text": "Cette table est faite bien matériellement."
                            }
                        ]
                    },
                    {
                        "sense_id": "3eff7511-6e00-3489-b8f6-d71e7759fb64",
                        "entry_id": "a31508da-6012-3ee8-99da-aa36a26912d7",
                        "glosses": [
                            "Effectivement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9b35895-dcc5-47c6-a2a1-91ab6f61f72e",
                                "sense_id": "3eff7511-6e00-3489-b8f6-d71e7759fb64",
                                "text": "Celui qui se dirige d'après les lois de l’agronomie, c'est l’agriculteur ; celui qui exécute matériellement les principes de l’agriculture, c'est le cultivateur."
                            },
                            {
                                "example_id": "78c49459-a4b3-45ea-8f34-067c71381440",
                                "sense_id": "3eff7511-6e00-3489-b8f6-d71e7759fb64",
                                "text": "Sire, il était matériellement impossible de deviner des projets que cet homme cachait à tout le monde."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a5c6c0fd-ffc3-45b5-8185-2d717b64f0d7",
                        "source_entry_id": "a31508da-6012-3ee8-99da-aa36a26912d7",
                        "target_lang_word": "actually",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "actually",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7a29d532-2ee3-34e8-9de1-6ba276511a06",
                                        "entry_id": "f130419b-ed55-31b0-9cf4-dc72620d6f85",
                                        "glosses": [
                                            "In act or in fact; really; in truth; positively."
                                        ],
                                        "tags": [
                                            "modal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "079859c2-29f5-4ab9-b8c0-937b0185592b",
                                                "sense_id": "7a29d532-2ee3-34e8-9de1-6ba276511a06",
                                                "text": "His promises did not correspond with what he actually did."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0806d5e5-340e-32a9-a6b6-b4ed78021614",
                                        "entry_id": "f130419b-ed55-31b0-9cf4-dc72620d6f85",
                                        "glosses": [
                                            "Actively."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7579c15-0563-459f-8b14-a6f606fa8934",
                                                "sense_id": "0806d5e5-340e-32a9-a6b6-b4ed78021614",
                                                "text": "Neither actually […] nor passively."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc455ce9-8c5c-376a-aaa0-c2feb3a7e814",
                                        "entry_id": "f130419b-ed55-31b0-9cf4-dc72620d6f85",
                                        "glosses": [
                                            "Currently; at the time."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3bac1d8-98eb-4a01-8f58-5d8ec737c064",
                                                "sense_id": "fc455ce9-8c5c-376a-aaa0-c2feb3a7e814",
                                                "text": "At the time whereof we are writing, though the Great George was on the throne and ladies wore gigots and large combs like tortoise-shell shovels in their hair, instead of the simple sleeves and lovely wreaths which are actually in fashion, the manners of the very polite world were not, I take it, essentially different from those of the present day: and their amusements pretty similar."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "actually",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f77cf2fb-8483-3d5b-a3fe-93fac5a942ea",
                                        "entry_id": "5f136a10-9d38-3750-922a-332e2d485480",
                                        "glosses": [
                                            "Indicating affirmation, agreement."
                                        ],
                                        "tags": [
                                            "Philippines",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52c5fbbf-9e08-4c24-aef5-cb5689b3160e",
                                                "sense_id": "f77cf2fb-8483-3d5b-a3fe-93fac5a942ea",
                                                "text": "A: That was a pretty good movie."
                                            },
                                            {
                                                "example_id": "b3b3fee7-5508-4237-bbf8-e413a2b7f8c0",
                                                "sense_id": "f77cf2fb-8483-3d5b-a3fe-93fac5a942ea",
                                                "text": "B: Actually!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c16c1f50-91b0-4b32-920b-faf43ab33c18",
                        "source_entry_id": "a31508da-6012-3ee8-99da-aa36a26912d7",
                        "target_lang_word": "financially",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "financially",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2030321b-d95f-3135-a93f-525a7b8855d9",
                                        "entry_id": "28050f01-9f4a-3083-a4c3-723a2cb4af26",
                                        "glosses": [
                                            "In terms of finance or money."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "839545f0-7a1e-48b9-bff0-33dc114468b1",
                                                "sense_id": "2030321b-d95f-3135-a93f-525a7b8855d9",
                                                "text": "He helped his daughter out financially, paying her rent and utilities, until she recovered from the accident."
                                            },
                                            {
                                                "example_id": "791a397e-c664-4922-8e6e-aa113fffbaf0",
                                                "sense_id": "2030321b-d95f-3135-a93f-525a7b8855d9",
                                                "text": "As it looked to him, another six months at sea should turn the trick financially. At least it would give him a good interest in the plantation."
                                            },
                                            {
                                                "example_id": "65183f3b-cb12-4497-a6b1-928dcc9f9ce1",
                                                "sense_id": "2030321b-d95f-3135-a93f-525a7b8855d9",
                                                "text": "For many investors using $3,000 in losses to offset regular income taxes can be more financially beneficial than offsetting gains, said Indiana-based CFP Russ Ford, because their income tax rates are higher than their long-term capital gains rate, which is 15% for most investors."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6ce2455a-7ea9-4256-b6b0-4a563d9e704f",
                        "source_entry_id": "a31508da-6012-3ee8-99da-aa36a26912d7",
                        "target_lang_word": "materially",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "materially",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5f6f31e1-773e-364b-9961-e3cd2f4a5cbe",
                                        "entry_id": "5b7e4da0-3070-356f-8624-e4a6737c3103",
                                        "glosses": [
                                            "In a material manner; with regard to physical things or characteristics."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d2aa36a-041f-406c-8e63-79d53fe5c38b",
                                                "sense_id": "5f6f31e1-773e-364b-9961-e3cd2f4a5cbe",
                                                "text": "Tobacco, for instance, shrinks materially by frequent reshippings, and as all goods are warehoused as a convenience to importers, duties should be paid on what the importer receives."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89cb145f-b2c0-3211-b544-9c033e039a6a",
                                        "entry_id": "5b7e4da0-3070-356f-8624-e4a6737c3103",
                                        "glosses": [
                                            "To a significant degree."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b2ffed1-cbdf-4585-a283-f5a9cf7df8ee",
                                                "sense_id": "89cb145f-b2c0-3211-b544-9c033e039a6a",
                                                "text": "In cases of extreme thickening of the coats of the stomach, of a scirrhoid character, where the suffering patients are almost worn out with constant pain, such remedies, applied over the epigastrium, most materially alleviate the distress."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
