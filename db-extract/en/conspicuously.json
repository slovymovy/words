                        "translation_id": "a0197075-fe6e-4cc9-8ea7-492a29c80e3c",
                        "source_entry_id": "28b4dd46-5b6c-3719-97c7-7d547574f898",
                        "source_sense_id": "f8c8845d-2872-3d03-b5fd-16a74a36d49a",
