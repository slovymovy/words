                                    {
                                        "sense_id": "52f14a71-e796-3f23-b1ef-d53752ebe24a",
                                        "entry_id": "e5601c10-172f-3107-8374-056202af1cc4",
                                        "glosses": [
                                            "Doctrine selon laquelle l'Église ne doit pas avoir de pouvoir politique ni influencer le gouvernement d'un pays."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0283d58a-1bd8-31ad-90cc-680a5d71ee83",
                                        "entry_id": "e5601c10-172f-3107-8374-056202af1cc4",
                                        "glosses": [
                                            "Doctrine qui prône la séparation des religions et de l'État."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f42fa0b5-3087-4389-a3a8-14fedb7b5866",
                                                "sense_id": "0283d58a-1bd8-31ad-90cc-680a5d71ee83",
                                                "text": "L'ambivalence et le laxisme des autorités de l'État laïque et de la nouvelle intelligentsia séculière ébranlèrent le sécularisme même. Dès l'instant […] où l'influence européenne diminua, la laïcité déclina et son attrait se volatilisa."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8ac427de-9817-4b2d-89cc-5a53a2bf0d0b",
                        "source_entry_id": "a87e96a1-9ab4-3734-a40c-6a6b1831d3c9",
