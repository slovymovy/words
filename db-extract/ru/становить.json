                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21778dbe-d5b0-4cb8-b3cf-2dd67a98ca68",
                                "sense_id": "6b312d09-7a35-34b9-87f9-f51bd1d9f2de",
                                "text": "На почётный стол становили кушанья, что искусной рукой Дарья Никитишна сготовила, на другие столы становили яства попроще, стряпни Виринеиной."
                            },
                            {
                                "example_id": "65c8ddde-4628-43a9-9bf2-152bae05a4ac",
                                "sense_id": "6b312d09-7a35-34b9-87f9-f51bd1d9f2de",
                                "text": "С весны до поздней осени // Дед брал грибы да ягоды, // Силочки становил // На глухарей, на рябчиков."
                            }
                        ]
                    }
