                "senses": [
                    {
                        "sense_id": "716cab77-1616-3a05-8b83-1f1bbdb540e3",
                        "entry_id": "b8022a31-644c-30d2-b3be-175db56f8931",
                        "glosses": [
                            "langer Strick mit zusammenziehbarer Schlinge zum Einfangen von Tieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1768e134-6ca4-4b3e-a9ba-d5ea8afa4941",
                                "sense_id": "716cab77-1616-3a05-8b83-1f1bbdb540e3",
                                "text": "Er warf sein Lasso, um das Fohlen einzufangen."
                            },
                            {
                                "example_id": "500450bd-24a9-4e23-bddc-bcd1b10e6142",
                                "sense_id": "716cab77-1616-3a05-8b83-1f1bbdb540e3",
                                "text": "Sie versuchten, die Schafe mit dem Lasso einzufangen."
                            },
                            {
                                "example_id": "7ddb5e82-37a9-4c66-8b2e-a8befd4e3341",
                                "sense_id": "716cab77-1616-3a05-8b83-1f1bbdb540e3",
                                "text": "„Gauchos ritten ein Stück mit, bogen ab und klatschten die Lassos durch die Luft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7d9d166e-36a4-4e4b-820c-b9a32a23a589",
                        "source_entry_id": "b8022a31-644c-30d2-b3be-175db56f8931",
                        "source_sense_id": "716cab77-1616-3a05-8b83-1f1bbdb540e3",
                        "source_sense_description": "langer Strick mit zusammenziehbarer Schlinge zum Einfangen von Tieren",
                        "target_lang_word": "lasso",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lasso",
