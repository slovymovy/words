                                        "entry_id": "f69d74ce-1e48-3a13-9c8c-be0d626edacd",
                                        "glosses": [
                                            "Alternative letter-case form of Thoroughbred (“horse bred for racing”)."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1cbc465-6df0-4174-844a-94d42922d263",
                                                "sense_id": "96e12952-d8de-3cbd-bbe5-979328e779a3",
                                                "text": "A CNN analysis of disciplinary records found that the top earning trainers in the sport – whose thoroughbreds win them millions of dollars – have all broken rules meant to keep their horses safe. Trainers slapped with violations have continued racing, pocketing winnings while paying minimal fines. […] During the 2018-2019 season, a staggering 56 horses died at one of the most glamorous racetracks in the country, Santa Anita Park, once home to the famous 1940s thoroughbred Seabiscuit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce0b45c6-662e-3195-a27e-c488608c4702",
                                        "entry_id": "f69d74ce-1e48-3a13-9c8c-be0d626edacd",
                                        "glosses": [
                                            "Any purebred horse."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b0f5f24b-c6a3-3a37-bc2d-7e4c3b9fa4a8",
                                        "entry_id": "f69d74ce-1e48-3a13-9c8c-be0d626edacd",
                                        "glosses": [
                                            "A person of uncommon strength or endurance (like that of a thoroughbred horse)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6e52051-042a-4976-a7cf-2643f2a29bd1",
                                                "sense_id": "b0f5f24b-c6a3-3a37-bc2d-7e4c3b9fa4a8",
                                                "text": "That athlete is a real thoroughbred."
                                            }
