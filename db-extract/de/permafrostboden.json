                "senses": [
                    {
                        "sense_id": "c142a02c-e564-3cfe-babc-98f037fcace7",
                        "entry_id": "d6f2c975-f36b-389c-8086-c50b252f2881",
                        "glosses": [
                            "tief gelegene Schicht des Erdbodens in kalten Regionen, die ganzjährig gefroren ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b33abe2-48bf-429e-b469-6c5d5cab682a",
                                "sense_id": "c142a02c-e564-3cfe-babc-98f037fcace7",
                                "text": "Aufgrund des Klimawandels beginnen die Permafrostböden zu tauen."
                            },
                            {
                                "example_id": "ab3419ed-2d29-4865-89f6-99e46b9cc00c",
                                "sense_id": "c142a02c-e564-3cfe-babc-98f037fcace7",
                                "text": "„Jakutsk gilt als kälteste Großstadt der Welt. Sie ist auf Permafrostboden gebaut, der niemals auftaut. Der Winter dauert von Oktober bis Mai.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e29fd7d1-8251-41a6-8edf-8abfb84b1f39",
                        "source_entry_id": "d6f2c975-f36b-389c-8086-c50b252f2881",
                        "source_sense_id": "c142a02c-e564-3cfe-babc-98f037fcace7",
                        "source_sense_description": "Geologie: tief gelegene Schicht des Erdbodens in kalten Regionen, die ganzjährig gefroren ist",
                        "target_lang_word": "permafrost",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "permafrost",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f349978e-f7ad-3b0e-aec0-465f167c455b",
                                        "entry_id": "3599bc32-b07a-35c8-8c8d-1b9547583800",
                                        "glosses": [
                                            "Permanently frozen ground, or a specific layer thereof."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f599144e-5918-41b1-8d8d-30619a55a8f4",
                                                "sense_id": "f349978e-f7ad-3b0e-aec0-465f167c455b",
                                                "text": "Nevertheless, the water molecule is present, as ice, in a solid form in frozen soils or permafrosts, which cover large regions characterised by a polar climate."
                                            },
                                            {
                                                "example_id": "835ffc5f-9f47-4425-b14a-2c5ee7e2b534",
                                                "sense_id": "f349978e-f7ad-3b0e-aec0-465f167c455b",
                                                "text": "In agreement with our overall trends within the permafrost samples, lower nirK and nirS and higher nosZ diversity have been identified in cryoturbated peat vs. unturbated peat soils (Palmer and Horn, 2012 )."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
