                        "glosses": [
                            "introverted, liking privacy and seclusion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc7e956f-4b54-43a7-bd87-12bfec72dfdb",
                                "sense_id": "2ec3345d-7bb5-3680-afff-6651c66a9415",
                                "text": "I don't really know him well, since he's so shy and retiring."
                            },
                            {
                                "example_id": "5af1a844-428b-407c-927d-ff7781e73696",
                                "sense_id": "2ec3345d-7bb5-3680-afff-6651c66a9415",
                                "text": "My uncle, as I can remember, was retiring in his disposition, scarcely ever visiting any one and not more frequently receiving any visitors."
                            },
                            {
                                "example_id": "f56274bd-3b8f-4299-b8ac-3de865ea3728",
                                "sense_id": "2ec3345d-7bb5-3680-afff-6651c66a9415",
                                "text": "Lester was in the thick of social and commercial affairs; he walked in paths to which Jennie's retiring soul had never aspired."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
