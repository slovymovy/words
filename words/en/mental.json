{
    "word_family": [
        "mentality",
        "mentally"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "bcffcac6-90bd-3102-b2b3-311b66f2fa7a",
                    "sense_definition": "Of or relating to the mind, intellect, or the process of thinking.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "mind_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Solving complex puzzles requires a great deal of <w>mental</w> effort.",
                            "target_lang_translations": {
                                "ru": "Решение сложных головоломок требует больших <w>у́мственных</w> усилий.",
                                "zh": "解决复杂的谜题需要大量的<w>脑力</w>劳动。"
                            }
                        },
                        {
                            "text": "She made a <w>mental</w> note to buy milk on her way home.",
                            "target_lang_translations": {
                                "ru": "Она сделала себе <w>мы́сленную</w> пометку купить молока по дороге домой.",
                                "zh": "她<w>暗自</w>记下回家路上要买牛奶。"
                            }
                        }
                    ],
                    "synonyms": [
                        "psychological",
                        "inner",
                        "intellectual",
                        "cognitive"
                    ],
                    "antonyms": [
                        "physical"
                    ],
                    "common_phrases": [
                        "mental health",
                        "mental state",
                        "mental image",
                        "mental age"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к разуму, интеллекту или процессу мышления.",
                        "zh": "与思维、智力或思考过程有关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "у́мственный",
                                "target_lang_sense_clarification": "относящийся к интеллекту"
                            },
                            {
                                "target_lang_word": "мы́сленный",
                                "target_lang_sense_clarification": "происходящий в мыслях"
                            },
                            {
                                "target_lang_word": "психи́ческий",
                                "target_lang_sense_clarification": "относящийся к психике"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "脑力",
                                "target_lang_sense_clarification": "指智力或思维活动"
                            },
                            {
                                "target_lang_word": "心理",
                                "target_lang_sense_clarification": "指与精神或思维相关的"
                            },
                            {
                                "target_lang_word": "精神",
                                "target_lang_sense_clarification": "指思维或意识层面"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8e780fd3-67ed-3158-8a50-21cc1ecdbbcc",
                    "sense_definition": "Relating to disorders of the mind or the care and treatment of people affected by them.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "mind_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government is increasing funding for <w>mental</w> hospitals and clinics.",
                            "target_lang_translations": {
                                "ru": "Правительство увеличивает финансирование <w>психиатри́ческих</w> больниц и клиник.",
                                "zh": "政府正在增加对<w>精神</w>病院和诊所的资助。"
                            }
                        },
                        {
                            "text": "He has suffered from a <w>mental</w> disorder for several years.",
                            "target_lang_translations": {
                                "ru": "Он страдает <w>психи́ческим</w> расстройством уже несколько лет.",
                                "zh": "他患有<w>精神</w>障碍已经好几年了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "psychological"
                    ],
                    "common_phrases": [
                        "mental hospital",
                        "mental disorder",
                        "mental illness",
                        "mental patient"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к расстройствам психики или уходу за людьми, страдающими ими.",
                        "zh": "与精神障碍或对其患者的护理和治疗有关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "психиатри́ческий",
                                "target_lang_sense_clarification": "относящийся к лечению (напр. больница)"
                            },
                            {
                                "target_lang_word": "психи́ческий",
                                "target_lang_sense_clarification": "относящийся к состоянию (напр. расстройство)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "精神",
                                "target_lang_sense_clarification": "指与心理健康相关的"
                            },
                            {
                                "target_lang_word": "精神病",
                                "target_lang_sense_clarification": "指与精神疾病相关的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7ccb1e4d-da4b-36c1-b653-11d39ba83011",
                    "sense_definition": "Behaving in a wild, foolish, or insane manner; extremely angry or excited.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crowd went <w>mental</w> when the band started playing their hit song.",
                            "target_lang_translations": {
                                "ru": "Толпа <w>ошале́ла</w>, когда группа начала играть свой хит.",
                                "zh": "当乐队开始演奏他们的热门歌曲时，人群<w>疯狂</w>了。"
                            }
                        },
                        {
                            "text": "My parents will go <w>mental</w> if they find out I broke the window.",
                            "target_lang_translations": {
                                "ru": "Мои родители <w>взбе́сятся</w>, если узнают, что я разбил окно.",
                                "zh": "如果我父母发现我打破了窗户，他们会<w>抓狂</w>的。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "go mental",
                        "drive someone mental"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "common in British and Australian English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ведущий себя дико, глупо или безумно; крайне рассерженный или возбужденный.",
                        "zh": "行为狂野、愚蠢或疯狂；极其愤怒或兴奋。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сумасше́дший",
                                "target_lang_sense_clarification": "безумный"
                            },
                            {
                                "target_lang_word": "чо́кнутый",
                                "target_lang_sense_clarification": "глупый, странный (разг.)"
                            },
                            {
                                "target_lang_word": "бе́шеный",
                                "target_lang_sense_clarification": "яростный, неуправляемый"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "发疯",
                                "target_lang_sense_clarification": "指行为失控或极其愤怒"
                            },
                            {
                                "target_lang_word": "抓狂",
                                "target_lang_sense_clarification": "指极其愤怒或情绪失控"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9b6e50d2-4ab3-3d24-b30a-d5fc9965a9f7",
                    "sense_definition": "Of or relating to the chin.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anatomy_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor examined the <w>mental</w> nerve to check for damage.",
                            "target_lang_translations": {
                                "ru": "Врач осмотрел <w>подборо́дочный</w> нерв, чтобы проверить его на наличие повреждений.",
                                "zh": "医生检查了<w>颏</w>神经以确认是否有损伤。"
                            }
                        },
                        {
                            "text": "Anatomy students must learn to identify the <w>mental</w> region of the mandible.",
                            "target_lang_translations": {
                                "ru": "Студенты-анатомы должны научиться определять <w>подборо́дочную</w> область нижней челюсти.",
                                "zh": "解剖学专业的学生必须学会识别下颌骨的<w>颏</w>区。"
                            }
                        }
                    ],
                    "synonyms": [
                        "genial"
                    ],
                    "common_phrases": [
                        "mental nerve"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к подбородку.",
                        "zh": "与下巴有关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подборо́дочный",
                                "target_lang_sense_clarification": "анатомический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "颏",
                                "target_lang_sense_clarification": "解剖学中指下巴的专业术语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2080ba2c-8708-3cfb-8c87-daa52c8828a1",
                    "sense_definition": "A person with a psychiatric disorder.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old asylum housed many <w>mentals</w> who had been abandoned by their families.",
                            "target_lang_translations": {
                                "ru": "В старой лечебнице содержалось много <w>пси́хов</w>, брошенных своими семьями.",
                                "zh": "那家旧收容所里住着许多被家人遗弃的<w>精神病患者</w>。"
                            }
                        },
                        {
                            "text": "He rudely referred to the patients as <w>mentals</w>.",
                            "target_lang_translations": {
                                "ru": "Он грубо называл пациентов <w>пси́хами</w>.",
                                "zh": "他粗鲁地称这些病人为<w>疯子</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often offensive or derogatory"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек с психическим расстройством.",
                        "zh": "患有精神障碍的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "псих",
                                "target_lang_sense_clarification": "разговорное, грубое"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "精神病患者",
                                "target_lang_sense_clarification": "指患有精神疾病的人"
                            },
                            {
                                "target_lang_word": "疯子",
                                "target_lang_sense_clarification": "贬义，指精神失常的人"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}