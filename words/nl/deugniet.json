    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cf2e82dc-d13b-3f4f-bf6a-6b8f5d2c5fcb",
                    "sense_definition": "Een ondeugend kind dat kattenkwaad uithaalt.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ondeugend_kind",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die kleine <w>deugniet</w> heeft weer de hele tuin overhoop gehaald.",
                            "target_lang_translations": {
                                "fr": "Ce petit <w>coquin</w> a encore mis tout le jardin sens dessus dessous."
                            }
                        },
                        {
                            "text": "De <w>deugniet</w> verstopte de sleutels van zijn vader voor de grap.",
                            "target_lang_translations": {
                                "fr": "Le <w>chenapan</w> a caché les clés de son père pour plaisanter."
                            }
                        }
                    ],
                    "synonyms": [
                        "bengel",
                        "rakker",
                        "rekel",
                        "belhamel",
                        "kwajongen",
                        "schavuit"
                    ],
                    "common_phrases": [
                        "kleine deugniet"
                    ],
                    "target_lang_definitions": {
                        "fr": "Un enfant espiègle qui fait des bêtises."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "coquin",
                                "target_lang_sense_clarification": "Enfant vif et espiègle, souvent utilisé de manière affectueuse."
                            },
                            {
                                "target_lang_word": "chenapan",
                                "target_lang_sense_clarification": "Garnement, utilisé sur un ton amusé ou légèrement réprobateur."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a354675b-e7d7-3b7f-a4f3-d5633926c3d1",
                    "sense_definition": "Iemand die niets nuttigs uitvoert of slecht gedrag vertoont.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "ondeugend_kind",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij staat in het dorp bekend als een echte <w>deugniet</w> die nooit werkt.",
                            "target_lang_translations": {
                                "fr": "Il est connu dans le village comme un vrai <w>vaurien</w> qui ne travaille jamais."
                            }
                        },
                        {
                            "text": "De oude <w>deugniet</w> probeerde iedereen op te lichten met zijn verhalen.",
                            "target_lang_translations": {
                                "fr": "La vieille <w>fripouille</w> essayait d'escroquer tout le monde avec ses histoires."
                            }
                        }
                    ],
                    "synonyms": [
                        "schelm"
                    ],
                    "target_lang_definitions": {
                        "fr": "Quelqu'un qui ne fait rien d'utile ou qui a une mauvaise conduite."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "vaurien",
                                "target_lang_sense_clarification": "Personne sans moralité ou qui ne travaille pas."
                            },
                            {
                                "target_lang_word": "fripouille",
                                "target_lang_sense_clarification": "Personne malhonnête ou sans scrupules."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}