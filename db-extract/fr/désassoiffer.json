                "senses": [
                    {
                        "sense_id": "66aca69b-d6ab-3fe2-82f2-160c417ae356",
                        "entry_id": "0b9cbb8b-eb6f-39df-9eb2-64f46e17ffdd",
                        "glosses": [
                            "Calmer la soif de."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1fe62370-757e-4744-a037-bd05bfc61072",
                                "sense_id": "66aca69b-d6ab-3fe2-82f2-160c417ae356",
                                "text": "Elle fermente, mousse, écume entre les rochers touffus d’herbe et porte par vent, par offrande, par éclats de cristaux de glace, le goût du dieu délicieux dont le feu désassoiffe l’âme."
                            },
                            {
                                "example_id": "86c6fa26-28c4-45eb-b0f5-dc189256ea4f",
                                "sense_id": "66aca69b-d6ab-3fe2-82f2-160c417ae356",
                                "text": "Le temps de nous désassoiffer avec une première mousse élevée exit du fût de chêne, et Rinuche nous rejoint comme Noël Noël dans « Les vieux de la vieille » : un peu hagard, beaucoup rigolard et rattrapant ses complices."
                            }
                        ]
                    }
                ],
