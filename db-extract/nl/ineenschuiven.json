                "word": "ineenschuiven",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ee8751d2-a68f-3616-8fe3-296020467505",
                        "entry_id": "d81138d7-1e71-3b30-98b6-4f2f0050b2d1",
                        "glosses": [
                            "van twee of meer organisaties één geheel maken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37f34f0b-605c-419f-ba2c-eefed4a0d422",
                                "sense_id": "ee8751d2-a68f-3616-8fe3-296020467505",
                                "text": "PPG zegt dat het ineenschuiven van de twee bedrijven veel beter is dan het stand-alone-scenario dat AkzoNobel vorige week presenteerde, met een zelfstandige verf- en coatingsbedrijf en de verkoop van de chemiedivisie."
                            },
                            {
                                "example_id": "130e59d3-0d88-4300-af98-fdb53237a81d",
                                "sense_id": "ee8751d2-a68f-3616-8fe3-296020467505",
                                "text": "De arbeidsplaatsen zullen sneuvelen bij de ondersteunende en controlerende diensten, zoals financiële zaken, risicobeheer, personeelszaken, catering en communicatie. In die afdelingen zitten nog veel dubbelingen als gevolg van het ineenschuiven van ABN Amro en Fortis bank. ABN wil 200 miljoen euro bezuinigen."
                            }
                        ]
                    }
                ],
