                "senses": [
                    {
                        "sense_id": "279ab5c3-f63e-380a-91d4-0a00a54bad93",
                        "entry_id": "b645373b-f4f9-3b25-b063-cc1604efcbfe",
                        "glosses": [
                            "Musikinstrument für Kinder: Trommel aus Blech"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e12486fc-8a21-4e3b-a31d-c9eddc1dad97",
                                "sense_id": "279ab5c3-f63e-380a-91d4-0a00a54bad93",
                                "text": "„Damals konnte man noch den Leuten auf und vor Tribünen mit einer armseligen Blechtrommel bekommen, und ich muß zugeben, daß ich meinen Bühnentrick ähnlich wie das fernwirkende Glaszersingen bis zur Perfektion trieb.“"
                            },
                            {
                                "example_id": "d16c6211-50c7-44a6-94a7-37123f345531",
                                "sense_id": "279ab5c3-f63e-380a-91d4-0a00a54bad93",
                                "text": "„Ich hatte mir eine Blechtrommel zu Weihnachten gewünscht, ich meine, es war wegen der bunten Farbe und wegen des Blechtons, den ich haben wollte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
