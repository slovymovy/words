                ],
                "senses": [
                    {
                        "sense_id": "7a0c0ac4-fee7-3b99-833e-f3c4089a94f7",
                        "entry_id": "70a45d59-a12e-32be-9661-156e0be3872a",
                        "glosses": [
                            "прост., презр. сойти с ума, спятить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef60f961-1bc3-4d70-abce-c85431314d5b",
                                "sense_id": "7a0c0ac4-fee7-3b99-833e-f3c4089a94f7",
                                "text": "— Разве не видишь, что он с ума сбрендил!"
                            },
                            {
                                "example_id": "20eb28b5-2fc9-4b8e-95a3-fb7d89036ed0",
                                "sense_id": "7a0c0ac4-fee7-3b99-833e-f3c4089a94f7",
                                "text": "Бедняга от страха совсем сбрендил."
                            },
                            {
                                "example_id": "35ae5672-81fd-4078-b75f-19266ab3632a",
                                "sense_id": "7a0c0ac4-fee7-3b99-833e-f3c4089a94f7",
                                "text": "Колька так рассвирепел, что крикнул: — Сбрендил, да? — и повертел пальцем у виска."
                            }
                        ]
                    },
                    {
                        "sense_id": "90bf6ef4-15a5-3f38-87c1-b8b01a3b2acf",
                        "entry_id": "70a45d59-a12e-32be-9661-156e0be3872a",
                        "glosses": [
                            "прост., устар. струсить, испугаться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d949c53-8bba-48e7-96c9-034b962d16dc",
                                "sense_id": "90bf6ef4-15a5-3f38-87c1-b8b01a3b2acf",
                                "text": "Таким-то образом и сбрендила благовоспитанная Софья с своей оранжерейной чувствительностью перед простой бабой."
                            },
                            {
                                "example_id": "bfe2eaf6-acf1-4daf-973c-b656353c6db1",
                                "sense_id": "90bf6ef4-15a5-3f38-87c1-b8b01a3b2acf",
                                "text": "— Только ты смотри у меня, держись в струне, не сбренди! Я, брат, ведь зол! Я тебя — ежели что — в треисподней достану! Как только он тебя свидетелем вызовет, — сейчас ты его удиви!"
                            }
                        ]
                    },
                    {
                        "sense_id": "fcf75b65-3c60-3372-8a53-4761e0051c54",
                        "entry_id": "70a45d59-a12e-32be-9661-156e0be3872a",
                        "glosses": [
                            "прост., устар. соврать или сказать глупость, чепуху"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39f4cdb4-5ab5-43ec-aba1-8d7e28a762c9",
                                "sense_id": "fcf75b65-3c60-3372-8a53-4761e0051c54",
                                "text": "Ты не думай, что я по глупости сейчас сбрендила; я понимаю, что говорю."
                            }
                        ]
                    },
                    {
                        "sense_id": "6adc3e73-df0c-3af7-bd97-61814532ff72",
                        "entry_id": "70a45d59-a12e-32be-9661-156e0be3872a",
                        "glosses": [
                            "прост., устар. упасть духом, отчаяться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37f6b977-b6a7-4ec7-8ae7-5949e41a9afe",
                                "sense_id": "6adc3e73-df0c-3af7-bd97-61814532ff72",
                                "text": "Вижу, моя воительница совсем сбрендила: распалась и угасла в час один."
                            }
                        ]
                    }
                ],
