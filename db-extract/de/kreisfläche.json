                ],
                "senses": [
                    {
                        "sense_id": "24507035-9707-33de-91a7-7ca96a014e4e",
                        "entry_id": "c4946df2-0cb6-35fb-9cad-beb9e8ce8025",
                        "glosses": [
                            "Menge aller Punkte, die von einem gegebenen Punkt in der gleichen Ebene einen gegebenen maximalen Abstand haben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8b42479-e764-42ac-be00-cb51fe977ce9",
                                "sense_id": "24507035-9707-33de-91a7-7ca96a014e4e",
                                "text": "„Wir wenden nun zur Berechnung des Größenwerts H der Feldstärke den Integralsatz von STOKES auf eine Kreisfläche vom Radius ρ an, die mit dem Leiter konzentrisch ist und auf ihm senkrecht steht: […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ae71b2a4-4df0-37bb-ab51-20d55d6381a6",
                        "entry_id": "c4946df2-0cb6-35fb-9cad-beb9e8ce8025",
                        "glosses": [
                            "Territorium einer bundesdeutschen flächenhaften föderalen Verwaltungseinheit der untersten Ebene über jener der Gemeinden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6a7891d-202e-4f48-b435-0ec5f34c8182",
                                "sense_id": "ae71b2a4-4df0-37bb-ab51-20d55d6381a6",
                                "text": "„Für den Main-Tauber-Kreis wurden zwei Vogelschutzgebiete, die insgesamt zwei Prozent der Kreisfläche beanspruchen, gemeldet.“"
                            },
                            {
                                "example_id": "00cdb334-ddd1-4a6d-9c26-01a9f43c04fb",
                                "sense_id": "ae71b2a4-4df0-37bb-ab51-20d55d6381a6",
                                "text": "„Auf einen Quadratkilometer Kreisfläche kamen dort im vergangenen 4,1 Einschläge - mehr als in allen anderen Kreisen und Städten, gab der Blitz-Informationsdienst in Karlsruhe bekannt.“"
                            },
                            {
                                "example_id": "bfc1a109-6545-4b40-8496-a7636bd6d884",
                                "sense_id": "ae71b2a4-4df0-37bb-ab51-20d55d6381a6",
                                "text": "„Rund 31 % der Kreisfläche werden aufgrund der überwiegend mageren und sandigen Geestböden forstwirtschaftlich genutzt, vor allem für Kiefernwald.“"
                            },
                            {
                                "example_id": "f7f17e5c-f5bf-436b-bd62-ba912843d3bb",
                                "sense_id": "ae71b2a4-4df0-37bb-ab51-20d55d6381a6",
                                "text": "„Zu Beginn des Untersuchungszeitraums betrug die Kreisfläche 867 qkm.“"
                            },
                            {
                                "example_id": "74ec7044-f4af-4b59-8757-42f6fddd8c9a",
                                "sense_id": "ae71b2a4-4df0-37bb-ab51-20d55d6381a6",
                                "text": "„Rheinland-Pfalz hat sehr kleine Landkreise, während in Brandenburg die Landkreise - gemessen an der Kreisfläche - sehr groß sind.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
