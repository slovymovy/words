                "senses": [
                    {
                        "sense_id": "b03a2e3b-89da-3d7c-af97-cf50db73d596",
                        "entry_id": "dbbed947-06eb-375f-a0a9-f5480189a60b",
                        "glosses": [
                            "Extrêmement connecté avec le monde extérieur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56c913e9-6264-4fe8-9aa1-49bf58fc9ef7",
                                "sense_id": "b03a2e3b-89da-3d7c-af97-cf50db73d596",
                                "text": "Quelques années plus tôt, Madrid construit de grands quartiers d’affaires, multiplie des bureaux haut standing, des centres commerciaux géants et des bases de loisirs ultraconnectées par de nouvelles infrastructures comme la M-30."
                            },
                            {
                                "example_id": "55179c1e-e24f-48dc-9fc7-680e6c265900",
                                "sense_id": "b03a2e3b-89da-3d7c-af97-cf50db73d596",
                                "text": "Et si la société indienne est toujours à la traîne sur le traitement de ces questions, une nouvelle génération féministe diplômée, ultraconnectée (journalistes, autrices, artistes), se mobilise très fortement."
                            },
                            {
                                "example_id": "9431da99-74e1-4aed-95e4-4bf9e64026c8",
                                "sense_id": "b03a2e3b-89da-3d7c-af97-cf50db73d596",
                                "text": "Tout va très vire, nous sommes ultraconnectés, bombardés d’informations en continu, les tâches à exécuter se multiplient, la distance n’est plus que virtuelle, même si le sentiment de solitude persiste."
                            }
                        ]
                    }
                ],
