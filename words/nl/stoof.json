                    "frequency": "Low",
                    "semantic_group_id": "verwarming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Grootmoeder zat vroeger altijd met haar voeten op een houten <w>stoof</w>.",
                            "target_lang_translations": {
                                "en": "Grandmother used to sit with her feet on a wooden <w>footwarmer</w>."
                            }
                        },
                        {
                            "text": "In het museum zagen we een historische <w>stoof</w> die vroeger in de kerk werd gebruikt.",
                            "target_lang_translations": {
                                "en": "In the museum, we saw a historical <w>foot stove</w> that used to be used in church."
                            }
                        }
