                "senses": [
                    {
                        "sense_id": "d0445307-2efa-36aa-9021-dff2bdfefd42",
                        "entry_id": "04c9f937-91aa-3f4b-aef0-fa39fbec579e",
                        "glosses": [
                            "jemand, der sich nicht für die Geldanlage in Aktien interessiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5a31b60-efea-4d56-aa6b-743b71392354",
                                "sense_id": "d0445307-2efa-36aa-9021-dff2bdfefd42",
                                "text": "„Für Aktienmuffel – und dazu zählen die meisten Österreicher – sind die jüngsten Turbulenzen an den Finanzmärkten der Beweis, dass sie immer schon recht hatten: Die Börse ist ein Kasino, wo vernünftige Anleger nichts verloren haben.“"
                            },
                            {
                                "example_id": "a712ae26-b559-4829-a354-f7a94ce222c5",
                                "sense_id": "d0445307-2efa-36aa-9021-dff2bdfefd42",
                                "text": "„Mehr wäre wahrscheinlich mit einer besseren Aufklärung der Bevölkerung zu erreichen, damit deutsche Kleinanleger, die nach eigenen Angaben aus Risikogründen immer noch absolute «Aktienmuffel» sind, sich nicht von hohen Renditen am grauen Markt blenden lassen und dabei die eigene Risikotragfähigkeit völlig ausblenden.“"
                            },
                            {
                                "example_id": "2f25ce92-700e-41ee-b72d-254622c67987",
                                "sense_id": "d0445307-2efa-36aa-9021-dff2bdfefd42",
                                "text": "„Dass die Deutschen als ganz schreckliche Aktienmuffel gelten, das wird zumindest regelmäßig von nicht ganz unabhängiger Seite behauptet.“"
                            },
                            {
                                "example_id": "3f1b2bd9-e54e-4292-8563-866a3cfa0806",
                                "sense_id": "d0445307-2efa-36aa-9021-dff2bdfefd42",
                                "text": "„Die Deutschen sind Aktienmuffel. Das will die Deutsche Börse nun ändern.“"
                            },
                            {
                                "example_id": "6ee28b32-e794-42ab-93df-ab306702e4b0",
                                "sense_id": "d0445307-2efa-36aa-9021-dff2bdfefd42",
                                "text": "„Die Jüngeren sind weiterhin die Aktienmuffel der Republik. Gerade mal 11,1 Prozent der 14- bis 39-Jährigen besitzen Aktien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
