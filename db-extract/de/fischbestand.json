                "senses": [
                    {
                        "sense_id": "6354d562-15c3-3e38-ae45-6cd39326497a",
                        "entry_id": "59b4e429-f1fb-37ec-ab04-66f73fa6bfd8",
                        "glosses": [
                            "Bestand an Fischen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a74e19b-6c5c-4fae-a927-efcaf8c27746",
                                "sense_id": "6354d562-15c3-3e38-ae45-6cd39326497a",
                                "text": "„Da die natürlichen Fischbestände in den letzten Jahrzehnten immer weiter geschrumpft sind, wird neben der traditionellen Fischzucht in Süßwasserteichen in zunehmendem Maße auch die Zucht von Meeresfischen, Krebsen, Muscheln oder Algen betrieben – die sog. Aquakultur.“"
                            },
                            {
                                "example_id": "f7740a07-09e5-4c13-99c4-f5fc631e6830",
                                "sense_id": "6354d562-15c3-3e38-ae45-6cd39326497a",
                                "text": "„Die Holzindustrie ist noch immer ein wichtiger Wirtschaftszweig, während die Fischbestände stark eingebrochen sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
