                "senses": [
                    {
                        "sense_id": "8575b322-69fa-304d-b3dc-482323d9bd8d",
                        "entry_id": "38411aec-df4a-31d5-9125-810fc01f797d",
                        "glosses": [
                            "Person, die oder etwas, das durch einen Versuch Sicherheit darüber gewinnt, ob ein technischer Apparat oder ein Vorgang innerhalb der geplanten Rahmenbedingungen funktioniert oder nicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "596cbf40-04e3-45b8-b157-b039484c386d",
                                "sense_id": "8575b322-69fa-304d-b3dc-482323d9bd8d",
                                "text": "„Bio-Food-Tester nimmt Bio-Produkte unter die Lupe.“"
                            },
                            {
                                "example_id": "0c895d43-1ae3-4f16-bfc7-f2a4b8c8fddf",
                                "sense_id": "8575b322-69fa-304d-b3dc-482323d9bd8d",
                                "text": "„Das hatte jedenfalls die Vorhut der anonymen Tester aus seinem Munde wenige Tage zuvor erfahren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2a0b3ce8-5d34-43a4-ac6f-e5c91d01ea6b",
                        "source_entry_id": "38411aec-df4a-31d5-9125-810fc01f797d",
                        "source_sense_id": "8575b322-69fa-304d-b3dc-482323d9bd8d",
                        "target_lang_word": "tester",
