                "senses": [
                    {
                        "sense_id": "d4793a1e-a112-3dea-a5f7-79b816cc15b1",
                        "entry_id": "ad8a63e3-b366-3c61-a647-407b38c2a181",
                        "glosses": [
                            "Coefficient : facteur, multiplicateur d’un nombre, d’une grandeur."
                        ],
                        "tags": [],
                        "note": "À ce titre, ce terme entre dans nombre de noms composés dans le domaine technico-scientifique (voir dérivés",
                        "examples": [
                            {
                                "example_id": "7735fe17-4c32-47b9-974d-b7d5195a0ef4",
                                "sense_id": "d4793a1e-a112-3dea-a5f7-79b816cc15b1",
                                "text": "Einfaches Beispiel: Der Koeffizient des Terms 9x² ist 9.",
                                "translation": "Exemple simple : le coefficient du terme 9x² est 9. (Mathématiques)"
                            },
                            {
                                "example_id": "51ef8459-3eeb-4027-811b-20676a4eec64",
                                "sense_id": "d4793a1e-a112-3dea-a5f7-79b816cc15b1",
                                "text": "Die vollständige Oxydation des Wolframs schreibt man: 2W+3O_2⟶2WO_3. Die stöchiometrischen Koeffizienten des Wolframs, Sauerstoffs und Wolframtrioxyds sind bzw. 2, 3 und 2.",
                                "translation": "L’oxydation complète du tungstène s’écrit : 2W+3O_2⟶2WO_3. Les coefficients stoechiométrique du tungstène, de l’oxygène et du trioxyde de tungstène sont respectivement 2, 3 et 2. (Chimie)"
                            }
                        ]
                    }
                ],
