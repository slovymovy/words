                                                "example_id": "ae50c450-9a36-4bc7-88d5-dcac10bb0855",
                                                "sense_id": "efacdea7-c3ec-30ed-bf61-cba604f41a5d",
                                                "text": "Elle collabore avec l’agence américaine en tant qu’experte de la magnétosphère de la « géante de glace »."
                                            }
