                    },
                    {
                        "form_id": "27ef4e92-ad0c-426e-a3c4-6629652915e8",
                        "entry_id": "9411ec6c-ccf1-30df-9895-c309b05535b8",
                        "tags": [
                            "plural"
                        ],
                        "form": "dhole"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2001c5d9-5c00-3ec4-be0d-06a2eec574af",
                        "entry_id": "9411ec6c-ccf1-30df-9895-c309b05535b8",
                        "glosses": [
                            "An Asian wild dog, Cuon alpinus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f8e10d7-fc59-4d81-ac9b-96b19b1d2626",
                                "sense_id": "2001c5d9-5c00-3ec4-be0d-06a2eec574af",
                                "text": "Mowgli's wanderings had taken him to the edge of the high grassy downs of the Dekkan, and he had seen the fearless dholes sleeping and playing and scratching themselves in the little hollows and tussocks that they use for lairs."
                            },
                            {
                                "example_id": "3f947ffc-2710-4db3-acc4-07b29a05855d",
                                "sense_id": "2001c5d9-5c00-3ec4-be0d-06a2eec574af",
                                "text": "This whistling, a means of communication for a pack of dhole regrouping after an unsuccessful hunt, inspired the other common name of this species—the whistling dog."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e9ac01db-31e0-45ff-9751-ae2f33280509",
                        "source_entry_id": "9411ec6c-ccf1-30df-9895-c309b05535b8",
                        "source_sense_id": "2001c5d9-5c00-3ec4-be0d-06a2eec574af",
                        "source_sense_description": "Asian wild dog",
                        "target_lang_word": "dhole",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dhole",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a0af89d2-dd7d-30e6-ab5c-688f7055bdc0",
                                        "entry_id": "bbf894c8-54b8-30d8-bf22-272b835800d3",
                                        "glosses": [
                                            "Espèce de canidé sauvage asiatique, Cuon alpinus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1feb6e46-bc21-4587-af06-b8f732a9dd62",
                                                "sense_id": "a0af89d2-dd7d-30e6-ab5c-688f7055bdc0",
                                                "text": "Un dhole adulte a besoin de manger environ 1,9 kg de viande par jour ou, de façon plus générale, 10 % de son poids total."
                                            },
                                            {
                                                "example_id": "a6e57f7d-3f86-4285-a077-3399c3ed5bdb",
                                                "sense_id": "a0af89d2-dd7d-30e6-ab5c-688f7055bdc0",
                                                "text": "Exclusivement carnivore, le dhole (Cuon alpinus ) est considéré comme l’un des plus redoutables prédateurs de toute l’Asie."
                                            },
                                            {
                                                "example_id": "3d646d97-a042-4150-8dfe-91d970c02e43",
                                                "sense_id": "a0af89d2-dd7d-30e6-ab5c-688f7055bdc0",
                                                "text": "En fait, sa réputation vient du fait que les dholes attaquent en groupe et tuent rarement leur proie du premier coup."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
