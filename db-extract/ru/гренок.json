                "senses": [
                    {
                        "sense_id": "9cadfdcf-3816-3d99-bf76-1c619ad39b50",
                        "entry_id": "b0097744-b511-3ea7-a7ec-a9c64da73aaa",
                        "glosses": [
                            "обычно мн. ч., устар. то же, что гренка; поджаренный ломтик хлеба"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34a875fe-18ab-493f-ab1a-75afe472251a",
                                "sense_id": "9cadfdcf-3816-3d99-bf76-1c619ad39b50",
                                "text": "Золотистый поджаренный гренок."
                            },
                            {
                                "example_id": "ec3904ac-1307-45e3-8435-e58154406e52",
                                "sense_id": "9cadfdcf-3816-3d99-bf76-1c619ad39b50",
                                "text": "Коля выставил тарелку гренков, стаканы."
                            },
                            {
                                "example_id": "dd242940-2e58-4e7b-95d7-eb942ffb746d",
                                "sense_id": "9cadfdcf-3816-3d99-bf76-1c619ad39b50",
                                "text": "Нанизав будущий гренок на вилку, она совала его в печь, часто меняла руку, в которой была вилка, и, морщась, откидывала в сторону лицо от палящего жара."
                            }
                        ]
                    }
