                        "form": "асфа́льтней"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "19edaba9-acaa-3867-9e42-a9f44be6a4dc",
                        "entry_id": "3119a50d-9fa8-367d-a401-eebe84d86772",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным асфальт; свойственный, характерный для асфальта"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2b04dbe-4f6d-46e5-8f58-fbc2ce0a9e0b",
                                "sense_id": "19edaba9-acaa-3867-9e42-a9f44be6a4dc",
                                "text": "Построен асфальтный завод и оранжерея."
                            },
                            {
                                "example_id": "fd8715f4-cb84-489c-835c-f806a436a0bb",
                                "sense_id": "19edaba9-acaa-3867-9e42-a9f44be6a4dc",
                                "text": "Что это за платье асфальтного цвета старомодного фасона?"
                            },
                            {
                                "example_id": "633c997d-6974-4df0-b7c4-656ffafc5a6e",
                                "sense_id": "19edaba9-acaa-3867-9e42-a9f44be6a4dc",
                                "text": "Вы как будто под асфальтный каток попали."
                            }
                        ]
                    },
                    {
                        "sense_id": "2b0f3b84-7f9f-3d8b-937d-8444c4031250",
                        "entry_id": "3119a50d-9fa8-367d-a401-eebe84d86772",
                        "glosses": [
                            "содержащий в себе асфальт, состоящий из асфальта, сделанный из асфальта и т. п."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "441d76bd-ccc0-4083-b0ec-b45b191ef521",
                                "sense_id": "2b0f3b84-7f9f-3d8b-937d-8444c4031250",
                                "text": "Проходя по этой злополучной улице, один прохожий не разглядел, благодаря темени, бугра, упал левым виском на асфальтный тротуар и рассек себе до кости бровь."
                            },
                            {
                                "example_id": "194af69a-39fb-43e5-a6ee-d681291b2bfd",
                                "sense_id": "2b0f3b84-7f9f-3d8b-937d-8444c4031250",
                                "text": "Потом мы с отцом принялись бросать камешки и асфальтную крошку из-под ног ― не могли оторваться."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dfe67b80-a933-4c26-ba43-e5a49ec14e76",
                        "source_entry_id": "3119a50d-9fa8-367d-a401-eebe84d86772",
                        "target_lang_word": "asphalt",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "asphalt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dd5228d0-44c4-3050-a0fc-3a511efe63d8",
                                        "entry_id": "619ce02d-05d5-3951-831c-a59be206fd0e",
                                        "glosses": [
                                            "A sticky, black to brown and highly viscous liquid or semi-solid, composed almost entirely of bitumen with small mineral particles, that is present in most crude petroleums and in some natural deposits."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3384066d-357a-4d53-822d-b0ea8704ec4b",
                                                "sense_id": "dd5228d0-44c4-3050-a0fc-3a511efe63d8",
                                                "text": "The mining of asphalt was big business in this area in the early twentieth century."
                                            },
                                            {
                                                "example_id": "8c6190b2-5f40-4cdc-9ef6-f630d3ba8c03",
                                                "sense_id": "dd5228d0-44c4-3050-a0fc-3a511efe63d8",
                                                "text": "Felltham wrote in the beginning of the 17th century of the “Bitumated walls of Babylon;” the source of its supply, the fountains of Is, on a tributary of the Euphrates, still yields asphalt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc4adf97-2de4-384f-9129-5183fb7a630a",
                                        "entry_id": "619ce02d-05d5-3951-831c-a59be206fd0e",
                                        "glosses": [
                                            "Ellipsis of asphalt concrete, a hard ground covering used for roads and walkways."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "countable",
                                            "ellipsis",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64a4fc99-d445-4f40-a3aa-9a78fea8b404",
                                                "sense_id": "dc4adf97-2de4-384f-9129-5183fb7a630a",
                                                "text": "Near-synonyms: tarmac, tarmacadam, blacktop, bitumen"
                                            },
                                            {
                                                "example_id": "26b5c27c-e741-41b1-a6de-636379769b18",
                                                "sense_id": "dc4adf97-2de4-384f-9129-5183fb7a630a",
                                                "text": "Please hose off the asphalt near the top of the driveway if the trucks get lots of mud on it."
                                            },
                                            {
                                                "example_id": "105cb154-efff-428d-b9fe-55d092027c33",
                                                "sense_id": "dc4adf97-2de4-384f-9129-5183fb7a630a",
                                                "text": "Between the grey mist of rainclouds the sun suddenly appeared to mottle the wet asphalt of Marble Arch in patches of silver and ebony."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "asphalt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eaa61ea5-93d1-339c-bc06-4ca38a2bef4c",
                                        "entry_id": "3dd6664b-8295-3382-af70-896317589cbb",
                                        "glosses": [
                                            "To pave with asphalt."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d5428ac3-172c-4831-9856-fc3b3196b4b0",
                        "source_entry_id": "3119a50d-9fa8-367d-a401-eebe84d86772",
                        "target_lang_word": "asphaltic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "asphaltic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6ec5ced8-1b84-3a91-9459-4d11d620376e",
                                        "entry_id": "514c481f-642c-3a3c-a610-f9a993ac961a",
                                        "glosses": [
                                            "Resembling, containing, or relating to asphalt or bitumen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3401c31-6f17-49bb-9fdf-5e667440a620",
                                                "sense_id": "6ec5ced8-1b84-3a91-9459-4d11d620376e",
                                                "text": "asphaltic concrete; asphaltic sediment"
                                            },
                                            {
                                                "example_id": "04f4874b-2375-45b3-a222-e350bf5e1866",
                                                "sense_id": "6ec5ced8-1b84-3a91-9459-4d11d620376e",
                                                "text": "The aggregated Soyle\nDeath with his Mace petrific, cold and dry,\nAs with a Trident smote, and fix’t as firm\nAs Delos floating once; the rest his look\nBound with Gorgonian rigor not to move,\nAnd with Asphaltic slime,"
                                            },
                                            {
                                                "example_id": "76a5da67-0ca2-49ac-8a4f-dc6acec1c22a",
                                                "sense_id": "6ec5ced8-1b84-3a91-9459-4d11d620376e",
                                                "text": "Hears the hoarse bittern, where Gomorrah stood;"
                                            },
                                            {
                                                "example_id": "edb991cf-c3fe-485c-9948-e57a32df00ad",
                                                "sense_id": "6ec5ced8-1b84-3a91-9459-4d11d620376e",
                                                "text": "[…] the congealed frost lay ten inches thick in a hard, asphaltic pavement,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b5edc2a-d2a3-3aec-9423-572034a8074e",
                                        "entry_id": "514c481f-642c-3a3c-a610-f9a993ac961a",
                                        "glosses": [
                                            "Of or relating to the Dead Sea (salt lake between Jordan and Israel)."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1fab84ca-af94-4e24-847a-8547498ff55f",
                                                "sense_id": "1b5edc2a-d2a3-3aec-9423-572034a8074e",
                                                "text": "As Sodomes Apples, neere th’Asphalticke lake,\nOf specious shew, yet touch’t, to ashes turning,\nSo are sinnes poysons sweete, yet bane to take;"
                                            },
                                            {
                                                "example_id": "90c442e5-90a3-47ee-9bb0-a2894e16e251",
                                                "sense_id": "1b5edc2a-d2a3-3aec-9423-572034a8074e",
                                                "text": "[…] who gather from the fragrant shrub\nThe aromatic balsam, and extract\nIts milky juice along the lovely side\nOf winding Jordan, till immers’d it sleep\nBeneath the pitchy surface, which obscures\nTh’ Asphaltic lake."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
