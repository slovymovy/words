                    }
                ],
                "senses": [
                    {
                        "sense_id": "ec78f8e3-08dd-3455-be04-f6fd2800b297",
                        "entry_id": "5e8fce9d-a1b9-3eff-823b-b184fbb77255",
                        "glosses": [
                            "met veel praal en schittering"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39e9061a-e418-40ce-9c25-f37ba96da4c7",
                                "sense_id": "ec78f8e3-08dd-3455-be04-f6fd2800b297",
                                "text": "Muziek maken, om minder zou het niet mogen gaan in deze wedstrijd. Want ook al hoor je elke avond twee totaal verschillende concerto’s, het gaat erom deze vaak eeuwenoude muziek zo te spelen dat je het zweet in de noten kan ruiken en zien parelen. Het is een van de grootste uitdagingen van een concertpianist anno nu: hoe geef je kleur en geur aan muziek die zo luisterrijk is dat iedereen in de zaal ze kan meefluiten? De twee finalisten die gisteren aantraden, hadden daar elk een ander antwoord op klaar."
                            },
                            {
                                "example_id": "ab639ece-148a-4760-8606-d2b9182f67a7",
                                "sense_id": "ec78f8e3-08dd-3455-be04-f6fd2800b297",
                                "text": "De eervolle Willibrordplaquette werd haar zondagmorgen uitgereikt door pastoor Munsterhuis van de parochie Lumen Christie tijdens de viering van het Plechelmusfeest in de kerk van De Lutte, dat in het dorp jaarlijks op een luisterrijke en traditionele wijze wordt gevierd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b9a902da-aa49-4896-9bd4-70ec7aa5ebe9",
                        "source_entry_id": "5e8fce9d-a1b9-3eff-823b-b184fbb77255",
                        "source_sense_id": "ec78f8e3-08dd-3455-be04-f6fd2800b297",
                        "source_sense_description": "met veel praal en schittering",
                        "target_lang_word": "magnificent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "magnificent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ee6f068a-0ac8-3444-8df5-f9c5651ca5aa",
                                        "entry_id": "7d18dc65-85f0-35dd-a4b0-5af11d4abb0f",
                                        "glosses": [
                                            "Grand, elegant or splendid in appearance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ad37072-66b7-46e2-99d0-111941e99fcb",
                                                "sense_id": "ee6f068a-0ac8-3444-8df5-f9c5651ca5aa",
                                                "text": "“Do I fidget you ?” he asked apologetically, whilst his long bony fingers buried themselves, string, knots, and all, into the capacious pockets of his magnificent tweed ulster."
                                            },
                                            {
                                                "example_id": "79e197cc-f492-4eec-96ab-27849bf2120b",
                                                "sense_id": "ee6f068a-0ac8-3444-8df5-f9c5651ca5aa",
                                                "text": "Armstrong: \"Isn't that something! Magnificent sight out here.\"\nAldrin: \"Magnificent desolation.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d903716a-bb6e-37f5-af1b-406f2c5de825",
                                        "entry_id": "7d18dc65-85f0-35dd-a4b0-5af11d4abb0f",
                                        "glosses": [
                                            "Grand or noble in action."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "91d03734-9c8f-3a81-af77-42b8b0f44bd5",
                                        "entry_id": "7d18dc65-85f0-35dd-a4b0-5af11d4abb0f",
                                        "glosses": [
                                            "Exceptional for its kind."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1901beb0-5b01-414b-888b-167d086c503c",
                                                "sense_id": "91d03734-9c8f-3a81-af77-42b8b0f44bd5",
                                                "text": "They burned the old gun that used to stand in the dark corner up in the garret, close to the stuffed fox that always grinned so fiercely. Perhaps the reason why he seemed in such a ghastly rage was that he did not come by his death fairly. Otherwise his pelt would not have been so perfect. And why else was he put away up there out of sight?—and so magnificent a brush as he had too."
                                            },
                                            {
                                                "example_id": "e9c49906-4c5d-45c2-b25b-0b00026da546",
                                                "sense_id": "91d03734-9c8f-3a81-af77-42b8b0f44bd5",
                                                "text": "Substitute Edin Dzeko scrambled in a fourth and the magnificent David Silva ran clear to add another, before the Bosnian striker inflicted the final wound seconds from the end."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
