                "senses": [
                    {
                        "sense_id": "b6b3da00-3498-3259-b796-c66cb80651fc",
                        "entry_id": "04430a2a-0cbe-3680-b820-3f6176cc522d",
                        "glosses": [
                            "eigensinniger Mangel an Bereitschaft, sich einzuschränken, obwohl eine Krise einen gewissen Verzicht oder Einschränkungen erforderlich machen würde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e83f8a52-dd5a-4cce-a749-f367c5071859",
                                "sense_id": "b6b3da00-3498-3259-b796-c66cb80651fc",
                                "text": "„Dazu kommen in den sozialen Netzwerken der Wohlstandstrotz und das Anspruchsdenken von Deutschen, die auch in der Krise auf nichts verzichten wollen.“"
                            },
                            {
                                "example_id": "6985afe2-a337-4f9c-861b-f835dbdbc0d4",
                                "sense_id": "b6b3da00-3498-3259-b796-c66cb80651fc",
                                "text": "„Die Bundespolizei in Hannover hat nun in einer emotionalen Pressemeldung ihrem Ärger darüber Luft gemacht. ‚Setzt einfach eure Maske auf und erspart uns euren Wohlstandstrotz. Wir haben schon genug zu tun‘, erklärten die Beamten.“"
                            },
                            {
                                "example_id": "5b3da50e-0275-4cad-8538-e5788e0df932",
                                "sense_id": "b6b3da00-3498-3259-b796-c66cb80651fc",
                                "text": "„Die sich (zum Glück!) so in ihrem Alltag einrichten konnte, dass sie aus den Komfortroutinen nun schwer wieder herauskommt. Vielleicht kommt im krisenverschonten Deutschland generell eine eingebildete Unverletzlichkeit hinzu, eine Art Wohlstandstrotz.“"
                            },
                            {
                                "example_id": "f185d703-112d-4d25-9fc5-1dd1afdb7bbd",
                                "sense_id": "b6b3da00-3498-3259-b796-c66cb80651fc",
                                "text": "„Die Psychologie kennt die Wohlstandsverwahrlosung bei Kindern, der Wellness-Widerstand baut auf ähnlichen Mechanismen auf. Der Journalist Lenz Jacobsen schrieb schon im März 2020, ganz zu Beginn der Pandemie, hellsichtig vom »Wohlstandstrotz«. Dieser Massentrotz der Verwöhnten hat tödliche Folgen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
