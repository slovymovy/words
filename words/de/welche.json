                        "welche Art",
                        "welche Farbe"
                    ]
                },
                {
                    "sense_id": "79d0a074-33fa-3176-b8c8-6e717c7ca20d",
                    "sense_definition": "steht stellvertretend für eine unbestimmte Anzahl von Personen oder zählbaren Dingen im Plural",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "indefinit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sind noch Kekse in der Dose oder hast du schon alle gegessen? – Da sind noch <w>welche</w>."
                        },
                        {
                            "text": "Wenn du noch frische Tomaten für den Salat brauchst, im Kühlschrank liegen noch <w>welche</w>."
                        }
                    ],
                    "synonyms": [
