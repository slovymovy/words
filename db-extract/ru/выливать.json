                "senses": [
                    {
                        "sense_id": "a9a83d3d-064f-38b2-80f6-ac17fcf99cc2",
                        "entry_id": "170c5068-4ddb-3248-b34e-3df02da37377",
                        "glosses": [
                            "заставлять (жидкость) вытечь из чего-либо, откуда-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38b7f93e-d264-4707-a8a4-3c5c24dd1975",
                                "sense_id": "a9a83d3d-064f-38b2-80f6-ac17fcf99cc2",
                                "text": "И тогда я решил её перехитрить: буду делать вид, что пью по-прежнему, а сам буду выливать часть водки и упорно уменьшать дозу. Нелегко пьющему человеку выливать водку! Однако я своей рукой её выливаю!"
                            }
                        ]
                    },
                    {
                        "sense_id": "f8985ed0-6fff-380f-ac47-fc233ffded70",
                        "entry_id": "170c5068-4ddb-3248-b34e-3df02da37377",
                        "glosses": [
                            "изготовлять литьём; отливать"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "8b4423d8-ea22-34fe-8d47-7d71246b63d7",
                        "entry_id": "170c5068-4ddb-3248-b34e-3df02da37377",
                        "glosses": [
                            "перен. давать выход какому-либо чувству"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8fbadf35-1c19-478d-b1e2-481aef9b2203",
                        "source_entry_id": "170c5068-4ddb-3248-b34e-3df02da37377",
                        "source_sense_description": "заставлять вытечь",
                        "target_lang_word": "ausgießen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ausgießen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9bccbcc8-41e5-3c08-8522-db86970c0c53",
                                        "entry_id": "56a9aa47-608b-301b-a899-99631cc9725f",
                                        "glosses": [
                                            "den Behälter, in dem die Flüssigkeit ist, wenden/kippen, so dass sie aus dem Gefäß herausläuft"
                                        ],
                                        "tags": [
                                            "meist über Flüssigkeiten"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2321b76a-4495-4987-83ac-7c1eaf618097",
                                                "sense_id": "9bccbcc8-41e5-3c08-8522-db86970c0c53",
                                                "text": "Statt das Wasser in der Toilette auszugießen, hättest du damit die Blumen auf dem Balkon gießen können."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9ad8eb6b-3a0a-337b-a937-aab4b62a6783",
                                        "entry_id": "56a9aa47-608b-301b-a899-99631cc9725f",
                                        "glosses": [
                                            "jemandem deutlich und viel Anerkennung/Kritik zukommen lassen"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88a0e084-b90c-4344-af15-c42962c017de",
                                                "sense_id": "9ad8eb6b-3a0a-337b-a937-aab4b62a6783",
                                                "text": "„Wenn Luther Witz und Hohn ausgießt, lässt er dies wirklich gern auch über sich selbst ergehen. Er gehörte nicht zu denen, die sich selbst wichtig nehmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "27e066c4-d416-39a6-bde2-f7f1e4b60503",
                                        "entry_id": "56a9aa47-608b-301b-a899-99631cc9725f",
                                        "glosses": [
                                            "mit flüssiger/halbflüssiger Masse befüllen"
                                        ],
                                        "tags": [
                                            "über Formen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e7efdea-876d-460e-b843-e34cb66821b3",
                                                "sense_id": "27e066c4-d416-39a6-bde2-f7f1e4b60503",
                                                "text": "In einem ersten Schritt gießen die Arbeiter die Formen mit Wachs aus."
