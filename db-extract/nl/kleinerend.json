                                "example_id": "7f2705fc-eb34-4b63-93d9-59075fe45605",
                                "sense_id": "750c03b1-e53f-3f3d-a1bb-c6192873d8cd",
                                "text": "Maar op de eretribune was de verontwaardiging bij de bonzen van Atlético groter dan bij de spelers op het veld, die de kleinerende woorden misschien niet eens zagen."
                            }
                        ]
                    }
