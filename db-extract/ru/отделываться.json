                        "entry_id": "3192915b-87e3-31b5-9ded-27c13f5ab124",
                        "glosses": [
                            "to get rid (of), to get away (from), to throw off, to shake off, to be through (with), to finish (with)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2bdbb56d-edd3-41ac-9da2-876dce19bdf4",
                                "sense_id": "88db11f1-779d-37e1-a36a-ad97e6dcc494",
                                "text": "не могу́ отде́лываться от впечатле́ния",
                                "translation": "I can't shake off [get away from] the impression",
                                "english": "I can't shake off [get away from] the impression"
                            }
                        ]
                    },
                    {
                        "sense_id": "66f51dc3-c79d-3750-9478-3fa585214e38",
                        "entry_id": "3192915b-87e3-31b5-9ded-27c13f5ab124",
                        "glosses": [
                            "to escape (with), to get away (with), to get off (with)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28106b11-7506-4aaa-883a-b8ea401664b8",
                                "sense_id": "66f51dc3-c79d-3750-9478-3fa585214e38",
                                "text": "отде́лываться о́бщими фра́зами (от)",
                                "translation": "to talk one's way out (of)",
                                "english": "to talk one's way out (of)"
                            },
                            {
                                "example_id": "51f1e7a0-6658-4c9c-9485-757973e409c6",
                                "sense_id": "66f51dc3-c79d-3750-9478-3fa585214e38",
                                "text": "отде́лываться отгово́рками",
                                "translation": "to get away with excuses; get away with irrelevant comments; dodge the question; give the runaround",
                                "english": "to get away with excuses; get away with irrelevant comments; dodge the question; give the runaround"
                            }
                        ]
                    },
                    {
                        "sense_id": "c2ec7f34-4898-35e3-b481-107b58a46a5f",
                        "entry_id": "3192915b-87e3-31b5-9ded-27c13f5ab124",
                        "glosses": [
                            "to get away (with), to get off (with)"
                        ],
                        "tags": [],
                        "examples": [
