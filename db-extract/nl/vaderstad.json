                "senses": [
                    {
                        "sense_id": "eba223f3-4306-3cb3-871b-8a420c802159",
                        "entry_id": "11a03448-f10c-34e9-b822-b5199d79a74b",
                        "glosses": [
                            "stad waar iemands vader vandaan komt, de stad waar iemand geboren is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ab6705f-ca9b-47dd-ae7f-bd34388a474b",
                                "sense_id": "eba223f3-4306-3cb3-871b-8a420c802159",
                                "text": "Volgens de rechtbank komt zijn film op 37 punten overeen met de boeken Weg van Lila en Vaderstad van auteur Patrick van Rhijn."
                            },
                            {
                                "example_id": "9c1b5941-cd33-4133-a79b-01930b3ef5f7",
                                "sense_id": "eba223f3-4306-3cb3-871b-8a420c802159",
                                "text": "In 1652 ging hij in zijn vaderstad theologie studeren en onder leiding van de beroemde Gisbertus Voetius verdedigde hij in 1656 een disputatie in een serie over dwalingen en ketters."
                            }
                        ]
                    },
                    {
                        "sense_id": "3e3904aa-d7a9-3747-9618-abc2089996e7",
                        "entry_id": "11a03448-f10c-34e9-b822-b5199d79a74b",
                        "glosses": [
                            "Jeruzalem de stad van de Heer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03aa651e-9d8e-4858-8f67-1ecfe6895e43",
                                "sense_id": "3e3904aa-d7a9-3747-9618-abc2089996e7",
                                "text": "En speel en zing ten slotte, in de kerk –of als dat niet mag thuis– eens gezang 265 uit het Liedboek van 1973. Wat dit lied, ”Jeruzalem, mijn vaderstad” van de grote dichter Willem Barnard, aan schoonheid bergt, in een volmaakte symbiose van Woord, beeld en klank, is onvergelijkelijk."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a4ed0885-c8e2-4d0b-8dde-bca53eba8923",
                        "source_entry_id": "11a03448-f10c-34e9-b822-b5199d79a74b",
                        "source_sense_id": "eba223f3-4306-3cb3-871b-8a420c802159",
                        "source_sense_description": "stad waar iemands vader vandaan komt",
                        "target_lang_word": "hometown",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hometown",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3d070c5a-38db-311d-90c4-8f265fe3b764",
                                        "entry_id": "589addf7-d377-3e91-a741-45605b4a3b6b",
                                        "glosses": [
                                            "An individual’s place of birth, childhood home, or place of main residence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a411e779-63cd-4e08-ae1a-f2994494ca76",
                                                "sense_id": "3d070c5a-38db-311d-90c4-8f265fe3b764",
                                                "text": "These vehicles convey Esther from her hometown hospital, then to a city hospital, and finally from the city hospital in another hearselike conveyance […]"
                                            },
                                            {
                                                "example_id": "663e9ffb-5dbc-4eca-a526-21d15f411a02",
                                                "sense_id": "3d070c5a-38db-311d-90c4-8f265fe3b764",
                                                "text": "“It’s not good stewardship. If the guests wanted to walk through a funhouse with guys jumping out of the shadows saying ‘booga-booga,’ they’d go to one of the Halloween Houses in their hometowns. The Mansion’s better than that. I can’t be a part of this plan.”"
                                            },
                                            {
                                                "example_id": "fa0157a6-a075-4cc2-b17b-65bb9343d5af",
                                                "sense_id": "3d070c5a-38db-311d-90c4-8f265fe3b764",
                                                "text": "Candace Rivers’ involvement with trucking began, fittingly, on Interstate 20 not far from her hometown of Oxford, Alabama."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae53230c-f062-3195-bd9b-b410beefaa05",
                                        "entry_id": "589addf7-d377-3e91-a741-45605b4a3b6b",
                                        "glosses": [
                                            "Designating a decision or judgement that is biased, or perceived to be biased, in favour of local preference."
                                        ],
                                        "tags": [
                                            "attributive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7e4d5ba-5f69-4729-80d5-3fd2b9cc22d9",
                                                "sense_id": "ae53230c-f062-3195-bd9b-b410beefaa05",
                                                "text": "hometown decision, hometown verdict"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
