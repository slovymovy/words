                "senses": [
                    {
                        "sense_id": "fe677580-a776-32cd-bbf6-6174782deb54",
                        "entry_id": "41289519-0c59-3b09-9e63-db52d1d5df04",
                        "glosses": [
                            "Vermittlung von gekündigten Mitarbeitern in ein neues Arbeitsverhältnis durch den bisherigen, kündigenden Arbeitgeber, insbesondere bei Fachkräften und Führungskräften"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55a9ba53-2dbc-4da0-9274-94a62c1fd670",
                                "sense_id": "fe677580-a776-32cd-bbf6-6174782deb54",
                                "text": "Der Betrieb setzte beim Personalabbau auf Outplacement."
                            },
                            {
                                "example_id": "2bdf0343-06ef-4003-b363-cb16842ce68d",
                                "sense_id": "fe677580-a776-32cd-bbf6-6174782deb54",
                                "text": "Unternehmen, die per Outplacement eine faire Trennungskultur praktizieren, signalisieren ihren Mitarbeitern, dass sie in dieser belastenden Situation nicht alleine gelassen werden."
                            },
                            {
                                "example_id": "b8469f03-a2b1-4cfe-b02e-35aad8eb8ee2",
                                "sense_id": "fe677580-a776-32cd-bbf6-6174782deb54",
                                "text": "Für das Unternehmen ist Outplacement eine Möglichkeit, arbeitsrechtliche Prozesse vor Gericht zu vermeiden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
