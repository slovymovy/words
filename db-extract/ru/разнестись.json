                "senses": [
                    {
                        "sense_id": "60ddb84f-350c-37a1-91fa-914effa784bc",
                        "entry_id": "16babb41-25c2-3291-91fc-31f6ccf860b9",
                        "glosses": [
                            "to spread"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa57ece3-0bc6-4f47-8fac-35e2e4cc4f09",
                                "sense_id": "60ddb84f-350c-37a1-91fa-914effa784bc",
                                "text": "Весть с э́тим ра́достным собы́тием, во вред христиа́нству и в по́льзу будди́зма, как ви́хрем разнесла́сь по всему́ кра́ю.",
                                "translation": "The news of these joyful events, to the detriment of Christianity, and to the advantage of Buddhism, spread over the whole district like a whirlwind.",
                                "english": "The news of these joyful events, to the detriment of Christianity, and to the advantage of Buddhism, spread over the whole district like a whirlwind."
                            },
                            {
                                "example_id": "7509792b-9863-4e6c-9eb7-6d864545d078",
                                "sense_id": "60ddb84f-350c-37a1-91fa-914effa784bc",
                                "text": "Слу́хи о том, что Пы́льников — переоде́тая ба́рышня, бы́стро разнесли́сь по го́роду.",
                                "translation": "Rumours that Pilnikov was a disguised girl soon spread about the town.",
                                "english": "Rumours that Pilnikov was a disguised girl soon spread about the town."
                            }
                        ]
                    },
