                    {
                        "sense_id": "95426795-ee2d-323f-ae62-236be8452255",
                        "entry_id": "8522e05d-eacf-3a82-af21-611de4fefd9c",
                        "glosses": [
                            "A magnetic mineral, Fe₃O₄, one of the primary ores of iron."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5acaccf0-e66f-4385-bd3f-f600fe1c2c6c",
                                "sense_id": "95426795-ee2d-323f-ae62-236be8452255",
                                "text": "Appropriately enough, the commonest of these, a simple iron oxide, is called magnetite."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b68fa358-d47b-46e9-bea7-0ca669ff2533",
                        "source_entry_id": "8522e05d-eacf-3a82-af21-611de4fefd9c",
