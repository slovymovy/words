                "senses": [
                    {
                        "sense_id": "6fd659c9-8c41-33e3-9449-b1ebd0213ae0",
                        "entry_id": "5be5f71f-3ef5-3c31-8f4a-d07357503279",
                        "glosses": [
                            "familiäre, nationale, kulturelle Herkunft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf89d53c-441c-418c-b43d-91fd69ffe4b3",
                                "sense_id": "6fd659c9-8c41-33e3-9449-b1ebd0213ae0",
                                "text": "„Zum besseren Verständnis dieses Gefühls muß man sich vergegenwärtigen, wie stark Menschen von aristokratischer Abkunft das Familienehrgefühl im Blut sitzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d7f85c62-73eb-462d-82b2-4340dc49b099",
                        "source_entry_id": "5be5f71f-3ef5-3c31-8f4a-d07357503279",
                        "source_sense_id": "6fd659c9-8c41-33e3-9449-b1ebd0213ae0",
                        "source_sense_description": "familiäre, nationale, kulturelle Herkunft",
                        "target_lang_word": "parentage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "parentage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a08b5b5-2cee-3b15-9cfb-4b5ee4c1aba5",
                                        "entry_id": "098a86b0-ed12-309b-a451-81206303f8f0",
                                        "glosses": [
                                            "The identity and nature of one's parents, and in particular, the legitimacy of one's birth."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1af6b372-b88c-45aa-ac1a-a81dc617cdf7",
                                                "sense_id": "5a08b5b5-2cee-3b15-9cfb-4b5ee4c1aba5",
                                                "text": "I am a Lord, for so my deedes ſhall prooue,\nAnd yet a ſhepheard by my Parentage: […]"
                                            },
                                            {
                                                "example_id": "6e0dd7c2-b792-4179-9b6f-4211e3d9b3e1",
                                                "sense_id": "5a08b5b5-2cee-3b15-9cfb-4b5ee4c1aba5",
                                                "text": "English gentlemen, after all, do not discriminate against each other on the grounds of parentage, only of breeding."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "457ff0f3-9502-391d-aceb-3de25b82ec9b",
                                        "entry_id": "098a86b0-ed12-309b-a451-81206303f8f0",
                                        "glosses": [
                                            "The social quality of one's class in society."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74f09b96-c0fb-417b-9d30-d3c3eeec7fc8",
                                                "sense_id": "457ff0f3-9502-391d-aceb-3de25b82ec9b",
                                                "text": "My fortunes parentage — good parentage — To equal mine! — was it not thus? What say you?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7ec7fc4-475d-34df-a42d-c40c5c1a355b",
                                        "entry_id": "098a86b0-ed12-309b-a451-81206303f8f0",
                                        "glosses": [
                                            "Origin; derivation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3ed07624-6f78-48c2-af7b-6ca6d71f58d6",
                        "source_entry_id": "5be5f71f-3ef5-3c31-8f4a-d07357503279",
                        "source_sense_id": "6fd659c9-8c41-33e3-9449-b1ebd0213ae0",
                        "source_sense_description": "familiäre, nationale, kulturelle Herkunft",
                        "target_lang_word": "origine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "origine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0eeab669-a447-39c2-a495-bca3392345e6",
                                        "entry_id": "da612b31-08b4-318c-abc6-921d7a206bea",
                                        "glosses": [
                                            "Commencement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79eae0ab-be3a-468a-a376-2e796cc598ee",
                                                "sense_id": "0eeab669-a447-39c2-a495-bca3392345e6",
                                                "text": "L'exploité modèle est donc, dès l’origine, le travailleur de grande entreprise."
                                            },
                                            {
                                                "example_id": "5c726cdd-4753-41f7-963a-c16406766d65",
                                                "sense_id": "0eeab669-a447-39c2-a495-bca3392345e6",
                                                "text": "L’histoire de l’origine du monde est différente selon les cultures."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12e3ffba-b980-39f7-8582-7227efc7392a",
                                        "entry_id": "da612b31-08b4-318c-abc6-921d7a206bea",
                                        "glosses": [
                                            "Point de départ ; première cause."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3276517b-980e-4952-a2b3-2ea54c72ecd3",
                                                "sense_id": "12e3ffba-b980-39f7-8582-7227efc7392a",
                                                "text": "Une étude plus large et plus scientifique des dialectes locaux établira que, par son origine et par ses caractères essentiels, le slovaque appartient au groupe yougoslave."
                                            },
                                            {
                                                "example_id": "d946735e-f333-4a6f-8a64-354e7eb3fb2d",
                                                "sense_id": "12e3ffba-b980-39f7-8582-7227efc7392a",
                                                "text": "La flore française contient aussi quelques plantes dont l’origine doit être recherchée dans une migration vers l'Ouest de plantes aralo-caspiennes au Miocène ou au Pliocène."
                                            },
                                            {
                                                "example_id": "a274e992-9186-4719-99b3-68cf4a18f559",
                                                "sense_id": "12e3ffba-b980-39f7-8582-7227efc7392a",
                                                "text": "Des spécialistes, comme Philippe Duchaufour ou Marcel Jamagne, qui a contribué à l'élaboration de la carte des sols de l’Aisne, notent que cette dégradation peut aussi avoir des origines anthropiques."
                                            },
                                            {
                                                "example_id": "374d578d-ed0b-4f35-8370-2cd53e22c3b6",
                                                "sense_id": "12e3ffba-b980-39f7-8582-7227efc7392a",
                                                "text": "Dion Cassius rapporte que les jubilés décennaux et vicennaux des Empereurs avaient leur origine dans le fait qu'en janvier 27 av. J.-C., Auguste avait reçu du Sénat et du peuple son imperium légal pour dix ans ; […]."
                                            },
                                            {
                                                "example_id": "44a1c05c-7795-40d2-94cb-6eb0b6068629",
                                                "sense_id": "12e3ffba-b980-39f7-8582-7227efc7392a",
                                                "text": "Bob Paisley est à l’origine du succès de Liverpool dans les années 1970 et 1980. Le manager anglais a apporté aux « Reds » six titres nationaux, trois fois la Coupe d’Europe I et une fois la Coupe de l’UEFA."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26cb5ce0-9a6e-3d2e-9d9b-a16ff9b215f3",
                                        "entry_id": "da612b31-08b4-318c-abc6-921d7a206bea",
                                        "glosses": [
                                            "Milieu de naissance ; lieu ou condition de création."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0038a33b-cc41-4c8b-b1d9-c8542be28630",
                                                "sense_id": "26cb5ce0-9a6e-3d2e-9d9b-a16ff9b215f3",
                                                "text": "En montant un vaste escalier à tapis, où je remarquai toutes les recherches du comfort anglais, le cœur me battit; j’en rougissais, je démentais mon origine, mes sentiments, ma fierté, j’étais sottement bourgeois."
                                            },
                                            {
                                                "example_id": "0be78c29-1959-449b-b1c8-8f1d879bdc42",
                                                "sense_id": "26cb5ce0-9a6e-3d2e-9d9b-a16ff9b215f3",
                                                "text": "De nombreux jaunes, par exemple, qu'ils soient d’origine naturelle (flavoniques) ou artificielle (azoïques) présentent une fluorescence non négligeable."
                                            },
                                            {
                                                "example_id": "a8220c8f-03cb-4114-90e9-04252a523f29",
                                                "sense_id": "26cb5ce0-9a6e-3d2e-9d9b-a16ff9b215f3",
                                                "text": "Végétariens et végétaliens seront heureux d'apprendre que les veloutés, gâteaux et la plupart des wraps sont réalisés avec des ingrédients d’origine végétale."
                                            },
                                            {
                                                "example_id": "e1fcb590-a03f-49ae-b4b2-2bd7992d85a4",
                                                "sense_id": "26cb5ce0-9a6e-3d2e-9d9b-a16ff9b215f3",
                                                "text": "Certificat d’origine : certificat indiquant officiellement la provenance d’un produit alimentaire, en particulier d’un vin."
                                            },
                                            {
                                                "example_id": "d42cdb42-330e-4514-9d3b-fa3593654082",
                                                "sense_id": "26cb5ce0-9a6e-3d2e-9d9b-a16ff9b215f3",
                                                "text": "Les origines d’une langue, l’origine d’un proverbe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d09ca35-a16f-31af-b8d9-4c35a5918cd7",
                                        "entry_id": "da612b31-08b4-318c-abc6-921d7a206bea",
                                        "glosses": [
                                            "En géométrie, singularité d’un espace repéré correspondant à l’intersection des axes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0dfd2630-5db0-431f-9b60-578e655ee838",
                                                "sense_id": "2d09ca35-a16f-31af-b8d9-4c35a5918cd7",
                                                "text": "L’origine d’un repère du plan, souvent notée O, est le point d’intersection de l’axe des abscisses et de l’axe des ordonnées"
                                            },
                                            {
                                                "example_id": "6875250b-46e1-4149-ba8a-e31b45f9bf15",
                                                "sense_id": "2d09ca35-a16f-31af-b8d9-4c35a5918cd7",
                                                "text": "Ainsi le seul couple de suites (e, f) dont l’équation différentielle hypergéométrique associée n'admet pas de solution de type logarithmique à l’origine correspond au cas j = 1.Éric Delaygue, Propriétés arithmétiques des applications miroir, Institut Fourier, 2011, page 28"
                                            },
                                            {
                                                "example_id": "0742f672-548c-4e87-a3b6-ae7561ab837e",
                                                "sense_id": "2d09ca35-a16f-31af-b8d9-4c35a5918cd7",
                                                "text": "La courbe d’aimantation stable passe par l’origine ; c’est en quelque sorte, la courbe médiane entre les deux branches de la courbe d’hystérésis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58547aa5-2035-3101-8efc-172f5bda38f8",
                                        "entry_id": "da612b31-08b4-318c-abc6-921d7a206bea",
                                        "glosses": [
                                            "Branches des sciences qui ont un point de départ et une flèche du temps comme la cosmologie ou l’épistémologie."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
