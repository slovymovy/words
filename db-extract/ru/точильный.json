                ],
                "senses": [
                    {
                        "sense_id": "afafa9c3-5d97-36c1-8505-9f81a48a4ff8",
                        "entry_id": "97987f63-0491-3906-a577-1733ac58ef53",
                        "glosses": [
                            "предназначенный, служащий для натачивания режущих и колющих инструментов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a54267a-d8c2-4277-96fd-9b070f27a391",
                                "sense_id": "afafa9c3-5d97-36c1-8505-9f81a48a4ff8",
                                "text": "Затачивают ножи на точильном круге из карборунда или песчаника, который в процессе заточки смачивают водой."
                            },
                            {
                                "example_id": "21702481-621e-4702-ae27-79de6591f247",
                                "sense_id": "afafa9c3-5d97-36c1-8505-9f81a48a4ff8",
                                "text": "Точильщик нёс на плече точильный станок ― деревянную станину с круглыми точильными камнями на оси и педалью."
                            }
                        ]
                    }
                ],
