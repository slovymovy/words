            {
                "entry_id": "ed6eaa39-fa0c-341a-bc05-c8fbb98c6eb4",
                "word": "wapenstilstand",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "9f834dc1-0b25-418d-813c-e3d5bbf89b30",
                        "entry_id": "ed6eaa39-fa0c-341a-bc05-c8fbb98c6eb4",
                        "tags": [
                            "plural"
                        ],
                        "form": "wapenstilstanden"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "624d46dd-6b23-394a-8624-26abfbf0968b",
                        "entry_id": "ed6eaa39-fa0c-341a-bc05-c8fbb98c6eb4",
                        "glosses": [
                            "een overeenkomst met de vijand om de vijandelijkheden op te schorten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da471ec2-0aea-4d7c-82c7-7bc2c3dfd665",
                                "sense_id": "624d46dd-6b23-394a-8624-26abfbf0968b",
                                "text": "Een wapenstilstand kan bedoeld zijn om vredesonderhandelingen mogelijk te maken, maar is soms bedoeld tijdelijk te zijn, bijvoorbeeld om gevangenen uit te wisselen."
                            },
                            {
                                "example_id": "0421d38c-40d6-4a05-a419-636a559b761d",
                                "sense_id": "624d46dd-6b23-394a-8624-26abfbf0968b",
                                "text": "Daarom hoorde Albert in oktober de geruchten over de komende wapenstilstand nogal sceptisch aan."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0f51dad7-7d8e-4dd3-ad66-c66c2ce77b03",
                        "source_entry_id": "ed6eaa39-fa0c-341a-bc05-c8fbb98c6eb4",
                        "source_sense_id": "624d46dd-6b23-394a-8624-26abfbf0968b",
                        "source_sense_description": "een overeenkomst met de vijand om de vijandelijkheden op te schorten",
                        "target_lang_word": "Waffenstillstand",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Waffenstillstand",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "76b40b77-56a2-384c-b56c-961b51f4fa30",
                                        "entry_id": "a7a282e1-0c21-3169-aa7e-7b3606ee7d6f",
                                        "glosses": [
                                            "Vereinbarung zur Unterbrechung der Kämpfe in einem bewaffneten Konflikt – meist um Friedensverhandlungen zu führen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c83c3361-803f-487e-a4bd-526e9548efa4",
                                                "sense_id": "76b40b77-56a2-384c-b56c-961b51f4fa30",
                                                "text": "Für Europa gilt seit dem 8. Mai 1945, 00.01 Uhr Waffenstillstand."
                                            },
                                            {
                                                "example_id": "029fb04d-aea8-48d5-9772-273df4db52c1",
                                                "sense_id": "76b40b77-56a2-384c-b56c-961b51f4fa30",
                                                "text": "„Jeder spricht von Frieden und Waffenstillstand.“"
                                            },
                                            {
                                                "example_id": "9b15c649-5a9b-4c50-801d-1c19c0bc751e",
                                                "sense_id": "76b40b77-56a2-384c-b56c-961b51f4fa30",
                                                "text": "„Zuvor aber musste auch Siegfrieds Tod noch einmal herhalten, um den Waffenstillstand vom November 1918 ins – im doppelten Wortsinn – rechte Licht zu rücken.“"
                                            },
                                            {
                                                "example_id": "04b5f692-7c02-4f9b-84d2-3c00826334f7",
                                                "sense_id": "76b40b77-56a2-384c-b56c-961b51f4fa30",
                                                "text": "„Nach Waffenstillstand, Friedensschluss und Siegeszug in Berlin kam das Regiment wieder an den Rhein nach Koblenz.“"
                                            },
                                            {
                                                "example_id": "e6af9c63-ae16-438d-86a4-7154756a0222",
                                                "sense_id": "76b40b77-56a2-384c-b56c-961b51f4fa30",
                                                "text": "„Ich wusste nicht, was der Waffenstillstand für Folgen haben würde, und war unruhig.“"
                                            },
                                            {
                                                "example_id": "771d2997-1e69-4ca4-904e-95b53060b842",
                                                "sense_id": "76b40b77-56a2-384c-b56c-961b51f4fa30",
                                                "text": "Erleichterung in Mosambik: Die Renamo-Rebellen haben den Waffenstillstand mit der Regierung um zwei Monate verlängert."
                                            },
                                            {
                                                "example_id": "9b7e82e0-5a6f-4072-b1d2-9e5aa97d636e",
                                                "sense_id": "76b40b77-56a2-384c-b56c-961b51f4fa30",
                                                "text": "Der Waffenstillstand in der Westsahara wird überwacht von einer kleinen UN-Blauhelmtruppe."
                                            },
                                            {
                                                "example_id": "01547639-bab1-4c86-b9d6-6d6db1a6fefb",
                                                "sense_id": "76b40b77-56a2-384c-b56c-961b51f4fa30",
                                                "text": "Schon am 30. September, einen Tag nach der Forderung nach Waffenstillstand seitens Ludendorff, hatte Admiral Reinhard Scheer […] die Hochseeflotte ohne Angaben von Gründen in Wilhelmshaven zusammengezogen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ac8ba8f7-a1c9-4ceb-9e33-aa68c49e3c48",
                        "source_entry_id": "ed6eaa39-fa0c-341a-bc05-c8fbb98c6eb4",
                        "source_sense_id": "624d46dd-6b23-394a-8624-26abfbf0968b",
                        "source_sense_description": "een overeenkomst met de vijand om de vijandelijkheden op te schorten",
                        "target_lang_word": "truce",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "truce",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1949e978-fb26-3dd7-bf7d-9cb741d14c0c",
                                        "entry_id": "4f7638a6-b72a-3260-992c-19fc871b4049",
                                        "glosses": [
                                            "A period of time in which no fighting takes place due to an agreement between the opposed parties."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5393d473-d746-4086-b6f5-c005b4fb7302",
                                                "sense_id": "1949e978-fb26-3dd7-bf7d-9cb741d14c0c",
                                                "text": "An uneasy truce"
                                            },
                                            {
                                                "example_id": "c0b58867-81ee-492a-adae-ec789b3793e2",
                                                "sense_id": "1949e978-fb26-3dd7-bf7d-9cb741d14c0c",
                                                "text": "[I]n about ſix VVeeks or tvvo Months, the Dyſentery gave Truce, in vvhich Time I vvas often fretted vvith ſtrangurious Symptoms."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "379a8675-d4f5-3136-a048-85a412c5c84c",
                                        "entry_id": "4f7638a6-b72a-3260-992c-19fc871b4049",
                                        "glosses": [
                                            "An agreement between opposed parties in which they pledge to cease fighting for a limited time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1679a723-022c-44ae-a7a0-6f4b4e341230",
                                                "sense_id": "379a8675-d4f5-3136-a048-85a412c5c84c",
                                                "text": "He asked for a truce with his school enemy for five days."
                                            },
                                            {
                                                "example_id": "83c502ce-6054-4ce7-9a21-82c5dbcda9f2",
                                                "sense_id": "379a8675-d4f5-3136-a048-85a412c5c84c",
                                                "text": "They should meet that night on some neutral spot to ratify the truce."
                                            },
                                            {
                                                "example_id": "22374f5c-fcc6-4134-8f02-74846c77861b",
                                                "sense_id": "379a8675-d4f5-3136-a048-85a412c5c84c",
                                                "text": "[T]hey marked their truce by each of them, Aesir and Vanir alike, one by one spitting into a vat. As their spit mingled, so was their agreement made binding."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "truce",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "57362c97-6e94-34b1-9b76-286ec2cf0304",
                                        "entry_id": "12881bc1-27a0-3131-8f74-94e41b77e8cd",
                                        "glosses": [
                                            "To come to an agreement to cease fighting."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e4fc50d-7357-4bfd-9461-f78b354382a7",
                                                "sense_id": "57362c97-6e94-34b1-9b76-286ec2cf0304",
                                                "text": "Only undaunted Henry de Tracey […] held up the cause; trucing at last, in loyal terms, till the king should become more powerful and be able in person to restrain the country."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ec28c914-1259-4dc9-828b-ade130ea96b3",
                        "source_entry_id": "ed6eaa39-fa0c-341a-bc05-c8fbb98c6eb4",
                        "source_sense_id": "624d46dd-6b23-394a-8624-26abfbf0968b",
                        "source_sense_description": "een overeenkomst met de vijand om de vijandelijkheden op te schorten",
                        "target_lang_word": "trêve",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trêve",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e81828ab-1331-3d29-ac4c-d4193764c9b2",
                                        "entry_id": "f04b5d4b-5710-3207-8e20-73ad33437856",
                                        "glosses": [
                                            "Suspension de l’usage des armes, cessation de tout acte d’hostilité pour un certain temps, par convention faite entre deux États, entre deux partis qui sont en guerre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf567288-c431-4ae8-a8d3-93cb629dbd70",
                                                "sense_id": "e81828ab-1331-3d29-ac4c-d4193764c9b2",
                                                "text": "Le Roi a une entrevue à Nice avec le Pape Paul III, qui ménage une trêve de dix ans entre les Puissances belligérantes."
                                            },
                                            {
                                                "example_id": "2f78bbf1-c1c2-409a-a71e-d72e02d226ea",
                                                "sense_id": "e81828ab-1331-3d29-ac4c-d4193764c9b2",
                                                "text": "J’ai peu de choses importantes à vous apprendre, […], si ce n’est la nouvelle déjà confirmée d’une trêve entre les croisés et Saladin."
                                            },
                                            {
                                                "example_id": "0386492b-3b77-4a60-bcaa-ed2e1011b3fb",
                                                "sense_id": "e81828ab-1331-3d29-ac4c-d4193764c9b2",
                                                "text": "Cette trêve boiteuse fut définitivement rompue par l’assassinat (car il n’y a pas d’autre mot pour un tel acte) du Wetterhorn, au-dessus de Union Square […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4fcc79f4-5476-3eb4-962f-8b1954489294",
                                        "entry_id": "f04b5d4b-5710-3207-8e20-73ad33437856",
                                        "glosses": [
                                            "Toute suspension d’hostilités entre adversaires."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "adc94cb8-4bd8-3681-9617-7b22fa850d68",
                                        "entry_id": "f04b5d4b-5710-3207-8e20-73ad33437856",
                                        "glosses": [
                                            "Relâche."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cbd31942-bab4-4f8d-8a37-e49fa0373240",
                                                "sense_id": "adc94cb8-4bd8-3681-9617-7b22fa850d68",
                                                "text": "Soyez les apôtres de ma Cause, cause sacrée, qui est celle de la défaite noble et fière, défaite temporaire... Faites le plus possible de prosélytes ; travaillez-y sans trêve ni relâche..."
                                            },
                                            {
                                                "example_id": "0c95815c-bf58-4b23-bf8e-c0b6a378b514",
                                                "sense_id": "adc94cb8-4bd8-3681-9617-7b22fa850d68",
                                                "text": "un bombardement sans cesse ni trêve"
                                            },
                                            {
                                                "example_id": "025890bf-c93a-40ac-a9d6-82fa14cbc92b",
                                                "sense_id": "adc94cb8-4bd8-3681-9617-7b22fa850d68",
                                                "text": "Catherine remarqua que les regards d’Isabelle allaient sans trêve de l’une à l’autre porte, comme anxieux."
                                            },
                                            {
                                                "example_id": "abecd780-e9e5-4025-bfd4-37ffb047d6e1",
                                                "sense_id": "adc94cb8-4bd8-3681-9617-7b22fa850d68",
                                                "text": "Nos gouvernements ne résistent pas à la tentation de l’infantilisation qui devient exaspérante. Nous aurons droit à une trêve de Noël supervisée par des experts de la Santé publique. Ottawa nous dit même à quel volume mettre la musique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b26f5e7b-d630-3b51-85da-e0b50efe086b",
                                        "entry_id": "f04b5d4b-5710-3207-8e20-73ad33437856",
                                        "glosses": [
                                            "Cesser quelque chose ; cesser de parler de quelque chose."
                                        ],
                                        "tags": [
                                            "ellipsis",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f4d5ac0-6fa8-47cb-8b43-fefbc640d658",
                                                "sense_id": "b26f5e7b-d630-3b51-85da-e0b50efe086b",
                                                "text": "Trêve de balivernes."
                                            },
                                            {
                                                "example_id": "36cfb392-b2bd-4b5d-a29e-f5c81b3c13b9",
                                                "sense_id": "b26f5e7b-d630-3b51-85da-e0b50efe086b",
                                                "text": "Trêve du passé, revenons à notre saison estivale."
                                            },
                                            {
                                                "example_id": "2e0099c0-f75e-4c58-9f84-a0710136b178",
                                                "sense_id": "b26f5e7b-d630-3b51-85da-e0b50efe086b",
                                                "text": "– Bon, trêve de bavardages. On passe à l’action. Après tout, ce bled n’est qu’un nid infesté d’ennemis, ni plus ni moins."
                                            },
                                            {
                                                "example_id": "ee88e0b2-8823-4dc5-bce0-c7b8d74817e6",
                                                "sense_id": "b26f5e7b-d630-3b51-85da-e0b50efe086b",
                                                "text": "Trêve de cérémonie."
                                            },
                                            {
                                                "example_id": "b8d9fe91-72a8-444f-817b-87cc35b88ac7",
                                                "sense_id": "b26f5e7b-d630-3b51-85da-e0b50efe086b",
                                                "text": "trêve de compliments."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
