{
    "word_family": [
        "fender",
        "defend",
        "offend"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b5f6d43c-895e-338b-b6da-6f0b5137571d",
                    "sense_definition": "To take care of oneself or manage without help from others.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "self-reliance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After moving out, he had to learn how to <w>fend</w> for himself.",
                            "target_lang_translations": {
                                "nl": "Nadat hij op zichzelf ging wonen, moest hij leren hoe hij zijn <w>eigen boontjes kon doppen</w>."
                            }
                        },
                        {
                            "text": "The young birds must <w>fend</w> for themselves once they leave the nest.",
                            "target_lang_translations": {
                                "nl": "De jonge vogels moeten <w>zichzelf redden</w> zodra ze het nest verlaten."
                            }
                        }
                    ],
                    "synonyms": [
                        "manage",
                        "survive"
                    ],
                    "common_phrases": [
                        "fend for oneself"
                    ],
                    "target_lang_definitions": {
                        "nl": "Voor zichzelf zorgen of zichzelf redden zonder hulp van anderen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "zijn eigen boontjes doppen",
                                "target_lang_sense_clarification": "idiomatische uitdrukking voor zelfredzaamheid"
                            },
                            {
                                "target_lang_word": "zich redden",
                                "target_lang_sense_clarification": "algemene term voor het overleven of klaren van een situatie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3eb3095f-c0ac-3bb8-988d-b28e59c9711a",
                    "sense_definition": "To push away, block, or protect against something harmful.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "protection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She used her umbrella to <w>fend</w> off the heavy rain.",
                            "target_lang_translations": {
                                "nl": "Ze gebruikte haar paraplu om de zware regen <w>af te weren</w>."
                            }
                        },
                        {
                            "text": "The guard used his shield to <w>fend</w> off the attacker.",
                            "target_lang_translations": {
                                "nl": "De bewaker gebruikte zijn schild om de aanvaller <w>van zich af te houden</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "repel",
                        "ward off",
                        "block"
                    ],
                    "common_phrases": [
                        "fend off"
                    ],
                    "target_lang_definitions": {
                        "nl": "Iets afweren, blokkeren of beschermen tegen iets schadelijks."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "afweren",
                                "target_lang_sense_clarification": "iets fysiek tegenhouden of op afstand houden"
                            },
                            {
                                "target_lang_word": "van zich afhouden",
                                "target_lang_sense_clarification": "iemand of iets op afstand houden"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9d4a3158-d4a2-3b6b-a8c7-acd70d67dac7",
                    "sense_definition": "The act of taking care of one's own well-being.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "self-reliance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>fend</w> was limited by his lack of resources.",
                            "target_lang_translations": {
                                "nl": "Zijn <w>zelfredzaamheid</w> werd beperkt door zijn gebrek aan middelen."
                            }
                        },
                        {
                            "text": "The survival of the group depended on their collective <w>fend</w>.",
                            "target_lang_translations": {
                                "nl": "Het overleven van de groep hing af van hun collectieve <w>zelfredzaamheid</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "self-reliance"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used as a noun in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "De handeling van het zorgen voor het eigen welzijn."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "zelfredzaamheid",
                                "target_lang_sense_clarification": "het vermogen om voor jezelf te zorgen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4b85de91-dcf4-3bb6-b65f-8cbd656e5444",
                    "sense_definition": "An enemy or a malevolent spirit.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "enemy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old stories warned of a dark <w>fend</w> lurking in the woods.",
                            "target_lang_translations": {
                                "nl": "De oude verhalen waarschuwden voor een duistere <w>demon</w> die in de bossen op de loer lag."
                            }
                        },
                        {
                            "text": "He felt as though he were fighting a personal <w>fend</w>.",
                            "target_lang_translations": {
                                "nl": "Hij had het gevoel alsof hij tegen een persoonlijke <w>vijand</w> vocht."
                            }
                        }
                    ],
                    "synonyms": [
                        "fiend",
                        "enemy"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "An archaic variant of fiend."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een vijand of een kwaadaardige geest."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "vijand",
                                "target_lang_sense_clarification": "iemand die tegenstand biedt"
                            },
                            {
                                "target_lang_word": "demon",
                                "target_lang_sense_clarification": "kwaadaardige geest of entiteit"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}