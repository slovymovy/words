{
    "word_family": [
        "watch",
        "watcher",
        "watchable",
        "unwatchable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ae0d6104-f230-3cbb-9cda-73c3c051121e",
                    "sense_definition": "To watch something again, such as a movie, television episode, or video.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "viewing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I decided to <w>rewatch</w> the entire series before the new season starts next month.",
                            "target_lang_translations": {
                                "ru": "Я решил <w>пересмотреть</w> весь сериал до того, как в следующем месяце начнется новый сезон."
                            }
                        },
                        {
                            "text": "If you <w>rewatch</w> a movie, you often notice small details that you missed the first time.",
                            "target_lang_translations": {
                                "ru": "Если вы <w>пересматриваете</w> фильм, вы часто замечаете мелкие детали, которые упустили в первый раз."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rewatch a movie",
                        "rewatch the series",
                        "rewatch a video"
                    ],
                    "target_lang_definitions": {
                        "ru": "Посмотреть что-либо снова, например фильм, серию телесериала или видео."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пересматривать",
                                "target_lang_sense_clarification": "смотреть повторно"
                            },
                            {
                                "target_lang_word": "посмотреть еще раз",
                                "target_lang_sense_clarification": "однократное действие"
                            },
                            {
                                "target_lang_word": "смотреть повторно",
                                "target_lang_sense_clarification": "официальный или описательный вариант"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e6a6efe9-57be-3b7d-bd8e-e95e5d7c1956",
                    "sense_definition": "The act of watching something again.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "viewing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is not the best film I have ever seen, but it probably deserves a <w>rewatch</w>.",
                            "target_lang_translations": {
                                "ru": "Это не самый лучший фильм, который я видел, но он, вероятно, заслуживает <w>пересмотра</w>."
                            }
                        },
                        {
                            "text": "After a second <w>rewatch</w>, I finally understood the complex plot of the thriller.",
                            "target_lang_translations": {
                                "ru": "После второго <w>просмотра</w> я наконец понял сложный сюжет этого триллера."
                            }
                        }
                    ],
                    "common_phrases": [
                        "deserves a rewatch",
                        "worth a rewatch",
                        "second rewatch"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт повторного просмотра чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пересмотр",
                                "target_lang_sense_clarification": "процесс повторного просмотра"
                            },
                            {
                                "target_lang_word": "повторный просмотр",
                                "target_lang_sense_clarification": "более формальное обозначение действия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}