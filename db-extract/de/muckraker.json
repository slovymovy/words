                        "translation_id": "8ded5c8b-e48c-46df-a46a-4fa48a495c7e",
                        "source_entry_id": "5a03575a-6a69-32b9-a265-13ca5f242ba9",
                        "source_sense_id": "f0d1e536-0274-3188-9747-03aa890b5336",
                        "target_lang_word": "muckraker",
