                        "sense_id": "cfc438b5-8148-34b8-91ed-e24157443c70",
                        "entry_id": "ecdf9745-0276-35c8-be12-53d7fb67f49b",
                        "glosses": [
                            "Dried corn (maize) milled (ground) to a meal, especially a coarse one."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "366d1a8e-7cb0-4315-b81e-e8372c9340db",
                                "sense_id": "cfc438b5-8148-34b8-91ed-e24157443c70",
                                "text": "She made a kind of polenta from cornmeal and chicken broth, with some cheese sprinkled on top."
                            }
                        ]
                    },
                    {
                        "sense_id": "9e30a3b1-e07c-39e5-bd68-354251c0a0ef",
                        "entry_id": "ecdf9745-0276-35c8-be12-53d7fb67f49b",
                        "glosses": [
                            "Any cereal grain meal or flour."
                        ],
                        "tags": [
                            "archaic",
                            "countable",
                            "especially",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b14cb529-4e69-4933-ac6d-c73487c45bb8",
                        "source_entry_id": "ecdf9745-0276-35c8-be12-53d7fb67f49b",
                        "source_sense_description": "dried corn milled to a coarse meal",
                        "target_lang_word": "farine de maïs",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "farine de maïs",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "44eff471-f922-3c02-a780-30f581a8a872",
                                        "entry_id": "dbb7b8c4-129a-35a0-89ff-beb03f7c4688",
                                        "glosses": [
                                            "Farine de couleur jaune pâle, obtenue par mouture sèche de grains de maïs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63e890f4-3edb-475d-af8e-2dfcc93ab3d1",
                                                "sense_id": "44eff471-f922-3c02-a780-30f581a8a872",
                                                "text": "Il tira de l’armoire un bloc de miasson tremblant sur une serviette saupoudrée de farine de maïs et l’apporta sur la table avec la planchette qui la soutenait."
                                            },
                                            {
                                                "example_id": "6359d847-f8e5-4cf4-8ccc-c4af73267bfe",
                                                "sense_id": "44eff471-f922-3c02-a780-30f581a8a872",
                                                "text": "La méture, ce pain fabriqué à base de farine de maïs, à la fois gâteau et pain campagnard que les fermières fabriquaient à la maison avec le fruit de leur récolte, revient à Salies de Béarn."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "db78ddc3-78da-4418-89d2-f0ec5254b477",
                        "source_entry_id": "ecdf9745-0276-35c8-be12-53d7fb67f49b",
                        "source_sense_description": "dried corn milled to a coarse meal",
                        "target_lang_word": "Maisgrieß",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Maisgrieß",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c05ee628-c6a0-3faf-825b-9d3e39c0d781",
                                        "entry_id": "68278fa0-58ed-3ce9-aa2b-097292d009be",
                                        "glosses": [
                                            "kleinkörnig gemahlene Maiskörner"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15b15425-9b50-4aa8-98be-025408f35776",
                                                "sense_id": "c05ee628-c6a0-3faf-825b-9d3e39c0d781",
                                                "text": "„Die traditionelle Zubereitung von Polenta ist einfach, aber kraftraubend. Nachdem man Maisgrieß langsam in kochendes Salzwasser eingerührt hat, muss die schwere Masse beständig bis zu einer Stunde lang gerührt werden, damit sie eine glatte Konsistenz erhält und nicht zu stark anbrennt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f3149bbe-3b60-34c5-8c56-2f9a377378cd",
                                        "entry_id": "68278fa0-58ed-3ce9-aa2b-097292d009be",
                                        "glosses": [
                                            "Speise (Brei) aus [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c410c55a-05f5-4549-aab6-ddfcdd71c564",
                                                "sense_id": "f3149bbe-3b60-34c5-8c56-2f9a377378cd",
                                                "text": "„Die Frauen kochen wie jeden Tag Pap, einen geschmacklosen Maisgrieß.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
