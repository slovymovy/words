        "ru-extract.jsonl": [
            {
                "entry_id": "4cbe424e-97f5-3fd7-a369-eb9f7827d968",
                "word": "поневоле",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c9129040-ae35-348d-b824-c5e5c56dfb59",
                        "entry_id": "4cbe424e-97f5-3fd7-a369-eb9f7827d968",
                        "glosses": [
                            "устар. по принуждению, из-за нужды, необходимости и т. п."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56a92e8d-58e1-439e-a1a7-296688c5e8c2",
                                "sense_id": "c9129040-ae35-348d-b824-c5e5c56dfb59",
                                "text": "В низкое состояние приходит человек иногда поневоле, а подлым становится всегда добровольно."
                            }
                        ]
                    },
                    {
                        "sense_id": "2c394686-05e4-394d-bbb4-ab021e0e91f5",
                        "entry_id": "4cbe424e-97f5-3fd7-a369-eb9f7827d968",
                        "glosses": [
                            "вопреки чьему-либо желанию, независимо от чьего-либо желания"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a44d9489-f877-49ff-bf78-bb9fabdfcd21",
                                "sense_id": "2c394686-05e4-394d-bbb4-ab021e0e91f5",
                                "text": "Ежели можно мне поверить, как человеку, умеющему очень хорошо лгать и в случае нужды говорить поневоле правду."
                            },
                            {
                                "example_id": "45b82c62-470f-463f-a62b-6b08abf3861d",
                                "sense_id": "2c394686-05e4-394d-bbb4-ab021e0e91f5",
                                "text": "Когда одну и ту же страшную историю рассказываешь второй раз на протяжении каких-нибудь двух часов, поневоле начинаешь обнаруживать в ней забавные стороны."
                            },
                            {
                                "example_id": "b66e9258-7c46-4c81-ae12-5fad2581eaa8",
                                "sense_id": "2c394686-05e4-394d-bbb4-ab021e0e91f5",
                                "text": "Но шеф столько рассказывал о тибетской премудрости, что поневоле кое-что запало в голову."
                            },
                            {
                                "example_id": "35172e11-a3fd-44cc-a4f5-8ba17fb73502",
                                "sense_id": "2c394686-05e4-394d-bbb4-ab021e0e91f5",
                                "text": "А постельник и впрямь славный: как заиграет на гуселках ― поневоле, а заслушаешься…"
                            }
                        ]
                    },
                    {
                        "sense_id": "1af3f302-49e4-3580-8e44-b662f4e9f209",
                        "entry_id": "4cbe424e-97f5-3fd7-a369-eb9f7827d968",
                        "glosses": [
                            "употребляется как несогласованное определение"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a23ff983-d5f7-4b04-afca-f6c00ef0a054",
                        "source_entry_id": "4cbe424e-97f5-3fd7-a369-eb9f7827d968",
                        "target_lang_word": "involuntarily",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "involuntarily",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "072a53f4-2a46-3acb-8b4c-9cbfdf81b308",
                                        "entry_id": "1315d253-080d-3acb-bf02-852c79a2b310",
                                        "glosses": [
                                            "In an involuntary manner; done without conscious thought."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61a5c59d-651c-446a-a797-4ad0070ff0bf",
                                                "sense_id": "072a53f4-2a46-3acb-8b4c-9cbfdf81b308",
                                                "text": "Her leg twitched involuntarily."
                                            },
                                            {
                                                "example_id": "59581903-2382-4bd1-98f8-559a0112b0b8",
                                                "sense_id": "072a53f4-2a46-3acb-8b4c-9cbfdf81b308",
                                                "text": "He involuntarily overheard the conversation."
                                            },
                                            {
                                                "example_id": "a5559fe0-e6d3-4289-824a-c0569ed162ad",
                                                "sense_id": "072a53f4-2a46-3acb-8b4c-9cbfdf81b308",
                                                "text": "His eyes filled with tears, as he took up the glittering lengths. Their pale gold was lovely as ever; but there was something in the touch from which he involuntarily recoiled."
                                            },
                                            {
                                                "example_id": "0d204e97-0f65-433a-8d57-b5f9f95f53f1",
                                                "sense_id": "072a53f4-2a46-3acb-8b4c-9cbfdf81b308",
                                                "text": "Kennedy’s vocal rasp is not caused by an infection or respiratory condition. Instead, he has spasmodic dysphonia, a rare neurological condition in which the muscles that open and close his vocal cords spasm involuntarily, creating a strained or strangled quality to his speech."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0e30618e-ccd8-4f9c-97f1-13343f75f5ee",
                        "source_entry_id": "4cbe424e-97f5-3fd7-a369-eb9f7827d968",
                        "target_lang_word": "unfreiwillig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unfreiwillig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8683a664-f6d0-39fa-a0b4-2659654f72bf",
                                        "entry_id": "e0283e94-bfd3-331a-8ab3-ebe99e8b0063",
                                        "glosses": [
                                            "gegen den eigenen Willen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c431aad-2850-455d-9990-0b970875af3e",
                                                "sense_id": "8683a664-f6d0-39fa-a0b4-2659654f72bf",
                                                "text": "„Gestärkt durch dieses Urteil haben die Fahnder jetzt ausgerechnet, wie viel Geld ihnen durch den unfreiwilligen Ruhestand entgangen ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "31bba324-fd1a-3be0-9cce-4b2e680f91d8",
                                        "entry_id": "e0283e94-bfd3-331a-8ab3-ebe99e8b0063",
                                        "glosses": [
                                            "ohne Absicht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "827cd33d-3e77-4e62-9bf8-061b0bc82c7e",
                                                "sense_id": "31bba324-fd1a-3be0-9cce-4b2e680f91d8",
                                                "text": "Da hat er ganz unfreiwillig einen Witz gemacht."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
