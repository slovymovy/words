                                "sense_id": "3887d5f9-6beb-3877-a150-e0e4a68f46aa",
                                "text": "Des conjonctions disjonctives."
                            }
                        ]
                    },
                    {
                        "sense_id": "6677378f-c34d-345f-a48c-628580d0c84a",
                        "entry_id": "a06e6597-2d0b-38c1-8087-a911582b4404",
                        "glosses": [
                            "Qui affirme une alternative."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6dcccb7-0411-44f4-8dc7-3c269998ae78",
                                "sense_id": "6677378f-c34d-345f-a48c-628580d0c84a",
                                "text": "Jugement disjonctif."
                            },
                            {
                                "example_id": "8c7ba52f-bc9e-43ff-9d9b-85871e2d9137",
                                "sense_id": "6677378f-c34d-345f-a48c-628580d0c84a",
                                "text": "Le dilemme est un raisonnement disjonctif."
                            }
                        ]
