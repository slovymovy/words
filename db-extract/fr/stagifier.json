                "senses": [
                    {
                        "sense_id": "64477ebc-1a85-32ff-8123-53617c893e88",
                        "entry_id": "7b09c08a-b07b-3a65-93e1-82e2f2501d8e",
                        "glosses": [
                            "Donner un caractère fondé sur les stages à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cfd64cb-cba3-43ad-8cb8-8ec30c2d09ea",
                                "sense_id": "64477ebc-1a85-32ff-8123-53617c893e88",
                                "text": "Pour reprendre un néologisme qui a eu beaucoup de succès dans les milieux de formation, attention à ne pas « stagifier » le développement des compétences."
                            },
                            {
                                "example_id": "271af82d-a578-440a-a310-d0175ad75b42",
                                "sense_id": "64477ebc-1a85-32ff-8123-53617c893e88",
                                "text": "On peut y voir un effet de la loi de 1971, qui a sans doute eu pour effet de « stagifier » la formation professionnelle dans notre pays."
                            }
                        ]
                    }
