                    "sense_definition": "iemand opzettelijk misleiden of oplichten",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bedrog",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De verkoper probeerde de klant te <w>bedonderen</w> met een kapot product.",
                            "target_lang_translations": {
                                "en": "The salesperson tried to <w>cheat</w> the customer with a broken product."
                            }
                        },
                        {
                            "text": "Hij voelde zich zwaar <w>bedonderd</w> door zijn eigen zakenpartner.",
                            "target_lang_translations": {
                                "en": "He felt severely <w>swindled</w> by his own business partner."
                            }
                        }
                    ],
                    "synonyms": [
                        "bedriegen",
                        "belazeren"
                    ],
                    "common_phrases": [
                        "de boel bedonderen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informeel taalgebruik"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To intentionally deceive or defraud someone, often for financial gain."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cheat",
                                "target_lang_sense_clarification": "To deceive or trick someone to gain an unfair advantage."
                            },
                            {
                                "target_lang_word": "swindle",
                                "target_lang_sense_clarification": "To obtain money or property from someone through fraudulent means."
                            },
                            {
                                "target_lang_word": "defraud",
                                "target_lang_sense_clarification": "To illegally obtain money or property from a person."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d8081609-6124-342c-b248-89c25bd0037b",
                    "sense_definition": "iemand in verwarring brengen of verbazen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verwarring",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De vreemde uitspraak van de leraar <w>bedonderde</w> de hele klas.",
                            "target_lang_translations": {
                                "en": "The teacher's strange statement <w>baffled</w> the entire class."
                            }
                        },
                        {
                            "text": "Ik raakte volledig <w>bedonderd</w> door de complexe instructies van het apparaat.",
                            "target_lang_translations": {
                                "en": "I became completely <w>confused</w> by the device's complex instructions."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informeel taalgebruik"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To cause someone to feel confused, bewildered, or surprised."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "baffle",
                                "target_lang_sense_clarification": "To completely bewilder or perplex someone."
                            },
                            {
                                "target_lang_word": "confuse",
                                "target_lang_sense_clarification": "To make someone unable to think clearly or understand something."
                            },
                            {
                                "target_lang_word": "bewilder",
                                "target_lang_sense_clarification": "To cause someone to become perplexed and confused."
                            }
                        ]
                    }
                }
            ]
