{
    "word_family": [
        "treasure",
        "treasurer",
        "treasurership"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2d906e85-8aca-3ff6-a76a-5f60617ed3c1",
                    "sense_definition": "A place where treasure or valuable items are stored safely.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "storage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient king built a hidden <w>treasury</w> deep within the mountains to protect his gold.",
                            "target_lang_translations": {
                                "ru": "Древний царь построил глубоко в горах скрытую <w>сокровищницу</w>, чтобы защитить свое золото."
                            }
                        },
                        {
                            "text": "Explorers discovered a royal <w>treasury</w> filled with jewels and ancient artifacts.",
                            "target_lang_translations": {
                                "ru": "Исследователи обнаружили королевскую <w>сокровищницу</w>, полную драгоценностей и древних артефактов."
                            }
                        }
                    ],
                    "common_phrases": [
                        "royal treasury",
                        "ancient treasury"
                    ],
                    "target_lang_definitions": {
                        "ru": "Место, где в безопасности хранятся сокровища или ценные предметы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сокровищница",
                                "target_lang_sense_clarification": "место хранения сокровищ"
                            },
                            {
                                "target_lang_word": "казна",
                                "target_lang_sense_clarification": "место хранения государственных или монарших ценностей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "265d2920-345f-3577-97c9-e9838b3562c2",
                    "sense_definition": "A collection of artistic, musical, or literary works.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "collection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This book is a <w>treasury</w> of children's verse that has been loved for generations.",
                            "target_lang_translations": {
                                "ru": "Эта книга — настоящая <w>сокровищница</w> детских стихов, любимых многими поколениями."
                            }
                        },
                        {
                            "text": "The museum serves as a <w>treasury</w> of folk art from across the country.",
                            "target_lang_translations": {
                                "ru": "Музей служит <w>сокровищницей</w> народного искусства со всей страны."
                            }
                        }
                    ],
                    "common_phrases": [
                        "treasury of verse",
                        "literary treasury"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used metaphorically for books or collections"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Собрание художественных, музыкальных или литературных произведений."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сокровищница",
                                "target_lang_sense_clarification": "переносное значение, собрание ценных произведений"
                            },
                            {
                                "target_lang_word": "антология",
                                "target_lang_sense_clarification": "сборник избранных произведений"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "25b4fd8e-b08c-373e-8bc5-840cd726eaca",
                    "sense_definition": "A government bond or security issued by a national treasury department.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Investors often buy a ten-year <w>treasury</w> when they want a low-risk investment.",
                            "target_lang_translations": {
                                "ru": "Инвесторы часто покупают десятилетние <w>казначейские облигации</w>, когда им нужны инвестиции с низким риском."
                            }
                        },
                        {
                            "text": "The yield on the <w>treasury</w> rose slightly following the latest economic report.",
                            "target_lang_translations": {
                                "ru": "Доходность по <w>казначейским бумагам</w> немного выросла после последнего экономического отчета."
                            }
                        }
                    ],
                    "synonyms": [
                        "treasury bond"
                    ],
                    "common_phrases": [
                        "ten-year treasury",
                        "treasury yield"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "financial context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Государственная облигация или ценная бумага, выпущенная министерством финансов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "казначейская облигация",
                                "target_lang_sense_clarification": "государственная ценная бумага"
                            },
                            {
                                "target_lang_word": "трежерис",
                                "target_lang_sense_clarification": "профессиональный жаргон для гособлигаций США"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "95e13160-367e-3791-bde7-fed90b609022",
                    "sense_definition": "A government department responsible for the collection, management, and expenditure of public revenue.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "government",
                    "name_type": "organization_name",
                    "examples": [
                        {
                            "text": "The <w>Treasury</w> announced new tax measures to help reduce the national debt.",
                            "target_lang_translations": {
                                "ru": "<w>Казначейство</w> объявило о новых налоговых мерах, призванных помочь сократить государственный долг."
                            }
                        },
                        {
                            "text": "Officials from the <w>Treasury</w> met with bank representatives to discuss the new policy.",
                            "target_lang_translations": {
                                "ru": "Чиновники из <w>Министерства финансов</w> встретились с представителями банков для обсуждения новой политики."
                            }
                        }
                    ],
                    "synonyms": [
                        "Exchequer"
                    ],
                    "common_phrases": [
                        "the Treasury",
                        "Treasury department"
                    ],
                    "target_lang_definitions": {
                        "ru": "Государственный департамент, ответственный за сбор, управление и расходование государственных доходов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Казначейство",
                                "target_lang_sense_clarification": "государственный орган"
                            },
                            {
                                "target_lang_word": "Министерство финансов",
                                "target_lang_sense_clarification": "аналог ведомства в РФ и других странах"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}