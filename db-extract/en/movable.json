                "senses": [
                    {
                        "sense_id": "444492ea-ba4a-30e7-8b4f-059d99676f7e",
                        "entry_id": "6d4d7d73-097a-36f5-93d1-4d1f19815415",
                        "glosses": [
                            "Capable of being moved, lifted, carried, drawn, turned, or conveyed, or in any way made to change place or posture; not fixed or stationary."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf4cbbc3-85fa-4d43-a24a-b9c38dbc3eb7",
                                "sense_id": "444492ea-ba4a-30e7-8b4f-059d99676f7e",
                                "text": "The owners had supplied the vessel with a movable derrick for the purpose of raising the gangways of the vessel when in port, in order to discharge cargo."
                            }
                        ]
                    },
                    {
                        "sense_id": "d0621eb0-8011-3792-a16b-28591816feb6",
                        "entry_id": "6d4d7d73-097a-36f5-93d1-4d1f19815415",
                        "glosses": [
                            "Changing from one time to another."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dba4ae5a-cf16-4089-9a6d-8d0d0707fe82",
                                "sense_id": "d0621eb0-8011-3792-a16b-28591816feb6",
                                "text": "This feast is movable - its date varies from year to year."
                            }
                        ]
                    }
                ],
