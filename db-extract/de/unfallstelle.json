                "senses": [
                    {
                        "sense_id": "4e5794c2-05d7-3cb7-8afe-1ed4cedee369",
                        "entry_id": "c393c583-59ef-360f-a835-0a88d0beabab",
                        "glosses": [
                            "Lieu de l'accident."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e0c3cf0-38bd-42b9-8e18-c356bcf09eea",
                                "sense_id": "4e5794c2-05d7-3cb7-8afe-1ed4cedee369",
                                "text": "Der Ersthelfer versorgte die Wunden des verunglückten Motorradfahrers, während sich der Notarzt auf dem Weg zur Unfallstelle befand.",
                                "translation": "Le secouriste a soigné les blessures du motocycliste accidenté pendant que le médecin urgentiste était en route au lieu de l'accident."
                            },
                            {
                                "example_id": "2dd9e885-1c37-4fef-b3b1-b23cd8bbf34c",
                                "sense_id": "4e5794c2-05d7-3cb7-8afe-1ed4cedee369",
                                "text": "Rettungskräfte versuchten, die Frau wiederzubeleben, sie starb allerdings noch an der Unfallstelle."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
