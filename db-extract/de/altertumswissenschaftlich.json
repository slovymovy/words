                ],
                "senses": [
                    {
                        "sense_id": "c117e60b-2f08-307b-9468-82858b4686da",
                        "entry_id": "68d7b013-504d-351b-8d41-fd21923e3373",
                        "glosses": [
                            "die Altertumswissenschaft betreffend; in der Art der Altertumswissenschaft vorgehend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e8150c0-ed35-43c0-9500-78a9270b1e4b",
                                "sense_id": "c117e60b-2f08-307b-9468-82858b4686da",
                                "text": "„Das Unternehmen richtet sich in seiner Ausführlichkeit zwar primär an die Fachgelehrten der altertumswissenschaftlichen und benachbarten Disziplinen.“"
                            },
                            {
                                "example_id": "13dea948-0153-4800-b76f-cdeab9484682",
                                "sense_id": "c117e60b-2f08-307b-9468-82858b4686da",
                                "text": "„Die traditionellen Wahrnehmungsmuster der beiden bekanntesten griechischen Stadtstaaten sind durch die altertumswissenschaftliche Forschung der letzten Jahrzehnte in vielfacher Hinsicht revidiert worden.“"
                            },
                            {
                                "example_id": "ce53bd2c-38e5-427e-992e-48ef5df50cc3",
                                "sense_id": "c117e60b-2f08-307b-9468-82858b4686da",
                                "text": "„Er verließ die Schule, als ihr nationalsozialistischer Stil für ihn nicht mehr tragbar war, und ging als Assistent und Lehrbeauftragter an das altertumswissenschaftliche Institut der Universität Freiburg.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
