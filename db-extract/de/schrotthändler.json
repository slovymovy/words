                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be6f2b7e-27e9-44c2-930e-ed6f2965c02d",
                                                "sense_id": "8ead6f14-2501-306e-95e1-ad4653249717",
                                                "text": "Donor locomotives are chosen on account of what works. A locomotive may have been stored for many years, or in the case of 56128 even been sold to a scrap merchant."
                                            }
                                        ]
