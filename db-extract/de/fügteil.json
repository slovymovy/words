                        "glosses": [
                            "traditioneller Begriff für die Wortarten Konjunktion, Subjunktion und Präposition. Sie können Syntagmen zusammenfügen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd63261f-260f-48a6-980d-4f1904d929bd",
                                "sense_id": "be73a544-3355-385c-9cd4-230eb3eddc96",
                                "text": "In \"Hans und Inge spielen Ball\" ist \"und\" ein Fügteil."
                            },
                            {
                                "example_id": "0d8a7534-26d6-4a7e-aafc-98a1571b04b3",
                                "sense_id": "be73a544-3355-385c-9cd4-230eb3eddc96",
                                "text": "„Fügteil: a) nebenordnend / koordinierend / parataktisch, d. h. Wörter bzw. Wortgruppen oder Sätze nebenordnend (‘Konjunktionen’) b) unterordnend / subordinierend / hypotaktisch: entweder Sätze unterordnend, somit ohne Kasusrektion (‘Subjunktionen’) oder Wörter bzw. Wortgruppen unterordnend, daher mit Kasusrektion (‘Präpositionen’).“"
                            }
                        ],
