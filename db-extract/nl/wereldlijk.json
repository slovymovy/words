                        "source_sense_id": "fcbde8b5-e246-38cd-bd66-9fefcb2565b5",
                        "source_sense_description": "betrekking hebbend op deze wereld, in tegenstelling tot met name het hiernamaals of de kerk",
                        "target_lang_word": "secular",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "secular",
