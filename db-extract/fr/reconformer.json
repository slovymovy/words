                ],
                "senses": [
                    {
                        "sense_id": "e3f29ccc-7c54-3f5a-b25b-811c62427c57",
                        "entry_id": "07e390ee-1e49-3050-882a-9b226d4c5353",
                        "glosses": [
                            "Conformer à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2ca0ea1-7878-410b-9ace-d4e3a7a1c8c7",
                                "sense_id": "e3f29ccc-7c54-3f5a-b25b-811c62427c57",
                                "text": "Nous avons conformé et reconformé chaque bobine un grand nombre de fois sans jamais perdre les dernières mises à jour des plans."
                            },
                            {
                                "example_id": "e4541ee2-c30c-44ba-8631-144cc80c77ad",
                                "sense_id": "e3f29ccc-7c54-3f5a-b25b-811c62427c57",
                                "text": "L’individu est délié, affranchi de contraintes anciennes, proches ou disposant d’agents proches, mais invité à se couler un peu plus loin dans des filières de comportement social et idéologique en nombre restreint, à se déconformer pour se reconformer."
                            }
                        ]
                    }
