                            "text": "Die auf den Boden gefallenen Birnen beginnen langsam zu <w>faulen</w>.",
                            "target_lang_translations": {
                                "en": "The pears that fell to the ground are slowly beginning to <w>rot</w>.",
                                "ru": "Упавшие на землю груши медленно начинают <w>гнить</w>.",
                                "nl": "De op de grond gevallen peren beginnen langzaam te <w>rotten</w>.",
                                "pl": "Gruszki, które spadły na ziemię, powoli zaczynają <w>gnić</w>.",
                                "fr": "Les poires tombées par terre commencent lentement à <w>pourrir</w>.",
                                "it": "Le pere cadute a terra iniziano lentamente a <w>marcire</w>.",
                                "cs": "Hrušky spadané na zem začínají pomalu <w>hnít</w>.",
                                "tr": "Yere düşen armutlar yavaş yavaş <w>çürümeye</w> başlıyor.",
                                "es": "Las peras caídas al suelo empiezan lentamente a <w>pudrirse</w>.",
                                "zh": "掉在地上的梨开始慢慢<w>腐烂</w>。"
                            }
                        },
                        {
                            "text": "Das feuchte Holz lag monatelang im Wald und <w>faulte</w> vor sich hin.",
                            "target_lang_translations": {
                                "en": "The damp wood lay in the forest for months and quietly <w>rotted</w> away.",
                                "ru": "Влажное дерево месяцами лежало в лесу и потихоньку <w>гнило</w>.",
                                "nl": "Het vochtige hout lag maandenlang in het bos en <w>rotte</w> langzaam weg.",
                                "pl": "Wilgotne drewno leżało miesiącami w lesie i powoli <w>gniło</w>.",
                                "fr": "Le bois humide est resté pendant des mois dans la forêt et a doucement <w>pourri</w>.",
                                "it": "Il legno umido è rimasto per mesi nel bosco e <w>marciva</w> pian piano.",
                                "cs": "Vlhké dřevo leželo celé měsíce v lese a pomalu <w>hnilo</w>.",
                                "tr": "Nemli odun aylarca ormanda kaldı ve için için <w>çürüdü</w>.",
                                "es": "La madera húmeda estuvo meses en el bosque y se <w>pudría</w> poco a poco.",
                                "zh": "潮湿的木头在森林里放了几个月，悄悄地<w>腐烂</w>了。"
                            }
                        }
