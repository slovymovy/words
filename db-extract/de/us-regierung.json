                "senses": [
                    {
                        "sense_id": "89b58227-c463-3090-b17d-2a2d7a9ffef9",
                        "entry_id": "339f8165-6531-3925-a01b-a606d90f7367",
                        "glosses": [
                            "die Regierung der Vereinigten Staaten von Amerika (USA)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aba5221d-ede1-4eab-af60-0553e0027023",
                                "sense_id": "89b58227-c463-3090-b17d-2a2d7a9ffef9",
                                "text": "Die US-Regierung hatte viele folgenschwere Entscheidungen zu treffen."
                            },
                            {
                                "example_id": "0422a428-6d95-4367-a967-ddc99cb8cf61",
                                "sense_id": "89b58227-c463-3090-b17d-2a2d7a9ffef9",
                                "text": "„Die US-Regierung wollte ihre eigene Wirtschaft schützen und vertraute hinsichtlich des Absatzes auf die Größe des eigenen Marktes und die Exportmöglichkeiten.“"
                            },
                            {
                                "example_id": "8df257c2-0f50-43c9-ad34-bd5ce7cd75c7",
                                "sense_id": "89b58227-c463-3090-b17d-2a2d7a9ffef9",
                                "text": "„Vielleicht sollte ich der US-Regierung noch eine Nachricht schicken und sie darauf aufmerksam machen.“"
                            },
                            {
                                "example_id": "9b2df3e6-d764-450c-9d2f-3ecc75d323c2",
                                "sense_id": "89b58227-c463-3090-b17d-2a2d7a9ffef9",
                                "text": "„Die Proteste gegen die Migrationspolitik der US-Regierung weiten sich auf weitere Städte aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
