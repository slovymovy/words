{
    "word_family": [
        "anticonformisme",
        "anticonformiste",
        "conformément",
        "conformer",
        "conformisme",
        "conformiste",
        "conformité"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d5e50f2b-638c-3a2e-bf52-90fdbc12fc12",
                    "sense_definition": "Qui est exactement semblable ou identique à un modèle ou à un original.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "ressemblance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La secrétaire a certifié que cette copie était bien <w>conforme</w> à l'original présenté."
                        },
                        {
                            "text": "Ce document n'était pas tout à fait <w>conforme</w> aux papiers officiels de la préfecture."
                        }
                    ],
                    "synonyms": [
                        "identique",
                        "semblable"
                    ],
                    "antonyms": [
                        "différent"
                    ],
                    "common_phrases": [
                        "copie conforme",
                        "conforme à l'original"
                    ]
                },
                {
                    "sense_id": "71e09b68-3d0b-3a11-b002-8d694d2221e2",
                    "sense_definition": "Qui respecte une norme, un standard technique ou les exigences de la loi.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "norme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'installation électrique de cette maison ancienne n'est plus <w>conforme</w> aux normes de sécurité."
                        },
                        {
                            "text": "L'entreprise garantit que ses produits sont strictement <w>conformes</w> à la réglementation en vigueur."
                        }
                    ],
                    "synonyms": [
                        "réglementaire"
                    ],
                    "antonyms": [
                        "non conforme"
                    ],
                    "common_phrases": [
                        "conforme aux normes",
                        "conforme à la réglementation",
                        "conforme à la loi"
                    ]
                },
                {
                    "sense_id": "9fb1ba0f-34ab-32e5-9292-0b08b716befa",
                    "sense_definition": "Qui s'accorde bien avec quelque chose, qui lui correspond logiquement ou moralement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "accord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les résultats du trimestre sont parfaitement <w>conformes</w> aux attentes des analystes financiers."
                        },
                        {
                            "text": "Son attitude calme dans cette situation difficile était tout à fait <w>conforme</w> à son caractère habituel."
                        }
                    ],
                    "synonyms": [
                        "adéquat",
                        "approprié",
                        "concordant"
                    ],
                    "antonyms": [
                        "contraire",
                        "incompatible"
                    ],
                    "common_phrases": [
                        "conforme aux attentes",
                        "conforme aux prévisions"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f75e8507-a026-3559-ae7c-10b042a3efb6",
                    "sense_definition": "Première ou troisième personne du singulier de l'indicatif présent ou du subjonctif présent de <w>conformer</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "conjugaison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je <w>conforme</w> toujours mes décisions aux directives de la direction afin d'éviter les erreurs."
                        },
                        {
                            "text": "Il faut qu'il <w>conforme</w> sa méthode de travail aux exigences du projet."
                        }
                    ]
                },
                {
                    "sense_id": "6389f6d2-a5bf-3619-ad30-d65ef71ebef2",
                    "sense_definition": "Deuxième personne du singulier de l'impératif présent de <w>conformer</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "conjugaison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Conforme</w> sans attendre ton travail aux recommandations du professeur pour obtenir une bonne note."
                        },
                        {
                            "text": "<w>Conforme</w> tes actions à tes promesses si tu veux conserver la confiance de tes amis."
                        }
                    ]
                }
            ]
        }
    ]
}