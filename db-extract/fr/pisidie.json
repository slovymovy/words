            {
                "entry_id": "a7f99c7b-b9fe-3c09-8997-4ba559ccf13c",
                "word": "pisidie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1a138834-7dfb-436e-98be-997dee87b9f7",
                        "entry_id": "a7f99c7b-b9fe-3c09-8997-4ba559ccf13c",
                        "tags": [
                            "plural"
                        ],
                        "form": "pisidies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "477595b7-b2d4-3cbe-8118-95cb71a3d3b5",
                        "entry_id": "a7f99c7b-b9fe-3c09-8997-4ba559ccf13c",
                        "glosses": [
                            "Genre de très petits bivalves d’eau douce (moins d’un centimètre)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "809b44f5-8836-4ea3-b283-70260900a268",
                                "sense_id": "477595b7-b2d4-3cbe-8118-95cb71a3d3b5",
                                "text": "Les Pisidies sont les plus petits bivalves fluviatiles de la France. On les trouve dans les canaux, les fossés, les bassins, à la base des plantes aquatiques, souvent au milieu du chevelu des radicelles."
                            },
                            {
                                "example_id": "0e71f036-f0ea-4fff-aacd-a3ce9c0c1530",
                                "sense_id": "477595b7-b2d4-3cbe-8118-95cb71a3d3b5",
                                "text": "Prfois, les rhizomes des Menyanthes forment par leur intrication des surplombs plus ou moins flottants qui retiennent la vase et par conséquent abritent des Pisidies."
                            },
                            {
                                "example_id": "e56f301d-0b7f-4686-ab99-bec45892cb79",
                                "sense_id": "477595b7-b2d4-3cbe-8118-95cb71a3d3b5",
                                "text": "Cette Pisidie ne porte pas de nom scientifique français et nous proposons ici de la nommer Pisidie ténébreuse en référence à son mode de vie en partie dans les eaux interstitielles."
                            }
                        ]
                    }
                ],
