                        "form": "die Bachhubers"
                    },
                    {
                        "form_id": "2b9b81f3-a723-4be1-889f-25caefb6f08a",
                        "entry_id": "16eab531-c72c-3e41-8a37-a95fbe513372",
                        "tags": [
                            "accusative",
