                {
                    "sense_id": "1e5e1848-cf35-38a2-867d-c335ecc78cfc",
                    "sense_definition": "Rediriger une communication, un appel téléphonique ou un message vers un autre destinataire.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La secrétaire va <w>transférer</w> votre appel vers le responsable du service technique.",
                            "target_lang_translations": {
                                "en": "The secretary will <w>transfer</w> your call to the manager of the technical department.",
                                "ru": "Секретарь <w>переведёт</w> ваш звонок к руководителю технического отдела.",
                                "de": "Die Sekretärin wird Ihren Anruf an den Leiter der technischen Abteilung <w>weiterverbinden</w>.",
                                "es": "La secretaria va a <w>pasar</w> su llamada al responsable del servicio técnico.",
                                "zh": "秘书会把您的电话<w>转接</w>给技术部门负责人。"
                            }
                        },
                        {
                            "text": "Pouvez-vous me <w>transférer</w> le courriel que vous avez reçu ce matin ?",
                            "target_lang_translations": {
                                "en": "Could you <w>forward</w> me the email you received this morning?",
                                "ru": "Не могли бы вы <w>переслать</w> мне электронное письмо, которое получили сегодня утром?",
                                "de": "Könnten Sie mir die E-Mail, die Sie heute Morgen erhalten haben, <w>weiterleiten</w>?",
                                "es": "¿Me podría <w>reenviar</w> el correo electrónico que recibió esta mañana?",
                                "zh": "您能把您今天早上收到的那封电子邮件<w>转发</w>给我吗？"
                            }
                        }
                    ],
                    "synonyms": [
                        "rediriger",
                        "renvoyer"
                    ],
                    "common_phrases": [
                        "transférer un appel",
                        "transférer un message",
                        "transférer un courriel"
