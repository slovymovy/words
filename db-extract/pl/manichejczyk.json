                    },
                    {
                        "translation_id": "305cfbb4-638a-4781-8367-695fe7a9231d",
                        "source_entry_id": "807d76eb-79be-389c-bc19-d236784b74eb",
                        "source_sense_id": "632da45c-08e1-3726-bb53-fda932605438",
                        "target_lang_word": "manichéen",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "manichéen",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e0fb47c4-80a0-38c2-a064-9f91635e0707",
                                        "entry_id": "15910ef6-f2bf-3c1f-88ce-997d734f4eaf",
                                        "glosses": [
                                            "Relatif au manichéisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a543c7a-0505-4033-b0c5-891d91b97666",
                                                "sense_id": "e0fb47c4-80a0-38c2-a064-9f91635e0707",
                                                "text": "Le dogme fondamental de toutes les sectes manichéennes, c’est la nature divine ou angélique de l’âme, prisonnière des formes créées et de la nuit de la matière."
                                            },
                                            {
                                                "example_id": "9515d371-2486-476e-8e72-e5fa30543076",
                                                "sense_id": "e0fb47c4-80a0-38c2-a064-9f91635e0707",
                                                "text": "La renaissance d’un certain patriotisme de clocher se traduisit par la prolifération des sectes manichéennes et millénaristes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aaa3b1a8-f30c-397a-9a8c-cd79784303d4",
                                        "entry_id": "15910ef6-f2bf-3c1f-88ce-997d734f4eaf",
                                        "glosses": [
                                            "Relatif aux dualistes bogomiles, dont les cathares."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af9a9f04-7012-4ed6-ad1d-1fe38ae1fa60",
                                                "sense_id": "aaa3b1a8-f30c-397a-9a8c-cd79784303d4",
                                                "text": "Dans ce document on lit : « L’ennemi rusé (le démon) a semé l’hérésie manichéenne dans la Bulgarie, hérésie du pope Bogomile, qui, sous Pierre, tsar de Bulgarie, adopta cette hérésie manichéenne, et la répandit dans la Bulgarie, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53ad44fa-3c9e-34d4-9427-54eb0631825f",
                                        "entry_id": "15910ef6-f2bf-3c1f-88ce-997d734f4eaf",
                                        "glosses": [
                                            "Qui analyse tout situation en séparant sans nuance les idées et les protagonistes entre un camp du Bien et un camp du Mal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50d17846-675e-4618-bf9a-840216d926eb",
                                                "sense_id": "53ad44fa-3c9e-34d4-9427-54eb0631825f",
                                                "text": "La conception coranique de la politique n’est pas irénique. Elle est d’affrontement, ou plutôt manichéenne, met l’accent sur la rectitude opposée à l’erreur et sur un affrontement armé entre les deux."
                                            },
                                            {
                                                "example_id": "6b93f28a-b30b-44ee-86ec-53747204a09f",
                                                "sense_id": "53ad44fa-3c9e-34d4-9427-54eb0631825f",
                                                "text": "Dans ce même ordre d’idées (les conspirationnistes étant surtout des Américains), on pourrait avancer qu’ils ont tendance à classer les gens de façon manichéenne en « bons » ou en « méchants »."
                                            },
                                            {
                                                "example_id": "e42f5172-7a3b-4e70-96e2-ec899e86d501",
                                                "sense_id": "53ad44fa-3c9e-34d4-9427-54eb0631825f",
                                                "text": "Dans le monde manichéen d'Eurabia, le communisme a été remplacé par l'islam comme ennemi civilisationnel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebfe08e7-5213-399c-b628-8c5933bf4bf1",
                                        "entry_id": "15910ef6-f2bf-3c1f-88ce-997d734f4eaf",
                                        "glosses": [
                                            "Relatif au manichéen (alphabet consonantique)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "manichéen",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "faaa90ef-7905-3d8a-bfc4-8d3bf0019c5e",
                                        "entry_id": "e7ecb21c-5743-3bfa-8269-c49176cd1639",
                                        "glosses": [
                                            "Celui ou celle qui adopte la doctrine de Manès, qui admet deux principes, le bien qui est la lumière et le mal qui est les ténèbres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d86f86a-7c5a-4186-ad98-ca6131192d0d",
                                                "sense_id": "faaa90ef-7905-3d8a-bfc4-8d3bf0019c5e",
                                                "text": "Pour les manichéens, deux principes s’opposent : la Lumière et la Matière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d070b6ba-375b-3235-ad5d-9042ef77b1b4",
                                        "entry_id": "e7ecb21c-5743-3bfa-8269-c49176cd1639",
                                        "glosses": [
                                            "Nom donné aux dualistes bogomiles, dont les cathares."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ac0eb02f-0940-3037-a6d4-d02f6e690d82",
                                        "entry_id": "e7ecb21c-5743-3bfa-8269-c49176cd1639",
                                        "glosses": [
                                            "Celui ou celle qui analyse les rapports sociaux ou politiques selon un schéma « Le Bien contre Le Mal »."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "760bd238-d5c6-4176-a796-6082cb4879e0",
                                                "sense_id": "ac0eb02f-0940-3037-a6d4-d02f6e690d82",
                                                "text": "Le manichéen est généralement fidèle au principe de non-contradiction mais incapable de voir celles qui l’habitent. Pour lui, le débat est sérieux : il est impératif d’instaurer l’utopie sur terre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8dda947-ca6f-3caf-a71c-bfa4b98c6a4c",
                                        "entry_id": "e7ecb21c-5743-3bfa-8269-c49176cd1639",
                                        "glosses": [
                                            "Alphabet consonantique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61237516-65a9-416f-80a1-9402dc4d65f4",
                                                "sense_id": "f8dda947-ca6f-3caf-a71c-bfa4b98c6a4c",
                                                "text": "Les systèmes d’écriture d’origine sémitique qui ont été utilisés pour écrire le turc sont le runique, le sogdien, le sogdien réformé ou l’ouïgour, le manichéen et l’écriture arabe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "97c3f928-a45d-435d-947a-eecec0ab5ab1",
                        "source_entry_id": "807d76eb-79be-389c-bc19-d236784b74eb",
                        "source_sense_id": "632da45c-08e1-3726-bb53-fda932605438",
                        "target_lang_word": "Manichäer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "0686e2fe-839a-49a2-a738-f6fa9dbf12ed",
                        "source_entry_id": "807d76eb-79be-389c-bc19-d236784b74eb",
                        "source_sense_id": "632da45c-08e1-3726-bb53-fda932605438",
                        "target_lang_word": "манихеец",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "манихеец",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "fa30b854-3c59-300e-b4ef-bf2d079c579e",
                                        "entry_id": "bc88d704-8435-31a4-bd08-868cb8ec94e9",
                                        "glosses": [
                                            "религ. последователь манихейства"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66471834-bcd9-4e8b-a0a4-c78e81f071a8",
                                                "sense_id": "fa30b854-3c59-300e-b4ef-bf2d079c579e",
                                                "text": "Мани установил такие законы, выполнение которых брали на себя только «праведники», т. е. манихейцы святой жизни и аскеты, а именно: предпочтение бедности [богатству], подавление жадности и похоти, удаление от мира и воздержание от мирских благ, непрерывный пост, раздача милостыни в меру возможности, запрещение приобретать что-либо, кроме пищи на один день и одежды на один год, воздержание от плотских сношений, странствование по миру для проповеди и руководства."
                                            },
                                            {
                                                "example_id": "96805314-72d9-45cd-97af-571eb8de72c0",
                                                "sense_id": "fa30b854-3c59-300e-b4ef-bf2d079c579e",
                                                "text": "— Зло — это нечто целенаправленное… — Вы — манихеец! — прервал его старик. — Я — комсомолец! — возразил Андрей, раздражаясь еще больше и чувствуя необыкновенный прилив веры и убежденности."
                                            },
                                            {
                                                "example_id": "6586e7d2-ca09-4114-a4cd-5719a70385f6",
                                                "sense_id": "fa30b854-3c59-300e-b4ef-bf2d079c579e",
                                                "text": "Наконец, в раннем исламе с его идеей «цепи пророков», последним из которых является Мухаммед, можно увидеть и черты гностической ереси: именно такую идею провозглашала известная гностическая секта манихейцев."
                                            }
                                        ]
