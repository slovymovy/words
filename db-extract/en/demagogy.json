                                        "entry_id": "17ba9ebe-ff62-38e6-a1fb-e12885f067d8",
                                        "glosses": [
                                            "het ophitsen van de massa door leugenachtige voorstellingen meestal met een politieke bedoeling"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0ffaf4a-9015-4f33-b3c7-6edf5ec1b5ad",
                                                "sense_id": "c58176e5-2637-3b8e-89c8-fb1a19a60c3c",
                                                "text": "Zij weten, dank zij de ervaringen van de heren Goebbels en consorten, dat geen dwaasheid te dom en geen demagogie te grof kan zijn om onaanvaardbaar te wezen voor de massa."
                                            }
