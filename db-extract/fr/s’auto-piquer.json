                "senses": [
                    {
                        "sense_id": "12891f08-053b-361a-95bd-28cd97cb892d",
                        "entry_id": "288d209a-da9f-309a-a0fb-bbdb0b980290",
                        "glosses": [
                            "Se piquer soi-même (avec une seringue, ou autrement)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2fa2ab0-5340-4fe1-90f9-8f194ab1ec78",
                                "sense_id": "12891f08-053b-361a-95bd-28cd97cb892d",
                                "text": "Il faut s'auto-piquer avant et après chaque repas (2 heures après) et contrôler sa glycémie."
                            },
                            {
                                "example_id": "ac47a114-1dd7-452a-93fa-643ad3c12245",
                                "sense_id": "12891f08-053b-361a-95bd-28cd97cb892d",
                                "text": "Mais pour d'autres, seulement le fait d'entendre parler de s'auto-piquer les traumatise énormément."
                            },
                            {
                                "example_id": "444da10d-aa42-4b6b-808f-324d6d2acc25",
                                "sense_id": "12891f08-053b-361a-95bd-28cd97cb892d",
                                "text": "Ceci étant, pas folles, les guêpes... elles ne vont pas aussi s'auto-piquer."
                            }
                        ]
                    }
