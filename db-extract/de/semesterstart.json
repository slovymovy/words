                ],
                "senses": [
                    {
                        "sense_id": "da6b9e5e-fecc-3409-a0aa-be6aff621a9d",
                        "entry_id": "3ad891df-3b04-3a0f-ad72-55f39e9f1d27",
                        "glosses": [
                            "Anfang eines Semesters"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1f288a5-6c53-458b-b74e-454196ca1f4d",
                                "sense_id": "da6b9e5e-fecc-3409-a0aa-be6aff621a9d",
                                "text": "„Da ich aber auch nicht zu viel verpassen wollte, habe ich mich entschieden, eine Woche nach dem Semesterstart einzusteigen.“"
                            },
                            {
                                "example_id": "48f3e3e7-cc8c-4f77-aa22-7dc4b06d3785",
                                "sense_id": "da6b9e5e-fecc-3409-a0aa-be6aff621a9d",
                                "text": "„Dazu treffen wir uns kurz vor dem offiziellen Semesterstart am Montagmorgen in einem Bildungszentrum außerhalb der Hochschule mit Übernachtungs- und Verpflegungsmöglichkeit.“"
                            },
                            {
                                "example_id": "a8072dbb-198b-4e22-89aa-568b41fb250d",
                                "sense_id": "da6b9e5e-fecc-3409-a0aa-be6aff621a9d",
                                "text": "„Die Gestaltung von Stundenplänen ist vor jedem Semesterstart grundsätzlich eine administrative Herausforderung, die dies verdeutlicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
