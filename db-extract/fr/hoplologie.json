                "senses": [
                    {
                        "sense_id": "370d56a6-05dd-333f-82fe-e7cef7f33e9f",
                        "entry_id": "b6d5bc28-011f-3a9d-ace2-361d54ef17cb",
                        "glosses": [
                            "Étude historique et technique des armes et de leur maniement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c1d5fe9-73a4-445b-a204-15dd15312cdf",
                                "sense_id": "370d56a6-05dd-333f-82fe-e7cef7f33e9f",
                                "text": "Hier, je me suis baladé au Louvre des Antiquaires où il y a quelques splendides magasins sur les armes anciennes mais j’ai été déçu par le propriétaire de la galerie… il semblait nul en hoplologie, ne pas du tout apprécier ni connaître ce qu’il vendait."
                            }
                        ]
                    },
                    {
                        "sense_id": "a616b0bd-1c37-3a27-943f-5536e0440fab",
                        "entry_id": "b6d5bc28-011f-3a9d-ace2-361d54ef17cb",
                        "glosses": [
                            "Étude du comportement combatif humain."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4775ca8-f54e-43be-b743-d8445d1a59a1",
                                "sense_id": "a616b0bd-1c37-3a27-943f-5536e0440fab",
                                "text": "L’étude de l’évolution du comportement combatif humain (hoplologie), les techniques de combat et les cultures dont elles sont issues sont aussi abordées."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d6d3d551-bf90-4069-bb20-50ad4235eb86",
                        "source_entry_id": "b6d5bc28-011f-3a9d-ace2-361d54ef17cb",
                        "target_lang_word": "hoplology",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hoplology",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c35774c5-c4b3-3f41-b7df-cdfb5f7ea539",
                                        "entry_id": "2733b84b-6e87-3c73-b870-e3514e0abd46",
                                        "glosses": [
                                            "The study of the methods, behaviour, and technology involved in human combat, particularly weapons and armour."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0cc3030d-354c-4ebc-88ff-7bb7ae65bbdd",
                                                "sense_id": "c35774c5-c4b3-3f41-b7df-cdfb5f7ea539",
                                                "text": "Some students of hoplology, the science of l'arme blanche (the sword), in the neighbourhood of my residence have entreated me to invoke the invaluable aid of 'N. & Q.' in matters of archæology to endeavour to trace the missing weapons."
                                            },
                                            {
                                                "example_id": "6bfaace3-8560-4a2e-8175-5e1a865f6be7",
                                                "sense_id": "c35774c5-c4b3-3f41-b7df-cdfb5f7ea539",
                                                "text": "It has often been a public misconception that the words \"martial arts\" refer to something exclusively Asian in nature. But history and hoplology (the science of weaponry and related combative systems) tell us that no race on the face of the earth has ever lacked for fighting techniques, […]"
                                            },
                                            {
                                                "example_id": "2250d3be-4111-4edf-b7ee-b499c115c110",
                                                "sense_id": "c35774c5-c4b3-3f41-b7df-cdfb5f7ea539",
                                                "text": "In his seminal work that made him the doyen of modern hoplology, Sir Richard Burton traces the spread of various arms and armaments of the world to ancient Egypt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
