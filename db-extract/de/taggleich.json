                ],
                "senses": [
                    {
                        "sense_id": "5e6eaaa2-0899-3d2b-90c2-6688586d9a52",
                        "entry_id": "0d13fa66-50a7-320d-a3bb-1590dad494aa",
                        "glosses": [
                            "am selben Tag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6e12259-91ab-46b5-a56e-26986f51ff9e",
                                "sense_id": "5e6eaaa2-0899-3d2b-90c2-6688586d9a52",
                                "text": "„E-Mails werden taggleich beantwortet, papiergebundene Eingangspost wird innerhalb von 2 Tagen bearbeitet.“"
                            },
                            {
                                "example_id": "56d65b2b-f512-43fa-b9ef-b71cfdaceb33",
                                "sense_id": "5e6eaaa2-0899-3d2b-90c2-6688586d9a52",
                                "text": "„Alle betrieblich verursachten Prozesse und Geschäftsfälle werden taggleich erfasst oder im Idealfall online automatisch über Prozessabläufe generiert.“"
                            },
                            {
                                "example_id": "8a5d6e57-2edc-455f-bf1f-212e89044023",
                                "sense_id": "5e6eaaa2-0899-3d2b-90c2-6688586d9a52",
                                "text": "„Eine taggleiche Lieferung ist ebenfalls bei einigen Lieferdiensten möglich.“"
                            },
                            {
                                "example_id": "0e000a9e-6035-4ae7-9375-dd420b950d41",
                                "sense_id": "5e6eaaa2-0899-3d2b-90c2-6688586d9a52",
                                "text": "„Wer seinen Kunden den taggleichen Lieferservice bieten möchte, muss auch in der Lage sein, die bestellten Produkte schnell zu kommissionieren und zu verpacken, denn ab Bestellzeitpunkt tickt die Uhr.“"
                            }
                        ],
