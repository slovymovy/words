                                        "glosses": [
                                            "žena, která cítí a jedná ve prospěch druhých"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5c30a1b-d6ae-46fc-982d-0aeef7f708f9",
                                                "sense_id": "b4672996-78dd-3109-8573-ccaa547216f8",
                                                "text": "Kolegové matku dvou dětí popsali jako nadšenou altruistku, která svůj život zasvětila pomoci ostatním."
                                            }
