                            {
                                "target_word": "fortified",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2c804b1d-154d-34af-8747-c9c5a8f7c727",
                                        "entry_id": "d7293d5c-832e-3c40-a817-df9353bb25cc",
                                        "glosses": [
                                            "A fortified wine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3448f34-0a76-4799-9091-e8afea353b09",
                                                "sense_id": "2c804b1d-154d-34af-8747-c9c5a8f7c727",
                                                "text": "In 1969 output of table wines exceeded that of fortifieds for the first time, and by 1973 more than twice as much table wine as fortified was being produced."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fortified",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "91a32aa7-090e-3252-8dc3-35e0aa206460",
                                        "entry_id": "0bbc9431-3121-341d-af04-18eb8a01ed61",
                                        "glosses": [
                                            "Having strong defenses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d961d183-5661-43c7-8e04-a60f70dfe6e6",
                                                "sense_id": "91a32aa7-090e-3252-8dc3-35e0aa206460",
                                                "text": "Every day he becomes stronger against evil, and more fortified against temptation."
                                            },
                                            {
                                                "example_id": "cb198b1c-273b-40d8-88e4-ac5ac42469b7",
                                                "sense_id": "91a32aa7-090e-3252-8dc3-35e0aa206460",
                                                "text": "Similarly, this material world, the universe, is covered by seven layers, and one layer, the first layer is there, and the second layer is ten times thicker than the first layer. the third layer is ten times thicker than the second layer. In this way, this universe is covered tightly, very fortified."
                                            },
                                            {
                                                "example_id": "d6f145d4-11b9-422d-a674-0ac3bbf5d310",
                                                "sense_id": "91a32aa7-090e-3252-8dc3-35e0aa206460",
                                                "text": "The DMZ was and is very fortified, probably as fortified as any border in the world."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef91dd48-c057-368f-ad07-137b7a779795",
                                        "entry_id": "0bbc9431-3121-341d-af04-18eb8a01ed61",
                                        "glosses": [
                                            "Being enriched with (additional) minerals and vitamins."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a45259d4-e06e-4c7c-9c29-cd76d07ecea0",
                                                "sense_id": "ef91dd48-c057-368f-ad07-137b7a779795",
                                                "text": "Fortified milk is cow’s milk that contains extra vitamins and minerals that are not naturally found in milk in significant amounts. Typically, vitamins D and A are added to milk sold in the United States. However, milk can be fortified with various other nutrients, including zinc, iron, and folic acid."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
