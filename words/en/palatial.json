    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ade3c68e-f7ef-3052-9bf3-0e3939185b2b",
                    "sense_definition": "Resembling a palace in being spacious, luxurious, or magnificent.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The billionaire lives in a <w>palatial</w> mansion overlooking the ocean.",
                            "target_lang_translations": {
                                "ru": "Миллиардер живет в <w>роскошном</w> особняке с видом на океан."
                            }
                        },
                        {
                            "text": "Guests were amazed by the hotel's <w>palatial</w> rooms and ornate decor.",
                            "target_lang_translations": {
                                "ru": "Гости были поражены <w>дворцовыми</w> номерами отеля и витиеватым декором."
                            }
                        }
                    ],
                    "synonyms": [
                        "luxurious",
                        "grand",
                        "opulent",
                        "magnificent",
                        "stately"
                    ],
                    "antonyms": [
                        "cramped",
                        "modest",
                        "humble"
                    ],
                    "common_phrases": [
                        "palatial home",
                        "palatial mansion",
                        "palatial residence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Напоминающий дворец своей просторностью, роскошью или великолепием; роскошный, пышный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "роскошный",
                                "target_lang_sense_clarification": "великолепный, поражающий богатством и убранством"
                            },
                            {
                                "target_lang_word": "дворцовый",
                                "target_lang_sense_clarification": "подобный дворцу по масштабу и убранству"
                            },
                            {
                                "target_lang_word": "пышный",
                                "target_lang_sense_clarification": "богатый, величавый"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d27eba8f-258b-3a9b-bda2-f7d7502df354",
                    "sense_definition": "Of, relating to, or belonging to a palace.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Historians studied the <w>palatial</w> grounds to understand ancient royal architecture.",
                            "target_lang_translations": {
                                "ru": "Историки изучали территорию <w>дворцового</w> комплекса, чтобы понять древнюю королевскую архитектуру."
                            }
                        },
                        {
                            "text": "The museum displayed artifacts excavated from the city's ancient <w>palatial</w> complex.",
                            "target_lang_translations": {
                                "ru": "В музее были выставлены артефакты, найденные при раскопках древнего <w>дворцового</w> комплекса города."
                            }
                        }
                    ],
                    "common_phrases": [
                        "palatial complex",
                        "palatial architecture"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к дворцу, принадлежащий дворцу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дворцовый",
                                "target_lang_sense_clarification": "относящийся ко дворцу или принадлежащий ему"
                            }
                        ]
                    }
                }
            ]
        }
    ]
