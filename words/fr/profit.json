                        "tirer un profit"
                    ]
                },
                {
                    "sense_id": "f12d0586-fc50-34a6-b52c-083eea0ffaa8",
                    "sense_definition": "Avantage ou enrichissement intellectuel et moral tiré d'une lecture, d'une étude ou d'une expérience.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les étudiants ont tiré un grand <w>profit</w> de cette conférence passionnante sur l'histoire."
                        },
                        {
                            "text": "Elle a su mettre à <w>profit</w> son séjour à l'étranger pour perfectionner sa prononciation."
                        }
                    ],
                    "common_phrases": [
