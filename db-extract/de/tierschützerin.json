                        "glosses": [
                            "weibliche Person, die sich im Tierschutz engagiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c9260df-6702-4190-bf66-3d0b64b7405f",
                                "sense_id": "b3b31aec-6fe0-3765-8201-6f609c18fa9d",
                                "text": "Tierschützerinnen fordern schon lange ein Verbot für Tierversuche."
                            },
                            {
                                "example_id": "70366da7-85a1-45b2-aea9-b0c494dbe506",
                                "sense_id": "b3b31aec-6fe0-3765-8201-6f609c18fa9d",
                                "text": "„Vielleicht haben sich Menschen seither fortwährend Gedanken darüber gemacht, wie Tiere gehalten werden sollen. Vereinsmäßig organisierten sich Tierschützer und Tierschützerinnen aber erst im 19. Jahrhundert, die ersten in Österreich 1846 in Wien und 1860 in Graz.“"
                            }
                        ],
