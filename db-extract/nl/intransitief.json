                "senses": [
                    {
                        "sense_id": "dafee603-204a-3e4a-815a-af2c7659e177",
                        "entry_id": "7aef9e86-df54-3d78-8b1c-074b4272b76e",
                        "glosses": [
                            "zonder de mogelijkheid van een lijdend of meewerkend voorwerp"
                        ],
                        "tags": [
                            "van een werkwoord"
                        ],
                        "examples": [
                            {
                                "example_id": "511f30f1-0d69-4aef-ad51-68459deac7ea",
                                "sense_id": "dafee603-204a-3e4a-815a-af2c7659e177",
                                "text": "Het werkwoord 'zieken' is intransitief."
                            },
                            {
                                "example_id": "978140fb-8db3-46bb-830d-ba37f15e1353",
                                "sense_id": "dafee603-204a-3e4a-815a-af2c7659e177",
                                "text": "In 1978 formuleerde Perlmutter, grotendeels zich baserend op observaties van het gedrag van Nederlandse intransitieve werkwoorden, de Unaccusativity Hypothesis. Intransitieve werkwoorden zijn volgens zijn hypothese op te delen in onaccusatieven, ook wel ergatieven (zoals ‘vallen’ en ‘gaan’) en onergatieven (zoals ‘fluiten’ en ‘zingen’).1. Ergatieve werkwoorden hebben in hun onderliggende structuur alleen een direct object, dat in de oppervlaktestructuur is verplaatst naar de subjectspositie"
                            }
                        ]
                    },
                    {
                        "sense_id": "e30913ad-92ca-3df1-8cb6-385bd7f8fdac",
                        "entry_id": "7aef9e86-df54-3d78-8b1c-074b4272b76e",
                        "glosses": [
                            "waarbij als de relatie zowel tussen element 1 en 2 als element 2 en 3 bestaat, die relatie zeker niet tussen 1 en 3 bestaat"
                        ],
                        "tags": [
                            "van relaties tussen twee elementen"
                        ],
                        "examples": [
                            {
                                "example_id": "7f15d443-d183-453c-a5da-960c3555e8fe",
                                "sense_id": "e30913ad-92ca-3df1-8cb6-385bd7f8fdac",
                                "text": "De relatie \"is meer dan twee keer zo groot als\" is intransitief."
                            },
                            {
                                "example_id": "d8ce2451-a8cd-4838-84f2-59e45f62f0f6",
                                "sense_id": "e30913ad-92ca-3df1-8cb6-385bd7f8fdac",
                                "text": "De relatie ‘vader zijn van’ tussen mensen is intransitief."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ce4db1c7-9386-4331-be97-55ea627535d1",
                        "source_entry_id": "7aef9e86-df54-3d78-8b1c-074b4272b76e",
                        "source_sense_id": "dafee603-204a-3e4a-815a-af2c7659e177",
                        "source_sense_description": "zonder de mogelijkheid van een lijdend of meewerkend voorwerp",
                        "target_lang_word": "intransitiv",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intransitiv",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "81389146-d798-3359-88a5-47640b60396c",
                                        "entry_id": "e843c174-9be5-3ef1-b567-c53c0490540d",
                                        "glosses": [
                                            "als Verb kein Akkusativobjekt benötigend und unfähig zum persönlichen Passiv"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "331a8e9a-4b7b-46a1-9a30-888b64be44b7",
                                                "sense_id": "81389146-d798-3359-88a5-47640b60396c",
                                                "text": "Das Wort „beginnen“ kann kontextabhängig sowohl intransitiv als auch transitiv verwendet werden."
                                            },
                                            {
                                                "example_id": "adf25f3c-d1fb-4e08-a252-ccd182d7786d",
                                                "sense_id": "81389146-d798-3359-88a5-47640b60396c",
                                                "text": "Das Verb „rasen“ ist nur intransitiv, weil die Aussage „jemand oder etwas wurde gerast“ keine sinnvolle Passivbildung darstellt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6a010ce3-1405-341e-addc-8ecad1138fb1",
                                        "entry_id": "e843c174-9be5-3ef1-b567-c53c0490540d",
                                        "glosses": [
                                            "aus der Gültigkeit einer Relation zwischen zwei beliebigen Elementen a und b einer Menge und der Gültigkeit dieser Relation für das gleiche Element b und ein drittes Element c nicht unbedingt die Gültigkeit für a und c begründend"
                                        ],
                                        "tags": [
                                            "Mengenlehre"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8fc9e4c5-7372-4516-af62-c8ab0bc5e507",
                                                "sense_id": "6a010ce3-1405-341e-addc-8ecad1138fb1",
                                                "text": "„In gerader Linie verwandt sein“ ist keine transitive, sondern eine intransitive Relation. Söhne sind mit ihrem Vater immer in gerader Linie verwandt, ebenso der Vater mit seinen Söhnen, aber die Söhne untereinander sind es nicht."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "54197d49-9f04-4e9d-af3f-7d82bdf3e109",
                        "source_entry_id": "7aef9e86-df54-3d78-8b1c-074b4272b76e",
                        "source_sense_id": "dafee603-204a-3e4a-815a-af2c7659e177",
                        "source_sense_description": "zonder de mogelijkheid van een lijdend of meewerkend voorwerp",
                        "target_lang_word": "intransitive",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intransitive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "18516d14-8f02-37c7-8636-639b356149ba",
                                        "entry_id": "316ae0c5-ad29-3253-994a-6abcae4ef74e",
                                        "glosses": [
                                            "An intransitive verb."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8af78d2e-dcf1-4142-95bc-c7ef62d4da79",
                                                "sense_id": "18516d14-8f02-37c7-8636-639b356149ba",
                                                "text": "This means that subcategorization properties do not allow us to distinguish between transitives and intransitives (both types of verbs are allowed, but not obliged, to take a direct object)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "intransitive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b957d122-d540-3d03-9c14-04a49ec237c9",
                                        "entry_id": "833b2721-7093-309a-b6a5-0c11f01a9bb0",
                                        "glosses": [
                                            "Not transitive: not having, or not taking, a direct object."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91f9fee4-c8a1-4916-9643-1aebb433f49e",
                                                "sense_id": "b957d122-d540-3d03-9c14-04a49ec237c9",
                                                "text": "The word \"drink\" is a transitive verb in \"they drink wine\", but an intransitive one in \"they drink often.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20d0db14-516f-373f-aece-02810c6f9971",
                                        "entry_id": "833b2721-7093-309a-b6a5-0c11f01a9bb0",
                                        "glosses": [
                                            "Not transitive or passing further; kept; detained."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d60aed16-c268-4879-8fd8-ee3e702a8777",
                                                "sense_id": "20d0db14-516f-373f-aece-02810c6f9971",
                                                "text": "1664-1667, Jeremy Taylor, Dissuasive from Popery\nAnd then it is for the image's sake and so far is intransitive; but whatever is paid more to the image is transitive and passes further."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "885177b5-f292-305e-ac04-bc167557b3ba",
                                        "entry_id": "833b2721-7093-309a-b6a5-0c11f01a9bb0",
                                        "glosses": [
                                            "Of a set of dice: containing three dice A, B, and C, with the property that A rolls higher than B more than half the time, and B rolls higher than C more than half the time, but lacking the property that A rolls higher than C more than half the time. See intransitive dice and intransitive game."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ca1d1287-14de-42e1-bd21-a2cf173e9e84",
                        "source_entry_id": "7aef9e86-df54-3d78-8b1c-074b4272b76e",
                        "source_sense_id": "dafee603-204a-3e4a-815a-af2c7659e177",
