                                "target_senses": [
                                    {
                                        "sense_id": "fb9a7e66-c44d-3269-abd4-f9d6dce92c2c",
                                        "entry_id": "4fea721b-1d34-3fdd-816f-d02dc90793b7",
                                        "glosses": [
                                            "(Cacatuidae) Ave trepadora de Oceanía de la familia de los loros de 80 a 90 cm, de plumaje colorido, generalmente blanco, y un penacho de plumas en la cabeza que levanta cuando está feliz o enojada, puede aprender a imitar palabras."
                                        ],
                                        "tags": [],
                                        "examples": [],
