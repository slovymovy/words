                "senses": [
                    {
                        "sense_id": "84e260b4-3be1-3054-a01f-a4e99ce7dfcd",
                        "entry_id": "54ca2686-c65d-378b-8693-fc83bbc874a7",
                        "glosses": [
                            "Politik, die einen bestimmten örtlich begrenzte Bereich oder Region betrifft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8922ae2-f8d7-4a65-b6bf-5d562d64c101",
                                "sense_id": "84e260b4-3be1-3054-a01f-a4e99ce7dfcd",
                                "text": "„Mit der vernetzten Lokalpolitik geht deshalb für viele auch das Versprechen nach mehr Bürgerbeteiligung einher.“"
                            },
                            {
                                "example_id": "9f49691e-92bc-4d72-8196-71a09837c295",
                                "sense_id": "84e260b4-3be1-3054-a01f-a4e99ce7dfcd",
                                "text": "„Auch die Lokalpolitik differenziert in nützlichen und schädlichen Protest und richtet ihr Handeln an dieser Differenz aus.“"
                            },
                            {
                                "example_id": "53bd84ec-96c4-4575-825e-1a52975e318d",
                                "sense_id": "84e260b4-3be1-3054-a01f-a4e99ce7dfcd",
                                "text": "„Bislang hatte ihn Oxfords Lokalpolitik nicht interessiert.“"
                            },
                            {
                                "example_id": "f8aa1849-02be-4239-a6a8-c777b4954f05",
                                "sense_id": "84e260b4-3be1-3054-a01f-a4e99ce7dfcd",
                                "text": "„Wir bekommen in unserer Arbeit auch meistens die Unterstützung der Lokalpolitik, die sich intensiv für unsere Arbeit interessieren und engagieren.“"
                            },
                            {
                                "example_id": "e6e3387a-7681-4e2d-99a4-598d11a6e3eb",
                                "sense_id": "84e260b4-3be1-3054-a01f-a4e99ce7dfcd",
                                "text": "„In den 60er Jahren waren es nur noch 30,8% gegen die lokalpolitischen … für die Lokalpolitik weniger als für die landesweite Politik interessieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
