    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "53fad281-2033-37af-b724-20a7a2ffda48",
                "word": "Belinda",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9fba1bda-4fc0-35c4-ae7a-bd14958c309f",
                        "entry_id": "53fad281-2033-37af-b724-20a7a2ffda48",
                        "glosses": [
                            "A female given name originating as a coinage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c5500c6-dc9d-42c4-9aad-8c929f457257",
                                "sense_id": "9fba1bda-4fc0-35c4-ae7a-bd14958c309f",
                                "text": "1714 Alexander Pope, The Rape of the Lock, Canto V, final verse,\nThis Lock, the Muse shall consecrate to Fame,\nAnd 'midst the Stars inscribe Belinda’s Name."
                            },
                            {
                                "example_id": "d1b398ce-19bd-4db1-bd5c-6c4b620227a3",
                                "sense_id": "9fba1bda-4fc0-35c4-ae7a-bd14958c309f",
                                "text": "\"Good-by, my dear Belinda; I leave you to ruminate sweet and bitter thoughts; to think of the last speech and confession of Lady Delacour, or, what will interest you much more, the first speech and confession of—Clarence Harvey.\""
                            },
                            {
                                "example_id": "18216ecd-4863-41d4-9e10-4b00af3f9d43",
                                "sense_id": "9fba1bda-4fc0-35c4-ae7a-bd14958c309f",
                                "text": "The fairy tale ended savagely on January 11, 1999, when Belinda’s lifeless body was discovered in a closet. Her skull had been shattered by a shotgun blast at close range."
                            }
                        ]
                    },
                    {
                        "sense_id": "24e0177e-d079-3a14-baed-67508ea690d4",
                        "entry_id": "53fad281-2033-37af-b724-20a7a2ffda48",
                        "glosses": [
                            "The ninth satellite of Uranus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c95f730-86a2-4c0b-a7e3-007cbb63413c",
                                "sense_id": "24e0177e-d079-3a14-baed-67508ea690d4",
                                "text": "This moon's orbit is nearly identical to that of Belinda, about 47,000 miles (75,000 km) from Uranus."
                            },
                            {
                                "example_id": "37ed9b00-1c33-427a-bf79-06983877ff73",
                                "sense_id": "24e0177e-d079-3a14-baed-67508ea690d4",
                                "text": "It belongs to the Portia group, made up of Bianca, Cressida, Desdemona, Juliet, Portia, Rosalind, Cupid, Belinda and Perdita; these satellites have similar orbits and photometric characteristics."
                            },
                            {
                                "example_id": "52921d00-a7a1-4cc5-afe2-f00ad9d207f8",
                                "sense_id": "24e0177e-d079-3a14-baed-67508ea690d4",
                                "text": "Miranda and the more recent discoveries have also been named after Shakespearean characters, with the exception of Belinda (1986 U5), which was named after a character from Pope's “The Rape of the Lock.”"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
