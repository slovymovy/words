                    {
                        "sense_id": "be9f5516-829e-315d-8375-0ad5157838b0",
                        "entry_id": "45e93f4d-8818-39e4-ada4-a2339f37f72b",
                        "glosses": [
                            "Nom vernaculaire de l’ajonc de Provence (Ulex parviflorus)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08259f9a-410c-41fc-bd33-2c7c70d47922",
                                "sense_id": "be9f5516-829e-315d-8375-0ad5157838b0",
                                "text": "Un parc de pins centenaires cernait une immense bâtisse carrée ; elle paraissait inaccessible parce que des genêts épineux (l’« argelas » des collines) poussaient en rangs serrés sous la haute futaie."
                            },
                            {
                                "example_id": "c5ed5e7a-123f-4877-b41c-8f0dac8be98f",
                                "sense_id": "be9f5516-829e-315d-8375-0ad5157838b0",
                                "text": "Dans ce vallon (et d’ailleurs dans les autres aussi), pas de bois fourrés : un petit ruisseau, sec parce qu’on est en juin, et des petits prés de luzerne. Petits : cinq pas de large. Les pentes des vallons, presque rases, de la lavande, du thym et de l’argelas."
                            }
                        ]
                    }
