                            {
                                "example_id": "5119aa99-c9a9-447b-9b47-cb921c054561",
                                "sense_id": "b94fada3-2d63-3ce1-a14f-78d7133f0912",
                                "text": "„Wie alle, die schon als Kinder erwachsen waren, bewahrt er auch noch im Mannesalter in sich ein kindliches Prinzip.“"
                            },
                            {
                                "example_id": "c84639d4-f64b-4516-86a9-e4df1cef97df",
                                "sense_id": "b94fada3-2d63-3ce1-a14f-78d7133f0912",
                                "text": "„Diese Liebhaberei wuchs mit mir heran, und noch im Mannesalter war sie mir eine Hauptquelle meiner Freuden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
