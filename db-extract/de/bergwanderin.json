                "senses": [
                    {
                        "sense_id": "c6207d0e-047f-3e47-a38b-332d9a14cdaa",
                        "entry_id": "748eec62-195d-3bfb-96d0-19adb046877b",
                        "glosses": [
                            "weibliche Person, die eine längere Strecke im Gebirge zu Fuß zurücklegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcc03ff4-3aef-466f-91d5-d0943e82a708",
                                "sense_id": "c6207d0e-047f-3e47-a38b-332d9a14cdaa",
                                "text": "„Als geübte Bergwanderin sollte dies kein Problem für mich sein, doch der Camino hatte so seine Tücken.“"
                            },
                            {
                                "example_id": "8a3977e4-fc61-4366-a658-37db181dc44f",
                                "sense_id": "c6207d0e-047f-3e47-a38b-332d9a14cdaa",
                                "text": "„Außerdem rief er auf der Berghütte an und bat Toni darum, später jemanden auf die ›Kuhalm‹ zu schicken, der die junge Bergwanderin abholt.“"
                            },
                            {
                                "example_id": "cb1a260f-9d3c-492c-991f-a4bb070aa703",
                                "sense_id": "c6207d0e-047f-3e47-a38b-332d9a14cdaa",
                                "text": "„Wer sie jetzt sah, konnte sie für eine Bergwanderin halten, die beim Marterl eine kleine Rast eingelegt hatte.“"
                            },
                            {
                                "example_id": "f1713e16-080e-4e0e-9121-185ac37bb794",
                                "sense_id": "c6207d0e-047f-3e47-a38b-332d9a14cdaa",
                                "text": "„In diesem Moment rief mich Helmut an, um sich zu erkundigen, wie es seiner Frau ginge, die keine besonders erprobte Bergwanderin war.“"
                            },
                            {
                                "example_id": "f832bd46-02ed-4352-9b75-270615294672",
                                "sense_id": "c6207d0e-047f-3e47-a38b-332d9a14cdaa",
                                "text": "„Sie ist eine erfahrene Bergwanderin und wird nicht so blöd sein, hier einfach so an einer Kante herunterzufallen.“"
                            },
                            {
                                "example_id": "0d7eebe8-edfe-45f7-84cd-19497715806d",
                                "sense_id": "c6207d0e-047f-3e47-a38b-332d9a14cdaa",
                                "text": "„Sie war ja in ihrer Jugend und auch später noch eine leidenschaftliche Bergwanderin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
