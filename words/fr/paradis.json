                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'enfant lança le caillou et sauta à cloche-pied jusqu'au <w>paradis</w>."
                        },
                        {
                            "text": "Pour gagner la partie, il faut réussir à atteindre le <w>paradis</w> sans perdre l'équilibre."
                        }
                    ]
                },
                {
                    "sense_id": "0de21805-4be8-3a48-94b4-3ae6076adb6c",
