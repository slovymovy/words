{
    "word_family": [
        "dull",
        "dullness",
        "dullard"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1e3e4054-242f-39a3-8037-152cd23084c0",
                    "sense_definition": "Having lost sharpness, brightness, or intensity.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "state_of_being",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>dulled</w> blade could no longer cut through the thick rope.",
                            "target_lang_translations": {
                                "pl": "<w>Stępione</w> ostrze nie mogło już przeciąć grubej liny."
                            }
                        },
                        {
                            "text": "His <w>dulled</w> senses made it difficult to react quickly to the danger.",
                            "target_lang_translations": {
                                "pl": "Jego <w>przytępione</w> zmysły utrudniały szybką reakcję na niebezpieczeństwo."
                            }
                        }
                    ],
                    "synonyms": [
                        "blunted",
                        "muted",
                        "faded"
                    ],
                    "antonyms": [
                        "sharp",
                        "bright"
                    ],
                    "common_phrases": [
                        "dulled senses",
                        "dulled blade"
                    ],
                    "target_lang_definitions": {
                        "pl": "Pozbawiony ostrości, blasku lub intensywności."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "stępiony",
                                "target_lang_sense_clarification": "o ostrzu lub narzędziu, które straciło ostrość"
                            },
                            {
                                "target_lang_word": "przytępiony",
                                "target_lang_sense_clarification": "o zmysłach lub uczuciach, które stały się mniej wyraziste"
                            },
                            {
                                "target_lang_word": "zmatowiały",
                                "target_lang_sense_clarification": "o powierzchni, która straciła połysk"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ed92f792-83ef-3814-9862-8e8789216853",
                    "sense_definition": "Simple past and past participle of <w>dull</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant rain <w>dulled</w> the vibrant colors of the garden.",
                            "target_lang_translations": {
                                "pl": "Ciągły deszcz <w>przytępił</w> żywe kolory ogrodu."
                            }
                        },
                        {
                            "text": "The medicine <w>dulled</w> the sharp pain in his leg.",
                            "target_lang_translations": {
                                "pl": "Lekarstwo <w>przytępiło</w> ostry ból w jego nodze."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Czas przeszły i imiesłów bierny od czasownika 'dull' (stępić, przytępić, osłabić)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "stępił",
                                "target_lang_sense_clarification": "sprawił, że coś przestało być ostre"
                            },
                            {
                                "target_lang_word": "przytępił",
                                "target_lang_sense_clarification": "osłabił intensywność bólu, zmysłów lub kolorów"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}