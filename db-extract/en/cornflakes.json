                                "target_senses": [
                                    {
                                        "sense_id": "41eb1961-051b-3be9-9ad2-a9a823d2a7f2",
                                        "entry_id": "15f0cd09-dc86-3f30-86d5-b92cab6763ec",
                                        "glosses": [
                                            "кукурузные хлопья"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c65310a9-afa8-4b85-a68b-ebfca0c40599",
                                                "sense_id": "41eb1961-051b-3be9-9ad2-a9a823d2a7f2",
                                                "text": "Бедная Дания: молоко, корнфлекс, кефир, йогурт, яйца, масло, ветчина, кофе."
                                            },
                                            {
                                                "example_id": "d4b93240-01c2-4d83-a26d-eb97e6426317",
                                                "sense_id": "41eb1961-051b-3be9-9ad2-a9a823d2a7f2",
                                                "text": "Президент попробовал немного корнфлекса и (я думаю) несколько фиг, затем съел бифштекс и желе."
                                            },
                                            {
                                                "example_id": "78f376c0-cfb2-4433-8dd2-ba292d2ae828",
                                                "sense_id": "41eb1961-051b-3be9-9ad2-a9a823d2a7f2",
                                                "text": "Лизавета взяла пиалу с корнфлексом, отчего ей снова вспомнился Лондон."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
