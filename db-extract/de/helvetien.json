                "senses": [
                    {
                        "sense_id": "6644b96b-7f1d-32cd-8511-d77edf6f8c07",
                        "entry_id": "08fe2b76-0bfe-37d1-9e77-769a94426116",
                        "glosses": [
                            "das Siedlungsgebiet der Helvetier, eines keltischen Volkes; die Schweiz zur vorrömischen und römischen Zeit"
                        ],
                        "tags": [
                            "archaic",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "05f3a29c-1741-4c02-9a84-3906a93cc90d",
                                "sense_id": "6644b96b-7f1d-32cd-8511-d77edf6f8c07",
                                "text": "„Helvetien unter den Römern.“"
                            },
                            {
                                "example_id": "e5a99a26-3239-43e8-be71-a5ae525d5747",
                                "sense_id": "6644b96b-7f1d-32cd-8511-d77edf6f8c07",
                                "text": "„Helvetien … wurde den ‚Schweizern‘ damals zu eng, sie versuchten in die fruchtbarsten Teile Galliens auszuwandern, was aber Cäsar zu verhindern gelang.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "94c255df-b444-3752-8d4b-a0a0ffae9675",
                        "entry_id": "08fe2b76-0bfe-37d1-9e77-769a94426116",
                        "glosses": [
                            "inoffizielle Bezeichnung des von 1798 bis 1803 existierenden, von Napoleon geschaffenen Vasallenstaats Frankreichs, weitgehend dem Gebiet der heutigen Schweiz entsprechend"
                        ],
                        "tags": [
                            "archaic",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "0f9b0614-1017-42cd-bc83-9b56794c70dc",
                                "sense_id": "94c255df-b444-3752-8d4b-a0a0ffae9675",
                                "text": "„General Brune, oberster Befehlshaber der fränkischen Armee in Helvetien: Die Republik Helvetien (Konstitutionsvorschlag).“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "493f91d7-d1cb-32e7-b902-c9fe17bc0ae9",
                        "entry_id": "08fe2b76-0bfe-37d1-9e77-769a94426116",
                        "glosses": [
                            "Schweiz"
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "2806d0c9-7098-45c2-b117-1441b29e48be",
                                "sense_id": "493f91d7-d1cb-32e7-b902-c9fe17bc0ae9",
                                "text": "„Helvetien und Deutschland. Kulturelle Beziehungen zwischen der Schweiz und Deutschland in der Zeit von 1770–1830.“"
                            },
                            {
                                "example_id": "ea68f8b9-a163-4531-b949-0f8f721cf1d5",
                                "sense_id": "493f91d7-d1cb-32e7-b902-c9fe17bc0ae9",
                                "text": "„Tuvalu, Bahamas – und Helvetien: In der Schweiz gibt es noch immer keine Regeln für die Finanzierung von Kampagnen und Parteien.“"
                            },
                            {
                                "example_id": "0fc95186-c79d-4127-9e48-066c908212f6",
                                "sense_id": "493f91d7-d1cb-32e7-b902-c9fe17bc0ae9",
                                "text": "„Helvetien im Treibhaus. Der weltweite Klimawandel und seine Auswirkungen auf die Schweiz.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
