        "fr-extract.jsonl": [
            {
                "entry_id": "3727dff7-31f9-3576-a2ed-103a8e4c65ff",
                "word": "pharmacologie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "38ce73e0-28cc-460f-83d4-4ef54ec10824",
                        "entry_id": "3727dff7-31f9-3576-a2ed-103a8e4c65ff",
                        "tags": [
