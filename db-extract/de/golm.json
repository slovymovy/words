                ],
                "senses": [
                    {
                        "sense_id": "45be9f56-5030-3028-af2f-c4c0856be42f",
                        "entry_id": "fc853487-9bac-33c7-81c7-441cd2083d7c",
                        "glosses": [
                            "Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d267da9c-0003-4791-948c-e0d6c40fbd19",
                                "sense_id": "45be9f56-5030-3028-af2f-c4c0856be42f",
                                "text": "Frau Golm ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "8c6d6e7e-8e05-412c-9a33-7b6f01513983",
                                "sense_id": "45be9f56-5030-3028-af2f-c4c0856be42f",
                                "text": "Herr Golm wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "05e9718e-fa6a-454d-9924-96c55049616d",
                                "sense_id": "45be9f56-5030-3028-af2f-c4c0856be42f",
                                "text": "Die Golms fahren heute nach Rotterdam."
                            },
                            {
                                "example_id": "ab1ed8fb-d497-46d0-a2cd-2387effef4ff",
                                "sense_id": "45be9f56-5030-3028-af2f-c4c0856be42f",
                                "text": "Der Golm trägt nie die Pullover, die die Golm ihm strickt."
                            },
                            {
                                "example_id": "1baefee2-c62f-4121-9ce0-0953ec47ccd3",
                                "sense_id": "45be9f56-5030-3028-af2f-c4c0856be42f",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Golm kommt, geht der Herr Golm.“"
                            },
                            {
                                "example_id": "315c9cc2-5933-4c44-a708-3399ace5e6cf",
                                "sense_id": "45be9f56-5030-3028-af2f-c4c0856be42f",
                                "text": "Golm kommt und geht."
                            },
                            {
                                "example_id": "07d4e7de-b049-443b-a8ec-f653b8e93f39",
                                "sense_id": "45be9f56-5030-3028-af2f-c4c0856be42f",
                                "text": "Golms kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
