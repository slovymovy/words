                "senses": [
                    {
                        "sense_id": "e4ac436a-ffa8-317a-9dbc-12df391f3b3b",
                        "entry_id": "48b6be23-4895-31d4-a54f-b1d70097556e",
                        "glosses": [
                            "Darstellung beziehungsweise Mitteilung über Verlauf und Ergebnis eines Spielgeschehens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d7b3257-9c71-43bb-809a-c98a7ec3379b",
                                "sense_id": "e4ac436a-ffa8-317a-9dbc-12df391f3b3b",
                                "text": "„Während des Hockeyspiels bei der Winterolympiade in Garmisch-Partenkirchen war er zu nervös gewesen, um bis zum Schluß dazubleiben, und ließ sich erst später einen genauen Spielbericht geben.“"
                            },
                            {
                                "example_id": "f81be022-d380-43dc-b361-0db2617ec4d5",
                                "sense_id": "e4ac436a-ffa8-317a-9dbc-12df391f3b3b",
                                "text": "„So hat es der Schiedsrichter im Spielbericht festgehalten, das Sportgericht hat es offenbar von dort übernommen.“"
                            },
                            {
                                "example_id": "c3858666-9c02-4df6-8f53-04b23b94badb",
                                "sense_id": "e4ac436a-ffa8-317a-9dbc-12df391f3b3b",
                                "text": "„Laut Spielbericht verfolgten 20 Fußballfans das Spiel am 1. Mai auf dem Sportplatz von Mühlenbeck (Oberhavel).“"
                            },
                            {
                                "example_id": "2258611a-59aa-4937-8bb5-d95bd28af19c",
                                "sense_id": "e4ac436a-ffa8-317a-9dbc-12df391f3b3b",
                                "text": "„Ein sachlicher Spielbericht wurde durch einen Kommentar über den Triumph des westdeutschen Separatstaates begleitet.“"
                            },
                            {
                                "example_id": "585e5eba-87af-4c19-a719-479448c8879c",
                                "sense_id": "e4ac436a-ffa8-317a-9dbc-12df391f3b3b",
                                "text": "„Kein einziges Mal hatte der Sportsender in seinem Spielbericht erwähnt, dass Babelsberg kein Dorfklub ist, wie Bielefelds Fans glaubten, sondern aus Potsdam kommt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
