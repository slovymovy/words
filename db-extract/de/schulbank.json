                        "form": "die Schulbänke"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c9dc9ba8-cecd-3816-98f4-cbfe23bf51e3",
                        "entry_id": "a2753881-ffb0-3f13-aef4-3b2abebe0f33",
                        "glosses": [
                            "Sitzmöbel für zwei Schüler in Klassenräumen, bei dem die Sitzgelegenheit fest mit der Schreibplatte verbunden ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d722e4db-4d88-4ccf-ac09-6b8be2723275",
                                "sense_id": "c9dc9ba8-cecd-3816-98f4-cbfe23bf51e3",
                                "text": "„Viele Klassenräume in Kamerun sind mit Schulbänken ausgestattet, die am Boden fixiert sind.“"
                            },
                            {
                                "example_id": "d5da6f22-43a4-4fb2-be9e-db86773a164a",
                                "sense_id": "c9dc9ba8-cecd-3816-98f4-cbfe23bf51e3",
                                "text": "„Sobald er den Raum betrat, mussten alle Schüler links neben die Schulbank treten und strammstehen.“"
                            },
                            {
                                "example_id": "852a4ed8-6772-4fe0-a4fa-93ab6dd5968c",
                                "sense_id": "c9dc9ba8-cecd-3816-98f4-cbfe23bf51e3",
                                "text": "„Ich gehe gern in die Schule, und die Vorstellung, dass ich nie wieder mit meinen Mitschülerinnen in der Schulbank sitzen darf, treibt mir die Tränen in die Augen.“"
                            },
                            {
                                "example_id": "8ccd47c0-b53c-444a-9265-b59fbbd17150",
                                "sense_id": "c9dc9ba8-cecd-3816-98f4-cbfe23bf51e3",
                                "text": "„Elsas Vater wurde dem Volkssturm zugeteilt, und in der Schule lernten sie jetzt, unter den Schulbänken Schutz zu suchen, Wassereimerketten zu bilden und Sirenensignale zu unterscheiden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
