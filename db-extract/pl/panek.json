                    }
                ],
                "translations": [
                    {
                        "translation_id": "dbe96783-d8d8-42b5-94ab-691db879ab5a",
                        "source_entry_id": "a609dcb6-f3ff-3c4b-a429-ca620cd79106",
                        "source_sense_id": "c3c26ec4-46c7-364c-8ad3-65cfa28abddd",
