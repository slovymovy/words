                        "entry_id": "42273448-e760-394c-8555-2701d09c482e",
                        "glosses": [
                            "наречие к стыдливый; испытывая или выражая стыдливость, смущение, застенчивость"
                        ],
                        "tags": [
                            "adverb"
                        ],
                        "examples": [
                            {
                                "example_id": "139a1a27-98c6-4ec8-8571-d11be1378cab",
                                "sense_id": "20685599-ecae-3774-b09f-7a084f55c467",
                                "text": "Встретившись с моим взглядом, барышни быстро и стыдливо отвернулись, смущенно потупив головки."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "416ecdfe-2f90-4242-bd65-b186c179f989",
                        "source_entry_id": "42273448-e760-394c-8555-2701d09c482e",
                        "source_sense_id": "20685599-ecae-3774-b09f-7a084f55c467",
                        "target_lang_word": "bashfully",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bashfully",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f9970c70-8ea7-35d0-b46d-336239db2d0d",
                                        "entry_id": "6f8b356f-97b3-3767-ab87-4f09893ff9ec",
                                        "glosses": [
                                            "In a bashful manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a62bae0-2656-4984-bfa1-35516b408efb",
                                                "sense_id": "f9970c70-8ea7-35d0-b46d-336239db2d0d",
                                                "text": "[T]he thrush sang his mocking songs and libellous ditties about everybody, but became occasionally a little sentimental and warbled gently and bashfully some tender stanzas."
                                            },
                                            {
                                                "example_id": "8228fa55-09a0-48ac-928d-c815577b8d82",
                                                "sense_id": "f9970c70-8ea7-35d0-b46d-336239db2d0d",
                                                "text": "The morning of the wedding he bounded up my stair, most tremendously shaved and brushed, stood upon my doormat bashfully hesitant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2218c22d-bda9-4de1-af32-98f60348936a",
                        "source_entry_id": "42273448-e760-394c-8555-2701d09c482e",
                        "source_sense_id": "20685599-ecae-3774-b09f-7a084f55c467",
