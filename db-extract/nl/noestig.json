                "senses": [
                    {
                        "sense_id": "fc517d0b-6e39-3dda-8433-b936e43b43c8",
                        "entry_id": "1b0ff8cf-007a-3469-92c0-968a32c69436",
                        "glosses": [
                            "van hout dat het veel knoesten bevat; ook in figuurlijke zin van andere zaken dan hout"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f6facf1-adff-4053-a800-212de77dc801",
                                "sense_id": "fc517d0b-6e39-3dda-8433-b936e43b43c8",
                                "text": "Het handengeklap begint. Tientallen seconden lang strijken de mannen hun noestige handpalmen over elkaar."
                            }
                        ]
                    },
                    {
                        "sense_id": "65bcde16-ed7d-3375-9a75-6625398dff3a",
                        "entry_id": "1b0ff8cf-007a-3469-92c0-968a32c69436",
                        "glosses": [
                            "met veel inspanning"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d376b26-fb55-4a50-8184-0854bb7ab168",
                                "sense_id": "65bcde16-ed7d-3375-9a75-6625398dff3a",
                                "text": "Een Westerse man tikt er noestig en rokend een of ander lang verhaal op zijn laptop."
                            },
                            {
                                "example_id": "baee8385-22e0-4821-931e-61ade06b425f",
                                "sense_id": "65bcde16-ed7d-3375-9a75-6625398dff3a",
                                "text": "Andy Schleck zette vandaag een knalprestatie neer. Nadat hij gisteren zwaar ten val kwam, vroeg iedereen zich af of hij de hel van Noord-Frankrijk zou overleven. En of hij dat deed!. Op de kasseistroken van Sars-et-Rosieres ontbond Cancellara zijn duivels. Contador en Armstrong moesten passen, maar Andy Schleck volgde noestig het wiel van zijn ploegmaat tot aan de eindstreep."
                            }
                        ]
                    }
