                ],
                "senses": [
                    {
                        "sense_id": "0e30eea1-8822-3151-9078-efcaaff679bb",
                        "entry_id": "ea1652d7-a1c5-33e6-aa26-6daf686b6227",
                        "glosses": [
                            "Durchschnittswert, errechnet aus allen zur Verfügung stehenden Werten; Gebrauch oft im Vergleich mit einem Durchschnitt aus einer Teilmenge der zur Verfügung stehenden Werte"
                        ],
                        "tags": [
                            "Statistik",
                            "Plural selten"
                        ],
                        "examples": [
                            {
                                "example_id": "ebcf571f-a219-4947-aa97-8b20ff40993a",
                                "sense_id": "0e30eea1-8822-3151-9078-efcaaff679bb",
                                "text": "Der Gesamtdurchschnitt errechnet sich durch den Quotienten von Gesamtsumme durch Gesamtanzahl."
                            },
                            {
                                "example_id": "cbd889dd-fa19-4770-9adc-0b1ffba99a7a",
                                "sense_id": "0e30eea1-8822-3151-9078-efcaaff679bb",
                                "text": "[Parlamentswahl in Russland 2021:] „Die Wahlbeteiligung lag im Gesamtdurchschnitt bei 51,68 %. In manchen Regionen, bspw. in Tschetschenien (über 93 %), Tartastan (79 %) und Kemerowo (70 %) lag die Wahlbeteiligung laut offiziellen Zahlen auch deutlich darüber.“"
                            },
                            {
                                "example_id": "172aa36a-e3be-4c81-b4e2-8c8a3f6b4712",
                                "sense_id": "0e30eea1-8822-3151-9078-efcaaff679bb",
                                "text": "„Das durchschnittliche Einkommen je Steuerpflichtigen beträgt in Altengamme 47.341 Euro jährlich (2013), der Hamburger Gesamtdurchschnitt liegt bei 39.054 Euro.“"
                            },
                            {
                                "example_id": "7a200834-5c8c-405a-a215-c6926328282a",
                                "sense_id": "0e30eea1-8822-3151-9078-efcaaff679bb",
                                "text": "[Angestellte in Österreich:] „Das heißt, männliche Angestellte sind deutlich Gutverdiener, weibliche verdienen deutlich noch unter dem Gesamtdurchschnitt.“"
                            },
                            {
                                "example_id": "5d56d2b6-f779-48f4-9c45-c35bdf94234d",
                                "sense_id": "0e30eea1-8822-3151-9078-efcaaff679bb",
                                "text": "„Sie gehört zu den größten und beliebtesten Arbeitgebern des Landes: Derzeit arbeiten dort 155.000 Menschen, wobei ihr Durchschnittslohn von umgerechnet 1.300 Euro den tschechischen Gesamtdurchschnitt um 23 Prozent übersteigt.“"
                            },
                            {
                                "example_id": "1bed271c-4444-47be-a9be-445f7cfa99a9",
                                "sense_id": "0e30eea1-8822-3151-9078-efcaaff679bb",
                                "text": "„Aus der Arbeitslosenstatistik allerdings sind die Probleme der älteren Arbeitssuchenden nicht ersichtlich: Die Quote lag 2016 mit 2,8 Prozent bei der Generation 50+ unter dem Gesamtdurchschnitt von 3,3 Prozent.“"
                            },
                            {
                                "example_id": "676e0aa8-fc59-49ea-8658-c166f4f00839",
                                "sense_id": "0e30eea1-8822-3151-9078-efcaaff679bb",
                                "text": "[Aquitanien:] „Insgesamt hat die Region in den letzten ca. 150 Jahren an Bevölkerung gewonnen, bleibt aber unter dem französischen Gesamtdurchschnitt.“"
                            },
                            {
                                "example_id": "12ced268-70fe-4795-a9ae-1312c57daa3b",
                                "sense_id": "0e30eea1-8822-3151-9078-efcaaff679bb",
                                "text": "„Für Frauen mit ausländischer Staatsangehörigkeit in Deutschland lag die Geburtenrate 2019 mit 2,06 Kinder pro Frau über dem Gesamtdurchschnitt.“"
                            },
                            {
                                "example_id": "052589da-005d-4e36-99ce-2727a1bc35cd",
                                "sense_id": "0e30eea1-8822-3151-9078-efcaaff679bb",
                                "text": "[11. Oktober 1916 – Erlass zur \"Judenzählung\":] „Juden hatten sich ihrem Anteil an der Bevölkerung gemäß an der Front eingesetzt, waren ihrem Anteil gemäß mit Tapferkeitsmedaillen ausgezeichnet worden, waren ihrem Anteil gemäß gefallen, und bei den Freiwilligen lag ihr Einsatz prozentual gesehen sogar über dem Gesamtdurchschnitt.“"
                            },
                            {
                                "example_id": "b81712a0-daf8-4a9e-ba91-372ec8037ebc",
                                "sense_id": "0e30eea1-8822-3151-9078-efcaaff679bb",
                                "text": "[Coronapandemie 2021:] „Im europäischen Gesamtdurchschnitt gaben 22 Prozent an, sich frei zu fühlen, während 64 Prozent angaben, sich vor der Pandemie frei gefühlt zu haben.“"
                            },
                            {
                                "example_id": "1ec8a7ce-f086-42eb-8d3a-6bdc4ded98b0",
                                "sense_id": "0e30eea1-8822-3151-9078-efcaaff679bb",
                                "text": "„In puncto Nachhaltigkeit zeigten sie ein „ambivalentes Verhalten“: Junge kauften deutlich mehr Secondhand-Kleidungsstücke als Ältere (60 bis 65 Jahre). Sie kaufen generell mehr (27 gegenüber dem Gesamtdurchschnitt von 18 Stück), geben aber pro Kleidungsstück (26 gegenüber 44 Euro) weniger dafür aus.“"
                            },
                            {
                                "example_id": "16c26e14-67da-4ca5-8383-b28eeed2e55e",
                                "sense_id": "0e30eea1-8822-3151-9078-efcaaff679bb",
                                "text": "[Kokainkonsum in europäischen Städten:] „Im aktuellen Ranking finden sich auf den Rängen sieben bis neun im Gesamtdurchschnitt drei weitere Schweizer Städte: Genf, St. Gallen und Basel.“"
                            },
                            {
                                "example_id": "4c7c8d50-7e80-4d2d-b95f-1f540cdbbff3",
                                "sense_id": "0e30eea1-8822-3151-9078-efcaaff679bb",
                                "text": "[Mietpreise in Berlin 2022:] „Hier nahmen die Gesellschaften durchschnittlich 7,25 Euro statt 7,00 Euro im Jahr zuvor. Das liegt immer noch deutlich unter dem Gesamtdurchschnitt bei Angebotsmieten von 10,55 Euro.“"
                            },
                            {
                                "example_id": "c6e6f398-ecfb-4a1a-9ab3-547241ce88b9",
                                "sense_id": "0e30eea1-8822-3151-9078-efcaaff679bb",
                                "text": "[Energieverbrauch eines Elektrofahrzeugs:] „Der Gesamtdurchschnitt im Test lag wegen der Mischung aus energieintensiven Kurzstrecken und Autobahnen bei relativ hohen 18,2 kWh/100 km (177 km Reichweite, alle Angaben ohne Ladeverluste).“"
                            },
                            {
                                "example_id": "9a436370-d52a-4473-8f55-32228b2b318b",
                                "sense_id": "0e30eea1-8822-3151-9078-efcaaff679bb",
                                "text": "[Bayern:] „Schüler der vierten Klasse“ […] „müssen in drei Fächern Deutsch, Mathematik, Heimat- und Sachkunde im Übertrittszeugnis mindestens den Gesamtdurchschnitt von 2,33 erreichen, um aufs Gymnasium zu gehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
