                                "target_senses": [
                                    {
                                        "sense_id": "8e2faefb-3387-360d-adc9-b475dedde6cd",
                                        "entry_id": "ae8a22aa-8b98-366f-bfce-9b2d024c7af6",
                                        "glosses": [
                                            "Discipline scientifique qui étudie les effets nocifs de certains produits chimiques ou agents toxiques (poisons) sur les êtres vivants, ainsi que les moyens de les prévenir, les détecter et les traiter."
                                        ],
                                        "tags": [
                                            "Santé environnementale"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1997b4c1-c43c-4b88-ab73-834eab724a88",
                                                "sense_id": "8e2faefb-3387-360d-adc9-b475dedde6cd",
                                                "text": "Dans ce domaine, Vicente était un érudit, connaissant des pans entiers de la chimie, de la botanique, de l’anatomie et de la psychologie – il aurait pu passer haut la main les examens les plus difficiles, s’il existait un concours en toxicologie."
                                            },
                                            {
                                                "example_id": "01b725e8-9179-427e-8d2f-3b5fa477325e",
                                                "sense_id": "8e2faefb-3387-360d-adc9-b475dedde6cd",
                                                "text": "Il ne faut pas minimiser les risques microbiologiques, assure Romain Lasseur, docteur en toxicologie animale."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5c23088d-d51c-4dd7-a977-f2748ed89331",
                        "source_entry_id": "10e2b445-4eaf-34ac-908c-0409405bc015",
                        "source_sense_id": "05be42a0-1db4-3a97-bfb1-d7433e94c221",
