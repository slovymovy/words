                "senses": [
                    {
                        "sense_id": "87f9374e-e9dc-35ce-b49d-cb45fd332099",
                        "entry_id": "55c2665d-3554-3bb4-b79a-bdc7522ba901",
                        "glosses": [
                            "conniver"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfa94190-1469-4194-bc32-7291600f0846",
                                "sense_id": "87f9374e-e9dc-35ce-b49d-cb45fd332099",
                                "text": "— Ступа́й… — пота́тчик. — прикри́кнула на него́ Ари́на Петро́вна, но таки́м го́лосом, что он и не поду́мал упо́рствовать в дальне́йшей защи́те Ива́на Миха́йлова.",
                                "translation": "‘Off with you, you... conniver!’ shouted Arina Petrovna, in such a tone that left him with no thought of persisting in his defence of Ivan Mikhailov.",
                                "english": "‘Off with you, you... conniver!’ shouted Arina Petrovna, in such a tone that left him with no thought of persisting in his defence of Ivan Mikhailov."
                            }
                        ]
                    }
