{
    "word_family": [
        "comradeship",
        "comradely"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cceeea89-eb40-3113-8050-16202cc23347",
                    "sense_definition": "A companion in battle or a fellow soldier.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "companion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers refused to leave their fallen <w>comrades</w> behind on the battlefield.",
                            "target_lang_translations": {
                                "ru": "Солдаты отказались оставлять своих павших <w>товарищей</w> на поле боя."
                            }
                        },
                        {
                            "text": "He felt a deep bond with every <w>comrade</w> in arms during the long winter.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал глубокую связь с каждым <w>соратником</w> по оружию в течение долгой зимы."
                            }
                        }
                    ],
                    "synonyms": [
                        "battle buddy"
                    ],
                    "antonyms": [
                        "enemy",
                        "foe"
                    ],
                    "common_phrases": [
                        "comrade in arms",
                        "fallen comrade"
                    ],
                    "target_lang_definitions": {
                        "ru": "Боевой товарищ или однополчанин."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "товарищ",
                                "target_lang_sense_clarification": "по оружию"
                            },
                            {
                                "target_lang_word": "соратник",
                                "target_lang_sense_clarification": "товарищ по битвам"
                            },
                            {
                                "target_lang_word": "однополчанин",
                                "target_lang_sense_clarification": "сослуживец"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "37351855-39e9-34a9-b7df-049c75efba32",
                    "sense_definition": "A close companion, mate, or associate.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "companion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They had been <w>comrades</w> since childhood, sharing every secret and adventure.",
                            "target_lang_translations": {
                                "ru": "Они были <w>товарищами</w> с детства, делясь всеми секретами и приключениями."
                            }
                        },
                        {
                            "text": "He was a loyal <w>comrade</w> who stayed by his side through the most difficult years.",
                            "target_lang_translations": {
                                "ru": "Он был верным <w>другом</w>, который оставался рядом в самые трудные годы."
                            }
                        }
                    ],
                    "synonyms": [
                        "friend",
                        "compagno"
                    ],
                    "antonyms": [
                        "stranger"
                    ],
                    "common_phrases": [
                        "loyal comrade",
                        "old comrade"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "often used in older literature"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Близкий спутник, приятель или коллега."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "товарищ",
                                "target_lang_sense_clarification": "друг или коллега"
                            },
                            {
                                "target_lang_word": "друг",
                                "target_lang_sense_clarification": "близкий человек"
                            },
                            {
                                "target_lang_word": "приятель",
                                "target_lang_sense_clarification": "знакомый"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5629d850-cc95-3bc2-98d1-8bcf755805c9",
                    "sense_definition": "A fellow member of a socialist or communist political party.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "political_title",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>comrade</w> stood up to address the assembly about the new labor laws.",
                            "target_lang_translations": {
                                "ru": "<w>Товарищ</w> встал, чтобы обратиться к собранию по поводу новых законов о труде."
                            }
                        },
                        {
                            "text": "He greeted his fellow <w>comrades</w> at the start of the political rally.",
                            "target_lang_translations": {
                                "ru": "Он поприветствовал своих <w>товарищей</w> в начале политического митинга."
                            }
                        }
                    ],
                    "synonyms": [
                        "tovarish"
                    ],
                    "common_phrases": [
                        "party comrade",
                        "fellow comrade"
                    ],
                    "target_lang_definitions": {
                        "ru": "Член социалистической или коммунистической партии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "товарищ",
                                "target_lang_sense_clarification": "партийное обращение"
                            },
                            {
                                "target_lang_word": "единомышленник",
                                "target_lang_sense_clarification": "соратник по борьбе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8074cee5-3145-3482-bbdd-0e8b5ccf724a",
                    "sense_definition": "A non-hierarchical title used instead of Mr. or Mrs. in certain political contexts.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "political_title",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please welcome <w>Comrade</w> Smith to the stage to deliver the opening remarks.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, поприветствуйте <w>товарища</w> Смита, который выйдет на сцену со вступительным словом."
                            }
                        },
                        {
                            "text": "In the document, she was referred to simply as <w>Comrade</w> Petrov.",
                            "target_lang_translations": {
                                "ru": "В документе она упоминалась просто как <w>товарищ</w> Петрова."
                            }
                        }
                    ],
                    "synonyms": [
                        "brother",
                        "compare sister"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неиерархическое обращение, используемое вместо «господин» или «госпожа» в определенных политических контекстах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "товарищ",
                                "target_lang_sense_clarification": "официальное обращение"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8d2a84be-95b5-32b6-ba87-1f3dc155c2b2",
                    "sense_definition": "To associate or spend time with someone in a friendly or companionable way.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She spent the summer <w>comrading</w> with the local travelers across the countryside.",
                            "target_lang_translations": {
                                "ru": "Она провела лето, <w>товариществуя</w> с местными путешественниками в сельской местности."
                            }
                        },
                        {
                            "text": "The soldiers were <w>comrading</w> together in the tavern after the long march.",
                            "target_lang_translations": {
                                "ru": "Солдаты <w>дружески общались</w> в таверне после долгого марша."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used as a verb in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Общаться или проводить время с кем-либо по-дружески."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "товариществовать",
                                "target_lang_sense_clarification": "поддерживать дружеские отношения"
                            },
                            {
                                "target_lang_word": "дружить",
                                "target_lang_sense_clarification": "проводить время вместе"
                            }
                        ]
                    }
                }
            ]
        }
    ]
