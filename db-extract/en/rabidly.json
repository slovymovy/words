                                        "sense_id": "4d1b1284-8382-3560-bf74-8c5719383a57",
                                        "entry_id": "1c53b2ff-3222-3dd9-9276-548323d3f676",
                                        "glosses": [
                                            "D’une manière farouche."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c8ffc88-01c7-4e2e-89f3-d885c6bd31fd",
                                                "sense_id": "4d1b1284-8382-3560-bf74-8c5719383a57",
                                                "text": "Les effigies qu’on publia de lui soulignaient d’abord une immense moustache noire et, en second lieu, derrière la moustache, un air farouchement irascible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd41a5c9-bf0a-35c2-8095-2ebae8cf4ac2",
                                        "entry_id": "1c53b2ff-3222-3dd9-9276-548323d3f676",
                                        "glosses": [
                                            "Absolument ; totalement ; sans aucun espoir de conciliation."
                                        ],
                                        "tags": [
                                            "hyperbole"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13aebdba-7411-4c40-9c82-be21958938c7",
                                                "sense_id": "bd41a5c9-bf0a-35c2-8095-2ebae8cf4ac2",
                                                "text": "Je voulais parler des perles, des diamants, des pierres précieuses et mes amants ne comprenaient pas qu’au lieu de les porter sur moi, je préférasse y plonger les mains jusqu’aux coudes, farouchement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9a1505ac-8a6f-4705-9160-f9b3bd2e3ab4",
                        "source_entry_id": "af82afa7-29a0-3334-8cea-c1245239d7af",
                        "source_sense_id": "f6401a77-b709-3060-bf39-a87eead06895",
                        "source_sense_description": "in a rabid manner",
                        "target_lang_word": "férocement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "férocement",
