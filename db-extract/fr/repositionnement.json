                                        "glosses": [
                                            "The act by which something is repositioned."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9dbc7560-20eb-419c-8569-ac7d88c33d7c",
                                                "sense_id": "f58d8a69-d7de-345e-9c9a-5dfeaf87d116",
                                                "text": "Work is planned as far as possible so that the last engine to arrive on one of the maintenance tracks is the first out, to avoid unnecessary shunting and the re-positioning of locomotives still receiving attention."
                                            }
                                        ]
                                    }
                                ]
