                        ]
                    },
                    {
                        "translation_id": "8fc3c4d5-7c47-4856-9bec-65b16e9c4f1c",
                        "source_entry_id": "c888e966-9aff-3e19-8f25-aa5237fba776",
                        "source_sense_description": "a compact folding knife",
                        "target_lang_word": "knipmes",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "knipmes",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "b0c3f3d0-07d7-3eac-81a4-b4b66fba5941",
                                        "entry_id": "dc186b8d-fcba-312b-8f05-19fcbd513ff3",
                                        "glosses": [
                                            "opvouwbaar mes waarbij vaak een veer zorgt voor het uitklappen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9abeebfd-674c-4652-93e8-59f3047a4f6d",
                                                "sense_id": "b0c3f3d0-07d7-3eac-81a4-b4b66fba5941",
                                                "text": "Dit is een van de waargebeurde verhalen die Steffie van den Oord met veel gevoel voor saillante details navertelt in De vrouw met de bijl en negen andere moordenaressen. Ze biedt een interessante mix van criminele feiten, gepleegd met uiteenlopende wapens. Bijl, sabel, deurknop, knipmes, broodmes, pistool, revolver, dolk en rattengif. De moordenaressen zijn dienstmeiden, hoeren, dochters van pachtboeren, zakkendragers en boerenknechten. Geldgebrek is een belangrijk motief. Soms ook jaloezie. Of hartstocht."
                                            },
                                            {
                                                "example_id": "561653ab-b1d4-442a-9af3-5f31ac81fa42",
                                                "sense_id": "b0c3f3d0-07d7-3eac-81a4-b4b66fba5941",
                                                "text": "Gonzalez stak het grasveld over en ging de residentie binnen. De Secret Service meldde daarna dat hij werd overmeesterd meteen nadat hij de deur van de Noordelijke Zuileningang had geopend. Maar naar maandag bekend werd, is dat niet waar. Gonzalez, die gewapend was met een knipmes, kwam veel verder. Hij drong door tot de East Room, een balzaal waar de cellist Pablo Casals nog heeft gespeeld voor president Kennedy. Pas bij de ingang naar de Green Room, een salon voor recepties aan de zuidkant, werd hij gepakt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6a8caa79-724b-48f6-9a93-1aa0b14df184",
                        "source_entry_id": "c888e966-9aff-3e19-8f25-aa5237fba776",
                        "source_sense_description": "a compact folding knife",
                        "target_lang_word": "Taschenmesser",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Taschenmesser",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a59e8db0-2775-3d1f-83fc-614335017912",
                                        "entry_id": "884ca9c7-c46b-3840-a238-64bff29716aa",
                                        "glosses": [
                                            "ein Messer, dessen Klinge zum gefahrlosen Transport in den Griff eingeklappt werden kann und das oft weitere Funktionen hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b79c7f8c-b27f-4466-ad97-ecfa71e408e4",
                                                "sense_id": "a59e8db0-2775-3d1f-83fc-614335017912",
                                                "text": "Mein Taschenmesser ist mit seinen vielen Funktionen ein kleiner Werkzeugkasten."
                                            },
                                            {
                                                "example_id": "8a91d6dc-1120-4461-a6ec-0f3884f247b6",
                                                "sense_id": "a59e8db0-2775-3d1f-83fc-614335017912",
                                                "text": "„Mit seinem Taschenmesser ratschte Bertram so energisch über die Verpackung, dass ich schon um den Inhalt fürchtete.“"
                                            },
                                            {
                                                "example_id": "35bec946-f256-4ce7-b7d1-bfabd4ced2a2",
                                                "sense_id": "a59e8db0-2775-3d1f-83fc-614335017912",
                                                "text": "Einer der Mobber greift den 14jährigen körperlich an. Der zieht ein Taschenmesser, das er seit Wochen mit in die Schule gebracht hat. Zu seiner Verteidigung, wie er sagt."
                                            },
                                            {
                                                "example_id": "75cf8879-cdb6-428f-8e86-aa55e1e0352a",
                                                "sense_id": "a59e8db0-2775-3d1f-83fc-614335017912",
                                                "text": "Besondere Erwähnung verdient das Taschenmesser. Natürlich passt es in so gut wie jede Tasche, aber es hat selbst eine. Seine Klinge lässt sich in die taschenähnliche Vertiefung im Griff klappen, weshalb es auch Klappmesser heißt."
                                            },
                                            {
                                                "example_id": "48183c20-937b-4a92-9bd4-8772c621d240",
                                                "sense_id": "a59e8db0-2775-3d1f-83fc-614335017912",
                                                "text": "„Da saß ich und trällerte oder schrieb auf weiße Birkenrinde oder schnitzte etwas mit meinem Taschenmesser.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3a34db49-0264-42c8-9896-018a9fcbabd6",
