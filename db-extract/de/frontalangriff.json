                        ],
                        "examples": [
                            {
                                "example_id": "ccb151d6-4a2b-4dad-84a8-d1dfb587bdf3",
                                "sense_id": "f52363db-6ae0-37f4-b815-afb9264ca5d9",
                                "text": "„Die Abwehr des sowjetischen Frontalangriffs gegen Seelow war der letzte Erfolg der Wehrmacht im Zweiten Weltkrieg.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
