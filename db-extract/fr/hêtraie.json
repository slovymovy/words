        "fr-extract.jsonl": [
            {
                "entry_id": "d74e18f0-027c-3bf8-b47c-9792b28cfa75",
                "word": "hêtraie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f1dabc85-06b2-4f7a-99d7-1325d6d60649",
                        "entry_id": "d74e18f0-027c-3bf8-b47c-9792b28cfa75",
                        "tags": [
                            "plural"
                        ],
                        "form": "hêtraies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0119a0d1-a319-3eaf-9b87-957706b9e49a",
                        "entry_id": "d74e18f0-027c-3bf8-b47c-9792b28cfa75",
                        "glosses": [
                            "Peuplement de hêtres (arbres du genre Fagus)."
                        ],
                        "tags": [
                            "Phytosociologie"
                        ],
                        "examples": [
                            {
                                "example_id": "c499a4bd-70fa-4d78-a5ed-aa8a5040e04c",
                                "sense_id": "0119a0d1-a319-3eaf-9b87-957706b9e49a",
                                "text": "Elle était au fond du verger, cueillant au pied d’un mur les premiers chrysanthèmes qui mêlaient leur parfum à celui des feuilles mortes de la hêtraie."
                            },
                            {
                                "example_id": "eaf63ae6-0fd6-44e2-a165-8a7a5939b1d5",
                                "sense_id": "0119a0d1-a319-3eaf-9b87-957706b9e49a",
                                "text": "Le vieux m’accompagna jusqu’à la sortie du village, là, il me montra le chemin et m’expliqua par où je devais aller. Mais cela ne me plaisait déjà plus. Mr Mansfield m’expliquait en substance que je devais traverser de temps en temps une hêtraie qui cédait la place à une forêt de bouleaux, et il avait aussi une chênaie qui jouait un grand rôle. Mais moi, hélas, j’étais citadin depuis ma prime jeunesse et adepte exclusif des sciences morales. Je n’ai jamais su distinguer deux arbres entre eux."
                            },
                            {
                                "example_id": "3b74802a-d3ae-4347-81cc-85fe134d6bf2",
                                "sense_id": "0119a0d1-a319-3eaf-9b87-957706b9e49a",
                                "text": "Un peu plus bas sur l’autre versant, les houppiers d’une vieille hêtraie d’altitude émergent du ciel qui rougit à l’horizon. Déjà, une grive musicienne nous régale de son chant matinal."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "27447d4c-4cb4-49e1-a81e-03c362885a3e",
                        "source_entry_id": "d74e18f0-027c-3bf8-b47c-9792b28cfa75",
                        "source_sense_id": "0119a0d1-a319-3eaf-9b87-957706b9e49a",
