                            {
                                "example_id": "76472a48-801b-4428-9a09-71bbf4939516",
                                "sense_id": "88fe8fcb-9b64-3a0e-9f45-6d79e7b22e6f",
                                "text": "D'abord les Chinetoques lui ont fait comprendre qu'il était démasqué : pédé, tante, caroline, folle, pédale, emmanché, chochotte, tantouse, pédoque, tapette, lopaille en grandes lettres au minium sur les murs de sa maison."
                            },
                            {
                                "example_id": "a3534de8-00e6-4291-a7b6-8360a6a9d83d",
                                "sense_id": "88fe8fcb-9b64-3a0e-9f45-6d79e7b22e6f",
                                "text": "Pas question qu'il aille s'excuser, ramper devant cette lopaille, lui lécher les bronzes."
                            }
                        ]
                    }
                ],
