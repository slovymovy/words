                ],
                "senses": [
                    {
                        "sense_id": "8291a142-6338-3cfa-b02f-f3530c6afca4",
                        "entry_id": "9a1e8dae-bb92-3a0b-ba68-1ad159f45ea1",
                        "glosses": [
                            "die (tiefe) Stimme eines Mannes (beim Sprechen oder Singen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc4785ff-041d-416c-a082-997a5ef3c57b",
                                "sense_id": "8291a142-6338-3cfa-b02f-f3530c6afca4",
                                "text": "In unserem Chor herrscht ein Mangel an Männerstimmen."
                            },
                            {
                                "example_id": "8315ac90-2d91-43b4-8d69-bcf15147006c",
                                "sense_id": "8291a142-6338-3cfa-b02f-f3530c6afca4",
                                "text": "Sie wurde mitten in der Nacht von einer lauten Männerstimme geweckt."
                            },
                            {
                                "example_id": "95b3e1a1-0f19-466f-8ece-a1a0fb7d718b",
                                "sense_id": "8291a142-6338-3cfa-b02f-f3530c6afca4",
                                "text": "„Endlich gegen Morgen ließen sich Männerstimmen vom Ufer her vernehmen.“"
                            },
                            {
                                "example_id": "3d51da2d-c700-427b-8c45-b957a9ec112e",
                                "sense_id": "8291a142-6338-3cfa-b02f-f3530c6afca4",
                                "text": "„Dann klangen aus der Tiefe alarmierte Männerstimmen empor, dann kreischten Frauen, heulten Kinder.“"
                            },
                            {
                                "example_id": "7b2a7f07-e746-49c3-8622-d1825d780fe5",
                                "sense_id": "8291a142-6338-3cfa-b02f-f3530c6afca4",
                                "text": "„Es folgte eine Männerstimme, und Elísabet fing sofort an, sich nach möglichen Verstecken umzusehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
