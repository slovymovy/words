{
    "word_family": [
        "trickly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "14cd9e09-6893-35d1-9e45-e70877cdc5e9",
                    "sense_definition": "A very thin, slow flow of liquid or the sound produced by such a flow.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "flow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The leaky tap produced a constant <w>trickle</w> that kept me awake all night."
                        },
                        {
                            "text": "After the heavy rain, the river was reduced to a mere <w>trickle</w> of muddy water."
                        }
                    ],
                    "synonyms": [
                        "drip",
                        "stream"
                    ],
                    "antonyms": [
                        "torrent",
                        "flood"
                    ],
                    "common_phrases": [
                        "mere trickle",
                        "steady trickle"
                    ]
                },
                {
                    "sense_id": "2af16285-b0cc-3ec3-985f-9921edd72213",
                    "sense_definition": "A small, narrow stream of water.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "flow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mountain brook had shrunk to a tiny <w>trickle</w> during the dry summer months."
                        },
                        {
                            "text": "We followed the <w>trickle</w> until it joined the larger river downstream."
                        }
                    ],
                    "synonyms": [
                        "brook",
                        "streamlet"
                    ],
                    "common_phrases": [
                        "mountain trickle"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "27fbfdc8-fb6b-39dc-8af1-b5beea654a8f",
                    "sense_definition": "To flow or move in a very thin, slow, or continuous stream.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "flow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Water began to <w>trickle</w> down the walls after the pipe burst."
                        },
                        {
                            "text": "Disappointed fans started to <w>trickle</w> out of the stadium before the game ended."
                        }
                    ],
                    "synonyms": [
                        "drip",
                        "ooze",
                        "seep"
                    ],
                    "antonyms": [
                        "gush",
                        "pour"
                    ],
                    "common_phrases": [
                        "trickle down",
                        "trickle out"
                    ]
                },
                {
                    "sense_id": "fb6d7821-9c54-34c3-99c8-c11725008710",
                    "sense_definition": "To cause a liquid to flow in a very thin, slow stream.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "flow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The nurse carefully <w>trickled</w> the medicine into the patient's mouth."
                        },
                        {
                            "text": "She <w>trickled</w> a little oil into the pan to prevent sticking."
                        }
                    ],
                    "synonyms": [
                        "drip",
                        "pour"
                    ]
                },
                {
                    "sense_id": "33d2324a-7650-3b9b-b419-1b72976bdcfc",
                    "sense_definition": "To move or roll slowly and often aimlessly.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "move",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ball <w>trickled</w> slowly across the grass and stopped near the goal line."
                        },
                        {
                            "text": "The marbles <w>trickled</w> through the narrow archway during the game."
                        }
                    ],
                    "synonyms": [
                        "roll",
                        "drift"
                    ]
                }
            ]
        }
    ]
}