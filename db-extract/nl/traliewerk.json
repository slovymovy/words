                        "examples": [
                            {
                                "example_id": "c1d4aed9-d416-4ef8-a5de-e97d1c78731b",
                                "sense_id": "c79f77c0-56c9-3d99-b249-1cf3ef6b667d",
                                "text": "Uit het dierenasiel in Enschede zijn afgelopen weekend twee straatkatten gestolen. De dieren, van wie er één ziek is, zaten in het dierenasiel in quarantaine. De daders zijn binnengekomen door het traliewerk van de quarantaineafdeling te verwijderen."
                            },
                            {
                                "example_id": "87f7fe11-53b5-4606-8526-1d63107cbcd1",
                                "sense_id": "c79f77c0-56c9-3d99-b249-1cf3ef6b667d",
                                "text": "De piloot werd begin februari vorig jaar door IS-strijders in een traliewerk gevangen gezet en in brand gestoken."
                            }
                        ]
                    }
