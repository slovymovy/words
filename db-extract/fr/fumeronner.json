                "senses": [
                    {
                        "sense_id": "11a7dcff-a726-3898-8411-3fe31802080e",
                        "entry_id": "28c0a969-e4da-34ac-ad88-28f8983aa371",
                        "glosses": [
                            "Fumer comme un morceau de bois pas complètement carbonisé (un fumeron)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb3dca41-e314-4bec-bff8-a84aa5ba515f",
                                "sense_id": "11a7dcff-a726-3898-8411-3fe31802080e",
                                "text": "Vous regardez notre lampe ? Une ferraille, mais qui nous économise la bougie. Y a un bidon d'huile cont´e le mur, pour la remplir ; mais surtout, veillez-y, si on la laisse se vider, le coton fumeronne, et ça pue."
                            }
                        ]
                    },
                    {
                        "sense_id": "51b1a2d1-4710-39f6-919a-256eb89c6c90",
                        "entry_id": "28c0a969-e4da-34ac-ad88-28f8983aa371",
                        "glosses": [
                            "Fumailler."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "b5682600-9970-423c-8491-131259c5de04",
                                "sense_id": "51b1a2d1-4710-39f6-919a-256eb89c6c90",
                                "text": "On parle par gestes, autrement dit : par mimiques, avec les mimines. Ça palpe et ça fourrage tout azimut. Ça fumeronne de l'herbe, aussi, et ça prise de la snifette dans les coins."
                            }
                        ]
                    }
