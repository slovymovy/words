                ],
                "senses": [
                    {
                        "sense_id": "55a2d63d-b0fe-3995-95d7-b1bfd0b25673",
                        "entry_id": "ebe17ba6-0f93-32f2-9d18-9c0adc9dd975",
                        "glosses": [
                            "geleerd hebbend zich naar behoren te gedragen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a371540-8f28-4fc7-bb2c-17b2c6144908",
                                "sense_id": "55a2d63d-b0fe-3995-95d7-b1bfd0b25673",
                                "text": "Dus was Tjoek feller, directer en gevaarlijker zichzelf dan onder de huis- en schoolnaam Gerda. Onder die naam was ze braaf en gemanierd en ergens schijnheilig."
                            }
                        ]
                    },
                    {
                        "sense_id": "035a084e-d01e-3a60-8562-baebfa7bffd1",
                        "entry_id": "ebe17ba6-0f93-32f2-9d18-9c0adc9dd975",
                        "glosses": [
                            "met een aangeleerde, onnatuurlijke stijl"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b882d1b-48c9-4f4a-8e17-8140ac20d0b5",
                                "sense_id": "035a084e-d01e-3a60-8562-baebfa7bffd1",
                                "text": "De eigen stijl achtten zij daar precies tussenin, noch gemanierd, noch ruw, maar echt beschaafd en toch ‘natuurlijk’."
                            }
                        ]
                    },
                    {
                        "sense_id": "cab46237-b13d-3a72-8420-d977189f8e7a",
                        "entry_id": "ebe17ba6-0f93-32f2-9d18-9c0adc9dd975",
                        "glosses": [
                            "goed geordend"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "2e701de6-275d-40a7-bbaf-9a72c2a5efd7",
                                "sense_id": "cab46237-b13d-3a72-8420-d977189f8e7a",
                                "text": "De verdiensten van dit stuk zijn eerder te vinden in de samenstelling en in den dialoog. De samenstelling is zonder leemten en zonder overlading, goed overwogen en kunstig als een hecht en sierlijk gebouw; de dialoog is goed gemanierd en natuur-getrouw tevens geschreven."
                            }
                        ]
                    }
                ],
