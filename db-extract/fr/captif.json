        "fr-extract.jsonl": [
            {
                "entry_id": "774bb4fc-e4f8-3fd0-9f1b-94f545d3be8a",
                "word": "captif",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "dc427f7c-1504-4e2d-b176-10b90dc03160",
                        "entry_id": "774bb4fc-e4f8-3fd0-9f1b-94f545d3be8a",
                        "tags": [
                            "plural",
