                        "glosses": [
                            "Gebäudeabdeckung eines Stalles"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51985afb-bf7d-47cb-bdca-e13dc6671cc2",
                                "sense_id": "2180e40c-44d1-30c6-ab9b-fd44868221f0",
                                "text": "„Glück hatten Donnerstagmittag vier Personen vor einem Stallgebäude in Windorf, als plötzlich ein Auspuffrohr eines Motorflugzeuges auf das Stalldach fiel.“"
                            },
                            {
                                "example_id": "a7018e0c-128c-4efa-8a08-c3274a561c6a",
                                "sense_id": "2180e40c-44d1-30c6-ab9b-fd44868221f0",
                                "text": "„Man hat in den Alpen 3000 Jahre alte Fundamente für Kuhunterstände gefunden, doch während die Ziegen die kalte Nacht unter einem Stalldach verbringen dürfen, müssen sich die Kühe unter Bäumen selbst Schutz suchen, für sie gibt es keine Dächer mehr, da nicht genug Geld in die Almwirtschaft investiert wird, um neue zu bauen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
