                                "target_senses": [
                                    {
                                        "sense_id": "1300de35-5fb1-3305-982a-f090622ed641",
                                        "entry_id": "bb9ed9d6-dfad-3e7d-87c6-d2470cc56a0e",
                                        "glosses": [
                                            "Relatif aux virus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "295d6b5a-cbe4-4271-bb7e-ffce849875f0",
                                                "sense_id": "1300de35-5fb1-3305-982a-f090622ed641",
                                                "text": "Une infection virale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4538bca-b010-3044-9df1-ce9cacab20f7",
                                        "entry_id": "bb9ed9d6-dfad-3e7d-87c6-d2470cc56a0e",
                                        "glosses": [
                                            "Qui se propage sur Internet comme un virus."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c77a00a5-cbe4-48fd-9656-076aa6d529b0",
                                                "sense_id": "a4538bca-b010-3044-9df1-ce9cacab20f7",
                                                "text": "Le Gangnam Style du chanteur PSY est un modèle de vidéo virale."
                                            },
                                            {
                                                "example_id": "114feb18-8ffd-4cf0-891f-3d6f3bf18a5e",
                                                "sense_id": "a4538bca-b010-3044-9df1-ce9cacab20f7",
                                                "text": "La vérité, c'est que les vidéos de Bardella sont beaucoup plus virales que celles de Mélenchon, pas très loin de celles d'Emmanuel Macron."
                                            },
                                            {
                                                "example_id": "59b654dd-417c-45f0-8f9a-a60620db6cc0",
                                                "sense_id": "a4538bca-b010-3044-9df1-ce9cacab20f7",
                                                "text": "Plus qu'une volonté de trivialiser la politique, il attesterait de l'effacement du discours politique derrière d'autres marqueurs, plus forts et plus viraux: les filtres, les effets de montage et les chansons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51fa17f5-a237-3b6a-aa99-fc98b86f5168",
                                        "entry_id": "bb9ed9d6-dfad-3e7d-87c6-d2470cc56a0e",
                                        "glosses": [
                                            "Relatif à un élément de droit qui reste valable pour des objets relatifs à l'objet sur lequel le droit s’applique initialement."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1af8e79b-c0c7-42d5-b6d9-92b632e6f260",
                                                "sense_id": "51fa17f5-a237-3b6a-aa99-fc98b86f5168",
                                                "text": "Parce que plein de boîtes refusent d'utiliser des licences virales. Ils n'ont aucune envie de devoir fournir le code source de leurs produits propriétaires parce qu'un ingénieur a utilisé une bibliothèque ou un outil qui contamine le produit final."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
