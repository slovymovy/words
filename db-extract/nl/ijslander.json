                    {
                        "translation_id": "100edc87-2fb8-43b7-b75c-b1c1a9546d43",
                        "source_entry_id": "b14ec402-c05c-323a-849a-137e602c6d2b",
                        "source_sense_id": "b9164bc5-ee97-35be-b46e-c8b95b215ff0",
