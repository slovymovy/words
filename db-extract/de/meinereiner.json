                "entry_id": "b3738c71-4398-3e2a-a523-93bd4802d195",
                "word": "meinereiner",
                "pos": "pron",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5a80e27a-c4a5-3fef-a3d8-3a070c4abc7b",
                        "entry_id": "b3738c71-4398-3e2a-a523-93bd4802d195",
                        "glosses": [
                            "ich"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "ebf7e938-ba9f-42cc-a28d-e3ce7161cf06",
                                "sense_id": "5a80e27a-c4a5-3fef-a3d8-3a070c4abc7b",
                                "text": "Meinereiner braucht nicht viel."
                            },
                            {
                                "example_id": "d215cfd9-2877-41f6-9f24-efef4c96d2a0",
                                "sense_id": "5a80e27a-c4a5-3fef-a3d8-3a070c4abc7b",
                                "text": "„Meinereiner würde das den Fachleuten überlassen, denkt der Hausmeister.“"
                            },
                            {
                                "example_id": "10bbacd0-2628-4d33-b245-990fb56ae344",
                                "sense_id": "5a80e27a-c4a5-3fef-a3d8-3a070c4abc7b",
                                "text": "„Für Tänze, Singsang und derlei Ding hatte meinereiner nie einen ausgeprägten Sinn.“"
                            },
                            {
                                "example_id": "a5361d87-6720-420f-852b-963112a7031d",
                                "sense_id": "5a80e27a-c4a5-3fef-a3d8-3a070c4abc7b",
                                "text": "„Meinereiner ertappte sich dabei, dass das Interesse an der kriminellen Geschichte flott den Bach hinunterging, während der Sehsinn ganz scharf darauf war, die Stadtansichten richtig zu verankern.“"
                            },
                            {
                                "example_id": "88f2bb03-7a6c-4cde-82ec-ae9ca1ce15da",
                                "sense_id": "5a80e27a-c4a5-3fef-a3d8-3a070c4abc7b",
                                "text": "„Da kann meinereiner nur den Kopp schütteln.“"
                            },
                            {
                                "example_id": "4ce85210-31aa-471b-bf94-7cb59f336eae",
                                "sense_id": "5a80e27a-c4a5-3fef-a3d8-3a070c4abc7b",
                                "text": "„Meinereiner würde sagen, der Rossi soll die Sache in die Hand nehmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
