                    },
                    {
                        "translation_id": "db8a10fd-e6ba-46d2-9971-897483fb19c2",
                        "source_entry_id": "0882fab8-2c2b-37b2-af36-d4d5da4754c0",
                        "source_sense_id": "a77912d8-9ebe-3b14-b277-90af32a17fdf",
                        "target_lang_word": "Heiligenmaler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "66eee679-aa92-4ec5-b88b-ba4505758b4c",
                        "source_entry_id": "0882fab8-2c2b-37b2-af36-d4d5da4754c0",
                        "source_sense_id": "a77912d8-9ebe-3b14-b277-90af32a17fdf",
                        "target_lang_word": "iconographe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "iconographe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f84c3e4a-3bc2-3df9-8c2e-be4d70c1c7a1",
                                        "entry_id": "367bf37f-88b9-3e24-a70c-cda58988dc03",
                                        "glosses": [
                                            "Peintre d’icônes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd23c5bf-c566-4ffc-ba43-500b6e9c83e6",
                                                "sense_id": "f84c3e4a-3bc2-3df9-8c2e-be4d70c1c7a1",
                                                "text": "Chaque élève fixe du regard sa planche de bois recouverte d’enduit, y appliquant tantôt de fines couches de peinture à base de pigments naturels, tantôt des feuilles d’or. Des croquis au crayon parsèment les murs de pierre claire, tandis que d’épais livres posés sur les tables offrent leur science aux apprentis iconographes. On y apprend comment représenter Pierre et sa barbe bouclée, Paul et son front dégarni […] L’atmosphère est plus recueillie que dans un cours de peinture ordinaire. Car ici, on apprend à écrire des icônes, ces « portes ouvertes sur le ciel »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80e488f2-7390-326e-af50-5a8d0e10f2f2",
                                        "entry_id": "367bf37f-88b9-3e24-a70c-cda58988dc03",
                                        "glosses": [
                                            "Spécialiste de l’iconographie ; professionnel de l’image, chargé notamment de chercher des illustrations (photographies, dessins…) pour des publications."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8a626d0-076c-45e2-a5b5-8c1f71ecba5a",
                                                "sense_id": "80e488f2-7390-326e-af50-5a8d0e10f2f2",
                                                "text": "Henri Focillon, pour empêcher les excès possibles des iconographes, que les magnifiques résultats obtenus par Émile Mâle auraient pu griser, affirma qu'il serait artificiel de séparer dans l'œuvre l'intention qu'y mettait son auteur."
                                            },
                                            {
                                                "example_id": "8e6ee042-f489-4b87-8acb-20e67b45f555",
                                                "sense_id": "80e488f2-7390-326e-af50-5a8d0e10f2f2",
                                                "text": "Agnès est documentaliste-iconographe à la « Vie catholique illustrée ». « Je fournis aux journalistes et secrétaires de rédaction les photos en noir et blanc ou en couleurs, destinées à illustrer leurs articles »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
