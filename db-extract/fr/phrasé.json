                                    {
                                        "sense_id": "92048f07-03c3-3a7b-a821-ef700ec7388b",
                                        "entry_id": "f62e250a-5d31-3e27-90ca-ddced2c4acc2",
                                        "glosses": [
                                            "het in frasen onderverdelen, met name gezegd van het articuleren van afzonderlijke muzikale zinnen in een muziekstuk, dat hierdoor als geheel beter moet klinken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1dd6375-52ad-4a69-9c50-48221b44ef41",
                                                "sense_id": "92048f07-03c3-3a7b-a821-ef700ec7388b",
                                                "text": "De frasering van een melodie."
                                            },
                                            {
                                                "example_id": "c41e8766-6f92-4f74-976c-5930f689ae53",
                                                "sense_id": "92048f07-03c3-3a7b-a821-ef700ec7388b",
                                                "text": "Je speelt werkelijk verdienstelijk, Bram, veel aandacht voor detail en je frasering ademt.'"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
