                                                "sense_id": "11f2c07f-4cd1-3f67-8103-7a8444e3d2a9",
                                                "text": "Die Würde des Menschen ist unantastbar."
                                            },
                                            {
                                                "example_id": "1ebc6af2-74b5-4838-829b-3940a58ac03f",
                                                "sense_id": "11f2c07f-4cd1-3f67-8103-7a8444e3d2a9",
