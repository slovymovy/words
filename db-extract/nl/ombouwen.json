                "senses": [
                    {
                        "sense_id": "a2833955-c34a-3753-ad8b-17fdf510d39f",
                        "entry_id": "4fb0a7d7-4576-3d40-bd96-bec210b1bea2",
                        "glosses": [
                            "verbouwen zodat een gebouw een andere functie heeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e905399-1758-4294-b475-7c6e8dd0cb65",
                                "sense_id": "a2833955-c34a-3753-ad8b-17fdf510d39f",
                                "text": "Hij heeft zijn huis laten ombouwen tot een museum."
                            },
                            {
                                "example_id": "347d2a74-bac2-49fa-831f-a3f3bf5847db",
                                "sense_id": "a2833955-c34a-3753-ad8b-17fdf510d39f",
                                "text": "Zelfs de kantorenmarkt is opgeleefd. „Die heeft een hele tijd stilgelegen”, zegt Tromp. Maar in en rond Amsterdam dreigt dankzij de aantrekkende economie en het ombouwen en slopen van kantoren weer krapte te ontstaan, met name voor gebruikers die grote kantoorruimte zoeken."
                            }
                        ]
                    },
                    {
                        "sense_id": "f5c0c5d3-7f00-3d26-a1db-aacd425beea6",
                        "entry_id": "4fb0a7d7-4576-3d40-bd96-bec210b1bea2",
                        "glosses": [
                            "door een operatie van geslacht doen veranderen"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "007da24a-3a80-4b44-8a49-64e8ab2e09ae",
                                "sense_id": "f5c0c5d3-7f00-3d26-a1db-aacd425beea6",
                                "text": "Geen vrouw zo mooi als een omgebouwde man"
                            }
                        ]
                    },
                    {
                        "sense_id": "f8194e41-3283-3ef7-bca0-8cfc3194919a",
                        "entry_id": "4fb0a7d7-4576-3d40-bd96-bec210b1bea2",
                        "glosses": [
                            "van een treinstel dat het geschikt gemaakt is om de andere kant op te rijden."
                        ],
