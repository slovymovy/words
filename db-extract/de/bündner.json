                "senses": [
                    {
                        "sense_id": "d7017931-5f87-32fb-a00d-dff854259d78",
                        "entry_id": "ff03e350-366a-3be5-a37e-7808c2b01748",
                        "glosses": [
                            "den Kanton Graubünden oder dessen Einwohner betreffend"
                        ],
                        "tags": [
                            "Swiss Standard German"
                        ],
                        "examples": [],
