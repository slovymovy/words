                        "entry_id": "52fef042-a359-36a4-be7c-1edfb2c0fc8d",
                        "glosses": [
                            "Appellation qui qualifie le commerce spécialisé en bière de microbrasserie ou en bières artisanales."
                        ],
                        "tags": [
                            "Québec"
                        ],
                        "examples": [
                            {
                                "example_id": "d5cf3814-a3f0-4563-8244-a749d9b8a0ac",
                                "sense_id": "0518ebf3-7bc1-32ec-b858-667cec3273e4",
                                "text": "Tite Frette est la première et plus importante franchise biériste québécoise. Il s’agit d’un réseau de boutiques spécialisées en bières de microbrasserie, vins, cidres et produits du terroir 100 % d’ici."
                            }
                        ]
                    },
                    {
                        "sense_id": "b1cea17e-6b3c-39e1-8332-7cde64c4a1ce",
                        "entry_id": "52fef042-a359-36a4-be7c-1edfb2c0fc8d",
                        "glosses": [
                            "Commerçant au détail des bières de microbrasserie."
                        ],
                        "tags": [
                            "Québec"
                        ],
                        "examples": [
                            {
                                "example_id": "7a25163b-4de7-4da9-adea-2f2ea7084a0d",
                                "sense_id": "b1cea17e-6b3c-39e1-8332-7cde64c4a1ce",
                                "text": "Tite Frette, le biériste québécois annonce l’ouverture d’une seconde succursale à Saint-Jean-sur-Richelieu le 14 avril."
                            },
                            {
                                "example_id": "78c3af8c-38dd-423e-bb53-67373220dab8",
                                "sense_id": "b1cea17e-6b3c-39e1-8332-7cde64c4a1ce",
                                "text": "Le palmarès porte le titre « des plus grands biéristes » mais il est fondé sur un seul indicateur, soit le nombre de variétés de bières de microbrasserie et de bières importées offertes en magasin."
                            }
                        ]
                    }
