                                        "sense_id": "f4aea522-c3ee-373a-8079-603a4b2828d4",
                                        "entry_id": "2b7e8f59-dd87-360c-b8ba-a40e32419ba9",
                                        "glosses": [
                                            "Person oder Institution, welche einen Preis in Form von Geld oder anderen Wertgegenständen aus einer Lotterie oder einem anderen Spiel erhält"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "091387e6-8e6c-43ff-b535-b434c2748b02",
                                                "sense_id": "f4aea522-c3ee-373a-8079-603a4b2828d4",
                                                "text": "Dem Gewinner des Preisausschreibens winken 30.000 Euro in bar."
                                            },
                                            {
                                                "example_id": "ffd45a60-8d6b-450c-842f-98e4a9325689",
                                                "sense_id": "f4aea522-c3ee-373a-8079-603a4b2828d4",
                                                "text": "Die Gewinner der TV-Rateshow reisen für eine Woche nach Interlaken."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
