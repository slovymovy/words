                "senses": [
                    {
                        "sense_id": "0dc59684-9a15-3fc4-a635-c529ac8060b2",
                        "entry_id": "fcb7f689-a9c8-3324-8cfc-f7ad7ed1171f",
                        "glosses": [
                            "Tiefe der Verankerung eines Glases im Rahmen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8558b6c3-f483-4ac9-bb6d-457ef0914834",
                                "sense_id": "0dc59684-9a15-3fc4-a635-c529ac8060b2",
                                "text": "„Der Glaseinstand soll in der Regel 2/3 der Glasfalzhöhe betragen, darf jedoch 20 mm nicht überschreiten […].“"
                            },
                            {
                                "example_id": "f55384af-df65-49c8-b834-e2fbcf4512df",
                                "sense_id": "0dc59684-9a15-3fc4-a635-c529ac8060b2",
                                "text": "„Die freie Glasfalzhöhe richtet sich nach der Klotzdicke, muss jedoch > 5 mm sein.“"
                            },
                            {
                                "example_id": "0a0252be-5be5-4af1-bb74-fab9ef44246a",
                                "sense_id": "0dc59684-9a15-3fc4-a635-c529ac8060b2",
                                "text": "„Bei Glasfalzen soll der Einstand zwischen den Leisten bei nicht vorgespannten Gläsern mindestens zwei Drittel der Glasfalzhöhe betragen, maximal jedoch 20 mm […].“"
                            },
                            {
                                "example_id": "06c1989a-46ff-4fc1-a619-04ab615e9f30",
                                "sense_id": "0dc59684-9a15-3fc4-a635-c529ac8060b2",
                                "text": "„Entsprechend der Glasgröße und Glasstärke werden die Glasfalzhöhe und Glasfalzbreite ermittelt.“"
                            },
                            {
                                "example_id": "734e0909-db2f-4530-993d-9953f00b4863",
                                "sense_id": "0dc59684-9a15-3fc4-a635-c529ac8060b2",
                                "text": "„Eine einschließlich Glasfalzhöhe gemessene Scheibe von z. B. 50,3 cm Breite und 140,1 cm Höhe ist also auf 51,0 cm mal 141,0 cm aufzurunden.“"
                            }
                        ],
