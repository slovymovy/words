                "senses": [
                    {
                        "sense_id": "cbfb7700-7a07-3854-b6de-c8b682cd9a48",
                        "entry_id": "3e6d307c-32c8-3620-bc05-a4a05e849737",
                        "glosses": [
                            "Handwerk, dessen Aufgabe die Herstellung von Sätteln und anderen Gegenständen aus Leder ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "758cb6cb-3821-4a4a-acce-8ce92fce4586",
                                "sense_id": "cbfb7700-7a07-3854-b6de-c8b682cd9a48",
                                "text": "„Rechts ist Houstons Sattlerei, vor ihr hockt Houstons vierjähriger Junge mit einem Spielkameraden am Gehsteigrand und schaufelt Sand in einen Eimer.“"
                            },
                            {
                                "example_id": "eb30a362-7aa4-49ce-9c00-7a87b828251f",
                                "sense_id": "cbfb7700-7a07-3854-b6de-c8b682cd9a48",
                                "text": "„Dort, wo der Qualm aus einer Häuserlücke trieb, entdeckte Tom das Schild einer Sattlerei.“"
                            },
                            {
                                "example_id": "ea54bfec-9661-49cc-8108-0c4fa047d1b1",
                                "sense_id": "cbfb7700-7a07-3854-b6de-c8b682cd9a48",
                                "text": "„Da Deutschland im Vergleich zu den USA wesentlich rigider im Umgang mit Bildungsnachweisen, Zertifikaten, Gewerberegelungen umging, beschloss ich, bei der Handwerkskammer eine Prüfung zur Meisterin für Sattlerei zu machen.“"
                            }
                        ],
