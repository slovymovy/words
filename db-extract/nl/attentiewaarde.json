                        "examples": [
                            {
                                "example_id": "622282d9-d6e2-4fbb-b945-aa42fc257a13",
                                "sense_id": "30f106b4-e99f-3ebd-8e03-a17382475ed6",
                                "text": "De nieuwe eigenaar bewaarde het object vanwege de attentiewaarde: zijn kinderen namen het wel eens mee naar school voor een spreekbeurt. Verder bleef hij hem gebruiken als deurstopper."
                            },
                            {
                                "example_id": "2fe1039e-9fe8-49d1-b82b-f961690df231",
                                "sense_id": "30f106b4-e99f-3ebd-8e03-a17382475ed6",
                                "text": "Waar de attentiewaarde van het treffen met de nodige fantasie hooguit een uiterst magere voldoende was, repte Van Dijk na afloop van \"een solide zege\". Grootste winst van de avond: \"We hebben niets weggegeven.\""
                            }
                        ]
                    }
