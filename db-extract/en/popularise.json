                        "sense_id": "cbd862a1-5558-389c-a433-1d88ef68258c",
                        "entry_id": "fdb63093-c999-3edc-bf82-af700c448ad9",
                        "glosses": [
                            "To make something popular."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "833f91c9-277e-4d71-82de-e52b32f82488",
                                "sense_id": "cbd862a1-5558-389c-a433-1d88ef68258c",
                                "text": "Homer Simpson popularised the term \"d'oh\"."
                            },
                            {
                                "example_id": "773f3130-4028-4c25-9c41-61a35c428a1a",
                                "sense_id": "cbd862a1-5558-389c-a433-1d88ef68258c",
                                "text": "Towards the end of August, the Southern Railway decided to adopt a novel form of publicity to popularise the services. Sandwich board men were employed at Charing Cross and Cannon Street to display placards, and distribute leaflet timetables, calling attention to the vacant seats on the services via Nunhead."
                            },
                            {
                                "example_id": "5408b208-a72d-4019-962a-0e43e009407b",
                                "sense_id": "cbd862a1-5558-389c-a433-1d88ef68258c",
                                "text": "Special cheap day return facilities have been introduced to popularise the railbuses."
                            }
                        ]
                    },
                    {
                        "sense_id": "56498346-a73a-3f56-a080-6564954f17a4",
                        "entry_id": "fdb63093-c999-3edc-bf82-af700c448ad9",
                        "glosses": [
                            "To present information in a form less difficult for the general public to understand or enjoy, especially by excluding details and jargon found in technical or academic publications."
