{
    "word_family": [
        "scuff"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cde9bb78-86c9-31af-9967-1f823d58f7f1",
                    "sense_definition": "A mark or scratch on a surface caused by rubbing or scraping.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "marks",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The floor was covered in black <w>scuffing</w> from the heavy furniture.",
                            "target_lang_translations": {
                                "cs": "Podlaha byla pokrytá černými <w>šmouhami</w> od těžkého nábytku."
                            }
                        },
                        {
                            "text": "She tried to clean the <w>scuffing</w> off the wall with a damp cloth.",
                            "target_lang_translations": {
                                "cs": "Snažila se tu <w>odřeninu</w> ze zdi očistit vlhkým hadříkem."
                            }
                        }
                    ],
                    "synonyms": [
                        "scratch",
                        "mark",
                        "scrape"
                    ],
                    "target_lang_definitions": {
                        "cs": "Značka nebo škrábanec na povrchu způsobený třením nebo odřením."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "odřenina",
                                "target_lang_sense_clarification": "povrchové poškození materiálu"
                            },
                            {
                                "target_lang_word": "šmouha",
                                "target_lang_sense_clarification": "tmavá stopa po otěru"
                            },
                            {
                                "target_lang_word": "škrábanec",
                                "target_lang_sense_clarification": "rýha v povrchu"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "73d0d18c-f192-3fb0-a9b8-b35ad2e4a72c",
                    "sense_definition": "Present participle and gerund of <w>scuff</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>scuffing</w> his feet along the hallway while walking to school.",
                            "target_lang_translations": {
                                "cs": "Cestou do školy <w>šoural</w> nohama po chodbě."
                            }
                        },
                        {
                            "text": "Stop <w>scuffing</w> your shoes on the pavement or they will wear out.",
                            "target_lang_translations": {
                                "cs": "Přestaň si <w>odírat</w> boty o chodník, jinak se ti zničí."
                            }
                        }
                    ],
                    "common_phrases": [
                        "scuffing feet"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "This is a grammatical form of the verb scuff."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Přítomné příčestí a gerundium slovesa scuff (šourat, odírat)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "šourání",
                                "target_lang_sense_clarification": "pohyb nohou po zemi"
                            },
                            {
                                "target_lang_word": "odírání",
                                "target_lang_sense_clarification": "poškozování povrchu třením"
                            }
                        ]
                    }
                }
            ]
        }
    ]
