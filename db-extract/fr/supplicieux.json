                        "glosses": [
                            "Qui inflige un supplice."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "27dcced1-bab2-4f85-a5be-f20e456f3750",
                                "sense_id": "d134a1c1-fb87-323d-beb5-b6696d8da463",
                                "text": "Pour se soustraire au supplicieux pansement qui les attendait, elles s’enfuirent de toute la vitesse de leurs jambes boiteuses […]."
                            },
                            {
                                "example_id": "25a60354-05a0-48e7-a46a-b3639c37807b",
                                "sense_id": "d134a1c1-fb87-323d-beb5-b6696d8da463",
                                "text": "Seule planait l’ombre de la Kampétaï, prête à abattre sa lourde main supplicieuse pour étouffer dans l’œuf toute velléité d’insoumission."
                            },
                            {
                                "example_id": "e587d57f-8687-4b28-b5b4-3ef83d4465fb",
                                "sense_id": "d134a1c1-fb87-323d-beb5-b6696d8da463",
                                "text": "Mieux vaut la glorieuse fin d’un ver insurgent, qu’une vie longue et supplicieuse traînée sous des despotes vindicatifs."
                            }
                        ]
                    }
