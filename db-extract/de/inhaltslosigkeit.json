                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "21347354-9036-3357-899b-335fe9382dfb",
                                        "entry_id": "c9f60c09-ca7b-3720-906f-8f876aef36c1",
                                        "glosses": [
                                            "The state, quality, or characteristic of being bland.",
                                            "Lack of interest or appeal."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
