                "senses": [
                    {
                        "sense_id": "ae796270-2059-3efc-86d2-54e0fb8391ae",
                        "entry_id": "0794ba7d-f4aa-30b9-8780-f244fbe2924e",
                        "glosses": [
                            "A parrot."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f537e891-3026-407b-9da4-b2c14c006603",
                                "sense_id": "ae796270-2059-3efc-86d2-54e0fb8391ae",
                                "text": "[I]nnumerable popingayes of ſundry kindes are found chattering in the groues of thoſe fenny places."
                            }
                        ]
                    },
                    {
                        "sense_id": "a7a5b036-219d-3631-a15d-fee0e9a5ecc0",
                        "entry_id": "0794ba7d-f4aa-30b9-8780-f244fbe2924e",
                        "glosses": [
                            "A decorative image of a parrot on a tapestry, cloth etc."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "e9ef6539-5f8a-39a7-bf0f-94974976dd05",
                        "entry_id": "0794ba7d-f4aa-30b9-8780-f244fbe2924e",
                        "glosses": [
                            "A vain, gaudy person; someone who is shallow or superficial."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "210c5bb8-fb1d-4f16-9bd7-66328acc1fed",
                                "sense_id": "e9ef6539-5f8a-39a7-bf0f-94974976dd05",
                                "text": "The very quintessence of popinjay vulgarity is reached when nicely is made to do service for well, in this wise: \"How do you do?\" \"Nicely.\" \"How are you?\" \"Nicely.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "64a65c79-c5ba-31ac-882d-d1973b480def",
                        "entry_id": "0794ba7d-f4aa-30b9-8780-f244fbe2924e",
                        "glosses": [
                            "A target to shoot at, typically stuffed with feathers or plumage."
                        ],
                        "tags": [],
                        "examples": []
                    },
