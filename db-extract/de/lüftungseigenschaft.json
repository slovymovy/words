                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aec9918f-cd34-47fd-8f14-03a0737365de",
                                "sense_id": "695c603e-4709-3e71-9787-fefe3b18560d",
                                "text": "„Das rechteckige Schwingfenster, mit seinen hervorragenden Lüftungseigenschaften erfreut sich wieder zunehmender Beliebtheit.“"
                            },
                            {
                                "example_id": "fbf03b57-1d9c-4a7e-a08a-87db36d6e746",
                                "sense_id": "695c603e-4709-3e71-9787-fefe3b18560d",
                                "text": "„Dank der Lüftungseigenschaften unterstützt es die thermischen Anforderungen der Intel Fly Creek und Mainstream Mini ITX Motherboards.“"
                            },
                            {
                                "example_id": "331c9f70-8fbf-4011-aba6-a5288bf4cd14",
                                "sense_id": "695c603e-4709-3e71-9787-fefe3b18560d",
                                "text": "„Einfallendes Sonnenlicht ist die perfekte Beleuchtung beim Kochen - und durch die Lüftungseigenschaften ziehen Dampf und Gerüche rasch ab.“"
                            },
                            {
                                "example_id": "fd9a48bf-9a03-43c1-be45-0f8c2dfa1191",
                                "sense_id": "695c603e-4709-3e71-9787-fefe3b18560d",
                                "text": "„Softshield 4X4 Stretch ist ein einschichtiges, wasserabweisendes, hochelastisches Material mit ausgezeichneter Lüftungseigenschaft.“"
                            },
                            {
                                "example_id": "eb3e4181-b4cc-4ed9-a650-77c3385bdf59",
                                "sense_id": "695c603e-4709-3e71-9787-fefe3b18560d",
                                "text": "„Im Gegensatz dazu sind Schießstände, die ausschließlich von Sportschützen betrieben werden, lediglich an eine Schießstandrichtlinie gebunden, in der vor allem die Lüftungseigenschaften bzw. die Lüftungsleistung geregelt wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
