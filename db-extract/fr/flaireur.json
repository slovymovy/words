                        "sense_id": "3714c7aa-fb3f-33df-940d-ab92cdbf353b",
                        "entry_id": "29e9f9dd-5d2a-38f8-b837-72cca3795a6b",
                        "glosses": [
                            "Qui flaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9fd53374-028a-4a3c-a436-5ccd48acf028",
                                "sense_id": "3714c7aa-fb3f-33df-940d-ab92cdbf353b",
                                "text": "Je parie qu’il est porté sur la chose, lui… J’ai vu cela, tout de suite, à son nez mobile, flaireur, sensuel, à ses yeux extrêmement brillants, doux en même temps que rigolos…"
                            }
                        ]
                    }
                ],
