                    {
                        "sense_id": "dec2f69e-0e53-3d1d-b933-a362875e6f65",
                        "entry_id": "a68d83db-8b59-3319-a6f6-fd40f12c7102",
                        "glosses": [
                            "Joueur de rugby."
                        ],
                        "tags": [
                            "Faux anglicisme"
                        ],
                        "examples": [
                            {
                                "example_id": "122039f5-26ae-4e65-842e-904cb3cf5bf2",
                                "sense_id": "dec2f69e-0e53-3d1d-b933-a362875e6f65",
                                "text": "Les pompiers, les rugbymen et même les commerçants l'ont fait."
                            },
                            {
                                "example_id": "ef00d844-4eb4-44a0-bcc9-7ea44d7f3bce",
                                "sense_id": "dec2f69e-0e53-3d1d-b933-a362875e6f65",
                                "text": "Après sa carrière de rugbyman, Jean-Pierre Rives s’est reconverti dans l’art contemporain, la sculpture et la peinture."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "20b289c1-32ac-41f2-869c-6f7ee9b3b6a7",
                        "source_entry_id": "a68d83db-8b59-3319-a6f6-fd40f12c7102",
                        "source_sense_id": "dec2f69e-0e53-3d1d-b933-a362875e6f65",
                        "source_sense_description": "Joueur de rugby",
                        "target_lang_word": "Rugbyspieler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rugbyspieler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b5838580-50aa-3ec2-8413-f8851b58a0bf",
                                        "entry_id": "e913f1df-4751-3724-9848-5ddeb02a7605",
                                        "glosses": [
                                            "jemand, der Rugby spielt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a00ed44-21dc-4a9e-8721-f2477091285a",
                                                "sense_id": "b5838580-50aa-3ec2-8413-f8851b58a0bf",
                                                "text": "„Griessel war das Gerücht zu Ohren gekommen, Dekker sei das Kind eines französischen Rugbyspielers.“"
                                            },
                                            {
                                                "example_id": "ce80fb6a-c2f6-471f-bb2e-cc649cf2a376",
                                                "sense_id": "b5838580-50aa-3ec2-8413-f8851b58a0bf",
                                                "text": "„In gewisser Hinsicht waren die Leute von der Tragödie am Donner-Pass besser dran, sagt Graf Schandmaul und schreibt etwas in seinen Notizblock. Und auch das Flugzeug mit den südamerikanischen Rugbyspielern, das 1972 in den Anden notlanden musste.“"
                                            },
                                            {
                                                "example_id": "ea3979f7-38f2-4cdd-b3eb-0dece9fcf03a",
                                                "sense_id": "b5838580-50aa-3ec2-8413-f8851b58a0bf",
                                                "text": "„STELL DIR MAL VOR, WIE GROSS UNSERE KINDER WÄREN! RUGBYSPIELER, MODELS UND SO.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
