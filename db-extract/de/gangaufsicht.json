                "senses": [
                    {
                        "sense_id": "f8579cf6-5e43-3b5f-a752-1903044712b3",
                        "entry_id": "8b3484a5-5739-3ebf-8cfa-6a9a047128a6",
                        "glosses": [
                            "Verantwortung für Kinder in der unterrichtsfreien Zeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77115f26-0dab-4e70-ade9-46b9fc890d3b",
                                "sense_id": "f8579cf6-5e43-3b5f-a752-1903044712b3",
                                "text": "„Auch wurde sie im März 2007 bereits einmal vom Amt der Steiermärkischen Landesregierung wegen dienstrechtlicher Verfehlungen ermahnt (Nachsitzen von Schülern, Nichthalten einer Gangaufsicht und von zwei Supplierstunden, frühzeitiges Beenden einer Unterrichtsstunde).“"
                            },
                            {
                                "example_id": "43bc5d93-36bc-4fe0-8b83-1cf7a3a0f92a",
                                "sense_id": "f8579cf6-5e43-3b5f-a752-1903044712b3",
                                "text": "„Die helfen ja noch nicht mal Mrs Lynch bei der Gangaufsicht.“"
                            },
                            {
                                "example_id": "4ae5d30f-507b-41ee-891f-632ee9ed40c5",
                                "sense_id": "f8579cf6-5e43-3b5f-a752-1903044712b3",
                                "text": "„Als sie sieht, dass ich es bin und nicht die Gangaufsicht, entspannt sie sich wieder und lächelt schüchtern.“"
                            },
                            {
                                "example_id": "58fca2d7-160f-4395-833c-7603c1223fd4",
                                "sense_id": "f8579cf6-5e43-3b5f-a752-1903044712b3",
                                "text": "„Eintreffen in der Schule, zwei Mal pro Woche 15 Minuten früher, da Gangaufsicht.“"
                            },
                            {
                                "example_id": "010f8098-c334-4803-98fe-9cca5b3de8a9",
                                "sense_id": "f8579cf6-5e43-3b5f-a752-1903044712b3",
                                "text": "„Aus Überwachung folge zwar immer eine Einschränkung der Privatsphäre, aber eine Gangaufsicht gründe wenigstens auf Zwischenmenschlichkeit, betonen die Schüler.“"
                            },
                            {
                                "example_id": "54848cc0-4ab2-40ef-b88b-957a9a1dcb43",
                                "sense_id": "f8579cf6-5e43-3b5f-a752-1903044712b3",
                                "text": "„Sie ließ das Gerät wenige Minuten in einer Klasse liegen, während sie Gangaufsicht hatte, doch den Schülern reichten diese wenigen Minuten völlig aus.“"
                            },
                            {
                                "example_id": "607b85b5-3652-443a-9268-0381c7dc9011",
                                "sense_id": "f8579cf6-5e43-3b5f-a752-1903044712b3",
                                "text": "„Seine Kollegin Katsch wich ihm nunmehr aus, sowohl bei der Gangaufsicht als auch im Konferenzzimmer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
