                    },
                    {
                        "translation_id": "033201a5-0b6c-4702-be90-652e30245424",
                        "source_entry_id": "f3220005-04af-3212-9ff4-001378b57b5b",
                        "source_sense_description": "closely; by a narrow margin",
                        "target_lang_word": "étroitement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "étroitement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "92a4638c-d01f-3fc8-819f-c8c45e05837b",
                                        "entry_id": "650db27b-71f1-358d-baf9-24d018a57acf",
                                        "glosses": [
                                            "À l’étroit, dans un espace resserré."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eea62530-d106-4ffb-80cc-78fddb6bb84f",
                                                "sense_id": "92a4638c-d01f-3fc8-819f-c8c45e05837b",
                                                "text": "Vous êtes logé bien étroitement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5858371-8232-32d1-8186-e8e953717208",
                                        "entry_id": "650db27b-71f1-358d-baf9-24d018a57acf",
                                        "glosses": [
                                            "D’une manière étroite, serrée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0859b5a1-5683-489f-9258-9e9b92178ef5",
                                                "sense_id": "a5858371-8232-32d1-8186-e8e953717208",
                                                "text": "Ils se tenaient embrassés étroitement."
                                            },
                                            {
                                                "example_id": "34842d03-80f8-4e72-995c-d0c1cb9d100a",
                                                "sense_id": "a5858371-8232-32d1-8186-e8e953717208",
                                                "text": "Ils sont étroitement liés."
                                            },
                                            {
                                                "example_id": "22a67a61-409a-475d-8480-0bcda835dccd",
                                                "sense_id": "a5858371-8232-32d1-8186-e8e953717208",
                                                "text": "C’est dans cette sainte maison qu’elles venaient s’unir par la foi et par la charité plus étroitement qu’elles n’étaient unies par le sang et par la nature […]"
                                            },
                                            {
                                                "example_id": "5e5718d2-cbaf-4e02-a22f-b74023ba1409",
                                                "sense_id": "a5858371-8232-32d1-8186-e8e953717208",
                                                "text": "Dans son voyage d’Italie, il se lia étroitement avec le cardinal Corsini, qui fut depuis Clément XII […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb009a78-004c-3f81-8bb1-a90b90eaa250",
                                        "entry_id": "650db27b-71f1-358d-baf9-24d018a57acf",
                                        "glosses": [
                                            "Rigoureusement, avec rigueur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c22c720-3b9f-40e6-9712-54e2b84455ab",
                                                "sense_id": "bb009a78-004c-3f81-8bb1-a90b90eaa250",
                                                "text": "Observer étroitement le carême."
                                            },
                                            {
                                                "example_id": "96a5788f-3e93-4880-b8ed-9134593cee24",
                                                "sense_id": "bb009a78-004c-3f81-8bb1-a90b90eaa250",
                                                "text": "[…] de sorte qu’il oblige étroitement tous les Français […] de reconnaître et de confesser qu’ils n’ont plus ces saintes reliques."
                                            },
                                            {
                                                "example_id": "ba0faa17-6d4a-4103-bf85-57139b307a68",
                                                "sense_id": "bb009a78-004c-3f81-8bb1-a90b90eaa250",
                                                "text": "Il faut étroitement observer le silence,\nOu faire d’un secret l’entière confidence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc5842a0-2dfd-3490-9366-f3ef8aada4d9",
                                        "entry_id": "650db27b-71f1-358d-baf9-24d018a57acf",
                                        "glosses": [
                                            "Avec une grande surveillance, parce que plus on est dans un lieu étroit, plus la surveillance est facile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57962bc3-4127-4fb6-85b3-f29bb2a0d682",
                                                "sense_id": "fc5842a0-2dfd-3490-9366-f3ef8aada4d9",
                                                "text": "M. le juge d’instruction Guillot demande, avec raison, que l’on enferme aussi étroitement ces candidats à la folie, ces demi-fous, demi-criminels, demi-responsables dont l’acquittement est arraché à la faiblesse et à la crédulité des jurys."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3f4c807-3aa5-319e-ac17-21d9a0dc109d",
                                        "entry_id": "650db27b-71f1-358d-baf9-24d018a57acf",
                                        "glosses": [
                                            "En vertu d’une obligation étroite, sur toutes choses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "015f98de-6d47-48e9-bf18-ef9839b5436d",
                                                "sense_id": "b3f4c807-3aa5-319e-ac17-21d9a0dc109d",
                                                "text": "[…] scandale qu’il vous est d’autant plus expressément et plus étroitement ordonné de prévenir et d’éviter […]"
                                            },
                                            {
                                                "example_id": "b428630c-56ae-44e0-90cc-a0cdb0cc2094",
                                                "sense_id": "b3f4c807-3aa5-319e-ac17-21d9a0dc109d",
                                                "text": "On lui a étroitement défendu de parler."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "60dce90b-ff80-4e51-990e-88f7e50dacbd",
                        "source_entry_id": "f3220005-04af-3212-9ff4-001378b57b5b",
                        "source_sense_description": "closely; by a narrow margin",
                        "target_lang_word": "eng",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eng",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a3e01310-a249-3de1-8fe9-9f8933d89ae7",
                                        "entry_id": "7233845c-1d36-321b-ae48-05f340756edf",
                                        "glosses": [
                                            "schmal, nahe anliegend; von relativ geringer Ausdehnung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29c1dfc1-75b2-483f-a196-f647ab5cea27",
                                                "sense_id": "a3e01310-a249-3de1-8fe9-9f8933d89ae7",
                                                "text": "Ich habe wohl zugenommen, meine Hose ist jetzt etwas eng."
                                            },
                                            {
                                                "example_id": "d3222db5-33c4-4afb-a565-4ea8924b6efc",
                                                "sense_id": "a3e01310-a249-3de1-8fe9-9f8933d89ae7",
                                                "text": "In der engen Gasse war ein Überholen unmöglich."
                                            },
                                            {
                                                "example_id": "55c0f382-00ad-4318-941e-341fa1608077",
                                                "sense_id": "a3e01310-a249-3de1-8fe9-9f8933d89ae7",
                                                "text": "Wenn du auch noch zum Bäcker willst, wird es eng."
                                            },
                                            {
                                                "example_id": "cce00e8a-dea9-4c4a-9d48-52cc3b8abafb",
                                                "sense_id": "a3e01310-a249-3de1-8fe9-9f8933d89ae7",
                                                "text": "„Um durch das enge Gitter vor dem Fenster zu kommen, muß man fast ein Zirkusakrobat sein, so Blume.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3afef53b-bd20-36b6-94d1-06d62bb6f5eb",
                                        "entry_id": "7233845c-1d36-321b-ae48-05f340756edf",
                                        "glosses": [
                                            "sehr dicht beieinander"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87ae248f-664b-4560-b3d9-7bcc3ab5ca69",
                                                "sense_id": "3afef53b-bd20-36b6-94d1-06d62bb6f5eb",
                                                "text": "Die beiden auf der Tanzfläche müssen sich sehr mögen, so eng wie die miteinander tanzen."
                                            },
                                            {
                                                "example_id": "3cac56b0-371f-4680-a0cd-547894aae19c",
                                                "sense_id": "3afef53b-bd20-36b6-94d1-06d62bb6f5eb",
                                                "text": "Auf der Geburtstagskarte ist nicht viel Platz, du musst ganz eng schreiben."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "284df989-3f45-3da4-95a9-3d4a1bd423b3",
                                        "entry_id": "7233845c-1d36-321b-ae48-05f340756edf",
                                        "glosses": [
                                            "ein intimes Verhältnis besitzend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29c01036-c99d-4b50-aa38-3c98e8c305f9",
                                                "sense_id": "284df989-3f45-3da4-95a9-3d4a1bd423b3",
                                                "text": "Wir sind so eng miteinander, der besorgt mir bestimmt auch eine Eintrittskarte."
                                            },
                                            {
                                                "example_id": "6a91906d-652f-4e7b-9578-19736528b2ba",
                                                "sense_id": "284df989-3f45-3da4-95a9-3d4a1bd423b3",
                                                "text": "Zur Hochzeit kommt nur der engste Freundeskreis."
                                            },
                                            {
                                                "example_id": "be84b3cc-af61-4919-b9e8-212daa2dd3e0",
                                                "sense_id": "284df989-3f45-3da4-95a9-3d4a1bd423b3",
                                                "text": "„Wie eng war die Verbindung zwischen der kleinen Gruppe der Araber in Berlin und der viel größeren Gruppe der Juden gewesen, wie viel hatten Araber in dieser Stadt gerade den Juden zu verdanken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "8488ca52-491f-3523-8c94-e743a00fc796",
                                        "entry_id": "7233845c-1d36-321b-ae48-05f340756edf",
                                        "glosses": [
                                            "keinen Spielraum habend, in Schwierigkeiten steckend"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7fb190f-5f01-4813-b96a-8e4d05528152",
                                                "sense_id": "8488ca52-491f-3523-8c94-e743a00fc796",
                                                "text": "Wenn es um die Deutsche Bank irgendwann eng wird, dann wird es wieder Steuerzahlergelder geben."
                                            },
                                            {
                                                "example_id": "3e7be11a-e077-48a0-9877-f1499eb05a37",
                                                "sense_id": "8488ca52-491f-3523-8c94-e743a00fc796",
                                                "text": "Wenn es für ihn eng wird, steht für Präsident Erdogan der Schuldige oft schon fest."
                                            },
                                            {
                                                "example_id": "023cef77-96e5-49ac-a62e-70a9bf534a01",
                                                "sense_id": "8488ca52-491f-3523-8c94-e743a00fc796",
                                                "text": "\"Wir haben erwartet, dass es eng wird. Wir hätten noch eine Nullrunde gebraucht\", sagte [der Bundestrainer der deutschen Springreiter Otto] Becker: \"Das ist bitter.\""
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            },
