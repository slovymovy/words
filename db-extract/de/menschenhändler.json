                ],
                "senses": [
                    {
                        "sense_id": "2ab24aa8-d0bf-31e3-a029-65421c391f0d",
                        "entry_id": "72b3901c-4103-37cf-b3d9-663c7c983ef4",
                        "glosses": [
                            "jemand, der mit Menschen als Ware handelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5877b53a-1a3c-40ea-8886-543c8ec4370c",
                                "sense_id": "2ab24aa8-d0bf-31e3-a029-65421c391f0d",
                                "text": "„Die afrikanischen Menschenhändler dezimieren zwischen 1440 und 1870 die Bevölkerung ganzer Landstriche, verkaufen bis Mitte des 19. Jahrhunderts wohl mehr als zwölf Millionen Gefangene an die Europäer.“"
                            },
                            {
                                "example_id": "9af0b833-15bd-4c5a-bad5-4114e493f23e",
                                "sense_id": "2ab24aa8-d0bf-31e3-a029-65421c391f0d",
                                "text": "„Es sind Menschenhändler wie der bärtige Hamed bin Mohammed el-Murjebi, genannt Tippu Tip, der im makellos weißen Gewand auftritt.“"
                            },
                            {
                                "example_id": "4cdbe3c5-4245-4759-b825-d910fa79e86a",
                                "sense_id": "2ab24aa8-d0bf-31e3-a029-65421c391f0d",
                                "text": "„Polaris betreibt in Tokio eine Hotline für die Opfer von Menschenhändlern, und die Leute dort tun ihr Bestes, um die Öffentlichkeit auf das Problem aufmerksam zu machen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
