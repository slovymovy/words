                        "examples": [
                            {
                                "example_id": "92fc5802-7805-40a9-832a-7072cf875b87",
                                "sense_id": "884c5e26-e52c-3063-9fa7-5a566f7e3fbb",
                                "text": "Szczęśliwie mam postoje taksówek na wszystkich ulicach wokół domu, więc zawsze czeka na mnie jakiś pojazd."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "f219dc1d-b729-3a8e-90be-9ac3663e676e",
                        "entry_id": "984f7a92-f155-34e1-898e-dab9e12e9e8f",
                        "glosses": [
                            "w szczęściu i radości"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0a6cc477-5424-442e-8cf9-c490e4ae20e2",
                        "source_entry_id": "984f7a92-f155-34e1-898e-dab9e12e9e8f",
                        "source_sense_id": "903da8e3-b550-3985-ae58-a49cdfbda7e9",
                        "target_lang_word": "happily",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "happily",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "de95d93e-c960-3e47-a541-aaa00b2e88ea",
                                        "entry_id": "71bd1161-03d3-3c86-8e05-e53c2b9a8d5a",
                                        "glosses": [
                                            "In a happy or cheerful manner; with happiness."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f0cd391-bf2c-4c06-a226-f5f6ee3ea0b1",
                                                "sense_id": "de95d93e-c960-3e47-a541-aaa00b2e88ea",
                                                "text": "This time next month I’ll be happily fishing at the beach."
                                            },
                                            {
                                                "example_id": "aa828e31-617b-450e-8739-5baf0be85ba0",
                                                "sense_id": "de95d93e-c960-3e47-a541-aaa00b2e88ea",
                                                "text": "And thus I have given the first part of a life of fortune and adventure, a life of Providence's chequer-work, and of a variety which the world will seldom be able to shew the like of: beginning foolishly, but closing much more happily than any part of it ever gave me leave so much as to hope for."
                                            },
                                            {
                                                "example_id": "ea2ce3e6-936d-43e7-a3de-784a79335de4",
                                                "sense_id": "de95d93e-c960-3e47-a541-aaa00b2e88ea",
                                                "text": "Train operating companies get plenty of column inches in the tabloids, usually for negative reasons. Happily, Southeastern is worthy of praise for having made The Sun for something positive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81054a6c-9a4e-3d16-8f60-660610a36c31",
                                        "entry_id": "71bd1161-03d3-3c86-8e05-e53c2b9a8d5a",
                                        "glosses": [
                                            "By good chance; fortunately, successfully."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "774e1733-253b-494b-a480-193607f08318",
                                                "sense_id": "81054a6c-9a4e-3d16-8f60-660610a36c31",
                                                "text": "Watt wore, on his feet, a boot, brown in colour, and a shoe, happily of a brownish colour also."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ad5cb87-5a0a-3781-a61e-31639014727b",
                                        "entry_id": "71bd1161-03d3-3c86-8e05-e53c2b9a8d5a",
                                        "glosses": [
                                            "With good will; in all happiness; willingly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62a17171-6d89-4412-9f16-b5f172348077",
                                                "sense_id": "9ad5cb87-5a0a-3781-a61e-31639014727b",
                                                "text": "I will happily help you look for your lost wallet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5306604-7dff-3488-9c86-f35980b59732",
                                        "entry_id": "71bd1161-03d3-3c86-8e05-e53c2b9a8d5a",
                                        "glosses": [
                                            "By chance; perhaps."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72740378-37da-4b13-be3e-540bafc6c561",
                                                "sense_id": "f5306604-7dff-3488-9c86-f35980b59732",
                                                "text": "And who knoweth whether a thousand yeares hence a third opinion will rise, which happily shall overthrow these two precedents?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b406e910-7580-4f1e-9673-8f20681077e8",
                        "source_entry_id": "984f7a92-f155-34e1-898e-dab9e12e9e8f",
                        "source_sense_id": "903da8e3-b550-3985-ae58-a49cdfbda7e9",
                        "target_lang_word": "fortunately",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fortunately",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8dd3bdb6-1961-36e1-8ccd-2f65bf4f93ac",
                                        "entry_id": "f8f5567b-caea-3aaa-bf99-d9d18c82e4ef",
                                        "glosses": [
                                            "In a fortunate manner."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a1bc5d3d-96c3-386d-afbd-1ebeb4605eac",
                                        "entry_id": "f8f5567b-caea-3aaa-bf99-d9d18c82e4ef",
                                        "glosses": [
                                            "It is (or was, etc) fortunate that."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08714842-52f2-4e8a-bc85-76d1a6de58dc",
                                                "sense_id": "a1bc5d3d-96c3-386d-afbd-1ebeb4605eac",
                                                "text": "Fortunately for Sam, his pet hamster was alive."
                                            },
                                            {
                                                "example_id": "9a4ccee3-09b7-43ce-815d-0832069c2300",
                                                "sense_id": "a1bc5d3d-96c3-386d-afbd-1ebeb4605eac",
                                                "text": "My mom has fortunately agreed to help us with the science project for school."
                                            },
                                            {
                                                "example_id": "5d39e9f6-7928-4c23-a2fc-83b4754f1879",
                                                "sense_id": "a1bc5d3d-96c3-386d-afbd-1ebeb4605eac",
                                                "text": "[…]the best thing to do is to curl up with a good goose-flesher and try to forget, and fortunately I had packed among my effects one called Murder at Greystone Grange."
                                            },
                                            {
                                                "example_id": "1037c556-c8bd-4cd6-bba2-8aa144f3081b",
                                                "sense_id": "a1bc5d3d-96c3-386d-afbd-1ebeb4605eac",
                                                "text": "Fortunately — very fortunately — the American people have a happy alternative to this bankrupt Republican campaign and its captive candidate."
                                            },
                                            {
                                                "example_id": "a93892a8-c294-43a4-a9d6-2ca40276299a",
                                                "sense_id": "a1bc5d3d-96c3-386d-afbd-1ebeb4605eac",
                                                "text": "Most pitchside medical staff fortunately will never have to treat a life threatening injury on the field of play."
                                            },
                                            {
                                                "example_id": "4c169188-4b0a-4a54-8ef8-0055e910f8da",
                                                "sense_id": "a1bc5d3d-96c3-386d-afbd-1ebeb4605eac",
                                                "text": "Fortunately for the noncampers, half of the hotel rooms overlook the seaside stage, making attendance almost automatic, and very convenient in bad weather."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "41a2df3d-0d47-4b07-9115-434388f6d357",
                        "source_entry_id": "984f7a92-f155-34e1-898e-dab9e12e9e8f",
                        "source_sense_id": "903da8e3-b550-3985-ae58-a49cdfbda7e9",
                        "target_lang_word": "successfully",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "successfully",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a3e37a6c-a5a7-3c35-92c1-c1c47d37467d",
                                        "entry_id": "eeb303c8-8a08-3450-a3b9-6bdbf9c8c2b3",
                                        "glosses": [
                                            "In a successful manner; with success; without failing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51da5d58-7119-4b98-82b2-b32880529030",
                                                "sense_id": "a3e37a6c-a5a7-3c35-92c1-c1c47d37467d",
                                                "text": "He successfully climbed the mountain."
                                            },
                                            {
                                                "example_id": "f9440064-c3fc-4fb6-991f-1bb53b5c7d64",
                                                "sense_id": "a3e37a6c-a5a7-3c35-92c1-c1c47d37467d",
                                                "text": "They successfully completed their project together."
                                            },
                                            {
                                                "example_id": "6798960a-e9ec-4189-bd0a-5bbb4f945d93",
                                                "sense_id": "a3e37a6c-a5a7-3c35-92c1-c1c47d37467d",
                                                "text": "Traders have been successfully indoctrinated with the necessity of quick unloading - or else seeing their coal hauled away again - […]"
                                            },
                                            {
                                                "example_id": "4ef9a439-1d9d-4aa2-b550-4090871a1ebc",
                                                "sense_id": "a3e37a6c-a5a7-3c35-92c1-c1c47d37467d",
                                                "text": "A species of wolf that died out some 12,500 years ago lives again as the “world’s first successfully de-extincted animal,” according to Dallas-based biotech company Colossal Biosciences."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "621205a6-4480-4cb5-94a3-24d83ba42f14",
                        "source_entry_id": "984f7a92-f155-34e1-898e-dab9e12e9e8f",
                        "source_sense_id": "903da8e3-b550-3985-ae58-a49cdfbda7e9",
                        "target_lang_word": "aptly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aptly",
