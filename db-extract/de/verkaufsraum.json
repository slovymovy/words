                "senses": [
                    {
                        "sense_id": "59f4d4e2-850c-3b29-a572-f864028e4b46",
                        "entry_id": "4a6cb4a6-7565-31b6-bc41-b9d684da6ef1",
                        "glosses": [
                            "Raum, in dem Waren verkauft werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0155b7fb-7077-4912-b47a-5956be7ebdc8",
                                "sense_id": "59f4d4e2-850c-3b29-a572-f864028e4b46",
                                "text": "„Im Verkaufsraum stehen sieben Kisten, alphabetisch nach Kundennamen sortiert, davon passt höchstens die Hälfte in die frei gewordenen Lücken im Abholfach.“"
                            },
                            {
                                "example_id": "92558ff3-a9c6-4e6b-98b8-e0870a71892a",
                                "sense_id": "59f4d4e2-850c-3b29-a572-f864028e4b46",
                                "text": "„Meistens meide ich den verwüsteten Verkaufsraum, aber einmal ging ich doch an den Ständer mit den bunten Tütchen vorbei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
