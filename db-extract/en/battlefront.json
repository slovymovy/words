                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c140e363-3991-364e-bbb9-9a6dd3ac792a",
                                        "entry_id": "f4b89afa-129f-38f8-b3c4-b55df7335595",
                                        "glosses": [
                                            "передняя линия, передний край, граница чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6002a929-32cf-4c91-ba07-d0b8a0c30eda",
                                                "sense_id": "c140e363-3991-364e-bbb9-9a6dd3ac792a",
                                                "text": "Фронт волны достиг этой точки."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60967809-31d2-341c-80ec-40d307a7f36d",
                                        "entry_id": "f4b89afa-129f-38f8-b3c4-b55df7335595",
                                        "glosses": [
                                            "передняя, лицевая часть чего-либо"
