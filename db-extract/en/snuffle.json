                "senses": [
                    {
                        "sense_id": "8508acd7-403e-3d65-88a4-08036610c3c1",
                        "entry_id": "52fb350a-8979-3036-9a97-2ed1c0301775",
                        "glosses": [
                            "To sniff or smell with the nose loudly and audibly."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "f78a6d84-24e7-308c-8c65-5fa85841b441",
                        "entry_id": "52fb350a-8979-3036-9a97-2ed1c0301775",
                        "glosses": [
                            "To speak through the nose; to breathe through the nose when it is obstructed, so as to make a broken sound."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "83256c29-73f4-435b-a8cf-085002a683f3",
                                "sense_id": "f78a6d84-24e7-308c-8c65-5fa85841b441",
                                "text": "One clad in purple / Eats, and recites some lamentable rhyme […] / Snuffling at nose, and croaking in his throat."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7a468901-9b97-493b-97a6-8edfb6b952a6",
                        "source_entry_id": "52fb350a-8979-3036-9a97-2ed1c0301775",
                        "source_sense_description": "to sniff loudly",
                        "target_lang_word": "renifler",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "renifler",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bdfe971f-196d-3cf1-a397-a41cc335ce27",
                                        "entry_id": "2b2c99e4-c521-3abb-a96b-09752d33f0c2",
                                        "glosses": [
                                            "Aspirer fortement par le nez."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f13588c-b88b-4b34-8aec-119d508a5dec",
                                                "sense_id": "bdfe971f-196d-3cf1-a397-a41cc335ce27",
                                                "text": "Quelques hommes seulement prirent part aux obsèques et peu de femmes même, de celles qui profitent de toutes les occasions pour sortir leurs vêtements noirs, leurs toquets de crêpe et qui aiment renifler l’odeur de l’encens."
                                            },
                                            {
                                                "example_id": "3b7c5b1f-33ec-4db0-82fb-3edbff006577",
                                                "sense_id": "bdfe971f-196d-3cf1-a397-a41cc335ce27",
                                                "text": "Et l’air, mon Claudin, l’air reniflable, risquais-je avec rusticité? — Tu renifles ? Et les microbes ! Prends garde !"
                                            },
                                            {
                                                "example_id": "6b709c62-e156-457c-ac89-de919038394a",
                                                "sense_id": "bdfe971f-196d-3cf1-a397-a41cc335ce27",
                                                "text": "Je geekai durant plus d'une heure, gardant toujours Roméo à l'œil. Le chat avançait dans l'appartement, reniflait à droite, à gauche, allait laper un peu d'eau dans le bol, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d94afaca-bbbf-3feb-a77b-056e54139ae4",
                                        "entry_id": "2b2c99e4-c521-3abb-a96b-09752d33f0c2",
                                        "glosses": [
                                            "Marquer de la répugnance pour quelque chose."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46255a58-50c5-4ca6-a082-95fa03d09108",
                                                "sense_id": "d94afaca-bbbf-3feb-a77b-056e54139ae4",
                                                "text": "Cet enfant renifle sur sa soupe. — Ce cheval renifle sur l’avoine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4649f100-1849-3c11-aa61-663a4ae41989",
                                        "entry_id": "2b2c99e4-c521-3abb-a96b-09752d33f0c2",
                                        "glosses": [
                                            "Aspirer sa morve ou ses larmes par le nez."
                                        ],
                                        "tags": [
                                            "especially",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f4b7120-e582-4c0c-bc1d-8f18f6c3ddd2",
                                                "sense_id": "4649f100-1849-3c11-aa61-663a4ae41989",
                                                "text": "Il fallait l'entendre ! En trois coups de cuiller à pot, il les a tous retournés. Il leur a boni un coup de sentiment à faire renifler le diable et l’enfer !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "676902a8-ac4e-36cd-bfa1-23b9a3322b5e",
                                        "entry_id": "2b2c99e4-c521-3abb-a96b-09752d33f0c2",
                                        "glosses": [
                                            "Sentir, dans le sens d’avoir pour odeur."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f26c616-46c3-41b7-8d67-89b5d6fb0ce4",
                                                "sense_id": "676902a8-ac4e-36cd-bfa1-23b9a3322b5e",
                                                "text": "– Pff, casser, toujours casser… D’accord, c’est marrant de temps en temps, mais moi je préférerais encore me renifler une Zarabe. Belle, et bien coincée du cul. Ou alors une p’tite bourge, bien blanche ? Les cris d’une vierge qu’a la pétoche, ça c’est excitant ! ricana Zef."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
