{
    "word_family": [
        "slurred",
        "slurring"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2c0c0540-3a49-38fe-9b04-b796714c1d72",
                    "sense_definition": "An extremely offensive and socially unacceptable term targeted at a specific group of people, such as an ethnicity or sexual orientation.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "insult",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The student was suspended for using a racial <w>slur</w> during the argument in the hallway.",
                            "target_lang_translations": {
                                "ru": "Студента отстранили от занятий за использование расового <w>оскорбления</w> во время спора в коридоре."
                            }
                        },
                        {
                            "text": "It is never acceptable to use a <w>slur</w> against someone based on their identity.",
                            "target_lang_translations": {
                                "ru": "Использование <w>слюров</w> в адрес кого-либо на основании их идентичности никогда не является приемлемым."
                            }
                        }
                    ],
                    "synonyms": [
                        "epithet",
                        "insult",
                        "pejorative"
                    ],
                    "antonyms": [
                        "compliment",
                        "honorific"
                    ],
                    "common_phrases": [
                        "racial slur",
                        "homophobic slur",
                        "ethnic slur"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крайне оскорбительное и социально неприемлемое выражение в адрес определенной группы людей, например, по признаку этнической принадлежности или сексуальной ориентации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слюр",
                                "target_lang_sense_clarification": "оскорбительное слово в адрес группы людей"
                            },
                            {
                                "target_lang_word": "оскорбительное прозвище",
                                "target_lang_sense_clarification": "унизительное именование"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3dc0da7d-3fb7-3745-9927-679323dae628",
                    "sense_definition": "A remark or allegation that causes a mark of dishonour or a stain on someone's reputation.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "insult",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The false accusations were a <w>slur</w> on his reputation that took years to clear.",
                            "target_lang_translations": {
                                "ru": "Ложные обвинения стали <w>пятном</w> на его репутации, на очищение которой ушли годы."
                            }
                        },
                        {
                            "text": "She felt that the criticism of her management was an unfair <w>slur</w> on her professional character.",
                            "target_lang_translations": {
                                "ru": "Она чувствовала, что критика её стиля руководства была несправедливым <w>выпадом</w> против её профессиональных качеств."
                            }
                        }
                    ],
                    "synonyms": [
                        "stigma",
                        "aspersions",
                        "blight",
                        "stain"
                    ],
                    "antonyms": [
                        "tribute",
                        "commendation"
                    ],
                    "common_phrases": [
                        "slur on one's reputation",
                        "cast a slur"
                    ],
                    "target_lang_definitions": {
                        "ru": "Замечание или утверждение, которое наносит ущерб чести или пятнает чью-либо репутацию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "клеветническое обвинение",
                                "target_lang_sense_clarification": "порочащее утверждение"
                            },
                            {
                                "target_lang_word": "инсинуация",
                                "target_lang_sense_clarification": "скрытый намек, порочащий кого-либо"
                            },
                            {
                                "target_lang_word": "пятно",
                                "target_lang_sense_clarification": "на репутации"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fe4d8222-cd08-3d82-bea0-8be11888ab5f",
                    "sense_definition": "An act of running words together or poor verbal articulation, often caused by tiredness or intoxication.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor noticed a slight <w>slur</w> in the patient's speech during the physical exam.",
                            "target_lang_translations": {
                                "ru": "Во время осмотра врач заметил небольшую <w>невнятность</w> в речи пациента."
                            }
                        },
                        {
                            "text": "He spoke with a heavy <w>slur</w> after the dental surgery made his mouth numb.",
                            "target_lang_translations": {
                                "ru": "Он говорил с сильным <w>бормотанием</w> после того, как стоматологическая операция вызвала онемение рта."
                            }
                        }
                    ],
                    "synonyms": [
                        "mumble",
                        "incoherence"
                    ],
                    "antonyms": [
                        "enunciation",
                        "articulation"
                    ],
                    "common_phrases": [
                        "slur in speech",
                        "noticeable slur"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нечеткое произношение или невнятная артикуляция, часто вызванная усталостью или опьянением."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "невнятная речь",
                                "target_lang_sense_clarification": "плохая дикция"
                            },
                            {
                                "target_lang_word": "бормотание",
                                "target_lang_sense_clarification": "неясное произношение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "90c9a0bf-4c87-3234-aa03-80b527b96c66",
                    "sense_definition": "A curved line in musical notation indicating that a group of notes should be played smoothly and connected.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The violinist followed the <w>slur</w> on the page to play the passage legato.",
                            "target_lang_translations": {
                                "ru": "Скрипач следовал <w>лиге</w> на странице, чтобы сыграть пассаж легато."
                            }
                        },
                        {
                            "text": "Make sure you don't confuse a <w>slur</w> with a tie when reading this sheet music.",
                            "target_lang_translations": {
                                "ru": "При чтении этих нот убедитесь, что вы не путаете <w>лигу</w> с соединительной дугой."
                            }
                        }
                    ],
                    "synonyms": [
                        "phrase mark"
                    ],
                    "antonyms": [
                        "staccato"
                    ],
                    "common_phrases": [
                        "musical slur"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in music"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Изогнутая линия в нотной записи, указывающая на то, что группу нот следует исполнять плавно и связно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лига",
                                "target_lang_sense_clarification": "музыкальный символ связности"
                            },
                            {
                                "target_lang_word": "лега́то",
                                "target_lang_sense_clarification": "связное исполнение звуков"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9eac287b-77a8-3998-b1c0-005b913f6cde",
                    "sense_definition": "To speak unclearly by running words or syllables together.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you drink too much alcohol, you might start to <w>slur</w> your words.",
                            "target_lang_translations": {
                                "ru": "Если вы выпьете слишком много алкоголя, ваш язык может начать <w>заплетаться</w>."
                            }
                        },
                        {
                            "text": "The tired child began to <w>slur</w> speech as he drifted off to sleep.",
                            "target_lang_translations": {
                                "ru": "Уставший ребенок начал <w>бормотать</w> невнятно, засыпая."
                            }
                        }
                    ],
                    "synonyms": [
                        "mumble",
                        "garble"
                    ],
                    "antonyms": [
                        "articulate",
                        "enunciate"
                    ],
                    "common_phrases": [
                        "slur your words",
                        "slur speech"
                    ],
                    "target_lang_definitions": {
                        "ru": "Говорить невнятно, сливая слова или слоги вместе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заплетаться",
                                "target_lang_sense_clarification": "о языке или речи"
                            },
                            {
                                "target_lang_word": "глотать",
                                "target_lang_sense_clarification": "пропускать звуки или окончания при речи"
                            },
                            {
                                "target_lang_word": "бормотать",
                                "target_lang_sense_clarification": "говорить неразборчиво"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2d24c51b-b7a5-327e-abfc-d4e083182218",
                    "sense_definition": "To insult or speak slightingly about someone or something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "insult",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is unprofessional to <w>slur</w> your competitors in front of potential clients.",
                            "target_lang_translations": {
                                "ru": "Непрофессионально <w>порочить</w> своих конкурентов перед потенциальными клиентами."
                            }
                        },
                        {
                            "text": "He felt the need to <w>slur</w> her character because he was jealous of her success.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал необходимость <w>очернить</w> её репутацию, потому что завидовал её успеху."
                            }
                        }
                    ],
                    "synonyms": [
                        "malign",
                        "slander",
                        "disparage",
                        "vilify"
                    ],
                    "antonyms": [
                        "praise",
                        "compliment",
                        "extol"
                    ],
                    "common_phrases": [
                        "slur someone's character"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оскорблять или пренебрежительно отзываться о ком-либо или чем-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "порочить",
                                "target_lang_sense_clarification": "наносить ущерб репутации"
                            },
                            {
                                "target_lang_word": "очернять",
                                "target_lang_sense_clarification": "представлять в дурном свете"
                            },
                            {
                                "target_lang_word": "клеветать",
                                "target_lang_sense_clarification": "распространять ложные сведения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aa7ec0ae-9143-3e28-8a53-0870f8c09045",
                    "sense_definition": "To perform a group of musical notes smoothly and without interruption.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The conductor asked the woodwinds to <w>slur</w> the opening notes of the melody.",
                            "target_lang_translations": {
                                "ru": "Дирижер попросил деревянные духовые <w>связать</w> начальные ноты мелодии."
                            }
                        },
                        {
                            "text": "You should <w>slur</w> these two quavers to create a more fluid sound.",
                            "target_lang_translations": {
                                "ru": "Вам следует <w>объединить лигой</w> эти две восьмые, чтобы создать более плавное звучание."
                            }
                        }
                    ],
                    "synonyms": [
                        "legato"
                    ],
                    "antonyms": [
                        "detach"
                    ],
                    "common_phrases": [
                        "slur the notes"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in music"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Исполнять группу музыкальных нот плавно и без перерывов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исполнять легато",
                                "target_lang_sense_clarification": "связно играть ноты"
                            },
                            {
                                "target_lang_word": "объединять лигой",
                                "target_lang_sense_clarification": "в нотной записи"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}