                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>wachtende</w> menigte begon onrustig te worden toen de deuren dicht bleven.",
                            "target_lang_translations": {
                                "it": "La folla <w>in attesa</w> iniziò ad agitarsi quando le porte rimasero chiuse."
                            }
                        },
                        {
                            "text": "Hij liep snel voorbij de <w>wachtende</w> auto's in de file.",
                            "target_lang_translations": {
                                "it": "Passò rapidamente oltre le auto <w>in attesa</w> nella coda."
                            }
