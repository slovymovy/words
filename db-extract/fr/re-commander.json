                "senses": [
                    {
                        "sense_id": "e6045a66-528e-3afa-9a94-a3bc8af77cfc",
                        "entry_id": "51c01b51-3071-36b8-bbdf-681ef611862f",
                        "glosses": [
                            "Commander à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55553a95-8500-4aba-9db8-9cdc029b07f4",
                                "sense_id": "e6045a66-528e-3afa-9a94-a3bc8af77cfc",
                                "text": "On entre tout vivant dans un cauchemar de cafés-crème, d’annuaires téléphoniques, de projets, on croit à ce qu’on dit, on ne dit pas ce qu’on croit, on se satisfait de mots, de promesses, on re-commande des cafés-crème, on câble à des êtres imaginaires, qui acquièrent de ce fait une espèce d’existence, on attend des réponses, on caresse des esquisses de films propres à bouleverser Paris, et l’on s’aperçoit finalement qu’il est quatre heures de l’après-midi."
                            },
                            {
                                "example_id": "d938e65f-572a-4527-9228-0bf714d00e16",
                                "sense_id": "e6045a66-528e-3afa-9a94-a3bc8af77cfc",
                                "text": "Re-commander la même chemise."
                            },
                            {
                                "example_id": "1d8e737f-18e9-4a6d-9580-2a07ff15dc32",
                                "sense_id": "e6045a66-528e-3afa-9a94-a3bc8af77cfc",
                                "text": "J’ai perdu mon téléphone, comment re-commander une carte sim?"
                            }
                        ]
                    }
