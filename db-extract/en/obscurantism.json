                                "target_senses": [
                                    {
                                        "sense_id": "f2423e56-7f43-3058-9b33-d267291925f1",
                                        "entry_id": "01265598-dec2-3e85-9793-b111c08d60d7",
                                        "glosses": [
                                            "Sistemática oposición al progreso y educación, o a la difusión de determinados conocimientos a la población."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b51e28b6-0e34-4446-9725-a8693aac31f2",
                                                "sense_id": "f2423e56-7f43-3058-9b33-d267291925f1",
                                                "text": "Recuerden que decían que si aumentaban los salarios mínimos iba a haber inflación. Ese era el mito del oscurantismo neoliberal, que si aumentaban los salarios … no iba a haber inversión, porque lo que México podía ofrecer al mundo era mano de obra barata. Y aquí lo que se demuestra es que cuando la gente vive mejor, el país está mejor y sigue habiendo inversiones y no hay inflación."
                                            }
                                        ],
