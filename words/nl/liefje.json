                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij had een afspraakje met zijn <w>liefje</w>.",
                            "target_lang_translations": {
                                "en": "He had a date with his <w>sweetheart</w>.",
                                "ru": "У него было свидание со своей <w>любимой</w>.",
                                "pl": "Miał randkę ze swoją <w>ukochaną</w>.",
                                "de": "Er hatte ein Date mit seinem <w>Schatz</w>.",
                                "fr": "Il avait un rendez-vous avec son <w>chéri</w>.",
                                "it": "Aveva un appuntamento con il suo <w>tesoro</w>.",
                                "cs": "Měl schůzku se svou <w>láskou</w>.",
                                "tr": "Sevgilisiyle bir randevusu vardı.",
                                "es": "Él tenía una cita con su <w>amor</w>.",
                                "zh": "他和他的<w>恋人</w>有个约会。"
                            }
                        },
                        {
                            "text": "Ik heb een mooi cadeau gekocht voor mijn <w>liefje</w>.",
                            "target_lang_translations": {
                                "en": "I bought a beautiful gift for my <w>darling</w>.",
                                "ru": "Я купил красивый подарок для своей <w>любимой</w>.",
                                "pl": "Kupiłem piękny prezent dla mojego <w>kochania</w>.",
                                "de": "Ich habe ein schönes Geschenk für meinen <w>Liebling</w> gekauft.",
                                "fr": "J'ai acheté un beau cadeau pour mon <w>amoureux</w>.",
                                "it": "Ho comprato un bel regalo per il mio <w>amore</w>.",
                                "cs": "Koupil jsem krásný dárek pro svého <w>miláčka</w>.",
                                "tr": "<w>Sevgilim</w> için güzel bir hediye aldım.",
                                "es": "He comprado un regalo bonito para mi <w>cariño</w>.",
                                "zh": "我给我的<w>爱人</w>买了一份精美的礼物。"
