                                        "sense_id": "4cfc497a-7301-3025-bf88-bfc6fdd71b98",
                                        "entry_id": "7597f63d-f737-35a0-b2ae-449a5f86f4b3",
                                        "glosses": [
                                            "That has lost some of its former vividness and colour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebed42ab-a736-409f-8d74-335d32e32604",
                                                "sense_id": "4cfc497a-7301-3025-bf88-bfc6fdd71b98",
                                                "text": "a faded tablecloth"
                                            },
                                            {
                                                "example_id": "d3ecb65b-b235-444e-b3c7-6dec2d447575",
                                                "sense_id": "4cfc497a-7301-3025-bf88-bfc6fdd71b98",
                                                "text": "The stop line had a faded appearance but remained visible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11d388cc-e7fe-3e93-b1ad-f2736479fbd4",
                                        "entry_id": "7597f63d-f737-35a0-b2ae-449a5f86f4b3",
                                        "glosses": [
                                            "That has lost some of its former strength or vigour."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c69d467c-eba3-43e3-ac0d-e929cbe5c4a3",
                                                "sense_id": "11d388cc-e7fe-3e93-b1ad-f2736479fbd4",
                                                "text": "a faded rock star of the 1970s"
                                            },
                                            {
                                                "example_id": "24cd7357-2afc-4f3c-a532-9688176ae95f",
                                                "sense_id": "11d388cc-e7fe-3e93-b1ad-f2736479fbd4",
                                                "text": "Some clients adjust their instructions as faded memories come into focus. Mr. Li recalled one prospective client who spent most of an hourlong phone call crying as she reminisced about her old home."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50652865-6344-3036-9592-78da374689c9",
                                        "entry_id": "7597f63d-f737-35a0-b2ae-449a5f86f4b3",
                                        "glosses": [
                                            "High on drugs; stoned."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9b8f165-ed87-44da-943e-f9ce02a0acdd",
                                                "sense_id": "50652865-6344-3036-9592-78da374689c9",
                                                "text": "As I'm walking through the festival entrance, a man casually vomits before continuing on, unfazed. ¶ Twenty-year-old me thinks, \"Dope. That guy knows how to get faded like a champ!\" ¶ Thirty-year-old me thinks, \"I'm concerned for the boy's health and the general sanitation of this festival. Where are the comment cards located?!\""
                                            }
                                        ]
                                    }
                                ]
