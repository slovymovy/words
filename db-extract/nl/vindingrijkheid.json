                "senses": [
                    {
                        "sense_id": "e2af3487-223d-3d33-b779-3eb7a659584d",
                        "entry_id": "e12ec6ae-947e-3ff1-ad52-2752889091a5",
                        "glosses": [
                            "de mate waarin iemand goed is in het vinden van nieuwe oplossingen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f99129a7-4bc6-48df-84e1-a2dd5d7a78c9",
                                "sense_id": "e2af3487-223d-3d33-b779-3eb7a659584d",
                                "text": "In de aangebroken stilte begonnen bij de mannen op het observatiepunt de harten snel en voelbaar te bonken alsof ze in Antipovs schoenen stonden en net als hij, nu hij zijn mannen naar de rand van de Oostenrijkse loopgraaf had geleid, zo dadelijk wonderen van vindingrijkheid en moed moesten tonen."
                            },
                            {
                                "example_id": "a9b53e01-1836-4c85-98f3-d6261272fd01",
                                "sense_id": "e2af3487-223d-3d33-b779-3eb7a659584d",
                                "text": "\"Ja, de Duitsers hebben te lang gegokt dat ze met Duitse vindingrijkheid dieselmotoren wel schoon genoeg konden maken. Maar ondertussen begonnen Tesla en de Aziatische automakers wel met het maken van elektrische auto's.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "78b5be34-e731-4b0c-9aa8-338d3a307e37",
                        "source_entry_id": "e12ec6ae-947e-3ff1-ad52-2752889091a5",
                        "source_sense_id": "e2af3487-223d-3d33-b779-3eb7a659584d",
                        "source_sense_description": "de mate waarin iemand goed is in het vinden van nieuwe oplossingen",
                        "target_lang_word": "inventiveness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inventiveness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7ea9d8fc-1070-30d9-a9a5-552eda74c251",
                                        "entry_id": "c8c35994-0111-3bb5-996d-b15cfa5a99dd",
                                        "glosses": [
                                            "The quality of being inventive; the faculty of inventing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b017a91-77b8-4d58-b22c-4a7e0f698e46",
                                                "sense_id": "7ea9d8fc-1070-30d9-a9a5-552eda74c251",
                                                "text": "Near-synonyms: resourcefulness, creativity, imagination"
                                            },
                                            {
                                                "example_id": "7c535a6e-6917-4727-9a1e-29d601cc8ed4",
                                                "sense_id": "7ea9d8fc-1070-30d9-a9a5-552eda74c251",
                                                "text": "For as was the land, such was the art of it while folk yet troubled themselves about such things; it strove little to impress people either by pomp or ingenuity: not unseldom it fell into commonplace, rarely it rose into majesty; yet was it never oppressive, never a slave’s nightmare or an insolent boast: and at its best it had an inventiveness, an individuality, that grander styles have never overpassed: […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fb1a8eea-6ba0-45aa-848e-909c2c26a295",
                        "source_entry_id": "e12ec6ae-947e-3ff1-ad52-2752889091a5",
                        "source_sense_id": "e2af3487-223d-3d33-b779-3eb7a659584d",
