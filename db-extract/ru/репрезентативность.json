                                        "sense_id": "972ea180-2ce2-303e-b8fd-04d582c4df6b",
                                        "entry_id": "c3bd492c-e3b4-3710-a06f-cf14a124dff6",
                                        "glosses": [
                                            "The state or quality of being representative."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3af54004-a064-4200-8fcf-c402e4a28d23",
                                                "sense_id": "972ea180-2ce2-303e-b8fd-04d582c4df6b",
                                                "text": "Our examination of the representativeness of WEIRD subjects is necessarily restricted to the rather limited database currently available."
                                            },
                                            {
                                                "example_id": "593ffd1a-04be-4f4d-bffc-f652156af4a7",
                                                "sense_id": "972ea180-2ce2-303e-b8fd-04d582c4df6b",
                                                "text": "One should not compromise on the essential standard of representativeness of the corpus as a whole. A corpus is only good if it can be reasonably trusted to represent the way language is used by those people whose usage one is interested in describing."
                                            },
                                            {
                                                "example_id": "3188a505-45a4-4eaa-8aaa-d5c06f91f37f",
                                                "sense_id": "972ea180-2ce2-303e-b8fd-04d582c4df6b",
                                                "text": "Drawing on texts recommended in curricula and controlling for two countries with benchmarked curricula improves the external representativeness of the corpus."
                                            }
                                        ]
