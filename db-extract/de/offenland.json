                "senses": [
                    {
                        "sense_id": "868814f3-f042-3b88-b80e-a4ca338ba7a5",
                        "entry_id": "9ccc40f6-8b6d-34e1-ae49-d23a9bdfb384",
                        "glosses": [
                            "nicht stark bebaute, nicht von Bäumen dominierte Fläche (zum Beispiel Äcker, Weiden, Moore)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "186611da-470a-40f2-b6b4-f0eca5e9449d",
                                "sense_id": "868814f3-f042-3b88-b80e-a4ca338ba7a5",
                                "text": "„Dieses Offenland der alpinen Stufe hat es in der Nacheiszeit, ja zum Teil schon auf den Nunatakkern des Eiszeitalters gegeben.“"
                            },
                            {
                                "example_id": "0ce4913a-db59-45cb-b748-a413318d0fc1",
                                "sense_id": "868814f3-f042-3b88-b80e-a4ca338ba7a5",
                                "text": "„Nördlich von Craula führt ein Wiesenweg durch Offenland.“"
                            },
                            {
                                "example_id": "b89a586a-2b32-4d9c-8241-f73c1563ac62",
                                "sense_id": "868814f3-f042-3b88-b80e-a4ca338ba7a5",
                                "text": "„In ihnen herrschte aber auch große Trockenheit, so dass das Offenland auch Charakteristika einer Steppe aufwies.“"
                            },
                            {
                                "example_id": "8d30cda6-1a5e-49d4-bc66-3a6c3ca819ec",
                                "sense_id": "868814f3-f042-3b88-b80e-a4ca338ba7a5",
                                "text": "„Das Eichsfelder Hügelland wird im S durch das Leinetal begrenzt und zeichnet sich durch einen kleinräumigen Wechsel von Wald und Offenland aus.“"
                            },
                            {
                                "example_id": "7089f16e-4d46-42fe-9131-8d2d3a36a41a",
                                "sense_id": "868814f3-f042-3b88-b80e-a4ca338ba7a5",
                                "text": "„Im Gegensatz zum Offenland zeigen viele typische Waldarten positive Bestandsentwicklungen und sind aktuell kaum gefährdet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
