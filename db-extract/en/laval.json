                                        "sense_id": "68f16685-1b62-35a9-91d6-486c4c31bb45",
                                        "entry_id": "344d5244-2a6d-3971-8b68-05706c39f7bc",
                                        "glosses": [
                                            "Région et ville canadienne du Québec occupant l’île Jésus au nord de l’île de Montréal."
                                        ],
                                        "tags": [],
                                        "examples": [
