                        ],
                        "examples": [
                            {
                                "example_id": "2f9dec68-02d5-49cc-9b14-4b521a0bac80",
                                "sense_id": "fd7d86a8-8298-38cf-92e7-3e8113bb70ba",
                                "text": "De politicus hield een toespraak tijdens de campagne.",
                                "translation": "The politician delivered a speech during the campaign.",
                                "english": "The politician delivered a speech during the campaign."
                            },
                            {
                                "example_id": "96228a0f-f08c-45f2-9d89-a3ae2f88e91f",
                                "sense_id": "fd7d86a8-8298-38cf-92e7-3e8113bb70ba",
                                "text": "De politici debatteerden over verschillende maatschappelijke kwesties.",
                                "translation": "The politicians debated various social issues.",
                                "english": "The politicians debated various social issues."
                            },
                            {
                                "example_id": "83666062-8c8f-49b2-bce8-eb99ac5fdf20",
                                "sense_id": "fd7d86a8-8298-38cf-92e7-3e8113bb70ba",
                                "text": "De jonge politica is een veelbelovend lid van het parlement.",
                                "translation": "The young politician is a promising member of the parliament.",
                                "english": "The young politician is a promising member of the parliament."
                            }
                        ]
                    }
