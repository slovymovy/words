                                        "entry_id": "e959cba9-d4d0-3148-bf91-00682bfa5fac",
                                        "glosses": [
                                            "Ancien duché du Saint-Empire romain germanique, correspondant à peu près à la province néerlandaise du Brabant-Septentrional et en Belgique aux provinces d’Anvers, du Brabant flamand et du Brabant wallon et à la Région de Bruxelles-Capitale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32a86bb3-379d-425b-9d92-7ef66f00f366",
                                                "sense_id": "f71c3831-ab5f-3818-9865-70b2cf48ada4",
                                                "text": "La duchesse de Marlborough exerçait la charge de grande maîtresse de la reine Anne à Londres tandis que son époux faisait dans les campagnes de Brabant une double moisson de lauriers et de richesses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2cf0a88b-73b8-36e1-b524-9cd7baf95c26",
                                        "entry_id": "e959cba9-d4d0-3148-bf91-00682bfa5fac",
                                        "glosses": [
                                            "Ancienne province et région géographique à cheval sur la Flandre, Bruxelles et la Wallonie, scindée en Brabant flamand, Brabant wallon et Région de Bruxelles-Capitale."
                                        ],
                                        "tags": [
                                            "toponymic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aadf0177-03b0-412f-8807-148d1db30aa7",
                                                "sense_id": "2cf0a88b-73b8-36e1-b524-9cd7baf95c26",
                                                "text": "Il habite dans le Brabant."
                                            },
                                            {
                                                "example_id": "360353f1-3975-4030-8b5a-c698c0370eee",
                                                "sense_id": "2cf0a88b-73b8-36e1-b524-9cd7baf95c26",
                                                "text": "Perturbations à Bruxelles et dans les Brabants."
                                            }
                                        ]
                                    }
