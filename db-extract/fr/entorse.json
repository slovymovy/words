        "fr-extract.jsonl": [
            {
                "entry_id": "f8ff654a-4071-3028-a8d3-1e1e7be2ff31",
                "word": "entorse",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "78653cc7-1096-435c-9071-f7534c01e932",
                        "entry_id": "f8ff654a-4071-3028-a8d3-1e1e7be2ff31",
                        "tags": [
                            "plural"
                        ],
                        "form": "entorses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "50292b4a-e289-3ab7-b4a9-42327b61ac44",
                        "entry_id": "f8ff654a-4071-3028-a8d3-1e1e7be2ff31",
                        "glosses": [
                            "Distension violente et douloureuse des ligaments, et en général des parties molles qui entourent une articulation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e96ef4f1-a760-46da-9410-1948d0226079",
                                "sense_id": "50292b4a-e289-3ab7-b4a9-42327b61ac44",
                                "text": "Se donner (vieilli), se faire une entorse au poignet, au genou, à la cheville, au pied."
                            },
                            {
                                "example_id": "95ce7e26-0ded-4276-9825-d567233bfbb3",
                                "sense_id": "50292b4a-e289-3ab7-b4a9-42327b61ac44",
                                "text": "En mon pays, les entorses sévissent le dimanche et il n’est pas rare qu’on s’enfonce ce jour-là deux ou trois côtes en sortant du cabaret."
                            },
                            {
                                "example_id": "a57427e6-a5cf-4a92-a58d-18b4a753a675",
                                "sense_id": "50292b4a-e289-3ab7-b4a9-42327b61ac44",
                                "text": "Ces traitements peuvent être pris en charge par le généraliste s’il y est habitué, en particulier s’il sait évaluer la gravité de l’entorse."
                            }
                        ]
                    },
                    {
                        "sense_id": "6956de09-bb1b-38a5-9b0d-c261a6eecbd4",
                        "entry_id": "f8ff654a-4071-3028-a8d3-1e1e7be2ff31",
                        "glosses": [
                            "Exception à une règle ou à une tradition."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "2e7c656d-fc94-46d2-9628-c31479b73ab6",
                                "sense_id": "6956de09-bb1b-38a5-9b0d-c261a6eecbd4",
                                "text": "Faire une entorse au règlement."
                            },
                            {
                                "example_id": "8fbae194-82f5-463d-9e9b-1a328ec72832",
                                "sense_id": "6956de09-bb1b-38a5-9b0d-c261a6eecbd4",
                                "text": "Ils sont de plus en plus nombreux et nombreuses à ne reculer devant aucune entorse pour tenter d’accéder au pouvoir."
                            }
                        ]
                    },
                    {
                        "sense_id": "1f4a0384-9e16-38bb-901b-2d76116370ee",
                        "entry_id": "f8ff654a-4071-3028-a8d3-1e1e7be2ff31",
                        "glosses": [
                            "Tort subi."
                        ],
                        "tags": [
                            "dated",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "be074839-e839-470b-b280-7632f011ef63",
                                "sense_id": "1f4a0384-9e16-38bb-901b-2d76116370ee",
                                "text": "La luxure n’est pas une luxation. C’est cependant une entorse à la chasteté."
                            },
                            {
                                "example_id": "6e98870e-bcf8-46e9-bf0c-44820f3d8da4",
                                "sense_id": "1f4a0384-9e16-38bb-901b-2d76116370ee",
                                "text": "Sa fortune, son crédit a souffert une rude entorse."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a336130d-35de-46a8-90de-e4aa7e06df17",
                        "source_entry_id": "f8ff654a-4071-3028-a8d3-1e1e7be2ff31",
                        "source_sense_description": "Foulure",
                        "target_lang_word": "Verstauchung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verstauchung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7ba73d1f-b13a-33d7-96d0-a141d16a14c1",
                                        "entry_id": "80657ada-a574-3091-83ba-7a595b1f0e67",
                                        "glosses": [
                                            "stumpfe Verletzung eines Körperteils (Hand, Fuß etc.) durch eine ungünstige Belastung oder Bewegung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09ef059b-7254-4cac-b7b5-4c2021dddd43",
                                                "sense_id": "7ba73d1f-b13a-33d7-96d0-a141d16a14c1",
                                                "text": "„»Was haben Sie denn, mein Herr?« »Ach weiter nichts, gnädige Frau; eine leichte Verstauchung, die durch ein bißchen Ruhe von selber wieder besser werden wird.« […] »Ich finde es eigentümlich, liebe Base, daß Sie darüber lachen.« »Ich lachte, weil es mich an eine vorgeschützte Verstauchung erinnerte, die ich mir vor zwei Jahren zulegte, um nicht tanzen zu müssen.«“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "28d0fcc9-678a-4f57-bc5a-415effe43fb6",
                        "source_entry_id": "f8ff654a-4071-3028-a8d3-1e1e7be2ff31",
