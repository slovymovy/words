                ],
                "senses": [
                    {
                        "sense_id": "0f7d5839-5ace-3c93-a028-2e96b05a8ec6",
                        "entry_id": "de96eb21-db9b-38c3-92ae-6e35dc8dfab9",
                        "glosses": [
                            "Wanne aus Zink"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76cd57cf-d525-4688-ad07-7b3cbf8129f2",
                                "sense_id": "0f7d5839-5ace-3c93-a028-2e96b05a8ec6",
                                "text": "„Am Abend vorher hatten sie der Reihe nach in der Zinkwanne in der Küche gebadet.“"
                            },
                            {
                                "example_id": "fcbb6d00-5fa8-420a-a7ef-d51b4c1663fe",
                                "sense_id": "0f7d5839-5ace-3c93-a028-2e96b05a8ec6",
                                "text": "Wir waschen unsere Wäsche traditionell mit Waschbrett und Zinkwanne."
                            },
                            {
                                "example_id": "bc1a3d34-ccbb-4b76-b616-f21ffa9b7107",
                                "sense_id": "0f7d5839-5ace-3c93-a028-2e96b05a8ec6",
                                "text": "„Die Dondorfer Zinkwanne im ausgedienten Schweinestall vor Augen, prustete ich los.“"
                            },
                            {
                                "example_id": "3d32819e-9a7d-4a81-8a9a-6bbc2f4f6a2e",
                                "sense_id": "0f7d5839-5ace-3c93-a028-2e96b05a8ec6",
                                "text": "„Die Fini und die kranke Tante haben einen Sauberkeitstick, nachdem sie sich als dritte und vierte in einer Zinkwanne in der Küche in das zuvor vom Großvater und dann von der Großmutter benutzte Wasser setzen und baden mußten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
