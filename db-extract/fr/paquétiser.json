                "senses": [
                    {
                        "sense_id": "004d959f-e960-39de-bb57-69f3a214804f",
                        "entry_id": "ef02e81a-eacd-3b3d-8495-66d6f6fd671c",
                        "glosses": [
                            "Découper en morceaux (paquets)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8ae0790-9499-443c-98eb-73804f4924de",
                                "sense_id": "004d959f-e960-39de-bb57-69f3a214804f",
                                "text": "Le temps de remplissage étant constant et très court, il n'y a pas de perte de temps à paquétiser et dépaquétiser l'information."
                            },
                            {
                                "example_id": "13813b3c-3f2d-49e8-974b-67592e35f2fa",
                                "sense_id": "004d959f-e960-39de-bb57-69f3a214804f",
                                "text": "au moins une interface de données en paquets (240) pour paquétiser le flux de données en paquets de réception produisant un flux de paquets de réception, et pour dépaquétiser un flux de paquets de transmission en le flux de données en paquets de transmission ;"
                            },
                            {
                                "example_id": "9c2a4284-e460-4c96-acef-654618855fb9",
                                "sense_id": "004d959f-e960-39de-bb57-69f3a214804f",
                                "text": "La technique de transport la plus appropriée consiste à paquétiser c'est-à-dire à regrouper en paquets, le flot des bits à transporter."
                            }
                        ]
                    }
