                    {
                        "sense_id": "fc10ee78-e9f5-3c94-9e04-9cfbfd268c63",
                        "entry_id": "e8f77dfd-343f-375f-8542-9fcad57009fd",
                        "glosses": [
                            "wyrażenie charakteryzujące lub nazywające przedmiot bądź osobę"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00466f08-bac4-457e-9aba-64bb020ccb4f",
                                "sense_id": "fc10ee78-e9f5-3c94-9e04-9cfbfd268c63",
                                "text": "Nie przepadał za sentymentalnymi określeniami, choć często osobiście doglądał napraw, a wszystko we wnętrzu maszyny było przygotowane zgodnie z jego ustaleniami"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0fbd79c8-fb6f-4e88-b841-dcd2e7f061bf",
                        "source_entry_id": "e8f77dfd-343f-375f-8542-9fcad57009fd",
                        "source_sense_id": "fc10ee78-e9f5-3c94-9e04-9cfbfd268c63",
                        "target_lang_word": "qualification",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "qualification",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b007744b-19a2-3ef6-be5b-b846b41d5940",
                                        "entry_id": "b4ee4e93-99e2-3ee6-8a70-5c5736c593a7",
                                        "glosses": [
                                            "The act or process of qualifying for a position, achievement etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c303af27-40ee-424f-89b1-daa94579040d",
                                                "sense_id": "b007744b-19a2-3ef6-be5b-b846b41d5940",
                                                "text": "Qualification for this organization is extraordinarily difficult."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bdda4da4-91f4-3f4c-ac53-343b868c1b2a",
                                        "entry_id": "b4ee4e93-99e2-3ee6-8a70-5c5736c593a7",
                                        "glosses": [
                                            "An ability or attribute that aids someone's chances of qualifying for something; specifically, completed professional training."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b43f924b-4eca-4be8-85e3-3e64061f856d",
                                                "sense_id": "bdda4da4-91f4-3f4c-ac53-343b868c1b2a",
                                                "text": "What are your qualifications for this job?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dfcbcd5c-72ce-3ee2-a1a1-235e67e56d5c",
                                        "entry_id": "b4ee4e93-99e2-3ee6-8a70-5c5736c593a7",
                                        "glosses": [
                                            "A certificate, diploma, or degree awarded after successful completion of a course, training, or exam."
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4e2797a8-1b91-37cc-bb64-c4651de991fc",
                                        "entry_id": "b4ee4e93-99e2-3ee6-8a70-5c5736c593a7",
                                        "glosses": [
                                            "A clause or condition which qualifies something; a modification, a limitation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "034b37ee-d831-40d1-a455-0f4e2a797da3",
                                                "sense_id": "4e2797a8-1b91-37cc-bb64-c4651de991fc",
                                                "text": "I accept your offer, but with the following qualification."
                                            },
                                            {
                                                "example_id": "a94504b6-8682-4929-9fbd-9fb3f7f1b9bd",
                                                "sense_id": "4e2797a8-1b91-37cc-bb64-c4651de991fc",
                                                "text": "Before a vowel (as in rib, brake) r is usually pronounced as a fricative consonant by all groups of speakers. But the qualification 'usually' is necessary, for the Negroes tend to weaken r after a consonant; and they omit it, as do illiterate white speakers, in throat, throw, through."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74d50006-2d59-3626-947c-3ec19a463c86",
                                        "entry_id": "b4ee4e93-99e2-3ee6-8a70-5c5736c593a7",
                                        "glosses": [
                                            "A quality or attribute."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3e68ae6-611e-44bd-886f-5cabb834ca7e",
                                                "sense_id": "74d50006-2d59-3626-947c-3ec19a463c86",
                                                "text": "To shew, that these Qualfications, which we all pretend to be asham'd of, are the great support of a flourishing Society has been the subject of the foregoing Poem."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
