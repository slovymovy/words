{
    "word_family": [
        "exposure",
        "exposé",
        "expository",
        "exposition"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f9271eba-826e-387d-ab7a-d491aac8ecd2",
                    "sense_definition": "To reveal something hidden, secret, or private, making it visible or known to others.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "reveal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The investigation helped <w>expose</w> corruption within the local government.",
                            "target_lang_translations": {
                                "ru": "Расследование помогло <w>разоблачить</w> коррупцию в местном правительстве."
                            }
                        },
                        {
                            "text": "Journalists worked for months to <w>expose</w> the truth about the company's illegal activities.",
                            "target_lang_translations": {
                                "ru": "Журналисты работали месяцами, чтобы <w>раскрыть</w> правду о незаконной деятельности компании."
                            }
                        }
                    ],
                    "synonyms": [
                        "reveal",
                        "bare"
                    ],
                    "antonyms": [
                        "hide",
                        "conceal",
                        "cover"
                    ],
                    "common_phrases": [
                        "expose the truth",
                        "expose a secret",
                        "expose corruption"
                    ],
                    "target_lang_definitions": {
                        "ru": "Раскрыть что-то скрытое, секретное или личное, сделав это видимым или известным другим."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разоблачать",
                                "target_lang_sense_clarification": "делать явным скрытые проступки или преступления"
                            },
                            {
                                "target_lang_word": "раскрывать",
                                "target_lang_sense_clarification": "делать известным что-либо неизвестное или скрываемое"
                            },
                            {
                                "target_lang_word": "обнажать",
                                "target_lang_sense_clarification": "делать явным, обнаруживать суть проблемы или правду"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "293d14fe-bfe9-3bfe-92df-0699b44a2387",
                    "sense_definition": "To leave someone or something unprotected from a harmful or dangerous substance, condition, or influence.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vulnerability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you stay outside too long, you will <w>expose</w> yourself to harmful UV rays.",
                            "target_lang_translations": {
                                "ru": "Если вы будете оставаться на улице слишком долго, вы <w>подвергнете</w> себя воздействию вредных УФ-лучей."
                            }
                        },
                        {
                            "text": "The workers were <w>exposed</w> to chemicals without proper safety equipment.",
                            "target_lang_translations": {
                                "ru": "Рабочие <w>подвергались</w> воздействию химикатов без надлежащих средств защиты."
                            }
                        }
                    ],
                    "antonyms": [
                        "protect",
                        "shield",
                        "guard"
                    ],
                    "common_phrases": [
                        "expose to danger",
                        "expose to risk",
                        "exposed to chemicals"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оставить кого-либо или что-либо без защиты от вредного или опасного вещества, условия или влияния."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подвергать",
                                "target_lang_sense_clarification": "ставить в условия воздействия чего-либо опасного"
                            },
                            {
                                "target_lang_word": "оставлять без защиты",
                                "target_lang_sense_clarification": "делать уязвимым перед опасностью"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4452f63d-d9c3-3fcc-9cba-d52d1b3eeefc",
                    "sense_definition": "To allow light to reach a piece of photographic film or a sensor to record an image.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "photography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to <w>expose</w> the film for exactly three seconds to get the right brightness.",
                            "target_lang_translations": {
                                "ru": "Вам нужно <w>экспонировать</w> пленку ровно три секунды, чтобы получить нужную яркость."
                            }
                        },
                        {
                            "text": "If you <w>expose</w> the sensor for too long, the photo will be completely white.",
                            "target_lang_translations": {
                                "ru": "Если <w>держать</w> сенсор открытым слишком долго, фотография будет полностью белой."
                            }
                        }
                    ],
                    "common_phrases": [
                        "expose the film",
                        "correctly expose"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in photography"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Позволить свету достичь фотопленки или сенсора для записи изображения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "экспонировать",
                                "target_lang_sense_clarification": "технический термин в фотографии"
                            },
                            {
                                "target_lang_word": "делать выдержку",
                                "target_lang_sense_clarification": "выдерживать пленку под светом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "19663337-3ee2-308e-85b4-a185ad02dc25",
                    "sense_definition": "To make specific data or functions available for use by other parts of a computer program or external systems.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The API will <w>expose</w> functionality to third-party developers.",
                            "target_lang_translations": {
                                "ru": "API <w>предоставит</w> функциональность сторонним разработчикам."
                            }
                        },
                        {
                            "text": "We should only <w>expose</w> the necessary data to ensure system security.",
                            "target_lang_translations": {
                                "ru": "Нам следует <w>открывать</w> только необходимые данные для обеспечения безопасности системы."
                            }
                        }
                    ],
                    "antonyms": [
                        "hide",
                        "encapsulate"
                    ],
                    "common_phrases": [
                        "expose an API",
                        "expose data"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in software development"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать определенные данные или функции доступными для использования другими частями компьютерной программы или внешними системами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предоставлять доступ",
                                "target_lang_sense_clarification": "делать функции доступными извне"
                            },
                            {
                                "target_lang_word": "открывать",
                                "target_lang_sense_clarification": "делать данные или API доступными для взаимодействия"
                            },
                            {
                                "target_lang_word": "экспонировать",
                                "target_lang_sense_clarification": "в контексте разработки ПО и API"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e37da4ea-7a3d-320a-b0fd-f762094e13ee",
                    "sense_definition": "To abandon a person, especially an infant, in an unprotected place.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "abandonment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In some ancient cultures, it was a practice to <w>expose</w> unwanted infants in the wilderness.",
                            "target_lang_translations": {
                                "ru": "В некоторых древних культурах практиковалось <w>оставлять</w> нежеланных младенцев в дикой местности."
                            }
                        },
                        {
                            "text": "The tragic story tells of a child <w>exposed</w> on a mountainside to die.",
                            "target_lang_translations": {
                                "ru": "Трагическая история повествует о ребенке, <w>оставленном</w> на склоне горы умирать."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "refers to historical practices"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Оставить человека, особенно младенца, в незащищенном месте на произвол судьбы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оставлять на произвол судьбы",
                                "target_lang_sense_clarification": "бросать без защиты в опасном месте"
                            },
                            {
                                "target_lang_word": "выставлять",
                                "target_lang_sense_clarification": "исторический термин, касающийся оставления детей"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}