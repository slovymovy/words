                ],
                "senses": [
                    {
                        "sense_id": "0a8aa725-6879-35bb-8e7a-11020564f340",
                        "entry_id": "404b36a4-5047-377f-87c0-d5b611a5b32f",
                        "glosses": [
                            "Crème chantilly espagnole ou portugaise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb120bf3-d165-47c8-ad17-df6d8d981a95",
                                "sense_id": "0a8aa725-6879-35bb-8e7a-11020564f340",
                                "text": "Au moment des desserts, les figues confites s’accompagnent d’une glace catalane au touron et à la nata (crème chantilly espagnole)."
                            },
                            {
                                "example_id": "fa0cbe5d-d328-47c3-840b-ff1c5501bfdf",
                                "sense_id": "0a8aa725-6879-35bb-8e7a-11020564f340",
                                "text": "Gardez une petite place pour la fin, les desserts maison sont délicieux : churros au chocolat, crème brûlée et noix à la nata, miel et chantilly."
                            }
                        ]
                    },
                    {
                        "sense_id": "f00aef30-21b4-3784-b67d-7da30b98b702",
                        "entry_id": "404b36a4-5047-377f-87c0-d5b611a5b32f",
                        "glosses": [
                            "Pâtisserie à la crème portugaise."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "584014b6-cd47-4fec-9c9c-7cf678eb6e96",
                                "sense_id": "f00aef30-21b4-3784-b67d-7da30b98b702",
                                "text": "Le nata suscite un intérêt qui ne fait que croître."
                            }
                        ]
                    },
                    {
                        "sense_id": "30933b7b-945b-3318-a161-442314439074",
                        "entry_id": "404b36a4-5047-377f-87c0-d5b611a5b32f",
                        "glosses": [
                            "Aliment gélatineux formé par la fermentation de jus de fruits, ingrédient de dessert aux Philippines."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "d8c5811b-94e0-4471-8718-a174b225696f",
                                "sense_id": "30933b7b-945b-3318-a161-442314439074",
                                "text": "Aux Philippines, le jus extrait de l’ananas ou de débris d’ananas sert à produire une pâtisserie appelée nata de piña. Sa préparation ressemble assez à celle de la nata de coco obtenue à partir de la noix de coco. La nata est une épaisse pellicule gélatineuse de couleur crème obtenue en cultivant Acetobacter aceti subsp. xylinum sur un milieu acidifié, qui contient des sucres et d’autres éléments nutritifs."
                            }
                        ]
                    }
                ],
