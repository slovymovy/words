                "senses": [
                    {
                        "sense_id": "d66f25a8-f72c-3cca-a58f-8ed2de908fb8",
                        "entry_id": "20db43af-ac23-37f7-9545-5e06316d9eb6",
                        "glosses": [
                            "Wirtschaftsbereich, der sich mit Finanzen beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f913d12c-5207-4c83-a3f8-5969f976401b",
                                "sense_id": "d66f25a8-f72c-3cca-a58f-8ed2de908fb8",
                                "text": "„Die Ertragslage der Banksparte bei Wirecard ist intransparent und außerdem verschleiert Wirecard Erträge aus der Abwicklung des Online-Wettgeschäftes.“"
                            },
                            {
                                "example_id": "cca526d6-e45d-4508-b043-1daf037ed172",
                                "sense_id": "d66f25a8-f72c-3cca-a58f-8ed2de908fb8",
                                "text": "„Die Ertragslage der Banksparte sei intransparent, zudem verschleiere die Firma Erträge aus der Abwicklung von Online-Wettgeschäften.“"
                            },
                            {
                                "example_id": "562f9531-b008-4287-9129-18407c1773db",
                                "sense_id": "d66f25a8-f72c-3cca-a58f-8ed2de908fb8",
                                "text": "„Alle drei Probleme lassen sich bei einer Eigengründung wie im Fall der Deutschen Bank zwar nicht vollständig beseitigen, bei einer von der Banksparte separierten Versicherung unter dem Konzerndach aber deutlich abmildern.“"
                            },
                            {
                                "example_id": "ec859add-fbd3-4da5-9ce4-c6a8e3b857f0",
                                "sense_id": "d66f25a8-f72c-3cca-a58f-8ed2de908fb8",
                                "text": "„Zudem wolle er der Behörde mehr Durchgriffsrechte bei der Kontrolle von Bilanzen geben - unabhängig davon, ob der Konzern eine Banksparte habe oder nicht, sagte Scholz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
