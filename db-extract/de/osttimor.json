                                "target_senses": [
                                    {
                                        "sense_id": "c84cbcf1-8d46-3227-b2a0-88ba2291fd4d",
                                        "entry_id": "37ccae9d-c35e-370e-b89b-d095828387bc",
                                        "glosses": [
                                            "Pays d’Asie, constitué de la moitié orientale de l’île de Timor et de l’exclave d’Oecusse, et dont la capitale est Dili."
                                        ],
                                        "tags": [
                                            "Pays"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "744bf04e-9309-4666-820d-4af9ad45ada3",
                                                "sense_id": "c84cbcf1-8d46-3227-b2a0-88ba2291fd4d",
                                                "text": "Quant au Timor oriental, demeuré portugais jusqu’en 1975, il est annexé par l’Indonésie et ne deviendra indépendant qu’en 2002."
                                            },
                                            {
                                                "example_id": "30368a4c-2949-43f9-a1cd-d6908aa3c0f9",
                                                "sense_id": "c84cbcf1-8d46-3227-b2a0-88ba2291fd4d",
                                                "text": "Un prêtre américain défroqué a été condamné mardi à 12 ans de prison pour abus sexuels sur des enfants d’un orphelinat du Timor oriental qu’il a fondé, a l’issue d’un procès qui a divisé le pays d’Asie du Sud-Est profondément catholique."
                                            },
                                            {
                                                "example_id": "85acb537-ab52-41bd-a65a-d79199991cc0",
                                                "sense_id": "c84cbcf1-8d46-3227-b2a0-88ba2291fd4d",
                                                "text": "On ne parle pas portugais seulement à Lisbonne ou à Brasilia, mais aussi en Angola, à Macao ou au Timor oriental."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
