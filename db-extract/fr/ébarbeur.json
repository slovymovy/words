                ],
                "senses": [
                    {
                        "sense_id": "b128ef79-449d-361e-8d98-eaaee5a58e4f",
                        "entry_id": "22be4b1e-2786-3ee0-80f6-eb02327244ac",
                        "glosses": [
                            "Qui sert à l’ébarbage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8dbbd97a-09e2-4a31-becc-1ae7cc86c9bf",
                                "sense_id": "b128ef79-449d-361e-8d98-eaaee5a58e4f",
                                "text": "Produits difficilement ébarbables - enclencher le bloc ébarbeur ou les volets d’ébarbage (équipement spécial)."
                            },
                            {
                                "example_id": "9be87af0-61e5-4da4-9276-362776470613",
                                "sense_id": "b128ef79-449d-361e-8d98-eaaee5a58e4f",
                                "text": "En 1889, la chute du patouillet fait mouvoir une roue à palettes, d’environ 8 m de diamètre, qui met en jeu trois tours, deux machines à percer, quatre poinçonneuses, un balancier et un mouton à estamper, un cylindre ébarbeur et une meule."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "9f8cf225-3e3e-3ae3-883b-5d676508f3ab",
                "word": "ébarbeur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "91813e64-798c-4844-83e5-7c718a75f1f4",
                        "entry_id": "9f8cf225-3e3e-3ae3-883b-5d676508f3ab",
                        "tags": [
                            "plural"
                        ],
                        "form": "ébarbeurs"
                    },
                    {
                        "form_id": "9487fe54-c817-4161-9fc7-14f7a3e94270",
                        "entry_id": "9f8cf225-3e3e-3ae3-883b-5d676508f3ab",
                        "tags": [
                            "feminine"
                        ],
                        "form": "ébarbeuse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c4029029-fd3a-3584-b520-a3e92145a4ed",
                        "entry_id": "9f8cf225-3e3e-3ae3-883b-5d676508f3ab",
                        "glosses": [
                            "Ouvrier chargé de l’ébarbage, la finition de pièces métalliques."
                        ],
                        "tags": [
                            "Métier"
                        ],
                        "examples": [
                            {
                                "example_id": "3932bfba-245c-404d-92e1-41cc12628d84",
                                "sense_id": "c4029029-fd3a-3584-b520-a3e92145a4ed",
                                "text": "Depuis 1920, l’assuré travaillait comme ébarbeur dans une fonderie de fer où il était chargé d’enlever au burin pneumatique le sable de moulage et de noyautage adhérent à de grosses pièces de fonte."
                            },
                            {
                                "example_id": "b5c1046f-7654-45db-a6d4-e798124245b3",
                                "sense_id": "c4029029-fd3a-3584-b520-a3e92145a4ed",
                                "text": "À la fonderie, Brahim est successivement ébarbeur puis mouleur, deux postes durs, bruyants et très empoussiérés. En 1978, il commence à tousser, en particulier la nuit, d'une toux au début discrète mais tenace."
                            },
                            {
                                "example_id": "f4a8dd41-27a5-42f6-8edd-09fbe7d13d41",
                                "sense_id": "c4029029-fd3a-3584-b520-a3e92145a4ed",
                                "text": "Puis il trouve du travail dans une usine de Caudebec-lès-Elbeuf, et enfin à la fonderie Manoir Industries. « Je m’occupais de la finition des pièces, j’étais ébarbeur-meuleur. J’ai fait ce travail jusqu’à la retraite en 2003 »."
                            }
                        ]
                    },
                    {
                        "sense_id": "d3148678-1c58-3c5f-9135-22e228d42404",
                        "entry_id": "9f8cf225-3e3e-3ae3-883b-5d676508f3ab",
                        "glosses": [
                            "Machine ou outil à ébarber, à retirer les barbes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3c46649-e5a6-48c5-968e-b5ddaf4ca902",
                                "sense_id": "d3148678-1c58-3c5f-9135-22e228d42404",
                                "text": "Comme appareil accessoire de l’opération du battage des grains se trouve l’ébarbeur d’orge qui est quelquefois séparé de la machine à battre, et constitue un instrument spécial dont il est nécessaire d’indiquer le principe."
                            },
                            {
                                "example_id": "7a8a7d0d-9eb9-4405-a5da-50f140571f9a",
                                "sense_id": "d3148678-1c58-3c5f-9135-22e228d42404",
                                "text": "Le grain qu’on voudra bien supposer barbu, porté dans les combles ou à une hauteur voulue, tombe dans un ébarbeur, cylindre vertical en fonte, fixé au plancher, enveloppant une sorte de peigne hérisson dont les dents longues et plates, sortes de lames de couteau sans tranchant, mues à plat dans le plan horizontal, sont implantées suivant le rayon dans un axe tournant."
                            }
                        ]
                    }
                ],
