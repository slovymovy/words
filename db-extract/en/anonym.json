                "translations": [
                    {
                        "translation_id": "34a745c2-c449-444f-bd13-e94fde949e2b",
                        "source_entry_id": "32028308-abd8-31b9-9371-fb9c940c5df7",
                        "source_sense_id": "400967ee-7ea0-3096-be60-f607bfb869f6",
                        "source_sense_description": "falscher Name (Pseudonym)",
                        "target_lang_word": "anonym",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anonym",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e20a3ada-b555-398d-ba7a-5451aec61e93",
                                        "entry_id": "805044f8-681f-3969-8f70-7b6ce817fcec",
                                        "glosses": [
                                            "die Angabe des Urhebers auslassend, unterlassend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f30021c-8466-4c30-b87d-8e7333d0b220",
                                                "sense_id": "e20a3ada-b555-398d-ba7a-5451aec61e93",
                                                "text": "Die „Nachtwachen des Bonaventura“ haben einen anonymen Verfasser."
                                            },
                                            {
                                                "example_id": "79b435a8-690b-40e8-b626-d45d9a196f0d",
                                                "sense_id": "e20a3ada-b555-398d-ba7a-5451aec61e93",
                                                "text": "„Ermittler stießen auf dieses Datum, nachdem auch ihnen die Mails in Kopie anonym zugeschickt worden waren.“"
                                            },
                                            {
                                                "example_id": "ddc426ec-357e-42d0-8f2c-1f89f9376d56",
                                                "sense_id": "e20a3ada-b555-398d-ba7a-5451aec61e93",
                                                "text": "„Ferner verbot Trajan die Beachtung anonymer Denunziationen und schließlich endete das Reskript mit einem Bekenntnis, […]: Ein allzu inquisitorisches Verhalten seitens des Staates werde dem Geist der Epoche nicht gerecht.“"
                                            },
                                            {
                                                "example_id": "6e4e897d-8dc0-4a4a-b477-a580252fd147",
                                                "sense_id": "e20a3ada-b555-398d-ba7a-5451aec61e93",
                                                "text": "„Tatsächlich jagte mir der Gedanke sogar Angst ein. Nicht nur der Gedanke, auf der Bühne zu stehen, sondern die Tatsache, dass meine Arbeit mich ins Licht der Öffentlichkeit zog. Ich war ganz glücklich mit meinem anonymen Dasein. Viele Songwriter treten gar nicht selbst auf, und am liebsten wollte ich so einer werden.“"
                                            },
                                            {
                                                "example_id": "2a2cef59-3d17-4112-a12f-7827b568c475",
                                                "sense_id": "e20a3ada-b555-398d-ba7a-5451aec61e93",
                                                "text": "„Das hatte jedenfalls die Vorhut der anonymen Tester aus seinem Munde wenige Tage zuvor erfahren.“"
                                            },
                                            {
                                                "example_id": "40ae9a72-a9b6-47f0-820b-93fa5f9ed9c5",
                                                "sense_id": "e20a3ada-b555-398d-ba7a-5451aec61e93",
                                                "text": "„Oliver Gerber heisst eigentlich anders. Weil die Familie seiner Partnerin in China lebt und mit Repressionen rechnet, wenn sein Name in der Zeitung steht, möchte er anonym bleiben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
