                                            {
                                                "example_id": "521f890f-322e-4e49-b4a4-c193907d9a7a",
                                                "sense_id": "877ab097-4822-3aef-b9d4-d4f49ff5c65c",
                                                "text": "It's not unreasonable to verify his claims by cross-checking them with third parties. That's called due diligence."
