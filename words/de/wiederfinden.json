                },
                {
                    "sense_id": "b1f2437d-c6ac-3ed8-b7fa-371cb3962d0a",
                    "sense_definition": "plötzlich oder unerwartet an einem Ort oder in einer Situation sein; wieder zu sich kommen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "zustand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nach dem schweren Unfall <w>fand</w> er sich plötzlich auf der Intensivstation <w>wieder</w>."
