                "senses": [
                    {
                        "sense_id": "13c51919-b3fd-3b50-93a9-84484165512a",
                        "entry_id": "7144043b-5d3e-33e9-a69c-50b75c236aab",
                        "glosses": [
                            "Donner une forme de pentagone à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e652d99f-f425-49b7-b66f-f062b4362fce",
                                "sense_id": "13c51919-b3fd-3b50-93a9-84484165512a",
                                "text": "Voilà, les barres ont été \"pentagonisées\" et c'est vrai que c'est beaucoup plus réaliste."
                            }
                        ]
                    },
                    {
                        "sense_id": "cac7e9f6-60cc-302f-89f0-936cd4aec14f",
                        "entry_id": "7144043b-5d3e-33e9-a69c-50b75c236aab",
                        "glosses": [
                            "Influencer, en parlant du Pentagone (département de la Défense des États-Unis)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01d7d9e1-d883-4e33-89f6-ce1a65a21765",
                                "sense_id": "cac7e9f6-60cc-302f-89f0-936cd4aec14f",
                                "text": "Pourquoi M. Obama se laisse-t-il ’pentagoniser' ?"
                            },
                            {
                                "example_id": "af3c6d24-0fb9-4863-96cc-5398246e4a29",
                                "sense_id": "cac7e9f6-60cc-302f-89f0-936cd4aec14f",
                                "text": "En parlant strictement de l’écrivain de Gaulle, j’ai essayé de montrer que dans notre monde de l’acier pentagonisé à mort, son écriture, son langage, ce langage qu’on prête au peuple était la véritable subversion comme les idéogrammes de son collègue Mao."
                            }
                        ]
                    }
