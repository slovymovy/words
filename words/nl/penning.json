                                "target_lang_sense_clarification": "a large medal or coin-shaped ornament"
                            },
                            {
                                "target_lang_word": "token",
                                "target_lang_sense_clarification": "a commemorative coin-like object"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1c7a456b-f30f-31b9-ab88-0fd47fbbc2e3",
                    "sense_definition": "Een tactische situatie bij schaken waarbij een stuk niet kan bewegen omdat er anders een waardevoller stuk wordt geslagen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "schaken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De witspeler won de partij door een slimme <w>penning</w> van de zwarte dame.",
                            "target_lang_translations": {
                                "en": "The white player won the game through a clever <w>pin</w> of the black queen."
                            }
                        },
                        {
                            "text": "Hij kon zijn paard niet verzetten vanwege een <w>penning</w> door de loper.",
                            "target_lang_translations": {
                                "en": "He could not move his knight because of a <w>pin</w> by the bishop."
                            }
                        }
                    ],
                    "common_phrases": [
                        "absolute penning",
                        "relatieve penning"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "schaken"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A tactical situation in chess where a piece cannot move because doing so would expose a more valuable piece to being captured."
                    },
                    "translations": {
                        "en": [
