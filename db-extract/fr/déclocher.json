                "senses": [
                    {
                        "sense_id": "68151c64-b7a3-3d8b-90ed-fbedcb9cfa1a",
                        "entry_id": "4119c324-ff5e-31a1-81ed-9d1553a4a889",
                        "glosses": [
                            "Retirer la cloche qui couvrait (quelque chose : un plat, une plante)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7e84c09-344e-44f6-a0e3-ade6e44905b6",
                                "sense_id": "68151c64-b7a3-3d8b-90ed-fbedcb9cfa1a",
                                "text": "Quand il est à son tour assis en face de moi, il me demande de « déclocher » mon plat."
                            },
                            {
                                "example_id": "151efeb9-254d-45b8-95e7-1f28247c37ea",
                                "sense_id": "68151c64-b7a3-3d8b-90ed-fbedcb9cfa1a",
                                "text": "En particulier au moment de déclocher les plats et d'annoncer ce que nous mangeons."
                            },
                            {
                                "example_id": "0da8780e-ab39-427a-9fff-2065c16ec531",
                                "sense_id": "68151c64-b7a3-3d8b-90ed-fbedcb9cfa1a",
                                "text": "C’est alors que doit se faire le second travail consistant à déclocher, pour passer en revue les boutures."
                            },
                            {
                                "example_id": "64172ab4-eea4-463a-b6aa-aed7c32b6403",
                                "sense_id": "68151c64-b7a3-3d8b-90ed-fbedcb9cfa1a",
                                "text": "Tatine, réjouis-toi, je viens de retourner au jardin pour déclocher les tomates et et ouvrir le vasistas de la serre et j'ai regardé le thermomètre : mini de cette nuit : 0°!"
                            }
                        ]
                    }
