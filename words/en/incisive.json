    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "625b60d2-de1a-3f02-9ad5-865dbb2a5835",
                    "sense_definition": "Intelligently analytical, concise, and sharply focused in thought or expression.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "mental_intellectual",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The journalist earned praise for her <w>incisive</w> questions during the heated press conference.",
                            "target_lang_translations": {
                                "nl": "De journalist kreeg lof voor haar <w>scherpzinnige</w> vragen tijdens de verhitte persconferentie."
                            }
                        },
                        {
                            "text": "Her <w>incisive</w> analysis exposed the subtle flaws hidden within the financial proposal.",
                            "target_lang_translations": {
                                "nl": "Haar <w>scherpzinnige</w> analyse legde de subtiele fouten bloot die in het financiële voorstel verborgen zaten."
                            }
                        }
                    ],
                    "synonyms": [
                        "acute",
                        "sharp"
                    ],
                    "antonyms": [
                        "vague",
                        "dull"
                    ],
                    "common_phrases": [
                        "incisive analysis",
                        "incisive commentary",
                        "incisive questioning",
                        "incisive mind"
                    ],
                    "target_lang_definitions": {
                        "nl": "Scherpzinnig, analytisch en kernachtig geformuleerd."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "scherpzinnig",
                                "target_lang_sense_clarification": "intelligent en snel van begrip"
                            },
                            {
                                "target_lang_word": "snijdend",
                                "target_lang_sense_clarification": "scherp en raak analyserend"
                            },
                            {
                                "target_lang_word": "trefzeker",
                                "target_lang_sense_clarification": "precies de kern rakend"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ddb19b3b-2ff7-3dc7-9a61-a5eaffa05066",
                    "sense_definition": "Quick, direct, and forceful in decision, action, or tone.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "manner_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee commended his <w>incisive</w> leadership during the sudden administrative crisis.",
                            "target_lang_translations": {
                                "nl": "De commissie prees zijn <w>doortastende</w> leiderschap tijdens de plotselinge bestuurscrisis."
                            }
                        },
                        {
                            "text": "She handled the negotiations with <w>incisive</w> remarks that quickly ended all debate.",
                            "target_lang_translations": {
                                "nl": "Ze leidde de onderhandelingen met <w>krachtige</w> opmerkingen die snel een einde maakten aan elk debat."
                            }
                        }
                    ],
                    "synonyms": [
                        "decisive",
                        "forthright"
                    ],
                    "antonyms": [
                        "hesitant",
                        "indecisive"
                    ],
                    "common_phrases": [
                        "incisive leadership",
                        "incisive action"
                    ],
                    "target_lang_definitions": {
                        "nl": "Besluitvaardig, direct en krachtig in optreden of leiderschap."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "doortastend",
                                "target_lang_sense_clarification": "krachtig en snel handelend"
                            },
                            {
                                "target_lang_word": "besluitvaardig",
                                "target_lang_sense_clarification": "snel en overtuigend knopen doorhakkend"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bfdc7895-1259-3738-a061-5fa689f9be7e",
                    "sense_definition": "Cutting, penetrating, or biting, as if piercing through physical barriers.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_penetration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her <w>incisive</w> tone cut through the background noise of the crowded courtroom.",
                            "target_lang_translations": {
                                "nl": "Haar <w>snijdende</w> toon sneed door het achtergrondgeluid van de overvolle rechtszaal."
                            }
                        },
                        {
                            "text": "He offered an <w>incisive</w> critique that hurt his colleague's feelings deeply.",
                            "target_lang_translations": {
                                "nl": "Hij leverde een <w>bijtende</w> kritiek die de gevoelens van zijn collega diep kwetste."
                            }
                        }
                    ],
                    "synonyms": [
                        "biting",
                        "sarcastic"
                    ],
                    "antonyms": [
                        "gentle",
                        "soothing"
                    ],
                    "common_phrases": [
                        "incisive wit",
                        "incisive critique"
                    ],
                    "target_lang_definitions": {
                        "nl": "Bijtend, vlijmscherp of kwetsend van toon of uitwerking."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "vlijmscherp",
                                "target_lang_sense_clarification": "zeer fel en doordringend"
                            },
                            {
                                "target_lang_word": "bijtend",
                                "target_lang_sense_clarification": "scherp en sarcastisch of kwetsend"
                            },
                            {
                                "target_lang_word": "snijdend",
                                "target_lang_sense_clarification": "hard en pijnlijk direct"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "48b0f7ec-58c0-3c03-9980-0b11639ce936",
                    "sense_definition": "Relating to the incisor teeth or adjacent structures of the jaw.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dentist carefully examined the <w>incisive</w> canal before planning the procedure.",
                            "target_lang_translations": {
                                "nl": "De tandarts onderzocht het <w>incisieve</w> kanaal zorgvuldig voordat de ingreep werd gepland."
                            }
                        },
                        {
                            "text": "Damage to the <w>incisive</w> bone can affect the alignment of the front teeth.",
                            "target_lang_translations": {
                                "nl": "Schade aan het <w>tussenkaaksbeen</w> kan de uitlijning van de voortanden beïnvloeden."
                            }
                        }
                    ],
                    "common_phrases": [
                        "incisive canal",
                        "incisive foramen",
                        "incisive bone"
                    ],
                    "target_lang_definitions": {
                        "nl": "Met betrekking tot de snijtanden of het nabijgelegen kaakgebied."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "incisief",
                                "target_lang_sense_clarification": "anatomische term voor het snijtandencomplex"
                            },
                            {
                                "target_lang_word": "snijtands-",
                                "target_lang_sense_clarification": "betrekking hebbend op de snijtand"
                            }
                        ]
                    }
                }
            ]
        }
    ]
