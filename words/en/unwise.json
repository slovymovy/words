            "senses": [
                {
                    "sense_id": "dc475e08-ba2e-3ab2-a75f-2b796435a08d",
                    "sense_definition": "Lacking good judgment or common sense; likely to lead to bad results.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "judgment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It would be <w>unwise</w> to make such a big decision without talking to your family first.",
                            "target_lang_translations": {
                                "tr": "Ailenle önce konuşmadan bu kadar büyük bir karar vermek <w>akılsızca</w> olurdu."
                            }
                        },
                        {
                            "text": "The manager made an <w>unwise</w> choice by ignoring the warnings from his team.",
                            "target_lang_translations": {
                                "tr": "Yönetici, ekibinden gelen uyarıları görmezden gelerek <w>basiretsiz</w> bir seçim yaptı."
                            }
                        }
                    ],
                    "synonyms": [
                        "injudicious",
                        "indiscreet",
                        "foolish",
                        "imprudent"
                    ],
                    "antonyms": [
                        "wise"
                    ],
                    "common_phrases": [
                        "highly unwise",
                        "unwise decision",
                        "unwise choice"
                    ],
                    "target_lang_definitions": {
                        "tr": "İyi bir muhakeme yeteneğinden yoksun; kötü sonuçlara yol açması muhtemel, akılsızca."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "akılsızca",
                                "target_lang_sense_clarification": "Mantıksız veya düşüncesizce yapılan eylemler için kullanılır."
                            },
                            {
                                "target_lang_word": "basiretsiz",
                                "target_lang_sense_clarification": "Öngörüsüz veya yanlış kararlar veren kişiler için kullanılır."
                            },
                            {
                                "target_lang_word": "tedbirsiz",
                                "target_lang_sense_clarification": "Gerekli önlemleri almayan veya riskli davranan durumlar için kullanılır."
                            }
                        ]
                    }
                }
            ]
        }
    ]
