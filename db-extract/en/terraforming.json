    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "130bf4f1-c186-3f90-8972-8ff72a8a7f2e",
                "word": "terraforming",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "260b5d82-e9ae-30be-8b3c-53af4038faf9",
                        "entry_id": "130bf4f1-c186-3f90-8972-8ff72a8a7f2e",
                        "glosses": [
                            "The hypothetical process of deliberately modifying the atmosphere, temperature, surface topography or ecology of a planet, moon, etc. to make it similar to those of Earth and thus suitable for human life."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "dc1c5b01-b125-455e-ab7c-0c90174d4395",
                                "sense_id": "260b5d82-e9ae-30be-8b3c-53af4038faf9",
                                "text": "Almarcrux's abundant water and relatively mild temperature and gravity have placed it on the short list of terraforming candidate worlds. However, there is significant opposition from eco-ethics groups, who assert that Almarcrux's primitive methanotrophic bacteria may be a precursor to a full-fledged native ecology."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "120b069c-e553-449a-a3ac-d4e79e5c6a3d",
