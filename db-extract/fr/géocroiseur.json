                "senses": [
                    {
                        "sense_id": "7d070065-02ac-3aa3-94f5-8140e9735819",
                        "entry_id": "c4264763-93c0-39b5-b9a4-216cb82b88d2",
                        "glosses": [
                            "Corps céleste, tel qu’un astéroïde ou une comète, qui est susceptible d’entrer en collision avec la Terre et de provoquer des effets dévastateurs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44c1b287-3956-450b-b275-f8b87f7d4bac",
                                "sense_id": "7d070065-02ac-3aa3-94f5-8140e9735819",
                                "text": "Si nous sommes un jour confrontés à un géocroiseur menaçant la vie sur Terre, il sera crucial de déterminer la technique la plus appropriée pour parer à la menace."
                            },
                            {
                                "example_id": "36606fe6-d327-46d8-a7db-d60bc388cf06",
                                "sense_id": "7d070065-02ac-3aa3-94f5-8140e9735819",
                                "text": "Ce géocroiseur (astéroïde proche de la Terre) met cinq années à faire le tour du Soleil, et se trouve aujourd'hui à plusieurs millions de kilomètres de la Terre au plus proche."
                            }
                        ]
                    }
                ],
                "translations": [
