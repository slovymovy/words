                "senses": [
                    {
                        "sense_id": "3e40f0cd-c4f5-3ec3-b1f9-9f903eb2c33d",
                        "entry_id": "756981c1-35f0-30e0-965a-f326c1433805",
                        "glosses": [
                            "Ansteigen der Preise"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4042bca5-fb35-43ee-94bd-af3be44d144f",
                                "sense_id": "3e40f0cd-c4f5-3ec3-b1f9-9f903eb2c33d",
                                "text": "„Der Preisauftrieb wird 1967 fünf Prozent überschreiten und damit einen weiteren negativen Rekord fixieren.“"
                            },
                            {
                                "example_id": "1dec30bc-e741-4468-a621-7f51dfd676bc",
                                "sense_id": "3e40f0cd-c4f5-3ec3-b1f9-9f903eb2c33d",
                                "text": "„Jahrelang waren die Dollars nach Europa geflossen (vor allem durch die hohen Auslandsinvestitionen der amerikanischen Großunternehmen) und hatten hier die Konjunktur und manchmal leider auch den Preisauftrieb auf Touren gehalten.“"
                            }
                        ],
