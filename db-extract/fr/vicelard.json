                    {
                        "form_id": "4f2f26af-a6dc-427f-9d9c-513fe20efd1d",
                        "entry_id": "d39bc1ba-fd85-3655-9bee-76521de20b9a",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "vicelardes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "313026ba-9f42-3cb9-b608-e5c1a75edcea",
                        "entry_id": "d39bc1ba-fd85-3655-9bee-76521de20b9a",
                        "glosses": [
                            "Pervers, retors, rusé, vicieux."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "53feedfb-3863-4822-af50-f14efd4c7d2a",
                                "sense_id": "313026ba-9f42-3cb9-b608-e5c1a75edcea",
                                "text": "Ce que je souhaite, dit Verdier, c'est que ces ordures ne ridiculisent pas mon ami Domergue, spécialiste du drame de campagne, de la psychologie paysanne, mais complètement étranger aux saloperies vicelardes des barbouzes."
                            },
                            {
                                "example_id": "10f0f7ac-99be-490c-966a-5bf83ac40381",
                                "sense_id": "313026ba-9f42-3cb9-b608-e5c1a75edcea",
                                "text": "À côté de lui, un petit blond avec des yeux vicelards jouant à se dévisser la mâchoire, menotté aussi."
                            },
                            {
                                "example_id": "e7406408-86fd-420d-befc-d1b8b8f43fac",
                                "sense_id": "313026ba-9f42-3cb9-b608-e5c1a75edcea",
                                "text": "Qu’on se comprenne bien : il ne prend aucun plaisir à tuer, à achever l’animal blessé. Ce n’est pas un vicelard. Non, ce qui lui plaît, c’est le geste technique, la routine sans faille qui s’installe à force de répétitions."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "95ee204d-ae6e-4d76-94f7-31d2992275c3",
                        "source_entry_id": "d39bc1ba-fd85-3655-9bee-76521de20b9a",
                        "source_sense_id": "313026ba-9f42-3cb9-b608-e5c1a75edcea",
                        "target_lang_word": "dreckig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dreckig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0ac0d93a-7895-32a5-a09b-2bf3520cd6ab",
                                        "entry_id": "2ecbf835-38ed-3c09-b78b-134c81d76148",
                                        "glosses": [
                                            "schmutzig, von Dreck befallen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c833994a-ea76-44a8-8c0f-e7af872e7972",
                                                "sense_id": "0ac0d93a-7895-32a5-a09b-2bf3520cd6ab",
                                                "text": "Der Boden ist sehr dreckig."
                                            },
                                            {
                                                "example_id": "5228ea9b-41b1-421d-9fde-65669bbedf0e",
                                                "sense_id": "0ac0d93a-7895-32a5-a09b-2bf3520cd6ab",
                                                "text": "Sabrina spielte Rugby und sehr schnell wurde ihr weißes Trikot sehr dreckig."
                                            },
                                            {
                                                "example_id": "241e8f69-c312-4412-9b78-0ee664a969ba",
                                                "sense_id": "0ac0d93a-7895-32a5-a09b-2bf3520cd6ab",
                                                "text": "„Die Schlafsäle, an denen sie vorbeikamen, waren vollgestopft mit Kindern, um die 40 pro Raum, die nichts am Leib hatten außer einem dreckigen Hemdchen oder einer dreckigen Unterhose, aber offenbar niemals beides.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bbf1e533-7dde-3a98-affb-e942bad01eda",
                                        "entry_id": "2ecbf835-38ed-3c09-b78b-134c81d76148",
                                        "glosses": [
                                            "unehrenhaft, gemein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c792dd8-917a-4622-96c0-d096af8c405e",
                                                "sense_id": "bbf1e533-7dde-3a98-affb-e942bad01eda",
                                                "text": "Das war ziemlich dreckig von dir."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dd1e9dfc-72f9-40f0-a293-0a9fbb734307",
                        "source_entry_id": "d39bc1ba-fd85-3655-9bee-76521de20b9a",
