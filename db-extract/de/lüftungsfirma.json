                "senses": [
                    {
                        "sense_id": "c28f05de-bbf4-3b57-b65b-9d17d505c006",
                        "entry_id": "1f207f70-629c-3870-a919-7459fd3c6951",
                        "glosses": [
                            "Unternehmen, welches sich mit Lüftungstechnik befasst"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "3e0c3f4f-4af1-4062-998f-cd700d74efc2",
                                "sense_id": "c28f05de-bbf4-3b57-b65b-9d17d505c006",
                                "text": "Die Lüftungsfirma übernahm die Planung und die Realisierung der gesamten Lüftungstechnik im Haus."
                            },
                            {
                                "example_id": "565d7606-4c1b-46a5-bd7a-f9425813d804",
                                "sense_id": "c28f05de-bbf4-3b57-b65b-9d17d505c006",
                                "text": "„Die Kälte- und Lüftungsfirma Pithard, Hanau mit 8 Mitarbeitern kann übernommen werden.“"
                            },
                            {
                                "example_id": "f2d305be-e45e-4926-a607-2fa8ff65f7f4",
                                "sense_id": "c28f05de-bbf4-3b57-b65b-9d17d505c006",
                                "text": "„Hier unterrichteten Alfred und George Tack gemeinsam mit Verkaufsleitern und Verkaufsdirektoren der Lüftungsfirma, wodurch ein bodenständiges und praxisgerechtes Training gewährleistet wurde.“"
                            },
                            {
                                "example_id": "00395bc9-7e6f-4fce-bc56-75ef927d2a35",
                                "sense_id": "c28f05de-bbf4-3b57-b65b-9d17d505c006",
                                "text": "„Systemair hat die Übernahme der holländischen Lüftungsfirma Rucon bekannt gegeben.“"
                            },
                            {
                                "example_id": "01559521-2290-4560-ba20-4f57281e1adf",
                                "sense_id": "c28f05de-bbf4-3b57-b65b-9d17d505c006",
                                "text": "„Novema aggregater as ist mit einem jährlichen Umsatz von 145 MNOK eine der führenden Lüftungsfirmen auf dem norwegischen Markt.“"
                            },
                            {
                                "example_id": "51cbfe2c-68e2-435a-a491-9ede73090ee2",
                                "sense_id": "c28f05de-bbf4-3b57-b65b-9d17d505c006",
                                "text": "„Die Kosteneinsparungen sind nicht nur für die Bauherren und Architekten interessant, sondern auch für innovative Lüftungsfirmen, die ihr Leistungshonorar an die Beteiligung der Kosteneinsparung verknüpfen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
