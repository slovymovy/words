{
    "word_family": [
        "troublesome",
        "troublemaker",
        "troubleshooter",
        "troubled",
        "troubling"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1148f4d6-1ea3-3fb7-b297-b60a877b8abf",
                    "sense_definition": "A distressing or dangerous situation.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "difficulty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was in <w>trouble</w> when the rain started and he had no shelter.",
                            "target_lang_translations": {
                                "ru": "Он оказался в <w>беде</w>, когда пошёл дождь, а у него не было укрытия."
                            }
                        },
                        {
                            "text": "If you don't follow the rules, you will get into <w>trouble</w> with the teacher.",
                            "target_lang_translations": {
                                "ru": "Если ты не будешь соблюдать правила, у тебя будут <w>неприятности</w> с учителем."
                            }
                        }
                    ],
                    "synonyms": [
                        "difficulty",
                        "predicament",
                        "plight",
                        "fix",
                        "jam"
                    ],
                    "common_phrases": [
                        "get into trouble",
                        "be in trouble",
                        "ask for trouble"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мучительная или опасная ситуация."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беда́",
                                "target_lang_sense_clarification": "несчастье, крайне тяжёлое событие"
                            },
                            {
                                "target_lang_word": "неприя́тность",
                                "target_lang_sense_clarification": "нежелательное происшествие"
                            },
                            {
                                "target_lang_word": "пробле́мы",
                                "target_lang_sense_clarification": "ситуация, влекущая наказание или трудности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0e9d6a9c-6132-31bd-98d0-ad7d918b8cf9",
                    "sense_definition": "A difficulty, problem, or condition that causes a bad situation.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "difficulty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>trouble</w> was a leaking brake line that caused the car to stop.",
                            "target_lang_translations": {
                                "ru": "<w>Проблема</w> заключалась в протекающем тормозном шланге, из-за которого машина остановилась."
                            }
                        },
                        {
                            "text": "We had some <w>trouble</w> with the internet connection during the meeting.",
                            "target_lang_translations": {
                                "ru": "Во время встречи у нас возникли <w>неполадки</w> с интернет-соединением."
                            }
                        }
                    ],
                    "synonyms": [
                        "problem",
                        "difficulty",
                        "hitch"
                    ],
                    "antonyms": [
                        "solution"
                    ],
                    "common_phrases": [
                        "the trouble is",
                        "have trouble with"
                    ],
                    "target_lang_definitions": {
                        "ru": "Трудность, проблема или условие, вызывающее плохую ситуацию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пробле́ма",
                                "target_lang_sense_clarification": "сложный вопрос или задача"
                            },
                            {
                                "target_lang_word": "непола́дки",
                                "target_lang_sense_clarification": "технические сбои или неисправности"
                            },
                            {
                                "target_lang_word": "затрудне́ние",
                                "target_lang_sense_clarification": "препятствие, сложность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1a6763fa-d6e4-3df4-8f49-bdd0e69c8ff0",
                    "sense_definition": "Difficulty or effort required in doing something.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "difficulty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has <w>trouble</w> eating because of her sore throat.",
                            "target_lang_translations": {
                                "ru": "Ей <w>трудно</w> есть из-за больного горла."
                            }
                        },
                        {
                            "text": "I had a lot of <w>trouble</w> finding your house in the dark.",
                            "target_lang_translations": {
                                "ru": "Мне стоило больших <w>усилий</w> найти твой дом в темноте."
                            }
                        }
                    ],
                    "synonyms": [
                        "difficulty",
                        "hassle"
                    ],
                    "antonyms": [
                        "ease"
                    ],
                    "common_phrases": [
                        "have trouble doing",
                        "with great trouble"
                    ],
                    "target_lang_definitions": {
                        "ru": "Трудность или усилия, необходимые для выполнения чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тру́дность",
                                "target_lang_sense_clarification": "сложность выполнения"
                            },
                            {
                                "target_lang_word": "затрудне́ние",
                                "target_lang_sense_clarification": "препятствие в процессе"
                            },
                            {
                                "target_lang_word": "пробле́мы",
                                "target_lang_sense_clarification": "сложности с чем-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d05f5fde-0d96-3302-b4b9-43f73624fbeb",
                    "sense_definition": "Efforts taken or expended, typically beyond what is normally required.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "effort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It’s no <w>trouble</w> for me to edit the document for you.",
                            "target_lang_translations": {
                                "ru": "Мне совсем не <w>трудно</w> отредактировать этот документ для вас."
                            }
                        },
                        {
                            "text": "She never took the <w>trouble</w> to close the windows before leaving.",
                            "target_lang_translations": {
                                "ru": "Она никогда не <w>утруждала</w> себя тем, чтобы закрыть окна перед уходом."
                            }
                        }
                    ],
                    "synonyms": [
                        "bother",
                        "effort",
                        "pains"
                    ],
                    "common_phrases": [
                        "take the trouble",
                        "go to the trouble",
                        "no trouble at all"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предпринятые или затраченные усилия, обычно сверх того, что требуется в обычных условиях."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "труд",
                                "target_lang_sense_clarification": "усилие, старание"
                            },
                            {
                                "target_lang_word": "хло́поты",
                                "target_lang_sense_clarification": "обременительные работы или заботы"
                            },
                            {
                                "target_lang_word": "забо́ты",
                                "target_lang_sense_clarification": "внимание и усилия, направленные на что-то"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "24d3be10-abfc-3ffe-ab7d-7b9fc7bea13a",
                    "sense_definition": "Health problems or an ailment affecting a specific part of the body.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "health",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He’s been in the hospital with some heart <w>trouble</w> lately.",
                            "target_lang_translations": {
                                "ru": "В последнее время он лежал в больнице из-за <w>проблем</w> с сердцем."
                            }
                        },
                        {
                            "text": "My grandmother has back <w>trouble</w> and cannot walk very far.",
                            "target_lang_translations": {
                                "ru": "У моей бабушки <w>болезнь</w> спины, и она не может ходить далеко."
                            }
                        }
                    ],
                    "synonyms": [
                        "ailment",
                        "complaint",
                        "disorder",
                        "malady"
                    ],
                    "common_phrases": [
                        "heart trouble",
                        "back trouble",
                        "stomach trouble"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проблемы со здоровьем или недуг, поражающий определенную часть тела."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "боле́знь",
                                "target_lang_sense_clarification": "расстройство здоровья"
                            },
                            {
                                "target_lang_word": "пробле́мы",
                                "target_lang_sense_clarification": "нарушения в работе органа"
                            },
                            {
                                "target_lang_word": "боли",
                                "target_lang_sense_clarification": "физические страдания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "35538dbe-02e1-3c5a-a884-216a6d170270",
                    "sense_definition": "A specific weakness, failing, or shortcoming in someone or something.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "difficulty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Your <w>trouble</w> is that you quit too readily when things get hard.",
                            "target_lang_translations": {
                                "ru": "Твоя <w>беда</w> в том, что ты слишком легко сдаёшься, когда становится трудно."
                            }
                        },
                        {
                            "text": "The <w>trouble</w> with that suggestion is that we lack the funds.",
                            "target_lang_translations": {
                                "ru": "<w>Проблема</w> этого предложения в том, что нам не хватает средств."
                            }
                        }
                    ],
                    "synonyms": [
                        "shortcoming",
                        "drawback",
                        "fault",
                        "flaw"
                    ],
                    "antonyms": [
                        "strength",
                        "advantage"
                    ],
                    "common_phrases": [
                        "the trouble with"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретная слабость, недостаток или изъян в ком-либо или чем-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беда́",
                                "target_lang_sense_clarification": "главный недостаток или проблема"
                            },
                            {
                                "target_lang_word": "недоста́ток",
                                "target_lang_sense_clarification": "изъян, несовершенство"
                            },
                            {
                                "target_lang_word": "пробле́ма",
                                "target_lang_sense_clarification": "отрицательная черта"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf0a52de-c4be-33b0-b5ea-ac7a1b4ea674",
                    "sense_definition": "A violent or turbulent event; public unrest or disturbance.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "conflict",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>troubles</w> in the region led to many people leaving their homes.",
                            "target_lang_translations": {
                                "ru": "<w>Беспорядки</w> в регионе привели к тому, что многие люди покинули свои дома."
                            }
                        },
                        {
                            "text": "There was some <w>trouble</w> at the stadium after the game ended.",
                            "target_lang_translations": {
                                "ru": "После окончания игры на стадионе произошли <w>столкновения</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "unrest",
                        "disturbance",
                        "turmoil",
                        "commotion"
                    ],
                    "antonyms": [
                        "peace"
                    ],
                    "common_phrases": [
                        "civil trouble",
                        "stir up trouble"
                    ],
                    "target_lang_definitions": {
                        "ru": "Насильственное или бурное событие; общественные беспорядки или волнения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беспоря́дки",
                                "target_lang_sense_clarification": "нарушение общественного спокойствия"
                            },
                            {
                                "target_lang_word": "волне́ния",
                                "target_lang_sense_clarification": "массовые протесты или тревога"
                            },
                            {
                                "target_lang_word": "конфли́кт",
                                "target_lang_sense_clarification": "столкновение сторон"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1556e72c-a9d9-3d4e-bc43-bf7941536724",
                    "sense_definition": "A person who is likely to cause problems for themselves or others.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I knew you were <w>trouble</w> the moment you walked into the room.",
                            "target_lang_translations": {
                                "ru": "Я понял, что ты приносишь одни <w>неприятности</w>, как только ты вошёл в комнату."
                            }
                        },
                        {
                            "text": "That kid is real <w>trouble</w> and always gets into fights.",
                            "target_lang_translations": {
                                "ru": "Этот парень — ходячая <w>беда</w>, он вечно ввязывается в драки."
                            }
                        }
                    ],
                    "synonyms": [
                        "nuisance",
                        "handful"
                    ],
                    "common_phrases": [
                        "be real trouble"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used to describe a person's character"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который, скорее всего, создаст проблемы для себя или окружающих."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беда́",
                                "target_lang_sense_clarification": "человек-катастрофа"
                            },
                            {
                                "target_lang_word": "наказа́ние",
                                "target_lang_sense_clarification": "человек, приносящий одни хлопоты"
                            },
                            {
                                "target_lang_word": "пробле́мный",
                                "target_lang_sense_clarification": "человек с трудным характером"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d2611545-76f8-3f8e-a168-d1717ecccad5",
                    "sense_definition": "A state of mental unease, distress, or disquiet.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "An inner <w>trouble</w> made him feel cold and distant from his friends.",
                            "target_lang_translations": {
                                "ru": "Внутреннее <w>смятение</w> заставляло его чувствовать холод и отчужденность от друзей."
                            }
                        },
                        {
                            "text": "She spoke with a voice that betrayed her deep mental <w>trouble</w>.",
                            "target_lang_translations": {
                                "ru": "Она говорила голосом, выдававшим её глубокое душевное <w>беспокойство</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "anguish",
                        "distress",
                        "unease",
                        "disquiet"
                    ],
                    "antonyms": [
                        "serenity",
                        "calm"
                    ],
                    "common_phrases": [
                        "inner trouble"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Often used in literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние душевного беспокойства, страдания или тревоги."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смяте́ние",
                                "target_lang_sense_clarification": "сильное душевное волнение"
                            },
                            {
                                "target_lang_word": "трево́га",
                                "target_lang_sense_clarification": "состояние беспокойства"
                            },
                            {
                                "target_lang_word": "беспоко́йство",
                                "target_lang_sense_clarification": "отсутствие покоя, волнение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "71d0510b-b99b-3c2b-b510-6b9d54939824",
                    "sense_definition": "A slang term for a wife.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I'd better get home to the <w>trouble</w> before she gets angry.",
                            "target_lang_translations": {
                                "ru": "Пойду-ка я лучше домой к своей <w>благоверной</w>, пока она не разозлилась."
                            }
                        },
                        {
                            "text": "He spent the evening out with his <w>trouble</w> and strife.",
                            "target_lang_translations": {
                                "ru": "Он провёл вечер со своей <w>женой</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "wife",
                        "missus",
                        "better half"
                    ],
                    "common_phrases": [
                        "trouble and strife"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Cockney rhyming slang"
                        },
                        {
                            "trait_type": "regional",
                            "comment": "British"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сленговое обозначение жены."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "благове́рная",
                                "target_lang_sense_clarification": "ироничное обозначение жены"
                            },
                            {
                                "target_lang_word": "моя́",
                                "target_lang_sense_clarification": "разговорное обращение к жене"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "642d4867-c917-3d69-aa7d-7449a0558087",
                    "sense_definition": "To cause someone to feel anxious, worried, or mentally distressed.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "disturb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "What she said about the future is <w>troubling</w> me deeply.",
                            "target_lang_translations": {
                                "ru": "То, что она сказала о будущем, глубоко меня <w>тревожит</w>."
                            }
                        },
                        {
                            "text": "Don't <w>trouble</w> yourself about those small mistakes; they don't matter.",
                            "target_lang_translations": {
                                "ru": "Не <w>беспокойтесь</w> из-за этих мелких ошибок, они не имеют значения."
                            }
                        }
                    ],
                    "synonyms": [
                        "worry",
                        "distress",
                        "upset",
                        "bother"
                    ],
                    "antonyms": [
                        "soothe",
                        "comfort"
                    ],
                    "common_phrases": [
                        "trouble oneself",
                        "be troubled by"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставлять кого-либо чувствовать тревогу, беспокойство или душевные страдания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беспоко́ить",
                                "target_lang_sense_clarification": "внушать тревогу, волновать"
                            },
                            {
                                "target_lang_word": "трево́жить",
                                "target_lang_sense_clarification": "приводить в состояние волнения"
                            },
                            {
                                "target_lang_word": "волновать",
                                "target_lang_sense_clarification": "эмоционально затрагивать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c8e913cd-4459-379f-998a-a382bd2d068f",
                    "sense_definition": "To bother or cause inconvenience to someone.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "disturb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am sorry to <w>trouble</w> you, but could you help me with this?",
                            "target_lang_translations": {
                                "ru": "Извините, что <w>беспокою</w> вас, но не могли бы вы мне помочь с этим?"
                            }
                        },
                        {
                            "text": "I will not <w>trouble</w> you to deliver the letter if you are busy.",
                            "target_lang_translations": {
                                "ru": "Я не стану <w>утруждать</w> вас доставкой письма, если вы заняты."
                            }
                        }
                    ],
                    "synonyms": [
                        "bother",
                        "inconvenience",
                        "disturb"
                    ],
                    "common_phrases": [
                        "sorry to trouble you"
                    ],
                    "target_lang_definitions": {
                        "ru": "Беспокоить или причинять неудобства кому-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беспоко́ить",
                                "target_lang_sense_clarification": "нарушать покой, доставлять хлопоты"
                            },
                            {
                                "target_lang_word": "побеспоко́ить",
                                "target_lang_sense_clarification": "потревожить на короткое время"
                            },
                            {
                                "target_lang_word": "утружда́ть",
                                "target_lang_sense_clarification": "обременять просьбой"
                            }
                        ]
                    }
