                "senses": [
                    {
                        "sense_id": "5c1c1947-bb1e-3066-b043-afb5a76414a9",
                        "entry_id": "893e404b-8fe4-36ad-9c25-d96fdbbc0319",
                        "glosses": [
                            "Dangereux, périlleux."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "6da7ad01-c48d-41a8-9e1f-538957ec1660",
                                "sense_id": "5c1c1947-bb1e-3066-b043-afb5a76414a9",
                                "text": "Les républicains Kelly Loeffler et David Perdue ont été entraînés bien malgré eux en terrain miné, en raison des propos et du comportement du président."
                            }
                        ]
                    },
                    {
                        "sense_id": "26b2be06-c8d7-3cb8-b83c-0688fa178656",
                        "entry_id": "893e404b-8fe4-36ad-9c25-d96fdbbc0319",
                        "glosses": [
                            "Rongé par les soucis."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "76978fbf-2c5c-4538-83cd-da7b146c4942",
                                "sense_id": "26b2be06-c8d7-3cb8-b83c-0688fa178656",
                                "text": "Dans son désœuvrement elle essaya de faire de la dentelle. Ses doigts trop lourds cassaient les fils ; elle n’entendait à rien, avait perdu le sommeil, suivant son mot, était « minée »."
                            }
                        ]
                    },
                    {
                        "sense_id": "b85ab573-dfe7-3bf1-b7f2-20bf53533cf8",
                        "entry_id": "893e404b-8fe4-36ad-9c25-d96fdbbc0319",
                        "glosses": [
                            "Couvert de mines."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73c84b65-3338-429e-b6b8-aa11dba5d15e",
                                "sense_id": "b85ab573-dfe7-3bf1-b7f2-20bf53533cf8",
                                "text": "Pour avoir une idée de l'ampleur de la catastrophe, sachez qu'en une dizaine de jours, 60 cadavres d'animaux furent enterrés à Ostheim même et qu'une quarantaine d'autres étaient inaccessibles parce qu'au milieu de près inondés et minés."
                            },
                            {
                                "example_id": "9d57c41d-7ad9-47e0-a922-937e56d14afd",
                                "sense_id": "b85ab573-dfe7-3bf1-b7f2-20bf53533cf8",
                                "text": "Le Haut-Karabakh, théâtre de deux guerres entre l’Arménie et l’Azerbaïdjan, au début des années 1990 puis à l’automne 2020, est l’une des régions les plus minées d’ex-URSS."
                            }
                        ]
                    }
