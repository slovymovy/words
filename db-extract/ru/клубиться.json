                ],
                "senses": [
                    {
                        "sense_id": "c279d7c3-ab21-3b8a-a3b1-c45c7d3b060b",
                        "entry_id": "d09a72d8-a114-3dc5-a6da-5ed9b764115c",
                        "glosses": [
                            "to curl, to wreathe, to swirl"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ec0612b-3160-4ee7-ad74-2b832c94749d",
                                "sense_id": "c279d7c3-ab21-3b8a-a3b1-c45c7d3b060b",
                                "text": "Дым клуби́лся из трубы́.",
                                "translation": "The chimney was belching out smoke.",
                                "english": "The chimney was belching out smoke."
                            },
                            {
                                "example_id": "43e547e4-d228-4531-a349-85fca60749ae",
                                "sense_id": "c279d7c3-ab21-3b8a-a3b1-c45c7d3b060b",
                                "text": "Пыль клуби́тся.",
                                "translation": "The dust is swirling.",
                                "english": "The dust is swirling."
                            },
                            {
                                "example_id": "cc0cd0e1-e394-4816-ab28-9b262bdae2bb",
                                "sense_id": "c279d7c3-ab21-3b8a-a3b1-c45c7d3b060b",
                                "text": "Смерка́лось; на столе́ блиста́я\nШипе́л вече́рний самова́р.\nКита́йский ча́йник нагрева́я;\nПод ним клуби́лся лё́гкий пар.",
                                "translation": "It darkened: on the table, gleaming,\nThe evening samovar now hissed,\nOn it the Chinese teapot, warming;\nLight vapour eddied under it.",
                                "english": "It darkened: on the table, gleaming,\nThe evening samovar now hissed,\nOn it the Chinese teapot, warming;\nLight vapour eddied under it."
                            }
                        ]
                    },
