{
    "word_family": [
        "deride",
        "derision",
        "derisively",
        "derisiveness",
        "derisory"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "14aa75ad-a168-3233-8708-12e5d06dae47",
                    "sense_definition": "Expressing contempt, mockery, or ridicule.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "derisive_mocking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His suggestion was met with a <w>derisive</w> laugh from the back of the room.",
                            "target_lang_translations": {
                                "ru": "Его предложение было встречено <w>насмешливым</w> смехом из глубины комнаты."
                            }
                        },
                        {
                            "text": "She curled her lip in a <w>derisive</w> smile before turning away.",
                            "target_lang_translations": {
                                "ru": "Она скривила губы в <w>издевательской</w> улыбке, прежде чем отвернуться."
                            }
                        }
                    ],
                    "synonyms": [
                        "mocking",
                        "ridiculing",
                        "scornful",
                        "disdainful"
                    ],
                    "common_phrases": [
                        "derisive laughter",
                        "derisive smile",
                        "derisive snort"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражающий презрение, издёвку или насмешку."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "насмешливый",
                                "target_lang_sense_clarification": "выражающий насмешку"
                            },
                            {
                                "target_lang_word": "издевательский",
                                "target_lang_sense_clarification": "оскорбительно насмешливый"
                            },
                            {
                                "target_lang_word": "саркастический",
                                "target_lang_sense_clarification": "язвительный, насмешливый"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "02c0d229-ff9b-304a-95c7-ab15d9461c57",
                    "sense_definition": "Deserving or provoking ridicule; absurd or laughable.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "derisive_mocking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The plot of the low-budget movie was so <w>derisive</w> that viewers walked out.",
                            "target_lang_translations": {
                                "ru": "Сюжет этого малобюджетного фильма был настолько <w>смехотворным</w>, что зрители выходили из зала."
                            }
                        },
                        {
                            "text": "He made several <w>derisive</w> claims that were immediately disproven by the panel.",
                            "target_lang_translations": {
                                "ru": "Он сделал несколько <w>нелепых</w> заявлений, которые комиссия тут же опровергла."
                            }
                        }
                    ],
                    "synonyms": [
                        "ridiculous"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заслуживающий или вызывающий насмешки; нелепый или смехотворный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смехотворный",
                                "target_lang_sense_clarification": "вызывающий смех своей нелепостью"
                            },
                            {
                                "target_lang_word": "нелепый",
                                "target_lang_sense_clarification": "абсурдный, заслуживающий насмешки"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "088b7238-ae34-349f-85f0-656e466a6672",
                    "sense_definition": "An expression or remark that mocks or ridicules someone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crowd shouted hostile <w>derisives</w> as the disgraced politician stepped out of the building.",
                            "target_lang_translations": {
                                "ru": "Толпа выкрикивала враждебные <w>насмешки</w>, когда опозоренный политик вышел из здания."
                            }
                        },
                        {
                            "text": "He endured every bitter <w>derisive</w> hurled at him without uttering a single complaint.",
                            "target_lang_translations": {
                                "ru": "Он стойко сносил каждую горькую <w>издёвку</w>, брошенную в его адрес, не высказав ни единой жалобы."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Высказывание или насмешливое замечание, высмеивающее кого-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "насмешка",
                                "target_lang_sense_clarification": "обидная шутка или замечание"
                            },
                            {
                                "target_lang_word": "издёвка",
                                "target_lang_sense_clarification": "язвительное оскорбительное замечание"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}