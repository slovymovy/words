                "senses": [
                    {
                        "sense_id": "ab76a51b-7a54-3e6a-a4b1-1c3e18ad6bc9",
                        "entry_id": "b43ca70c-638e-393f-9441-fce28338e02f",
                        "glosses": [
                            "de tak van wetenschap die zich bezighoudt met het vinden, beschrijven, indelen en benoemen van levende wezens. Al dan niet hetzelfde als systematiek"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6a025ec-c347-4fb8-b2ee-ac13b8471121",
                                "sense_id": "ab76a51b-7a54-3e6a-a4b1-1c3e18ad6bc9",
                                "text": "Door het politieke klimaat is taxonomie een uitstervende wetenschap."
                            }
                        ]
                    },
                    {
                        "sense_id": "64c53e4b-da3f-33ad-ad2d-0b7d377cc571",
                        "entry_id": "b43ca70c-638e-393f-9441-fce28338e02f",
                        "glosses": [
                            "een indeling van een bepaalde groep van levende wezens, gemaakt door een taxonoom"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33df1504-17d7-46f3-b235-06b4cf1d9b9c",
                                "sense_id": "64c53e4b-da3f-33ad-ad2d-0b7d377cc571",
                                "text": "Ik zie dat je de allernieuwste taxonomie voor deze orde gebruikt!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "abadff2f-fc40-4eee-ad3c-39a7eea0a320",
