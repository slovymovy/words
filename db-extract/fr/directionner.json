                "senses": [
                    {
                        "sense_id": "49ca879a-8da9-357f-8591-60930b7f424a",
                        "entry_id": "bf904dd3-3bf0-3253-a3d0-303840a46af9",
                        "glosses": [
                            "Diriger dans une certaine direction."
                        ],
                        "tags": [
                            "Extrêmement rare"
                        ],
                        "examples": [
                            {
                                "example_id": "5b7e1501-4b18-430f-aa2d-fe5ebe7354d8",
                                "sense_id": "49ca879a-8da9-357f-8591-60930b7f424a",
                                "text": "Les bandes directionnelles phosphorescentes, qui ne phosphorescent, ne directionnent jamais tant que par forte humidité, phosphorescent à perte de vue, directionnent jusqu'à l'autoroute."
                            },
                            {
                                "example_id": "7be8e2e1-eb02-4af2-a783-c5e9cf192f21",
                                "sense_id": "49ca879a-8da9-357f-8591-60930b7f424a",
                                "text": "Rotative pour directionner la lumière."
                            },
                            {
                                "example_id": "9a51c8f0-340e-4716-b212-38289dc6f9b9",
                                "sense_id": "49ca879a-8da9-357f-8591-60930b7f424a",
                                "text": "Directionner le flux énergétique à l'aide du mental."
                            }
                        ]
                    }
