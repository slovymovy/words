                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fb1b346-25b7-4335-88be-19136be7abd7",
                                                "sense_id": "cbdc0b95-260c-3409-b8b8-b3ef4867075c",
                                                "text": "Yves Tumor heeft vele gedaantes. De zanger live zien betekent een regendouche van sonisch geweld en risico op klappen als je vooraan staat."
                                            }
                                        ]
                                    }
                                ]
