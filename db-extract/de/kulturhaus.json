                        "examples": [
                            {
                                "example_id": "50df163a-062e-474e-9bff-7b3de5162206",
                                "sense_id": "8c8255b3-db55-39e1-a9a6-add1e4f720cd",
                                "text": "„Denn als das Wirtschaftswunder zu brummen begann, verpflichtete man mit dem Finnen Alvar Aalto einen Architekten von Weltruf, um zwei Kirchen und ein Kulturhaus zu bauen.“"
                            },
                            {
                                "example_id": "3cefcb5c-7102-4b73-be8c-3523503b9860",
                                "sense_id": "8c8255b3-db55-39e1-a9a6-add1e4f720cd",
                                "text": "„Wer Angela Merkel an diesem Tag im Kulturhaus beobachtet, der bekommt einen Begriff davon, wie groß Politik manchmal sein kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
