                                        "sense_id": "9b9af990-2de8-3078-b714-d2c8d4d0fc0f",
                                        "entry_id": "09c940c9-12c9-3062-9fe6-8658550c7ce8",
                                        "glosses": [
                                            "To swing back and forth, especially if with a regular rhythm."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a70433a4-0700-4ee5-a72e-5fa043e5f6bb",
                                                "sense_id": "9b9af990-2de8-3078-b714-d2c8d4d0fc0f",
                                                "text": "A pendulum oscillates slower as it gets longer."
                                            },
                                            {
                                                "example_id": "071042bc-3710-4527-8dc7-23400e22eff3",
                                                "sense_id": "9b9af990-2de8-3078-b714-d2c8d4d0fc0f",
                                                "text": "By placing the 0.02μF capacitor on top of the whistle chip, the circuit oscillates at a lower frequency."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90ea26d3-4f44-398e-9709-c788cb2481bd",
                                        "entry_id": "09c940c9-12c9-3062-9fe6-8658550c7ce8",
                                        "glosses": [
                                            "To vacillate between conflicting opinions, etc."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a7fb935-dbfc-4db2-9204-c63d70e4fc0c",
                                                "sense_id": "90ea26d3-4f44-398e-9709-c788cb2481bd",
                                                "text": "The mood for change oscillated from day to day."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd387836-2792-3cdd-8bce-e9305acc364c",
