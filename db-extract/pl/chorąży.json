                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "58e81534-a74c-3dfe-bb5e-0c2e8823b9ef",
                                        "entry_id": "1a13befa-aa79-31d9-9968-b709d4771271",
                                        "glosses": [
                                            "To distinguish by an ornament, especially by a crown."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dce63c4e-133d-4449-ba04-12d3f25970c8",
                                                "sense_id": "58e81534-a74c-3dfe-bb5e-0c2e8823b9ef",
                                                "text": "Any charge which has a crown immediately above or upon it, is said to be ensigned."
                                            }
                                        ]
