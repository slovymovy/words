                ],
                "senses": [
                    {
                        "sense_id": "2593bece-30d9-37bb-8f8f-f03940ce7705",
                        "entry_id": "7ad96c35-4db8-3d12-810b-c0524d550a42",
                        "glosses": [
                            "dotyczący wizy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e27d423-e7a2-4849-974e-98a16a0d028f",
                                "sense_id": "2593bece-30d9-37bb-8f8f-f03940ce7705",
                                "text": "Loteria wizowa […] odbywa się corocznie od sześciu lat"
                            },
                            {
                                "example_id": "78ba8f1b-7d4e-4c8f-9e98-ed3cc662c574",
                                "sense_id": "2593bece-30d9-37bb-8f8f-f03940ce7705",
                                "text": "Do końca czerwca ustawa wizowa ma trafić pod obrady wspólnej komisji Senatu i Izby Reprezentantów"
                            },
                            {
                                "example_id": "2379f817-0dea-4ab1-a5c5-435c85b9f344",
                                "sense_id": "2593bece-30d9-37bb-8f8f-f03940ce7705",
                                "text": "A potem złożyli się na bilet i załatwili formalności wizowe, żeby tylko mogła być na placu Świętego Piotra w dniu inauguracji nowego pontyfikatu"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cbf28563-d9eb-4d6f-8db2-7e9f2af995f5",
                        "source_entry_id": "7ad96c35-4db8-3d12-810b-c0524d550a42",
                        "source_sense_id": "2593bece-30d9-37bb-8f8f-f03940ce7705",
                        "target_lang_word": "visa",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "visa",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "67d9a22e-b024-3ce6-97e1-31b3f46fe69d",
                                        "entry_id": "a689da8d-7080-365e-8ded-0c38cf4c742b",
                                        "glosses": [
                                            "A permit to enter and leave a country, normally issued by the authorities of the country to be visited."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7092d55e-a6b5-42c7-a804-c8c8d9e1b2b6",
                                                "sense_id": "67d9a22e-b024-3ce6-97e1-31b3f46fe69d",
                                                "text": "I came on a six-month tourist visa."
                                            },
                                            {
                                                "example_id": "7bebfab1-7b2c-4e6a-b7b1-711a1e50e025",
                                                "sense_id": "67d9a22e-b024-3ce6-97e1-31b3f46fe69d",
                                                "text": "Several Sun MySQLers have been denied short stay business visas to Australia - yes, Australia - as they attempted to attend a Linux conference in Hobart, Tasmania. According to a blog post from Kaj Arno, vice president in charge of \"database community\" at Sun Microsystems, several employees - many of whom worked with MySQL - have been barred from entering Oz."
                                            },
                                            {
                                                "example_id": "314f4bdc-1944-448d-8f0f-c1d534f54691",
                                                "sense_id": "67d9a22e-b024-3ce6-97e1-31b3f46fe69d",
                                                "text": "However, I couldn't continue by land to Georgia, as I would have liked: Russia still maintains its crazy, Sovietesque visa regulations, which makes getting a transit visa extremely difficult and extremely expensive."
                                            },
                                            {
                                                "example_id": "6894fda0-8c7d-4352-afda-e10a990ec220",
                                                "sense_id": "67d9a22e-b024-3ce6-97e1-31b3f46fe69d",
                                                "text": "The impact would be smaller in the immediate term given that the Trump proclamation allows existing visa holders to remain in the US, but still, at MSK around 100 new scientific and medical trainees this year would not be allowed to commence their research."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "visa",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "873815ee-12c9-30d2-a811-04c1ed6b068c",
                                        "entry_id": "4a412175-f51e-3aff-a1ae-7f639d5b6db5",
                                        "glosses": [
                                            "To endorse (a passport, etc.)."
                                        ],
                                        "tags": [
                                            "dated",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28a1ef8d-46cb-4d61-8165-044f98b314a7",
                                                "sense_id": "873815ee-12c9-30d2-a811-04c1ed6b068c",
                                                "text": "\"Let me tell you that I am going to spit into that coffee! Yes, and if you do not get me my passport visaed this very minute, I shall take it to Monsignor myself.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
