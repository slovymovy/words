                "senses": [
                    {
                        "sense_id": "dae4bb2a-e3dd-3025-9e2d-8d251346bdfb",
                        "entry_id": "09c2227e-9fc3-39bf-bc48-15cad6ab7c73",
                        "glosses": [
                            "Gesamtheit der Mitglieder einer Familie, die dem Adel angehören"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62ed22c5-7541-4714-8f4c-5131eec57658",
                                "sense_id": "dae4bb2a-e3dd-3025-9e2d-8d251346bdfb",
                                "text": "„Untereinander unterhielten die Adelshäuser mithilfe gegenseitiger Geschenke und Tributzahlungen enge Verbindungen und häuften so ganz nebenbei gewaltige Reichtümer an.“"
                            },
                            {
                                "example_id": "de4888ed-681d-4c14-8299-e1073bdf43d2",
                                "sense_id": "dae4bb2a-e3dd-3025-9e2d-8d251346bdfb",
                                "text": "„Schimmelmann, für den auch die Altonaer Reederei Hinrich van der Smissen & Söhne fuhr, belieferte Adelshäuser sogar mit sogenannten Kammermohren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
