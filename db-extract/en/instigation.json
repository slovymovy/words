                        "form": "instigations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9d9c4350-fe8a-3a8c-99dc-0ea7f2687522",
                        "entry_id": "9c89233a-6fef-3bba-8194-2524cc581c63",
                        "glosses": [
                            "The act of instigating, or the state of being instigated; incitement; especially to evil or wickedness."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "61437a81-fb3e-4718-936b-71f132a266ea",
                                "sense_id": "9d9c4350-fe8a-3a8c-99dc-0ea7f2687522",
                                "text": "The departure was not unduly prolonged.[…]Within the door Mrs. Spoker hastily imparted to Mrs. Love a few final sentiments on the subject of Divine Intention in the disposition of buckets; farewells and last commiserations; a deep, guttural instigation to the horse; and the wheels of the waggonette crunched heavily away into obscurity."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c6c7bea9-0bdd-4f99-8498-011d63871854",
                        "source_entry_id": "9c89233a-6fef-3bba-8194-2524cc581c63",
                        "source_sense_id": "9d9c4350-fe8a-3a8c-99dc-0ea7f2687522",
                        "source_sense_description": "act of instigating",
                        "target_lang_word": "aansporing",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aansporing",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "37d128b4-c309-3b48-a8e6-cf190159a56a",
                                        "entry_id": "7d377a47-6303-366a-8a29-d3210ffb6015",
                                        "glosses": [
                                            "aanmoediging tot actie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76958318-222d-43c4-a9dd-4f56f7bcc3a3",
                                                "sense_id": "37d128b4-c309-3b48-a8e6-cf190159a56a",
                                                "text": "Na een kleine aansporing wilde de meester toch wel beginnen met de uitleg."
                                            },
                                            {
                                                "example_id": "68d0c0e1-8d01-435b-8cf1-ff54c5338fbb",
                                                "sense_id": "37d128b4-c309-3b48-a8e6-cf190159a56a",
                                                "text": "Tv-zender CNN vatte Obama’s woorden op als een aansporing voor jongeren om te blijven protesteren tegen het politiegeweld."
                                            },
                                            {
                                                "example_id": "312a69f1-3ef2-48b4-b2e4-76f34f79760c",
                                                "sense_id": "37d128b4-c309-3b48-a8e6-cf190159a56a",
                                                "text": "Om ons minder eenzaam te voelen hebben de meesten van ons niets aan aansporingen om uit te gaan of de zoveelste aanmoediging om de volmaakte geliefde te zoeken."
                                            },
                                            {
                                                "example_id": "744423af-f767-40f6-a932-58364cf6db4f",
                                                "sense_id": "37d128b4-c309-3b48-a8e6-cf190159a56a",
                                                "text": "Gemor, gelach, aansporingen, misschien zelfs protest."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0ae49523-643b-4a60-b3d3-a49017922852",
                        "source_entry_id": "9c89233a-6fef-3bba-8194-2524cc581c63",
                        "source_sense_id": "9d9c4350-fe8a-3a8c-99dc-0ea7f2687522",
