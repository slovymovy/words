                "senses": [
                    {
                        "sense_id": "e86b2766-5277-3e95-aaec-5776018d0419",
                        "entry_id": "60b5c544-5c1a-385b-9162-997fec8d550b",
                        "glosses": [
                            "старин. и нар.-поэт. взять (брать) в плен, покорить (покорять) при завоевании"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3901da24-1762-47b4-962d-403808d90fae",
                                "sense_id": "e86b2766-5277-3e95-aaec-5776018d0419",
                                "text": "Гвардия пришла на театр войны, когда Наполеон уже полонил Австрийскую армию, под Ульмом, занял Вену и вступил в Моравию."
                            },
                            {
                                "example_id": "1995b6a0-5d4d-4442-8a33-9406bf817190",
                                "sense_id": "e86b2766-5277-3e95-aaec-5776018d0419",
                                "text": "Что взял он царство Казанское, Симеона царя в полон полонил, С царицею, со Еленою〈…〉"
                            },
                            {
                                "example_id": "bc1d2384-b7b7-44fc-9854-ddc2024742a2",
                                "sense_id": "e86b2766-5277-3e95-aaec-5776018d0419",
                                "text": "Взглянет он тебе в очи и полонит твою душу, и ничуть тебе это не стыдно, а еще и гордо для тебя."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8ae1a08a-3387-4e55-8dec-4b365c165729",
                        "source_entry_id": "60b5c544-5c1a-385b-9162-997fec8d550b",
                        "source_sense_id": "e86b2766-5277-3e95-aaec-5776018d0419",
                        "target_lang_word": "capturer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "capturer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "72114861-2114-30c2-9fac-dada8c752d8d",
                                        "entry_id": "ed941ddc-85c9-3c78-9807-9dddf8c4ce4f",
                                        "glosses": [
                                            "S’emparer d’un être vivant ou d’une chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ddb9eb6-994d-4104-8b6a-ab32dbb30702",
                                                "sense_id": "72114861-2114-30c2-9fac-dada8c752d8d",
                                                "text": "À Mogador, nouvelle relâche, mais la barque envoyée à terre pour rapporter de l’eau fraîche faillit être capturée par les Arabes."
                                            },
                                            {
                                                "example_id": "e97dbe58-c069-40cc-9109-9ae17a7145f3",
                                                "sense_id": "72114861-2114-30c2-9fac-dada8c752d8d",
                                                "text": "Guerre vaine, où l’on ne capturera pas des chevau-légers bleus, des hussards blancs, mais dans la même veste grise, des garçons de café, des peintres de Dresde qui découpent déjà en cubes la sentinelle berrichonne qui les conduit à l’arrière."
                                            },
                                            {
                                                "example_id": "6ea156f2-c15d-46b5-b540-2b6d3105e2f3",
                                                "sense_id": "72114861-2114-30c2-9fac-dada8c752d8d",
                                                "text": "— Simulait-elle l’espièglerie, la naïveté pour mieux le captiver, le capturer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71c1d28e-a22b-3632-bcd9-2e68944cc2f9",
                                        "entry_id": "ed941ddc-85c9-3c78-9807-9dddf8c4ce4f",
                                        "glosses": [
                                            "Photographier ou filmer."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0ccae32-e027-4290-bd09-8872d4b435b1",
                                                "sense_id": "71c1d28e-a22b-3632-bcd9-2e68944cc2f9",
                                                "text": "Elle avait capturé des images à couper le souffle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
