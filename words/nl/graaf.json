            "senses": [
                {
                    "sense_id": "0aa68e7d-3152-368f-8acc-738f95626f73",
                    "sense_definition": "De eerste persoon enkelvoud tegenwoordige tijd van het werkwoord <w>graven</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>graaf</w> elke zaterdag een diepe kuil in de zandbak met mijn zoon.",
                            "target_lang_translations": {
