                        "glosses": [
                            "Donner un caractère anticyclonique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ccecc4e-fcdc-424f-a9bb-83c9d8025b37",
                                "sense_id": "6e3282e7-f137-3cf7-b15a-be9ab66edec9",
                                "text": "(…) et va tasser la masse d'air humide actuelle très très près du niveau du sol, sans garantie de pouvoir la résorber, \"l'anticycloniser\" dirais-je, totalement."
                            },
                            {
                                "example_id": "23810717-3fc5-40e0-ba92-5da455f6db85",
                                "sense_id": "6e3282e7-f137-3cf7-b15a-be9ab66edec9",
                                "text": "Et seconde remarque, j'ai l'impression que le Vortex se déconcentre de plus en plus, et à tendance à \"s'anticycloniser\" sur le Groenland qui se dernier fournit une bonne \"accroche\" ..."
                            }
                        ]
                    }
