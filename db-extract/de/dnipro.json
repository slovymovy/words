                "senses": [
                    {
                        "sense_id": "e7a586ae-56fc-3c85-bee2-95af8df23ed1",
                        "entry_id": "b007e423-dfc3-3c95-a3ef-e1404a62e98b",
                        "glosses": [
                            "viertgrößte Stadt der Ukraine sowie Hauptort und Verwaltungssitz der Oblast Dnipropetrowsk (Oblast Sitscheslaw)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a0118ff-3258-4f27-b2ba-59a06ee07dd3",
                                "sense_id": "e7a586ae-56fc-3c85-bee2-95af8df23ed1",
                                "text": "Er lebte seit zehn Jahren in Dnipro."
                            },
                            {
                                "example_id": "80ddecba-3753-492c-8bc8-e729faef65c4",
                                "sense_id": "e7a586ae-56fc-3c85-bee2-95af8df23ed1",
                                "text": "„In Dnipro, das von 1926 bis 2016 Dnjepropetrowsk hieß, leben Schätzungen zufolge 40.000 bis 80.000 Juden. Die hiesige Gemeinde ist die größte in der Ukraine und eine Einheitsgemeinde.“"
                            },
                            {
                                "example_id": "6cfcab5f-35d3-468b-a8be-00efa726cac6",
                                "sense_id": "e7a586ae-56fc-3c85-bee2-95af8df23ed1",
                                "text": "„Habeck ist auf Einladung von Selenskyj in der Ukraine unterwegs. Nach dem Treffen mit Selenskyj reiste er am Montag nach Dnipro weiter.“"
                            },
                            {
                                "example_id": "0dca2240-a6fd-4f52-8018-3e6fb5dad43c",
                                "sense_id": "e7a586ae-56fc-3c85-bee2-95af8df23ed1",
                                "text": "„Ein russischer Luftangriff hat in der Stadt Dnipro eine Schuhfabrik zerstört.“"
                            },
                            {
                                "example_id": "33167b12-04b0-426b-8dec-9b112be497c9",
                                "sense_id": "e7a586ae-56fc-3c85-bee2-95af8df23ed1",
                                "text": "„Dnipro ist die viertgrößte Stadt des Landes und liegt rund 400 Kilometer südöstlich der Hauptstadt Kiew.“"
                            },
                            {
                                "example_id": "da6390a7-387d-4f18-9905-a80f7dc08854",
                                "sense_id": "e7a586ae-56fc-3c85-bee2-95af8df23ed1",
                                "text": "„Nach dem verheerenden russischen Raketenangriff auf ein Wohnhaus in der ukrainischen Großstadt Dnipro ist die Zahl der Toten auf 40 gestiegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
