                ],
                "senses": [
                    {
                        "sense_id": "96f0cc13-0194-3d63-b4d4-4df833b52877",
                        "entry_id": "eba891c6-1e49-3360-8c51-3e09ebecca1b",
                        "glosses": [
                            "Vorgang, der den Geruch von etwas abschätzt, festlegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53456b1b-d74c-4dc0-8b14-3a705b0ccf7e",
                                "sense_id": "96f0cc13-0194-3d63-b4d4-4df833b52877",
                                "text": "„Das Ziel einer harmonisierten Geruchsbewertung der Innenraumluft ist prinzipiell zu begrüßen und wird derzeit auch von anderen Gremien aktiv bearbeitet.“"
                            },
                            {
                                "example_id": "d14c8f07-6378-4020-85bf-5261d011f37a",
                                "sense_id": "96f0cc13-0194-3d63-b4d4-4df833b52877",
                                "text": "„Neben der subjektiven Geruchsbewertung werden Meßmethoden zu objektiven Messung benötigt.“"
                            },
                            {
                                "example_id": "d3af4bbd-d4da-47ad-8270-fd12737e58db",
                                "sense_id": "96f0cc13-0194-3d63-b4d4-4df833b52877",
                                "text": "„Daraufhin wurden für die einzelnen Sensoren optimierte Temperaturzyklen entwickelt, um möglichst hohe Empfindlichkeiten für die Geruchsbewertung zu erhalten.“"
                            },
                            {
                                "example_id": "8db5968f-49d4-4e5e-a1d8-2e5eda334e7f",
                                "sense_id": "96f0cc13-0194-3d63-b4d4-4df833b52877",
                                "text": "„Die mit dem bis dato vorliegenden Datenumfang erreichbare Genauigkeit dieser Korrelation ist jedoch noch nicht ausreichend hoch, um derzeit bei der Geruchsbewertung auf das \"sensorische Panel\" vollständig verzichten zu können.“"
                            },
                            {
                                "example_id": "2c2c798b-22b4-4beb-a297-946dbcc99b48",
                                "sense_id": "96f0cc13-0194-3d63-b4d4-4df833b52877",
                                "text": "„Nach der Gaschromatographischen Trennung lässt sich die Probe teilen, so dass nicht nur eine Identifizierung im Massenspektrometer möglich ist, sondern auch eine Geruchsbewertung an einem so genannten Sniffing-Port.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
