                        "glosses": [
                            "taki, który następuje przed południem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "abddd9e4-4bac-4e05-a31c-16b00b89a450",
                                "sense_id": "f91de217-63cb-367e-bb31-3bd3e367e822",
                                "text": "Również w godzinach przedpołudniowych sarny wychodzą na żerowiska"
                            }
                        ],
