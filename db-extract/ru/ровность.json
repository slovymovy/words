                    }
                ],
                "translations": [
                    {
                        "translation_id": "c46de7d4-b4cb-4a85-a1e0-cbe258301b51",
                        "source_entry_id": "8baa6488-b219-3f1d-9d35-aae8a644f42f",
                        "source_sense_id": "60a43ad7-9e52-3b9e-aa85-3afaebee116a",
                        "target_lang_word": "égalité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "égalité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "65e0889e-5e89-31f1-b02a-dca35617045f",
                                        "entry_id": "5d56e9dc-da79-3295-807e-9f2c2f198b4d",
                                        "glosses": [
                                            "Qualité de ce qui est égal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57ea6d24-38fc-4113-868a-792944e4d475",
                                                "sense_id": "65e0889e-5e89-31f1-b02a-dca35617045f",
                                                "text": "[…] ; enfin si originairement ils ont été placés alternativement entre eux, et séparés par des distances égales, en équilibre et sans se toucher par l'effet de leurs forces opposées , on peut déterminer le mode des premières réunions , lorsque le mouvement interne et général a commencé, parce que l’égalité des distances a été rompue."
                                            },
                                            {
                                                "example_id": "3ebe6036-f2a5-4222-a650-f39161d8cb37",
                                                "sense_id": "65e0889e-5e89-31f1-b02a-dca35617045f",
                                                "text": "En quelque sorte, l’égalité des revenus potentiels est excessive car, au lieu de niveler les inégalités de temps libre, elle ne fait que les renverser, au détriment des plus talentueux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff6bb4e1-e0cf-361a-acad-af98aedc80ca",
                                        "entry_id": "5d56e9dc-da79-3295-807e-9f2c2f198b4d",
                                        "glosses": [
                                            "Uniformité ; constance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6456e471-5d01-49fc-a923-7f86cb1b6e00",
                                                "sense_id": "ff6bb4e1-e0cf-361a-acad-af98aedc80ca",
                                                "text": "M. Euler nous rendit pour lors cette théorie plus indécise & plus compliquée, & en même temps les observations extraordinairement pénibles: nous ne pouvions compter assez ni sur l’égalité du mouvement des horloges à pendule, ni sur les erreurs du plan des quarts-de-cercles muraux : […]."
                                            },
                                            {
                                                "example_id": "2a2e7d4b-7525-42e8-b5d3-5e9be13e25ae",
                                                "sense_id": "ff6bb4e1-e0cf-361a-acad-af98aedc80ca",
                                                "text": "L’égalité d'humeur est une vertu que tout le monde aime et que peu de personnes possèdent; elle exige non seulement une ame pure, mais encore une force d'esprit qui résiste aux contrariétés légères qu'excitent chaque jour une multitude d'objets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "684c0ae5-9966-3666-96d4-c36af733cdb7",
                                        "entry_id": "5d56e9dc-da79-3295-807e-9f2c2f198b4d",
                                        "glosses": [
                                            "Caractéristique d’une surface plane et unie, sans aspérités."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "559d4450-aeff-46b5-8aae-9688c0d88df6",
                                                "sense_id": "684c0ae5-9966-3666-96d4-c36af733cdb7",
                                                "text": "Le 16 mai, nous sortîmes d’Héraclée, suivant au sud-est une voie ancienne, qu’indiquaient ses pavés épars et l’égalité du terrain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0dc3d7c-d0e9-3c90-8fce-4b4dd7557f70",
                                        "entry_id": "5d56e9dc-da79-3295-807e-9f2c2f198b4d",
                                        "glosses": [
                                            "Fait d’être à quarante contre quarante pour deux joueurs ou deux équipes dans un jeu."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c084df00-92d5-3239-a767-30fb89d2fbae",
                                        "entry_id": "5d56e9dc-da79-3295-807e-9f2c2f198b4d",
                                        "glosses": [
                                            "Rapport entre des grandeurs en vertu duquel elles peuvent être substituées l’une à l’autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4de39849-73ea-44ca-89cc-291b81e84f2b",
                                                "sense_id": "c084df00-92d5-3239-a767-30fb89d2fbae",
                                                "text": "Q étant un polynôme de forme fractionnaire, mais dont tous les dénominateurs sont facteurs de δᵐ⁻¹. Cela posé, multiplions les deux membres de l’égalité (1) par δᵐ; il vient X. δᵐ = (δ^(x-α)).Q. δᵐ⁻¹ ; et il est évident que Q. δᵐ⁻¹ peut être considéré comme un polynôme rationnel et entier, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b99022e-d401-3ae6-8bc5-0e920545cd78",
                                        "entry_id": "5d56e9dc-da79-3295-807e-9f2c2f198b4d",
                                        "glosses": [
                                            "Principe selon lequel les individus, au sein d’une communauté politique, doivent être traités de la même façon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "789d6af6-c702-44b8-905c-03ea0faf4091",
                                                "sense_id": "9b99022e-d401-3ae6-8bc5-0e920545cd78",
                                                "text": "Toute personne a droit à accéder, dans des conditions d’égalité, aux fonctions publiques de son pays."
                                            },
                                            {
                                                "example_id": "f3d07f62-1372-4c45-b469-b7fe26ab6ced",
                                                "sense_id": "9b99022e-d401-3ae6-8bc5-0e920545cd78",
                                                "text": "— Monsieur Choulette, pourquoi nous condamnez-vous aux tristesses sauvages de l’égalité ? Pourquoi ? La flûte de Daphnis ne chanterait pas bien, si elle était faite de sept roseaux égaux. Vous voulez détruire les belles harmonies du maître et des serviteurs, de l’aristocrate et des artisans. Oh ! vous êtes un barbare, monsieur Choulette."
                                            },
                                            {
                                                "example_id": "fc9e2f96-2121-4426-9972-34c548484ed9",
                                                "sense_id": "9b99022e-d401-3ae6-8bc5-0e920545cd78",
                                                "text": "Tant que la morne et rigoureuse égalité n’aura pas imposé la même pitance et la même saloperie aux génies comme aux crétins, vous serez toujours en deçà ou en delà de la barricade…"
                                            },
                                            {
                                                "example_id": "fc0ea55c-d3ab-410b-824e-bb7eca76e6c4",
                                                "sense_id": "9b99022e-d401-3ae6-8bc5-0e920545cd78",
                                                "text": "Le but du socialisme, c’est la recherche du progrès et la concrétisation de l’aspiration égalitaire dont les composantes - égalité juridique, égalité politique et égalité sociale - sont indissociables et inopposables."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cffe6e4e-a05a-49b4-a0b7-9c6ad55ddef9",
                        "source_entry_id": "8baa6488-b219-3f1d-9d35-aae8a644f42f",
                        "source_sense_id": "60a43ad7-9e52-3b9e-aa85-3afaebee116a",
                        "target_lang_word": "régularité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "régularité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1b1841fb-9a24-366c-aab7-22ffa3a7a8d9",
                                        "entry_id": "6469ae88-451f-3f57-80e7-c6ee171f8696",
                                        "glosses": [
                                            "Conformité à un ordre, à des règles, soit naturelles, soit de convention ; constance ; uniformité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "feb3e95a-0b9d-4626-a88b-3c360f87ce60",
                                                "sense_id": "1b1841fb-9a24-366c-aab7-22ffa3a7a8d9",
                                                "text": "La nourriture incrassante qu’elles recevaient de la main de leur maître, en les faisant passer peu à peu à l’état de poulardes, nuisait à la régularité de leur pondaison."
                                            },
                                            {
                                                "example_id": "09bc0616-f87a-4b54-aaad-f7a3d76b98aa",
                                                "sense_id": "1b1841fb-9a24-366c-aab7-22ffa3a7a8d9",
                                                "text": "Comme tous les édifices de cette époque, le château des comtes de Montgommery ne présentait aucune régularité. Les pères l’avaient légué à leurs fils, et chaque propriétaire avait, selon son caprice ou son besoin, ajouté quelque chose au géant de pierre."
                                            },
                                            {
                                                "example_id": "d650c4dc-17bb-4a13-9e1c-bd83119c6a70",
                                                "sense_id": "1b1841fb-9a24-366c-aab7-22ffa3a7a8d9",
                                                "text": "La régularité de ses mœurs, de sa conduite lui a mérité l’estime publique."
                                            },
                                            {
                                                "example_id": "4869a8cc-47ee-4fda-bb95-05a6c9b097b7",
                                                "sense_id": "1b1841fb-9a24-366c-aab7-22ffa3a7a8d9",
                                                "text": "Sa régularité dans son travail est parfaite, est exemplaire."
                                            },
                                            {
                                                "example_id": "ff5d0a44-20f1-432c-b951-8e1d7db21b8d",
                                                "sense_id": "1b1841fb-9a24-366c-aab7-22ffa3a7a8d9",
                                                "text": "Cet ouvrage de tapisserie, de broderie est d’une grande régularité, d’une régularité parfaite."
                                            },
                                            {
                                                "example_id": "40125173-5f38-4712-944d-8c736c0638fc",
                                                "sense_id": "1b1841fb-9a24-366c-aab7-22ffa3a7a8d9",
                                                "text": "La régularité des traits d’un visage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "304aaa57-99fb-3801-8e9e-08771fd79cdb",
                                        "entry_id": "6469ae88-451f-3f57-80e7-c6ee171f8696",
                                        "glosses": [
                                            "Égalité de tous les côtés et de tous les angles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f80bd4a-b4c5-44ff-9717-5bb580026069",
                                                "sense_id": "304aaa57-99fb-3801-8e9e-08771fd79cdb",
                                                "text": "Régularité dans une figure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e32c08e1-5962-302d-9368-c1ba103c5495",
                                        "entry_id": "6469ae88-451f-3f57-80e7-c6ee171f8696",
                                        "glosses": [
                                            "Exacte observation des règles de chaque ordre, en parlant des ordres religieux,."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7acf6ed2-5e09-49dd-bdcf-7b3f04a6b7fc",
                                                "sense_id": "e32c08e1-5962-302d-9368-c1ba103c5495",
                                                "text": "Les religieux de cette maison vivent dans une grande régularité."
                                            },
                                            {
                                                "example_id": "77ae6389-85d0-4533-a967-198d4ff2ec4b",
                                                "sense_id": "e32c08e1-5962-302d-9368-c1ba103c5495",
                                                "text": "Ils observent la régularité de leur ordre."
                                            },
                                            {
                                                "example_id": "08227e48-407c-49f2-ab29-3dbfeab2144c",
                                                "sense_id": "e32c08e1-5962-302d-9368-c1ba103c5495",
                                                "text": "On a rétabli la régularité dans ce monastère."
                                            },
                                            {
                                                "example_id": "65798e46-a98f-460f-b5ef-eb5f9cde0ba4",
                                                "sense_id": "e32c08e1-5962-302d-9368-c1ba103c5495",
                                                "text": "Le rétablissement de la régularité dans la plupart des monastères de notre ordre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "79d35fa6-3ac8-4fec-a5b2-c6a8902739ee",
                        "source_entry_id": "8baa6488-b219-3f1d-9d35-aae8a644f42f",
                        "source_sense_id": "60a43ad7-9e52-3b9e-aa85-3afaebee116a",
                        "target_lang_word": "uniformité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "uniformité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "80eb52b3-fb41-344d-be57-76b9f6ed0f70",
                                        "entry_id": "f3e953f7-ec5a-3670-bead-5cdd532e1c57",
                                        "glosses": [
                                            "Caractère de ce qui est uniforme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb1872da-b020-4a7e-888d-69fdbc4ee529",
                                                "sense_id": "80eb52b3-fb41-344d-be57-76b9f6ed0f70",
                                                "text": "Ernestine passa trois années chez son maître, sans que rien troublât la paisible uniformité de sa vie."
                                            },
                                            {
                                                "example_id": "51eb038c-00b4-4e3b-b81e-22b984b7d2e4",
                                                "sense_id": "80eb52b3-fb41-344d-be57-76b9f6ed0f70",
                                                "text": "C’est un spectacle douloureux pour le poëte, l’artiste et le philosophe, de voir les formes et les couleurs disparaître du monde, les lignes se troubler, les teintes se confondre et l’uniformité la plus désespérante envahir l’univers sous je ne sais quel prétexte de progrès. Quand tout sera pareil, les voyages deviendront complètement inutiles, et c’est précisément alors, heureuse coïncidence, que les chemins de fer seront en pleine activité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d48a0eb-af60-31d2-bc45-7f14bc85630b",
                                        "entry_id": "f3e953f7-ec5a-3670-bead-5cdd532e1c57",
                                        "glosses": [
                                            "Ressemblance des parties d’une chose ou de plusieurs choses entre elles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5069e2dd-ee10-40d9-bdc3-d72b82d9ece5",
                                                "sense_id": "1d48a0eb-af60-31d2-bc45-7f14bc85630b",
                                                "text": "L’uniformité d’un jardin."
                                            },
                                            {
                                                "example_id": "ce99fd66-84be-4c79-a5f2-90d52bd0c4c5",
                                                "sense_id": "1d48a0eb-af60-31d2-bc45-7f14bc85630b",
                                                "text": "Uniformité de doctrine, de langage, de style."
                                            },
                                            {
                                                "example_id": "f6e58cea-8ea5-4049-a3e7-a54653e690ca",
                                                "sense_id": "1d48a0eb-af60-31d2-bc45-7f14bc85630b",
                                                "text": "L’uniformité du style est bien près de la monotonie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
