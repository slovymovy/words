{
    "word_family": [
        "remit",
        "remitter",
        "remittee"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "33638268-24a3-3ef1-82a5-325e22fc7c8f",
                    "sense_definition": "A sum of money sent to someone, especially to a person living abroad or far away.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "money_transfer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many families rely on a monthly <w>remittance</w> from relatives working overseas to cover basic expenses.",
                            "target_lang_translations": {
                                "nl": "Veel gezinnen zijn afhankelijk van een maandelijkse <w>overmaking</w> van familieleden die in het buitenland werken om in hun basisbehoeften te voorzien."
                            }
                        },
                        {
                            "text": "The company sent a regular <w>remittance</w> to clear their outstanding balance with the supplier.",
                            "target_lang_translations": {
                                "nl": "Het bedrijf stuurde een periodieke <w>overschrijving</w> om het openstaande saldo bij de leverancier te voldoen."
                            }
                        }
                    ],
                    "synonyms": [
                        "payment",
                        "dispatch"
                    ],
                    "common_phrases": [
                        "monthly remittance",
                        "foreign remittance"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een geldbedrag dat naar iemand wordt gestuurd, vooral naar iemand die in het buitenland of ver weg woont."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "overschrijving",
                                "target_lang_sense_clarification": "via de bank verzonden bedrag"
                            },
                            {
                                "target_lang_word": "overboeking",
                                "target_lang_sense_clarification": "overgemaakt bedrag"
                            },
                            {
                                "target_lang_word": "overmaking",
                                "target_lang_sense_clarification": "toegezonden geld"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1f3b0683-7f12-3798-90e5-e30c71b9e4a2",
                    "sense_definition": "The act or process of sending money as payment or a gift.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "money_transfer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please enclose the invoice along with the <w>remittance</w> when making your final payment.",
                            "target_lang_translations": {
                                "nl": "Voeg alstublieft de factuur bij de <w>betaling</w> wanneer u het resterende bedrag voldoet."
                            }
                        },
                        {
                            "text": "The accounting department will issue a <w>remittance</w> advice once the bank transfer is confirmed.",
                            "target_lang_translations": {
                                "nl": "De boekhoudafdeling zal een <w>betalingsadvies</w> verstrekken zodra de overboeking is bevestigd."
                            }
                        }
                    ],
                    "synonyms": [
                        "transmission",
                        "settlement"
                    ],
                    "common_phrases": [
                        "remittance advice"
                    ],
                    "target_lang_definitions": {
                        "nl": "De handeling of het proces van het versturen of overmaken van geld als betaling of schenking."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "overmaking",
                                "target_lang_sense_clarification": "handeling van het overmaken"
                            },
                            {
                                "target_lang_word": "overschrijving",
                                "target_lang_sense_clarification": "girale betaling"
                            },
                            {
                                "target_lang_word": "betaling",
                                "target_lang_sense_clarification": "voldoening van een rekening"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e2ae6b6-c419-3a88-a1ca-43cdb5459276",
                    "sense_definition": "Money sent back by a migrant worker to their family or community in their home country.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "money_transfer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The national economy depends heavily on migrant <w>remittances</w> to support local development.",
                            "target_lang_translations": {
                                "nl": "De nationale economie is sterk afhankelijk van <w>geldovermakingen</w> van migranten om de lokale ontwikkeling te ondersteunen."
                            }
                        },
                        {
                            "text": "High fees make it difficult for foreign laborers to send a <w>remittance</w> back home.",
                            "target_lang_translations": {
                                "nl": "Hoge kosten maken het moeilijk voor buitenlandse arbeiders om een <w>geldbedrag over te maken</w> naar huis."
                            }
                        }
                    ],
                    "common_phrases": [
                        "migrant remittance",
                        "inward remittance"
                    ],
                    "target_lang_definitions": {
                        "nl": "Geld dat door een arbeidsmigrant naar familie of gemeenschap in het land van herkomst wordt gestuurd."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "geldovermaking",
                                "target_lang_sense_clarification": "naar het thuisland verzonden geld"
                            },
                            {
                                "target_lang_word": "remittance",
                                "target_lang_sense_clarification": "internationale geldzending van migranten (vakterm)"
                            },
                            {
                                "target_lang_word": "overboeking",
                                "target_lang_sense_clarification": "bedrag overgemaakt naar het buitenland"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}