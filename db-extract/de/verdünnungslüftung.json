                "senses": [
                    {
                        "sense_id": "2dba6913-c3d9-3cfe-a287-345a2cf0a1ac",
                        "entry_id": "ecc73ef1-899c-39de-8664-abdc94a3de9e",
                        "glosses": [
                            "Einbringung von Zuluft in einen Raum und turbulente Verdünnung der vorhandenen Raumluft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17bf56fc-e064-450f-8e7b-03228dba3a7e",
                                "sense_id": "2dba6913-c3d9-3cfe-a287-345a2cf0a1ac",
                                "text": "„Bei der Verdünnungslüftung wird Luft mit hoher Geschwindigkeit außerhalb des Wintergarteninneren zugeführt.“"
                            },
                            {
                                "example_id": "a0c9c748-050a-4dde-9829-ef10ff8d5547",
                                "sense_id": "2dba6913-c3d9-3cfe-a287-345a2cf0a1ac",
                                "text": "„ Hierbei unterscheidet man grundsätzlich zwischen der Verdrängungslüftung, die vor allem in OP-Räumen oder in Laboren verwendet wird, und der Verdünnungslüftung, die meist in Häusern zum Einsatz kommt.“"
                            },
                            {
                                "example_id": "bcc55427-8636-44a8-845a-99eef2361c4e",
                                "sense_id": "2dba6913-c3d9-3cfe-a287-345a2cf0a1ac",
                                "text": "„Verdünnungslüftung ist für Schweißwerkstätten keine geeignete Maßnahme, da zur ausreichenden Unterschreitung der Grenzwerte bei mehreren Arbeitsplätzen sehr hohe Außenluftvolumenströme erforderlich wären.“"
                            },
                            {
                                "example_id": "5eac5c8d-e1af-4669-92bc-3bb899329179",
                                "sense_id": "2dba6913-c3d9-3cfe-a287-345a2cf0a1ac",
                                "text": "„Dabei wird zwischen Verdrängungslüftung und Verdünnungslüftung unterschieden.“"
                            },
                            {
                                "example_id": "39696a02-4db9-42c2-b303-fbe1c740766a",
                                "sense_id": "2dba6913-c3d9-3cfe-a287-345a2cf0a1ac",
                                "text": "„Die Strahllüftung wird auch als Mischlüftung oder Verdünnungslüftung bezeichnet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
