                "senses": [
                    {
                        "sense_id": "1f34b5a8-fd5b-320c-a8e9-f1fd950aa8c4",
                        "entry_id": "7d008a84-879d-3e50-8609-58d1fdf16d8c",
                        "glosses": [
                            "Able to persuade; convincing."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9de5178f-f509-4cc6-ab26-a789153f6625",
                                "sense_id": "1f34b5a8-fd5b-320c-a8e9-f1fd950aa8c4",
                                "text": "But I'm pretty persuasive, and I've learned how elected officials think. I know how to press their buttons."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "68d80341-094b-4874-9151-a7daa49977e6",
                        "source_entry_id": "7d008a84-879d-3e50-8609-58d1fdf16d8c",
                        "source_sense_id": "1f34b5a8-fd5b-320c-a8e9-f1fd950aa8c4",
                        "source_sense_description": "convincing",
                        "target_lang_word": "přesvědčivý",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "přesvědčivý",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "37afd0c9-e13e-38a6-ad3a-ef4cd0e1ece7",
                                        "entry_id": "2c49fda7-789a-3f54-984e-48c95a305393",
                                        "glosses": [
                                            "takový, který dokáže přesvědčit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c2afd42-90b8-4c2f-96bb-ccbb65f014a6",
                                                "sense_id": "37afd0c9-e13e-38a6-ad3a-ef4cd0e1ece7",
                                                "text": "Tohle pro mě jsou dost přesvědčivé argumenty."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1a8ef273-00bf-4cf9-97d8-053ccaef7d7f",
                        "source_entry_id": "7d008a84-879d-3e50-8609-58d1fdf16d8c",
                        "source_sense_id": "1f34b5a8-fd5b-320c-a8e9-f1fd950aa8c4",
                        "source_sense_description": "convincing",
                        "target_lang_word": "persuasif",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "persuasif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dab8fe2f-b54c-3b78-a6cd-8476ada32007",
                                        "entry_id": "3857253e-2fc3-39de-9c3c-9b3b94662136",
                                        "glosses": [
                                            "Qui a la force, le pouvoir de persuader."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d98a296-a8cf-47db-8bc4-86baa89edc23",
                                                "sense_id": "dab8fe2f-b54c-3b78-a6cd-8476ada32007",
                                                "text": "Vous saurez trouver des arguments très percutants et vraiment persuasifs."
                                            },
                                            {
                                                "example_id": "7079eed2-a71f-4f2f-a1cc-8517f52d64cc",
                                                "sense_id": "dab8fe2f-b54c-3b78-a6cd-8476ada32007",
                                                "text": "C’est que nous ne l’avons pas choisi, monsieur ; nous l’attendons depuis si longtemps et avec tant d’impatience ! dit doucement Marguerite en glissant encore du côté de l’officier un regard persuasif."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec5418f8-7f4d-3f13-bf2c-040ac460b60e",
                                        "entry_id": "3857253e-2fc3-39de-9c3c-9b3b94662136",
                                        "glosses": [
                                            "Qui a l’art, le talent de persuader."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2afb028-797c-47d7-a686-59c61e3de461",
                                                "sense_id": "ec5418f8-7f4d-3f13-bf2c-040ac460b60e",
                                                "text": "Orateur éloquent et persuasif."
                                            },
                                            {
                                                "example_id": "1a0cf9e0-c274-4370-959e-62e907aa90cc",
                                                "sense_id": "ec5418f8-7f4d-3f13-bf2c-040ac460b60e",
                                                "text": "Vous êtes persuasif."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "de90283a-1066-44b3-8ec8-069d63cfe04e",
                        "source_entry_id": "7d008a84-879d-3e50-8609-58d1fdf16d8c",
                        "source_sense_id": "1f34b5a8-fd5b-320c-a8e9-f1fd950aa8c4",
                        "source_sense_description": "convincing",
                        "target_lang_word": "convaincant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "convaincant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a47b3d6a-0def-309a-ae9d-fd6f9bf5307d",
                                        "entry_id": "d69dbcd6-cc84-3ff2-9c85-6e87740edb3d",
                                        "glosses": [
                                            "Qui est propre à convaincre, qui emporte la conviction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17fb9eca-e099-41d1-8aab-49cec5c34bec",
                                                "sense_id": "a47b3d6a-0def-309a-ae9d-fd6f9bf5307d",
                                                "text": "Ce qui a été réalisé jusqu’alors par le dirigeable est admirable, mais cependant pas convaincant : le dirigeable est plus à la merci d’un accident que l’avion."
                                            },
                                            {
                                                "example_id": "ad386357-7a32-40d8-ace6-9a2f89b0d5d1",
                                                "sense_id": "a47b3d6a-0def-309a-ae9d-fd6f9bf5307d",
                                                "text": "11 décembre 1940 – J’ai refait trois fois ma première lettre d’amour. Elle me paraît assez convaincante. S’il suffisait pour vaincre de convaincre, l’affaire serait dans le sac."
                                            },
                                            {
                                                "example_id": "1204004a-d17d-4c14-9383-ab336458128e",
                                                "sense_id": "a47b3d6a-0def-309a-ae9d-fd6f9bf5307d",
                                                "text": "Mais quand bien même serions-nous plus nombreux, arriverions-nous à obtenir des résultats convaincants ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4e2f0fe9-c855-4297-b5fd-180dd85260b6",
                        "source_entry_id": "7d008a84-879d-3e50-8609-58d1fdf16d8c",
                        "source_sense_id": "1f34b5a8-fd5b-320c-a8e9-f1fd950aa8c4",
                        "source_sense_description": "convincing",
                        "target_lang_word": "überzeugend",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "überzeugend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2e614a32-8e4d-3d92-ba58-f466b48d4aed",
                                        "entry_id": "7c7f1c14-cfd7-3b8d-a35d-02f80e1b8f33",
                                        "glosses": [
                                            "so, dass jemand glaubt, dass etwas wahr ist: einleuchtend, glaubhaft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9572542d-ef89-429d-abe8-8d8a14429899",
                                                "sense_id": "2e614a32-8e4d-3d92-ba58-f466b48d4aed",
                                                "text": "Seine Argumentation ist wirklich überzeugend."
                                            },
                                            {
                                                "example_id": "3ce18e73-ef91-4fd2-99a4-844089c148e3",
                                                "sense_id": "2e614a32-8e4d-3d92-ba58-f466b48d4aed",
                                                "text": "Dieser Kandidat hat einen überzeugenden Auftritt."
                                            },
                                            {
                                                "example_id": "59bfb04f-c659-44c6-ac27-7366215dcedd",
                                                "sense_id": "2e614a32-8e4d-3d92-ba58-f466b48d4aed",
                                                "text": "Ich fand ihre Erklärungsversuche nicht überzeugend."
                                            },
                                            {
                                                "example_id": "95316b15-9ffa-4940-ad5d-a26db0dd7824",
                                                "sense_id": "2e614a32-8e4d-3d92-ba58-f466b48d4aed",
                                                "text": "Sollen das ihre überzeugenden Beweise sein?"
                                            },
                                            {
                                                "example_id": "412f9c49-c42a-4053-954d-b6e323d37550",
                                                "sense_id": "2e614a32-8e4d-3d92-ba58-f466b48d4aed",
                                                "text": "„Der Bericht sagt sehr überzeugend, wohlfundiert, dass es sich lohnt, in Klima zu investieren.“"
                                            },
                                            {
                                                "example_id": "cb3f94c6-b74a-448c-93f5-9505a1c54eac",
                                                "sense_id": "2e614a32-8e4d-3d92-ba58-f466b48d4aed",
                                                "text": "Gerade in einem Song wie \"All my hope is gone\" kommt der Blues zurück, den Faulkner so liebt und so überzeugend spielt, als wäre er selbst am Mississippi groß geworden."
                                            },
                                            {
                                                "example_id": "374ce25b-34c6-415b-b35e-6da36c4a21fe",
                                                "sense_id": "2e614a32-8e4d-3d92-ba58-f466b48d4aed",
                                                "text": "[…] wenn er bisher in den ersten Tagen seit seiner Wahl eines überzeugend unter Beweis gestellt hat: Donald Trump ist immer für Überraschungen gut."
                                            },
                                            {
                                                "example_id": "59645911-b2c5-4c15-b18e-28cfe849b65e",
                                                "sense_id": "2e614a32-8e4d-3d92-ba58-f466b48d4aed",
                                                "text": "DFB-Frauen siegen gegen Frankreich: Mit einem überzeugenden Erfolg gegen die Equipe Tricolore haben die deutschen Fußball-Frauen ein schlechtes Länderspiel-Jahr beendet."
                                            },
                                            {
                                                "example_id": "16426988-6172-4847-8425-38c187e9488f",
                                                "sense_id": "2e614a32-8e4d-3d92-ba58-f466b48d4aed",
                                                "text": "Damit kein Mißverständnis aufkommt: Zarnajews Tat war verabscheuungswürdig und muß entsprechend hart bestraft werden. Die Frage ist nur, ob Juroren und Richter wirklich frei in ihrer Entscheidung waren und die Todesstrafe demzufolge überzeugend gefällt wurde. Ich bleibe bei meinen Zweifeln."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "überzeugend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3a614f31-fac8-3e91-a658-764bc2da28b4",
                                        "entry_id": "d4aefccf-a2d7-30d7-a1ec-171b92819108",
                                        "glosses": [
                                            "Partizip Präsens des Verbs überzeugen"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "present"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
