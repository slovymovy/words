                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c570a28a-7a0c-3553-b59f-73d265d995fa",
                                        "entry_id": "9cf5843a-8b40-3248-90b2-9982c1272a90",
                                        "glosses": [
                                            "A short form (of a longer word) created by removing syllables, often terminal ones."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e168124b-0fc4-447c-b627-1b2a88034611",
