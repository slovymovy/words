                "senses": [
                    {
                        "sense_id": "2d197050-d7d9-3292-a884-62eeb30afebc",
                        "entry_id": "f0f2b981-7015-33e4-84de-86284ee06b63",
                        "glosses": [
                            "Pertaining to the origin of man, or anthropogeny; anthropogonic."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "e956befe-a552-4f51-9f97-89783e027040",
                                "sense_id": "2d197050-d7d9-3292-a884-62eeb30afebc",
                                "text": "1952 The cosmogonic and anthropogenic myths are of secondary importance in Yahwistic religiosity. (H. H. Gerth & D. A. Martindale (trans.), M. Weber's Ancient Judaism ix. 227)"
                            }
                        ]
                    },
                    {
                        "sense_id": "40190ae8-b4f8-3562-9a59-ee81adfccc11",
                        "entry_id": "f0f2b981-7015-33e4-84de-86284ee06b63",
                        "glosses": [
                            "Having its origin in the influence of human activity on nature."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "a6ff84ce-90f3-466a-893a-8e3d9ebdc876",
                                "sense_id": "40190ae8-b4f8-3562-9a59-ee81adfccc11",
                                "text": "anthropogenic climate change"
                            },
                            {
                                "example_id": "86e907eb-4a1a-496f-95df-03083d09a73e",
                                "sense_id": "40190ae8-b4f8-3562-9a59-ee81adfccc11",
                                "text": "Wastewater is any water that has been adversely affected in quality by anthropogenic influence."
                            },
                            {
                                "example_id": "5f8336f8-6ae4-4c8d-bcec-b360720f6ee8",
                                "sense_id": "40190ae8-b4f8-3562-9a59-ee81adfccc11",
                                "text": "The approximately 4,000 remaining adult birds in this species are also threatened by the usual palette of anthropogenic factors, including habitat destruction, oil and gas drilling and disruption of fish movement by dams."
                            }
                        ]
                    }
