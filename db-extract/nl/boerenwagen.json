                "senses": [
                    {
                        "sense_id": "e0bdd0ea-cb87-341d-826c-6cfa142c6f13",
                        "entry_id": "0267ab44-e587-3828-a3da-6eed1721f59d",
                        "glosses": [
                            "een eenvoudige wagen die wordt gebruikt door landbouwers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49e30b40-7965-43ad-a682-6946ae674364",
                                "sense_id": "e0bdd0ea-cb87-341d-826c-6cfa142c6f13",
                                "text": "Achter hem kwam een wagen die er heel anders uitzag dan alle wagens die tot dan toe voorbij waren gekomen. Het was een Duitse boerenwagen met twee paarden die beladen leek met een heel huishouden; achter de wagen, die door een Duitser werd gemend, was een mooie, bonte koe met een enorme uier gebonden."
                            },
                            {
                                "example_id": "6f856684-4a9e-4757-a3ba-5b83edbb0e66",
                                "sense_id": "e0bdd0ea-cb87-341d-826c-6cfa142c6f13",
                                "text": "Een boerenwagen bracht hem van het Engelse fregat The Warrior naar het strand. Bijna een half jaar later, op 30 maart 1814, werd hij in de Nieuwe Kerk in Amsterdam ingehuldigd als koning Willem I."
                            }
                        ]
                    }
