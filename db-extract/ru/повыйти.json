                "forms": [],
                "senses": [
                    {
                        "sense_id": "c3ff726a-c4d9-3a3b-ae5a-91d9d31a736b",
                        "entry_id": "decafe31-b721-3c62-be39-1573539030cd",
                        "glosses": [
                            "Sortir (l’un après l’autre, tous, ou tout au moins une grande partie)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50aec3f8-b121-4a18-b1f7-5e118e7f2073",
                                "sense_id": "c3ff726a-c4d9-3a3b-ae5a-91d9d31a736b",
                                "text": "Пассажиры повышли, остались грузы. : Les passagers sortirent l’un après l’autre, il ne resta que la cargaison."
                            },
                            {
                                "example_id": "2fa5df1e-ae37-4c51-b6c2-dc9389851c1a",
                                "sense_id": "c3ff726a-c4d9-3a3b-ae5a-91d9d31a736b",
                                "text": "Все одноклассницы повышли замуж. : Tous mes copains de classe se sont mariés l’un après l’autre."
                            }
                        ]
                    },
                    {
                        "sense_id": "51b283e1-220b-3692-9a3b-73e5dc02103d",
                        "entry_id": "decafe31-b721-3c62-be39-1573539030cd",
                        "glosses": [
                            "Apparaître (petit à petit)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "271271fa-ddac-4a57-927e-abc579f8018e",
                                "sense_id": "51b283e1-220b-3692-9a3b-73e5dc02103d",
                                "text": "Солнышко повышло из-за леса. : Le soleil apparut de derrière la forêt."
                            }
                        ]
                    }
                ],
