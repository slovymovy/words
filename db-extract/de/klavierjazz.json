                "senses": [
                    {
                        "sense_id": "78a6dde7-d950-30e0-a8ea-4be17dce8bb9",
                        "entry_id": "1d2b6c15-f5eb-3ac7-9c2a-2b7ed694085e",
                        "glosses": [
                            "Musikrichtung Jazz für das Tasteninstrument Klavier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "164f16a7-6829-4288-bc78-e22af87cb150",
                                "sense_id": "78a6dde7-d950-30e0-a8ea-4be17dce8bb9",
                                "text": "„Doch die dem Band exklusiv beiliegende CD mit instrumentalem Klavierjazz von Didier Squiban hat mich überrascht.“"
                            },
                            {
                                "example_id": "6d88de2f-7f96-42f1-8482-879ed43c43d8",
                                "sense_id": "78a6dde7-d950-30e0-a8ea-4be17dce8bb9",
                                "text": "„Downtown Records ist ein Schweizer Musiklabel mit Spezialgebiet Jazz und Klavierjazz und wurde 1983 gegründet.“"
                            },
                            {
                                "example_id": "6f0e37f7-a7b8-49c7-98ad-b308e121acc5",
                                "sense_id": "78a6dde7-d950-30e0-a8ea-4be17dce8bb9",
                                "text": "„Und auch die Pianistin Anke Helfrich mit ihrem Trio, die im strahlenden Nachmittagslicht ihr Set im Geiste der Moderne des Klavierjazz absolvierte, hatte es nicht leicht in diesem Zusammenhang.“"
                            },
                            {
                                "example_id": "afa17128-4d48-4dad-ae31-73abe0923ab9",
                                "sense_id": "78a6dde7-d950-30e0-a8ea-4be17dce8bb9",
                                "text": "„Fliegen, Tanzen, Bügeln: Jacob Karlzons moderner Klavierjazz passt zu allen möglichen Beschäftigungen.“"
                            },
                            {
                                "example_id": "036a44de-875d-4b24-8ea5-ffd16f76f251",
                                "sense_id": "78a6dde7-d950-30e0-a8ea-4be17dce8bb9",
                                "text": "„Die drei Musiker haben sich in diesen Jahren genaustens kennengelernt, sich neue musikalische Wege eröffnet bis hin zum völlig freien Spiel und den Klavierjazz auf eine neue Ebene gehoben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
