                ],
                "senses": [
                    {
                        "sense_id": "51b3c7d9-c12d-37c8-b727-76c48977e9b6",
                        "entry_id": "ebfd61f4-4d61-3511-a386-4031fdccb755",
                        "glosses": [
                            "(junger) urwüchsiger Mensch, der wenig durch moderne Zivilisation beeinflusst ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "310e3fbe-2922-46cc-b756-14bfb4735e0c",
                                "sense_id": "51b3c7d9-c12d-37c8-b727-76c48977e9b6",
                                "text": "„Während wir uns mit der Schnalle beschäftigen, drücke ich meine Brieftasche mit dem Arm fest an mich, um dieses Naturkind nicht in Versuchung zu führen.“"
                            },
                            {
                                "example_id": "53747b4a-99f7-4a46-81dc-690306b8f1b7",
                                "sense_id": "51b3c7d9-c12d-37c8-b727-76c48977e9b6",
                                "text": "„Die Erzählung des Briten hatte allerdings etwas an sich, das dem ungekünstelten, mit den Grundsätzen des Völkerrechts gänzlich unbekannten Naturkinde ziemlich unwahrscheinlich vorkommen mußte.“"
                            },
                            {
                                "example_id": "d58a555f-f4c4-4d0d-8dda-0ba48028bde6",
                                "sense_id": "51b3c7d9-c12d-37c8-b727-76c48977e9b6",
                                "text": "„Wäre man boshaft, würde man sagen, die Bedingung für die Luft der Freiheit dieser Naturkinder sei nachbarschaftliche Enge und, wie es Friedrich Engels formuliert hätte, die Idiotie des Landlebens.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
