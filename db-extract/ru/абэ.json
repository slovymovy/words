                ],
                "senses": [
                    {
                        "sense_id": "8720f1f7-82fc-33f2-840c-5ca2bd6a5bd6",
                        "entry_id": "3f478b3c-baf8-39b3-8789-cfbf8268ba08",
                        "glosses": [
                            "японская фамилия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35530191-0a9e-4114-b739-303e168c4a5d",
                                "sense_id": "8720f1f7-82fc-33f2-840c-5ca2bd6a5bd6",
                                "text": "Большая дружба завязалась между мамой и профессором медицины Абэ."
                            },
                            {
                                "example_id": "217bea92-c4b6-4df2-81d7-2b62ad82e820",
                                "sense_id": "8720f1f7-82fc-33f2-840c-5ca2bd6a5bd6",
                                "text": "— Так вышло, что вплоть до конца 90-х годов самыми современными японцами для русских читателей оставались Кобо Абэ и Кэндзабуро Оэ."
                            },
                            {
                                "example_id": "8c298cc1-7e8c-43c8-b840-be6164c01ddc",
                                "sense_id": "8720f1f7-82fc-33f2-840c-5ca2bd6a5bd6",
                                "text": "Пару лет назад к власти пришёл энергичный премьер-министр Синдзо Абэ, который придумал «абэномику»."
                            },
                            {
                                "example_id": "2b0e8950-ae08-45b5-9018-f032d0d50b6a",
                                "sense_id": "8720f1f7-82fc-33f2-840c-5ca2bd6a5bd6",
                                "text": "Убитый в возрасте 67 лет Синдзо Абэ, 57-й и 63-й премьер-министр Японии в 2006–2007 и 2012–2020 годах соответственно, дольше всех проработал на этом посту в истории страны."
                            }
                        ]
                    }
