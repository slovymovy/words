                        "glosses": [
                            "soeverein gebied dat geheel door zee wordt omringd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8bfe26f-9562-4a54-b60e-b06c076d485f",
                                "sense_id": "4930f4c5-1267-3639-9188-eaf252898dfb",
                                "text": "Het waren die eilandstaten die eind jaren tachtig al begrepen dat de klimaatverandering hun voortbestaan bedreigde, door de stijging van de zeespiegel."
                            }
                        ]
                    }
                ],
