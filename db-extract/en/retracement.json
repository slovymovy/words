                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3f04d4f-00a4-42c8-940a-898e3305df94",
                                                "sense_id": "42dc36da-b24a-360b-94b6-af5fb96c6663",
                                                "text": "„Die spontanen Hebungen und Senkungen nach schweren Erdbeben führen zu großräumigen Verwerfungen der Gesteinsschichten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
