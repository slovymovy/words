                    {
                        "translation_id": "9e18e3cc-c3b6-4822-902e-80f12b940601",
                        "source_entry_id": "ae52350a-8729-3063-b4bd-57e61c7d3cd6",
                        "source_sense_description": "Of or relating to Spanish-speaking people or culture",
                        "target_lang_word": "spanisch",
                        "target_lang_code": "de",
                        "note": "of Spain",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spanisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5ac1ac6d-1fd4-351a-9490-d5d712790f5d",
                                        "entry_id": "d76067f6-ce5b-3c08-b216-ea97f6d82ba1",
                                        "glosses": [
                                            "zu Spanien gehörig, aus Spanien kommend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3de8497a-113e-43f7-9d77-53109e6bc70e",
                                                "sense_id": "5ac1ac6d-1fd4-351a-9490-d5d712790f5d",
                                                "text": "Der spanische Außenminister ist heute in Berlin."
                                            },
                                            {
                                                "example_id": "218b91d9-5a01-46b7-89cc-595ba923e022",
                                                "sense_id": "5ac1ac6d-1fd4-351a-9490-d5d712790f5d",
                                                "text": "„Humboldt wandte sich an den Kapitän, zeigte einmal noch seinen spanischen Paß und erbat eine Passage.“"
                                            },
                                            {
                                                "example_id": "89d72204-6822-4f45-bfe5-bf6a3e76c54b",
                                                "sense_id": "5ac1ac6d-1fd4-351a-9490-d5d712790f5d",
                                                "text": "„Indiz für den verbreiteten Wunsch, Wagemut zu demonstrieren und sich über das starke Tier zu profilieren, ist auch das Stiertreiben (Encierro), das am Morgen eines Stierkampftages im spanischen Pamplona […] die sogenannten Corredores auf die Straßen zieht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7ad936b2-bee7-3e97-99d5-d953d21342b7",
                                        "entry_id": "d76067f6-ce5b-3c08-b216-ea97f6d82ba1",
                                        "glosses": [
                                            "zum Volk der Spanier gehörig, in der Art und Weise der Spanier"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6a0f4d2-4150-4e5c-ad1b-cfc21f8e95de",
                                                "sense_id": "7ad936b2-bee7-3e97-99d5-d953d21342b7",
                                                "text": "Da mir persönlich auch sehr am Kulturgut und Brauchtum der Einheimischen gelegen war, nutzte ich die einmalige Chance, einen Stierkampf zu besuchen, diesen spanischsten aller Bräuche."
                                            },
                                            {
                                                "example_id": "41dc45aa-b51b-4da1-aa7b-3e23c77bbb96",
                                                "sense_id": "7ad936b2-bee7-3e97-99d5-d953d21342b7",
                                                "text": "Er brachte seine spanische Ehefrau mit."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4cad5b43-d758-3b65-844d-ed118ee765ce",
                                        "entry_id": "d76067f6-ce5b-3c08-b216-ea97f6d82ba1",
                                        "glosses": [
                                            "zur Sprache Spanisch gehörig"
                                        ],
                                        "tags": [
                                            "no-comparative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e43e5772-b925-4b1e-9bfb-0e8b84104454",
                                                "sense_id": "4cad5b43-d758-3b65-844d-ed118ee765ce",
                                                "text": "Ich habe wieder ein paar spanische Wörter gelernt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "02bd8a6f-a3e8-398c-89b2-0fcd59a726e7",
                                        "entry_id": "d76067f6-ce5b-3c08-b216-ea97f6d82ba1",
                                        "glosses": [
                                            "Charakterisierung einer Sexualpraktik, bei der ein Partner oder eine Partnerin seine/ ihre Geschlechtsorgane an den Brüsten der Partnerin stimuliert"
                                        ],
                                        "tags": [
                                            "Sexualität"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e31524bc-8864-4f84-91a5-466629f1bef2",
                                                "sense_id": "02bd8a6f-a3e8-398c-89b2-0fcd59a726e7",
                                                "text": "Machst du's auch spanisch?"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "50f3130e-9c1b-476a-b464-6bb8338ef4ef",
                        "source_entry_id": "ae52350a-8729-3063-b4bd-57e61c7d3cd6",
