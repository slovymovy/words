    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d262e9f0-de14-3fd1-850d-eb09039162a3",
                    "sense_definition": "The top or highest part of a wave.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "top_summit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The surfer managed to ride the <w>crest</w> of the giant wave.",
                            "target_lang_translations": {
                                "ru": "Сёрферу удалось оседлать <w>гребень</w> гигантской волны.",
                                "de": "Der Surfer schaffte es, auf dem <w>Wellenkamm</w> der Riesenwelle zu reiten."
                            }
                        },
                        {
                            "text": "Foam formed on the <w>crest</w> of the swelling sea.",
                            "target_lang_translations": {
                                "ru": "На <w>гребне</w> вздымающегося моря образовалась пена.",
                                "de": "Auf dem <w>Kamm</w> des anschwellenden Meeres bildete sich Schaum."
                            }
                        }
                    ],
                    "synonyms": [
                        "top",
                        "peak"
                    ],
                    "antonyms": [
                        "trough"
                    ],
                    "common_phrases": [
                        "crest of a wave",
                        "on the crest"
                    ],
                    "target_lang_definitions": {
                        "ru": "Верхняя или наивысшая часть волны.",
                        "de": "Der oberste oder höchste Punkt einer Welle."
                    },
                    "translations": {
