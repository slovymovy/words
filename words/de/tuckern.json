    "word_family": [],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4ecf94f8-caa1-374a-b280-5d8ad9a08c0f",
                    "sense_definition": "Sich mit einem Fahrzeug langsam und meist unter regelmäßigem, dumpfem Motorengeräusch fortbewegen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fortbewegung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der alte Traktor <w>tuckert</w> langsam über das weite Feld."
                        },
                        {
                            "text": "Wir <w>tuckerten</w> an einem sonnigen Nachmittag gemütlich über den See."
                        }
                    ],
                    "common_phrases": [
                        "über den See tuckern",
                        "durch die Stadt tuckern"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "häufig umgangssprachlich verwendet"
                        }
                    ]
                },
                {
                    "sense_id": "079fae51-d43e-3caa-859e-afabc408bde7",
                    "sense_definition": "Ein gleichmäßiges, dumpf klopfendes Geräusch von sich geben, wie es für einen langsam laufenden Motor typisch ist.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "motorengeraeusch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Im Hafen <w>tuckerte</w> der Motor des kleinen Fischerboots vor sich hin."
                        },
                        {
                            "text": "Aus der Ferne hörte man eine Maschine unaufhörlich im Hintergrund <w>tuckern</w>."
                        }
                    ],
                    "common_phrases": [
                        "vor sich hin tuckern"
                    ]
                },
                {
                    "sense_id": "c412f2ee-b059-35ef-916d-f0d0aee6ca10",
                    "sense_definition": "Ein rhythmisches Klopfen oder Pochen in einem verletzten oder entzündeten Körperteil verursachen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "schmerzempfindung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nach dem Schlag mit dem Hammer begann mein Daumen heftig zu <w>tuckern</w>."
                        },
                        {
                            "text": "Die entzündete Wunde am Knie <w>tuckerte</w> die ganze Nacht und tat weh."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "umgangssprachlich für pochen"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f434ce52-b9c5-38e5-b100-f3c2168cd7c9",
                    "sense_definition": "Gleichmäßiges, dumpf klopfendes Geräusch, das insbesondere von einem langsam arbeitenden Motor erzeugt wird.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "motorengeraeusch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das gleichmäßige <w>Tuckern</w> des Motors beruhigte das schlafende Kind auf dem Boot."
                        },
                        {
                            "text": "In der morgendlichen Stille war nur das monotone <w>Tuckern</w> eines Traktors zu vernehmen."
                        }
                    ],
                    "synonyms": [
                        "Getucker"
                    ],
                    "common_phrases": [
                        "das monotone Tuckern",
                        "das Tuckern des Motors"
                    ]
                }
            ]
        }
    ]
}