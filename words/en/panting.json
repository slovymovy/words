    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3aa13dbc-b21c-3307-a0a1-919241d03a13",
                    "sense_definition": "present participle and gerund of <w>pant</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "breathing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dog was <w>panting</w> heavily after running across the sunny park.",
                            "target_lang_translations": {
                                "de": "Der Hund <w>hechelte</w> schwer, nachdem er durch den sonnigen Park gerannt war.",
                                "ru": "Собака <w>тяжело дышала</w>, пробежавшись по залитому солнцем парку."
                            }
                        },
                        {
                            "text": "She arrived at the top of the hill, <w>panting</w> for breath.",
                            "target_lang_translations": {
                                "de": "Sie kam oben auf dem Hügel an, nach Atem <w>keuchend</w>.",
                                "ru": "Она добралась до вершины холма, <w>задыхаясь</w> от нехватки воздуха."
                            }
                        }
                    ],
                    "synonyms": [
                        "gasping",
                        "wheezing",
                        "puffing"
                    ],
                    "common_phrases": [
                        "panting for breath",
                        "panting heavily"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Partizip Präsens und Gerundium von pant; hecheln, keuchen",
                        "ru": "Причастие настоящего времени или герундий от глагола pant; тяжело или часто дышащий, задыхающийся."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "hechelnd",
                                "target_lang_sense_clarification": "schnell und kurz atmend (oft bei Hunden oder nach Anstrengung)"
                            },
                            {
                                "target_lang_word": "keuchend",
                                "target_lang_sense_clarification": "schwer atmend nach großer Anstrengung"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "тяжело дышащий",
                                "target_lang_sense_clarification": "о человеке или животном после нагрузки"
                            },
                            {
                                "target_lang_word": "запыхавшийся",
                                "target_lang_sense_clarification": "сбившийся с дыхания после бега или усилий"
                            },
                            {
                                "target_lang_word": "задыхающийся",
                                "target_lang_sense_clarification": "жадно хватающий ртом воздух"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fc03151a-2379-3947-9469-3a058468bc1c",
                    "sense_definition": "Rapid, labored breathing or gasping sounds.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "breathing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the silent hallway, the loud <w>panting</w> of the runner was the only sound.",
                            "target_lang_translations": {
                                "de": "Auf dem stillen Flur war das laute <w>Keuchen</w> des Läufers das einzige Geräusch.",
                                "ru": "В тихом коридоре громкое <w>тяжёлое дыхание</w> бегуна было единственным звуком."
                            }
                        },
                        {
                            "text": "Her rapid <w>panting</w> began to slow as she sat down to rest.",
                            "target_lang_translations": {
                                "de": "Ihr schnelles <w>Hecheln</w> begann sich zu verlangsamen, als sie sich hinsetzte, um sich auszuruhen.",
                                "ru": "Её частое <w>дыхание</w> начало успокаиваться, когда она присела отдохнуть."
                            }
                        }
                    ],
                    "synonyms": [
                        "gasping",
                        "wheezing"
                    ],
                    "common_phrases": [
                        "heavy panting"
                    ],
                    "target_lang_definitions": {
                        "de": "Schnelles, mühsames Atmen oder keuchende Geräusche.",
                        "ru": "Частое, тяжелое дыхание или звуки одышки."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "das Keuchen",
                                "target_lang_sense_clarification": "schweres, angestrengtes Atmen"
                            },
                            {
                                "target_lang_word": "das Hecheln",
                                "target_lang_sense_clarification": "schnelles, flaches Atmen (z. B. bei Hunden)"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "тяжёлое дыхание",
                                "target_lang_sense_clarification": "шумный вдох и выдох от усталости или жары"
                            },
                            {
                                "target_lang_word": "одышка",
                                "target_lang_sense_clarification": "сбитое, затруднённое дыхание"
                            },
                            {
                                "target_lang_word": "запыхавшееся дыхание",
                                "target_lang_sense_clarification": "звуки дыхания после физической нагрузки"
                            }
                        ]
                    }
                }
            ]
        },
