                    {
                        "sense_id": "9a012c6b-a656-37a5-872d-40ebe354f61d",
                        "entry_id": "40b786a2-3799-3c9c-b127-3e98b37cbe16",
                        "glosses": [
                            "Corsage ajusté, à longues basques flottantes, porté sur la jupe par les femmes du peuple ou de la campagne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b659f3bb-ad0e-42bc-9a43-14ab7da9c113",
                                "sense_id": "9a012c6b-a656-37a5-872d-40ebe354f61d",
                                "text": "On nommait hongreline une veste étoffée qui remplaçait la robe chez les servantes et les femmes du peuple."
                            }
                        ]
                    },
                    {
                        "sense_id": "77029bd7-7b56-36df-99d2-dd944f23c311",
                        "entry_id": "40b786a2-3799-3c9c-b127-3e98b37cbe16",
                        "glosses": [
                            "Paletot boutonné sur le devant et fendu tout autour à partir des hanches."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b1ee69b-9f3c-4b4e-98ed-e56e030ee353",
                                "sense_id": "77029bd7-7b56-36df-99d2-dd944f23c311",
                                "text": "On se rappelle le buffle et la hongreline, qui étaient les vêtements préférés dans la cavalerie à la fin du règne de Louis XIII."
                            }
                        ]
                    },
                    {
                        "sense_id": "751c9d2e-b5a6-39f3-b2ce-7914ae451054",
                        "entry_id": "40b786a2-3799-3c9c-b127-3e98b37cbe16",
                        "glosses": [
                            "Justaucorps fourré porté par les hommes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b186626-d2bd-4b84-af53-8bdfea79abef",
                                "sense_id": "751c9d2e-b5a6-39f3-b2ce-7914ae451054",
                                "text": "Dans la cour se tenaient les officiers de chasse, et, au milieu d’eux, Marillac, habillé d’une hongreline écarlate et bien fourrée, une plume flottant sur le petit chapeau retroussé et boutonné d’or sous le menton."
                            }
                        ]
                    }
