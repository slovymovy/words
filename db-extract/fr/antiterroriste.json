                "senses": [
                    {
                        "sense_id": "f3fa730b-f939-3771-ad34-f06260ebafdb",
                        "entry_id": "9710f55a-5991-37ad-978a-1d189137139e",
                        "glosses": [
                            "Personne qui lutte contre le terrorisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "807d01fe-2474-469f-ae92-c0fbef16118c",
                                "sense_id": "f3fa730b-f939-3771-ad34-f06260ebafdb",
                                "text": "Révolutionnaire et terroriste type (au sens paulhanien du mot), il devient vite un antiterroriste conséquent."
                            },
                            {
                                "example_id": "6e56e439-9477-443c-932a-c415a62a8d66",
                                "sense_id": "f3fa730b-f939-3771-ad34-f06260ebafdb",
                                "text": "Né en 2000, le jeu vidéo de tirs à la première personne est devenu un objet culte pour les gameurs, sans jamais rien changer à un concept aussi manichéen qu’efficace : les terroristes d’un côté, les antiterroristes de l’autre, et que le meilleur gagne."
                            }
                        ]
                    }
