                                    {
                                        "sense_id": "3e763002-fc54-3d26-8015-cb11b1e66240",
                                        "entry_id": "be358802-0f31-3f91-823f-4fc4222c385e",
                                        "glosses": [
                                            "Action de réédifier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97c570b2-493c-4de0-8e92-9889f3608c20",
                                                "sense_id": "3e763002-fc54-3d26-8015-cb11b1e66240",
                                                "text": "La réédification d’une église, d’un palais."
                                            },
                                            {
                                                "example_id": "146c0dbe-c93a-416f-bb5f-77d0357f3c1b",
                                                "sense_id": "3e763002-fc54-3d26-8015-cb11b1e66240",
                                                "text": "La réédification du temple de Jérusalem."
                                            },
                                            {
                                                "example_id": "8ddad1e9-c4a3-464f-99f7-a49ee0af7a71",
                                                "sense_id": "3e763002-fc54-3d26-8015-cb11b1e66240",
                                                "text": "Plus tard, il est vrai, sous Alphonse X, on y fit quelques modifications, et enfin le 8 juillet 1401, le sacré chapitre se s’assembla pour délibérer sue la néccessité d’une réédification complète, réédification motivée par l’étal de délabrement auquel de nombreux tremblements de terre avaient réduit l’ancienne mosquée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "96a9bc65-94ae-4f3d-892b-61567655edd0",
                        "source_entry_id": "aef936f9-e25d-38d0-8812-3ac626a6c839",
                        "source_sense_id": "3435d1c0-9013-31f9-a181-08090b462b28",
                        "source_sense_description": "act of building again",
                        "target_lang_word": "Wiederaufbau",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wiederaufbau",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fbe048e8-3e79-3af8-96cf-7193b1783064",
                                        "entry_id": "a709bdc0-5a19-35fa-8db0-34004ffd13a3",
                                        "glosses": [
                                            "Wiedererrichtung von Zerstörtem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "094a9f51-5a50-4e15-a45c-c76857583a62",
                                                "sense_id": "fbe048e8-3e79-3af8-96cf-7193b1783064",
                                                "text": "„Im März beginnen die Vorarbeiten zum Wiederaufbau des Berliner Schlosses als Haus der Weltkulturen unter dem Namen Humboldt-Forum, frühestens 2018 dürfte es fertig sein.“"
                                            },
                                            {
                                                "example_id": "f0a70c3e-adaa-4f19-a771-1586b6acbf5c",
                                                "sense_id": "fbe048e8-3e79-3af8-96cf-7193b1783064",
                                                "text": "„Er beschloss, sich mit aller Kraft für den Wiederaufbau des Bogens einzusetzen und sich als Urheber einer entsprechenden Kampagne einen Namen zu machen.“"
                                            },
                                            {
                                                "example_id": "cce594f3-aa6b-4cc2-84de-ab04f330b577",
                                                "sense_id": "fbe048e8-3e79-3af8-96cf-7193b1783064",
                                                "text": "„Der Wiederaufbau sorgte für Ärger, aber auch für surreale Momente.“"
                                            },
                                            {
                                                "example_id": "a0f7fa9d-d624-4aa2-b1ce-6883fc52c233",
                                                "sense_id": "fbe048e8-3e79-3af8-96cf-7193b1783064",
                                                "text": "„Es gab keine gesetzliche Möglichkeit, den Vertrieb ‚kulturell minderwertiger oder schädlicher Filme‘ zu untersagen, wie das für das Kinowesen zuständige Ministerium für Handel und Wiederaufbau auf Anfrage bedauernd mitteilte.“"
                                            },
                                            {
                                                "example_id": "194d6348-839b-4c4b-a75d-1c95ce90438a",
                                                "sense_id": "fbe048e8-3e79-3af8-96cf-7193b1783064",
                                                "text": "[Hans Böckler:] „1945 begann er mit dem Wiederaufbau der Gewerkschaften in der Britischen Zone.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
