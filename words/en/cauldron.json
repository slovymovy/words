            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3e2b6951-4107-3aca-962d-da5b32a55fe0",
                    "sense_definition": "A large bowl-shaped pot used for boiling over an open flame.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cooking vessel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The witch stirred the bubbling <w>cauldron</w> while chanting a mysterious spell.",
                            "target_lang_translations": {
                                "ru": "Ведьма помешивала бурлящий <w>котёл</w>, напевая таинственное заклинание."
                            }
                        },
                        {
                            "text": "In the old days, people used a large <w>cauldron</w> to cook soup over a fire.",
                            "target_lang_translations": {
                                "ru": "В прежние времена люди использовали большой <w>котёл</w>, чтобы варить суп на костре."
                            }
                        }
                    ],
                    "synonyms": [
                        "pot",
                        "kettle"
                    ],
                    "common_phrases": [
                        "bubbling cauldron",
                        "large cauldron",
                        "iron cauldron"
                    ],
                    "target_lang_definitions": {
                        "ru": "Большой котел округлой формы, используемый для кипячения на открытом огне."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "котёл",
                                "target_lang_sense_clarification": "большой металлический сосуд"
                            },
                            {
                                "target_lang_word": "казан",
                                "target_lang_sense_clarification": "чугунный котел для приготовления пищи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0d0b7706-8cd0-34a5-939d-f0f59d3f454a",
                    "sense_definition": "An unsettled, difficult, or highly emotional situation or place.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "situation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stadium became a <w>cauldron</w> of noise as the home team scored the winning goal.",
                            "target_lang_translations": {
                                "ru": "Стадион превратился в <w>котёл</w> шума, когда домашняя команда забила победный гол."
                            }
                        },
                        {
                            "text": "The city was a <w>cauldron</w> of discontent following the announcement of the new taxes.",
                            "target_lang_translations": {
                                "ru": "Город стал <w>очагом</w> недовольства после объявления о новых налогах."
                            }
                        }
                    ],
                    "synonyms": [
                        "hotbed",
                        "maelstrom"
                    ],
                    "common_phrases": [
                        "cauldron of noise",
                        "cauldron of discontent",
                        "emotional cauldron"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "metaphorical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Неспокойная, сложная или крайне эмоциональная ситуация или место."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "котёл",
                                "target_lang_sense_clarification": "переносное значение, о бурных событиях"
                            },
                            {
                                "target_lang_word": "кипящий котёл",
                                "target_lang_sense_clarification": "метафора напряженной обстановки"
                            },
                            {
                                "target_lang_word": "очаг",
                                "target_lang_sense_clarification": "место сосредоточения каких-либо чувств или явлений"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af0fff1f-a43b-366c-8315-4e1f0f49f6ba",
                    "sense_definition": "A strategic encirclement of military forces by an enemy.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "military",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The trapped soldiers tried to break out of the <w>cauldron</w> before the enemy closed in.",
                            "target_lang_translations": {
                                "ru": "Окруженные солдаты пытались вырваться из <w>котла</w>, пока враг не сомкнул кольцо."
                            }
                        },
                        {
                            "text": "Thousands of troops were caught in the southern <w>cauldron</w> during the winter offensive.",
                            "target_lang_translations": {
                                "ru": "Тысячи военнослужащих попали в южный <w>котёл</w> во время зимнего наступления."
                            }
                        }
                    ],
                    "synonyms": [
                        "encirclement",
                        "pocket"
                    ],
                    "common_phrases": [
                        "southern cauldron",
                        "military cauldron"
                    ],
                    "target_lang_definitions": {
                        "ru": "Стратегическое окружение военных сил противником."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "котёл",
                                "target_lang_sense_clarification": "военный жаргон, полное окружение"
                            },
                            {
                                "target_lang_word": "окружение",
                                "target_lang_sense_clarification": "военная блокада сил противника"
                            }
                        ]
                    }
                }
            ]
        }
    ]
