            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "af204e1b-56fc-354d-a1e5-077ee1d51b07",
                    "sense_definition": "Essential or decisive for determining the outcome or future of something; extremely important; vital.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Regular exercise plays a <w>crucial</w> role in maintaining good physical health.",
                            "target_lang_translations": {
                                "ru": "Регулярные физические упражнения играют <w>реша́ющую</w> роль в поддержании хорошего здоровья.",
                                "tr": "Düzenli egzersiz, iyi bir fiziksel sağlığı korumada <w>hayati</w> bir rol oynar."
                            }
                        },
                        {
                            "text": "It is <w>crucial</w> that we receive the signed documents by tomorrow morning.",
                            "target_lang_translations": {
                                "ru": "<w>Крайне ва́жно</w>, чтобы мы получили подписанные документы завтра к утру.",
                                "tr": "İmzalı belgeleri yarın sabaha kadar almamız <w>kritik önem taşıyor</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "critical",
                        "essential",
                        "vital",
                        "pivotal",
                        "key",
                        "decisive",
                        "paramount"
                    ],
                    "antonyms": [
                        "noncrucial"
                    ],
                    "common_phrases": [
                        "crucial role",
                        "crucial factor",
                        "crucial moment",
                        "crucial step",
                        "crucial part"
                    ],
                    "target_lang_definitions": {
                        "ru": "Существенный или имеющий решающее значение для исхода чего-либо; чрезвычайно важный.",
                        "tr": "Bir şeyin sonucunu veya geleceğini belirlemede son derece önemli, hayati veya belirleyici olan."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "реша́ющий",
                                "target_lang_sense_clarification": "определяющий исход"
