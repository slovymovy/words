                "senses": [
                    {
                        "sense_id": "db719ff8-7fdf-34a6-9af1-3f7fc183413f",
                        "entry_id": "86cde8b9-ede4-39ef-b982-9c64404944b9",
                        "glosses": [
                            "het kale casco van een schip zonder tuig, machines, opbouw of inrichting; de buitenste laag van een schip"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c018b13f-fb8d-446a-ba40-9b6c2e3487bb",
                                "sense_id": "db719ff8-7fdf-34a6-9af1-3f7fc183413f",
                                "text": "Ik overgoot haar lichaam en de scheepsromp met benzine."
                            },
                            {
                                "example_id": "c3e6fe2d-6db4-44b5-99eb-5cfbbdc5dbb7",
                                "sense_id": "db719ff8-7fdf-34a6-9af1-3f7fc183413f",
                                "text": "Er zijn inmiddels enorme drijvende kranen aangekomen op de rampplek, maar de Zuid-Koreaanse overheid wil die nog niet inzetten. Het gebruik van het grote materiaal zou namelijk fataal kunnen zijn voor overlevenden in de scheepsromp. Omdat men nog niet wil uitsluiten dat iemand het heeft overleefd, wordt daarom gewacht."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f015a5a9-45b3-4a51-bf2d-9a461c2fb63a",
                        "source_entry_id": "86cde8b9-ede4-39ef-b982-9c64404944b9",
                        "source_sense_id": "db719ff8-7fdf-34a6-9af1-3f7fc183413f",
                        "source_sense_description": "de kale romp van een schip zonder tuig, machines en andere opbouw",
