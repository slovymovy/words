                        "glosses": [
                            "S’occuper d’antiquités."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7822211-9c4f-41c6-af7a-9f4747ad75f4",
                                "sense_id": "18bb1129-0517-3cc6-a6e6-668d31317352",
                                "text": "Admettons qu’à cette époque il n’y ait de Paris que des ruines, et que des savans se mettent à antiquailler sur ces vénérables débris."
                            },
                            {
                                "example_id": "b28dd52a-0915-400c-aca5-ce23310c8d5e",
                                "sense_id": "18bb1129-0517-3cc6-a6e6-668d31317352",
                                "text": "Ils chantent, ou bien ils antiquaillent, c'est leur seule passion."
                            }
                        ]
                    }
