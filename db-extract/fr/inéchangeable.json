                        "sense_id": "421c6017-3b37-3dab-9e3e-e65b05623ced",
                        "entry_id": "85d7aa2e-103f-3316-810d-6a4a82a4c4f1",
                        "glosses": [
                            "Qu’on ne peut pas échanger."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "808b6d58-2d5e-4f29-ae32-05a99df9425b",
                                "sense_id": "421c6017-3b37-3dab-9e3e-e65b05623ced",
                                "text": "A la paix, en 1815, les banques furent hors d’état de reprendre les paiements en espèces. Le régime du papier-monnaie inéchangeable continua."
                            },
                            {
                                "example_id": "def10a64-2896-45ea-ad15-a63bfa7563ff",
                                "sense_id": "421c6017-3b37-3dab-9e3e-e65b05623ced",
                                "text": "Il est en tout homme un fond inéchangeable."
                            },
                            {
                                "example_id": "6527870c-ec2c-4ea5-86cf-2b73c3784d9b",
                                "sense_id": "421c6017-3b37-3dab-9e3e-e65b05623ced",
                                "text": "Décréter que le corps humain est inaliénable, inexpropriable, inéchangeable, malgré le mercantilisme du capitalisme contemporain qui a tendance à réifier le corps, ses organes et ses produits et à les transformer en pures marchandises, c’est affirmer du même coup que le corps est une singularité absolue, un corps qui est un Je, et non un troupeau de muscles, un amas de protéines ou un tas de viande."
                            }
                        ]
                    }
