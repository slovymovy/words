                        "glosses": [
                            "Habitant ou personne originaire des îles d’Aaland (État libre associé d’Åland), en Finlande."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ec54064-e7fb-46cf-bb73-5e77f98f80d1",
                                "sense_id": "2750391c-0c9d-39cf-8859-5b0e077ff880",
                                "text": "Les 28,000 Aalandais vivent donc tout comme les habitants d’une province suédoise."
