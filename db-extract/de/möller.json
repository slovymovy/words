                ],
                "senses": [
                    {
                        "sense_id": "091dccad-8421-3145-b18d-465b7e4df070",
                        "entry_id": "ede98e3f-d149-3fa0-aed5-5a54da814060",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0956829b-3b45-46e3-9d6d-a664b18a0aab",
                                "sense_id": "091dccad-8421-3145-b18d-465b7e4df070",
                                "text": "Frau Möller ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "09e5eeda-f242-48e8-8a40-222dab497f10",
                                "sense_id": "091dccad-8421-3145-b18d-465b7e4df070",
                                "text": "Herr Möller wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "95c450b3-f1f1-48ec-8b5b-7b4a0eeaf036",
                                "sense_id": "091dccad-8421-3145-b18d-465b7e4df070",
                                "text": "Die Möllers fahren heute ins Allgäu."
                            },
                            {
                                "example_id": "724cbfab-50aa-463e-9cb6-2021c3c15ba3",
                                "sense_id": "091dccad-8421-3145-b18d-465b7e4df070",
                                "text": "Der Möller trägt nie die Schals, die die Möller ihm strickt."
                            },
                            {
                                "example_id": "a770aeed-ecbf-4cc8-a6c6-c0b50209f04f",
                                "sense_id": "091dccad-8421-3145-b18d-465b7e4df070",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Möller kommt, geht der Herr Möller.“"
                            },
                            {
                                "example_id": "9c297dba-799a-49c0-95c0-f48095cf2b34",
                                "sense_id": "091dccad-8421-3145-b18d-465b7e4df070",
                                "text": "Möller kommt und geht."
                            },
                            {
                                "example_id": "5f88aa29-7982-4387-aed1-478a5d8d9a80",
                                "sense_id": "091dccad-8421-3145-b18d-465b7e4df070",
                                "text": "Möllers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
