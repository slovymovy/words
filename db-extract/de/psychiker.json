                "senses": [
                    {
                        "sense_id": "3af7f9ff-6f10-33e1-bdb2-c0a85d7ed80c",
                        "entry_id": "edd20786-a04b-3717-8318-e0ff68f93387",
                        "glosses": [
                            "gemäß der Lehre der Gnosis ein Angehöriger der mittleren Menschenklasse, der zwar zu Glauben und sittlicher Einsicht, aber nicht zur Erkenntnis Gottes fähig ist"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "f311a6ca-11d3-4faa-9641-0b6f288f8728",
                                "sense_id": "3af7f9ff-6f10-33e1-bdb2-c0a85d7ed80c",
                                "text": "„Sie nimmt an, dass Herakleon einen Erkenntnisprozess beschrieben hat, in dem der Gnostiker die verschiedenen Stufen vom Hyliker über den Psychiker bis zum Pneumatiker durchlaufe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4f6d0486-4aac-3b96-91cd-7524f5fbaabc",
                        "entry_id": "edd20786-a04b-3717-8318-e0ff68f93387",
                        "glosses": [
                            "Arzt mit dem Fachgebiet Psychiatrie, der bei psychischen Erkrankungen eine Störung der Seele/Psyche als ursächlich ansieht"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "ddc2209f-81d8-4aab-8677-6dd4ade5345d",
                                "sense_id": "4f6d0486-4aac-3b96-91cd-7524f5fbaabc",
                                "text": "„Psychische Grundfunktionen wurden von Psychikern wie Somatikern im Organismus lokalisiert, wobei die «niederen» triebhaften psychischen Vermögen insbesondere den Bauchorganen zugeordnet wurden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
