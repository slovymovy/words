                "senses": [
                    {
                        "sense_id": "f0a24dd1-8efc-371f-a7fb-76345f05657d",
                        "entry_id": "1e73ab56-fc88-369c-9824-0ec30f9ac406",
                        "glosses": [
                            "Féminin singulier de marinier."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "a2d223ae-36f3-4238-9fd4-9a17fc962a1c",
                                "sense_id": "f0a24dd1-8efc-371f-a7fb-76345f05657d",
                                "text": "Mais Fauchet rapporte des vers de Guyot de Provins qui vivoit en France vers l’an 1200, lequel en fait mention sous le nom de la marinette, ou pierre marinière : ce qui fait voir qu’on la connoissoit en France avant le Vénitien & le Melphitain."
                            },
                            {
                                "example_id": "21513c35-5a19-407e-88a3-66091e9cd657",
                                "sense_id": "f0a24dd1-8efc-371f-a7fb-76345f05657d",
                                "text": "Connaissance nécessaires, langage nautique, manœuvre, qualités du canot et du canotier, voilà ce qui nous occupera spécialement, et nous répandrons à pleines mains les trésors de notre érudition marinière."
                            }
                        ]
                    }
                ],
