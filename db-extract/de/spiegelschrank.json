                                "example_id": "6fbaea0b-c515-45f0-969f-875f214262d1",
                                "sense_id": "d0fc7384-b0b2-331e-8ab4-30176cb7b112",
                                "text": "„Während ich vor dem Spiegelschrank stand, trug meine nicht ganz unbegründete Ablehnung über die nicht ganz uneigennützige Zustimmung den Sieg davon.“"
                            }
