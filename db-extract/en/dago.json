                        "sense_id": "76e2b1cb-4657-3a8d-912b-85fc49735026",
                        "entry_id": "5385a2ea-187d-3e4b-ad2c-e9049cf28d54",
                        "glosses": [
                            "A person of Italian, Spanish, Portuguese, Greek, or other Mediterranean or Latin descent."
                        ],
                        "tags": [
                            "Ireland",
                            "UK",
                            "ethnic",
                            "offensive",
                            "slang",
                            "slur"
                        ],
                        "examples": [
                            {
                                "example_id": "1c48e8ef-f4cf-4f8c-9cad-ea6dd8fe7fb5",
                                "sense_id": "76e2b1cb-4657-3a8d-912b-85fc49735026",
                                "text": "And all foreigners to him were \"dem bloody dagoes\"—for, according to his theory, foreigners were responsible for unemployment."
                            }
                        ]
                    },
                    {
                        "sense_id": "8deea238-9be8-3c4e-ac55-f6b3e6b4bb99",
                        "entry_id": "5385a2ea-187d-3e4b-ad2c-e9049cf28d54",
                        "glosses": [
                            "A person of Italian descent."
                        ],
                        "tags": [
                            "Australia",
                            "New-Zealand",
                            "Philippines",
                            "US",
                            "ethnic",
                            "offensive",
                            "slang",
                            "slur"
                        ],
                        "examples": [
                            {
                                "example_id": "f34cbc00-9bdf-4fcc-ae91-feda9ea44fc6",
                                "sense_id": "8deea238-9be8-3c4e-ac55-f6b3e6b4bb99",
                                "text": "Sort of dago fellow; leads the orchestra down at the Winter Gardens ... You know the sort, all lah-di-dah and snakeskin shoes."
                            },
                            {
                                "example_id": "6d8bb98b-a662-470e-a357-d4021947fe31",
                                "sense_id": "8deea238-9be8-3c4e-ac55-f6b3e6b4bb99",
                                "text": "\"Matilda's making us omelettes, that all right, Miss Tomson.\"\n\"Are they going to reek.\"\n\"Dear me, I hope not. I instructed her to leave out particularly strong ingredients.\"\n\"Just so I don't leave here smelling like a dago.\""
                            }
                        ]
                    }
