                                        "examples": [
                                            {
                                                "example_id": "0b967ed3-e153-45f8-af17-336b95ab07c3",
                                                "sense_id": "df980230-11aa-3b98-8b69-85a3cbb06e68",
                                                "text": "„Die Parallelen zum Deutschen in bezug auf die allophonischen Realisierungen von Kurz- und Langvokalen (in Haupttonsilben) liegen auf der Hand: Die Langvokale sind immer gespannt, während die Kurzvokale meist ungespannt oder zentralisiert sind.“"
                                            },
                                            {
                                                "example_id": "8115298d-df45-4355-81de-cbcb890efe56",
                                                "sense_id": "df980230-11aa-3b98-8b69-85a3cbb06e68",
                                                "text": "„Im Gegensatz zu der englischen Regel der l-Velarisierung ist die Auslautverhärtung keine allophonische Regel, weil die Outputsegmente in (17) Phoneme des Deutschen sind.“"
                                            },
                                            {
                                                "example_id": "4a68d17f-68d0-45b9-abeb-a15f0a3e3a26",
                                                "sense_id": "df980230-11aa-3b98-8b69-85a3cbb06e68",
                                                "text": "„Die allophonische Variation reflektiert den phonetischen Faktor und den Artikulationsfaktor.“"
                                            },
                                            {
                                                "example_id": "b93ca5e6-dafc-4b15-81bb-70cb9a937314",
                                                "sense_id": "df980230-11aa-3b98-8b69-85a3cbb06e68",
                                                "text": "„Dass eine Sprache über allophonische Variation verfügt, ahnen im Durchschnittsfall auch Muttersprachler nicht.“"
                                            }
