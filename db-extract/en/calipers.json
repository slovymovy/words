                        "entry_id": "c3ef09a4-d260-3c49-a6b1-58ca2a54f5c2",
                        "glosses": [
                            "A device used to measure dimensions, especially for small or precise measurements."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "91177349-4b7f-4242-922b-7750d8b470b9",
                                "sense_id": "f629e90b-24ae-378f-8499-5c3de247e4dc",
                                "text": "\"Good, good for there,\" he mumbled, and then with a certain eagerness asked me whether I would let him measure my head. Rather surprised, I said Yes, when he produced a thing like calipers and got the dimensions back and front and every way, taking notes carefully."
                            }
                        ]
                    },
                    {
                        "sense_id": "7ccc88e1-7fcc-3045-8300-acfd35c64a7b",
                        "entry_id": "c3ef09a4-d260-3c49-a6b1-58ca2a54f5c2",
                        "glosses": [
                            "A metal (orthopedic) leg support."
                        ],
                        "tags": [
                            "UK",
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "ed92fc42-6c30-4499-83d4-b790cbc1a74e",
                                "sense_id": "7ccc88e1-7fcc-3045-8300-acfd35c64a7b",
                                "text": "And simultaneously I raise my trouser cuff to reveal the leather straps and wicked steel calipers harnessing my right boot."
                            }
                        ]
                    }
                ],
