            "senses": [
                {
                    "sense_id": "959f70b1-1260-3570-b67b-f6f5d0b2ec18",
                    "sense_definition": "de toestand van een romantische relatie hebben of met iemand uitgaan",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "romantische relatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij heeft al drie maanden <w>verkering</w> met onze overbuur.",
                            "target_lang_translations": {
                                "en": "She has been <w>dating</w> our neighbor across the street for three months already."
                            }
                        },
                        {
                            "text": "Mijn zoon is dertien en heeft voor het eerst vaste <w>verkering</w>.",
                            "target_lang_translations": {
                                "en": "My son is thirteen and has a steady <w>relationship</w> for the first time."
                            }
                        }
                    ],
                    "synonyms": [
                        "relatie"
                    ],
                    "common_phrases": [
                        "vaste verkering",
                        "verkering hebben",
                        "verkering vragen",
                        "verkering uitmaken"
                    ],
                    "target_lang_definitions": {
                        "en": "the state of having a romantic relationship or dating someone"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "relationship",
                                "target_lang_sense_clarification": "romantic connection"
                            },
                            {
                                "target_lang_word": "dating",
                                "target_lang_sense_clarification": "the act of seeing someone romantically"
                            },
                            {
                                "target_lang_word": "going steady",
                                "target_lang_sense_clarification": "having a committed relationship"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "00791f19-d198-3701-91d8-a028ac1d552f",
                    "sense_definition": "een periode van regelmatige omgang met iemand, meestal met het oog op een liefdesrelatie",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "romantische relatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij verbrak na enige tijd de <w>verkering</w> omdat het niet meer werkte.",
                            "target_lang_translations": {
                                "en": "After some time she broke off the <w>relationship</w> because it wasn't working anymore."
                            }
                        },
                        {
                            "text": "Na een korte <w>verkering</w> besloten ze om te gaan samenwonen.",
                            "target_lang_translations": {
                                "en": "After a short <w>courtship</w> they decided to move in together."
                            }
                        }
                    ],
                    "synonyms": [
                        "relatie"
                    ],
                    "common_phrases": [
                        "de verkering verbreken"
                    ],
                    "target_lang_definitions": {
                        "en": "a period of regular interaction with someone, usually with a view to a love relationship"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "courtship",
                                "target_lang_sense_clarification": "period of dating before marriage or commitment"
                            },
                            {
                                "target_lang_word": "romance",
                                "target_lang_sense_clarification": "a love affair or relationship"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "29f1fe1c-4ad2-3bca-8f31-167ff9a5dabb",
                    "sense_definition": "het sociaal contact of de omgang tussen mensen in het algemeen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sociaal contact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In die afgelegen regio is er weinig <w>verkering</w> tussen de verschillende dorpen.",
                            "target_lang_translations": {
                                "en": "In that remote region there is little <w>interaction</w> between the different villages."
                            }
                        },
                        {
                            "text": "De dagelijkse <w>verkering</w> met collega's is belangrijk voor de werksfeer.",
                            "target_lang_translations": {
