                        "sense_id": "7f149000-2dc8-33d2-b769-89a79e807475",
                        "entry_id": "45c07163-5aa0-37f5-9f00-59592d5149f9",
                        "glosses": [
                            "действ. прич. наст. вр. от генерировать"
