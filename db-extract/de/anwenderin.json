                    {
                        "sense_id": "12296aed-bf39-3b69-a65f-b9ac4892c023",
                        "entry_id": "897b190d-f40f-37c5-a9bf-8d3bcf4ed7f6",
                        "glosses": [
                            "female equivalent of Anwender (“user”)"
                        ],
