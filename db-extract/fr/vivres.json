        "pl-extract.jsonl": [],
        "fr-extract.jsonl": [
            {
                "entry_id": "23e0e9bb-3427-352c-a9ed-d28f4b02ad59",
                "word": "vivres",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d3fa272c-fce9-30fe-8cc4-8d2e0335cdf1",
                        "entry_id": "23e0e9bb-3427-352c-a9ed-d28f4b02ad59",
                        "glosses": [
                            "Denrées destinées à l’approvisionnement alimentaire."
                        ],
                        "tags": [
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "1d6b1886-bd62-40dc-a915-acfac99406cb",
                                "sense_id": "d3fa272c-fce9-30fe-8cc4-8d2e0335cdf1",
                                "text": "Quant aux provisions, c’était autre chose. Les vivres devaient être abondants et facilement transportables."
                            },
                            {
                                "example_id": "5c9b5d87-e79c-40d8-a708-1d57d3a491da",
                                "sense_id": "d3fa272c-fce9-30fe-8cc4-8d2e0335cdf1",
                                "text": "La première partie du chemin se fit à la raquette, et les bagages, les vivres et les munitions furent portés à force de bras sur des traîneaux sauvages appelés tabaganes."
                            }
                        ]
                    },
                    {
                        "sense_id": "643489ba-bd01-3b1e-a16a-d823a2a6b10d",
                        "entry_id": "23e0e9bb-3427-352c-a9ed-d28f4b02ad59",
                        "glosses": [
                            "Légumes."
                        ],
                        "tags": [
                            "Guadeloupe"
                        ],
                        "examples": [
                            {
                                "example_id": "e63f8737-3487-4e3f-b57c-b5f091244374",
                                "sense_id": "643489ba-bd01-3b1e-a16a-d823a2a6b10d",
                                "text": "L’interpellé, occupé à arroser ses vivres dans la fraîcheur du matin, se retourna d’un bond, éparpillant de l’eau en tous sens."
                            },
                            {
                                "example_id": "236b73f8-e173-4bd1-bfef-6d414ebc4c2f",
                                "sense_id": "643489ba-bd01-3b1e-a16a-d823a2a6b10d",
                                "text": "Elle est ainsi prénommée parce qu’elle est née sur le chemin un jour où sa maman allait vendre des vivres au bourg."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4cba89f1-b4d1-4ab8-9342-6c560983083a",
                        "source_entry_id": "23e0e9bb-3427-352c-a9ed-d28f4b02ad59",
                        "target_lang_word": "Proviant",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Proviant",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "017f10f6-9a2d-3466-a9c1-78d5379a1ef6",
                                        "entry_id": "b33eb035-52ce-31b6-ad3f-3560075161c5",
                                        "glosses": [
                                            "mitgeführter Nahrungsvorrat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5b0cb34-7603-4e4b-984c-48fd97527487",
                                                "sense_id": "017f10f6-9a2d-3466-a9c1-78d5379a1ef6",
                                                "text": "„Wir verheimlichten so gut wie möglich, daß wir Gold und Perlen hatten, und verkauften deshalb drei, vier Ballen Chinaseide und indischen Kaliko, um das nötige Geld zu haben, Kamele zu erwerben, den Zoll zu bezahlen, der an mehreren Stellen erhoben wurde, und uns für die Wüste mit Proviant auszurüsten.“"
                                            },
                                            {
                                                "example_id": "724cd24c-ab9e-456c-ba38-578c84736088",
                                                "sense_id": "017f10f6-9a2d-3466-a9c1-78d5379a1ef6",
                                                "text": "„Wir hielten irgendwo auf dem Feld an, packten unseren Proviant aus und ließen den kleinen Banditen nach Belieben sich den Bauch vollschlagen.“"
                                            },
                                            {
                                                "example_id": "aad2b2fd-1bc7-49fe-8fbe-2f18375f87e4",
                                                "sense_id": "017f10f6-9a2d-3466-a9c1-78d5379a1ef6",
                                                "text": "„Proviant für zwei Monate lagert unter Deck, neben 174 Kanonen und 82000 Kanonenkugeln.“"
                                            },
                                            {
                                                "example_id": "3d591bec-bfd1-495b-8925-5bfe41a7090f",
                                                "sense_id": "017f10f6-9a2d-3466-a9c1-78d5379a1ef6",
                                                "text": "„Diese Gesellschaft betrieb nicht nur den Kanal, sondern auch die Geschäfte, in denen Proviant zum Selbstkostenpreis gekauft werden konnte.“"
                                            },
                                            {
                                                "example_id": "2f786441-b650-4c12-a1bd-6fa464921123",
                                                "sense_id": "017f10f6-9a2d-3466-a9c1-78d5379a1ef6",
                                                "text": "„Eigentlich war Reinhold Messner allein zur finalen Etappe in die Todeszone aufgebrochen, ohne Seil, ohne Zelt, ohne Proviant; er wollte zum Gipfel und so schnell wie möglich wieder zurück.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d9cc4a70-0800-44e2-8687-2252f07de0f7",
                        "source_entry_id": "23e0e9bb-3427-352c-a9ed-d28f4b02ad59",
                        "target_lang_word": "food",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "food",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cc75b8af-bf66-3dd4-8b4b-8dd15d4a113a",
                                        "entry_id": "e0677819-09e1-3ac3-b474-e4d9aa229b6d",
                                        "glosses": [
                                            "Any solid substance that can be consumed by living organisms, especially by eating, in order to sustain life."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef655cf3-1116-4db5-b114-507d42fc961b",
                                                "sense_id": "cc75b8af-bf66-3dd4-8b4b-8dd15d4a113a",
                                                "text": "The innkeeper brought them food and drink."
                                            },
                                            {
                                                "example_id": "13c7a064-a5ac-4f1c-9221-69cdb9161e91",
                                                "sense_id": "cc75b8af-bf66-3dd4-8b4b-8dd15d4a113a",
                                                "text": "“[…] the awfully hearty sort of Christmas cards that people do send to other people that they don't know at all well. You know. The kind that have mottoes like\n Here's rattling good luck and roaring good cheer, / With lashings of food and great hogsheads of beer. […]”"
                                            },
                                            {
                                                "example_id": "3d80f2e1-d401-44ee-af9b-4869ed486d51",
                                                "sense_id": "cc75b8af-bf66-3dd4-8b4b-8dd15d4a113a",
                                                "text": "Mostly, the microbiome is beneficial. It helps with digestion and enables people to extract a lot more calories from their food than would otherwise be possible. Research over the past few years, however, has implicated it in diseases from atherosclerosis to asthma to autism."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b9bc5f8-04ab-3aa4-b8b4-e05f1167ce8a",
                                        "entry_id": "e0677819-09e1-3ac3-b474-e4d9aa229b6d",
                                        "glosses": [
                                            "A foodstuff."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5fb4d650-85aa-4698-8da7-92df267c4f98",
                                                "sense_id": "3b9bc5f8-04ab-3aa4-b8b4-e05f1167ce8a",
                                                "text": "Variation and changes in the trans fatty acid content of different foods, especially in processed foods, further complicate such estimates."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dcd181ed-d32f-3f43-8556-35e10bdbea09",
                                        "entry_id": "e0677819-09e1-3ac3-b474-e4d9aa229b6d",
                                        "glosses": [
                                            "Anything that nourishes or sustains."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b441b842-4612-4184-ac8b-4fc7d147e3e5",
                                                "sense_id": "dcd181ed-d32f-3f43-8556-35e10bdbea09",
                                                "text": "The man's inspiring speech gave us food for thought."
                                            },
                                            {
                                                "example_id": "d4347a0e-d88d-4d9e-bf78-cfe5006387ec",
                                                "sense_id": "dcd181ed-d32f-3f43-8556-35e10bdbea09",
                                                "text": "Mozart and Bach are food for my soul."
                                            },
                                            {
                                                "example_id": "83ced542-162c-4ff6-9b35-541fee7b7680",
                                                "sense_id": "dcd181ed-d32f-3f43-8556-35e10bdbea09",
                                                "text": "This may prove food to my displeasure."
                                            },
                                            {
                                                "example_id": "f64bbf35-32f2-4d06-ab42-fa6203e764fa",
                                                "sense_id": "dcd181ed-d32f-3f43-8556-35e10bdbea09",
                                                "text": "In this moment there is life and food / For future years."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83921e52-1c60-3d73-9fe3-7528ffb0671d",
                                        "entry_id": "e0677819-09e1-3ac3-b474-e4d9aa229b6d",
                                        "glosses": [
                                            "Any illegal substance or illegal substances, drugs."
                                        ],
                                        "tags": [
                                            "Multicultural-London-English",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0eff3281-7f59-47cc-a05a-66dc42d1d985",
                                                "sense_id": "83921e52-1c60-3d73-9fe3-7528ffb0671d",
                                                "text": "What kind of things that you have. When I find out don't expect me to stop. I'll come for the P's that you stack. And come for the food that you blot."
                                            },
                                            {
                                                "example_id": "7b1d866e-707b-4213-b29c-09894e4d68c3",
                                                "sense_id": "83921e52-1c60-3d73-9fe3-7528ffb0671d",
                                                "text": "I'm so London, I'm so south / Food in the ends like there ain't no drought / Flipz don't talk like he's got no mouth"
                                            },
                                            {
                                                "example_id": "b6184209-9f63-4070-8d71-48017f139888",
                                                "sense_id": "83921e52-1c60-3d73-9fe3-7528ffb0671d",
                                                "text": "[Verse 2:Kano]:If you've been shotting in the manor from way back when and you ain't on a kilo ting, I don't wanna hear about cunch and food and tings, man don't do those tings."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
