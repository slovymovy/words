                            "participle",
                            "past"
                        ],
                        "form": "мири́вши"
                    },
                    {
                        "form_id": "4a481178-0799-4808-bd8e-46d3a9bf0386",
                        "entry_id": "4092e3dd-f009-347d-a5fb-56364bcb8e52",
