                        "glosses": [
                            "Cri émis par certains oiseaux (chouettes…)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78a21c4e-c229-4df0-b245-add97f1b771d",
                                "sense_id": "7fb5b7a6-7f22-382e-a272-e20ad6ab3332",
                                "text": "Tous les soirs, nous entendions des hou-hou plaintifs qui semblaient venir de notre toit, et souvent aussi nous entrevoyions des ombres qui passaient et repassaient rapides, silencieuses, devant les vitres de notre petite fenêtre."
                            },
                            {
                                "example_id": "3d793191-ecf5-443b-9ad5-b610c96fcd77",
                                "sense_id": "7fb5b7a6-7f22-382e-a272-e20ad6ab3332",
                                "text": "Même ma chouette, qui se taisait de peur de faire fuir ses proies, ne pouvait s'empêcher de pousser de petits hou-hou pour déclarer sa joie de vivre ou rappeler son appartenance à la grande famille des rapaces."
                            }
                        ]
                    }
