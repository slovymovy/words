                                        "entry_id": "f48dfd00-84c4-3767-809d-07695bceca5a",
                                        "glosses": [
                                            "In a proper manner, appropriately, suitably; correctly, justifiably"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95abe135-9f29-4948-a1be-bd8176d7eb46",
                                                "sense_id": "a05a3702-62e4-3c16-8391-b1c92326468a",
                                                "text": "Does she think the repairs have been properly done?"
                                            },
                                            {
                                                "example_id": "c68e092f-cace-4091-82cc-abe43a24bcd7",
                                                "sense_id": "a05a3702-62e4-3c16-8391-b1c92326468a",
                                                "text": "I know that I am spoiling your life that without me you could work. And you will I know. You see I cant[sic] even write this properly."
                                            },
                                            {
                                                "example_id": "b5b6eca5-dddc-4fe8-a7cc-a5a22e8daee7",
                                                "sense_id": "a05a3702-62e4-3c16-8391-b1c92326468a",
                                                "text": "Hospitals are failing to care properly for the growing number of people with dementia, according to an NHS-funded report, which has prompted demands for big improvements to help patients."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f13bcaa-a273-387d-b971-e6f55dba4f99",
                                        "entry_id": "f48dfd00-84c4-3767-809d-07695bceca5a",
                                        "glosses": [
                                            "individually; in one's own manner."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "58ec283c-36f9-3214-a6da-be62626b5b77",
                                        "entry_id": "f48dfd00-84c4-3767-809d-07695bceca5a",
                                        "glosses": [
                                            "Entirely; extremely; thoroughly."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e158e6e6-d158-4e36-970c-cefbae211fcf",
                                                "sense_id": "58ec283c-36f9-3214-a6da-be62626b5b77",
                                                "text": "I was properly tired after that party."
                                            }
                                        ]
                                    }
