                "senses": [
                    {
                        "sense_id": "c2e06579-42f8-3db3-9572-383a374ab580",
                        "entry_id": "3e2f68d7-1c15-3767-bdcf-2a375c9f92dd",
                        "glosses": [
                            "mittelalterliches Hafenhandbuch mit Karten der Küstenlinie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "214343f1-a3a4-45b2-adba-5f358c8f449a",
                                "sense_id": "c2e06579-42f8-3db3-9572-383a374ab580",
                                "text": "„Zur Zeit der Renaissance machte es eine ganze Reihe von nautischen und astronomischen Erfindungen (hochseetaugliche Schiffe wie die Karavelle und Karacke, Portolankarten, Astrolabium und Kompass) den Europäern technisch möglich, in ihnen fremde Gewässer und Gebiete vorzudringen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f9189357-a47d-43bd-bdcb-1d87437d2843",
