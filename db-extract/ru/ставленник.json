                "senses": [
                    {
                        "sense_id": "c12121f3-9b94-311b-a500-5461f52ee739",
                        "entry_id": "5a00affe-35ae-3ad9-bfd1-9b17f215825d",
                        "glosses": [
                            "; тот, кто получил должность, место с помощью кого-либо, по протекции кого-либо"
                        ],
                        "tags": [
