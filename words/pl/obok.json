{
    "word_family": [],
    "entries": [
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "191d5abd-82c3-36f0-9044-6201dca82a6c",
                    "sense_definition": "wskazuje na położenie w niedużej odległości od kogoś lub czegoś",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "bliskość przestrzenna",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mój najlepszy przyjaciel usiadł w klasie tuż <w>obok</w> mnie.",
                            "target_lang_translations": {
                                "ru": "Мой лучший друг сел в классе прямо <w>рядом со</w> мной."
                            }
                        },
                        {
                            "text": "Codziennie rano przechodzę <w>obok</w> starej piekarni, idąc na przystanek autobusowy.",
                            "target_lang_translations": {
                                "ru": "Каждое утро я прохожу <w>мимо</w> старой пекарни, идя на автобусную остановку."
                            }
                        }
                    ],
                    "synonyms": [
                        "blisko",
                        "koło",
                        "przy"
                    ],
                    "antonyms": [
                        "daleko"
                    ],
                    "common_phrases": [
                        "obok siebie",
                        "tuż obok",
                        "przechodzić obok"
                    ],
                    "target_lang_definitions": {
                        "ru": "указывает на нахождение на небольшом расстоянии от кого-либо или чего-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "около",
                                "target_lang_sense_clarification": "вблизи кого-либо или чего-либо"
                            },
                            {
                                "target_lang_word": "возле",
                                "target_lang_sense_clarification": "в непосредственной близости"
                            },
                            {
                                "target_lang_word": "рядом с",
                                "target_lang_sense_clarification": "по соседству, бок о бок"
                            },
                            {
                                "target_lang_word": "мимо",
                                "target_lang_sense_clarification": "при движении мимо чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cb81821d-39e0-3d75-b128-5d39483da975",
                    "sense_definition": "wskazuje na współwystępowanie lub istnienie czegoś dodatkowo; poza czymś",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "dodatkowość",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Obok</w> języka angielskiego uczy się także hiszpańskiego i francuskiego.",
                            "target_lang_translations": {
                                "ru": "<w>Наряду с</w> английским языком он также изучает испанский и французский."
                            }
                        },
                        {
                            "text": "To zjawisko występuje często <w>obok</w> innych typowych objawów tej choroby.",
                            "target_lang_translations": {
                                "ru": "Это явление часто наблюдается <w>наряду с</w> другими типичными симптомами этой болезни."
                            }
                        }
                    ],
                    "synonyms": [
                        "oprócz",
                        "poza",
                        "prócz"
                    ],
                    "common_phrases": [
                        "obok tego"
                    ],
                    "target_lang_definitions": {
                        "ru": "указывает на совместное присутствие, сопутствие или наличие чего-либо в дополнение; кроме"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наряду с",
                                "target_lang_sense_clarification": "вместе с чем-либо, в дополнение"
                            },
                            {
                                "target_lang_word": "помимо",
                                "target_lang_sense_clarification": "кроме чего-либо"
                            },
                            {
                                "target_lang_word": "кроме",
                                "target_lang_sense_clarification": "в добавление к чему-либо"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "7445c252-1f67-38a9-9cb0-799cbecd9807",
                    "sense_definition": "w małej odległości, w pobliżu wskazanego miejsca",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "bliskość przestrzenna",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Postaw ten duży wazon na półce, a budzik połóż <w>obok</w>.",
                            "target_lang_translations": {
                                "ru": "Поставь эту большую вазу на полку, а будильник положи <w>рядом</w>."
                            }
                        },
                        {
                            "text": "Czekałam na korytarzu, a mój brat stał cicho tuż <w>obok</w>.",
                            "target_lang_translations": {
                                "ru": "Я ждала в коридоре, а мой брат тихо стоял прямо <w>рядом</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "blisko",
                        "w pobliżu"
                    ],
                    "antonyms": [
                        "daleko"
                    ],
                    "common_phrases": [
                        "stać obok",
                        "tuż obok"
                    ],
                    "target_lang_definitions": {
                        "ru": "на небольшом расстоянии, поблизости от указанного места"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рядом",
                                "target_lang_sense_clarification": "поблизости, подле"
                            },
                            {
                                "target_lang_word": "поблизости",
                                "target_lang_sense_clarification": "недалеко отсюда"
                            },
                            {
                                "target_lang_word": "возле",
                                "target_lang_sense_clarification": "близко"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}