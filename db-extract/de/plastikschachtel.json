                "senses": [
                    {
                        "sense_id": "16fea161-4097-3d55-b3d3-e946cb44c744",
                        "entry_id": "2b845b75-9296-3404-8608-705d89cfbbb7",
                        "glosses": [
                            "Verpackung aus Plastik/Kunststoff, zumeist in Form eines Quaders"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e35f3db8-e6f1-4be3-ac41-807f31ee8dc5",
                                "sense_id": "16fea161-4097-3d55-b3d3-e946cb44c744",
                                "text": "„Auf dem Weg ins Büro ein Coffee to go – mittags geschnittene Ananas oder Salat aus der Plastikschachtel.“"
                            },
                            {
                                "example_id": "db9943b2-cdb9-4a37-9e84-5447786dbf53",
                                "sense_id": "16fea161-4097-3d55-b3d3-e946cb44c744",
                                "text": "„Er zog eine kleine orangefarbene Plastikschachtel aus der Hosentasche, klappte den Deckel auf, und im Inneren lagerte auf einem schwarzen, dünnen Schaumstoffkissen ein elektronischer Chip.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
