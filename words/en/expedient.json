                    "frequency": "VeryLow",
                    "semantic_group_id": "speed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The general ordered an <w>expedient</w> march to reach the town before the enemy could prepare."
                        },
                        {
                            "text": "They hoped for an <w>expedient</w> resolution to the conflict, but negotiations dragged on."
                        }
                    ],
                    "traits": [
