                        "source_entry_id": "93eaef36-f5fe-3d5b-92e1-d1c3f3ac124f",
                        "source_sense_id": "f97a7aff-2f4c-3247-97d5-e1c98ba3d008",
                        "target_lang_word": "garnish",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "garnish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "35cf4f05-2229-3bfa-ba39-287ca73ed93a",
                                        "entry_id": "be57cad6-44b4-3445-8a0e-597b3415dfe8",
                                        "glosses": [
                                            "To decorate with ornaments; to adorn; to embellish."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0507da1-dcd8-40ce-8840-e61b027c397e",
                                                "sense_id": "35cf4f05-2229-3bfa-ba39-287ca73ed93a",
                                                "text": "[…] the whip […] was garnished with a massive horse’s head of plated metal."
                                            },
                                            {
                                                "example_id": "bee96617-35aa-4f55-9854-00498838ab23",
                                                "sense_id": "35cf4f05-2229-3bfa-ba39-287ca73ed93a",
                                                "text": "And all within with flowres was garnished,"
                                            },
                                            {
                                                "example_id": "2eb3ea85-e391-4610-8efc-24c33163ca8e",
                                                "sense_id": "35cf4f05-2229-3bfa-ba39-287ca73ed93a",
                                                "text": "1710, Joseph Addison, The Tatler, No. 163, 25 April, 1710, Glasgow: Robert Urie, 1754, p. 165,\n[…] as that admirable writer has the best and worst verses of any among our English poets, Ned Softly has got all the bad ones without book, which he repeats upon occasion, to shew his reading, and garnish his conversation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f83afde0-0d83-3ba9-8a1b-2039091f0fc6",
                                        "entry_id": "be57cad6-44b4-3445-8a0e-597b3415dfe8",
                                        "glosses": [
                                            "To ornament with something placed around it."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87800a48-8004-408d-b0ac-7faefa15cfd7",
                                                "sense_id": "f83afde0-0d83-3ba9-8a1b-2039091f0fc6",
                                                "text": "a dish garnished with a sprig/spray of parsley"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "adde6cae-58ea-37cf-affd-aabd5a205bef",
                                        "entry_id": "be57cad6-44b4-3445-8a0e-597b3415dfe8",
                                        "glosses": [
                                            "To furnish; to supply."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e5f5d6b-dd09-4210-a89b-505bd8913fa0",
                                                "sense_id": "adde6cae-58ea-37cf-affd-aabd5a205bef",
                                                "text": "By his spirit he hath garnished the heavens; his hand hath formed the crooked serpent."
                                            },
                                            {
                                                "example_id": "c9962cc7-e9a3-40d0-a699-fb13af8d10da",
                                                "sense_id": "adde6cae-58ea-37cf-affd-aabd5a205bef",
                                                "text": "[…] the good-humoured, affectionate-hearted Godfrey Cass was fast becoming a bitter man, visited by cruel wishes, that seemed to enter, and depart, and enter again, like demons who had found in him a ready-garnished home."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5fe69905-0ce1-3784-a0b7-9a647493ac25",
                                        "entry_id": "be57cad6-44b4-3445-8a0e-597b3415dfe8",
                                        "glosses": [
                                            "To fit with fetters; to fetter."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a8783459-13c5-3447-bfee-a7b4518ca9c1",
                                        "entry_id": "be57cad6-44b4-3445-8a0e-597b3415dfe8",
                                        "glosses": [
                                            "To warn by garnishment; to give notice to."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bbcbc879-e047-386c-a774-90b1b40473aa",
                                        "entry_id": "be57cad6-44b4-3445-8a0e-597b3415dfe8",
                                        "glosses": [
                                            "To have (money) set aside by court order (particularly for the payment of alleged debts); to garnishee."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0e57437-50cf-44fb-a353-15f7d4e4b82f",
                                                "sense_id": "bbcbc879-e047-386c-a774-90b1b40473aa",
                                                "text": "When the editorial board of Fire met again, we did not plan a new issue, but emptied our pockets to help poor Thurman whose wages were being garnished weekly because he had signed for the printer’s bills."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "garnish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c2446ca3-c479-3762-9a1b-e09536d27ec1",
                                        "entry_id": "8c933b61-ce4c-3510-8725-769fdb6a2507",
                                        "glosses": [
                                            "A set of dishes, often pewter, containing a dozen pieces of several types."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7f483085-9385-3886-8bab-5e153ab9ddf7",
                                        "entry_id": "8c933b61-ce4c-3510-8725-769fdb6a2507",
                                        "glosses": [
                                            "Pewter vessels in general."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7809b1d-d4a7-412c-b442-617ffd92b540",
                                                "sense_id": "7f483085-9385-3886-8bab-5e153ab9ddf7",
                                                "text": "The accounts of collegiate and monastic institutions give abundant entries of the price of pewter vessels, called also garnish."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36e88854-0365-3114-bd9b-b169446fa5f9",
                                        "entry_id": "8c933b61-ce4c-3510-8725-769fdb6a2507",
                                        "glosses": [
                                            "Something added for embellishment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5a65451-3e6b-4a3c-9580-1227c9199293",
                                                "sense_id": "36e88854-0365-3114-bd9b-b169446fa5f9",
                                                "text": "1718, Matthew Prior, Alma: or, The Progress of the Mind, Canto 1, in Poems on Several Occasions, London: Jacob Tonson, p. 333,\nFirst Poets, all the World agrees,\nWrite half to profit, half to please\nMatter and figure They produce;\nFor Garnish This, and That for Use;"
                                            },
                                            {
                                                "example_id": "68a9f3dc-61b4-4dce-91c7-d8896ead1481",
                                                "sense_id": "36e88854-0365-3114-bd9b-b169446fa5f9",
                                                "text": "This hard-headed old Overreach approved of the sentimental song, as the suitable garnish for girls, and also as fundamentally fine, sentiment being the right thing for a song."
                                            },
                                            {
                                                "example_id": "944eab48-019c-4f54-a89d-c12a6911138b",
                                                "sense_id": "36e88854-0365-3114-bd9b-b169446fa5f9",
                                                "text": "There had been a semblance of chivalry in the attitude from which, at the beginning of their marriage, he had briefly regarded her; but forty-seven years had efficiently disposed of that garnish of politeness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91384282-a0ae-32df-a069-07e0be010e7f",
                                        "entry_id": "8c933b61-ce4c-3510-8725-769fdb6a2507",
                                        "glosses": [
                                            "Clothes; garments, especially when showy or decorative."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43499a39-0aa2-44bb-ac4d-e0f817c53af1",
                                                "sense_id": "91384282-a0ae-32df-a069-07e0be010e7f",
                                                "text": "So are you, sweet,\nEven in the lovely garnish of a boy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2244039-e618-36ff-9124-92444317e022",
                                        "entry_id": "8c933b61-ce4c-3510-8725-769fdb6a2507",
                                        "glosses": [
                                            "Something set round or upon a dish as an embellishment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bbe00c27-715d-3ea4-a5f9-93eaedee45ee",
                                        "entry_id": "8c933b61-ce4c-3510-8725-769fdb6a2507",
                                        "glosses": [
                                            "Fetters."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "189da3ba-6637-3e8a-809f-c623c70e4876",
                                        "entry_id": "8c933b61-ce4c-3510-8725-769fdb6a2507",
                                        "glosses": [
                                            "A fee; specifically, in English jails, formerly an unauthorized fee demanded from a newcomer by the older prisoners."
                                        ],
                                        "tags": [
                                            "historical",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "000cef46-e274-42e6-a16a-1705a0d0dc68",
                                                "sense_id": "189da3ba-6637-3e8a-809f-c623c70e4876",
                                                "text": "1699, B. E., A New Dictionary of the Canting Crew, London: W. Hawes et al.,\nGarnish money, what is customarily spent among the Prisoners at first coming in."
                                            },
                                            {
                                                "example_id": "651da8d6-d103-41e8-8532-cbe4cba8a852",
                                                "sense_id": "189da3ba-6637-3e8a-809f-c623c70e4876",
                                                "text": "This person then […] acquainted him that it was the custom of the place for every prisoner, upon his first arrival there, to give something to the former prisoners to make them drink. This, he said, was what they called garnish; and concluded with advising his new customer to draw his purse upon the present occasion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4681a03f-574b-3e25-9a2b-16d2d11e4d56",
                                        "entry_id": "8c933b61-ce4c-3510-8725-769fdb6a2507",
                                        "glosses": [
                                            "Cash."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
