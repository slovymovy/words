                "entry_id": "dbb62653-4b88-329d-ab93-4f153f29743a",
                "word": "menfolk",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c9c07257-42e3-381d-ba5e-a494f61bd325",
                        "entry_id": "dbb62653-4b88-329d-ab93-4f153f29743a",
                        "glosses": [
                            "Male people in general."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "d07cfb18-6b3a-4fb2-accf-deae433b6356",
                                "sense_id": "c9c07257-42e3-381d-ba5e-a494f61bd325",
                                "text": "The old woman was surprised when the soldiers stopped to look at her camouflage quilts, since menfolk are rarely interested in needlework."
                            }
                        ]
                    },
                    {
                        "sense_id": "44d62d4f-0d6e-3cd1-9bd4-062d1de75ca5",
                        "entry_id": "dbb62653-4b88-329d-ab93-4f153f29743a",
                        "glosses": [
                            "The male members of a group."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "3ef91abf-83b6-4357-a4ed-618953128cc7",
                                "sense_id": "44d62d4f-0d6e-3cd1-9bd4-062d1de75ca5",
                                "text": "At our family reunion, the menfolk generally have a ball game, while the womenfolk gossip and trade snapshots."
                            },
                            {
                                "example_id": "cecef80a-77e2-424b-b87a-cbaa1741e184",
                                "sense_id": "44d62d4f-0d6e-3cd1-9bd4-062d1de75ca5",
                                "text": "[…] when the pleasant time of night is come, and the stewardess is tucking up the ladies, and putting oranges and other goodies under their pillows, and the menfolk assemble in the capstan house to smoke their last cigar."
                            },
                            {
                                "example_id": "45af4103-fcab-4b00-8348-dd9645d75d3d",
                                "sense_id": "44d62d4f-0d6e-3cd1-9bd4-062d1de75ca5",
                                "text": "“I don't suppose a Russian convict under the knout is able to amuse the rest of his gang; and all our men-folk here are gilded convicts.”"
                            }
                        ]
                    }
                ],
                "translations": [
