                ],
                "senses": [
                    {
                        "sense_id": "16ca0600-4d2e-3645-8638-a0946ba04ef4",
                        "entry_id": "2f8d2fe6-fe08-3c2f-98b7-b1725d870f5d",
                        "glosses": [
                            "S’emporter mal à propos pour une cause légère."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a83cb7e0-a150-43c8-8302-1e7163178750",
                                "sense_id": "16ca0600-4d2e-3645-8638-a0946ba04ef4",
                                "text": "Pour si peu de chose, il n’y a pas de quoi se gendarmer."
                            },
                            {
                                "example_id": "cd100b72-4d3a-499c-af1d-c770ec22381a",
                                "sense_id": "16ca0600-4d2e-3645-8638-a0946ba04ef4",
                                "text": "À quoi bon vous gendarmer."
                            },
                            {
                                "example_id": "58533ea9-9fe1-45f3-89fb-c4282061d5c9",
                                "sense_id": "16ca0600-4d2e-3645-8638-a0946ba04ef4",
                                "text": "Elle s’est gendarmée à cette proposition."
                            },
                            {
                                "example_id": "b8f90962-c98a-4316-8541-eab4b6cb7303",
                                "sense_id": "16ca0600-4d2e-3645-8638-a0946ba04ef4",
                                "text": "Est-ce qu'au simple aveu d'un amoureux transport\nIl faut que notre honneur se gendarme si fort ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "a2006042-5050-3c84-ae2c-82c86f22b06d",
                        "entry_id": "2f8d2fe6-fe08-3c2f-98b7-b1725d870f5d",
                        "glosses": [
                            "Agir comme un gendarme règle la circulation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86785b52-b4eb-4164-b4e2-72fc198150fa",
                                "sense_id": "a2006042-5050-3c84-ae2c-82c86f22b06d",
                                "text": "Mon frère m’énerve à vouloir gendarmer mes fréquentations."
                            }
                        ]
                    }
