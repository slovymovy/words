                        "examples": [
                            {
                                "example_id": "20e18eb0-b06c-4b5d-bf89-4027e3875b66",
                                "sense_id": "4433cf5c-803a-320a-8abf-2952f4e5ef65",
                                "text": "Jicht is geen pretje. Kenmerkend is de plotselinge vlijmende pijn, meestal in de grote teen. Pittige pijnstillers zijn nodig. Die hebben echter ook nare bijwerkingen. Huisarts dr. Hein Janssens ontdekte een veiliger alternatief."
                            },
                            {
                                "example_id": "76f4b062-fa6a-45a4-aab6-fde38d9225b3",
                                "sense_id": "4433cf5c-803a-320a-8abf-2952f4e5ef65",
                                "text": "„Ja. Ten aanzien van de dood van mijn broer val ik samen met de Charlotte in het boek. Bij het schrijven werd ik steeds solidairder met hem, door het vlijmende besef dat wat hem is overkomen mij ook had kunnen overkomen."
                            }
                        ]
                    }
