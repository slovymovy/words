                        "glosses": [
                            "de mate waarin iemand onbevredigd en ontevreden is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f3d99ac-5177-4a48-a9a0-af0a478db313",
                                "sense_id": "14720013-9a74-37e0-b943-f0aab9fbf75e",
                                "text": "Dan zijn eigen onvoldaanheid over zijn werk en de vage hoop hiervoor een middel tot verbetering te vinden."
                            },
                            {
                                "example_id": "4e3caa09-d5c1-40d5-8beb-7dea1690548b",
                                "sense_id": "14720013-9a74-37e0-b943-f0aab9fbf75e",
                                "text": "Volgens het onderzoek ondervinden tussen de 600.000 en 800.000 Nederlanders ernstige hinder van verkeerslawaai. Ze zijn boos en hebben gevoelens van afkeer, onbehagen en onvoldaanheid. Nog eens 300.000 mensen hebben slaapproblemen door verkeerslawaai."
                            }
                        ]
                    }
