                                                "sense_id": "bee35159-0c46-3a9e-a5e4-b3516ac72c4b",
                                                "text": "Die ersten Herbsttage sind doch schon recht klamm."
                                            },
                                            {
                                                "example_id": "d87925f9-5593-4052-af1c-77439c3a7a97",
                                                "sense_id": "bee35159-0c46-3a9e-a5e4-b3516ac72c4b",
                                                "text": "Die Hände sind mir klamm vor Kälte."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "8ef5b8ca-5aba-3193-84d1-a95609b08e50",
                                        "entry_id": "648d6b70-43ed-37fc-b434-f1a4a9b01e22",
                                        "glosses": [
                                            "kein oder nur wenig Geld besitzend"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9f9a243-117b-484e-b7c8-d81d72042352",
                                                "sense_id": "8ef5b8ca-5aba-3193-84d1-a95609b08e50",
                                                "text": "Bin gerade etwas klamm, kannst du mir die Kohle leihen?"
                                            },
                                            {
                                                "example_id": "1f8d9c32-444e-4f66-a084-0ce51f9c748d",
                                                "sense_id": "8ef5b8ca-5aba-3193-84d1-a95609b08e50",
                                                "text": "„Der Bund war dem seit Jahren klammen Konzern schon während der Coronapandemie mit rund 600 Millionen Euro zur Seite gesprungen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
