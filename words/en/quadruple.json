{
    "word_family": [
        "quad",
        "quadrant",
        "quadrate",
        "quadric",
        "quadrillion"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "053058e3-7599-3539-966b-f7316be47199",
                    "sense_definition": "To increase by a factor of four.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "multiplication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Our profits <w>quadrupled</w> after we launched the new marketing campaign.",
                            "target_lang_translations": {
                                "zh": "我们推出新的营销活动后，利润<w>翻了两番</w>。"
                            }
                        },
                        {
                            "text": "The number of students in the program has <w>quadrupled</w> over the last decade.",
                            "target_lang_translations": {
                                "zh": "过去十年里，该项目的学生人数<w>增加到了四倍</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "增加到原来的四倍"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "翻两番",
                                "target_lang_sense_clarification": "指数量增加到原来的四倍"
                            },
                            {
                                "target_lang_word": "增加到四倍",
                                "target_lang_sense_clarification": "描述增长程度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "03b58ab6-81a3-383c-aaa9-b96d2f786366",
                    "sense_definition": "To multiply a number by four.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "multiplication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you <w>quadruple</w> the number five, you get twenty.",
                            "target_lang_translations": {
                                "zh": "如果你把五<w>乘以四</w>，就得到二十。"
                            }
                        },
                        {
                            "text": "You must <w>quadruple</w> the recipe if you want to feed sixteen people.",
                            "target_lang_translations": {
                                "zh": "如果你想招待十六个人，就必须把配方<w>乘以四</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "将一个数乘以四"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "乘以四",
                                "target_lang_sense_clarification": "数学运算"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "041479dd-eb07-333a-9f93-511a7de99c80",
                    "sense_definition": "To add three additional parallel tracks to a railway line.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company plans to <w>quadruple</w> the main line to reduce train delays.",
                            "target_lang_translations": {
                                "zh": "公司计划对主线进行<w>四线化</w>改造以减少列车延误。"
                            }
                        },
                        {
                            "text": "Engineers are currently <w>quadrupling</w> the track to increase capacity for freight.",
                            "target_lang_translations": {
                                "zh": "工程师们目前正在对轨道进行<w>四线化</w>施工，以提高货运能力。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "将铁路线扩建为四条轨道"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "四线化",
                                "target_lang_sense_clarification": "铁路工程术语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "48712ba8-1a97-39e0-bed1-4c6750d1754e",
                    "sense_definition": "Something that is four times the usual number, amount, or size.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "multiplication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new salary is a <w>quadruple</w> of what he earned last year.",
                            "target_lang_translations": {
                                "zh": "新的薪水是他去年收入的<w>四倍</w>。"
                            }
                        },
                        {
                            "text": "The company reported a <w>quadruple</w> in its annual revenue.",
                            "target_lang_translations": {
                                "zh": "该公司报告称其年度收入增长了<w>四倍</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "四倍的数量或规模"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "四倍",
                                "target_lang_sense_clarification": "指代四倍的量"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "79f2005b-b3a8-3082-bfdf-6c1c3847c685",
                    "sense_definition": "A figure-skating jump involving four full revolutions in the air.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The skater landed a perfect <w>quadruple</w> during the final competition.",
                            "target_lang_translations": {
                                "zh": "这位选手在决赛中完美地完成了<w>四周跳</w>。"
                            }
                        },
                        {
                            "text": "Performing a <w>quadruple</w> requires immense strength and precision.",
                            "target_lang_translations": {
                                "zh": "完成<w>四周跳</w>需要极大的力量和精准度。"
                            }
                        }
                    ],
                    "synonyms": [
                        "quad"
                    ],
                    "target_lang_definitions": {
                        "zh": "花样滑冰中在空中旋转四周的跳跃动作"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "四周跳",
                                "target_lang_sense_clarification": "花样滑冰术语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ea13903c-6fa4-390a-a2e2-ce0f568038ed",
                    "sense_definition": "Consisting of four parts or being four times as large or as many.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "multiplication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The machine has a <w>quadruple</w> filtration system that cleans the water in four stages.",
                            "target_lang_translations": {
                                "zh": "这台机器配有<w>四重</w>过滤系统，分四个阶段净化水质。"
                            }
                        },
                        {
                            "text": "They received a <w>quadruple</w> dose of the medication by mistake.",
                            "target_lang_translations": {
                                "zh": "他们误服了<w>四倍</w>剂量的药物。"
                            }
                        }
                    ],
                    "antonyms": [
                        "quarter"
                    ],
                    "target_lang_definitions": {
                        "zh": "由四个部分组成，或数量规模为四倍的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "四倍的",
                                "target_lang_sense_clarification": "形容词，表示数量关系"
                            },
                            {
                                "target_lang_word": "四重的",
                                "target_lang_sense_clarification": "形容词，表示结构组成"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}