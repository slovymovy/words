                                        "sense_id": "906304e7-69ad-3bd1-97a1-7152f73cce91",
                                        "entry_id": "b954d1dc-d45d-3436-8818-8798fe97f354",
                                        "glosses": [
                                            "in einem bildlichen oder in einem übertragenen Sinn gebraucht"
                                        ],
