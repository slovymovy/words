                        "glosses": [
                            "Molécule chimique qui a des propriétés bêta-bloquantes sur le système cardiovasculaire humain."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c06aa60-1352-45fa-95c5-3725a443bbaf",
                                "sense_id": "2b69ec32-86f2-31ee-8a95-d0ddb91046c3",
                                "text": "La baisse de la pression artérielle doit être contrôlée, ni trop vite ni trop fort, en utilisant du nitroprussiate de sodium ou du labétolol à la seringue électrique, associé à des anti-œdèmes (mannitol, corticoïdes) et des antiépileptiques."
                            },
                            {
                                "example_id": "0f168a13-dd21-4604-bbce-623c9fb73e2f",
                                "sense_id": "2b69ec32-86f2-31ee-8a95-d0ddb91046c3",
                                "text": "Antécédents d’allergie ou contre-indications au sulfate de magnésium ou au labétolol."
                            },
                            {
                                "example_id": "c5b9c2fd-6c28-4d3c-bbdc-8a8a1b8fa449",
                                "sense_id": "2b69ec32-86f2-31ee-8a95-d0ddb91046c3",
                                "text": "Mutagénicité: le labétolol n’a démontré aucun indice concernant des effets mutagènes dans des études in vitro et in vivo."
                            }
                        ]
                    }
