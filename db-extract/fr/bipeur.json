                        ],
                        "form": "bipeurs"
                    },
                    {
                        "form_id": "4b033618-5320-49c1-aaea-c9bd80338227",
                        "entry_id": "540aed63-ae95-3b87-85f7-9c54dabb37b9",
                        "tags": [],
                        "form": "beeper"
                    },
                    {
                        "form_id": "0994c48f-fc0d-4e43-9a9c-2636c5d92b98",
                        "entry_id": "540aed63-ae95-3b87-85f7-9c54dabb37b9",
                        "tags": [],
                        "form": "biper"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "32db06e0-cb91-3a80-868d-fd685f57edf1",
                        "entry_id": "540aed63-ae95-3b87-85f7-9c54dabb37b9",
                        "glosses": [
                            "Messager, sorte d’appareil qui émet un bip pour appeler un correspondant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4b5895c-dea8-44c8-a4b6-ac4189b07f52",
                                "sense_id": "32db06e0-cb91-3a80-868d-fd685f57edf1",
                                "text": "Lorsqu’elle entra dans la pièce pour voir ce dont il s’agissait, elle comprit que c’était le bipeur de Steve qui sonnait."
                            },
                            {
                                "example_id": "7f273a94-5185-4d95-aab7-04669e9c63dc",
                                "sense_id": "32db06e0-cb91-3a80-868d-fd685f57edf1",
                                "text": "En tant que surveillants, nous n’étions pas autorisés à franchir la porte d’entrée avec des récipients en verre, des chewing-gums, des canifs dont la lame mesurait plus de cinq centimètres, des journaux, des magazines, des bipeurs, des téléphones portables ou, bien sûr, nos pistolets et autres armes personnelles."
                            }
                        ]
                    },
                    {
                        "sense_id": "400967e2-15df-3985-a00a-34a1b4dbbc22",
                        "entry_id": "540aed63-ae95-3b87-85f7-9c54dabb37b9",
                        "glosses": [
                            "Sorte de télécommande qui émet un bip d’avertissement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17345bdd-4b1a-4562-8197-231145dbb2a5",
                                "sense_id": "400967e2-15df-3985-a00a-34a1b4dbbc22",
                                "text": "– Y’a des caméras à l’entrée. Et puis les bipeurs qu’on utilise pour s’introduire dans cette foutue résidence, Kerex te l’a dit, ils déclenchent un ordre informatique. Alors il doit bien y avoir une trace quelque part qui pourra nous apprendre avec quel bipeur ce type est arrivé ici."
                            },
                            {
                                "example_id": "0d04647e-3b11-4ae5-a71f-a4da503d3169",
                                "sense_id": "400967e2-15df-3985-a00a-34a1b4dbbc22",
                                "text": "Il utilisa le « bipeur » dans la boîte à gants pour déverrouiller l’alarme de la maison."
                            },
                            {
                                "example_id": "aa4c8506-92fe-496a-a52d-effd273a2474",
                                "sense_id": "400967e2-15df-3985-a00a-34a1b4dbbc22",
                                "text": "Lucas rentrait du travail, ce jour-là. Il utilisa son bipeur pour ouvrir le portail électrique lui ouvrant la voie vers le manoir."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3666340c-9c35-40f7-9605-12a91c091746",
                        "source_entry_id": "540aed63-ae95-3b87-85f7-9c54dabb37b9",
                        "target_lang_word": "beeper",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "beeper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "849e24d1-10e7-3491-a1f0-df9c23eddca2",
                                        "entry_id": "8d531da5-3eed-3d00-a609-e292b35a03a6",
                                        "glosses": [
                                            "Something that makes a beeping sound.",
                                            "A simple computer speaker."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bb321a1-0beb-4d24-a50b-8432c6b8b4a0",
                                                "sense_id": "849e24d1-10e7-3491-a1f0-df9c23eddca2",
                                                "text": "The Controls option enables you to resize and move a currently displayed window, as well as toggle the PC beeper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19a0d449-0506-395a-85ae-edf0a5a762ed",
                                        "entry_id": "8d531da5-3eed-3d00-a609-e292b35a03a6",
                                        "glosses": [
                                            "Something that makes a beeping sound.",
                                            "A pager (wireless telecommunication device)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e118cd72-2842-407e-a0df-888923d11a9c",
                                                "sense_id": "19a0d449-0506-395a-85ae-edf0a5a762ed",
                                                "text": "No stages, front pages, no phones, no beepers"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3df1df0c-220e-3e1a-881f-101582628324",
                                        "entry_id": "8d531da5-3eed-3d00-a609-e292b35a03a6",
                                        "glosses": [
                                            "Something that makes a beeping sound.",
                                            "A robot."
                                        ],
                                        "tags": [
                                            "endearing"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3b7b5b3c-1a3f-37ff-8480-b17542754d42",
                                        "entry_id": "8d531da5-3eed-3d00-a609-e292b35a03a6",
                                        "glosses": [
                                            "A broadcast interview taking place over the telephone (originally having to include a beeping sound to indicate that it was not a live broadcast)."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92ce7038-2b6c-4e46-9156-c96d407b323b",
                                                "sense_id": "3b7b5b3c-1a3f-37ff-8480-b17542754d42",
                                                "text": "Radio \"beepers\" are easy: all you need is a telephone, and you can basically have an overseas conversation with any DJ or radio news director in America."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bfd2bde2-39c6-4609-a05e-ee230b70f487",
                        "source_entry_id": "540aed63-ae95-3b87-85f7-9c54dabb37b9",
                        "target_lang_word": "pager",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pager",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "95187c5f-a807-3df5-a437-86bea9368b17",
                                        "entry_id": "1f0f98b3-073c-30e6-891d-8a419b49497b",
                                        "glosses": [
                                            "A wireless telecommunications device that receives text or voice messages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2292441-a7e1-43d7-ab3e-1cc191c838df",
                                                "sense_id": "95187c5f-a807-3df5-a437-86bea9368b17",
                                                "text": "Before he could bring it down, the pager clipped to his belt went off. Alan pushed the button that turned the hateful gadget off and stood indecisively in front of the shop door a moment longer […]"
                                            },
                                            {
                                                "example_id": "e54b6104-de94-4de9-a0ea-eb7b28aacc91",
                                                "sense_id": "95187c5f-a807-3df5-a437-86bea9368b17",
                                                "text": "I left my cell, my pager, and my home phone at the bottom / I sent two letters back in autumn, you must not've got 'em"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac8a362c-e662-3487-8ea0-fee2b04af4af",
                                        "entry_id": "1f0f98b3-073c-30e6-891d-8a419b49497b",
                                        "glosses": [
                                            "A computer program running in a text terminal, used to view (but not modify) the contents of a text file moving down the file one line or one screen at a time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "839ea39a-3950-4c87-b306-09e513942026",
                                                "sense_id": "ac8a362c-e662-3487-8ea0-fee2b04af4af",
                                                "text": "more is a pager. The basic purpose of a pager is that it lets you view the contents of a file without actually having to open the file."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6000a06-f64f-375a-bbd8-e58d9b2c7bff",
                                        "entry_id": "1f0f98b3-073c-30e6-891d-8a419b49497b",
                                        "glosses": [
                                            "Something (a document, book etc.) that has a specified number of pages."
                                        ],
                                        "tags": [
                                            "in-compounds"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60a0414b-ae3f-4004-a5f8-9bcda970b697",
                                                "sense_id": "b6000a06-f64f-375a-bbd8-e58d9b2c7bff",
                                                "text": "Sunday papers kept growing in bulk, however. The Boston Globes standard eight-page Sunday offering swelled to forty pages in 1895, and sixty pages soon after. The New York World issued a record-breaking hundred-pager' in 1893 to celebrate its tenth anniversary under Pulitzer's ownership."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75f44859-c3e9-344b-afd0-328c13eedf4c",
                                        "entry_id": "1f0f98b3-073c-30e6-891d-8a419b49497b",
                                        "glosses": [
                                            "One who makes up type into pages of a book; one who binds or sorts pages into a book."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7b12a1ed-efb7-43c2-b3af-3d2838703a99",
                        "source_entry_id": "540aed63-ae95-3b87-85f7-9c54dabb37b9",
                        "target_lang_word": "buzzer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "buzzer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c66aeb3f-13bc-3e0b-ac53-012cc661ff9e",
                                        "entry_id": "bf101cbf-8dc5-34d0-af7a-d3635286a31c",
                                        "glosses": [
                                            "One who, or that which, buzzes; an insect that buzzes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db1eb639-1c19-4bc9-ad6c-2c627440997f",
                                                "sense_id": "c66aeb3f-13bc-3e0b-ac53-012cc661ff9e",
                                                "text": "And wants not buzzers to infect his ear / With pestilent speeches of his father's death."
                                            },
                                            {
                                                "example_id": "d0540d76-ff42-4ce1-bd68-19b824b1e33f",
                                                "sense_id": "c66aeb3f-13bc-3e0b-ac53-012cc661ff9e",
                                                "text": "... it left, however, a bee at his ear and an itch to transfer the buzzer's attentions and tease his darling; for she had betrayed herself as right good game."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41091420-ce70-3d1b-aed2-0863928f4a78",
                                        "entry_id": "bf101cbf-8dc5-34d0-af7a-d3635286a31c",
                                        "glosses": [
                                            "A device that makes a buzzing sound."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b527ea1a-ff0c-4d29-b3c8-63e19b355405",
                                                "sense_id": "41091420-ce70-3d1b-aed2-0863928f4a78",
                                                "text": "If you think you know the answer to the question, hit the buzzer as fast as you can."
                                            },
                                            {
                                                "example_id": "a53bb444-6af1-4744-bcb6-1e698f7d488b",
                                                "sense_id": "41091420-ce70-3d1b-aed2-0863928f4a78",
                                                "text": "If a train enters the forward section before its description has been transmitted, a \"not described\" lamp is illuminated on the transmitter, an alarm buzzer is sounded, and the lamp remains alight until a description has been transmitted."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d211a4d1-9681-3837-affc-2e389d88b088",
                                        "entry_id": "bf101cbf-8dc5-34d0-af7a-d3635286a31c",
                                        "glosses": [
                                            "A police badge."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29ecc8d9-6ac4-4a66-954c-a32dd9137831",
                                                "sense_id": "d211a4d1-9681-3837-affc-2e389d88b088",
                                                "text": "I flipped my wallet open on her desk and let her look at the buzzer pinned to the flap."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "590ad0d9-2196-3069-abf7-667294ecbf49",
                                        "entry_id": "bf101cbf-8dc5-34d0-af7a-d3635286a31c",
                                        "glosses": [
                                            "A run scored from an overthrow."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c3332e8a-3f9d-3f4e-b826-4ac35e0c935c",
                                        "entry_id": "bf101cbf-8dc5-34d0-af7a-d3635286a31c",
                                        "glosses": [
                                            "A gossip."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66531c07-9104-4441-8644-5d5a863ebaeb",
                                                "sense_id": "c3332e8a-3f9d-3f4e-b826-4ac35e0c935c",
                                                "text": "Her brother is in secret come from France,\nFeeds on this wonder, keeps himself in clouds\nAnd wants not buzzers to infect his ear\nWith pestilent speeches of his father's death."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
