                "senses": [
                    {
                        "sense_id": "f6b85558-a339-3e77-b8cc-ed4f3f10d671",
                        "entry_id": "99525de8-71cd-372a-89eb-748c4bb7ad73",
                        "glosses": [
                            "Mitglied der Unterordnung Tylopoda oder Schwielensohler der Säugetierfamilie der Kamele, die in die Untergruppen der Altweltkamele (Dromedar) und der Neuweltkamele (Lama, Vikunja) eingeteilt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9eea52e4-f89b-477a-8157-d72b1b31d185",
                                "sense_id": "f6b85558-a339-3e77-b8cc-ed4f3f10d671",
                                "text": "„Um zu betonen, daß sie als erste amerikanische Markenzigarette amerikanische und türkische Tabaksorten mischte, hatte Joshua Reynolds den orientalischen Schwielensohler zum Markenzeichen und -namen erhoben.“"
                            },
                            {
                                "example_id": "97e58dda-9f4d-4048-9dea-d82780e3df76",
                                "sense_id": "f6b85558-a339-3e77-b8cc-ed4f3f10d671",
                                "text": "„Das Kamel hat seine Schuhsohlen direkt an den Füßen: Es ist ein so genannter Schwielensohler.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
