                "senses": [
                    {
                        "sense_id": "ec328b9b-5a2b-3987-b889-1d3757b85738",
                        "entry_id": "21537648-481b-3a33-bcdf-c331d1c0db60",
                        "glosses": [
                            "von zwanzig gleichseitigen Dreiecken begrenzter Körper"
                        ],
                        "tags": [
                            "geometry"
                        ],
                        "examples": [
                            {
                                "example_id": "11c7be7e-91a4-4569-964f-4d9a81942b1b",
                                "sense_id": "ec328b9b-5a2b-3987-b889-1d3757b85738",
                                "text": "Ein Ikosaeder hat zwölf Ecken, in denen jeweils fünf Flächen zusammentreffen."
                            },
                            {
                                "example_id": "35386582-0025-4572-89e1-5a03d8644c15",
                                "sense_id": "ec328b9b-5a2b-3987-b889-1d3757b85738",
                                "text": "Das Ikosaeder ist dual zum Dodekaeder."
                            },
                            {
                                "example_id": "8430451f-4722-4422-a928-cd90673382a3",
                                "sense_id": "ec328b9b-5a2b-3987-b889-1d3757b85738",
                                "text": "„Für den Ikosaeder sind es 60 Untereinheiten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5fe3cc5e-10ba-4fcd-8bbf-b64fd7d4acdc",
