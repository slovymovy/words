                        "выйти из окружения",
                        "кольцо окружения"
                    ],
                    "target_lang_definitions": {
                        "en": "A military situation where troops are cut off from main forces and blocked by the enemy.",
                        "pl": "Sytuacja militarna, w której wojska są odcięte od sił głównych i zablokowane przez przeciwnika."
                    },
                    "translations": {
                        "en": [
