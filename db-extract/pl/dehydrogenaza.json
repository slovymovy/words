                    {
                        "sense_id": "24b91cfd-59fd-3544-a93b-31c79b412e23",
                        "entry_id": "ccfc5542-3f7e-3621-97af-8f4e1cd03906",
                        "glosses": [
                            "enzym katalizujący odszczepianie atomów wodoru od metabolitów i przenoszenie ich na inne związki chemiczne"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83637d99-08cb-4130-966c-0f228402454a",
                                "sense_id": "24b91cfd-59fd-3544-a93b-31c79b412e23",
                                "text": "W przypadku toluenu wydaje się, że główną reakcją, w której powstają RFT, jest reakcja utleniania aldehydu benzylowego, powstającego w wyniku metabolizmu tego związku, przez dehydrogenazę aldehydową."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0c2341b9-b055-4111-bf2f-0bebc36e9693",
                        "source_entry_id": "ccfc5542-3f7e-3621-97af-8f4e1cd03906",
                        "source_sense_id": "24b91cfd-59fd-3544-a93b-31c79b412e23",
                        "target_lang_word": "dehydrogenase",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dehydrogenase",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "06cacb85-569e-3a93-8f7d-f93f27042798",
                                        "entry_id": "238bbaec-8a49-3d8d-ba40-0f4f5ba23a25",
                                        "glosses": [
                                            "Any of several enzymes that catalyze the removal of hydrogen (a proton) from biological compounds."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2fe1fa9-a5b0-462a-8610-63dfdef1a185",
                                                "sense_id": "06cacb85-569e-3a93-8f7d-f93f27042798",
                                                "text": "This led to a search in the filtrate for a dehydrogenase which should activate lactate in preference to the other three substances."
                                            },
                                            {
                                                "example_id": "fa66718e-9ea2-4007-b6d1-c4f7eeee3f16",
                                                "sense_id": "06cacb85-569e-3a93-8f7d-f93f27042798",
                                                "text": "Our stomachs and livers have an enzyme known as alcohol dehydrogenase that breaks down ethanol to make it less toxic for our bodies, said Atlanta gastroenterologist Dr. Preston Stewart."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8bc5713f-9e1f-424b-8ac7-c511df416c70",
                        "source_entry_id": "ccfc5542-3f7e-3621-97af-8f4e1cd03906",
