                        "examples": [
                            {
                                "example_id": "a08a853e-2d5d-47b2-b7ff-4d789bbcff60",
                                "sense_id": "0b72d55b-1396-366a-a261-be9482569636",
                                "text": "„Die Diagnose ADHS wird seit Jahren immer häufiger bei Kindern und auch bei Erwachsenen gestellt, in Deutschland leidet heute angeblich jedes 20. Kind darunter.“",
                                "translation": "DEHB, senelerdir çocuklarda ve yetişkinlerde giderek daha sık teşhis ediliyor. Almanya'da her 20 çocuktan birinin bundan muzdarip olduğu söyleniyor."
                            },
                            {
                                "example_id": "94649839-896a-4aa8-9b0c-ea244d87608b",
                                "sense_id": "0b72d55b-1396-366a-a261-be9482569636",
                                "text": "„ADHS tritt im Kindesalter auf und bleibt dann oft ein Leben lang bestehen.“",
                                "translation": "DEHB çocuklukta ortaya çıkar ve genellikle hayat boyu devam eder."
                            }
                        ]
