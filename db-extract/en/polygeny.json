                        ],
                        "examples": [
                            {
                                "example_id": "4f764480-b25b-4f32-8cd5-a233aff3426f",
                                "sense_id": "ea333329-8e90-3785-acce-d8e42734deef",
                                "text": "Some features of the universal tree of life based on rRNA polygenies have been confirmed, such as the division of the cellular living world into three domains."
                            }
                        ]
                    },
                    {
                        "sense_id": "45e4f7dc-f953-3a6e-ab39-29186fb2ce0d",
                        "entry_id": "37a76502-6928-394a-be9e-c0708798c1b2",
                        "glosses": [
                            "The control of a single trait, or phenotype, by multiple genes."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a3aa06d9-9d72-4183-95cd-3e375f795264",
                                "sense_id": "45e4f7dc-f953-3a6e-ab39-29186fb2ce0d",
                                "text": "Mendel thus recognised the possibility of polygenies."
                            },
                            {
                                "example_id": "c471abc8-5760-4931-b8dc-6d4872e1b3a7",
                                "sense_id": "45e4f7dc-f953-3a6e-ab39-29186fb2ce0d",
                                "text": "However, the recent studies by Khan & Doworkers and Siegel (1977) have indicated that under a balance polygenic combination the ill effects of dw gene under egg type genome can be modified by introducing polygenies for egg production."
                            }
                        ]
                    }
