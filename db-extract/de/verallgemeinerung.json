                "senses": [
                    {
                        "sense_id": "2b8e5638-6364-3bd2-83d8-55ad009834c8",
                        "entry_id": "f910614a-ce85-36ba-888a-5ce264786455",
                        "glosses": [
                            "die Handlung, die Eigenschaften einer konkreten Einheit auf die Gesamtheit zu übertragen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cf4a6f4-fe25-426e-9042-e9a8c70de493",
                                "sense_id": "2b8e5638-6364-3bd2-83d8-55ad009834c8",
                                "text": "Sie neigen zu unangebrachten Verallgemeinerungen."
                            },
                            {
                                "example_id": "46746fd7-fcc2-4c09-9c26-4c771705ed7a",
                                "sense_id": "2b8e5638-6364-3bd2-83d8-55ad009834c8",
                                "text": "„Der aber ergibt sich nie aus Abstraktionen und Verallgemeinerungen.“"
                            },
                            {
                                "example_id": "29c15531-fda1-44c3-a75c-79b4a1e5cd62",
                                "sense_id": "2b8e5638-6364-3bd2-83d8-55ad009834c8",
                                "text": "„Für gesicherte Verallgemeinerungen verfügen wir also über zu wenige Daten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
