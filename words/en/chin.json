{
    "word_family": [
        "chinless",
        "chin-up",
        "chinwag"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1c2ef490-7213-3931-b020-5a369c6698c5",
                    "sense_definition": "The protruding part of the face below the mouth and above the neck.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "anatomy_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She rested her <w>chin</w> on her hand while she listened.",
                            "target_lang_translations": {
                                "ru": "Слушая, она положила <w>подбородок</w> на руку.",
                                "cs": "Při poslechu si podepřela <w>bradu</w> rukou.",
                                "zh": "她听的时候，用手托着<w>下巴</w>。"
                            }
                        },
                        {
                            "text": "He has a small scar on his <w>chin</w> from a childhood fall.",
                            "target_lang_translations": {
                                "ru": "У него на <w>подбородке</w> есть маленький шрам от падения в детстве.",
                                "cs": "Na <w>bradě</w> má malou jizvu z dětství po pádu.",
                                "zh": "他小时候摔了一跤，<w>下巴</w>上留下了个小疤。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "double chin",
                        "keep your chin up",
                        "stroke one's chin",
                        "chin strap"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выступающая часть лица ниже рта и выше шеи.",
                        "cs": "Vystupující část obličeje pod ústy a nad krkem.",
                        "zh": "面部嘴巴下方、脖子以上的突出部位。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подбородок",
                                "target_lang_sense_clarification": "часть лица"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "brada",
                                "target_lang_sense_clarification": "anatomická část obličeje"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "下巴",
                                "target_lang_sense_clarification": "面部解剖部位"
                            },
                            {
                                "target_lang_word": "下巴颏",
                                "target_lang_sense_clarification": "口语表达"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a7e90c3c-2b3f-3122-80c1-4a306365bf80",
                    "sense_definition": "The ability to withstand being punched in the face without being knocked unconscious; often used figuratively for resilience.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "boxing_resilience",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boxer is known for having a granite <w>chin</w>.",
                            "target_lang_translations": {
                                "ru": "Этот боксер известен своей гранитной <w>челюстью</w>.",
                                "cs": "Ten boxer je známý svou žulovou <w>čelistí</w>.",
                                "zh": "这位拳击手以拥有极强的<w>抗击打能力</w>而闻名。"
                            }
                        },
                        {
                            "text": "You have to learn to take bad news on the <w>chin</w> and keep moving forward.",
                            "target_lang_translations": {
                                "ru": "Ты должен научиться <w>держать удар</w>, получая плохие новости, и двигаться дальше.",
                                "cs": "Musíš se naučit <w>přijmout</w> špatné zprávy se vztyčenou hlavou a jít dál.",
                                "zh": "你必须学会<w>坚强</w>地面对坏消息，继续前行。"
                            }
                        }
                    ],
                    "antonyms": [
                        "glass chin",
                        "glass jaw"
                    ],
                    "common_phrases": [
                        "take it on the chin",
                        "granite chin"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способность выдерживать удары в лицо без потери сознания; часто используется в переносном смысле для обозначения стойкости.",
                        "cs": "Schopnost snášet údery do obličeje bez ztráty vědomí; často se používá přeneseně pro odolnost.",
                        "zh": "指在拳击中承受重击而不昏迷的能力；常比喻为面对挫折时的韧性。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "челюсть",
                                "target_lang_sense_clarification": "в боксе"
                            },
                            {
                                "target_lang_word": "стойкость",
                                "target_lang_sense_clarification": "переносное значение"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "čelist",
                                "target_lang_sense_clarification": "v kontextu boxu a odolnosti"
                            },
                            {
                                "target_lang_word": "odolnost",
                                "target_lang_sense_clarification": "přenesený význam"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "抗击打能力",
                                "target_lang_sense_clarification": "拳击术语"
                            },
                            {
                                "target_lang_word": "韧性",
                                "target_lang_sense_clarification": "比喻义"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4929b792-567c-3cc6-8a22-f349516c1f1a",
                    "sense_definition": "A chinchilla.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "animal_slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We keep two <w>chins</w> in a large cage in the living room.",
                            "target_lang_translations": {
                                "ru": "Мы держим двух <w>шиншилл</w> в большой клетке в гостиной.",
                                "cs": "Ve velké kleci v obývacím pokoji chováme dvě <w>činčily</w>.",
                                "zh": "我们在客厅的大笼子里养了两只<w>龙猫</w>。"
                            }
                        },
                        {
                            "text": "The breeder specializes in grey <w>chins</w>.",
                            "target_lang_translations": {
                                "ru": "Заводчик специализируется на серых <w>шиншиллах</w>.",
                                "cs": "Chovatel se specializuje na šedé <w>činčily</w>.",
                                "zh": "这位繁育者专门培育灰色<w>龙猫</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "shortening of chinchilla"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Шиншилла (разговорное сокращение).",
                        "cs": "Činčila (hovorové zkrácení).",
                        "zh": "一种原产于南美洲的啮齿动物，常作为宠物饲养。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шиншилла",
                                "target_lang_sense_clarification": "животное"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "činčila",
                                "target_lang_sense_clarification": "zvíře"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "龙猫",
                                "target_lang_sense_clarification": "宠物名称"
                            },
                            {
                                "target_lang_word": "南美栗鼠",
                                "target_lang_sense_clarification": "学名"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4fa2f94a-75a8-3e5a-ae47-485e01fc4506",
                    "sense_definition": "To perform a chin-up exercise by lifting one's body weight while hanging from a bar.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "exercise_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He managed to <w>chin</w> himself ten times before his arms gave out.",
                            "target_lang_translations": {
                                "ru": "Ему удалось <w>подтянуться</w> десять раз, прежде чем руки отказали.",
                                "cs": "Podařilo se mu <w>přitáhnout</w> desetkrát, než mu vypověděly službu ruce.",
                                "zh": "他成功做了十个<w>引体向上</w>，直到双臂力竭。"
                            }
                        },
                        {
                            "text": "The soldiers were required to <w>chin</w> the bar as part of their physical test.",
                            "target_lang_translations": {
                                "ru": "Солдаты должны были <w>подтянуться</w> на перекладине в рамках сдачи нормативов.",
                                "cs": "Vojáci se museli v rámci fyzických testů <w>přitahovat</w> na hrazdě.",
                                "zh": "作为体能测试的一部分，士兵们必须完成<w>引体向上</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "chin oneself",
                        "chin the bar"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выполнять упражнение «подтягивание», поднимая вес собственного тела на перекладине.",
                        "cs": "Provádět cvik „shyby“, při kterém se zvedá vlastní váha těla na hrazdě.",
                        "zh": "指通过悬挂在横杆上向上拉动身体的锻炼动作。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подтягиваться",
                                "target_lang_sense_clarification": "упражнение"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "přitahovat se",
                                "target_lang_sense_clarification": "cvičení na hrazdě"
                            },
                            {
                                "target_lang_word": "shybovat",
                                "target_lang_sense_clarification": "odbornější termín pro shyby"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "引体向上",
                                "target_lang_sense_clarification": "健身动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "66233e86-e8a6-36a2-8e65-7f39f1432ac5",
                    "sense_definition": "To talk or converse casually.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "communication_slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We sat on the porch <w>chinning</w> about old times until the sun went down.",
                            "target_lang_translations": {
                                "ru": "Мы сидели на крыльце, <w>болтая</w> о былых временах, пока не зашло солнце.",
                                "cs": "Seděli jsme na verandě a <w>klábosili</w> o starých časech, dokud slunce nezapadlo.",
                                "zh": "我们坐在门廊上<w>闲聊</w>往事，直到日落。"
                            }
                        },
                        {
                            "text": "Stop <w>chinning</w> with your friends and get back to work.",
                            "target_lang_translations": {
                                "ru": "Хватит <w>трепаться</w> с друзьями, возвращайся к работе.",
                                "cs": "Přestaň <w>tlachat</w> s kamarády a vrať se k práci.",
                                "zh": "别再和朋友<w>闲聊</w>了，回去工作吧。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gab"
                    ],
                    "common_phrases": [
                        "chin wag"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Болтать или непринужденно беседовать.",
                        "cs": "Nuceně nebo neformálně konverzovat.",
                        "zh": "指非正式的闲聊或交谈。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "болтать",
                                "target_lang_sense_clarification": "разговорное"
                            },
                            {
                                "target_lang_word": "трепаться",
                                "target_lang_sense_clarification": "сленг"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "klábosit",
                                "target_lang_sense_clarification": "neformální hovor"
                            },
                            {
                                "target_lang_word": "tlachat",
                                "target_lang_sense_clarification": "hovorově, často o nepodstatných věcech"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "闲聊",
                                "target_lang_sense_clarification": "非正式交谈"
                            },
                            {
                                "target_lang_word": "唠嗑",
                                "target_lang_sense_clarification": "口语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8a56186f-2b6b-3bca-a3be-50e3c8c27bbe",
                    "sense_definition": "To punch or hit someone on the jaw.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "violence_slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He got into a fight at the pub and <w>chinned</w> the bouncer.",
                            "target_lang_translations": {
                                "ru": "Он ввязался в драку в пабе и <w>врезал</w> вышибале.",
                                "cs": "V hospodě se připletl do rvačky a <w>vrazil</w> vyhazovači.",
                                "zh": "他在酒吧打架，一拳<w>打</w>在了保安的<w>下巴</w>上。"
                            }
                        },
                        {
                            "text": "I was so angry I almost <w>chinned</w> him right there.",
                            "target_lang_translations": {
                                "ru": "Я был так зол, что чуть не <w>ударил его в челюсть</w> прямо там.",
                                "cs": "Byl jsem tak naštvaný, že jsem mu skoro <w>vrazil</w> přímo tam.",
                                "zh": "我当时太生气了，差点就在那儿一拳<w>打</w>他<w>下巴</w>上。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ударить кого-либо в челюсть.",
                        "cs": "Udeřit někoho do čelisti.",
                        "zh": "指猛击某人的下巴。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ударить в челюсть",
                                "target_lang_sense_clarification": "действие"
                            },
                            {
                                "target_lang_word": "врезать",
                                "target_lang_sense_clarification": "сленг"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "vrazit pěstí",
                                "target_lang_sense_clarification": "fyzický úder"
                            },
                            {
                                "target_lang_word": "praštit do čelisti",
                                "target_lang_sense_clarification": "přímý popis akce"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "打下巴",
                                "target_lang_sense_clarification": "动作描述"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "1d496516-5a74-3271-9a31-43eefa358d27",
                    "sense_definition": "A state in western Myanmar (Burma).",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "geography_myanmar",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The <w>Chin</w> State is known for its mountainous terrain.",
                            "target_lang_translations": {
                                "ru": "Штат <w>Чин</w> известен своей гористой местностью.",
                                "cs": "Stát <w>Čin</w> je známý svým hornatým terénem.",
                                "zh": "<w>钦邦</w>以其多山的地形而闻名。"
                            }
                        },
                        {
                            "text": "Many people from <w>Chin</w> have migrated to other countries.",
                            "target_lang_translations": {
                                "ru": "Многие люди из штата <w>Чин</w> мигрировали в другие страны.",
                                "cs": "Mnoho lidí z <w>Činu</w> emigrovalo do jiných zemí.",
                                "zh": "许多来自<w>钦邦</w>的人已经移民到其他国家。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Штат на западе Мьянмы (Бирмы).",
                        "cs": "Stát na západě Myanmaru (Barmy).",
                        "zh": "缅甸西部的一个邦。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Чин",
                                "target_lang_sense_clarification": "штат"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "Čin",
                                "target_lang_sense_clarification": "geografický název státu"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "钦邦",
                                "target_lang_sense_clarification": "地理名称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "08ff3864-3a75-39b0-b235-a1e64d0d165d",
                    "sense_definition": "An ethnic group or tribe native to Myanmar and India.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "ethnicity_myanmar",
                    "name_type": "ethnic_group_name",
                    "examples": [
                        {
                            "text": "The <w>Chin</w> people have a rich cultural heritage.",
                            "target_lang_translations": {
                                "ru": "Народ <w>чин</w> обладает богатым культурным наследием.",
                                "cs": "Národ <w>Činů</w> má bohaté kulturní dědictví.",
                                "zh": "<w>钦族</w>人民拥有丰富的文化遗产。"
                            }
                        },
                        {
                            "text": "Traditional weaving is an important skill among the <w>Chin</w>.",
                            "target_lang_translations": {
                                "ru": "Традиционное ткачество — важный навык среди народа <w>чин</w>.",
                                "cs": "Tradiční tkaní je mezi <w>Činy</w> důležitou dovedností.",
                                "zh": "传统编织是<w>钦族</w>人的一项重要技能。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Этническая группа или племя, коренное население Мьянмы и Индии.",
                        "cs": "Etnická skupina nebo kmen, původní obyvatelé Myanmaru a Indie.",
                        "zh": "原产于缅甸和印度的一个民族。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чин",
                                "target_lang_sense_clarification": "народность"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "Činové",
                                "target_lang_sense_clarification": "etnická skupina"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "钦族",
                                "target_lang_sense_clarification": "民族名称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d8bacc75-65d8-37fd-8e36-d034133679f3",
                    "sense_definition": "A Chinese dynasty (also known as Jin) or an ancient Chinese state.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "history_china",
                    "name_type": "historical_name",
                    "examples": [
                        {
                            "text": "The <w>Chin</w> dynasty saw significant developments in literature.",
                            "target_lang_translations": {
                                "ru": "В эпоху династии <w>Цзинь</w> наблюдалось значительное развитие литературы.",
                                "cs": "Za dynastie <w>Ťin</w> došlo k významnému rozvoji literatury.",
                                "zh": "<w>晋</w>朝时期文学有了显著的发展。"
                            }
                        },
                        {
                            "text": "Artifacts from the <w>Chin</w> period are displayed in the museum.",
                            "target_lang_translations": {
                                "ru": "Артефакты периода <w>Цзинь</w> выставлены в музее.",
                                "cs": "Artefakty z období <w>Ťin</w> jsou vystaveny v muzeu.",
                                "zh": "<w>晋</w>代的文物陈列在博物馆里。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "alternative form of Jin"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Китайская династия (также известная как Цзинь) или древнее китайское государство.",
                        "cs": "Čínská dynastie (také známá jako Ťin) nebo starověký čínský stát.",
                        "zh": "中国古代的一个朝代或国家。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Цзинь",
                                "target_lang_sense_clarification": "династия"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "Ťin",
                                "target_lang_sense_clarification": "historická dynastie"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "晋",
                                "target_lang_sense_clarification": "历史朝代"
                            }
                        ]
                    }
