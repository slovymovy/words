                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e69283b1-0255-3f20-9ffe-9b5379bff227",
                                        "entry_id": "85779af0-7173-378c-834e-eebcdb4c0d16",
                                        "glosses": [
                                            "A flitch."
                                        ],
