                "senses": [
                    {
                        "sense_id": "abd94867-4fa0-3ce4-bfab-560d762c0ac4",
                        "entry_id": "623122e9-3e25-3a29-8d22-f6a0c335830f",
                        "glosses": [
                            "Donner un caractère soporifique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2de66035-79e3-4a47-b0b0-d1ba192442b5",
                                "sense_id": "abd94867-4fa0-3ce4-bfab-560d762c0ac4",
                                "text": "Bon, je me suis un peu ennuyée pour Philippe Solers et Philippe Delerme, disons … « soporifiquisés »."
                            }
                        ]
                    },
                    {
                        "sense_id": "38078697-87c5-3fa3-b5af-778abc3baa9f",
                        "entry_id": "623122e9-3e25-3a29-8d22-f6a0c335830f",
                        "glosses": [
                            "Administrer un soporifique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e401eff9-467d-4195-8139-374c1e7a66c4",
                                "sense_id": "38078697-87c5-3fa3-b5af-778abc3baa9f",
                                "text": "Mais non : il en ressortit que Françoise avait fait l’acquisition de cette faune au cours de la dernière expédition de Charlie et puis l’avait ramenée à son insu, cachée au milieu de son chargement de caisses après l’avoir copieusement soporifiquisée."
                            },
                            {
                                "example_id": "8a137886-efda-406e-85e7-fbc475b9e7a4",
                                "sense_id": "38078697-87c5-3fa3-b5af-778abc3baa9f",
                                "text": "normal, on est fliqué codé programmé logiciellisé outdoorisé insonorisé soporifiquisé envieucampeurisé et je te passe les 99% qui restent."
                            }
                        ]
                    }
