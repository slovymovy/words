                        "glosses": [
                            "het jaar dat iemand met een bepaalde activiteit begonnen is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b20c1a21-cfe1-4bb8-9271-a3ffa8667d51",
                                "sense_id": "742ef8da-2d67-3bd7-a9bf-4a52896dd2f5",
                                "text": "Er zat een flinke periode tussen het moment dat Marco van Basten Ajax verliet op 6 mei 2009 en zijn entree als trainer van SC Heerenveen. Hij tekende op 13 februari 2012 voor drie seizoenen. Ondanks een wisselvallig startjaar werden de Friezen achtste."
