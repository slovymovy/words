                        "cross_references": [
                            {
                                "target_word": "regularity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5750acf4-10c8-3b1b-a9df-deb141a54e55",
                                        "entry_id": "2fed6c0c-8ac3-311f-b796-f76bd8389e35",
                                        "glosses": [
                                            "The condition or quality of being regular"
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e09ed9b-688e-45ad-a664-a9ebfe6801ef",
                                                "sense_id": "5750acf4-10c8-3b1b-a9df-deb141a54e55",
                                                "text": "I have been watching that show with regularity."
                                            },
                                            {
                                                "example_id": "8ac15d33-546d-421b-8cb1-8f245ad38e2e",
                                                "sense_id": "5750acf4-10c8-3b1b-a9df-deb141a54e55",
                                                "text": "For Chelsea coach Andre Villas-Boas, this was his most sobering moment in the Premier League and he looked stunned on the sidelines at the regularity with which Chelsea's defence was exposed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49a239ea-8aaf-36af-88ba-5687d09f059a",
                                        "entry_id": "2fed6c0c-8ac3-311f-b796-f76bd8389e35",
                                        "glosses": [
                                            "A particular regular occurrence"
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "48478712-bb46-438c-84e4-2029b35b9c47",
                        "source_entry_id": "659e099f-ea70-3200-a943-dc7dc15777b4",
                        "source_sense_id": "f37e4faa-487e-3296-a7a9-8feb29400bf0",
                        "target_lang_word": "rhythm",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rhythm",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1f64a694-2483-310f-83e0-375471debb64",
                                        "entry_id": "fcb3db8a-7f6c-30e8-a076-c13fe570ba1d",
                                        "glosses": [
                                            "The variation of strong and weak elements (such as duration, accent) of sounds, notably in speech or music, over time; a beat or meter."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e799dabd-9053-44ff-b903-0a1b7189cd85",
                                                "sense_id": "1f64a694-2483-310f-83e0-375471debb64",
                                                "text": "Dance to the rhythm of the music."
                                            },
                                            {
                                                "example_id": "641c6ebb-8c0a-4d17-ba1c-d6fab7f66d65",
                                                "sense_id": "1f64a694-2483-310f-83e0-375471debb64",
                                                "text": "Hicks is both thwarter and thwartee of Daedalean plots. Aboard a train, the rhythm of the wheels sounds to him like \"wottachump, wottachump, wottachump.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89c006dc-6029-3a96-92aa-e49b0173cc8f",
                                        "entry_id": "fcb3db8a-7f6c-30e8-a076-c13fe570ba1d",
                                        "glosses": [
                                            "A specifically defined pattern of such variation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6167363-c6c2-453c-a952-bac2793f521c",
                                                "sense_id": "89c006dc-6029-3a96-92aa-e49b0173cc8f",
                                                "text": "Most dances have a rhythm as distinctive as the Iambic verse in poetry"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38842443-4cf6-3297-9251-578b9a42b4ae",
                                        "entry_id": "fcb3db8a-7f6c-30e8-a076-c13fe570ba1d",
                                        "glosses": [
                                            "A flow, repetition or regularity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1ba10ec-e836-4726-9425-36e3552d8e3d",
                                                "sense_id": "38842443-4cf6-3297-9251-578b9a42b4ae",
                                                "text": "Once you get the rhythm of it, the job will become easy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "192eb1cf-dcf2-3317-9be7-4ccae9479bca",
                                        "entry_id": "fcb3db8a-7f6c-30e8-a076-c13fe570ba1d",
                                        "glosses": [
                                            "The tempo or speed of a beat, song or repetitive event."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8116c5f3-016e-4ea4-961c-6f3ed06863bf",
                                                "sense_id": "192eb1cf-dcf2-3317-9be7-4ccae9479bca",
                                                "text": "We walked with a quick, even rhythm."
                                            },
                                            {
                                                "example_id": "8cdbe44e-a722-4e5d-b2e3-a068054fec20",
                                                "sense_id": "192eb1cf-dcf2-3317-9be7-4ccae9479bca",
                                                "text": "If you hum or whistle the rhythm of the common English metres,— of the decasyllabic quatrain, or the octosyllabic with alternate sexisyllabic, or other rhythms, […]"
                                            },
                                            {
                                                "example_id": "52827ad1-7918-4fc3-b60b-a4bafba38126",
                                                "sense_id": "192eb1cf-dcf2-3317-9be7-4ccae9479bca",
                                                "text": "Bigeminous rhythm was followed by bursts of extrasystoles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb6e2e53-388b-3b03-89ad-3f73d6e58342",
                                        "entry_id": "fcb3db8a-7f6c-30e8-a076-c13fe570ba1d",
                                        "glosses": [
                                            "The musical instruments which provide rhythm (mainly; not or less melody) in a musical ensemble."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69e4a2f9-d844-4e17-8178-03506a32590a",
                                                "sense_id": "bb6e2e53-388b-3b03-89ad-3f73d6e58342",
                                                "text": "The Baroque term basso continuo is virtually equivalent to rhythm"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f92f55e-9f00-3fd2-9190-474be97a4019",
                                        "entry_id": "fcb3db8a-7f6c-30e8-a076-c13fe570ba1d",
                                        "glosses": [
                                            "A regular quantitative change in a variable (notably natural) process."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d2e7ac4-dfd8-429d-8f84-00b0669759cd",
                                                "sense_id": "7f92f55e-9f00-3fd2-9190-474be97a4019",
                                                "text": "The rhythm of the seasons dominates agriculture as well as wildlife"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61332187-f3de-3a24-becd-4962fafd3e2c",
                                        "entry_id": "fcb3db8a-7f6c-30e8-a076-c13fe570ba1d",
                                        "glosses": [
                                            "Controlled repetition of a phrase, incident or other element as a stylistic figure in literature and other narrative arts; the effect it creates."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e76e36ba-c327-47aa-bb9c-cab1a1501020",
                                                "sense_id": "61332187-f3de-3a24-becd-4962fafd3e2c",
                                                "text": "The running gag is a popular rhythm in motion pictures and theater comedy"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9662d3f-0ccb-39f7-ac11-85200356d925",
                                        "entry_id": "fcb3db8a-7f6c-30e8-a076-c13fe570ba1d",
                                        "glosses": [
                                            "A person's natural feeling for rhythm."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb5e1835-56de-4ffa-9088-42bd5f703192",
                                                "sense_id": "e9662d3f-0ccb-39f7-ac11-85200356d925",
                                                "text": "That girl's got rhythm, watch her dance!"
                                            },
                                            {
                                                "example_id": "5a3b905b-f093-46a9-a08c-759c0a59908f",
                                                "sense_id": "e9662d3f-0ccb-39f7-ac11-85200356d925",
                                                "text": "I'm never gonna dance again / Guilty feet have got no rhythm"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rhythm",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e753ab54-6338-3471-9be1-de520dcb7ec2",
                                        "entry_id": "5c7e5db9-aab7-3337-9c90-e7c9df63b462",
                                        "glosses": [
                                            "To impart a (particular) rhythm to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f643f1d-981e-425c-b4fb-d1007e8f7aa1",
                                                "sense_id": "e753ab54-6338-3471-9be1-de520dcb7ec2",
                                                "text": "The pamphlet, writes Muray, 'is the supremely affirmative form in which nothing can be turned around, rhythmed or played with in synonyms and rhymes'."
                                            },
                                            {
                                                "example_id": "74a44096-6bc0-4c2f-aa86-71a867d82e12",
                                                "sense_id": "e753ab54-6338-3471-9be1-de520dcb7ec2",
                                                "text": "And so the microchip, say, reflects a certain electronically driven speed of society, just as the invention of a flint axe, reflected a society that was rhythmed fully by biological and environmental temporalities."
                                            },
                                            {
                                                "example_id": "3c487d94-d861-48f0-bebc-419db14f942f",
                                                "sense_id": "e753ab54-6338-3471-9be1-de520dcb7ec2",
                                                "text": "ISP places are, therefore, not only considered places of teaching and learning performances (see point 4): the different locations rhythmed the entire programme."
                                            },
                                            {
                                                "example_id": "163ed332-73b6-4d76-af5f-1e86b3106799",
                                                "sense_id": "e753ab54-6338-3471-9be1-de520dcb7ec2",
                                                "text": "rhythmed by a television show and a meal, as we grow older, things change. rhythmed by a baby's cry and school holidays, as we grow older, things change. rhythmed by monthly bills and a husband's envies, as we grow older, some things never change."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "66886f0b-0794-4efb-bb20-0d883edbd465",
                        "source_entry_id": "659e099f-ea70-3200-a943-dc7dc15777b4",
                        "source_sense_id": "f37e4faa-487e-3296-a7a9-8feb29400bf0",
                        "target_lang_word": "rythme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rythme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "569a49bf-3781-30f1-ae6b-2ec30939c836",
                                        "entry_id": "88026f06-0c23-3c74-a1ef-2f65c50b183b",
                                        "glosses": [
                                            "Nombre ; cadence ; mesure ; fréquence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "495dc31b-87c2-40a9-a97f-934a18fc2ee1",
                                                "sense_id": "569a49bf-3781-30f1-ae6b-2ec30939c836",
                                                "text": "Poète, il voulait être poète, créer des rythmes nouveaux, des sensations neuves et souffler au ciel toutes les sottises qui tourbillonnaient dans son cerveau."
                                            },
                                            {
                                                "example_id": "8cd3d0b0-ce1c-4133-98f8-671d66c3c392",
                                                "sense_id": "569a49bf-3781-30f1-ae6b-2ec30939c836",
                                                "text": "On préfère construire un roman, qu'on déroule à sa guise, au rythme que l'on choisit, on l'illustre d'images d'Épinal aux coloriages grossiers, aux violentes couleurs."
                                            },
                                            {
                                                "example_id": "09ec451a-ce32-4df4-8db1-12dd6d2342fd",
                                                "sense_id": "569a49bf-3781-30f1-ae6b-2ec30939c836",
                                                "text": "Ils changent d'activité au rythme des saisons, fabriquent des charpagnes ou cherchent dans les bois les plantes médicinales."
                                            },
                                            {
                                                "example_id": "a39f8126-08a7-4794-84b1-ddcb0a0ab7a1",
                                                "sense_id": "569a49bf-3781-30f1-ae6b-2ec30939c836",
                                                "text": "Il y organise son propre travail et peut même y être rejoint par sa famille, durant les mois d'été, puisque le rythme bisannuel impose entre quatre et six mois de « belle saison » sur le littoral - […] - et le reste à Paris ([…])."
                                            },
                                            {
                                                "example_id": "45c9274e-ec19-491d-9af7-07fc3d20a907",
                                                "sense_id": "569a49bf-3781-30f1-ae6b-2ec30939c836",
                                                "text": "Quand la jeune femme appuya sur la télécommande pour verrouiller sa voiture, les clignotants bipèrent en rythme avec les lointains échos de musique et de rires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2501ec4f-4a2d-3a9b-b0a0-03f10f075fde",
                                        "entry_id": "88026f06-0c23-3c74-a1ef-2f65c50b183b",
                                        "glosses": [
                                            "Proportion des durées de notes suivant la variation des temps forts et des temps faibles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10dc59c6-7867-4f34-88e9-437ddeb8a25c",
                                                "sense_id": "2501ec4f-4a2d-3a9b-b0a0-03f10f075fde",
                                                "text": "Je me trouvais précisément dans l'un de ces débits et m'y acoquinais au rythme d'un vague accordéon."
                                            },
                                            {
                                                "example_id": "aa1497ee-4656-4d21-943a-9b025c907e46",
                                                "sense_id": "2501ec4f-4a2d-3a9b-b0a0-03f10f075fde",
                                                "text": "Bien accompagnée par des musiciens talentueux dont l’harmoniciste inspiré, Vincent Bucher, Joyce Tape a chanté, dansé au rythme du blues."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbc3ddf1-4638-3f01-b1b6-040e66691b53",
                                        "entry_id": "88026f06-0c23-3c74-a1ef-2f65c50b183b",
                                        "glosses": [
                                            "Succession répétitive d'une variable physiologique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d8aaebb-8fe6-431d-b375-437b08669981",
                                                "sense_id": "cbc3ddf1-4638-3f01-b1b6-040e66691b53",
                                                "text": "Les rythmes circadiens."
                                            },
                                            {
                                                "example_id": "c0bda2a7-3b98-4090-af08-7f8f9e18d6f5",
                                                "sense_id": "cbc3ddf1-4638-3f01-b1b6-040e66691b53",
                                                "text": "Le rythme de sécrétion d'une hormone."
                                            }
                                        ]
                                    }
                                ]
                            },
