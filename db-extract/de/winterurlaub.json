                "senses": [
                    {
                        "sense_id": "ca0f9b7d-e083-3af5-8738-8c27af833826",
                        "entry_id": "09631505-4235-3406-8a0f-baea6d75ddaa",
                        "glosses": [
                            "Urlaub im Winter, meist in Gebieten mit Möglichkeiten, Wintersport (wie Skifahren) zu machen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae0a988a-c5b1-4a3a-9384-c4b2932c1c5d",
                                "sense_id": "ca0f9b7d-e083-3af5-8738-8c27af833826",
                                "text": "„[…] in Zukunft müssen wir uns immer häufiger auf einen Winterurlaub mit Matsch statt Schnee einstellen.“"
                            },
                            {
                                "example_id": "85e2877a-219a-4139-86a5-c473cd8a4261",
                                "sense_id": "ca0f9b7d-e083-3af5-8738-8c27af833826",
                                "text": "Im Winterurlaub gehe ich gerne Skifahren."
                            },
                            {
                                "example_id": "8e044d32-bda2-4ebc-87d4-e704ce3187ca",
                                "sense_id": "ca0f9b7d-e083-3af5-8738-8c27af833826",
                                "text": "„Viele wollen ihren Winterurlaub im Schnee verbringen.“"
                            },
                            {
                                "example_id": "cd309d11-1b37-40b0-ae4f-411f61eedecb",
                                "sense_id": "ca0f9b7d-e083-3af5-8738-8c27af833826",
                                "text": "Man kann den Winterurlaub auch in der Sonne, beispielsweise auf den Kanaren, verbringen."
                            },
                            {
                                "example_id": "42d4065d-44e4-4754-bfab-78654dc78be6",
                                "sense_id": "ca0f9b7d-e083-3af5-8738-8c27af833826",
                                "text": "[St. Moritz:] „1864 lud nach der Legende der […] Hotelier Johannes Badrutt die ersten englischen Touristen zu einem Winterurlaub ein, […].“"
                            },
                            {
                                "example_id": "bda38b87-139d-473e-b198-ed48fc4a64be",
                                "sense_id": "ca0f9b7d-e083-3af5-8738-8c27af833826",
                                "text": "„Popstar Madonna verbringt regelmässig ihren Winterurlaub in Gstaad.“"
                            },
                            {
                                "example_id": "0ed13381-dee9-418f-ab31-cd3f152ed1cd",
                                "sense_id": "ca0f9b7d-e083-3af5-8738-8c27af833826",
                                "text": "„Die Harzer Wintersportgebiete können in den Ausmaßen zwar nicht mit den Alpen konkurrieren, bieten aber den norddeutschen Wintersportenthusiasten eine nahegelegene Alternative für ein Skiwochenende oder auch einen längeren Winterurlaub.“"
                            },
                            {
                                "example_id": "c4f13a1d-5503-4d3f-a1ee-d6717bbdaf5b",
                                "sense_id": "ca0f9b7d-e083-3af5-8738-8c27af833826",
                                "text": "„Um die Folgen des Winterurlaubs für Umwelt und Klima zumindest zu verringern, empfiehlt es sich, direkt bei der Anreise anzufangen: Die Fahrt mit der Bahn ist deutlich weniger emissionsreich als das Flugzeug oder Auto zu nehmen.“"
                            },
                            {
                                "example_id": "9e40f206-0593-4798-ad3c-92a460391be7",
                                "sense_id": "ca0f9b7d-e083-3af5-8738-8c27af833826",
                                "text": "„[…] auch vor Ort kann man auf die Klimaverträglichkeit des eigenen Winterurlaubs achten.“"
                            },
                            {
                                "example_id": "dc6b26d4-a8c3-456d-829e-cf0d5bc276ef",
                                "sense_id": "ca0f9b7d-e083-3af5-8738-8c27af833826",
                                "text": "„[…] der weiße Schnee in den Wintersportgebieten reflektiert das energiereiche UV-Licht viel stärker als andere Hintergründe. Wer ohne Augenschutz in den Winterurlaub fährt, riskiert daher Verbrennungen an der Hornhaut.“"
                            },
                            {
                                "example_id": "54e25693-703d-4227-b452-f2b16ef7fa85",
                                "sense_id": "ca0f9b7d-e083-3af5-8738-8c27af833826",
                                "text": "[Coronapandemie 2020:] „Auffallend viele Rückkehrer aus dem Winterurlaub in Tirol und dem angrenzenden Vorarlberg sind inzwischen über Europa verteilt am Coronavirus erkrankt.“"
                            },
                            {
                                "example_id": "60a76fe3-a6dc-4b29-aede-4f36a5dcc85c",
                                "sense_id": "ca0f9b7d-e083-3af5-8738-8c27af833826",
                                "text": "[Coronapandemie 2020:] „Während in Tirol die Schneekanonen laufen und die Pisten vorsorglich beschneit werden, warnen maßgebliche Herkunftsländer der Gäste vor der Infektionsgefahr im Winterurlaub.“"
                            },
                            {
                                "example_id": "140f3560-3141-4ee2-b1e6-6ea1df8abcc5",
                                "sense_id": "ca0f9b7d-e083-3af5-8738-8c27af833826",
                                "text": "[Coronapandemie 2020:] „Bundeskanzlerin Angela Merkel sprach sich mit Blick auf Winterurlaube dafür aus, dass alle Skigebiete in Europa schließen.“"
                            },
                            {
                                "example_id": "35913632-2f9d-4cc6-8777-a708e07c3908",
                                "sense_id": "ca0f9b7d-e083-3af5-8738-8c27af833826",
                                "text": "„Ihren Winterurlaub scheinen viele wegen der derzeitigen Corona-Pandemie bereits abgeschrieben zu haben.“"
                            },
                            {
                                "example_id": "047af739-6fde-4748-8a49-d95dba4253fb",
                                "sense_id": "ca0f9b7d-e083-3af5-8738-8c27af833826",
                                "text": "„In Zermatt zeigt sich das gleiche Bild. Auch hier streichen reiche Russen ihren Winterurlaub, wenn auch in geringer Zahl.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
