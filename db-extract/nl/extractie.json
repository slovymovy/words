                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aaa48af8-bfc2-4c1a-8793-0b85fd19244f",
                                                "sense_id": "837705fd-0567-39d8-ac56-11cf58cfc98c",
                                                "text": "They [books] do preserve as in a vial the purest efficacy and extraction of that living intellect that bred them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afe64311-f4b4-3ddc-95ac-33496259970a",
                                        "entry_id": "1d75e968-fbcf-3871-ad22-3e9268b6fa6c",
                                        "glosses": [
                                            "A person's origin or ancestry."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77ffa510-9662-4467-80c0-c10bbb59f4ee",
                                                "sense_id": "afe64311-f4b4-3ddc-95ac-33496259970a",
                                                "text": "Our companion on these tours was a young tourist, an American of Russian extraction, whose questions and remarks drew our attention to some details of Haifa life that have become too familiar and would have otherwise passed unnoticed. ..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1696ef21-917c-3121-af0e-798e3946bed6",
                                        "entry_id": "1d75e968-fbcf-3871-ad22-3e9268b6fa6c",
                                        "glosses": [
                                            "An act of removing someone from a hostile area to a secure location."
                                        ],
