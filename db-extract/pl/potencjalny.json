                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "potenziell",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "23ed24b8-59ed-38d0-be95-f79b8942b7e6",
                                        "entry_id": "dc568e39-a767-3a5c-bf99-199baa5b90d6",
                                        "glosses": [
                                            "nach Möglichkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96c0b078-1340-4514-8307-9c48a0cdf226",
                                                "sense_id": "23ed24b8-59ed-38d0-be95-f79b8942b7e6",
                                                "text": "Man muss die potenziellen Gewinne deutlich von den tatsächlichen unterscheiden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b1dae9e4-10c7-4ae0-b773-d248d7ac6f47",
                        "source_entry_id": "5e6e324e-b0e7-3129-bcc9-424bb1b82bd5",
