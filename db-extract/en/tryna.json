                            {
                                "example_id": "9f66e3dd-c0c5-4b2f-b13d-4f944a322507",
                                "sense_id": "b952c094-3383-3fea-983d-a6616d17951f",
                                "text": "You get caught in the middle, tryna dribble on my court"
                            },
                            {
                                "example_id": "73af668a-0522-4483-92ea-d608e676ee58",
                                "sense_id": "b952c094-3383-3fea-983d-a6616d17951f",
                                "text": "[…] Mr. Kelly’s verse outshines all the others (“I’m tryna keep it R&B/But these streets is a part of me,” he sings, ascending into falsetto); he gives the chorus a tuneful makeover too."
                            },
                            {
                                "example_id": "9f828348-03b9-4c03-8e33-00155a691d44",
                                "sense_id": "b952c094-3383-3fea-983d-a6616d17951f",
                                "text": "Catch me up in snowin, in my sliders and my shorts / Chicks tryna get my brotha Flips to share his thoughts"
                            },
                            {
                                "example_id": "13a7eb5c-44a4-42b1-b55f-8729808b3db4",
                                "sense_id": "b952c094-3383-3fea-983d-a6616d17951f",
                                "text": "You're beautiful, but misunderstood / So why you tryna be just like the neighborhood?"
                            },
                            {
                                "example_id": "35d5208b-d405-4f4f-b329-deebd64d2d63",
                                "sense_id": "b952c094-3383-3fea-983d-a6616d17951f",
                                "text": "Kissy face, kissy face / Sent to your phone, but / I'm tryna kiss your lips for real (uh-huh, uh-huh)"
