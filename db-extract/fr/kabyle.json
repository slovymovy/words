                ],
                "senses": [
                    {
                        "sense_id": "78b2299b-b27b-36a2-b458-f80d24d5e6ac",
                        "entry_id": "57f88931-6a08-342c-aeeb-2bf53e13b0ba",
                        "glosses": [
                            "Habitant(e) ou personne originaire de Kabylie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2568f44a-4690-477b-a677-bc3dd1b4fef0",
                                "sense_id": "78b2299b-b27b-36a2-b458-f80d24d5e6ac",
                                "text": "Avant la conquête française, la Kabylie ne connaissait pas d’autre mode de répression que la vengeance privée et les Kabyles n’étaient pas de mauvaises gens."
                            },
                            {
                                "example_id": "85d75ad2-c932-4f35-a242-6289c0dda1c8",
                                "sense_id": "78b2299b-b27b-36a2-b458-f80d24d5e6ac",
                                "text": "Chez les colons, nous trouvons un pourcentage élevé de gens venus de Corse, de Malte, d’Espagne… Or, les Corses sont ethniquement plus proches des Kabyles et des Chaouia que des Provençaux."
                            },
                            {
                                "example_id": "1cce0145-326b-45a7-87ef-e9569f1b8ab0",
                                "sense_id": "78b2299b-b27b-36a2-b458-f80d24d5e6ac",
                                "text": "Les Kabyles luttent pour la reconnaissance de leur culture berbère et en particulier de leur langue, la tamazight."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
