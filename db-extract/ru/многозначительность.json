                    {
                        "translation_id": "2b1788fb-b2ea-4de5-ae8e-3adb29cdb278",
                        "source_entry_id": "eed70ae1-2b2c-3ab4-94ea-2542af89a05d",
                        "source_sense_id": "b2843b33-0b3e-3b7b-843f-8dc09b15bc72",
                        "target_lang_word": "Bedeutsamkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bedeutsamkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "875565ba-475d-3370-bf28-4aadd0f6ecb5",
                                        "entry_id": "431ced26-cfa0-3203-a0f6-60a849736903",
                                        "glosses": [
                                            "Eigenschaft, bedeutsam, wichtig, ausschlaggebend zu sein; Wichtigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "087414e0-12f3-4bb5-a149-274a73ee82fe",
                                                "sense_id": "875565ba-475d-3370-bf28-4aadd0f6ecb5",
                                                "text": "„In der Corona-Pandemie zeigt sich die ungeheure Bedeutsamkeit des Individuums in der modernen Gesellschaft.“"
                                            },
                                            {
                                                "example_id": "1840a7c7-73ee-44df-afee-b09a4862b93b",
                                                "sense_id": "875565ba-475d-3370-bf28-4aadd0f6ecb5",
                                                "text": "„Der Glanz und die Farbe stechen hervor und machen die Bedeutsamkeit des Anlasses deutlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9cc8a198-a9c1-3bad-a2d6-19254330b103",
                                        "entry_id": "431ced26-cfa0-3203-a0f6-60a849736903",
                                        "glosses": [
                                            "Sinn von etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16635d33-8716-462c-b47e-217d1f156cc9",
                                                "sense_id": "9cc8a198-a9c1-3bad-a2d6-19254330b103",
                                                "text": "„Ich wollte die tiefe Bedeutsamkeit von allem, was geschehen war, nicht abschwächen, deshalb schaltete ich weder den Fernsehapparat an noch nahm ich ein Buch zur Hand oder zerstreute mich auf irgendeine andere Weise.“"
                                            },
                                            {
                                                "example_id": "7fabda17-9cec-4ffb-8ccc-4f3318bb7158",
                                                "sense_id": "9cc8a198-a9c1-3bad-a2d6-19254330b103",
                                                "text": "„Die Idee der Feier war echt künstlerisch aufgefasst und geschmackvoll und glänzend ausgeführt; die musikalische Begleitung, die Dichtung gaben die tiefe Bedeutsamkeit des Festes schön und ansprechend wieder.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8423645f-74df-49e7-b2fa-5ca1ea09d31e",
                        "source_entry_id": "eed70ae1-2b2c-3ab4-94ea-2542af89a05d",
                        "source_sense_id": "b2843b33-0b3e-3b7b-843f-8dc09b15bc72",
                        "target_lang_word": "importance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "importance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bab8649e-8444-31a8-8029-005ea7504978",
                                        "entry_id": "6697d7cd-51d8-3a22-8eb9-35b052d20bbe",
                                        "glosses": [
                                            "Ce qui fait qu’une chose est d’un grand intérêt, est considérable par elle-même, ou par les circonstances qui l’accompagnent, ou par les suites qu’elle peut avoir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0ec89a5-6978-4702-8610-0eb28c279b30",
                                                "sense_id": "bab8649e-8444-31a8-8029-005ea7504978",
                                                "text": "Le soldat des guerres de la Liberté attachait une importance presque supersti­tieuse à l’accomplissement des moindres consignes. De là résulte qu'il n'éprouvait aucune pitié pour les généraux ou les fonctionnaires qu'il voyait guillotiner après quelque défaite, sous l'inculpation de manquement à leur devoir ; […]."
                                            },
                                            {
                                                "example_id": "df590c33-9cdc-4c3c-8ce9-898c2d6e25ae",
                                                "sense_id": "bab8649e-8444-31a8-8029-005ea7504978",
                                                "text": "Le proviseur adjoint l'écoute poliment et acquiesce à ses suggestions, le valorise et lui donne de l’importance. Je ne sais pas s'il est sincère."
                                            },
                                            {
                                                "example_id": "e3234a8c-305f-4e4e-9afb-7d6d524d4dc1",
                                                "sense_id": "bab8649e-8444-31a8-8029-005ea7504978",
                                                "text": "En toutes choses, il est d’une grande importance de bien commencer."
                                            },
                                            {
                                                "example_id": "c06d4a81-e537-4cc1-b9a7-bec914fad1e5",
                                                "sense_id": "bab8649e-8444-31a8-8029-005ea7504978",
                                                "text": "Mettre, attacher de l’importance à une chose, La considérer comme ayant beaucoup d’importance."
                                            },
                                            {
                                                "example_id": "25fa5f74-a8b6-41c1-b63b-c68520904943",
                                                "sense_id": "bab8649e-8444-31a8-8029-005ea7504978",
                                                "text": "Il attache de l’importance aux plus petites choses."
                                            },
                                            {
                                                "example_id": "f7534012-1314-4075-8e61-1159382feb76",
                                                "sense_id": "bab8649e-8444-31a8-8029-005ea7504978",
                                                "text": "Je n’attache pas d’importance à ma tenue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16071726-4f3f-3eef-91a3-b22ffe77abf1",
                                        "entry_id": "6697d7cd-51d8-3a22-8eb9-35b052d20bbe",
                                        "glosses": [
                                            "Caractère de ce qui est considérable en nombre, en quantité, en volume, en dimension."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "813ba44c-a468-4281-945e-74c701100853",
                                                "sense_id": "16071726-4f3f-3eef-91a3-b22ffe77abf1",
                                                "text": "Les mauvaises herbes sont pour l'agriculture de tous les pays un fléau dont il est malaisé de chiffrer l’importance."
                                            },
                                            {
                                                "example_id": "311e751e-8136-4933-9516-39780f60153e",
                                                "sense_id": "16071726-4f3f-3eef-91a3-b22ffe77abf1",
                                                "text": "Les seuls marchés qui aient conservé quelque importance sont ceux de Formerie, de Gournay et de Songeons. Le premier dépasse de beaucoup tous les autres, même celui de Gournay."
                                            },
                                            {
                                                "example_id": "30bd58cf-f4e2-4d48-bd49-cc4b472553c1",
                                                "sense_id": "16071726-4f3f-3eef-91a3-b22ffe77abf1",
                                                "text": "L’importance de la diffusion à Paris explique en partie la faiblesse des invendus, qui atteignent environ 20-22 % des exemplaires fournis aux NMPP, et par conséquent la facilité des réglages."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cdb1fad2-fd86-33b5-b716-60ced935fa59",
                                        "entry_id": "6697d7cd-51d8-3a22-8eb9-35b052d20bbe",
                                        "glosses": [
                                            "Autorité, crédit, influence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b618ffd-724f-4b8b-b040-269f8509888d",
                                                "sense_id": "cdb1fad2-fd86-33b5-b716-60ced935fa59",
                                                "text": "Ils pensent en effet que le luxe vestimentaire est proportionnel à l'importance et à la renommée d'un individu : […]."
                                            },
                                            {
                                                "example_id": "d396d107-54ec-4c5b-8dee-91a2166d4387",
                                                "sense_id": "cdb1fad2-fd86-33b5-b716-60ced935fa59",
                                                "text": "Cette place lui donne beaucoup d’importance dans le monde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67654ab0-a551-3570-8287-7e2c916ba829",
                                        "entry_id": "6697d7cd-51d8-3a22-8eb9-35b052d20bbe",
                                        "glosses": [
                                            "Caractère de ceux qui montrent de l’orgueil, de la vanité et veulent paraître plus considérables qu’ils ne le sont réellement."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd0b8be5-bbbe-464f-9349-153ad65fda25",
                                                "sense_id": "67654ab0-a551-3570-8287-7e2c916ba829",
                                                "text": "Prendre un ton d’importance."
                                            },
                                            {
                                                "example_id": "a6a00c1b-d426-4262-8f7a-5000f5e2cb1f",
                                                "sense_id": "67654ab0-a551-3570-8287-7e2c916ba829",
                                                "text": "Il se donne des airs d’importance qui choquent tout le monde."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "23b3eacb-bbaf-45da-a210-ee8ee69e505c",
                        "source_entry_id": "eed70ae1-2b2c-3ab4-94ea-2542af89a05d",
                        "source_sense_id": "b2843b33-0b3e-3b7b-843f-8dc09b15bc72",
                        "target_lang_word": "gravité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gravité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d25723f9-5a44-3cd3-bb17-948f383db25c",
                                        "entry_id": "e3529f02-a440-3b10-9a97-e7681319d873",
                                        "glosses": [
                                            "Champ de force gravitationnel d’un corps massif ; pesanteur."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c697853-3510-4418-8f53-3c3b3be3e0aa",
                                                "sense_id": "d25723f9-5a44-3cd3-bb17-948f383db25c",
                                                "text": "La matière solide contenue dans la vis reste dans la zone d’interpénétration ou tombe par gravité dans la partie basse du chenal, où elle est poussée par les filets arrières […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "082d3645-88fa-3135-96ef-f477c6379cc5",
                                        "entry_id": "e3529f02-a440-3b10-9a97-e7681319d873",
                                        "glosses": [
                                            "Sentiment ou qualité d’une personne ou d’une chose grave ; l’air, le ton grave et sérieux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc3711e8-6b62-4203-a5d9-1c3b332f7cd6",
                                                "sense_id": "082d3645-88fa-3135-96ef-f477c6379cc5",
                                                "text": "[…] en outre, la gravité de son maintien et de son langage, et aussi bien le ton sonore qu’il affectait en parlant de l’autorité de l’Église et du clergé, engageait chacun à le tenir presque en odeur de sainteté."
                                            },
                                            {
                                                "example_id": "38333746-5df6-4e4f-b918-bbf48db99458",
                                                "sense_id": "082d3645-88fa-3135-96ef-f477c6379cc5",
                                                "text": "Lorsque tout le monde fut assis, il y eut un moment de silence, pendant lequel la gravité du président parut se communiquer à l’assemblée."
                                            },
                                            {
                                                "example_id": "1fda53d4-edc4-4723-9f4f-62082e041878",
                                                "sense_id": "082d3645-88fa-3135-96ef-f477c6379cc5",
                                                "text": "La physionomie de la Renaude prit une expression de gravité et de tristesse profonde."
                                            },
                                            {
                                                "example_id": "4b7afdfe-e984-48c0-8b5f-d00e944c78fb",
                                                "sense_id": "082d3645-88fa-3135-96ef-f477c6379cc5",
                                                "text": "L’animal sortait de sa torpeur, ouvrait ses yeux d’or, faisait mine d’allonger sa patte griffue. Puis il bâillait voluptueusement, et se rendormait aussitôt ; car c’était une bête raisonnable, à qui l’âge avait donné toutes sortes de gravités."
                                            },
                                            {
                                                "example_id": "10e6e31c-6084-40ee-8a93-6628c46dd43d",
                                                "sense_id": "082d3645-88fa-3135-96ef-f477c6379cc5",
                                                "text": "Une question doit alors être posée dans toute sa gravité : en France, l’antisémitisme nouveau est-il arrivé sous le couvert de l’antisionisme ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba04312f-bfa9-3b20-8b88-8cb92293db1f",
                                        "entry_id": "e3529f02-a440-3b10-9a97-e7681319d873",
                                        "glosses": [
                                            "Grande importance ; lourde conséquence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e17a864-0dba-4e07-a197-bca5395e7c7e",
                                                "sense_id": "ba04312f-bfa9-3b20-8b88-8cb92293db1f",
                                                "text": "Cette gravité de l’œuvre poursuivie par le prolétariat ne saurait convenir à la clientèle jouisseuse de nos politiciens."
                                            },
                                            {
                                                "example_id": "374c3026-ff82-4a9d-95a6-c9a72a1bea2a",
                                                "sense_id": "ba04312f-bfa9-3b20-8b88-8cb92293db1f",
                                                "text": "Je ne me pardonne pas d’être né. C’est comme si, en m’insinuant dans ce monde, j’avais […] commis une faute d’une gravité sans nom."
                                            },
                                            {
                                                "example_id": "a565f452-282d-4914-9276-c9f5031f1edd",
                                                "sense_id": "ba04312f-bfa9-3b20-8b88-8cb92293db1f",
                                                "text": "On connait plus de 300 arbovirus, et on en isole toujours de nouveaux […] Parmi les infections qu’ils provoquent, il faut citer à cause de leur grande incidence et de leur gravité la fièvre jaune, les méningo-encéphalites américaines, l’encéphalite japonaise B."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38050bed-3c85-3f53-b922-36ed1d09b367",
                                        "entry_id": "e3529f02-a440-3b10-9a97-e7681319d873",
                                        "glosses": [
                                            "Caractère d’un son quelconque par rapport aux sons plus élevés, dans l’échelle générale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e871affe-3e36-48f9-bf48-616ea9e49014",
                                                "sense_id": "38050bed-3c85-3f53-b922-36ed1d09b367",
                                                "text": "Un son a plus ou moins de gravité selon que la corde qui le rend a plus ou moins de grosseur, plus ou moins de longueur."
                                            }
                                        ]
                                    }
