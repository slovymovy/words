                "senses": [
                    {
                        "sense_id": "d0f04cbe-2e9f-3077-a941-1ba431f866af",
                        "entry_id": "f48c418c-d620-3654-ae33-004aa52ae6e2",
                        "glosses": [
                            "(Fort-)Bildungsveranstaltung, die eine andere fortsetzt/weiterführt"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "ef8c3cde-ddcb-484b-b52d-2b7ba8c55823",
                                "sense_id": "d0f04cbe-2e9f-3077-a941-1ba431f866af",
                                "text": "„Drei Kinder und ein Vollzeitstudium sind nicht leicht unter einen Hut zu bekommen, erst recht, wenn viele Lehrveranstaltungen am Nachmittag stattfinden - wie aktuell die Ringvorlesung ‚Einführung in die neue deutsche Literatur‘, die die dreifache Mutter besuchen muss, um im nächsten Semester an der Universität Hamburg das entsprechende Aufbauseminar belegen zu können.“"
                            },
                            {
                                "example_id": "516711a4-3ebf-4ad6-87e6-f06d62a35fe5",
                                "sense_id": "d0f04cbe-2e9f-3077-a941-1ba431f866af",
                                "text": "„ In einem Basis- und einem Aufbauseminar, das jeweils drei Wochenenden beansprucht, werden sie auf ihre Einsätze vorbereitet; zu absolvieren sind insgesamt 80 Unterrichtseinheiten.“"
                            },
                            {
                                "example_id": "6145b7b3-c6e1-4915-8a10-60e54286ff1e",
                                "sense_id": "d0f04cbe-2e9f-3077-a941-1ba431f866af",
                                "text": "„Neue Erkenntnisse konnten 79 Prozent der Auszubildenden im Aufbauseminar gewinnen.“"
                            },
                            {
                                "example_id": "6b7501cc-fefc-4b12-85a6-99c822f7f186",
                                "sense_id": "d0f04cbe-2e9f-3077-a941-1ba431f866af",
                                "text": "„Aufbauseminare vermitteln Kompetenzen zur eigenständigen Anwendung geschichtswissenschaftlicher Methoden auf ausgewählte Themen.“"
                            },
                            {
                                "example_id": "2322654e-d469-4ab3-888d-fd116def07e8",
                                "sense_id": "d0f04cbe-2e9f-3077-a941-1ba431f866af",
                                "text": "„Dieses Aufbauseminar ‐ für Einsteiger wird das Training ‚Interkulturelle Kommunikation‘ empfohlen ‐ verknüpft die Bereiche Interkulturelle Theorien und Personalführung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "24751103-70ae-3209-9d46-18719d933e5c",
                        "entry_id": "f48c418c-d620-3654-ae33-004aa52ae6e2",
                        "glosses": [
                            "von der Fahrerlaubnisbehörde angeordnetes Seminar bei Verstößen im Straßenverkehr innerhalb der Probezeit"
                        ],
                        "tags": [
                            "Germany",
                            "special"
                        ],
                        "examples": [
                            {
                                "example_id": "d92f8a7a-a29b-48f4-a971-ffb2fbd67e02",
                                "sense_id": "24751103-70ae-3209-9d46-18719d933e5c",
                                "text": "Weil er den Mindestabstand erheblich unterschritten hatte, musste er ein Aufbauseminar besuchen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
