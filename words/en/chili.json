{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e66c0323-71b9-3b19-9b2f-368f6e2c1b35",
                    "sense_definition": "The pungent, spicy fresh or dried fruit of a capsicum pepper plant, used in cooking to add heat.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "food_ingredient",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She chopped a red <w>chili</w> to add some spice to the curry sauce.",
                            "target_lang_translations": {
                                "ru": "Она нарезала красный <w>перец чили</w>, чтобы добавить остроты в соус карри.",
                                "zh": "她切了一个红<w>辣椒</w>，给咖喱酱增添了一些辣味。"
                            }
                        },
                        {
                            "text": "Be careful not to touch your eyes after handling a hot <w>chili</w>.",
                            "target_lang_translations": {
                                "ru": "Будьте осторожны и не касайтесь глаз после того, как трогали острый <w>чили</w>.",
                                "zh": "处理完辣<w>辣椒</w>后，千万不要揉眼睛。"
                            }
                        }
                    ],
                    "synonyms": [
                        "chili pepper",
                        "hot pepper"
                    ],
                    "common_phrases": [
                        "red chili",
                        "green chili",
                        "hot chili",
                        "fresh chili"
                    ],
                    "target_lang_definitions": {
                        "ru": "Острый свежий или сушеный плод стручкового перца, используемый в кулинарии для придания остроты.",
                        "zh": "一种辛辣的辣椒，常用于烹饪以增加辣味。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перец чили",
                                "target_lang_sense_clarification": "плод"
                            },
                            {
                                "target_lang_word": "чили",
                                "target_lang_sense_clarification": "перец"
                            },
                            {
                                "target_lang_word": "красный перец",
                                "target_lang_sense_clarification": "острый"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "辣椒",
                                "target_lang_sense_clarification": "指辣椒这种植物或果实"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6a0c779a-0b83-3d35-9bee-be2de90a6af2",
                    "sense_definition": "A spicy stew made with chili peppers, meat (usually beef), and often beans and tomatoes.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "food_dish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We cooked a large pot of beef <w>chili</w> for the family dinner.",
                            "target_lang_translations": {
                                "ru": "Мы приготовили большую кастрюлю <w>чили</w> с говядиной на семейный ужин.",
                                "zh": "我们为家庭晚餐做了一大锅牛肉<w>辣肉酱</w>。"
                            }
                        },
                        {
                            "text": "He likes to eat a bowl of <w>chili</w> with cheese and sour cream on top.",
                            "target_lang_translations": {
                                "ru": "Ему нравится есть миску <w>чили</w> с сыром и сметаной сверху.",
                                "zh": "他喜欢吃一碗上面撒了奶酪和酸奶油的<w>辣肉酱</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "chili con carne"
                    ],
                    "common_phrases": [
                        "bowl of chili",
                        "chili dog",
                        "vegetarian chili",
                        "homemade chili"
                    ],
                    "target_lang_definitions": {
                        "ru": "Острое рагу из перца чили, мяса (обычно говядины), часто с добавлением фасоли и томатов.",
                        "zh": "一种由辣椒、肉类（通常是牛肉）以及豆类和番茄炖制而成的辛辣菜肴。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чили",
                                "target_lang_sense_clarification": "блюдо"
                            },
                            {
                                "target_lang_word": "чили кон карне",
                                "target_lang_sense_clarification": "полное название"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "辣肉酱",
                                "target_lang_sense_clarification": "指美式炖菜 Chili con carne"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "96e5931b-bc57-3273-bd44-bc6cdbed6db3",
                    "sense_definition": "A red powder made from dried chili peppers, often mixed with other spices, used as a seasoning.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "food_ingredient",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The recipe calls for a teaspoon of <w>chili</w> to season the meat.",
                            "target_lang_translations": {
                                "ru": "В рецепте требуется чайная ложка <w>чили</w> для приправы мяса.",
                                "zh": "食谱要求加一茶匙<w>辣椒粉</w>来腌制肉类。"
                            }
                        },
                        {
                            "text": "If you want the soup spicier, you can add a pinch of <w>chili</w>.",
                            "target_lang_translations": {
                                "ru": "Если вы хотите суп поострее, можете добавить щепотку <w>чили</w>.",
                                "zh": "如果你想让汤更辣，可以加一小撮<w>辣椒粉</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "chili powder"
                    ],
                    "common_phrases": [
                        "pinch of chili"
                    ],
                    "target_lang_definitions": {
                        "ru": "Красный порошок из сушеного перца чили, часто смешанный с другими специями, используемый как приправа.",
                        "zh": "由干辣椒磨成的红色粉末，常与其他香料混合作为调味料。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "порошок чили",
                                "target_lang_sense_clarification": "специя"
                            },
                            {
                                "target_lang_word": "чили",
                                "target_lang_sense_clarification": "приправа"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "辣椒粉",
                                "target_lang_sense_clarification": "作为调味品的粉末"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e6515a29-8841-3ec9-ae4e-3139334e3619",
                    "sense_definition": "A spicy dish of chicken or cheese cooked with capsicum and onions, common in Indian Chinese cuisine.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "food_dish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We ordered paneer <w>chili</w> as a starter for our meal at the restaurant.",
                            "target_lang_translations": {
                                "ru": "Мы заказали панир <w>чили</w> в качестве закуски в ресторане.",
                                "zh": "我们在餐厅点了一份辣味奶酪作为开胃菜。"
                            }
                        },
                        {
                            "text": "The chicken <w>chili</w> was too spicy for the children to eat.",
                            "target_lang_translations": {
                                "ru": "Курица <w>чили</w> была слишком острой для детей.",
                                "zh": "这道辣味鸡肉太辣了，孩子们吃不了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "paneer chili",
                        "chicken chili"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Indian Chinese cuisine"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Острое блюдо из курицы или сыра с перцем и луком, популярное в индийско-китайской кухне.",
                        "zh": "一种源自印式中餐的菜肴，通常用鸡肉或奶酪与辣椒和洋葱炒制而成。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чили",
                                "target_lang_sense_clarification": "в названиях блюд"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "辣味炒菜",
                                "target_lang_sense_clarification": "指印式中餐中的辣味菜肴"
                            }
                        ]
                    }
                }
            ]
        },
        {
