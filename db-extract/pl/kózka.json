                    },
                    {
                        "sense_id": "a0656797-db63-3757-8c83-c73ac57e9d35",
                        "entry_id": "b6f3665a-4dbd-3d36-992f-60c953cbcfc2",
                        "glosses": [
                            "Sabanejewia, ryba z rodzaju Sabanejewia, z rodziny piskorzowatych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff2426ea-d1e1-457c-9485-3bbde8394c87",
                                "sense_id": "a0656797-db63-3757-8c83-c73ac57e9d35",
                                "text": "Ichtiolog badał kózki i karasie."
                            }
                        ],
