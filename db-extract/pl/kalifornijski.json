                                                "example_id": "dd569f0d-9cad-4fc9-a925-44a80a4800e2",
                                                "sense_id": "28a90473-ab43-36d4-9e65-2ddad61cd74f",
                                                "text": "„Passanten querten im kalifornischen Long Beach einen Parkplatz, als ihnen in einem dort abgestellten Auto eine plötzliche Bewegung auffiel.“"
                                            }
