                        "glosses": [
                            "Of, pertaining to, or believing in mercantilism."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8d47e86-668b-4d63-bbd3-9fc337283b30",
                                "sense_id": "8ea74796-45d4-3144-87b4-78b6853d786c",
                                "text": "According to the mercantilist thinking that dominated European thought between the 16th and 18th centuries, poverty was socially useful. True, it was miserable for the poor. But it also kept the economic engine humming by ensuring the availability of plentiful cheap labour."
                            }
                        ]
                    }
