                        "entry_id": "e00c5859-13e7-356d-b841-2b502efa78a6",
                        "glosses": [
                            "Qualifie l'action par laquelle on tend à être maintenu ou rétabli dans la possession."
                        ],
                        "tags": [
                            "Droit de propriété"
                        ],
                        "examples": [
                            {
                                "example_id": "227ed15a-3dea-4077-a286-25cf3dfe32ba",
                                "sense_id": "d41fa539-64fb-3c7e-bc1e-cf5024c7223f",
                                "text": "Le co-possesseur d’une chose commune peut, en cas de trouble, intenter l’action possessoire contre son co-possesseur."
                            }
                        ]
                    }
                ],
