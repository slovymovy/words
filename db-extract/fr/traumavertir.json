                ],
                "senses": [
                    {
                        "sense_id": "2f0c56f4-6fe7-34ea-8329-a1af795ea01e",
                        "entry_id": "8f11ee33-50b6-3525-897d-740272612f1e",
                        "glosses": [
                            "Avertir (spécialement des étudiants) que des éléments qu'ils vont voir ou entendre pourraient être traumatisants pour certains d'entre eux."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "63a0b9ff-27ac-4aed-aee7-005026e6adb1",
                                "sense_id": "2f0c56f4-6fe7-34ea-8329-a1af795ea01e",
                                "text": "Cette tendance à traumavertir (plutôt que guérir) participe d’un phénomène plus général de bienveillance qui peut parfois sembler verser dans l’excès."
                            }
                        ]
                    },
                    {
                        "sense_id": "f9bff6c0-ed9d-3389-852d-b36a6331c49c",
                        "entry_id": "8f11ee33-50b6-3525-897d-740272612f1e",
                        "glosses": [
                            "Adapter dans le but d’éviter des traumatismes potentiels."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "8db36c23-92d5-4cb0-b3c7-9d011386a23d",
                                "sense_id": "f9bff6c0-ed9d-3389-852d-b36a6331c49c",
                                "text": "L’outil permet d’évaluer les risques dans une perspective traumavertie et centrée sur les personnes survivantes."
                            },
                            {
                                "example_id": "d70be8ba-0d98-46ae-bad2-5dd005e6f5fb",
                                "sense_id": "f9bff6c0-ed9d-3389-852d-b36a6331c49c",
                                "text": "Assurez-vous d’adopter une approche traumavertie, centrée sur la personne survivante, lorsque vous décidez des mesures provisoires."
                            }
                        ]
                    }
                ],
