                "translations": [
                    {
                        "translation_id": "88ea4433-6f7a-46cb-9fc6-038712800d24",
                        "source_entry_id": "e65c5f40-ff56-3e62-807e-b171848fbb19",
                        "source_sense_id": "387e46c5-9098-31fe-8d82-048035c6a5f6",
                        "source_sense_description": "Taubenhaus, Taubenschlag",
                        "target_lang_word": "Taubenhaus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Taubenhaus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d784af0b-55a5-3910-8857-84751c68eae4",
                                        "entry_id": "84dd07c4-8c2c-375d-b1ec-4e2f02dadbb0",
                                        "glosses": [
                                            "Verschlag zur Haltung von Haustauben in Form eines Häuschens, das auf einer Säule steht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2b1ab8a-e065-4245-ad00-110bbb9578ca",
                                                "sense_id": "d784af0b-55a5-3910-8857-84751c68eae4",
                                                "text": "„Weshalb setzen wir ein Taubenhaus auf eine himmelhohe Stange? – Um die jeder Verteidigung fast unfähigen Insassen vor dem Marder zu schützen. Er kommt aber doch hinein.“"
                                            },
                                            {
                                                "example_id": "09e04637-6b1a-4848-a450-32736e376954",
                                                "sense_id": "d784af0b-55a5-3910-8857-84751c68eae4",
                                                "text": "„Das Dach ist voller Technik: Überall sind Lüftungen, Bauten für die Klimaanlage des Kaufhauses. Dazwischen steht unauffällig ein Taubenhaus, 15 Quadratmeter Fläche, etwa zwei Meter hoch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0d8e8d23-523f-4675-a79b-b8b6557d0b56",
                        "source_entry_id": "e65c5f40-ff56-3e62-807e-b171848fbb19",
                        "source_sense_id": "387e46c5-9098-31fe-8d82-048035c6a5f6",
                        "source_sense_description": "Taubenhaus, Taubenschlag",
                        "target_lang_word": "Taubenschlag",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Taubenschlag",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "252f8a45-e619-33e3-a7ec-ff71377957db",
                                        "entry_id": "5823d365-4104-3c9d-83ff-745a05399f37",
                                        "glosses": [
                                            "Verschlag, der Haustauben Schutz vor Witterungseinflüssen und natürlichen Feinden bietet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d282d4b6-a3dc-468f-a7b8-756e77ec81d1",
                                                "sense_id": "252f8a45-e619-33e3-a7ec-ff71377957db",
                                                "text": "Auf der Flucht vor einem Habicht konnte sich die Taube in den Taubenschlag retten."
                                            },
                                            {
                                                "example_id": "69e584e9-96a8-4d01-8ab3-d14c3f2cbd37",
                                                "sense_id": "252f8a45-e619-33e3-a7ec-ff71377957db",
                                                "text": "„Er forderte von der Stadt eine vorübergehende Aufhebung des Fütterungsverbotes und neue Taubenschläge zur kontrollierten Haltung der Vögel, um deren \"Leid\" in den Griff zu bekommen.“"
                                            },
                                            {
                                                "example_id": "e39b3944-6a6c-431e-b908-04699a9a290d",
                                                "sense_id": "252f8a45-e619-33e3-a7ec-ff71377957db",
                                                "text": "„Kosole erzählt, dass er heute Nachmittag seinen Taubenschlag reparieren will.“"
                                            },
                                            {
                                                "example_id": "c384c44f-17c1-45ea-8945-0401cd51d066",
                                                "sense_id": "252f8a45-e619-33e3-a7ec-ff71377957db",
                                                "text": "„In einer Ecke des Hühnerhofs wurde ein Taubenschlag aufgestellt.“"
                                            },
                                            {
                                                "example_id": "2c2ac939-ad5f-479a-a5f6-6e1ff14e3451",
                                                "sense_id": "252f8a45-e619-33e3-a7ec-ff71377957db",
                                                "text": "„Die Welle der Kelter erschien ihnen riesenhaft; dann stiegen sie in den Taubenschlag hinauf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
