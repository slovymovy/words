{
    "word_family": [
        "reattempt",
        "unattempted",
        "attempter"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "37289dcb-a895-3057-bf2b-f749988eedd7",
                    "sense_definition": "To try to do something, especially something difficult or challenging.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>attempted</w> to fix the broken computer myself, but I failed.",
                            "target_lang_translations": {
                                "ru": "Я <w>попытался</w> починить сломанный компьютер сам, но потерпел неудачу.",
                                "es": "<w>Intenté</w> arreglar la computadora rota yo mismo, pero fallé."
                            }
                        },
                        {
                            "text": "The climbers <w>attempted</w> to reach the summit before the storm arrived.",
                            "target_lang_translations": {
                                "ru": "Альпинисты <w>попытались</w> добраться до вершины до начала шторма.",
                                "es": "Los escaladores <w>intentaron</w> llegar a la cima antes de que llegara la tormenta."
                            }
                        }
                    ],
                    "synonyms": [
                        "seek",
                        "essay",
                        "take a stab at",
                        "try",
                        "endeavor"
                    ],
                    "common_phrases": [
                        "attempt to do",
                        "attempt a rescue",
                        "attempt to find"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пытаться сделать что-то, особенно что-то трудное или сложное.",
                        "es": "Tratar de hacer algo, especialmente algo difícil o desafiante."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пытаться",
                                "target_lang_sense_clarification": "прилагать усилия"
                            },
                            {
                                "target_lang_word": "пробовать",
                                "target_lang_sense_clarification": "испытывать, экспериментировать"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "intentar",
                                "target_lang_sense_clarification": "hacer el esfuerzo para conseguir algo"
                            },
                            {
                                "target_lang_word": "tratar de",
                                "target_lang_sense_clarification": "procurar realizar una acción"
                            },
                            {
                                "target_lang_word": "acometer",
                                "target_lang_sense_clarification": "emprender una tarea con ímpetu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "53cac91d-9d6d-39c1-9a0c-82af3e111f36",
                    "sense_definition": "To attack or try to take by force.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The general decided to <w>attempt</w> the enemy's camp at dawn.",
                            "target_lang_translations": {
                                "ru": "Генерал решил <w>штурмовать</w> вражеский лагерь на рассвете.",
                                "es": "El general decidió <w>acometer</w> el campamento enemigo al amanecer."
                            }
                        },
                        {
                            "text": "He would not <w>attempt</w> the life of his adversary without cause.",
                            "target_lang_translations": {
                                "ru": "Он не стал бы <w>покушаться</w> на жизнь своего противника без причины.",
                                "es": "Él no <w>atentaría</w> contra la vida de su adversario sin causa."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Found in older literature."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Атаковать или пытаться захватить силой.",
                        "es": "Atacar o intentar tomar por la fuerza."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "покушаться",
                                "target_lang_sense_clarification": "на чью-либо жизнь или права"
                            },
                            {
                                "target_lang_word": "штурмовать",
                                "target_lang_sense_clarification": "атаковать укрепленную позицию"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "acometer",
                                "target_lang_sense_clarification": "atacar de forma violenta"
                            },
                            {
                                "target_lang_word": "atentar contra",
                                "target_lang_sense_clarification": "intentar causar daño a alguien o algo"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f182b27f-a972-38b0-a8ac-37123b2abc44",
                    "sense_definition": "An act of trying to do something, especially something difficult.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We made an <w>attempt</w> to cross the stream, but the water was too deep.",
                            "target_lang_translations": {
                                "ru": "Мы предприняли <w>попытку</w> пересечь ручей, но вода была слишком глубокой.",
                                "es": "Hicimos un <w>intento</w> de cruzar el arroyo, pero el agua era demasiado profunda."
                            }
                        },
                        {
                            "text": "This painting is my first <w>attempt</w> at using oil colors.",
                            "target_lang_translations": {
                                "ru": "Эта картина — моя первая <w>попытка</w> использования масляных красок.",
                                "es": "Esta pintura es mi primer <w>intento</w> de usar colores al óleo."
                            }
                        }
                    ],
                    "synonyms": [
                        "effort",
                        "try",
                        "bid",
                        "endeavor",
                        "shot"
                    ],
                    "common_phrases": [
                        "make an attempt",
                        "failed attempt",
                        "first attempt",
                        "suicide attempt"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие, направленное на то, чтобы сделать что-то, особенно что-то трудное.",
                        "es": "El acto de tratar de hacer algo, especialmente algo difícil."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "попытка",
                                "target_lang_sense_clarification": "стремление добиться чего-либо"
                            },
                            {
                                "target_lang_word": "проба",
                                "target_lang_sense_clarification": "испытание, проверка"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "intento",
                                "target_lang_sense_clarification": "acción de intentar algo"
                            },
                            {
                                "target_lang_word": "tentativa",
                                "target_lang_sense_clarification": "ensayo o propuesta de algo"
                            },
                            {
                                "target_lang_word": "ensayo",
                                "target_lang_sense_clarification": "prueba o experimento"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "06e1ae18-4526-3ef6-8496-697df90fe631",
                    "sense_definition": "An act of attacking someone, often with the intent to kill.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The president survived an assassination <w>attempt</w> during his speech.",
                            "target_lang_translations": {
                                "ru": "Президент пережил <w>покушение</w> во время своего выступления.",
                                "es": "El presidente sobrevivió a un <w>atentado</w> contra su vida durante su discurso."
                            }
                        },
                        {
                            "text": "Police are investigating an <w>attempt</w> on the witness's life.",
                            "target_lang_translations": {
                                "ru": "Полиция расследует <w>покушение</w> на жизнь свидетеля.",
                                "es": "La policía está investigando un <w>atentado</w> contra la vida del testigo."
                            }
                        }
                    ],
                    "common_phrases": [
                        "assassination attempt",
                        "attempt on someone's life"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нападение на кого-либо, часто с намерением убить.",
                        "es": "El acto de atacar a alguien, a menudo con la intención de matar."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "покушение",
                                "target_lang_sense_clarification": "посягательство на жизнь"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "atentado",
                                "target_lang_sense_clarification": "hecho delictivo contra la seguridad o la vida"
                            },
                            {
                                "target_lang_word": "conato",
                                "target_lang_sense_clarification": "delito que se empezó pero no se consumó"
                            },
                            {
                                "target_lang_word": "intentona",
                                "target_lang_sense_clarification": "intento temerario o atrevido"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}