                ],
                "senses": [
                    {
                        "sense_id": "fee823dc-4209-32c5-a664-93f047247d0c",
                        "entry_id": "b37304b1-c98a-3564-893e-b86c52479500",
                        "glosses": [
                            "ein kleineres Gerät zum Warmhalten von Speisen durch Erhitzung auf dem Tisch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e2253c5-5c33-4ac9-a1ea-ecd0a28e5f62",
                                "sense_id": "fee823dc-4209-32c5-a664-93f047247d0c",
                                "text": "„Das caquelon, wie die bauchige Fonduepfanne heißt, wird auf dem Rechaud mitten auf den Tisch gestellt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "708aedea-f1ce-3671-b496-97d048cada73",
                        "entry_id": "b37304b1-c98a-3564-893e-b86c52479500",
                        "glosses": [
                            "ein kleineres Gerät zum Zubereiten von Speisen durch Erhitzung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87064a54-c0e5-4001-98be-688e484e1abc",
                                "sense_id": "708aedea-f1ce-3671-b496-97d048cada73",
                                "text": "„Nun produziert die Gasflamme als solche schon Wasserdampf, und zwar in dem Maße, daß beim Kochen auf dem Rechaud pro Stunde etwa 1 bis 1/2 Kilogramm Wasserdampf erzeugt wird, der sich an den kalten Wänden niederschlägt.“"
                            },
                            {
                                "example_id": "56b4089c-8551-4c6b-a8d8-f9cb61eae6a0",
                                "sense_id": "708aedea-f1ce-3671-b496-97d048cada73",
                                "text": "„Kleinere Gasapparate für vorübergehende Verwendung, wie zum Beispiel Teekocher, Bügeleisenwärmer, Rechauds u. dgl. dürfen ohne Anschluß an Abzugschläuche nur in Räumen benützt werden, welche leicht zu lüften sind.“"
                            },
                            {
                                "example_id": "57c8a0e3-edb6-4f7e-9a32-bc3ffaad9dea",
                                "sense_id": "708aedea-f1ce-3671-b496-97d048cada73",
                                "text": "„Die am 7.11.1930 geborene, in großstädtischen Verhältnissen in einer im Parterre gelegenen, mit Bad, Zentralheizung und elektrischem Rechaud ausgestatteten Einzimmerwohnung lebende Klägerin bedarf nach den Feststellungen lediglich für größere Einkäufe und für alle groben Hausarbeiten wie Wäschewaschen, Fensterputzen und Gründlichreinigen der Wohnung fremder Hilfe.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e90547b3-2ee2-4a12-984d-a6008d7df202",
                        "source_entry_id": "b37304b1-c98a-3564-893e-b86c52479500",
