                "senses": [
                    {
                        "sense_id": "f102141f-6f32-3043-990d-7590f1b7278b",
                        "entry_id": "f3d22d89-ca93-3414-9046-90e7b7a35615",
                        "glosses": [
                            "długa, ręczna, odprzodowa broń palna z zamkiem kołowym, używana przez kawalerię i piechotę w XVI-XVII wieku; także jako broń myśliwska"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fca4a43b-e1e4-4044-8f26-24566acaa6b8",
                                "sense_id": "f102141f-6f32-3043-990d-7590f1b7278b",
                                "text": "Dałem rozkaz mojej straży: Kto zbyt blisko się poważy, przywitać go z arkebuza"
                            },
                            {
                                "example_id": "633b670a-5dfc-434a-819d-6a93e4a3a4ab",
                                "sense_id": "f102141f-6f32-3043-990d-7590f1b7278b",
                                "text": "Oto już słyszę z daleka pukanie z dział, z dubeltówek, z flinty, z arkebuza…"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
