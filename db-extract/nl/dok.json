                    {
                        "translation_id": "a4872bd6-7f71-47b2-aa9f-7816f5996704",
                        "source_entry_id": "fe649c08-53b6-314c-9a33-01d30867f947",
                        "source_sense_id": "9945b637-6f03-393e-ba06-61b2cd7cef92",
