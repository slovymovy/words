                },
                {
                    "sense_id": "2c89fc39-e6c4-33a0-bd16-8317d1eb2bc3",
                    "sense_definition": "The act or process of saying something or expressing something in words.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She finally gave <w>utterance</w> to the thoughts she had been hiding for weeks.",
