                "senses": [
                    {
                        "sense_id": "f951e39f-e043-3fcd-bba2-8dea20ab491e",
                        "entry_id": "7819a958-4950-39c6-a006-feb18b56abfa",
                        "glosses": [
                            "Abgeordneter in der Knesset"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26cabf21-1e8e-42ea-9f06-8873879c1063",
                                "sense_id": "f951e39f-e043-3fcd-bba2-8dea20ab491e",
                                "text": "„Die arabischen Knessetabgeordneten gehörten zu einer Gruppe von Israelis, die vor dem Obersten Gerichtshof Israels gegen dieses neueste rassistische Gesetz klagten.“"
                            },
                            {
                                "example_id": "2ef830aa-406c-4f9d-b295-9de8385b27f8",
                                "sense_id": "f951e39f-e043-3fcd-bba2-8dea20ab491e",
                                "text": "„Ich war schon oft dort gewesen, bei Zwischenaufenthalten auf Fernreisen, als Knessetabgeordneter und Amtsinhaber, als Knessetsprecher, der Israel bei der Rückkehr des Bundestags von Bonn nach Berlin vertrat, als Israeli, als ich mit meinem jüngsten den Spuren meines Vaters und seiner längst untergegangenen Welt folgte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
