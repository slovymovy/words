                {
                    "sense_id": "581afd6b-6891-313f-aa1a-96ec030140fb",
                    "sense_definition": "The act of cutting the hair, often done professionally by a barber or stylist.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "hair_grooming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need to schedule an appointment for a <w>haircut</w> this weekend.",
                            "target_lang_translations": {
                                "ru": "Мне нужно записаться на <w>стрижку</w> в эти выходные.",
                                "zh": "我这周末需要预约去<w>理发</w>。"
                            }
                        },
                        {
                            "text": "The barber gave him a quick <w>haircut</w> before the ceremony.",
                            "target_lang_translations": {
                                "ru": "Парикмахер быстро сделал ему <w>стрижку</w> перед церемонией.",
                                "zh": "仪式开始前，理发师很快地为他<w>剪了发</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
