                    {
                        "sense_id": "7090d454-e4eb-3a0b-b4e8-51bbb6e40a6a",
                        "entry_id": "12ed4bf3-4768-3470-b4bb-e74cdf7fbce2",
                        "glosses": [
                            "een grasland in het hooggebergte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32c41988-1c60-4b54-b6fc-de2982df00b0",
                                "sense_id": "7090d454-e4eb-3a0b-b4e8-51bbb6e40a6a",
                                "text": "De grasmat in het Wörthersee Stadion voorspelde al een ploeteravond voor Feyenoord. Geen schone Alpenweide, maar een Oostenrijkse akker waarop alleen werkvoetbal mogelijk was. Tegen een ploeg waarvan eerder in eigen huis, mede door drie penalty's tegen, met 4-1 verloren was."
                            },
                            {
                                "example_id": "e6fa47b3-876e-4d39-a050-604f8a3420c2",
                                "sense_id": "7090d454-e4eb-3a0b-b4e8-51bbb6e40a6a",
                                "text": "Hij zegt dat het een hoop scheelt als je kleding weer ruikt naar een frisse Alpenweide. Voorbijgangers op straat kijken vriendelijker naar hem. En: \"Nu heb ik tenminste iets om aan te doen naar een sollicitatiegesprek.\""
                            }
                        ]
                    }
