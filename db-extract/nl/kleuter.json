                    {
                        "translation_id": "c5bad9fc-f536-47b2-a691-bc7534fdcc08",
                        "source_entry_id": "d299fd6e-7ef1-31a7-abf9-be9e6bb42e12",
                        "source_sense_id": "0dbd2737-a5a5-306f-aee7-47b53679f02d",
                        "source_sense_description": "een jong kind in de leeftijd van vier tot zes jaar",
                        "target_lang_word": "preschool child",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d146e11d-25ff-4a0a-a574-628537a35696",
                        "source_entry_id": "d299fd6e-7ef1-31a7-abf9-be9e6bb42e12",
                        "source_sense_id": "0dbd2737-a5a5-306f-aee7-47b53679f02d",
                        "source_sense_description": "een jong kind in de leeftijd van vier tot zes jaar",
                        "target_lang_word": "preschooler",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "preschooler",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "087bcf2e-991e-312a-96b8-b65cfaa47458",
                                        "entry_id": "ac1dca37-0b5a-3d6a-a224-6179dbf02c2e",
                                        "glosses": [
                                            "A child who has not yet attended school."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b38e48cf-b1f9-36ee-802c-66f3f2ad913a",
                                        "entry_id": "ac1dca37-0b5a-3d6a-a224-6179dbf02c2e",
                                        "glosses": [
                                            "A child who is educated at preschool."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33aabf74-9192-44b5-9bd5-18b032f163aa",
                                                "sense_id": "b38e48cf-b1f9-36ee-802c-66f3f2ad913a",
                                                "text": "Countless issues arise in family life every day, from the litany of no-noes showered on the toddler, to calling the preschooler in for his lunch."
                                            },
                                            {
                                                "example_id": "c73c766d-3175-46da-ad78-60775243e646",
                                                "sense_id": "b38e48cf-b1f9-36ee-802c-66f3f2ad913a",
                                                "text": "Tasks that include non-living natural kinds (e.g., clouds and rivers) generally elicit more animalistic errors (e.g., Carey, 1985; Laurendeau & Pinard, 1962; Smeets, 1973; see Nass, 1956, for discussion of content effects); however, even with such items, preschoolers are no more likely to overattribute life than to underattribute it (Hatano et al., 1993; Smeets, 1973)."
                                            },
                                            {
                                                "example_id": "8df6718c-d8e9-4071-a102-ca78e0260038",
                                                "sense_id": "b38e48cf-b1f9-36ee-802c-66f3f2ad913a",
                                                "text": "The warmup guy — as I now know is common for live audiences in taped television performances — kept fluffing the crowd like they were preschoolers.\n“Now what are you going to do when we introduce the first comedian?”\nWild cheers.\n“C'mon, that's not good enough! Let's try it again! What are you going to do???”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8b3f9f93-4d84-4a6b-b3e1-fb9fea1ef362",
                        "source_entry_id": "d299fd6e-7ef1-31a7-abf9-be9e6bb42e12",
                        "source_sense_id": "0dbd2737-a5a5-306f-aee7-47b53679f02d",
                        "source_sense_description": "een jong kind in de leeftijd van vier tot zes jaar",
                        "target_lang_word": "marmot",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "marmot",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bab93fb3-ddca-357b-bb48-6e2be7e9d954",
                                        "entry_id": "5816e391-f7b6-3792-873b-cb24a95bbe52",
                                        "glosses": [
                                            "Singe dont la bouche se déforme."
                                        ],
                                        "tags": [
                                            "Sens original"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c72830ff-0c64-4f98-bd6d-5a3931380784",
                                                "sense_id": "bab93fb3-ddca-357b-bb48-6e2be7e9d954",
                                                "text": "Par contre, nul n’affirme que ces singes étaient des marmots."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8832ae54-95ff-3dcf-9e5a-e3bfc79f4e07",
                                        "entry_id": "5816e391-f7b6-3792-873b-cb24a95bbe52",
                                        "glosses": [
                                            "Faciès déformé par des rictus. → voir croquer le marmot"
                                        ],
                                        "tags": [
                                            "analogy",
                                            "broadly",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e293d88e-7b44-434b-97a6-14f24172448e",
                                                "sense_id": "8832ae54-95ff-3dcf-9e5a-e3bfc79f4e07",
                                                "text": "Come d’un tronc de boys se peut faire la représentation d’un marmot (sic)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "320cae78-d3b2-3311-836c-ed919e51564a",
                                        "entry_id": "5816e391-f7b6-3792-873b-cb24a95bbe52",
                                        "glosses": [
                                            "Heurtoir de porte d’entrée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d88ba3b9-2189-45aa-8c9b-5eccea7b5558",
                                                "sense_id": "320cae78-d3b2-3311-836c-ed919e51564a",
                                                "text": "La porte, en cet endroit, était garnie d’un gros bouton de cuivre qui représentait une de ces figures grotesques qu’on nomme ordinairement marmots."
                                            },
                                            {
                                                "example_id": "1b3450e0-a0ea-4a49-bf63-8121082d9a55",
                                                "sense_id": "320cae78-d3b2-3311-836c-ed919e51564a",
                                                "text": "Il frappait le marmot. C’était une porte étroite de bois ouvragé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf5c2f1c-6cda-391a-866c-9163a960c07c",
                                        "entry_id": "5816e391-f7b6-3792-873b-cb24a95bbe52",
                                        "glosses": [
                                            "Personne dont le visage est déformé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70c8b5ec-e51d-4cfc-8e6f-273ddb0daafc",
                                                "sense_id": "bf5c2f1c-6cda-391a-866c-9163a960c07c",
                                                "text": "[…] tous les quatre revêtus de treillis, en godillots, avec leurs gants et leur écharpe de laine ; ( Moineau porte un passe-montagne qui lui fait une tête de marmot )."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66203a44-5654-3af3-b5cc-b77b3fbf683b",
                                        "entry_id": "5816e391-f7b6-3792-873b-cb24a95bbe52",
                                        "glosses": [
                                            "Enfant en bas âge faisant des mimiques."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1af7ffe-eb0a-4fa4-a01d-62f3273c96f9",
                                                "sense_id": "66203a44-5654-3af3-b5cc-b77b3fbf683b",
                                                "text": "[L’homme] s’affairant autour de l’humble ménage et de quelque marmot grimaçant, sa compagne, la « popinée », guenon sympathique et rieuse qu’engonce drôlement la robe […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa002acc-1172-31ed-8fd4-6c15abb00191",
                                        "entry_id": "5816e391-f7b6-3792-873b-cb24a95bbe52",
                                        "glosses": [
                                            "Petit enfant."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d45533e-a7be-403a-9736-c84afda44fbf",
                                                "sense_id": "aa002acc-1172-31ed-8fd4-6c15abb00191",
                                                "text": "Cependant faites bien mes recommandations à notre marmot, et dites-lui que peut-être j’amènerai de ce pays-là quelque beau petit chaperon pour le faire jouer et pour lui tenir compagnie."
                                            },
                                            {
                                                "example_id": "ed5aa0a0-67b9-46a4-945f-9980945c308e",
                                                "sense_id": "aa002acc-1172-31ed-8fd4-6c15abb00191",
                                                "text": "Et le doigt de l’oreille est le Benjamin de la famille, marmot pleureur, qui toujours se trimballe à la ceinture de sa mère."
                                            },
                                            {
                                                "example_id": "8fb1f999-221a-46bf-b32c-ac6f0aeac5db",
                                                "sense_id": "aa002acc-1172-31ed-8fd4-6c15abb00191",
                                                "text": "Quelquefois dans les champs, où mon mari m’aurait menée, en m’échappant à quelques pas de mes marmots, en voyant une splendide matinée, secrètement, j’eusse jeté quelques pleurs bien amers."
                                            },
                                            {
                                                "example_id": "faf1223a-2714-45cd-ade5-04d4d730a55f",
                                                "sense_id": "aa002acc-1172-31ed-8fd4-6c15abb00191",
                                                "text": "Rentré chez eux, le marmot fut gâté comme un prince."
                                            },
                                            {
                                                "example_id": "0d4e30e6-dde5-4ac3-9af7-093c287aeb45",
                                                "sense_id": "aa002acc-1172-31ed-8fd4-6c15abb00191",
                                                "text": "Autour d’elle se vautraient, en glapissant, trois ou quatre marmots dans l’état le plus primitif, noirs comme des mulâtres, avec de gros ventres et des membres grêles qui les faisaient ressembler plutôt à des quadrumanes qu’à des bipèdes."
                                            },
                                            {
                                                "example_id": "fe62825b-6369-405b-bc95-e7b27dc044a7",
                                                "sense_id": "aa002acc-1172-31ed-8fd4-6c15abb00191",
                                                "text": "« Tais-toi, la mère !… vous autres, femmes, vous n’y entendez rien. À force de vivre toujours avec les enfants et rien que pour eux, vous rapetissez tout à la taille de vos marmots…"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "marmot",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "32152643-fff4-30bd-8d07-81bd91261c98",
                                        "entry_id": "be34553d-746e-3406-8dae-8dec80b8a617",
                                        "glosses": [
                                            "Relatif à Saint-Geniez-d’Olt, commune de l’Aveyron."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0e490c4-caee-4456-a305-2cc54233801a",
                                                "sense_id": "32152643-fff4-30bd-8d07-81bd91261c98",
                                                "text": "Société SCI Du Pays Marmot (Saint Geniez d'Olt et d'Aubrac, 12130)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01cfe341-9e6d-3dd7-9b6a-dad4c6b8a03b",
                                        "entry_id": "be34553d-746e-3406-8dae-8dec80b8a617",
                                        "glosses": [
                                            "Qui tient de l’enfant, du marmot."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf8c961c-7054-489a-a74c-18a8aaac06de",
                                                "sense_id": "01cfe341-9e6d-3dd7-9b6a-dad4c6b8a03b",
                                                "text": "Fatal amour ! charmant, morose,\nTaquin, il prend le mal au mot ;\nD’autant plus sombre qu’il est rose,\nD’autant plus dieu qu’il est marmot !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
