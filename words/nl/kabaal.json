            "senses": [
                {
                    "sense_id": "43f43819-b796-3506-b6a4-55780146b8f6",
                    "sense_definition": "zeer luid en hinderlijk geluid of rumoer",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geluid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kinderen maakten zoveel <w>kabaal</w> dat de buren er wakker van werden.",
                            "target_lang_translations": {
                                "en": "The children were making so much <w>racket</w> that it woke the neighbors up."
                            }
                        },
                        {
                            "text": "Het onophoudelijke <w>kabaal</w> van de bouwwerkzaamheden zorgde voor veel overlast in de straat.",
                            "target_lang_translations": {
                                "en": "The incessant <w>din</w> of the construction work caused a lot of nuisance on the street."
                            }
                        }
                    ],
                    "synonyms": [
                        "herrie",
                        "lawaai",
                        "rumoer"
                    ],
                    "common_phrases": [
                        "veel kabaal maken",
                        "een hels kabaal"
                    ],
                    "target_lang_definitions": {
                        "en": "very loud, disturbing noise, commotion, or racket"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "din",
                                "target_lang_sense_clarification": "a loud, persistent, and confusing noise"
                            },
                            {
                                "target_lang_word": "racket",
                                "target_lang_sense_clarification": "a loud, annoying commotion or clamor"
                            },
                            {
                                "target_lang_word": "uproar",
                                "target_lang_sense_clarification": "loud, turbulent noise or clamor"
                            },
                            {
                                "target_lang_word": "clamor",
                                "target_lang_sense_clarification": "a loud and confused noise"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1b92d109-f5c0-3ea5-b11f-012eb0bcae9d",
                    "sense_definition": "grote ophef, drukte of protest over iets",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "ophef",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Waarom maak je toch zo'n <w>kabaal</w> om zo'n klein detail?",
                            "target_lang_translations": {
                                "en": "Why are you making such a <w>fuss</w> about such a small detail?"
                            }
                        },
                        {
                            "text": "De nieuwe belastingmaatregel veroorzaakte meteen een groot politiek <w>kabaal</w> in het parlement.",
                            "target_lang_translations": {
                                "en": "The new tax measure immediately caused a major political <w>outcry</w> in parliament."
                            }
                        }
                    ],
                    "synonyms": [
                        "tumult"
                    ],
                    "common_phrases": [
                        "kabaal schoppen",
                        "ergens kabaal om maken"
                    ],
                    "target_lang_definitions": {
                        "en": "a great fuss, disturbance, or vocal outcry about something"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fuss",
                                "target_lang_sense_clarification": "excessive excitement, protest, or agitation over something"
                            },
                            {
                                "target_lang_word": "outcry",
                                "target_lang_sense_clarification": "a strong public protest or commotion"
                            },
                            {
                                "target_lang_word": "commotion",
                                "target_lang_sense_clarification": "a state of noisy agitation or turbulence"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "40880e55-f05f-3658-8252-80e9555cb2cd",
                    "sense_definition": "heimelijke groep samenzweerders of een geheim complot",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "samenzwering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Men vermoedde dat een kleine politieke <w>kabaal</w> achter de schermen het beleid stuurde.",
                            "target_lang_translations": {
                                "en": "It was suspected that a small political <w>cabal</w> was steering policy behind the scenes."
                            }
                        },
                        {
                            "text": "De koning vreesde de invloed van een gevaarlijke <w>kabaal</w> binnen de aristocratie.",
                            "target_lang_translations": {
                                "en": "The king feared the influence of a dangerous <w>cabal</w> within the aristocracy."
                            }
                        }
                    ],
                    "synonyms": [
                        "complot",
                        "samenzwering",
                        "kliek"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "In deze betekenis verouderd in het hedendaags Nederlands"
                        }
                    ],
