                "forms": [],
                "senses": [
                    {
                        "sense_id": "4e0fbeeb-ee80-3c34-81c8-bbca0ad2b8ef",
                        "entry_id": "f166888f-45dc-3ee7-a76b-9cd0ae563238",
                        "glosses": [
                            "boeken en ander leesmateriaal dat dient om de wens om te lezen te bevredigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be454118-9856-4c45-8f4c-6a966463432f",
                                "sense_id": "4e0fbeeb-ee80-3c34-81c8-bbca0ad2b8ef",
                                "text": "Op zoek naar een boek om je boekenkast verder uit te breiden? De bibliotheek houdt vandaag een boekenmarkt met leesvoer voor jeugd en volwassenen, allemaal voor zachte prijsjes. Ook is er bladmuziek te koop. De boekenmarkt is te vinden aan de Pijpenstraat 15 van 9.30 tot 16.00 uur."
                            },
                            {
                                "example_id": "4f818c77-904b-4efd-92db-f0d31a0e68b4",
                                "sense_id": "4e0fbeeb-ee80-3c34-81c8-bbca0ad2b8ef",
                                "text": "Als het voorstel was aangenomen door alle Europese ministers van Financiën, zou er een akkoord liggen dat het voor EU-lidstaten mogelijk maakt om minder btw te heffen op digitaal leesvoer. Nu wordt er in EU-landen op elektronische publicaties nog minstens 15 procent btw geheven."
                            }
                        ]
                    }
