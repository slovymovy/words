                                "target_senses": [
                                    {
                                        "sense_id": "676fe8e6-55f3-3dc0-a72b-0d8c59e4ce03",
                                        "entry_id": "3cd83198-5df9-3840-b318-4fb806413675",
                                        "glosses": [
                                            "auf gleichem oder angemessenem Niveau sein"
                                        ],
                                        "tags": [
                                            "with-dative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c78eeb1c-2fb2-4aeb-9952-33693854ebe7",
                                                "sense_id": "676fe8e6-55f3-3dc0-a72b-0d8c59e4ce03",
                                                "text": "Deine Leistungen entsprechen nicht deinen tatsächlichen Fähigkeiten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2a0fe1f3-888d-33b1-b894-991583ea7c99",
                                        "entry_id": "3cd83198-5df9-3840-b318-4fb806413675",
                                        "glosses": [
                                            "die Anforderungen oder Wünsche erfüllen"
                                        ],
                                        "tags": [
                                            "with-dative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "848dbbcf-3372-41b3-87f4-4451cff41af4",
                                                "sense_id": "2a0fe1f3-888d-33b1-b894-991583ea7c99",
                                                "text": "Dieses Buch entspricht nicht meinen Vorstellungen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ae8ea902-f9db-479d-bd75-24029584b344",
                        "source_entry_id": "e6f97629-46aa-339a-9b09-c0945693275f",
                        "source_sense_id": "75976849-8ef8-3c6a-9f09-6d000384e48a",
                        "source_sense_description": "be fit for",
                        "target_lang_word": "zukommen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zukommen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "98c68617-86ba-3311-8a73-8d43800413d5",
                                        "entry_id": "e0142286-2d00-377f-b55f-3a56045ef355",
                                        "glosses": [
                                            "sich jemandem oder etwas nähern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e4b2bc7-bdcd-4dd1-82ce-bbce8ea109a3",
                                                "sense_id": "98c68617-86ba-3311-8a73-8d43800413d5",
                                                "text": "Ich sehe, wie der große Hund auf ihn zukommt."
                                            },
                                            {
                                                "example_id": "96976b58-852f-404e-bad7-f6df58b12682",
                                                "sense_id": "98c68617-86ba-3311-8a73-8d43800413d5",
                                                "text": "„Ganz langsam komme ich auf sie zu.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f522135f-7dc5-393a-be97-88daac262cdb",
                                        "entry_id": "e0142286-2d00-377f-b55f-3a56045ef355",
                                        "glosses": [
                                            "(zeitnah) zu erwarten sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bca40e1e-5948-48e2-9f18-d7fa341b0f2d",
                                                "sense_id": "f522135f-7dc5-393a-be97-88daac262cdb",
                                                "text": "„Eine schwierige Zeit kommt auf mich zu.“"
                                            },
                                            {
                                                "example_id": "2c2cb515-9730-4077-95af-97d2ef7d533b",
                                                "sense_id": "f522135f-7dc5-393a-be97-88daac262cdb",
                                                "text": "„Denke jetzt nur nicht, dass deine Anschuldigungen damit abgetan sind, da kommt noch etwas auf dich zu, allerdings nicht jetzt.“"
                                            },
                                            {
                                                "example_id": "9532c33b-d2b1-4b34-8699-d7f8a6596e6a",
                                                "sense_id": "f522135f-7dc5-393a-be97-88daac262cdb",
                                                "text": "„Zusätzlich zu den Steuern kommen auch noch weitere Kosten auf den Käufer zu, wie etwa Notarkosten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "653edbf2-ccdb-33e0-88a2-ba95247073a4",
                                        "entry_id": "e0142286-2d00-377f-b55f-3a56045ef355",
                                        "glosses": [
                                            "jemandem gebühren, zustehen, zuteilwerden (lassen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2687784-29b7-472f-9dec-4cd9a50161bc",
                                                "sense_id": "653edbf2-ccdb-33e0-88a2-ba95247073a4",
                                                "text": "„Den Priestern soll wegen der heiligen Dinge, die sie verrichten, Würde und Ehre zukommen; […]“"
                                            },
                                            {
                                                "example_id": "d527806c-56a4-40ba-89d5-88dd1ca3d1cd",
                                                "sense_id": "653edbf2-ccdb-33e0-88a2-ba95247073a4",
                                                "text": "„Eine solche politische Macht kommt dem deutschen Bundespräsidenten nicht zu.“"
                                            },
                                            {
                                                "example_id": "56cf633f-4074-4eb6-b6e8-d7d61be397fe",
                                                "sense_id": "653edbf2-ccdb-33e0-88a2-ba95247073a4",
                                                "text": "„Der Gesundheit der in unserem Land in hohem Ausmaß vorhandenen Schutzwälder kommt Vorrang zu.“"
                                            },
                                            {
                                                "example_id": "933adb9a-8950-488c-b81b-4413c04c0898",
                                                "sense_id": "653edbf2-ccdb-33e0-88a2-ba95247073a4",
                                                "text": "„Dem Schutz von Quellen und Flüssen kommt große Bedeutung zu.“"
                                            },
                                            {
                                                "example_id": "d64c037c-9db3-453c-ab28-9123d5b036bd",
                                                "sense_id": "653edbf2-ccdb-33e0-88a2-ba95247073a4",
                                                "text": "„Beim Stierkampf (Corrida), dem in südlichen Ländern häufig noch Kultcharakter zukommt und der dort als hohe Kunst betrieben wird, stehen sich Mensch und Tier in einem gefährlichen Zweikampf gegenüber.“"
                                            },
                                            {
                                                "example_id": "6500aa21-5741-43ec-b8ee-dc1e4e4cbe42",
                                                "sense_id": "653edbf2-ccdb-33e0-88a2-ba95247073a4",
                                                "text": "„Für uns ist es wichtig, dass wir unseren Mitarbeitern in der Produktion entsprechende Impfstoffdosen zukommen lassen.“"
                                            },
                                            {
                                                "example_id": "20f93416-99c7-46a8-8bd4-08d6fe632a9d",
                                                "sense_id": "653edbf2-ccdb-33e0-88a2-ba95247073a4",
                                                "text": "„Am 15. September 2008 entschied die amerikanische Regierung der schwer angeschlagenen Investmentbank Lehman Brothers keine finanzielle Hilfe zukommen zu lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "11b02cc2-3198-34a9-89ba-8386e86046c4",
                                        "entry_id": "e0142286-2d00-377f-b55f-3a56045ef355",
                                        "glosses": [
                                            "überbracht, geschickt werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed814962-aa49-40ef-9754-4f47cca64410",
                                                "sense_id": "11b02cc2-3198-34a9-89ba-8386e86046c4",
                                                "text": "„Mir ist ein Schreiben folgenden Inhaltes zugekommen (liest): […].“"
                                            },
                                            {
                                                "example_id": "590c795a-9092-4680-b190-b0c90e790ab8",
                                                "sense_id": "11b02cc2-3198-34a9-89ba-8386e86046c4",
                                                "text": "„Einem meiner Freunde ist die Nachricht zugekommen, dass die Chorproben schon begonnen haben, ich selbst habe aber noch keine offizielle Nachricht erhalten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "2cd1ea05-752a-3ffd-9f70-c7f47875ecf9",
                                        "entry_id": "e0142286-2d00-377f-b55f-3a56045ef355",
                                        "glosses": [
                                            "sich an jemanden wenden, Verbindung aufnehmen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "715863fc-147f-4d58-90c0-7e987390a938",
                                                "sense_id": "2cd1ea05-752a-3ffd-9f70-c7f47875ecf9",
                                                "text": "Kommen Sie gerne auf uns zu, wenn noch etwas unklar sein sollte."
                                            },
                                            {
                                                "example_id": "cca182fa-f309-45eb-ae98-ae53aaf4e12f",
                                                "sense_id": "2cd1ea05-752a-3ffd-9f70-c7f47875ecf9",
                                                "text": "„Auf freundliche Empfehlung von Herrn Weber komme ich auf Sie zu.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
