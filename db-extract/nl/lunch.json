                "senses": [
                    {
                        "sense_id": "58a5e394-53ce-39a9-b4ad-f9276486e50a",
                        "entry_id": "cb95e3a4-a3fc-3a41-9fbb-5a0779f0bdf0",
                        "glosses": [
                            "een maaltijd rond of iets na het middaguur"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3fb6fda5-2eff-44e2-81b8-f0cf00ea715b",
                                "sense_id": "58a5e394-53ce-39a9-b4ad-f9276486e50a",
                                "text": "'Dertig jaar geleden zat het hier helemaal vol', zegt Claudette Bonin (60), serveerster van het Relais des Routier in Dordives. Nu zijn een paar tafels bezet voor de lunch."
                            },
                            {
                                "example_id": "69d3b453-600a-4fe3-a8bb-5eb66503c501",
                                "sense_id": "58a5e394-53ce-39a9-b4ad-f9276486e50a",
                                "text": "Zo wist ik precies wat ik moest inkopen voor ontbijt, lunch en avondeten en hoeveel wc-papier, wet-wipes en proteïnepoeder ik nodig zou hebben voor elk deel van de trail."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9f5efe51-647c-4e27-8100-6b34dbafef80",
                        "source_entry_id": "cb95e3a4-a3fc-3a41-9fbb-5a0779f0bdf0",
                        "source_sense_id": "58a5e394-53ce-39a9-b4ad-f9276486e50a",
                        "source_sense_description": "een maaltijd rond of iets na het middaguur",
                        "target_lang_word": "Mittagessen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mittagessen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "865c27a0-f427-39f0-9536-fd0655bf3851",
                                        "entry_id": "8227c363-36d1-3707-b421-613d138fe28c",
                                        "glosses": [
                                            "Mahlzeit, die zur Mittagszeit eingenommen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b508e1e-01f6-4adc-9b04-d0bf99a72978",
                                                "sense_id": "865c27a0-f427-39f0-9536-fd0655bf3851",
                                                "text": "Heute gab es Fischsuppe zum Mittagessen."
                                            },
                                            {
                                                "example_id": "9710d906-c81d-4f51-9f37-33a5f1b8648b",
                                                "sense_id": "865c27a0-f427-39f0-9536-fd0655bf3851",
                                                "text": "„Für andere Geschäfte bediente er sich der Rotunde, die ihm auf dem Wege vom Mittagessen zur Werkstatt am nächsten lag.“"
                                            },
                                            {
                                                "example_id": "15019a5a-65f4-4054-bb33-6bb81789f48b",
                                                "sense_id": "865c27a0-f427-39f0-9536-fd0655bf3851",
                                                "text": "„Nach dem Mittagesssen wurde der Unterricht fortgesetzt.“"
                                            },
                                            {
                                                "example_id": "0785def7-e7d9-4fa6-a975-d3f737644e12",
                                                "sense_id": "865c27a0-f427-39f0-9536-fd0655bf3851",
                                                "text": "„Danach lud er uns noch einen großen Kessel auf, aus dem das Mittagessen an die Gefangenen auszuteilen war.“"
                                            },
                                            {
                                                "example_id": "0640599f-491e-40da-adab-1c61cbbbf25a",
                                                "sense_id": "865c27a0-f427-39f0-9536-fd0655bf3851",
                                                "text": "„Max hätte gern beim Mittagessen Gesellschaft gehabt.“"
                                            },
                                            {
                                                "example_id": "007ef9ab-2f5e-4028-b983-a1644d206b18",
                                                "sense_id": "865c27a0-f427-39f0-9536-fd0655bf3851",
                                                "text": "„Vor dem Mittagessen mußte ich die Hände vorzeigen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
