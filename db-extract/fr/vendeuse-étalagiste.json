                    {
                        "sense_id": "cf157ef9-409f-3d85-859e-82042c3f57ce",
                        "entry_id": "e9cb8824-78e5-344a-99d1-7f8c772e7e53",
                        "glosses": [
                            "Celle qui, dans une boutique, un magasin, est à la fois chargée de la vente et de l’aménagement de la vitrine."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "6cc61fe2-dfb0-4db1-b767-1376e053a675",
                                "sense_id": "cf157ef9-409f-3d85-859e-82042c3f57ce",
                                "text": "Debout toute la journée, dans une atmosphère surchauffée, souvent chargée de poussière, la vendeuse-étalagiste vit sous la menace des varices et des affections pulmonaires."
                            },
                            {
                                "example_id": "93ab241a-a2c5-40d9-a28c-21a039435d92",
                                "sense_id": "cf157ef9-409f-3d85-859e-82042c3f57ce",
                                "text": "Il y a maintenant une école de vente et un C.A.P. de vendeuse-étalagiste obtenu après deux ans d’études et de stages, qui permet d’accéder tout de suite au grade de vendeuse."
                            },
                            {
                                "example_id": "0f02e472-5901-49b2-a86f-f618beb3390a",
                                "sense_id": "cf157ef9-409f-3d85-859e-82042c3f57ce",
                                "text": "C’est ainsi qu’un jour, je vis une petite annonce affichée sur la porte d’un magasin, face à l’Opéra : « On demande une apprentie vendeuse-étalagiste. »"
                            }
                        ]
                    }
