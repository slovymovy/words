                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kata",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "584290eb-cdfc-37ae-9ece-45095bb7b6e8",
                                        "entry_id": "79c34774-f105-3649-b08f-57f0e0fafd4d",
                                        "glosses": [
                                            "Forme, technique dans les arts martiaux japonais."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d39d288b-d3c8-4de9-844f-18b7828ba39d",
                                                "sense_id": "584290eb-cdfc-37ae-9ece-45095bb7b6e8",
                                                "text": "Le kata est un procédé traditionnel de transmission des principes essentiels du Judo. Il consiste à mémoriser un ensemble de techniques fixé historiquement et à exécuter cet ensemble de façon précise en harmonie avec le partenaire."
                                            },
                                            {
                                                "example_id": "425560ed-82a4-4f2a-8ec4-6ad45cd39e4a",
                                                "sense_id": "584290eb-cdfc-37ae-9ece-45095bb7b6e8",
                                                "text": "Pratiquez le kata avec exactitude, le combat réel est une autre affaire."
                                            },
                                            {
                                                "example_id": "11260137-90b2-4e2c-8b72-7fe038f941ae",
                                                "sense_id": "584290eb-cdfc-37ae-9ece-45095bb7b6e8",
                                                "text": "Cet examen comporte six axes : travail des techniques, travail en multidirectionnelle, gestion de la distance, kihon ippon kumité, kata, bunkaï, et combat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca1018ed-4986-3836-a6f9-43a385f09f74",
                                        "entry_id": "79c34774-f105-3649-b08f-57f0e0fafd4d",
                                        "glosses": [
                                            "Court exercice de programmation visant à améliorer les compétences de l’utilisateur par une pratique répétitive."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
