            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d50fbf48-1f07-3449-b1c7-72a6df2ff9a7",
                    "sense_definition": "sich leise, vorsichtig und unbemerkt fortbewegen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bewegung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er <w>schlich</w> mitten in der Nacht auf Zehenspitzen in die Küche, um niemanden im Haus aufzuwecken."
                        },
                        {
                            "text": "Die Katze <w>schleicht</w> vorsichtig durch das hohe Gras, um die kleine Maus nicht zu erschrecken."
                        }
                    ],
                    "antonyms": [
                        "stampfen",
                        "trampeln"
                    ],
                    "common_phrases": [
                        "auf Zehenspitzen schleichen",
                        "durchs Haus schleichen"
                    ]
                },
                {
                    "sense_id": "f8b166aa-61f2-327b-a652-2664629715bc",
                    "sense_definition": "sich auffallend langsam vorwärtsbewegen, insbesondere im Straßenverkehr",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "bewegung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wegen des dichten Nebels <w>schleichen</w> alle Autos nur noch im Schritttempo über die Autobahn."
                        },
                        {
                            "text": "Ein alter Traktor <w>schlich</w> vor uns die enge Landstraße entlang und bremste den gesamten Verkehr aus."
                        }
                    ],
                    "antonyms": [
                        "rasen",
                        "rennen"
                    ],
                    "common_phrases": [
                        "im Schritttempo schleichen",
                        "über die Straße schleichen"
                    ]
                },
                {
                    "sense_id": "17b3ec3c-d175-3b29-8ff0-0710c08d31da",
                    "sense_definition": "einen Ort widerwillig oder nach einer Aufforderung verlassen; abhauen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "weggehen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wenn du mir hier nicht helfen willst, dann <w>schleich</w> dich lieber sofort!"
                        },
                        {
                            "text": "„<w>Schleich</w> dich und lass dich hier nie wieder blicken!“, schrie der Wirt."
                        }
                    ],
                    "common_phrases": [
                        "sich schleichen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "umgangssprachlich verwendet"
                        },
                        {
                            "trait_type": "regional",
                            "comment": "besonders in Süddeutschland und Österreich"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1e865e22-d6aa-399c-81dd-3367ca43abe3",
                    "sense_definition": "das leise, unbemerkte oder auffallend langsame Gehen; Vorgang des Schleichens; Substantivierung des Verbs <w>schleichen</w>",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "bewegung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Durch ihr lautloses <w>Schleichen</w> kam die Raubkatze unbemerkt nah an ihre Beute heran."
                        },
                        {
                            "text": "Sein ständiges <w>Schleichen</w> im Flur machte die Mitbewohner im Haus nervös."
                        }
                    ],
                    "common_phrases": [
                        "lautloses Schleichen"
                    ]
                }
            ]
        }
