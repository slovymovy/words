                "senses": [
                    {
                        "sense_id": "28db74a2-e785-3549-8315-058483c2bbb8",
                        "entry_id": "b2c7e6b4-ff9c-3b49-bc68-078e3c361146",
                        "glosses": [
                            "weibliche Person, die einem Harem angehört"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f06cd452-5c20-4775-9190-fb73d355d64d",
                                "sense_id": "28db74a2-e785-3549-8315-058483c2bbb8",
                                "text": "„Es gab ein paar Jahrzehnte im 17. Jahrhundert, in denen die Haremsdamen die Macht über das Weltreich ausübten, weil sie die Macht über den Sultan hatten.“"
                            },
                            {
                                "example_id": "1df4f6c1-8b1a-4e6e-a9cd-a142cc34cad2",
                                "sense_id": "28db74a2-e785-3549-8315-058483c2bbb8",
                                "text": "„Alten Tanten, Haremsdamen und Nonnen ist im Witz eines gemeinsam, nämlich ihre unbefriedigten sexuellen Gelüste und ihre sexuelle Unersättlichkeit.“"
                            },
                            {
                                "example_id": "8aef0393-9494-4bd2-a3e7-2e836256d8c1",
                                "sense_id": "28db74a2-e785-3549-8315-058483c2bbb8",
                                "text": "„Die auf Forderung von Claires Mann durchgeführte, in Zweifelsfällen ohnehin obligatorische Obduktion Claires zeigt in ihrem Blut die Überdosis eines in Europa kaum bekannten namenlosen Geheimmittels, das unter anderem von arabischen Scheichs benutzt wird, um das Hemmungslose ihrer Haremsdamen ins Extreme zu steigern.“"
                            },
                            {
                                "example_id": "5d03ab65-8353-4280-9af5-ca11a4caa440",
                                "sense_id": "28db74a2-e785-3549-8315-058483c2bbb8",
                                "text": "„Als der Eunuch wieder aus der Dusche kommt, sehen die Haremsdamen sofort: Da ist auf einmal richtig Samba in der Pluderhose!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
