                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b988c1aa-9c1d-423d-9670-c38b8c6f4603",
                                                "sense_id": "e22493eb-2d3a-3b84-90b3-f21dae1fa118",
                                                "text": "Daarop zet je een vaas met bloemen."
                                            },
                                            {
                                                "example_id": "0654a725-77f2-46f0-bfe5-f56e3020cd67",
                                                "sense_id": "e22493eb-2d3a-3b84-90b3-f21dae1fa118",
                                                "text": "Zie je de lijst? Daarop kun je je naam schrijven."
                                            },
                                            {
                                                "example_id": "24201aa1-2abf-4ab6-8ecc-ef99c21710d6",
                                                "sense_id": "e22493eb-2d3a-3b84-90b3-f21dae1fa118",
                                                "text": "Er hingen ook een herdenkingstegeltje van de ramp met daarop het overstroomde eiland Goeree-Overflakkee en het Delfts blauwe bevrijdingsbord Herrijzend Nederland van na de oorlog."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "daarop",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "d3bd68a1-b027-35f9-87a3-8d53c69668d0",
                                        "entry_id": "21e21f2c-136b-382d-afa4-fd162c1fe54a",
                                        "glosses": [
                                            "op een tijdstip vlak na het genoemde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac4a1e39-10d9-48c5-8594-4727d29476d4",
                                                "sense_id": "d3bd68a1-b027-35f9-87a3-8d53c69668d0",
                                                "text": "Na een paar replieken werd het debat gesloten. Daarop kwam 't hoofdpunt ter sprake."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bd21a0f5-9878-4065-aa46-b44e26838c35",
                        "source_entry_id": "75f60b70-0069-3a43-8ec1-71a97ce25ae5",
                        "source_sense_description": "following that/it",
                        "target_lang_word": "sur ce",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sur ce",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a555a9e0-43ef-3f1e-bcc4-7f0f068ed11e",
                                        "entry_id": "97aee906-ce87-3a40-a537-d07e458e9383",
                                        "glosses": [
                                            "Aussitôt après (ce qui a été dit ou ce qui s’est passé)."
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e30d6dbd-b888-4025-9eaa-433ef719531a",
                                                "sense_id": "a555a9e0-43ef-3f1e-bcc4-7f0f068ed11e",
                                                "text": "[…] et sur ce, nous prions Dieu, sire, qu’il donne à Votre Majesté tout heur et prospérité."
                                            },
                                            {
                                                "example_id": "270cf7e7-7a94-4923-813f-fc72327f2918",
                                                "sense_id": "a555a9e0-43ef-3f1e-bcc4-7f0f068ed11e",
                                                "text": "— « Tudieu! Sir, dit-il, savez-vous ce que vous faites et ce qu’ils ont fait ? Si vous voulez savoir la raison de ce que nous avons fait, nous, venez ici. » — Et sur ce, il me montra le pauvre Tosi pendu à un arbre, et la gorge coupée."
                                            },
                                            {
                                                "example_id": "c2496c4d-f8a9-4b1a-9a35-cb40a3aec604",
                                                "sense_id": "a555a9e0-43ef-3f1e-bcc4-7f0f068ed11e",
                                                "text": "Un beau matin, le boucher de Boisville-la-Saint-Père, voulant se décarémer, dit à sa femme : « Je m'en vais tuer un lapin. » Sur ce, il partit, comme d'habitude, avec son chien et sa chienne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7417d485-ad48-44c5-b989-bdbdab11f3a0",
                        "source_entry_id": "75f60b70-0069-3a43-8ec1-71a97ce25ae5",
                        "source_sense_description": "following that/it",
                        "target_lang_word": "là-dessus",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "là-dessus",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dc8c66ca-e37b-3176-99a0-f9e035b1c03a",
                                        "entry_id": "57a0475f-e240-33a1-b72e-d01e6d17cf42",
                                        "glosses": [
                                            "Sur cela."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbbe0a64-15eb-4eb9-acd4-2d3c00babb7e",
                                                "sense_id": "dc8c66ca-e37b-3176-99a0-f9e035b1c03a",
                                                "text": "Tu vas me déclouter toutes les planches de ce couvercle qui est là et tu le mettras là-dessus, sur sa caisse."
                                            },
                                            {
                                                "example_id": "bd9b3485-a9b6-4ed2-8aa5-27252b0cbc8c",
                                                "sense_id": "dc8c66ca-e37b-3176-99a0-f9e035b1c03a",
                                                "text": "— Mais le diable a soufflé là-dessus, de son haleine fiévreuse et empestée, et les pires billevesées ont pris leur vol. L'homme a inventé les dieux et il a crée l'amour avec son cortège de sensibleries ridicules ou criminelles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6ea31aa-ff9c-33e5-99b0-5347e6a1739f",
                                        "entry_id": "57a0475f-e240-33a1-b72e-d01e6d17cf42",
                                        "glosses": [
                                            "Sur ce sujet, sur cette affaire, sur la réalité de telle ou telle chose."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31b64bce-513b-4af9-bb70-b0c7b9feedac",
                                                "sense_id": "a6ea31aa-ff9c-33e5-99b0-5347e6a1739f",
                                                "text": "Pourquoi revenir toujours là-dessus ?"
                                            },
                                            {
                                                "example_id": "82b29f6c-1ad8-4a33-b2d7-10375c738b8d",
                                                "sense_id": "a6ea31aa-ff9c-33e5-99b0-5347e6a1739f",
                                                "text": "Que n’a-t-on pas écrit là-dessus ?"
                                            },
                                            {
                                                "example_id": "66f90f99-4095-412c-889d-afd1e780d316",
                                                "sense_id": "a6ea31aa-ff9c-33e5-99b0-5347e6a1739f",
                                                "text": "Vous pouvez compter là-dessus."
                                            },
                                            {
                                                "example_id": "5d152874-0221-4326-8a1d-3d77ed30ab10",
                                                "sense_id": "a6ea31aa-ff9c-33e5-99b0-5347e6a1739f",
                                                "text": "Nous pouvons travailler là-dessus demain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45fe6614-3860-3d4e-a65e-59a55cd8daed",
                                        "entry_id": "57a0475f-e240-33a1-b72e-d01e6d17cf42",
                                        "glosses": [
                                            "Aussitôt après cela, après ces mots."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c208e75d-1baf-4a92-a628-0a97da39a7e8",
                                                "sense_id": "45fe6614-3860-3d4e-a65e-59a55cd8daed",
                                                "text": "On me l’a dit : il faut que je me venge.\nLà-dessus, au fond des forêts,\nLe Loup l’emporte, et puis le mange,\nSans autre forme de procès."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
