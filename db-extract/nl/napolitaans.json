                    },
                    {
                        "translation_id": "dbfb0682-1864-44c9-8190-1a172ee75233",
                        "source_entry_id": "2a787d02-d6dc-39d3-925c-af46f0675ab4",
                        "source_sense_id": "37d060ca-0c65-3ee3-8cb7-883892375af4",
                        "source_sense_description": "een taal die in Napels, Campanië, Basilicata en noordelijk Calabrië gesproken wordt",
                        "target_lang_word": "napolitain",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "napolitain",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c6d904d4-3cc1-3f23-b7c8-058f2984df2c",
                                        "entry_id": "27cc6b92-894f-3ebc-9bc1-16472634c385",
                                        "glosses": [
                                            "Relatif à Naples ou à ses habitants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04d86abb-de0a-4bb2-b639-5ecdfd16353a",
                                                "sense_id": "c6d904d4-3cc1-3f23-b7c8-058f2984df2c",
                                                "text": "Quand nous respirâmes un peu, la marquise trouva chez moi l’homme avec qui je croyais finir ma vie, Gennaro Conti, le grand compositeur, d’origine napolitaine, mais né à Marseille."
                                            },
                                            {
                                                "example_id": "892344bc-bba0-4491-aaff-338940b12fb0",
                                                "sense_id": "c6d904d4-3cc1-3f23-b7c8-058f2984df2c",
                                                "text": "Il y avait dans cette galère quatre jeunes gens de Marseille, cinq prêtres napolitains, et deux moines de Corfou, qui nous dirent que de pareilles aventures arrivaient tous les jours."
                                            },
                                            {
                                                "example_id": "1f9e4141-5a4d-479c-8146-b2c2645a311e",
                                                "sense_id": "c6d904d4-3cc1-3f23-b7c8-058f2984df2c",
                                                "text": "Ce jour-là, pour faire honneur à sa nation, il avait remplacé ses vêtements napolitains par une jaquette bordée de rose à la Provençale."
                                            },
                                            {
                                                "example_id": "899c6fa9-d578-4bab-8b44-c9a7cec208d4",
                                                "sense_id": "c6d904d4-3cc1-3f23-b7c8-058f2984df2c",
                                                "text": "Crème glacée napolitaine, crème glacée à la fraise, la vanille, et au chocolat."
                                            },
                                            {
                                                "example_id": "312a5fb3-b7cc-467d-ad4e-b7d01910bf89",
                                                "sense_id": "c6d904d4-3cc1-3f23-b7c8-058f2984df2c",
                                                "text": "Baiser napolitain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ab20af1-6cef-33b8-b31d-526906349aba",
                                        "entry_id": "27cc6b92-894f-3ebc-9bc1-16472634c385",
                                        "glosses": [
                                            "Qui appartient à la langue de la région de Naples."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8cfd8923-d296-4ff7-ab3e-2e9354a783ec",
                                                "sense_id": "1ab20af1-6cef-33b8-b31d-526906349aba",
                                                "text": "Beaucoup de mots napolitains ressemblent à de l'italien."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "napolitain",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "60d94fdc-7ccd-3374-8cd0-3e939069415b",
                                        "entry_id": "0fe6ebac-a983-3b75-b700-2d18b723e684",
                                        "glosses": [
                                            "Langue romane parlée à Naples en Italie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3fcba87e-c6e3-40fc-a368-19f0bd1932e2",
                                                "sense_id": "60d94fdc-7ccd-3374-8cd0-3e939069415b",
                                                "text": "On nomme « napolitain » la langue littéraire commune aux divers parlers méridionaux. Elle ne fut jamais la langue officielle du royaume, rôle rempli au XVIᵉ siècle par l'espagnol, plus tard par l'italien."
                                            },
                                            {
                                                "example_id": "3bb2cdb0-7c1d-4948-8727-6525dc16042f",
                                                "sense_id": "60d94fdc-7ccd-3374-8cd0-3e939069415b",
                                                "text": "Le napolitain est compris par de nombreux Italiens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3dfa7d71-a1a8-3930-a6c7-37bad218ce84",
                                        "entry_id": "0fe6ebac-a983-3b75-b700-2d18b723e684",
                                        "glosses": [
                                            "Ancien type de chaussures, sorte de brodequins à semelle ferrée."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0223f0d-a251-48b5-8830-b3753eb0f6fc",
                                                "sense_id": "3dfa7d71-a1a8-3930-a6c7-37bad218ce84",
                                                "text": "En général, les chaussures confectionnées à Fruges sont, ou bien des chaussures de fatigue: des napolitains, des brodequins pour hommes et pour femmes, ou bien des chaussures à élastiques, comme on en porte dans les campagnes …."
                                            },
                                            {
                                                "example_id": "16ce48a4-7fc3-4cbd-9ccb-47e5c78cc1e5",
                                                "sense_id": "3dfa7d71-a1a8-3930-a6c7-37bad218ce84",
                                                "text": "… pauvre de ces chéries avait en revanche bottines, vernis, chaussons à boucles ou escarpins, mules, sabots de cuir, le caoutchouc et les snow boots, zapatos à lisière ou les napolitains, quelquefois les brodequins,…."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf91efb6-3332-3ac9-8abe-01308884852c",
                                        "entry_id": "0fe6ebac-a983-3b75-b700-2d18b723e684",
                                        "glosses": [
                                            "Petit gâteau"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b4c89df-f067-437b-8275-4533dc5ba1b1",
                                                "sense_id": "cf91efb6-3332-3ac9-8abe-01308884852c",
                                                "text": "J’aimerais bien manger un petit napolitain."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
