                ],
                "senses": [
                    {
                        "sense_id": "50bf4b7e-0c12-32b3-8724-476a1e68436d",
                        "entry_id": "8412e8d1-dc55-3aea-ada6-fedc3086429d",
                        "glosses": [
                            "für die Verfolgung von Straftaten zuständiger Beamter im Polizeidienst"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "32f9a841-5d31-415b-b982-021d5e4bfc6c",
                                "sense_id": "50bf4b7e-0c12-32b3-8724-476a1e68436d",
                                "text": "„Auch das Din-A-4-Heftchen, mit dem sich sein Bruder stets nach Dienstschluss auf die Terrasse setzte, wobei er die Lesebrille aufsetzte und eine Zigarette rauchte, ist verschwunden. Penibel genau notierte der Kriminaler darin seine Gedanken.“"
                            },
                            {
                                "example_id": "7b393e6e-4b04-4c99-b8df-331d52ee11fa",
                                "sense_id": "50bf4b7e-0c12-32b3-8724-476a1e68436d",
                                "text": "„Sie sah ihre Schwester mit dem Kriminaler tanzen, aber ihre Blicke gingen gleichmütig weiter.“"
                            },
                            {
                                "example_id": "0fcff993-7ee8-4f88-8611-cee0abbd145a",
                                "sense_id": "50bf4b7e-0c12-32b3-8724-476a1e68436d",
                                "text": "„Viele Kriminaler glauben zum Beispiel, sie hätten mit der Zeit ein Gespür für falsche Geständnisse entwickelt.“"
                            },
                            {
                                "example_id": "e0c81a39-c4c1-41c5-9d47-5174213d2ce7",
                                "sense_id": "50bf4b7e-0c12-32b3-8724-476a1e68436d",
                                "text": "„Mittlerweile hatte ein Kriminaler den Wagen verlassen.“"
                            },
                            {
                                "example_id": "a250a3b2-253e-46b9-80ad-eea6749306f0",
                                "sense_id": "50bf4b7e-0c12-32b3-8724-476a1e68436d",
                                "text": "„Die Kriminaler hatten entschieden keinen Humor, fragten weiter. […] Die Kriminaler verlangten Zeugen, die unabhängig versichern konnten, dass sie nicht im Ausland, und insbesondere nicht in der Tschechoslowakei, gewesen war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
