                ],
                "senses": [
                    {
                        "sense_id": "e662a9d3-ecea-30d6-a4a9-e3c6308933b9",
                        "entry_id": "3b7b04dc-d1f5-30a8-b2c1-05adc2846bc1",
                        "glosses": [
                            "Beseitigung oder wesentliche Minderung von Geruchsbelästigungen, die undefiniert stinken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9230fae-afd3-44fe-985c-8d81870f5009",
                                "sense_id": "e662a9d3-ecea-30d6-a4a9-e3c6308933b9",
                                "text": "Die Geruchsneutralisation der Luft und von Oberflächen kann biologisch, chemisch oder durch ein Ionisationsgerät technisch realisiert werden."
                            },
                            {
                                "example_id": "1171afd0-ce29-4345-881c-bad741810be4",
                                "sense_id": "e662a9d3-ecea-30d6-a4a9-e3c6308933b9",
                                "text": "„Gerüche aller Art lassen sich effektiv über eine professionelle Geruchsneutralisierung beseitigen.“"
                            },
                            {
                                "example_id": "6ff4eb9f-3cf6-429a-99ed-4ecb52a385e5",
                                "sense_id": "e662a9d3-ecea-30d6-a4a9-e3c6308933b9",
                                "text": "„Wir sind seit vielen Jahren als geprüftes Fachunternehmen tätig und kümmern uns um eine professionelle Geruchsneutralisation in den betroffenen Räumlichkeiten.“"
                            },
                            {
                                "example_id": "61ba5577-c22a-4325-b09c-75623ccc5f87",
                                "sense_id": "e662a9d3-ecea-30d6-a4a9-e3c6308933b9",
                                "text": "„Die Geruchsneutralisation durch Ozon ist gesundheitlich vollkommen unbedenklich und hat keine negativen Einfluss auf Gegenstände in der Umgebung.“"
                            },
                            {
                                "example_id": "f1545072-de27-449b-9385-2ac7a03ca8ae",
                                "sense_id": "e662a9d3-ecea-30d6-a4a9-e3c6308933b9",
                                "text": "„Starke Gerüche, wie zum Beispiel durch Fäulnisprozesse, unangenehme Gerüche in Messiwohnungen sowie Gerüche hervorgerufen durch Tiere, Nikotin, Fäkalien oder Schimmelbildung lassen sich effektiv durch eine professionelle Geruchsneutralisation entfernen.“"
                            },
                            {
                                "example_id": "da54bbb1-a80f-4408-8ab5-dd31f94186b1",
                                "sense_id": "e662a9d3-ecea-30d6-a4a9-e3c6308933b9",
                                "text": "„In der Regel reicht es für die Geruchsneutralisation, nur mit der Ionisation zu arbeiten.“"
                            },
                            {
                                "example_id": "0b9da98f-ea68-484d-b1dd-0ef4dc34ffac",
                                "sense_id": "e662a9d3-ecea-30d6-a4a9-e3c6308933b9",
                                "text": "„Kompakte Wandgeräte nutzen im Wesentlichen die freie Konvektion im betreffenden Raum, mit dem Ziel der raumluftbezogenen Geruchsneutralisation, Entkeimung und dem Schadstoffabbau.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
