                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "historisch voorwerp"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A wooden box with holes in which a glowing coal in a small pot was placed to warm the feet."
                    },
