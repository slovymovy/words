                        "entry_id": "7fbb9d7b-031b-354a-b3de-5c0d7ed79ed0",
                        "glosses": [
                            "Sängerin, die Musik und/oder Texte ihres Programms überwiegend selbst geschrieben oder originär bearbeitet hat"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "dc794d30-00df-4c32-a28c-1f1985652814",
                                "sense_id": "45859e7e-dd85-3df2-97f8-943227d2d097",
                                "text": "„Die Ost-Berliner Liedermacherin Bettina Wegner gilt als Ikone des Widerstands in der DDR – und nahm dafür staatliche Verfolgung in Kauf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
