                                "example_id": "2a5069a5-5141-4b17-b1d3-f72bb550d9aa",
                                "sense_id": "12d68bd4-717d-3d88-ae58-e122319385ae",
                                "text": "Gryps BV valt onder de VU-holding Geesteswetenschappen waar ook Taalcentrum-VU en het Archeologisch Centrum deel van uitmaken."
                            },
                            {
                                "example_id": "79854da7-c39e-45fe-8250-a37923e76d95",
                                "sense_id": "12d68bd4-717d-3d88-ae58-e122319385ae",
                                "text": "Jennifer Bekhuis uit Tubbergen heeft deze week een taalcentrum geopend in basisschool De Wiekslag aan de Bruno van Ommenstraat 34 in Tubbergen."
                            }
                        ]
                    },
                    {
