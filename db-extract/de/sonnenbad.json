                "senses": [
                    {
                        "sense_id": "388042b8-5883-32db-b4a3-7f04b01fca38",
                        "entry_id": "3bda8da0-d0ac-39d6-88e2-132d6ff3ae17",
                        "glosses": [
                            "Aufenthalt im Sonnenlicht, um den Körper aufzuwärmen oder um sich zu bräunen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6c0b296-ad03-4f7e-a087-cd74adbb88ea",
                                "sense_id": "388042b8-5883-32db-b4a3-7f04b01fca38",
                                "text": "Nimm ein Sonnenbad, um schön braun zu werden."
                            },
                            {
                                "example_id": "4747b1d0-d145-4dfe-95ea-7806fddee15c",
                                "sense_id": "388042b8-5883-32db-b4a3-7f04b01fca38",
                                "text": "„Die Wirkung der Mondbäder war unbekannt, aber man sagte, sie bewirkten das Gegenteil von Sonnenbädern.“"
                            },
                            {
                                "example_id": "4bead156-9d20-48b7-b34d-3cbe8d85492d",
                                "sense_id": "388042b8-5883-32db-b4a3-7f04b01fca38",
                                "text": "„Alle meine Adern scheinen plötzlich ein Sonnenbad genommen zu haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eb39579f-9a55-454e-acdf-591d3a5d688d",
                        "source_entry_id": "3bda8da0-d0ac-39d6-88e2-132d6ff3ae17",
                        "source_sense_id": "388042b8-5883-32db-b4a3-7f04b01fca38",
