    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ccfc3fbe-fbd6-367e-b0b4-d69e99167fec",
                    "sense_definition": "De geografische positie ten noorden of zuiden van de evenaar, uitgedrukt in graden.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "geografie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>breedtegraad</w> bepaalt in grote mate het klimaat van een regio.",
                            "target_lang_translations": {
                                "en": "The <w>latitude</w> largely determines the climate of a region."
                            }
                        },
                        {
                            "text": "Schepen navigeren vaak door hun exacte <w>breedtegraad</w> te berekenen.",
                            "target_lang_translations": {
                                "en": "Ships often navigate by calculating their exact <w>latitude</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "breedte"
                    ],
                    "common_phrases": [
                        "op een breedtegraad"
                    ],
                    "target_lang_definitions": {
                        "en": "The angular distance north or south from a planet's equator, measured along the meridian of that particular point."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "latitude",
                                "target_lang_sense_clarification": "geographical coordinate"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9cfb3f08-f8cf-36d1-b902-b8cb7a2c13e3",
                    "sense_definition": "Een denkbeeldige cirkel op het aardoppervlak die parallel loopt aan de evenaar.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "geografie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Eindhoven en Londen liggen op dezelfde <w>breedtegraad</w>.",
                            "target_lang_translations": {
                                "en": "Eindhoven and London lie at the same <w>latitude</w>."
                            }
                        },
                        {
                            "text": "De evenaar is de belangrijkste <w>breedtegraad</w> op aarde.",
                            "target_lang_translations": {
                                "en": "The equator is the most important <w>latitude</w> on Earth."
                            }
                        }
                    ],
                    "synonyms": [
                        "breedtecirkel",
                        "parallel",
                        "parallelcirkel"
                    ],
                    "common_phrases": [
                        "deze breedtegraad"
                    ],
                    "target_lang_definitions": {
                        "en": "An imaginary line around a planet running parallel to the equator."
                    },
                    "translations": {
