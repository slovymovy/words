                    {
                        "sense_id": "368d0d34-d73a-321f-b04b-4d1e909d19fb",
                        "entry_id": "fc9193ac-d297-317e-b727-510d70e48267",
                        "glosses": [
                            "oprisping, dampen, hinderlijke uitstoot van maagdampen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8100d9e6-71cc-40ea-9e58-6ab919c3e440",
                                "sense_id": "368d0d34-d73a-321f-b04b-4d1e909d19fb",
                                "text": "\"Verontschuldig mijn onaangediend bezoek\", sprak de edelman met zwakke stem. \"Ik voel echter een vapeur aankomen... Een glaasje water is alles wat ik vraag.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "8d17eacb-a08a-30be-a62b-e2fbbcfb675b",
                        "entry_id": "fc9193ac-d297-317e-b727-510d70e48267",
                        "glosses": [
                            "opvlieger, onprettig warm gevoel waar vrouwen in de overgang soms bij vlagen last van hebben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd93fa00-680b-490b-9438-3b5c0b6538a9",
                                "sense_id": "8d17eacb-a08a-30be-a62b-e2fbbcfb675b",
                                "text": "Ik ben er wel zeker van dat tante Agaath terstond een vapeur gekregen zou hebben als ze had geweten dat anno 1978 farmaceutische heren een pil uitvonden om bruin te worden."
                            }
                        ]
                    },
                    {
                        "sense_id": "192d8bb7-9bd4-3a87-a537-488938123b6b",
                        "entry_id": "fc9193ac-d297-317e-b727-510d70e48267",
                        "glosses": [
                            "stoomtrein, spoortrein"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "144491a3-7313-4790-b4d8-6e5b372bd5c3",
                                "sense_id": "192d8bb7-9bd4-3a87-a537-488938123b6b",
                                "text": "Als ik den eersten keer den vapeur zag komen aangestormd ('t was op onze gewezen Vrijdagmarkt te Brugge), hewel, ik mag u verzekeren dat er mij iets door en door mijn lichaam kroop, gelijk een soort van godvreezende schrik!"
                            }
                        ]
                    },
                    {
                        "sense_id": "2f7ef845-5adb-3a63-a45d-1b64e0ccc81f",
                        "entry_id": "fc9193ac-d297-317e-b727-510d70e48267",
                        "glosses": [
                            "rail waarlangs of wagentje waarop de koeketel om 's winters het veevoer in op te warmen, naar de stal werd gereden"
                        ],
                        "tags": [
                            "veeteelt",
                            "België"
                        ],
                        "examples": [
                            {
                                "example_id": "02ec98c6-3689-458a-8b10-62144df701b5",
                                "sense_id": "2f7ef845-5adb-3a63-a45d-1b64e0ccc81f",
                                "text": "Op een schilderij van A. Koekkoek uit de jaren 1920, dat bij familie bewaard is, is die haard afgebeeld voorzien van een z.g. “vapeur”, een richel door middel waarvan de koeketel, hangend aan een vijshaal, via een deur naar de dieren kon worden verschoven (…)."
                            }
                        ]
                    }
