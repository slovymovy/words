                        "comédie romantique",
                        "week-end romantique"
                    ]
                },
                {
                    "sense_id": "180982fa-8fc1-31f7-a545-dcdd05889e72",
                    "sense_definition": "Relatif au romantisme, mouvement artistique et littéraire du dix-neuvième siècle.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mouvement_artistique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Victor Hugo est l'une des figures majeures du mouvement <w>romantique</w> en France."
                        },
                        {
                            "text": "Cette exposition présente plusieurs chefs-d'œuvre de la peinture <w>romantique</w> européenne."
