                            {
                                "example_id": "9a0360ae-3569-41fc-846a-22116a66a8c8",
                                "sense_id": "a2699790-7557-3bb7-8c5b-a3c0a1303ad4",
                                "text": "„Sie stromerten durch die Baumärkte auf der Suche nach Bambusrohren und geeigneten Hanfseilen.“"
                            },
                            {
                                "example_id": "b2400d30-90b9-4012-9a4b-bf34a72743bc",
                                "sense_id": "a2699790-7557-3bb7-8c5b-a3c0a1303ad4",
                                "text": "„Ein Hanfseil reichte von einem hölzernen Hebel bis zu einer Gießkanne, die auf einer Achse zwischen zwei Streben des Rahmens befestigt war.“"
                            }
                        ],
