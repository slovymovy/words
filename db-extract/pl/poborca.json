                        "translation_id": "7abeeff1-0e5a-429d-916b-ea0eda06f59b",
                        "source_entry_id": "466e85be-1aff-37d0-9076-b9735ce3addb",
                        "source_sense_id": "7602f907-b1fe-366e-905f-aad5fb980655",
                        "target_lang_word": "collector",
