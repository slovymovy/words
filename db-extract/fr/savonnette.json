        "fr-extract.jsonl": [
            {
                "entry_id": "8dcd98a7-2ba1-3248-bd61-1acf1e0ca26c",
                "word": "savonnette",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d562f236-61c6-4a5e-b2e3-ad77422e7aa5",
                        "entry_id": "8dcd98a7-2ba1-3248-bd61-1acf1e0ca26c",
                        "tags": [
                            "plural"
                        ],
                        "form": "savonnettes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d0aadcd7-997b-3949-859e-49373b0c6fa2",
                        "entry_id": "8dcd98a7-2ba1-3248-bd61-1acf1e0ca26c",
                        "glosses": [
                            "Petit savon, très souvent parfumé, destiné à l’hygiène corporelle."
                        ],
                        "tags": [
                            "Cosmétologie"
                        ],
                        "examples": [
                            {
                                "example_id": "047318b9-57d0-4a57-9d19-b4a27e5234ed",
                                "sense_id": "d0aadcd7-997b-3949-859e-49373b0c6fa2",
                                "text": "Peter se passa la savonnette sur les lèvres, frottant et frottant encore pour se débarrasser du miasme de Fenny."
                            }
                        ]
                    },
                    {
                        "sense_id": "bafaa33b-2c81-3fb1-a8c9-ab60b338e6f4",
                        "entry_id": "8dcd98a7-2ba1-3248-bd61-1acf1e0ca26c",
                        "glosses": [
                            "Objet mouillé difficile à maitriser."
                        ],
                        "tags": [
                            "broadly",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "b7cc279d-b4b5-4ca3-b5a5-020d0494eea3",
                                "sense_id": "bafaa33b-2c81-3fb1-a8c9-ab60b338e6f4",
                                "text": "[…] il ne voyait plus rien au delà de dix mètres et la chaussée glissait comme une savonnette."
                            }
                        ]
                    },
                    {
                        "sense_id": "c9f2786b-fdb0-3bfd-8216-ef6d01b5c597",
                        "entry_id": "8dcd98a7-2ba1-3248-bd61-1acf1e0ca26c",
                        "glosses": [
                            "Objet mouillé difficile à maitriser.",
                            "Ballon mouillé."
                        ],
                        "tags": [
                            "broadly",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "8ba7a1a5-74ed-48e1-b0a6-9cd62b698c27",
                                "sense_id": "c9f2786b-fdb0-3bfd-8216-ef6d01b5c597",
                                "text": "Les attaquants insistaient sur le fait que le ballon était une véritable « savonnette » quand leurs mains se couvraient de sueur, après quelques minutes de jeu."
                            }
                        ]
                    },
                    {
                        "sense_id": "94b0db2e-864b-32d8-9ff1-5c566acfe606",
                        "entry_id": "8dcd98a7-2ba1-3248-bd61-1acf1e0ca26c",
                        "glosses": [
                            "Objet mouillé difficile à maitriser.",
                            "Pneu très usé, lisse, d’une automobile."
                        ],
                        "tags": [
                            "broadly",
                            "familiar",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "4e0d9221-7815-47c8-9650-307dca81f891",
                                "sense_id": "94b0db2e-864b-32d8-9ff1-5c566acfe606",
                                "text": "« Faut que tu roules plus vite pour chauffer tes pneus, tant qu’ils seront froids ce sont des savonnettes »."
                            }
                        ]
                    },
                    {
                        "sense_id": "bdb46147-4525-3adc-9b8f-f6b44d304cd6",
                        "entry_id": "8dcd98a7-2ba1-3248-bd61-1acf1e0ca26c",
                        "glosses": [
                            "Objet mouillé difficile à maitriser.",
                            "Automobile dangereuse, aux pneus usés ou tenant très mal la route."
                        ],
                        "tags": [
                            "broadly",
                            "familiar",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "33740a02-a7d6-4fd0-b334-258c3a599caf",
                                "sense_id": "bdb46147-4525-3adc-9b8f-f6b44d304cd6",
                                "text": "Je prouverai que je sais démarrer en douceur, même sans connaître la course de cet embrayage, sûrement une savonnette."
                            }
                        ]
                    },
                    {
                        "sense_id": "ff32d4a9-aece-3fb5-a455-b24f11862448",
                        "entry_id": "8dcd98a7-2ba1-3248-bd61-1acf1e0ca26c",
                        "glosses": [
                            "Bloc de haschich pesant environ 250 grammes (le quart d’un bloc d’un kilo)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "210e9177-8737-45c1-9406-bcf5ce9e8d6b",
                                "sense_id": "ff32d4a9-aece-3fb5-a455-b24f11862448",
                                "text": "[…] si certains ont déjà vu de leurs propres yeux quelque « barrette » ou « savonnette » de cannabis, ils restent, avant 16 ou 17 ans, étonnamment réfractaires à toute idée de consommation personnelle."
                            }
                        ]
                    },
                    {
                        "sense_id": "a6e9efa7-87b0-3ffd-a461-9eac2d935617",
                        "entry_id": "8dcd98a7-2ba1-3248-bd61-1acf1e0ca26c",
                        "glosses": [
                            "Montre à gousset à double boîtier."
                        ],
                        "tags": [
                            "dated",
                            "ellipsis"
                        ],
                        "examples": [
                            {
                                "example_id": "46f1a129-b020-44b5-a2dd-0e67e08caace",
                                "sense_id": "a6e9efa7-87b0-3ffd-a461-9eac2d935617",
                                "text": "Savonnette or à étui, soit à double face, mouvement 18 lignes à ponts, extra-plate, échappement libre à ancre, levées visibles."
                            }
                        ]
                    },
                    {
                        "sense_id": "93e379a8-818d-3857-88fe-c38745814e92",
                        "entry_id": "8dcd98a7-2ba1-3248-bd61-1acf1e0ca26c",
                        "glosses": [
                            "Arbre de 5 à 15 mètres, de la famille des fabacées, originaire des Antilles, Venezuela et Colombie."
                        ],
                        "tags": [
                            "Antilles"
                        ],
                        "examples": [
                            {
                                "example_id": "1efb0f53-42c4-4a72-a950-3411a2c1701d",
                                "sense_id": "93e379a8-818d-3857-88fe-c38745814e92",
                                "text": "SAVONNETTE, arbre de médiocre grandeur, des Antilles , à fleur rosacée, dont le tronc se divise, à peu de distance du sol, en branches assez grosses […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "3898b623-80b4-339a-83f1-dab81136cff0",
                        "entry_id": "8dcd98a7-2ba1-3248-bd61-1acf1e0ca26c",
                        "glosses": [
                            "Pièce de monnaie usée par le temps et dont les détails sont devenus indiscernables."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14ec5a21-a44e-4b61-9085-40f7e8fee13a",
                                "sense_id": "3898b623-80b4-339a-83f1-dab81136cff0",
                                "text": "On dirait bien une savonnette romaine"
                            }
                        ]
                    }
                ],
