                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79f2d0e3-dc86-41f9-a4ed-62e3243854d7",
                                                "sense_id": "cbe102b8-103d-3111-b08d-f987b65fee93",
                                                "text": "Hij baseerde zich op het stuk van Chorus, op zijn eigen herinneringen aan de „dodelijk saaie” buurt, en op het bezwaarschrift „vol juridisch gekwaak” van de omwonenden: „kakkers” met „miljonairsgeneuzel” en „rijkemensengezeik”."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d333bc4-348b-3086-b9bb-0f6bd5ba5d08",
                                        "entry_id": "3280ce6e-4afd-3508-8a4b-942a151bc571",
                                        "glosses": [
                                            "geluid van een kikker, eend, of gans"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed80f6c4-4154-4a68-8fde-1c70625c9781",
                                                "sense_id": "5d333bc4-348b-3086-b9bb-0f6bd5ba5d08",
                                                "text": "Voor volwassen kikkers is het normaal om de winter in winterslaap te overleven. Maar jonge kikkers voltooien hun ontwikkeling doorgaans in het jaar waarin ze uit het ei zijn gekomen. Zeker bruine kikkers, die al vroeg in de lente met voortplanten beginnen – volgende maand zal het gekwaak overal te horen zijn. Vooral in mei zijn er dan kikkervisjes, en in de zomer kruipen de bruine kikkers massaal het land op."
                                            },
                                            {
                                                "example_id": "59890ece-84c9-463b-8928-aaa3a1d533b4",
                                                "sense_id": "5d333bc4-348b-3086-b9bb-0f6bd5ba5d08",
                                                "text": "De sociale kloof is diep, in het vorige decennium waren er bijna 20.000 processen waarbij neo-ruralen hun buren aanklaagden wegens overlast door kraaiende hanen, gekwaak van kikkers of beierende kerkklokken."
                                            }
                                        ]
                                    }
                                ]
                            }
