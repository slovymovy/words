                "senses": [
                    {
                        "sense_id": "f94a9a70-574a-3f34-839d-546d9ac201f5",
                        "entry_id": "137e0367-368a-3b49-9f2c-29abf55cd47a",
                        "glosses": [
                            "Excitation anormale de la mémoire qui s’observe le plus souvent dans le délire et l’état hypnotique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1bfc4b80-8545-4ac8-b85d-bccd92418623",
                                "sense_id": "f94a9a70-574a-3f34-839d-546d9ac201f5",
                                "text": "Jamais il [le maniaque] n'est pris de court, son imagination et son hypermnésie lui fournissant les développements les plus variés."
                            }
                        ]
                    }
                ],
                "translations": [
