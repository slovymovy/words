                    }
                ],
                "senses": [
                    {
                        "sense_id": "6b70cc71-d098-3d7b-8d18-3196e824ae22",
                        "entry_id": "6ecbe363-20b8-329e-b2d4-25a2cc40c28b",
                        "glosses": [
                            "Petit arbre fruitier, de la famille des Rutacées (Rutaceae), originaire de Chine et de Malaisie. → voir Fortunella"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d4d41cd-cd7f-493a-8662-697831fad2bc",
                                "sense_id": "6b70cc71-d098-3d7b-8d18-3196e824ae22",
                                "text": "Les kumquats, du genre Fortunella, sont de petits arbustes produisant de petits fruits totalement comestibles."
                            },
                            {
                                "example_id": "f7f965e7-2316-4ae9-9178-0ab7c50e4c42",
                                "sense_id": "6b70cc71-d098-3d7b-8d18-3196e824ae22",
                                "text": "Le vif zéphyr jubile sur les kumquats du clown gracieux. (pangramme)"
                            }
                        ]
                    },
                    {
                        "sense_id": "82d97442-931b-3ea7-a8a5-59522acb03cb",
                        "entry_id": "6ecbe363-20b8-329e-b2d4-25a2cc40c28b",
                        "glosses": [
                            "Fruit de cet arbre, appartenant à la famille des agrumes, plus petit qu’une orange, souvent consommé confit."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "84be0e99-e73a-486b-b6ee-9cd8e2ef6212",
                                "sense_id": "82d97442-931b-3ea7-a8a5-59522acb03cb",
                                "text": "On se mit à le praliner en surface et à le décorer de la moitié d'un chinois (sorte de kumquat confit et à l'eau-de-vie), ou d'une prune. La mode de ce décor passa."
                            },
                            {
                                "example_id": "5ae9254b-9987-40cf-b73f-b0598c7185c1",
                                "sense_id": "82d97442-931b-3ea7-a8a5-59522acb03cb",
                                "text": "Dans son bouquet tertiaire apparaîtront des arômes suaves de kumquat confit, de fruit de la passion, d’épices douces et d’amande grillée, toujours sur le fond citronné ma foi assagi."
                            },
                            {
                                "example_id": "7fb9931e-5813-4976-bab4-f8e683c7115d",
                                "sense_id": "82d97442-931b-3ea7-a8a5-59522acb03cb",
                                "text": "Les espèces exotiques coûteuses en empreinte carbone (kumquat, yuzu, combava, etc.) sont à réserver aux repas d’exception."
                            }
                        ]
                    }
                ],
                "translations": [
