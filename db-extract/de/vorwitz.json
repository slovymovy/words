                        ],
                        "examples": [
                            {
                                "example_id": "a5731d58-6e41-4659-bd7c-ee90293af8b0",
                                "sense_id": "53398f9f-97d5-3598-96c2-c55e83726928",
                                "text": "Dein unglücksel'ger Vorwitz übereilt / Die fürchterlichste der Entdeckungen, / Und rasen wirst du, wenn du sie gemacht."
                            },
                            {
                                "example_id": "70ee2790-2395-49ce-95a3-856f08606a8c",
                                "sense_id": "53398f9f-97d5-3598-96c2-c55e83726928",
                                "text": "Ich suche keine Abenteuer aus Vorwitz noch Sonderbarkeit, aber weil ich meist klar bin und dem Gegenstand bald seine Eigentümlichkeit abgewinne, so kann ich mehr tun und wagen als ein anderer.",
                                "translation": "Italian Journey",
                                "english": "Italian Journey"
                            }
                        ]
                    },
