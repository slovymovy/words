                "senses": [
                    {
                        "sense_id": "d7c0c49e-4a3c-3afd-a62b-e3d26d6a9932",
                        "entry_id": "fcc6004c-e988-31c0-b67c-b8c252b6014a",
                        "glosses": [
                            "Bus für Ausflugsreisen"
                        ],
                        "tags": [
                            "regional (Schweiz)"
                        ],
                        "examples": [
                            {
                                "example_id": "539ce9d2-fa3a-4085-bf08-ff680eadd763",
                                "sense_id": "d7c0c49e-4a3c-3afd-a62b-e3d26d6a9932",
                                "text": "„Nach einer Polizeiverordnung bedarf das Aufstellen von Autocars auf dem öffentlichen Grund zwecks Angebotes von Stadtrundfahrten der Bewilligung C. Das Aufstellen von Autocars auf öffentlichem Grund zwecks Angebotes von Fernfahrten sowie das Abholen von Teilnehmern an solchen Fahrten ist der Bewilligung D unterstellt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "01dc2346-77ce-4b31-8c45-2d1969ebbfce",
                        "source_entry_id": "fcc6004c-e988-31c0-b67c-b8c252b6014a",
                        "source_sense_id": "d7c0c49e-4a3c-3afd-a62b-e3d26d6a9932",
                        "source_sense_description": "regional (Schweiz): Bus für Ausflugsreisen",
                        "target_lang_word": "autocar",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "autocar",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bf0b4b16-33c0-3b72-8ea0-d91bd95cf528",
                                        "entry_id": "2e3fffde-df83-375e-a124-3ad9e522c6b6",
                                        "glosses": [
                                            "Véhicule de transport, pouvant compter jusqu’à une cinquantaine de places assises, qui effectue soit du transport en commun sur des lignes régulières, soit du transport scolaire, soit du transport de touristes."
                                        ],
                                        "tags": [
                                            "Faux anglicisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4abc6d8-20fc-462d-85b1-8ebf38d81ffa",
                                                "sense_id": "bf0b4b16-33c0-3b72-8ea0-d91bd95cf528",
                                                "text": "J’ai fermé ma gueule, mais je vous l’affirme, inspecteur, quand il est monté dans l’autocar, ce n’était plus ce vieux marqué par trente ans de zonzon, mais un mec tout neuf."
                                            },
                                            {
                                                "example_id": "134ebee4-c56e-453e-a8c6-4fd5160bef02",
                                                "sense_id": "bf0b4b16-33c0-3b72-8ea0-d91bd95cf528",
                                                "text": "Si vous êtes handicapée mentale et domiciliée dans l’’Yonne, Émile Louis vous emmène faire un tour dans son autocar."
                                            },
                                            {
                                                "example_id": "438cadd1-de0f-4b16-b74b-3c1b15c32540",
                                                "sense_id": "bf0b4b16-33c0-3b72-8ea0-d91bd95cf528",
                                                "text": "Voyages en autocar à destination des capitales et grandes cités européennes, Prague, Budapest, Cracovie, Moscou et Saint Pétersbourg, Kiev, Sofia, Dubrovnik, Vienne, Venise, Florence, Rome, Barcelone et Madrid, Lisbonne, Londres, Amsterdam."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "43030707-0e16-43cb-9f6c-5977d9260635",
                        "source_entry_id": "fcc6004c-e988-31c0-b67c-b8c252b6014a",
                        "source_sense_id": "d7c0c49e-4a3c-3afd-a62b-e3d26d6a9932",
