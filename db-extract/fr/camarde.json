                            "sometimes"
                        ],
                        "examples": [
                            {
                                "example_id": "5663ee42-c838-4876-9f06-354962812a60",
                                "sense_id": "ef36192b-e346-318f-a085-60956727ba23",
                                "text": "Car, enfin, la Camarde est assez vigilante / Elle n'a pas besoin qu'on lui tienne la faux / Plus de danse macabre autour des échafauds !",
                                "translation": "Because after all, Death is vigilant enough / He does not need us to hold the scythe for him / No more macabre dance around the scaffold!",
                                "english": "Because after all, Death is vigilant enough / He does not need us to hold the scythe for him / No more macabre dance around the scaffold!"
                            }
                        ]
