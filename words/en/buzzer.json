{
    "word_family": [
        "buzz",
        "buzzing"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "41091420-ce70-3d1b-aed2-0863928f4a78",
                    "sense_definition": "An electrical device that produces a buzzing sound, often used as a signal or alarm.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "signaling devices",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you think you know the answer to the question, hit the <w>buzzer</w> as fast as you can.",
                            "target_lang_translations": {
                                "ru": "Если вы думаете, что знаете ответ на вопрос, нажмите на <w>кнопку</w> как можно быстрее."
                            }
                        },
                        {
                            "text": "The teacher pressed the door <w>buzzer</w> to let the students into the building.",
                            "target_lang_translations": {
                                "ru": "Учитель нажал на дверной <w>звонок</w>, чтобы впустить учеников в здание."
                            }
                        }
                    ],
                    "synonyms": [
                        "beeper",
                        "alarm"
                    ],
                    "common_phrases": [
                        "door buzzer",
                        "game-show buzzer",
                        "press the buzzer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Электрическое устройство, издающее жужжащий звук, часто используемое в качестве сигнала или будильника."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зуммер",
                                "target_lang_sense_clarification": "электронное сигнальное устройство"
                            },
                            {
                                "target_lang_word": "кнопка",
                                "target_lang_sense_clarification": "сигнальная кнопка, например, в викторинах"
                            },
                            {
                                "target_lang_word": "звонок",
                                "target_lang_sense_clarification": "дверной или сигнальный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c66aeb3f-13bc-3e0b-ac53-012cc661ff9e",
                    "sense_definition": "A person or thing that makes a buzzing sound, such as a flying insect.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "buzzing entities",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The little <w>buzzer</w> flew around the garden, landing on every flower it could find.",
                            "target_lang_translations": {
                                "ru": "Маленькая <w>жужжалка</w> летала по саду, садясь на каждый цветок, который могла найти."
                            }
                        },
                        {
                            "text": "I could hear a tiny <w>buzzer</w> near my ear while I was trying to sleep.",
                            "target_lang_translations": {
                                "ru": "Я слышал крошечное <w>жужжание</w> возле уха, когда пытался уснуть."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или предмет, издающий жужжащий звук, например, летающее насекомое."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жужжалка",
                                "target_lang_sense_clarification": "о насекомом или предмете"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c3332e8a-3f9d-3f4e-b826-4ac35e0c935c",
                    "sense_definition": "A person who spreads rumors or gossip.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was known as a <w>buzzer</w> who filled the king's ears with lies about his rivals.",
                            "target_lang_translations": {
                                "ru": "Он был известен как <w>наушник</w>, наполнявший уши короля ложью о его соперниках."
                            }
                        },
                        {
                            "text": "The court was full of <w>buzzers</w> whispering secrets in every dark corner of the palace.",
                            "target_lang_translations": {
                                "ru": "Двор был полон <w>сплетников</w>, шептавших секреты в каждом темном углу дворца."
                            }
                        }
                    ],
                    "synonyms": [
                        "gossip",
                        "rumormonger"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in historical or literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, распространяющий слухи или сплетни."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сплетник",
                                "target_lang_sense_clarification": "человек, распространяющий слухи"
                            },
                            {
                                "target_lang_word": "наушник",
                                "target_lang_sense_clarification": "устар., тот, кто нашептывает на ухо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d211a4d1-9681-3837-affc-2e389d88b088",
                    "sense_definition": "A badge worn or carried by a police officer.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "identification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The detective flipped open his wallet to show the <w>buzzer</w> pinned inside.",
                            "target_lang_translations": {
                                "ru": "Детектив открыл бумажник, чтобы показать приколотый внутри <w>жетон</w>."
                            }
                        },
                        {
                            "text": "He flashed his <w>buzzer</w> at the guard to gain entry to the crime scene.",
                            "target_lang_translations": {
                                "ru": "Он предъявил свой <w>жетон</w> охраннику, чтобы попасть на место преступления."
                            }
                        }
                    ],
                    "synonyms": [
                        "badge",
                        "shield"
                    ],
                    "common_phrases": [
                        "flash a buzzer",
                        "show the buzzer"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "specifically US police slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Значок, который носит или имеет при себе офицер полиции."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жетон",
                                "target_lang_sense_clarification": "полицейский значок"
                            },
                            {
                                "target_lang_word": "бляха",
                                "target_lang_sense_clarification": "разг., полицейский значок"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}