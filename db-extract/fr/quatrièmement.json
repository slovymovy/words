                                        "sense_id": "73411252-576e-3258-bdc8-1d615a244997",
                                        "entry_id": "96e31e78-544e-3ea2-a182-e16371078897",
                                        "glosses": [
                                            "In the fourth place; fourth in a row."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "406e1028-4538-4436-97eb-b782c7949431",
                                                "sense_id": "73411252-576e-3258-bdc8-1d615a244997",
                                                "text": "Fourthly, I have made an effort to call the attention of the reader to the pertinent literature."
                                            },
                                            {
                                                "example_id": "4026c73b-42a6-454c-bdc1-cbe9e09ebe43",
                                                "sense_id": "73411252-576e-3258-bdc8-1d615a244997",
                                                "text": "Fourthly, when all equilibria are unstable and complex endogenous fluctuations arise, the LAW policy reduces the amplitude of fluctuations but at the expense of larger average deviations from the targets."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e5880495-0a9c-4851-99da-cf151320b796",
                        "source_entry_id": "d2943071-dfd3-39ad-b1f4-f21acbf8a30e",
