                                "target_senses": [
                                    {
                                        "sense_id": "ee584c86-c9aa-37a1-a66b-ac3a06c7c9a0",
                                        "entry_id": "a78b32bf-6f54-31d4-a99d-bac92f99f77e",
                                        "glosses": [
                                            "Petite construction fermée ou partiellement fermée, équipée d’un téléphone à l’usage du public."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b2e2200-772d-4134-9b72-0b4dee5eb8c8",
                                                "sense_id": "ee584c86-c9aa-37a1-a66b-ac3a06c7c9a0",
                                                "text": "Je suis entrée dans la première cabine téléphonique et j’ai composé le numéro de Georges."
                                            },
                                            {
                                                "example_id": "ffe62f2c-af50-44f4-80de-66668ec7d133",
                                                "sense_id": "ee584c86-c9aa-37a1-a66b-ac3a06c7c9a0",
                                                "text": "La machine policière est en marche. Le téléphone d’où est passé l’appel est immédiatement localisé. La communication a été émise depuis une cabine téléphonique située au lieu-dit La Commodité, sur la RN 7 à Solterre dans le Loiret."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0351f82-48c5-3509-a945-85130d385e3a",
                                        "entry_id": "a78b32bf-6f54-31d4-a99d-bac92f99f77e",
                                        "glosses": [
                                            "Tout téléphone public avec sous sans cabine ou dispositif permettant à l’utilisateur de s’isoler."
                                        ],
