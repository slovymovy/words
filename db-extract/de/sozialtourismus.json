                "senses": [
                    {
                        "sense_id": "8553182f-dbd3-3fec-b2ea-3e83b2821238",
                        "entry_id": "f841af7b-75b0-30e3-b4dd-c4b5f7587fc4",
                        "glosses": [
                            "das Bemühen, Urlaubsreisen auch für einkommensschwache Schichten zu ermöglichen"
                        ],
                        "tags": [
                            "Sozialpolitik"
                        ],
                        "examples": [
                            {
                                "example_id": "b355c783-ba32-4d4a-a928-05e1d23ce528",
                                "sense_id": "8553182f-dbd3-3fec-b2ea-3e83b2821238",
                                "text": "„Über die sinnvolle Tätigkeit von Reisebüros hinaus -- allerdings nicht für gesteuerte Propagandareisen - könnte unter Mitwirkung der entsprechenden Einrichtungen und Verbände eine Förderung des Sozialtourismus ins Auge gefaßt werden, und zwar mit Selbstverwaltung für die Austauschgruppen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3ec07614-3132-3e0b-9649-230df7f2e719",
                        "entry_id": "f841af7b-75b0-30e3-b4dd-c4b5f7587fc4",
                        "glosses": [
                            "Einwanderung, die nur dazu dient, im Zielland Sozialleistungen zu erhalten"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "43eeda4f-6c07-4351-930e-df42a5674c33",
                                "sense_id": "3ec07614-3132-3e0b-9649-230df7f2e719",
                                "text": "CDU-Innenpolitiker Günter Krings warnt vor Sozialtourismus aus Osteuropa."
                            },
                            {
                                "example_id": "d7046d27-bcfc-42e8-a852-c1f11820c2cb",
                                "sense_id": "3ec07614-3132-3e0b-9649-230df7f2e719",
                                "text": "[Er hatte] in einem am Montagabend gesendeten Interview gesagt: »Wir erleben mittlerweile einen Sozialtourismus dieser Flüchtlinge: nach Deutschland, zurück in die Ukraine, nach Deutschland, zurück in die Ukraine.«"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
