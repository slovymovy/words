                ],
                "senses": [
                    {
                        "sense_id": "6ff0e619-87f2-3c78-94b5-92efbc2c6624",
                        "entry_id": "f9ccf127-e6bc-35d1-89f8-2612aa948069",
                        "glosses": [
                            "Eigenschaft/Fähigkeit, Informationen bei Bedarf für sich behalten zu können, nicht alles ausplaudern zu müssen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c53e65d-78e8-47a1-a456-a31bac8c6bd9",
                                "sense_id": "6ff0e619-87f2-3c78-94b5-92efbc2c6624",
                                "text": "„Ich konnte weder an der Verschwiegenheit C. C.s zweifeln noch an der Aufrichtigkeit, mit der sie mir davon erzählt hätte, wenn sie ihrer Nonne auch nur die geringste Andeutung gemacht hätte.“"
                            },
                            {
                                "example_id": "ac8ce948-8b06-41ac-9c18-b2212ac2d316",
                                "sense_id": "6ff0e619-87f2-3c78-94b5-92efbc2c6624",
                                "text": "„Beim Einzug ins Konklave verpflichten sich die Kardinäle zur Verschwiegenheit über alles, was im Zusammenhang mit der Papstwahl steht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
