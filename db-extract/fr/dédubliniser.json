                "senses": [
                    {
                        "sense_id": "34237f9e-7e19-3b02-ba50-e44194180dfd",
                        "entry_id": "cc5ea70e-f5b8-3f87-a2b4-205878f00aff",
                        "glosses": [
                            "Permettre à quelqu’un de déposer une demande d’asile dans un pays non prévu par la procédure Dublin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d58f48ab-719d-45e0-8de5-9dc9808780ef",
                                "sense_id": "34237f9e-7e19-3b02-ba50-e44194180dfd",
                                "text": "À Calais, la décision de “dédubliniser” a été prise pour régler rapidement la situation."
                            },
                            {
                                "example_id": "2d863785-fdf3-44df-9b19-4d190245d8b1",
                                "sense_id": "34237f9e-7e19-3b02-ba50-e44194180dfd",
                                "text": "Au lieu de la “dédubliniser”, l'État a appliqué la procédure à sa fille, les contraignant toutes deux au départ, vers une nouvelle vie sans filet."
                            },
                            {
                                "example_id": "c7d66fbd-5b0e-4ae9-9adf-5bbf77d11914",
                                "sense_id": "34237f9e-7e19-3b02-ba50-e44194180dfd",
                                "text": "Pour les adultes, la promesse, tenue au mois de mars, de “dédubliniser” les réfugiés de Calais présents en Cao a rencontré l'enthousiasme des réfugiés dont la plupart ont déposé une demande d’asile en France."
                            }
                        ]
                    }
                ],
