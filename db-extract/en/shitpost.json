                "senses": [
                    {
                        "sense_id": "1b0208b2-92c8-3086-bd58-786bc5d93657",
                        "entry_id": "d80bfc9e-55cc-334f-9d20-d5ace6597f01",
                        "glosses": [
                            "To make a shitpost."
                        ],
                        "tags": [
                            "Internet",
                            "derogatory",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "ddad1122-5d02-4118-8d45-f242c7229ad0",
                                "sense_id": "1b0208b2-92c8-3086-bd58-786bc5d93657",
                                "text": "I agree with you. No moderated group. But I still think we have to get all that shitposting out of the group. Ignoring them is ok, not crossposting too (deleting the other recipients), but what do we do with the rec.football and skaterpeople if they go further with crossposting to this group? Do I have to set a filter for every moron (like buddy)?"
                            },
                            {
                                "example_id": "b6f7af73-4a8a-404d-963d-6adca63236e5",
                                "sense_id": "1b0208b2-92c8-3086-bd58-786bc5d93657",
                                "text": "Maybe you should read the whole fucking thread before posting such crap! There are arguments against top or bottom posting...even if after reading the thread you decide to keep shitposting, you should not say its trivial!"
                            },
                            {
                                "example_id": "88407b16-b994-41d4-ad66-98cf0bddca8a",
                                "sense_id": "1b0208b2-92c8-3086-bd58-786bc5d93657",
                                "text": "..and I'm just musing that you taxpayers in the United States are now paying me to shitpost on alt.slack."
                            },
                            {
                                "example_id": "9305d42c-8be9-494b-aeff-9f8b2969e9d1",
                                "sense_id": "1b0208b2-92c8-3086-bd58-786bc5d93657",
                                "text": "I cannot wait until summer ends and you have to go back to middle school so you no longer have time to shitpost 50 times a day."
                            }
                        ]
                    }
