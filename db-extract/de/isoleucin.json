                            {
                                "example_id": "d6bf9d13-fcaf-4f8a-a9ab-9de181f96f43",
                                "sense_id": "7bcf500d-0c3d-3a19-9b2c-7abc496baace",
                                "text": "Die Seitenkette von Isoleucin besteht aus einer verzweigten unsubstituierten Kohlenwasserstoff-Kette."
                            },
                            {
                                "example_id": "03725a7b-97df-4c35-8841-47afe117149b",
                                "sense_id": "7bcf500d-0c3d-3a19-9b2c-7abc496baace",
                                "text": "„Valin, Leucin und Isoleucin werden vom Gehirn besonders leicht aufgenommen und dort dem Stoffwechsel zugeführt, während die anderen Aminosäuren vorwiegend in der Leber abgebaut werden.“"
                            }
                        ],
