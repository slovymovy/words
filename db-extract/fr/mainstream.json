                        "form_id": "32ee891a-d8a0-4c60-8734-2e38ae84997e",
                        "entry_id": "6f3695ab-071d-3717-8be0-c306e0c2e9c4",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
