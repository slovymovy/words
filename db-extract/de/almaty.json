                    {
                        "sense_id": "0ff651df-1e75-3ee7-9195-817aac285345",
                        "entry_id": "306984ff-d361-399f-8472-ba3c94cace3b",
                        "glosses": [
                            "ehemalige Hauptstadt Kasachstans, die im Südosten des Landes liegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6db99076-e2fc-4b66-89bf-723ee3473458",
                                "sense_id": "0ff651df-1e75-3ee7-9195-817aac285345",
                                "text": "„Vor einigen Jahren wurde auf einer von der OSZE unterstützten Konferenz in Almaty die Frage diskutiert, inwieweit die Erfahrungen der Europäischen Union auf diese Region angewendet werden können.“"
                            }
