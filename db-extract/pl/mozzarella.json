                                                "sense_id": "d75d28c8-4645-3276-9011-e9393d6d4d6f",
                                                "text": "Me no rat, I get hella cheddar, I get mozzarella / Take two hundred thousand out the bank ’cause I fucked the teller"
                                            },
                                            {
                                                "example_id": "216e6283-65cf-44a2-940e-e171d8237bd3",
                                                "sense_id": "d75d28c8-4645-3276-9011-e9393d6d4d6f",
                                                "text": "Tell a bank teller / This Louis my sweater / Came through with a Baretta / Stack my cheese, that mozzarella"
                                            },
                                            {
                                                "example_id": "f2eb2875-9547-4154-9947-e6b651b9585a",
                                                "sense_id": "d75d28c8-4645-3276-9011-e9393d6d4d6f",
                                                "text": "I need the cheese, mozzarella / Rainin outside, I got a Louis umbrella / She ate up my dick like Nutella / I used to be four-fourin at the bank"
                                            }
                                        ]
                                    }
                                ]
