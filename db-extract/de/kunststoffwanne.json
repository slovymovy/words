                "senses": [
                    {
                        "sense_id": "682d8c61-ac1f-38f4-adb1-b02ff953c10a",
                        "entry_id": "2e300dc7-8c90-32f3-bdd4-1d04ad0ebc0c",
                        "glosses": [
                            "aus Plastik/Kunststoff bestehende Wanne"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3fb31afd-6c7f-4252-a2f0-18339c7da1ae",
                                "sense_id": "682d8c61-ac1f-38f4-adb1-b02ff953c10a",
                                "text": "„Er sah die Bestatter wieder, wie diese einen nahezu bis zur Unkenntlichkeit verbrannten Körper in die Kunststoffwanne des Sargs hoben.“"
                            },
                            {
                                "example_id": "1c55c28b-70c4-49dc-8e64-6b3b32eda248",
                                "sense_id": "682d8c61-ac1f-38f4-adb1-b02ff953c10a",
                                "text": "„Sie spähte sogar hinter die Toiletten, wo sie in einer Kunststoffwanne Putzmittel, Desinfektionslösung und Einmalhandschuhe entdeckte.“"
                            },
                            {
                                "example_id": "9dcda610-3ef9-490a-b80b-43e129ab50ba",
                                "sense_id": "682d8c61-ac1f-38f4-adb1-b02ff953c10a",
                                "text": "„Mäntel, Jacken, Taschen, Handy, Schlüssel, Geldbeutel wandern in einer Kunststoffwanne durch das Durchleuchtungsgerät.“"
                            },
                            {
                                "example_id": "90e24674-b7ac-4ce0-b880-6c494ec3f0c5",
                                "sense_id": "682d8c61-ac1f-38f4-adb1-b02ff953c10a",
                                "text": "„Stattdessen sammelt der Kunde seine Einkäufe in einer 45 Liter fassenden Kunststoffwanne mit normierten Maßen, die von zwei Längsträgern in angenehmer Höhe gehalten wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
