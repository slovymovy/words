                "senses": [
                    {
                        "sense_id": "7553518d-9e64-3ce5-be03-354080288051",
                        "entry_id": "4171b526-ce8a-30bb-b730-b70c657d2707",
                        "glosses": [
                            "Dégrossir (du bois…)."
                        ],
                        "tags": [
                            "Franche-Comté",
                            "Limousin",
                            "Auvergne"
                        ],
                        "examples": [
                            {
                                "example_id": "4428ecb9-e47c-4e02-9594-39886f0b753a",
                                "sense_id": "7553518d-9e64-3ce5-be03-354080288051",
                                "text": "Mais elle lui demanda où était son père, avec tant d’honnêteté, qu’il fut obligé de lui répondre et de la conduire à la grange, où le père Barbeau était occupé à chapuser."
                            },
                            {
                                "example_id": "3e9a2afd-fc7a-4179-9dea-7e3b1460e1b3",
                                "sense_id": "7553518d-9e64-3ce5-be03-354080288051",
                                "text": "Mais à force de « chapuser », d’enlever du bois au sapin, il finit par n’en laisser plus assez que pour faire un manche d’étrille."
                            }
                        ]
                    }
