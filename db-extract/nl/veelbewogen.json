                "entry_id": "95444e76-c1e3-36d9-b8a9-88f864c77acb",
                "word": "veelbewogen",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "7d448b2d-675f-4d4e-9f36-bc7733c224e1",
                        "entry_id": "95444e76-c1e3-36d9-b8a9-88f864c77acb",
                        "tags": [
                            "partitive",
                            "positive"
                        ],
                        "form": "veelbewogens"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f26d0b0f-d6b7-3456-8915-966d0301cd6d",
                        "entry_id": "95444e76-c1e3-36d9-b8a9-88f864c77acb",
                        "glosses": [
                            "met veel spannende of schokkende gebeurtenissen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad404e36-8c9c-4110-bd03-8a27c839a585",
                                "sense_id": "f26d0b0f-d6b7-3456-8915-966d0301cd6d",
                                "text": "Het boek vertelt over zijn veelbewogen familiegeschiedenis; zijn vader vocht voor de Waffen-SS aan het Oostfront en zijn moeder was een Russische gravin."
                            },
                            {
                                "example_id": "801ca2ed-baf5-4d6b-919d-8d434df5dc96",
                                "sense_id": "f26d0b0f-d6b7-3456-8915-966d0301cd6d",
                                "text": "De veelbewogen negende etappe in de Tour de France is een prooi geworden voor Rigoberto Uran. De Colombiaanse klimmer troefde in de sprint van de kopgroep, onder wie enkele klassementsrenners, ternauwernood Warren Barguil af."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b878360c-f235-4dd9-b49b-f76d016e38bf",
                        "source_entry_id": "95444e76-c1e3-36d9-b8a9-88f864c77acb",
                        "source_sense_id": "f26d0b0f-d6b7-3456-8915-966d0301cd6d",
                        "target_lang_word": "tumultuous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tumultuous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6230b502-2e23-3600-94d9-8ac6e8cdb112",
                                        "entry_id": "dce58991-605b-3fa6-b24e-89b900693dc5",
                                        "glosses": [
                                            "Characterized by loud, confused noise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22e04de3-f137-4812-9a3b-6cdff0d3285f",
                                                "sense_id": "6230b502-2e23-3600-94d9-8ac6e8cdb112",
                                                "text": "Rage with Iambicks, arm'd Archilocus / Numbers for Dialogue and Action fit, / And Favourites of the Dramatick Muſe. / Fierce, Lofty, Rapid, whoſe commanding Sound / Awes the tumultuous Noiſes of the Pit, / And whoſe peculiar Province is the Stage."
                                            },
                                            {
                                                "example_id": "1d0736d2-58cc-4015-bd09-3fc402c727db",
                                                "sense_id": "6230b502-2e23-3600-94d9-8ac6e8cdb112",
                                                "text": "The noise in this room was perfectly tumultuous, for there were more children there, than Scrooge in his agitated state of mind could count; and, unlike the celebrated herd in the poem, they were not forty children conducting themselves like one, but every child was conducting itself like forty."
                                            },
                                            {
                                                "example_id": "fd553766-396a-41b9-abb2-94481276f046",
                                                "sense_id": "6230b502-2e23-3600-94d9-8ac6e8cdb112",
                                                "text": "Down showers tumultuous music from the belfry of Old Trinity— / Merry chiming for His birth, and gave songs for His Divinity!"
                                            },
                                            {
                                                "example_id": "d1f61994-0b0a-4371-bd2d-5d648c8a30b2",
                                                "sense_id": "6230b502-2e23-3600-94d9-8ac6e8cdb112",
                                                "text": "\"Flynn! Flynn! Mike Flynn!\" came surging a tumultuous roar from the crowd."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35a6c789-c057-371d-b008-6ecd8314cc1f",
                                        "entry_id": "dce58991-605b-3fa6-b24e-89b900693dc5",
                                        "glosses": [
                                            "Causing or characterized by tumult; chaotic, disorderly, turbulent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5d9da03-ffc0-4f2f-8f0e-207ae415bf63",
                                                "sense_id": "35a6c789-c057-371d-b008-6ecd8314cc1f",
                                                "text": "Yet not rejoycing in his [Satan's] ſpeed, though bold, / Far off and fearleſs, nor with cauſe to boaſt, / Begins his dire attempt, with nigh the birth / Now rowling, boiles in his tumultuous breſt, / And like a devilliſh Engine back recoiles, / Upon himſelf; […]"
                                            },
                                            {
                                                "example_id": "1256de0c-9f46-4ce7-82e4-c73fd86e4d60",
                                                "sense_id": "35a6c789-c057-371d-b008-6ecd8314cc1f",
                                                "text": "And ſeeing theſe Tumultuous and Rebellious Men do more immediately vent their Malice on ſome of their Fellow-Subjects and Fellow-Protestants, who will be true to their Oaths, and their Obligations to the King, whom God has placed over them, may not one humbly ask, As for theſe Sheep, what have they done? What Cauſe is there whereby an Account may be given of theſe tumultuous Inſurrections against them?"
                                            },
                                            {
                                                "example_id": "e5953931-1a4c-4733-9722-67d9fb83f544",
                                                "sense_id": "35a6c789-c057-371d-b008-6ecd8314cc1f",
                                                "text": "The old cavalier stooped his head in token of acquiescence in the command of his Sovereign, but he raised it not again. The tumultuous agitation of the moment had been too much for spirits which had been long in a state of depression, and health which was much decayed."
                                            },
                                            {
                                                "example_id": "0752f776-42a9-4b3b-ae52-4b3a75da731e",
                                                "sense_id": "35a6c789-c057-371d-b008-6ecd8314cc1f",
                                                "text": "She leaned very slowly closer and yet closer to the mirror; a rich colour spread over her; her eyes, gazing into themselves, became dreamy, inexpressibly wistful, cloudily sweet; her breath was tumultuous."
                                            },
                                            {
                                                "example_id": "46ea7ae3-287d-448b-bf57-58daa2f8436a",
                                                "sense_id": "35a6c789-c057-371d-b008-6ecd8314cc1f",
                                                "text": "A tumultuous waterway, the Yangtze ranks second after the Amazon in terms of discharge. Fed by copious amounts of melting snow and also heavy rains, the river's flow is 10 times greater than China's Huang Ho (Hwang River, Huanghe; also known in English as the Yellow River)."
                                            },
                                            {
                                                "example_id": "0a4183e3-d432-4a1f-816f-a7a58fa859a4",
                                                "sense_id": "35a6c789-c057-371d-b008-6ecd8314cc1f",
                                                "text": "In his first address to a joint session of Congress, after a tumultuous first month in office, Mr [Donald] Trump delivered a conventional speech in a conventional manner."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b6275786-4f89-406d-83d3-484fab7c3e94",
                        "source_entry_id": "95444e76-c1e3-36d9-b8a9-88f864c77acb",
                        "source_sense_id": "f26d0b0f-d6b7-3456-8915-966d0301cd6d",
                        "target_lang_word": "turbulent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "turbulent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c6d5132c-3134-35b3-b70d-e8e6fb526d4b",
                                        "entry_id": "608ae88e-b480-31d4-b81d-8c534b3e8a61",
                                        "glosses": [
                                            "Violently disturbed or agitated; tempestuous, tumultuous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f820017-7318-4c0c-bc6d-9a27766c79bc",
                                                "sense_id": "c6d5132c-3134-35b3-b70d-e8e6fb526d4b",
                                                "text": "It is dangerous to sail in turbulent seas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3756a3b-ea6c-362a-a6d7-3299a54af57c",
                                        "entry_id": "608ae88e-b480-31d4-b81d-8c534b3e8a61",
                                        "glosses": [
                                            "Being in, or causing, disturbance or unrest."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea5c55ea-da20-41d3-95c8-ddd08db0dbd2",
                                                "sense_id": "f3756a3b-ea6c-362a-a6d7-3299a54af57c",
                                                "text": "The mid-19th century was a turbulent time in American history."
                                            },
                                            {
                                                "example_id": "3fceab3c-632e-4f39-a5ca-1308abb0f5df",
                                                "sense_id": "f3756a3b-ea6c-362a-a6d7-3299a54af57c",
                                                "text": "The [Washington] Post's proprietor through those turbulent [Watergate] days, Katharine Graham, held a double place in Washington’s hierarchy: at once regal Georgetown hostess and scrappy newshound, ready to hold the establishment to account. That is a very American position."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
