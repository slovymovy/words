                "senses": [
                    {
                        "sense_id": "37113e42-8d17-337c-8309-8f72390b04c5",
                        "entry_id": "1428c186-b5bb-3cb9-963c-63222f15b27e",
                        "glosses": [
                            "Utiliser le joual pour."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d692bff1-49d5-4091-8af9-2d49a2e55587",
                                "sense_id": "37113e42-8d17-337c-8309-8f72390b04c5",
                                "text": "Tel est le propos des auteurs francophones du Canada qui se sont donné la tâche de joualiser leurs oeuvres, ou d'écrire ' en dialecte '."
                            },
                            {
                                "example_id": "0b72cef7-1df9-4973-bf1b-4551d1e775d1",
                                "sense_id": "37113e42-8d17-337c-8309-8f72390b04c5",
                                "text": "Se pourrait-il que les French Canadians aient réussi à joualiser jusqu'aux plus pures et plus nobles pensées autochtones, celles que tout visiteur d'outre- Atlantique rêve de réinventer dans leur virginité première (voir, entre autres, Thompson 1919)."
                            }
                        ]
                    },
                    {
                        "sense_id": "d43a03ad-6ba2-3ed4-97f4-62da7c935454",
                        "entry_id": "1428c186-b5bb-3cb9-963c-63222f15b27e",
                        "glosses": [
                            "Utiliser le joual."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "684c22e3-3aac-4731-b7ef-93a1cc70c1dd",
                                "sense_id": "d43a03ad-6ba2-3ed4-97f4-62da7c935454",
                                "text": "Sans doute parce que j'y pouvais de la sorte joualiser tout mon soûl."
                            }
                        ]
                    }
