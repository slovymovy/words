        "fr-extract.jsonl": [
            {
                "entry_id": "d84434ec-a1e3-3196-a5bf-9d242dce6760",
                "word": "dédit",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "121630c3-0ded-49d6-808a-cac9a2a90e41",
                        "entry_id": "d84434ec-a1e3-3196-a5bf-9d242dce6760",
                        "tags": [
                            "plural"
                        ],
                        "form": "dédits"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e99f1571-5693-3730-a987-03958dda9c8c",
                        "entry_id": "d84434ec-a1e3-3196-a5bf-9d242dce6760",
                        "glosses": [
                            "Révocation d’une parole donnée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3dc32d47-018b-4ba6-bbbe-988438d7f912",
                                "sense_id": "e99f1571-5693-3730-a987-03958dda9c8c",
                                "text": "Allez, mademoiselle, en fait de mariage, une fille a son dit et son dédit."
                            }
                        ]
                    },
                    {
                        "sense_id": "50a1df82-466a-3c45-a592-58a4d71a1a74",
                        "entry_id": "d84434ec-a1e3-3196-a5bf-9d242dce6760",
                        "glosses": [
                            "Somme stipulée et due par celui qui ne remplit pas les termes d’une convention."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9fe344c3-7f9e-44e3-a7bd-359c51dd369f",
                                "sense_id": "50a1df82-466a-3c45-a592-58a4d71a1a74",
                                "text": "Mais songez au dédit, il faut surtout le mettre."
                            },
                            {
                                "example_id": "e6d09529-f2b7-4c3d-997c-3fbe650d24f4",
                                "sense_id": "50a1df82-466a-3c45-a592-58a4d71a1a74",
                                "text": "Un dédit est le plus souvent une somme à payer."
                            },
                            {
                                "example_id": "799dd8d7-1661-463c-a0ef-15cbb48a0038",
                                "sense_id": "50a1df82-466a-3c45-a592-58a4d71a1a74",
                                "text": "Stipuler un dédit ; Convenir d’un dédit ; Payer le dédit."
                            },
                            {
                                "example_id": "006214ea-04c9-4edb-bcbe-cbbdb1b37703",
                                "sense_id": "50a1df82-466a-3c45-a592-58a4d71a1a74",
                                "text": "Il y a dix mille francs de dédit."
                            },
                            {
                                "example_id": "276e1a1e-f2c4-4270-bdac-6059df21751a",
                                "sense_id": "50a1df82-466a-3c45-a592-58a4d71a1a74",
                                "text": "Rose, par son traité, avait à payer un dédit de dix mille francs, si elle se retirait."
                            }
                        ]
                    },
                    {
                        "sense_id": "75b9bb22-6f31-3b1b-a104-943ae7a5c7f7",
                        "entry_id": "d84434ec-a1e3-3196-a5bf-9d242dce6760",
                        "glosses": [
                            "Acte qui garantit cette stipulation, indemnité encourue par celui ou celle qui se dédira."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "d6387b21-7ba3-47ee-952e-f0be63f365aa",
                                "sense_id": "75b9bb22-6f31-3b1b-a104-943ae7a5c7f7",
                                "text": "Le dédit fut déposé chez un notaire."
                            },
                            {
                                "example_id": "5e1e390a-bfc6-42d4-b5ce-b768489fc3c2",
                                "sense_id": "75b9bb22-6f31-3b1b-a104-943ae7a5c7f7",
                                "text": "Le notaire qui avait rédigé le dédit en demeura dépositaire."
                            },
                            {
                                "example_id": "ea876d45-0c7e-4a96-8181-7180eed714ce",
                                "sense_id": "75b9bb22-6f31-3b1b-a104-943ae7a5c7f7",
                                "text": "Les deux parties s’étant arrangées, on déclara le dédit."
                            },
                            {
                                "example_id": "8a45ff1f-06e4-4414-b05c-65ac1a85a6ec",
                                "sense_id": "75b9bb22-6f31-3b1b-a104-943ae7a5c7f7",
                                "text": "Qu’avec un grand plaisir, dédit, je te déchire."
                            },
                            {
                                "example_id": "b5343401-3d38-4a5c-9520-a6474462e328",
                                "sense_id": "75b9bb22-6f31-3b1b-a104-943ae7a5c7f7",
                                "text": "Le « faux dédit » est aussi très en vogue : dès publication d’une annonce immobilière d’un bien très surévalué, un acheteur se présente et signe sans discuter une promesse de vente, en versant, à titre de garantie, 10 % du prix sur un compte de notaire. Dix jours après, il se désiste et abandonne les 10 % au vendeur, en réalité un complice dont le gain en argent louche est ainsi recyclé."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e2714f95-511d-4550-8d63-0deb2b63d626",
                        "source_entry_id": "d84434ec-a1e3-3196-a5bf-9d242dce6760",
                        "target_lang_word": "Abstandsgeld",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "24b02bf2-59ea-43de-bce3-3dbc73ff10bb",
                        "source_entry_id": "d84434ec-a1e3-3196-a5bf-9d242dce6760",
                        "target_lang_word": "Widerruf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Widerruf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7de8ae3c-bed9-3aa5-abe5-e18cafac6247",
                                        "entry_id": "600e2216-ebac-34b2-994d-2aa7f6ab9e1b",
                                        "glosses": [
                                            "Erklärung/Mitteilung, dass etwas ungültig sein soll"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef0653b5-8563-467a-b21e-1ee826331469",
                                                "sense_id": "7de8ae3c-bed9-3aa5-abe5-e18cafac6247",
                                                "text": "Da ich dem gesendeten Vertrag nicht zustimmen konnte, schrieb ich einen Widerruf."
                                            },
                                            {
                                                "example_id": "a31f6c8f-61b8-498c-b0d7-59070aa4f75f",
                                                "sense_id": "7de8ae3c-bed9-3aa5-abe5-e18cafac6247",
                                                "text": "„Der Grund zu diesem Widerruf kann nur der folgende sein.“"
                                            },
                                            {
                                                "example_id": "82b933b2-e98e-4c9f-afed-6b07bb10a871",
                                                "sense_id": "7de8ae3c-bed9-3aa5-abe5-e18cafac6247",
                                                "text": "„Die Order sei widerrufen worden, er aber habe noch vor dem Widerruf einen Fluchtversuch unternommen, daher die weitere Haft, die neuen Handschellen.“"
                                            },
                                            {
                                                "example_id": "1a5cc452-3621-4aad-85f0-ab33c29c4fd9",
                                                "sense_id": "7de8ae3c-bed9-3aa5-abe5-e18cafac6247",
                                                "text": "„Nachdem Luther einen Widerruf seiner Lehre abgelehnt hatte, verfiel er der Reichsacht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
