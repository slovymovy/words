                                "example_id": "ce16f66f-5846-4c10-9be9-68c0412e06d0",
                                "sense_id": "32065ba0-d0da-393f-84f4-9692deb97615",
                                "text": "No scientific examiner would select only chance variations to establish nonidentity of two specimens when the fundamental points of identification stamp them as originating at a single source."
                            }
                        ]
                    },
