                                    {
                                        "sense_id": "afe5338f-046f-3a21-be3d-01eb7fc7500e",
                                        "entry_id": "86a8ada9-1be7-3be9-a6a4-a024bc248f56",
                                        "glosses": [
                                            "A pile.",
                                            "A large pile of hay, grain, straw, or the like, larger at the bottom than the top, sometimes covered with thatch."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e4e256e-979b-4114-b996-4970f0a740a1",
                                                "sense_id": "afe5338f-046f-3a21-be3d-01eb7fc7500e",
                                                "text": "But corn was housed, and beans were in the stack."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98f32a8f-a0d8-301e-a729-201bb40307d4",
                                        "entry_id": "86a8ada9-1be7-3be9-a6a4-a024bc248f56",
                                        "glosses": [
                                            "A pile.",
                                            "A pile of similar objects, each directly on top of the last."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92f5185c-1084-42d9-9f90-9dcb46d43432",
                                                "sense_id": "98f32a8f-a0d8-301e-a729-201bb40307d4",
                                                "text": "Please bring me a chair from that stack in the corner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3bdbfd78-2ebd-36db-b419-0a71fa1f6aa3",
                                        "entry_id": "86a8ada9-1be7-3be9-a6a4-a024bc248f56",
                                        "glosses": [
                                            "A pile.",
                                            "A pile of poles or wood, indefinite in quantity."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f670c0c-b046-4432-9126-161eca81e3e1",
                                                "sense_id": "3bdbfd78-2ebd-36db-b419-0a71fa1f6aa3",
                                                "text": "There was againſt euery Pillar, a Stacke of Billets, aboue a Mans Height;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb148ede-c5a2-3b31-9f76-a40469b70f06",
                                        "entry_id": "86a8ada9-1be7-3be9-a6a4-a024bc248f56",
                                        "glosses": [
                                            "A pile.",
                                            "A pile of wood containing 108 cubic feet. (~3 m³)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1d68b5c7-16ad-321e-9795-b396dd2710dc",
                                        "entry_id": "86a8ada9-1be7-3be9-a6a4-a024bc248f56",
                                        "glosses": [
                                            "A pile.",
                                            "An extensive collection"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3806f5d-6bdb-4bef-8675-5cbcf6b1add4",
                                                "sense_id": "1d68b5c7-16ad-321e-9795-b396dd2710dc",
                                                "text": "She performed appallingly on standard neurological tests, which are, as Sacks perceptively notes, specifically designed to deconstruct the whole person into a stack of 'abilities'."
                                            },
                                            {
                                                "example_id": "23922eac-4117-4b46-ba78-fccb4fc4d7a0",
                                                "sense_id": "1d68b5c7-16ad-321e-9795-b396dd2710dc",
                                                "text": "“We said, 'Maybe we could come up with a couple of characters doing jokes,'” Correll recalled in 1972. “We had a whole stack of jokes we used to do in these home talent shows"
                                            },
                                            {
                                                "example_id": "5d032259-deac-4d5a-8961-3f8917d20489",
                                                "sense_id": "1d68b5c7-16ad-321e-9795-b396dd2710dc",
                                                "text": "Going back to an earlier question, which I think is very important, this question of how you use skills. It is no good having a great stack of skills in a workplace if the employer does not utilise them properly"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23b2e7b9-7bd8-367c-a973-7db820f3ef9d",
                                        "entry_id": "86a8ada9-1be7-3be9-a6a4-a024bc248f56",
                                        "glosses": [
                                            "A smokestack."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95c9a744-cee6-4379-9ecc-58f9fe81f4a4",
                                                "sense_id": "23b2e7b9-7bd8-367c-a973-7db820f3ef9d",
                                                "text": "With just the turn of a shoulder she indicated the water front, where, at the end of the dock on which they stood, lay the good ship, Mount Vernon, river packet, the black smoke already pouring from her stacks."
                                            },
                                            {
                                                "example_id": "33599765-750c-4c4f-b9fb-a6aa6fc364c1",
                                                "sense_id": "23b2e7b9-7bd8-367c-a973-7db820f3ef9d",
                                                "text": "Long before Shap platform showed up around a corner and the two arms on the gradient post drooped in both directions at once, Duchess of Buccleuch's amiable throbbing purr at the stack had become a fierce freight-engine bark, as she resolutely dragged at her enormous load."
                                            },
                                            {
                                                "example_id": "ad916d06-4885-477e-8598-ba4a6fccb462",
                                                "sense_id": "23b2e7b9-7bd8-367c-a973-7db820f3ef9d",
                                                "text": "The leading engine was one of the Class Y6 2-8-8-2 compound articulateds, [...] The stack noise of one of these great brutes slogging up a grade was quite unforgettable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "960ca9b4-47f0-30a5-a8a3-19b526f6ca46",
                                        "entry_id": "86a8ada9-1be7-3be9-a6a4-a024bc248f56",
                                        "glosses": [
                                            "In computing.",
                                            "A linear data structure in which items inserted are removed in reverse order (the last item inserted is the first one to be removed)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "30b99d32-3241-340f-b891-1f88d845eb8e",
                                        "entry_id": "86a8ada9-1be7-3be9-a6a4-a024bc248f56",
                                        "glosses": [
                                            "In computing.",
                                            "A stack data structure stored in main memory that is manipulated during machine language procedure call related instructions."
                                        ],
                                        "tags": [
                                            "often",
                                            "with-definite-article"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cfe64318-65ba-4b8c-b60c-dc77bc9e15d9",
                                                "sense_id": "30b99d32-3241-340f-b891-1f88d845eb8e",
                                                "text": "When the microprocessor decodes the JSR opcode, it stores the operand into the TEMP register and pushes the current contents of the PC ($00 0128) onto the stack."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15128ca7-d3d2-31ba-b043-5ea92f899701",
                                        "entry_id": "86a8ada9-1be7-3be9-a6a4-a024bc248f56",
                                        "glosses": [
                                            "In computing.",
                                            "An implementation of a protocol suite (set of protocols forming a layered architecture)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55818ec0-3a03-4a27-8f00-a889607d5735",
                                                "sense_id": "15128ca7-d3d2-31ba-b043-5ea92f899701",
                                                "text": "A TCP/IP stack is a library or set of libraries or of OS drivers that take care of networking."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cdd3375c-bac7-35dd-adc6-4f1be047e508",
                                        "entry_id": "86a8ada9-1be7-3be9-a6a4-a024bc248f56",
                                        "glosses": [
                                            "In computing.",
                                            "A combination of interdependent, yet individually replaceable, software components or technologies used together on a system."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60a51257-bbee-43d4-9cf7-c91fbdd113ea",
                                                "sense_id": "cdd3375c-bac7-35dd-adc6-4f1be047e508",
                                                "text": "A Linux, Apache, MySQL, and PHP (LAMP) stack is a configuration of four popular products for hosting websites."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b66df1f3-15ef-3b6b-8719-de5f15fc11dd",
                                        "entry_id": "86a8ada9-1be7-3be9-a6a4-a024bc248f56",
                                        "glosses": [
                                            "A generalization of schemes in algebraic geometry and of sheaves."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c9aba925-1c04-3d4a-af4e-477acceea58e",
                                        "entry_id": "86a8ada9-1be7-3be9-a6a4-a024bc248f56",
                                        "glosses": [
                                            "A coastal landform, consisting of a large vertical column of rock in the sea."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4f7a06b7-0e38-3555-92e1-f7f62999c09c",
                                        "entry_id": "86a8ada9-1be7-3be9-a6a4-a024bc248f56",
                                        "glosses": [
                                            "Compactly spaced bookshelves used to house large collections of books."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db1da1ad-b8ec-412c-9d79-670a8a3b48de",
                                                "sense_id": "4f7a06b7-0e38-3555-92e1-f7f62999c09c",
                                                "text": "You took me to your library and kissed me in the stacks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b605a23-f831-371d-9bdb-8ee4bd511cb4",
                                        "entry_id": "86a8ada9-1be7-3be9-a6a4-a024bc248f56",
                                        "glosses": [
                                            "A large amount of an object."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03086bd3-2b79-45df-a60f-6edab973ac11",
                                                "sense_id": "0b605a23-f831-371d-9bdb-8ee4bd511cb4",
                                                "text": "They paid him a stack of money to keep quiet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20142bc5-30a7-3526-85ec-d5ae7ae41322",
                                        "entry_id": "86a8ada9-1be7-3be9-a6a4-a024bc248f56",
                                        "glosses": [
                                            "A pile of rifles or muskets in a cone shape."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8cf9567a-6e05-364b-a0b9-94796659f0e0",
                                        "entry_id": "86a8ada9-1be7-3be9-a6a4-a024bc248f56",
                                        "glosses": [
                                            "The amount of money a player has on the table."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7cd6883b-500b-3b83-a18b-1109b567253d",
                                        "entry_id": "86a8ada9-1be7-3be9-a6a4-a024bc248f56",
                                        "glosses": [
                                            "In architecture.",
                                            "A number of flues embodied in one structure, rising above the roof."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "96986e6e-f82b-3aec-8a7f-edb467894ed1",
                                        "entry_id": "86a8ada9-1be7-3be9-a6a4-a024bc248f56",
                                        "glosses": [
                                            "In architecture.",
                                            "A vertical drainpipe."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "98ac42c7-03e0-30e9-b1f9-dd1e64c77769",
                                        "entry_id": "86a8ada9-1be7-3be9-a6a4-a024bc248f56",
                                        "glosses": [
                                            "A fall or crash, a prang."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dec15685-7258-4621-9750-57f3337f3a17",
                                                "sense_id": "98ac42c7-03e0-30e9-b1f9-dd1e64c77769",
                                                "text": "\"You've got to go all out in a race or you don't get a good time,\" he said. \"But going all out means that you have a few stacks.\""
                                            },
                                            {
                                                "example_id": "7bd17b66-6a8a-470f-8b57-4a76daa60a78",
                                                "sense_id": "98ac42c7-03e0-30e9-b1f9-dd1e64c77769",
                                                "text": "Fan-shot footage of Bieber’s big stack (not a euphemism) sees the pop singer trying to adjust his pants during a concert in the Canadian city of Saskatoon on Thursday night, 16th June, before an audible “THWACK” can be heard as he falls off the stage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e51503d-92f4-37db-bd2f-4a11cc03e876",
                                        "entry_id": "86a8ada9-1be7-3be9-a6a4-a024bc248f56",
                                        "glosses": [
                                            "A blend of various dietary supplements or anabolic steroids with supposed synergistic benefits."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fb80bfbe-5eca-3246-9acb-8da1fae9b3e9",
                                        "entry_id": "86a8ada9-1be7-3be9-a6a4-a024bc248f56",
                                        "glosses": [
                                            "A holding pattern, with aircraft circling one above the other as they wait to land."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bc36cfd9-84dd-3844-8168-644cec0d3025",
                                        "entry_id": "86a8ada9-1be7-3be9-a6a4-a024bc248f56",
                                        "glosses": [
                                            "The quantity of a given item which fills up an inventory slot or bag."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04cb13bf-2349-43df-be52-49d8ebc76836",
                                                "sense_id": "bc36cfd9-84dd-3844-8168-644cec0d3025",
                                                "text": "I've got 107 Golden Branches, but the stack size is 20 so they're taking up 6 spaces in my inventory."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stack",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "15c6ff89-b4f8-3f32-9154-7c7267dcdef5",
                                        "entry_id": "656b3e08-9bb7-30e3-9d44-a49eabd1dd07",
                                        "glosses": [
                                            "To arrange in a stack, or to add to an existing stack."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c160e507-7649-4f4c-b15f-794151cc4e50",
                                                "sense_id": "15c6ff89-b4f8-3f32-9154-7c7267dcdef5",
                                                "text": "Please stack those chairs in the corner."
                                            },
                                            {
                                                "example_id": "1fc0117c-b439-4e8a-8b45-daaa9671e626",
                                                "sense_id": "15c6ff89-b4f8-3f32-9154-7c7267dcdef5",
                                                "text": "James Hanson, the striker who used to stack shelves in a supermarket, flashed a superb header past Shay Given from Gary Jones's corner 10 minutes after the break."
                                            },
                                            {
                                                "example_id": "b40bb89a-984c-4552-a973-8e18e0367f74",
                                                "sense_id": "15c6ff89-b4f8-3f32-9154-7c7267dcdef5",
                                                "text": "Not long ago, it was difficult to produce photographs of tiny creatures with every part in focus.[…]A photo processing technique called focus stacking has changed that. Developed as a tool to electronically combine the sharpest bits of multiple digital images, focus stacking is a boon to biologists seeking full focus on a micron scale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51bf4168-de07-38bc-8dae-7ee583b7ed53",
                                        "entry_id": "656b3e08-9bb7-30e3-9d44-a49eabd1dd07",
                                        "glosses": [
                                            "To arrange the cards in a deck in a particular manner, especially for cheating."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82b7efb1-cd0a-4af3-b9f7-6e169feb5268",
                                                "sense_id": "51bf4168-de07-38bc-8dae-7ee583b7ed53",
                                                "text": "This is the third hand in a row where you've drawn four of a kind. Someone is stacking the deck!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "739858ad-4db7-3703-a8b1-61a479d998ac",
                                        "entry_id": "656b3e08-9bb7-30e3-9d44-a49eabd1dd07",
                                        "glosses": [
                                            "To arrange or fix to obtain an advantage; to deliberately distort the composition of (an assembly, committee, etc.)."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6c726a5-504b-4488-94c0-06836059143e",
                                                "sense_id": "739858ad-4db7-3703-a8b1-61a479d998ac",
                                                "text": "to be stacked against (someone)"
                                            },
                                            {
                                                "example_id": "04b4c1e6-68e8-4ed2-8b02-09ee824a48e0",
                                                "sense_id": "739858ad-4db7-3703-a8b1-61a479d998ac",
                                                "text": "The Government was accused of stacking the parliamentary committee."
                                            },
                                            {
                                                "example_id": "cc71a0bf-346b-4385-b376-e286f49ba084",
                                                "sense_id": "739858ad-4db7-3703-a8b1-61a479d998ac",
                                                "text": "In 2015 the country's military-stacked national assembly impeached her and banned her from political office over the scheme, which her government introduced after she had campaigned in 2011 promising to support the rural poor."
                                            },
                                            {
                                                "example_id": "076fc8f3-4043-459a-a27e-d4708e92c3a5",
                                                "sense_id": "739858ad-4db7-3703-a8b1-61a479d998ac",
                                                "text": "Many citizens support the recent attacks on democracy, and those who don’t face a system stacked against them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4b72705-06d2-3149-9937-955a985cd94e",
                                        "entry_id": "656b3e08-9bb7-30e3-9d44-a49eabd1dd07",
                                        "glosses": [
                                            "To take all the money another player currently has on the table."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16ff2515-d135-4d15-8b7a-0245e2bfce93",
                                                "sense_id": "c4b72705-06d2-3149-9937-955a985cd94e",
                                                "text": "I won Jill's last $100 this hand; I stacked her!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fde94040-2dcc-3204-8ac2-dfe5df9e1984",
                                        "entry_id": "656b3e08-9bb7-30e3-9d44-a49eabd1dd07",
                                        "glosses": [
                                            "To crash; to fall."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "US",
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5f4cbc3-45ca-4c3e-9b7e-87cf67139e51",
                                                "sense_id": "fde94040-2dcc-3204-8ac2-dfe5df9e1984",
                                                "text": "Jim couldn′t make it today as he stacked his car on the weekend."
                                            },
                                            {
                                                "example_id": "8996bcc3-023a-49d6-a605-89223b43f729",
                                                "sense_id": "fde94040-2dcc-3204-8ac2-dfe5df9e1984",
                                                "text": "1975, Laurie Clancy, A Collapsible Man, Outback Press, page 43,\nMiserable phone calls from Windsor police station or from Russell Street. ‘Mum, I′ve stacked the car; could you get me a lawyer?’, the middle-class panacea for all diseases."
                                            },
                                            {
                                                "example_id": "3b78481a-1b2f-4f6a-8c50-bfea8cbe1918",
                                                "sense_id": "fde94040-2dcc-3204-8ac2-dfe5df9e1984",
                                                "text": "Marmalade: Who stacked the car? (pointing to Saloon) Fangio here. / Jock: (standing) I claim full responsibility for the second bingle."
                                            },
                                            {
                                                "example_id": "077a07df-ca6c-463f-bbb5-b40e60a805f4",
                                                "sense_id": "fde94040-2dcc-3204-8ac2-dfe5df9e1984",
                                                "text": "Eventually he sideswiped a bus and forced other cars to collide, and as he finally stacked the car up on a bridge abutment, he passed out, perhaps from exhaustion, perhaps from his head hitting the windshield."
                                            },
                                            {
                                                "example_id": "6ea3886e-d52a-4213-97d1-44ebbef4caca",
                                                "sense_id": "fde94040-2dcc-3204-8ac2-dfe5df9e1984",
                                                "text": "2007, Martin Chipperfield, slut talk, Night Falling, 34th Parallel Publishing, US, Trade Paperback, page 100,\noh shit danny, i stacked the car / ran into sally, an old school friend / you stacked the car? / so now i need this sally′s address / for the insurance, danny says"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38542f85-d6f1-3a4e-b315-2c065ee2c0e4",
                                        "entry_id": "656b3e08-9bb7-30e3-9d44-a49eabd1dd07",
                                        "glosses": [
                                            "To operate cumulatively."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b92b4c9-e737-470b-af44-f1c32fb8e3f3",
                                                "sense_id": "38542f85-d6f1-3a4e-b315-2c065ee2c0e4",
                                                "text": "A magical widget will double your mojo. And yes, they do stack: if you manage to get two magical widgets, your mojo will be quadrupled. With three, it will be octupled, and so forth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44fee77f-70b8-3130-b3bf-e0755386aa16",
                                        "entry_id": "656b3e08-9bb7-30e3-9d44-a49eabd1dd07",
                                        "glosses": [
                                            "To place (aircraft) into a holding pattern."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "55a9b330-89fd-3526-9359-4b6519d50763",
                                        "entry_id": "656b3e08-9bb7-30e3-9d44-a49eabd1dd07",
                                        "glosses": [
                                            "To collect precious metal in the form of various small objects such as coins and bars."
                                        ],
                                        "tags": [
                                            "informal",
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2499b300-4c36-3fb5-832c-d2facee2a54e",
                                        "entry_id": "656b3e08-9bb7-30e3-9d44-a49eabd1dd07",
                                        "glosses": [
                                            "To have excessive ink transfer."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
