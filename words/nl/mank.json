                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>manken</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>mank</w> aan mijn linkervoet door die lange wandeling.",
                            "target_lang_translations": {
                                "en": "I <w>limp</w> on my left foot because of that long walk.",
                                "ru": "Я <w>хромаю</w> на левую ногу из-за этой долгой прогулки.",
                                "de": "Ich <w>hinke</w> wegen der langen Wanderung auf dem linken Fuß."
                            }
                        },
                        {
                            "text": "Soms <w>mank</w> ik een beetje als het koud weer is.",
                            "target_lang_translations": {
                                "en": "Sometimes I <w>limp</w> a little when the weather is cold.",
                                "ru": "Иногда я немного <w>хромаю</w>, когда погода холодная.",
                                "de": "Manchmal <w>hinke</w> ich ein wenig, wenn das Wetter kalt ist."
                            }
