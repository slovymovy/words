                    {
                        "sense_id": "1cd2e412-ea5e-35b5-960b-3723f3e3fba9",
                        "entry_id": "3e3a36cc-fddc-3436-bbbc-c513e92a2d55",
                        "glosses": [
                            "das Angreifen mit einem Messer als Waffe"
