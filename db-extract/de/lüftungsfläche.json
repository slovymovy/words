                ],
                "senses": [
                    {
                        "sense_id": "67c0c008-5dda-3352-b039-852016c9a05b",
                        "entry_id": "ea84a9e1-f3d1-3ea0-b874-fac994a05a22",
                        "glosses": [
                            "ein zweidimensionales Gebilde, Oberfläche oder auch Ebene, über die Luft strömt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84702e86-73d8-4d2a-beae-8fe01416e0bc",
                                "sense_id": "67c0c008-5dda-3352-b039-852016c9a05b",
                                "text": "„Die freie geometrische Lüftungsfläche ist abzustimmen auf die in Bodennähe vorhandenen Nachströmöffnungen (z.B. Türen, Tore, Fenster, Lichtschächte).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f0634458-936c-3bd8-9178-432aa5ce1328",
                        "entry_id": "ea84a9e1-f3d1-3ea0-b874-fac994a05a22",
                        "glosses": [
                            "die Größe eines solchen Gebildes [1], Flächeninhalt oder auch Öffnung, durch die Luft strömt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b1372f0-ce2a-40b3-9329-a78e7e8ed8a5",
                                "sense_id": "f0634458-936c-3bd8-9178-432aa5ce1328",
                                "text": "„Die Formel zur Berechnung des Wärmestroms über eine geschlossene Lüftungsfläche wird nämlich in gleichem Masse von der Lüftungsfläche und dem mittleren K-Faktor des Einbauteiles beeinflusst.“"
                            },
                            {
                                "example_id": "4406afc6-6ee1-41d0-a253-4bea03b6c9fd",
                                "sense_id": "f0634458-936c-3bd8-9178-432aa5ce1328",
                                "text": "„Für die Bemessung der freien geometrischen Lüftungsfläche von RWA-Öffnungen in der senkrechten Wand gemäss den Anforderungen in den Landesbauordnungen gibt es keine einheitliche Regelung.“"
                            },
                            {
                                "example_id": "2fa4cc61-cff4-4f40-8972-30fb9326bdbe",
                                "sense_id": "f0634458-936c-3bd8-9178-432aa5ce1328",
                                "text": "„Hier empfiehlt es sich mind. 1/2 des Deckels aus Gaze zu machen und auch die untere Lüftungsfläche darf ruhig grosszügig bemessen sein.“"
                            },
                            {
                                "example_id": "e95bb845-dcbf-4d7a-92ec-bc794b017172",
                                "sense_id": "f0634458-936c-3bd8-9178-432aa5ce1328",
                                "text": "„Wird Methan in geschlossenen Gruben ohne Lüftungsflächen gefangen gehalten, erreicht es rasch einen Anteil von 4,5 % des Luftvolumens.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
