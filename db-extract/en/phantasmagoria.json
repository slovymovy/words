                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Phantasmagorie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5e0548aa-57ed-3c98-a903-4d5c96e2426c",
                                        "entry_id": "c91620de-488a-3089-aad0-8e439130adad",
                                        "glosses": [
                                            "Trugbild, Scheinbild"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8e1af18-5117-482a-a763-7cf872a7979b",
                                                "sense_id": "5e0548aa-57ed-3c98-a903-4d5c96e2426c",
                                                "text": "Bei der Aufführung waren spektakuläre Phantasmagorien zu sehen."
                                            },
                                            {
                                                "example_id": "00bf150f-6eb9-4261-9534-73866754f35b",
                                                "sense_id": "5e0548aa-57ed-3c98-a903-4d5c96e2426c",
                                                "text": "„Als auch die Hoffnung auf die Wunderwaffen zunichte war, schlug in der Irrwelt des Führers die Stunde der Phantasmagorien.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "501fccbd-56fc-4516-b2d2-193fa406594c",
                        "source_entry_id": "4df5a8fb-8c82-363c-8395-0edf4945cb7e",
