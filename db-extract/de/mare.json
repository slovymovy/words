                                "target_senses": [
                                    {
                                        "sense_id": "ddac86a1-6a67-3983-b89b-2ca121c807f1",
                                        "entry_id": "4008f7b8-4e3a-3f7c-bfc1-c2b6d8d70d19",
                                        "glosses": [
                                            "An adult female horse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89138a65-a7b2-4c86-87d4-cc4fbf436ac7",
                                                "sense_id": "ddac86a1-6a67-3983-b89b-2ca121c807f1",
                                                "text": "But then I had the [massive] flintlock by me for protection. ¶[…]The linen-press and a chest on the top of it formed, however, a very good gun-carriage; and, thus mounted, aim could be taken out of the window at the old mare feeding in the meadow below by the brook, and a 'bead' could be drawn upon Molly, the dairymaid, kissing the fogger behind the hedge,[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "446eda1e-8bb3-3199-a44e-0b35338f72ed",
                                        "entry_id": "4008f7b8-4e3a-3f7c-bfc1-c2b6d8d70d19",
                                        "glosses": [
                                            "A foolish woman."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "UK",
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6efb500-fdea-4e39-a9c2-e184fa35fe18",
                                                "sense_id": "446eda1e-8bb3-3199-a44e-0b35338f72ed",
                                                "text": "The silly mare phoned your mother, talking about applying for a mortgage, and we don't want that, do we?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mare",
                                "target_lang_code": "en",
