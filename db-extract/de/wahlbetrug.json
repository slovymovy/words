                ],
                "senses": [
                    {
                        "sense_id": "c82b29da-9af9-3adc-80db-0435636c352a",
                        "entry_id": "89a3dd97-e9de-3e7e-ac99-6c4d4a841941",
                        "glosses": [
                            "illegale Manipulation eines Wahlergebnisses"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbf0ab6f-774e-45db-8ba5-9f46d1721bad",
                                "sense_id": "c82b29da-9af9-3adc-80db-0435636c352a",
                                "text": "„Doch selbst dieser verwässerte Sieg war nach Ansicht von Kritikern nur durch massiven Wahlbetrug möglich geworden, auch internationale Wahlbeobachter bemängelten Manipulationen bei der Wahl.“"
                            },
                            {
                                "example_id": "caccb0d4-a06d-4d28-81e2-4f9b81eeb662",
                                "sense_id": "c82b29da-9af9-3adc-80db-0435636c352a",
                                "text": "„Sogar Ermittlungen wegen Wahlbetrugs hat Trump abgekündigt, weil Hillary Clinton angeblich bis zu fünf Millionen illegale Stimmen bekam.“"
                            },
                            {
                                "example_id": "93045d05-a852-473f-84bd-9e2bd8079c84",
                                "sense_id": "c82b29da-9af9-3adc-80db-0435636c352a",
                                "text": "„Ausgebrochen war der Krieg, nachdem bekannt geworden war, dass die Konservativen 1899 Wahlbetrug begangen hatten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "46a695c8-e820-42af-9e08-6a22e3e34453",
                        "source_entry_id": "89a3dd97-e9de-3e7e-ac99-6c4d4a841941",
                        "source_sense_id": "c82b29da-9af9-3adc-80db-0435636c352a",
                        "source_sense_description": "illegale Manipulation eines Wahlergebnisses",
                        "target_lang_word": "electoral fraud",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "electoral fraud",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "57e86329-d7f1-3093-92d5-a1d661c01807",
                                        "entry_id": "7c270591-9c83-363e-8396-076b42a33106",
                                        "glosses": [
                                            "Illegal interference with the process of an election, especially with the intent to stage a desired election outcome."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ce37c9f-75b0-4dc4-a1f4-e240dbdd1de7",
                                                "sense_id": "57e86329-d7f1-3093-92d5-a1d661c01807",
                                                "text": "The taking such measures, in order to secure their fair right of voting to the electors in a particular interest, must be considered rather as an act of official favouritism, than as an electoral fraud."
                                            },
                                            {
                                                "example_id": "ac684064-04a4-4363-bca0-6f3357687084",
                                                "sense_id": "57e86329-d7f1-3093-92d5-a1d661c01807",
                                                "text": "He has saddled the finances of the Principality with the costs of a huge electoral fraud."
                                            },
                                            {
                                                "example_id": "543fe220-8bb9-4012-96f4-09d739921967",
                                                "sense_id": "57e86329-d7f1-3093-92d5-a1d661c01807",
                                                "text": "In addition to the strength of the Social Democratic candidates, I also examined the relationship between other political factors and the incidence of electoral fraud."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
