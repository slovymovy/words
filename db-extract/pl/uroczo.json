                                                "sense_id": "d732a63e-0aed-3343-987d-cbafdae58b55",
                                                "text": "How charmingly sweet you sing."
                                            },
                                            {
                                                "example_id": "1c1d5b74-0e79-466e-8e4f-9e09a7c5ea25",
                                                "sense_id": "d732a63e-0aed-3343-987d-cbafdae58b55",
                                                "text": "This does not take into account the tens of thousands of New Yorkers who are harmlessly and charmingly insane in a peculiarly Manhattanite manner."
                                            },
                                            {
                                                "example_id": "9e3b678f-e418-42ce-b6ce-5b0c68275b81",
                                                "sense_id": "d732a63e-0aed-3343-987d-cbafdae58b55",
                                                "text": "Now, Vimeo user Alejandro Prullansky has compiled a super cut of Anderson's slo-mo shots from across the director's filmography, charmingly – and maybe a tad cheekily – set to The Shins' \"New Slang.\""
                                            }
                                        ]
