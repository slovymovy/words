                        ]
                    },
                    {
                        "translation_id": "2ccc1399-c6bf-438d-b7fe-672b9b2ab245",
                        "source_entry_id": "9a144de6-8426-3ed1-9dbc-0df0b9f20a52",
                        "source_sense_id": "39a1c6cb-ea14-3397-a806-8abc8d2cb099",
                        "source_sense_description": "unglaubliche, haarsträubende Geschichte (die jemand als wahr präsentiert)",
                        "target_lang_word": "cock-and-bull story",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cock-and-bull story",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c01da551-514d-3e19-aca2-51f63dbdbf6e",
                                        "entry_id": "84767627-db70-3919-94f7-bd89a93181ea",
                                        "glosses": [
                                            "A far-fetched and fanciful story or tale of highly dubious validity."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "588146f4-b5f7-4d39-984f-e84aafd491e3",
                                                "sense_id": "c01da551-514d-3e19-aca2-51f63dbdbf6e",
                                                "text": "The grinning landlord, as well as the boarders, seemed amazingly tickled at the sudden friendship which had sprung up between me and Queequeg—especially as Peter Coffin’s cock and bull stories about him had previously so much alarmed me concerning the very person whom I now companied with."
                                            },
                                            {
                                                "example_id": "f1d8ebbc-9a96-4f43-b43d-c46edf013360",
                                                "sense_id": "c01da551-514d-3e19-aca2-51f63dbdbf6e",
                                                "text": "Finding us easy in our ways, he […] told me a cock-and-bull story with the moral of another five francs for the narrator. The thing was palpably absurd; but I paid up, and at once dropped all friendliness of manner, and kept him in his place as an inferior with freezing British dignity. He saw in a moment that he had gone too far, and killed a willing horse; his face fell; I am sure he would have refunded if he could only have thought of a decent pretext."
                                            },
                                            {
                                                "example_id": "a68a7134-ca1d-4d7c-9a7d-3cf339fe783d",
                                                "sense_id": "c01da551-514d-3e19-aca2-51f63dbdbf6e",
                                                "text": "\"Challenger was the man who came with some cock-and-bull story from South America.\" \"What story?\" \"Oh, it was rank nonsense about some queer animals he had discovered.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
