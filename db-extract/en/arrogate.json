                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anmaßen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "47c48967-8014-3e74-b68c-2292a8931a6a",
                                        "entry_id": "cce86350-af82-33c2-beec-4e7de7f611b3",
                                        "glosses": [
                                            "sich etwas erlauben, was einem nicht zusteht; etwas tun, wozu man nicht fähig ist; etwas eigenmächtig, unberechtigterweise für sich in Anspruch nehmen"
                                        ],
                                        "tags": [
