                ],
                "senses": [
                    {
                        "sense_id": "c78fe241-af1b-3c85-b62b-9453bcb0502b",
                        "entry_id": "5af2ad4d-1e9b-37ce-a910-f382ecdfb260",
                        "glosses": [
                            "Faire un fricot, faire cuire, préparer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f90551f4-81f9-4722-b0fc-9cfd3a078133",
                                "sense_id": "c78fe241-af1b-3c85-b62b-9453bcb0502b",
                                "text": "Mon ami Destinge, qui fricotte à l’office, m’apporte les restes d’une pièce montée que nous achevons de démonter le plus consciencieusement du monde."
                            },
                            {
                                "example_id": "e264bce7-6b3e-46b4-96ab-c535474950a6",
                                "sense_id": "c78fe241-af1b-3c85-b62b-9453bcb0502b",
                                "text": "Les centres de loisirs et les maisons de la culture sont en général des sortes de pétaudières où se fricottent « les bouillons de culture »…"
                            },
                            {
                                "example_id": "88cc9314-7e52-43a5-aa74-d5368c7d9170",
                                "sense_id": "c78fe241-af1b-3c85-b62b-9453bcb0502b",
                                "text": "Ellis, la chienne, est là, qui ne quitte pas des yeux le canard qui fricotte."
                            }
                        ]
                    },
                    {
                        "sense_id": "4c207919-59e7-3d6f-9d40-dbab99b032f5",
                        "entry_id": "5af2ad4d-1e9b-37ce-a910-f382ecdfb260",
                        "glosses": [
                            "Manger."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "72b0994b-babe-374a-9c1d-7a20dae7b85e",
                        "entry_id": "5af2ad4d-1e9b-37ce-a910-f382ecdfb260",
                        "glosses": [
                            "Se rassembler pour faire bonne chère de façon discrète, voire secrète ; faire fricot."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "b06e16ad-c16f-3d66-8786-db637be478bb",
                        "entry_id": "5af2ad4d-1e9b-37ce-a910-f382ecdfb260",
                        "glosses": [
                            "Manigancer ; mijoter."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b5670c65-a318-30b1-a857-1a551ac3bf80",
                        "entry_id": "5af2ad4d-1e9b-37ce-a910-f382ecdfb260",
                        "glosses": [
                            "Avoir des relations sentimentales, voire sexuelles, ou bien des relations suspectes, avec quelqu’un."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "44ee6d60-7ab8-4ef4-a91a-30af3cccf858",
                                "sense_id": "b5670c65-a318-30b1-a857-1a551ac3bf80",
                                "text": "C’est avec lui qu’elle fricotte ? railla Marcel."
                            },
                            {
                                "example_id": "76a218a1-06c9-4ae1-8b5c-4ca24d87501a",
                                "sense_id": "b5670c65-a318-30b1-a857-1a551ac3bf80",
                                "text": "Sans doute, ça le démangeait, ces canards qui fricottaient à son nez, dans la mare."
                            },
                            {
                                "example_id": "dbb8b89a-c70b-417a-875e-2ba9d0fc0f56",
                                "sense_id": "b5670c65-a318-30b1-a857-1a551ac3bf80",
                                "text": "Je savais qu’il fricottait avec des huiles même s’il prétend que non."
                            }
                        ]
                    },
                    {
                        "sense_id": "16b5c38c-c1d0-3d43-ace5-8732f232919a",
                        "entry_id": "5af2ad4d-1e9b-37ce-a910-f382ecdfb260",
                        "glosses": [
                            "Préparer secrètement quelque chose de louche."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "285f8710-8851-3b9a-aef4-5dc37c6ead9e",
                        "entry_id": "5af2ad4d-1e9b-37ce-a910-f382ecdfb260",
                        "glosses": [
                            "Faire des profits de manière louche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02614b30-c114-4834-966c-911c21c4191e",
                                "sense_id": "285f8710-8851-3b9a-aef4-5dc37c6ead9e",
                                "text": "Alors Noël s’assied et lui explique la raison de sa présence : il a une enveloppe à lui donner, cette enveloppe lui a été remise par une bande de jeunes qui fricottent avec la drogue."
                            }
                        ]
                    }
                ],
