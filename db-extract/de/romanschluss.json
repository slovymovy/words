                "senses": [
                    {
                        "sense_id": "fe76be7e-ec4b-3bb9-b80c-a26b704172df",
                        "entry_id": "3ec4771e-dcbb-33b9-94af-7e09afdb1928",
                        "glosses": [
                            "Ende eines Romans"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb77ed2e-ab84-46be-94cd-4116e2eaee1e",
                                "sense_id": "fe76be7e-ec4b-3bb9-b80c-a26b704172df",
                                "text": "„Zum Beispiel zunehmend ein Problem: der Romanschluss. Wie gut kann ein Roman aufhören? Ich hasse schlecht ausgehende Romane, und ich habe ein unheimliches Bedürfnis, dass der Roman gut ausgehe.“"
                            },
                            {
                                "example_id": "115a3497-1e2d-44d8-ab63-ab85a760c0ee",
                                "sense_id": "fe76be7e-ec4b-3bb9-b80c-a26b704172df",
                                "text": "„Aus dem offenen Romanschluss ergeben sich verschiedene Interpretationen und vermutlich ist es dieser Ambiguität geschuldet, dass der Roman nach seiner Veröffentlichung ganz unterschiedliche Reaktionen provoziert hat.“"
                            },
                            {
                                "example_id": "c3b66456-d4e0-4682-9f4d-e75333c460e9",
                                "sense_id": "fe76be7e-ec4b-3bb9-b80c-a26b704172df",
                                "text": "„Wird am Romanschluss keine Absage an die Technik erteilt, so wird ihre immerhin relativierte Funktion im utopischen Gesellschaftsbild auch nicht expliziert.“"
                            },
                            {
                                "example_id": "16c2d134-de7d-42ac-a64b-323f84429fa8",
                                "sense_id": "fe76be7e-ec4b-3bb9-b80c-a26b704172df",
                                "text": "„Aus der Sicht von 1930 ist der neue Romanschluss nicht einmal unwahrscheinlich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
