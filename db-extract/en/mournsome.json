                        "glosses": [
                            "Characterised by mourning; mournful"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "225d2ec2-12f1-4117-92a3-c58a3ca42b0b",
                                "sense_id": "40ed4912-d505-37f2-bc78-0fb0593fff60",
                                "text": "I sat up an' squinted in the mournsome dim."
                            },
                            {
                                "example_id": "7e0dab85-abe4-4dc9-a476-7ca9a4147c86",
                                "sense_id": "40ed4912-d505-37f2-bc78-0fb0593fff60",
                                "text": "“That sure sounds mournsome, ma'am. Who looked after you when you ran out of kin entire?”"
                            },
                            {
                                "example_id": "59ee74d2-69b6-4320-87f6-d73c42853734",
                                "sense_id": "40ed4912-d505-37f2-bc78-0fb0593fff60",
                                "text": "Then there came a mellow noise, very low and mournsome, not a sound to be afraid of, but to long to know the meaning, with a soft rise of the hair."
                            },
                            {
                                "example_id": "9b4faab4-47e1-41ba-a943-c32e1b900002",
                                "sense_id": "40ed4912-d505-37f2-bc78-0fb0593fff60",
                                "text": "I become the wind. I wind and wend my mournsome way, I thread the trees with keening."
                            }
                        ]
                    }
                ],
