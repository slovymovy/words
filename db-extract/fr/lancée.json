                    {
                        "sense_id": "d8846e33-d144-3e57-b1e4-bc2515cca9cd",
                        "entry_id": "d7393c8c-8a81-3a28-a555-4ba64813a1da",
                        "glosses": [
                            "path or course where momentum is accumulated"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "c7a6ed3a-9007-475a-a71c-760369cb2828",
                                "sense_id": "d8846e33-d144-3e57-b1e4-bc2515cca9cd",
                                "text": "[...] le bateau s'était littéralement ouvert en deux, en tombant entre deux lames, et, tandis que la partie avant — filant sur sa lancée — emportait les rameurs nᵒˢ 3 et 4, le chef de nage et le nᵒ 2 restaient en panne sur la partie arrière en compagnie du barreur."
                            },
                            {
                                "example_id": "2872eb4b-6459-46e5-a5d0-e1e5bbaf0c17",
                                "sense_id": "d8846e33-d144-3e57-b1e4-bc2515cca9cd",
                                "text": "La voiture poursuivit sur sa lancée, avec la plainte déchirante des pneus sur la chaussée."
                            }
                        ]
                    },
                    {
                        "sense_id": "3e28ea0d-d905-36c3-8ec5-6f4240e61612",
                        "entry_id": "d7393c8c-8a81-3a28-a555-4ba64813a1da",
                        "glosses": [
                            "kickoff, momentum"
                        ],
                        "tags": [
