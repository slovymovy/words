                ],
                "senses": [
                    {
                        "sense_id": "653d71f6-67f5-386d-8a43-05293fa2e071",
                        "entry_id": "d67fe47f-15a8-316a-97eb-1861298171ff",
                        "glosses": [
                            "medizinischer Mund-Nasen-Schutz zur Vermeidung von Ansteckung/Kontamination, besonders während einer Operation"
                        ],
                        "tags": [
                            "Hygiene"
                        ],
                        "examples": [
                            {
                                "example_id": "fc27a36e-bc56-4768-986c-b3d0b23b91b4",
                                "sense_id": "653d71f6-67f5-386d-8a43-05293fa2e071",
                                "text": "„Operationsmasken sollen aus Vliesstoff sein, sie müssen auch einen Bart verläßlich abdecken und sie sollen vor dem Mund einen Hohlraum bilden und nicht im direkten Kontakt mit Nase und Lippen sein.“"
                            },
                            {
                                "example_id": "7c330b2b-39f3-43a2-be59-a38a11a5cb76",
                                "sense_id": "653d71f6-67f5-386d-8a43-05293fa2e071",
                                "text": "„Steel trug einen weißen Arztkittel und hatte eine Operationsmaske vor dem Mund.“"
                            },
                            {
                                "example_id": "60449678-a086-4931-a844-6d7e30704ac6",
                                "sense_id": "653d71f6-67f5-386d-8a43-05293fa2e071",
                                "text": "„Sein Gesicht war fast zur Gänze von einer Operationsmaske verhüllt, die nur die Augen freiließ, deren lodernde Blicke auf June herabstachen.“"
                            },
                            {
                                "example_id": "217b3a94-c7a3-48cd-8c87-5bb23009b48b",
                                "sense_id": "653d71f6-67f5-386d-8a43-05293fa2e071",
                                "text": "„Dabei helfen uns russische Spezialisten mit weißen Kitteln und Operationsmasken. Kundig schließen sie die Öffnungen in unseren Anzügen mit einer Reihe von Faltungen und den berüchtigten Gummibändern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
