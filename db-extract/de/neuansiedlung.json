                    {
                        "sense_id": "0141041a-dd86-3a05-9a8f-0ba69f6f753a",
                        "entry_id": "c895a4c0-d658-3555-a4d4-b77655ab40fa",
                        "glosses": [
                            "Zuweisung/Annahme einer neuen Wohnstelle"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4156fae6-df63-47be-a3b7-236e1d185486",
                                "sense_id": "0141041a-dd86-3a05-9a8f-0ba69f6f753a",
                                "text": "„Der Aufstand der Morisken in den Alpujarras und in der Serranía de Ronda 1570 und deren Vertreibung führte zur Entvölkerung Benalaurías, die durch die geplante Neuansiedlung von Christen ausgeglichen wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ef2fda28-2f72-3f0e-9b95-5e9634400d2a",
                        "entry_id": "c895a4c0-d658-3555-a4d4-b77655ab40fa",
                        "glosses": [
                            "Gründung der Niederlassung eines Betriebes/von Betrieben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d622b8e-19b7-4f1e-ae3f-c20ca569af53",
                                "sense_id": "ef2fda28-2f72-3f0e-9b95-5e9634400d2a",
                                "text": "„Neuansiedlungen, so schildert er, werden momentan nicht umgesetzt.“"
                            },
                            {
                                "example_id": "181f8116-ef7b-40dc-bac3-0b65ca4eb319",
                                "sense_id": "ef2fda28-2f72-3f0e-9b95-5e9634400d2a",
                                "text": "„Der Kaufvertrag ist beurkundet – der Neuansiedlung des Unternehmens Undercover-Werl im Gewerbegebiet KonWerl steht somit nichts mehr im Wege. “"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "afc88b43-1afc-3b57-9b8e-8280c381f1dc",
                        "entry_id": "c895a4c0-d658-3555-a4d4-b77655ab40fa",
                        "glosses": [
                            "Einbringen von Lebewesen in ein Biotop, in dem sie zuvor nicht vorkamen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bdac17ef-98d7-402b-ba9b-25e732fa9fb8",
                                "sense_id": "afc88b43-1afc-3b57-9b8e-8280c381f1dc",
                                "text": "Die Neuansiedlung der Feldhamster ist gelungen."
                            },
                            {
                                "example_id": "15ddb8f8-92a3-4753-aaf3-ce8872c99c59",
                                "sense_id": "afc88b43-1afc-3b57-9b8e-8280c381f1dc",
                                "text": "„Zu den Maßnahmen des direkten fischereilichen Artenschutzes gehören die Wiederansiedlung ehemals in einem Gebiet vorgekommener Arten, die Neuansiedlung von Fischarten in neu entstandenen Gewässern sowie der Besatz zur Stützung von Beständen, die zur Zeit nur mit menschlicher Hilfe erhalten werden können.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
