                        "cross_references": [
                            {
                                "target_word": "curetage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "37f72662-4ea7-3960-8dee-c5f71289a1b7",
                                        "entry_id": "aa732022-c17a-3396-8d96-3d17ab1b7d06",
                                        "glosses": [
                                            "Opération chirurgicale par laquelle on nettoie certains organes intérieurs, surtout chez les femmes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1dc50b2e-19a2-4a51-a3de-58e3f4c576be",
                                                "sense_id": "37f72662-4ea7-3960-8dee-c5f71289a1b7",
                                                "text": "Le lendemain, le médecin vint, l’examina ; c’était une métrite, et sérieuse ; il fallait lui faire un curetage."
                                            },
                                            {
                                                "example_id": "3ebfc83c-7f8e-43d1-b6b9-15e74ae467ac",
                                                "sense_id": "37f72662-4ea7-3960-8dee-c5f71289a1b7",
                                                "text": "L’avortement pratiqué par une commère avait mal tourné. Le chirurgien de l’hôpital avait fait le curetage sans anesthésier la jeune fille, pour la punir « d’avoir attenté à sa santé »."
                                            },
                                            {
                                                "example_id": "c501e1a1-9eb6-4b38-b9db-6d2b1af2c92f",
                                                "sense_id": "37f72662-4ea7-3960-8dee-c5f71289a1b7",
                                                "text": "Si les anomalies cellulaires sont de type endométrial, un curetage utérin est indiqué."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1ac1ccc-1965-33e0-a9ac-9bfbe33d125c",
                                        "entry_id": "aa732022-c17a-3396-8d96-3d17ab1b7d06",
                                        "glosses": [
                                            "Opération de réhabilitation urbaine selon laquelle on détruit un immeuble sauf la façade quand elle présente un intérêt historique ou architectural et que l'on reconstruit intégralement l'arrière de l'immeuble."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ce9c86e4-5a4a-48ba-9977-419f929bc278",
                        "source_entry_id": "dc0590bd-e03b-3cd0-8df9-db4cec090649",
                        "source_sense_id": "eb4daa66-3e40-3bc1-bebe-5eafa7428ae7",
                        "source_sense_description": "the removal of unwanted tissue from a body cavity using a curette",
                        "target_lang_word": "Kürettage",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kürettage",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0dba1783-9b2d-327c-b38c-5764f1039a92",
                                        "entry_id": "fa0b1db9-5cb3-31cc-9b88-30522e193481",
                                        "glosses": [
                                            "„operative Entfernung eines Gewebes durch Ausschabung“"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "652fff21-c417-4f36-97b6-9d8cbd23c52c",
                                                "sense_id": "0dba1783-9b2d-327c-b38c-5764f1039a92",
                                                "text": "„Bei der Beschreibung der Behandlung wird üblicherweise davon ausgegangen, dass die Kürettage der Wurzelspitzenresektion vorausgeht.“"
                                            },
                                            {
                                                "example_id": "61e67e82-8fa4-49a6-ba6f-da8b64976788",
                                                "sense_id": "0dba1783-9b2d-327c-b38c-5764f1039a92",
                                                "text": "„Die instrumentelle Kürettage dient der Entfernung des (restlichen) Schwangerschaftsgewebes aus dem Uterus.“"
                                            },
                                            {
                                                "example_id": "bddad3fa-f264-4173-b84b-0a717e2de1b0",
                                                "sense_id": "0dba1783-9b2d-327c-b38c-5764f1039a92",
                                                "text": "„Endometritis und Kürettage ist fehlerhafterweise für manche Ärzte eine absolute Begriffsverbindung.“"
                                            },
                                            {
                                                "example_id": "c8395423-7351-40ea-8f37-b507d46602fe",
                                                "sense_id": "0dba1783-9b2d-327c-b38c-5764f1039a92",
                                                "text": "„Bei Perforation der Gebärmutter im zweiten Trimenon ist allerdings das viszerale Verletzungsrisiko höher, als bei Kürettagen im ersten Trimenon [75, 76].“"
                                            },
                                            {
                                                "example_id": "5e872bab-a05b-447a-a7f6-c3c6a3ab2ceb",
                                                "sense_id": "0dba1783-9b2d-327c-b38c-5764f1039a92",
                                                "text": "„Auch hier sollte dennoch eine Kürettage erfolgen, um ein Endometriumkarzinom auszuschließen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
