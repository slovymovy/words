                    }
                ],
                "senses": [
                    {
                        "sense_id": "8f0cf366-df9f-3124-bd26-0ba6d217b96e",
                        "entry_id": "710409c7-4231-34a4-af1a-c7d95e697474",
                        "glosses": [
                            "langer Griff eines Besens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c164368-55f0-4727-9e9c-5e501d528701",
                                "sense_id": "8f0cf366-df9f-3124-bd26-0ba6d217b96e",
                                "text": "Sie gaben an, von ihrer 41-jährigen Mutter mit einem Besenstiel geschlagen worden zu sein."
                            },
                            {
                                "example_id": "42c2dcdd-15ef-4477-a667-538991dd3913",
                                "sense_id": "8f0cf366-df9f-3124-bd26-0ba6d217b96e",
                                "text": "„Mit dem Besenstiel stieß sie die Türe zu.“"
                            },
                            {
                                "example_id": "8e1244b0-4402-4572-b5d1-2bdfcaf67c9b",
                                "sense_id": "8f0cf366-df9f-3124-bd26-0ba6d217b96e",
                                "text": "„Bjarni sagte manchmal, sie könnte sich auch mit einem Besenstiel unterhalten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5eea8224-abb4-4cc0-8d8f-61b18562d9f6",
                        "source_entry_id": "710409c7-4231-34a4-af1a-c7d95e697474",
                        "source_sense_id": "8f0cf366-df9f-3124-bd26-0ba6d217b96e",
                        "source_sense_description": "langer Griff eines Besens",
                        "target_lang_word": "broomstick",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "broomstick",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0bdc16e2-c4c4-3bfa-aab0-e3f851389aa1",
                                        "entry_id": "4e3da90d-1bbf-3e82-8e44-5d9ca7eb4919",
                                        "glosses": [
                                            "The handle of a broom (sweeping tool); (sometimes) the entire broom."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6bbcf131-3ec4-3da9-b73d-9f07acf6ee07",
                                        "entry_id": "4e3da90d-1bbf-3e82-8e44-5d9ca7eb4919",
                                        "glosses": [
                                            "A broom imbued with magic, enabling one to fly astride the handle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebdc3046-8200-4713-9f0a-4f63a53b4daf",
                                                "sense_id": "6bbcf131-3ec4-3da9-b73d-9f07acf6ee07",
                                                "text": "Witches of all ages attended these lively gatherings by flying away on their broomsticks[.]"
                                            },
                                            {
                                                "example_id": "7dce2699-ebb2-40a7-b690-5743b5277218",
                                                "sense_id": "6bbcf131-3ec4-3da9-b73d-9f07acf6ee07",
                                                "text": "She really was a witch now. No one but a witch could fly a broomstick."
                                            },
                                            {
                                                "example_id": "f2e2e906-db2d-4ac8-a920-554496dc5734",
                                                "sense_id": "6bbcf131-3ec4-3da9-b73d-9f07acf6ee07",
                                                "text": "Harry ripped the parcel open and gasped as a magnificent, gleaming broomstick rolled out onto his bedspread. [...] It was a Firebolt, identical to the dream broom Harry had gone to see every day in Diagon Alley."
                                            },
                                            {
                                                "example_id": "2e7ab98e-4167-40de-a071-047249411be8",
                                                "sense_id": "6bbcf131-3ec4-3da9-b73d-9f07acf6ee07",
                                                "text": "Greebo, hiccuping occasionally, oozed into his accustomed place among the bristles of Nanny’s broomstick. As they rose above the forest a thin plume of smoke also rose from the castle."
                                            },
                                            {
                                                "example_id": "ffb3b9f2-0d75-468e-86cd-1e18cee79527",
                                                "sense_id": "6bbcf131-3ec4-3da9-b73d-9f07acf6ee07",
                                                "text": "Most people are familiar with the age-old superstition that witches fly on broomsticks to their covens (though they were formerly also reputed to use shovels, cleft sticks, eggshells, ANIMALS and other means of flight)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3734edb3-00a2-3226-b490-4c6c6f81fd9a",
                                        "entry_id": "4e3da90d-1bbf-3e82-8e44-5d9ca7eb4919",
                                        "glosses": [
                                            "A control stick of an airplane or other vehicle."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "167c442f-50ee-364f-8d24-deaf5a65ac30",
                                        "entry_id": "4e3da90d-1bbf-3e82-8e44-5d9ca7eb4919",
                                        "glosses": [
                                            "A firearm."
                                        ],
                                        "tags": [
                                            "rare",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84e8e3ae-1602-4c0f-896b-25ca6562cb8d",
                                                "sense_id": "167c442f-50ee-364f-8d24-deaf5a65ac30",
                                                "text": "Gangdem known for the shootings, go ask Ramz – got whooshed with a broomstick."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "broomstick",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9da39915-3d4e-3d96-a5cf-c3f947cfd8d0",
                                        "entry_id": "b2ceba09-e745-3f66-aacc-97dda16f2c45",
                                        "glosses": [
                                            "To fly on a broomstick, as witches are said to."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91a9c6fc-a869-484c-b202-0a06130fcb3a",
                                                "sense_id": "9da39915-3d4e-3d96-a5cf-c3f947cfd8d0",
                                                "text": "BATTY: But, Mother Witch, I want to go broomsticking, too."
                                            },
                                            {
                                                "example_id": "6be306c5-4f70-4786-89b3-2bdac82845cd",
                                                "sense_id": "9da39915-3d4e-3d96-a5cf-c3f947cfd8d0",
                                                "text": "Cynthia the Witch, whenever she broomsticked back into town would not even be given the chance to lay eyes on my machine or my clothes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2e94e1af-e6fd-443b-b94d-d9799aa8258e",
                        "source_entry_id": "710409c7-4231-34a4-af1a-c7d95e697474",
                        "source_sense_id": "8f0cf366-df9f-3124-bd26-0ba6d217b96e",
                        "source_sense_description": "langer Griff eines Besens",
                        "target_lang_word": "manche à balai",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "manche à balai",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "171270a9-8a01-3914-9ce2-fc0ff434b307",
                                        "entry_id": "ef9f2992-9425-334c-a6d6-d48a12ec9e7a",
                                        "glosses": [
                                            "Manche d'un balai."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d3a7dde-0d8b-4c5c-a58f-756c77ab6cb2",
                                                "sense_id": "171270a9-8a01-3914-9ce2-fc0ff434b307",
                                                "text": "Le corps, une espèce de manche à balai, décemment couvert d’une robe, jouissait des avantages de la nature morte, il ne remuait point."
                                            },
                                            {
                                                "example_id": "6bd07e26-fa6a-4c3f-ac32-cdaccb1e1a83",
                                                "sense_id": "171270a9-8a01-3914-9ce2-fc0ff434b307",
                                                "text": "— Voilà encore ces vieilles folles qui se croient au sabbat, dit-il, et qui font plus de bruit que lorsqu’elles y arrivent à cheval sur un manche à balai."
                                            },
                                            {
                                                "example_id": "92c7473f-ace6-4493-bb2e-b88be3aa904a",
                                                "sense_id": "171270a9-8a01-3914-9ce2-fc0ff434b307",
                                                "text": "J’avais des jouets, une voiture bleue avec des roues, un cheval de bois, tandis qu’ils en étaient réduits à chevaucher des manches à balais et à traîner ce qui n’était carriole que dans leur imagination, deux ou trois planches mal assemblées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e16aae0c-04e1-3975-a1bf-4431fb4a9548",
                                        "entry_id": "ef9f2992-9425-334c-a6d6-d48a12ec9e7a",
                                        "glosses": [
                                            "Manette de direction, levier de commande de l’avion."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd6647fb-0e71-49da-a28e-0f89e2863ba1",
                                                "sense_id": "e16aae0c-04e1-3975-a1bf-4431fb4a9548",
                                                "text": "Dans cet élan prodigieux, la machine parut lever le nez et se raidir. Nous avons fait comme un saut de mouton, puis j’ai arraché, avec plus d’énergie peut-être qu’auparavant, le « manche à balai ». À cet instant notre biplan se trouva dans une position beaucoup plus normale, et fila d’un trait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8dcaf08d-6813-38f4-bba2-0bf275baf83f",
                                        "entry_id": "ef9f2992-9425-334c-a6d6-d48a12ec9e7a",
                                        "glosses": [
                                            "Dispositif de commande à plusieurs degrés de liberté servant à déplacer le curseur d’un écran de visualisation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
