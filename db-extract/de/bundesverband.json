                "senses": [
                    {
                        "sense_id": "03805685-1aae-3cb4-9cc9-05115ba72b5b",
                        "entry_id": "b3327886-5c98-383f-8d8e-acd144f56b54",
                        "glosses": [
                            "Verband auf Bundesebene"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a328cc23-4df9-427f-b51b-2175ba481847",
                                "sense_id": "03805685-1aae-3cb4-9cc9-05115ba72b5b",
                                "text": "„Mit knapp 20 Prozent liegt Strom aus Wind, Wasser oder Sonne nun an zweiter Stelle nach der heimischen Braunkohle (24,6 Prozent), wie der Bundesverband der deutschen Energiewirtschaft (BDEW) in ersten Berechnungen ermittelt hat.“"
                            },
                            {
                                "example_id": "5c87f479-2ddd-4b7b-bb68-3ca0a7d50c17",
                                "sense_id": "03805685-1aae-3cb4-9cc9-05115ba72b5b",
                                "text": "„Matthias Keller vom Bundesverband der deutschen Fischindustrie sagt, der Pangasius sei der erste Zuchtfisch, der für die Tiefkühlindustrie interessant sei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
