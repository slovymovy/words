                "senses": [
                    {
                        "sense_id": "2d9517bb-f012-37e1-a6fe-229a27d6ab58",
                        "entry_id": "a16a20d4-d1c5-3c2b-923a-f632d8ae8387",
                        "glosses": [
                            "Faire perdre son caractère croate à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e31cae8-0c00-4346-9fdd-e4b913668a8e",
                                "sense_id": "2d9517bb-f012-37e1-a6fe-229a27d6ab58",
                                "text": "Faute de nouvelle formule associative, il n’y avait que l’alternative : ou laisser les minorités serbes de Croatie à la merci d’une croatisation annoncée et menaçante ; ou s’emparer de la Slavonie et de la Krajina et les décroatiser."
                            },
                            {
                                "example_id": "89e579bf-a6b4-455a-b368-1e40575884b9",
                                "sense_id": "2d9517bb-f012-37e1-a6fe-229a27d6ab58",
                                "text": "Au contraire les milices serbes parviennent à « décroatiser » la Slavonie et une partie de la Dalmatie, et « serbiser » la Voïvodine."
                            }
                        ]
                    }
                ],
