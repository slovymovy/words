{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a02e76de-3b25-34f5-bb9d-4f0ce1c1a3b9",
                    "sense_definition": "The intermediate light in a set of three traffic lights, which indicates that drivers should stop if it is safe to do so.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "traffic_light",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You must slow down and prepare to stop when the traffic signal turns <w>amber</w>.",
                            "target_lang_translations": {
                                "ru": "Вы должны снизить скорость и приготовиться остановиться, когда сигнал светофора сменится на <w>жёлтый</w>.",
                                "zh": "当交通信号灯变成<w>黄灯</w>时，你必须减速并准备停车。"
                            }
                        },
                        {
                            "text": "He waited impatiently for the <w>amber</w> light to switch to green so he could go.",
                            "target_lang_translations": {
                                "ru": "Он нетерпеливо ждал, когда <w>жёлтый</w> свет сменится на зелёный, чтобы поехать.",
                                "zh": "他不耐烦地等着<w>黄灯</w>变绿，这样他就可以走了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "yellow"
                    ],
                    "antonyms": [
                        "red",
                        "green"
                    ],
                    "common_phrases": [
                        "amber light",
                        "flashing amber"
                    ],
                    "target_lang_definitions": {
                        "ru": "Средний сигнал светофора, указывающий, что водители должны остановиться, если это безопасно.",
                        "zh": "交通信号灯中的中间灯，表示驾驶员在安全的情况下应停车。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жёлтый свет",
                                "target_lang_sense_clarification": "сигнал светофора"
                            },
                            {
                                "target_lang_word": "жёлтый сигнал",
                                "target_lang_sense_clarification": "сигнал светофора"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "黄灯",
                                "target_lang_sense_clarification": "交通信号灯"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "375f7880-ccbb-32e9-80ee-e80cdb114004",
                    "sense_definition": "A hard, translucent fossil resin, typically yellowish-brown, used for jewelry and decoration.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "resin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The museum displayed a piece of ancient <w>amber</w> with a prehistoric insect trapped inside.",
                            "target_lang_translations": {
                                "ru": "В музее был выставлен кусок древнего <w>янтаря</w> с доисторическим насекомым внутри.",
                                "zh": "博物馆展出了一块里面困着史前昆虫的古老<w>琥珀</w>。"
                            }
                        },
                        {
                            "text": "She bought a beautiful necklace made of polished <w>amber</w> beads during her trip.",
                            "target_lang_translations": {
                                "ru": "Во время поездки она купила красивое ожерелье из бусин полированного <w>янтаря</w>.",
                                "zh": "她在旅行期间买了一条由抛光<w>琥珀</w>珠子制成的漂亮项链。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "fossil amber",
                        "amber jewelry",
                        "trapped in amber"
                    ],
                    "target_lang_definitions": {
                        "ru": "Твёрдая полупрозрачная ископаемая смола, обычно желтовато-коричневого цвета, используемая для украшений.",
                        "zh": "一种坚硬、半透明的化石树脂，通常呈黄褐色，用于制作珠宝和装饰品。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "янтарь",
                                "target_lang_sense_clarification": "ископаемая смола"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "琥珀",
                                "target_lang_sense_clarification": "化石树脂"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "13d931a8-d849-3544-90fc-65fa722a4087",
                    "sense_definition": "A yellow-orange colour.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cat watched the birds through the window with its glowing <w>amber</w> eyes.",
                            "target_lang_translations": {
                                "ru": "Кошка наблюдала за птицами через окно своими светящимися <w>янтарными</w> глазами.",
                                "zh": "猫透过窗户，用它那闪烁着<w>琥珀色</w>的眼睛注视着鸟儿。"
                            }
                        },
                        {
                            "text": "As the sun began to set, the sky was painted in shades of <w>amber</w> and gold.",
                            "target_lang_translations": {
                                "ru": "Когда солнце начало садиться, небо окрасилось в оттенки <w>янтаря</w> и золота.",
                                "zh": "当太阳开始落山时，天空被染成了<w>琥珀色</w>和金色。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "amber eyes",
                        "dark amber",
                        "shades of amber"
                    ],
                    "target_lang_definitions": {
                        "ru": "Жёлто-оранжевый цвет.",
                        "zh": "一种黄橙色。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "янтарный цвет",
                                "target_lang_sense_clarification": "цвет"
                            },
                            {
                                "target_lang_word": "янтарь",
                                "target_lang_sense_clarification": "цвет (поэтич.)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "琥珀色",
                                "target_lang_sense_clarification": "颜色"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "74a687de-1ba9-3670-9e85-ab18e0b8d321",
                    "sense_definition": "A specific genetic stop codon (UAG) in DNA or RNA sequences.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "genetics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scientists identified an <w>amber</w> mutation that caused the protein synthesis to stop prematurely.",
                            "target_lang_translations": {
                                "ru": "Учёные выявили <w>амбер</w>-мутацию, которая вызывала преждевременную остановку синтеза белка.",
                                "zh": "科学家们发现了一种导致蛋白质合成过早停止的<w>琥珀密码子</w>突变。"
                            }
                        },
                        {
                            "text": "In this experiment, we used an <w>amber</w> suppressor to allow the gene expression to continue.",
                            "target_lang_translations": {
                                "ru": "В этом эксперименте мы использовали <w>амбер</w>-супрессор, чтобы позволить экспрессии гена продолжиться.",
                                "zh": "在这个实验中，我们使用了一种<w>琥珀密码子</w>抑制因子来使基因表达得以继续。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "amber mutation",
                        "amber codon"
                    ],
                    "target_lang_definitions": {
                        "ru": "Специфический стоп-кодон (UAG) в последовательностях ДНК или РНК.",
                        "zh": "DNA或RNA序列中的一种特定终止密码子（UAG）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "амбер",
                                "target_lang_sense_clarification": "генетика"
                            },
                            {
                                "target_lang_word": "амбер-кодон",
                                "target_lang_sense_clarification": "генетика"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "琥珀密码子",
                                "target_lang_sense_clarification": "遗传学"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "76229632-2863-30c2-b0b1-26db77bcf16f",
                    "sense_definition": "Ambergris, a waxy substance produced by sperm whales, formerly used in perfumes.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "ambergris",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the past, <w>amber</w> was a highly valued ingredient for making expensive perfumes.",
                            "target_lang_translations": {
                                "ru": "В прошлом <w>амбра</w> была высоко ценимым ингредиентом для создания дорогих духов.",
                                "zh": "过去，<w>龙涎香</w>是制作昂贵香水的一种高价值成分。"
                            }
                        },
                        {
                            "text": "The sailors were lucky to find a lump of <w>amber</w> washed up on the beach.",
                            "target_lang_translations": {
                                "ru": "Морякам посчастливилось найти кусок <w>амбры</w>, выброшенный на берег.",
                                "zh": "水手们很幸运，在海滩上发现了一块被冲上岸的<w>龙涎香</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ambergris"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "referring to ambergris"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Амбра, воскообразное вещество, вырабатываемое кашалотами, ранее использовавшееся в парфюмерии.",
                        "zh": "龙涎香，一种由抹香鲸产生的蜡状物质，曾用于香水制作。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "амбра",
                                "target_lang_sense_clarification": "вещество"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "龙涎香",
                                "target_lang_sense_clarification": "物质"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6a091ce7-470c-39d5-812b-749f42ac2580",
                    "sense_definition": "Having a brownish-yellow colour.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He poured the smooth <w>amber</w> liquid into a crystal glass.",
                            "target_lang_translations": {
