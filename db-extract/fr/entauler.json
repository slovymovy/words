                "senses": [
                    {
                        "sense_id": "3ca785ff-8449-3da1-939e-92aeaba07206",
                        "entry_id": "f8d00469-5e8c-349a-b904-3394ad59d905",
                        "glosses": [
                            "Mettre en taule, en prison."
                        ],
                        "tags": [
                            "Prison"
                        ],
                        "examples": [
                            {
                                "example_id": "f19bb0bd-100a-433c-a33d-57ab28e34f0a",
                                "sense_id": "3ca785ff-8449-3da1-939e-92aeaba07206",
                                "text": "Selon Victor, le tueur aurait assuré que son « réseau », ou peu importe le mot, les poursuivrait même si l’un d’eux le faisait entauler."
                            },
                            {
                                "example_id": "ced53ca5-4d96-4cb2-9d7e-3b160fc53557",
                                "sense_id": "3ca785ff-8449-3da1-939e-92aeaba07206",
                                "text": "On tombera pour meurtre, on rencontrera Rocky en train de sortir et il pourra se faire entauler encore quatre fois avant qu’on soit de nouveau dehors."
                            }
                        ]
                    }
