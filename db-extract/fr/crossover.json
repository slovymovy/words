                "senses": [
                    {
                        "sense_id": "c01652ba-3ea1-3585-aec9-ad067669e6f7",
                        "entry_id": "43b0cce4-8c41-3bb3-9d1d-946943d875a0",
                        "glosses": [
                            "Type d’automobile sportive résultant du croisement du type SUV et du type berline voire coupé ou monospace."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db7a64ce-4fdc-474c-a98c-de3349b4aebc",
                                "sense_id": "c01652ba-3ea1-3585-aec9-ad067669e6f7",
                                "text": "Avec son physique particulier, la C4 Cactus détonne : un crossover compact aux formes arrondies, un look estival avec un toit panoramique et des petits coussins d’air en caoutchouc colorés sur les côtés, les nouveaux airbumps censés protéger des frottements."
                            }
                        ]
                    },
                    {
                        "sense_id": "bceaf2f5-dc5d-3056-acbb-9c0c90dad1ca",
                        "entry_id": "43b0cce4-8c41-3bb3-9d1d-946943d875a0",
                        "glosses": [
                            "Filtre séparant des bandes de fréquences, soit pour des baffles, soit pour des traitements différenciés du signal audio."
                        ],
                        "tags": [
                            "Acoustique"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "a93ff4da-5d7d-3777-bc51-f50444eb6631",
                        "entry_id": "43b0cce4-8c41-3bb3-9d1d-946943d875a0",
                        "glosses": [
                            "Récit commun à deux personnages fictifs provenant de différents récits."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca04e58e-dd2f-458e-8402-5c64f517dbe5",
                                "sense_id": "a93ff4da-5d7d-3777-bc51-f50444eb6631",
                                "text": "Depuis le piratage de Sony l’année dernière et la divulgation de nombreux mails privés internes au studio, on sait qu’un improbable crossover entre les franchises 21 Jump Street et Men in Black est en discussion."
                            },
                            {
                                "example_id": "871c685b-60b1-4566-a86a-70e2892f9a72",
                                "sense_id": "a93ff4da-5d7d-3777-bc51-f50444eb6631",
                                "text": "Tant qu’à faire, on aurait préféré que le créateur aille jusqu’au bout en imaginant un crossover avec Dead or Alive Xtreme."
                            }
                        ]
                    },
                    {
                        "sense_id": "8f71748a-fa48-3449-8216-95a73064abae",
                        "entry_id": "43b0cce4-8c41-3bb3-9d1d-946943d875a0",
                        "glosses": [
                            "Métissage entre deux ou différents styles musicaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df3dd8b8-2143-407f-9a00-6ddd728d8313",
                                "sense_id": "8f71748a-fa48-3449-8216-95a73064abae",
                                "text": "Sissel Kyrkjebø est une artiste crossover : elle pratique tous les styles de musique, du classique au rap, les mélangeant parfois."
                            }
                        ]
                    },
                    {
                        "sense_id": "bdba87a1-3792-312c-a8f9-00b4da6cbafc",
                        "entry_id": "43b0cce4-8c41-3bb3-9d1d-946943d875a0",
                        "glosses": [
                            "Genre musical proche du thrash metal très influencé par des éléments punk hardcore."
                        ],
                        "tags": [
                            "specifically"
                        ],
                        "examples": []
                    }
                ],
