                    },
                    {
                        "form_id": "5cb54008-eaf2-40c6-a2c6-63251d5f1721",
                        "entry_id": "79375e27-dd37-3fb4-afa3-88c689ab73a4",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Leumund"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "faf5a301-161f-3961-af44-b6360697261c",
                        "entry_id": "79375e27-dd37-3fb4-afa3-88c689ab73a4",
                        "glosses": [
                            "Ruf, den jemand hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45b21fc5-ebd8-43a3-9351-9ae731311739",
                                "sense_id": "faf5a301-161f-3961-af44-b6360697261c",
                                "text": "Ihrer Schwiegertochter kann man einen einwandfreien Leumund bescheinigen."
                            },
                            {
                                "example_id": "cf18093f-b4fa-4788-9b8a-6f9ee3dc649f",
                                "sense_id": "faf5a301-161f-3961-af44-b6360697261c",
                                "text": "„Der Leumund war freilich ein Nachruf.“"
                            },
                            {
                                "example_id": "74c0015b-b793-439a-bf9a-4b03deda4f7f",
                                "sense_id": "faf5a301-161f-3961-af44-b6360697261c",
                                "text": "„Auch Wieland beruft man als den berühmten Schriftsteller, der er ist, ungeachtet der fehlenden akademischen Qualifikation. Das sorgt bei den eingesessenen Professoren für Maulerei, zumal Wieland den Leumund eines Freigeistes hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ea01357a-51ee-44f7-9f43-1e5b02cea566",
                        "source_entry_id": "79375e27-dd37-3fb4-afa3-88c689ab73a4",
                        "source_sense_id": "faf5a301-161f-3961-af44-b6360697261c",
                        "source_sense_description": "Ruf, den jemand hat",
                        "target_lang_word": "prestige",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prestige",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3debd272-be9c-3f8a-8565-d2e2e44a7c39",
                                        "entry_id": "cdb6a28d-f6eb-3ba5-8037-f482916179db",
                                        "glosses": [
                                            "The quality of how good the reputation of something or someone is, how favourably something or someone is regarded."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80aac3d7-aedd-494b-8163-59b812f15fbb",
                                                "sense_id": "3debd272-be9c-3f8a-8565-d2e2e44a7c39",
                                                "text": "Oxford has a university of very high prestige."
                                            },
                                            {
                                                "example_id": "559b8fd1-bd20-4985-8dda-1c95844989c3",
                                                "sense_id": "3debd272-be9c-3f8a-8565-d2e2e44a7c39",
                                                "text": "But in such an instance a false belief will appear with all the prestige of the latest scientific knowledge supporting it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5b39fcc-01d9-3df8-8787-ad53622dbcd2",
                                        "entry_id": "cdb6a28d-f6eb-3ba5-8037-f482916179db",
                                        "glosses": [
                                            "Delusion; illusion; trick."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5414d939-14a3-43a9-84c4-920e3034b3ec",
                                                "sense_id": "b5b39fcc-01d9-3df8-8787-ad53622dbcd2",
                                                "text": "That faith which, we are told, was founded on a rock, impregnable to the assaults of men and demons; to the sophisms of infidelity, and the prestiges of imposture!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "prestige",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3cc83993-cce9-312c-b124-ff38037d52ea",
                                        "entry_id": "a3254d92-382c-37cc-9eb9-3f5dd8d225eb",
                                        "glosses": [
                                            "Regarded as relatively prestigious; often, considered the standard language or language variety, or a part of such a variety."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "565fe689-19f8-4921-9e08-4e21b6f3c2ea",
                                                "sense_id": "3cc83993-cce9-312c-b124-ff38037d52ea",
                                                "text": "Furthermore there is in each area a well recognized standard, known by a single name, which although often linguistically distinct from local dialects, has served as the prestige form for some time."
                                            },
                                            {
                                                "example_id": "c9d09f2b-6725-452c-afa5-821f2ed9d23c",
                                                "sense_id": "3cc83993-cce9-312c-b124-ff38037d52ea",
                                                "text": "The 3rd person plural -ą ending is phonetically [ow̃] or [om], depending on the dialect. However, [ow̃] is the prestige form."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "prestige",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "76a9b761-b2de-396e-90a3-d09e557ab320",
                                        "entry_id": "4063973f-9ed4-3b4e-80c0-2cecda748b64",
                                        "glosses": [
                                            "To start over at an earlier point in a video game with some type of bonus or reward."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9fe808ed-92b0-4d90-9048-9e6f80e19db6",
                                                "sense_id": "76a9b761-b2de-396e-90a3-d09e557ab320",
                                                "text": "This seriously depends on the prerequisites, but most chars will already have a +1 bow by the time they're thinking of prestiging - or will this stack with the equipment's magic?"
                                            },
                                            {
                                                "example_id": "b39e77b2-2e00-443a-a5fb-89a7307b4b91",
                                                "sense_id": "76a9b761-b2de-396e-90a3-d09e557ab320",
                                                "text": "I'm going to try to stop and move onto a different game once I've prestiged, but the credits/equipment buying arrangement will make prestiging much less of a crippling shock than in previous games, so I may well be stuck playing it for a long time to come."
                                            },
                                            {
                                                "example_id": "8eba79fb-2201-4c2a-9aca-2cc7c35a37a7",
                                                "sense_id": "76a9b761-b2de-396e-90a3-d09e557ab320",
                                                "text": "However, Treyarch crafts a narrative of leveling up when a player attempts to prestige. The player is stripped of most un-lockable game features and must re-earn them with the ability to repeat this process 15 times. Prestiging allows the empty narrative of online multiplayer first person shooters to continue on a much grander scale."
                                            },
                                            {
                                                "example_id": "cf2e2363-9aa7-4220-a540-dccc02af24f4",
                                                "sense_id": "76a9b761-b2de-396e-90a3-d09e557ab320",
                                                "text": "Reached level 50 and prestiged which I have never had the inclination to do in any game before."
                                            },
                                            {
                                                "example_id": "05d8fe49-7126-4f9e-8524-11589c20c785",
                                                "sense_id": "76a9b761-b2de-396e-90a3-d09e557ab320",
                                                "text": "Prestiging itself is a concept popularized by Call of Duty: Modern Warfare, where players can reset their in-game progress after reaching the maximum experience level, and receive a cosmetic token in exchange."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fd5cdb52-9223-4c31-95d6-62108746d4cc",
                        "source_entry_id": "79375e27-dd37-3fb4-afa3-88c689ab73a4",
                        "source_sense_id": "faf5a301-161f-3961-af44-b6360697261c",
                        "source_sense_description": "Ruf, den jemand hat",
                        "target_lang_word": "reputation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reputation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dfa70ec3-89a5-3958-ada3-4b3b1c6ec046",
                                        "entry_id": "677ba6cc-1d8a-37e7-87dd-a6752e847ae7",
                                        "glosses": [
                                            "What somebody or something is known for."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d30c9bc7-e4b7-4d66-bcdb-f4b79d6e9f40",
                                                "sense_id": "dfa70ec3-89a5-3958-ada3-4b3b1c6ec046",
                                                "text": "And Balaam (or as the trueth of the hebrewe hath Bileam) doth signifie the people of no reputation\n or the vayne people or they that are not counted for people."
                                            },
                                            {
                                                "example_id": "37799a24-5d7b-408f-8f43-6da3c8600868",
                                                "sense_id": "dfa70ec3-89a5-3958-ada3-4b3b1c6ec046",
                                                "text": "Sometimes a man makes a reputation, deserved or otherwise, by a single action."
                                            },
                                            {
                                                "example_id": "b7e4e278-c361-4fc8-870b-7a14d2fc5bb0",
                                                "sense_id": "dfa70ec3-89a5-3958-ada3-4b3b1c6ec046",
                                                "text": "The reputations of our universities and our research base are already under threat because of the fallout from the EU referendum result, which is making the UK an unfriendlier place for overseas scholars and students, as well as cutting off access to an important stream of research funding and to a vibrant and well-developed ecosystem for collaborative work."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "31e87ae4-cb60-469f-bcae-abc449163346",
                        "source_entry_id": "79375e27-dd37-3fb4-afa3-88c689ab73a4",
                        "source_sense_id": "faf5a301-161f-3961-af44-b6360697261c",
                        "source_sense_description": "Ruf, den jemand hat",
                        "target_lang_word": "réputation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "réputation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6b9e5c0d-4b84-36f0-b9b0-5979e2c77b52",
                                        "entry_id": "aecf2822-537c-3227-9f7d-55614bdb50b7",
                                        "glosses": [
                                            "Opinion bonne ou mauvaise au sujet d'une personne ou d’une chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "193f7fb5-6697-4448-a9eb-82ad855feb04",
                                                "sense_id": "6b9e5c0d-4b84-36f0-b9b0-5979e2c77b52",
                                                "text": "Sa bravoure lui valait une haute réputation militaire que rien ne démentait, parce qu'il n'avait jamais commandé en chef."
                                            },
                                            {
                                                "example_id": "f9b77cee-0985-4017-8f38-186415f279aa",
                                                "sense_id": "6b9e5c0d-4b84-36f0-b9b0-5979e2c77b52",
                                                "text": "Au village, sans prétention,\n J'ai mauvaise réputation […]."
                                            },
                                            {
                                                "example_id": "071d92b7-21f1-4b2b-9979-dcc12e3851ec",
                                                "sense_id": "6b9e5c0d-4b84-36f0-b9b0-5979e2c77b52",
                                                "text": "La réputation de sagacité et de prudence de notre frère n’est pas moindre parmi nous que celle que lui ont value sa valeur et son savoir ; […]."
                                            },
                                            {
                                                "example_id": "7202aa03-96d0-4f3f-8c58-909f3034142f",
                                                "sense_id": "6b9e5c0d-4b84-36f0-b9b0-5979e2c77b52",
                                                "text": "Et puis encore, Balzac avait mauvaise réputation. Il n'administrait pas son nom et son œuvre en bon père de famille. Ce n'était même pas un bohème – et l'on sait qu'un bohème est inacadémisable –, c'était quelque chose de bien pis."
                                            },
                                            {
                                                "example_id": "62ed1e24-8896-4775-9190-ed882d8c6b21",
                                                "sense_id": "6b9e5c0d-4b84-36f0-b9b0-5979e2c77b52",
                                                "text": "Sur leur trente et un et la cigarette aux lèvres, les jeunes gens partirent pour le lieu du rendez-vous, […], tous deux donnant l’exemple de la façon dont une indomptable crânerie peut triompher d’une réputation d’insolvabilité."
                                            },
                                            {
                                                "example_id": "1dd5269a-db7c-4565-b86a-577b59090a98",
                                                "sense_id": "6b9e5c0d-4b84-36f0-b9b0-5979e2c77b52",
                                                "text": "D’autre part, cette mansuétude et cette bonté vraiment chrétiennes lui avaient assis, parmi les ouailles, une solide réputation de brave et d’honnête homme, […]."
                                            },
                                            {
                                                "example_id": "bf462f5c-2aa8-49d1-8aee-d6576a9e9937",
                                                "sense_id": "6b9e5c0d-4b84-36f0-b9b0-5979e2c77b52",
                                                "text": "Il se fabriquait une étrange réputation, personnage de légende qui voyait à travers le brouillard, savait se rendre invisible aux gabelous, capable de tout !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c06ea44-b345-3849-8850-11744cd5101a",
                                        "entry_id": "aecf2822-537c-3227-9f7d-55614bdb50b7",
                                        "glosses": [
                                            "Honorabilité ; renommée de bonne moralité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92b22d36-f0d1-4770-885b-45592dde57ca",
                                                "sense_id": "1c06ea44-b345-3849-8850-11744cd5101a",
                                                "text": "Or, des outrages par paroles, des actes ou des gestes contumélieux, non accompagnés de voies de fait, peuvent produire ce résultat, autant et plus même que les violences physiques. Les atteintes dirigées contre l'honneur et la réputation sont parfois autrement graves que ne le seraient des attaques corporelles; l'indignation qu'elles soulèvent est aussi plus vive et plus profonde."
                                            },
                                            {
                                                "example_id": "7ac5717c-53b7-436e-b66b-78779590bd95",
                                                "sense_id": "1c06ea44-b345-3849-8850-11744cd5101a",
                                                "text": "Selon un sondage Ifop pour l’Observatoire de la réputation, 58,5% des Français n’étaient pas au courant de l’affaire avant que le président du CSA n’en parle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9214c9c5-5730-3e27-a72f-6fe7464a3730",
                                        "entry_id": "aecf2822-537c-3227-9f7d-55614bdb50b7",
                                        "glosses": [
                                            "Notoriété ; renom ; renommée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6e74e74-9570-4d7f-b4f1-7cd617617673",
                                                "sense_id": "9214c9c5-5730-3e27-a72f-6fe7464a3730",
                                                "text": "Ce ne fut que sur l’observation que je lui fis que ce costume donnerait une haute idée de son talent et le mettrait en réputation à Paris, qu’il consentit à s’en dessaisir."
                                            },
                                            {
                                                "example_id": "461d76c4-30f7-4674-9999-095c1cc35394",
                                                "sense_id": "9214c9c5-5730-3e27-a72f-6fe7464a3730",
                                                "text": "La réputation de ce grand homme reposait principalement sur l’autorité avec laquelle il démontrait que l’éternument était une prévoyance de la nature, au moyen de laquelle les penseurs trop profonds pouvaient chasser par le nez le superflu de leurs idées ; […]."
                                            },
                                            {
                                                "example_id": "4f1e3294-e5c1-4b35-bd80-a2b8b3c61b44",
                                                "sense_id": "9214c9c5-5730-3e27-a72f-6fe7464a3730",
                                                "text": "La ville avait la réputation d'être imprenable ; son château s'élevait à l'est et la ceinture de murailles qui entourait la cité venait s'y attacher; des portes, des bastions, des fossés formaient un respectable appareil de défense."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
