                        "glosses": [
                            "Celui qui exagère."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b96dc0cb-f85a-4041-af9e-99d7fd94737b",
                                "sense_id": "d3c7ba53-6876-3fd0-a90f-dc052e481234",
                                "text": "Job a au-dessus de sa tête cet affreux soleil arabe, éleveur de monstres, exagérateur de fléaux, qui change le chat en tigre, le lézard en crocodile, le pourceau en rhinocéros, l’anguille en boa, l’ortie en cactus, le vent en simoun, le miasme en peste."
                            }
                        ]
