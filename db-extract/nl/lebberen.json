                    },
                    {
                        "sense_id": "3040561b-3d00-3086-9663-39d983125a12",
                        "entry_id": "2a2ec5ce-de94-394d-8d3b-78655d802bd8",
                        "glosses": [
                            "to lap; to drink audibly, often using a tongue"
                        ],
                        "tags": [
                            "intransitive",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "9db9a0c5-e4aa-4579-9a94-4ec724ee109d",
                                "sense_id": "3040561b-3d00-3086-9663-39d983125a12",
                                "text": "Tante Wilma liet Babsi weer uit haar glas lebberen."
                            },
                            {
                                "example_id": "77f2bb66-7246-493f-82cd-8841ddf92668",
                                "sense_id": "3040561b-3d00-3086-9663-39d983125a12",
                                "text": "Tientallen olifanten staan met elkaar te lebberen in het water, strooien zand rond alsof het allemaal niets kost, badderen hun logge lijven en weten vast allemal dat wij naar hun staan te kijken."
                            }
                        ]
                    }
                ],
