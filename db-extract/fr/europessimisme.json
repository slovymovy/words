                                        "entry_id": "fe30c0d3-395b-3188-b7e0-7372b4763703",
                                        "glosses": [
                                            "Pessimistic feelings about Europe, especially regarding economic crises in Western Europe in the 1970s."
                                        ],
                                        "tags": [
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ede6366-45d9-4d81-81ec-78e593380c71",
                                                "sense_id": "28c391d2-dc6c-3150-b7c6-0cc2a93553b8",
                                                "text": "Today, \"Europessimism\" belongs to the past. European economies have been growing […]"
                                            },
                                            {
                                                "example_id": "62ca25e9-542b-469c-bad7-7a2289dbf771",
                                                "sense_id": "28c391d2-dc6c-3150-b7c6-0cc2a93553b8",
                                                "text": "The 1970s were therefore the era of Europessimism. Europe seemed unable to adjust to the changed circumstances of international growth and competition […]"
                                            },
                                            {
                                                "example_id": "cec22e32-ba27-4760-a6af-7968078d4d6c",
                                                "sense_id": "28c391d2-dc6c-3150-b7c6-0cc2a93553b8",
                                                "text": "Today in the West, Europessimism is back in fashion where Eastern Europe is concerned."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
