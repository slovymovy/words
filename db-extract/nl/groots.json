                ],
                "senses": [
                    {
                        "sense_id": "f4e8ff0f-b525-31e0-aae0-262ef324439e",
                        "entry_id": "25f73d0c-31d2-3e5a-854b-4f726acd09fe",
                        "glosses": [
                            "verheven, groot van opzet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01ea37ec-1e74-45d2-a5e9-012759f7db13",
                                "sense_id": "f4e8ff0f-b525-31e0-aae0-262ef324439e",
                                "text": "Daarvoor bestaan grootse plannen."
                            },
                            {
                                "example_id": "e8beb72e-868c-4135-81ac-e732fc321bfa",
                                "sense_id": "f4e8ff0f-b525-31e0-aae0-262ef324439e",
                                "text": "Burgemeester Ron König zegt \"buitengewoon trots\" te zijn op het team. \"Go Ahead Eagles heeft echt voetbal laten zien zoals het hoort te zijn\", vindt hij. \"Heel Deventer is uitzinnig van blijdschap en terecht! We gaan woensdag het elftal groots onthalen en huldigen.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "2c243299-4132-3699-8c90-abf57f43a435",
                        "entry_id": "25f73d0c-31d2-3e5a-854b-4f726acd09fe",
                        "glosses": [
                            "partitief van de stellende trap van groot"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "d1bbe7d9-6152-4b93-a483-1515a8316f57",
                                "sense_id": "2c243299-4132-3699-8c90-abf57f43a435",
                                "text": "Of wat daar voorbijvloog een arend was of een gier, weet ik niet, maar het was wel iets groots."
                            }
                        ]
                    },
                    {
                        "sense_id": "ee8696c0-8a27-3a0b-9b06-913ca2cbbbbd",
                        "entry_id": "25f73d0c-31d2-3e5a-854b-4f726acd09fe",
                        "glosses": [
                            "partitief van de stellende trap van groots"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "a03107e5-037c-4283-b481-01143c8c834a",
                                "sense_id": "ee8696c0-8a27-3a0b-9b06-913ca2cbbbbd",
                                "text": "Daar wordt iets groots verricht."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1f0cf705-34a4-4df2-a716-98f3f3e1a964",
                        "source_entry_id": "25f73d0c-31d2-3e5a-854b-4f726acd09fe",
                        "source_sense_id": "f4e8ff0f-b525-31e0-aae0-262ef324439e",
