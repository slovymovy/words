                                "sense_id": "a7fd83c5-2acc-3d35-9425-4a866398d73c",
                                "text": "I get dickwad in there wantin' to play wheel of fortune so I can find out their supplier!"
                            },
                            {
                                "example_id": "2611eb5f-5a61-47d0-afa9-5cc1519e0fdc",
                                "sense_id": "a7fd83c5-2acc-3d35-9425-4a866398d73c",
                                "text": "\"Yeah? Who's gonna stop me, dickwad?\""
                            },
                            {
                                "example_id": "93cde5ee-7ecb-42e2-a341-f24b28188eb1",
                                "sense_id": "a7fd83c5-2acc-3d35-9425-4a866398d73c",
                                "text": "You treat your girlfriend so bad, you damn dickwad!"
                            }
                        ]
