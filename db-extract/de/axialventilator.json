                ],
                "senses": [
                    {
                        "sense_id": "c5b287af-be9a-38af-85e6-fae9535fe8ef",
                        "entry_id": "c17db037-5821-322c-87f1-f9d3a19d0460",
                        "glosses": [
                            "Ventilator, der die Luft axial (parallel zur Drehachse des Laufrades) ansaugt und auch axial ausbläst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "258c4e51-3b61-4951-b52f-d7a03f59adaf",
                                "sense_id": "c5b287af-be9a-38af-85e6-fae9535fe8ef",
                                "text": "„Axialventilatoren finden überall da Verwendung, wo es hoher Volumenströme (Luftmengen) in Verbindung mit geringen Pressungen (Widerstände, die überwunden werden müssen) bedarf.“"
                            },
                            {
                                "example_id": "95070c5a-029e-4a75-8a9d-75944b1fb192",
                                "sense_id": "c5b287af-be9a-38af-85e6-fae9535fe8ef",
                                "text": "„Axialventilatoren fördern die Luft in koaxialer Richtung zur Drehachse des Laufrades.“"
                            },
                            {
                                "example_id": "2ff21639-0a87-4dde-a562-96d33a84d5f8",
                                "sense_id": "c5b287af-be9a-38af-85e6-fae9535fe8ef",
                                "text": "„Beim Axialventilator, der in seiner Funktion einem Propeller ähnelt, wird die Förderluft in axialer Richtung parallel zur umlaufenden Motorwelle transportiert.“"
                            },
                            {
                                "example_id": "6bcce135-fd02-4d03-a756-531d513fcf56",
                                "sense_id": "c5b287af-be9a-38af-85e6-fae9535fe8ef",
                                "text": "„Zur Bestimmung des Einflusses verschiedener Anström- und Ausströmbedingungen an einem Axialventilator sollen Windkanalversuche durchgeführt werden.“"
                            },
                            {
                                "example_id": "b6da7a0a-cab2-431e-80b1-a6a7c3f3c371",
                                "sense_id": "c5b287af-be9a-38af-85e6-fae9535fe8ef",
                                "text": "„Die von uns angebotenen Radial- und Dachventilatoren sowie Axialventilatoren sind hervorragend geeignet zur Förderung aggressiver Abluft und Gase.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
