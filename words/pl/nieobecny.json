                },
                {
                    "sense_id": "cbfb2699-dba4-39f7-94a1-c2ea058ee1b3",
                    "sense_definition": "człowiek, który umarł; zmarły",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "osoba",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W trakcie uroczystości wspominaliśmy wszystkich <w>nieobecnych</w> już członków naszej rodziny.",
                            "target_lang_translations": {
                                "de": "Während der Feier gedachten wir all jener Mitglieder unserer Familie, die schon unter den <w>Verstorbenen</w> weilen."
                            }
                        },
                        {
                            "text": "Wzniesiono uroczysty toast za spokój dusz wszystkich <w>nieobecnych</w> przyjaciół.",
                            "target_lang_translations": {
                                "de": "Es wurde ein feierlicher Trinkspruch auf das Seelenheil aller <w>verstorbenen</w> Freunde ausgebracht."
                            }
                        }
                    ],
                    "traits": [
