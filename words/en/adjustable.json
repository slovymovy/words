                            },
                            {
                                "target_lang_word": "настраиваемый",
                                "target_lang_sense_clarification": "о параметрах или функциях"
                            },
                            {
                                "target_lang_word": "раздвижной",
                                "target_lang_sense_clarification": "о физических размерах"
                            }
                        ]
                    }
                }
            ]
        },
        {
