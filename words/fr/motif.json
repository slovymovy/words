            "senses": [
                {
                    "sense_id": "12678211-feb6-3c2b-989b-8c3c1d4fa28e",
                    "sense_definition": "Raison d'agir ou justification d'une action ou d'une décision.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "raison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'employé a été convoqué par sa direction sans aucun <w>motif</w> valable."
                        },
                        {
                            "text": "Elle a expliqué le véritable <w>motif</w> de son départ précipité à ses collègues."
                        }
                    ],
                    "common_phrases": [
