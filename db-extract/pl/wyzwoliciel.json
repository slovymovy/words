                    {
                        "translation_id": "9428cd43-ee78-4577-a35a-50b0855a09d6",
                        "source_entry_id": "e78e71a7-ff7a-338b-b65f-b0fdf17ebbc5",
                        "source_sense_id": "e81c28b3-354b-36bd-b66c-34f67842f6d7",
                        "target_lang_word": "libérateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "libérateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0e176a70-0bb0-3b6b-a485-6cf7ea47a3a4",
                                        "entry_id": "38165f8f-3c28-382b-99cf-0e9aed7170f7",
                                        "glosses": [
                                            "Qui délivre, ce qui libère."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c648a234-2e69-41cc-aa0c-3d491515179a",
                                                "sense_id": "0e176a70-0bb0-3b6b-a485-6cf7ea47a3a4",
                                                "text": "Comme un écolier au son de la cloche libératrice, M. Chasle, en un tournemain, rassembla ses paperasses, fit plusieurs petits saluts, et s’esquiva."
                                            },
                                            {
                                                "example_id": "66193cd8-a0bf-4cb9-aca3-fd636180a554",
                                                "sense_id": "0e176a70-0bb0-3b6b-a485-6cf7ea47a3a4",
                                                "text": "Être seul, c'est si libérateur."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "libérateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "26504d87-3586-3616-a695-32058d1ff159",
                                        "entry_id": "b5361cde-3240-318b-9ed0-3a83b16282d1",
                                        "glosses": [
                                            "Celui qui a libéré une personne, une ville, un peuple, de la captivité, de la servitude ou de quelque grand péril."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a13a6fe-e6db-4b2a-b76a-d6fd51abc86e",
                                                "sense_id": "26504d87-3586-3616-a695-32058d1ff159",
                                                "text": "En 1955, nous étions sous le choc de la “réconciliation” soviéto-yougoslave. Sans crier gare, la troïka moscovite avait débarqué à Belgrade pour se jeter dans les bras de Tito et le couvrir de fleurs. […], Josip Broz Tito soudainement redevenait un grand communiste, le libérateur de son peuple !"
                                            },
                                            {
                                                "example_id": "7445e355-216f-47d2-a578-9130bb2220db",
                                                "sense_id": "26504d87-3586-3616-a695-32058d1ff159",
                                                "text": "Non loin d’Asfeld, où l’église épouse la forme d’un violon, se trouve un village baptisé Poilcourt-Sydney en l’honneur de ses libérateurs australiens."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
