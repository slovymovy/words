                    ],
                    "synonyms": [
                        "faufiler",
                        "insérer",
                        "introduire"
                    ],
                    "antonyms": [
                        "extraire",
                        "retirer"
                    ],
                    "common_phrases": [
                        "glisser dans la poche",
                        "glisser sous la porte"
                    ]
                },
                {
                    "sense_id": "0bb046ea-4076-35aa-8369-94f73d38d29b",
                    "sense_definition": "Se déplacer avec aisance, fluidité et sans bruit.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chat semblait <w>glisser</w> dans l'ombre sans faire le moindre bruit."
                        },
                        {
                            "text": "Les jours et les semaines finissent par <w>glisser</w> sans que l'on s'en rende compte."
                        }
                    ],
                    "synonyms": [
                        "filer"
                    ],
                    "common_phrases": [
                        "glisser en silence"
                    ]
                },
                {
                    "sense_id": "51930d4c-f09b-3e33-a75c-3b208751ea40",
                    "sense_definition": "Évoquer rapidement un sujet sans s'y attarder ou sans insister.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "discours",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur a préféré <w>glisser</w> sur cette question délicate pendant la réunion."
                        },
                        {
                            "text": "Il a choisi de <w>glisser</w> sur leurs désaccords passés pour préserver l'amitié."
                        }
                    ],
                    "synonyms": [
                        "passer",
                        "survoler"
                    ],
                    "antonyms": [
                        "approfondir",
                        "insister"
                    ],
                    "common_phrases": [
                        "glisser rapidement",
                        "glisser sur un sujet"
                    ]
                },
                {
                    "sense_id": "bb4327d7-b2af-35bd-8d61-12f77aee2520",
                    "sense_definition": "N'avoir aucun effet marquant, laisser indifférent en parlant de propos ou d'actes.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sentiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toutes ces méchantes critiques semblent simplement <w>glisser</w> sur lui sans l'atteindre."
                        },
                        {
                            "text": "Les remarques désobligeantes de ses collègues <w>glissent</w> sur elle sans l'affecter."
                        }
                    ],
                    "antonyms": [
                        "atteindre",
                        "toucher"
                    ],
                    "common_phrases": [
                        "glisser sur quelqu'un"
                    ]
                }
            ]
        }
    ]
