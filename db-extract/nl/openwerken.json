        "nl-extract.jsonl": [
            {
                "entry_id": "bc6bca7a-7559-3ea7-8854-7101fb0d773c",
                "word": "openwerken",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b0823521-0f8c-3b7c-bbe2-da3135f20c2a",
                        "entry_id": "bc6bca7a-7559-3ea7-8854-7101fb0d773c",
                        "glosses": [
                            "een gat of een holle ruimte maken in iets"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc81bc51-81f5-4b0e-b527-31d8031d5e68",
                                "sense_id": "b0823521-0f8c-3b7c-bbe2-da3135f20c2a",
                                "text": "Het blijft voorlopig geheim hoeveel de bouw van de loopbrug over de Wenninkgaarde en het openwerken van de noordelijke gevel van het Muziekkwartier gaat kosten. Het college van B en W eist volstrekte geheimhouding van de raad."
                            },
                            {
                                "example_id": "85b9cca5-d8de-4f2a-aaf6-855bf1972ad0",
                                "sense_id": "b0823521-0f8c-3b7c-bbe2-da3135f20c2a",
                                "text": "Ongetwijfeld beïnvloed door de wijze waarop Zadkine ruimte in zijn beelden toeliet, ging Lotti haar beelden openwerken. Zij ontwikkelde een ingenieuze techniek waarbij zij de klei aanbracht rond een armatuur. Kenmerkend werd een spel van rond elkaar geweven vormen, waaruit die zowel herkenbare als vegetatieve wezens opdoken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8b933e9c-edba-4f03-8b71-3d44423cc1c0",
                        "source_entry_id": "bc6bca7a-7559-3ea7-8854-7101fb0d773c",
                        "source_sense_id": "b0823521-0f8c-3b7c-bbe2-da3135f20c2a",
                        "target_lang_word": "cut away",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cut away",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b6c5bd3d-a7b6-3775-88f2-8fe1959d49a6",
                                        "entry_id": "81c46d9e-12de-3b4f-899f-0dace03e593b",
                                        "glosses": [
                                            "To fail to show something; to stop before showing something; to leave a scene; to switch to a different scene quickly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed6950b5-a7da-4641-ad47-5044feffcfb7",
                                                "sense_id": "b6c5bd3d-a7b6-3775-88f2-8fe1959d49a6",
                                                "text": "The camera cut away before we could see the reveal."
                                            },
                                            {
                                                "example_id": "1a8f6fc4-2596-4952-9892-571e05dbec8b",
                                                "sense_id": "b6c5bd3d-a7b6-3775-88f2-8fe1959d49a6",
                                                "text": "The movie cuts away too much and too quickly without letting scenes breathe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cfdc47b8-f93d-3c46-bd72-aeb95df3ac22",
                                        "entry_id": "81c46d9e-12de-3b4f-899f-0dace03e593b",
                                        "glosses": [
                                            "to cut out something; to remove all or portions of a damaged or diseased area by cutting"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86ffc91d-e4a5-49cd-b3fe-a548c6f8b461",
                                                "sense_id": "cfdc47b8-f93d-3c46-bd72-aeb95df3ac22",
                                                "text": "One womb, one shame, one resolve\nLiberate this will to release us all\nGotta cut away, clear away\nSnip away and sever this umbilical residue\nKeeping me from killing you"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
