                    },
                    {
                        "translation_id": "ab40458c-8691-41c6-b1d6-391f2e6d93a6",
                        "source_entry_id": "9629adf8-a33b-3b1d-a730-a2490b5090d2",
                        "source_sense_description": "transitive: to mummify",
                        "target_lang_word": "mummificeren",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mummificeren",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "f2f5d5ee-d78b-3a05-b1c0-a63ba515b6ad",
                                        "entry_id": "a8bdc0a9-9e5e-325e-b521-651f05e68a6f",
                                        "glosses": [
                                            "van een overledene een mummie maken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b566afa7-e198-4ded-a36a-263e801f8d00",
                                                "sense_id": "f2f5d5ee-d78b-3a05-b1c0-a63ba515b6ad",
                                                "text": "De oude Egyptenaren mummificeerden de lichamen van hun doden."
                                            },
                                            {
                                                "example_id": "83b62959-775f-4eda-9feb-77780744f11e",
                                                "sense_id": "f2f5d5ee-d78b-3a05-b1c0-a63ba515b6ad",
                                                "text": "Een Britse taxichauffeur heeft een originele manier gevonden om de tand des tijds te weerstaan. De man, Allan Billis, liet zich na zijn dood namelijk mummificeren. Daarmee is Billis de eerste mummie in ruim 3000 jaar. Dat melden verschillende Britse media vandaag."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d15eb9aa-8225-3b1c-ade0-fbf2ed9d9b4f",
                                        "entry_id": "a8bdc0a9-9e5e-325e-b521-651f05e68a6f",
                                        "glosses": [
                                            "uitdrogen, verschrompelen, verstenen, concerveren van overleden organismen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c56a176-972c-4ff5-b064-a9bcae276906",
                                                "sense_id": "d15eb9aa-8225-3b1c-ade0-fbf2ed9d9b4f",
                                                "text": "Daar zat hij dan, leunend op zijn rechterarm, voorovergebogen over zijn navigatietafel in zijn zeiljacht. Roerloos, alsof hij zijn zeilroute aan het overpeinzen was. De Filipijnse politie trof hem zo aan op 25 februari, dobberend voor de Filipijnse kust. Hij was van top tot teen gemummificeerd. Naar verluidt is hij gestorven aan een hartaanval."
                                            },
                                            {
                                                "example_id": "fa4f86af-7052-4994-80db-d3054d4afd79",
                                                "sense_id": "d15eb9aa-8225-3b1c-ade0-fbf2ed9d9b4f",
                                                "text": "Goudzoekers hebben dinsdag in de permafrost van Yukon, een gebied in het noordwesten van Canada, een gemummificeerde wolharige babymammoet gevonden. Het dier zou meer dan 30.000 jaar geleden op de wereld hebben gelopen, meldt de gemeente."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1e4ac8a2-7d04-499d-8381-aacfb35f3cf5",
                        "source_entry_id": "9629adf8-a33b-3b1d-a730-a2490b5090d2",
                        "source_sense_description": "transitive: to mummify",
                        "target_lang_word": "momifier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "momifier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "37029626-a87b-33ab-8bee-26ad30a56c19",
                                        "entry_id": "10277829-9295-3976-bdbf-70d9f4e1229d",
                                        "glosses": [
                                            "Faire subir à un corps le processus de momification."
                                        ],
                                        "tags": [
                                            "Funéraire"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d9ea1ec5-9771-3ae9-9452-611ffb7f8191",
                                        "entry_id": "10277829-9295-3976-bdbf-70d9f4e1229d",
                                        "glosses": [
                                            "Dessécher ; donner l’apparence d’une momie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d5827e4-004f-45db-b87e-c30c7f88c636",
                                                "sense_id": "d9ea1ec5-9771-3ae9-9452-611ffb7f8191",
                                                "text": "Nous ne fatiguerons pas nos lecteurs de la description de cette route monotone à travers un pays plat, pierreux et poudreux, pommelé de loin en loin d’oliviers au feuillage d’un vert glauque et malade, où l’on ne rencontre que des paysans hâves, fauves, momifiés, avec des chapeaux roussis, des culottes courtes et des guêtres de gros drap noirâtre, portant sur l’épaule des vestes en guenilles et poussant devant eux quelque âne galeux au poil blanc de vieillesse, aux oreilles énervées, à la mine piteuse."
                                            },
                                            {
                                                "example_id": "352c7dbd-234b-4f66-8947-754b5c19b0cd",
                                                "sense_id": "d9ea1ec5-9771-3ae9-9452-611ffb7f8191",
                                                "text": "De la cathédrale, nous nous rendîmes, mon compagnon et moi, à la tour Saint-Michel, où se trouve un caveau qui a la propriété de momifier les corps qu’on y dépose."
                                            },
                                            {
                                                "example_id": "09b682c9-189c-4c1b-95f3-970a2ed764c1",
                                                "sense_id": "d9ea1ec5-9771-3ae9-9452-611ffb7f8191",
                                                "text": "A Acy-Romance (Ardennes), la découverte de trois corps momifiés, inhumés en position dite de Boudha dans des petites fosses profondes de 80 cm laissent les archéologues dubitatifs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a09c86bc-c13f-372f-8e69-4547f2ac598e",
                                        "entry_id": "10277829-9295-3976-bdbf-70d9f4e1229d",
                                        "glosses": [
                                            "Dessécher."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "81675387-5568-32b4-87ba-ffd9c945ecc9",
                                        "entry_id": "10277829-9295-3976-bdbf-70d9f4e1229d",
                                        "glosses": [
                                            "Se dessécher, comme mort, par immobilisation."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dce964fb-5127-4cde-b228-fad2a0a1764f",
                                                "sense_id": "81675387-5568-32b4-87ba-ffd9c945ecc9",
                                                "text": "À ce stade, le couple se momifie, se sclérose."
                                            },
                                            {
                                                "example_id": "23c2fcbb-e063-479c-b638-9b59102da9a1",
                                                "sense_id": "81675387-5568-32b4-87ba-ffd9c945ecc9",
                                                "text": "Mes enfants auront tout leur bien, celui de leur mère et le mien ; mais ils ne veulent sans doute pas que leur père s’ennuie, se moinifie et se momifie !…"
                                            },
                                            {
                                                "example_id": "465fa553-1a83-4664-94a3-a5fc3c907e25",
                                                "sense_id": "81675387-5568-32b4-87ba-ffd9c945ecc9",
                                                "text": "L’indécence de ces jours, aux yeux du banal et du serre-fesses, n’a d’égale que celle qui ravit aujourd’hui ma mémoire et me prouve que je n’ai pas trop vieilli, saisi par les codes, les convenances et les stupidités qui momifient les vivants bien avant que le souffle ne les ait quittés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "74c3a32d-ca67-45af-841c-10b059d1f5f8",
                        "source_entry_id": "9629adf8-a33b-3b1d-a730-a2490b5090d2",
