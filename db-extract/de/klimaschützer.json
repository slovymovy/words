                ],
                "senses": [
                    {
                        "sense_id": "d53b1ae3-9729-308e-9e6b-2bdeb7f1fdf0",
                        "entry_id": "9b945d66-6884-381f-bf2e-cb4de65ff27f",
                        "glosses": [
                            "Person, die sich dezidiert für den Schutz des Klimas einsetzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e923726-64af-4644-83f8-baee53b8dcd2",
                                "sense_id": "d53b1ae3-9729-308e-9e6b-2bdeb7f1fdf0",
                                "text": "„Die Klimaschützer von Fridays for Future haben am Sonntagnachmittag die Premiere der Mozart-Oper \"Così fan tutte\" bei den Salzburger Festspielen für eine Protestaktion genutzt.“"
                            },
                            {
                                "example_id": "9746feae-035a-4041-9410-0c91311c03e0",
                                "sense_id": "d53b1ae3-9729-308e-9e6b-2bdeb7f1fdf0",
                                "text": "„Für die europäischen Klimaschützer naht die Stunde der Wahrheit. Halten sie beim Streit um das Kyoto-Protokoll zusammen, oder lassen sie sich von US-Präsident George W. Bush auseinander dividieren?“"
                            },
                            {
                                "example_id": "febf404f-dcbf-402b-ae03-444074b24d3c",
                                "sense_id": "d53b1ae3-9729-308e-9e6b-2bdeb7f1fdf0",
                                "text": "„Ein Sprecher des Aktionsbündnisses ‚Letzte Generation‘ verteidigte die Reise gegenüber Bild mit der wilden Begründung: ‚Sie haben den Flug als Privatleute gebucht, nicht als Klimaschützer. Das muss man auseinanderhalten können.‘“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
