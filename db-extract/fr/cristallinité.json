                    },
                    {
                        "sense_id": "34b7d4c7-956f-312b-968d-b2cede8e8b28",
                        "entry_id": "f1a95da1-65bd-3226-91a1-abc3e206c84c",
                        "glosses": [
                            "Qualité d’une substance dans laquelle tout ou partie des atomes, groupes d’atomes ou molécules qui la composent sont disposés dans l’espace de manière régulière et répétitive, comme c’est le cas dans un cristal."
                        ],
                        "tags": [
                            "Chimie physique"
                        ],
                        "examples": [
                            {
                                "example_id": "408ea828-fd0d-402c-bc19-b2b2498b1186",
                                "sense_id": "34b7d4c7-956f-312b-968d-b2cede8e8b28",
                                "text": "Les éléments qui, autour du carbone et du silicium, jouent les rôles dominants dans les phénomènes fondamentaux de la cristallinité et de la vitrosité."
                            },
                            {
                                "example_id": "afe27831-7919-450d-85fa-45160e2d278a",
                                "sense_id": "34b7d4c7-956f-312b-968d-b2cede8e8b28",
                                "text": "Cette technique permettra de déterminer la température de fusion T_f et de cristallisation T_c, l’enthalpie de fusion DH_f et de cristallisation DH_c et le taux de cristallinité χ_c."
                            }
                        ]
                    }
