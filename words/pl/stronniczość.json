                    "sense_id": "0ed329d6-5ad2-3388-812f-218299dc91b4",
                    "sense_definition": "postawa polegająca na faworyzowaniu jednej ze stron w sporze lub ocenie",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "stronniczość",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sędzia został oskarżony o <w>stronniczość</w> podczas prowadzenia tego ważnego meczu.",
                            "target_lang_translations": {
                                "ru": "Судью обвинили в <w>предвзятости</w> во время проведения этого важного матча."
                            }
                        },
                        {
                            "text": "Media często wykazują <w>stronniczość</w> w relacjonowaniu wydarzeń politycznych.",
                            "target_lang_translations": {
                                "ru": "СМИ часто проявляют <w>предвзятость</w> при освещении политических событий."
                            }
                        }
                    ],
                    "antonyms": [
