                "senses": [
                    {
                        "sense_id": "20443c70-d665-3d08-a3ad-46eaedf518b5",
                        "entry_id": "63880caf-f6dc-310d-9c92-4d9ffe8dec5c",
                        "glosses": [
                            "gegen Wärme isolierter Schrank beziehungsweise schrankartiges Behältnis mit einem oder mehreren speziellen kleineren Fächern, die mit Eisblöcken gefüllt wurden, um in einem großen, den restlichen Innenraum umfassenden Fach leicht verderbliche Lebensmittel kühl aufzubewahren und somit frischzuhalten"
                        ],
                        "tags": [
                            "früher"
                        ],
                        "examples": [
                            {
                                "example_id": "fcb2641d-e00b-419a-8df1-c60de4a7c26a",
                                "sense_id": "20443c70-d665-3d08-a3ad-46eaedf518b5",
                                "text": "„Ein Werkzeug, welches nicht zur Fabrication verkäuflicher Waaren, sondern zum unmittelbaren Hausgebrauche dient, wie etwa eine patentirte Kochmaschine, ein Eisschrank u. dgl. kann zur ersten wie zur zweiten Klasse gezählt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f51cc7d7-b9ac-352c-bd5b-f1679132d6c0",
                        "entry_id": "63880caf-f6dc-310d-9c92-4d9ffe8dec5c",
                        "glosses": [
                            "kastenförmiges, einem Schrank ähnliches, gegen Wärme isoliertes und mit einem Kühlsystem ausgestattetes Behältnis, in dem leicht verderbliche Lebensmittel kühl aufbewahrt werden, um sie frischzuhalten"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "7b0047a2-c1b7-4783-b7ea-671ef47ccecf",
                                "sense_id": "f51cc7d7-b9ac-352c-bd5b-f1679132d6c0",
                                "text": "„Vielleicht find ich noch ne Coca im Eisschrank.“"
                            },
                            {
                                "example_id": "4acfe246-8f7d-44e1-afa8-b067b974c34f",
                                "sense_id": "f51cc7d7-b9ac-352c-bd5b-f1679132d6c0",
                                "text": "„In der Küche brummte der Eisschrank.“"
                            },
                            {
                                "example_id": "be04d5ab-8d4d-4a17-8857-fb272355ab25",
                                "sense_id": "f51cc7d7-b9ac-352c-bd5b-f1679132d6c0",
                                "text": "„Ich laufe in die Küche und hole die Coca-Cola-Flaschen aus dem Eisschrank.“"
                            },
                            {
                                "example_id": "0bf3295a-c8e7-4d9e-b1a7-16d88c6f99da",
                                "sense_id": "f51cc7d7-b9ac-352c-bd5b-f1679132d6c0",
                                "text": "„Monika Silvs war auch diesmal so nett gewesen, wie sie immer war, wenn wir ihr ein Telegramm schickten; sie hatte sich vom Hausverwalter die Schlüssel besorgt, alles sauber gemacht, Blumen ins Wohnzimmer gestellt, den Eisschrank mit allem möglichen gefüllt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
