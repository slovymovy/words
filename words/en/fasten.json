                {
                    "sense_id": "b608215c-c770-3f6e-b476-4c8ffc184910",
                    "sense_definition": "To attach or connect something in a secure manner.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "attach",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>fasten</w> your seat belts before the plane takes off.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>пристегните</w> ремни безопасности перед взлетом самолета.",
                                "nl": "Maak alstublieft uw veiligheidsgordels <w>vast</w> voordat het vliegtuig opstijgt.",
                                "pl": "Proszę <w>zapiąć</w> pasy bezpieczeństwa przed startem samolotu.",
                                "de": "Bitte <w>legen</w> Sie Ihre Sicherheitsgurte <w>an</w>, bevor das Flugzeug abhebt.",
                                "fr": "Veuillez <w>attacher</w> vos ceintures de sécurité avant le décollage de l'avion.",
                                "it": "Si prega di <w>allacciare</w> le cinture di sicurezza prima del decollo dell'aereo.",
                                "cs": "Prosím, <w>zapněte</w> si bezpečnostní pásy před vzletem letadla.",
                                "tr": "Lütfen uçak kalkmadan önce emniyet kemerlerinizi <w>bağlayın</w>.",
                                "es": "Por favor, <w>abróchense</w> los cinturones de seguridad antes de que el avión despegue."
                            }
                        },
                        {
                            "text": "The sailor <w>fastened</w> the boat to the dock with a strong rope.",
                            "target_lang_translations": {
                                "ru": "Моряк <w>привязал</w> лодку к причалу крепкой веревкой.",
                                "nl": "De zeeman <w>maakte</w> de boot met een stevig touw aan de steiger <w>vast</w>.",
                                "pl": "Marynarz <w>przywiązał</w> łódź do doku mocną liną.",
                                "de": "Der Seemann <w>machte</w> das Boot mit einem starken Seil am Dock <w>fest</w>.",
                                "fr": "Le marin <w>amarra</w> le bateau au quai avec une corde solide.",
                                "it": "Il marinaio <w>ha legato</w> la barca al molo con una corda robusta.",
                                "cs": "Námořník <w>přivázal</w> loď k doku pevným lanem.",
                                "tr": "Denizci tekneyi rıhtıma güçlü bir halatla <w>bağladı</w>.",
                                "es": "El marinero <w>ató</w> el barco al muelle con una cuerda fuerte."
                            }
                        }
                    ],
                    "synonyms": [
                        "attach",
                        "secure",
                        "fix",
                        "tie"
                    ],
                    "antonyms": [
                        "unfasten",
                        "detach",
                        "loosen"
                    ],
                    "common_phrases": [
                        "fasten your seat belts",
                        "fasten securely",
                        "fasten together"
                    ],
                    "target_lang_definitions": {
