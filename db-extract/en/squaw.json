                                "target_senses": [
                                    {
                                        "sense_id": "39318546-34fc-3aee-8b1a-8866f0c86194",
                                        "entry_id": "ad7b5aa6-48c4-3b4f-ad7b-d603bb0498e0",
                                        "glosses": [
                                            "этногр. жена, женщина в индейском племени, вообще индианка"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0eed48e4-37d4-4c58-afe7-aa6ddf43f629",
                                                "sense_id": "39318546-34fc-3aee-8b1a-8866f0c86194",
                                                "text": "Что нам стоит учинить набег на близлежащие вигвамы и умыкнуть себе по хорошенькой скво?"
                                            },
                                            {
                                                "example_id": "b0fcd07f-e489-4ea7-912b-fcb67ff9147c",
                                                "sense_id": "39318546-34fc-3aee-8b1a-8866f0c86194",
                                                "text": "Мальчишки подняли её на смех, стали дразнить, говорить, что скво не место среди настоящих охотников, и вообще она даже никакая не скво, а бледнолицая размазня, да и стрелять не умеет…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
