                    {
                        "sense_id": "8d0b0e32-fa9a-3cc3-bdc9-12694c1658fa",
                        "entry_id": "4053c938-d6ce-3679-b5d5-cbb4e2e73a77",
                        "glosses": [
                            "A girdle, especially that of Aphrodite (or Venus) which gave the wearer the power to excite love."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "eab0d496-49b3-4a77-bce7-f1e69d917c39",
                                "sense_id": "8d0b0e32-fa9a-3cc3-bdc9-12694c1658fa",
                                "text": "With pasture slopes, and flocks just visible;\nThen, further still, soft wavy wastes of forest,\nIn all the varied tints of sylvan verdure,\nDescending to the plain; then, wide and boundless,\nThe plain itself, with towns and cultured tracts,\nAnd its fair river gleaming in the light,\nWith all its sweepy windings, seen and lost,\nAnd seen again, till through the pale grey tint\nOf distant space, it seem'd a loosen'd cestus\nFrom virgin's tunic blown; and still beyond,\nThe earth's extended vastness from the sight\nWore like the boundless ocean."
                            }
                        ]
                    }
