                "entry_id": "35ed1904-54de-3737-8f35-d9d23d1e27cc",
                "word": "folderol",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "f7bd3940-eeac-45d8-99a9-e511e3af5691",
                        "entry_id": "35ed1904-54de-3737-8f35-d9d23d1e27cc",
                        "tags": [
                            "plural"
