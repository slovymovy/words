{
    "word_family": [
        "lokettist",
        "loketbediende"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1b344a1c-961d-3488-97e9-3abfcaabd1f9",
                    "sense_definition": "Een doorgeefluik of balie, vaak beveiligd met glaswerk, voor het verkopen van kaartjes of het verrichten van administratieve handelingen.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "dienstverlening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "U kunt een treinkaartje kopen bij de automaat of aan het <w>loket</w>.",
                            "target_lang_translations": {
                                "en": "You can buy a train ticket at the machine or at the <w>counter</w>."
                            }
                        },
                        {
                            "text": "De open balie is vervangen door een reeks afgesloten <w>loketten</w>.",
                            "target_lang_translations": {
                                "en": "The open counter has been replaced by a row of enclosed <w>service windows</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "balie"
                    ],
                    "common_phrases": [
                        "aan het loket"
                    ],
                    "target_lang_definitions": {
                        "en": "A service window, counter, or hatch, often enclosed by glass, used for selling tickets or conducting administrative transactions."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "counter",
                                "target_lang_sense_clarification": "service or ticket counter"
                            },
                            {
                                "target_lang_word": "window",
                                "target_lang_sense_clarification": "service or ticket window"
                            },
                            {
                                "target_lang_word": "ticket-window",
                                "target_lang_sense_clarification": "ticket hatch or window"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b96de88c-7002-361c-9828-90c4a56ba657",
                    "sense_definition": "Een specifiek contactpunt of afdeling binnen een instantie waar het publiek terechtkan voor informatie of diensten.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "dienstverlening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Voor het aanvragen van een vergunning moet u zich melden bij het gemeentelijke <w>loket</w>.",
                            "target_lang_translations": {
                                "en": "To apply for a permit, you must report to the municipal <w>service desk</w>."
                            }
                        },
                        {
                            "text": "De gemeente heeft een speciaal <w>loket</w> geopend voor vragen over zorg.",
                            "target_lang_translations": {
                                "en": "The municipality has opened a dedicated <w>helpdesk</w> for questions about healthcare."
                            }
                        }
                    ],
                    "synonyms": [
                        "meldpunt",
                        "informatiepunt"
                    ],
                    "common_phrases": [
                        "centraal loket"
                    ],
                    "target_lang_definitions": {
                        "en": "A dedicated contact point, desk, or department within an organization where the public can obtain information or services."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "desk",
                                "target_lang_sense_clarification": "helpdesk or service desk"
                            },
                            {
                                "target_lang_word": "contact point",
                                "target_lang_sense_clarification": "point of access for public services"
                            },
                            {
                                "target_lang_word": "counter",
                                "target_lang_sense_clarification": "service counter at an office"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "57e772fd-8b17-3447-953e-90bb0deced40",
                    "sense_definition": "Een digitaal portaal of virtueel kanaal waar burgers of bedrijven online transacties, aanvragen of regelingen kunnen afhandelen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dienstverlening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het digitale <w>loket</w> is vanaf volgende week geopend voor alle subsidieaanvragen.",
                            "target_lang_translations": {
                                "en": "The digital <w>portal</w> will be open for all grant applications starting next week."
                            }
                        },
                        {
                            "text": "Door een technische storing was het online <w>loket</w> van de overheid urenlang onbereikbaar.",
                            "target_lang_translations": {
                                "en": "Due to a technical glitch, the government's online <w>portal</w> was inaccessible for hours."
                            }
                        }
                    ],
                    "synonyms": [
                        "webportaal"
                    ],
                    "common_phrases": [
                        "digitaal loket",
                        "online loket"
                    ],
                    "target_lang_definitions": {
                        "en": "A digital portal or online channel where citizens or businesses can handle transactions, applications, or administrative procedures."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "portal",
                                "target_lang_sense_clarification": "online service portal"
                            },
                            {
                                "target_lang_word": "online desk",
                                "target_lang_sense_clarification": "virtual service counter"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a274dc6b-583d-3d99-9d63-cf030a8f91eb",
                    "sense_definition": "Een klein opbergvakje of afsluitbaar hokje in een schrijfbureau of kast.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "meubilair",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In het verborgen <w>loket</w> van de oude secretaire bewaarde hij zijn brieven.",
                            "target_lang_translations": {
                                "en": "In the hidden <w>compartment</w> of the old secretary desk, he kept his letters."
                            }
                        },
                        {
                            "text": "Zij vond enkele antieke munten in een klein houten <w>loket</w> van de kast.",
                            "target_lang_translations": {
                                "en": "She found some antique coins in a small wooden <w>cubbyhole</w> of the cabinet."
                            }
                        }
                    ],
                    "synonyms": [
                        "vakje",
                        "bergvak"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Zelden nog gebruikt in hedendaags Nederlands"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A small compartment, pigeonhole, or lockable cubbyhole inside a writing desk or cabinet."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pigeonhole",
                                "target_lang_sense_clarification": "compartment in a desk"
                            },
                            {
                                "target_lang_word": "cubbyhole",
                                "target_lang_sense_clarification": "small compartment in furniture"
                            },
                            {
                                "target_lang_word": "compartment",
                                "target_lang_sense_clarification": "small storage section"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}