                "senses": [
                    {
                        "sense_id": "55a89d54-e350-3116-acb3-57b77ee3acf7",
                        "entry_id": "42220914-94ea-35df-8a68-d9678a71109f",
                        "glosses": [
                            "Verpflichtung, etwas zurück zu zahlen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "228783ad-5652-4f05-a24e-36f76046b35d",
                                "sense_id": "55a89d54-e350-3116-acb3-57b77ee3acf7",
                                "text": "„Bei wiederholter Überziehung droht die fristlose Kündigung des Kontos mit sofortiger Rückzahlungspflicht.“"
                            },
                            {
                                "example_id": "c3bc4270-477b-42b6-8c19-9d7841cbecbe",
                                "sense_id": "55a89d54-e350-3116-acb3-57b77ee3acf7",
                                "text": "„Eine Rückzahlungspflicht tritt nur dann ein, wenn ein Land seine Quote stärker ausnutzt.“"
                            },
                            {
                                "example_id": "2d053809-b9a5-4cf2-908b-35806eff8850",
                                "sense_id": "55a89d54-e350-3116-acb3-57b77ee3acf7",
                                "text": "„Die Arbeitslosenhilfe betrug für Arbeitslose mit mindestens einem Kind 57% des letzten Nettoentgelts, für die übrigen Arbeitslosen 53%; keine Rückzahlungspflicht; Finanzierung aus allgemeinen Steuermitteln.“"
                            },
                            {
                                "example_id": "d16d4aa2-8d43-4ebb-9a9d-734634f52992",
                                "sense_id": "55a89d54-e350-3116-acb3-57b77ee3acf7",
                                "text": "„Neben der Auszahlungsverpflichtung des Kreditgebers und der Rückzahlungspflicht des Kreditnehmers als Hauptpflichten beinhaltet der Kreditvertrag eine Vielzahl weiterer Vertragsbestandteile, Abreden und Klarstellungen, die zumeist durch den Kreditnehmer zu erfüllen oder zu beachten sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
