                                "example_id": "37491722-827a-4d45-b802-e4df07c44b60",
                                "sense_id": "d4743196-aa72-324f-8722-7113ad4922ff",
                                "text": "„Beim Absturz eines Polizeihubschraubers im Zentrum des türkischen Badeorts Antalya kommen vier Polizisten ums Leben.“"
                            },
                            {
                                "example_id": "ac0b433d-98bc-4b8d-a697-54d3eb0f9b4f",
                                "sense_id": "d4743196-aa72-324f-8722-7113ad4922ff",
                                "text": "„Bei einem Anschlag im türkischen Urlaubsort Antalya werden drei Menschen getötet und etwa zwei Dutzend verletzt.“"
                            }
                        ],
