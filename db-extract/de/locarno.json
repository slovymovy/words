                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22635d8f-d032-4fea-954a-3e4acec23fb9",
                                "sense_id": "6e7a1809-30ac-37a6-8e70-1e295c9dcfb5",
                                "text": "„In Locarno steigt das viel beachtete Filmfestival, am Luganer See lockt die Privatsammlung Thyssen-Bornemisza in die Villa Favorita.“"
                            },
                            {
                                "example_id": "d7177176-4ac3-4525-8c56-5c65787581b3",
                                "sense_id": "6e7a1809-30ac-37a6-8e70-1e295c9dcfb5",
                                "text": "„Er wird die Villa erst für immer verlassen, als der Krankenwagen ihn nach Locarno fährt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
