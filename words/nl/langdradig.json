{
    "word_family": [
        "langdradigheid",
        "draad",
        "draadje"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fe514aca-fc24-3adf-bd08-6d762e2eb0bc",
                    "sense_definition": "saai en te lang durend, vaak met te veel woorden of details",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "saaiheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De burgemeester die het kort zou houden hield weer een van zijn <w>langdradige</w> toespraken.",
                            "target_lang_translations": {
                                "en": "The mayor, who was supposed to keep it short, gave another one of his <w>long-winded</w> speeches."
                            }
                        },
                        {
                            "text": "Ik vond het een <w>langdradig</w> verhaal omdat hij elk klein detail wilde vertellen.",
                            "target_lang_translations": {
                                "en": "I found it a <w>tedious</w> story because he wanted to tell every little detail."
                            }
                        }
                    ],
                    "synonyms": [
                        "saai",
                        "eentonig",
                        "wijdlopig"
                    ],
                    "antonyms": [
                        "bondig",
                        "kort",
                        "beknopt"
                    ],
                    "common_phrases": [
                        "langdradig verhaal",
                        "langdradige toespraak",
                        "langdradige film"
                    ],
                    "target_lang_definitions": {
                        "en": "boring and lasting too long, often with too many words or details"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "long-winded",
                                "target_lang_sense_clarification": "referring to speech or writing that is excessively long"
                            },
                            {
                                "target_lang_word": "tedious",
                                "target_lang_sense_clarification": "too long, slow, or dull; tiresome"
                            },
                            {
                                "target_lang_word": "wordy",
                                "target_lang_sense_clarification": "using or expressed in too many words"
                            },
                            {
                                "target_lang_word": "prolix",
                                "target_lang_sense_clarification": "using or containing too many words; tediously lengthy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "47da36de-1c2d-35e0-8017-710d5c4021c8",
                    "sense_definition": "bestaande uit lange draden of vezels",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "textuur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deze wol is erg <w>langdradig</w> en daardoor lastig om mee te werken.",
                            "target_lang_translations": {
                                "en": "This wool is very <w>stringy</w> and therefore difficult to work with."
                            }
                        },
                        {
                            "text": "De <w>langdradige</w> structuur van het vlees maakt het moeilijk om te kauwen.",
                            "target_lang_translations": {
                                "en": "The <w>fibrous</w> structure of the meat makes it difficult to chew."
                            }
                        }
                    ],
                    "synonyms": [
                        "vezelig"
                    ],
                    "common_phrases": [
                        "langdradige vezels"
                    ],
                    "target_lang_definitions": {
                        "en": "consisting of long threads or fibers"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stringy",
                                "target_lang_sense_clarification": "containing long, tough fibers, especially of food or plants"
                            },
                            {
                                "target_lang_word": "fibrous",
                                "target_lang_sense_clarification": "consisting of or characterized by fibers"
                            }
                        ]
                    }
                }
            ]
        }
    ]
