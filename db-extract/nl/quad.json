                    {
                        "sense_id": "147ce08b-6a67-3a5c-9a3d-6a39188b0e85",
                        "entry_id": "0de104d2-6d21-31a8-ab4c-3f241741eae5",
                        "glosses": [
                            "een motorfiets of brommer op vier wielen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2548fa3f-bb7d-4f84-8d08-86e36967af08",
                                "sense_id": "147ce08b-6a67-3a5c-9a3d-6a39188b0e85",
                                "text": "Ik wist niet dat je een quad had."
                            }
                        ]
                    },
                    {
                        "sense_id": "b2d72a93-13f8-3fa2-ac11-a3d2350d4480",
                        "entry_id": "0de104d2-6d21-31a8-ab4c-3f241741eae5",
                        "glosses": [
                            "een richtingsgevoelige antenne bestaande uit twee evenwijdige vierkante lussen"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8555aaee-9186-406a-89e5-b426d11cc8ea",
                        "source_entry_id": "0de104d2-6d21-31a8-ab4c-3f241741eae5",
                        "source_sense_id": "147ce08b-6a67-3a5c-9a3d-6a39188b0e85",
                        "source_sense_description": "een motorfiets of brommer op vier wielen",
                        "target_lang_word": "quad",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quad",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9e8fbb61-9615-3270-ae33-81f54a0ead89",
                                        "entry_id": "6cdb77bd-add4-353a-98fc-a6976ffdc9b2",
                                        "glosses": [
                                            "Clipping of quadrat.",
                                            "A blank metal block used to fill short lines of type."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6db83fe-1d0f-4bf3-ad10-6b7bcf93d965",
                                                "sense_id": "9e8fbb61-9615-3270-ae33-81f54a0ead89",
                                                "text": "“Quadrats, sir. We call 'em quads.” […] Quads are the spaces left between the paragraphs that come white on the paper. If you look here, at this page that is set-up, you will see that they are deeper than the spaces left between the words and letters—regular little trenches."
                                            },
                                            {
                                                "example_id": "71869570-867d-41a7-82ea-2e034a45f4ab",
                                                "sense_id": "9e8fbb61-9615-3270-ae33-81f54a0ead89",
                                                "text": "Horizontal spacing is further divided into multiples and fractions of the em. The multiples are called quads. The fractions are called spaces."
                                            },
                                            {
                                                "example_id": "d74eb56b-968d-4aeb-9211-ace736291dec",
                                                "sense_id": "9e8fbb61-9615-3270-ae33-81f54a0ead89",
                                                "text": "Other larger spaces – known as quads – were used to space out lines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46cfaf04-ffdc-3c1d-a256-7c36d7b64e7a",
                                        "entry_id": "6cdb77bd-add4-353a-98fc-a6976ffdc9b2",
                                        "glosses": [
                                            "Clipping of quadrat.",
                                            "A joke used to fill long days of setting type."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3266c7a6-004c-3ea3-bcb5-2f4e9edcfd52",
                                        "entry_id": "6cdb77bd-add4-353a-98fc-a6976ffdc9b2",
                                        "glosses": [
                                            "Clipping of quadrat.",
                                            "A keyboard command which aligns text with the left or right margin, or centred between them. In combination, as quad left, quad right, or quad centre."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "253114de-4dd4-3abf-826b-4f0d33903ad4",
                                        "entry_id": "6cdb77bd-add4-353a-98fc-a6976ffdc9b2",
                                        "glosses": [
                                            "A quadrangle (quadrangular courtyard)."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39cae0b6-8a19-42de-9337-4ae90e934c04",
                                                "sense_id": "253114de-4dd4-3abf-826b-4f0d33903ad4",
                                                "text": "Gilt-backed books on gilded shelf or table caught the eye, and as you turned your glance from the luxurious interiors to the well-shorn lawn in the Quad with its classic fountain also gilded by sunbeams, the mental vision saw plainly written over the whole \"The Union of Luxury and Learning.\""
                                            },
                                            {
                                                "example_id": "341d631d-afc8-46b4-bb5b-bb10f8c7effc",
                                                "sense_id": "253114de-4dd4-3abf-826b-4f0d33903ad4",
                                                "text": "Every spring, the quad on the University of Washington (UW) campus transforms from a peaceful green space to a bustling habitat for hundreds of shuttering cameras, families, and onlookers."
                                            },
                                            {
                                                "example_id": "dbbce716-aff0-4468-95d4-0de8a72780d8",
                                                "sense_id": "253114de-4dd4-3abf-826b-4f0d33903ad4",
                                                "text": "The teenage couple is lounging on the lawn outside a high school, taking advantage of a free period between classes in that age-old way: making out on the quad."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7151f6be-9de5-3d9b-877b-497a5415e014",
                                        "entry_id": "6cdb77bd-add4-353a-98fc-a6976ffdc9b2",
                                        "glosses": [
                                            "A horse, from colloquial or humorous quadruped specifically for horse."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd8b7269-dabf-4735-b393-5cf81243358f",
                                                "sense_id": "7151f6be-9de5-3d9b-877b-497a5415e014",
                                                "text": "The quads is all right, barrin’ that the bay is blind o’ the left eye, and the chestnut a bit weak in the off fore."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d8d7c24-10b3-357c-8aea-63f4be0a58fe",
                                        "entry_id": "6cdb77bd-add4-353a-98fc-a6976ffdc9b2",
                                        "glosses": [
                                            "Something that is quadruple (four times) the usual amount, number, etc.",
                                            "A poster advertising a cinematic film release, measuring forty by thirty inches, four times the area of crown paper."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "acaaf507-53a0-33c1-8d72-8bbec404c2d1",
                                        "entry_id": "6cdb77bd-add4-353a-98fc-a6976ffdc9b2",
                                        "glosses": [
                                            "Something that is quadruple (four times) the usual amount, number, etc.",
                                            "A quadruple, a jump with four revolutions in the air."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "26df6a74-27dc-30cd-a29b-cd61d5c36827",
                                        "entry_id": "6cdb77bd-add4-353a-98fc-a6976ffdc9b2",
                                        "glosses": [
                                            "Something that is quadruple (four times) the usual amount, number, etc.",
                                            "A serving of four shots of espresso; (attributive) containing four shots of espresso."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7cce736d-1a6d-4b00-a0c8-8f6f89913ef7",
                                                "sense_id": "26df6a74-27dc-30cd-a29b-cd61d5c36827",
                                                "text": "A grande iced quad latte with milk is $6.65 + tax, whereas a quad over ice with milk added at the self-serve station is only $3.65 + tax"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9422995c-a83f-3279-a446-80da4aa22217",
                                        "entry_id": "6cdb77bd-add4-353a-98fc-a6976ffdc9b2",
                                        "glosses": [
                                            "Something that is quadruple (four times) the usual amount, number, etc.",
                                            "A skate with four wheels."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac8c6fe8-033a-4f0c-b4c0-a053d1790f55",
                                                "sense_id": "9422995c-a83f-3279-a446-80da4aa22217",
                                                "text": "These are the quads I recommend for newbies."
                                            },
                                            {
                                                "example_id": "dde64d45-1eb0-4e3d-9fe6-9a5f41e88b5a",
                                                "sense_id": "9422995c-a83f-3279-a446-80da4aa22217",
                                                "text": "When you can skate, inline, ice, quads are all equally enjoyable as long as they are of good enough quality."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa870788-ce41-32c7-8f4d-29d707ae8a0f",
                                        "entry_id": "6cdb77bd-add4-353a-98fc-a6976ffdc9b2",
                                        "glosses": [
                                            "Clipping of quadruplet (“a set of four; one of a set of four”)."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "clipping"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd0081ba-8d5f-4242-aea5-8443751b8760",
                                                "sense_id": "aa870788-ce41-32c7-8f4d-29d707ae8a0f",
                                                "text": "The Pair, Triples, and Quads can be formed with both Honor and Suit Tiles."
                                            },
                                            {
                                                "example_id": "27f14515-f992-4d43-9d47-7f2a48ffe988",
                                                "sense_id": "aa870788-ce41-32c7-8f4d-29d707ae8a0f",
                                                "text": "Object of the game: To use up all the tiles by playing them in quads. A quad is four consecutive numbers running in ascending or descending order, and played in a straight line."
                                            },
                                            {
                                                "example_id": "adf312e3-28b8-49e7-92ee-7ee8ac839a8b",
                                                "sense_id": "aa870788-ce41-32c7-8f4d-29d707ae8a0f",
                                                "text": "Each person on the team could be exclusively responsible for taking care of and keeping records for one set of four plants (a quad)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "681689a4-7add-316f-b059-de11d2a4df79",
                                        "entry_id": "6cdb77bd-add4-353a-98fc-a6976ffdc9b2",
                                        "glosses": [
                                            "Clipping of quadruplet (“a set of four; one of a set of four”).",
                                            "A group of four insulated wires twisted together to form two circuits of two wires each."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0b4e88a4-f166-3721-89fd-a103e9293221",
                                        "entry_id": "6cdb77bd-add4-353a-98fc-a6976ffdc9b2",
                                        "glosses": [
                                            "Clipping of quadruplet (“a set of four; one of a set of four”).",
                                            "A quad antenna, a directional radio antenna consisting of multiple loop antennas."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "79c7790d-b062-31ac-aeea-3eadff2560e8",
                                        "entry_id": "6cdb77bd-add4-353a-98fc-a6976ffdc9b2",
                                        "glosses": [
                                            "Clipping of quadruplet (“a set of four; one of a set of four”).",
                                            "A quadruplet, one of four babies born during the same birth."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88ce52ee-ac70-4e60-8406-8f5f3d3fa23b",
                                                "sense_id": "79c7790d-b062-31ac-aeea-3eadff2560e8",
                                                "text": "My husband Jim was home[…] and so were my children: Samantha, 4, and the quadruplets, Zachary, Danielle, Amanda, and Elisabeth. The quads were eighteen months old and in their usual fine form — singing, banging, pushing each other, and toddling into impossible places."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0d85bf1-134b-3270-bac4-51197d2e6afb",
                                        "entry_id": "6cdb77bd-add4-353a-98fc-a6976ffdc9b2",
                                        "glosses": [
                                            "Clipping of quadruplet (“a set of four; one of a set of four”).",
                                            "A kind of round-robin tournament between four players, where each participant plays every other participant once."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "195d83e3-b150-39d7-ab6c-c4bf634cec88",
                                        "entry_id": "6cdb77bd-add4-353a-98fc-a6976ffdc9b2",
                                        "glosses": [
                                            "Clipping of quadruplet (“a set of four; one of a set of four”).",
                                            "The Bible, Book of Mormon, Doctrine and Covenants, and Pearl of Great Price bound in a single volume."
                                        ],
                                        "tags": [
                                            "Mormonism"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1934562c-731d-3d41-a613-5bf6332ce45c",
                                        "entry_id": "6cdb77bd-add4-353a-98fc-a6976ffdc9b2",
                                        "glosses": [
                                            "Clipping of quadruplet (“a set of four; one of a set of four”).",
                                            "Of or relating to quads (four of a kind)."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab91cb9c-9515-4de0-835e-10ba69d26c84",
                                                "sense_id": "1934562c-731d-3d41-a613-5bf6332ce45c",
                                                "text": "Both players had four of a kind. A had quad fours; B had quad deuces."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00ee6436-2f3e-365d-bfba-f155bc2aed7c",
                                        "entry_id": "6cdb77bd-add4-353a-98fc-a6976ffdc9b2",
                                        "glosses": [
                                            "The quadriceps muscle."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29b0157b-a364-477b-a12e-a1ce2d0580b3",
                                                "sense_id": "00ee6436-2f3e-365d-bfba-f155bc2aed7c",
                                                "text": "Aesthetics aside, if you train your quads while neglecting your hamstrings, you're setting yourself up for an eventual injury."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86bae126-9989-33c5-a9f5-e52eea05b7ce",
                                        "entry_id": "6cdb77bd-add4-353a-98fc-a6976ffdc9b2",
                                        "glosses": [
                                            "Quadruplex videotape."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f15000b-b8be-4a23-bcdc-04caf2ff539b",
                                                "sense_id": "86bae126-9989-33c5-a9f5-e52eea05b7ce",
                                                "text": "The high band color quadruplex format is recommended for the following reasons:\n1. Quad is now the accepted industry standard world-wide with over 90% of all television broadcast operations using this format for video recording."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80205c6e-2e30-3edc-8f06-e334b63f9e4d",
                                        "entry_id": "6cdb77bd-add4-353a-98fc-a6976ffdc9b2",
                                        "glosses": [
                                            "A quadriplegic person."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3fda9f35-7912-4c73-b0c8-e83b10a69f0d",
                                                "sense_id": "80205c6e-2e30-3edc-8f06-e334b63f9e4d",
                                                "text": "The worse was the realization that this was my new reality. This too was Bill's debut as a husband of a quad and his first social gathering since June 22."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a31f459-e332-3890-81c0-6ff2f29c6c35",
                                        "entry_id": "6cdb77bd-add4-353a-98fc-a6976ffdc9b2",
                                        "glosses": [
                                            "A unit of energy equivalent to a quadrillion BTU (10¹⁵ BTU)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "720d3df4-00dd-3c66-b724-5b476e027923",
                                        "entry_id": "6cdb77bd-add4-353a-98fc-a6976ffdc9b2",
                                        "glosses": [
                                            "A quad bike."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5efdcd73-dbd3-4741-aa88-6cf7e500d935",
                                                "sense_id": "720d3df4-00dd-3c66-b724-5b476e027923",
                                                "text": "Cad was a ferocious driver of a quad, much given to wheelies, jumps and stunts in general."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fff13a43-2203-378c-88cc-cada6080a4bc",
                                        "entry_id": "6cdb77bd-add4-353a-98fc-a6976ffdc9b2",
                                        "glosses": [
                                            "A quadrilateral."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20b0296a-55c0-4d8e-8553-7a5716587aad",
                                                "sense_id": "fff13a43-2203-378c-88cc-cada6080a4bc",
                                                "text": "System Rasterization Primitives • Polygons • Triangles, Trapezoids, Quads"
                                            },
                                            {
                                                "example_id": "40662706-a0e8-4bdd-a23c-386a3cca35a8",
                                                "sense_id": "fff13a43-2203-378c-88cc-cada6080a4bc",
                                                "text": "schemes have appeared which generate good results when applied to meshes which contain both triangular and quadrilateral regions. These kinds of schemes turn out to be very useful for modelling animations, because there, in symmetric (e.g. cylindrical) areas, quads and vertices with valence 4 are preferred"
                                            },
                                            {
                                                "example_id": "b832b70c-8cea-425d-bb51-45ab1f07a974",
                                                "sense_id": "fff13a43-2203-378c-88cc-cada6080a4bc",
                                                "text": "Tris and quads have different areas of functionality. In real-time graphics, tris are the norm because they provide the most basic geometric representations of planes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aff09897-6a72-3ccd-9f97-7a417bd286ba",
                                        "entry_id": "6cdb77bd-add4-353a-98fc-a6976ffdc9b2",
                                        "glosses": [
                                            "A quadcopter."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "789683df-a7b7-4bb5-9df6-13c7873ac421",
                                                "sense_id": "aff09897-6a72-3ccd-9f97-7a417bd286ba",
                                                "text": "Today you can buy quadrotor drones—also known as quadcopters—of just about any kind, for just about any price. The extremely wealthy can buy gold-plated quads, and the rest of us can buy tiny plastic ones."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3335b291-f3b1-307a-b15c-ad2ce564ad85",
                                        "entry_id": "6cdb77bd-add4-353a-98fc-a6976ffdc9b2",
                                        "glosses": [
                                            "A quadrupel beer."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22ecab65-d378-443d-9aa3-7132fbeea3c9",
                                                "sense_id": "3335b291-f3b1-307a-b15c-ad2ce564ad85",
