                ],
                "senses": [
                    {
                        "sense_id": "1bdc501a-2d82-3a8c-833a-e56a74f3c5b5",
                        "entry_id": "a8f0cf7c-7441-3a89-8871-b53364c1c47e",
                        "glosses": [
                            "Erlernen der Sprache, die ein Kind in den ersten Lebensjahren vorrangig verwendet, in der Regel die Muttersprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0e6f58f-f67b-4e3c-a0a7-82b1e200891f",
                                "sense_id": "1bdc501a-2d82-3a8c-833a-e56a74f3c5b5",
                                "text": "Mit Erstspracherwerb wird die Tatsache bezeichnet, dass jemand eine bestimmte Sprache als erste erwirbt, in der Regel die seiner Eltern, die Muttersprache."
                            },
                            {
                                "example_id": "9df4b65f-81a2-41b0-a045-874bd40c7957",
                                "sense_id": "1bdc501a-2d82-3a8c-833a-e56a74f3c5b5",
                                "text": "„Nativistische Konzeptionen des Erstspracherwerbs postulieren, »[…] daß Sprachkenntnis - eine Grammatik - nur von einem Organismus erworben werden kann, der mit einer strengen Restriktion im Hinblick auf die Form der Grammatik ›prädisponiert‹ ist…«.“"
                            },
                            {
                                "example_id": "21347c7f-1211-4391-a860-4e7cae8bb72b",
                                "sense_id": "1bdc501a-2d82-3a8c-833a-e56a74f3c5b5",
                                "text": "Elsen gibt ihrem Buch über den Lauterwerb in der Muttersprache den Titel Erstspracherwerb."
                            },
                            {
                                "example_id": "9f0f9f98-1e03-4a35-93a6-2d950025c2dd",
                                "sense_id": "1bdc501a-2d82-3a8c-833a-e56a74f3c5b5",
                                "text": "„Sie beschreibt den Erstspracherwerb einiger Konsonanten des Deutschen eines Jungen, G., im Alter von 1;09:0,1 bis 2;05:24 Jahren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
