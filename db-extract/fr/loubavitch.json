                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b20d071-a1af-4390-a095-99a980ba91e8",
                                "sense_id": "d0201166-652e-3f4c-97f2-f1a8d74ecf5f",
                                "text": "Ce sont deux loubavitch (secte juive orthodoxe dont le siège est à New York) habitant le village voisin."
                            },
                            {
                                "example_id": "e942a3a7-d72a-48ec-bc5e-a296e95b993a",
                                "sense_id": "d0201166-652e-3f4c-97f2-f1a8d74ecf5f",
                                "text": "Il faut prendre garde, en outre, aux demandes de création d’écoles formulées par d’autres : juifs orthodoxes ou loubavitchs renaissants, et fondamentalistes musulmans."
                            }
                        ]
                    }
