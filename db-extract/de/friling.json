                ],
                "senses": [
                    {
                        "sense_id": "f8692425-cb05-36dc-923a-d0b261103073",
                        "entry_id": "2e7b17e3-2c1d-39c0-b71f-3d7efb88cb64",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "852f9480-27da-48b8-8284-dc0042814199",
                                "sense_id": "f8692425-cb05-36dc-923a-d0b261103073",
                                "text": "Frau Friling ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "4e4314e2-80ca-409e-a3a6-330c9961e61c",
                                "sense_id": "f8692425-cb05-36dc-923a-d0b261103073",
                                "text": "Herr Friling wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "dadf2dbf-e3f8-4dcb-bfa0-56b5668a8fba",
                                "sense_id": "f8692425-cb05-36dc-923a-d0b261103073",
                                "text": "Die Frilings fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "ba115696-b68b-48db-b2c0-2cdf9ea9250d",
                                "sense_id": "f8692425-cb05-36dc-923a-d0b261103073",
                                "text": "Der Friling trägt nie die Schals, die die Friling ihm strickt."
                            },
                            {
                                "example_id": "a3ca6261-d19c-44e0-bf7f-4754dcc5a2e0",
                                "sense_id": "f8692425-cb05-36dc-923a-d0b261103073",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Friling kommt, geht der Herr Friling.“"
                            },
                            {
                                "example_id": "aab1c14a-df36-4d73-b519-633fbfbd40c0",
                                "sense_id": "f8692425-cb05-36dc-923a-d0b261103073",
                                "text": "Friling kommt und geht."
                            },
                            {
                                "example_id": "2aa9ba78-c19a-44b8-9da4-1af256ae6808",
                                "sense_id": "f8692425-cb05-36dc-923a-d0b261103073",
                                "text": "Frilings kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
