{
    "word_family": [
        "oblivion"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d3700578-17c3-3d27-ad4d-a2cd2637709d",
                    "sense_definition": "Lacking awareness or consciousness of one's surroundings or a specific situation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "awareness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The driver was <w>oblivious</w> to the stop sign and nearly caused an accident.",
                            "target_lang_translations": {
                                "cs": "Řidič byl <w>nevšímavý</w> ke značce stop a málem způsobil nehodu."
                            }
                        },
                        {
                            "text": "She remained <w>oblivious</w> to the surroundings while reading her book.",
                            "target_lang_translations": {
                                "cs": "Zůstala <w>nevšímavá</w> ke svému okolí, zatímco četla knihu."
                            }
                        }
                    ],
                    "synonyms": [
                        "unaware",
                        "unmindful",
                        "heedless"
                    ],
                    "antonyms": [
                        "aware",
                        "conscious",
                        "mindful"
                    ],
                    "common_phrases": [
                        "oblivious to surroundings",
                        "completely oblivious"
                    ],
                    "target_lang_definitions": {
                        "cs": "Postrádající povědomí nebo vědomí o svém okolí nebo konkrétní situaci."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "nevšímavý",
                                "target_lang_sense_clarification": "osoba, která si nevšímá okolí nebo podnětů"
                            },
                            {
                                "target_lang_word": "neuvědomující si",
                                "target_lang_sense_clarification": "osoba, která si není vědoma určité skutečnosti"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "55365845-7e0f-3ff5-afee-59f16ca801fb",
                    "sense_definition": "Prone to forgetting things easily.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "memory",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is hopelessly <w>oblivious</w> and often misses his scheduled meetings.",
                            "target_lang_translations": {
                                "cs": "Je beznadějně <w>roztržitý</w> a často zmešká své naplánované schůzky."
                            }
                        },
                        {
                            "text": "Being <w>oblivious</w> to daily tasks can make life quite difficult for him.",
                            "target_lang_translations": {
                                "cs": "Být <w>zapomnětlivý</w> ohledně každodenních úkolů mu může život značně ztížit."
                            }
                        }
                    ],
                    "synonyms": [
                        "forgetful",
                        "absent-minded"
                    ],
                    "antonyms": [
                        "attentive"
                    ],
                    "common_phrases": [
                        "hopelessly oblivious"
                    ],
                    "target_lang_definitions": {
                        "cs": "Mající sklon snadno zapomínat nebo být roztržitý."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "roztržitý",
                                "target_lang_sense_clarification": "člověk, který zapomíná nebo nedává pozor kvůli nesoustředěnosti"
                            },
                            {
                                "target_lang_word": "zapomnětlivý",
                                "target_lang_sense_clarification": "člověk, který má potíže s pamětí na běžné úkoly"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}