    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "324b22c5-388b-3f7c-b5ab-f901e5b6cc78",
                    "sense_definition": "Прочно, надёжно; так, что трудно разбить, сломать или сдвинуть.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_firmness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Она <крепко> держала ребёнка за руку, чтобы он не убежал.",
                            "target_lang_translations": {
                                "en": "She held the child's hand <firmly> so he wouldn't run away.",
                                "de": "Sie hielt das Kind <fest> an der Hand, damit es nicht weglief."
                            }
                        },
                        {
                            "text": "Дверь была <крепко> заперта на большой железный засов.",
                            "target_lang_translations": {
                                "en": "The door was <securely> locked with a large iron bolt.",
                                "de": "Die Tür war mit einem großen Eisenriegel <fest> verschlossen."
                            }
                        }
                    ],
                    "synonyms": [
                        "прочно",
                        "надёжно",
                        "сильно"
                    ],
                    "antonyms": [
                        "слабо"
                    ],
                    "common_phrases": [
                        "крепко держать",
                        "крепко связать",
                        "крепко обнять",
                        "крепко стоять"
                    ],
                    "target_lang_definitions": {
                        "en": "Firmly, securely; in a way that is difficult to break, loosen, or move.",
                        "de": "Fest, sicher; so, dass es schwer zu zerbrechen, zu lösen oder zu bewegen ist."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "firmly",
                                "target_lang_sense_clarification": "used for holding, standing, or physical stability"
                            },
                            {
                                "target_lang_word": "tightly",
                                "target_lang_sense_clarification": "used for gripping, holding, or closing"
                            },
                            {
                                "target_lang_word": "securely",
                                "target_lang_sense_clarification": "used for locking or fastening"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "fest",
                                "target_lang_sense_clarification": "wird für das Halten oder die physische Stabilität verwendet"
                            },
                            {
                                "target_lang_word": "sicher",
                                "target_lang_sense_clarification": "wird für das Verschließen oder Befestigen verwendet"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e208a35-9786-35f1-a389-c5e39f2f18dd",
                    "sense_definition": "Очень сильно, глубоко или основательно (о сне, чувствах, мыслях).",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "figurative_intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "После долгой прогулки в лесу он <крепко> уснул.",
                            "target_lang_translations": {
                                "en": "After a long walk in the forest, he fell <fast> asleep.",
                                "de": "Nach einem langen Spaziergang im Wald schlief er <tief> und fest."
                            }
                        },
                        {
                            "text": "Я <крепко> задумался над вашим предложением о работе.",
                            "target_lang_translations": {
                                "en": "I thought <hard> about your job offer.",
                                "de": "Ich habe <intensiv> über Ihr Stellenangebot nachgedacht."
                            }
                        }
                    ],
                    "synonyms": [
                        "си́льно"
                    ],
                    "antonyms": [
                        "слабо"
                    ],
                    "common_phrases": [
                        "крепко спать",
                        "крепко любить",
                        "крепко задуматься",
                        "крепко дружить"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in conversational contexts for emphasis"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Very strongly, deeply, or thoroughly (referring to sleep, feelings, or thoughts).",
                        "de": "Sehr stark, tief oder gründlich (in Bezug auf Schlaf, Gefühle oder Gedanken)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "soundly",
                                "target_lang_sense_clarification": "used specifically with sleep"
                            },
                            {
                                "target_lang_word": "hard",
                                "target_lang_sense_clarification": "used with thinking or mental effort"
                            },
                            {
                                "target_lang_word": "fast",
                                "target_lang_sense_clarification": "used in the phrase 'fast asleep'"
                            },
                            {
                                "target_lang_word": "deeply",
                                "target_lang_sense_clarification": "used with feelings or states of being"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "tief",
                                "target_lang_sense_clarification": "wird speziell für Schlaf verwendet"
                            },
                            {
                                "target_lang_word": "fest",
                                "target_lang_sense_clarification": "wird für Gefühle oder Überzeugungen verwendet"
                            },
                            {
                                "target_lang_word": "intensiv",
                                "target_lang_sense_clarification": "wird für Nachdenken oder geistige Anstrengung verwendet"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "90942171-2839-3aad-902d-1a6ec64f88f4",
                    "sense_definition": "Насыщенно, с большой концентрацией (о чае, кофе или запахах).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "concentration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Папа всегда просит <крепко> заварить ему чёрный чай.",
                            "target_lang_translations": {
                                "en": "Dad always asks to brew his black tea <strong/strongly>.",
                                "de": "Papa bittet immer darum, ihm den schwarzen Tee <stark> zu brühen."
                            }
                        },
                        {
                            "text": "В комнате <крепко> пахло дорогим табаком и кофе.",
                            "target_lang_translations": {
                                "en": "The room smelled <strongly> of expensive tobacco and coffee.",
                                "de": "Im Zimmer roch es <intensiv> nach teurem Tabak und Kaffee."
                            }
                        }
                    ],
                    "antonyms": [
                        "слабо"
                    ],
                    "common_phrases": [
                        "крепко заварить",
                        "крепко пахнуть"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Strongly or intensely (referring to the concentration of tea, coffee, or smells).",
                        "de": "Konzentriert oder intensiv (in Bezug auf die Stärke von Tee, Kaffee oder Gerüchen)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "strong",
                                "target_lang_sense_clarification": "used for tea, coffee, or drinks (often as an adjective)"
                            },
                            {
                                "target_lang_word": "strongly",
                                "target_lang_sense_clarification": "used for smells or scents"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "stark",
                                "target_lang_sense_clarification": "wird für Tee, Kaffee oder Getränke verwendet"
                            },
                            {
                                "target_lang_word": "intensiv",
                                "target_lang_sense_clarification": "wird für Gerüche verwendet"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "adbc91db-6725-3694-a208-1a7447ffa3d9",
                    "sense_definition": "О телосложении: плотно, мускулисто, свидетельствуя о физической силе.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_build",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Молодой спортсмен был <крепко> сложен и выглядел очень здоровым.",
                            "target_lang_translations": {
                                "en": "The young athlete was <sturdily> built and looked very healthy.",
                                "de": "Der junge Sportler war <kräftig> gebaut und sah sehr gesund aus."
                            }
                        },
                        {
                            "text": "Несмотря на возраст, старик был сбит <крепко> и ходил быстро.",
                            "target_lang_translations": {
                                "en": "Despite his age, the old man was <solidly> built and walked quickly.",
                                "de": "Trotz seines Alters war der alte Mann <stämmig> gebaut und ging schnell."
                            }
                        }
                    ],
                    "synonyms": [
                        "мо́щно"
                    ],
                    "antonyms": [
                        "хило"
                    ],
                    "common_phrases": [
                        "крепко сложен",
                        "крепко сбит"
                    ],
                    "target_lang_definitions": {
                        "en": "Sturdily or solidly (referring to body build or physique).",
                        "de": "Kräftig oder robust gebaut (in Bezug auf den Körperbau)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sturdily",
                                "target_lang_sense_clarification": "referring to a robust physical build"
                            },
                            {
                                "target_lang_word": "solidly",
                                "target_lang_sense_clarification": "referring to a compact, strong build"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "kräftig",
                                "target_lang_sense_clarification": "bezieht sich auf einen robusten Körperbau"
                            },
                            {
                                "target_lang_word": "stämmig",
                                "target_lang_sense_clarification": "bezieht sich auf einen kompakten, starken Körperbau"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0f2b32cf-d98e-3e7f-a7c1-f73ee5d4f4a8",
                    "sense_definition": "Краткая форма среднего рода единственного числа прилагательного <w>крепкий</w>.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "short_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Его слово всегда <крепко> и нерушимо.",
                            "target_lang_translations": {
                                "en": "His word is always <firm> and unbreakable.",
                                "de": "Sein Wort ist immer <fest> und unumstößlich."
                            }
                        },
                        {
                            "text": "Это старое дерево ещё <крепко> и простоит много лет.",
                            "target_lang_translations": {
                                "en": "This old tree is still <strong/sturdy> and will stand for many years.",
                                "de": "Dieser alte Baum ist noch <stark> und wird noch viele Jahre stehen."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "short neuter singular"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Short form of the neuter singular adjective 'strong' or 'firm'.",
                        "de": "Kurzform des sächlichen Adjektivs 'stark' oder 'fest'."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "firm",
                                "target_lang_sense_clarification": "unshakeable or reliable (abstract)"
                            },
                            {
                                "target_lang_word": "strong",
                                "target_lang_sense_clarification": "physically durable or healthy"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "fest",
                                "target_lang_sense_clarification": "unerschütterlich oder zuverlässig (abstrakt)"
                            },
                            {
                                "target_lang_word": "stark",
                                "target_lang_sense_clarification": "physisch widerstandsfähig oder gesund"
                            }
                        ]
                    }
                }
            ]
        }
    ]
