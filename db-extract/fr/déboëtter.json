                "senses": [
                    {
                        "sense_id": "64f94e98-edf4-3236-8473-4a6b21fbe416",
                        "entry_id": "c4b89abf-1dbc-3fd7-b42d-c6644d808a3f",
                        "glosses": [
                            "Enlever la boëtte de l’hameçon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93268e39-ffcc-437b-8fc3-a45b6149d807",
                                "sense_id": "64f94e98-edf4-3236-8473-4a6b21fbe416",
                                "text": "Quand vous commencez à boëtter vos lignes, vous finissez trois ou quatre heures après, les reins cassés ; pour, alors, déboëtter une manne, une corbeille de lignes, et la reboëtter avec de l’encornet frais, il faut de l’ambition…"
                            },
                            {
                                "example_id": "c682d7c4-ccd4-4687-9472-685dd9372292",
                                "sense_id": "64f94e98-edf4-3236-8473-4a6b21fbe416",
                                "text": "Celui qui était derrière, il attrapait la morue, il la déboëttait, et il lovait ses lignes en même temps."
                            }
                        ]
                    }
                ],
