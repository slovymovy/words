                ],
                "senses": [
                    {
                        "sense_id": "eeffb49d-cdde-3d2f-98ac-6825828d04b5",
                        "entry_id": "619a43be-6976-3bbf-b304-08d405b33179",
                        "glosses": [
                            "Autre orthographe de calancher (mourir)."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "11c1a4d8-97d8-4ea9-af63-1323da83ed3e",
                                "sense_id": "eeffb49d-cdde-3d2f-98ac-6825828d04b5",
                                "text": "Et il n’y avait aucune raison pour que je n’en vinsse pas à bout, du moment qu’autour de moi on commençait à calencher et que les matraques prenaient position."
                            },
                            {
                                "example_id": "4ea1fdf7-90bb-41b0-bc4a-4d037fe90d8e",
                                "sense_id": "eeffb49d-cdde-3d2f-98ac-6825828d04b5",
                                "text": "Si on me retrouvait calenché de façon pas catholique, bigophone à Gabriel Lecouvreur à ce resto à Paname, le tavernier saura où le loger."
                            },
                            {
                                "example_id": "06e10f2e-1acb-4b1a-9690-0e38e62e6f68",
                                "sense_id": "eeffb49d-cdde-3d2f-98ac-6825828d04b5",
                                "text": "Nul familier n’est plus agréable à vivre qu’un poisson rouge. J’essayais d’en gagner à la loterie. Hélas, tous mes poissons de foire calenchaient."
                            }
                        ]
                    }
                ],
