                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ba07062-9493-35a4-80c1-57157d69746d",
                                        "entry_id": "81e6f2df-7fa2-3843-bc87-d3c18e7c8c27",
                                        "glosses": [
                                            "Allowing more than is usual to be seen."
                                        ],
                                        "tags": [
                                            "of clothing"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af6a7dce-2e70-43e6-abf9-f1d5e034d3a5",
                                                "sense_id": "7ba07062-9493-35a4-80c1-57157d69746d",
                                                "text": "Her shirt is rather revealing."
                                            }
