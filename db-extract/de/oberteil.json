                                "example_id": "d88f98fa-07cf-4bd6-91ae-abbae158e42f",
                                "sense_id": "c621f872-b900-3cbd-b104-450f3cb6c484",
                                "text": "„Beim Eingießen der Büchsen prüfe man erst, ob der Oberteil genau senkrecht in den Schnittstempel eingedrückt und ob der Abstreifer gerade zurückgeschraubt worden ist.“"
                            },
                            {
                                "example_id": "5110841e-c591-47d0-9eb6-ba3132bd02fe",
                                "sense_id": "c621f872-b900-3cbd-b104-450f3cb6c484",
                                "text": "„Zusammen mit dem Innenfutter, je nach Schuh entweder aus Leder oder Gore-Tex, ist der Oberteil des Schuhs, der Schaft, fertig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "208b36d5-d17c-3bc2-93a4-c2b2c0fc4054",
                        "entry_id": "d693c2c4-2df2-37b1-b1f3-b9e524be2e21",
                        "glosses": [
                            "Kleidungsstück für die obere Hälfte des Körpers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "029b4c4d-0e74-4adb-83b6-f656dc5eb109",
                                "sense_id": "208b36d5-d17c-3bc2-93a4-c2b2c0fc4054",
                                "text": "Kannst du mir bitte mal das Oberteil geben?"
                            },
                            {
                                "example_id": "cc53f0c0-0a2c-4424-beb7-9f04260dc5d3",
                                "sense_id": "208b36d5-d17c-3bc2-93a4-c2b2c0fc4054",
                                "text": "„Im Fitnessstudio sind junge Frauen in knappen Oberteilen keine Seltenheit."
                            },
                            {
                                "example_id": "fb412bba-bd54-40ea-a0f4-ccff550e69b5",
                                "sense_id": "208b36d5-d17c-3bc2-93a4-c2b2c0fc4054",
                                "text": "„Sie zieht das Oberteil ihres Bikinis aus und legt sich hin, erst auf den Bauch, zwanzig Minuten später auf den Rücken.“"
                            },
                            {
                                "example_id": "bd1afc7c-41b3-411e-b316-410a253808d3",
                                "sense_id": "208b36d5-d17c-3bc2-93a4-c2b2c0fc4054",
                                "text": "„Ich sah Katinka an, ihr Oberteil, das straff in der Jeans steckte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
