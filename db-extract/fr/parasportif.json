                    {
                        "sense_id": "b6953d44-c215-3c05-9f03-1692fd36ec4a",
                        "entry_id": "6d0733e2-5a7f-369d-8535-b56c79ab3dca",
                        "glosses": [
                            "Relatif aux sports pratiqués par les sportifs handicapés par une déficience physique ou motrice."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ee4655d-d604-41c9-83f1-f383fa97a2f5",
                                "sense_id": "b6953d44-c215-3c05-9f03-1692fd36ec4a",
                                "text": "Mais dans le même temps, l'entraîneur se braquait, refusant souvent le dialogue et imposant un joug parasportif que peu de joueurs ont supporté."
                            },
                            {
                                "example_id": "19b0ef48-8166-4a4f-9305-b3f045cfec0a",
                                "sense_id": "b6953d44-c215-3c05-9f03-1692fd36ec4a",
                                "text": "Il faut donc observer comment les probabilités de « conduites de classe » dans le choix des pratiques sportives et parasportives, là comme ailleurs, se réalisent ou non."
                            }
                        ]
                    }
                ],
