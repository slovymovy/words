                "senses": [
                    {
                        "sense_id": "088ea116-5306-3027-914e-811e82cdbd62",
                        "entry_id": "5bc413dd-24e9-3f2c-8bdb-96f3ded30429",
                        "glosses": [
                            "To cancel an invitation to (someone)."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "48eb0e38-d1ec-4def-a22c-03dbee0822cd",
                                "sense_id": "088ea116-5306-3027-914e-811e82cdbd62",
                                "text": "Near-synonym: uninvite (see notes)"
                            },
                            {
                                "example_id": "20944a14-624a-4453-9f6d-610e0d3f2fa0",
                                "sense_id": "088ea116-5306-3027-914e-811e82cdbd62",
                                "text": "Edwina Gately, a lay missionary who works with prostitutes in Chicago, was recently \"disinvited\" from delivering homilies at two parishes after the pastors received conservative complaints."
                            },
                            {
                                "example_id": "fdbac88a-c72a-4a2c-9e6e-79ff90deac8e",
                                "sense_id": "088ea116-5306-3027-914e-811e82cdbd62",
                                "text": "Tech people rarely, if ever, have a sense of the broader applications and policy implications of the projects to which they're assigned. And the work that consumes them tends to require such specialized knowledge that to bring it up at a barbecue would get them disinvited from the next one, because nobody cared."
                            },
                            {
                                "example_id": "16e7b374-e781-4a93-b5b3-8e268ced32a0",
                                "sense_id": "088ea116-5306-3027-914e-811e82cdbd62",
                                "text": "Well-meaning people have advised me that voicing this opinion could lead to being disinvited from literary events and festivals, and that my career in Germany – the source of my livelihood for the last two years – might be over."
                            },
                            {
                                "example_id": "2466e7e3-519d-48a8-99d4-eb3cebfecdf7",
                                "sense_id": "088ea116-5306-3027-914e-811e82cdbd62",
                                "text": "The organisers of the Berlin international film festival have disinvited five politicians from the far-right party Alternative für Deutschland (AfD) from next week’s opening gala in the German capital, citing recent reports on the AfD’s alleged mass deportation plans."
                            }
                        ]
                    }
