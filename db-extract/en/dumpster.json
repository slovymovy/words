                "senses": [
                    {
                        "sense_id": "dfb6e30e-00f9-308b-8daa-8912b994204c",
                        "entry_id": "d1451f21-2af1-32b3-a44b-24dd11d76f78",
                        "glosses": [
                            "A large, usually metal trash receptacle designed to be hoisted up by a garbage truck in order to be emptied."
                        ],
                        "tags": [
                            "Canada",
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "3ac91daf-2ab5-4d38-a04a-692fa955a402",
                                "sense_id": "dfb6e30e-00f9-308b-8daa-8912b994204c",
                                "text": "He realized with a brief shudder that Kurt probably used this flashlight while nipple-deep in dumpsters, had an image of Kurt transferring it from his gloved hands to his mouth and back again as he dug through bags of kitchen and toilet waste, looking for discarded technology."
                            },
                            {
                                "example_id": "1aaa94e0-537f-49f3-b254-281c4093aaa2",
                                "sense_id": "dfb6e30e-00f9-308b-8daa-8912b994204c",
                                "text": "[…]with the uncanny ability to always look like he just woke up in a dumpster"
                            }
                        ]
                    }
                ],
