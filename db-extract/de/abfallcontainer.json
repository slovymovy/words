                            {
                                "example_id": "1d223222-94c4-4583-9e09-61b19a9b83cc",
                                "sense_id": "8043e363-f1e1-3984-a285-e5afc4a04163",
                                "text": "„Am Tag nach dem Memorial Day schiebt der Hausmeister einen Abfallcontainer durch die Gänge und sammelt die frischen Blumen ein.“"
                            },
                            {
                                "example_id": "414d9477-53bc-4841-bd11-98867a103582",
                                "sense_id": "8043e363-f1e1-3984-a285-e5afc4a04163",
                                "text": "„Sogar die Abfallcontainer sind in gutem Zustand, frisch gestrichen und diskret.“"
                            }
                        ],
