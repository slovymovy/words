                "senses": [
                    {
                        "sense_id": "ee4255bd-6aa1-31c7-b2cb-bbd0328f06b0",
                        "entry_id": "f3d45c40-855a-3ed0-83e8-6c24ae33bf6b",
                        "glosses": [
                            "Buch für/mit Skizzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e300af11-3fa6-4156-8797-97ebd046f520",
                                "sense_id": "ee4255bd-6aa1-31c7-b2cb-bbd0328f06b0",
                                "text": "„Als er sich endlich nach Katell umsah, der in eine Ecke gelehnt mit raschen Strichen das Bild in seinem Skizzenbuch festhielt, da erst kam ihm der Gedanke, ob sich Anna wohl auch in einer dieser Gruppen befinden könne.“"
                            },
                            {
                                "example_id": "ad43a1ad-e3d5-4584-b950-0e68778ce676",
                                "sense_id": "ee4255bd-6aa1-31c7-b2cb-bbd0328f06b0",
                                "text": "„Diese Notizen zum Verlauf des vorigen Tages werden später in ein großes Skizzenbuch kopiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
