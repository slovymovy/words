                                    {
                                        "sense_id": "b3022f4a-4694-3b75-a9c9-12188a559b7c",
                                        "entry_id": "6935ddaa-5755-3d45-ac51-fb0636b49ea0",
                                        "glosses": [
                                            "Syrup made from the sap of the sugar maple, Acer saccharum."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4bf9f30d-88e3-357b-aae6-13982e51c2b3",
                                        "entry_id": "6935ddaa-5755-3d45-ac51-fb0636b49ea0",
                                        "glosses": [
                                            "Syrup flavored with artificial maple flavoring; though legally in the United States cannot be labelled as such when for sale."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "62e947e5-5acc-405f-b2e1-63d03126faee",
                        "source_entry_id": "708d7272-da70-3f34-bf38-4d8de1ef4e4b",
                        "source_sense_id": "ffb6b971-9b00-31b2-9938-08ced9725494",
                        "source_sense_description": "Süßungsmittel aus dem Saft des Zuckerahorns",
                        "target_lang_word": "sirop d’érable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sirop d’érable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6fea1fa7-e161-3142-a2ff-8bc1cd0f7ff1",
                                        "entry_id": "168c9483-3ac6-31ab-a269-3abfac42374c",
                                        "glosses": [
                                            "Sirop résultant de la réduction de l’eau d’érable par évaporation, servant comme ingrédient dans divers mets."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96e94a95-cb18-48a7-8a21-1d7c84d9b05d",
                                                "sense_id": "6fea1fa7-e161-3142-a2ff-8bc1cd0f7ff1",
                                                "text": "Oh ! Hé ho !\nOn n’est jamais de trop\nPour manger du sirop\nPour manger du sirop\nD’éra-a-ble !"
                                            },
                                            {
                                                "example_id": "54ee6267-d6cf-4326-90f0-e2e0782c599c",
                                                "sense_id": "6fea1fa7-e161-3142-a2ff-8bc1cd0f7ff1",
                                                "text": "Jambon au sirop d’érable, tarte au sirop d’érable."
                                            },
                                            {
                                                "example_id": "d899dce3-e8a9-432a-a358-e2a5d9e55bd8",
                                                "sense_id": "6fea1fa7-e161-3142-a2ff-8bc1cd0f7ff1",
                                                "text": "Beignet aux pommes et sirop d’érable."
                                            },
                                            {
                                                "example_id": "3328c3f5-2054-4116-bddc-6f607fe51616",
                                                "sense_id": "6fea1fa7-e161-3142-a2ff-8bc1cd0f7ff1",
                                                "text": "Il achète aussi du fromage frais Mato, qu’il servira au dessert, arrosé de sirop d’érable et entouré de cerises de terre pour ajouter une pointe d’acidité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b26a64f-2f44-3d78-a30b-a74f6da7150e",
                                        "entry_id": "168c9483-3ac6-31ab-a269-3abfac42374c",
                                        "glosses": [
                                            "Référence au Canada."
                                        ],
                                        "tags": [
                                            "En apposition"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bac7dd9c-bf87-4199-b854-93b1d1405d48",
                                                "sense_id": "9b26a64f-2f44-3d78-a30b-a74f6da7150e",
                                                "text": "Le Wall Street Journal prédisait alors au Canada le destin d’un « nouveau Mexique ». Après la gueule de bois tequila, qui secouait le géant hispanique, c’était la crise de foie sirop d’érable qui était promise au voisin du Nord."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
