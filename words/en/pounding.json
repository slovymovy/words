                    "frequency": "Middle",
                    "semantic_group_id": "sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy storm brought <w>pounding</w> rain all night long.",
                            "target_lang_translations": {
                                "cs": "Silná bouře přinesla celou noc <w>prudký</w> déšť."
                            }
                        },
                        {
                            "text": "I woke up with a <w>pounding</w> headache after the loud party.",
                            "target_lang_translations": {
