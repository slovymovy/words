                                            {
                                                "example_id": "fd14e4ff-8240-4460-a8c1-369a3b34ccf0",
                                                "sense_id": "e00958ea-5dfb-308a-ab54-19d29398d290",
                                                "text": "Consommer de grandes quantités de céréales."
                                            },
                                            {
                                                "example_id": "a0134af8-22cd-43de-ba8d-19e4dcf20dc5",
                                                "sense_id": "e00958ea-5dfb-308a-ab54-19d29398d290",
                                                "text": "On consomme beaucoup dans cette maison."
                                            },
