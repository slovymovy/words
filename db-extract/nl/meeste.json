                                            {
                                                "example_id": "ad43333f-58b2-4320-aa81-571e72ba0174",
                                                "sense_id": "131bcbf3-4789-3553-82f8-569b3f7f3e28",
                                                "text": "«Cuando en la votación de una sentencia, auto ó providencia no resultare mayoría de votos sobre cualquiera de los pronunciamientos de hecho o de derecho que deban hacerse, o sobre la decisión que haya de dictarse volverán a discutirse y a votarse los puntos en que hayan disentido los votantes»."
                                            }
