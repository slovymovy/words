                                "target_lang_sense_clarification": "to do something to stay busy"
                            },
                            {
                                "target_lang_word": "while away",
                                "target_lang_sense_clarification": "to spend time in a relaxed way"
                            }
                        ]
                    }
                }
            ]
        }
