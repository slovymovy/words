                        "examples": [
                            {
                                "example_id": "b3800263-a0d5-4d9f-a5f6-64f2742a1037",
                                "sense_id": "8cbab61f-2e23-34d3-8155-d529e91f20f7",
                                "text": "Avant de se recoucher, l’idée lui vint pourtant de soulever son traversin. Il aperçut alors trois minuscules pastilles noirâtres, qui prestement se muchèrent dans un repli de drap."
                            },
                            {
                                "example_id": "9abd2c0e-274e-4bde-8238-1de694268d2a",
                                "sense_id": "8cbab61f-2e23-34d3-8155-d529e91f20f7",
                                "text": "Il avait un peu l'air d'un cochon d'Inde qui se muche sous la paille et vous guette avec anxiété."
                            },
                            {
                                "example_id": "e0363475-6a78-410b-ba19-564d11b3654a",
                                "sense_id": "8cbab61f-2e23-34d3-8155-d529e91f20f7",
                                "text": "…y compris les partisans du clan de Tobie qui restaient muchés dans leurs huttes pour ne pas être aperçus par les trois « démons »."
                            }
                        ]
                    }
