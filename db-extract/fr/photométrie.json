                        "sense_id": "0f075ca4-6720-37fd-b2b1-e5be51c111cf",
                        "entry_id": "7a453015-b606-317a-9dca-49acc16d606b",
                        "glosses": [
                            "Mesure de l’intensité de la lumière."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "ce3174e3-5b28-4c8f-bcbf-6f8b639be407",
                                "sense_id": "0f075ca4-6720-37fd-b2b1-e5be51c111cf",
                                "text": "Vu la différence souvent considérable dans la couleur et la distribution spectrale d’énergie des rayonnements à comparer, toutes les difficultés théoriques et pratiques de la photométrie hétérochrome peuvent se présenter."
                            },
                            {
                                "example_id": "6c20c8dd-1f7e-46ed-84e3-157685e55816",
                                "sense_id": "0f075ca4-6720-37fd-b2b1-e5be51c111cf",
                                "text": "Les sulfures (COS, mono- et disulfures de méthyle et d'éthyle) sont analysés selon l’EPA par GC et détection par photométrie de flamme, après piégeage sur Tenax GC et élimination en amont du SO₂ par un piège alcalin."
                            }
                        ]
                    }
