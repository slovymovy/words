                "senses": [
                    {
                        "sense_id": "ac609ff8-646c-3f90-a4e8-66dd23756230",
                        "entry_id": "705d955b-c9bf-39ac-bf44-42ccd48ec7aa",
                        "glosses": [
                            "podłużna, niska, obita ławeczka bez oparcia"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c40e8de-f82d-4def-b586-fc200cb11f59",
                                "sense_id": "ac609ff8-646c-3f90-a4e8-66dd23756230",
                                "text": "Na muzealnej bankietce przysiadł ostatni żyjący członek rządu Polski Podziemnej Adam Bień"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a5e3b837-01c5-4f8e-a7b5-16bcb9c97af2",
                        "source_entry_id": "705d955b-c9bf-39ac-bf44-42ccd48ec7aa",
                        "source_sense_id": "ac609ff8-646c-3f90-a4e8-66dd23756230",
                        "target_lang_word": "banquette",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "banquette",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cd6c4b84-b2da-3b6d-b659-7352415dabe5",
                                        "entry_id": "672223fb-a9d5-309c-99cc-0534df0a27b2",
                                        "glosses": [
                                            "A narrow area behind a defensive wall's parapet elevated above its terreplein and used by defenders to shoot at attackers."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3ab4c70e-2e1b-37f0-bddf-c0a610d17cc4",
                                        "entry_id": "672223fb-a9d5-309c-99cc-0534df0a27b2",
                                        "glosses": [
                                            "A bench built into a wall, especially (military) one built into a wall of a defensive trench, used for sitting and for shooting at attackers."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f1a2871b-7eac-30cd-a4f6-2acae10a2be0",
                                        "entry_id": "672223fb-a9d5-309c-99cc-0534df0a27b2",
                                        "glosses": [
                                            "An upholstered bench, e.g., along a wall of a restaurant or lounge area."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42cf3388-caa4-464b-a334-891e2879431e",
                                                "sense_id": "f1a2871b-7eac-30cd-a4f6-2acae10a2be0",
                                                "text": "Stoned, she would traipse in, overtly sexual in last night's dress, and throw herself exhausted across the banquette."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77d9cb94-e379-3b8a-8ead-86f048bece66",
                                        "entry_id": "672223fb-a9d5-309c-99cc-0534df0a27b2",
                                        "glosses": [
                                            "A bench or similar seat on top of a diligence or other public vehicle."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39ca0a8b-31e9-4d2d-8dfb-46cd64782c3b",
                                                "sense_id": "77d9cb94-e379-3b8a-8ead-86f048bece66",
                                                "text": "My brother-in-law […] took refuge in the banquette."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a068d4f-1b68-394f-a067-3ebd6bcf8cf3",
                                        "entry_id": "672223fb-a9d5-309c-99cc-0534df0a27b2",
                                        "glosses": [
                                            "A sidewalk."
                                        ],
                                        "tags": [
                                            "Louisiana",
                                            "Texas"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d10b647-2bca-4752-9f4f-14cb0d980c9f",
                                                "sense_id": "1a068d4f-1b68-394f-a067-3ebd6bcf8cf3",
                                                "text": "The boys were dragging along the banquette a small “express wagon,” which they had filled with blocks and sticks."
                                            },
                                            {
                                                "example_id": "2a1cd5d0-2412-4175-84e9-3b8546269bda",
                                                "sense_id": "1a068d4f-1b68-394f-a067-3ebd6bcf8cf3",
                                                "text": "“Get the hell away from that stove, Charmaine, and go play out on the banquette before I bust you right in the mouth.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ead7d19e-85c0-4e89-84b6-2dc8feb61f28",
                        "source_entry_id": "705d955b-c9bf-39ac-bf44-42ccd48ec7aa",
                        "source_sense_id": "ac609ff8-646c-3f90-a4e8-66dd23756230",
                        "target_lang_word": "banquette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "banquette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "911d0fc4-b82c-3a82-b11b-248673da1205",
                                        "entry_id": "706b7184-95db-3c2d-961f-e9ba6f795b35",
                                        "glosses": [
                                            "Sorte de banc rembourré, sans dossier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82111356-4ec1-406a-a3b0-788df1d265ae",
                                                "sense_id": "911d0fc4-b82c-3a82-b11b-248673da1205",
                                                "text": "Il siégeait, au fond, sur une banquette, et fumait un cigare."
                                            },
                                            {
                                                "example_id": "bbd3fd88-8fd7-4722-8126-d6aa10c45cda",
                                                "sense_id": "911d0fc4-b82c-3a82-b11b-248673da1205",
                                                "text": "Apparemment conçu pour que personne ne s’y attarde, sauf les chauffeurs-gardes du corps venus déposer et attendre leurs ministres qui assistent au Conseil ou à diverses autres réunions, ce hall ne comporte aucun véritable endroit pour s’asseoir, à l’exception de deux longues banquettes de bois peu invitantes et sur lesquelles traînent invariablement colis et enveloppes en attente d’un messager ou d'un taxi."
                                            },
                                            {
                                                "example_id": "184a4054-3c56-4e04-8202-7f51af960e7c",
                                                "sense_id": "911d0fc4-b82c-3a82-b11b-248673da1205",
                                                "text": "Les banquettes de velours noir sont disposées, comme au hasard, suivant les méandres d’un dédale de murettes : on peut, se soulevant sur une banquette, dominer l’autre."
                                            },
                                            {
                                                "example_id": "ee213f60-eebc-4d5d-bf59-ac08b742baae",
                                                "sense_id": "911d0fc4-b82c-3a82-b11b-248673da1205",
                                                "text": "Vous vous sentirez des âmes de dandy en montant le superbe escalier Napoléon III qui mène vers le lounge proprement dit, appelé le Salon Rouge en référence à la couleur des banquettes aux formes origamiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1f4eaea-1f75-392a-8bf6-a8307cdf3020",
                                        "entry_id": "706b7184-95db-3c2d-961f-e9ba6f795b35",
                                        "glosses": [
                                            "Banc ou siège rembourré à dossier dans une automobile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "990c8c42-325c-4f16-8cb4-520f76dea200",
                                                "sense_id": "b1f4eaea-1f75-392a-8bf6-a8307cdf3020",
                                                "text": "Il décollait ses fesses de la banquette, poitrine collée au volant, nez contre le pare-brise, dans la position du jockey à l’entrée de la ligne droite, aveuglé par l’éblouissement de la lumière."
                                            },
                                            {
                                                "example_id": "a0046820-85b8-4f14-a178-32e3f581e7bc",
                                                "sense_id": "b1f4eaea-1f75-392a-8bf6-a8307cdf3020",
                                                "text": "Au moment où il s'assied au volant de sa vieille Peugeot garée près de l'Opéra, à Paris, une jeune femme s’engouffre sur la banquette arrière, donne une adresse à Neuilly, qui n'est pas la porte à côté ; il essaie de discuter."
                                            },
                                            {
                                                "example_id": "b96118fa-6a27-4b42-a05c-f7f3d28d43d6",
                                                "sense_id": "b1f4eaea-1f75-392a-8bf6-a8307cdf3020",
                                                "text": "La sociologie américaine nous vient d'un monde où les jeunes, avant même l'invention de la pilule, avaient le droit de s'envoyer en l’air sur les banquettes arrière des voitures. Ils ne le faisaient cependant qu'en vitesse et avec un appel immodéré à la fellation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9de08ca1-ca0c-3eeb-8f0e-36b42dc0d8fc",
                                        "entry_id": "706b7184-95db-3c2d-961f-e9ba6f795b35",
                                        "glosses": [
                                            "Place d’impériale sur certaines voitures publiques."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b9f1e21d-2fdb-3572-b0e1-2412539d4590",
                                        "entry_id": "706b7184-95db-3c2d-961f-e9ba6f795b35",
                                        "glosses": [
                                            "Petite élévation ou large degré de pierre, de terre ou de gazon, sur lequel on monte pour tirer par-dessus le parapet d’un bastion ou le revers d’une tranchée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56083747-54be-46ce-83b5-cec94078b1c2",
                                                "sense_id": "b9f1e21d-2fdb-3572-b0e1-2412539d4590",
                                                "text": "Derrière ces abattis, j’élève un parapet avec une banquette & un fossé en avant. Je place, derrière ce parapet, des compagnies de Chasseurs & l’Infanterie des Troupes Légères."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d41e3e65-159d-3bb0-a287-54684bc52c85",
                                        "entry_id": "706b7184-95db-3c2d-961f-e9ba6f795b35",
                                        "glosses": [
                                            "Petit chemin pour les piétons, élevé de quelques centimètres au-dessus de la voie où passent les voitures."
                                        ],
                                        "tags": [
                                            "Urbanisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "534979f4-543c-4b51-b203-8bc188e79ae6",
                                                "sense_id": "d41e3e65-159d-3bb0-a287-54684bc52c85",
                                                "text": "La traction-avant file à près de cent sur la route de Malesherbes entre deux rangées d'arbres plantées sur des banquettes transformées en brosse par le gel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55cf16ff-2047-368c-99af-be8bdd0b065f",
                                        "entry_id": "706b7184-95db-3c2d-961f-e9ba6f795b35",
                                        "glosses": [
                                            "Chemin d’une certaine largeur ménagé à l’intérieur d’un aqueduc et d’un égout, et sur lequel on peut marcher, pour le nettoyer ou le réparer."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "27c4e832-6f74-3089-b5aa-6f4084b59a1d",
                                        "entry_id": "706b7184-95db-3c2d-961f-e9ba6f795b35",
                                        "glosses": [
                                            "Appui d’une fenêtre, lorsqu’il ne s’élève qu’à hauteur de siège et qu’il est surmonté d’un appui de fer."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f580f661-c052-3ea5-b115-7c112f93e7f6",
                                        "entry_id": "706b7184-95db-3c2d-961f-e9ba6f795b35",
                                        "glosses": [
                                            "Palissade taillée à hauteur d’appui, entre les arbres d’une contre-allée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "340b1104-99c9-4b59-9d86-15148e987f59",
                                                "sense_id": "f580f661-c052-3ea5-b115-7c112f93e7f6",
                                                "text": "Je m’asseyais, je m’en souviens, sur de hauts buis taillés en banquettes qui garnissaient le bord des allées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5cb34a22-e950-3317-90c9-af06ca595490",
                                        "entry_id": "706b7184-95db-3c2d-961f-e9ba6f795b35",
                                        "glosses": [
                                            "Trottoir."
                                        ],
                                        "tags": [
                                            "Louisiane"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "167d17e4-7b1d-3803-9cf2-b351768c950c",
                                        "entry_id": "706b7184-95db-3c2d-961f-e9ba6f795b35",
                                        "glosses": [
                                            "Partie semi-arbustive du schorre formée de plantes ligneuses."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "50c80412-5b17-35bc-839e-ce8e55bebb4b",
                                        "entry_id": "706b7184-95db-3c2d-961f-e9ba6f795b35",
                                        "glosses": [
                                            "Bande, lisière géologique étroite immédiatement adjacente à un cours d'eau ou une étendue d'eau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0db0add1-7c30-48fd-a05e-3669711dcac2",
                                                "sense_id": "50c80412-5b17-35bc-839e-ce8e55bebb4b",
                                                "text": "La présence des espèces de haut de berge sur les bas de berge (sans augmentation spécifique) observée sur la Jouanne s’expliquent par le fait que la végétalisation des sédiments ou des banquettes minérales exondés est corrélée à la banque de graines et ainsi qu’à la présence des formations végétales alentours qui fructifient abondement avec le stress hydrique généré par l’abaissement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3bf7f3a6-4e3e-3067-8d18-9322f344b3d5",
                                        "entry_id": "706b7184-95db-3c2d-961f-e9ba6f795b35",
                                        "glosses": [
                                            "Bordure surélevée délimitant la piste d’un cirque. Désigne traditionnellement l'un ou l'ensemble des éléments constitutifs en bois, structurés en arc de cercle, peints en blanc, recouverts de velours rouge et hauts de 40 centimètres environ."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6e11d2b-96a9-4488-8e68-7ec71d253cef",
                                                "sense_id": "3bf7f3a6-4e3e-3067-8d18-9322f344b3d5",
                                                "text": "Un cirque, c'est une piste circulaire de treize mètres de diamètre, entourée de banquettes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7be487e5-d089-334d-8e68-b9ec8bf699df",
                                        "entry_id": "706b7184-95db-3c2d-961f-e9ba6f795b35",
                                        "glosses": [
                                            "Discipline acrobatique consistant pour des porteurs au sol à recevoir et à projeter en l’air un voltigeur, à l’aide de leurs mains entrecroisées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2bbbdb4-a472-46a9-a711-f581f6a787f2",
                                                "sense_id": "7be487e5-d089-334d-8e68-b9ec8bf699df",
                                                "text": "Un saut de banquette."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66320458-c149-3aa5-b3aa-ac222f0b36f4",
                                        "entry_id": "706b7184-95db-3c2d-961f-e9ba6f795b35",
                                        "glosses": [
                                            "Dispositif aménagé sous un pont pour le passage de la faune sauvage (loutres, castors…)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5f27097-1b33-468e-8d3b-255352e1b14f",
                                                "sense_id": "66320458-c149-3aa5-b3aa-ac222f0b36f4",
                                                "text": "On voit apparaître une diversité de dispositifs. Des écoponts, des écoducs, des tunnels, des ponts aériens, des banquettes sous les ouvrages pour les loutres et castors, des échelles de corde pour les écureuils…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc9e1d58-216a-3dd9-b072-1ae3d0c5fa31",
                                        "entry_id": "706b7184-95db-3c2d-961f-e9ba6f795b35",
                                        "glosses": [
                                            "Bordure des voies pavées en terre battue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "453df126-a67d-4658-9b33-5eb3cd261f3a",
                                                "sense_id": "fc9e1d58-216a-3dd9-b072-1ae3d0c5fa31",
                                                "text": "Je suis très mal placé pour dire qu’il faut rester sur le haut du pavé car sur les six Roubaix que j’ai faits, je n’ai crevé qu’une seule fois et j’étais un utilisateur quasi permanent de la banquette (bas-côté)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
