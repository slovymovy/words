                                "sense_id": "d0b9ea9f-6352-3efb-80d1-347e1da77425",
                                "text": "Im Salon hing eine Jagdszene."
                            },
                            {
                                "example_id": "85c0a6d6-173f-4905-b5bc-f16bed8f8afa",
                                "sense_id": "d0b9ea9f-6352-3efb-80d1-347e1da77425",
                                "text": "„Ein Relief auf einer der Stelen zeigt eine Jagdszene.“"
                            }
                        ],
