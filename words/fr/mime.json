                    "frequency": "Middle",
                    "semantic_group_id": "theatre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle pratique le <w>mime</w> depuis plusieurs années avec beaucoup de passion."
                        },
                        {
                            "text": "Le festival célèbre l'art du <w>mime</w> à travers des spectacles visuels."
                        }
                    ],
                    "common_phrases": [
