                ],
                "senses": [
                    {
                        "sense_id": "d4983040-d962-39de-ad51-2267161ce886",
                        "entry_id": "dca7d1c4-0d95-329e-b5bd-31a534922844",
                        "glosses": [
                            "Qui imagine aisément, qui a une grande fertilité d’imagination."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9736ad20-dbab-4280-9c57-31355ae97ba4",
                                "sense_id": "d4983040-d962-39de-ad51-2267161ce886",
                                "text": "Avoir l’esprit imaginatif."
                            },
                            {
                                "example_id": "e78b088d-3bb0-4833-987f-3bd0c7a190f8",
                                "sense_id": "d4983040-d962-39de-ad51-2267161ce886",
                                "text": "Mémoire imaginative."
                            },
                            {
                                "example_id": "a2556517-0421-48d1-b742-d5d71160157f",
                                "sense_id": "d4983040-d962-39de-ad51-2267161ce886",
                                "text": "La faculté, la puissance imaginative."
                            },
                            {
                                "example_id": "38b03cc1-cd84-4217-9843-103ba1fba6d9",
                                "sense_id": "d4983040-d962-39de-ad51-2267161ce886",
                                "text": "— Il n’a pas assez d’éloges pour ton zèle. Il te trouve seulement un peu exalté, un peu imaginatif…"
                            },
                            {
                                "example_id": "360f9670-8848-4e3a-8a2c-65a82f35366c",
                                "sense_id": "d4983040-d962-39de-ad51-2267161ce886",
                                "text": "Dans le souvenir de la nuit, la marche hallucinante vers la Cité, l’homme-chien aux imaginatives prosopopées, l’arrivée sous le péristyle ; devant les bustes de Desault et de Bichat, l’accueil de l’interne : — pour les femmes en couche, c’est à Port-Royal."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cd431b13-5c80-49a0-881b-a9a57fa8f255",
                        "source_entry_id": "dca7d1c4-0d95-329e-b5bd-31a534922844",
                        "source_sense_id": "d4983040-d962-39de-ad51-2267161ce886",
