                "senses": [
                    {
                        "sense_id": "ee835605-3abc-3fa2-99f1-8eb3dfed7fc2",
                        "entry_id": "bad6cfb1-8053-3a2a-9ca2-5699bb24e1f0",
                        "glosses": [
                            "Couple qui s'est rencontré en ligne, généralement via une application de rencontre, ce qui reflète une manière contemporaine de nouer des relations amoureuses dans un contexte numérique."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "8ea2abc5-d137-4cc6-b3a1-551603bf4a0e",
                                "sense_id": "ee835605-3abc-3fa2-99f1-8eb3dfed7fc2",
                                "text": "Parmi les autres tendances “love” qui marqueront la jeune génération, on retrouve le swouple era. Le principe ? Assumer à 100 % que l’on s’est rencontré en ligne, via une application."
                            },
                            {
                                "example_id": "ee1ddb67-ec86-4e2a-b78c-5800b0497fd2",
                                "sense_id": "ee835605-3abc-3fa2-99f1-8eb3dfed7fc2",
                                "text": "Leur histoire a commencé par un simple swipe à droite, aujourd’hui ils forment un swouple qui partage son quotidien sur Instagram."
                            },
                            {
                                "example_id": "82031ab3-75c7-493f-87d5-088238c57261",
                                "sense_id": "ee835605-3abc-3fa2-99f1-8eb3dfed7fc2",
                                "text": "« Désormais, vous ne devrez plus dire ‘nous nous sommes rencontrés sur une application de rencontre’, mais vous pourrez simplement dire ‘nous sommes un swouple et fiers de l’être’ ! », indique l’application Fruitz qui est à l’origine de ce nouveau terme."
                            }
                        ]
                    }
