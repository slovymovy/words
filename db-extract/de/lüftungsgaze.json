                "senses": [
                    {
                        "sense_id": "bc8bd31a-f2e1-3874-a06c-83f1fb0f6ca3",
                        "entry_id": "f2ad58cc-fd4e-354b-b62d-de329cfd9695",
                        "glosses": [
                            "ein lockeres, durchsichtiges Gewebe, durch welches (im aufgespannten Zustand) die Luft frei strömen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "caaed2fd-03d9-45b5-a7d9-7f0b69e1f147",
                                "sense_id": "bc8bd31a-f2e1-3874-a06c-83f1fb0f6ca3",
                                "text": "„Der Kasten sollte vier bis fünf Waben aufnehmen können und von unten mit einer Lüftungsgaze versehen sein.“"
                            },
                            {
                                "example_id": "677279a2-ac97-4789-b9c6-03acc36ed8d9",
                                "sense_id": "bc8bd31a-f2e1-3874-a06c-83f1fb0f6ca3",
                                "text": "„Anschließend habe ich selbst weitere vier Terrarien gebaut, die vorne eine senkrechte Lüftungsgaze unterhalb der zweiteiligen Schiebescheibe haben.“"
                            },
                            {
                                "example_id": "84403269-e729-4f33-a86e-e083300f7e9f",
                                "sense_id": "bc8bd31a-f2e1-3874-a06c-83f1fb0f6ca3",
                                "text": "„Daher sollte ein Aufzuchtbecken nicht nur Drosophila-dichte Lüftungsgaze sondern auch so gut wie keinen Scheibenzwischenraum aufweisen.“"
                            },
                            {
                                "example_id": "1203a06d-98be-48d2-bb3b-68ee35df3e4d",
                                "sense_id": "bc8bd31a-f2e1-3874-a06c-83f1fb0f6ca3",
                                "text": "„Links im Bild erkennt man unter der vorderen Lüftungsgaze ein weiteres Heizkabel, dass zusammen mit einem PC Lüfter, der auf der oberen Entlüftungsgaze liegt, drei mal am Tag zeitgesteuert eingeschaltet wird.“"
                            },
                            {
                                "example_id": "ab66d994-5c69-40a5-8b45-2e1a314bf7d9",
                                "sense_id": "bc8bd31a-f2e1-3874-a06c-83f1fb0f6ca3",
                                "text": "„Ein raffinierter Druck findet sich auf allen Lüftungsgazen wieder.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
