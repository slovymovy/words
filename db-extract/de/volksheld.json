                "senses": [
                    {
                        "sense_id": "e4bf86a8-23c0-3ce2-8a84-d558ba43cd78",
                        "entry_id": "ef8ec768-2c87-37f3-b335-83ebd2e7e7ed",
                        "glosses": [
                            "Person, die für ihre besonderen Verdienste vom Volk als Held verehrt und anerkannt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59e56f06-1628-4c68-8ffc-cc9a037110ce",
                                "sense_id": "e4bf86a8-23c0-3ce2-8a84-d558ba43cd78",
                                "text": "„Der Boxer Manny Pacquiao ist auf den Philippinen ein Volksheld und in den Vereinigten Staaten eine Attraktion.“"
                            },
                            {
                                "example_id": "fdca8689-2544-4a85-a68b-8c2cae8df6f2",
                                "sense_id": "e4bf86a8-23c0-3ce2-8a84-d558ba43cd78",
                                "text": "„Vor der Kulturrevolution wurde Liu in Pingxiang wie im ganzen Land als Volksheld verehrt.“"
                            },
                            {
                                "example_id": "60983ec8-c960-4f62-ba1e-120bd1109190",
                                "sense_id": "e4bf86a8-23c0-3ce2-8a84-d558ba43cd78",
                                "text": "„Erst die Entscheidung des Parlamentes, auch dem Volkshelden Garibaldi nach dessen Tod 1882 ein Nationaldenkmal zu bauen, treibt die Diskussion um das Vittorziano wieder an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
