{
    "word_family": [
        "schelms",
        "schelmerij"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b47bd506-b059-3891-bdfd-d0d839a4a016",
                    "sense_definition": "iemand die onbetrouwbaar of slecht is",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "schurk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die <w>schelm</w> heeft iedereen in het dorp opgelicht.",
                            "target_lang_translations": {
                                "fr": "Ce <w>fripon</w> a escroqué tout le monde dans le village."
                            }
                        },
                        {
                            "text": "Hij gedroeg zich als een echte <w>schelm</w> tijdens de onderhandelingen.",
                            "target_lang_translations": {
                                "fr": "Il s'est comporté comme un vrai <w>coquin</w> pendant les négociations."
                            }
                        }
                    ],
                    "synonyms": [
                        "schurk",
                        "bedrieger"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "wordt tegenwoordig minder vaak gebruikt"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Personne malhonnête ou peu fiable."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "fripon",
                                "target_lang_sense_clarification": "Personne qui agit de manière malhonnête ou rusée."
                            },
                            {
                                "target_lang_word": "coquin",
                                "target_lang_sense_clarification": "Individu sans scrupules ou malveillant."
                            },
                            {
                                "target_lang_word": "scélérat",
                                "target_lang_sense_clarification": "Personne capable de commettre des actes criminels ou très mauvais."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c1d94ab8-c872-350b-b384-6544373f2101",
                    "sense_definition": "een ondeugend persoon, vaak een kind",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ondeugend",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kijk die kleine <w>schelm</w> eens lachen met zijn snoet vol chocolade.",
                            "target_lang_translations": {
                                "fr": "Regarde ce <w>petit diable</w> rire avec son museau plein de chocolat."
                            }
                        },
                        {
                            "text": "Het is een echte <w>schelm</w> die altijd kattenkwaad uithaalt.",
                            "target_lang_translations": {
                                "fr": "C'est un vrai <w>polisson</w> qui fait toujours des bêtises."
                            }
                        }
                    ],
                    "synonyms": [
                        "deugniet",
                        "rakker"
                    ],
                    "common_phrases": [
                        "kleine schelm"
                    ],
                    "target_lang_definitions": {
                        "fr": "Personne espiègle, souvent un enfant."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "petit diable",
                                "target_lang_sense_clarification": "Enfant plein d'énergie et un peu turbulent."
                            },
                            {
                                "target_lang_word": "espiègle",
                                "target_lang_sense_clarification": "Qui aime faire des farces avec malice."
                            },
                            {
                                "target_lang_word": "polisson",
                                "target_lang_sense_clarification": "Enfant qui fait des bêtises sans méchanceté."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4255ab1d-5c62-3b5d-b2cc-2907fc2dbe24",
                    "sense_definition": "iemand die op avontuur uitgaat, vaak met een dubieuze moraal",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "avonturier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>schelm</w> trok door het land op zoek naar rijkdom en gevaar.",
                            "target_lang_translations": {
                                "fr": "L'<w>aventurier</w> parcourait le pays en quête de richesse et de danger."
                            }
                        },
                        {
                            "text": "In oude verhalen is de <w>schelm</w> vaak een charmante avonturier.",
                            "target_lang_translations": {
                                "fr": "Dans les vieux récits, le <w>personnage picaresque</w> est souvent un aventurier charmant."
                            }
                        }
                    ],
                    "synonyms": [
                        "avonturier"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "vooral in literaire context"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Personnage littéraire aventureux, souvent doté d'une morale douteuse."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "aventurier",
                                "target_lang_sense_clarification": "Personne en quête d'aventures, souvent en marge de la loi."
                            },
                            {
                                "target_lang_word": "picaresque",
                                "target_lang_sense_clarification": "Relatif au genre littéraire du roman de mœurs mettant en scène un héros rusé."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "136f014a-02a3-3e3f-93ea-5b8b28e8660b",
                    "sense_definition": "een gehucht in Deurne, Noord-Brabant",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "locatie",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "Het kleine gehucht <w>Schelm</w> ligt in de gemeente Deurne.",
                            "target_lang_translations": {
                                "fr": "Le petit hameau de Schelm se situe dans la commune de Deurne."
                            }
                        },
                        {
                            "text": "Vroeger was <w>Schelm</w> een bekende plek voor lokale boeren.",
                            "target_lang_translations": {
                                "fr": "Autrefois, Schelm était un lieu connu des fermiers locaux."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "specifiek voor Noord-Brabant"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Un hameau situé à Deurne, dans le Brabant-Septentrional."
                    },
                    "translations": {
                        "fr": []
                    }
                }
            ]
        }
    ]
