                        "examples": [
                            {
                                "example_id": "aa077039-d72e-486d-a6b3-385810cb3d43",
                                "sense_id": "9bdd4162-e580-3c53-926f-dd9590980628",
                                "text": "Het is weer de tweeënveertig die het niet doet, kunnen we die niet simpel vervangen?"
                            },
                            {
                                "example_id": "de2014ab-262f-4991-a727-79004b0697a9",
                                "sense_id": "9bdd4162-e580-3c53-926f-dd9590980628",
                                "text": "Haar drieënveertigste verjaardag was een belangrijk moment, want haar leven werd heel anders toen ze de tweeënveertig eenmaal voorbij was."
                            }
                        ]
                    },
                    {
                        "sense_id": "26cb76ae-4152-3caa-93da-9bd7082b845a",
                        "entry_id": "01c4709f-f95e-39ef-a2eb-4adc6d75b013",
                        "glosses": [
