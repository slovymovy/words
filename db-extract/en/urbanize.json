                        "examples": [
                            {
                                "example_id": "a0b9b52a-4038-456f-99d8-9f92c393c017",
                                "sense_id": "b6549559-f606-3620-b557-e9261f9cfacb",
                                "text": "The coastal zone has been urbanized over the past twenty years.",
                                "translation": "Η παραλιακή ζώνη αστικοποιήθηκε τα τελευταία είκοσι χρόνια."
                            },
                            {
                                "example_id": "00206024-44c6-4462-a488-318c3e6b2570",
                                "sense_id": "b6549559-f606-3620-b557-e9261f9cfacb",
                                "text": "Πολλές μικρές κοινότητες αστικοποιούνται λόγω του τουρισμού.",
                                "translation": "Many small communities are being urbanized due to tourism."
                            },
                            {
                                "example_id": "b5e6c2ce-13ac-4a68-a2b5-764c40f8522e",
                                "sense_id": "b6549559-f606-3620-b557-e9261f9cfacb",
                                "text": "The government is trying to urbanize rural areas.",
                                "translation": "Η κυβέρνηση προσπαθεί να αστικοποιήσει τις αγροτικές περιοχές."
                            }
                        ]
                    }
