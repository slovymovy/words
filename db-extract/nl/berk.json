                    {
                        "sense_id": "13388e67-4e71-3dec-9968-327b2296ae09",
                        "entry_id": "65c5c0c6-196a-3398-bcd8-b3d36995e7e5",
                        "glosses": [
                            "geslacht Betula van katjes dragende loofbomen of struiken, kenmerkend is het in horizontale banden afschilferende schors"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89ed0f68-2138-4345-92d8-972540726fde",
                                "sense_id": "13388e67-4e71-3dec-9968-327b2296ae09",
                                "text": "Een berk is een soort boom die veel voorkomt in Nederland."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9caf353e-6177-4348-883e-c69e01ba4feb",
                        "source_entry_id": "65c5c0c6-196a-3398-bcd8-b3d36995e7e5",
                        "source_sense_id": "13388e67-4e71-3dec-9968-327b2296ae09",
                        "source_sense_description": "een katjes dragende loofboom met witte bast",
                        "target_lang_word": "Birke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Birke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "253693e3-df64-3f92-89ad-b253466b4320",
                                        "entry_id": "35615600-6124-3d39-9ec5-192610bab3f5",
                                        "glosses": [
                                            "Vertreter der Gattung Betula"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9f41e1c-56b8-4666-8873-77263245d28a",
                                                "sense_id": "253693e3-df64-3f92-89ad-b253466b4320",
                                                "text": "Vor der Villa stand eine Gruppe von Birken."
                                            },
                                            {
                                                "example_id": "97c7ed5e-c4d5-41a4-9601-74d1d3ba766b",
                                                "sense_id": "253693e3-df64-3f92-89ad-b253466b4320",
                                                "text": "„An einigen Stellen war die Gegend völlig nackt, an anderen mit einzelnen Fichten und Birken bewachsen.“"
                                            },
                                            {
                                                "example_id": "00fd82cc-c7cc-45b2-bf27-871dfebcb75d",
                                                "sense_id": "253693e3-df64-3f92-89ad-b253466b4320",
                                                "text": "„Er musste in der Birke sitzen, die fünf Schritte hinter dem Unterstand vor schwarzen Fichten stand.“"
                                            },
                                            {
                                                "example_id": "ee8605a5-2615-43b1-b6ef-93d8518c2ef1",
                                                "sense_id": "253693e3-df64-3f92-89ad-b253466b4320",
                                                "text": "„Die mit klebrigen grünen Blättchen ganz übersäten Birken standen regungslos da; aus dem vorjährigen Laube am Boden kamen, das welke Laub in die Höhe hebend, violette Blüten und junges grünes Gras hervor.“"
                                            },
                                            {
                                                "example_id": "cdfd4997-5b1f-4909-b9d7-ac4b3392167f",
                                                "sense_id": "253693e3-df64-3f92-89ad-b253466b4320",
                                                "text": "„Zwischen Birken und Edeltannen hin schlängelte sich der Weg und führte bis an eine künstliche, von Moos und Efeu überwachsene Felswand, in deren Front (der alte Köckritz war jetzt zurückgeblieben) der König auf einer Steinbank saß.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0a2c167e-9608-35eb-a553-9cbdf63f8439",
                                        "entry_id": "35615600-6124-3d39-9ec5-192610bab3f5",
                                        "glosses": [
                                            "Holz von ^([1])"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aff75faa-f3d6-4de5-a17b-b521b5eed8a5",
                                                "sense_id": "0a2c167e-9608-35eb-a553-9cbdf63f8439",
                                                "text": "Der Schreiner baut einen Tisch aus Birke."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Birke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0022ed99-022e-3143-8529-07329436b948",
                                        "entry_id": "8441b429-9a04-36ec-b8d2-44998a752ba9",
                                        "glosses": [
                                            "Familienname, Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d03d8448-961e-4915-8172-4279c4b92f05",
                                                "sense_id": "0022ed99-022e-3143-8529-07329436b948",
                                                "text": "Frau Birke ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "0791ddf9-f51c-4810-bb6b-f5a37e921d6d",
                                                "sense_id": "0022ed99-022e-3143-8529-07329436b948",
                                                "text": "Herr Birke wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "a284c73a-f205-48c2-b28d-b43a544792a4",
                                                "sense_id": "0022ed99-022e-3143-8529-07329436b948",
                                                "text": "Die Birkes fliegen heute nach Paris."
                                            },
                                            {
                                                "example_id": "d0bb7c80-d468-41c6-bb37-ef665cec224f",
                                                "sense_id": "0022ed99-022e-3143-8529-07329436b948",
                                                "text": "Der Birke trägt nie die Pullover, die die Birke ihm strickt."
                                            },
                                            {
                                                "example_id": "b910dcfe-5523-462b-925f-a6164592a439",
                                                "sense_id": "0022ed99-022e-3143-8529-07329436b948",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Birke kommt, geht der Herr Birke.“"
                                            },
                                            {
                                                "example_id": "cf5ddbfc-81f2-4bdf-8d58-7925c680bcc5",
                                                "sense_id": "0022ed99-022e-3143-8529-07329436b948",
                                                "text": "Birke kommt und geht."
                                            },
                                            {
                                                "example_id": "de26a17c-e61c-451b-9c1f-8e5f7216e03b",
                                                "sense_id": "0022ed99-022e-3143-8529-07329436b948",
                                                "text": "Birkes kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
