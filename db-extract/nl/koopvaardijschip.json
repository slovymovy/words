                "senses": [
                    {
                        "sense_id": "f9c056ed-a0e2-36b8-bd57-b23eb1b52cb8",
                        "entry_id": "55cf6b64-f43e-3c9f-bf13-36f462c3e73e",
                        "glosses": [
                            "zeeschip voor het vervoer van handelsgoederen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94482198-8bd3-49ee-a100-48c0e29d611a",
                                "sense_id": "f9c056ed-a0e2-36b8-bd57-b23eb1b52cb8",
                                "text": "Zeker twaalf en mogelijk veertig bootvluchtelingen zijn woensdag omgekomen net buiten de kust van Libië. De rubberboot waarmee zij naar Italië waren vertrokken, begon water te maken. Een koopvaardijschip en het Duitse marineschip Schleswig-Holstein schoten te hulp. Wat er toen precies is gebeurd, is nog onduidelijk, maar een aantal bootvluchtelingen kwam in het water terecht."
                            },
                            {
                                "example_id": "6a5b0754-f31c-46bb-acc1-0811e48b6606",
                                "sense_id": "f9c056ed-a0e2-36b8-bd57-b23eb1b52cb8",
                                "text": "Piraten hebben in de Golf van Aden voor de noordkust van Somalië maandag een olietanker gekaapt met acht Srilankaanse zeelieden aan boord. Ze eisen losgeld voor de bemanning. Het is de eerste kaping van een buitenlands koopvaardijschip in Somalische wateren sinds 2012."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "837b1901-b2dd-478d-80a8-f22f0e8eb415",
                        "source_entry_id": "55cf6b64-f43e-3c9f-bf13-36f462c3e73e",
                        "source_sense_id": "f9c056ed-a0e2-36b8-bd57-b23eb1b52cb8",
                        "source_sense_description": "zeeschip voor het vervoer van handelsgoederen",
                        "target_lang_word": "Handelsschiff",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Handelsschiff",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "50b3e5e0-d63a-3760-aea4-23729dae6963",
                                        "entry_id": "bad0313f-6b41-3f75-b38d-fed488532c8a",
                                        "glosses": [
                                            "Schiff, mit dem Handelswaren, Güter transportiert werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe2e4fba-2cac-4cf7-9ad1-ab62edf3ec5f",
                                                "sense_id": "50b3e5e0-d63a-3760-aea4-23729dae6963",
                                                "text": "„Erst vor einigen Jahren wurden an den Wänden des Tezon Grande, einem mehr als hundert Meter langen Gebäude, Inschriften und Zeichnungen aus dem 16. Jahrhundert entdeckt: Einzigartige Dokumente über das Leben auf den Galeeren, das Wirken der Pestärzte und der Bastazzi – Beamte im Dienst der Dogen, die akribisch die Waren der Handelsschiffe kontrollierten.“"
                                            },
                                            {
                                                "example_id": "e5f5f3fc-f9c3-4d34-baf3-9a9762cb3af5",
                                                "sense_id": "50b3e5e0-d63a-3760-aea4-23729dae6963",
                                                "text": "Der Alltag auf See ist aber überhaupt nicht vergleichbar: Nicht nur, dass Kapitäne auf Handelsschiffen im Unterschied zu Kreuzfahrt-Kollegen gelegentlich wortkarge Zeitgenossen sind."
                                            },
                                            {
                                                "example_id": "52e0caae-bf79-472e-8908-b4a94b31daf8",
                                                "sense_id": "50b3e5e0-d63a-3760-aea4-23729dae6963",
                                                "text": "„Als er schon Maat auf einem Handelsschiff war, lachte man über sein Kauderwelsch;…“"
                                            },
                                            {
                                                "example_id": "54a683cb-8c3e-40e9-a8b5-cb69e46c9302",
                                                "sense_id": "50b3e5e0-d63a-3760-aea4-23729dae6963",
                                                "text": "„Wer als Kaufmann oder Siedler sein Glück in der Ferne sucht, wählt deshalb eine Knorr: ein massiv gebautes, breiteres Handelsschiff mit hochgezogener Bordwand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
