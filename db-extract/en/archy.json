                        "examples": [
                            {
                                "example_id": "6c4c2ed2-6982-4265-9e93-9a8566af501b",
                                "sense_id": "e9642410-d8cd-3951-9b14-9494d6fb2216",
                                "text": "\"Well, if it's beer you're after,\" said Archy, \"It's time we cut along and milked the old 'Cow.'\""
