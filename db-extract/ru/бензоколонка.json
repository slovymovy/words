                    {
                        "translation_id": "9570cc3b-db5c-4f5e-8155-eeb61f217b6f",
                        "source_entry_id": "faf9e80f-d134-3a11-9a63-f7e509e672a8",
                        "target_lang_word": "petrol pump",
