{
    "word_family": [
        "mower",
        "mowing"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ecf5f78c-2789-3f01-9d74-06111dd55f98",
                    "sense_definition": "To cut down grass or crops using a machine or tool.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "cutting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>mowed</w> the lawn every few weeks in the summer.",
                            "target_lang_translations": {
                                "ru": "Летом он <w>косил</w> газон каждые несколько недель."
                            }
                        },
                        {
                            "text": "It is time to <w>mow</w> the grass before it gets too long.",
                            "target_lang_translations": {
                                "ru": "Пора <w>косить</w> траву, пока она не стала слишком высокой."
                            }
                        }
                    ],
                    "synonyms": [
                        "trim",
                        "cut"
                    ],
                    "common_phrases": [
                        "mow the lawn"
                    ],
                    "target_lang_definitions": {
                        "ru": "Срезать траву или сельскохозяйственные культуры с помощью машины или инструмента."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "косить",
                                "target_lang_sense_clarification": "заниматься косьбой, срезать траву или злаки"
                            },
                            {
                                "target_lang_word": "скашивать",
                                "target_lang_sense_clarification": "срезать косой или косилкой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a5dd77eb-3efb-3bfe-81d9-d6fa0f80bfe7",
                    "sense_definition": "To kill or destroy a large number of people or things quickly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cutting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The machine gun <w>mowed</w> down the advancing soldiers.",
                            "target_lang_translations": {
                                "ru": "Пулемёт <w>косил</w> наступающих солдат."
                            }
                        },
                        {
                            "text": "The speeding car <w>mowed</w> down several pedestrians.",
                            "target_lang_translations": {
                                "ru": "Мчащаяся машина <w>скосила</w> нескольких пешеходов."
                            }
                        }
                    ],
                    "synonyms": [
                        "slaughter",
                        "massacre"
                    ],
                    "common_phrases": [
                        "mow down"
                    ],
                    "target_lang_definitions": {
                        "ru": "Массово уничтожать, убивать или выводить из строя большое количество людей или объектов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "косить",
                                "target_lang_sense_clarification": "переносное значение: массово губить или уничтожать"
                            },
                            {
                                "target_lang_word": "скосить",
                                "target_lang_sense_clarification": "переносное значение: убить, погубить"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e62d7484-e127-3204-90dc-489019be9942",
                    "sense_definition": "To make faces or grimaces to mock someone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mocking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children would <w>mow</w> and chatter at the stranger.",
                            "target_lang_translations": {
                                "ru": "Дети <w>гримасничали</w> и болтали, глядя на незнакомца."
                            }
                        },
                        {
                            "text": "He <w>mowed</w> at me with an ironical expression.",
                            "target_lang_translations": {
                                "ru": "Он <w>строил</w> мне <w>рожи</w> с ироничным выражением лица."
                            }
                        }
                    ],
                    "synonyms": [
                        "grimace",
                        "mock"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is largely historical or literary."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Корчить гримасы, чтобы подразнить или высмеять кого-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гримасничать",
                                "target_lang_sense_clarification": "делать гримасы, искажать выражение лица"
                            },
                            {
                                "target_lang_word": "строить рожи",
                                "target_lang_sense_clarification": "разговорное выражение: корчить гримасы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "30012e82-2bff-303d-aa1b-2118173816ef",
                    "sense_definition": "To store hay or grain in a barn or stack.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "storage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the harvest, the hay was <w>mowed</w> away in the loft for the winter.",
                            "target_lang_translations": {
                                "ru": "После уборки урожая сено <w>сложили</w> на сеновал на зиму."
                            }
                        },
                        {
                            "text": "They <w>mowed</w> the hay in the large barn.",
                            "target_lang_translations": {
                                "ru": "Они <w>скирдовали</w> сено в большом сарае."
                            }
                        }
                    ],
                    "synonyms": [
                        "stack",
                        "store"
                    ],
                    "target_lang_definitions": {
                        "ru": "Складывать сено или зерно в стога или скирды для хранения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стоговать",
                                "target_lang_sense_clarification": "складывать сено в стога"
                            },
                            {
                                "target_lang_word": "скирдовать",
                                "target_lang_sense_clarification": "складывать сено или солому в скирды"
                            },
                            {
                                "target_lang_word": "складывать",
                                "target_lang_sense_clarification": "сено: складывать на сеновал, в стог"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "172926c6-f26f-3e9c-b295-9de85ae51541",
                    "sense_definition": "The act of cutting grass or crops.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cutting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawn hasn't had a <w>mow</w> for a couple of months.",
                            "target_lang_translations": {
                                "ru": "Газон не <w>косили</w> уже пару месяцев."
                            }
                        },
                        {
                            "text": "Give the grass a quick <w>mow</w> this afternoon.",
                            "target_lang_translations": {
                                "ru": "Быстро <w>скоси</w> траву сегодня днём."
                            }
                        }
                    ],
                    "synonyms": [
                        "trim"
                    ],
                    "common_phrases": [
                        "give a mow"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс скашивания травы или сельскохозяйственных культур."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "косьба",
                                "target_lang_sense_clarification": "процесс срезания травы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "499dc96b-a5dc-3932-a2b2-9fe67c5ed798",
                    "sense_definition": "A stack of hay or the area in a barn where it is stored.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "storage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hay <w>mow</w> was filled to the ceiling.",
                            "target_lang_translations": {
                                "ru": "<w>Сеновал</w> был забит сеном до самого потолка."
                            }
                        },
                        {
                            "text": "They climbed up onto the <w>mow</w> to hide.",
                            "target_lang_translations": {
                                "ru": "Они забрались на <w>стог</w>, чтобы спрятаться."
                            }
                        }
                    ],
                    "synonyms": [
                        "haystack",
                        "barn"
                    ],
                    "target_lang_definitions": {
                        "ru": "Стог сена или место в сарае, где оно хранится."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стог",
                                "target_lang_sense_clarification": "большая куча сена или соломы"
                            },
                            {
                                "target_lang_word": "скирда",
                                "target_lang_sense_clarification": "продолговатая куча сена или соломы"
                            },
                            {
                                "target_lang_word": "сеновал",
                                "target_lang_sense_clarification": "помещение для хранения сена"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f0f09c88-c6a8-30e1-aa03-ce00cb84ff3f",
                    "sense_definition": "A scornful facial expression.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mocking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prisoners made <w>mows</w> at their guards.",
                            "target_lang_translations": {
                                "ru": "Заключённые <w>строили</w> <w>гримасы</w> своим охранникам."
                            }
                        },
                        {
                            "text": "He made a <w>mow</w> of disgust at the suggestion.",
                            "target_lang_translations": {
                                "ru": "Он <w>скривился</w> от отвращения при этом предложении."
                            }
                        }
                    ],
                    "synonyms": [
                        "grimace",
                        "sneer"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is largely historical or literary."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Насмешливое или пренебрежительное выражение лица."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гримаса",
                                "target_lang_sense_clarification": "искажение выражения лица"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3aa03748-d048-3b60-8bfd-c2ce980571e9",
                    "sense_definition": "A sweeping, scythe-like stroke in sports like cricket.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "cutting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He played a powerful <w>mow</w> over the midwicket boundary.",
                            "target_lang_translations": {
                                "ru": "Он нанёс мощный <w>размашистый удар</w> за пределы поля."
                            }
                        },
                        {
                            "text": "The batsman attempted a <w>mow</w> but missed the ball completely.",
                            "target_lang_translations": {
                                "ru": "Бэтсмен попытался нанести <w>размашистый удар</w>, но промахнулся по мячу."
                            }
                        }
                    ],
                    "synonyms": [
                        "swing",
                        "stroke"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мощный, размашистый удар в спорте (например, в крикете)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "размашистый удар",
                                "target_lang_sense_clarification": "в крикете"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "15021c9d-a2cf-3537-8756-cf1601308b9d",
                    "sense_definition": "A seagull.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A lone <w>mow</w> circled above the fishing boat.",
                            "target_lang_translations": {
                                "ru": "Одинокая <w>чайка</w> кружила над рыбацкой лодкой."
                            }
                        },
                        {
                            "text": "The cry of the <w>mow</w> echoed across the harbor.",
                            "target_lang_translations": {
                                "ru": "Крик <w>чайки</w> разносился по гавани."
                            }
                        }
                    ],
                    "synonyms": [
                        "gull",
                        "seagull"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Regional or archaic term for a gull."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Морская птица (чайка)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чайка",
                                "target_lang_sense_clarification": "морская птица"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9689d9b8-010b-3c72-81b5-2cde99f53030",
                    "sense_definition": "A service that delivers prepared meals to people who cannot cook for themselves.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many elderly residents rely on <w>MOW</w>, short for Meals on Wheels.",
                            "target_lang_translations": {
                                "ru": "Многие пожилые жители полагаются на <w>доставку готовой еды</w> MOW (сокращение от Meals on Wheels)."
                            }
                        },
                        {
                            "text": "The local charity runs <w>MOW</w>, delivering hot meals to people who cannot cook.",
                            "target_lang_translations": {
                                "ru": "Местная благотворительная организация занимается <w>доставкой готовой еды</w>, привозя горячие обеды тем, кто не может готовить сам."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Служба доставки готовой еды для людей, которые не могут готовить самостоятельно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "доставка готовой еды",
                                "target_lang_sense_clarification": "служба доставки еды на дом (Meals on Wheels)"
                            }
                        ]
                    },
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "acronym MOW (Meals on Wheels), written in capitals"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "388c3ce3-7fad-359c-bcfd-87c88db9ed1d",
                    "sense_definition": "A family name.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Mow</w> is our new neighbor.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Моу</w> — наш новый сосед."
                            }
                        },
                        {
                            "text": "The research was conducted by Dr. <w>Mow</w>.",
                            "target_lang_translations": {
                                "ru": "Исследование было проведено доктором <w>Моу</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
