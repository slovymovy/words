                "translations": [
                    {
                        "translation_id": "4f8bd1ff-9183-4071-9857-20379251d1d3",
                        "source_entry_id": "3dd9912c-d1af-367b-b7fa-e6eefa1650c9",
                        "source_sense_id": "22f59016-928c-3423-bbb6-c321885978e7",
                        "target_lang_word": "chivalry",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chivalry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aba53f69-2729-3958-a2e8-730d5c59c0b2",
                                        "entry_id": "890b6b89-9f5f-3432-a4f0-8d41bbbc46ab",
                                        "glosses": [
                                            "Cavalry; horsemen armed for battle."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "historical",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf790836-4555-4fa5-b5c9-7f37eae20db6",
                                                "sense_id": "aba53f69-2729-3958-a2e8-730d5c59c0b2",
                                                "text": "‘Most of the lords who rode with Lord Renly to Storm's End have gone over banner-and-blade to Stannis, with all their chivalry.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0db70c7a-0a96-3955-8a04-7dc47eb60915",
                                        "entry_id": "890b6b89-9f5f-3432-a4f0-8d41bbbc46ab",
                                        "glosses": [
                                            "The fact or condition of being a knight; knightly skill, prowess."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e7705a96-78dd-3c41-a44c-86867e494f68",
                                        "entry_id": "890b6b89-9f5f-3432-a4f0-8d41bbbc46ab",
                                        "glosses": [
                                            "The ethical code of the knight prevalent in Medieval Europe, having such primary virtues as mercy towards the poor and oppressed, humility, honour, sacrifice, fear of God, faithfulness, courage and courtesy to ladies."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "169fe30b-8857-38f5-8fb5-7c3f40fb930e",
                                        "entry_id": "890b6b89-9f5f-3432-a4f0-8d41bbbc46ab",
                                        "glosses": [
                                            "Courtesy, respect and honourable conduct, as between opponents in wartime."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac26b416-c2f9-4dfb-b685-439baf324cf3",
                                                "sense_id": "169fe30b-8857-38f5-8fb5-7c3f40fb930e",
                                                "text": "He had seen the woman he craved—his woman—his mate—in the arms of another. There had been but one course open to him, according to the fierce jungle code that guided him in this other existence; but just before it had become too late the softer sentiments of his inherent chivalry had risen above the flaming fires of his passion and saved him. A thousand times he gave thanks that they had triumphed before his fingers had released that polished arrow."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb2f7e6b-c087-36a2-a1ef-f266c6141da0",
                                        "entry_id": "890b6b89-9f5f-3432-a4f0-8d41bbbc46ab",
                                        "glosses": [
                                            "Courteous behaviour, especially that of men towards women."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "180fae77-a4bc-3c87-a5ef-1d8db585c9c3",
                                        "entry_id": "890b6b89-9f5f-3432-a4f0-8d41bbbc46ab",
                                        "glosses": [
                                            "A tenure of lands by knightly service."
                                        ],
                                        "tags": [
                                            "UK",
                                            "historical",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9fb2f2a2-9ee3-4dda-ae07-f81271d9496a",
                        "source_entry_id": "3dd9912c-d1af-367b-b7fa-e6eefa1650c9",
                        "source_sense_id": "22f59016-928c-3423-bbb6-c321885978e7",
                        "target_lang_word": "knighthood",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "knighthood",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "39d1ad83-a808-334f-af0d-d5a0b2d02046",
                                        "entry_id": "9876c18b-538f-3a63-b641-f0dbc6542c73",
                                        "glosses": [
                                            "An honour whereby one is made into a knight, and one can thereafter be called Sir."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1afb0bc9-fc63-4700-96c3-623eadf15ea6",
                                                "sense_id": "39d1ad83-a808-334f-af0d-d5a0b2d02046",
                                                "text": "the knighthood of Sir [So-and-So]"
                                            },
                                            {
                                                "example_id": "ec040159-bd53-467d-acc1-ed5417115bc7",
                                                "sense_id": "39d1ad83-a808-334f-af0d-d5a0b2d02046",
                                                "text": "He's got an OBE and MBE, and his recent work should entitle him to a knighthood."
                                            },
                                            {
                                                "example_id": "c51497bc-a1a8-4f10-9732-fac4c38b9b93",
                                                "sense_id": "39d1ad83-a808-334f-af0d-d5a0b2d02046",
                                                "text": "They rushed to congratulate Sir John Smith on his knighthood."
                                            },
                                            {
                                                "example_id": "7f2cc294-90f6-4af6-a8d4-0144bbe39b9f",
                                                "sense_id": "39d1ad83-a808-334f-af0d-d5a0b2d02046",
                                                "text": "He received his knighthood at the opening of Immingham Dock in 1912."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99521b14-0127-3bbb-b39b-765eefdca6a8",
                                        "entry_id": "9876c18b-538f-3a63-b641-f0dbc6542c73",
                                        "glosses": [
                                            "The quality of being a knight."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "71029894-de6d-3a03-a2e0-0444d96a3dd7",
                                        "entry_id": "9876c18b-538f-3a63-b641-f0dbc6542c73",
