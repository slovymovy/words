        "fr-extract.jsonl": [
            {
                "entry_id": "fe4222d7-d3e5-3d3e-96f7-d05e9cb01d7f",
                "word": "pardessus",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e188df6b-1f5c-3bf9-86e7-fc12a49b459d",
                        "entry_id": "fe4222d7-d3e5-3d3e-96f7-d05e9cb01d7f",
                        "glosses": [
                            "Vêtement qu’on met sur les autres pour se garantir du froid ou de l’humidité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc883ab6-f923-4129-a900-c2f96bf9c5dd",
                                "sense_id": "e188df6b-1f5c-3bf9-86e7-fc12a49b459d",
                                "text": "Le parfait gentleman qu’est mon vieil ami Jacques arborait ce soir-là une suave écharpe de soie, d’impeccables chaussures vernies, un pardessus du bon faiseur et un chapeau d’au moins vingt louis."
                            },
                            {
                                "example_id": "148689a0-61f8-4cae-9a00-41a7b60cc837",
                                "sense_id": "e188df6b-1f5c-3bf9-86e7-fc12a49b459d",
                                "text": "Ils descendirent les marches de la station et, bientôt, se trouvèrent sous une voûte où ils déboutonnèrent leurs pardessus."
                            },
                            {
                                "example_id": "d51bd1e9-5061-4dd5-af1d-d44ebfd558d3",
                                "sense_id": "e188df6b-1f5c-3bf9-86e7-fc12a49b459d",
                                "text": "Il faisait froid et pleuvait. Rattner et moi, empaquetés dans nos pardessus, nous l’invitions à remuer."
                            },
                            {
                                "example_id": "d00b1630-363f-4c81-a485-ac782f93842c",
                                "sense_id": "e188df6b-1f5c-3bf9-86e7-fc12a49b459d",
                                "text": "Dans son vieux pardessus râpé\nIl s'en allait l'hiver, l'été\nDans le petit matin frileux\nMon vieux."
                            },
                            {
                                "example_id": "3773fc0b-96b6-485d-9244-92094cfa8964",
                                "sense_id": "e188df6b-1f5c-3bf9-86e7-fc12a49b459d",
                                "text": "Ils m’y achètent un pardessus qui me donne, j’ai dix ans, une allure à la Humphrey Bogart dans Le Grand Sommeil."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9d7fcd89-4e1b-44e1-9ba8-34399d5ae640",
                        "source_entry_id": "fe4222d7-d3e5-3d3e-96f7-d05e9cb01d7f",
                        "source_sense_id": "e188df6b-1f5c-3bf9-86e7-fc12a49b459d",
                        "target_lang_word": "Übermantel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Übermantel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "28bccccb-0ef2-354d-9616-cda817d4812c",
                                        "entry_id": "ff513c40-b321-37c2-9d37-18a925695ffe",
                                        "glosses": [
                                            "über anderer Kleidung getragenes, mindestens bis zum Knie reichendes Bekleidungsstück, meist für draußen (es kann je nach Zusammenhang eine leichte, farblich passende Ergänzung des Sommerkleides sein oder ein schwerer, pelzgefütterter Wintermantel)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30c07678-5eb8-4b2d-b46a-bf982831b889",
                                                "sense_id": "28bccccb-0ef2-354d-9616-cda817d4812c",
                                                "text": "„Saint-Laurent empfiehlt ein Ophelia-Nachtgewand mit einem Übermantel aus Taft.“"
                                            },
                                            {
                                                "example_id": "7b1d9267-da6c-4d83-85eb-4b6c2cccdf40",
                                                "sense_id": "28bccccb-0ef2-354d-9616-cda817d4812c",
                                                "text": "„Dass ich ebenfalls in den Genuss neuer Kleidung kam, die mir bis auf einen weißen, weit wallenden Übermantel mit Kapuze nicht einmal passte, ließ mich kopfschüttelnd in unserem Quartier auf einen der Stühle sinken.“"
                                            },
                                            {
                                                "example_id": "c4599931-ac6c-444c-8ff6-b6c481938880",
                                                "sense_id": "28bccccb-0ef2-354d-9616-cda817d4812c",
                                                "text": "„Er hatte ein ebenmäßiges, blasses Gesicht, glatt zurückgekämmtes Haar und trug einen schweren, bis zum Hals zugeknöpften Übermantel.“"
                                            },
                                            {
                                                "example_id": "b2c914e3-9e8f-4172-9262-f988385734d9",
                                                "sense_id": "28bccccb-0ef2-354d-9616-cda817d4812c",
                                                "text": "„Als Alexander mit seinen griechischen Begleitern am Hofe Arturs eintrifft, ziehen sie, bevor sie vor den König treten, entsprechend der Sitte ihre Übermäntel aus, damit man sie nicht für \"unhöflich\" und \"vermessen\" halte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "92a5e772-a7f2-4ddf-9b60-7bc5d08f8989",
                        "source_entry_id": "fe4222d7-d3e5-3d3e-96f7-d05e9cb01d7f",
                        "source_sense_id": "e188df6b-1f5c-3bf9-86e7-fc12a49b459d",
                        "target_lang_word": "overcoat",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "overcoat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cf97172a-f73c-3e91-9741-a6b4fb5e54fd",
                                        "entry_id": "0c05952e-1d41-3e40-8a4c-d52cc167fd72",
                                        "glosses": [
                                            "A heavy garment worn over other clothes, for protection from cold or weather."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1379b8c4-c65c-4ead-b9fa-d83a55bb2c3c",
                                                "sense_id": "cf97172a-f73c-3e91-9741-a6b4fb5e54fd",
                                                "text": "Men that I knew around Wapatomac didn't wear high, shiny plug hats, nor yeller spring overcoats, nor carry canes with ivory heads as big as a catboat's anchor, as you might say."
                                            },
                                            {
                                                "example_id": "8bd02d6a-44bf-4863-8c6c-4d75a13572dd",
                                                "sense_id": "cf97172a-f73c-3e91-9741-a6b4fb5e54fd",
                                                "text": "‘It's rather like a beautiful Inverness cloak one has inherited. Much too good to hide away, so one wears it instead of an overcoat and pretends it's an amusing new fashion.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69b5cbef-17ac-3642-bdbc-2b191f60d155",
                                        "entry_id": "0c05952e-1d41-3e40-8a4c-d52cc167fd72",
                                        "glosses": [
                                            "An outer coat, an outer coating (of paint, etc)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f53ca39-9b4c-4db5-94fc-9a80c45f0c4b",
                                                "sense_id": "69b5cbef-17ac-3642-bdbc-2b191f60d155",
                                                "text": "Near-synonym: topcoat"
                                            },
                                            {
                                                "example_id": "1b6451af-889c-44a5-b598-6915a18b6d61",
                                                "sense_id": "69b5cbef-17ac-3642-bdbc-2b191f60d155",
                                                "text": "Wait 24 hours before applying an overcoat."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "overcoat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2de3b01a-200d-3a58-bba6-26bd2907dcbd",
                                        "entry_id": "b9cd20cd-ffff-3584-a5c0-b05654556793",
                                        "glosses": [
                                            "To apply an exterior coating to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a366fe14-3e6d-4472-a4a4-08cd2139e950",
                                                "sense_id": "2de3b01a-200d-3a58-bba6-26bd2907dcbd",
                                                "text": "Wait 24 hours before overcoating with either this product or a clearcoat."
                                            },
                                            {
                                                "example_id": "4b6e0c8c-79f3-4331-8c72-b3261d2b128c",
                                                "sense_id": "2de3b01a-200d-3a58-bba6-26bd2907dcbd",
                                                "text": "One method is to overcoat the fiber with Teflon AF, an amorphous Teflon that transmits over most of sapphire fiber's transmission range."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "89c3062c-d7e2-4587-95a6-8e9f91626b76",
                        "source_entry_id": "fe4222d7-d3e5-3d3e-96f7-d05e9cb01d7f",
                        "source_sense_id": "e188df6b-1f5c-3bf9-86e7-fc12a49b459d",
