                    },
                    {
                        "translation_id": "4073aaf2-69b7-4e69-a0f3-741545c17726",
                        "source_entry_id": "f168d516-a933-3501-8dac-4bac476dee5c",
                        "source_sense_id": "1517baa7-384f-333a-aa44-99df31dd87e8",
                        "target_lang_word": "pharmacie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pharmacie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ef622d42-e53d-3a83-a743-d5989f29b63f",
                                        "entry_id": "1fc002c2-f0c4-3e15-8ea6-ea7a3d033167",
                                        "glosses": [
                                            "Science ayant pour objet la composition, la préparation et le contrôle des médicaments."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ee7cae7-0ab0-4f19-b4c2-5dde142e0c2b",
                                                "sense_id": "ef622d42-e53d-3a83-a743-d5989f29b63f",
                                                "text": "La pharmacie est parfois encore, à la campagne, exercée par les médecins."
                                            },
                                            {
                                                "example_id": "1b376d12-73d1-4141-8cda-b377682e884c",
                                                "sense_id": "ef622d42-e53d-3a83-a743-d5989f29b63f",
                                                "text": "École de pharmacie. Par extension,"
                                            },
                                            {
                                                "example_id": "134d40ee-d3a6-4f40-b968-29c5c2b762d3",
                                                "sense_id": "ef622d42-e53d-3a83-a743-d5989f29b63f",
                                                "text": "Études de pharmacie."
                                            },
                                            {
                                                "example_id": "d5abebfa-5d68-4a52-9fb0-5400126152ae",
                                                "sense_id": "ef622d42-e53d-3a83-a743-d5989f29b63f",
                                                "text": "Élève en pharmacie."
                                            },
                                            {
                                                "example_id": "ccbd000e-3920-45cc-bda2-502b3ca35ac8",
                                                "sense_id": "ef622d42-e53d-3a83-a743-d5989f29b63f",
                                                "text": "Des étudiants en pharmacie, en pratique sage-femme ou en inhalothérapie, ou des étudiants qui deviendront infirmiers ou infirmières auxiliaires et des résidents en médecine pourront contribuer à la campagne.\n L’arrêté ministériel permettra aussi aux acupuncteurs, audiologistes, chiropraticiens, audioprothésistes, denturologistes, ergothérapeutes, hygiénistes dentaires d'administrer le vaccin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70727626-c4b6-36b0-a041-81063ae46d8b",
                                        "entry_id": "1fc002c2-f0c4-3e15-8ea6-ea7a3d033167",
                                        "glosses": [
                                            "Officine où l’on conserve, prépare et vend des médicaments ainsi que divers produits ayant trait à la santé, à l'hygiène, aux soins du corps etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d0743e7-e819-40d2-bca7-f4f63a69c25e",
                                                "sense_id": "70727626-c4b6-36b0-a041-81063ae46d8b",
                                                "text": "Ce que l’on mangeait dans les drugstores, plus ou moins élégants, se ressemblait, tout comme le milk-of-magnesia ou l’aspirine, vendus par le pharmacien de l’autre comptoir, sont les mêmes dans toutes les pharmacies."
                                            },
                                            {
                                                "example_id": "a40a1cf9-a984-4740-8d7b-f19ececef8db",
                                                "sense_id": "70727626-c4b6-36b0-a041-81063ae46d8b",
                                                "text": "Au commencement était le palfium, reprit la voix tandis que la caméra, installée à l’intérieur d’une voiture en marche, révélait à David une pharmacie qu’il reconnut aussitôt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95e04304-fa7a-3bf4-bd2d-ece73fdd466b",
                                        "entry_id": "1fc002c2-f0c4-3e15-8ea6-ea7a3d033167",
                                        "glosses": [
                                            "Assortiment de produits de premiers soins et de médicaments d'usage courant que l'on garde chez soi ou que l'on emporte en voyage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06bc5d44-0e2c-4170-966a-299915155193",
                                                "sense_id": "95e04304-fa7a-3bf4-bd2d-ece73fdd466b",
                                                "text": "À défaut de médecin j'emportai une petite pharmacie, c'était une précaution sage et elle me fut d'un grand secours. J'avais pris une ordonnance d'un jeune médecin de mes amis en cas d'attaque de vomito-négro : la prudence est la mère de sûreté."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
