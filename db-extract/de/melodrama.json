                "senses": [
                    {
                        "sense_id": "91660f5d-df46-35ef-84dc-c245469b66c1",
                        "entry_id": "7c8e09f4-d495-3cd1-87a5-950273503132",
                        "glosses": [
                            "dichterischer Vortrag, der von Instrumentalmusik begleitet wird"
                        ],
                        "tags": [
                            "Theater"
                        ],
                        "examples": [
                            {
                                "example_id": "d975d4f1-91f1-43e4-b93d-6d032bda98c4",
                                "sense_id": "91660f5d-df46-35ef-84dc-c245469b66c1",
                                "text": "„Doch abgesehen von den vielen Gesangsnummern handelt es sich dennoch um ein akzeptables Melodrama.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "066842e3-dbe9-3e5e-a9ef-49662702a673",
                        "entry_id": "7c8e09f4-d495-3cd1-87a5-950273503132",
                        "glosses": [
                            "Film, Theaterstück oder sonstige Handlung, bei denen Emotionen oder traurige Ereignisse übertrieben dargestellt werden"
                        ],
                        "tags": [
                            "pejorativ"
                        ],
                        "examples": [
                            {
                                "example_id": "8dd1c870-90f7-4fcb-b3a6-15800ca7fe0e",
                                "sense_id": "066842e3-dbe9-3e5e-a9ef-49662702a673",
                                "text": "„Gorju klatschte Beifall bei den philosophischen Tiraden der Tragödien und bei allem, was in den Melodramen fürs Volk sprach, so daß sie, von seinem Geschmack entzückt, daran dachten, ihm Unterricht zu geben, um ihn später Schauspieler werden zu lassen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "9b021155-a68b-3ea0-a2e8-97deb9b8ca39",
                        "entry_id": "7c8e09f4-d495-3cd1-87a5-950273503132",
                        "glosses": [
                            "emotional geführte Auseinandersetzung oder Diskussion"
                        ],
                        "tags": [
                            "figurative"
                        ],
