                        "entry_id": "6c8ef2e0-635f-33f0-ac34-c71b88a80c17",
                        "glosses": [
                            "Wohnung, die nur einen Wohn-/Schlafraum hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "948dc742-ab6b-4d24-b993-f66742ec18d2",
                                "sense_id": "4a01684b-342b-3422-8510-c067a6cdf414",
                                "text": "Viele Menschen müssen sich mit einer Einraumwohnung begnügen."
                            },
                            {
                                "example_id": "9b234dea-5f29-426e-855b-4a6847f66602",
                                "sense_id": "4a01684b-342b-3422-8510-c067a6cdf414",
                                "text": "„Sie schlichen die Treppe hinauf zu ihrer Einraumwohnung im vierten Stock eines Hauses, das, wäre es ein Schiff gewesen, nur Todesmutige zum Anheuern gebracht hätte.“"
                            }
                        ],
