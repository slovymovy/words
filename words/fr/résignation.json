    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0ff84ef6-cbd6-3bea-889e-6112fad16765",
                    "sense_definition": "Disposition morale consistant à accepter sans révolte les épreuves, la souffrance ou le sort.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attitude_morale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a accepté la mauvaise nouvelle avec une calme <w>résignation</w>, sans prononcer un seul mot de plainte."
                        },
                        {
                            "text": "Son visage fatigué exprimait une profonde <w>résignation</w> face aux difficultés incessantes de son quotidien."
                        }
                    ],
                    "synonyms": [
                        "abandon",
                        "renoncement"
                    ],
                    "antonyms": [
                        "révolte",
                        "résistance"
                    ],
                    "common_phrases": [
                        "avec résignation"
                    ]
                },
                {
                    "sense_id": "5bd05d09-b36a-325e-9329-f0a09524a06b",
                    "sense_definition": "Action de renoncer formellement à une charge, un office ou une fonction.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "renonciation_formelle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le ministre a finalement annoncé la <w>résignation</w> de ses fonctions après plusieurs semaines de polémique."
                        },
                        {
                            "text": "La <w>résignation</w> d'un office public devait autrefois être validée par les autorités royales."
                        }
                    ],
                    "synonyms": [
                        "démission",
                        "renoncement"
                    ],
                    "common_phrases": [
                        "résignation d'un office",
                        "résignation de ses fonctions"
                    ]
                },
                {
                    "sense_id": "741f593a-030e-3988-98b1-48d6c1305f9e",
                    "sense_definition": "Abandon volontaire d'un titre, d'un droit ou d'un bien en faveur d'une autre personne.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "renonciation_formelle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le prince a signé l'acte de <w>résignation</w> de la couronne en faveur de son jeune frère."
                        },
                        {
                            "text": "Cette <w>résignation</w> de ses droits successoraux a permis d'éviter un long procès familial."
                        }
                    ],
                    "synonyms": [
                        "abandon",
                        "renoncement"
                    ],
                    "common_phrases": [
                        "acte de résignation"
                    ]
                },
                {
                    "sense_id": "8829b0d1-dde2-3c4e-a54c-a977a7f3d2b1",
                    "sense_definition": "Démission d'un bénéfice ecclésiastique remise entre les mains de l'autorité compétente.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "renonciation_formelle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'évêque a soumis sa <w>résignation</w> directement au pape pour des raisons de santé."
                        },
                        {
                            "text": "Cette <w>résignation</w> pure et simple fut contestée par les chanoines du diocèse."
                        }
                    ],
                    "synonyms": [
                        "démission"
                    ],
                    "common_phrases": [
                        "résignation pure et simple"
                    ]
                }
            ]
        }
    ]
