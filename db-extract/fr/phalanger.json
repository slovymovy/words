                "senses": [
                    {
                        "sense_id": "bf2ffc98-41bc-37fe-8a84-0b769b18e9f2",
                        "entry_id": "1c9249fc-28f4-3d0b-8b23-4d4bcced416b",
                        "glosses": [
                            "Voir les flottes partant ou arrivant d’une planète en utilisant une phalange, dans le jeu OGame."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f842aa64-61d2-464f-b578-eb6dc5be6f25",
                                "sense_id": "bf2ffc98-41bc-37fe-8a84-0b769b18e9f2",
                                "text": "Mais concrètement, qu'est ce qu'on voit en phalangeant ? Au moment où on phalange une planète, une fenêtre pop-up apparait."
                            },
                            {
                                "example_id": "00c4c6db-f624-4566-a96a-6e01db432326",
                                "sense_id": "bf2ffc98-41bc-37fe-8a84-0b769b18e9f2",
                                "text": "Un SP me phalangeant en G4, il a eu peur que je retourne vers la G3 me jeter dans les griffes du Maka qui n'attendait que ca."
                            },
                            {
                                "example_id": "74f3c93a-b3e0-4579-a95a-76de29547aa8",
                                "sense_id": "bf2ffc98-41bc-37fe-8a84-0b769b18e9f2",
                                "text": "En phalangeant la colo d'où partent les recycleurs on voit où ils se dirigent et à quelle heure ils reviennent."
                            },
                            {
                                "example_id": "cdeff58f-da4e-4bea-be85-b12c8c1db588",
                                "sense_id": "bf2ffc98-41bc-37fe-8a84-0b769b18e9f2",
                                "text": "Si votre flotte est près d'une lune et que celle-ci possède une phalange (bâtiment spécifique aux lunes) suffisante pour être à portée de votre flotte, alors ce joueur pourra voir toutes les flottes partant ou arrivant de cette planète /* sauf les retours de statio ou les statio planète - lune */ , avec leur mission et le nombre de vaisseaux(tout ceci a un coût: 5000 de deut). On appelle cette action phalanger."
                            },
                            {
                                "example_id": "6e2cd5e6-35fa-4c57-b131-0ab762363ff6",
                                "sense_id": "bf2ffc98-41bc-37fe-8a84-0b769b18e9f2",
                                "text": "Quels types de flotte se phalangent ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "98188df9-4f2e-333e-9ceb-b25a31ade896",
                        "entry_id": "1c9249fc-28f4-3d0b-8b23-4d4bcced416b",
                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7dc4b1ba-cb39-45a8-bbf9-13ebf53d5536",
                                "sense_id": "98188df9-4f2e-333e-9ceb-b25a31ade896",
                                "text": "Les vieux crabes phalangent des échafauds de récolte."
                            },
                            {
                                "example_id": "7e30af5c-80bd-46fb-acc1-f1ab13e6397b",
                                "sense_id": "98188df9-4f2e-333e-9ceb-b25a31ade896",
                                "text": "Je te raiderai en te phalangeant."
                            }
                        ]
                    }
                ],
