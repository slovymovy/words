{
    "word_family": [
        "blood",
        "bloodiness",
        "bloodily",
        "bloodless"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "45d49da4-b1d5-3c90-884f-2b2594bc991f",
                    "sense_definition": "Used as an intensifier to express anger, annoyance, or emphasis.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "intensifier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I cannot find my <w>bloody</w> keys anywhere in this house.",
                            "target_lang_translations": {
                                "ru": "Я нигде не могу найти свои <w>чёртовы</w> ключи в этом доме.",
                                "zh": "我在屋子里到处都找不到我那<w>该死的</w>钥匙。"
                            }
                        },
                        {
                            "text": "Traffic in the city center was a <w>bloody</w> mess this morning.",
                            "target_lang_translations": {
                                "ru": "Движение в центре города сегодня утром было <w>чёртовым</w> кошмаром.",
                                "zh": "今天早上市中心的交通简直是一团<w>该死的</w>混乱。"
                            }
                        }
                    ],
                    "synonyms": [
                        "damn",
                        "damned",
                        "freaking",
                        "blasted",
                        "effing"
                    ],
                    "common_phrases": [
                        "bloody hell",
                        "bloody fool",
                        "bloody mess",
                        "bloody shame"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "common in UK and Australia"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "mild expletive"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется как усилитель для выражения гнева, раздражения или эмфазы.",
                        "zh": "用作强调词，表达愤怒、烦躁或加强语气。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чёртов",
                                "target_lang_sense_clarification": "выражает сильное раздражение"
                            },
                            {
                                "target_lang_word": "грёбаный",
                                "target_lang_sense_clarification": "грубое просторечие"
                            },
                            {
                                "target_lang_word": "долбаный",
                                "target_lang_sense_clarification": "просторечие, выражает досаду"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "该死的",
                                "target_lang_sense_clarification": "表达强烈的不满或愤怒"
                            },
                            {
                                "target_lang_word": "鬼",
                                "target_lang_sense_clarification": "用于反问或强调，表示厌烦"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "507374e1-2d95-327f-ae7b-3d2a2f9ed53a",
                    "sense_definition": "Covered with or stained by blood.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "literal_blood",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boxer wiped his <w>bloody</w> nose with a towel.",
                            "target_lang_translations": {
                                "ru": "Боксер вытер свой <w>окровавленный</w> нос полотенцем.",
                                "zh": "拳击手用毛巾擦了擦他<w>沾满血的</w>鼻子。"
                            }
                        },
                        {
                            "text": "She found a <w>bloody</w> bandage lying on the bathroom floor.",
                            "target_lang_translations": {
                                "ru": "Она нашла <w>окровавленный</w> бинт на полу в ванной.",
                                "zh": "她在浴室地板上发现了一个<w>带血的</w>绷带。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bloodied",
                        "gory"
                    ],
                    "antonyms": [
                        "clean"
                    ],
                    "common_phrases": [
                        "bloody nose",
                        "bloody hands",
                        "bloody stump"
                    ],
                    "target_lang_definitions": {
                        "ru": "Покрытый кровью или испачканный ею.",
                        "zh": "被血覆盖或沾染了血。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "окровавленный",
                                "target_lang_sense_clarification": "испачканный кровью"
                            },
                            {
                                "target_lang_word": "в крови",
                                "target_lang_sense_clarification": "покрытый кровью"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "沾满血的",
                                "target_lang_sense_clarification": "表面覆盖着血迹"
                            },
                            {
                                "target_lang_word": "带血的",
                                "target_lang_sense_clarification": "有血迹的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f43fc2c8-fb62-38ff-be65-cff114c41b0f",
                    "sense_definition": "Characterised by extreme violence and bloodshed.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "literal_blood",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The civil war was a long and <w>bloody</w> conflict that lasted for years.",
                            "target_lang_translations": {
                                "ru": "Гражданская война была долгим и <w>кровопролитным</w> конфликтом, который длился годами.",
                                "zh": "那场内战是一场持续多年的漫长而<w>血腥的</w>冲突。"
                            }
                        },
                        {
                            "text": "History is full of <w>bloody</w> battles fought over land and power.",
                            "target_lang_translations": {
                                "ru": "История полна <w>кровавых</w> битв за землю и власть.",
                                "zh": "历史上充满了为了土地和权力而进行的<w>血腥的</w>战争。"
                            }
                        }
                    ],
                    "synonyms": [
                        "violent",
                        "savage",
                        "ferocious",
                        "gory"
                    ],
                    "antonyms": [
                        "peaceful",
                        "bloodless"
                    ],
                    "common_phrases": [
                        "bloody battle",
                        "bloody war",
                        "bloody conflict",
                        "bloody history"
                    ],
                    "target_lang_definitions": {
                        "ru": "Характеризующийся крайней жестокостью и кровопролитием.",
                        "zh": "以极度暴力和流血为特征的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кровавый",
                                "target_lang_sense_clarification": "жестокий, сопровождающийся убийствами"
                            },
                            {
                                "target_lang_word": "кровопролитный",
                                "target_lang_sense_clarification": "с большими жертвами"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "血腥的",
                                "target_lang_sense_clarification": "充满暴力和杀戮的"
                            },
                            {
                                "target_lang_word": "残酷的",
                                "target_lang_sense_clarification": "造成大量伤亡的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "12291609-de4a-3841-9b94-abe81288e272",
                    "sense_definition": "Used to emphasize a statement, often to express anger, annoyance, or shock.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intensifier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You know <w>bloody</w> well that I did not say that.",
                            "target_lang_translations": {
                                "ru": "Ты <w>чертовски</w> хорошо знаешь, что я этого не говорил.",
                                "zh": "你<w>该死地</w>清楚我没说过那样的话。"
                            }
                        },
                        {
                            "text": "I am not <w>bloody</w> likely to walk home in this rain.",
                            "target_lang_translations": {
                                "ru": "Я <w>черта с два</w> пойду домой пешком под этим дождем.",
                                "zh": "我才<w>该死地</w>不可能在雨中走回家。"
                            }
                        }
                    ],
                    "synonyms": [
                        "damn",
                        "really"
                    ],
                    "common_phrases": [
                        "bloody well",
                        "not bloody likely"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "common in UK and Australia"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "mild expletive"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для усиления утверждения, часто для выражения гнева, раздражения или шока.",
                        "zh": "用于强调陈述，通常表达愤怒、烦躁或震惊。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чертовски",
                                "target_lang_sense_clarification": "очень, крайне"
                            },
                            {
                                "target_lang_word": "чёрт возьми",
                                "target_lang_sense_clarification": "восклицание для усиления"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "该死地",
                                "target_lang_sense_clarification": "极度地，用于加强语气"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "74b69622-fab2-31d0-8c4b-3ca63382c1c7",
                    "sense_definition": "To stain something with blood or cause someone to bleed.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "action_blood",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The butcher <w>bloodied</w> his apron while preparing the meat.",
                            "target_lang_translations": {
                                "ru": "Мясник <w>окровавил</w> свой фартук, разделывая мясо.",
                                "zh": "屠夫在处理肉类时把围裙<w>弄脏</w>了。"
                            }
                        },
                        {
                            "text": "He <w>bloodied</w> his knuckles by punching the hard wall in anger.",
                            "target_lang_translations": {
                                "ru": "Он <w>разбил в кровь</w> костяшки пальцев, ударив со злости по твердой стене.",
                                "zh": "他愤怒地击打坚硬的墙壁，把指关节<w>打出血</w>来了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "stain"
                    ],
                    "antonyms": [
                        "clean"
                    ],
                    "common_phrases": [
                        "bloody one's nose",
                        "bloody one's hands"
                    ],
                    "target_lang_definitions": {
                        "ru": "Испачкать что-либо кровью или заставить кого-то кровоточить.",
                        "zh": "使某物沾上血或使某人流血。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "окровавить",
                                "target_lang_sense_clarification": "испачкать кровью"
                            },
                            {
                                "target_lang_word": "разбить в кровь",
                                "target_lang_sense_clarification": "поранить до крови"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "弄脏",
                                "target_lang_sense_clarification": "使沾上血迹"
                            },
                            {
                                "target_lang_word": "打出血",
                                "target_lang_sense_clarification": "因击打而导致流血"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c73578b5-106c-3299-8dd0-27bc05c11480",
                    "sense_definition": "A cocktail made with vodka and tomato juice; short for Bloody Mary.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "drink",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bartender mixed two <w>bloodies</w> for the guests at the brunch table.",
                            "target_lang_translations": {
                                "ru": "Бармен смешал две <w>Кровавые Мэри</w> для гостей за столом.",
                                "zh": "调酒师为早午餐桌上的客人们调了两杯<w>血腥玛丽</w>。"
                            }
                        },
                        {
                            "text": "I will have a virgin <w>bloody</w> with extra celery, please.",
                            "target_lang_translations": {
                                "ru": "Мне, пожалуйста, безалкогольную <w>Кровавую Мэри</w> с дополнительным сельдереем.",
                                "zh": "请给我来一杯不含酒精的<w>血腥玛丽</w>，多加点芹菜。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Коктейль из водки и томатного сока; сокращение от 'Кровавая Мэри'.",
                        "zh": "一种由伏特加和番茄汁调制的鸡尾酒；“血腥玛丽”的简称。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Кровавая Мэри",
                                "target_lang_sense_clarification": "коктейль"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "血腥玛丽",
                                "target_lang_sense_clarification": "鸡尾酒名称"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}