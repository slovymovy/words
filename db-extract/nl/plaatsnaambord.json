                        "glosses": [
                            "een bord dat staat bij de ingang van een plaats waarop de naam van de plaats staat en de naam van de gemeente waartoe deze plaats behoort"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5722130d-aac2-4386-abb8-21847e8f311d",
                                "sense_id": "594c2663-1525-3e81-afb0-e1508f9263e5",
                                "text": "Pas toen ik Marsalès op een plaatsnaambord zag staan, werd mijn hart weer zwaar van de zorgen om mijn plotseling verslechterde verstandhouding met Mirjam."
                            },
                            {
                                "example_id": "8b0fbf96-4c7c-4a56-bb44-1ba18b2b29bc",
                                "sense_id": "594c2663-1525-3e81-afb0-e1508f9263e5",
                                "text": "Ook al zijn ze Friestalig, toch voelen de dorpen Warfstermolen, Kollumerpomp, Burum en Munnekezijl er niets voor om louter Friestalige plaatsnaamborden neer te zetten aan de rand van hun bebouwde kom. Het gaat \"onnodig veel geld\" kosten, schrijven de vier dorpen in een brief aan hun gemeenteraad."
                            }
                        ]
