                "senses": [
                    {
                        "sense_id": "81caa1b7-f066-3543-b404-3833306ac7cb",
                        "entry_id": "28a3d6ec-20c5-3a0b-b2ae-0c3c2ed69bf5",
                        "glosses": [
                            "het bestaan als landbouwer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ad48d66-a690-4112-9705-9f0f1776f81a",
                                "sense_id": "81caa1b7-f066-3543-b404-3833306ac7cb",
                                "text": "Hij sprak niet graag over zijn soldatentijd, hoewel hij niet klaagde en vaak zei dat hij tijdens zijn hele diensttijd geen enkele keer geslagen was. Als hij vertelde, waren dat voornamelijk de herinneringen die hem het meest dierbaar waren, aan zijn oude, zoals hij het noemde «christelijke» boerenleven."
                            },
                            {
                                "example_id": "454586a2-ba67-4238-abfe-e9aa5795919f",
                                "sense_id": "81caa1b7-f066-3543-b404-3833306ac7cb",
                                "text": "Lang bestaat Farmers Defence Force (FDF) nog niet. De eerste kalfjes sinds de oprichting van de boerenactiegroep worden rond deze tijd geboren. Voor iedereen die het boerenleven niet kent: negen maanden dus. Toch lijkt de organisatie het stadium van net geboren kalf wel gepasseerd, en lijkt de groep soms eerder op een boze stier."
                            }
                        ]
                    }
