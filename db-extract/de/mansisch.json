                        "glosses": [
                            "von den Mansen in Sibirien gesprochene Sprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0ddb2fa-c7a1-458a-8958-4ef2b9ef8743",
                                "sense_id": "bcf25e19-ad12-382e-b4ac-5701b4841993",
                                "text": "Nur noch knapp 3000 Menschen sprechen Mansisch."
                            },
                            {
                                "example_id": "a0b7cb07-8b55-469d-8105-b22c2e437774",
                                "sense_id": "bcf25e19-ad12-382e-b4ac-5701b4841993",
                                "text": "„Da sich die Mansen über ein flächenmäßig relativ großes Siedlungsgebiet erstrecken, zerfällt das Mansische trotz der geringen Sprecheranzahl in mehrere Dialekte, die in der Aussprache mitunter größere Unterschiede aufweisen.“"
                            }
