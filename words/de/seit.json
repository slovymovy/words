    "entries": [
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "b1953227-590d-37dd-b69e-c45b3f60f66f",
                    "sense_definition": "drückt den Beginn eines bis in die Gegenwart andauernden Vorgangs oder Zustands aus; von einem bestimmten Zeitpunkt in der Vergangenheit an",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "zeitpunkt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ich fühle mich überhaupt nicht gut und liege <w>seit</w> gestern mit Fieber im Bett."
                        },
                        {
                            "text": "Mein Bruder wohnt <w>seit</w> letztem Monat in einer gemütlichen Wohnung in Berlin."
                        }
                    ],
                    "antonyms": [
                        "bis"
                    ],
                    "common_phrases": [
                        "seit gestern",
                        "seit letzter Woche"
                    ]
                },
                {
                    "sense_id": "f18de961-a244-3623-8a3e-50c49eac4719",
                    "sense_definition": "drückt eine Zeitdauer aus, die in der Vergangenheit begonnen hat und bis heute andauert; während einer bestimmten Zeitspanne",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "zeitdauer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wir lernen nun schon <w>seit</w> drei Monaten intensiv die deutsche Sprache."
                        },
                        {
                            "text": "Meine Eltern sind schon <w>seit</w> zwanzig Jahren sehr glücklich verheiratet."
                        }
                    ],
                    "antonyms": [
                        "bis"
                    ],
                    "common_phrases": [
                        "seit zwei Wochen",
                        "seit vielen Jahren"
                    ]
                }
            ]
        },
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "7de29e54-1f6d-35ad-a962-bb5fb5d6a02e",
                    "sense_definition": "leitet einen temporalen Nebensatz ein; von dem Zeitpunkt an, als etwas geschehen ist",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sie hat deutlich mehr Energie im Alltag, <w>seit</w> sie regelmäßig Sport treibt."
                        },
                        {
                            "text": "Ich habe ihn nicht mehr gesehen, <w>seit</w> er nach München gezogen ist."
                        }
                    ]
                }
            ]
        }
