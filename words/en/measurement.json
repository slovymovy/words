                },
                {
                    "sense_id": "d558962c-747a-3050-b968-692861386325",
                    "sense_definition": "A specific size, length, or amount obtained by measuring.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "result",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tailor took my waist <w>measurement</w> to adjust the trousers.",
                            "target_lang_translations": {
                                "ru": "Портной снял с меня <w>мерку</w> талии, чтобы подогнать брюки.",
                                "zh": "裁缝量了我的腰围<w>尺寸</w>来修改裤子。",
                                "es": "El sastre tomó la <w>medida</w> de mi cintura para ajustar los pantalones."
                            }
                        },
                        {
                            "text": "These <w>measurements</w> indicate that the table will fit in the kitchen.",
                            "target_lang_translations": {
                                "ru": "Эти <w>размеры</w> указывают на то, что стол поместится на кухне.",
                                "zh": "这些<w>数据</w>表明这张桌子能放进厨房。",
                                "es": "Estas <w>medidas</w> indican que la mesa cabrá en la cocina."
                            }
                        }
                    ],
                    "common_phrases": [
                        "waist measurement",
                        "exact measurement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретная величина, размер или количество, полученные в результате измерения",
                        "zh": "通过测量得出的具体尺寸、长度或数量。",
                        "es": "Un tamaño, longitud o cantidad específica obtenida al medir."
                    },
