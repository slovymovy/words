            {
                "entry_id": "7ce43b28-893f-3c43-86f2-cddb95bd5869",
                "word": "tilly",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "45ac0915-eb47-4569-816c-32976f626a48",
                        "entry_id": "7ce43b28-893f-3c43-86f2-cddb95bd5869",
                        "tags": [
                            "plural"
                        ],
                        "form": "tillies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "787c55aa-76c8-3335-995d-35dced7efab9",
                        "entry_id": "7ce43b28-893f-3c43-86f2-cddb95bd5869",
                        "glosses": [
                            "An extra product given to a customer at no additional charge; a lagniappe."
                        ],
                        "tags": [
                            "Ireland"
                        ],
                        "examples": [
                            {
                                "example_id": "d78b1d8d-ce39-450f-a72e-4c97ecb41be9",
                                "sense_id": "787c55aa-76c8-3335-995d-35dced7efab9",
                                "text": "Myles: \"Indeed your Honour may safely say so : Iwas ploughing away […] when I bethought how I forgot to tell little Jem, when he'd be buying my pen'orth of snuff, to be sure to get it in two separate ha'porths, the way he'd have the two tillies. So what could Ido but run home, to […] go myself for the snuff, and be sure to get my tillies."
                            },
                            {
                                "example_id": "aee32d5c-d8a7-45bf-a490-82e35915841d",
                                "sense_id": "787c55aa-76c8-3335-995d-35dced7efab9",
                                "text": "He watched her pour into the measure and thence into the jug rich white milk, not hers. […] She poured again a measureful and a tilly."
                            },
                            {
                                "example_id": "f2fb71bc-d688-4e91-97f8-f7f3bcb0f3a9",
                                "sense_id": "787c55aa-76c8-3335-995d-35dced7efab9",
                                "text": "A bakereen's dusind with tithe tillies to boot."
                            },
                            {
                                "example_id": "e7d78a81-6985-4a31-a222-7b9dd299848e",
                                "sense_id": "787c55aa-76c8-3335-995d-35dced7efab9",
                                "text": "At each door he poured from the can into a pint measure and into the house-wife's jug, always with a tilly for the cat, whether there was a cat or not, sometimes splashing the step with milk to the annoyance of the housewife."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
                    {
                        "linkage_id": "cf583726-d7e5-4d0c-98ed-9972173e4dba",
                        "source_entry_id": "7ce43b28-893f-3c43-86f2-cddb95bd5869",
