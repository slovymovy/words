                "senses": [
                    {
                        "sense_id": "2ac387e7-0f65-3fe3-a15f-5c2b61d5f1af",
                        "entry_id": "d15234c2-b4e4-3fd3-b970-d6cebdc44de0",
                        "glosses": [
                            "dodatkowe wynagrodzenie w formie pieniężnej lub w postaci paczek, bonów towarowych itp. wypłacane w niektórych zakładach pracy przed świętami Bożego Narodzenia"
                        ],
                        "tags": [
                            "środ."
                        ],
                        "examples": [
                            {
                                "example_id": "743f6786-98b2-400f-8d10-047098c848de",
                                "sense_id": "2ac387e7-0f65-3fe3-a15f-5c2b61d5f1af",
                                "text": "Urzędnicy dostali już na koniec roku tzw. karpiowe – w magistracie każdy otrzymał po 400 zł brutto, a w Urzędzie Marszałkowskim o wysokości zastrzyku gotówki na święta decydowali kierownicy wydziałów (jednak średnio wyszło także po 400 zł na osobę)."
                            },
                            {
                                "example_id": "ae00de6c-e152-47ea-9a18-7e9874c9fc45",
                                "sense_id": "2ac387e7-0f65-3fe3-a15f-5c2b61d5f1af",
                                "text": "Na karpiowe w postaci bonów towarowych liczy aż 32 proc. ankietowanych pracowników – wynika z bożonarodzeniowego sondażu Pentoru."
                            },
                            {
                                "example_id": "a467602b-4768-431d-8820-4f46bc3f1387",
                                "sense_id": "2ac387e7-0f65-3fe3-a15f-5c2b61d5f1af",
                                "text": "I kiedy się widzi, że tacy sami doktorzy jak ja za tę samą pracę dostają dwukrotnie więcej plus trzynastki, płatne urlopy i karpiowe."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
