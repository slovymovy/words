        "fr-extract.jsonl": [
            {
                "entry_id": "97fa5a25-c295-326b-bdc6-a9b3aa754a72",
                "word": "désinfection",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3fe50b17-95b1-49a2-b9ba-2294efd08257",
                        "entry_id": "97fa5a25-c295-326b-bdc6-a9b3aa754a72",
                        "tags": [
                            "plural"
                        ],
                        "form": "désinfections"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "02ff1ea2-b653-317a-9a37-280d24824aea",
                        "entry_id": "97fa5a25-c295-326b-bdc6-a9b3aa754a72",
                        "glosses": [
                            "Action de désinfecter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11df8b71-f93d-4080-a5d9-ea5354e87bd0",
                                "sense_id": "02ff1ea2-b653-317a-9a37-280d24824aea",
                                "text": "Son savoir-faire s'applique à trois domaines de compétences : la lutte contre les rongeurs et les nuisibles volants (dératisation et dépigeonnage), la lutte contre les insectes rampants et volants (désinsectisation), la lutte contre les bactéries (désinfection)."
                            },
                            {
                                "example_id": "f618681b-b23c-4d3b-8fc0-876f7f6224a2",
                                "sense_id": "02ff1ea2-b653-317a-9a37-280d24824aea",
                                "text": "La loi de 1902 a rendu la déclaration d’un certain nombre de maladies infectieuses absolument obligatoire pour le médecin, dès le diagnostic posé, et comme corollaire, a rendu également obligatoire la désinfection pour les cas déclarés."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6f0e06ff-b35d-4377-88c5-e77d7eda1a25",
                        "source_entry_id": "97fa5a25-c295-326b-bdc6-a9b3aa754a72",
                        "source_sense_id": "02ff1ea2-b653-317a-9a37-280d24824aea",
                        "target_lang_word": "Desinfizierung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "56087d66-d526-45b4-b083-e0cb539199a3",
                        "source_entry_id": "97fa5a25-c295-326b-bdc6-a9b3aa754a72",
                        "source_sense_id": "02ff1ea2-b653-317a-9a37-280d24824aea",
                        "target_lang_word": "disinfection",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "disinfection",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5ddd3ada-1443-3c22-a91b-f3ee5acd48f1",
                                        "entry_id": "0f7a336a-be92-375d-82f8-c1a711848c35",
                                        "glosses": [
                                            "Treatment with disinfectant materials in order to destroy harmful microorganisms."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d356125b-223a-42f2-a7ae-e0abc6d29c70",
                                                "sense_id": "5ddd3ada-1443-3c22-a91b-f3ee5acd48f1",
                                                "text": "Recent activity in the field of blood product disinfection has been based on a photovirucidal approach, with the requirement that the other microbial branches are also susceptible."
                                            },
                                            {
                                                "example_id": "0cb4f165-561c-4c59-a571-caaf71597e20",
                                                "sense_id": "5ddd3ada-1443-3c22-a91b-f3ee5acd48f1",
                                                "text": "In brief, after application of the speculum and disinfection of the cervix, the hysterovideoscope was introduced intracervically."
                                            },
                                            {
                                                "example_id": "4b077f40-eda9-422d-af16-073704093eb8",
                                                "sense_id": "5ddd3ada-1443-3c22-a91b-f3ee5acd48f1",
                                                "text": "Whether full-room disinfections are necessary is not always clear."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
