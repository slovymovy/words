                        "source_entry_id": "ede4bbe2-3035-33c6-84b5-dbdcb21f8083",
                        "source_sense_id": "3da56f35-4a77-35e1-93f4-b573a713e8ac",
                        "target_lang_word": "puant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "puant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0b326d23-b22d-34e9-8e7c-e55e52924860",
                                        "entry_id": "cf91b26f-3546-3f4e-976f-5f69bb506ea7",
                                        "glosses": [
                                            "Qui sent mauvais, qui a une mauvaise odeur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b5be4b5-fb6a-4b40-9575-18ee5941c24a",
                                                "sense_id": "0b326d23-b22d-34e9-8e7c-e55e52924860",
                                                "text": "Il mangeait une maigre et puante pitance, faite de créton et d’eau sale qu’on lui apportait le matin, dans une écuelle de grès ébréché, […]."
                                            },
                                            {
                                                "example_id": "3ae24780-fb64-459c-94fe-7b7c71d9f2b4",
                                                "sense_id": "0b326d23-b22d-34e9-8e7c-e55e52924860",
                                                "text": "Le village auvergnat est resté malpropre, boueux, puant, délavé par les purins; il est sans lumières; les conditions d’habitation y sont exécrables."
                                            },
                                            {
                                                "example_id": "d514d6ec-50b5-4453-817a-7d0d18c39706",
                                                "sense_id": "0b326d23-b22d-34e9-8e7c-e55e52924860",
                                                "text": "Et le feu d’un petit brasero avec trois grelotteux autour qui louchaient dans la fumée puante. On n’était pas très bien."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8cb1359b-d4bc-3bed-83e4-b709c9e3d350",
                                        "entry_id": "cf91b26f-3546-3f4e-976f-5f69bb506ea7",
                                        "glosses": [
                                            "Qui est d’une fatuité, d’une vanité insupportable."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e047221-1d58-4e10-949b-31fa576436e8",
                                                "sense_id": "8cb1359b-d4bc-3bed-83e4-b709c9e3d350",
                                                "text": "Il est puant."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "puant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c5e6906a-ad56-3e31-a712-5f7bb3dda04e",
                                        "entry_id": "d715b268-c235-3a67-93e8-68b5c9622bf1",
                                        "glosses": [
                                            "Mammifère caniforme de l’ordre des carnivores réputé pour ses sécrétions de liquide malodorant en cas de menace."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2cf4eb23-a089-4ae0-a0b9-bcf0ff7a00de",
                                                "sense_id": "c5e6906a-ad56-3e31-a712-5f7bb3dda04e",
                                                "text": "Les mouffettes ou puants d’Amérique, et le putois d’Europe paraissent être du même genre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "572464b0-b06d-33e9-ad91-af69fa7502f0",
                                        "entry_id": "d715b268-c235-3a67-93e8-68b5c9622bf1",
                                        "glosses": [
                                            "Personne pour laquelle on éprouve une profonde aversion, du dégoût."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc225a7f-b574-42b3-9eb6-3ff468c60723",
                                                "sense_id": "572464b0-b06d-33e9-ad91-af69fa7502f0",
                                                "text": "Qué plaisir de loger un pruneau dans son bocal, ça me vengerait de tous mes puants d’officiers."
                                            },
                                            {
                                                "example_id": "cebdee8e-c8c4-455e-8a5e-0c212931acdf",
                                                "sense_id": "572464b0-b06d-33e9-ad91-af69fa7502f0",
                                                "text": "– Dehors les vampires ! dehors les loufiats ! dehors les puants ! les carnes ! charognes ! vendus !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "puant",
