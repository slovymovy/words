                "senses": [
                    {
                        "sense_id": "73d570f1-94dc-32ab-b7bc-15b4d7917f23",
                        "entry_id": "bbabde9f-045b-3552-be29-c19dd32f2559",
                        "glosses": [
                            "Déterminer la primitive de."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7dbc9e59-5a43-4737-8f29-39fd5c43e82b",
                                "sense_id": "73d570f1-94dc-32ab-b7bc-15b4d7917f23",
                                "text": "Primitiver une fonction f revient à chercher la fonction F [à une constante près] dont la dérivée est f : c’est l’opération inverse de la dérivation."
                            },
                            {
                                "example_id": "f48216d7-43a9-4853-9191-112f6a3718fc",
                                "sense_id": "73d570f1-94dc-32ab-b7bc-15b4d7917f23",
                                "text": "Il est très important de ne pas passer à la limite avant, car on ne peut pas dériver ni primitiver une somme infinie."
                            },
                            {
                                "example_id": "68f289ec-d6a4-4a69-be62-9ecbea64c4f1",
                                "sense_id": "73d570f1-94dc-32ab-b7bc-15b4d7917f23",
                                "text": "Primitiver une fonction avec ln(x) !"
                            }
                        ]
                    }
