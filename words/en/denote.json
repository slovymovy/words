{
    "word_family": [
        "denotation",
        "denotative",
        "denotable",
        "denotatum"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6b76e62d-9385-3691-b3c9-d8989fda4e6f",
                    "sense_definition": "To serve as a sign, mark, or indication of something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "indication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The yellow blazes on the trees <w>denote</w> the trail for hikers to follow.",
                            "target_lang_translations": {
                                "ru": "Желтые метки на деревьях <w>обозначают</w> тропу, по которой должны следовать туристы."
                            }
                        },
                        {
                            "text": "A high fever can often <w>denote</w> a serious underlying infection.",
                            "target_lang_translations": {
                                "ru": "Высокая температура часто может <w>указывать</w> на серьезную скрытую инфекцию."
                            }
                        }
                    ],
                    "synonyms": [
                        "indicate",
                        "mark",
                        "signify",
                        "represent"
                    ],
                    "common_phrases": [
                        "denote the trail",
                        "clearly denote"
                    ],
                    "target_lang_definitions": {
                        "ru": "Служить знаком, меткой или указанием на что-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обозначать",
                                "target_lang_sense_clarification": "служить знаком или меткой"
                            },
                            {
                                "target_lang_word": "указывать",
                                "target_lang_sense_clarification": "свидетельствовать о чем-либо"
                            },
                            {
                                "target_lang_word": "отмечать",
                                "target_lang_sense_clarification": "выделять меткой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "db821f1f-6e7b-32dc-bb8c-1cfa8b126f41",
                    "sense_definition": "To refer to something by its literal or primary meaning, rather than by the feelings or ideas that the word suggests.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prefix pre- <w>denotes</w> before as in the word preview.",
                            "target_lang_translations": {
                                "ru": "Приставка pre- <w>означает</w> «перед», как в слове preview (предварительный просмотр)."
                            }
                        },
                        {
                            "text": "In this technical context, the term must <w>denote</w> a specific chemical compound.",
                            "target_lang_translations": {
                                "ru": "В данном техническом контексте термин должен <w>обозначать</w> конкретное химическое соединение."
                            }
                        }
                    ],
                    "synonyms": [
                        "mean",
                        "designate"
                    ],
                    "antonyms": [
                        "connote"
                    ],
                    "common_phrases": [
                        "denote a specific meaning",
                        "literally denote"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относиться к чему-либо в его буквальном или основном значении, в отличие от сопутствующих идей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "означать",
                                "target_lang_sense_clarification": "иметь буквальное значение"
                            },
                            {
                                "target_lang_word": "значить",
                                "target_lang_sense_clarification": "выражать определенный смысл"
                            },
                            {
                                "target_lang_word": "обозначать",
                                "target_lang_sense_clarification": "называть конкретное понятие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "163e8634-9ee7-3912-8021-743f61e106ad",
                    "sense_definition": "To make something overt or clearly visible to others.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His facial expressions <w>denote</w> a deep sense of sorrow that he cannot hide.",
                            "target_lang_translations": {
                                "ru": "Выражение его лица <w>выдает</w> глубокое чувство печали, которое он не может скрыть."
                            }
                        },
                        {
                            "text": "The artist used bold colors to <w>denote</w> the chaotic energy of the city.",
                            "target_lang_translations": {
                                "ru": "Художник использовал смелые цвета, чтобы <w>передать</w> хаотичную энергию города."
                            }
                        }
                    ],
                    "synonyms": [
                        "manifest",
                        "show",
                        "reveal"
                    ],
                    "antonyms": [
                        "conceal",
                        "hide"
                    ],
                    "common_phrases": [
                        "denote feelings"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать что-либо явным или отчетливо видимым для окружающих."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выражать",
                                "target_lang_sense_clarification": "делать явным чувства или состояния"
                            },
                            {
                                "target_lang_word": "показывать",
                                "target_lang_sense_clarification": "делать видимым или заметным"
                            },
                            {
                                "target_lang_word": "свидетельствовать",
                                "target_lang_sense_clarification": "служить явным признаком чего-либо"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}