                                        "sense_id": "890b9c98-e9d0-30a5-87c9-92c287b20caf",
                                        "entry_id": "38f80cb9-9c6e-356e-9a22-874fb655cee4",
                                        "glosses": [
                                            "Masa de barro sin cocción, a veces mezclada con paja o algún otro aditivo, secada al sol y al aire, empleado como material de construcción."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f7213a8-9249-451f-aa84-7f2f26b565b2",
                                                "sense_id": "890b9c98-e9d0-30a5-87c9-92c287b20caf",
                                                "text": "El año de 176 creció tanto el agua de la laguna, , y las casas que eran de adobe cayeron."
                                            }
