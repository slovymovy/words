                                "target_senses": [
                                    {
                                        "sense_id": "3b369e95-4793-30f6-a7c0-4f303b5ccecd",
                                        "entry_id": "8664bc1d-de6d-3ea1-88b8-3a9aaf2c905f",
                                        "glosses": [
                                            "Une très petite quantité."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f14e2a51-4207-45b9-922f-0fb23c162747",
                                                "sense_id": "3b369e95-4793-30f6-a7c0-4f303b5ccecd",
                                                "text": "Antoinette sait que c'est faux, qu'il lui annonce périodiquement son mariage pour le seul plaisir de l'entendre réagir avec désinvolture, certes, mais avec un tout petit peu de retard... avec une voix un tout petit peu altérée."
                                            },
                                            {
                                                "example_id": "5217931f-a014-4ce7-af31-effb6f41a68a",
                                                "sense_id": "3b369e95-4793-30f6-a7c0-4f303b5ccecd",
                                                "text": "Pour les éliminer très facilement, versez un tout petit peu de sucre en poudre sur les taches, puis frottez—les avec un demi-citron jaune."
                                            }
                                        ]
                                    }
