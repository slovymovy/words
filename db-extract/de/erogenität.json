                "senses": [
                    {
                        "sense_id": "0eca80f4-b06a-3f25-8db2-30be9625a0ea",
                        "entry_id": "7473b74e-9e96-300e-b868-9d2349841096",
                        "glosses": [
                            "Eigenschaft einer Person, sexy und für den Betrachter erregend (erogen) zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5fac093a-42dc-4e02-b2dc-7e3216b517e9",
                                "sense_id": "0eca80f4-b06a-3f25-8db2-30be9625a0ea",
                                "text": "„Zwei Aspekte sind zu unterscheiden: Zum einen das Kunstwerk oder ein Teil davon (formaler wie inhaltlicher Art) als erregendes Objekt, zum anderen Erregung oder Erogenität als Thema des Werks (d.h. als eine solche des künstlerischen Modells oder als Beziehung von Elementen des Werks zueinander.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "72901575-98e9-3d5f-a83b-0883f4af4288",
                        "entry_id": "7473b74e-9e96-300e-b868-9d2349841096",
                        "glosses": [
                            "Eigenschaft eines Organs, sexuell erregbar (erogen) zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1cc2919-62c0-4ff2-a5a2-79b2dca0eac6",
                                "sense_id": "72901575-98e9-3d5f-a83b-0883f4af4288",
                                "text": "„Spätere definitorische Erweiterungen, wie sie Freud im Zusammenhang mit der Formulierung der Narzissmustheorie gibt, wo er allen Körperteilen gewisse Erogenität zuschreibt (1905d; GW XIV, S. 85; Fußnote 1 von 1915), stellen bereits eine erhebliche Aufweichung des Begriffs dar.“"
                            },
                            {
                                "example_id": "e0de073a-354d-4181-9132-16fd12857579",
                                "sense_id": "72901575-98e9-3d5f-a83b-0883f4af4288",
                                "text": "„Die Eigenschaft einer Körperstelle, sexuell erregende Reize ins Seelenleben zu schicken, heißt Erogenität.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
