                {
                    "sense_id": "ad7d21c7-568d-344e-b749-72dce96bbead",
                    "sense_definition": "Een kenmerkende eigenschap van iemands karakter of uiterlijk.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "characteristic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dat koppige gedrag is echt een <w>trekje</w> van zijn vader.",
                            "target_lang_translations": {
                                "en": "That stubborn behavior is really a <w>trait</w> of his father.",
                                "ru": "Это упрямое поведение — настоящая <w>черта</w> его отца.",
                                "de": "Dieses sture Verhalten ist wirklich ein <w>Charakterzug</w> seines Vaters."
                            }
                        },
                        {
                            "text": "Zijn gezicht vertoonde vermoeide <w>trekken</w> na de lange en zware reis.",
                            "target_lang_translations": {
                                "en": "His face showed tired <w>features</w> after the long and heavy journey.",
                                "ru": "На его лице проступили усталые <w>черты</w> после долгого и тяжелого путешествия.",
                                "de": "Sein Gesicht zeigte müde <w>Züge</w> nach der langen und anstrengenden Reise."
                            }
                        }
