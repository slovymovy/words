{
    "word_family": [
        "ultimate",
        "ultimatum"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "0a6656fa-654c-3863-ae9c-50366fdae48f",
                    "sense_definition": "In the end; finally, especially after a long series of events or difficulties.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "outcome",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The project was <w>ultimately</w> successful despite the initial problems.",
                            "target_lang_translations": {
                                "ru": "Проект <w>в конечном счёте</w> оказался успешным, несмотря на первоначальные проблемы.",
                                "zh": "尽管起初遇到了一些问题，但该项目<w>最终</w>还是成功了。"
                            }
                        },
                        {
                            "text": "Although they argued for hours, they <w>ultimately</w> agreed on a solution.",
                            "target_lang_translations": {
                                "ru": "Хотя они спорили часами, <w>в конце концов</w> они пришли к решению.",
                                "zh": "虽然他们争论了几个小时，但<w>到头来</w>还是就解决方案达成了一致。"
                            }
                        }
                    ],
                    "synonyms": [
                        "finally",
                        "in the end",
                        "at last",
                        "at length"
                    ],
                    "common_phrases": [
                        "ultimately successful",
                        "ultimately fail",
                        "ultimately lead to"
                    ],
                    "target_lang_definitions": {
                        "ru": "В конце концов; в итоге, особенно после долгой череды событий или трудностей.",
                        "zh": "指经过一系列事件或困难后，最终的结果。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "в конечном счёте",
                                "target_lang_sense_clarification": "результат процесса"
                            },
                            {
                                "target_lang_word": "в итоге",
                                "target_lang_sense_clarification": "результат"
                            },
                            {
                                "target_lang_word": "в конце концов",
                                "target_lang_sense_clarification": "после долгого времени"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "最终",
                                "target_lang_sense_clarification": "表示过程的终点"
                            },
                            {
                                "target_lang_word": "到头来",
                                "target_lang_sense_clarification": "强调经历曲折后的结果"
                            },
                            {
                                "target_lang_word": "终究",
                                "target_lang_sense_clarification": "表示必然的结果"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "154d52f1-6708-30dd-af6c-5c94952beabd",
                    "sense_definition": "Used to state the most important fact or the basic truth about a situation.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "essence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Ultimately</w>, it is your choice whether to accept the job offer or not.",
                            "target_lang_translations": {
                                "ru": "<w>В конечном счёте</w>, это твой выбор — принимать предложение о работе или нет.",
                                "zh": "<w>归根结底</w>，是否接受这份工作邀请取决于你自己的选择。"
                            }
                        },
                        {
                            "text": "The quality of the product <w>ultimately</w> depends on the materials used.",
                            "target_lang_translations": {
                                "ru": "Качество продукта <w>в конечном счёте</w> зависит от используемых материалов.",
                                "zh": "产品的质量<w>说到底</w>取决于所使用的材料。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fundamentally",
                        "essentially",
                        "basically",
                        "at the end of the day",
                        "when all is said and done",
                        "at bottom"
                    ],
                    "common_phrases": [
                        "ultimately responsible",
                        "ultimately depends on",
                        "ultimately a matter of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для указания на самый важный факт или основную истину в ситуации.",
                        "zh": "用于陈述情况中最重要或最根本的事实。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "в конечном счёте",
                                "target_lang_sense_clarification": "по сути, фактически"
                            },
                            {
                                "target_lang_word": "в конце концов",
                                "target_lang_sense_clarification": "подчёркивание факта"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "归根结底",
                                "target_lang_sense_clarification": "强调根本原因"
                            },
                            {
                                "target_lang_word": "说到底",
                                "target_lang_sense_clarification": "强调本质事实"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ccb01f4c-e8ae-3ffe-b00e-4b721ad6e9b7",
                    "sense_definition": "Used to introduce the last item in a series or list.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to plan the route, buy the tickets, and <w>ultimately</w> pack our bags.",
                            "target_lang_translations": {
                                "ru": "Нам нужно спланировать маршрут, купить билеты и, <w>наконец</w>, собрать вещи.",
                                "zh": "我们需要规划路线、购买车票，<w>最后</w>收拾行李。"
                            }
                        },
                        {
                            "text": "First we gather data, then we analyze it, and <w>ultimately</w> we publish the results.",
                            "target_lang_translations": {
                                "ru": "Сначала мы собираем данные, затем анализируем их и, <w>в заключение</w>, публикуем результаты.",
                                "zh": "我们先收集数据，然后进行分析，<w>最终</w>发布研究结果。"
                            }
                        }
                    ],
                    "synonyms": [
                        "lastly",
                        "finally",
                        "last"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для представления последнего пункта в серии или списке.",
                        "zh": "用于引出系列或列表中的最后一项。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наконец",
                                "target_lang_sense_clarification": "последний пункт списка"
                            },
                            {
                                "target_lang_word": "в заключение",
                                "target_lang_sense_clarification": "завершающее действие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "最后",
                                "target_lang_sense_clarification": "序列的末尾"
                            },
                            {
                                "target_lang_word": "最终",
                                "target_lang_sense_clarification": "完成一系列步骤后的最后一步"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}