                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a7602661-5fcc-4209-93cd-eaf556458040",
                        "source_entry_id": "986dd1ca-94c6-3a88-bbb4-4dfcfb765b92",
                        "target_lang_word": "autosensación",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "2c7de9e6-8884-4667-b040-24269949ed1b",
                        "source_entry_id": "986dd1ca-94c6-3a88-bbb4-4dfcfb765b92",
                        "target_lang_word": "Empfindung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Empfindung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c423f907-961d-3376-9836-ac7a7e9db393",
                                        "entry_id": "7d500a09-ab90-3a0c-8268-395c352baed0",
                                        "glosses": [
                                            "sinnliche Wahrnehmung, körperliches Gefühl"
                                        ],
                                        "tags": [
                                            "Neurologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f063867b-ef68-4f34-a3e4-315352456b2d",
                                                "sense_id": "c423f907-961d-3376-9836-ac7a7e9db393",
                                                "text": "Ihrer Empfindung zufolge war es zu kalt."
                                            },
                                            {
                                                "example_id": "78363ddb-3be7-4886-895d-894b398c7750",
                                                "sense_id": "c423f907-961d-3376-9836-ac7a7e9db393",
                                                "text": "„Dann wurde sie jäh aus ihren Empfindungen gerissen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2ea4225e-0d39-3fb8-bcf3-0e6a1602bc19",
                                        "entry_id": "7d500a09-ab90-3a0c-8268-395c352baed0",
                                        "glosses": [
                                            "inneres Gefühl, seelische Regung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ceba532-2ab6-4e9a-b016-632b2d712a59",
                                                "sense_id": "2ea4225e-0d39-3fb8-bcf3-0e6a1602bc19",
                                                "text": "Er wollte seine Empfindungen ihr gegenüber nicht zugeben."
                                            },
                                            {
                                                "example_id": "49dbf44d-caae-4525-b82f-619de9404c03",
                                                "sense_id": "2ea4225e-0d39-3fb8-bcf3-0e6a1602bc19",
                                                "text": "„Allein diese Empfindungen lebten in ihr.“"
                                            },
                                            {
                                                "example_id": "411c0da6-eaf8-4eb6-bef6-9d2dbfa6f5f1",
                                                "sense_id": "2ea4225e-0d39-3fb8-bcf3-0e6a1602bc19",
                                                "text": "„Die Tochter, obwohl von verschiedenen Empfindungen bestürmt, kannte ihren Vater zu wohl, um nicht die plötzliche Veränderung zu gewahren, die in ihm vorgegangen war.“"
                                            },
                                            {
                                                "example_id": "78a1ab94-05dd-4794-8e04-2af78b5b0799",
                                                "sense_id": "2ea4225e-0d39-3fb8-bcf3-0e6a1602bc19",
                                                "text": "„Als Soldat – und in vielen Berichten ehemaliger Kriegsteilnehmer tauchen ähnliche Empfindungen auf – findet Remarque ebenfalls Halt in der Kameradschaft mit Menschen, die wie er in einer extremen Lebenssituation stehen.“"
                                            },
                                            {
                                                "example_id": "852c2c22-b1b2-4d34-b96f-0bf738de1933",
                                                "sense_id": "2ea4225e-0d39-3fb8-bcf3-0e6a1602bc19",
                                                "text": "„Seite um Seite schreibt Ina Seidel ihre Gedanken und Empfindungen in ihre vielen schwarzen Wachstuchhefte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a44a0a87-c686-4922-83d3-a7d28a3d22fc",
                        "source_entry_id": "986dd1ca-94c6-3a88-bbb4-4dfcfb765b92",
                        "target_lang_word": "Wahrnehmung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wahrnehmung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f6f371b6-675b-3aa7-846f-86235400efc0",
                                        "entry_id": "19c8219c-3ae6-3ba1-9a40-978db9faad45",
                                        "glosses": [
                                            "Aufnahme und Verarbeitung physikalischer und psychischer Reize durch Sinneszellen oder -organe; Sinneserfahrung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41b36fbc-cbb2-4b54-9c8c-84f299b749be",
                                                "sense_id": "f6f371b6-675b-3aa7-846f-86235400efc0",
                                                "text": "Eine verzerrte Wahrnehmung führt zwangsläufig zu ungeeignetem Handeln."
                                            },
                                            {
                                                "example_id": "512f25cf-0e58-4bb7-ad12-9a0ee83dad8c",
                                                "sense_id": "f6f371b6-675b-3aa7-846f-86235400efc0",
                                                "text": "Ihre Wahrnehmung war durch den Alkoholkonsum getrübt."
                                            },
                                            {
                                                "example_id": "cd2c20f3-d0dc-4b2e-8290-51a464ce9431",
                                                "sense_id": "f6f371b6-675b-3aa7-846f-86235400efc0",
                                                "text": "„Das ! macht aus dem Internet einen wärmeren, persönlicheren Ort der Zugehörigkeit und strukturiert unsere visuelle Wahrnehmung dieses Ortes.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d300cfee-ca2b-372f-95f5-28f7cbd355c8",
                                        "entry_id": "19c8219c-3ae6-3ba1-9a40-978db9faad45",
                                        "glosses": [
                                            "Vertretung, Ausübung, Realisierung von etwas; das sich Kümmern um eine Sache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d659ece-e6f7-4686-979c-c25d27f9c712",
                                                "sense_id": "d300cfee-ca2b-372f-95f5-28f7cbd355c8",
                                                "text": "Ich habe einen Rechtsanwalt mit der Wahrnehmung meiner Interessen beauftragt."
                                            },
