                                "example_id": "a400c11b-cf5a-4664-a5b0-1b53ed542bdc",
                                "sense_id": "ff092bee-00d2-3bdd-8d49-c612b68dde8a",
                                "text": "„Die vom Tageslicht durchleuchtete, relativ warme und gut durchlüftete Oberflächenzone eines ruhenden Gewässers ist das Epilimnion, der darunter liegende, sauerstofflimitierte Bereich kalten Wassers ist das Hypolimnion.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
