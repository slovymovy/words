                        "target_lang_word": "Pelerine",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pelerine",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "53ad8300-2801-3811-bb67-881b4f4b5291",
                                        "entry_id": "f28b5484-43fd-3f6d-bd8e-ef08fbc5eca9",
                                        "glosses": [
                                            "ärmelloser Umhang"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "afde505d-7b1d-42f5-9b57-f960deb345c3",
                                                "sense_id": "53ad8300-2801-3811-bb67-881b4f4b5291",
                                                "text": "„Statt eines Mantels trug er eine grünliche, verschossene Pelerine, und der Kopf gipfelte in einem steifen grauen Hut, der vor Jahren schwarz gewesen sein mochte.“"
                                            },
                                            {
                                                "example_id": "81e7c8d0-8b68-46be-b60e-9385d44e8b83",
                                                "sense_id": "53ad8300-2801-3811-bb67-881b4f4b5291",
                                                "text": "„Sie rannte mit wehender Pelerine ins Wohnzimmer und warf Aschenbecher unter das Klavier.“"
                                            },
                                            {
                                                "example_id": "4d3927d5-6a2f-4543-9774-e80f53b23f8a",
                                                "sense_id": "53ad8300-2801-3811-bb67-881b4f4b5291",
                                                "text": "„Hie und da waren Langhaarige zu sehen, die breitkrempige Hüte und Pelerinen trugen und sich statt einer Krawatte ein Halstuch umgebunden hatten.“"
                                            },
                                            {
                                                "example_id": "6000942b-67c6-4d76-8493-295419082233",
                                                "sense_id": "53ad8300-2801-3811-bb67-881b4f4b5291",
                                                "text": "„Als er kurz vor vier aufwachte, wußte er plötzlich, woran ihn der hagere Junge in der Pelerine erinnert hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
