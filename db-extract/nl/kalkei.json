                        "examples": [
                            {
                                "example_id": "c959e99e-1dbb-4928-bc56-1d7241a18166",
                                "sense_id": "60ee1b17-b90e-3aad-8f0c-9190e4c14ae7",
                                "text": "Voor het eerst in ruim 10 jaar tijd hebben flamingo's in Dierenpark Amersfoort eieren gelegd. De vogels zijn waarschijnlijk tot de leg verleid doordat hun verzorgers een kalkei in een nest hadden gelegd, aldus een woordvoerster van het park vandaag."
                            },
                            {
                                "example_id": "9291496d-56b0-4b68-8c33-559403384738",
                                "sense_id": "60ee1b17-b90e-3aad-8f0c-9190e4c14ae7",
                                "text": "Voor de veiligheid is het ei uit het nest gehaald en vervangen door een kalkei. De gier zag het levenslicht in een broedmachine."
                            }
                        ]
                    },
