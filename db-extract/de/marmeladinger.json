                                    {
                                        "sense_id": "c79c10a3-75bf-3e0b-ab1f-abab551c34a0",
                                        "entry_id": "56c0eada-2c54-3ff8-a9c5-bf71d7d987cd",
                                        "glosses": [
                                            "Clipping of sauerkraut."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "clipping",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08deaf25-9431-42a5-b21c-12a494574299",
                                                "sense_id": "c79c10a3-75bf-3e0b-ab1f-abab551c34a0",
                                                "text": "The bacon fat and the browned ribs and the boiling kraut smelled good."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "kraut",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1a1f8961-17f4-322f-91bc-59dacb7e05e4",
                                        "entry_id": "3e80430b-dfba-3e4a-b50e-151416d6285a",
                                        "glosses": [
                                            "To make (into) sauerkraut."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31306a18-d662-45d5-81f4-37f13366a490",
                                                "sense_id": "1a1f8961-17f4-322f-91bc-59dacb7e05e4",
                                                "text": "I find more money in krauting Cabbage myself and marketing the kraut, as […]"
                                            },
                                            {
                                                "example_id": "c9a729dd-b3a6-4dd9-aa12-c1a896e6434d",
                                                "sense_id": "1a1f8961-17f4-322f-91bc-59dacb7e05e4",
                                                "text": "The same applies to the brining of cucumbers […] and krauting cabbage."
                                            },
                                            {
                                                "example_id": "fb5a2d53-6013-4e0e-ace4-e5ff4ac9e9fd",
                                                "sense_id": "1a1f8961-17f4-322f-91bc-59dacb7e05e4",
                                                "text": "They krauted cabbage, picked saskatoons and dried them for the winter. The whole family contributed to the welfare of the home for there was no room for a drone in their midst."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "kraut",
