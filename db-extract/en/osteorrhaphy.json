        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "a1754d42-7ad0-3dea-8f08-d652f88e70ca",
                "word": "osteorrhaphy",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "be1f3d7d-5ae0-3749-87af-855ef1377758",
                        "entry_id": "a1754d42-7ad0-3dea-8f08-d652f88e70ca",
                        "glosses": [
                            "Synonym of osteosuture."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "d12b8257-6877-437c-a209-5f052f45e9c1",
                                "sense_id": "be1f3d7d-5ae0-3749-87af-855ef1377758",
                                "text": "Good results are seldom obtained by wiring the bone fragments, i. e., a uniting of the fractured pieces by means of wire sutures (osteorrhaphy). Wire sutures generally hamper a normal healing of the fracture, because they act as a foreign body, delay consolidation and quite often lead to necrosis and sequestrum."
                            },
                            {
                                "example_id": "3e6f9cd0-7456-4f25-a7d2-60831b2488f2",
                                "sense_id": "be1f3d7d-5ae0-3749-87af-855ef1377758",
                                "text": "At our hospital, the temporal approach is most frequently employed, but osteorrhaphy by exposing the fracture site is also performed depending on the indications."
                            },
                            {
                                "example_id": "9826ab64-80bd-4e54-8702-86804720feca",
                                "sense_id": "be1f3d7d-5ae0-3749-87af-855ef1377758",
                                "text": "Ultra-high-molecular-weight polyethylene (UHMWPE) is commonly used as the load-bearing materials of bone implants such as hip prosthesis, sutures in osteorrhaphy, and synthetic ligaments."
                            }
                        ]
                    }
                ],
