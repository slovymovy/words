                    "sense_id": "cb6adc37-af5a-3298-991e-e7b877c0e076",
                    "sense_definition": "Regarder attentivement et longuement, souvent avec admiration ou recueillement.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis le sommet de la montagne, nous pouvons <w>contempler</w> toute la vallée.",
                            "target_lang_translations": {
                                "en": "From the summit of the mountain, we can <w>contemplate</w> the whole valley.",
                                "ru": "С вершины горы мы можем <w>любоваться</w> всей долиной.",
                                "nl": "Vanaf de top van de berg kunnen we de hele vallei <w>bewonderen</w>.",
                                "de": "Vom Gipfel des Berges aus können wir das ganze Tal <w>betrachten</w>.",
                                "pl": "Ze szczytu góry możemy <w>podziwiać</w> całą dolinę.",
                                "it": "Dalla vetta della montagna possiamo <w>contemplare</w> tutta la valle.",
                                "cs": "Z vrcholu hory můžeme <w>obdivovat</w> celé údolí.",
                                "tr": "Dağın zirvesinden tüm vadiyi <w>seyredebiliriz</w>.",
                                "es": "Desde la cima de la montaña podemos <w>contemplar</w> todo el valle.",
                                "zh": "从山顶上，我们可以<w>眺望</w>整个山谷。"
                            }
                        },
                        {
                            "text": "Elle s'arrête devant le tableau pour <w>contempler</w> les détails de la peinture.",
                            "target_lang_translations": {
                                "en": "She stops in front of the painting to <w>contemplate</w> the details of the artwork.",
                                "ru": "Она останавливается перед картиной, чтобы <w>полюбоваться</w> деталями живописи.",
                                "nl": "Ze blijft voor het schilderij staan om de details van het werk te <w>bewonderen</w>.",
                                "de": "Sie bleibt vor dem Bild stehen, um die Einzelheiten des Gemäldes zu <w>betrachten</w>.",
                                "pl": "Zatrzymuje się przed obrazem, żeby <w>podziwiać</w> szczegóły dzieła.",
                                "it": "Si ferma davanti al quadro per <w>ammirare</w> i dettagli del dipinto.",
                                "cs": "Zastaví se před obrazem, aby <w>obdivovala</w> detaily malby.",
                                "tr": "Resmin ayrıntılarını hayranlıkla <w>seyretmek</w> için tablonun önünde durur.",
                                "es": "Se detiene frente al cuadro para <w>contemplar</w> los detalles de la pintura.",
                                "zh": "她在画前停下脚步，<w>欣赏</w>画中的细节。"
                            }
                        }
                    ],
                    "synonyms": [
                        "admirer",
                        "observer",
                        "regarder"
                    ],
                    "antonyms": [
                        "ignorer"
                    ],
                    "common_phrases": [
                        "contempler le paysage",
                        "contempler le coucher de soleil"
                    ],
                    "target_lang_definitions": {
                        "en": "To look at attentively and for a long time, often with admiration or reverence.",
                        "ru": "Смотреть внимательно и долго, часто с восхищением или благоговением.",
                        "nl": "Lang en aandachtig naar iets kijken, vaak met bewondering of eerbied.",
                        "de": "Etwas lange und aufmerksam ansehen, oft bewundernd oder andächtig.",
                        "pl": "Patrzeć uważnie i długo na coś, często z podziwem lub czcią.",
                        "it": "Guardare con attenzione e a lungo, spesso con ammirazione o raccoglimento.",
                        "cs": "Dlouze a pozorně se na něco dívat, často s obdivem nebo úctou.",
                        "tr": "Bir şeye uzun süre ve dikkatle bakmak, çoğu zaman hayranlıkla veya saygıyla.",
                        "es": "Mirar algo con atención y durante mucho tiempo, a menudo con admiración o recogimiento.",
                        "zh": "长时间、仔细地注视某物，常带着赞叹或敬仰的心情。"
                    },
