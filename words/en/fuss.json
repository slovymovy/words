{
    "word_family": [
        "fussy",
        "fussiness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "66bce4ea-d562-3a62-8bfa-66ac190b1d10",
                    "sense_definition": "Excessive activity, worry, or talk about something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "fuss_activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They made a big <w>fuss</w> about the wedding plans.",
                            "target_lang_translations": {
                                "zh": "他们为婚礼计划<w>大惊小怪</w>。",
                                "ru": "Они подняли <w>большой шум</w> из-за планов на свадьбу."
                            }
                        },
                        {
                            "text": "What is all the <w>fuss</w> about regarding the new policy?",
                            "target_lang_translations": {
                                "zh": "关于这项新政策，大家到底在<w>大惊小怪</w>什么？",
                                "ru": "Из-за чего весь этот <w>сыр-бор</w> по поводу новой политики?"
                            }
                        }
                    ],
                    "synonyms": [
                        "hubbub"
                    ],
                    "common_phrases": [
                        "make a fuss"
                    ],
                    "target_lang_definitions": {
                        "zh": "指对某事表现出过度的关注、担忧或大惊小怪。",
                        "ru": "Излишняя суета, беспокойство или разговоры по поводу чего-либо."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "大惊小怪",
                                "target_lang_sense_clarification": "指对小事表现出不必要的惊慌或关注。"
                            },
                            {
                                "target_lang_word": "小题大做",
                                "target_lang_sense_clarification": "指把小事当作大事来处理。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "суета",
                                "target_lang_sense_clarification": "Беспорядочные действия или излишняя спешка."
                            },
                            {
                                "target_lang_word": "шумиха",
                                "target_lang_sense_clarification": "Оживленные, часто необоснованные разговоры вокруг события."
                            },
                            {
                                "target_lang_word": "сыр-бор",
                                "target_lang_sense_clarification": "Разговорное выражение для обозначения начала шумного конфликта или переполоха."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1316775d-0d76-39ed-9e33-667951302405",
                    "sense_definition": "A complaint or noisy protest.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fuss_activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you make enough of a <w>fuss</w> about the problem, they might fix it.",
                            "target_lang_translations": {
                                "zh": "如果你针对这个问题<w>抱怨</w>得够多，他们或许会解决它。",
                                "ru": "Если ты поднимешь достаточно <w>шума</w> из-за этой проблемы, они, возможно, её исправят."
                            }
                        },
                        {
                            "text": "The customer made a loud <w>fuss</w> when the order arrived late.",
                            "target_lang_translations": {
                                "zh": "当订单送达晚了时，那位顾客<w>闹事</w>得很大声。",
                                "ru": "Клиент устроил <w>громкий скандал</w>, когда заказ пришел с опозданием."
                            }
                        }
                    ],
                    "common_phrases": [
                        "make a fuss"
                    ],
                    "target_lang_definitions": {
                        "zh": "指抱怨、抗议或吵闹。",
                        "ru": "Жалоба, шумный протест или выражение недовольства."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "抱怨",
                                "target_lang_sense_clarification": "指对不满的事物进行言语上的抗议。"
                            },
                            {
                                "target_lang_word": "闹事",
                                "target_lang_sense_clarification": "指通过吵闹的方式表达不满。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "шум",
                                "target_lang_sense_clarification": "Громкое выражение недовольства или ссора."
                            },
                            {
                                "target_lang_word": "скандал",
                                "target_lang_sense_clarification": "Громкое выяснение отношений или публичное выражение протеста."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "46c0fad0-e85d-3557-a8c3-27679a23b5dd",
                    "sense_definition": "An exhibition of excessive affection or admiration.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fuss_affection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They made a great <w>fuss</w> over the new baby.",
                            "target_lang_translations": {
                                "zh": "他们对那个新生儿非常<w>宠爱</w>。",
                                "ru": "Они <w>носились</w> с новорожденным."
                            }
                        },
                        {
                            "text": "The guests made a <w>fuss</w> over the host's delicious cooking.",
                            "target_lang_translations": {
                                "zh": "客人们对主人的美味佳肴大加<w>捧场</w>。",
                                "ru": "Гости <w>рассыпались в похвалах</w> по поводу вкусной еды хозяина."
                            }
                        }
                    ],
                    "common_phrases": [
                        "make a fuss over"
                    ],
                    "target_lang_definitions": {
                        "zh": "指对某人或某物表现出过度的喜爱或赞赏。",
                        "ru": "Проявление чрезмерного внимания, восхищения или заботы."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "宠爱",
                                "target_lang_sense_clarification": "指对某人表现出过度的喜爱。"
                            },
                            {
                                "target_lang_word": "捧场",
                                "target_lang_sense_clarification": "指对某人的表现给予过度的赞美。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "носиться",
                                "target_lang_sense_clarification": "Разговорное: уделять кому-то слишком много внимания или заботы."
                            },
                            {
                                "target_lang_word": "сюсюканье",
                                "target_lang_sense_clarification": "Чрезмерно ласковое, умиленное обращение."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "035dd445-9847-32f5-8863-8881cbcab842",
                    "sense_definition": "To be worried or excited about something, often to an unnecessary degree.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fuss_activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His grandmother will never quit <w>fussing</w> over his vegetarianism.",
                            "target_lang_translations": {
                                "zh": "他祖母永远不会停止为他的素食主义而<w>操心</w>。",
                                "ru": "Его бабушка никогда не перестанет <w>переживать</w> из-за его вегетарианства."
                            }
                        },
                        {
                            "text": "Do not <w>fuss</w> about such small details.",
                            "target_lang_translations": {
                                "zh": "不要为这些小细节<w>瞎忙</w>。",
                                "ru": "Не стоит <w>суетиться</w> из-за таких мелочей."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fuss about"
                    ],
                    "target_lang_definitions": {
                        "zh": "指对某事感到担忧或兴奋，通常是不必要的。",
                        "ru": "Беспокоиться или волноваться по поводу чего-либо, часто без необходимости."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "操心",
                                "target_lang_sense_clarification": "指对某事过度担忧。"
                            },
                            {
                                "target_lang_word": "瞎忙",
                                "target_lang_sense_clarification": "指在不必要的事情上浪费精力。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "переживать",
                                "target_lang_sense_clarification": "Испытывать волнение или беспокойство."
                            },
                            {
                                "target_lang_word": "суетиться",
                                "target_lang_sense_clarification": "Торопливо и беспокойно действовать из-за волнения."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d48dc032-5d36-3ec0-80f1-f1df243afe31",
                    "sense_definition": "To fiddle, fidget, or make small, unnecessary adjustments.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fuss_activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Quit <w>fussing</w> with your hair because it looks fine.",
                            "target_lang_translations": {
                                "zh": "别再<w>摆弄</w>你的头发了，看起来挺好的。",
                                "ru": "Перестань <w>теребить</w> свои волосы, они выглядят отлично."
                            }
                        },
                        {
                            "text": "He kept <w>fussing</w> with his tie before the interview.",
                            "target_lang_translations": {
                                "zh": "面试前他一直不停地<w>摆弄</w>领带。",
                                "ru": "Перед собеседованием он постоянно <w>возился</w> с галстуком."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fuss with"
                    ],
                    "target_lang_definitions": {
                        "zh": "指摆弄、乱动或进行不必要的小调整。",
                        "ru": "Теребить, вертеть в руках или совершать мелкие, ненужные движения."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "摆弄",
                                "target_lang_sense_clarification": "指反复调整或玩弄某物。"
                            },
                            {
                                "target_lang_word": "乱动",
                                "target_lang_sense_clarification": "指不安分地触碰某物。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "возиться",
                                "target_lang_sense_clarification": "Беспокойно или неуклюже совершать действия с предметом."
                            },
                            {
                                "target_lang_word": "теребить",
                                "target_lang_sense_clarification": "Постоянно дергать или перебирать что-либо руками."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3d6a9f07-37b0-38b6-a8aa-5380d0f0d420",
                    "sense_definition": "To show affection for someone or something, especially an animal.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "fuss_affection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>fussed</w> the cat while sitting on the sofa.",
                            "target_lang_translations": {
                                "zh": "他坐在沙发上时一直在<w>抚摸</w>那只猫。",
                                "ru": "Сидя на диване, он <w>гладил</w> кошку."
                            }
                        },
                        {
                            "text": "The children <w>fussed</w> the puppy when it entered the room.",
                            "target_lang_translations": {
                                "zh": "小狗进屋时，孩子们都在<w>逗弄</w>它。",
                                "ru": "Дети начали <w>сюсюкать</w> со щенком, когда он вошел в комнату."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指对某人或某物（尤其是动物）表现出亲昵。",
                        "ru": "Проявлять ласку к кому-либо, особенно к животному."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "抚摸",
                                "target_lang_sense_clarification": "指通过触摸来表达喜爱。"
                            },
                            {
                                "target_lang_word": "逗弄",
                                "target_lang_sense_clarification": "指通过互动来表达对动物的喜爱。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "гладить",
                                "target_lang_sense_clarification": "Ласково проводить рукой по шерсти животного."
                            },
                            {
                                "target_lang_word": "сюсюкать",
                                "target_lang_sense_clarification": "Разговаривать с животным ласковым, умиленным тоном."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1edbf749-f840-3c79-bd53-e489b8344a51",
                    "sense_definition": "To cry or be ill-humoured.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fuss_activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The baby started <w>fussing</w> because it was tired.",
                            "target_lang_translations": {
                                "zh": "婴儿因为累了开始<w>哭闹</w>。",
                                "ru": "Ребенок начал <w>капризничать</w>, потому что устал."
                            }
                        },
                        {
                            "text": "Stop <w>fussing</w> and go to sleep.",
                            "target_lang_translations": {
                                "zh": "别再<w>闹脾气</w>了，快去睡觉。",
                                "ru": "Перестань <w>хныкать</w> и иди спать."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指哭闹或情绪不佳。",
                        "ru": "Плакать, капризничать или проявлять недовольство."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "哭闹",
                                "target_lang_sense_clarification": "指因不适或不满而哭泣吵闹。"
                            },
                            {
                                "target_lang_word": "闹脾气",
                                "target_lang_sense_clarification": "指表现出不愉快的情绪。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "капризничать",
                                "target_lang_sense_clarification": "Выражать недовольство, часто без веской причины."
                            },
                            {
                                "target_lang_word": "хныкать",
                                "target_lang_sense_clarification": "Тихо плакать или жаловаться."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2b22380d-0ff2-32e8-876a-5ca60064428a",
                    "sense_definition": "To disturb or bother a person.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fuss_activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Do not <w>fuss</w> the guests while they are eating.",
                            "target_lang_translations": {
                                "zh": "客人在用餐时不要去<w>打扰</w>他们。",
                                "ru": "Не <w>беспокойте</w> гостей, пока они едят."
                            }
                        },
                        {
                            "text": "He did not want to <w>fuss</w> his busy colleague.",
                            "target_lang_translations": {
                                "zh": "他不想去<w>烦扰</w>他忙碌的同事。",
                                "ru": "Он не хотел <w>отвлекать</w> своего занятого коллегу."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指打扰或烦扰某人。",
                        "ru": "Беспокоить или отвлекать человека."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "打扰",
                                "target_lang_sense_clarification": "指干扰他人的正常活动。"
                            },
                            {
                                "target_lang_word": "烦扰",
                                "target_lang_sense_clarification": "指给他人带来不必要的麻烦。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "беспокоить",
                                "target_lang_sense_clarification": "Мешать кому-либо своими действиями."
                            },
                            {
                                "target_lang_word": "отвлекать",
                                "target_lang_sense_clarification": "Мешать сосредоточиться на деле."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}