                    {
                        "sense_id": "9a9ab74e-6eb9-3b58-913e-3b821ce13af8",
                        "entry_id": "03bcb441-1d14-32e1-b9c0-5cb36cb73abb",
                        "glosses": [
                            "Incidence supérieure à la moyenne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cadf78a0-a9d1-4fd5-af44-8e64bda39aec",
                                "sense_id": "9a9ab74e-6eb9-3b58-913e-3b821ce13af8",
                                "text": "On note en revanche une sur-incidence, respectivement, de 12 et 13 %, dans les départements du Nord et du Pas-de-Calais."
                            },
                            {
                                "example_id": "ec618033-bab0-47a3-ada7-38e78bb31232",
                                "sense_id": "9a9ab74e-6eb9-3b58-913e-3b821ce13af8",
                                "text": "Cette tendance se confirme, que l’on se situe à l’est ou à l’ouest de la ligne de partage des faibles ou fortes incidences : à l’Est, les taux d’incidence par cancers du sein sont élevés pour un large Bassin parisien, la Région lyonnaise, la métropole lilloise, le pourtour méditerranéen ; à l’Ouest, la sur-incidence est nette pour les agglomérations bordelaise, toulousaine ou nantaise."
                            },
                            {
                                "example_id": "5d4cffe2-0f7f-4994-b196-0353aa389ee1",
                                "sense_id": "9a9ab74e-6eb9-3b58-913e-3b821ce13af8",
                                "text": "Récemment, plusieurs équipes on rapporté l’absence de sur-incidence de P.N.A.V.M. lors de l’utilisation d’anti-H² (49, 51, 62, 71) ou d’antiacides (8)."
                            }
                        ]
                    }
