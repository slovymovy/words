                "senses": [
                    {
                        "sense_id": "4c6e7ef7-1bf5-3fe3-885a-4cb6d7b58323",
                        "entry_id": "24a38129-7947-3f84-abb0-d0312d744bcf",
                        "glosses": [
                            "junger Mann, der eine Lehre absolviert, einen Beruf erlernt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5758c88-f24e-4b6f-ae78-50cadd7be575",
                                "sense_id": "4c6e7ef7-1bf5-3fe3-885a-4cb6d7b58323",
                                "text": "„Als die Glocke zu St. Maria Magdalena in Breslau gegossen werden sollte und alles dazu fast fertig war, ging der Gießer zuvor zum Essen, verbot aber dem Lehrjungen bei Leib und Leben, den Hahn am Schmelzkessel anzurühren.“"
                            },
                            {
                                "example_id": "76654bed-01be-45c0-b0bb-b55e7e915887",
                                "sense_id": "4c6e7ef7-1bf5-3fe3-885a-4cb6d7b58323",
                                "text": "„Ich vergaß, die Namen der beiden Lehrjungen, der Maniküren und der Schuhputzer zu erwähnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
