                        "entry_id": "df1d6a84-f81a-34e2-9e61-4c4683f8f769",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind verlustfrei"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0a4920b6-d8ce-3188-b50a-33436a5ff24a",
                        "entry_id": "df1d6a84-f81a-34e2-9e61-4c4683f8f769",
                        "glosses": [
                            "so beschaffen, dass keine Verluste auftreten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d956a1f-2180-47d8-b242-49cea7c121b3",
                                "sense_id": "0a4920b6-d8ce-3188-b50a-33436a5ff24a",
                                "text": "„Als Isolatoren leiten sie eigentlich keinen Strom, verhalten sich an der Oberfläche jedoch nahezu wie perfekte Leiter, die Strom fast verlustfrei transportieren.“"
                            },
                            {
                                "example_id": "cf9d0dcb-4b87-45d0-80a0-acb990d822c7",
                                "sense_id": "0a4920b6-d8ce-3188-b50a-33436a5ff24a",
                                "text": "„Früher war der promovierte Physiker Ralf Nemetschek Projektmanager bei einem Energietechnik-Unternehmen und entwickelte Kabel, die möglichst verlustfrei Strom transportieren.“"
                            },
                            {
                                "example_id": "0b619abf-39b1-4723-8e20-97efb1557fc8",
                                "sense_id": "0a4920b6-d8ce-3188-b50a-33436a5ff24a",
                                "text": "„Wenn man zwei Schichten der Kohlenstoffvariante Graphen gegeneinander verdreht, fließt Strom verlustfrei hindurch.“"
                            },
                            {
                                "example_id": "af69541d-5d79-4951-acf4-74950ea3a8b5",
                                "sense_id": "0a4920b6-d8ce-3188-b50a-33436a5ff24a",
                                "text": "„Diese seien verlustfrei, sodass man mit einem EAC-Back-up seiner CDs ein vollwertiges Musikarchiv auf dem Rechner erstellt.“"
                            },
                            {
                                "example_id": "f74f9af0-2eaf-4ff7-87c6-03297caf5800",
                                "sense_id": "0a4920b6-d8ce-3188-b50a-33436a5ff24a",
                                "text": "„Wie beim modernen ISO-Standard AAC SLS (Scalable to Lossless), einer Entwicklung des Institute for Infocomm Research (I2R) und des Fraunhofer IIS, enthält eine MP3HD-Datei einen verlustbehaftet kodierten Kern – in diesem Fall freilich im MP3-Format – und zusätzlich die verlustfrei kodierten Inhalte; der MP3HD-Bitstrom soll sich von jedem herkömmlichen MP3-Decoder verlustbehaftet abspielen lassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
