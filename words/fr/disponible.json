    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a0405012-c9b2-396d-9446-2a079136bb47",
                    "sense_definition": "Dont on peut disposer librement, qui est prêt à être utilisé ou qui a du temps libre pour quelqu'un ou quelque chose.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Êtes-vous <w>disponible</w> demain après-midi pour discuter de ce nouveau projet ?"
                        },
                        {
                            "text": "Ce livre n'est plus <w>disponible</w> en librairie, mais on peut le commander."
                        }
                    ],
                    "synonyms": [
                        "libre",
                        "accessible"
                    ],
                    "antonyms": [
                        "indisponible",
                        "occupé",
                        "pris"
                    ],
                    "common_phrases": [
                        "être disponible",
                        "place disponible",
                        "temps disponible"
                    ]
                },
                {
                    "sense_id": "2ef8a07a-0521-355a-8e78-f3a1773f960a",
                    "sense_definition": "Qualifie la portion de biens dont la loi permet à une personne de disposer par testament ou par donation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le notaire a vérifié la quotité <w>disponible</w> avant de faire signer le testament."
                        },
                        {
                            "text": "Une part importante de ses biens reste <w>disponible</w> pour ce legs particulier."
                        }
                    ],
                    "common_phrases": [
                        "quotité disponible",
                        "portion disponible"
                    ]
                },
                {
                    "sense_id": "8707870b-e63a-3692-8c5d-57485f26731c",
                    "sense_definition": "Qui est en disponibilité, sans affectation précise mais restant à la disposition d'une administration.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet officier supérieur reste <w>disponible</w> en attendant de recevoir une nouvelle affectation."
                        },
                        {
                            "text": "Le fonctionnaire est déclaré <w>disponible</w> par décision du ministère."
                        }
                    ],
                    "common_phrases": [
                        "officier disponible"
                    ]
                },
                {
                    "sense_id": "d594f2ea-c426-3050-9fcc-fe2dd46055a6",
                    "sense_definition": "En parlant d'un animal ou familièrement d'une personne, qui est en période de reproduction ou prêt à l'accouplement.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Durant cette courte saison de reproduction, la femelle devient soudainement très <w>disponible</w>."
                        },
                        {
                            "text": "Il répétait à ses amis qu'il était désormais célibataire et particulièrement <w>disponible</w>."
                        }
                    ],
                    "synonyms": [
                        "en chaleur"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "au sens figuré pour une personne"
                        }
                    ]
                }
            ]
        }
    ]
