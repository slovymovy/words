                "senses": [
                    {
                        "sense_id": "56fcf961-04f5-3136-89ec-931314ec94e9",
                        "entry_id": "b4f8886e-2671-38b7-b0b4-438bf627cbf3",
                        "glosses": [
                            "aus Porzellan gefertigte Tasse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae5bfae0-b75b-466e-8030-358923d403e4",
                                "sense_id": "56fcf961-04f5-3136-89ec-931314ec94e9",
                                "text": "Die antike Porzellantasse ging gestern zu Bruch."
                            },
                            {
                                "example_id": "ea09752f-9c58-4b6d-8bd2-73ea74749d28",
                                "sense_id": "56fcf961-04f5-3136-89ec-931314ec94e9",
                                "text": "„Sie wandte sich an Helena und bat, wie sie es gewohnt war, um den Kaffee in der Porzellantasse mit Goldrand und einem Stück Zucker und einem Keks auf der Untertasse.“"
                            },
                            {
                                "example_id": "814431d9-4c48-4b44-8bac-ad3e7548b073",
                                "sense_id": "56fcf961-04f5-3136-89ec-931314ec94e9",
                                "text": "„Pécuchet untersuchte sofort das Innere; die Porzellantassen lagen in Scherben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
