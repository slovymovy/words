                "senses": [
                    {
                        "sense_id": "2d3cbedb-59d2-3e88-a52f-ad16e499f2fd",
                        "entry_id": "caabdeae-7302-37f9-832f-b3f5f5ea717b",
                        "glosses": [
                            "Abläufe und Ereignisse während eines Spiels"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c9a3651-b5fa-44ad-abd7-2f487123c4e7",
                                "sense_id": "2d3cbedb-59d2-3e88-a52f-ad16e499f2fd",
                                "text": "„Die Eingriffe des Spielleiters in das Spielgeschehen, seine Beratung und Hilfe für die Spieler und die Auswertung der Spielereignisse sind jedoch nur sinnvoll und erfolgversprechend, wenn er als Beobachter und auch als Mitspieler dazu in der Lage ist, die entscheidenden Spielphänomene zu erkennen.“"
                            },
                            {
                                "example_id": "dc4f20d3-ce0a-4034-9492-4797d5985abe",
                                "sense_id": "2d3cbedb-59d2-3e88-a52f-ad16e499f2fd",
                                "text": "„Aufgrund der Schnelligkeit, mit der das Spielgeschehen abläuft und mit der der Spielleiter reagieren und unter Umständen eingreifen muß, kommt als Instrument der Evaluation wohl ausschließlich die Beobachtung in Frage.“"
                            },
                            {
                                "example_id": "7c85d246-8a0b-4e0a-9dcb-9a165bcd6208",
                                "sense_id": "2d3cbedb-59d2-3e88-a52f-ad16e499f2fd",
                                "text": "„Seit dem vulkanartigen Ausbruch des Computerzeitalters in den neunziger Jahren wird das Spielinteresse und Spielgeschehen in beträchtlichem Maße von elektronischen Spielen geprägt.“"
                            },
                            {
                                "example_id": "5b49aac0-a7f8-4b5f-a0c0-c557fdfeb3a9",
                                "sense_id": "2d3cbedb-59d2-3e88-a52f-ad16e499f2fd",
                                "text": "„Mit Beginn einer Bundesligapartie filmen Kameras vom Tribünendach aus das Spielgeschehen.“"
                            },
                            {
                                "example_id": "9f824751-dea2-47dd-8996-642f906b3349",
                                "sense_id": "2d3cbedb-59d2-3e88-a52f-ad16e499f2fd",
                                "text": "„Das Spielgeschehen spielte sich überwiegend im Mittelfeld ab, klare Torchancen gab es so gut wie gar nicht mehr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
