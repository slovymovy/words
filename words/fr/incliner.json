{
    "word_family": [
        "inclinaison",
        "inclination",
        "inclinable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3a386889-858e-3d10-88a0-04058a96c4f9",
                    "sense_definition": "Pencher ou disposer un objet de manière oblique par rapport à l'horizontale ou à la verticale.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mouvement_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut <w>incliner</w> doucement le récipient pour verser l'eau sans en renverser à côté."
                        },
                        {
                            "text": "Le passager a décidé d'<w>incliner</w> son siège afin de se reposer pendant le long voyage."
                        }
                    ],
                    "synonyms": [
                        "pencher"
                    ],
                    "antonyms": [
                        "redresser"
                    ],
                    "common_phrases": [
                        "incliner la bouteille",
                        "incliner le dossier"
                    ]
                },
                {
                    "sense_id": "3112fb30-31bb-3f6e-b27a-99c5fc684797",
                    "sense_definition": "Courber ou baisser vers le sol une partie du corps, en particulier la tête.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mouvement_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'élève a simplement <w>incliné</w> la tête pour marquer son accord avec la consigne."
                        },
                        {
                            "text": "Elle <w>incline</w> le visage vers son livre pour lire attentivement les petits caractères."
                        }
                    ],
                    "synonyms": [
                        "baisser",
                        "courber"
                    ],
                    "antonyms": [
                        "relever"
                    ],
                    "common_phrases": [
                        "incliner la tête"
                    ]
                },
                {
                    "sense_id": "2927f8ab-c749-3518-a2aa-2d909b60b8dc",
                    "sense_definition": "Courber le haut du corps ou la tête en signe de déférence, de politesse ou de salutation.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "salutation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les comédiens sont revenus sur scène pour s'<w>incliner</w> devant les spectateurs enthousiastes."
                        },
                        {
                            "text": "L'ambassadeur a choisi de s'<w>incliner</w> respectueusement au moment d'accueillir les invités officiels."
                        }
                    ],
                    "synonyms": [
                        "saluer"
                    ],
                    "common_phrases": [
                        "s'incliner bien bas",
                        "s'incliner respectueusement"
                    ]
                },
                {
                    "sense_id": "be471a27-598d-390c-81e0-39450b922240",
                    "sense_definition": "Reconnaître la supériorité d'un adversaire, s'avouer vaincu ou céder devant une décision.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "soumission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le joueur a dû s'<w>incliner</w> en finale après un match très disputé contre le champion."
                        },
                        {
                            "text": "Nous devons nous <w>incliner</w> devant les faits et accepter ce nouveau résultat sans hésiter."
                        }
                    ],
                    "synonyms": [
                        "capituler",
                        "céder",
                        "plier"
                    ],
                    "antonyms": [
                        "résister"
                    ],
                    "common_phrases": [
                        "s'incliner avec élégance",
                        "s'incliner devant la décision"
                    ]
                },
                {
                    "sense_id": "046a5a44-5d2a-3232-9537-afc794c52d8f",
                    "sense_definition": "Être orienté ou avoir une tendance spontanée vers une opinion, un choix ou une conduite.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "tendance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après une longue réflexion, les experts <w>inclinent</w> plutôt pour la seconde proposition budgétaire."
                        },
                        {
                            "text": "Mon cœur <w>incline</w> pour la clémence alors que la raison me commande la fermeté."
                        }
                    ],
                    "synonyms": [
                        "pencher",
                        "tendre"
                    ],
                    "common_phrases": [
                        "incliner pour une option",
                        "incliner vers une solution"
                    ]
                },
                {
                    "sense_id": "e83aa28b-82d7-3417-b947-88ba42527904",
                    "sense_definition": "Prédisposer ou inciter quelqu'un à adopter un sentiment, une croyance ou un comportement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "influence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce paysage paisible et mélancolique m'<w>incline</w> à méditer sur le cours de la vie."
                        },
                        {
                            "text": "Les récents événements l'<w>inclinent</w> à envisager l'avenir avec beaucoup plus de prudence."
                        }
                    ],
                    "synonyms": [
                        "inciter",
                        "porter",
                        "prédisposer"
                    ],
                    "antonyms": [
                        "dissuader"
                    ],
                    "common_phrases": [
                        "incliner à croire",
                        "incliner à penser"
                    ]
                }
            ]
        }
    ]
}