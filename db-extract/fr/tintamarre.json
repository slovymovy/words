                                                "sense_id": "913b61b9-f596-390b-bdcf-002b09df57d1",
                                                "text": "He bought a new tennis racket two days ago."
                                            },
                                            {
                                                "example_id": "46ea360f-9033-453f-8905-bee3f1f2fbc5",
                                                "sense_id": "913b61b9-f596-390b-bdcf-002b09df57d1",
                                                "text": "Ivor had acquired more than a mile of fishing rights with the house ; he was not at all a good fisherman, but one must do something ; one generally, however, banged a ball with a squash-racket against a wall."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "318eeaa0-7dcf-375d-85cb-0a3fea0c8daf",
                                        "entry_id": "8976b0e9-0360-3ca6-8869-773778cbe9bb",
