                ],
                "senses": [
                    {
                        "sense_id": "3919b5a9-cc44-3dfc-a65e-e92bf54c17a6",
                        "entry_id": "fafb6601-e0cd-3571-8f23-955a4f63214d",
                        "glosses": [
                            "Bedarf an etwas für sich selbst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "706770c9-32b4-4521-a726-231a665648e4",
                                "sense_id": "3919b5a9-cc44-3dfc-a65e-e92bf54c17a6",
                                "text": "Mit seinem kleinen Garten kann Herr Meier seinen Eigenbedarf an Gemüse decken."
                            },
                            {
                                "example_id": "0e711197-fd3e-444c-ad0d-68dd012a264e",
                                "sense_id": "3919b5a9-cc44-3dfc-a65e-e92bf54c17a6",
                                "text": "[Subsistenzwirtschaft ist die] Produktion von Gütern oder Anbau von landwirtschaftlichen Produkten nicht für den Export, sondern für den Eigenbedarf."
                            },
                            {
                                "example_id": "3db9dfff-93cc-4c2f-b5e3-a5ade63b0381",
                                "sense_id": "3919b5a9-cc44-3dfc-a65e-e92bf54c17a6",
                                "text": "„Er formt die Landwirtschaft um, vom Ackerbau für den Eigenbedarf zum Anbau von lukrativen Exportgütern, vor allem Kaffee.“"
                            },
                            {
                                "example_id": "387e1e4d-996f-43bd-854d-dc4092ec711c",
                                "sense_id": "3919b5a9-cc44-3dfc-a65e-e92bf54c17a6",
                                "text": "„Sie durften Land für den Eigenbedarf bewirtschaften; Vieh halten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6258397d-3966-3030-a22e-a99d5399e387",
                        "entry_id": "fafb6601-e0cd-3571-8f23-955a4f63214d",
                        "glosses": [
                            "Bedarf an Energie eines Kraftwerks, der zu dessen Betrieb notwendig ist und von diesem Kraftwerk selbst hergestellt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bab62879-d660-4b79-9f82-e4976b8351ee",
                                "sense_id": "6258397d-3966-3030-a22e-a99d5399e387",
                                "text": "Einen großen Anteil am Eigenbedarf hat üblicherweise die Speisepumpe. Sie wird entweder von einer eigenen Dampfturbine oder über einen Elektromotor angetrieben."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
