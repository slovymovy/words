                "senses": [
                    {
                        "sense_id": "415c0164-7c3a-3b5a-91b4-4979c51d52e8",
                        "entry_id": "53b01387-64c2-3e1d-910d-8de69924174b",
                        "glosses": [
                            "прост., бран. высокий, обычно нескладный человек"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "346362bb-51cb-4076-b778-450904e3cb6e",
                                "sense_id": "415c0164-7c3a-3b5a-91b4-4979c51d52e8",
                                "text": "Иваниха, старуха высоченная, дылда костистая, бровястая, брови, как у сыча…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e2d95d59-ebc8-4d12-a420-480d53aad28a",
                        "source_entry_id": "53b01387-64c2-3e1d-910d-8de69924174b",
                        "source_sense_id": "415c0164-7c3a-3b5a-91b4-4979c51d52e8",
                        "target_lang_word": "lamppost",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lamppost",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4df91f87-4d06-328e-97b8-672a3e52e1d2",
                                        "entry_id": "4936345e-9ca9-3aff-ae95-878c70c6350c",
                                        "glosses": [
                                            "The pole that holds up a light so it can illuminate a wide area, such as holds up a streetlight."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f65421b-75e1-41f2-9e43-a1ae03d486f5",
                                                "sense_id": "4df91f87-4d06-328e-97b8-672a3e52e1d2",
                                                "text": "Visit the Jurassic Coast World Heritage Site in the UK, and ammonite road signs greet you at every town and city and even the lampposts on the seafront feature a familiar coiled shell."
                                            },
                                            {
                                                "example_id": "960f87f9-9f95-46e0-a14f-7358fb67c88a",
                                                "sense_id": "4df91f87-4d06-328e-97b8-672a3e52e1d2",
                                                "text": "\"What is really good is they haven't just painted the station building, they've done all the lampposts to match as well, right down to the end of the platform."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9d28152-7744-37cb-8984-96b301013371",
                                        "entry_id": "4936345e-9ca9-3aff-ae95-878c70c6350c",
                                        "glosses": [
                                            "A tall, thin person."
                                        ],
                                        "tags": [
                                            "humorous",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff4c2dab-8b19-4647-8b88-a3cbd1196fb8",
                                                "sense_id": "f9d28152-7744-37cb-8984-96b301013371",
                                                "text": "You big skinny lamppost. And you're going grey!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f3db96d3-1d66-4fb8-8a6e-101168108f98",
                        "source_entry_id": "53b01387-64c2-3e1d-910d-8de69924174b",
