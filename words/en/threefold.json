    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d1ed38ba-0a34-35b3-868c-0d7a834bb6e5",
                    "sense_definition": "Three times as great or as much in size, degree, or number.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "multiplication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company reported a <w>threefold</w> increase in profits over the last fiscal year.",
                            "target_lang_translations": {
                                "pl": "Firma odnotowała <w>trzykrotny</w> wzrost zysków w minionym roku obrotowym."
                            }
                        },
                        {
                            "text": "There was a <w>threefold</w> rise in energy costs after the international supply disruptions.",
                            "target_lang_translations": {
                                "pl": "Nastąpił <w>trzykrotny</w> wzrost kosztów energii po zakłóceniach w międzynarodowych dostawach."
                            }
                        }
                    ],
                    "synonyms": [
                        "triple"
                    ],
                    "common_phrases": [
                        "threefold increase",
                        "threefold rise"
                    ],
                    "target_lang_definitions": {
                        "pl": "Trzy razy większy pod względem rozmiaru, stopnia lub liczby."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "trzykrotny",
                                "target_lang_sense_clarification": "zwiększony o trzy razy lub występujący trzy razy"
                            },
                            {
                                "target_lang_word": "potrójny",
                                "target_lang_sense_clarification": "trzy razy większy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "056424e7-2be8-3fd2-88df-77e708c818d3",
                    "sense_definition": "Having three parts, aspects, or elements.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "composition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The plan has a <w>threefold</w> purpose focusing on health, education, and employment.",
                            "target_lang_translations": {
                                "pl": "Plan ma <w>trojaki</w> cel, skupiając się na zdrowiu, edukacji i zatrudnieniu."
                            }
                        },
                        {
                            "text": "The teacher explained the <w>threefold</w> nature of the problem to the students.",
                            "target_lang_translations": {
                                "pl": "Nauczyciel wyjaśnił uczniom <w>troistą</w> naturę tego problemu."
                            }
                        }
                    ],
                    "synonyms": [
                        "triple",
                        "triplicate"
                    ],
                    "common_phrases": [
                        "threefold purpose",
                        "threefold nature"
                    ],
                    "target_lang_definitions": {
                        "pl": "Mający trzy części, aspekty lub elementy."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "trojaki",
                                "target_lang_sense_clarification": "występujący w trzech postaciach lub aspektach"
                            },
                            {
                                "target_lang_word": "troisty",
                                "target_lang_sense_clarification": "złożony z trzech elementów"
                            },
                            {
                                "target_lang_word": "potrójny",
                                "target_lang_sense_clarification": "składający się z trzech części"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "63975bfc-82da-38bf-9551-43f67d96a66b",
                    "sense_definition": "By three times as much; by a factor of three.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "multiplication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The population of the city has grown <w>threefold</w> in the last fifty years.",
                            "target_lang_translations": {
                                "pl": "Liczba mieszkańców miasta wzrosła <w>trzykrotnie</w> w ciągu ostatnich pięćdziesięciu lat."
                            }
                        },
                        {
                            "text": "Demand for the new electric vehicle increased <w>threefold</w> over the summer.",
                            "target_lang_translations": {
                                "pl": "Popyt na nowy pojazd elektryczny wzrósł latem <w>trzykrotnie</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "thrice",
                        "trebly"
                    ],
                    "common_phrases": [
                        "grow threefold",
                        "increase threefold"
                    ],
                    "target_lang_definitions": {
                        "pl": "Trzykrotnie, w stopniu trzy razy większym."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "trzykrotnie",
                                "target_lang_sense_clarification": "trzy razy (bardziej, mocniej, więcej)"
                            },
                            {
                                "target_lang_word": "trzy razy",
                                "target_lang_sense_clarification": "w ilości trzykrotnie wyższej"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d8ab5942-f7b4-3815-9ef1-5c7402de2e7e",
                    "sense_definition": "An algebraic variety of dimension three.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mathematicians study Calabi-Yau <w>threefolds</w> because of their applications in theoretical physics.",
                            "target_lang_translations": {
                                "pl": "Matematycy badają <w>trójrozmaitości</w> Calabiego-Yau ze względu na ich zastosowanie w fizyce teoretycznej."
                            }
                        },
                        {
                            "text": "She wrote her doctoral dissertation on the topology of a complex <w>threefold</w>.",
                            "target_lang_translations": {
                                "pl": "Napisała rozprawę doktorską na temat topologii zespolonej <w>trójrozmaitości</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Rozmaitość algebraiczna o wymiarze trzy."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "trójrozmaitość",
                                "target_lang_sense_clarification": "obiekt matematyczny o trzech wymiarach"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "055cff47-dfef-340e-9816-e1b7162c40a7",
                    "sense_definition": "To make threefold; to multiply by three.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "multiplication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The administration hoped to <w>threefold</w> the initial funding by attracting private investors.",
                            "target_lang_translations": {
                                "pl": "Administracja miała nadzieję <w>potroić</w> początkowe fundusze, przyciągając prywatnych inwestorów."
                            }
                        },
                        {
                            "text": "New technological investments effectively <w>threefolded</w> the output of the factory.",
                            "target_lang_translations": {
                                "pl": "Nowe inwestycje technologiczne skutecznie <w>potroiły</w> wydajność fabryki."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Zwiększyć lub powiększyć trzykrotnie; pomnożyć przez trzy."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "potrajać",
                                "target_lang_sense_clarification": "zwiększać trzykrotnie (niedokonany)"
                            },
                            {
                                "target_lang_word": "potroić",
                                "target_lang_sense_clarification": "zwiększyć trzykrotnie (dokonany)"
                            }
                        ]
                    }
                }
            ]
        }
