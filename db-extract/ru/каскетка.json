                    {
                        "sense_id": "fa9a2428-fb14-34f8-8812-58414150de7a",
                        "entry_id": "22049c40-8fbc-36ce-b14e-a81bca0c8bf1",
                        "glosses": [
                            "лёгкий мужской головной убор наподобие фуражки"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d5efb8a-5410-4419-886b-b25df6660f91",
                                "sense_id": "fa9a2428-fb14-34f8-8812-58414150de7a",
                                "text": "Приступим: сверху начнем. Видишь ли ты эту каскетку? — начал он, вынимая из узла довольно хорошенькую, но в то же время очень обыкновенную и дешёвую фуражку."
                            },
                            {
                                "example_id": "04d86db6-611d-4b5b-ab7e-04974211d871",
                                "sense_id": "fa9a2428-fb14-34f8-8812-58414150de7a",
                                "text": "Одет в плюшевый, с разводами, френч, в серую каскетку."
                            }
                        ]
                    }
