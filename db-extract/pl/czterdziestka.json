                                        "sense_id": "b47234f5-de30-30ac-a52d-ee1002455d1e",
                                        "entry_id": "d4467c03-bd01-332d-8100-9c3b1b040f00",
                                        "glosses": [
                                            "to, co má číslo čtyřicet v názvu, je jím označeno nebo má v obvyklých jednotkách číselnou hodnotu čtyřicet"
                                        ],
                                        "tags": [
