                                        "glosses": [
                                            "Destruction des cellules d’un organisme par les enzymes produits par cet organisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a16f9e2-6239-4220-aba1-9050a2228a3e",
                                                "sense_id": "4fb61082-a2d2-319d-8166-415e57f9e94d",
                                                "text": "La vitesse de l’autolyse et de la putréfaction varie selon la température ambiante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83009549-656f-3fd5-975e-909e4bba647f",
                                        "entry_id": "d29165b0-55af-3f5f-9d5e-369df5506f40",
                                        "glosses": [
                                            "Décomposition des cellules mortes de la levure après la fermentation."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20c18705-c2be-4d90-b81f-3ed45cdcef41",
                                                "sense_id": "83009549-656f-3fd5-975e-909e4bba647f",
                                                "text": "L’autolyse est un processus enzymatique d’autodestruction qui se produit à l’intérieur des cellules levuriennes mortes quand les enzymes responsables de la lyse sont activées et, chacune selon sa spécificité propre, entraînent la dégradation des composants de la structure cellulaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fd12fea-1ea8-3c44-809b-1bb231df4d70",
                                        "entry_id": "d29165b0-55af-3f5f-9d5e-369df5506f40",
                                        "glosses": [
                                            "Suicide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b964619e-30f8-4b57-a5ea-09ce81bd12ce",
                                                "sense_id": "0fd12fea-1ea8-3c44-809b-1bb231df4d70",
                                                "text": "Les juges d’instruction ont considéré que ce lien de causalité « est difficile à démontrer dans les décès par autolyse, le suicide étant analysé comme un fait multifactoriel »."
                                            },
                                            {
                                                "example_id": "747bf24d-1b96-4313-974b-5272bbda8611",
                                                "sense_id": "0fd12fea-1ea8-3c44-809b-1bb231df4d70",
                                                "text": "Untel a fait une tentative d’autolyse qui le conduira trois jours à l’hôpital."
                                            }
                                        ]
                                    }
                                ]
