                    },
                    {
                        "translation_id": "d075aff1-9ebf-4854-b586-6ccb1187d090",
                        "source_entry_id": "4f50b081-0424-35c7-bb6b-a6d0a92b25af",
                        "source_sense_id": "4d8cb1ee-d0ff-3eb8-a5fb-b8e54a134945",
                        "target_lang_word": "arboretum",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arboretum",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ca46a2cf-e016-3759-ac4f-b5e4e0d04f2a",
                                        "entry_id": "33e3c88b-397d-3408-b218-50a2c999bf8f",
                                        "glosses": [
                                            "Jardin botanique où sont collectionnés des arbres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02e8b025-1164-481c-acdc-f171002fe3b9",
                                                "sense_id": "ca46a2cf-e016-3759-ac4f-b5e4e0d04f2a",
                                                "text": "De plus, un arboretum, qui avait été endommagé par la tempête de 1999, est également visible."
                                            },
                                            {
                                                "example_id": "3e57961c-6fe6-4e04-857d-1b3b78631d76",
                                                "sense_id": "ca46a2cf-e016-3759-ac4f-b5e4e0d04f2a",
                                                "text": "Les arboretums sont des collections d’essences exotiques établies en principe dans des Macrosites représentatifs des zones d’introduction possibles.\nC’est la méthode traditionnelle utilisée en Europe depuis la fin du XVIIIᵉ siècle pour comparer les essences."
                                            },
                                            {
                                                "example_id": "d38fced4-8afd-472f-acb9-8a539eba3bb5",
                                                "sense_id": "ca46a2cf-e016-3759-ac4f-b5e4e0d04f2a",
                                                "text": "L’arboretum des Arbres du monde, à Huelgoat, est un espace dédié à la biodiversité végétale mondiale sur 22 hectares avec 3 600 espèces d’arbres et d’arbustes originaires de quatre continents."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
