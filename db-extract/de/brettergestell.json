                "senses": [
                    {
                        "sense_id": "fc00ca44-2d21-38f5-8949-b6e85ab647bb",
                        "entry_id": "0b148445-bf2a-3d2c-8596-4b9678e87541",
                        "glosses": [
                            "Konstruktion, die aus länglichen, breiten Holzstücken besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40a56991-d173-4a58-ae24-e3d81449dd36",
                                "sense_id": "fc00ca44-2d21-38f5-8949-b6e85ab647bb",
                                "text": "„Rechts ein großer Davidstern, frontal ein Brettergestell mit schwarzem Vorhang, das mal an eine Show-Bühne, mal an einen Viehwaggon, mal an eine Rampe erinnert.“"
                            },
                            {
                                "example_id": "9e6f5fab-759a-422b-9907-6344e7329f28",
                                "sense_id": "fc00ca44-2d21-38f5-8949-b6e85ab647bb",
                                "text": "„Wo vor einem Jahr noch leere Brettergestelle die Straße säumten, türmen sich jetzt wieder Kochtöpfe und Plastikgeschirr, Verlängerungskabel, Batterien und Rucksäcke.“"
                            },
                            {
                                "example_id": "626d4e17-4842-4d80-a93e-ae02db7c5a53",
                                "sense_id": "fc00ca44-2d21-38f5-8949-b6e85ab647bb",
                                "text": "„Sie bewohnten ineinander gestülpte Blechkanister, ausgebrannte Autos, Löcher im Flußufer, Brettergestelle.“"
                            },
                            {
                                "example_id": "51afb53c-c6fa-44da-a716-99209bdef3ac",
                                "sense_id": "fc00ca44-2d21-38f5-8949-b6e85ab647bb",
                                "text": "„Man stelle die Schränke oder Brettergestelle, welche zur Aufbewahrung der Pflanzenpäcke dienen, nicht an eine im Winter kalte Mauerwand.“"
                            },
                            {
                                "example_id": "23558249-f7e9-4997-99c0-6c5e498eb3dc",
                                "sense_id": "fc00ca44-2d21-38f5-8949-b6e85ab647bb",
                                "text": "„An dieser fensterlosen Wand stand das Brettergestell, das zum Schlafen diente.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
