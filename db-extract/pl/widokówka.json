                    {
                        "translation_id": "9fe37208-3428-4ffe-84ca-f08a47caf1d8",
                        "source_entry_id": "ceacbf63-1d60-3427-bedb-676f4a363763",
                        "source_sense_id": "a98db318-fc27-35ad-96bd-282c71e3b942",
                        "target_lang_word": "Ansichtskarte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ansichtskarte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6650d9c3-386f-3ba4-a912-04c7a3de2978",
                                        "entry_id": "b731ff9e-ecdb-337c-9a38-8c121f67c4e1",
                                        "glosses": [
                                            "Postkarte mit der Abbildung eines Gebäudes, Ortes oder Ähnliches auf der Rückseite (Bildseite)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d98fe0d-b1fe-4e66-94c5-9fc0f91fa702",
                                                "sense_id": "6650d9c3-386f-3ba4-a912-04c7a3de2978",
                                                "text": "Schau, eine Ansichtskarte aus New York mit der Freiheitsstatue drauf!"
                                            },
                                            {
                                                "example_id": "6cf9da3c-6fe7-4274-a8d7-e9846a29d1e9",
                                                "sense_id": "6650d9c3-386f-3ba4-a912-04c7a3de2978",
                                                "text": "„Ich hatte weitere Ansichtskarten einstecken, damit sie sehen konnte, wie die jetzt kaputten Kirchen und Giebelhäuser früher ausgesehen hatten.“"
                                            },
                                            {
                                                "example_id": "c3d010c0-da7d-440f-9574-5665d1aa2272",
                                                "sense_id": "6650d9c3-386f-3ba4-a912-04c7a3de2978",
                                                "text": "„Oben in der Nähe der Brücke entdeckte ich einen Kiosk mit vielen Ansichtskarten von der Umgebung.“"
                                            },
                                            {
                                                "example_id": "476072b1-f46b-48a1-8f1a-ba108331dde4",
                                                "sense_id": "6650d9c3-386f-3ba4-a912-04c7a3de2978",
                                                "text": "„Nachhause schrieb ich eine Ansichtskarte mit dem Maschsee vornedrauf.“"
                                            },
                                            {
                                                "example_id": "829b5853-40e6-4edb-8646-9deaee470653",
                                                "sense_id": "6650d9c3-386f-3ba4-a912-04c7a3de2978",
                                                "text": "„Die Sammlung selbst umfaßt inzwischen mehr als 400 teils farbige Post- und Ansichtskarten des gesamten Eichsfeldes, von denen in diesem Bildband circa 130 auf Alt-Duderstadt bezogene Ansichtskarten veröffentlicht werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
