{
    "word": "immobility",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "09386256-19c7-3ad1-8833-379e403ccaa3",
                "word": "immobility",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "0f931735-029d-4f23-8e49-926fe5a0c97c",
                        "entry_id": "09386256-19c7-3ad1-8833-379e403ccaa3",
                        "tags": [
                            "plural"
                        ],
                        "form": "immobilities"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "095d49f7-9842-315a-8849-8995e4c6efc3",
                        "entry_id": "09386256-19c7-3ad1-8833-379e403ccaa3",
                        "glosses": [
                            "The quality of not moving."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "0e0982b4-9691-484e-a725-8ec3dc14a704",
                                "sense_id": "095d49f7-9842-315a-8849-8995e4c6efc3",
                                "text": "Common to all Regions were frozen points, which were troublesome not only because of immobility, but because failure to close prevented operation of detector circuits."
                            },
                            {
                                "example_id": "c6f8a97b-eeb8-4918-b693-7cd947b65dd9",
                                "sense_id": "095d49f7-9842-315a-8849-8995e4c6efc3",
                                "text": "See how he still covers his face with his hands when he sees me and his immobility and fixed stare are often evident."
                            }
                        ]
                    },
                    {
                        "sense_id": "c3949941-ca73-302e-b4fb-db83e9bf131a",
                        "entry_id": "09386256-19c7-3ad1-8833-379e403ccaa3",
                        "glosses": [
                            "The state or condition of being unable to change one's location, move or be moved."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "7d1512f0-0d86-4355-adbf-4edc6e2462b9",
                                "sense_id": "c3949941-ca73-302e-b4fb-db83e9bf131a",
                                "text": "Immobility is a big problem for many people who can't afford a car."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1ed4ab70-d970-489d-9316-d3f0d7303da6",
                        "source_entry_id": "09386256-19c7-3ad1-8833-379e403ccaa3",
                        "source_sense_description": "the quality of not moving",
                        "target_lang_word": "immobilité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "immobilité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a1a18207-d05c-36c7-aa40-65a89e2e2cb9",
                                        "entry_id": "18a25efa-8e13-3765-b207-03b62c35d44d",
                                        "glosses": [
                                            "État de ce qui est immobile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "094aabdb-c213-44cd-99c5-0bdfd712f459",
                                                "sense_id": "a1a18207-d05c-36c7-aa40-65a89e2e2cb9",
                                                "text": "Moi, je vais comme les autres; moi, je suis le mouvement. Dieu me garde de prêcher l’immobilité. — L'immobilité, c'est la mort."
                                            },
                                            {
                                                "example_id": "5ef0afcc-add3-486c-a267-73709990117d",
                                                "sense_id": "a1a18207-d05c-36c7-aa40-65a89e2e2cb9",
                                                "text": "— Le quiétisme […] érigeait en système et posait avec franchise comme suprême perfection l’état d’immobilité et d’impuissance où l'âme parvient à la longue quand elle abdique son activité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ff68eb58-0d2a-4a0e-88a4-ada352c2cc09",
                        "source_entry_id": "09386256-19c7-3ad1-8833-379e403ccaa3",
                        "source_sense_description": "the quality of not moving",
                        "target_lang_word": "Immobilität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Immobilität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e3d2fd5f-93a3-3c88-819d-19c37e60139f",
                                        "entry_id": "70d44ce8-31f9-340f-ac79-1753ac459df6",
                                        "glosses": [
                                            "Eigenschaft/Haltung/Handlungsweise, die in deutlichem Maße unbewegliches (immobiles) Verhalten zeigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c45ae6f3-88ed-41a6-ab96-052258e8c39d",
                                                "sense_id": "e3d2fd5f-93a3-3c88-819d-19c37e60139f",
                                                "text": "„Immer wieder kam es zu einer zeitweisen Immobilität der Truppen und zu schwerwiegenden Engpässen in ihrer Verpflegung.“"
                                            },
                                            {
                                                "example_id": "6d7a29e4-8e8d-41f3-8137-c683bd238588",
                                                "sense_id": "e3d2fd5f-93a3-3c88-819d-19c37e60139f",
                                                "text": "„Schwerer wiegt CA's Unfähigkeit zum Dialog, seine psychische Starre und seine geistige Immobilität.“"
                                            },
                                            {
                                                "example_id": "cc575f8e-3089-4182-99c5-b7e617bb53f1",
                                                "sense_id": "e3d2fd5f-93a3-3c88-819d-19c37e60139f",
                                                "text": "„Vielleicht war ihr Fluchtinstinkt durch die Immobilität der Schlaganfallpatienten über die Jahre ermattet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
