    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "ce57b7e4-72e2-3872-aa3b-f6f377aa4708",
                "word": "fuster",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "0a058b45-3c5f-466b-9a32-e5cd78ff530c",
                        "entry_id": "ce57b7e4-72e2-3872-aa3b-f6f377aa4708",
                        "tags": [
                            "plural"
                        ],
                        "form": "fusters"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "170cc88d-f5e1-3e58-a473-1aa66e283741",
                        "entry_id": "ce57b7e4-72e2-3872-aa3b-f6f377aa4708",
                        "glosses": [
                            "A saddle tree maker."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d41faedb-6a62-4cca-ad61-ecfa03e0bd78",
                                "sense_id": "170cc88d-f5e1-3e58-a473-1aa66e283741",
                                "text": "There were the Fusters, not to be confused with Fusters who wove fustians ; the Sadler's Fusters made the wooden frame for saddles, which used to be much more elaborate affairs than our modern saddles are."
                            },
                            {
                                "example_id": "a2e9e415-0b87-4bfa-9c67-cc8a0b278a43",
                                "sense_id": "170cc88d-f5e1-3e58-a473-1aa66e283741",
                                "text": "There were some leather-workers, as 4 or 5 curriers or tanners, 2 kissers, 6 or 7 saddlers or fusters."
                            },
                            {
                                "example_id": "78a1dae0-85e3-4f5f-b51d-c90ede19a987",
                                "sense_id": "170cc88d-f5e1-3e58-a473-1aa66e283741",
                                "text": "It was the task of the fusters, or joiners, to make the wooden saddlebows while the painters were employed to decorate the completed saddles."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "486c413f-afd8-3d61-8f5f-bea2c30261b4",
                "word": "fuster",
                "pos": "verb",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "bdf81e74-e94c-455e-9a6e-90959915465c",
                        "entry_id": "486c413f-afd8-3d61-8f5f-bea2c30261b4",
                        "tags": [
                            "present",
