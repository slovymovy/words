                "senses": [
                    {
                        "sense_id": "b72f0d32-4591-3869-b259-f632dcc132ed",
                        "entry_id": "ccbcbd37-543b-31be-b6a9-926a5d6ba9b9",
                        "glosses": [
                            "Einstellung, Gefahren/Risikos zu meiden"
                        ],
                        "tags": [
                            "Wirtschaftsjargon"
                        ],
                        "examples": [
                            {
                                "example_id": "91c4161f-514a-4424-9132-bba3d9a233f5",
                                "sense_id": "b72f0d32-4591-3869-b259-f632dcc132ed",
                                "text": "„Je nachdem, ob das Maß an Risikoaversion mit steigendem Ergebnisniveau zunimmt, gleich bleibt oder abnimmt, spricht man von zunehmender, konstanter oder abnehmender Risikoaversion.“"
                            },
                            {
                                "example_id": "dce614f1-a104-46f3-b53b-422a9f5ab10c",
                                "sense_id": "b72f0d32-4591-3869-b259-f632dcc132ed",
                                "text": "„Würde dieser Vorgang für mehrere Lotterien wiederholt, so ließen sich aus den ermittelten Sicherheitsäquivalenten die Nutzenfunktion und damit die Risikoaversion des Entscheiders abschätzen.“"
                            },
                            {
                                "example_id": "b3aca219-7f9b-47af-b135-bc7bbb05d315",
                                "sense_id": "b72f0d32-4591-3869-b259-f632dcc132ed",
                                "text": "„Bevor wir uns jedoch mit dem Markt für Versicherungen beschäftigen, müssen wir der Frage nachgehen, warum Menschen Risiko als nachteilig ansehen, eine Haltung, die von Ökonomen als Risikoaversion bezeichnet wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
