    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "f534a0d5-1aa1-3dd3-a5a6-732ef9bf4d77",
                "word": "bevor",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "4108cd69-f6c7-461c-9324-76b2250b2fdf",
                        "entry_id": "f534a0d5-1aa1-3dd3-a5a6-732ef9bf4d77",
                        "tags": [
                            "plural"
                        ],
                        "form": "bevors"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "223416a1-e432-3966-8a4d-aa7b433fc9d9",
                        "entry_id": "f534a0d5-1aa1-3dd3-a5a6-732ef9bf4d77",
                        "glosses": [
                            "A portion of plate armour to protect the lower face and the neck, typically in two parts, called upper bevor and lower bevor."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "3a89e97a-cb3d-45ef-8bac-d457d4c83b45",
                                "sense_id": "223416a1-e432-3966-8a4d-aa7b433fc9d9",
                                "text": "He who lookes you in the face, ſaith he ſees you, though the reſt of your bodie be within your cloathes, and if you, being an ὁωλομάχος a cataphract in your proteſtantiſh πανοπλία [panoplía, suit of armour] should for fear pull downe your beuer before you come into the liſt, your Aduerſarie for all that might light vpon your (  ) vnleſſe you bring with you Giges his ring, ſo to make your ſelf inuiſible; [...]"
                            },
                            {
                                "example_id": "8759f123-3dcb-45fd-841c-03141a557f9f",
                                "sense_id": "223416a1-e432-3966-8a4d-aa7b433fc9d9",
                                "text": "Since gorgets completely encircled the neck, they were usually more articulated than the bevors to allow for some movement of the neck and head. Bevors typically were open in back but extended up above the wearer′s jaw on the sides and front. Use of a bevor or a gorget depended upon the type of helmet the knight wore[…]."
                            },
                            {
                                "example_id": "adfe09c7-801f-4dc7-9383-044350e620f9",
                                "sense_id": "223416a1-e432-3966-8a4d-aa7b433fc9d9",
                                "text": "For heavy field use a reinforcing breastplate was sometimes added, together with a wrapper over the upper bevor."
                            },
                            {
                                "example_id": "c0658e0d-7876-4d3c-b8d3-26b4df9e1bbe",
                                "sense_id": "223416a1-e432-3966-8a4d-aa7b433fc9d9",
                                "text": "Many helmets had an upper part joined with hinges to a bevor, which protected the knight′s lower face and jaw."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d978b761-8539-45bb-ab1e-e88f1bc96e3c",
                        "source_entry_id": "f534a0d5-1aa1-3dd3-a5a6-732ef9bf4d77",
                        "source_sense_id": "223416a1-e432-3966-8a4d-aa7b433fc9d9",
                        "source_sense_description": "plate armour protecting the lower face and neck",
                        "target_lang_word": "bavière",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bavière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e103cedd-2cf4-3ef8-b8e9-bcbb8ca80b22",
                                        "entry_id": "c1fe52d9-e906-31e3-a703-c829f370291d",
                                        "glosses": [
                                            "Partie de l’armure destinée à protéger le cou et le menton."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59a0067f-24bf-442e-b023-e6358b2f21b6",
                                                "sense_id": "e103cedd-2cf4-3ef8-b8e9-bcbb8ca80b22",
                                                "text": "Quand l’armement de tête est la salade, comme au XVe siècle, la bavière est fixée à la partie supérieure de la cuirasse. Quand il s’agit de l'armet, la bavière fait partie du casque et est mobile autour des mêmes pivots que le mézail."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "320ebe94-8a1f-46a8-b5b1-c7b073f1baf8",
                        "source_entry_id": "f534a0d5-1aa1-3dd3-a5a6-732ef9bf4d77",
                        "source_sense_id": "223416a1-e432-3966-8a4d-aa7b433fc9d9",
                        "source_sense_description": "plate armour protecting the lower face and neck",
                        "target_lang_word": "Bart",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bart",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b8bcdae6-2a03-3092-9514-6aa5c45c31fb",
                                        "entry_id": "35f24fbe-5d97-397b-97e2-1d7d368ce451",
                                        "glosses": [
                                            "Haarbewuchs im Gesicht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c2f0c3a-458d-46a3-a1a2-92cd13fa2aef",
                                                "sense_id": "b8bcdae6-2a03-3092-9514-6aa5c45c31fb",
                                                "text": "Ich lasse mir einen Bart stehen."
                                            },
                                            {
                                                "example_id": "09110af3-8903-4a13-9807-f7bbbf8184d9",
                                                "sense_id": "b8bcdae6-2a03-3092-9514-6aa5c45c31fb",
                                                "text": "„Der alte, zerdrückte Filzhut war ihm vom Kopf gefallen, und das Haar stand struppig und ungekämmt empor; der borstige Bart schien eine Woche lang vernachlässigt zu sein, und ein sehr abgetragenes blauwollenes Jagdhemd, an dem einzelne einst gelb gewesene Fransen wild herabhingen, war mit alten wie neuen Blutflecken bedeckt.“"
                                            },
                                            {
                                                "example_id": "2a559354-64ab-46e0-b8a1-589cc7d2655a",
                                                "sense_id": "b8bcdae6-2a03-3092-9514-6aa5c45c31fb",
                                                "text": "„Der Firmengründer trug noch Kippa und Bart, sein Porträt hängt im Büro, seine Nachfahren sind typische Vertreter eines erfolgreich assimilierten Judentums.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3798373c-4944-37fb-9fbb-d1071b229264",
                                        "entry_id": "35f24fbe-5d97-397b-97e2-1d7d368ce451",
                                        "glosses": [
                                            "an Schlüsseln derjenige Teil, der in das Schloss passt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c4de73d-1298-43cf-b705-d68c48b5a71d",
                                                "sense_id": "3798373c-4944-37fb-9fbb-d1071b229264",
                                                "text": "Bis auf den Bart sind die Schlüssel gleich."
                                            },
                                            {
                                                "example_id": "c08bdc2c-238e-4ca3-a746-2d54b50a6fce",
                                                "sense_id": "3798373c-4944-37fb-9fbb-d1071b229264",
                                                "text": "„Dann entdeckte er ein quer liegendes Schlüsselloch, zu dem der Sonderschlüssel mit dem langen Bart paßte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "75d4a62d-5c52-3708-945b-2498e58cc539",
                                        "entry_id": "35f24fbe-5d97-397b-97e2-1d7d368ce451",
                                        "glosses": [
                                            "Grat oder Gussnaht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19a3512e-a18f-4c75-801d-0101f2bad686",
                                                "sense_id": "75d4a62d-5c52-3708-945b-2498e58cc539",
                                                "text": "Der Bart wird dann weggefeilt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "c8fb9d3b-a817-3701-abb9-6f1807528bb0",
                                        "entry_id": "35f24fbe-5d97-397b-97e2-1d7d368ce451",
                                        "glosses": [
                                            "im Orgelbau zwei Stücke aus Blech, durch deren Ein- oder Auswärtsbiegung eine Orgelpfeife gestimmt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f13d41f0-a329-47a9-8d23-81ca1078d4ec",
                                                "sense_id": "c8fb9d3b-a817-3701-abb9-6f1807528bb0",
                                                "text": "Die Bärte werden neben dem Aufschnitt angelötet und lenken den dort austretenden Wind."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "3acd10a4-7edf-33d3-b016-cc8d20c60b11",
                                        "entry_id": "35f24fbe-5d97-397b-97e2-1d7d368ce451",
                                        "glosses": [
                                            "Aufwind im Segelflug"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "701b8e02-4b1d-40bb-9b27-d30fe62cfade",
                                                "sense_id": "3acd10a4-7edf-33d3-b016-cc8d20c60b11",
                                                "text": "Im Bart bewegen sich die Segelflieger kreisend aufwärts und gewinnen so die nötige Höhe und Energie."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Bart",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "51e9fb6d-a617-3068-90ac-8b9dc7619c55",
                                        "entry_id": "9a4e8dc8-16b0-37fc-89db-5cf0689eb0f2",
