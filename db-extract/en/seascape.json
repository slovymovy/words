                    {
                        "translation_id": "8394342f-4579-4c3a-9902-6d4e9ef86dc8",
                        "source_entry_id": "1ef31721-7fcd-302c-bcd6-929670f1d7e4",
                        "source_sense_description": "a view of the sea",
                        "target_lang_word": "Meereslandschaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Meereslandschaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cb46c3bc-356c-3e28-ad70-ce7853f1dd4e",
                                        "entry_id": "3e4c1a51-3137-352f-aa65-27afc2f3f5b9",
                                        "glosses": [
                                            "vorwiegend durch das Meer geprägte Landschaft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a657f6c-1245-4725-9e61-58f42e99c9b6",
                                                "sense_id": "cb46c3bc-356c-3e28-ad70-ce7853f1dd4e",
                                                "text": "„Am Morgen brachte er das Feuer wieder in Gang, sie aßen und betrachteten das Ufer. So kalt und regnerisch, wie es anmutete, unterschied es sich nicht sehr von Meereslandschaften der nördlichen Welt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d508713e-a4c3-4caf-8d7c-e4cd2a5e624a",
                        "source_entry_id": "1ef31721-7fcd-302c-bcd6-929670f1d7e4",
                        "source_sense_description": "piece of art that depicts the sea or shoreline",
                        "target_lang_word": "marine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "marine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a1ccd3f8-c5a5-3fbe-92ee-f2eba641a23d",
                                        "entry_id": "a525844b-d115-3ccd-a04d-80eb91e9dbe0",
                                        "glosses": [
                                            "Ce qui concerne la navigation sur mer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39e28379-485c-4fbb-8553-f9004da6406e",
                                                "sense_id": "a1ccd3f8-c5a5-3fbe-92ee-f2eba641a23d",
                                                "text": "Avoir la vocation de la marine."
                                            },
                                            {
                                                "example_id": "1c7f187e-0e33-4541-8a86-39ddce01ed77",
                                                "sense_id": "a1ccd3f8-c5a5-3fbe-92ee-f2eba641a23d",
                                                "text": "Se passionner pour les choses de la marine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3df8433-e73b-36bc-9f40-22ca33115de2",
                                        "entry_id": "a525844b-d115-3ccd-a04d-80eb91e9dbe0",
                                        "glosses": [
                                            "Service de mer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "550872a2-95c8-47cf-ab80-a9355e75b9c7",
                                                "sense_id": "f3df8433-e73b-36bc-9f40-22ca33115de2",
                                                "text": "Lui-même, à son dernier congé, en plaisantait devant moi, d’être un gradé de la marine qui, comme le petit navire de la chanson, n’avait ja-ja-jamais navigué."
                                            },
                                            {
                                                "example_id": "89c55452-ab57-4d12-94d8-d6f1525a9e77",
                                                "sense_id": "f3df8433-e73b-36bc-9f40-22ca33115de2",
                                                "text": "Commissaire de la marine."
                                            },
                                            {
                                                "example_id": "a654ee36-9dbc-4952-a82a-b2933eb57441",
                                                "sense_id": "f3df8433-e73b-36bc-9f40-22ca33115de2",
                                                "text": "Servir dans la marine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19a80bc2-9a82-3dbf-9ae8-d3b049cb47ad",
                                        "entry_id": "a525844b-d115-3ccd-a04d-80eb91e9dbe0",
                                        "glosses": [
                                            "Armée de mer ; forces navales."
                                        ],
                                        "tags": [
                                            "collective"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3c56e35-5161-4bb4-8fcf-0a725a26d1db",
                                                "sense_id": "19a80bc2-9a82-3dbf-9ae8-d3b049cb47ad",
                                                "text": "Deux mots encore sur la marine marocaine, cette marine si redoutée, autrefois, quand les corsaires barbaresques infestaient les eaux européennes, étendant leurs déprédations à tout le littoral méditerranéen et jusqu’aux côtes de l’Angleterre."
                                            },
                                            {
                                                "example_id": "b46f663f-3bc7-447f-bae0-1f44cd0bfc37",
                                                "sense_id": "19a80bc2-9a82-3dbf-9ae8-d3b049cb47ad",
                                                "text": "[…] mais, il est traditionnel dans la Marine française qu’un Commandant peut transgresser les ordres et courir tous les risques pour secourir des vies en danger."
                                            },
                                            {
                                                "example_id": "3cab7e2e-20cc-4ac0-a9e6-1a3801f468ae",
                                                "sense_id": "19a80bc2-9a82-3dbf-9ae8-d3b049cb47ad",
                                                "text": "Le tatouage, en effet, est une institution dans la marine américaine et des heures de service sont spécialement réservées à ce divertissement artistique."
                                            },
                                            {
                                                "example_id": "7a180d2d-5d42-4060-a2ff-ecfd14b2c4a3",
                                                "sense_id": "19a80bc2-9a82-3dbf-9ae8-d3b049cb47ad",
                                                "text": "[…] les Sarrazins qui s’étaient assurés de la maîtrise de la Méditerranée, avaient provoqué la ruine du commerce français et il faudra attendre jusqu’aux Croisades pour voir la marine française reconquérir la libre circulation sur la mer."
                                            },
                                            {
                                                "example_id": "33c99590-ddc5-4adf-8bd3-5fae3b6f2aa0",
                                                "sense_id": "19a80bc2-9a82-3dbf-9ae8-d3b049cb47ad",
                                                "text": "La ploutocratie chilienne s’était appuyée sur deux forces : les milieux réactionnaires de la Marine et les intérêts impérialistes britanniques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a95597b-fc01-304b-84ee-3caa44f9afe2",
                                        "entry_id": "a525844b-d115-3ccd-a04d-80eb91e9dbe0",
                                        "glosses": [
                                            "Partie du port où se tient l’administration du port."
                                        ],
                                        "tags": [
                                            "Navigation"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6b2608d5-0033-354a-9f9a-9ea22f8b3651",
                                        "entry_id": "a525844b-d115-3ccd-a04d-80eb91e9dbe0",
                                        "glosses": [
                                            "Partie du port où se font les arrivages et marchés de poisson."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "93314907-e671-341b-b188-22fb5995d281",
                                        "entry_id": "a525844b-d115-3ccd-a04d-80eb91e9dbe0",
                                        "glosses": [
                                            "Tableau représentant un port de mer, ou quelque vue de la mer."
                                        ],
                                        "tags": [
                                            "Peinture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "188474de-ba33-481f-aaa7-2a8a0fff1c4f",
                                                "sense_id": "93314907-e671-341b-b188-22fb5995d281",
                                                "text": "Joseph Vernet a excellé dans les marines."
                                            },
                                            {
                                                "example_id": "4dca648c-9851-470c-94bb-9170829fafd1",
                                                "sense_id": "93314907-e671-341b-b188-22fb5995d281",
                                                "text": "Un peintre de marines."
                                            },
                                            {
                                                "example_id": "4d24bc2b-fa37-4928-bcf9-bbed15fd7054",
                                                "sense_id": "93314907-e671-341b-b188-22fb5995d281",
                                                "text": "Mais les rares moments où l’on voit la nature telle qu’elle est, poétiquement, c’était de ceux-là qu’était faite l’œuvre d’Elstir. Une de ses métaphores les plus fréquentes dans les marines qu’il avait près de lui en ce moment était justement celle qui, comparant la terre à la mer, supprimait entre elles toute démarcation."
                                            },
                                            {
                                                "example_id": "5f494dc3-2ee3-491a-987a-9cb513e36181",
                                                "sense_id": "93314907-e671-341b-b188-22fb5995d281",
                                                "text": "29 juin 44 – Exposition de « marines » à la galerie Charpentier. Que de chapeaux ! Il y avait plus de chapeaux que de toiles."
                                            },
                                            {
                                                "example_id": "683b420c-76a1-4891-8cf3-b13c00c40210",
                                                "sense_id": "93314907-e671-341b-b188-22fb5995d281",
                                                "text": "« Tu n’es pas sans avoir entendu parler de mon vieux camarade, Van Marius, dit-il, Van Marius, le fameux peintre de marines, qui comprenait la mer comme Ruysdaël comprenait la campagne, Van Ostade le village, Rembrandt les intérieurs sombres, Rubens les temples et les palais. Ah ! c’était un grand peintre ; en face de ses tableaux, on ne disait pas : « C’est beau ! » On disait : « Que la mer est belle !… qu’elle est grande et terrible ! » — On ne voyait pas le pinceau de Van Marius aller et venir ; mais l’ombre de la main de Dieu s’étendre sur la toile. Oh ! le génie… le génie… quel don sublime, Christian ! »"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "marine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0025825b-9429-3af4-91f0-ee64128ced06",
                                        "entry_id": "b0ff42d2-58e6-3b4c-9828-dd4fb45a39dd",
                                        "glosses": [
                                            "Soldat de l’US Marine Corps, qui est une branche distincte de l’US Navy. Fusilier marin américain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e10b7f7-e753-4deb-aed3-c2c20901dacd",
                                                "sense_id": "0025825b-9429-3af4-91f0-ee64128ced06",
                                                "text": "Les marines ont leurs propres uniformes de combat ou de cérémonie, bien distincts des autres corps, ce qui leur confère une place à part au sein des autres forces armées de la nation."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
