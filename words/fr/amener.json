    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "447dadae-da0e-3bf5-9bc8-92181903f7d0",
                    "sense_definition": "Faire venir quelqu'un ou quelque chose avec soi vers un lieu.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle <w>amène</w> tous les matins ses deux enfants à l'école à pied."
                        },
                        {
                            "text": "Tu peux m'<w>amener</w> à la gare avant le départ du train ?"
                        }
                    ],
                    "synonyms": [
                        "conduire",
                        "emmener",
                        "mener"
                    ]
                },
                {
                    "sense_id": "2770ec9b-9413-3c45-b390-1b88a02e442f",
                    "sense_definition": "Avoir pour effet ou pour conséquence directe ; provoquer l'apparition de quelque chose.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "consequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette nouvelle loi va <w>amener</w> de profonds changements dans le fonctionnement des entreprises."
                        },
                        {
                            "text": "Ces pluies torrentielles risquent d'<w>amener</w> des inondations dans toute la vallée."
                        }
                    ],
                    "common_phrases": [
                        "amener des changements",
                        "être amené à"
                    ]
                },
                {
                    "sense_id": "740c1056-2639-3272-8c12-3002e2007e99",
                    "sense_definition": "Persuader ou disposer quelqu'un à adopter une idée, une décision ou une attitude.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "persuasion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous avons réussi à les <w>amener</w> à accepter un compromis raisonnable après de longues discussions."
                        },
                        {
                            "text": "Ses arguments convaincants ont fini par <w>amener</w> ses collègues à changer complètement d'avis."
                        }
                    ],
                    "common_phrases": [
                        "amener à la raison"
                    ]
                },
                {
                    "sense_id": "53bf6928-475d-37dd-ab8d-9eab36c7c5b8",
                    "sense_definition": "Arriver, venir quelque part.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mouvement_familier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dépêche-toi et <w>amène</w>-toi vite avant qu'il ne commence à pleuvoir !"
                        },
                        {
                            "text": "Après une longue attente, le voisin s'<w>amène</w> enfin avec ses outils de jardinage."
                        }
                    ],
                    "common_phrases": [
                        "amène-toi"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier"
                        }
                    ]
                },
                {
                    "sense_id": "93fb300e-76e7-32c8-86b7-560acc6464c4",
                    "sense_definition": "Abaisser ou faire descendre un cordage, une voile ou un pavillon.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "marine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À l'approche du port, l'équipage a dû <w>amener</w> la grande voile pour ralentir le bateau."
                        },
                        {
                            "text": "Le capitaine vaincu donna l'ordre solennel d'<w>amener</w> le pavillon national."
                        }
                    ],
                    "common_phrases": [
                        "amener le pavillon"
                    ]
                }
            ]
        }
    ]
}