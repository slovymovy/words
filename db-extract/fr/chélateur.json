                        "glosses": [
                            "Agent chélateur."
                        ],
                        "tags": [
                            "Pharmacie"
                        ],
                        "examples": [
                            {
                                "example_id": "00d44025-be1e-4f4d-9679-593b6eb0df53",
                                "sense_id": "9ed865f2-faea-38e3-bf8b-e7abdfaf02e5",
                                "text": "L’hyperaccumulation reposerait quant à elle sur la synthèse de chélateurs intracellulaires, molécules capables de se lier aux métaux et de les immobiliser."
                            },
                            {
                                "example_id": "ebef042b-adf1-48f0-803c-1871fa28d08c",
                                "sense_id": "9ed865f2-faea-38e3-bf8b-e7abdfaf02e5",
                                "text": "Il peut également résulter de l'utilisation de chélateurs de fer : la géophagie de certaines femmes africaines, la pagophagie (consommation de glaçons)... ou la consommation importante de thé des anglaises."
                            }
                        ]
                    }
