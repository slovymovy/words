                                        "entry_id": "98f7d2b9-4f7e-32c7-ad45-b1cc3fae361f",
                                        "glosses": [
                                            "A sailing vessel of three or more masts, with all masts but the sternmost square-rigged, the sternmost being fore-and-aft-rigged"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca9b2ca5-f457-4466-8470-7a674b5380ca",
                                                "sense_id": "5c93eab8-6d44-3699-904c-f48116947b33",
                                                "text": "On being told, however, that the Norwegian barque Daphne was about to leave An-peng for Tamsui, I had my things taken on board, and we set sail a few hours later."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70c70c62-2423-39c6-a99e-b2e146b83161",
                                        "entry_id": "98f7d2b9-4f7e-32c7-ad45-b1cc3fae361f",
