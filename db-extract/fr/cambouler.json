                "senses": [
                    {
                        "sense_id": "adecd704-568f-3313-8a46-95c421f744e5",
                        "entry_id": "dcb02de2-897a-3281-829b-cf449df228d9",
                        "glosses": [
                            "Transporter."
                        ],
                        "tags": [
                            "Sud de la France"
                        ],
                        "examples": [
                            {
                                "example_id": "5d3135d0-1050-44cf-942f-61dc0cc05c6a",
                                "sense_id": "adecd704-568f-3313-8a46-95c421f744e5",
                                "text": "J’ai fini à Toulon. Vous voyez ? Hôtesse de bar. Et j’en suis partie un jour avec un marin qui m’a camboulée, et qui m’a laissée à Conakry, et me voilà ici, je n’en sais rien pourquoi."
                            },
                            {
                                "example_id": "1fcb38d1-e0d2-4542-a1d8-8f276e33fc25",
                                "sense_id": "adecd704-568f-3313-8a46-95c421f744e5",
                                "text": "D’ailleurs nous vous avions camboulée jusque dans le désert pour s’apercevoir que vous y étiez déjà allée, comme l’atteste le livre \"Drôle de Sahara\" que nous avons trouvé dans un kiosque à touristes de Djerba!"
                            }
                        ]
                    }
