{
    "word_family": [
        "challenger",
        "challenging",
        "unchallenged"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7ba94121-3688-3edb-a2ed-e871d0cba9af",
                    "sense_definition": "A difficult task or situation that tests someone's abilities and is often seen as an opportunity.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "difficulty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Learning a new language is a big <w>challenge</w> but it is very rewarding.",
                            "target_lang_translations": {
                                "ru": "Изучение нового языка — это серьезный <w>вызов</w>, но это приносит большое удовлетворение.",
                                "zh": "学习一门新语言是一个巨大的<w>挑战</w>，但非常有意义。"
                            }
                        },
                        {
                            "text": "The team faced a major <w>challenge</w> when their lead developer left the project.",
                            "target_lang_translations": {
                                "ru": "Команда столкнулась с серьезным <w>испытанием</w>, когда их ведущий разработчик покинул проект.",
                                "zh": "当首席开发人员离开项目时，团队面临了一个重大的<w>挑战</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "call out"
                    ],
                    "antonyms": [
                        "breeze",
                        "cinch"
                    ],
                    "common_phrases": [
                        "major challenge",
                        "face a challenge",
                        "accept a challenge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Трудная задача или ситуация, которая проверяет способности человека и часто рассматривается как возможность.",
                        "zh": "一项困难的任务或情况，旨在考验某人的能力，通常被视为一种机遇。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вызов",
                                "target_lang_sense_clarification": "трудная проблема, требующая усилий"
                            },
                            {
                                "target_lang_word": "испытание",
                                "target_lang_sense_clarification": "проверка сил или способностей"
                            },
                            {
                                "target_lang_word": "трудная задача",
                                "target_lang_sense_clarification": "сложное поручение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "挑战",
                                "target_lang_sense_clarification": "需要克服的困难或考验"
                            },
                            {
                                "target_lang_word": "难题",
                                "target_lang_sense_clarification": "难以解决的问题"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ee5de481-a5e9-3893-bbc1-fea196eb36df",
                    "sense_definition": "An invitation or a bid to compete against someone or to overcome an obstacle.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "confrontation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young boxer issued a <w>challenge</w> to the current world champion.",
                            "target_lang_translations": {
                                "ru": "Молодой боксер бросил <w>вызов</w> действующему чемпиону мира.",
                                "zh": "这位年轻的拳击手向现任世界冠军发出了<w>挑战</w>。"
                            }
                        },
                        {
                            "text": "He decided to take up the <w>challenge</w> and run the marathon next year.",
                            "target_lang_translations": {
                                "ru": "Он решил принять <w>вызов</w> и пробежать марафон в следующем году.",
                                "zh": "他决定接受这个<w>挑战</w>，参加明年的马拉松比赛。"
                            }
                        }
                    ],
                    "synonyms": [
                        "call out",
                        "becall"
                    ],
                    "common_phrases": [
                        "take up the challenge",
                        "issue a challenge",
                        "direct challenge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приглашение или предложение вступить в состязание с кем-либо или преодолеть препятствие.",
                        "zh": "邀请或提议与某人竞争，或要求克服某种障碍。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вызов",
                                "target_lang_sense_clarification": "приглашение к состязанию или борьбе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "挑战",
                                "target_lang_sense_clarification": "向某人发出竞争邀请"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1c80f532-de26-312e-a891-46d32f42dea1",
                    "sense_definition": "A formal objection or an appeal against a legal ruling, decision, or authority.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer filed a legal <w>challenge</w> against the new government policy.",
                            "target_lang_translations": {
                                "ru": "Адвокат подал судебный <w>протест</w> против новой политики правительства.",
                                "zh": "律师针对政府的新政策提起了法律<w>质疑</w>。"
                            }
                        },
                        {
                            "text": "There was a <w>challenge</w> to the king's authority from the local lords.",
                            "target_lang_translations": {
                                "ru": "Местные лорды бросили <w>вызов</w> власти короля.",
                                "zh": "当地领主对国王的权威发起了<w>挑战</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "call out"
                    ],
                    "antonyms": [
                        "acceptance",
                        "agreement"
                    ],
                    "common_phrases": [
                        "legal challenge",
                        "court challenge",
                        "constitutional challenge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Формальное возражение или апелляция против судебного решения, постановления или власти.",
                        "zh": "针对法律裁决、决定或权威提出的正式反对或上诉。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оспаривание",
                                "target_lang_sense_clarification": "правовой протест или возражение"
                            },
                            {
                                "target_lang_word": "вызов",
                                "target_lang_sense_clarification": "несогласие с авторитетом или властью"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "质疑",
                                "target_lang_sense_clarification": "对权威或决定的怀疑与反对"
                            },
                            {
                                "target_lang_word": "挑战",
                                "target_lang_sense_clarification": "对既定规则或权力的对抗"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "29c44e0a-27cc-3cbb-ab64-22a6e1244276",
                    "sense_definition": "The act of a sentry or security system demanding identification or a password.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "security",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldier gave a loud <w>challenge</w> when he heard someone approaching the gate.",
                            "target_lang_translations": {
                                "ru": "Солдат громко <w>окликнул</w>, услышав, что кто-то приближается к воротам.",
                                "zh": "当听到有人靠近大门时，士兵大声地进行了<w>盘问</w>。"
                            }
                        },
                        {
                            "text": "The computer system issued a security <w>challenge</w> asking for a secondary password.",
                            "target_lang_translations": {
                                "ru": "Система безопасности выдала <w>запрос</w> на ввод дополнительного пароля.",
                                "zh": "计算机系统发出了安全<w>验证</w>，要求输入辅助密码。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "security challenge",
                        "sentry challenge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие часового или системы безопасности, требующее идентификации или пароля.",
                        "zh": "哨兵或安全系统要求身份验证或密码的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опрос",
                                "target_lang_sense_clarification": "требование пароля или опознавания"
                            },
                            {
                                "target_lang_word": "оклик",
                                "target_lang_sense_clarification": "требование часового остановиться и назваться"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "盘问",
                                "target_lang_sense_clarification": "哨兵要求来人表明身份"
                            },
                            {
                                "target_lang_word": "验证",
                                "target_lang_sense_clarification": "系统要求输入凭证"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bda5d2b8-fed2-3f1f-a506-331bd28a01a4",
                    "sense_definition": "In sports, an attempt to take the ball away from an opponent; a tackle.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The defender made a late <w>challenge</w> and was lucky not to get a yellow card.",
                            "target_lang_translations": {
                                "ru": "Защитник совершил запоздалый <w>подкат</w>, и ему повезло не получить желтую карточку.",
                                "zh": "防守队员进行了一次迟到的<w>抢断</w>，很幸运没有吃到黄牌。"
                            }
                        },
                        {
                            "text": "He surged past four <w>challenges</w> to fire the ball into the net.",
                            "target_lang_translations": {
                                "ru": "Он прорвался сквозь четыре <w>попытки отбора</w> и отправил мяч в сетку.",
                                "zh": "他突破了四次<w>抢断</w>，将球射入网中。"
                            }
                        }
                    ],
                    "synonyms": [
                        "becall"
                    ],
                    "common_phrases": [
                        "late challenge",
                        "sliding challenge",
                        "fair challenge"
                    ],
                    "target_lang_definitions": {
                        "ru": "В спорте: попытка отобрать мяч у соперника; подкат.",
                        "zh": "在体育运动中，试图从对手脚下抢球；铲球。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отбор",
                                "target_lang_sense_clarification": "попытка забрать мяч"
                            },
                            {
                                "target_lang_word": "единоборство",
                                "target_lang_sense_clarification": "борьба за мяч"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "抢断",
                                "target_lang_sense_clarification": "试图夺取球权"
                            },
                            {
                                "target_lang_word": "铲球",
                                "target_lang_sense_clarification": "通过滑铲动作争抢球"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "059a5236-9e7b-3186-8c2c-bc458134b0c5",
                    "sense_definition": "To invite someone to take part in a competition or a fight.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "confrontation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We <w>challenged</w> the boys next door to a game of football.",
                            "target_lang_translations": {
                                "ru": "Мы <w>вызвали</w> соседских мальчишек на футбольный матч.",
                                "zh": "我们<w>挑战</w>隔壁的男孩们进行一场足球赛。"
                            }
                        },
                        {
                            "text": "She <w>challenged</w> him to a race across the park.",
                            "target_lang_translations": {
                                "ru": "Она <w>вызвала</w> его на соревнование по бегу через парк.",
                                "zh": "她<w>挑战</w>他进行一场穿过公园的赛跑。"
                            }
                        }
                    ],
                    "synonyms": [
                        "call out"
                    ],
                    "common_phrases": [
                        "challenge to a duel",
                        "challenge to a game"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пригласить кого-либо принять участие в соревновании или поединке.",
                        "zh": "邀请某人参加比赛或决斗。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вызывать",
                                "target_lang_sense_clarification": "предлагать состязание"
                            },
                            {
                                "target_lang_word": "бросать вызов",
                                "target_lang_sense_clarification": "предлагать вступить в борьбу"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "挑战",
                                "target_lang_sense_clarification": "邀请对方进行竞争"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f2470724-2c4a-3300-ab55-575736753d10",
                    "sense_definition": "To question the truth or validity of something; to dispute.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "dispute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>challenge</w> the accuracy of the report if you find errors.",
                            "target_lang_translations": {
                                "ru": "Вам следует <w>оспорить</w> точность отчета, если вы найдете ошибки.",
                                "zh": "如果你发现错误，你应该<w>质疑</w>这份报告的准确性。"
                            }
                        },
                        {
                            "text": "The scientist <w>challenged</w> the old theory with new evidence from her research.",
                            "target_lang_translations": {
                                "ru": "Ученая <w>поставила под сомнение</w> старую теорию, представив новые доказательства своего исследования.",
                                "zh": "这位科学家用她研究中的新证据<w>挑战</w>了旧理论。"
                            }
                        }
                    ],
                    "synonyms": [
                        "call out"
                    ],
                    "antonyms": [
                        "accept",
                        "confirm"
                    ],
                    "common_phrases": [
                        "challenge the status quo",
                        "challenge the validity",
                        "challenge the findings"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ставить под сомнение истинность или обоснованность чего-либо; оспаривать.",
                        "zh": "对某事的真实性或有效性提出疑问；提出异议。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оспаривать",
                                "target_lang_sense_clarification": "выступать с опровержением"
                            },
                            {
                                "target_lang_word": "подвергать сомнению",
                                "target_lang_sense_clarification": "сомневаться в правильности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "质疑",
                                "target_lang_sense_clarification": "对某事的正确性表示怀疑"
                            },
                            {
                                "target_lang_word": "挑战",
                                "target_lang_sense_clarification": "对既定观点或权威提出异议"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "35a67da2-9215-3ded-9501-a61faba9cba8",
                    "sense_definition": "To be difficult for someone or to test their abilities.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "difficulty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The complex math problem <w>challenged</w> even the most advanced students.",
                            "target_lang_translations": {
                                "ru": "Сложная математическая задача стала настоящим <w>испытанием</w> даже для самых продвинутых учеников.",
                                "zh": "这道复杂的数学题<w>考验</w>了即使是最优秀的学生。"
                            }
                        },
                        {
                            "text": "This new role will <w>challenge</w> you to develop better leadership skills.",
                            "target_lang_translations": {
                                "ru": "Эта новая роль <w>заставит</w> вас развивать лидерские качества.",
                                "zh": "这个新职位将<w>考验</w>你，促使你发展更好的领导能力。"
                            }
                        }
                    ],
                    "antonyms": [
                        "bore"
                    ],
                    "common_phrases": [
                        "challenge the mind",
                        "challenge the imagination"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть трудным для кого-либо или проверять чьи-либо способности.",
                        "zh": "对某人来说具有难度，或考验其能力。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бросать вызов",
                                "target_lang_sense_clarification": "требовать полной отдачи сил"
                            },
                            {
                                "target_lang_word": "испытывать",
                                "target_lang_sense_clarification": "проверять на прочность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "考验",
                                "target_lang_sense_clarification": "测试某人的能力极限"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6b71d088-73d8-3aa4-ab1a-56210cd08eb7",
                    "sense_definition": "To demand identification or a password from someone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "security",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The guard <w>challenged</w> us with a firm Who goes there as we approached.",
                            "target_lang_translations": {
                                "ru": "Когда мы подошли, охранник <w>окликнул</w> нас строгим «Кто идет?».",
                                "zh": "当我们靠近时，警卫严厉地<w>盘问</w>我们：“谁在那儿？”"
                            }
                        },
                        {
                            "text": "Security protocols require the system to <w>challenge</w> any unrecognized user.",
                            "target_lang_translations": {
                                "ru": "Протоколы безопасности требуют, чтобы система <w>запрашивала идентификацию</w> у любого нераспознанного пользователя.",
                                "zh": "安全协议要求系统对任何未识别的用户进行<w>核实</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "challenge a visitor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Требовать идентификацию или пароль у кого-либо.",
                        "zh": "要求某人提供身份证明或密码。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "окликать",
                                "target_lang_sense_clarification": "требовать назваться (о часовом)"
                            },
                            {
                                "target_lang_word": "запрашивать данные",
                                "target_lang_sense_clarification": "требовать пароль (о системе)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "盘问",
                                "target_lang_sense_clarification": "要求来人表明身份"
                            },
                            {
                                "target_lang_word": "核实",
                                "target_lang_sense_clarification": "要求提供凭证以确认身份"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "895b2076-bd4e-3dd8-98b5-f5e4041e12c8",
                    "sense_definition": "To take an exam to prove proficiency in a subject without taking the full course.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "education",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you already know the material, you can <w>challenge</w> the exam for credit.",
                            "target_lang_translations": {
                                "ru": "Если вы уже знаете материал, вы можете <w>сдать</w> экзамен экстерном для получения зачета.",
                                "zh": "如果你已经掌握了这些材料，你可以通过<w>免修考试</w>来获得学分。"
                            }
                        },
                        {
                            "text": "He decided to <w>challenge</w> the final exam instead of attending the lectures.",
                            "target_lang_translations": {
                                "ru": "Он решил <w>сдать</w> итоговый экзамен экстерном вместо посещения лекций.",
                                "zh": "他决定通过<w>免修考试</w>来代替参加讲座。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "challenge an exam",
                        "challenge for credit"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "North America"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сдать экзамен для подтверждения знаний по предмету без прохождения полного курса обучения.",
                        "zh": "无需修读完整课程，直接参加考试以证明对某学科的掌握程度。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сдавать экстерном",
                                "target_lang_sense_clarification": "сдавать экзамен без посещения занятий"
                            }
                        ],
