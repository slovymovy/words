                                        "sense_id": "27243cf1-3681-3136-b6a1-e6c47cba2600",
                                        "entry_id": "839fbc30-20e8-3b06-9ba0-a63e55dd02e6",
                                        "glosses": [
                                            "Himmelsrichtung (Haupthimmelsrichtung), die Westen gegenüber und zwischen Norden und Süden liegt; Himmelsrichtung, die zur aufgehenden Sonne zeigt"
                                        ],
                                        "tags": [
                                            "geography"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ebe682e7-63cd-41af-8e46-405e6a74fc74",
                                                "sense_id": "27243cf1-3681-3136-b6a1-e6c47cba2600",
                                                "text": "Im Osten geht die Sonne auf."
                                            },
                                            {
                                                "example_id": "29d0ca9c-7734-47ce-a4f1-4bc6f4fcfaf6",
                                                "sense_id": "27243cf1-3681-3136-b6a1-e6c47cba2600",
                                                "text": "„Im Osten flammte ein schmaler, heller Streifen über der Kimm auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b381dd30-2215-3d1b-b55b-d93b5beaf13a",
                                        "entry_id": "839fbc30-20e8-3b06-9ba0-a63e55dd02e6",
                                        "glosses": [
                                            "Bezeichnung größerer geografischer Gebiete"
                                        ],
                                        "tags": [
                                            "geography"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d72f287-9b47-40a7-b1fc-8c832fc40d6d",
                                                "sense_id": "b381dd30-2215-3d1b-b55b-d93b5beaf13a",
                                                "text": "Der Nahe Osten kommt nicht zur Ruhe."
                                            },
                                            {
                                                "example_id": "08c03f8a-6586-49f7-9d63-bd351951721e",
                                                "sense_id": "b381dd30-2215-3d1b-b55b-d93b5beaf13a",
                                                "text": "Der Osten Deutschlands war während der Zeit der Teilung Deutschlands beziehungsweise des Kalten Krieges die DDR."
                                            },
                                            {
                                                "example_id": "850c4ca0-6858-415c-b7ef-13c0c4799519",
                                                "sense_id": "b381dd30-2215-3d1b-b55b-d93b5beaf13a",
                                                "text": "„Außerdem und vor allem betätigte er sich im Osten wie im Westen als ein europäischer Kriegsunternehmer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "8afc052d-8ac7-3d2e-be6e-40659bf03028",
                                        "entry_id": "839fbc30-20e8-3b06-9ba0-a63e55dd02e6",
                                        "glosses": [
                                            "Gebiete, die zu den Ländern des Warschauer Paktes gehörten"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "806fd804-701a-42de-8661-c65ed7282b36",
                                                "sense_id": "8afc052d-8ac7-3d2e-be6e-40659bf03028",
                                                "text": "Bei einem Stoß des Ostens durch Innerösterreich Richtung Italien hätte der Osten davon auszugehen, dass alle nach Kärnten führenden Straßen verteidigt werden."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
