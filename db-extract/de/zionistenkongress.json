                ],
                "senses": [
                    {
                        "sense_id": "2563fb43-3c0e-38ea-a29f-0b16608e993b",
                        "entry_id": "a98b0560-8e0b-3afe-997d-3bea4a01b5e0",
                        "glosses": [
                            "Kongress von Vertretern und Anhängern des Zionismus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d094564-0e47-4318-9ad4-d31c965ea2af",
                                "sense_id": "2563fb43-3c0e-38ea-a29f-0b16608e993b",
                                "text": "„Er war der erste Delegierte, der beim ersten Zionistenkongress 1897 eine Rede auf Hebräisch hielt, er gehörte zu den Gründungsvätern der zionistischen Organisation in Palästina; eine seiner Töchter heiratete den Sohn des einflussreichen Schriftstellers und Philosophen Achad Ha’am, eine andere Dr. Arthur Ruppin, der in der zionistischen Siedlungsbewegung eine wichtige Rolle spielte.“"
                            },
                            {
                                "example_id": "19a51348-13fc-4528-b6e5-728f3005dcf6",
                                "sense_id": "2563fb43-3c0e-38ea-a29f-0b16608e993b",
                                "text": "„Der 1901 vom 5. Zionistenkongress gegründete Jüdische Nationalfonds war das Hauptinstrument der Zionisten für die Kolonisierung Palästinas.“"
                            },
                            {
                                "example_id": "4ad58197-eaee-4d61-bc94-074550610bac",
                                "sense_id": "2563fb43-3c0e-38ea-a29f-0b16608e993b",
                                "text": "„Mehr als hundertzwanzig Jahre nach dem ersten Zionistenkongress in Basel und über siebzig Jahre nach der Gründung Israels sollte das palästinensische Volk, das bei keiner dieser Gelegenheiten vertreten war, als Nation nicht mehr präsent sein.“"
                            },
                            {
                                "example_id": "8065d4a4-09b7-4451-bb07-0189e873ee24",
                                "sense_id": "2563fb43-3c0e-38ea-a29f-0b16608e993b",
                                "text": "„Rothschild jedenfalls war damals in Zionistenkreisen keineswegs der Einzige, den der Gedanke vom Wiederaufbau des Jerusalemer Tempels umtrieb. Schon im Vorfeld des Ersten Zionistenkongresses in Basel im August 1897 machte sich einer der Mitorganisatoren für diese Idee stark: der mit dem Gründungsvater des politischen Zionismus Theodor Herzl eng befreundeter Wiener Architekt Oskar Marmorek.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
