                                        "examples": [
                                            {
                                                "example_id": "c016e2b1-9cda-4973-b2e2-a89be7d53210",
                                                "sense_id": "2bd8ba61-3745-3f5a-b335-b0f02fd8c0ba",
                                                "text": "\"To the doctor's? Bah!\" said the sorceress, and spat upon the floor."
                                            },
                                            {
                                                "example_id": "4f876980-7773-46f9-9ff5-30545435d3b0",
                                                "sense_id": "2bd8ba61-3745-3f5a-b335-b0f02fd8c0ba",
                                                "text": "“Bah!” cried the woman. “My husband will know!”"
                                            },
                                            {
                                                "example_id": "a2ecfc47-76c0-415e-9ebb-ab71fe695972",
                                                "sense_id": "2bd8ba61-3745-3f5a-b335-b0f02fd8c0ba",
                                                "text": "Templeton looked over the assembled servants speculatively, then shrugged. \"Bah!\" he said. \"They're of no use to me. Come, Andrew, a word with you upstairs.\""
                                            }
                                        ]
                                    }
