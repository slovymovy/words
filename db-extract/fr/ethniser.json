                "senses": [
                    {
                        "sense_id": "39b42d78-3e3e-399c-9e6b-db57a526dd97",
                        "entry_id": "7ab3161f-fd2f-3a1c-9451-f69dc9610112",
                        "glosses": [
                            "Donner un caractère ethnique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2cd76966-107d-451a-a3a8-d1d15e94a759",
                                "sense_id": "39b42d78-3e3e-399c-9e6b-db57a526dd97",
                                "text": "Plus encore, l’impossible mise en place des institutions de transition semble justifiée par cette volonté outrancière d’ethniser institutionnellement le Burundi."
                            },
                            {
                                "example_id": "b2f02a93-c43b-4991-8c6b-2c3a7d3fb834",
                                "sense_id": "39b42d78-3e3e-399c-9e6b-db57a526dd97",
                                "text": "Cela a été observé, au Rwanda en 1989 et au Burundi en 1993, où le débat politique a dévié de son idéal démocratique de confrontation de projets de société et de programmes politiques pour s’ethniser."
                            }
                        ]
                    }
