                ],
                "senses": [
                    {
                        "sense_id": "c07314e3-336c-3405-bad2-7235495cfb86",
                        "entry_id": "c39084bb-d288-33f0-9a51-2cf24df5be5a",
                        "glosses": [
                            "A little bird; especially, a baby bird."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7b72f7b-77d4-4be0-922f-ecf84cdb5e90",
                                "sense_id": "c07314e3-336c-3405-bad2-7235495cfb86",
                                "text": "Near-synonyms: birdlet, birdie, birb; chick, nestling, fledgling"
                            },
                            {
                                "example_id": "66fac1dd-9d55-4090-b6e8-7fa1b5a9ccb2",
                                "sense_id": "c07314e3-336c-3405-bad2-7235495cfb86",
                                "text": "Clasped, love, close to thy heart, thy birdling Foldeth her wings in peace-- Trusts, love! feeling nor cold nor shadow, Finding at last her ease, From fear a safe release, Heart's love, with thee.\""
                            },
                            {
                                "example_id": "be6b5da6-fd21-40e6-a171-237a1847dc4a",
                                "sense_id": "c07314e3-336c-3405-bad2-7235495cfb86",
                                "text": "Nay, fear not, birdling! let me gently Uplift and hold thee in my hand; Thou gazest on me so intently, Thou must my motive understand."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "40fec1f6-6d47-4e08-a389-15f93a7445f8",
                        "source_entry_id": "c39084bb-d288-33f0-9a51-2cf24df5be5a",
                        "source_sense_id": "c07314e3-336c-3405-bad2-7235495cfb86",
