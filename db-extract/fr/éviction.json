                        "sense_id": "7e76531a-4377-37c4-82d9-2506b2de0df2",
                        "entry_id": "ca113bdd-54bc-3112-952a-8dd14a4839fe",
                        "glosses": [
                            "Action d’évincer, de faire partir ; résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67999bcf-a16f-45ed-b301-e132fe3d6d1e",
                                "sense_id": "7e76531a-4377-37c4-82d9-2506b2de0df2",
                                "text": "Farandoles d’Ivoiriens en délire qui saluent le départ peu glorieux d’un président autiste qui, jusqu’à la veille de son éviction n’a rien vu venir, rien compris au mécontentement d’une majorité de la population."
                            }
                        ]
                    },
                    {
                        "sense_id": "c24c8ad2-d8ba-3b92-9982-b62e5da4515d",
                        "entry_id": "ca113bdd-54bc-3112-952a-8dd14a4839fe",
                        "glosses": [
                            "Le fait d’expulser, d’éliminer quelqu’un, par l’intrigue plutôt que par la force."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "59660f0e-50f8-4bbb-89cf-87102561f9cb",
                                "sense_id": "c24c8ad2-d8ba-3b92-9982-b62e5da4515d",
                                "text": "Manœuvrer pour obtenir l’éviction de ses concurrents."
                            }
                        ]
                    },
                    {
                        "sense_id": "4cac8464-90d1-36ff-ba02-1b964ab03ce7",
                        "entry_id": "ca113bdd-54bc-3112-952a-8dd14a4839fe",
                        "glosses": [
                            "Dépossession légale par un tiers de tout ou partie d’un bien ou d’un droit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c40607a5-e822-4d5e-aa92-ca2b90d54f0a",
                                "sense_id": "4cac8464-90d1-36ff-ba02-1b964ab03ce7",
                                "text": "Le vendeur d’un bien est garant de l’éviction éventuelle que peut subir l’acquéreur."
                            },
                            {
                                "example_id": "65d08e95-0bdc-4c2d-b209-c1c741b707ca",
                                "sense_id": "4cac8464-90d1-36ff-ba02-1b964ab03ce7",
                                "text": "L’éviction d’un fermier."
                            }
                        ]
                    },
                    {
                        "sense_id": "5b7e6aa1-4dae-3bae-8cd6-fcf3acd22e0a",
                        "entry_id": "ca113bdd-54bc-3112-952a-8dd14a4839fe",
                        "glosses": [
                            "Éviction scolaire, décision administrative interdisant, pour une certaine durée, le retour à l’école d’un enfant atteint d’une maladie contagieuse ; l’absence qui en résulte."
                        ],
                        "tags": [],
                        "examples": []
                    }
