{
    "word_family": [
        "giber"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b745ed62-6709-3b23-9aff-080a494c8204",
                    "sense_definition": "A mocking or insulting remark intended to tease or belittle someone.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "mockery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The comedian's sharp <w>gibes</w> at the politicians made the entire audience laugh.",
                            "target_lang_translations": {
                                "nl": "De scherpe <w>sneren</w> van de komiek naar de politici lieten het hele publiek lachen."
                            }
                        },
                        {
                            "text": "She ignored the cruel <w>gibes</w> from her classmates and focused on her studies.",
                            "target_lang_translations": {
                                "nl": "Ze negeerde de wrede <w>spotternijen</w> van haar klasgenoten en concentreerde zich op haar studie."
                            }
                        }
                    ],
                    "synonyms": [
                        "taunt",
                        "jeer",
                        "sneer",
                        "insult"
                    ],
                    "antonyms": [
                        "compliment",
                        "praise"
                    ],
                    "common_phrases": [
                        "racist gibes",
                        "cruel gibes"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een spottende of beledigende opmerking bedoeld om iemand te plagen of kleineren."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "spotternij",
                                "target_lang_sense_clarification": "algemene term voor spottende opmerkingen"
                            },
                            {
                                "target_lang_word": "sneren",
                                "target_lang_sense_clarification": "bijtende, spottende opmerking"
                            },
                            {
                                "target_lang_word": "hoon",
                                "target_lang_sense_clarification": "spottende minachting"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3a2ac8a8-5b93-39cb-b20a-f0217c28750f",
                    "sense_definition": "A maneuver in sailing where a fore-and-aft rigged vessel changes tack by swinging the sail across the wind.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sailing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sailor performed a sudden <w>gibe</w> to change the boat's direction quickly.",
                            "target_lang_translations": {
                                "nl": "De zeiler voerde een plotselinge <w>gijp</w> uit om de koers van de boot snel te veranderen."
                            }
                        },
                        {
                            "text": "A poorly timed <w>gibe</w> can be dangerous in strong winds.",
                            "target_lang_translations": {
                                "nl": "Een slecht getimede <w>gijp</w> kan gevaarlijk zijn bij harde wind."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een manoeuvre bij het zeilen waarbij een schip met een langsscheeps tuigage van koers verandert door het zeil voor de wind langs te laten klappen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "gijpen",
                                "target_lang_sense_clarification": "de zeilterm voor deze manoeuvre"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f99ce70f-4098-35da-b2ad-367c0bc121f9",
                    "sense_definition": "To make mocking or insulting remarks.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "mockery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is unkind to <w>gibe</w> at people who are struggling with their work.",
                            "target_lang_translations": {
                                "nl": "Het is onvriendelijk om te <w>spotten</w> met mensen die worstelen met hun werk."
                            }
                        },
                        {
                            "text": "He continued to <w>gibe</w> at his opponent throughout the entire debate.",
                            "target_lang_translations": {
                                "nl": "Hij bleef tijdens het hele debat <w>sneren</w> naar zijn tegenstander."
                            }
                        }
                    ],
                    "synonyms": [
                        "taunt",
                        "jeer",
                        "mock",
                        "ridicule"
                    ],
                    "antonyms": [
                        "praise",
                        "compliment"
                    ],
                    "target_lang_definitions": {
                        "nl": "Spottende of beledigende opmerkingen maken."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "spotten",
                                "target_lang_sense_clarification": "algemeen werkwoord voor bespotten"
                            },
                            {
                                "target_lang_word": "sneren",
                                "target_lang_sense_clarification": "op een bijtende manier opmerkingen maken"
                            },
                            {
                                "target_lang_word": "hoon drijven",
                                "target_lang_sense_clarification": "iemand bespotten"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bf7d2963-216f-3176-be7b-0315a72f6ccd",
                    "sense_definition": "To change the direction of a sailing vessel by swinging the sail across the wind.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sailing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The captain decided to <w>gibe</w> the boat to catch the shifting breeze.",
                            "target_lang_translations": {
                                "nl": "De kapitein besloot de boot te <w>gijpen</w> om de draaiende wind te vangen."
                            }
                        },
                        {
                            "text": "You must be careful when you <w>gibe</w> in heavy weather.",
                            "target_lang_translations": {
                                "nl": "Je moet voorzichtig zijn wanneer je <w>gijpt</w> bij zwaar weer."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "De koers van een zeilschip veranderen door het zeil voor de wind langs te laten klappen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "gijpen",
                                "target_lang_sense_clarification": "de zeilterm voor deze handeling"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "7a4ad0b0-ebf3-3a2f-8afc-ba3d138cd45e",
                    "sense_definition": "An abbreviation of Gibraltarian English.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "language",
                    "name_type": "language_name",
                    "examples": [
                        {
                            "text": "Linguists often study <w>Gibe</w> to understand the unique blend of languages in Gibraltar.",
                            "target_lang_translations": {
                                "nl": "Taalkundigen bestuderen vaak <w>Gibe</w> om de unieke mix van talen in Gibraltar te begrijpen."
                            }
                        },
                        {
                            "text": "The local dialect, sometimes referred to as <w>Gibe</w>, is spoken by many residents.",
                            "target_lang_translations": {
                                "nl": "Het lokale dialect, soms aangeduid als <w>Gibe</w>, wordt door veel inwoners gesproken."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Used in Gibraltar"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een afkorting voor het Gibraltarees Engels."
                    },
                    "translations": {
