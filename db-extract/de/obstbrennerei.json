                        "glosses": [
                            "Betrieb, in dem Obstbrände hergestellt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4536c355-c30e-46d6-b88b-065a03ded20e",
                                "sense_id": "209ea029-d901-3563-aded-6751e23c0c74",
                                "text": "Wenn man die Straße herunterkam, roch man es schon von Weitem: da stand die Obstbrennerei."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1125a66e-4341-3626-bd1b-cdb8e365257b",
                        "entry_id": "affe5d6a-a492-3079-b12a-dc541f1bdf8f",
                        "glosses": [
                            "die Herstellung von Bränden durch Destillation vergorenen Obstes"
                        ],
                        "tags": [
                            "nur im Singular"
                        ],
                        "examples": [
                            {
                                "example_id": "f4e2f137-b827-4fd3-8c35-cc7a9c2f1549",
                                "sense_id": "1125a66e-4341-3626-bd1b-cdb8e365257b",
                                "text": "„Da es unter den in der Obstbrennerei üblichen Destillationsbedingungen nicht möglich ist, Blausäure im Vor- oder Nachlauf anzureichern, um einen blausäurearmen Mittellauf zu erhalten, bleibt nur die Möglichkeit, zu verhindern, dass größere Mengen in die Maische gelangen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
