                    {
                        "translation_id": "f6d05565-89b7-4f55-a466-a62a2dc18b91",
                        "source_entry_id": "31071c2b-dd8f-325d-a0f6-be56e2be3d1e",
                        "source_sense_id": "77993731-f6e9-3b2e-a45b-2286cfd3386c",
                        "target_lang_word": "Ermordung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ermordung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c66cb8f8-4213-3300-af89-2a410b47d3f2",
                                        "entry_id": "00bb9ddf-e78b-3d47-bc1a-ff437ab62f0a",
                                        "glosses": [
                                            "Durchführung einer geplanten Tötung (meist eines Menschen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "703e8d14-07a1-4c89-b825-2a3bbd8bfd4d",
                                                "sense_id": "c66cb8f8-4213-3300-af89-2a410b47d3f2",
                                                "text": "Die Ermordung des Präsidenten lähmte die Nation."
                                            },
                                            {
                                                "example_id": "ff8084b7-6779-4d5f-b380-dc2032a0082c",
                                                "sense_id": "c66cb8f8-4213-3300-af89-2a410b47d3f2",
                                                "text": "„Nach Rathenaus Ermordung erinnert sich der Reichstag der Republikaner, die in deutschen Zuchthäusern und Gefängnissen verkümmern, eine allgemeine Amnestie soll sie befreien.“"
                                            },
                                            {
                                                "example_id": "039ab6c8-f889-4580-b73e-7eeabc3ee243",
                                                "sense_id": "c66cb8f8-4213-3300-af89-2a410b47d3f2",
                                                "text": "„Ob die schnöde Missachtung elementarster Spielregeln des Gastrechts der Grund für die Ermordung von der Deckens war, ist ungeklärt.“"
                                            },
                                            {
                                                "example_id": "d4ea83cb-fafe-46aa-ae22-5f8320b24a06",
                                                "sense_id": "c66cb8f8-4213-3300-af89-2a410b47d3f2",
                                                "text": "„Seine Ermordung ist jetzt nur noch eine Frage der Zeit.“"
                                            },
                                            {
                                                "example_id": "142fa15e-914a-43b6-8ec3-2f48379fc0a9",
                                                "sense_id": "c66cb8f8-4213-3300-af89-2a410b47d3f2",
                                                "text": "„Mit Deckung des Afrika-Ministers in Brüssel planen zwei belgische Militärs die Entführung und Ermordung des abgesetzten Premiers.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
