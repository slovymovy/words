                                    },
                                    {
                                        "sense_id": "917d4725-b6b7-307b-8c19-ee1d0311ba0a",
                                        "entry_id": "f2898750-9b3e-32a4-901e-8ef9542230f9",
                                        "glosses": [
                                            "Supresión, generalmente por estar sobrentendido, de un vocablo o elemento de la oración sin que esta pierda su corrección gramatical."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2edac88-3040-4e20-8fe5-c3d85e11890c",
                                                "sense_id": "917d4725-b6b7-307b-8c19-ee1d0311ba0a",
                                                "text": "En la oración \"Yo vivo en Bogotá y mi hermana en Lima\", hay elisión del segundo verbo (\"vive\") por estar sobrentendido."
