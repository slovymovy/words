                "senses": [
                    {
                        "sense_id": "655945c7-e49a-3493-b581-fdc322d5a681",
                        "entry_id": "5cfc5489-a897-3cd0-901c-864c917c1adc",
                        "glosses": [
                            "das Ausschenken von Wein in einem gastronomischen Betrieb"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01ebaac5-3984-4d4b-8e2a-b6b056fe82cc",
                                "sense_id": "655945c7-e49a-3493-b581-fdc322d5a681",
                                "text": "Im Weinausschank halten wir nur Weine der Region."
                            },
                            {
                                "example_id": "196bcd0a-e8d3-4903-b696-2fdd44a280c2",
                                "sense_id": "655945c7-e49a-3493-b581-fdc322d5a681",
                                "text": "„Beim Weinausschank war es Usus, dass gespielt - genannt wird insbesondere das Brettspiel - wurde, dass »freie Töchter«, also Prostituierte anwesend waren, um nicht zuletzt zu erhöhtem Weinkonsum zu animieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6d0e0158-123c-3c1f-933f-89fb26df44d8",
                        "entry_id": "5cfc5489-a897-3cd0-901c-864c917c1adc",
                        "glosses": [
                            "Theke oder generell die Örtlichkeit, an der der Wein ausgeschenkt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d5aa72e-c359-4563-9494-c5e9e2d23ae2",
                                "sense_id": "6d0e0158-123c-3c1f-933f-89fb26df44d8",
                                "text": "„Ihre Eltern und ihre Schwester betrieben auf der Mannheimer Mess, die gerade wie jedes Jahr zusätzlich zur Maimess im Oktober stattfand, einen Weinausschank.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
