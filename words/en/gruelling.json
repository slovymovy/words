                    "sense_id": "ef033fa2-d9f9-30ab-b3e0-e4e1ff6b473f",
                    "sense_definition": "Extremely difficult, tiring, or demanding.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "difficult",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The athletes faced a <w>gruelling</w> training schedule before the Olympic games.",
                            "target_lang_translations": {
                                "ru": "Перед Олимпийскими играми спортсмены столкнулись с <w>изнурительным</w> графиком тренировок.",
                                "zh": "运动员在奥运会前迎来了<w>艰苦的</w>训练日程。"
                            }
                        },
                        {
                            "text": "After a <w>gruelling</w> day at the office, she just wanted to sleep.",
                            "target_lang_translations": {
                                "ru": "После <w>изнурительного</w> дня в офисе ей хотелось только спать.",
                                "zh": "在办公室度过了<w>筋疲力尽的</w>一天后，她只想睡觉。"
                            }
                        }
