                                                "example_id": "fc05ae8a-7573-4f53-b48d-faf2d3da5131",
                                                "sense_id": "76aab3a4-9e40-344f-b456-4d6ab4aac92d",
                                                "text": "a mind intent on self-improvement"
                                            },
                                            {
                                                "example_id": "356ed6f6-4617-4ff9-80fa-b415d0843368",
                                                "sense_id": "76aab3a4-9e40-344f-b456-4d6ab4aac92d",
                                                "text": "Uruguay were quick to the ball, strong in the tackle and seemed intent on showing they were a better team than had been apparent in their defeat to Costa Rica."
                                            },
                                            {
                                                "example_id": "9c8b44ce-6033-4a96-a46a-d2be38c168a3",
                                                "sense_id": "76aab3a4-9e40-344f-b456-4d6ab4aac92d",
                                                "text": "And it was while all were passionately intent upon the pleasing and snake-like progress of their uncle that a young girl in furs, ascending the stairs two at a time, peeped perfunctorily into the nursery as she passed the hallway—and halted amazed."
                                            }
