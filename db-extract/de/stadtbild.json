                ],
                "senses": [
                    {
                        "sense_id": "8c19a88e-c059-3de1-a2b1-a4cdce62e694",
                        "entry_id": "ed241f5a-d9eb-3f22-a551-af3e5fb1e2d8",
                        "glosses": [
                            "bestimmtes Bild, das eine Stadt von sich abgibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a182d7d-64e4-474b-844f-42ce8baf0b75",
                                "sense_id": "8c19a88e-c059-3de1-a2b1-a4cdce62e694",
                                "text": "„Tokyo zeigt ein modernes Stadtbild mit nur noch wenigen historischen Bauten.“"
                            },
                            {
                                "example_id": "3c3bb6bd-30f8-4e68-a38d-7300fff5aef9",
                                "sense_id": "8c19a88e-c059-3de1-a2b1-a4cdce62e694",
                                "text": "„Führer und Reichskanzler Adolf Hitler ordnet die Durchführung baulicher Maßnahmen in der Stadt der Reichsparteitage Nürnberg an, die zum Ausbau des Parteitagsgeländes und zur planvollen Gestaltung des Stadtbildes erforderlich sind.“"
                            },
                            {
                                "example_id": "ce162d3f-a8d9-49e4-b911-e7fe94d53192",
                                "sense_id": "8c19a88e-c059-3de1-a2b1-a4cdce62e694",
                                "text": "„Eng verwinkelte Gassen, Teestuben und einfache Lebensmittelläden prägten das Stadtbild.“"
                            },
                            {
                                "example_id": "a4cead10-7d44-4748-9050-8ef757cb109b",
                                "sense_id": "8c19a88e-c059-3de1-a2b1-a4cdce62e694",
                                "text": "„Die S-Bahn von Potsdam zum Stettiner Bahnhof verkehrt wie stets, an all den Ruinen vorüber, die das Berliner Stadtbild prägen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "43f46a13-78a4-4865-b7dc-fa1360788d8a",
                        "source_entry_id": "ed241f5a-d9eb-3f22-a551-af3e5fb1e2d8",
                        "source_sense_id": "8c19a88e-c059-3de1-a2b1-a4cdce62e694",
                        "source_sense_description": "bestimmtes Bild, das eine Stadt von sich abgibt",
                        "target_lang_word": "townscape",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "townscape",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "84eb34fc-c5ec-3c9f-8429-854e5afa0c37",
                                        "entry_id": "77fa2cd1-e8e7-35f2-83aa-134bf273b83f",
                                        "glosses": [
                                            "A view of a town, or a subjective image of a town"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac3d313f-0050-4273-b793-2713deaca2e5",
                                                "sense_id": "84eb34fc-c5ec-3c9f-8429-854e5afa0c37",
                                                "text": "In the latter years of its existence, BR was rationalising its estate by pulling down station buildings which were too large for its modern operational needs, or by shutting off parts of them when demolition was not an option. Kilmarnock station falls into this latter category. It dominates the townscape, but its operational importance has seriously diminished since electrification of the West Coast Main Line."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc4552b6-e64c-38d7-a7e9-4dc60fc880f6",
                                        "entry_id": "77fa2cd1-e8e7-35f2-83aa-134bf273b83f",
                                        "glosses": [
                                            "A depiction of an urban scene"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "townscape",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8175a86c-f412-306f-a119-269f75a39b60",
                                        "entry_id": "5340669a-71c0-3ccc-bab4-47f8d0d95539",
                                        "glosses": [
                                            "To design and lay out (buildings) as a town."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "823a117d-2a50-4f40-b206-7d526bd4d7b6",
                                                "sense_id": "8175a86c-f412-306f-a119-269f75a39b60",
                                                "text": "But the houses are so delicious and the way they're townscaped on to hilly bits is absolutely wonderful."
                                            },
                                            {
                                                "example_id": "b755b614-7633-42b7-b3df-258beeab802e",
                                                "sense_id": "8175a86c-f412-306f-a119-269f75a39b60",
                                                "text": "For example, small communities in the Midwest have developed modest but well-designed approaches to townscaping that make them exceptionally visually appealing."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
