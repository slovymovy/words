                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1372acde-a6a8-4294-b243-375e3d6dc803",
                                "sense_id": "f56db58c-cab0-3af6-80c9-418bca730a50",
                                "text": "„Sieger wurde beim 8. Männerballettwettbewerb bereits zum 3. Mal die Crottendorfer Faschingsgesellschaft.“"
                            },
                            {
                                "example_id": "4cf1221a-d8fd-4aea-a982-cee875cff9e3",
                                "sense_id": "f56db58c-cab0-3af6-80c9-418bca730a50",
                                "text": "„Der Bleicheröder Carneval Club (BCC) hat am Samstag zum 14. Männerballettwettbewerb ins Kulturhaus eingeladen.“"
                            },
                            {
                                "example_id": "fc0fb4e0-b2ad-4d7e-a1a7-246b8a6eee80",
                                "sense_id": "f56db58c-cab0-3af6-80c9-418bca730a50",
                                "text": "„Carsten II. tanzt seit einigen Jahren im Männerballett und organisiert an zentraler Stelle den Männerballettwettbewerb.“"
                            },
                            {
                                "example_id": "5cf5a421-4224-46f1-8c65-fe7d33dcf4af",
                                "sense_id": "f56db58c-cab0-3af6-80c9-418bca730a50",
                                "text": "„Die Prinzengarde der Grafschaftler Karnevalsgesellschaft Rietberg gewann am Samstagabend den Männerballettwettbewerb in Atteln.“"
                            },
                            {
                                "example_id": "e375bfe0-c147-4c51-95d1-c7a89eb8e9bc",
                                "sense_id": "f56db58c-cab0-3af6-80c9-418bca730a50",
                                "text": "„Eine Bombenstimmung herrschte beim Männerballettwettbewerb in der proppenvollen Steinatalhalle.“"
                            }
                        ],
