                        "es": "Estar obligado o tener el deber de hacer algo (uso arcaico).",
                        "fr": "Être tenu ou obligé de faire quelque chose (archaïque)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "have to",
                                "target_lang_sense_clarification": "obligation"
                            },
                            {
