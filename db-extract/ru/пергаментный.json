                    {
                        "translation_id": "5d9bcdba-2467-4587-be53-21431e6abceb",
                        "source_entry_id": "9f11ba02-f4e7-3ddb-a289-9193ebf894b9",
                        "source_sense_description": "связанный, соотносящийся по значению с существительным пергамент",
                        "target_lang_word": "pergaminowy",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "5b4acf05-39d9-4a2a-abd2-226c7794fc12",
                        "source_entry_id": "9f11ba02-f4e7-3ddb-a289-9193ebf894b9",
                        "source_sense_description": "свойственный пергаменту, характерный для него; напоминающий пергамент",
                        "target_lang_word": "parcheminé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "parcheminé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "090a963b-0be4-3ce5-bac9-509ab6f750ff",
                                        "entry_id": "94e2ffcd-4ba5-38ee-9c7a-eb181414ba9d",
                                        "glosses": [
                                            "Qui est de la consistance, de la couleur, qui a l’apparence du parchemin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65e9d804-2bb4-4c54-85ed-2986a828da6f",
                                                "sense_id": "090a963b-0be4-3ce5-bac9-509ab6f750ff",
                                                "text": "N'eût été le mouvement des paupières offusquées par la lueur qui les frappait, on eût dit le visage d'un cadavre, tant la peau était parcheminée, tant elle se collait aux os, tant les yeux disparaissaient dans le creux des orbites..."
                                            },
                                            {
                                                "example_id": "c445b998-b820-4874-bec8-09d74d713c04",
                                                "sense_id": "090a963b-0be4-3ce5-bac9-509ab6f750ff",
                                                "text": "La figure était jaune, parcheminée, annelée de rides, décimée par l’âge."
                                            },
                                            {
                                                "example_id": "46ee1c14-d085-4d2e-a8fe-f20f1f9f5881",
                                                "sense_id": "090a963b-0be4-3ce5-bac9-509ab6f750ff",
                                                "text": "Longs doigts parcheminés, froids et lisses comme du verre, non moins fragiles peut-être, quand ils s’approchaient des miens, je regrettais d’être venu."
                                            },
                                            {
                                                "example_id": "7cfaed21-fe37-470c-8928-e1d2ef138462",
                                                "sense_id": "090a963b-0be4-3ce5-bac9-509ab6f750ff",
                                                "text": "Psychiatre new-yorkais arrivée à l’écriture sur le tard, Arlene Heyman, née en 1943, déroule une carte du Tendre parcheminée, entre Viagra, désirs flétris et démons cacochymes."
                                            },
                                            {
                                                "example_id": "9971ba39-62eb-48d4-913c-79252e52de3d",
                                                "sense_id": "090a963b-0be4-3ce5-bac9-509ab6f750ff",
                                                "text": "C’était le milieu de l’après-midi, mais on ne distinguait que des ombres, des silhouettes parcheminées et le chemin qu’ils avaient emprunté pour éviter le village était glissant, mal empierré, encombré de ruisseaux bouillonnants."
                                            }
                                        ]
                                    }
                                ]
                            },
