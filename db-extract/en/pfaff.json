                "senses": [
                    {
                        "sense_id": "d912d8f1-1064-3baf-a8a2-14d054b006c3",
                        "entry_id": "9aa8f458-fd95-3018-b8ce-6fdae636fcb5",
                        "glosses": [
                            "Alternative spelling of faff."
                        ],
                        "tags": [
                            "British",
                            "alt-of",
                            "alternative",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "e256bf09-fe7d-41a9-885c-14f9a1cde915",
                                "sense_id": "d912d8f1-1064-3baf-a8a2-14d054b006c3",
                                "text": "No, on a foreign journey, the real damage is done pfaffing about in airport lounges, counting down the torture to departure, sitting on the runway, enduring protracted periods of sub-pedestrian taxiing [...]."
                            },
                            {
                                "example_id": "0dad0643-7462-4903-a7eb-6e73b1b17c47",
                                "sense_id": "d912d8f1-1064-3baf-a8a2-14d054b006c3",
                                "text": "By my own admission I pfaffed around a bit here but I'm going to claim that I was merely enjoying the moment!"
                            },
                            {
                                "example_id": "2f62899c-760c-4d67-8700-979600716225",
                                "sense_id": "d912d8f1-1064-3baf-a8a2-14d054b006c3",
                                "text": "Mr Hicks wrote on his website: \"At dusk the rudder cable broke\nAt dusk the rudder cable broke. \"Six hours pfaffing about in the dark and heaving sea saw a fairly unsatisfactory makeshift steering system into place\""
                            },
                            {
                                "example_id": "e5c7bc22-6da8-4ca5-8fd2-c90a1ec299f3",
                                "sense_id": "d912d8f1-1064-3baf-a8a2-14d054b006c3",
                                "text": "Chetan Mahajan is a writing coach, blogger and author. To convey coolness he calls himself the Chief Pfaffing Officer of the Himalayan Writing Retreat, which he co-founded."
                            }
                        ]
                    }
                ],
