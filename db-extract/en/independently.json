                                "target_senses": [
                                    {
                                        "sense_id": "48a74fbe-0dd1-3b89-870a-c5640fe32322",
                                        "entry_id": "708dde81-c64c-38b3-96c8-0912ddb86aeb",
                                        "glosses": [
                                            "Sans dépendance, d’une manière indépendante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a218c98-d827-4351-bf08-5e161ec3afd3",
                                                "sense_id": "48a74fbe-0dd1-3b89-870a-c5640fe32322",
                                                "text": "L'âme […] étant sortie de son état pour avoir voulu être heureuse indépendamment de Dieu."
                                            },
                                            {
                                                "example_id": "3ec5b4ca-33d5-48f2-bea7-dbb3313395af",
                                                "sense_id": "48a74fbe-0dd1-3b89-870a-c5640fe32322",
                                                "text": "Dieu, qui nous a créés indépendamment de nous et sans nous, ne peut-il pas, sans nous et indépendamment de nous, décider de notre sort ?"
                                            },
                                            {
                                                "example_id": "fcd3c0c4-c926-4a5c-a81c-5d5126093cab",
                                                "sense_id": "48a74fbe-0dd1-3b89-870a-c5640fe32322",
                                                "text": "Aux événements de la guerre, il faut agir indépendamment dans de certaines occasions."
                                            },
                                            {
                                                "example_id": "b3d9e129-ce60-4296-b1ad-ae5ac821db3a",
                                                "sense_id": "48a74fbe-0dd1-3b89-870a-c5640fe32322",
                                                "text": "Le questionnaire doit être rédigé dans une langue grammaticalement correcte et compréhensible pour tous les participants indépendamment de l’âge et du niveau d’enseignement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1856c2e8-0546-33a7-9c82-1ff612d986a0",
                                        "entry_id": "708dde81-c64c-38b3-96c8-0912ddb86aeb",
                                        "glosses": [
                                            "Sans aucun égard à […]."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea2dca4b-f04d-42b2-ad60-4db576fc8a7b",
                                                "sense_id": "1856c2e8-0546-33a7-9c82-1ff612d986a0",
                                                "text": "Je vous servirai indépendamment de tout événement."
                                            },
                                            {
                                                "example_id": "3962368f-543f-49cf-9257-a47a28e7ac48",
                                                "sense_id": "1856c2e8-0546-33a7-9c82-1ff612d986a0",
                                                "text": "Adieu, mon cher monsieur : à la mort et à la vie, je vous aimerai et vous estimerai très indépendamment de la qualité de gouverneur du marquis de Grignan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e8f476a-5f24-33c3-9b86-03e9f78ea51c",
                                        "entry_id": "708dde81-c64c-38b3-96c8-0912ddb86aeb",
                                        "glosses": [
                                            "Outre, par surcroît."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3264eeb-7630-4cc5-a137-63a0945d596e",
                                                "sense_id": "3e8f476a-5f24-33c3-9b86-03e9f78ea51c",
                                                "text": "Indépendamment des portes percées dans l’enceinte intérieure, on comptait plusieurs poternes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
