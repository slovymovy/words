                    {
                        "translation_id": "7d6380bf-34b0-4bc2-b9cd-49c4d4c5ab9e",
                        "source_entry_id": "d8fa413e-16e0-3e15-ab39-628aed10f94c",
                        "source_sense_description": "in a careful manner",
                        "target_lang_word": "насторо́женно",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "насторо́женно",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "798fc018-930d-3418-a55e-13b2f0e51289",
                                        "entry_id": "6a02e97b-39ec-3c7d-a550-00a72012f980",
                                        "glosses": [
                                            "разг. будучи напряжённо внимательным в ожидании чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b95bcafa-3b4a-41ad-9fb6-827e5b5211bf",
                                                "sense_id": "798fc018-930d-3418-a55e-13b2f0e51289",
                                                "text": "Прасковья сидела на уголке стула, худенькая, тонкая, и настороженно молчала."
                                            },
                                            {
                                                "example_id": "f5c942b8-8ec5-463f-ad2b-511120159fcd",
                                                "sense_id": "798fc018-930d-3418-a55e-13b2f0e51289",
                                                "text": "Он смотрел на неё настороженно, но она на этот раз плакать не стала."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dfcb6c1a-526f-3110-95ff-282f7fd19138",
                                        "entry_id": "6a02e97b-39ec-3c7d-a550-00a72012f980",
                                        "glosses": [
                                            "разг. выражая насторожённость или свидетельствуя о ней"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "368dbbdc-5544-48dc-ac5a-fbdb75587845",
                                                "sense_id": "dfcb6c1a-526f-3110-95ff-282f7fd19138",
                                                "text": "Он говорил с Макаровым задорно взвизгивая и тоном человека, который, чего-то опасаясь, готов к защите, надменно выпячивая грудь, откидывал голову, бегающие глазки его останавливались настороженно, недоверчиво и как бы ожидая необыкновенного."
                                            },
                                            {
                                                "example_id": "fa0cdc05-5e41-4f5d-8f39-210781068418",
                                                "sense_id": "dfcb6c1a-526f-3110-95ff-282f7fd19138",
                                                "text": "Тогда жесты ее становились настороженно скупы, однако никогда не скованны."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
