{
    "word_family": [
        "cherry-red",
        "cherry-pick",
        "cherried",
        "cherry-wood"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b8efe9d6-19fc-3c1f-8c5b-60896cd089a9",
                    "sense_definition": "A small, round, fleshy fruit, usually red, black, or yellow, containing a single hard stone.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fruit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She ate a sweet <w>cherry</w> from the bowl on the kitchen table.",
                            "target_lang_translations": {
                                "ru": "Она съела сладкую <w>черешню</w> из миски на кухонном столе."
                            }
                        },
                        {
                            "text": "The baker placed a single <w>cherry</w> on top of the chocolate cake.",
                            "target_lang_translations": {
                                "ru": "Пекарь положил одну <w>вишенку</w> на верхушку шоколадного торта."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bowl of cherries",
                        "sweet cherry",
                        "sour cherry"
                    ],
                    "target_lang_definitions": {
                        "ru": "Маленький круглый мясистый плод, обычно красного, черного или желтого цвета, содержащий одну твердую косточку."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вишня",
                                "target_lang_sense_clarification": "обычно кислая или садовая"
                            },
                            {
                                "target_lang_word": "черешня",
                                "target_lang_sense_clarification": "сладкая крупная ягода"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9c0c4f5e-ae9d-3b5f-8d7b-21e86e69f7fa",
                    "sense_definition": "A bright, deep red color like that of a ripe cherry.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sports car was painted a vibrant shade of <w>cherry</w>.",
                            "target_lang_translations": {
                                "ru": "Спортивный автомобиль был выкрашен в яркий <w>вишнёвый</w> оттенок."
                            }
                        },
                        {
                            "text": "Her lips were stained a deep <w>cherry</w> after eating the fruit.",
                            "target_lang_translations": {
                                "ru": "Ее губы окрасились в глубокий <w>вишнёвый</w> цвет после того, как она поела ягод."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cherry red"
                    ],
                    "target_lang_definitions": {
                        "ru": "Яркий, глубокий красный цвет, похожий на цвет спелой вишни."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вишнёвый цвет",
                                "target_lang_sense_clarification": "оттенок красного"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "054e0bc1-1e89-3941-a614-a4381a4f1686",
                    "sense_definition": "Any of various trees or shrubs that bear cherries.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "plants",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>cherry</w> in our backyard blooms with beautiful pink flowers every spring.",
                            "target_lang_translations": {
                                "ru": "<w>Вишня</w> у нас во дворе каждую весну расцветает красивыми розовыми цветами."
                            }
                        },
                        {
                            "text": "Birds often gather in the <w>cherry</w> to eat the ripening fruit.",
                            "target_lang_translations": {
                                "ru": "Птицы часто собираются на <w>вишне</w>, чтобы поесть созревающие плоды."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cherry blossom",
                        "cherry tree"
                    ],
                    "target_lang_definitions": {
                        "ru": "Любое из различных деревьев или кустарников, на которых растут вишни или черешни."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вишня",
                                "target_lang_sense_clarification": "дерево"
                            },
                            {
                                "target_lang_word": "черешня",
                                "target_lang_sense_clarification": "дерево"
                            },
                            {
                                "target_lang_word": "сакура",
                                "target_lang_sense_clarification": "японская декоративная вишня"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ccfce8f-2e11-381c-b619-fd798912620a",
                    "sense_definition": "The wood of a cherry tree, often used for making furniture.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dining table was crafted from solid <w>cherry</w> and had a rich finish.",
                            "target_lang_translations": {
                                "ru": "Обеденный стол был изготовлен из массива <w>вишни</w> и имел роскошную отделку."
                            }
                        },
                        {
                            "text": "He prefers working with <w>cherry</w> because of its fine grain and durability.",
                            "target_lang_translations": {
                                "ru": "Он предпочитает работать с <w>вишней</w> из-за ее мелкой текстуры и долговечности."
                            }
                        }
                    ],
                    "common_phrases": [
                        "solid cherry",
                        "cherry wood"
                    ],
                    "target_lang_definitions": {
                        "ru": "Древесина вишневого дерева, часто используемая для изготовления мебели."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вишня",
                                "target_lang_sense_clarification": "материал"
                            },
                            {
                                "target_lang_word": "черешня",
                                "target_lang_sense_clarification": "материал"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7a00f75d-8535-36df-8161-d0197975f759",
                    "sense_definition": "A round, red emergency light typically mounted on top of a police car.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "equipment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The officer activated the flashing <w>cherry</w> on the roof to signal the driver to pull over.",
                            "target_lang_translations": {
                                "ru": "Офицер включил мигающую <w>мигалку</w> на крыше, чтобы подать водителю сигнал остановиться."
                            }
                        },
                        {
                            "text": "We saw the glow of a <w>cherry</w> in the distance as the patrol car approached.",
                            "target_lang_translations": {
                                "ru": "Мы увидели отблеск <w>красного маячка</w> вдалеке, когда патрульная машина приблизилась."
                            }
                        }
                    ],
                    "synonyms": [
                        "cherrytop"
                    ],
                    "common_phrases": [
                        "flashing cherry"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used informally to refer to police lights"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Круглый красный аварийный маячок, обычно устанавливаемый на крыше полицейской машины."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мигалка",
                                "target_lang_sense_clarification": "красный спецсигнал"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "17fbdfff-3aa3-3e30-a664-b9f75f0c06b1",
                    "sense_definition": "The glowing, burning tip of a cigarette or cigar.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "smoking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the dark alley, the only thing visible was the orange <w>cherry</w> of his cigarette.",
                            "target_lang_translations": {
                                "ru": "В темном переулке был виден только оранжевый <w>уголёк</w> его сигареты."
                            }
                        },
                        {
                            "text": "He accidentally dropped a hot <w>cherry</w> on his shirt, burning a small hole.",
                            "target_lang_translations": {
                                "ru": "Он случайно уронил горячий <w>уголёк</w> на рубашку, прожегши маленькую дырочку."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cigarette cherry"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal term for the burning end of a cigarette"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Светящийся, горящий кончик сигареты или сигары."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уголёк",
                                "target_lang_sense_clarification": "горящий кончик сигареты"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b212ae14-5111-380b-97f7-ac7b0193b345",
                    "sense_definition": "A person's virginity.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The movie characters joked about who would be the first to lose their <w>cherry</w>.",
                            "target_lang_translations": {
                                "ru": "Герои фильма шутили о том, кто первым лишится <w>целки</w>."
                            }
                        },
                        {
                            "text": "He felt nervous about the encounter, as if he were about to lose his <w>cherry</w> all over again.",
                            "target_lang_translations": {
                                "ru": "Он нервничал перед встречей, как будто собирался снова потерять <w>невинность</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "lose one's cherry",
                        "pop the cherry"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Informal and potentially offensive"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "Common in casual, non-formal speech"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Девственность человека."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "целка",
                                "target_lang_sense_clarification": "вульгарно, о девственности"
                            },
                            {
                                "target_lang_word": "невинность",
                                "target_lang_sense_clarification": "более формально"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "529cadfd-6ed3-30c0-86db-be8df0f1ab1a",
                    "sense_definition": "Having a bright, deep red color.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore a <w>cherry</w> dress that stood out in the crowd.",
                            "target_lang_translations": {
                                "ru": "На ней было <w>вишнёвое</w> платье, которое выделялось в толпе."
                            }
                        },
                        {
                            "text": "The walls were painted a <w>cherry</w> red to make the room feel warmer.",
                            "target_lang_translations": {
                                "ru": "Стены были выкрашены в <w>вишнёво-красный</w> цвет, чтобы в комнате было уютнее."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cherry red"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий яркий, глубокий красный цвет."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вишнёвый",
                                "target_lang_sense_clarification": "о цвете"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "85b6f5e4-c178-3e3b-92da-3c31842e9948",
                    "sense_definition": "Containing or tasting like cherries.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "taste",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I ordered a <w>cherry</w> pie for dessert at the diner.",
                            "target_lang_translations": {
                                "ru": "Я заказал <w>вишнёвый</w> пирог на десерт в закусочной."
                            }
                        },
                        {
                            "text": "This <w>cherry</w> soda is much too sweet for my liking.",
                            "target_lang_translations": {
                                "ru": "Эта <w>вишнёвая</w> газировка слишком сладкая на мой вкус."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cherry pie",
                        "cherry flavor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Содержащий вишню или имеющий вкус вишни."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вишнёвый",
                                "target_lang_sense_clarification": "о вкусе или составе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6ef9a574-3c25-3bb0-acf3-9c3f2807ce3b",
                    "sense_definition": "In perfect or excellent condition; like new.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "condition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He kept his vintage motorcycle in <w>cherry</w> condition for over twenty years.",
                            "target_lang_translations": {
                                "ru": "Он содержал свой винтажный мотоцикл в <w>идеальном</w> состоянии более двадцати лет."
                            }
                        },
                        {
                            "text": "The collector was thrilled to find the action figure in <w>cherry</w> state.",
                            "target_lang_translations": {
                                "ru": "Коллекционер был в восторге, найдя фигурку в <w>безупречном</w> состоянии."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cherry condition"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Often used by car or toy collectors"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В идеальном или отличном состоянии; как новый."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "идеальный",
                                "target_lang_sense_clarification": "о состоянии вещи"
                            },
                            {
                                "target_lang_word": "нулёвый",
                                "target_lang_sense_clarification": "сленг, как новый"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "48c98976-fe9e-3667-8bbd-fa89442a65b7",
                    "sense_definition": "A female given name, sometimes used as a diminutive of Charity.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Her friends called her <w>Cherry</w> instead of her full name, Charity.",
                            "target_lang_translations": {
                                "ru": "Друзья называли ее <w>Черри</w> вместо ее полного имени, Черити."
                            }
                        },
                        {
                            "text": "<w>Cherry</w> was a popular character in the novel we read in class.",
                            "target_lang_translations": {
                                "ru": "<w>Черри</w> была популярным персонажем в романе, который мы читали в классе."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Женское имя, иногда используемое как уменьшительное от Charity."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Черри",
                                "target_lang_sense_clarification": "имя собственное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e0f22a0a-12d3-3914-a582-d53e09a90b08",
                    "sense_definition": "A surname.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Professor <w>Cherry</w> published a groundbreaking study on linguistics.",
                            "target_lang_translations": {
                                "ru": "Профессор <w>Черри</w> опубликовал новаторское исследование по лингвистике."
                            }
                        },
                        {
                            "text": "The <w>Cherry</w> family has lived in this town for generations.",
                            "target_lang_translations": {
                                "ru": "Семья <w>Черри</w> жила в этом городе на протяжении нескольких поколений."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Черри",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8ae6ab0e-0677-3505-b411-9967e800aff3",
                    "sense_definition": "To make something red or to give it a cherry-like color.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "color_change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cold winter wind <w>cherried</w> her cheeks as she walked home.",
                            "target_lang_translations": {
                                "ru": "Холодный зимний ветер <w>зарумянил</w> ее щеки, пока она шла домой."
                            }
                        },
                        {
                            "text": "The sunset <w>cherried</w> the clouds with a beautiful red glow.",
                            "target_lang_translations": {
                                "ru": "Закат <w>окрасил</w> облака в красивый вишнево-красный цвет."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Rarely used as a verb"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать что-то красным или придать чему-то вишневый оттенок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "окрасить в вишнёвый цвет",
                                "target_lang_sense_clarification": "придать красный оттенок"
                            },
                            {
                                "target_lang_word": "зарумянить",
                                "target_lang_sense_clarification": "о щеках"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}