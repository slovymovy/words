                    {
                        "translation_id": "11328745-f560-4eca-870a-fa0acc350002",
                        "source_entry_id": "f65c4a8f-3119-3571-92bb-e4396dc58d6b",
                        "source_sense_id": "7611ca7d-4349-32b3-9cb2-f0bb28a87d10",
                        "source_sense_description": "a Muslim greeting",
                        "target_lang_word": "селя́м",
