                "senses": [
                    {
                        "sense_id": "505eb980-6124-3308-89a7-463d8c0ad5dc",
                        "entry_id": "91e4cbf7-1bb6-3fb7-a0b2-dfd43278aea1",
                        "glosses": [
                            "Faire perdre son caractère confédéral à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0feee987-8291-4afe-8eb3-53cd18790504",
                                "sense_id": "505eb980-6124-3308-89a7-463d8c0ad5dc",
                                "text": "La Prusse ne veut pas que le contingent fédéral autrichien fasse partie du corps d’observation, elle veut disposer à son gré des forces fédérales ; elle veut nous déconfédérer (entbünden), disait l’Autriche."
                            },
                            {
                                "example_id": "3ff711ff-4fef-4e9d-bb72-11eab9013bf8",
                                "sense_id": "505eb980-6124-3308-89a7-463d8c0ad5dc",
                                "text": "Ce n’est que lorsqu’une grosse fédération historique se déconfédère que les journalistes économiques et sociaux s’y intéressent."
                            },
                            {
                                "example_id": "6bd8f042-0a49-41ea-935d-90500cc101cb",
                                "sense_id": "505eb980-6124-3308-89a7-463d8c0ad5dc",
                                "text": "Laissons les Allemands se réunir ou se diviser, se confédérer ou se déconfédérer à leur gré !"
                            }
                        ]
                    }
                ],
