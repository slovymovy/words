                ],
                "senses": [
                    {
                        "sense_id": "71521350-3d10-386f-9194-335500dc7982",
                        "entry_id": "3c011a72-e6d8-3046-bb63-1fa3a48bc3ed",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb47e843-941a-4132-8c5d-64a370aa7fd5",
                                "sense_id": "71521350-3d10-386f-9194-335500dc7982",
                                "text": "Frau Märkle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "9cb730db-ccb0-4ad7-be7f-d2b872fa3cca",
                                "sense_id": "71521350-3d10-386f-9194-335500dc7982",
                                "text": "Herr Märkle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "ee30e148-7d86-4248-b120-df712defab5c",
                                "sense_id": "71521350-3d10-386f-9194-335500dc7982",
                                "text": "Die Märkles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "a6260b12-f768-4a85-8b41-3d3d52fda84d",
                                "sense_id": "71521350-3d10-386f-9194-335500dc7982",
                                "text": "Der Märkle trägt nie die Schals, die die Märkle ihm strickt."
                            },
                            {
                                "example_id": "12133460-512f-40bb-aa82-ef291945fdb7",
                                "sense_id": "71521350-3d10-386f-9194-335500dc7982",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Märkle kommt, geht der Herr Märkle.“"
                            },
                            {
                                "example_id": "cc4bf348-0ff1-4ec5-9de7-cc3ee4f9b5c2",
                                "sense_id": "71521350-3d10-386f-9194-335500dc7982",
                                "text": "Märkle kommt und geht."
                            },
                            {
                                "example_id": "b9f539b2-9dbb-4ff4-86a4-aaf2ac2d5f50",
                                "sense_id": "71521350-3d10-386f-9194-335500dc7982",
                                "text": "Märkles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
