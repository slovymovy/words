                                "example_id": "99d35121-c34c-42ac-ac0a-8cdfd915f640",
                                "sense_id": "ba28f0cb-4722-3f9d-bde5-08759609f9cc",
                                "text": "„Zu jener Zeit beschloß das College die meisten seiner kostbaren Buchbestände an eine zentrale Universitätsbibliothek abzugeben, wo sie unter besseren Bedingungen aufbewahrt werden konnten.“"
                            },
                            {
                                "example_id": "396dd365-9576-44db-b723-9f46621e576f",
                                "sense_id": "ba28f0cb-4722-3f9d-bde5-08759609f9cc",
                                "text": "„Dasselbe ist zumindest für Teile der im Duderstädter Ursulinenkloster aufbewahrten historischen Buchbestände festzustellen.“"
                            }
