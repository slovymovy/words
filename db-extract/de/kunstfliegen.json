                ],
                "senses": [
                    {
                        "sense_id": "81c51817-b084-393f-8e87-d8b2fcd073ad",
                        "entry_id": "cf875960-3292-3787-8239-7666e22d8835",
                        "glosses": [
                            "Sportart, bei der mit einem Motorflugzeug, einem Segelflugzeug oder einem anderen dafür technisch ausgestatteten Fluggerät akrobatische Bewegungen im Luftraum durchgeführt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9de86487-a361-4a21-b439-0dc12985f22c",
                                "sense_id": "81c51817-b084-393f-8e87-d8b2fcd073ad",
                                "text": "„Das Motorfliegen erfordert ein beträchtliches navigatorisches Wissen und Können bzw. beim Kunstfliegen vestibuläre Belastbarkeit, Raumorientierungsvermögen und ein feinmotorisches Gespür für den Umgang mit der Maschine.“"
                            },
                            {
                                "example_id": "691f4db7-05e6-4198-87ec-18b3b3500291",
                                "sense_id": "81c51817-b084-393f-8e87-d8b2fcd073ad",
                                "text": "„Beim Kunstfliegen geht es nicht darum, schnell an ein Ziel zu kommen, sondern Flugmanöver so spektakulär wie möglich auszuführen.“"
                            },
                            {
                                "example_id": "6e2c8186-d842-44a4-be60-85ab633d78e4",
                                "sense_id": "81c51817-b084-393f-8e87-d8b2fcd073ad",
                                "text": "„Das Faszinierende beim Kunstfliegen sei aber kein einzelnes Manöver, sondern die Präzision, mit der so ein Flug ausgeführt werden muss.“"
                            },
                            {
                                "example_id": "3c47245a-6df0-4910-abbb-b2947eccc80f",
                                "sense_id": "81c51817-b084-393f-8e87-d8b2fcd073ad",
                                "text": "„Und die Redakteure bildeten sich im Kunstfliegen aus, und je jüdischer einer hieß, desto raußerer flog er raus.“"
                            },
                            {
                                "example_id": "bd4e4c38-1026-41d4-b972-628b570f05ed",
                                "sense_id": "81c51817-b084-393f-8e87-d8b2fcd073ad",
                                "text": "Das Kunstfliegen gilt als die Königsdisziplin des Flugsports. […] Die Sehnsucht des Menschen nach dem Fliegen findet im Kunstfliegen ihren höchsten Ausdruck."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
