                    },
                    {
                        "translation_id": "3262708d-64b3-492d-b184-97bace238571",
                        "source_entry_id": "99c729f4-e9cf-3fbb-adf0-2bac1588444b",
                        "source_sense_id": "40e00231-2994-3753-8ec4-75378584f6f9",
                        "source_sense_description": "Rechnungswesen: in der Buchführung die linke Seite eines T-Kontos",
                        "target_lang_word": "débit",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "débit",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "389b2a29-4a2e-306f-b303-87eb3e5169bf",
                                        "entry_id": "0d0187a5-3e07-3c49-945a-e57a92225f0c",
                                        "glosses": [
                                            "Vente continue, répétée, surtout au détail."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91d3d36e-8e7e-4d35-a1a0-7e7964e2bffa",
                                                "sense_id": "389b2a29-4a2e-306f-b303-87eb3e5169bf",
                                                "text": "Débit de draps, de dentelles."
                                            },
                                            {
                                                "example_id": "833a5d39-c328-46f6-9476-c8d62d56e3eb",
                                                "sense_id": "389b2a29-4a2e-306f-b303-87eb3e5169bf",
                                                "text": "Enfin, après deux mois de navigation, nous arrivâmes heureusement à un port de mer, où nous débarquâmes et fîmes un très grand débit de nos marchandises."
                                            },
                                            {
                                                "example_id": "017e03e8-3be9-40e2-9ee7-f7b66d7e9a81",
                                                "sense_id": "389b2a29-4a2e-306f-b303-87eb3e5169bf",
                                                "text": "Ce magasin a un grand débit."
                                            },
                                            {
                                                "example_id": "aa338146-c86e-4de3-9b2e-d29e0950b8ed",
                                                "sense_id": "389b2a29-4a2e-306f-b303-87eb3e5169bf",
                                                "text": "Débit de vins, de liqueurs : commerce de vin, de liqueurs, au détail et en boutique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9ad27eb-2af7-332e-89bd-ae4bb4d9652f",
                                        "entry_id": "0d0187a5-3e07-3c49-945a-e57a92225f0c",
                                        "glosses": [
                                            "Droit de vendre certaines marchandises dont le gouvernement s’est réservé le monopole."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1839b340-86ea-4efd-b938-35b379f30e73",
                                                "sense_id": "d9ad27eb-2af7-332e-89bd-ae4bb4d9652f",
                                                "text": "Il obtint un débit de tabac."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af0a1b66-eedf-36ae-969e-6bda7480df7e",
                                        "entry_id": "0d0187a5-3e07-3c49-945a-e57a92225f0c",
                                        "glosses": [
                                            "Endroit où se vendent les boissons, le tabac."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6aaca2b-d6c0-44e7-adf0-07e20429ce8f",
                                                "sense_id": "af0a1b66-eedf-36ae-969e-6bda7480df7e",
                                                "text": "— Je vis avec ma grand’mère qui tient un débit et une épicerie."
                                            },
                                            {
                                                "example_id": "2c95a883-1708-4f79-ba08-d4c5976f20fa",
                                                "sense_id": "af0a1b66-eedf-36ae-969e-6bda7480df7e",
                                                "text": "[…], et nous avons été ensemble boire une petite goutte au débit d’à côté ; le pauvre vieux ne déteste pas ça, quoi qu'il n'en ait jamais abusé."
                                            },
                                            {
                                                "example_id": "838d286e-3c5c-4f50-b7d4-ea62848a9bfb",
                                                "sense_id": "af0a1b66-eedf-36ae-969e-6bda7480df7e",
                                                "text": "Aujourd'hui, je médite; je me rappelle avoir été frappé, partout où je suis allé, d'apercevoir dans les débits, dès la première heure du matin, des masses de gens, hommes ou femmes, corsant leur café par des rasades d'eau-de-vie."
                                            },
                                            {
                                                "example_id": "7fe7a26f-44fd-48d3-8564-38f67813d699",
                                                "sense_id": "af0a1b66-eedf-36ae-969e-6bda7480df7e",
                                                "text": "[…], rien ne resplendit plus, après minuit, que cinq ou six débits mal fréquentés dont l'éclairage ourle le trottoir d'un morne flamboiement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28b161ea-7777-3af3-bcd1-900680fd1570",
                                        "entry_id": "0d0187a5-3e07-3c49-945a-e57a92225f0c",
                                        "glosses": [
                                            "Quantité, généralement, d'un fluide ou de tout autre chose, passant en en point donné, au travers une surface donnée, pendant une unité de temps."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5ac6b11c-5958-3908-9dec-3d7445f566f9",
                                        "entry_id": "0d0187a5-3e07-3c49-945a-e57a92225f0c",
                                        "glosses": [
                                            "Quantité, généralement, d'un fluide ou de tout autre chose, passant en en point donné, au travers une surface donnée, pendant une unité de temps.",
                                            "Quantité d’eau que débite une source, une fontaine ; du fluide que débite un bec de gaz."
                                        ],
                                        "tags": [
                                            "especially",
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f59bc682-cea5-47c5-8da8-cec7710c6c22",
                                                "sense_id": "5ac6b11c-5958-3908-9dec-3d7445f566f9",
                                                "text": "Parallèlement à la rivière, afin de régulariser le cours de l'eau, les paysans ont d'abord creusé puis cimenté un canal de dérivation équipé de batardeaux, ouvrages permettant de régler le débit de l'eau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e25e5a2-f935-3fda-a022-21e05d44ab89",
                                        "entry_id": "0d0187a5-3e07-3c49-945a-e57a92225f0c",
                                        "glosses": [
                                            "Quantité, généralement, d'un fluide ou de tout autre chose, passant en en point donné, au travers une surface donnée, pendant une unité de temps.",
                                            "Paramètre permettant de définir la vitesse d'un transfert de données numériques. Son unité est généralement un nombre de bits par seconde (bps)."
                                        ],
                                        "tags": [
                                            "especially",
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32c88899-c717-4d89-837b-06af41edf72e",
                                                "sense_id": "8e25e5a2-f935-3fda-a022-21e05d44ab89",
                                                "text": "Un débit Internet de 512Kbps (512 Kilo bits par seconde)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "618735a5-2531-36a8-bf4b-1f1b43838ca6",
                                        "entry_id": "0d0187a5-3e07-3c49-945a-e57a92225f0c",
                                        "glosses": [
                                            "Nombre de pièces que peut produire une machine, une usine dans une unité de temps."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "49dfcd08-b72d-3dcb-8358-7c061df7b670",
                                        "entry_id": "0d0187a5-3e07-3c49-945a-e57a92225f0c",
                                        "glosses": [
                                            "Exploitation du bois, selon ses diverses destinations, comme lorsqu’on le met en poutres, en merrains, en cerceaux, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7684f4c5-5854-4747-81d2-16f05f8f93df",
                                                "sense_id": "49dfcd08-b72d-3dcb-8358-7c061df7b670",
                                                "text": "Le débit du châtaignier en planches, en échalas, en bois à brûler."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5978b5e-55f4-33af-8558-45ff531cc47c",
                                        "entry_id": "0d0187a5-3e07-3c49-945a-e57a92225f0c",
                                        "glosses": [
                                            "Manière de s’énoncer, de réciter."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27c465ec-b06e-4be6-82a5-e2fc31eff376",
                                                "sense_id": "f5978b5e-55f4-33af-8558-45ff531cc47c",
                                                "text": "Ce conférencier a le débit aisé, le débit agréable."
                                            },
                                            {
                                                "example_id": "b9404183-6802-4baf-8ad5-2cd3dfd616d6",
                                                "sense_id": "f5978b5e-55f4-33af-8558-45ff531cc47c",
                                                "text": "C’est qu’aujourd’hui on compose en récitation classique et débit, et ma mère veut que j’aie le prix.\nPour cela, il faut non seulement savoir, mais bien dire ; et un nez vigoureusement clarifié permet d’avoir la voix claire."
                                            },
                                            {
                                                "example_id": "b8525109-7da4-4480-b98d-38b26f158e6d",
                                                "sense_id": "f5978b5e-55f4-33af-8558-45ff531cc47c",
                                                "text": "… car il avait un défaut de prononciation, essayait de rattraper un cheveu posé sur sa langue, s'emballait, précipitait le débit et mangeait des syllabes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47bd67fc-4359-3470-8351-ff94e6bad488",
                                        "entry_id": "0d0187a5-3e07-3c49-945a-e57a92225f0c",
                                        "glosses": [
                                            "Récitation précipitée qui ressemble à la parole."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dd4fe45d-5da0-3732-894e-64602a157b29",
                                        "entry_id": "0d0187a5-3e07-3c49-945a-e57a92225f0c",
                                        "glosses": [
                                            "Compte que l’on inscrit sur le grand livre des articles payés ou fournis à quelqu’un ou pour quelqu’un."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "04fafb67-9e41-3e36-b09f-d8f513db7028",
                                        "entry_id": "0d0187a5-3e07-3c49-945a-e57a92225f0c",
                                        "glosses": [
                                            "Ce qui est dû par quelqu’un dans un compte courant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35bd6df6-61ba-477d-b357-409c0e77a192",
                                                "sense_id": "04fafb67-9e41-3e36-b09f-d8f513db7028",
                                                "text": "Porter, inscrire au débit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
