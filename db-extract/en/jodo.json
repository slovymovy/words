    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "58e45c45-c5bc-386e-a991-e2dcfdfd0ebc",
                "word": "Jodo",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e1a725ed-0315-3e98-876b-36f4171b19ae",
                        "entry_id": "58e45c45-c5bc-386e-a991-e2dcfdfd0ebc",
                        "glosses": [
                            "Synonym of Pure Land: a sect of Buddhism and its primary afterlife, the seat of the Amida Buddha."
                        ],
                        "tags": [
                            "Japanese"
                        ],
                        "examples": [
                            {
                                "example_id": "6a5d7d12-fb78-4114-b362-680c11b0ba3d",
                                "sense_id": "e1a725ed-0315-3e98-876b-36f4171b19ae",
                                "text": "...zealous persons, chiefly the followers of the Sect of Siodo..."
                            },
                            {
                                "example_id": "d2a4cad5-babb-4ab7-a049-8be852974693",
                                "sense_id": "e1a725ed-0315-3e98-876b-36f4171b19ae",
                                "text": "The Jō-do-shū, or Pure Land sect."
                            },
                            {
                                "example_id": "5d9e8e80-778e-448c-9404-4f4aa31f4108",
                                "sense_id": "e1a725ed-0315-3e98-876b-36f4171b19ae",
                                "text": "In 1579, the two great sects of Nichiren and Jōdo held a great discussion upon religious subjects."
                            },
                            {
                                "example_id": "8c7fd16f-32a0-425e-aff0-b77a4545ff4b",
                                "sense_id": "e1a725ed-0315-3e98-876b-36f4171b19ae",
                                "text": "In the far off West there is said to be the home of Amida... He is free from the chain of transmigration and enjoys a conscious and happy immortality in ‘Jodo’,—that is, in the Pure Land."
                            },
                            {
                                "example_id": "cb0d68f2-df35-4a6b-89a0-13b0494d6d1a",
                                "sense_id": "e1a725ed-0315-3e98-876b-36f4171b19ae",
                                "text": "The Jōdo appeals naturally more to plebeian requirements because of the simpleness of its faith and teaching."
                            },
                            {
                                "example_id": "a72c945f-3a42-46a4-9c8e-deb647f74e90",
                                "sense_id": "e1a725ed-0315-3e98-876b-36f4171b19ae",
                                "text": "Jodo Buddhism... had in its structure a grace-based doctrine of salvation of trusting in its goddess that was similar to the doctrine of grace in Christianity."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
                    {
                        "linkage_id": "7de40748-e91c-4c4c-b022-ad3e6413b3aa",
                        "source_entry_id": "58e45c45-c5bc-386e-a991-e2dcfdfd0ebc",
