                                "target_lang_word": "system",
                                "target_lang_sense_clarification": "geological classification"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "系",
                                "target_lang_sense_clarification": "指地质分类"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4eb3c9c5-6977-318a-b42c-5457adf9b75e",
                    "sense_definition": "Вид русского боевого искусства, основанный на естественных движениях и расслаблении.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "5",
                    "name_type": "brand_or_product_name",
                    "examples": [
                        {
                            "text": "Он уже несколько лет занимается единоборством, которое называется <w>система</w>.",
                            "target_lang_translations": {
                                "en": "He has been practicing a martial art called <w>Systema</w> for several years.",
                                "zh": "他练习一种叫<w>西斯特玛</w>的武术已经好几年了。"
                            }
