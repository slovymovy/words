                "senses": [
                    {
                        "sense_id": "8ecbf291-c52c-36cc-a7fe-a57896ba547a",
                        "entry_id": "af93be01-08d5-3246-be85-e1656346cdb4",
                        "glosses": [
                            "aus Irland stammend, irische Vorfahren habend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18acb3ed-3701-4bf8-965a-1b5de6fecb96",
                                "sense_id": "8ecbf291-c52c-36cc-a7fe-a57896ba547a",
                                "text": "„Er war ein irischstämmiger Katholik, Sohn eines Polizeikommissars aus Springfield, Massachusetts.“"
                            },
                            {
                                "example_id": "2b6c8830-0fa6-470e-8a82-0ce86ef00edd",
                                "sense_id": "8ecbf291-c52c-36cc-a7fe-a57896ba547a",
                                "text": "„Als eine im Februar 1900 aus Chicago abgereiste Einheit von irischstämmigen Amerikanern in Transvaal eintraf, entledigten sich die meisten der sechzig Männer sofort ihrer Rotkreuz-Armbinden und ersetzten sie durch Gewehre und Patronengurte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
