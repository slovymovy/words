                        "sense_id": "4445c3ad-90d1-3d23-b69b-fedfbf51b8a9",
                        "entry_id": "4a454075-81bb-369f-a260-ef901fd846a6",
                        "glosses": [
                            "A woman who has received an inheritance."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
