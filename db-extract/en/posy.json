                    }
                ],
                "senses": [
                    {
                        "sense_id": "04a1ac72-e155-3b6d-a70d-519d9a6bba82",
                        "entry_id": "dd2d829a-4d8e-33ad-a581-825d53c130bb",
                        "glosses": [
                            "A flower; a small bouquet; a nosegay."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10fab448-d16f-4ba9-a038-c912b0813704",
                                "sense_id": "04a1ac72-e155-3b6d-a70d-519d9a6bba82",
                                "text": "And I will make thee beds of roses, / And a thousand fragrant posies;"
                            },
                            {
                                "example_id": "03f02b41-eb3f-4f2d-8905-7dfa4f08c894",
                                "sense_id": "04a1ac72-e155-3b6d-a70d-519d9a6bba82",
                                "text": "'Twas early June, the new grass was flourishing everywheres, the posies in the yard—peonies and such—in full bloom, the sun was shining, and the water of the bay was blue, with light green streaks where the shoal showed."
                            }
                        ]
                    },
                    {
                        "sense_id": "11797ff0-4524-3ef4-bce8-b81c3b6510bb",
                        "entry_id": "dd2d829a-4d8e-33ad-a581-825d53c130bb",
                        "glosses": [
                            "A verse of poetry, especially a motto or an inscription on a ring."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "c051cbe0-f3fe-4e41-99a8-31b335a1da8b",
                                "sense_id": "11797ff0-4524-3ef4-bce8-b81c3b6510bb",
                                "text": "Is this a Prologue, or the Poeſie of a Ring?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5008f59d-1968-4006-84b2-8c8806892189",
