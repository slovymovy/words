                        "entry_id": "24ae606c-34f7-3119-939e-5e6656648aa1",
                        "glosses": [
                            "Fine lame de parquet ou petite latte de bois utilisée pour le revêtement des murs et des plafonds."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6205036-b00e-41a9-be7a-ab4253fe033f",
                                "sense_id": "297d8ff5-eefd-3578-a709-8963fe7b6528",
                                "text": "Une simple cloison dans ce local, habillé d’une frisette jaunie et vieillotte qui montait jusqu’au plafond, séparait les vestiaires hommes des vestiaires femmes."
                            },
                            {
                                "example_id": "26cc2fde-5158-4cd8-ac93-d79b4d27c639",
                                "sense_id": "297d8ff5-eefd-3578-a709-8963fe7b6528",
                                "text": "J’ai des tarifs très avantageux pour la frisette, annonça-t-il."
                            }
                        ]
                    }
