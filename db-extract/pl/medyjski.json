                                        "entry_id": "33de3ed5-e49e-36c2-af66-2e872cf5be49",
                                        "glosses": [
                                            "Relatif à la Médie, aux Mèdes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c7b22f8-6673-4a79-950a-01197878da08",
                                                "sense_id": "fea6526a-7a0f-34a5-9f0e-6d1f9b476030",
                                                "text": "Il manque pour cette période des documents en langue parthe, mède, scythique, bactrienne, sogdienne, chorasmienne."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mède",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ec3b35af-5de0-3343-b10c-ceb708b9311c",
                                        "entry_id": "fd3bf18a-46d6-3a75-b6d2-62c88386efb1",
                                        "glosses": [
                                            "Idiome qu’on a nommé touranien, parlé en Médie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57484f73-0362-4f7e-a8db-d49fcb4a427b",
                                                "sense_id": "ec3b35af-5de0-3343-b10c-ceb708b9311c",
                                                "text": "Toutes les inscriptions officielles des rois de la race de Darius sont rédigées à la fois en perse, en mède et en assyrien."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ab90387b-b18f-4a09-a4d9-58517dfed3d0",
                        "source_entry_id": "69937529-f4e5-3b46-893b-fe77a525df11",
                        "source_sense_id": "4081ca35-2408-3eed-b0e9-896eced65d80",
                        "target_lang_word": "médique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "médique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bed6f2f0-4869-35cf-9cf2-ab6652ff8606",
                                        "entry_id": "d09c0161-6e40-326d-b940-76394ea5286d",
                                        "glosses": [
                                            "Qui appartient aux Mèdes, ou aux Perses que les Grecs appelaient souvent Mèdes."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f83d4687-2c69-4f68-8e4d-ae98d12807a8",
                                                "sense_id": "bed6f2f0-4869-35cf-9cf2-ab6652ff8606",
                                                "text": "Les guerres médiques, guerres que les Perses firent aux Grecs dans le cinquième siècle avant J.-C."
                                            },
                                            {
                                                "example_id": "4b0598a7-032c-43f8-a5c4-19c11bd4327e",
                                                "sense_id": "bed6f2f0-4869-35cf-9cf2-ab6652ff8606",
                                                "text": "La première guerre médique, la seconde guerre médique."
                                            },
                                            {
                                                "example_id": "c6af7ea1-c897-4526-81f5-5d6682a33a3a",
                                                "sense_id": "bed6f2f0-4869-35cf-9cf2-ab6652ff8606",
                                                "text": "La puissance ninivite s'écroula sous une invasion médique."
                                            }
                                        ]
                                    }
                                ]
                            },
