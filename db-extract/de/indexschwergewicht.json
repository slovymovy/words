                    {
                        "sense_id": "1c816a7e-f0b1-3347-adcf-cf57b7a39e13",
                        "entry_id": "2d1e2277-e0f1-3ba1-8c3e-f507e2f841c4",
                        "glosses": [
                            "Wertpapier, das in einem Wertpapierindex einen hohen Anteil einnimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "784b0c81-2236-4119-8eba-3fbb715e6b77",
                                "sense_id": "1c816a7e-f0b1-3347-adcf-cf57b7a39e13",
                                "text": "„Derzeit stellt der britischen Rohstoffkonzern Rio Tinto mit einer Gewichtung von 15 Prozent das Indexschwergewicht dar, der kanadischen Uranförderer International Uranium Corp., ist mit einer Gewichtung von 7,59 Prozent derzeit das Leichtgewicht des Index.“"
                            },
                            {
                                "example_id": "56e6058b-4d48-4c3e-a530-e4eed867c5b3",
                                "sense_id": "1c816a7e-f0b1-3347-adcf-cf57b7a39e13",
                                "text": "„Allerdings erholt sich der Aktienmarkt von den Tiefständen des frühen Handels, nachdem sich das Indexschwergewicht Nestlé ins Plus vorgearbeitet hat.“"
                            },
                            {
                                "example_id": "def6efd6-6b54-4d62-b3e8-397bb1430ade",
                                "sense_id": "1c816a7e-f0b1-3347-adcf-cf57b7a39e13",
                                "text": "„Mit deutlichen Kursgewinnen von mehr als 3,7 Prozent zieht am Dienstag das Indexschwergewicht General Electric den S&P 500-Index nach oben.“"
                            },
                            {
                                "example_id": "f63337e8-db45-41da-8a51-0143051d3c6a",
                                "sense_id": "1c816a7e-f0b1-3347-adcf-cf57b7a39e13",
                                "text": "„Schub erhielt der Dax vom Indexschwergewicht Bayer, dessen Titel mit einem Plus von 7,8 Prozent an der Spitze im deutschen Leitindex standen.“"
                            }
                        ],
