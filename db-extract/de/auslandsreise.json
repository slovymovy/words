                ],
                "senses": [
                    {
                        "sense_id": "31c4e33e-d137-385f-8711-8d07846bbe79",
                        "entry_id": "eeb63b58-c468-37f0-b51b-9947e8c5b30c",
                        "glosses": [
                            "Reise, die ins Ausland führt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82fa8dec-5dfd-4273-a7fd-492aa17485c7",
                                "sense_id": "31c4e33e-d137-385f-8711-8d07846bbe79",
                                "text": "Martin lud Tatjana zu einer Auslandsreise ein."
                            },
                            {
                                "example_id": "eeb555aa-55e9-4627-afd9-ec7fe8025fe1",
                                "sense_id": "31c4e33e-d137-385f-8711-8d07846bbe79",
                                "text": "„Das Treffen der Führer der arabischen Erdöl exportierenden Länder war die erste Auslandsreise nach seiner Inthronisation.“"
                            },
                            {
                                "example_id": "382e79a1-407e-4088-a77a-43a5e9a7eb72",
                                "sense_id": "31c4e33e-d137-385f-8711-8d07846bbe79",
                                "text": "„Auslandsreisen waren auch nur höchst selten möglich.“"
                            },
                            {
                                "example_id": "9adcf28f-afc9-4501-a877-ebeb1cb011ee",
                                "sense_id": "31c4e33e-d137-385f-8711-8d07846bbe79",
                                "text": "„Auslandsreisen waren ohnehin verboten, auch hatte ja niemand Devisen.“"
                            },
                            {
                                "example_id": "52d25e34-fa42-4ef0-83cf-dcdcc984b93b",
                                "sense_id": "31c4e33e-d137-385f-8711-8d07846bbe79",
                                "text": "„Thomas Mann wird mit offenen Armen aufgenommen, Remarque hat zwar bei seinen Auslandsreisen später Paßprobleme, bleibt aber in Porto Ronco ansonsten unbehelligt.“"
                            },
                            {
                                "example_id": "40ba077d-11e7-43fd-8ffa-5227df4c3406",
                                "sense_id": "31c4e33e-d137-385f-8711-8d07846bbe79",
                                "text": "„Doch er konnte Auslandsreisen unternehmen und nutzte die Zeit, um Kontakte zu westlichen Politikern aufzubauen und um in Europa als Sprecher der ZANU aufzutreten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
