                                "target_senses": [
                                    {
                                        "sense_id": "64c2c928-e7ae-3e03-9e80-68b0dfb7271b",
                                        "entry_id": "c847df53-8bd6-3fc8-a845-32d827b33082",
                                        "glosses": [
                                            "Ở vào tình trạng không biết nên nói năng, hành động, xử trí như thế nào, do không làm chủ được tình thế."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bb75e36-0b81-4d6c-a930-c5f729ae4d01",
                                                "sense_id": "64c2c928-e7ae-3e03-9e80-68b0dfb7271b",
                                                "text": "Lúng túng khi nói chuyện trước đám đông."
                                            },
                                            {
                                                "example_id": "a2c342d4-b5cb-4efc-b5e0-c1969d2c8d6c",
                                                "sense_id": "64c2c928-e7ae-3e03-9e80-68b0dfb7271b",
                                                "text": "Trả lời lúng túng."
                                            },
                                            {
                                                "example_id": "6276e8d7-5901-419f-9501-febd0354393a",
                                                "sense_id": "64c2c928-e7ae-3e03-9e80-68b0dfb7271b",
                                                "text": "Lúng túng như thợ vụng mất kim (tục ngữ)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
