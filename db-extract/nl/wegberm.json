                                                "sense_id": "bd94fc4d-f45b-3d12-a0b3-2f7e723feb3a",
                                                "text": "passage[…]in thy ſhoulder do I builde my Seate;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89365593-08e1-32e3-bf0c-dffd0e6b9cd9",
                                        "entry_id": "f48c868e-91bf-34a9-82e3-9a22975b8af1",
