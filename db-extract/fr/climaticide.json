                "senses": [
                    {
                        "sense_id": "4013aa9f-c1df-383c-b6d5-144a1b18f1db",
                        "entry_id": "d6728120-5f02-339a-82d1-5e05458e7d80",
                        "glosses": [
                            "Qui participe au dérèglement du climat de la Terre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "724c3abd-ee0b-42bf-97a3-a1a3af6a45b6",
                                "sense_id": "4013aa9f-c1df-383c-b6d5-144a1b18f1db",
                                "text": "Plein succès de l’action contre le pétrole climaticide"
                            },
                            {
                                "example_id": "18451b7b-ad6a-4929-ba6f-fa70b1777f26",
                                "sense_id": "4013aa9f-c1df-383c-b6d5-144a1b18f1db",
                                "text": "De son côté, la coordination des opposants à l’A45 dénonce un projet « inutile et climaticide » et rappelle que « l’avis favorable rendu par le Conseil d’Etat ne vaut pas signature du gouvernement »."
                            },
                            {
                                "example_id": "fbc7d13f-e332-454b-9e5f-34f7f3a8373f",
                                "sense_id": "4013aa9f-c1df-383c-b6d5-144a1b18f1db",
                                "text": "Il s’agit de soutenir les investissements et la création massive d’emplois dans la transition écologique et énergétique, de désinvestir des activités les plus polluantes et climaticides, d’opérer un vaste partage des richesses et de mener des politiques bien plus ambitieuses de formation et de reconversion professionnelles pour éviter que les travailleurs·euses et les populations précaires n’en fassent les frais."
                            },
                            {
                                "example_id": "e9f5b32c-1b49-4b7a-b131-866b61737b6a",
                                "sense_id": "4013aa9f-c1df-383c-b6d5-144a1b18f1db",
                                "text": "Vous suivez une autre voie, celle d'une alliance climaticide avec la Pologne et la Hongrie, lui a-t-il lancé."
                            }
                        ]
                    }
                ],
