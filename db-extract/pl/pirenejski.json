                                        "entry_id": "296b2019-9db4-322b-a973-1a85e8376069",
                                        "glosses": [
                                            "A native or inhabitant of the Pyrenees."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "49fcd553-7c7e-4401-a4a9-adff719ee43e",
                        "source_entry_id": "8304c75e-b2cf-38e5-bf5c-603bfd5e8b31",
