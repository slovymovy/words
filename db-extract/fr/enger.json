                "senses": [
                    {
                        "sense_id": "68e16d47-4cf9-3c1e-8d28-28cb7311aa22",
                        "entry_id": "dfa063f8-96f1-3b4e-9f12-4b603f416afb",
                        "glosses": [
                            "Pourvoir d’un plant, d’une herbe."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "b5c733f1-119e-4ed8-8ada-743b5904c378",
                                "sense_id": "68e16d47-4cf9-3c1e-8d28-28cb7311aa22",
                                "text": "Un tel m’a engé de ce plant, mais je n’en espère rien de bon."
                            },
                            {
                                "example_id": "e977fb92-91ad-47c5-92a1-aff51d547c38",
                                "sense_id": "68e16d47-4cf9-3c1e-8d28-28cb7311aa22",
                                "text": "Qui a engé votre jardin de cette herbe ? elle ne vaut rien."
                            },
                            {
                                "example_id": "9145bf5d-08aa-4c79-8846-60fa898446cc",
                                "sense_id": "68e16d47-4cf9-3c1e-8d28-28cb7311aa22",
                                "text": "L'ambassadeur Nicot a engé la France de l'herbe nicotiane [tabac]."
                            }
                        ]
                    },
                    {
                        "sense_id": "1d23760f-a7ac-35d5-9182-10ad2600e3cd",
                        "entry_id": "dfa063f8-96f1-3b4e-9f12-4b603f416afb",
                        "glosses": [
                            "Embarrasser d’une sotte ou d’une mauvaise engeance."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "0d0f6b85-d5bc-448c-9113-7952660f8a61",
                                "sense_id": "1d23760f-a7ac-35d5-9182-10ad2600e3cd",
                                "text": "Votre père se moque-t-il de vouloir vous enger de son avocat de Limoges ?"
                            }
                        ]
                    }
