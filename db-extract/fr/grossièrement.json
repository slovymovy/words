                                "target_senses": [
                                    {
                                        "sense_id": "24853cc5-6919-3d69-9399-f384528cae82",
                                        "entry_id": "e690e08d-4741-36ac-867a-3125b71879c3",
                                        "glosses": [
                                            "In a churlish manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dde8d7c1-0a3c-4570-895e-e1ac0094d071",
                                                "sense_id": "24853cc5-6919-3d69-9399-f384528cae82",
                                                "text": "How churlishlyI chid Lucreatia hence, / When willingly I would have had her here."
                                            }
