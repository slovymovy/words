                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ed00ba0-15a1-4908-98eb-ee65bb4a051c",
                                                "sense_id": "b0e5a5d9-317b-3136-b70d-b80d96f3f122",
                                                "text": "Voici un homme qui, par son délit ou son crime, a motivé l'intervention de la loi ; mais la Justice n'a devant elle qu'un irresponsable, qu'un aliéné, et elle désarme."
                                            },
                                            {
                                                "example_id": "f9d06ab6-29e5-4d9d-805a-e5dd379f36c2",
                                                "sense_id": "b0e5a5d9-317b-3136-b70d-b80d96f3f122",
                                                "text": "La seconde loi « sur l’organisation de l’assistance publique » complète la précédente en prescrivant qu'aucun aliéné ne peut être admis ou gardé en séjour à l’Hôpital cantonal."
                                            }
                                        ]
