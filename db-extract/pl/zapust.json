                                "example_id": "5c238ad9-6552-490f-9069-edea508fb62a",
                                "sense_id": "e90f6265-ed9a-34fc-89bc-3467d882f2ea",
                                "text": "Zimą przejazdki, brygad parady, • W zapust kuliki, miłe szlichtady • Czoło zakwaszą."
                            },
                            {
                                "example_id": "770e6739-4b03-4b12-bd7f-2855f8bd254a",
                                "sense_id": "e90f6265-ed9a-34fc-89bc-3467d882f2ea",
                                "text": "[…] Tam w późne dosiewki ślij swata z pierścieniem, • A w zapust wyprawiaj wesele!"
                            }
                        ],
