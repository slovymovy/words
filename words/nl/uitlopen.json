    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c1cf7cd2-c497-3eda-838c-d5dc48564615",
                    "sense_definition": "lopend een ruimte verlaten",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij is woedend de kamer <w>uitgelopen</w> na de ruzie.",
                            "target_lang_translations": {
                                "en": "He <w>walked out</w> of the room in a rage after the argument."
                            }
                        },
                        {
                            "text": "De leerlingen moeten rustig het lokaal <w>uitlopen</w> als de bel gaat.",
                            "target_lang_translations": {
                                "en": "The students must <w>walk out</w> of the classroom quietly when the bell rings."
                            }
                        }
                    ],
                    "common_phrases": [
                        "de kamer uitlopen",
                        "het gebouw uitlopen"
                    ],
                    "target_lang_definitions": {
                        "en": "to leave a space or room on foot"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "walk out",
                                "target_lang_sense_clarification": "to leave a room or building by walking"
                            },
                            {
                                "target_lang_word": "leave",
                                "target_lang_sense_clarification": "to depart from a place"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4732557a-196e-3bbb-afbf-709e9058ca6d",
                    "sense_definition": "langer duren dan oorspronkelijk gepland of verwacht",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "tijd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De vergadering <w>liep uit</w> omdat er te veel vragen waren.",
                            "target_lang_translations": {
                                "en": "The meeting <w>ran over</w> because there were too many questions."
                            }
                        },
                        {
                            "text": "Ik kom iets later, want mijn afspraak is een kwartier <w>uitgelopen</w>.",
                            "target_lang_translations": {
                                "en": "I'll be a bit late because my appointment <w>overran</w> by fifteen minutes."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een kwartier uitlopen",
                        "behoorlijk uitlopen"
                    ],
                    "target_lang_definitions": {
                        "en": "to last longer than originally planned or expected"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "run over",
                                "target_lang_sense_clarification": "to exceed the scheduled time"
                            },
                            {
                                "target_lang_word": "overrun",
                                "target_lang_sense_clarification": "to go beyond a time limit"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0f545de7-d720-301e-9177-fd7371692f23",
                    "sense_definition": "resulteren in een bepaalde uitkomst of gevolg",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "resultaat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dat project is helaas <w>uitgelopen</w> op een grote nederlaag.",
                            "target_lang_translations": {
                                "en": "Unfortunately, that project <w>ended in</w> a major defeat."
                            }
                        },
                        {
                            "text": "De discussie <w>liep uit</w> op een felle ruzie tussen de buren.",
                            "target_lang_translations": {
                                "en": "The discussion <w>resulted in</w> a fierce argument between the neighbors."
                            }
                        }
                    ],
                    "common_phrases": [
                        "uitlopen op niets",
                        "uitlopen op een sisser"
                    ],
                    "target_lang_definitions": {
                        "en": "to result in a specific outcome or consequence"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "end in",
                                "target_lang_sense_clarification": "to have a particular final result"
                            },
                            {
                                "target_lang_word": "result in",
                                "target_lang_sense_clarification": "to cause a specific outcome"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf5db7f0-607f-37e4-a7a0-1313612462ed",
                    "sense_definition": "het proces waarbij planten nieuwe takjes, knoppen of blaadjes vormen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "natuur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De lente is vroeg dit jaar en de bomen <w>lopen</w> al <w>uit</w>.",
                            "target_lang_translations": {
                                "en": "Spring is early this year and the trees are already <w>budding</w>."
                            }
                        },
                        {
                            "text": "In april beginnen de meeste struiken in de tuin prachtig <w>uit te lopen</w>.",
                            "target_lang_translations": {
                                "en": "In April, most shrubs in the garden begin to <w>sprout</w> beautifully."
                            }
                        }
                    ],
                    "synonyms": [
                        "botten",
                        "knoppen",
                        "uitbotten",
                        "uitkomen"
                    ],
                    "common_phrases": [
                        "in de lente uitlopen"
                    ],
                    "target_lang_definitions": {
                        "en": "the process where plants form new twigs, buds, or leaves"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bud",
                                "target_lang_sense_clarification": "to start forming new buds"
                            },
                            {
                                "target_lang_word": "sprout",
                                "target_lang_sense_clarification": "to begin to grow new leaves or shoots"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b033be99-36e9-373c-81ba-a3b2ebb9f756",
                    "sense_definition": "de afstand tot een achtervolger of concurrent groter maken",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wedstrijd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ondanks mijn goede conditie <w>liep</w> hij tijdens de marathon toch op mij <w>uit</w>.",
                            "target_lang_translations": {
                                "en": "Despite my good fitness, he still <w>pulled away</w> from me during the marathon."
                            }
                        },
                        {
                            "text": "De koploper wist zijn voorsprong in de laatste ronde verder <w>uit te lopen</w>.",
                            "target_lang_translations": {
                                "en": "The leader managed to <w>extend</w> his lead further in the final round."
                            }
                        }
                    ],
                    "antonyms": [
                        "inlopen"
                    ],
                    "common_phrases": [
                        "op iemand uitlopen",
                        "voorsprong uitlopen"
                    ],
                    "target_lang_definitions": {
                        "en": "to increase the distance from a pursuer or competitor"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pull away",
                                "target_lang_sense_clarification": "to increase a lead in a race"
                            },
                            {
                                "target_lang_word": "extend a lead",
                                "target_lang_sense_clarification": "to make the gap between competitors larger"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f2f24174-5343-3607-95cc-5b2509df627d",
                    "sense_definition": "een bepaalde afstand of route te voet helemaal voltooien",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "voltooien",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik heb genoeg getraind om te weten dat ik de vierdaagse kan <w>uitlopen</w>.",
                            "target_lang_translations": {
                                "en": "I've trained enough to know that I can <w>finish</w> the four-day march."
                            }
                        },
                        {
                            "text": "Het was een zware tocht, maar we hebben hem uiteindelijk helemaal <w>uitgelopen</w>.",
                            "target_lang_translations": {
                                "en": "It was a tough journey, but we eventually <w>completed</w> it entirely."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een marathon uitlopen",
                        "de wedstrijd uitlopen"
                    ],
                    "target_lang_definitions": {
                        "en": "to complete a certain distance or route entirely on foot"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "finish",
                                "target_lang_sense_clarification": "to complete a race or walk"
                            },
                            {
                                "target_lang_word": "complete",
                                "target_lang_sense_clarification": "to go the full distance of a route"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fcf7fb8d-412c-3664-ae95-291e35406942",
                    "sense_definition": "ontrouw zijn aan een echtgenoot of vaste partner",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "relaties",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Iedereen weet dat <w>uitlopen</w> niet goed is voor een stabiele relatie.",
                            "target_lang_translations": {
                                "en": "Everyone knows that <w>cheating</w> is not good for a stable relationship."
                            }
                        },
                        {
                            "text": "Zij besloot hem te verlaten nadat ze ontdekte dat hij al jaren <w>uitliep</w>.",
                            "target_lang_translations": {
                                "en": "She decided to leave him after she discovered he had been <w>stepping out</w> for years."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used informally to describe infidelity."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to be unfaithful to a spouse or long-term partner"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cheat",
                                "target_lang_sense_clarification": "to be unfaithful in a relationship"
                            },
                            {
                                "target_lang_word": "step out",
                                "target_lang_sense_clarification": "informal term for being unfaithful"
                            }
                        ]
                    },
                    "common_phrases": [
                        "uitlopen op je partner"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
