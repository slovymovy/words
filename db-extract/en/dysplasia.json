                                        "examples": [
                                            {
                                                "example_id": "3adfe534-f977-4103-b46b-f8776ebc37d4",
                                                "sense_id": "17cceb9c-4de0-3f70-9e28-df356aa9cac9",
                                                "text": "Il a une dysplasie de hanche."
                                            },
                                            {
                                                "example_id": "b8ee71e8-4e28-44a7-874b-025660ebda32",
                                                "sense_id": "17cceb9c-4de0-3f70-9e28-df356aa9cac9",
                                                "text": "Des précurseurs parfois célèbres n’avaient pas pu identifier la dysplasie du fait d’un nombre de cas trop restreint étudiés par le même médecin et par manque de diffusion d’observations éparses concernant le comportement du ventricule droit."
                                            }
                                        ]
