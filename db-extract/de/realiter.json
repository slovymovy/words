                        "examples": [
                            {
                                "example_id": "33aeec1c-b087-46bf-9a8e-e39dcc71cf61",
                                "sense_id": "7e3f377f-80d9-3143-8fa5-e50e5906c55f",
                                "text": "„Doppelgänger sind bedrohlich und die Erfahrung, einem Wiedergänger realiter gegenüberzustehen, empfand ich regelmäßig als personifizierten Angriff auf das eigene Selbst, als narzisstische Kränkung: Bin ich tatsächlich so seltsam wie der da?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "73478fc4-bb3e-4178-ae2a-c126ed434a8c",
                        "source_entry_id": "f23e68f8-0d8a-3a3d-8666-e50f07d282c8",
                        "source_sense_id": "7e3f377f-80d9-3143-8fa5-e50e5906c55f",
                        "source_sense_description": "in Wirklichkeit",
                        "target_lang_word": "en réalité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "en réalité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5e1c85a6-3298-3bee-ab42-10bb64968820",
                                        "entry_id": "9a9b7325-9612-3e04-bbfc-6b16911d47fa",
                                        "glosses": [
                                            "Réellement ; effectivement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d1eaf1a-f08b-42a8-9c46-950ad7c56e33",
                                                "sense_id": "5e1c85a6-3298-3bee-ab42-10bb64968820",
                                                "text": "Elle semblait faite pour glisser, en robe blanche, dans des paysages liturgiques, […]. En réalité, elle trayait les vaches, cette âme, elle crochait le fumier dans la cour, ce rêve."
                                            },
                                            {
                                                "example_id": "6d3acf87-3975-4b76-b717-5cc21784dc4c",
                                                "sense_id": "5e1c85a6-3298-3bee-ab42-10bb64968820",
                                                "text": "Une coiffure faussement sage et naturelle, en réalité hyper-glamour !"
                                            },
                                            {
                                                "example_id": "b9d30760-f469-4d54-baae-950117efbf76",
                                                "sense_id": "5e1c85a6-3298-3bee-ab42-10bb64968820",
                                                "text": "Toulon, en réalité, n’appartient, en propre, à aucune de nos provinces, c’est le Brest de la Méditerranée, à moins que Brest ne soit le Toulon de l’Océan."
                                            },
                                            {
                                                "example_id": "3be432b7-e8fc-43b2-815f-09333f4a07bc",
                                                "sense_id": "5e1c85a6-3298-3bee-ab42-10bb64968820",
                                                "text": "En réalité, ce vin du Caucase, quelque peu aigrelet, accompagne convenablement la poule bouillie, […]."
                                            },
                                            {
                                                "example_id": "09dcf015-bb5b-4df7-971d-a2131141972f",
                                                "sense_id": "5e1c85a6-3298-3bee-ab42-10bb64968820",
                                                "text": "Il mit également à ma disposition une escorte de deux mokhaznis, c’est-à-dire, en réalité, de deux espions chargés de le renseigner sur mes faits et gestes."
                                            },
                                            {
                                                "example_id": "cf87ae70-b16c-4dd5-9eda-226598324d8e",
                                                "sense_id": "5e1c85a6-3298-3bee-ab42-10bb64968820",
                                                "text": "Venue des États-Unis, on la trouve toute prête en bouteille. En réalité, il y a autant de sauces BBQ que de styles de barbecues."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
