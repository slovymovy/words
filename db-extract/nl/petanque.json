                ],
                "senses": [
                    {
                        "sense_id": "ef383e71-a7a5-327d-8091-76a2d3dbd449",
                        "entry_id": "6a8348d5-9e64-342a-b50d-7112964ad3e1",
                        "glosses": [
                            "spel waarbij men metalen ballen zo dicht mogelijk naar een klein houten balletje moet gooien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ee15851-ec25-458d-8152-13313fe64fba",
                                "sense_id": "ef383e71-a7a5-327d-8091-76a2d3dbd449",
                                "text": "Een wedstrijdje petanque is vlakbij het Franse Bordeaux helemaal ontspoord. Eén speler liep een messteek op, een ander verschillende breuken. Er zijn twee mannen aangehouden."
                            },
                            {
                                "example_id": "6e4296d1-0801-47d6-9c53-8acde164cf18",
                                "sense_id": "ef383e71-a7a5-327d-8091-76a2d3dbd449",
                                "text": "Tirer (schieten) en pointer (plaatsen) zijn veelgebruikte termen in jeu de boules, maar voorzitter Bert Lemmers en secretaris Jan de Ham, die samen met penningmeester Johan Brilman het bestuur vormen, spreken liever van petanque."
                            },
                            {
                                "example_id": "68691304-e332-42a5-a0b4-3ed21ccf629f",
                                "sense_id": "ef383e71-a7a5-327d-8091-76a2d3dbd449",
                                "text": "Aha, aha, dat doet mij genoegen, dat doet mij groot en machtig genoegen, dat u van pétanque houdt, want dat komt niet veel voor bij lieden, die niet hier inheems zijn."
                            }
                        ]
                    }
                ],
