                                        "glosses": [
                                            "Qui fait preuve d’amitié."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13dae3a9-30c5-4021-be59-03c489a8c9a0",
                                                "sense_id": "86b0144c-d808-3ff4-a61d-b4c275b40110",
                                                "text": "Un signe amical, un bonsoir de la main répondaient toujours à leur regard et à leur sourire."
                                            },
                                            {
                                                "example_id": "e3fa448c-f9a0-43f6-b199-88e2e8a656c8",
                                                "sense_id": "86b0144c-d808-3ff4-a61d-b4c275b40110",
                                                "text": "Bob, au passage, le secoua, le fit se lever et, lui administrant sur le crâne une amicale taloche, dit en me l’amenant : […]"
                                            },
                                            {
                                                "example_id": "66b8601b-1f37-4570-8ce0-6977449c8fc5",
                                                "sense_id": "86b0144c-d808-3ff4-a61d-b4c275b40110",
                                                "text": "Conseil amical."
                                            },
                                            {
                                                "example_id": "5f32bd27-2870-4ecd-95a3-2995b76a4bad",
                                                "sense_id": "86b0144c-d808-3ff4-a61d-b4c275b40110",
                                                "text": "Exhortation amicale."
                                            },
                                            {
