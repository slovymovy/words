                "senses": [
                    {
                        "sense_id": "95363f25-46b6-3863-88b3-af391f7d6d48",
                        "entry_id": "3f402d51-6afc-3dda-aecb-6f9fabc7b3ef",
                        "glosses": [
                            "Gesamtheit der Knochen, die den oberen Teil des Schädels bilden, bestehend aus dem Stirnbein (Os frontale), dem Scheitelbein (Os parietale) und dem Hinterhauptbein (Os occipitale)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "087f02f5-eae2-47c5-ad10-45a42d76c604",
                                "sense_id": "95363f25-46b6-3863-88b3-af391f7d6d48",
                                "text": "„Bei der Anencephalie fehlen die Kopfhaut, das knöcherne Schädeldach, die Hirnhäute und Teile des Gehirns.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6ada77f9-82ca-41aa-8175-4d76d9448dbe",
                        "source_entry_id": "3f402d51-6afc-3dda-aecb-6f9fabc7b3ef",
                        "source_sense_id": "95363f25-46b6-3863-88b3-af391f7d6d48",
                        "target_lang_word": "skullcap",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "skullcap",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5e015e44-d8a7-387e-8181-cc8069d10d4c",
                                        "entry_id": "be3f96d2-dfba-39b6-818f-a16c001b68fa",
                                        "glosses": [
                                            "A small domed cap that covers the area from the forehead to just above the back of the neck."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7ad6cfa-7b69-45b6-b337-523ebfdca320",
                                                "sense_id": "5e015e44-d8a7-387e-8181-cc8069d10d4c",
                                                "text": "He was a short man with a long hooked nose. A blue skull-cap with a red border scarcely covered his head of bristly grey hair, and a short-bodied but long Ringerike coat of dark grey frieze with worn velvet borders served to make the roundness and crookedness of his back still more conspicuous."
                                            },
                                            {
                                                "example_id": "a12519b7-c92f-4570-bfc1-6f6c071233aa",
                                                "sense_id": "5e015e44-d8a7-387e-8181-cc8069d10d4c",
                                                "text": "“I call on all citizens of Berlin and across Germany to wear the yarmulke (as the skullcap is known in Yiddish) next Saturday if there are new, intolerable attacks targeting Israel and Jews on the occasion of Al-Quds Day in Berlin,” said Felix Klein in a statement."
                                            },
                                            {
                                                "example_id": "b5edbda0-789e-4767-972b-2aaf789911bd",
                                                "sense_id": "5e015e44-d8a7-387e-8181-cc8069d10d4c",
                                                "text": "The French government in 2004 banned “conspicuous” religious symbols including Muslim headscarves, Jewish skullcaps and large Christian crosses from French schools."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db818f64-7280-3bbf-8d88-490233453304",
                                        "entry_id": "be3f96d2-dfba-39b6-818f-a16c001b68fa",
                                        "glosses": [
                                            "A yarmulke-like hat."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f26fdfcc-b0c6-3fca-a658-52a4f5a701f6",
                                        "entry_id": "be3f96d2-dfba-39b6-818f-a16c001b68fa",
                                        "glosses": [
                                            "The calvaria, the top part of the skull, covering the cranial cavity containing the brain."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f75d3457-a22a-340f-a709-9d5c1f867931",
                                        "entry_id": "be3f96d2-dfba-39b6-818f-a16c001b68fa",
                                        "glosses": [
                                            "Any of several species of flowering plants of the genus Scutellaria, in the Lamiaceae family."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "89317a6a-7cf6-3e02-a3b5-7bb2508a408c",
                                        "entry_id": "be3f96d2-dfba-39b6-818f-a16c001b68fa",
                                        "glosses": [
                                            "A torture device for compressing the skull."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c407473c-31c2-4dc3-81f4-03a2372dab0c",
