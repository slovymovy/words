                "senses": [
                    {
                        "sense_id": "66320c8e-1209-39b5-9cc8-a99d01fd13a7",
                        "entry_id": "19bafc74-2e7a-3eb2-9d94-693eda919861",
                        "glosses": [
                            "Krankenhausplatz (Bett), an dem eine künstliche Beatmung, Versorgung der Lunge mit Sauerstoff, durchgeführt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93a3bafc-a99d-4e15-b233-b9f1f4501dac",
                                "sense_id": "66320c8e-1209-39b5-9cc8-a99d01fd13a7",
                                "text": "„Gleichzeitig sollen die Behandlungskosten eingeschränkt, ein vielleicht lebensrettender Beatmungsplatz für den nächsten Patienten angeboten und die fur die Angehörigen sehr quälende Zeit des Wartens verkürzt werden […].“"
                            },
                            {
                                "example_id": "f9efe80e-3a36-4e55-ae38-6b6bcee8908b",
                                "sense_id": "66320c8e-1209-39b5-9cc8-a99d01fd13a7",
                                "text": "„Er lag in einem Doppelzimmer, neben ihm ein zurzeit freier Beatmungsplatz, mit einem Beatmungsgerät, das auf „bereit“ eingestellt war.“"
                            },
                            {
                                "example_id": "6eb86289-7cba-4b1e-b4be-3feb47f20948",
                                "sense_id": "66320c8e-1209-39b5-9cc8-a99d01fd13a7",
                                "text": "„Heute verfügt die Abteilung über 5 Intensivbetten mit einem Beatmungsplatz.“"
                            },
                            {
                                "example_id": "8e4502c5-fb33-4578-9fb4-3c887f345659",
                                "sense_id": "66320c8e-1209-39b5-9cc8-a99d01fd13a7",
                                "text": "„Die Krankenhausleitung von KH B hat dem Oberarzt der chirurgischen Intensivstation erst vor zwei Wochen mit Sperrung eines Beatmungsplatzes gedroht, wenn die Sachmittelkosten nicht kurzfristig um 20% gesenkt werden.“"
                            },
                            {
                                "example_id": "8376ccbe-e961-424a-b727-6790f72dae39",
                                "sense_id": "66320c8e-1209-39b5-9cc8-a99d01fd13a7",
                                "text": "„Eine Datenbank sollte einen schnellen Überblick ermöglichen, was die Kapazität an Beatmungsplätzen in deutschen Kliniken angeht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
