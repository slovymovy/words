                                        "sense_id": "31d65b7c-7e52-3e79-906d-35df5ede605b",
                                        "entry_id": "b72ae59f-28a7-3b9f-9058-d3767faca6b9",
                                        "glosses": [
                                            "Angabe von Gründen, Rechtfertigung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6018b7e0-aa6f-4b98-b59a-cc88cba2ff7a",
                                                "sense_id": "31d65b7c-7e52-3e79-906d-35df5ede605b",
                                                "text": "Warum hast Du das gemacht? Gib mir doch bitte eine Begründung!"
                                            },
                                            {
                                                "example_id": "6e5c0e3b-3ea3-4d85-aa88-ea48770bbb01",
                                                "sense_id": "31d65b7c-7e52-3e79-906d-35df5ede605b",
                                                "text": "Dies lehnte der Senat nun mit der Begründung ab, daß eine Veröffentlichung dem Staatswohl entgegenstehe."
                                            },
                                            {
                                                "example_id": "19d30231-57da-466a-9690-7d7bea51e02e",
                                                "sense_id": "31d65b7c-7e52-3e79-906d-35df5ede605b",
                                                "text": "„Daraufhin erließ eine weitere islamistische Gruppe eine Fatwa gegen das Buch mit der Begründung, es verstieße gegen die Gesetze der Scharia und bezweifle die Existenz Gottes.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
