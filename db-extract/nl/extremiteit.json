                    }
                ],
                "senses": [
                    {
                        "sense_id": "c5da27c3-26d8-30b2-9ccc-e2041fe233de",
                        "entry_id": "b5821175-91d3-37f6-9c95-14e01f77ebc2",
                        "glosses": [
                            "een van de ledematen"
                        ],
                        "tags": [],
