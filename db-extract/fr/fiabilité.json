        "fr-extract.jsonl": [
            {
                "entry_id": "457b5d05-ade1-3cb8-b77c-49bf83e3b224",
                "word": "fiabilité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e75100b7-7ec0-4041-9bd3-6205eb7022af",
                        "entry_id": "457b5d05-ade1-3cb8-b77c-49bf83e3b224",
                        "tags": [
                            "plural"
                        ],
                        "form": "fiabilités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "94e3dc01-eb30-3edd-b936-13e8d668a965",
                        "entry_id": "457b5d05-ade1-3cb8-b77c-49bf83e3b224",
                        "glosses": [
                            "Caractère de ce qui est fiable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76c5afbc-1b47-4abe-aff8-9919d8bec15d",
                                "sense_id": "94e3dc01-eb30-3edd-b936-13e8d668a965",
                                "text": "Le fil directeur de ces cours est la fiabilité et j’ai voulu montrer ce que peut apporter l’étude des processus stochastiques dans ce domaine."
                            },
                            {
                                "example_id": "01c3a63d-5ff6-45fe-9c8c-8c8aab01cb76",
                                "sense_id": "94e3dc01-eb30-3edd-b936-13e8d668a965",
                                "text": "« Pour serrer les prix, nous misons sur la vente directe dans notre shop à Paris ou en ligne, et sur l’utilisation au maximum de pièces standards du marché dont la fiabilité a été approuvée », explique Amélie Guicheney, l’une des créatrices."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d2b7fcf1-37b8-4dd1-be55-ceca592a0f28",
                        "source_entry_id": "457b5d05-ade1-3cb8-b77c-49bf83e3b224",
                        "source_sense_id": "94e3dc01-eb30-3edd-b936-13e8d668a965",
                        "target_lang_word": "Zuverlässigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zuverlässigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d553d6a8-476d-30be-96ca-d62d25b88177",
                                        "entry_id": "4e4213d6-eaa9-3be4-b9a4-333570e1cdb4",
                                        "glosses": [
                                            "das Zuverlässigsein; menschliche Eigenschaft, zuverlässig zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d649482-49d3-4540-9f2a-74100594d574",
                                                "sense_id": "d553d6a8-476d-30be-96ca-d62d25b88177",
                                                "text": "\"Zuverlässigkeit heißt nicht, das zu tun, womit andere rechnen, sondern das, worauf sie zählen.\""
                                            },
                                            {
                                                "example_id": "a1bd63e0-f9c6-46e3-bb6b-a68b8b4fc2b2",
                                                "sense_id": "d553d6a8-476d-30be-96ca-d62d25b88177",
                                                "text": "„In der Vorlesung werden zunächst die Sachzusammenhänge zum Menschlichen Fehler, der Zusammenhang zur Zuverlässigkeit technischer Systeme sowie die Gründe dargestellt, warum dieser Faktor gerade in heutigen technischen Systemen einen hohen Stellenwert einnimmt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "02252849-f3f8-34a2-a799-9449817a096b",
                                        "entry_id": "4e4213d6-eaa9-3be4-b9a4-333570e1cdb4",
                                        "glosses": [
                                            "das Zuverlässigsein; technische Eigenschaft, zuverlässig zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63081b70-5845-421d-afd6-6393b157ae5e",
                                                "sense_id": "02252849-f3f8-34a2-a799-9449817a096b",
                                                "text": "„In der Vorlesung werden zunächst die Sachzusammenhänge zum Menschlichen Fehler, der Zusammenhang zur Zuverlässigkeit technischer Systeme sowie die Gründe dargestellt, warum dieser Faktor gerade in heutigen technischen Systemen einen hohen Stellenwert einnimmt.“"
                                            },
                                            {
                                                "example_id": "95af79db-1413-4281-a81c-d2c6dcbda16c",
                                                "sense_id": "02252849-f3f8-34a2-a799-9449817a096b",
                                                "text": "„Sicherheit und Zuverlässigkeit von Softwaresystemen haben deshalb in den Bereichen Embedded Systems, Kommunikation und Anwendungssoftware hohe Priorität. “"
                                            },
                                            {
                                                "example_id": "3d98f562-866e-478d-a12d-9a02bcf3751d",
                                                "sense_id": "02252849-f3f8-34a2-a799-9449817a096b",
                                                "text": "„Auch volksetymologischen Deutungen wird Raum gegeben, soweit diese mit einiger Zuverlässigkeit den Kern der Sache treffen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7f60530e-5799-483c-aded-3814b8750cd1",
                        "source_entry_id": "457b5d05-ade1-3cb8-b77c-49bf83e3b224",
                        "source_sense_id": "94e3dc01-eb30-3edd-b936-13e8d668a965",
