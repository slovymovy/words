                "senses": [
                    {
                        "sense_id": "6af66657-9dbe-3048-a0ad-b61754d9ad57",
                        "entry_id": "28d844e1-6456-3a14-912a-39f915ed5fe4",
                        "glosses": [
                            "Transport guidé comportant un seul rail où les véhicules se déplacent à cheval sur le rail ou suspendus sous celui-ci en utilisant différentes techniques de propulsion et de sustentation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "733c4319-287a-4deb-9d0c-a30a45cd46ad",
                                "sense_id": "6af66657-9dbe-3048-a0ad-b61754d9ad57",
                                "text": "Depuis plusieurs années, il avait beaucoup été question du monorail. Mais le mal commença vraiment lorsque Brennan présenta aux divers corps savants d’Europe son monorail à wagon gyroscopique. Ce fut la grande vogue de 1907, […]."
                            },
                            {
                                "example_id": "83fb2662-3e80-4de0-8bf8-f546f7016dee",
                                "sense_id": "6af66657-9dbe-3048-a0ad-b61754d9ad57",
                                "text": "En France, il semble que le premier monorail soit celui de Larmanjat dont une ligne fut mise en service entre Le Raincy et Montfermeil, en 1868."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3b25b0fb-b07a-479e-baf5-779d6f5f2898",
