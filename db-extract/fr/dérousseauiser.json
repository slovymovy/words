                "senses": [
                    {
                        "sense_id": "41f307c8-8f7b-3640-82e7-0ac0ee572e86",
                        "entry_id": "c36e8739-88d0-3d46-8b66-533fe5bec466",
                        "glosses": [
                            "Faire perdre son caractère rousseauiste à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90805307-7ca2-4e48-adda-53098ba0d05b",
                                "sense_id": "41f307c8-8f7b-3640-82e7-0ac0ee572e86",
                                "text": "Quelques années avant de signer cette lettre à sa sœur dont nous avons cité quelques lignes, il s’exhortait déjà dans son Journal à dérousseauiser son jugement."
                            }
                        ]
                    },
                    {
                        "sense_id": "c82967fc-0b37-3e32-b53c-ed5bbc2c0dc1",
                        "entry_id": "c36e8739-88d0-3d46-8b66-533fe5bec466",
                        "glosses": [
                            "Perdre son caractère rousseauiste."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "02b6cff4-9221-41d3-a497-54cb26a17ab4",
                                "sense_id": "c82967fc-0b37-3e32-b53c-ed5bbc2c0dc1",
                                "text": "Stendhal voudra-t-il se défaire de cette fascination, il dira se « dérousseauiser », donnant par cet hommage négatif la première place à Rousseau dans son éducation de citoyen."
                            }
                        ]
                    }
