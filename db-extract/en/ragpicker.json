                                                "sense_id": "f2d5ba19-4bfc-3de1-8861-9ad37a470bda",
                                                "text": "„Einige Zeit darauf brachte der Lumpensammler sich eine Frauensperson mit, die er als seine Braut ausgab und die mit Kartoffelrodern aus Westpreußen gekommen war.“"
                                            },
                                            {
                                                "example_id": "8fa5a64b-996a-475a-9ec4-d8d94da564f5",
                                                "sense_id": "f2d5ba19-4bfc-3de1-8861-9ad37a470bda",
                                                "text": "„Überall in Europa lebten in der frühen Neuzeit die Lumpensammler.“"
                                            }
                                        ],
