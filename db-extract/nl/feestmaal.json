                    {
                        "sense_id": "03b00f56-7abf-3692-84c2-b359e930053a",
                        "entry_id": "48c9b297-7aee-3dc8-b7f2-abb6603c8b6e",
                        "glosses": [
                            "uitgebreide maaltijd ter gelegenheid van een feest"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2a2424a4-d03c-3381-b653-a78f590cff5f",
                        "entry_id": "48c9b297-7aee-3dc8-b7f2-abb6603c8b6e",
                        "glosses": [
                            "een uitgebreide maaltijd met een feestelijk karakter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6b918d2-b1c7-4ade-84c1-14403a296081",
                                "sense_id": "2a2424a4-d03c-3381-b653-a78f590cff5f",
                                "text": "Barbie en ik sloten ons uren op in de keuken om het feestmaal voor te bereiden. Hij concentreerde zich op het maken van taco’s en ik stortte me op een spinaziesalade, vol noten, geitenkaas en kip. Verder had ik ook artisjokken ingekocht en wat flessen witte wijn."
                            },
                            {
                                "example_id": "2a24a4a2-58eb-45c6-bf6d-c05873925c68",
                                "sense_id": "2a2424a4-d03c-3381-b653-a78f590cff5f",
                                "text": "In de Financial Times vergeleek columnist Gideon Rachman Trump en Poetin (en Xi) met maffiafamilies voor wie macht gelijk staat aan het zaaien van angst. We kennen de beelden uit The Godfather – op het éne moment word je onthaald op een feestmaal om even later met een kogel in het hoofd gedumpt te worden op een vuilnisbelt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a145fd94-a7c3-46f7-aefc-86464be479ba",
                        "source_entry_id": "48c9b297-7aee-3dc8-b7f2-abb6603c8b6e",
                        "target_lang_word": "banquete",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "banquete",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "972b12dd-0806-3d52-b284-a8627547f1f8",
                                        "entry_id": "1cff835b-fe95-358e-ad2a-3f10d3cecfc2",
                                        "glosses": [
                                            "Comida a que concurren muchas personas para celebrar algún acontecimiento."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e7a5b3a-f6dc-4bd7-8a20-8e1889f2df78",
                                                "sense_id": "972b12dd-0806-3d52-b284-a8627547f1f8",
                                                "text": "«El banquete que hizo el cardenal fue generoso en el gasto y prolijo en el tiempo, en que comenzamos a comer a la una y acabamos a las cuatro»."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c479da0c-a8ce-3cde-81a1-142e86b5407b",
                                        "entry_id": "1cff835b-fe95-358e-ad2a-3f10d3cecfc2",
                                        "glosses": [
                                            "Comida espléndida."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "951c33d1-8e7f-4cd6-8e53-606f24a9aea7",
                                                "sense_id": "c479da0c-a8ce-3cde-81a1-142e86b5407b",
                                                "text": "«Mostrábanle el rostro desabrido, decíanle palabras sentidas que le escociesen, despedían con algún buen término a los que venían a la conversación, y, finalmente, usaban los mejores medios y más discretos que podían para evitar semejantes banquetes y juegos, de manera que viniese a entender el disgusto y desabrimiento de los de su casa y que viese claramente cuán errado andaba»."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
