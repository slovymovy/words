                    {
                        "translation_id": "6a4de9e0-63f5-4596-885c-05cdc6b410f5",
                        "source_entry_id": "a49f3e99-8e72-3cd6-b98f-6755100d8e25",
                        "source_sense_description": "instance of unexpected benefit or good fortune",
                        "target_lang_word": "godsgeschenk",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "godsgeschenk",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "0f6b301d-328b-33bf-a495-6e7d2e438cd8",
                                        "entry_id": "0c36159d-4fc0-346d-b934-c4cd396cab61",
                                        "glosses": [
                                            "een gift van de goden en waar je dus heel blij mee bent"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20a89078-a3db-4eef-93cb-713c33f101f4",
                                                "sense_id": "0f6b301d-328b-33bf-a495-6e7d2e438cd8",
                                                "text": "Wikipedia is een godsgeschenk voor iedereen die kennis wil delen en wil vinden."
                                            },
                                            {
                                                "example_id": "c68ef0b1-bb6f-47ba-a200-e542ce6bc647",
                                                "sense_id": "0f6b301d-328b-33bf-a495-6e7d2e438cd8",
                                                "text": "De eerste speech van Erdogan voedt gelijk de twijfels. Erdogan, vlak daarvoor nog aan de dood ontsnapt, wijst tegenover een juichende massa direct prediker in ballingschap Fethullah Gülen aan als dader. Hij noemt de couppoging vervolgens een ‘godsgeschenk’ omdat het een grote schoonmaak in het leger mogelijk maakt."
                                            },
                                            {
                                                "example_id": "7298daee-b176-487f-b78c-8f20953a04c2",
                                                "sense_id": "0f6b301d-328b-33bf-a495-6e7d2e438cd8",
                                                "text": "Huisman maakte de geboorte van zijn achterkleinzoon begin mei wereldkundig op Twitter. Aan Shownieuws vertelde de 71-jarige televisiecoryfee eerder hoe bijzonder het is om overgrootvader te worden. \"Je hebt een kind en die heeft een kind en daar zit dan ook weer een kind in. Het is heel bijzonder, een godsgeschenk.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "87069760-b4f9-4dbc-be23-ba6e502d8db7",
                        "source_entry_id": "a49f3e99-8e72-3cd6-b98f-6755100d8e25",
                        "source_sense_description": "instance of unexpected benefit or good fortune",
                        "target_lang_word": "don du ciel",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
