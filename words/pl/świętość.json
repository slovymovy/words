    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "52039bbd-6169-3ed3-959f-6889f2e1f09e",
                    "sense_definition": "cecha tego, co jest święte; stan sakralności lub doskonałości moralnej",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sacredness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Szwedzi podczas potopu nie uszanowali <w>świętości</w> tego zabytkowego kościoła.",
                            "target_lang_translations": {
                                "en": "During the Deluge, the Swedes did not respect the <w>sanctity</w> of this historic church."
                            }
                        },
                        {
                            "text": "Wierni z wielkim szacunkiem mówili o <w>świętości</w> życia zmarłego kapłana.",
                            "target_lang_translations": {
                                "en": "The faithful spoke with great reverence about the <w>holiness</w> of the late priest's life."
                            }
                        }
                    ],
                    "synonyms": [
                        "sakralność"
                    ],
                    "antonyms": [
                        "profanacja"
                    ],
                    "common_phrases": [
                        "świętość miejsca",
                        "świętość życia",
                        "aureola świętości"
                    ],
                    "target_lang_definitions": {
                        "en": "the state or quality of being holy, sacred, or morally pure"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "holiness",
                                "target_lang_sense_clarification": "state of being holy or morally pure"
                            },
                            {
                                "target_lang_word": "sanctity",
                                "target_lang_sense_clarification": "sacredness or ultimate importance"
                            },
                            {
                                "target_lang_word": "sacredness",
                                "target_lang_sense_clarification": "the condition of being sacred"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "804eb168-55ab-3874-8eff-b8c540c2d63a",
                    "sense_definition": "przedmiot, idea lub wartość otaczana najwyższym kultem, szacunkiem i czcią",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sacredness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dla wielu ludzi rodzina i wiara zawsze pozostaną nienaruszalną <w>świętością</w>.",
                            "target_lang_translations": {
                                "en": "For many people, family and faith will always remain an inviolable <w>sacred value</w>."
                            }
                        },
                        {
                            "text": "W tym domu tradycja była prawdziwą <w>świętością</w>, której nikt nie śmiał podważać.",
                            "target_lang_translations": {
                                "en": "In this house, tradition was truly <w>sacrosanct</w>, something no one dared to question."
                            }
                        }
                    ],
                    "synonyms": [
                        "relikwia"
                    ],
                    "common_phrases": [
                        "naruszać świętości",
                        "być świętością"
                    ],
                    "target_lang_definitions": {
                        "en": "an object, idea, or value held in the highest reverence, respect, or veneration"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sacred cow",
                                "target_lang_sense_clarification": "an idea, custom, or institution held immune from question or criticism"
                            },
                            {
                                "target_lang_word": "sacred object",
                                "target_lang_sense_clarification": "a physically revered religious or venerable object"
                            },
                            {
                                "target_lang_word": "sacred value",
                                "target_lang_sense_clarification": "an inviolable or cherished principle"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}