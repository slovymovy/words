                                "target_senses": [
                                    {
                                        "sense_id": "40634148-6520-3a77-819d-7cafb6bea278",
                                        "entry_id": "d6c77037-1cb2-3535-9051-72fd423407e5",
                                        "glosses": [
                                            "Auteur du texte et compositeur de la musique de chansons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35711275-0392-4c6a-aad6-330d95c562eb",
                                                "sense_id": "40634148-6520-3a77-819d-7cafb6bea278",
                                                "text": "Puis, d'une voix très douce, il lui expliquait que le temps était venu de lui faire enregistrer une bande qu'on présenterait à la maison de disques. Il fallait trouver quelques bonnes chansons et il s'adresserait à des auteurs-compositeurs de ses relations."
                                            },
                                            {
                                                "example_id": "63edbe94-ea77-4577-92c1-498fc12e19b7",
                                                "sense_id": "40634148-6520-3a77-819d-7cafb6bea278",
                                                "text": "Parmi l’héritage musical laissé par son père, l’auteur-compositeur faisait partie de ses favoris."
                                            },
                                            {
                                                "example_id": "e53f14c0-6255-4303-b140-151d6015dae7",
                                                "sense_id": "40634148-6520-3a77-819d-7cafb6bea278",
                                                "text": "À l’affiche cette année, entre autres, le chanteur, guitariste et auteur-compositeur Gilberto Gil, le pétillant groupe de jazz-funk Earth Wind and Fire, la chanteuse Jane Birkin, l’organiste Rhoda Scott ou encore l’ensemble vocal de gospel Golden Gate Quartet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
