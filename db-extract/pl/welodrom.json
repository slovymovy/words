                "senses": [
                    {
                        "sense_id": "88ad8a2b-c5e6-3dbd-99da-966816fb873b",
                        "entry_id": "d16ca8e9-c202-3482-8927-c09c538bc9b9",
                        "glosses": [
                            "velodrome (an indoor arena, having an oval banked track for bicycle racing)"
                        ],
                        "tags": [
                            "inanimate",
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "3f123e57-ae42-4372-8e32-22ce8546d43a",
                                "sense_id": "88ad8a2b-c5e6-3dbd-99da-966816fb873b",
                                "text": "welodrom olimpijski",
                                "translation": "Olympic velodrome",
                                "english": "Olympic velodrome"
                            },
                            {
                                "example_id": "5ab80509-1ceb-45ba-a6fd-025b244414cf",
                                "sense_id": "88ad8a2b-c5e6-3dbd-99da-966816fb873b",
                                "text": "na welodromie",
                                "translation": "on/at a velodrome",
                                "english": "on/at a velodrome"
                            },
                            {
                                "example_id": "cd301e21-f010-442e-947d-5471ce89d306",
                                "sense_id": "88ad8a2b-c5e6-3dbd-99da-966816fb873b",
                                "text": "Mistrzostwa świata dla sprinterów rozegrane zostaną na welodromie w Kolonii w dniach 27—29 sierpnia.",
                                "translation": "The World Sprint Championships will be held at the velodrome in Cologne from 27 to 29 August.",
                                "english": "The World Sprint Championships will be held at the velodrome in Cologne from 27 to 29 August."
                            },
                            {
                                "example_id": "26c27931-3352-47fc-85bc-efbb3e31ecd8",
                                "sense_id": "88ad8a2b-c5e6-3dbd-99da-966816fb873b",
                                "text": "Nowo powstałe obiekty na igrzyska w 2012 r., w tym centrum pływackie, tor kolarski, kilka nowych hal sportowych, po zakończeniu olimpijskiej rywalizacji nie zmienią przeznaczenia, będą nadal wykorzystywane jako sportowe areny. Wioska olimpijska, w której będzie 3600 niezależnych mieszkań, po zakończeniu igrzysk stanie się tanim osiedlem dla mieszkańców Londynu. W ten sposób zmodernizowana zostanie zaniedbana i biedniejsza wschodnia część metropolii - East End. Powstanie kilka nowych linii kolejowych i metra wokół stacji Stratford, zaplanowano budowę nowych obiektów sportowych: basenu olimpijskiego, welodromu, stadionu hokejowego.",
                                "translation": "The newly constructed facilities for the 2012 Olympics, including a swimming centre, a cycling track, several new sports halls, will not change their purpose after the end of the Olympic competition, they will continue to be used as sports arenas. The Olympic Village, which will house 3,600 independent flats, will become a low-cost housing estate for Londoners after the end of the games. In this way, the neglected and poorer eastern part of the metropolis - the East End - will be modernised. Several new railway lines and the underground will be built around Stratford station, and new sports facilities are planned: an Olympic swimming pool, a velodrome, and a hockey stadium.",
                                "english": "The newly constructed facilities for the 2012 Olympics, including a swimming centre, a cycling track, several new sports halls, will not change their purpose after the end of the Olympic competition, they will continue to be used as sports arenas. The Olympic Village, which will house 3,600 independent flats, will become a low-cost housing estate for Londoners after the end of the games. In this way, the neglected and poorer eastern part of the metropolis - the East End - will be modernised. Several new railway lines and the underground will be built around Stratford station, and new sports facilities are planned: an Olympic swimming pool, a velodrome, and a hockey stadium."
                            },
                            {
                                "example_id": "e8a8f0ca-9897-4e84-a1bc-315e24790600",
                                "sense_id": "88ad8a2b-c5e6-3dbd-99da-966816fb873b",
                                "text": "Uroczystość uhonorowania najlepszych zawodników w poszczególnych konkurencjach odbędzie się dzisiaj na welodromie w Pruszkowie.",
                                "translation": "The ceremony to honor the best competitors in the individual disciplines will take place today at the velodrome in Pruszków.",
                                "english": "The ceremony to honor the best competitors in the individual disciplines will take place today at the velodrome in Pruszków."
                            }
                        ]
