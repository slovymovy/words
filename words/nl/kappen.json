                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "hakken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De houthakkers gaan morgen het hele bos <w>kappen</w>.",
