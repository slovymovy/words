                "senses": [
                    {
                        "sense_id": "c8f5dd07-2ac8-3dca-8eca-ae8d278b5688",
                        "entry_id": "575589df-5fec-3849-a718-d6e484cafbd4",
                        "glosses": [
                            "krautige Pflanze mit sternenförmig angeordneten, wollig-filzig, schmal lanzettlichen, etwa fünf Zentimeter langen weiß glänzenden Hüllblättern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a182e64-3ab1-445f-b9e2-63945e415fb7",
                                "sense_id": "c8f5dd07-2ac8-3dca-8eca-ae8d278b5688",
                                "text": "Das Edelweiß kommt vorwiegend auf steinigen Wiesen und Kalksteinfelsen vor, ist ungleichmäßig verteilt und bevorzugt felsige Kalksteinumgebung auf Höhenlagen zwischen 1.800 und 3.000 Metern."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5ccd52c9-de10-45ce-984f-b8ddad68eb6c",
                        "source_entry_id": "575589df-5fec-3849-a718-d6e484cafbd4",
                        "source_sense_id": "c8f5dd07-2ac8-3dca-8eca-ae8d278b5688",
                        "source_sense_description": "krautige Pflanze mit sternenförmig angeordneten, wollig-filzig, lanzettlichen glänzenden Hüllblättern",
                        "target_lang_word": "edelweiss",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "edelweiss",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c0cdd0b7-2446-32f5-974b-e208e2bc7726",
                                        "entry_id": "4e519a6d-3981-34a2-8c88-497e48f5b7b9",
                                        "glosses": [
                                            "A European perennial alpine plant (Leontopodium alpinum), with downy leaves and small white flower heads in a dense cluster."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bacf8cce-4277-40d7-95bc-53607047ba9d",
                                                "sense_id": "c0cdd0b7-2446-32f5-974b-e208e2bc7726",
                                                "text": "And that will mean farewell to the edelweiss, adieu the eider goose."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9fb12b2d-ffae-4dbc-a907-2272644dcffb",
                        "source_entry_id": "575589df-5fec-3849-a718-d6e484cafbd4",
                        "source_sense_id": "c8f5dd07-2ac8-3dca-8eca-ae8d278b5688",
                        "source_sense_description": "krautige Pflanze mit sternenförmig angeordneten, wollig-filzig, lanzettlichen glänzenden Hüllblättern",
                        "target_lang_word": "edelweiss",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
