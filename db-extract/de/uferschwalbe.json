                                                "example_id": "207c6d56-abf8-4b21-ae2f-83481931b070",
                                                "sense_id": "182c0984-05ad-3196-aa96-373503c9d65e",
                                                "text": "L’hirondelle de rivage niche et chasse généralement à proximité des rivages."
                                            },
                                            {
                                                "example_id": "096a7310-e3df-44e5-8821-f8578f89f7e7",
