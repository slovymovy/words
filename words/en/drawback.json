{
    "word_family": [
        "draw",
        "back"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8d984bc3-601c-3b8c-865c-ecd6b0e8064d",
                    "sense_definition": "A disadvantage; something that detracts or takes away.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "disadvantage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Poor fuel economy is a common <w>drawback</w> among larger vehicles.",
                            "target_lang_translations": {
                                "ru": "Плохая топливная экономичность — частый <w>недостаток</w> крупных автомобилей."
                            }
                        },
                        {
                            "text": "The main <w>drawback</w> of this apartment is that it is located far from the subway station.",
                            "target_lang_translations": {
                                "ru": "Главный <w>минус</w> этой квартиры в том, что она находится далеко от станции метро."
                            }
                        }
                    ],
                    "synonyms": [
                        "hindrance",
                        "nuisance"
                    ],
                    "antonyms": [
                        "benefit",
                        "advantage",
                        "boon"
                    ],
                    "common_phrases": [
                        "major drawback",
                        "main drawback",
                        "common drawback"
                    ],
                    "target_lang_definitions": {
                        "ru": "Недостаток, отрицательная сторона чего-либо, уменьшающая его ценность или привлекательность."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "недостаток",
                                "target_lang_sense_clarification": "изъян, отрицательное свойство"
                            },
                            {
                                "target_lang_word": "минус",
                                "target_lang_sense_clarification": "разговорное обозначение недостатка"
                            },
                            {
                                "target_lang_word": "изъян",
                                "target_lang_sense_clarification": "несовершенство, дефект"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3aacf3a7-ca56-3afc-ac6c-bf0a32482c52",
                    "sense_definition": "A partial refund of an import fee, as when goods are re-exported from the country that collected the fee.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "financial_refund",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company applied for a customs <w>drawback</w> after re-exporting the imported raw materials.",
                            "target_lang_translations": {
                                "ru": "Компания подала заявку на таможенный <w>возврат пошлины</w> после реэкспорта импортированного сырья."
                            }
                        },
                        {
                            "text": "East-India goods are to be liable to duties and <w>drawbacks</w> on the value, to be taken by the gross price.",
                            "target_lang_translations": {
                                "ru": "Ост-Индские товары подлежат обложению пошлинами и <w>возврату пошлин</w> в зависимости от стоимости, определяемой по валовой цене."
                            }
                        }
                    ],
                    "common_phrases": [
                        "customs drawback"
                    ],
                    "target_lang_definitions": {
                        "ru": "Возврат пошлин (частичный или полный возврат импортных пошлин при реэкспорте товаров)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возврат пошлины",
                                "target_lang_sense_clarification": "таможенная процедура возврата ранее уплаченных сборов"
                            },
                            {
                                "target_lang_word": "дробэк",
                                "target_lang_sense_clarification": "профессиональный таможенный термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6361b8d8-3f1a-30e3-9cf3-5075c8dcabde",
                    "sense_definition": "The inhalation of a lungful of smoke from a cigarette, viewed as a skill of the practised smoker.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "smoking_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He took a deep <w>drawback</w> and blew the smoke slowly into the cold night air.",
                            "target_lang_translations": {
                                "ru": "Он сделал глубокую <w>затяжку</w> и медленно выпустил дым в холодный ночной воздух."
                            }
                        },
                        {
                            "text": "I want to learn to do the <w>drawback</w> better than Swiftie.",
                            "target_lang_translations": {
                                "ru": "Я хочу научиться делать <w>затяжку</w> лучше, чем Свифти."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used in informal contexts regarding smoking"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Глубокая затяжка сигаретным дымом в легкие."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "затяжка",
                                "target_lang_sense_clarification": "вдыхание дыма при курении"
                            },
                            {
                                "target_lang_word": "затяг",
                                "target_lang_sense_clarification": "разговорное обозначение затяжки"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}