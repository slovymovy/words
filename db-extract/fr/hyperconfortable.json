                            {
                                "example_id": "76fcb77e-789b-4927-a1c0-ac6638e25431",
                                "sense_id": "2ee0bb83-0ab6-3fc0-a4f2-0e8bc7c2cdbf",
                                "text": "C’est hyperconfortable d’avoir un petit job sur le campus, se réjouit Florin."
                            },
                            {
                                "example_id": "ccad759b-d054-4deb-b5a0-f12c62c0088f",
                                "sense_id": "2ee0bb83-0ab6-3fc0-a4f2-0e8bc7c2cdbf",
                                "text": "Les baskets de l’infirmière sont hyperconfortables, et j’arrive à courir plutôt vite dans les couloirs malgré ma gaine, mon bustier trop serré et mes kilos de jupe."
                            },
                            {
                                "example_id": "aded6e9f-0873-4243-8b39-6745e22c1c91",
                                "sense_id": "2ee0bb83-0ab6-3fc0-a4f2-0e8bc7c2cdbf",
                                "text": "Ces trucs-là sont hyperconfortables quand on les essaye dans le magasin, mais on dirait que dès qu’ils sortent du showroom, quelqu’un enlève toute la mousse à haute densité dont le vendeur avait fait l’éloge pour la remplacer par de la caillasse et des gravillons."
                            }
                        ]
