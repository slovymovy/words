{
    "word_family": [
        "kommandieren",
        "Kommandant",
        "Kommandeur"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "55f2bcb3-606c-356b-9d0d-e1c72e825fa8",
                    "sense_definition": "Kurzer, meist mündlicher Befehl oder verbindliche Anweisung an Personen.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "befehl",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Schiedsrichter gab laut das <w>Kommando</w> zum Start des Rennens."
                        },
                        {
                            "text": "Auf sein <w>Kommando</w> hin blieben alle Schüler sofort ganz ruhig stehen."
                        }
                    ],
                    "synonyms": [
                        "Anweisung"
                    ],
                    "common_phrases": [
                        "das Kommando geben",
                        "auf Kommando"
                    ]
                },
                {
                    "sense_id": "214b0e08-57f9-3af0-9123-1f32eefa3375",
                    "sense_definition": "Recht und Befugnis, anderen Personen Befehle zu erteilen; leitende Führungsgewalt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der erfahrene Kapitän übernahm auf dem Schiff sofort das <w>Kommando</w>."
                        },
                        {
                            "text": "Die Soldaten standen während des Einsatzes unter dem <w>Kommando</w> eines Generals."
                        }
                    ],
                    "synonyms": [
                        "Befehlsgewalt"
                    ],
                    "common_phrases": [
                        "das Kommando übernehmen",
                        "unter dem Kommando"
                    ]
                },
                {
                    "sense_id": "5da96cd2-1801-3806-a22e-914cf6de8898",
                    "sense_definition": "Kleinere Gruppe von speziell ausgebildeten Einsatzkräften oder Soldaten für besondere Aufgaben.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ein speziell ausgebildetes <w>Kommando</w> befreite die Geiseln aus dem Gebäude."
                        },
                        {
                            "text": "Die Polizei schickte ein schwer bewaffnetes <w>Kommando</w> an den Einsatzort."
                        }
                    ],
                    "synonyms": [
                        "Einheit",
                        "Gruppe",
                        "Team"
                    ],
                    "common_phrases": [
                        "ein geheimes Kommando"
                    ]
                },
                {
                    "sense_id": "8b76bee5-5ac7-3335-a184-47d598609e4c",
                    "sense_definition": "Anweisung oder Befehl an ein Betriebssystem oder Computerprogramm zur Ausführung einer Funktion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "befehl",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Administrator musste das passende <w>Kommando</w> in das Terminal eingeben."
                        },
                        {
                            "text": "Mit diesem einfachen <w>Kommando</w> können Sie das gesamte System neu starten."
                        }
                    ],
                    "synonyms": [
                        "Anweisung"
                    ],
                    "common_phrases": [
                        "ein Kommando eingeben"
                    ]
                },
                {
                    "sense_id": "b6d0122e-f34c-30b9-9405-436cc792a10c",
                    "sense_definition": "Militärische Führungsbehörde oder Dienststelle, die nachgeordnete Truppenteile leitet.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das militärische <w>Kommando</w> plante die groß angelegte Übung über mehrere Monate."
                        },
                        {
                            "text": "Die Meldung über den Vorfall wurde umgehend an das zuständige <w>Kommando</w> weitergeleitet."
                        }
                    ]
                }
            ]
        }
    ]
}