                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "00323462-d34e-3f34-916c-a1f4b77c9bef",
                                        "entry_id": "12d62a49-26f2-36a3-aaa1-a89d0c7576c0",
                                        "glosses": [
                                            "sich so unsicher fühlend, dass man keine Entscheidung trifft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a14fe696-a925-4616-a097-62c0072cb8e3",
                                                "sense_id": "00323462-d34e-3f34-916c-a1f4b77c9bef",
                                                "text": "Noch zaudernd, was ich bestellen soll, blättere ich in der Speisekarte."
                                            },
                                            {
                                                "example_id": "9c626217-30c9-4963-a12e-b8709db98eb7",
                                                "sense_id": "00323462-d34e-3f34-916c-a1f4b77c9bef",
                                                "text": "„Zaudernd schaute ich zu ihr hinüber: sollte ich sie, das Mädchen meiner Träume, ansprechen? Oder würde ich mich lächerlich machen?“"
                                            },
                                            {
                                                "example_id": "19c2d6ba-5c1f-470f-ba7b-58dd5a09ffbc",
                                                "sense_id": "00323462-d34e-3f34-916c-a1f4b77c9bef",
                                                "text": "Der böse Kaspar heißt hier Gaspard, das neckische Ännchen Annette und Max, dieser zauderndste aller treudeutschen Opernhelden, singt nicht mit voller Stimme \"Durch die Wälder, durch die Auen\", sondern lyrisch schmiegsam \"Frais vallons, forêts, vastes plaines\"."
                                            },
                                            {
                                                "example_id": "3d79aa98-876b-4a7c-a398-5b9a593b6477",
                                                "sense_id": "00323462-d34e-3f34-916c-a1f4b77c9bef",
                                                "text": "Die Briten hätten dabei in der Tat die zauderndste Haltung eingenommen; auch sie seien aber für die Existenz dieses Beschlusses voll verantwortlich und müßten sich an der politischen Wirklichkeit dieses Beschlusses beteiligen."
                                            },
                                            {
                                                "example_id": "a81f7887-5f8c-4d95-881c-fbe6be64a846",
                                                "sense_id": "00323462-d34e-3f34-916c-a1f4b77c9bef",
                                                "text": "Während seiner Kanzlerschaft hieß es immer wieder, er [Willy Brandt] sei ein Hamlet, ewig zaudernd. Ein ganz anderes Bild bot der junge Mann, der früh davon überzeugt war, dass die Republik sich leidenschaftlich gegen die Nationalsozialisten wehren müsse."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
