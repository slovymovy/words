                        ],
                        "examples": [
                            {
                                "example_id": "3772c5c8-fcf6-417d-9b80-d73b71798d52",
                                "sense_id": "e3597885-0bf6-3e26-8efd-2e34e1e363d7",
                                "text": "[…] ; les jours où iels n’avaient pas l’occasion de parler un peu, juste tous les deux, iel se sentait vide.",
                                "translation": "the days when they [plural] didn't have the chance to talk a little, just the two of them, they [singular] felt empty.",
                                "english": "the days when they [plural] didn't have the chance to talk a little, just the two of them, they [singular] felt empty."
                            },
                            {
                                "example_id": "c32c19e4-1461-4a4c-9db9-26141f2aaaa3",
                                "sense_id": "e3597885-0bf6-3e26-8efd-2e34e1e363d7",
                                "text": "Arthaud, Poutou, Cheminade, Dupont-Aignan, Lassalle ? Aucune chance, iels sont considéré·e·s comme des “petits candidats”.",
                                "translation": "[Nathalie] Arthaud, [Philippe] Poutou, [Jacques] Cheminade, [Nicolas] Dupont-Aignan, [Jean] Lassalle? No way; they are seen as \"minor candidates\".",
                                "english": "[Nathalie] Arthaud, [Philippe] Poutou, [Jacques] Cheminade, [Nicolas] Dupont-Aignan, [Jean] Lassalle? No way; they are seen as \"minor candidates\"."
                            }
                        ]
