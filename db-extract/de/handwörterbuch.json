                        "form": "die Handwörterbücher"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "05158056-e4ae-312f-b4aa-58c59d7c3571",
                        "entry_id": "d384e6e6-9656-338a-93aa-87ce99e0a0c1",
                        "glosses": [
                            "Linguistik: Der Begriff wird auf recht unterschiedliche Werke angewendet: Die Spanne reicht von relativ kleinen, meist einbändigen und dadurch handlichen Wörterbüchern bis zu mehrbändigen Werken."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55331b6a-c4e3-448a-a3a0-3e92f74e1741",
                                "sense_id": "05158056-e4ae-312f-b4aa-58c59d7c3571",
                                "text": "Ein Handwörterbuch ist größer und umfangreicher als ein Taschenwörterbuch, kann aber den Umfang von mehrbändigen großen Wörterbüchern erreichen."
                            },
                            {
                                "example_id": "943e556c-d354-47f9-b40f-771c86831552",
                                "sense_id": "05158056-e4ae-312f-b4aa-58c59d7c3571",
                                "text": "Der Begriff Handwörterbuch wird auf einbändige Schulwörterbücher ebenso wie auf mehrbändige Spezialwörterbücher angewendet."
                            },
                            {
                                "example_id": "89247d9e-3a10-4368-834c-bde031b0e5af",
                                "sense_id": "05158056-e4ae-312f-b4aa-58c59d7c3571",
                                "text": "„Selbst in den Schulbüchern auf dem wurmstichigen Brett über der Kommode, in der halbzerfetzten Ploetzschen Grammatik für den Gebrauch der Unterprima und in dem dicken lateinischen Handwörterbuch von Georges offenbarte sich eine heimische Anziehungskraft, ein Bann, der gar nicht so leicht zu brechen war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
