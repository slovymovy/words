                        "form_id": "5876aeac-b558-45ee-9fcc-3c86bfc06a1b",
                        "entry_id": "e6713d04-dbac-368e-9e44-d8cf009f5af9",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
