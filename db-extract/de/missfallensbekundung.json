                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b57dd083-2c59-4276-884d-80b819196e79",
                                "sense_id": "05dd9404-297f-3e1e-847d-da7a9c9587e5",
                                "text": "„Der knurrt nur unverständliches Zeug, was offenkundig eine Missfallensbekundung darstellt.“"
                            },
                            {
                                "example_id": "e760b506-c16b-41ac-8277-42929c00fcb5",
                                "sense_id": "05dd9404-297f-3e1e-847d-da7a9c9587e5",
                                "text": "„Solches Zähneklappern ist bei uns eine Drohgebärde oder zumindest eine deutliche Missfallensbekundung.“"
                            },
                            {
                                "example_id": "964ff826-9c5a-4074-a19e-75e36f876a6c",
                                "sense_id": "05dd9404-297f-3e1e-847d-da7a9c9587e5",
                                "text": "„Laubach zog seine Augenbrauen in gespielter Missfallensbekundung in die Höhe und bemerkte, wie Stephanie ihm ein kleines, mitfühlendes Lächeln schenkte.“"
                            },
                            {
                                "example_id": "b3cdc965-5701-4595-a641-1fc71d8533cf",
                                "sense_id": "05dd9404-297f-3e1e-847d-da7a9c9587e5",
                                "text": "„In diesem Experiment zeigte sich, dass Hunde unabhängig davon, ob sie tatsächlich etwas falsch gemacht haben, auf eine Missfallensbekundung ihres Herrchens mit einem »schuldbewussten Gesichtsausdruck« reagieren.“"
                            }
                        ],
