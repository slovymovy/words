                "senses": [
                    {
                        "sense_id": "dfc8534d-a87f-393c-95bd-a732bac0db81",
                        "entry_id": "9fc90811-0c69-389a-a036-93821d8a6dbf",
                        "glosses": [
                            "(abgezogenes) Fell eines Panthers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89c3d4e5-f9f9-44e3-8b16-fa896c4a2237",
                                "sense_id": "dfc8534d-a87f-393c-95bd-a732bac0db81",
                                "text": "„Das Torsofragment des mit Standarten agierenden Königs stellt den frühesten Beleg für ein Pantherfell als Königsornat dar.“"
                            },
                            {
                                "example_id": "85118401-9ee9-451d-9330-fb2a404a8c55",
                                "sense_id": "dfc8534d-a87f-393c-95bd-a732bac0db81",
                                "text": "„Die Felle der kleineren Arten, welche mehr nördlich leben, sind wegen ihrer Wärme sehr gesucht; die größeren empfehlen sich meist durch ihre schöne Zeichnung; von den letzteren unterscheidet man gewöhnlich schlechthin Pantherfelle, mit geringelten Flecken, und Tigerfelle, mit Flecken ohne Ringen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
