    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8d2ef1bb-d7ca-3caf-beaa-a07f20b739f6",
                    "sense_definition": "Spanning the world; global.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The band achieved <w>worldwide</w> fame after their second album was released.",
                            "target_lang_translations": {
                                "ru": "Группа добилась <w>всемирной</w> славы после выхода их второго альбома.",
                                "zh": "该乐队在发行第二张专辑后获得了<w>全球性</w>的声誉。"
                            }
                        },
                        {
                            "text": "There is a <w>worldwide</w> shortage of computer chips affecting many industries.",
                            "target_lang_translations": {
                                "ru": "Существует <w>мировая</w> нехватка компьютерных чипов, затрагивающая многие отрасли.",
                                "zh": "目前存在一种影响许多行业的<w>全球性</w>芯片短缺问题。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "worldwide success",
                        "worldwide network",
                        "worldwide support",
                        "worldwide community"
                    ],
                    "target_lang_definitions": {
                        "ru": "Охватывающий весь мир; глобальный.",
                        "zh": "遍布全球的；全世界范围的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "всемирный",
                                "target_lang_sense_clarification": "охватывающий весь земной шар"
                            },
                            {
                                "target_lang_word": "мировой",
                                "target_lang_sense_clarification": "относящийся к миру в целом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "全球性的",
                                "target_lang_sense_clarification": "指涉及整个地球范围的"
                            },
                            {
                                "target_lang_word": "世界范围的",
                                "target_lang_sense_clarification": "指在世界范围内发生的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "9cccfb8a-1dc2-3194-8fd9-fa493ef59499",
                    "sense_definition": "Throughout the world.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "English is spoken <w>worldwide</w> by millions of people in many different countries.",
                            "target_lang_translations": {
                                "ru": "На английском говорят <w>по всему миру</w> миллионы людей во многих разных странах.",
                                "zh": "许多不同国家的数百万人都在<w>全世界</w>使用英语交流。"
                            }
                        },
                        {
                            "text": "The company ships its products <w>worldwide</w> to ensure everyone can buy them.",
                            "target_lang_translations": {
                                "ru": "Компания доставляет свои товары <w>по всему миру</w>, чтобы каждый мог их купить.",
                                "zh": "该公司将产品运往<w>全球</w>各地，以确保每个人都能买到。"
                            }
                        }
                    ],
                    "synonyms": [
                        "globally",
                        "internationally",
                        "around the world",
                        "all over the world",
                        "everywhere"
                    ],
                    "common_phrases": [
                        "known worldwide",
                        "available worldwide",
                        "travel worldwide",
                        "recognized worldwide"
                    ],
                    "target_lang_definitions": {
                        "ru": "По всему миру; повсюду.",
                        "zh": "在世界各地；全世界范围内。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "по всему миру",
                                "target_lang_sense_clarification": "во всех странах"
                            },
                            {
                                "target_lang_word": "во всём мире",
                                "target_lang_sense_clarification": "везде на планете"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "在全世界",
                                "target_lang_sense_clarification": "指在地球上的各个地方"
                            },
                            {
                                "target_lang_word": "全球",
                                "target_lang_sense_clarification": "指遍及全球"
                            }
                        ]
                    }
                }
            ]
        }
    ]
