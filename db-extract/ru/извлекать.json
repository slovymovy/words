                                "example_id": "86c304f0-395f-4b45-8b4e-acfa8c5e220c",
                                "sense_id": "fc6365ae-888d-36e4-9e6b-073e4f836a78",
                                "text": "извлека́ть что́-либо из чего́-либо",
                                "translation": "to derive something from something",
                                "english": "to derive something from something"
                            },
                            {
                                "example_id": "7c3e44f3-1780-4c58-994c-1a777a6ca66c",
