                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "охо́та",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b5863b7d-c84c-3242-9b4c-27e71cf59555",
                                        "entry_id": "540bbdd3-e494-3d0a-9498-46a39d9fa74c",
                                        "glosses": [
                                            "добывание дичи для получения пушнины, мяса, жира, кожи, пуха, пера, рогов и др., а также для поимки живых зверей с целью разведения и расселения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0386328-aa0c-444d-a23b-85cebe3f0022",
                                                "sense_id": "b5863b7d-c84c-3242-9b4c-27e71cf59555",
                                                "text": "Охота с ружьём и собакой прекрасна сама по себе, für sich, как говаривали в старину."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69bf9591-d475-3698-b0c4-ab628fc0325e",
                                        "entry_id": "540bbdd3-e494-3d0a-9498-46a39d9fa74c",
                                        "glosses": [
                                            "совокупность охотников и обученных животных, участвующих в охоте [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3952eec-117e-441a-936a-cb5f50910e1e",
                                                "sense_id": "69bf9591-d475-3698-b0c4-ab628fc0325e",
                                                "text": "Выехала охота в поле; увидели оленя и поскакали к нему. Стоит олень, голову поднял, на охоту оглядывается, будто ждёт чего-то."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "охо́та",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "db017482-b053-38af-88e7-2a7158ee4b19",
                                        "entry_id": "cd2425f8-0921-3831-9e5d-1d689267cf2e",
                                        "glosses": [
                                            "хотение, желание чего-либо; расположение, склонность к чему-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "390b7dc8-bf09-4fab-ba70-c5660c64094e",
                                                "sense_id": "db017482-b053-38af-88e7-2a7158ee4b19",
                                                "text": "Ибо все днесь мне её добро́ты // Мыслить умом есть много охоты."
                                            },
                                            {
                                                "example_id": "906a2ad6-5048-4e56-b07c-490d11a8e156",
                                                "sense_id": "db017482-b053-38af-88e7-2a7158ee4b19",
                                                "text": "Я как есть тоже имею сильную охоту до рыбной ловли и здесь только на побывке, как бы на рекреации от должности."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a729bfc-2c1c-328a-8dbe-f1f72a755b49",
                                        "entry_id": "cd2425f8-0921-3831-9e5d-1d689267cf2e",
                                        "glosses": [
                                            "биол. период течки; стремление к спариванию у самок некоторых животных"
                                        ],
                                        "tags": [],
                                        "examples": [
