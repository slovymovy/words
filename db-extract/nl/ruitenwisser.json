                                        "entry_id": "cee48755-438b-3837-953f-b85cc2f2e940",
                                        "glosses": [
                                            "a device used to clear rain and dirt from a windshield; normally a pivoting arm with a rubber blade."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b04988c1-de2c-4354-9d4c-740692a1d289",
                                                "sense_id": "d6731b45-2462-383d-ad2a-bcf0c57bbc4a",
                                                "text": "Using her hands like windshield wipers, she tried to flick snow away from her mouth. When she clawed at her chest and neck, the crumbs maddeningly slid back onto her face. She grew claustrophobic."
                                            }
                                        ]
                                    },
