                        "entry_id": "2e5a69e7-e997-31b4-b8e7-b63407f94618",
                        "glosses": [
                            "Groupe islamiste somalien."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25a90815-54dc-4520-a8ea-6382634f2132",
                                "sense_id": "c0f1212d-82f0-3916-9f09-cd45ce6c7fd5",
                                "text": "Un attentat au camion piégé revendiqué par les shebabs a fait au moins 65 morts hier et de nombreux blessés à Mogadiscio, la capitale de la Somalie."
                            },
                            {
                                "example_id": "90065aaf-a819-4507-b9d3-fe88ad9c5d7c",
                                "sense_id": "c0f1212d-82f0-3916-9f09-cd45ce6c7fd5",
                                "text": "Enfin, une quatrième base est en construction, à l’ouest, en Éthiopie, allié des États-Unis dans la lutte contre les shebabs, les islamistes qui contrôlent la partie méridionale de la Somalie."
                            },
                            {
                                "example_id": "803b1989-df3e-4efb-8abd-42ae3f2c68e1",
                                "sense_id": "c0f1212d-82f0-3916-9f09-cd45ce6c7fd5",
                                "text": "Mogadiscio est complètement libérée des shebab."
                            }
                        ]
                    }
