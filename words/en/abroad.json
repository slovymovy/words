                {
                    "sense_id": "f3848da6-7ead-3975-a2a6-e7b1a272189c",
                    "sense_definition": "Outside of one's home or a confined space; outdoors.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "outside",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was a cold night, and there were very few people <w>abroad</w> in the streets.",
                            "target_lang_translations": {
                                "ru": "Была холодная ночь, и <w>на улице</w> было совсем мало людей."
                            }
