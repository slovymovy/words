{
    "word_family": [
        "smiley",
        "smiler",
        "smilingly",
        "unsmiling"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c7532a3f-d807-3d86-908b-05d2d849593b",
                    "sense_definition": "To form one's features into a pleased, friendly, or amused expression, typically with the corners of the mouth turned up.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "facial_expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "When you <w>smile</w>, the whole world <w>smiles</w> with you.",
                            "target_lang_translations": {
                                "ru": "Когда ты <w>улыбаешься</w>, весь мир <w>улыбается</w> вместе с тобой."
                            }
                        },
                        {
                            "text": "She <w>smiled</w> at the camera for the family photo.",
                            "target_lang_translations": {
                                "ru": "Она <w>улыбнулась</w> в камеру для семейного фото."
                            }
                        }
                    ],
                    "antonyms": [
                        "frown"
                    ],
                    "common_phrases": [
                        "smile at someone",
                        "smile for the camera"
                    ],
                    "target_lang_definitions": {
                        "ru": "Принимать радостное, приветливое или веселое выражение лица, обычно с приподнятыми уголками губ."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "улыбаться",
                                "target_lang_sense_clarification": "процесс"
                            },
                            {
                                "target_lang_word": "улыбнуться",
                                "target_lang_sense_clarification": "однократное действие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "904353a4-52dc-3e77-97c5-d8b6628e3f42",
                    "sense_definition": "To express a specific feeling or message by using a facial expression with the mouth turned up.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "facial_expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The host <w>smiled</w> a warm welcome to all the arriving guests.",
                            "target_lang_translations": {
                                "ru": "Хозяин тепло <w>поприветствовал улыбкой</w> всех прибывающих гостей."
                            }
                        },
                        {
                            "text": "She <w>smiled</w> her agreement when I suggested going to the park.",
                            "target_lang_translations": {
                                "ru": "Она <w>выразила улыбкой</w> свое согласие, когда я предложил пойти в парк."
                            }
                        }
                    ],
                    "common_phrases": [
                        "smile a welcome",
                        "smile consent"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражать определенное чувство или сообщение с помощью улыбки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "улыбаться",
                                "target_lang_sense_clarification": "выражать чувство"
                            },
                            {
                                "target_lang_word": "выражать улыбкой",
                                "target_lang_sense_clarification": "передавать сообщение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "920fbdeb-1b64-3444-bd9f-b6feac22beb9",
                    "sense_definition": "To look bright, cheerful, or favorable, often said of the weather or environment.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "favorability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sun <w>smiled</w> down from a clear summer sky during our picnic.",
                            "target_lang_translations": {
                                "ru": "Солнце <w>улыбалось</w> с чистого летнего неба во время нашего пикника."
                            }
                        },
                        {
                            "text": "The landscape seemed to <w>smile</w> in the bright morning light.",
                            "target_lang_translations": {
                                "ru": "Пейзаж, казалось, <w>сиял</w> в ярком утреннем свете."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sun smiled down"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used metaphorically"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выглядеть ярким, жизнерадостным или благоприятным (о погоде или окружении)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "улыбаться",
                                "target_lang_sense_clarification": "метафорически о природе"
                            },
                            {
                                "target_lang_word": "сиять",
                                "target_lang_sense_clarification": "о погоде"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a5182add-711d-3192-89dd-82becf2bfb7a",
                    "sense_definition": "To be favorable or lucky toward someone or something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "favorability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fortune <w>smiled</w> on him, and he won the lottery unexpectedly.",
                            "target_lang_translations": {
                                "ru": "Фортуна <w>улыбнулась</w> ему, и он неожиданно выиграл в лотерею."
                            }
                        },
                        {
                            "text": "The gods <w>smiled</w> on his labours, bringing a bountiful harvest.",
                            "target_lang_translations": {
                                "ru": "Боги <w>благоволили</w> его трудам, принеся обильный урожай."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fortune smiled on",
                        "fate smiled on"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "metaphorical usage regarding luck"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть благосклонным или приносить удачу кому-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "улыбаться",
                                "target_lang_sense_clarification": "о судьбе или удаче"
                            },
                            {
                                "target_lang_word": "благоволить",
                                "target_lang_sense_clarification": "проявлять благосклонность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ea2c23f8-3d1b-3e96-b045-d406826c6944",
                    "sense_definition": "Of an ackee fruit: to open up fully when ripe, showing that it is safe to eat.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You must wait for the ackee to <w>smile</w> before you pick it.",
                            "target_lang_translations": {
                                "ru": "Нужно подождать, пока аки <w>раскроется</w>, прежде чем срывать его."
                            }
                        },
                        {
                            "text": "The fruit <w>smiles</w> by bursting open to expose the yellow meat.",
                            "target_lang_translations": {
                                "ru": "Плод <w>раскрывается</w>, лопаясь и обнажая желтую мякоть."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily used in Jamaica and the Caribbean"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "О плоде аки: полностью раскрываться при созревании."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раскрываться",
                                "target_lang_sense_clarification": "о плоде"
                            },
                            {
                                "target_lang_word": "лопаться",
                                "target_lang_sense_clarification": "при созревании"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5937657f-4948-3000-91ff-fcff1b77a942",
                    "sense_definition": "A facial expression characterized by the upward curving of the corners of the mouth.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "facial_expression_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She had a beautiful <w>smile</w> on her face when she saw the gift.",
                            "target_lang_translations": {
                                "ru": "На ее лице была прекрасная <w>улыбка</w>, когда она увидела подарок."
                            }
                        },
                        {
                            "text": "He always puts a <w>smile</w> on my face with his jokes.",
                            "target_lang_translations": {
                                "ru": "Он всегда вызывает у меня <w>улыбку</w> своими шутками."
                            }
                        }
                    ],
                    "antonyms": [
                        "frown",
                        "scowl"
                    ],
                    "common_phrases": [
                        "big smile",
                        "warm smile",
                        "put a smile on"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражение лица, характеризующееся изгибом уголков рта вверх."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "улыбка",
                                "target_lang_sense_clarification": "доброжелательная"
                            },
                            {
                                "target_lang_word": "усмешка",
                                "target_lang_sense_clarification": "ироничная или недоверчивая"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dc9562a7-681a-3dee-a75f-28376ce18e06",
                    "sense_definition": "A show of favor or approval.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "favor_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The project succeeded thanks to the <w>smile</w> of the gods.",
                            "target_lang_translations": {
                                "ru": "Проект удался благодаря <w>благосклонности</w> богов."
                            }
                        },
                        {
                            "text": "He lived his life seeking the <w>smile</w> of fortune.",
                            "target_lang_translations": {
                                "ru": "Он прожил жизнь в поисках <w>улыбки</w> фортуны."
                            }
                        }
                    ],
                    "synonyms": [
                        "smile"
                    ],
                    "common_phrases": [
                        "smile of fortune"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "literary or metaphorical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Проявление благосклонности или одобрения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "улыбка",
                                "target_lang_sense_clarification": "переносно, об удаче"
                            },
                            {
                                "target_lang_word": "благосклонность",
                                "target_lang_sense_clarification": "одобрение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7aa9100a-d1a8-3aab-afbd-cf6a8cadda6a",
                    "sense_definition": "A drink that is purchased by one person for another person.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He offered to buy me a <w>smile</w> at the local pub.",
                            "target_lang_translations": {
                                "ru": "Он предложил <w>угостить</w> меня в местном пабе."
                            }
                        },
                        {
                            "text": "The bartender served a <w>smile</w> paid for by the gentleman at the corner.",
                            "target_lang_translations": {
                                "ru": "Бармен подал <w>напиток</w>, оплаченный джентльменом в углу."
                            }
                        }
                    ],
                    "synonyms": [
                        "treat"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "archaic or regional slang for a drink"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Напиток, купленный одним человеком для другого (устаревший сленг)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "угощение",
                                "target_lang_sense_clarification": "напиток за чужой счет"
                            },
                            {
                                "target_lang_word": "выпивка",
                                "target_lang_sense_clarification": "в качестве подарка"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}