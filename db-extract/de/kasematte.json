                    {
                        "translation_id": "6a97860f-5d90-471d-a6f1-7141dc14b3e5",
                        "source_entry_id": "bcd49ac5-4403-38e5-98af-5b6e050b654b",
                        "source_sense_id": "7ea5ad91-fb2d-30c2-a064-7a5795baeeec",
