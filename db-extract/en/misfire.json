                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ade265a-afef-43e9-b2a9-de8a87f7f4ec",
                                                "sense_id": "1d966af7-b875-375d-b8ee-1649dbfc5c88",
                                                "text": "J’ai rien calé au cours d’aujourd’hui !"
                                            },
                                            {
                                                "example_id": "8cb42ecd-83b2-4934-b783-16aa056f6c1f",
                                                "sense_id": "1d966af7-b875-375d-b8ee-1649dbfc5c88",
                                                "text": "Pour les plus calés, nous pouvons conserver l’heure de 17 à 18 heures."
