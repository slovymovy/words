                "senses": [
                    {
                        "sense_id": "b32dc75b-c37a-3015-b6fd-ee86eee20811",
                        "entry_id": "c7f4f830-a846-3889-8695-ffa96863a74f",
                        "glosses": [
                            "Verbrennungsmotor mit zwei Arbeitsgängen, die während einer Umdrehung der Kurbelwelle durchlaufen werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dee808cc-dc1c-4ad3-927b-0640ca6a4763",
                                "sense_id": "b32dc75b-c37a-3015-b6fd-ee86eee20811",
                                "text": "„Beim klassischen Zweitaktmotor sind die vier Arbeitsgänge Ansaugen - Verdichten - Verdrängen - Ausschieben durch den doppelt wirkenden Kolben auf zwei Hübe, also eine Kurbelwellenumdrehung zusammengedrängt.“"
                            },
                            {
                                "example_id": "804ac50e-ba63-45a4-865a-759b8eb6c9e1",
                                "sense_id": "b32dc75b-c37a-3015-b6fd-ee86eee20811",
                                "text": "„Einer von ihnen diente als Garage; in ihm stand ein grauer DKW Kombi mit einem Zweitaktmotor, der einen fürchterlichen Krach machte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
