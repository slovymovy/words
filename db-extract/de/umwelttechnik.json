                "senses": [
                    {
                        "sense_id": "1de76125-3cab-302c-8404-87f3cd7c577d",
                        "entry_id": "a5ca0526-070a-3961-8571-ef718f40b6fd",
                        "glosses": [
                            "Gesamtheit der Bereiche der Technik und Technologie, die für Maßnahmen des Umweltschutzes von Bedeutung sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a6d5c4e-001d-4ddf-93b8-6aa5c25f7852",
                                "sense_id": "1de76125-3cab-302c-8404-87f3cd7c577d",
                                "text": "Die Umwelttechnik ist inzwischen ein bedeutender internationaler Geschäftszweig."
                            },
                            {
                                "example_id": "b39fcb36-286a-4e5c-8eca-451e97421785",
                                "sense_id": "1de76125-3cab-302c-8404-87f3cd7c577d",
                                "text": "Der vorbeugende Sinn der Umwelttechnik ist es, den Einfluss von Mensch und Technik auf die Umwelt zu minimieren."
                            },
                            {
                                "example_id": "7b8c1d37-2e55-41b5-89af-4949331681c7",
                                "sense_id": "1de76125-3cab-302c-8404-87f3cd7c577d",
                                "text": "Der Umwelttechnik obliegt es, Kontaminationen der Industriellen Revolution vergangener Jahrhunderte aufzuarbeiten/zu beseitigen."
                            },
                            {
                                "example_id": "480a8873-f705-4873-8299-019d9fc2f93d",
                                "sense_id": "1de76125-3cab-302c-8404-87f3cd7c577d",
                                "text": "Der Einsatz der verschiedenen Umwelttechniken führt letztlich zu einem Rückgang der Umweltbelastungen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
