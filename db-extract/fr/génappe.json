                        "glosses": [
                            "Fil de laine retors, lissé et grillé au gaz."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d90d9bec-7a07-4c78-ae89-0906cef1014e",
                                "sense_id": "1289bc13-fda6-3f1a-9f55-0a61c7e61d74",
                                "text": "Les génappes… sont des fils n’ayant reçu d’autre main-d’œuvre que le retordage, le lissage et le grillage au gaz, et constituant une matière première pour le tissage de certaines étoffes ou pour la fabrication de la passementerie."
                            },
                            {
                                "example_id": "0dde4cdf-f27a-4607-be59-f2d9908bae9c",
                                "sense_id": "1289bc13-fda6-3f1a-9f55-0a61c7e61d74",
                                "text": "Les Anglais expédient en France :… des fils de laine de mouton, lavés, grillés, teints ou non ; ces fils sont désignés sous le nom de fils de génappe, et, dans le tarif des douanes françaises, ils sont dénommés fils de laine lisse."
                            }
                        ]
                    }
