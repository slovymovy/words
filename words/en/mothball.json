{
    "word_family": [
        "moth"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d5fd26a0-f20c-3dbf-ab9c-f27f74381bd7",
                    "sense_definition": "A small ball of chemical pesticide used to protect clothing from damage by insects.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "household_item",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She placed a <w>mothball</w> in each pocket of the winter coat before storing it.",
                            "target_lang_translations": {
                                "cs": "Před uložením zimního kabátu vložila do každé kapsy <w>naftalín</w>."
                            }
                        },
                        {
                            "text": "The strong smell of the <w>mothball</w> filled the entire closet.",
                            "target_lang_translations": {
                                "cs": "Celou skříň naplnil silný zápach <w>naftalínu</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Malá kulička chemického pesticidu používaná k ochraně oblečení před poškozením hmyzem."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "naftalín",
                                "target_lang_sense_clarification": "prostředek proti molům šatním"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1b316599-9936-3ac2-a52a-899b8e4d682b",
                    "sense_definition": "To stop using something temporarily while keeping it in good condition for future use.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "storage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company decided to <w>mothball</w> the factory until the economy improves.",
                            "target_lang_translations": {
                                "cs": "Společnost se rozhodla továrnu <w>zakonzervovat</w>, dokud se ekonomika nezlepší."
                            }
                        },
                        {
                            "text": "They chose to <w>mothball</w> the project rather than cancel it completely.",
                            "target_lang_translations": {
                                "cs": "Rozhodli se projekt raději <w>uložit k ledu</w>, než ho úplně zrušit."
                            }
                        }
                    ],
                    "synonyms": [
                        "store",
                        "shelve",
                        "set aside"
                    ],
                    "antonyms": [
                        "demothball"
                    ],
                    "common_phrases": [
                        "mothball a project",
                        "mothball a facility"
                    ],
                    "target_lang_definitions": {
                        "cs": "Dočasně zastavit používání něčeho, přičemž se to udržuje v dobrém stavu pro budoucí využití."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "konzervovat",
                                "target_lang_sense_clarification": "udržovat v provozuschopném stavu pro budoucí potřebu"
                            },
                            {
                                "target_lang_word": "odložit",
                                "target_lang_sense_clarification": "pozastavit projekt nebo činnost"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8e72256d-4a36-33b9-bb2d-ed15b4307c01",
                    "sense_definition": "To put something away because it is no longer needed or used.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "storage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government decided to <w>mothball</w> the old naval base after the war ended.",
                            "target_lang_translations": {
                                "cs": "Vláda se po skončení války rozhodla starou námořní základnu <w>vyřadit z provozu</w>."
                            }
                        },
                        {
                            "text": "They <w>mothballed</w> the outdated software system once the new platform was launched.",
                            "target_lang_translations": {
                                "cs": "Jakmile byla spuštěna nová platforma, zastaralý softwarový systém <w>vyřadili z provozu</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "store",
                        "shelve",
                        "defer"
                    ],
                    "antonyms": [
                        "unmothball"
                    ],
                    "common_phrases": [
                        "mothball equipment"
                    ],
                    "target_lang_definitions": {
                        "cs": "Uložit něco stranou, protože to již není potřeba nebo se to nepoužívá."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "vyřadit z provozu",
                                "target_lang_sense_clarification": "ukončit aktivní využívání zařízení či systému"
                            },
                            {
                                "target_lang_word": "uložit k ledu",
                                "target_lang_sense_clarification": "přenést do stavu nečinnosti (idiomaticky)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}