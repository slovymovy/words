                        "glosses": [
                            "aantal mensen die bij een bepaalde gebeurtenis zijn gestorven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6aa6cfe-777d-48aa-ad19-21f44ba5c8a0",
                                "sense_id": "f9624edf-251c-3e2e-aea0-79995442a8e4",
                                "text": "Ook in de stad Sendai, waar een miljoen mensen wonen, is onbekend hoeveel doden er onder de inwoners zijn. Het officiële dodencijfer staat nog op ongeveer 900, maar op die lijst staan alleen de namen van geborgen of geïdentificeerde doden."
                            },
                            {
                                "example_id": "fd20042b-c2f3-4e29-9fed-f25f35c66b47",
                                "sense_id": "f9624edf-251c-3e2e-aea0-79995442a8e4",
                                "text": "Toen het net begon lag het dodencijfer op meer dan 90 procent. Nu zitten we op ruim 60 procent. Ongeveer de helft van de nieuwe patiënten overleeft het en kan daarna weer gewoon aan de slag."
                            }
                        ]
                    }
