                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bad81242-62a0-4e5d-8467-6b57226583da",
                                "sense_id": "e31719b4-9e64-3f67-b851-9b426e26b3e4",
                                "text": "„Sie zeigten keine Neigung, zu unserem heiligen Glauben überzutreten. Aus diesem Grunde gelangte ich zu dem Schluss, sie müssten belehrt werden, dass die Zeit für Götzenanbetung und Ketzereien vorüber sei.“"
                            },
                            {
                                "example_id": "07031e00-3aa8-47dd-bbde-c144f1376483",
                                "sense_id": "e31719b4-9e64-3f67-b851-9b426e26b3e4",
                                "text": "„Sie verboten unter anderem die Blasphemie, den Papismus, die öffentliche Entblößung der Knöchel, die Götzenanbetung, den Wucher, jeden Ungehorsam gegenüber dem Vater und alle geschäftlichen Aktivitäten am Sonntag.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
