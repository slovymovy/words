                "senses": [
                    {
                        "sense_id": "c5cdcf37-08f1-3f9f-b870-1d4c5983c222",
                        "entry_id": "01848ee4-79c3-3dee-aa4b-4a3a06416ae4",
                        "glosses": [
                            "związany z chmielem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19f4cc8d-0be0-46fc-a674-0e93e9866e76",
                                "sense_id": "c5cdcf37-08f1-3f9f-b870-1d4c5983c222",
                                "text": "Sprzeczamy się, która altana w naszym ogrodzie piękniejsza: różana czy chmielowa?"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "547dd971-5219-440b-97eb-66a15f557ea7",
                        "source_entry_id": "01848ee4-79c3-3dee-aa4b-4a3a06416ae4",
                        "source_sense_id": "c5cdcf37-08f1-3f9f-b870-1d4c5983c222",
                        "target_lang_word": "hop",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hop",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ed8db8bf-9050-3bd5-8432-a5d6335361a8",
                                        "entry_id": "320869c2-d16a-3131-8b38-18f4421a457d",
                                        "glosses": [
                                            "A short jump."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a66d000-7b11-440b-9ed3-da09b0de4bbf",
                                                "sense_id": "ed8db8bf-9050-3bd5-8432-a5d6335361a8",
                                                "text": "The frog crossed the brook in three or four hops."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9e4f468-37ab-363f-a084-6f3876b861ae",
                                        "entry_id": "320869c2-d16a-3131-8b38-18f4421a457d",
                                        "glosses": [
                                            "A jump on one leg."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c8e6c569-76db-3672-9872-a677d7e268ca",
                                        "entry_id": "320869c2-d16a-3131-8b38-18f4421a457d",
                                        "glosses": [
                                            "A short journey, especially in the case of air travel, one that takes place on a private plane."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8523c41-865f-421c-b1e5-e7f9b730ea9e",
                                                "sense_id": "c8e6c569-76db-3672-9872-a677d7e268ca",
                                                "text": "My fellow passengers are a mixture of people returning from a day out in the capital, locals doing short hops, and a few (like me) heading farther afield."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f16b8b2-5259-307a-be0a-e393e63dd15e",
                                        "entry_id": "320869c2-d16a-3131-8b38-18f4421a457d",
                                        "glosses": [
                                            "A brief period of development or progress."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3aebeaab-0f51-4fa1-8971-8025c2d0dac9",
                                                "sense_id": "5f16b8b2-5259-307a-be0a-e393e63dd15e",
                                                "text": "For popular radio stars in New York and Los Angeles, it was a short hop to network television."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c4c633a-cd5a-31e6-8fed-ede08fbcf17a",
                                        "entry_id": "320869c2-d16a-3131-8b38-18f4421a457d",
                                        "glosses": [
                                            "A bounce, especially from the ground, of a thrown or batted ball."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "af68574e-7991-32fb-a419-134c2650f5bc",
                                        "entry_id": "320869c2-d16a-3131-8b38-18f4421a457d",
                                        "glosses": [
                                            "A dance; a gathering for the purpose of dancing."
                                        ],
                                        "tags": [
                                            "UK",
                                            "US",
                                            "dated",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2157938-05f7-42d4-851e-1849f5471d6f",
                                                "sense_id": "af68574e-7991-32fb-a419-134c2650f5bc",
                                                "text": "1896, Benjamin Brierley, James Dronsfield, \"Ab-o'th'-Yate\" Sketches and Other Short Stories\nOne singing-room we had closed, and so damaged a \"twopenny hop\" that it could not have survived another season had our own prosperity continued unchecked."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2746348e-d3bb-397b-a9ec-a90386225b5a",
                                        "entry_id": "320869c2-d16a-3131-8b38-18f4421a457d",
                                        "glosses": [
                                            "The sending of a data packet from one host to an adjacent host as part of its overall journey."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "hop",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "07241aed-1d75-36a1-b550-ce8eb3c0e91f",
                                        "entry_id": "52e091e6-ff5e-3058-bc85-b5b50e0f1e53",
                                        "glosses": [
                                            "To jump a short distance."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bfde4f27-9be8-4283-99fd-020be5e38ccc",
                                                "sense_id": "07241aed-1d75-36a1-b550-ce8eb3c0e91f",
                                                "text": "When it had advanced from the wood, it hopped much after the fashion of a kangaroo, using its hind feet and tail to propel it, and when it stood erect, it sat upon its tail."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0f16098-c171-3eb2-b5f2-722231b88539",
                                        "entry_id": "52e091e6-ff5e-3058-bc85-b5b50e0f1e53",
                                        "glosses": [
                                            "To jump on one foot."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0f97562c-0339-355e-a714-893c01d523cd",
                                        "entry_id": "52e091e6-ff5e-3058-bc85-b5b50e0f1e53",
                                        "glosses": [
                                            "To be in state of energetic activity."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ae1f0e8-4a7a-43ff-a882-ef237a80aec6",
                                                "sense_id": "0f97562c-0339-355e-a714-893c01d523cd",
                                                "text": "Sorry, can't chat. Got to hop."
                                            },
                                            {
                                                "example_id": "189ce6ed-82df-4abb-83b7-2ed453922e96",
                                                "sense_id": "0f97562c-0339-355e-a714-893c01d523cd",
                                                "text": "The sudden rush of customers had everyone in the shop hopping."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6db11d33-fe87-3123-afa4-2094a35fcbed",
                                        "entry_id": "52e091e6-ff5e-3058-bc85-b5b50e0f1e53",
                                        "glosses": [
                                            "To suddenly take a mode of transportation that one does not drive oneself, often surreptitiously."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2601b5a-b5aa-4fbd-8bb6-752e45bccf46",
                                                "sense_id": "6db11d33-fe87-3123-afa4-2094a35fcbed",
                                                "text": "I hopped a plane over here as soon as I heard the news."
                                            },
                                            {
                                                "example_id": "89628301-ada0-48fa-9749-9e4a1b34a86f",
                                                "sense_id": "6db11d33-fe87-3123-afa4-2094a35fcbed",
                                                "text": "He was trying to hop a ride in an empty trailer headed north."
                                            },
                                            {
                                                "example_id": "56a6695e-285b-4080-bc83-8e64fbe7f00d",
                                                "sense_id": "6db11d33-fe87-3123-afa4-2094a35fcbed",
                                                "text": "He hopped a train to California."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f924c969-7106-3005-a787-dfa25a2369a9",
                                        "entry_id": "52e091e6-ff5e-3058-bc85-b5b50e0f1e53",
                                        "glosses": [
                                            "To jump onto, or over"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1973150a-e4da-40da-b963-937debfcbc6a",
                                                "sense_id": "f924c969-7106-3005-a787-dfa25a2369a9",
                                                "text": "They hop the curb and cut their engines."
                                            },
                                            {
                                                "example_id": "0a38339e-231f-4e00-aa0e-910635d58357",
                                                "sense_id": "f924c969-7106-3005-a787-dfa25a2369a9",
                                                "text": "As the 1857 to Manchester Piccadilly rolls in, I scan the windows and realise there are plenty of spare seats, so I hop aboard. The train is a '221'+'220' combo to allow for social distancing - a luxury on an XC train as normally you're playing sardines, so I make the most of it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d315e57-f2a9-3249-b3f0-6e88cd925c85",
                                        "entry_id": "52e091e6-ff5e-3058-bc85-b5b50e0f1e53",
                                        "glosses": [
                                            "To move frequently from one place or situation to another similar one."
                                        ],
                                        "tags": [
                                            "in-compounds",
                                            "intransitive",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e122547-a314-456b-b191-5c489ef1179e",
                                                "sense_id": "1d315e57-f2a9-3249-b3f0-6e88cd925c85",
                                                "text": "We were party-hopping all weekend."
                                            },
                                            {
                                                "example_id": "eb9650bc-535e-472d-a1e9-78dbd6187e4d",
                                                "sense_id": "1d315e57-f2a9-3249-b3f0-6e88cd925c85",
                                                "text": "bar-hopping"
                                            },
                                            {
                                                "example_id": "230e08ba-838a-4236-8fff-2d1174f932cd",
                                                "sense_id": "1d315e57-f2a9-3249-b3f0-6e88cd925c85",
                                                "text": "We had to island-hop on the weekly seaplane to get to his hideaway."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "492608e7-bd6e-3ebc-9bd1-1c49d02dee33",
                                        "entry_id": "52e091e6-ff5e-3058-bc85-b5b50e0f1e53",
                                        "glosses": [
                                            "To go in a quick or sudden manner."
                                        ],
                                        "tags": [
                                            "informal",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de323fa7-329c-46c1-8bbe-73b0df2160d3",
                                                "sense_id": "492608e7-bd6e-3ebc-9bd1-1c49d02dee33",
                                                "text": "We hopped on the freeway heading to LA and I looked over at the dashboard and saw the needle back on “E” and I told the guy, “Hey! You going to make it with the gas you got?\""
                                            },
                                            {
                                                "example_id": "3f6d49e9-3ade-499d-b3f2-ef09e3108730",
                                                "sense_id": "492608e7-bd6e-3ebc-9bd1-1c49d02dee33",
                                                "text": "Juliet shook her head as she hopped on the computer and greeted a customer who ambled in, blowing on her still wet nails."
                                            },
