                "senses": [
                    {
                        "sense_id": "c66f49a0-06e2-37e1-9076-e2b5a31f0dfe",
                        "entry_id": "7be5a451-f79a-35b6-a510-fc909af8890a",
                        "glosses": [
                            "Revendiquer."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "ab1fa63d-89ce-4e28-90be-12fafb59bd1b",
                                "sense_id": "c66f49a0-06e2-37e1-9076-e2b5a31f0dfe",
                                "text": "À mon petit sens, ce livret ne fait pas assez pour votre parti, parce qu’il ne vous vendique pas assez l’ouvrage contentieux."
                            },
                            {
                                "example_id": "f885a5eb-28c5-429b-a1a2-36c6884f69e7",
                                "sense_id": "c66f49a0-06e2-37e1-9076-e2b5a31f0dfe",
                                "text": "Cela ne plut pas au valet qui, les ayant pris sur le fait, vendiqua son bien de couchette, à sa moitié chanta goguette, l’appela tout net et tout franc."
                            },
                            {
                                "example_id": "bb89c2e4-d716-461c-9f56-5ba8eed8d789",
                                "sense_id": "c66f49a0-06e2-37e1-9076-e2b5a31f0dfe",
                                "text": "Un promoteur intervient pour le siège épiscopal, et vendique le cas"
                            }
                        ]
                    }
