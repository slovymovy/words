                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2166e0bf-5188-4c74-a4e6-0a72d541fe94",
                                "sense_id": "1bd3dc89-7d52-30b8-bc26-42dc593a587e",
                                "text": "Na tym właśnie polega tragizm sytuacji głównego bohatera, a ten aspekt interesował inscenizatorkę najbardziej – czy współcześnie możliwa jest tragedia."
                            },
                            {
                                "example_id": "41fcec3e-331b-4c7b-a217-f80239b8fbf7",
                                "sense_id": "1bd3dc89-7d52-30b8-bc26-42dc593a587e",
                                "text": "Drugoplanowi wykonawcy, puszczeni przez inscenizatorkę samopas, grają na zasadzie „ratuj się, kto może”."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
