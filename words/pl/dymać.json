                    "frequency": "Middle",
                    "semantic_group_id": "oszustwo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ten nieuczciwy sprzedawca <w>dyma</w> klientów na każdym kroku.",
                            "target_lang_translations": {
