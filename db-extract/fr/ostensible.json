                                                "sense_id": "603dfa9f-a3c8-3561-8c50-e3e9d486c881",
                                                "text": "Silvia mueve la cabeza de un modo muy ostensible en sentido afirmativo."
                                            },
                                            {
                                                "example_id": "3a7850f7-1cfe-47a5-8272-7534bc5b4181",
                                                "sense_id": "603dfa9f-a3c8-3561-8c50-e3e9d486c881",
                                                "text": "El crecimiento de la masa corporal libre de grasa y de la grasa, se observa una diferencia ostensible entre ambos sexos."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cd83f340-7f84-377d-9d8d-81489e7b7304",
                                        "entry_id": "dd8ae55d-3c5a-3bad-bab1-bb0f9613b0da",
