                "senses": [
                    {
                        "sense_id": "8ac8692d-04ab-3d07-b79e-16c72e54ce97",
                        "entry_id": "495bb981-cb8b-3dec-a251-f662828b02ee",
                        "glosses": [
                            "Étable à chèvres."
                        ],
                        "tags": [
                            "Élevage",
                            "Caséologie"
                        ],
                        "examples": [
                            {
                                "example_id": "66f5caa6-a94a-4fa2-b0e1-1c22fbc55d63",
                                "sense_id": "8ac8692d-04ab-3d07-b79e-16c72e54ce97",
                                "text": "— Une inséminatrice, chuchota-t-il. Elles sont une demi-douzaine. Elles règnent sur la chèvrerie et inoculent nos paillettes aux femelles en automne, durant les mois de fécondité."
                            },
                            {
                                "example_id": "2bfe8ddf-e84f-48c8-93b7-c21ab4eaac4b",
                                "sense_id": "8ac8692d-04ab-3d07-b79e-16c72e54ce97",
                                "text": "On distingue plusieurs modalités de traite selon qu’elle est réalisée avec des pots (ou des bidons) sur le sol de la chèvrerie (pots à terre) ou avec un lactoduc, sur une plateforme aménagée ou directement à terre."
                            },
                            {
                                "example_id": "bde52ca4-ee2a-4eff-a516-912c3ad3384e",
                                "sense_id": "8ac8692d-04ab-3d07-b79e-16c72e54ce97",
                                "text": "En plus des ventilateurs, il prévoit d’équiper la chèvrerie de brumisateurs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a6991f91-fe64-4768-b5f5-53c0f98e4c79",
                        "source_entry_id": "495bb981-cb8b-3dec-a251-f662828b02ee",
                        "source_sense_id": "8ac8692d-04ab-3d07-b79e-16c72e54ce97",
                        "target_lang_word": "Ziegenstall",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ziegenstall",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "969c3780-a6e1-3136-bfbe-691ddb95960e",
                                        "entry_id": "f8bd709e-dd12-3fc7-99d8-5b0003149d12",
                                        "glosses": [
                                            "Gebäude einer Farm, eines landwirtschaftlichen Betriebs, das zur Unterbringung von Ziegen dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33f2c697-8ae6-4398-abb7-ee2bd97e08a7",
                                                "sense_id": "969c3780-a6e1-3136-bfbe-691ddb95960e",
                                                "text": "„Tatsächlich, gegenüber vom Ziegenstall steht ein Gebäude, aus dem es nach Hopfen duftet.“"
                                            },
                                            {
                                                "example_id": "abe8ccea-7cdd-4376-8cf1-2efc596eb87e",
                                                "sense_id": "969c3780-a6e1-3136-bfbe-691ddb95960e",
                                                "text": "„Alle heiligen Zeiten passieren vom Regen durchnässte Wanderer das Grundstück. Ihnen bietet sie einen Platz im Ziegenstall und macht in der Mitte ein Feuer.“"
                                            },
                                            {
                                                "example_id": "3f53b8ad-10fb-42ea-8e87-ba145fe15c0e",
                                                "sense_id": "969c3780-a6e1-3136-bfbe-691ddb95960e",
                                                "text": "„Sie selbst hatte keine konkrete Person vor Augen, als sie sich des hinteren Raumes des Üblacker-Häusls, der früher einmal ein Ziegenstall war, annahm.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
