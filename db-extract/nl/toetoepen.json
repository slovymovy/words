                        "glosses": [
                            "ervoor zorgen dat zaken die mensen in problemen hadden kunnen brengen, niet bekend worden en geen gevolgen meer hebben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb0d5c0b-9d9f-4d48-8d97-11073a0b4f6c",
                                "sense_id": "ad1c7554-bfb1-3555-99a7-fd241ea4fbb3",
                                "text": "Generaal Spoor, voormalig bevelhebber van de strijdkrachten in Nederlands-Indië, en de diplomaat Van Roijen, medeverantwoordelijk voor de bepalingen van de soevereiniteitsoverdracht aan Indonesië in 1949, zouden verbijsterd zijn. De eerste omdat in dit geval zijn poging om de zaak te toetoepen (Indische term voor toedekken) is mislukt, de tweede omdat een met veel pijn en moeite opgestelde amnestieregeling is getrotseerd."
                            }
                        ]
                    }
