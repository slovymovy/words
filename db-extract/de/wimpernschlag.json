                            {
                                "example_id": "6cb592c5-28ae-427f-a9f0-5e67bfa58036",
                                "sense_id": "492c7d0c-c031-35d3-a6a0-fbb5b1e25d9e",
                                "text": "„Kurze Zeit später schien der Truck kaum merklich einen Wimpernschlag lang zu wackeln.“"
                            },
                            {
                                "example_id": "0aed927b-7a37-4664-bd00-13e0130a77e1",
                                "sense_id": "492c7d0c-c031-35d3-a6a0-fbb5b1e25d9e",
                                "text": "„Nur einen gefühlten Wimpernschlag lang hatten sich ihre Blicke getroffen, als sie nach dem ersten Erschrecken seinen Blick erwidert hatte.“"
                            }
                        ],
