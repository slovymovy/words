                    {
                        "translation_id": "fd43e615-26ef-4a56-9ec2-e03db11e9c04",
                        "source_entry_id": "515c94ee-b8c2-33e4-b6a1-078a6cd4c656",
                        "source_sense_description": "held back, limited, kept in check or under control",
                        "target_lang_word": "beherrscht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
