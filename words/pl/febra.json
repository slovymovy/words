    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3af58a75-c1ee-3f28-ae2d-602737bacd07",
                    "sense_definition": "potoczne określenie opryszczki wargowej",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Po przeziębieniu na dolnej wardze wyskoczyła mi bolesna <w>febra</w>.",
                            "target_lang_translations": {
                                "ru": "После простуды у меня на нижней губе вскочила болезненная <w>лихорадка</w>."
                            }
                        },
                        {
                            "text": "Stosuję specjalną maść, żeby ta <w>febra</w> jak najszybciej zniknęła.",
                            "target_lang_translations": {
                                "ru": "Я использую специальную мазь, чтобы этот <w>герпес</w> поскорее прошел."
                            }
                        }
                    ],
                    "synonyms": [
                        "opryszczka"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "potoczne określenie opryszczki"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "разговорное обозначение герпеса на губах (простуды)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "простуда на губах",
                                "target_lang_sense_clarification": "герпес"
                            },
                            {
                                "target_lang_word": "герпес",
                                "target_lang_sense_clarification": "высыпание на губах"
                            },
                            {
                                "target_lang_word": "лихорадка на губах",
                                "target_lang_sense_clarification": "пузырьковые высыпания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "454edc25-3eea-3a7a-b4d5-cf3f70b78092",
                    "sense_definition": "silna gorączka połączona z dreszczami",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chorego nagle chwyciła <w>febra</w> i zaczął cały dygotać z zimna.",
                            "target_lang_translations": {
                                "ru": "Больного внезапно забила <w>лихорадка</w>, и он весь задрожал от холода."
                            }
                        },
                        {
                            "text": "Wysoka <w>febra</w> nie ustępowała przez całą noc pomimo podanych leków.",
                            "target_lang_translations": {
                                "ru": "Сильный <w>жар</w> не спадал всю ночь, несмотря на принятые лекарства."
                            }
                        }
                    ],
                    "common_phrases": [
                        "chwyciła febra"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "dawne określenie gorączki z dreszczami"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "сильный жар, сопровождающийся ознобом; лихорадочное состояние"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лихорадка",
                                "target_lang_sense_clarification": "жар с ознобом"
                            },
                            {
                                "target_lang_word": "озноб",
                                "target_lang_sense_clarification": "дрожь от сильного жара"
                            },
                            {
                                "target_lang_word": "трясучка",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e0ad00ac-2f66-37b2-af07-761fe3499d67",
                    "sense_definition": "dawna nazwa malarii, tropikalnej choroby pasożytniczej wywołującej napady gorączki",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W dziewiętnastym wieku wielu podróżników w Afryce umierało na <w>febrę</w>.",
                            "target_lang_translations": {
                                "ru": "В девятнадцатом веке многие путешественники в Африке умирали от <w>малярии</w>."
                            }
                        },
                        {
                            "text": "W dawnych pamiętnikach często wspominano o zarażeniu groźną <w>febrą</w>.",
                            "target_lang_translations": {
                                "ru": "В старинных мемуарах часто упоминалось заражение опасной <w>болотной лихорадкой</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "malaria",
                        "zimnica"
                    ],
                    "common_phrases": [
                        "żółta febra"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "dawne określenie malarii"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "устаревшее название малярии (болотной лихорадки)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "малярия",
                                "target_lang_sense_clarification": "заболевание"
                            },
                            {
                                "target_lang_word": "болотная лихорадка",
                                "target_lang_sense_clarification": "устаревшее название малярии"
                            },
                            {
                                "target_lang_word": "лихорадка",
                                "target_lang_sense_clarification": "устаревшее о малярии"
                            }
                        ]
                    }
                }
            ]
        }
    ]
