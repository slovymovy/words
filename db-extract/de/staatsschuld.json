                        ],
                        "examples": [
                            {
                                "example_id": "243ffbca-6e4e-4f13-8b71-4ea5b34fc3ea",
                                "sense_id": "c4b065f0-455f-3f39-a906-63e6c32fca08",
                                "text": "„Den Staatsschulden in Deutschland stehen beträchtliche Staatsvermögen gegenüber.“"
