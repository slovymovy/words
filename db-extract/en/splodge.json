                    {
                        "translation_id": "72e53e4b-a22c-43d1-8a48-f4148b3153f1",
                        "source_entry_id": "d63fd921-3bc9-3ddb-b391-7314558ecc8f",
                        "source_sense_id": "ffbe1a99-fec7-3912-a1ec-f9114a9ea27d",
                        "source_sense_description": "splash, smear",
