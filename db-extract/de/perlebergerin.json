                "senses": [
                    {
                        "sense_id": "ede5350b-131b-30be-9c4c-e3b0fa893326",
                        "entry_id": "fbd59ad9-e4a3-3a94-a2e3-b1a38669610d",
                        "glosses": [
                            "ein weiblicher Einwohner, Bewohner der Stadt Perleberg, eine weibliche in Perleberg geborene Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6b47684-99bc-4570-a6c0-f7c2303bafd5",
                                "sense_id": "ede5350b-131b-30be-9c4c-e3b0fa893326",
                                "text": "Sie ist eine ein gebürtige Perlebergerin."
                            },
                            {
                                "example_id": "7640d7c2-a373-4b95-97a4-e3740bd8e958",
                                "sense_id": "ede5350b-131b-30be-9c4c-e3b0fa893326",
                                "text": "„Katrin Nörren erwartet ihr erstes Kind. Die Perlebergerin lag gestern im Kreißsaal des Perleberger Krankenhauses, betreut von ihrer Hebamme Ursula Geisler.“"
                            },
                            {
                                "example_id": "2537979a-a908-4462-90e2-50633f6c7dbc",
                                "sense_id": "ede5350b-131b-30be-9c4c-e3b0fa893326",
                                "text": "„Die ersten Anmeldungen sind bereits da, \"die ersten 50 Euro auch\", fügt die junge Perlebergerin an.“"
                            },
                            {
                                "example_id": "e134a150-0938-4dbf-9f80-60a865cb0881",
                                "sense_id": "ede5350b-131b-30be-9c4c-e3b0fa893326",
                                "text": "„Die Tochter des Konzertmeisters aus Perleberg, ein schlankes, gut proportioniertes Mädchen mit Rehaugen. Roberts Mutter hatte einmal erklärt, das sei die einzige Perlebergerin, die sie als Schwiegertochter anerkennen würde.“"
                            },
                            {
                                "example_id": "fd543a21-3a0b-48c1-9037-b5f152d9a507",
                                "sense_id": "ede5350b-131b-30be-9c4c-e3b0fa893326",
                                "text": "„Die schönen Perlebergerinnen bedeckten ihre etwas unromantischen Promenaden, denn es war Sonntag.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
