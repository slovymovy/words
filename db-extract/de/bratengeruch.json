                "senses": [
                    {
                        "sense_id": "b6a45ccd-0cd3-399d-b6ce-9c5692449c55",
                        "entry_id": "2a7abc97-0f44-31fc-8a6e-c4ed196cd6aa",
                        "glosses": [
                            "prägnanter, wahrnehmbarer Geruch nach einem gebackenen Stück Fleisch an sich selbst, in der Umgebung oder direkt am Braten; durch das Geruchsorgan wahrgenommene Ausdünstung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76c06f78-edb4-4463-bed0-fa3ee678d1f8",
                                "sense_id": "b6a45ccd-0cd3-399d-b6ce-9c5692449c55",
                                "text": "Den markanten Brantengeruch von einer Gans, einem Hähnchen oder einem gefüllten Rollbraten, kann der Geruchssinn sehr wohl unterscheiden und sofort einem Geruchsbild zuordnen."
                            },
                            {
                                "example_id": "eba0d1bb-8fbe-4a4c-a94f-fd9c3e620444",
                                "sense_id": "b6a45ccd-0cd3-399d-b6ce-9c5692449c55",
                                "text": "„Die Weihnachtsgans steht auf dem Tisch, der Bratengeruch riecht im gesamten Haus ganz frisch.“"
                            },
                            {
                                "example_id": "de805eb3-c388-4126-a1e6-16714d4415a8",
                                "sense_id": "b6a45ccd-0cd3-399d-b6ce-9c5692449c55",
                                "text": "„Wie die Studie zeigt, sind 36 Prozent der Bewohner vom Bratengeruch aus der Wohnung des Nachbarn genervt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
