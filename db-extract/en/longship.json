                        "target_lang_word": "drakkar",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "drakkar",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cc153c51-de27-3f8c-812b-df5df174be03",
                                        "entry_id": "87c45530-72c1-322e-9171-7c13c36ec900",
                                        "glosses": [
                                            "Bateau léger à voiles et à rames, à l'étrave très relevée, utilisé par les Vikings du haut Moyen Âge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76a7f7dc-e8ff-4dca-8ff3-a9a5e7f6837e",
                                                "sense_id": "cc153c51-de27-3f8c-812b-df5df174be03",
                                                "text": "Toutes ces données expliquent la remarquable tenue à la mer et la rapidité du drakkar, la légèreté et la maniabilité, le faible tirant d’eau permettant des manœuvres faciles, même sur les hauts fonds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "abaa10e8-8c83-3623-8823-4520977a75af",
                                        "entry_id": "87c45530-72c1-322e-9171-7c13c36ec900",
                                        "glosses": [
                                            "Meuble représentant le bateau du même nom dans les armoiries. Il est généralement représenté de profil, équipé de boucliers, arborant une tête de dragon ou une spirale en proue et muni d’une voile rectangulaire. À rapprocher de bateau, flobard, gabarot, galère, navire, nef et vaisseau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b5ca07c-7071-4933-a395-d6eeeb184b44",
                                                "sense_id": "abaa10e8-8c83-3623-8823-4520977a75af",
                                                "text": "D’or au drakkar de gueules, à la voile d’argent chargée d’une tête de cheval de sable, voguant sur une rivière d’azur, qui est de la commune de Dannevoux de la Meuse → voir illustration « armoiries avec un drakkar »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4f8941c5-d93f-4a43-bc3f-3b4cb19c9df0",
                        "source_entry_id": "5c4f53cd-01f8-3c5f-97da-09f93d590fc1",
                        "source_sense_id": "c2f31c4e-85b3-3b4c-b003-37a148f13527",
                        "source_sense_description": "type of Viking vessel",
                        "target_lang_word": "Langschiff",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Langschiff",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ea7bb619-1f7e-3b77-a015-fc3fafc3e185",
                                        "entry_id": "324d1a7f-6eec-3461-94b4-31c9a4d73ad4",
                                        "glosses": [
                                            "langes, schlankes, offenes Boot"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8005d0b-274e-4ffa-8d37-cef2f43f4897",
                                                "sense_id": "ea7bb619-1f7e-3b77-a015-fc3fafc3e185",
                                                "text": "Auch die Wikinger fuhren mit Langschiffen zur See."
                                            },
                                            {
                                                "example_id": "22e4fb9c-051c-43a4-bcca-cef80c2ab99f",
                                                "sense_id": "ea7bb619-1f7e-3b77-a015-fc3fafc3e185",
                                                "text": "„Doch so schnell die Langschiffe auch sind - für wochenlange Fahrten auf hoher See eignen sie sich nicht, ebenso wenig für den Transport schwerer und sperriger Lasten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dc82021a-8710-3a88-b03e-e010919effc0",
                                        "entry_id": "324d1a7f-6eec-3461-94b4-31c9a4d73ad4",
                                        "glosses": [
                                            "Kirchenschiff in der Längsachse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26fa355a-04cf-4ff4-a7d3-b8cab018394c",
                                                "sense_id": "dc82021a-8710-3a88-b03e-e010919effc0",
                                                "text": "Im Langschiff einer Kirche übersieht man am besten ihre Dimensionen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
