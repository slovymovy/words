        "pl-extract.jsonl": [
            {
                "entry_id": "cb327c8c-49b4-37c4-9102-6185b6848794",
                "word": "zuchwałość",
                "pos": "noun",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "276f6d32-4e62-3d3a-bf51-e247293c40e8",
                        "entry_id": "cb327c8c-49b4-37c4-9102-6185b6848794",
                        "glosses": [
                            "zbytnia pewność siebie, zbytnia odwaga"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6168e972-8a6a-405b-a269-5d1aca6ca367",
                                "sense_id": "276f6d32-4e62-3d3a-bf51-e247293c40e8",
                                "text": "Mimo mobilizacji środków przez najpotężniejsze marynarki świata piraci biją rekordy zuchwałości."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eaba41c9-7dd5-4dd0-83ec-5e5ea657cac2",
                        "source_entry_id": "cb327c8c-49b4-37c4-9102-6185b6848794",
                        "source_sense_id": "276f6d32-4e62-3d3a-bf51-e247293c40e8",
                        "target_lang_word": "audacity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "audacity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1e25b3d1-6209-3402-9568-bd21dd029658",
                                        "entry_id": "0911a438-b25c-3dd5-bc39-f5a5d81dbc55",
                                        "glosses": [
                                            "Insolent boldness, especially when imprudent or unconventional."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a23c6a9-68b7-414f-883a-7d4abe135475",
                                                "sense_id": "1e25b3d1-6209-3402-9568-bd21dd029658",
                                                "text": "The brash private had the audacity to criticize the general."
                                            },
                                            {
                                                "example_id": "eea964cd-dda4-4edc-b7ce-354016c22011",
                                                "sense_id": "1e25b3d1-6209-3402-9568-bd21dd029658",
                                                "text": "Somebody never pays his loans, yet he has the audacity to ask the bank for money."
                                            },
                                            {
                                                "example_id": "ae9751cc-9d03-4f39-8dce-1c948e3f52e3",
                                                "sense_id": "1e25b3d1-6209-3402-9568-bd21dd029658",
                                                "text": "“Oh?” she said. “So you have decided to revise my guest list for me? You have the nerve, the – the –” I saw she needed helping out. “Audacity,” I said, throwing her the line. “The audacity to dictate to me who I shall have in my house.” It should have been “whom”, but I let it go. “You have the –” “Crust.” “– the immortal rind,” she amended, and I had to admit it was stronger, “to tell me whom” – she got it right that time – “I may entertain at Brinkley Court and who” – wrong again – “I may not.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00ddd532-8fd6-3fab-aaf0-77ba602d1943",
                                        "entry_id": "0911a438-b25c-3dd5-bc39-f5a5d81dbc55",
                                        "glosses": [
                                            "Fearlessness, intrepidity or daring, especially with confident disregard for personal safety, conventional thought, or other restrictions."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "beaefa76-d7e1-45f1-8781-4438dd76deb2",
                        "source_entry_id": "cb327c8c-49b4-37c4-9102-6185b6848794",
                        "source_sense_id": "276f6d32-4e62-3d3a-bf51-e247293c40e8",
                        "target_lang_word": "audace",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "audace",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "91547cbe-9923-3262-95d3-f1f4b0eb3c29",
                                        "entry_id": "8a8bf340-26b0-311a-95f3-576510d80e1d",
                                        "glosses": [
                                            "Hardiesse, parfois excessive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1383aac2-27a4-4e1a-80d6-c56ef5e3e373",
                                                "sense_id": "91547cbe-9923-3262-95d3-f1f4b0eb3c29",
                                                "text": "Foncez, cette journée est propice à toutes les audaces."
                                            },
                                            {
                                                "example_id": "425e5bcd-3fe5-413c-998e-1b4acb19286a",
                                                "sense_id": "91547cbe-9923-3262-95d3-f1f4b0eb3c29",
                                                "text": "Mais ces belles futaies représentent une valeur commerciale qui a mis en appétit la convoitise du spéculateur, déjà riche de capital, plus riche encore en audace et en influence."
                                            },
                                            {
                                                "example_id": "a6035ce2-e1f8-4cf1-82a2-6e0e28b61164",
                                                "sense_id": "91547cbe-9923-3262-95d3-f1f4b0eb3c29",
                                                "text": "Le président du groupe Renaissance, Sylvain Maillard, s’est quant à lui satisfait du discours de Gabriel Attal en citant Danton : « De l’audace, encore de l’audace, toujours de l’audace, et la France est sauvée. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55a552da-0700-322c-83b4-8aeabf23fa68",
                                        "entry_id": "8a8bf340-26b0-311a-95f3-576510d80e1d",
                                        "glosses": [
                                            "Ganse utilisée au XVIIᵉ siècle pour relever les bords des chapeaux d’hommes et donner à ces dernier un air audacieux."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
