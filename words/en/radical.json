        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e162979d-650a-3433-bd4b-c0ba2e0844ff",
                    "sense_definition": "A person who holds extreme views or advocates for fundamental social and political change.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government feared that the <w>radical</w> would incite a violent uprising.",
                            "target_lang_translations": {
                                "ru": "Правительство опасалось, что этот <w>радикал</w> спровоцирует насильственное восстание.",
                                "zh": "政府担心那个<w>激进分子</w>会煽动暴力起义。"
                            }
                        },
                        {
                            "text": "As a young <w>radical</w>, he spent most of his time protesting against the war.",
                            "target_lang_translations": {
                                "ru": "Будучи молодым <w>радикалом</w>, он проводил большую часть времени, протестуя против войны.",
                                "zh": "作为一个年轻的<w>激进分子</w>，他大部分时间都在抗议战争。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "political radical"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, придерживающийся крайних взглядов или выступающий за коренные социальные и политические изменения.",
                        "zh": "持有极端观点或主张进行根本性社会和政治变革的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "радикал",
                                "target_lang_sense_clarification": "сторонник крайних мер"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "激进分子",
                                "target_lang_sense_clarification": "指主张极端变革的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2df0bafe-9f6a-3895-9488-fdea562f2a03",
                    "sense_definition": "The component of a Chinese character used for indexing in a dictionary and often indicating the general meaning.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you know the <w>radical</w> for water, you can often guess the meaning of the character.",
                            "target_lang_translations": {
                                "ru": "Если вы знаете <w>ключ</w> «вода», вы часто можете угадать значение иероглифа.",
                                "zh": "如果你认识“水”的<w>部首</w>，通常就能猜出这个汉字的意思。"
                            }
                        },
                        {
                            "text": "The student looked up the character in the dictionary by identifying its primary <w>radical</w>.",
                            "target_lang_translations": {
                                "ru": "Студент нашел иероглиф в словаре, определив его основной <w>радикал</w>.",
                                "zh": "学生通过识别汉字的主要<w>部首</w>在字典里查到了它。"
                            }
                        }
