                                        "sense_id": "41e342ed-109e-33d6-a533-08de7759d6a3",
                                        "entry_id": "1759484f-16cb-30d6-a365-8fdafbdfb2cf",
                                        "glosses": [
                                            "iemand die goederen naar een ander stuurt"
                                        ],
