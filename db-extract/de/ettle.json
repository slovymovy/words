                ],
                "senses": [
                    {
                        "sense_id": "fd8ec58b-492e-3830-bee8-7f3777eedd36",
                        "entry_id": "376d24d7-0439-33a9-8d9c-67f715781f31",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a0d5a0d-3c57-4900-9307-bd67bd84fd24",
                                "sense_id": "fd8ec58b-492e-3830-bee8-7f3777eedd36",
                                "text": "Frau Ettle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "caa7f9c5-d1ac-41a8-bad4-5d4c580791ef",
                                "sense_id": "fd8ec58b-492e-3830-bee8-7f3777eedd36",
                                "text": "Herr Ettle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "a9646285-2e98-4f22-b753-155464159589",
                                "sense_id": "fd8ec58b-492e-3830-bee8-7f3777eedd36",
                                "text": "Die Ettles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "27d53f27-e47e-4e11-98e4-8adcf6a3882d",
                                "sense_id": "fd8ec58b-492e-3830-bee8-7f3777eedd36",
                                "text": "Der Ettle trägt nie die Schals, die die Ettle ihm strickt."
                            },
                            {
                                "example_id": "78593476-157e-4780-96b1-4da9d6377850",
                                "sense_id": "fd8ec58b-492e-3830-bee8-7f3777eedd36",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Ettle kommt, geht der Herr Ettle.“"
                            },
                            {
                                "example_id": "e59c4581-4790-448f-b1be-56d223b8bcc6",
                                "sense_id": "fd8ec58b-492e-3830-bee8-7f3777eedd36",
                                "text": "Ettle kommt und geht."
                            },
                            {
                                "example_id": "42bc2d2e-8d68-4a8b-83b4-d8a1f7837fb8",
                                "sense_id": "fd8ec58b-492e-3830-bee8-7f3777eedd36",
                                "text": "Ettles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
