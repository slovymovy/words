                                        "entry_id": "1ebfadf8-ea5a-3110-8ff2-e29269d5f076",
                                        "glosses": [
                                            "król Elidy, piękny młodzieniec, ukochany Selene, ukarany nieprzerwanym snem i obdarzony wieczną młodością"
                                        ],
                                        "tags": [
                                            "Ancient-Greek"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a4bda80-049d-49d4-ba21-7d403d14cfdf",
                                                "sense_id": "a0205fb2-ca30-35f1-94da-ff344d7fd2e3",
                                                "text": "Endymion symbolizuje piękno śmierci."
                                            },
                                            {
                                                "example_id": "bc0a65b2-17c2-4d3c-9d5a-ce0b78aa2163",
                                                "sense_id": "a0205fb2-ca30-35f1-94da-ff344d7fd2e3",
                                                "text": "W sztukach plastycznych Endymion bywa przedstawiany jako urodziwy młodzieniec, który spoczywa w objęciach Morfeusza."
                                            },
                                            {
                                                "example_id": "be44cc3f-8bf5-4d77-b9db-84d2b2165b07",
                                                "sense_id": "a0205fb2-ca30-35f1-94da-ff344d7fd2e3",
                                                "text": "Pewnej nocy Selene, jadąc po niebie, ujrzała śpiącego Endymiona"
                                            },
                                            {
                                                "example_id": "bfa9aaf6-9a07-497b-8fea-8c585a6754e0",
                                                "sense_id": "a0205fb2-ca30-35f1-94da-ff344d7fd2e3",
                                                "text": "(…) Selene zakochała się w śpiącym Endymionie"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            },
