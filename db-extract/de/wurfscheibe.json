                    {
                        "sense_id": "56d32767-cdc6-3e2b-bffa-c6ca20c19741",
                        "entry_id": "a11cc002-34c5-31ed-9533-a3466dddd36d",
                        "glosses": [
                            "Sport- oder Spielgerät zum Werfen in der Form einer Scheibe, zum Beispiel Diskus oder Frisbee"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8392f671-4165-4d58-8219-296456912491",
                                "sense_id": "56d32767-cdc6-3e2b-bffa-c6ca20c19741",
                                "text": "„Beim Dog-Frisbee jagen extra-sprungstarke Hunde extra-weichen Wurfscheiben hinterher.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a9e3a907-d301-302b-be9b-ba746418d1cc",
                        "entry_id": "a11cc002-34c5-31ed-9533-a3466dddd36d",
                        "glosses": [
                            "Scheibe, die in die Luft geschleudert wird, als Ziel für ein Schießen im sportlichen Wettkampf; Tontaube"
                        ],
                        "tags": [
                            "Schießsport"
                        ],
                        "examples": [
                            {
                                "example_id": "ed24fe32-4b8a-4b34-8851-f0295eabd2e5",
                                "sense_id": "a9e3a907-d301-302b-be9b-ba746418d1cc",
                                "text": "„In London werden 15 Goldmedaillen vergeben: Die Schützen und Schützinnen zielen dabei mit verschiedenen Gewehren und Pistolen entweder auf Schießscheiben oder Wurfscheiben.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
