                ],
                "senses": [
                    {
                        "sense_id": "2ec88c84-0eab-3687-8b5d-47c2a210c4d1",
                        "entry_id": "f3dc1f83-9b3a-3e21-8e3b-af5989fe616d",
                        "glosses": [
                            "Handwerksberuf, der sich mit dem Schlachten von Pferden (selten auch Eseln) und der Zubereitung des Fleisches für die Nahrung beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1c50673-c158-432b-be7f-c1aafab2d188",
                                "sense_id": "2ec88c84-0eab-3687-8b5d-47c2a210c4d1",
                                "text": "Am Münchner Viktualienmarkt werden praktisch alle Lebensmittel, die es gibt, verkauft – es gibt sogar einen Pferdemetzger."
                            },
                            {
                                "example_id": "74693cbe-acd9-46cb-b2de-b04f2c5a98ec",
                                "sense_id": "2ec88c84-0eab-3687-8b5d-47c2a210c4d1",
                                "text": "„Jährlich werden ungefähr eine Million Schlachtpferde aus der Sowjetunion, Polen und Jugoslawien in die EG exportiert. Vor allem die französischen Pferdemetzger legen Wert darauf, daß sie nicht mehr mit Tiefkühlware aus dem Ausland bedient werden. Die Folge sind Transporte lebender Tiere über Hunderte und Tausende von Kilometern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
