                        "examples": [
                            {
                                "example_id": "13306431-3f82-4586-99ba-35fce695a5e6",
                                "sense_id": "dbb5a6aa-1676-31a1-947c-72d21ed0632b",
                                "text": "When a girl's a young lady she's got to have a good supply of fresh skirts and clean shirt-waists. Men like to see their stenogs dressed clean and pretty."
                            },
                            {
                                "example_id": "7c4f8fab-95a8-4bfa-a13a-0077049c32ff",
                                "sense_id": "dbb5a6aa-1676-31a1-947c-72d21ed0632b",
                                "text": "The very stenogs who had scorned them before wanted them now."
                            },
                            {
                                "example_id": "cf6f3d3d-f757-4a61-9eb9-620186b9d8b7",
                                "sense_id": "dbb5a6aa-1676-31a1-947c-72d21ed0632b",
                                "text": "As I said before I had cased this mouse and she was pretty but I knew she was no society debutante. Probably a stenog out of work but very cute."
                            }
                        ]
                    }
