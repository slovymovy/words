                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba21064c-c033-46d8-a408-1404cbbe105f",
                                "sense_id": "fd095f32-49ed-3938-a086-8c0010775d46",
                                "text": "„Mehr als 18.000 Zuschauer wollten im Schnitt die Magdeburger Heimspiele sehen, das ist mit großem Abstand Bestwert in der 3. Liga.“"
                            },
                            {
                                "example_id": "5f5b5ddc-acbe-4dad-8f60-2039b171a1e3",
                                "sense_id": "fd095f32-49ed-3938-a086-8c0010775d46",
                                "text": "„Das Unternehmen verkaufte so viele Fahrzeuge wie noch nie – was letztlich auch zu Bestwerten in der Bilanz führte.“"
                            }
                        ],
