        "fr-extract.jsonl": [
            {
                "entry_id": "a164d738-5864-3a56-9bb4-d23c03818aa2",
                "word": "fondamentalement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b905a585-3fa1-39bb-9522-4c43c1f1cd80",
                        "entry_id": "a164d738-5864-3a56-9bb4-d23c03818aa2",
                        "glosses": [
                            "Sur de bons fondements, sur de bons principes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8cffd33f-4b77-4ff1-8f49-1daa09ca9150",
                                "sense_id": "b905a585-3fa1-39bb-9522-4c43c1f1cd80",
                                "text": "Une maxime fondamentalement établie."
                            }
                        ]
                    },
                    {
                        "sense_id": "efb6676c-bc91-3034-b9a9-a22c9366b3c1",
                        "entry_id": "a164d738-5864-3a56-9bb4-d23c03818aa2",
                        "glosses": [
                            "Au fond, essentiellement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "700fc64d-1a08-4823-8a25-be575295c8d7",
                                "sense_id": "efb6676c-bc91-3034-b9a9-a22c9366b3c1",
                                "text": "L'établissement du prix des choses dépend fondamentalement de la raison du total des choses au total des signes."
                            },
                            {
                                "example_id": "b891e2b2-367d-4820-b68b-157d859033c6",
                                "sense_id": "efb6676c-bc91-3034-b9a9-a22c9366b3c1",
                                "text": "Mais plus fondamentalement, nous devons chercher les raisons de ce déficit d'opposition, dans notre trop grande acceptation du modèle dominant, …."
                            }
                        ]
                    },
                    {
                        "sense_id": "41d5c9dd-dcce-3cdd-89a8-8f8ce088ab70",
                        "entry_id": "a164d738-5864-3a56-9bb4-d23c03818aa2",
                        "glosses": [
                            "Totalement, complètement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe7c17ea-288a-4c5b-a27b-97c9aaa5ac92",
                                "sense_id": "41d5c9dd-dcce-3cdd-89a8-8f8ce088ab70",
                                "text": "Provoquer une réforme qui modifie fondamentalement le système religieux."
                            },
                            {
                                "example_id": "4700578a-6a5b-4079-9e06-4b8b3c1a35ea",
                                "sense_id": "41d5c9dd-dcce-3cdd-89a8-8f8ce088ab70",
                                "text": "La caractéristique de quelques Marseillais de mes amis, c'est d'être, à ce sujet, fondamentalement optimistes. La dépopulation ? Ils la déplorent pour les pays circonvoisins, pour les Basses-Alpes, pour le Var."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "05cef9f0-75a6-4bb4-9d3f-7fc03fe1d915",
                        "source_entry_id": "a164d738-5864-3a56-9bb4-d23c03818aa2",
                        "target_lang_word": "fundamentally",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fundamentally",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a2fe6fef-f264-3f8c-b204-8f8b7e7da40f",
                                        "entry_id": "9f6bd5f8-96b7-3459-844b-e38dacf320f1",
                                        "glosses": [
                                            "In a fundamental or basic sense; reaching the very core of the matter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5cbdf82b-99a9-4474-b994-9226982df6dd",
                                                "sense_id": "a2fe6fef-f264-3f8c-b204-8f8b7e7da40f",
                                                "text": "What the science shows, he says, is that the brain of an addict is fundamentally different from that of a nonaddict."
                                            },
                                            {
                                                "example_id": "377ef536-eba7-4172-9fa4-52ed5513064e",
                                                "sense_id": "a2fe6fef-f264-3f8c-b204-8f8b7e7da40f",
                                                "text": "Hanks is known as being an avid reader of history and biography, and seems to seek out stories which offer a certain optimism and humanism. In other words, he plays – fundamentally – good people."
                                            },
                                            {
                                                "example_id": "c71c1d3a-1d48-4430-8180-451f73977169",
                                                "sense_id": "a2fe6fef-f264-3f8c-b204-8f8b7e7da40f",
                                                "text": "On Tuesday, a proposal to fundamentally restructure the Minneapolis police department in the wake of George Floyd’s death in 2020 was soundly defeated, a setback that even many Democrats acknowledged could be laid at the feet of the “defund the police” movement that some within the party embraced last summer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0908922d-84c4-4883-b051-170cedb94f68",
                        "source_entry_id": "a164d738-5864-3a56-9bb4-d23c03818aa2",
                        "target_lang_word": "inherently",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inherently",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ebad639d-f63a-3bae-a9d5-dbd0dad2293e",
                                        "entry_id": "58e6370c-49b9-3791-84ee-053abf0e4b67",
                                        "glosses": [
                                            "In an inherent way; naturally, innately."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11ceeb7e-c63a-45b1-b3f5-aac65106c8bf",
                                                "sense_id": "ebad639d-f63a-3bae-a9d5-dbd0dad2293e",
                                                "text": "Rights are inherently in all the inhabitants; but charters, by annulling those rights, in the majority, leave the right, by exclusion, in the hands of a few."
                                            },
                                            {
                                                "example_id": "d00f1383-94ee-4d98-a34c-73ba85e127ca",
                                                "sense_id": "ebad639d-f63a-3bae-a9d5-dbd0dad2293e",
                                                "text": "Democrats are quick to say that President Donald Trump’s tariffs are horrible, awful, terrible. But Democrats are also stressing that they are not inherently anti-tariff."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ef759e78-d855-461c-9068-4d885b245d3b",
                        "source_entry_id": "a164d738-5864-3a56-9bb4-d23c03818aa2",
                        "target_lang_word": "radically",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "radically",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "688bb8e3-83e2-3388-848f-fef723cecc45",
                                        "entry_id": "3bbe7e38-2ac7-324e-afba-d10d91261847",
                                        "glosses": [
                                            "In a radical manner; fundamentally; very."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f6830b8-6a33-4c7c-a375-f16658493c8a",
                                                "sense_id": "688bb8e3-83e2-3388-848f-fef723cecc45",
                                                "text": "two radically different political groups"
                                            },
                                            {
                                                "example_id": "c1c5584e-fe69-49d5-9c12-48c0c8c05580",
                                                "sense_id": "688bb8e3-83e2-3388-848f-fef723cecc45",
                                                "text": "The reasons for this growing disconnect are myriad and complex but the situation is exacerbated by the reality that those English players who do smash through our game's \"glass ceiling\" command radically inflated transfer fees."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05989351-3a42-379d-868e-f23623156087",
                                        "entry_id": "3bbe7e38-2ac7-324e-afba-d10d91261847",
                                        "glosses": [
                                            "At the root."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c3e2a04-0feb-4fe8-a7d1-50b9853985cf",
                                                "sense_id": "05989351-3a42-379d-868e-f23623156087",
                                                "text": "\"Clot\" and \"clod\" are radically the same word."
                                            },
                                            {
                                                "example_id": "6b9abf95-babe-4486-82dd-2154cae8ffbe",
                                                "sense_id": "05989351-3a42-379d-868e-f23623156087",
                                                "text": "This [Algonquian] language [family] is spoken by all the Indians throughout New England. Every tribe, as that of Stockbridge, that of Farmington, that of New London, &c. has a different dialect [i.e. language], but the language [family] is radically the same."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
