                        "sense_id": "b50c93bd-fe25-3fc8-9903-0637f0d66f8d",
                        "entry_id": "00920c71-99e3-3245-a850-ba6e5e35491b",
                        "glosses": [
                            "rodzaj specjalnego zabiegu diagnostycznego, będącego inwazyjną metodą pobrania materiału biologicznego z przypuszczalnie zmienionych chorobowo tkanek, który następnie jest oceniany morfologicznie z użyciem mikroskopu świetlnego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "362244ed-34df-4194-a106-8ff320385c06",
                                "sense_id": "b50c93bd-fe25-3fc8-9903-0637f0d66f8d",
                                "text": "Boję się biopsji, bo jest to poważna ingerencja w organizm, ale wiem, że to badanie może mi uratować życie."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6798863b-9cb5-4a64-9294-3d787412c314",
                        "source_entry_id": "00920c71-99e3-3245-a850-ba6e5e35491b",
                        "source_sense_id": "b50c93bd-fe25-3fc8-9903-0637f0d66f8d",
                        "target_lang_word": "biopsy",
