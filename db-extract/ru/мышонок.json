                    }
                ],
                "senses": [
                    {
                        "sense_id": "87378c12-b5f2-36c7-9458-1a9a33219f4e",
                        "entry_id": "0e46ac6f-df39-3eaf-a544-a4cc410b7178",
                        "glosses": [
                            "детёныш мыши"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d18dc70-5aa8-4ef9-9062-c674c611127a",
                                "sense_id": "87378c12-b5f2-36c7-9458-1a9a33219f4e",
                                "text": "И между тем сердце говорит громче, нежели все доводы рассудка; сердце дрожит и сжимается, едва заслышит княжна звуки голоса Техоцкого, как дрожит и сжимается мышонок, завидев для себя неотразимую смерть в образе жирного, самодовольного кота."
                            },
                            {
                                "example_id": "8c231db4-f0a2-4049-9e33-c25c363fe07a",
                                "sense_id": "87378c12-b5f2-36c7-9458-1a9a33219f4e",
                                "text": "Вчера один мышонок вылез и стал катать по полу прошлогодний орех."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b020abb9-e990-432f-938b-e67723552020",
                        "source_entry_id": "0e46ac6f-df39-3eaf-a544-a4cc410b7178",
                        "source_sense_id": "87378c12-b5f2-36c7-9458-1a9a33219f4e",
                        "target_lang_word": "baby mouse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "b45037e8-de13-4db7-94a0-4d16b0e5e6ff",
                        "source_entry_id": "0e46ac6f-df39-3eaf-a544-a4cc410b7178",
                        "source_sense_id": "87378c12-b5f2-36c7-9458-1a9a33219f4e",
                        "target_lang_word": "Mäuschen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mäuschen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "58b568d7-a167-3456-a0dd-66f9ea2d33a4",
                                        "entry_id": "a9047a07-deed-3c8f-a8ce-9ec1d9922b27",
                                        "glosses": [
                                            "kleine, niedliche Maus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e17376e-fab7-45f9-b546-81aed1c7e79c",
                                                "sense_id": "58b568d7-a167-3456-a0dd-66f9ea2d33a4",
                                                "text": "Ich habe vorhin ein ganz putziges Mäuschen gesehen."
                                            },
                                            {
                                                "example_id": "95cd2036-8f2b-49ef-a9a0-be4609e199e0",
                                                "sense_id": "58b568d7-a167-3456-a0dd-66f9ea2d33a4",
                                                "text": "„Es waren einmal ein Mäuschen, ein Vögelchen und eine Bratwurst in Gesellschaft gerathen, hatten einen Haushalt geführt, lange wohl und köstlich im Frieden gelebt, und trefflich an Gütern zugenommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "60762a1d-6676-3f8c-a93c-d4845f260763",
                                        "entry_id": "a9047a07-deed-3c8f-a8ce-9ec1d9922b27",
                                        "glosses": [
                                            "Kosename"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2082a5a-bcf1-4801-9ae6-59ee9342f4f2",
                                                "sense_id": "60762a1d-6676-3f8c-a93c-d4845f260763",
                                                "text": "Komm zu mir, mein Mäuschen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "edda4b85-6da7-3aeb-a37b-d11a5fe0388f",
                                        "entry_id": "a9047a07-deed-3c8f-a8ce-9ec1d9922b27",
                                        "glosses": [
                                            "Musikantenknochen, stoßempfindliche Stelle am Ellenbogen"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25d29555-091b-4e23-a7de-ca4287794a39",
                                                "sense_id": "edda4b85-6da7-3aeb-a37b-d11a5fe0388f",
                                                "text": "Ich habe mir das Mäuschen angeschlagen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
