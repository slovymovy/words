{
    "word_family": [
        "dismantlement",
        "mantle",
        "mantel"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b807f021-9db9-3edd-8332-9a79b7e8d0a7",
                    "sense_definition": "To take a machine or structure apart into separate pieces.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "disassemble",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The technician had to <w>dismantle</w> the engine to find the source of the leak.",
                            "target_lang_translations": {
                                "ru": "Технику пришлось <w>разобрать</w> двигатель, чтобы найти источник утечки."
                            }
                        },
                        {
                            "text": "It is much easier to <w>dismantle</w> the old shed than it was to build it.",
                            "target_lang_translations": {
                                "ru": "Гораздо проще <w>разобрать</w> старый сарай, чем было его построить."
                            }
                        }
                    ],
                    "synonyms": [
                        "disassemble",
                        "take apart",
                        "deconstruct"
                    ],
                    "antonyms": [
                        "assemble",
                        "construct",
                        "build"
                    ],
                    "common_phrases": [
                        "dismantle a machine",
                        "dismantle a structure"
                    ],
                    "target_lang_definitions": {
                        "ru": "Постепенно ликвидировать систему, организацию или свод законов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "демонтировать",
                                "target_lang_sense_clarification": "переносное значение, систему"
                            },
                            {
                                "target_lang_word": "упразднять",
                                "target_lang_sense_clarification": "официально отменять"
                            },
                            {
                                "target_lang_word": "ликвидировать",
                                "target_lang_sense_clarification": "прекращать существование"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b807f021-9db9-3edd-8332-9a79b7e8d0a7",
                    "sense_definition": "To gradually get rid of a system, organization, or set of laws.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "abolish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government plans to <w>dismantle</w> the welfare state by cutting essential public services.",
                            "target_lang_translations": {
                                "ru": "Правительство планирует <w>демонтировать</w> систему социального обеспечения, сокращая основные государственные услуги."
                            }
                        },
                        {
                            "text": "Activists are working hard to <w>dismantle</w> systemic racism within the legal system.",
                            "target_lang_translations": {
                                "ru": "Активисты усердно работают над тем, чтобы <w>искоренить</w> системный расизм в правовой системе."
                            }
                        }
                    ],
                    "synonyms": [
                        "dissolve",
                        "abolish",
                        "liquidate"
                    ],
                    "antonyms": [
                        "establish",
                        "create",
                        "institute"
                    ],
                    "common_phrases": [
                        "dismantle a system",
                        "dismantle an organization"
                    ],
                    "target_lang_definitions": {
                        "ru": "Постепенно ликвидировать систему, организацию или свод законов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "демонтировать",
                                "target_lang_sense_clarification": "переносное значение, систему"
                            },
                            {
                                "target_lang_word": "упразднять",
                                "target_lang_sense_clarification": "официально отменять"
                            },
                            {
                                "target_lang_word": "ликвидировать",
                                "target_lang_sense_clarification": "прекращать существование"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "305183da-f333-3693-8747-d767aa72926f",
                    "sense_definition": "To show that a claim, argument, or theory is wrong by examining its different parts.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "refute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer managed to <w>dismantle</w> the witness's testimony piece by piece.",
                            "target_lang_translations": {
                                "ru": "Адвокату удалось по частям <w>разбить</w> показания свидетеля."
                            }
                        },
                        {
                            "text": "If we can <w>dismantle</w> hate rhetoric and explain why it is illogical, the language becomes less dangerous.",
                            "target_lang_translations": {
                                "ru": "Если мы сможем <w>опровергнуть</w> риторику ненависти и объяснить её нелогичность, язык станет менее опасным."
                            }
                        }
                    ],
                    "synonyms": [
                        "refute",
                        "debunk",
                        "disprove"
                    ],
                    "antonyms": [
                        "support",
                        "uphold",
                        "validate"
                    ],
                    "common_phrases": [
                        "dismantle an argument",
                        "dismantle a theory"
                    ],
                    "target_lang_definitions": {
                        "ru": "Показывать ошибочность утверждения, аргумента или теории, анализируя их составляющие."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разбивать",
                                "target_lang_sense_clarification": "аргументацию"
                            },
                            {
                                "target_lang_word": "опровергать",
                                "target_lang_sense_clarification": "доказывать ложность"
                            },
                            {
                                "target_lang_word": "разбирать",
                                "target_lang_sense_clarification": "подробно анализировать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0e8dba86-b73e-353e-b941-730f19914327",
                    "sense_definition": "To strip someone or something of clothing, covering, or protection.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "strip",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cold wind seemed to <w>dismantle</w> the traveler of his heavy cloak.",
                            "target_lang_translations": {
                                "ru": "Холодный ветер, казалось, <w>срывал</w> с путника его тяжелый плащ."
                            }
                        },
                        {
                            "text": "In the play, the character's betrayal served to <w>dismantle</w> her many folds of favor.",
                            "target_lang_translations": {
                                "ru": "В пьесе предательство персонажа послужило тому, чтобы <w>лишить</w> её многочисленных покровов благосклонности."
                            }
                        }
                    ],
                    "synonyms": [
                        "strip",
                        "divest",
                        "unclothe"
                    ],
                    "antonyms": [
                        "clothe",
                        "cover"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in older literature"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Лишать кого-либо или что-либо одежды, покрова или защиты."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раздевать",
