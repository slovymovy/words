                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a1e287fb-ba7f-4b22-af98-9df351c56ab0",
                        "source_entry_id": "2a12226b-8c99-3ecc-82cb-b1a78e242f40",
                        "source_sense_id": "d49b9335-ffcd-39e0-bef0-3989f0931e01",
                        "source_sense_description": "Bösartigkeit, Fehlerhaftigkeit, Verdorbenheit, Lasterhaftigkeit, Verderbtheit, Boshaftigkeit",
                        "target_lang_word": "Bösartigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "e27c7fa5-b11b-4051-a8ce-9d5643104430",
                        "source_entry_id": "2a12226b-8c99-3ecc-82cb-b1a78e242f40",
                        "source_sense_id": "d49b9335-ffcd-39e0-bef0-3989f0931e01",
                        "source_sense_description": "Bösartigkeit, Fehlerhaftigkeit, Verdorbenheit, Lasterhaftigkeit, Verderbtheit, Boshaftigkeit",
                        "target_lang_word": "Fehlerhaftigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fehlerhaftigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0569d592-c60e-374d-9485-83e63434598c",
                                        "entry_id": "db5f785f-78b1-3a68-b454-01a515ebe499",
                                        "glosses": [
                                            "Eigenschaft, Zustand, gewisse Mängel oder Schwächen zu haben, also fehlerhaft zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be2602fa-bbe3-49cb-9cbd-38b550593398",
                                                "sense_id": "0569d592-c60e-374d-9485-83e63434598c",
                                                "text": "„Am Donnerstag haben Sie gesagt, dass Sie das Gesetz wegen seiner Fehlerhaftigkeit nicht unterschreiben werden.“"
                                            },
                                            {
                                                "example_id": "45a40638-988c-4bc8-925d-ce4e1a1e1f53",
                                                "sense_id": "0569d592-c60e-374d-9485-83e63434598c",
                                                "text": "„Diese hohe Fehlerhaftigkeit bei Hartz-IV schaffe Rechtsunsicherheit, sagte De Felice.“"
                                            },
                                            {
                                                "example_id": "f9eff354-90f7-4370-bc95-93b48a660a19",
                                                "sense_id": "0569d592-c60e-374d-9485-83e63434598c",
                                                "text": "„Das bedeutet, dass er an dieser Front auch nicht zu überzeugen wäre, wenn ihm eine Kommission der besten Weltökonomen die Fehlerhaftigkeit seiner Vorstellungen nachweisen würde.“"
                                            },
                                            {
                                                "example_id": "298a588a-9a94-41b6-881f-029eeebf3964",
                                                "sense_id": "0569d592-c60e-374d-9485-83e63434598c",
                                                "text": "„Vergessen wir dabei nicht, dass Japan immerhin über zehn Jahre benötigte, um sich der Fehlerhaftigkeit seiner eigenen Politik bewusst zu werden.“"
                                            },
                                            {
                                                "example_id": "bbeb3c79-282e-4263-973f-e2c344284660",
                                                "sense_id": "0569d592-c60e-374d-9485-83e63434598c",
                                                "text": "„Hinter diesen Ratschlägen steckt eine Portion Optimismus: Wir vertrauen auf die Lernfähigkeit, wir glauben, dass der Mensch seine Fehlerhaftigkeit überwinden kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9a6247ed-6e87-39ae-b137-05f75c16b8db",
                                        "entry_id": "db5f785f-78b1-3a68-b454-01a515ebe499",
                                        "glosses": [
                                            "etwas, das [1] aufweist"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f07f1fd0-bf27-4f98-94fe-1b56aa4b2a59",
                        "source_entry_id": "2a12226b-8c99-3ecc-82cb-b1a78e242f40",
                        "source_sense_id": "d49b9335-ffcd-39e0-bef0-3989f0931e01",
                        "source_sense_description": "Bösartigkeit, Fehlerhaftigkeit, Verdorbenheit, Lasterhaftigkeit, Verderbtheit, Boshaftigkeit",
                        "target_lang_word": "Verdorbenheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verdorbenheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c765dfdc-dd4b-32f0-b397-a3108217b28d",
                                        "entry_id": "b4ccc295-afd8-360c-8f21-5a6a54e0a1b2",
                                        "glosses": [
                                            "Eigenschaft, verdorben, moralisch verkommen zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96f38d71-0dfd-42f3-876b-379942e4c381",
                                                "sense_id": "c765dfdc-dd4b-32f0-b397-a3108217b28d",
                                                "text": "„Da erst so wenig Zeit vergangen war, entging Anklägern, Richtern, Zeugen, Zuschauern, Politikern und Scharfrichtern die tiefgreifende Verdorbenheit Eichmanns.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f41075f1-7b3c-406f-9cc9-ddc99c5add65",
                        "source_entry_id": "2a12226b-8c99-3ecc-82cb-b1a78e242f40",
                        "source_sense_id": "d49b9335-ffcd-39e0-bef0-3989f0931e01",
                        "source_sense_description": "Bösartigkeit, Fehlerhaftigkeit, Verdorbenheit, Lasterhaftigkeit, Verderbtheit, Boshaftigkeit",
                        "target_lang_word": "Lasterhaftigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lasterhaftigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fe71b698-72da-3da6-ad5c-c64b725e92f3",
                                        "entry_id": "384a7c67-d187-3601-8646-fc0e6718da01",
                                        "glosses": [
                                            "Eigenschaft, lasterhaft zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6eb597b-f938-44ec-a44a-a7c93f7f0345",
                                                "sense_id": "fe71b698-72da-3da6-ad5c-c64b725e92f3",
                                                "text": "„Es war weder Liebe noch Lasterhaftigkeit, was mich veranlaßte, dieser Unglücklichen zu Hilfe zu kommen, sondern Mitgefühl, eine Tugend.“"
                                            },
                                            {
                                                "example_id": "2e03b9bf-ab0a-44b8-b19b-838e0060ef2a",
                                                "sense_id": "fe71b698-72da-3da6-ad5c-c64b725e92f3",
                                                "text": "„Ihre Rohheit, ihre obszöne Lasterhaftigkeit formte den Knaben ebenso wie die naturalistische Auffassung der Dorfmädchen von Liebesdingen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
