                    {
                        "sense_id": "309e71f3-5119-3000-9e96-11951547d94a",
                        "entry_id": "fd986b94-5dcd-3e1e-addf-9428f4aa8223",
                        "glosses": [
                            "Citoyen et écologique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d710de41-2302-41ef-b436-723567eebb9e",
                                "sense_id": "309e71f3-5119-3000-9e96-11951547d94a",
                                "text": "De la compétence écocitoyenne globale découlent trois compétences interreliées."
                            }
                        ]
                    },
                    {
                        "sense_id": "2a0387b1-ff96-303d-92c7-bbc24182854a",
                        "entry_id": "fd986b94-5dcd-3e1e-addf-9428f4aa8223",
                        "glosses": [
                            "Relatif à l’écocitoyenneté, qui a trait à la préservation de l’environnement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0ca6d2a-b2db-4ad8-8ab0-2a452e6f71a0",
                                "sense_id": "2a0387b1-ff96-303d-92c7-bbc24182854a",
                                "text": "Les éco-délégués sont des élèves élus, ambassadeurs des démarches écocitoyennes en milieu scolaire."
                            },
                            {
                                "example_id": "256f14ee-6f07-4285-a5bc-2d072f896438",
                                "sense_id": "2a0387b1-ff96-303d-92c7-bbc24182854a",
                                "text": "Le reboisement est une action écocitoyenne qui permet de lutter contre la désertification."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3168bce0-03e7-4822-87b1-71e035e6700f",
                        "source_entry_id": "fd986b94-5dcd-3e1e-addf-9428f4aa8223",
                        "target_lang_word": "eco-friendly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eco-friendly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f7c87164-ca90-3219-b406-88f6f5b7ce8e",
                                        "entry_id": "72a1a059-2d8a-3463-aa97-bf9e7da3e3ee",
                                        "glosses": [
                                            "Ecologically friendly; not damaging to the natural environment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66cb4dce-13cc-47f5-858d-24e1f1051963",
                                                "sense_id": "f7c87164-ca90-3219-b406-88f6f5b7ce8e",
                                                "text": "Reducing plastic waste is a crucial problem for today’s environment, and whether it’s recyclable and biodegradable phone cases or sustainable fashion, there are plenty of eco-friendly products that can help you reduce your footprint."
                                            },
                                            {
                                                "example_id": "7b234748-3df7-4d72-9001-de459863cc9e",
                                                "sense_id": "f7c87164-ca90-3219-b406-88f6f5b7ce8e",
                                                "text": "To cut carbon, a steel industry by-product (known as ground granulated blast-furnace slag) has been incorporated into the pier, as an eco-friendlier alternative, to traditional concrete."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6e5fbb12-fa2d-499d-a4f6-cdcf77b06523",
                        "source_entry_id": "fd986b94-5dcd-3e1e-addf-9428f4aa8223",
                        "target_lang_word": "ecovriendelijk",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ecovriendelijk",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "7a9e5a8b-5b36-30ae-b1a0-a0f003c67a4f",
                                        "entry_id": "badf449e-bec1-3d3d-ab77-1516a9916df7",
                                        "glosses": [
                                            "wat de leefomgeving en de natuur spaart"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b787a8c8-68ab-4323-af14-cdbb2b0fccae",
                                                "sense_id": "7a9e5a8b-5b36-30ae-b1a0-a0f003c67a4f",
                                                "text": "Ze krijgen ook heel wat bijval voor twee 'groene' beslissingen: alle medailles zijn van ecovriendelijk metaal gemaakt én er wordt gerecycleerd materiaal gebruikt voor de lintjes."
                                            },
                                            {
                                                "example_id": "80512450-1a82-43ee-8635-9d199bee17e1",
                                                "sense_id": "7a9e5a8b-5b36-30ae-b1a0-a0f003c67a4f",
                                                "text": "Added value, toegevoegde waarde, kun je dus voor een product verzinnen. Soms ook zit dat daarin besloten. Bijvoorbeeld als een tandpasta of waspoeder op een ecovriendelijke manier is geproduceerd."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
