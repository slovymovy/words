{
    "word_family": [
        "jade"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4f654855-31e0-347f-bf53-6e79942ebdbc",
                    "sense_definition": "Bored or lacking enthusiasm due to having experienced too much of something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "boredom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After years of traveling, the <w>jaded</w> tourist no longer felt excited by new cities."
                        },
                        {
                            "text": "The <w>jaded</w> audience was unimpressed by the magician's repetitive tricks."
                        }
                    ],
                    "synonyms": [
                        "blasé",
                        "world-weary"
                    ],
                    "common_phrases": [
                        "jaded outlook",
                        "jaded perspective"
                    ]
                },
                {
                    "sense_id": "3f63ab31-9dc2-3366-9266-ca21d54a46eb",
                    "sense_definition": "Feeling physically or mentally exhausted and worn out.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "exhaustion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>jaded</w> athlete finally collapsed after the long marathon."
                        },
                        {
                            "text": "She felt <w>jaded</w> after working a double shift at the hospital."
                        }
                    ],
                    "synonyms": [
                        "exhausted",
                        "fatigued",
                        "weary"
                    ],
                    "common_phrases": [
                        "jaded traveler"
                    ]
                },
                {
                    "sense_id": "e7f43448-d840-3fb0-97ff-e24c4b5ecd29",
                    "sense_definition": "Becoming cynical or insensitive as a result of past experiences.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "cynicism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Years of working in politics left him <w>jaded</w> about the possibility of real change."
                        },
                        {
                            "text": "The detective had become <w>jaded</w> by the constant exposure to crime."
                        }
                    ],
                    "synonyms": [
                        "cynical"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6aaa13ec-f7db-38f1-9ebe-9023609bbfc2",
