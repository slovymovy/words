                        "cross_references": [
                            {
                                "target_word": "threeside",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "600693cc-bdf5-3762-9281-96ba8bf79703",
                                        "entry_id": "8cf509a2-8c35-39ea-a337-5bc437d4948a",
                                        "glosses": [
                                            "Any object or shape consisting of three sides; triangle."
                                        ],
                                        "tags": [
                                            "nonstandard",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d57f8822-931d-4ab5-9353-7905793e64b0",
                                                "sense_id": "600693cc-bdf5-3762-9281-96ba8bf79703",
                                                "text": "[...] let this base-point be indicated by Ax, while the sixth base-point will be indicated by C. Now [c*] contains a threeside formed by a, [...]"
                                            },
                                            {
                                                "example_id": "39ba4f7b-6b79-483a-9f27-dc21074417e7",
                                                "sense_id": "600693cc-bdf5-3762-9281-96ba8bf79703",
                                                "text": "Pappus tells us that Menelaus in his Sphaertca calls the figure in question (the spherical triangle) a 'threeside' [...]"
                                            },
                                            {
                                                "example_id": "acf7d0e5-ec96-4c47-bd6a-8dd681c1e4ad",
                                                "sense_id": "600693cc-bdf5-3762-9281-96ba8bf79703",
                                                "text": "A triangle is then defined as the figure formed by the aggregate of all the segments joining the respective vertices of a three-side to points on the opposite sides."
                                            },
                                            {
                                                "example_id": "b42ba3b0-9350-4ad9-85ab-b15d2218ca11",
                                                "sense_id": "600693cc-bdf5-3762-9281-96ba8bf79703",
                                                "text": "If a straight line passes through a point of one of the sides of a threeside it must contain at least one point of one of the other sides...For the fourside we define the area to be the sum of the areas of the four threesides in which it is divided by its diagonals."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "threeside",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e6b92901-619d-3345-809e-59e1c40ecf92",
                                        "entry_id": "9d3ba19c-c4ba-3319-9816-2cbf4aba4c1b",
                                        "glosses": [
                                            "Having three sides; three-sided, triangular."
                                        ],
