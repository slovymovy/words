                "senses": [
                    {
                        "sense_id": "76fa1559-4254-3296-bfb0-19ce1c86cd04",
                        "entry_id": "21da3000-74b6-3b22-8efa-f7a05b6a4e9b",
                        "glosses": [
                            "In a powerful manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66b7eec7-58ef-4631-a204-338e4a661142",
                                "sense_id": "76fa1559-4254-3296-bfb0-19ce1c86cd04",
                                "text": "Little had been seen of £35m man Carroll until just after the restart when he twice rose powerfully to meet corners, forcing Louis Saha to clear acrobatically off the line and Howard to save low at his post."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "65bb5aa9-e1bb-449e-9027-94b146db7076",
                        "source_entry_id": "21da3000-74b6-3b22-8efa-f7a05b6a4e9b",
                        "source_sense_id": "76fa1559-4254-3296-bfb0-19ce1c86cd04",
                        "source_sense_description": "in a powerful manner",
                        "target_lang_word": "machtig",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "machtig",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "40d88111-ebf9-38cc-81cd-a45a4f635f91",
                                        "entry_id": "aa4c7a8a-cc47-3789-9192-d3ceafbc4bd1",
                                        "glosses": [
                                            "meer invloed hebbend dan anderen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eed1343e-f4c0-4d03-b2d5-80c67f812017",
                                                "sense_id": "40d88111-ebf9-38cc-81cd-a45a4f635f91",
                                                "text": "In zijn tijd was Rome heel machtig."
                                            },
                                            {
                                                "example_id": "f65d2076-067b-488e-b91b-38bd85ef5477",
                                                "sense_id": "40d88111-ebf9-38cc-81cd-a45a4f635f91",
                                                "text": "En men stelde zich voor hoe de machtige Nicolaas, ieder jaar op zijn feestdag, de duivel in ketenen sloeg en geboeid met zich meevoerde."
                                            },
                                            {
                                                "example_id": "81b72861-e6f4-4ede-9e35-9082e08c5e2e",
                                                "sense_id": "40d88111-ebf9-38cc-81cd-a45a4f635f91",
                                                "text": "Bari, een machtige havenstad, riep hem al gauw uit tot 'redder op zee'. En de Noormannen, die Bari in bezit hadden, brachten hun verering voor de 'schutspatroon aller zeelieden' over naar Noord-Europa."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30d3365d-75c3-30ab-b0e5-87e111c33e6e",
                                        "entry_id": "aa4c7a8a-cc47-3789-9192-d3ceafbc4bd1",
                                        "glosses": [
                                            "zeer goed vullen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54e1ce92-d971-4254-b52f-413e528c71b3",
                                                "sense_id": "30d3365d-75c3-30ab-b0e5-87e111c33e6e",
                                                "text": "De groentetaart van gisteravond was mij eigenlijk te machtig."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf0be722-01b4-3e14-8d14-816672447a80",
                                        "entry_id": "aa4c7a8a-cc47-3789-9192-d3ceafbc4bd1",
                                        "glosses": [
                                            "heel mooi, heel leuk en indrukwekkend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "548eed55-ebee-44a6-bef7-af96630dbd16",
                                                "sense_id": "bf0be722-01b4-3e14-8d14-816672447a80",
                                                "text": "Dat is echt een machtige achtbaan!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "machtig",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "84c100da-4b95-39ae-b109-511ce1c009e2",
                                        "entry_id": "929d7499-17c4-309a-866c-e2abf79f6692",
                                        "glosses": [
                                            "eerste persoon enkelvoud tegenwoordige tijd van machtigen"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36dc6eb5-e14c-40e3-9341-dc31a4e9e920",
                                                "sense_id": "84c100da-4b95-39ae-b109-511ce1c009e2",
                                                "text": "Ik machtig."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f511c338-b4be-3fc6-b32e-c85d3fe19888",
                                        "entry_id": "929d7499-17c4-309a-866c-e2abf79f6692",
                                        "glosses": [
                                            "gebiedende wijs van machtigen"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9310f680-b885-4ad0-be22-2639c7373f8c",
                                                "sense_id": "f511c338-b4be-3fc6-b32e-c85d3fe19888",
                                                "text": "Machtig!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28b903b9-68b9-3028-923d-90896b826122",
                                        "entry_id": "929d7499-17c4-309a-866c-e2abf79f6692",
                                        "glosses": [
                                            "tweede persoon enkelvoud tegenwoordige tijd van machtigen"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "inversion"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "632289d3-7fff-4747-8efe-f8aa4f3d1c85",
                                                "sense_id": "28b903b9-68b9-3028-923d-90896b826122",
                                                "text": "Machtig je?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d7b230ca-292c-48fd-b3f3-1dfdb5d28393",
                        "source_entry_id": "21da3000-74b6-3b22-8efa-f7a05b6a4e9b",
                        "source_sense_id": "76fa1559-4254-3296-bfb0-19ce1c86cd04",
                        "source_sense_description": "in a powerful manner",
                        "target_lang_word": "puissamment",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "puissamment",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "578cd8c7-93e9-3f0f-b0fe-720ee79b5b1a",
                                        "entry_id": "ce7bdb40-73c1-3265-a92a-ef9e31ab8252",
                                        "glosses": [
                                            "Avec puissance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e39393a-30e8-46f2-ab8d-2970bdcad789",
                                                "sense_id": "578cd8c7-93e9-3f0f-b0fe-720ee79b5b1a",
                                                "text": "Voir de si faibles vainqueurs [les femmes] Régner si puissamment sur les plus nobles cœurs !"
                                            },
                                            {
                                                "example_id": "677c966a-0af1-44e8-88f0-7d5902a07a97",
                                                "sense_id": "578cd8c7-93e9-3f0f-b0fe-720ee79b5b1a",
                                                "text": "Il sait… que le Grand Seigneur arme puissamment,"
                                            },
                                            {
                                                "example_id": "7788598e-b0b3-48ec-a701-dbd87481ba80",
                                                "sense_id": "578cd8c7-93e9-3f0f-b0fe-720ee79b5b1a",
                                                "text": "À peine le guéritier, se bouchant du pouce la narine droite, en aspira-t-il par la gauche un demi-pincée, le mort toussa si puissamment qu’il aveugla par ses postillons les yeux des trois pandores."
                                            },
                                            {
                                                "example_id": "74db40ec-3903-4d63-93d2-19f6858ee087",
                                                "sense_id": "578cd8c7-93e9-3f0f-b0fe-720ee79b5b1a",
                                                "text": "Enfin, comme à dessein de le rendre plus complexe, des odeurs de caroube, de denrées coloniales, de goudron, d’air marin arrivaient puissamment du port et se mêlaient à celles qui montaient des pavés et des caves."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ecceb1f-61a5-3cd9-b561-b00e0bad29fe",
                                        "entry_id": "ce7bdb40-73c1-3265-a92a-ef9e31ab8252",
                                        "glosses": [
                                            "Avec force."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d113a91f-ca9b-45b7-b3dc-850041bc54cf",
                                                "sense_id": "1ecceb1f-61a5-3cd9-b561-b00e0bad29fe",
                                                "text": "Rien n'éloigne plus promptement et plus puissamment les surprises captieuses des sophistes…."
                                            },
                                            {
                                                "example_id": "ea66973b-dee8-41e6-8598-0321fa2779be",
                                                "sense_id": "1ecceb1f-61a5-3cd9-b561-b00e0bad29fe",
                                                "text": "Cela confirme puissamment ce que vous dites si bien, que nos yeux ne sont point ceux qu’on devrait avoir, si nous regardions les choses comme des chrétiens,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5141eed-dc04-3b5b-a570-1597d395c899",
                                        "entry_id": "ce7bdb40-73c1-3265-a92a-ef9e31ab8252",
                                        "glosses": [
                                            "Extrêmement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fb4417b-e2bc-4185-a803-c03dd4010c20",
                                                "sense_id": "b5141eed-dc04-3b5b-a570-1597d395c899",
                                                "text": "À sa propagande de quartier, il alliait une action incessante dans les ateliers du boulevard Masséna. Il avait puissamment resserré les liens moraux qui unissaient à la C. G. T. les typographes, les minervistes et les relieurs de Delaborde."
                                            },
                                            {
                                                "example_id": "4ea3938c-6db6-4212-9464-caf7e52e5cdb",
                                                "sense_id": "b5141eed-dc04-3b5b-a570-1597d395c899",
                                                "text": "Je sentirais mon mal puissamment soulagé,"
                                            },
                                            {
                                                "example_id": "ec10b2e3-de5a-47f0-94ba-35748b44b43b",
                                                "sense_id": "b5141eed-dc04-3b5b-a570-1597d395c899",
                                                "text": "Et qu’Isabelle en est puissamment irritée,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19966dd9-2a43-3fa8-ada9-88dc1a61094d",
                                        "entry_id": "ce7bdb40-73c1-3265-a92a-ef9e31ab8252",
                                        "glosses": [
                                            "très."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "700f41c6-35f1-4c4d-8369-8afce460f6ed",
                                                "sense_id": "19966dd9-2a43-3fa8-ada9-88dc1a61094d",
                                                "text": "Puissamment riche très riche."
                                            },
                                            {
                                                "example_id": "b11faaf8-91ef-482b-a460-c0cecaba00f9",
                                                "sense_id": "19966dd9-2a43-3fa8-ada9-88dc1a61094d",
                                                "text": "Oui, madame, je suis puissamment riche,"
                                            },
                                            {
                                                "example_id": "6979a1a3-ff77-4b06-b29b-74fdd355955b",
                                                "sense_id": "19966dd9-2a43-3fa8-ada9-88dc1a61094d",
                                                "text": "Un brave laboureur […], et qui, après avoir payé la taille, le taillon, les aides et gabelles, le sou pour livre, la capitation et les vingtièmes, ne se trouvait pas puissamment riche au bout de l’année,"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f1e53db3-fb6a-49a9-b156-d89ec5b5ff77",
                        "source_entry_id": "21da3000-74b6-3b22-8efa-f7a05b6a4e9b",
                        "source_sense_id": "76fa1559-4254-3296-bfb0-19ce1c86cd04",
                        "source_sense_description": "in a powerful manner",
                        "target_lang_word": "fortement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fortement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "19ace799-dd97-3ab3-a1ca-3e148ae67619",
                                        "entry_id": "321a97ef-a2fb-37ee-bed6-fa125cc85af0",
                                        "glosses": [
                                            "Avec force."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "138b1d0e-f3da-4686-b723-92ee002b083a",
                                                "sense_id": "19ace799-dd97-3ab3-a1ca-3e148ae67619",
                                                "text": "L’objectif majeur de cette étude était d’identifier l’influence de différents facteurs dynamiques sur la distribution spatiale des matières en suspension dans une région côtière macrotidale et fortement influencée par les apports fluviaux."
                                            },
                                            {
                                                "example_id": "9229aba6-2775-4e14-af3f-4ee3ed612ec6",
                                                "sense_id": "19ace799-dd97-3ab3-a1ca-3e148ae67619",
                                                "text": "Cela tient fortement à la muraille."
                                            },
                                            {
                                                "example_id": "9e737e5d-b651-4915-a9df-0ff8575c4950",
                                                "sense_id": "19ace799-dd97-3ab3-a1ca-3e148ae67619",
                                                "text": "Cette nouvelle génération d’espionnes, ultradéterminée, qui a redoublé d’efforts pour s’imposer, challenge aussi fortement les agents à l’ancienne."
                                            },
                                            {
                                                "example_id": "f048df1e-d06f-461d-bbe5-b466be56d22a",
                                                "sense_id": "19ace799-dd97-3ab3-a1ca-3e148ae67619",
                                                "text": "C’est un ouvrage fortement pensé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e064e95-ac62-3c35-88d5-ada7b4a2108a",
                                        "entry_id": "321a97ef-a2fb-37ee-bed6-fa125cc85af0",
                                        "glosses": [
                                            "Très, beaucoup."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c7b627d4-b2cd-3969-a2e8-26fbb8b1ae0c",
                                        "entry_id": "321a97ef-a2fb-37ee-bed6-fa125cc85af0",
                                        "glosses": [
                                            "Avec une netteté saillante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90d167a3-2200-4aca-83d8-b0e147a407cb",
                                                "sense_id": "c7b627d4-b2cd-3969-a2e8-26fbb8b1ae0c",
                                                "text": "Des contours, des muscles, etc., fortement dessinés."
                                            },
                                            {
                                                "example_id": "cd40fbc3-0251-42f1-90d5-1b7579192cdc",
                                                "sense_id": "c7b627d4-b2cd-3969-a2e8-26fbb8b1ae0c",
                                                "text": "Des traits marqués fortement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
