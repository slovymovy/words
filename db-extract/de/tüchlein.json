                ],
                "senses": [
                    {
                        "sense_id": "fdee106e-5d33-3cc2-b39f-d93a23ff06e6",
                        "entry_id": "55c2c544-b857-3aec-b5ff-1a9b1b97ace1",
                        "glosses": [
                            "kleines Tuch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07adc990-1673-4cd0-bb44-007362fc947e",
                                "sense_id": "fdee106e-5d33-3cc2-b39f-d93a23ff06e6",
                                "text": "„Während sie dort noch gemeinschaftlich frühstückten, erschien die alte Feng, zog aus dem Ärmel ein älteres Tüchlein, in das die vier goldenen Haarpfeile des langen Lebens eingewickelt waren, und reichte es Väsele Li.“"
                            },
                            {
                                "example_id": "6115504b-013e-4db2-8a42-729f47f25e9d",
                                "sense_id": "fdee106e-5d33-3cc2-b39f-d93a23ff06e6",
                                "text": "„Sie hatte ein zusammengefaltetes, kariertes Tüchlein in der Hand, und ihr Gesichtsausdruck bekundete Schüchternheit und Entschlossenheit zugleich.“"
                            },
                            {
                                "example_id": "c573ec4a-47f4-4cdc-8c57-f7deb0960c9b",
                                "sense_id": "fdee106e-5d33-3cc2-b39f-d93a23ff06e6",
                                "text": "„Ehe er sich versah, hatte der Hemdärmelige das Tüchlein ergriffen und warf es dem Partner zu, der ihm die Joppe vorenthielt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
