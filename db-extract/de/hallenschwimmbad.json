                        "glosses": [
                            "Schwimmbad, das sich in einem geschlossenen Raum befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1677feea-af61-4aae-8c07-962efa8a34d8",
                                "sense_id": "34fe8cdc-2d84-32b7-96cc-b4d983a4a623",
                                "text": "In unserem Hallenschwimmbad riecht es immer so penetrant nach Chlor."
                            },
                            {
                                "example_id": "5eb83b1e-e3b3-458e-99a1-2a47468d5538",
                                "sense_id": "34fe8cdc-2d84-32b7-96cc-b4d983a4a623",
                                "text": "„Das Hallenschwimmbad im Dießener Augustinum bleibt in den Weihnachtsferien vom 23. Dezember bis einschließlich Sonntag, 6. Januar, für die Öffentlichkeit geschlossen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
