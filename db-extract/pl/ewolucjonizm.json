                    },
                    {
                        "translation_id": "ba301fd0-1129-4e58-ab73-129c573493a7",
                        "source_entry_id": "2ae52054-9189-3e7b-b53f-8ba10deec211",
                        "source_sense_id": "2d4f4176-53dc-3a42-b34b-4f47d821cd63",
                        "target_lang_word": "évolutionnisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "évolutionnisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cf582c10-a7f4-3b7b-b302-99e6f2ad1f04",
                                        "entry_id": "f31f6784-a496-3ebe-966f-790d740b55fe",
                                        "glosses": [
                                            "Système fondé exclusivement sur l’idée de l’évolution."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4c7b0d1-50f5-410f-9264-7bfd2bb4ef6b",
                                                "sense_id": "cf582c10-a7f4-3b7b-b302-99e6f2ad1f04",
                                                "text": "L’évolutionnisme donne une interprétation purement physique de tous les phénomènes de l’univers."
                                            },
                                            {
                                                "example_id": "e02b8a06-e997-4c20-b572-08000ca5ab99",
                                                "sense_id": "cf582c10-a7f4-3b7b-b302-99e6f2ad1f04",
                                                "text": "J’avais fourré le progrès continu des bourgeois dans mon âme et j’en faisais un moteur à explosion ; j’abaissai le passé devant le présent et celui-ci devant l’avenir, je transformai un évolutionnisme tranquille en un catastrophisme révolutionnaire et discontinu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2a38cfd-95e0-3edf-ae24-9418d18934a8",
                                        "entry_id": "f31f6784-a496-3ebe-966f-790d740b55fe",
                                        "glosses": [
                                            "Théorie d’après laquelle toutes les espèces vivantes dérivent les unes des autres par transformation naturelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20fb02b7-b225-4c6f-a9e3-2e120056718c",
                                                "sense_id": "f2a38cfd-95e0-3edf-ae24-9418d18934a8",
                                                "text": "S’il est pour la science un péril à se reposer dans la doctrine de l’évolutionnisme, ce n’est tout de même point par paresse que Darwin l’aura formulée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40bbfc4d-cb3e-3c1c-a856-e3c25b54f70c",
                                        "entry_id": "f31f6784-a496-3ebe-966f-790d740b55fe",
                                        "glosses": [
                                            "Conceptions d’après lesquelles le développement des sociétés et des institutions a suivi une certaine orientation et franchi des étapes selon une loi que l’on peut dégager."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
