                        "cross_references": [
                            {
                                "target_word": "electromobility",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b5f31706-1a1a-361e-b3d7-ec0c51eb1df9",
                                        "entry_id": "f06ce7c2-7f94-3f3a-b101-0aae39290a8f",
                                        "glosses": [
                                            "electrophoretic mobility"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e869eb5d-3953-3d56-9c15-2ef6008d157b",
                                        "entry_id": "f06ce7c2-7f94-3f3a-b101-0aae39290a8f",
                                        "glosses": [
                                            "Synonym of emobility."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "201a0c18-4b02-4145-b4d9-b91ded674d62",
                                                "sense_id": "e869eb5d-3953-3d56-9c15-2ef6008d157b",
                                                "text": "Seen in this context, innovation in electromobility (eMobility) takes on a special significance. eMobility is not only an alternative drive technology that can be substituted for the combustion engine that has dominated until now, it could revolutionize transport altogether because it differs decisively from conventional automobility."
                                            },
                                            {
                                                "example_id": "0349663d-9d1e-456c-8f18-eb64b2ae7ad2",
                                                "sense_id": "e869eb5d-3953-3d56-9c15-2ef6008d157b",
                                                "text": "Between 1907 and 1941 the U.S. manufacturer “Detroit Electric” produced more than 12.000 electric cars and over 500 electric trucks. After almost one century of shadowy existence the topic of electromobility is more up to date than ever."
                                            },
                                            {
                                                "example_id": "3d1ce2fd-717e-4f96-b45b-5ddf933d0614",
                                                "sense_id": "e869eb5d-3953-3d56-9c15-2ef6008d157b",
                                                "text": "The TU Munich is broadly positioned in the field of electromobility, working across the board from basic research to application-based research."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8da0c7dd-d97a-4d40-b126-9f4d8e391bd0",
                        "source_entry_id": "773b7b32-d67c-30a6-9469-8242df5bd7fc",
                        "source_sense_id": "cebfb2ed-1b49-310e-ae8b-03bf9d84ea45",
                        "target_lang_word": "e-mobility",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "e-mobility",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ef693fe5-bd67-350b-b3a0-b5efb3db4419",
                                        "entry_id": "00fbb446-8d5d-34a2-8c5b-ae6f78abd98e",
                                        "glosses": [
                                            "Alternative form of emobility."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13df18fb-d597-4a12-b1bf-dfdbf6e49013",
                                                "sense_id": "ef693fe5-bd67-350b-b3a0-b5efb3db4419",
                                                "text": "As a result, a multitude of new business models for e-mobility are currently in development."
                                            },
                                            {
                                                "example_id": "bfe48a66-7fca-440e-944f-96c9728941a2",
                                                "sense_id": "ef693fe5-bd67-350b-b3a0-b5efb3db4419",
                                                "text": "C2C communicates news related to developments in e-mobility in the U.S. and the Netherlands through various channels."
                                            },
                                            {
                                                "example_id": "5d51fc25-675f-4fa9-9e68-b94187f2a4a6",
                                                "sense_id": "ef693fe5-bd67-350b-b3a0-b5efb3db4419",
                                                "text": "Moreover, the government program for 2011 created so-called “showcase regions”, i.e. state-subsidized regions where e-mobility projects with various focus areas were specifically implemented."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
