                "senses": [
                    {
                        "sense_id": "47401f76-d87d-32b2-aa8a-798af5c031c1",
                        "entry_id": "85a29b7b-c74b-35f9-b805-50d2f2be745c",
                        "glosses": [
                            "In a thin, loose, or scattered manner; scantily; not thickly."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88dc6480-6376-41b5-8baa-50cc4d3af3cf",
                                "sense_id": "47401f76-d87d-32b2-aa8a-798af5c031c1",
                                "text": "The surroundings become bleak in the extreme as the timber line is approached and trees give place to thinly scattered birches that are little more than bushes."
                            },
                            {
                                "example_id": "40854542-65e6-43e3-9c1f-fb379c668824",
                                "sense_id": "47401f76-d87d-32b2-aa8a-798af5c031c1",
                                "text": "Brüno was a case of diminishing returns, intermittently amusing but not nearly as bracing or funny as Borat—it didn’t help that Brüno was the most thinly conceived of all his Da Ali G Show characters—and the lead-up to Baron Cohen’s new comedy, The Dictator, made it look like he’d boxed himself into a corner."
                            },
                            {
                                "example_id": "39f5efb1-cc1a-4342-8e29-2eaf572a8f83",
                                "sense_id": "47401f76-d87d-32b2-aa8a-798af5c031c1",
                                "text": "“The Budget proposes eliminating Supporting Effective Instruction (SEI) State Grants (Title II State grants), a program that provides formula funds to States to improve the quality and effectiveness of teachers, principals, and other schools leaders. SEI grants are poorly targeted and funds are spread too thinly to have a meaningful impact on student outcomes."
                            }
                        ]
                    },
                    {
                        "sense_id": "327551fe-b5c2-3f43-8eea-c13fc463f900",
                        "entry_id": "85a29b7b-c74b-35f9-b805-50d2f2be745c",
                        "glosses": [
                            "Barely; hardly; with little attempt to conceal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e88b6591-3af0-440a-8f53-2fe17805f040",
                                "sense_id": "327551fe-b5c2-3f43-8eea-c13fc463f900",
                                "text": "a thinly-veiled attack on my integrity"
                            },
                            {
                                "example_id": "ecbd2e33-0854-4108-a90c-1bc13ee5e409",
                                "sense_id": "327551fe-b5c2-3f43-8eea-c13fc463f900",
                                "text": "a thinly disguised attempt at sabotage"
                            }
                        ]
                    }
                ],
