                    {
                        "sense_id": "91f55f39-a8e2-3fe0-848b-4002452aa720",
                        "entry_id": "ea457b97-d57c-30aa-ac5a-f93d0177c9ae",
                        "glosses": [
                            "short and stout; low and wide"
                        ],
                        "tags": [
                            "British"
                        ],
                        "examples": [
                            {
                                "example_id": "6b5f5718-4ab7-4513-8554-3bd771f1bc1f",
                                "sense_id": "91f55f39-a8e2-3fe0-848b-4002452aa720",
                                "text": "A fubsy, good-humoured, laughing, silly […] old maid."
                            },
                            {
                                "example_id": "326481c4-0de3-4cdb-80ec-afd2fbb4499d",
                                "sense_id": "91f55f39-a8e2-3fe0-848b-4002452aa720",
                                "text": "“Pray,” said Doctor Waldron, addressing Mrs. Green, “who is that little fubsy lady, with scarce a morsel of neck, and all covered with ribbands, pursued by that long ghost of a man in the Spanish dress?”"
                            },
                            {
                                "example_id": "82ec1a2c-1583-44e0-86d3-c8687879d057",
                                "sense_id": "91f55f39-a8e2-3fe0-848b-4002452aa720",
                                "text": "[…] seated upon the widow's little fubsy sofa […]"
                            },
                            {
                                "example_id": "a2c2a241-e26c-4adf-b86c-fdf79cef0272",
                                "sense_id": "91f55f39-a8e2-3fe0-848b-4002452aa720",
                                "text": "He knew she was nothing but a fubsy pig-pink whorelet and would elbow her face away when she attempted to kiss him after he had finished […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9371eef0-8c9b-424d-893a-38096241201d",
                        "source_entry_id": "ea457b97-d57c-30aa-ac5a-f93d0177c9ae",
                        "source_sense_id": "91f55f39-a8e2-3fe0-848b-4002452aa720",
                        "source_sense_description": "short and stout; low and wide",
                        "target_lang_word": "przysadzisty",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
