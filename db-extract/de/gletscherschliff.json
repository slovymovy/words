                "senses": [
                    {
                        "sense_id": "28dc6814-602f-3943-a31d-4acd43053f7f",
                        "entry_id": "7366e0a7-098c-32a9-ae1c-b48abb424a13",
                        "glosses": [
                            "Material, das von Gletschern abgeschliffen wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "358240e9-59ae-4f7c-b5d4-2ce64f44aa49",
                                "sense_id": "28dc6814-602f-3943-a31d-4acd43053f7f",
                                "text": "„Andreas Döllerer backt Fenchel im Salzteig mit Gletscherschliff, damit das Gemüse einen feinen mineralischen Geschmack bekommt.“ (www.bild.de, gesammelt am 30.03.2018)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c9cf5e67-824d-398c-9ff6-3143bf772471",
                        "entry_id": "7366e0a7-098c-32a9-ae1c-b48abb424a13",
                        "glosses": [
                            "Oberflächenform von Felsen, die durch die Gleitbewegung, das Gewicht eines Gletschers und darin eingelagertes Gestein abgeschliffen (zum Beispiel poliert, gekratzt) wurden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f693f3c8-642c-484d-ae89-125e79530535",
                                "sense_id": "c9cf5e67-824d-398c-9ff6-3143bf772471",
                                "text": "„Die Teilnehmer erlebten den Wechsel zwischen der Theorie mit Vortrag, Besuch von Sammlungen und Diaschau und Exkursionen zum Gletscherschliff, Steinbruch bei Burgberg und Gottesackerplateau als «eine gelungene, fruchtbare Veranstaltung»“. (www.allgaeuer-anzeigeblatt.de, gesammelt am 27.03.2018)"
                            },
                            {
                                "example_id": "fe53e27d-3695-443d-9e6c-cf08782d03dc",
                                "sense_id": "c9cf5e67-824d-398c-9ff6-3143bf772471",
                                "text": "„Die weitere Route verläuft hochalpin über Gletscherschliff und Blockwerk.“ (www.salzburg24.at, gesammelt am 30.03.2018)"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "f7910710-4979-39ad-8c2f-4f3744919825",
                        "entry_id": "7366e0a7-098c-32a9-ae1c-b48abb424a13",
                        "glosses": [
                            "abschleifende Tätigkeit eines Gletschers, der sich über einen Gesteinskörper hinwegbewegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5db8b9ca-6b00-4e88-9749-7685f5a3cf46",
                                "sense_id": "f7910710-4979-39ad-8c2f-4f3744919825",
                                "text": "„Vom Gletschereis mitgeführte Gesteinstrümmer unterschiedlichster Größe beanspruchen den Felsuntergrund. Sie schleifen ihn ab und glätten ihn. Man bezeichnet diesen Teilprozess der Glazialerosion als Detersion (von lateinisch deterere = zerreiben)“ oder synonym als Gletscherschliff."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
