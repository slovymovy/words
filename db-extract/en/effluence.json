                "senses": [
                    {
                        "sense_id": "d1986d34-5f67-389e-96fc-cef558b446fd",
                        "entry_id": "7cf09512-2242-3b38-9aaa-d807842dbfe1",
                        "glosses": [
                            "The process of flowing out."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "6782f3a1-f0f3-3d4c-9423-5d9bd8445d97",
                        "entry_id": "7cf09512-2242-3b38-9aaa-d807842dbfe1",
                        "glosses": [
                            "Something that flows out; the issue."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "27a2b5c1-9c08-4e02-9033-18020e229f79",
                                "sense_id": "6782f3a1-f0f3-3d4c-9423-5d9bd8445d97",
                                "text": "But we have grounds to believe, that there are yet other Rays or Effluences from the Sun, which neither Feeling nor Sight can apprehend, but which are to be inferred from the effects."
                            },
                            {
                                "example_id": "fe8e0bed-25a9-4488-9c69-a617780819d9",
                                "sense_id": "6782f3a1-f0f3-3d4c-9423-5d9bd8445d97",
                                "text": "The doctrine of spiritism is associated in Shinto with the word Mitama, for which \"spirit\" is the nearest English equivalent. Strictly speaking, the Mitama is not the God, but an emanation or effluence from him, which inhabits his temple, and is the vehicle of his action at a distance from the place where he himself resides."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a98607b4-9720-4ccd-ab27-5a1d725da93e",
                        "source_entry_id": "7cf09512-2242-3b38-9aaa-d807842dbfe1",
                        "source_sense_description": "process of flowing out",
                        "target_lang_word": "effluence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "effluence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bc4b048f-394c-32e8-8ca8-86ed8fc55092",
                                        "entry_id": "1c57d4e1-d61e-3cc3-8d44-175f5f14800b",
                                        "glosses": [
                                            "Ce qui flue hors, coule hors, s’exhale d’une manière invisible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4913771-1d12-4cdb-8765-1e743d2ca19e",
                                                "sense_id": "bc4b048f-394c-32e8-8ca8-86ed8fc55092",
                                                "text": "Des effluences de marais."
                                            },
                                            {
                                                "example_id": "90041ca3-f132-4dec-93a6-9710edf69b22",
                                                "sense_id": "bc4b048f-394c-32e8-8ca8-86ed8fc55092",
                                                "text": "Effluences électriques."
                                            },
                                            {
                                                "example_id": "d29125eb-ea18-4506-adc8-88b023a9ccc9",
                                                "sense_id": "bc4b048f-394c-32e8-8ca8-86ed8fc55092",
                                                "text": "Souvent même, ils avaient été soulevés par l’effluence mystique, par l’émanation même du Moyen Age à jamais perdue."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
