                        ],
                        "examples": [
                            {
                                "example_id": "e687d644-9ba3-446f-a711-393990e0aa7c",
                                "sense_id": "7c78a3fe-388c-3956-bf44-fec2858628be",
                                "text": "Immer wenn ich traurig bin, trink' ich einen Unikum (frei nach Heinz Erhardt)"
