                        "glosses": [
                            "Subject to attainder; condemned to death or outlawry, hence stripped of one's titles, hereditary rights, or possessions."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "715d704b-610b-451d-91d5-0e8ee0e74318",
                                "sense_id": "56e1360b-2a40-3a8e-bf05-633a70b232c0",
                                "text": "The king stands in your father's place, since your brother is an attainted traitor."
                            },
                            {
                                "example_id": "b52aba29-7c36-4018-9ee2-a58c7b696a11",
                                "sense_id": "56e1360b-2a40-3a8e-bf05-633a70b232c0",
                                "text": "Besides, Suffolk, attainted – stripped of his hereditary title – was no longer a member of the nobility, merely ‘Ed. Rebel’."
                            }
                        ]
                    },
