                                        "entry_id": "c7e3960d-1b78-3427-b892-dd0d1280643d",
                                        "glosses": [
                                            "Très long fleuve en Chine, qui coule du Tibet jusqu’à la mer de Chine orientale, au nord de Shanghai."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7dd41e18-2db4-4206-8946-8a21522ee78e",
                                                "sense_id": "d835f712-e314-3176-9e76-f1065e48cf82",
                                                "text": "Ce tunnel, en construction depuis deux ans, est le premier à traverser le fleuve Yangtsé, l’une des plus importantes voies d’eau en Chine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
