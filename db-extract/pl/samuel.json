                                            {
                                                "example_id": "8c90ad7f-058a-49e0-ba42-f20b20f967d1",
                                                "sense_id": "7eed45cf-9f7f-3ad6-9d42-ea8f55dcae6d",
                                                "text": "Les gérants de l’ancien parc saint-georgeais, Samuel Lesueur et Yann Cosson sont déjà plongés dans une bataille judiciaire avec la Ville de Saint-Georges-de-Didonne qui a décidé de se séparer d’eux."
                                            },
                                            {
                                                "example_id": "818ceeaf-3f35-4cd2-ac92-f929544495d8",
                                                "sense_id": "7eed45cf-9f7f-3ad6-9d42-ea8f55dcae6d",
                                                "text": "Pau, Camille, Juliette, Tiphaine, Laura et Samuel, tous proches de la trentaine, ont choisi de fonder une éco-location, dans le 12ᵉ arrondissement."
                                            },
                                            {
                                                "example_id": "d4731267-7fe4-4b69-bcfc-e0fea49a5a9a",
                                                "sense_id": "7eed45cf-9f7f-3ad6-9d42-ea8f55dcae6d",
                                                "text": "Samuel sentit que le vent tournait.\n— Viens, Abraham, on s’en va…"
                                            }
                                        ]
                                    }
                                ]
                            },
