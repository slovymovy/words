                "senses": [
                    {
                        "sense_id": "d065cb08-9cb9-386b-ba5c-ea22f3c47241",
                        "entry_id": "e9a9745a-2524-3619-a528-067425fe4426",
                        "glosses": [
                            "Untersuchung (Test), die im besonderen Umfeld eines wissenschaftlich eingerichteten Arbeitsplatzes (Labor) durchgeführt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2127fa16-b897-459d-8f1c-6df0760be902",
                                "sense_id": "d065cb08-9cb9-386b-ba5c-ea22f3c47241",
                                "text": "Wenn das Ergebnis vom Labortest vorliegt, rufen wir Sie an."
                            },
                            {
                                "example_id": "23f03ae7-1c33-4cbe-a48b-b018ce1632af",
                                "sense_id": "d065cb08-9cb9-386b-ba5c-ea22f3c47241",
                                "text": "Der Labortest weist das Virus oder Anteile davon nach, wogegen der Schnelltest die Antikörper im Blut erkennt."
                            },
                            {
                                "example_id": "9f1024fb-ec8e-4344-b125-3a92fdaf2c41",
                                "sense_id": "d065cb08-9cb9-386b-ba5c-ea22f3c47241",
                                "text": "Wir haben beide Kameras einem Labortest unterworfen."
                            },
                            {
                                "example_id": "59ca22de-b6a7-4094-8f2a-a9897f676e15",
                                "sense_id": "d065cb08-9cb9-386b-ba5c-ea22f3c47241",
                                "text": "Was im Labortest funktioniert, muss nicht sofort fehlerfrei in der Praxis funktionieren."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
