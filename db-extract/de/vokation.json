                "senses": [
                    {
                        "sense_id": "7163d400-5184-3fec-84ba-2c48dc22e081",
                        "entry_id": "150db3e3-3ae5-37aa-bdee-d3b5b96604e9",
                        "glosses": [
                            "Ernennung, Berufung in ein bestimmtes Amt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f62441f3-b842-4e00-a7f9-bc6c7d99c5fa",
                                "sense_id": "7163d400-5184-3fec-84ba-2c48dc22e081",
                                "text": "„Es war der bekannte Bediente des Rittmeisters, der die Vokation an den Subrektor Füchslein hatte.“"
                            },
                            {
                                "example_id": "c80d5dc9-98aa-44b1-84a0-4acb3b8e8bc2",
                                "sense_id": "7163d400-5184-3fec-84ba-2c48dc22e081",
                                "text": "„Eine kirchenrechtliche Grundlage für die Vokation Nüssmanns bot der königliche Befehl jedoch nicht.“"
                            },
                            {
                                "example_id": "2aaa7677-6527-4ecc-afe1-98fdfda31f02",
                                "sense_id": "7163d400-5184-3fec-84ba-2c48dc22e081",
                                "text": "„Die Vokation ist danach derjenige Akt, durch den der Pfarrer seine Legitimation empfängt.“"
                            },
                            {
                                "example_id": "0e260991-bc9a-4501-a205-d8a5f8c78a0d",
                                "sense_id": "7163d400-5184-3fec-84ba-2c48dc22e081",
                                "text": "„Falls er später eine rechtmäßige und unstrittige Vokation bekommen sollte, würde er wieder nach Danzig zurückkehren.“"
                            },
                            {
                                "example_id": "e39048f3-8fb5-4bb4-b1fe-7c663900a967",
                                "sense_id": "7163d400-5184-3fec-84ba-2c48dc22e081",
                                "text": "„Die Ausfertigung der Vokation gebührt dem Patrone und in dessen Ermangelung den Kirchenvorstehern.“"
                            },
                            {
                                "example_id": "d764bef7-bcd3-4248-b197-0995c7ad4476",
                                "sense_id": "7163d400-5184-3fec-84ba-2c48dc22e081",
                                "text": "„Doch nach nur einjähriger Amtszeit erreichte ihn die Vokation zum Pastor und Inspektor in Havelberg, die er auch annahm.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
