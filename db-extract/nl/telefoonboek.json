                "translations": [
                    {
                        "translation_id": "3b40babb-9641-42c4-b42f-e9fedce32d58",
                        "source_entry_id": "f32ee39c-67c8-3526-9ce1-b1c34a9ef7c9",
                        "source_sense_id": "b4fc35fb-ed0f-3410-a302-62958177ef70",
                        "source_sense_description": "is een boek met een grote verzameling telefoonnummers gerangschikt op naam en woonplaats",
                        "target_lang_word": "Telefonbuch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Telefonbuch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4803c8d3-8ef2-3d69-8a8e-d2d7dc8cc1bf",
                                        "entry_id": "129c7e14-1936-3d97-ade3-bc90d9419d6e",
                                        "glosses": [
                                            "Buch oder Verzeichnis von Telefonnummern, Telefonverzeichnis in Buchform"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b45820fc-b3bc-474a-b27f-b84f1bb3dd4a",
                                                "sense_id": "4803c8d3-8ef2-3d69-8a8e-d2d7dc8cc1bf",
                                                "text": "Viele Telefonbesitzer lassen sich nicht mehr im Telefonbuch verzeichnen, da die Nummern von aufdringlichen Werbeanrufern missbraucht werden."
                                            },
                                            {
                                                "example_id": "b02a55f7-1dd0-41ee-96b4-9fbe16f3c052",
                                                "sense_id": "4803c8d3-8ef2-3d69-8a8e-d2d7dc8cc1bf",
                                                "text": "Meine Nummer finden sie leicht im Telefonbuch unter Lieschen Müller."
                                            },
                                            {
                                                "example_id": "a4618aab-a4e1-4664-88ed-18557c973aca",
                                                "sense_id": "4803c8d3-8ef2-3d69-8a8e-d2d7dc8cc1bf",
                                                "text": "„Im Café ließ er sich das Telefonbuch geben - er blätterte, es war töricht zu erwarten, daß einer von damals noch hier lebte und ein Telefon besaß.“"
                                            },
                                            {
                                                "example_id": "0a30b2e1-a8c4-48c4-a7ff-25b0eea696ab",
                                                "sense_id": "4803c8d3-8ef2-3d69-8a8e-d2d7dc8cc1bf",
                                                "text": "„Im Telefonbuch fehlt sie aus guten Gründen, und Eos hat nicht daran gedacht, sie ihm zu geben.“"
                                            },
                                            {
                                                "example_id": "2163770a-47a8-47d5-a348-3c8a3d18dfb3",
                                                "sense_id": "4803c8d3-8ef2-3d69-8a8e-d2d7dc8cc1bf",
                                                "text": "„Auf dem Dorfplatz betritt Elsa die gelbe Telefonzelle und findet auf der ersten Seite des Telefonbuchs die Nummer der Auskunft.“"
                                            },
                                            {
                                                "example_id": "e2f936f5-b7ad-467c-933a-f2ba00a73679",
                                                "sense_id": "4803c8d3-8ef2-3d69-8a8e-d2d7dc8cc1bf",
                                                "text": "„Ich zündete mir an Monikas Kerze eine von Monikas Zigaretten an, holte den Kognak aus der Küche, das Telefonbuch aus der Diele und hob den Telefonhörer ab.“"
                                            },
                                            {
                                                "example_id": "4ce20599-17bf-40c2-9562-ad10b2da0241",
                                                "sense_id": "4803c8d3-8ef2-3d69-8a8e-d2d7dc8cc1bf",
                                                "text": "„Chigurh fuhr bei der Ausfahrt zur 131 vom Highway ab, schlug das Telefonbuch auf seinem Schoß auf und blätterte die blutbefleckten Seiten um, bis er zu den Tierärzten kam.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
