{
    "word_family": [
        "member"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fbd83d6d-cf2f-32f9-9441-a3774923f6a1",
                    "sense_definition": "The state of being a member of a group or organization.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "state_of_belonging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to cancel her gym <w>membership</w> to save money.",
                            "target_lang_translations": {
                                "ru": "Она решила аннулировать свой <w>абонемент</w> в спортзал, чтобы сэкономить деньги.",
                                "zh": "为了省钱，她决定取消健身房的<w>会员资格</w>。"
                            }
                        },
                        {
                            "text": "You need a valid <w>membership</w> to enter the private club.",
                            "target_lang_translations": {
                                "ru": "Вам нужно действующее <w>членство</w>, чтобы войти в частный клуб.",
                                "zh": "你需要有效的<w>会员</w>身份才能进入这家私人俱乐部。"
                            }
                        }
                    ],
                    "synonyms": [
                        "enrollment",
                        "subscription",
                        "affiliation"
                    ],
                    "common_phrases": [
                        "membership card",
                        "membership fee",
                        "gym membership",
                        "apply for membership"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние пребывания членом группы или организации.",
                        "zh": "作为团体或组织成员的身份或状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "членство",
                                "target_lang_sense_clarification": "статус участника организации"
                            },
                            {
                                "target_lang_word": "абонемент",
                                "target_lang_sense_clarification": "право пользования услугами (напр. спортзала)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "会员资格",
                                "target_lang_sense_clarification": "作为组织成员的身份"
                            },
                            {
                                "target_lang_word": "会员",
                                "target_lang_sense_clarification": "指代会员身份或凭证"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "df54abff-25a1-3937-8e7f-1dd924ba4816",
                    "sense_definition": "The body of members of an organization.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The union's <w>membership</w> voted in favor of the strike.",
                            "target_lang_translations": {
                                "ru": "<w>Члены</w> профсоюза проголосовали за забастовку.",
                                "zh": "工会的<w>全体成员</w>投票支持罢工。"
                            }
                        },
                        {
                            "text": "The club's <w>membership</w> has grown significantly this year.",
                            "target_lang_translations": {
                                "ru": "<w>Численный состав</w> клуба значительно вырос в этом году.",
                                "zh": "今年该俱乐部的<w>会员人数</w>显著增长。"
                            }
                        }
                    ],
                    "synonyms": [
                        "members",
                        "body"
                    ],
                    "common_phrases": [
                        "total membership",
                        "general membership"
                    ],
                    "target_lang_definitions": {
                        "ru": "Совокупность всех членов организации.",
                        "zh": "组织中所有成员的总和。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "члены",
                                "target_lang_sense_clarification": "люди, входящие в организацию"
                            },
                            {
                                "target_lang_word": "состав",
                                "target_lang_sense_clarification": "совокупность участников"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "全体成员",
                                "target_lang_sense_clarification": "组织内的所有成员"
                            },
                            {
                                "target_lang_word": "会员人数",
                                "target_lang_sense_clarification": "指代成员的数量规模"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d8007e59-e30b-3bad-b817-2098bd2b5a58",
                    "sense_definition": "The fact of being a member of a set.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "state_of_belonging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The symbol indicates <w>membership</w> in the set of integers.",
                            "target_lang_translations": {
                                "ru": "Этот символ указывает на <w>принадлежность</w> к множеству целых чисел.",
                                "zh": "该符号表示<w>属于</w>整数集合。"
                            }
                        },
                        {
                            "text": "We must define the criteria for set <w>membership</w> clearly.",
                            "target_lang_translations": {
                                "ru": "Мы должны четко определить критерии <w>принадлежности</w> к множеству.",
                                "zh": "我们必须明确定义集合<w>隶属</w>的标准。"
                            }
                        }
                    ],
                    "synonyms": [
                        "inclusion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Факт вхождения элемента в множество.",
                        "zh": "元素属于某个集合的事实。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "принадлежность",
                                "target_lang_sense_clarification": "в математике и логике"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "属于",
                                "target_lang_sense_clarification": "数学或逻辑上的归属关系"
                            },
                            {
                                "target_lang_word": "隶属",
                                "target_lang_sense_clarification": "归属于某集合"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f457edf0-f0f2-3d9c-9c85-52c2c0b6f12e",
                    "sense_definition": "To classify someone as belonging to a certain group or community.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sociologists analyze how we <w>membership</w> people in conversation.",
                            "target_lang_translations": {
                                "ru": "Социологи анализируют, как мы <w>причисляем</w> людей к группам в разговоре.",
                                "zh": "社会学家分析我们在对话中是如何将人们进行<w>归类</w>的。"
                            }
                        },
                        {
                            "text": "Do not <w>membership</w> him based on stereotypes.",
                            "target_lang_translations": {
                                "ru": "Не стоит <w>классифицировать</w> его, основываясь на стереотипах.",
                                "zh": "不要根据刻板印象对他进行<w>划分</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "classify",
                        "categorize"
                    ],
                    "target_lang_definitions": {
                        "ru": "Классифицировать кого-либо как принадлежащего к определенной группе или сообществу.",
                        "zh": "将某人归类为属于特定群体或社区。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "причислять",
                                "target_lang_sense_clarification": "относить к группе"
                            },
                            {
                                "target_lang_word": "классифицировать",
                                "target_lang_sense_clarification": "распределять по категориям"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "归类",
                                "target_lang_sense_clarification": "将某人划分到特定类别"
                            },
                            {
                                "target_lang_word": "划分",
                                "target_lang_sense_clarification": "将某人归入某群体"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}