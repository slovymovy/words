                                        "entry_id": "893dbc73-a22b-304c-bf4a-337ef15c256e",
                                        "glosses": [
                                            "Alternative form of muller (“to beat, thrash”)."
                                        ],
                                        "tags": [
                                            "UK",
                                            "alt-of",
                                            "alternative",
                                            "slang",
