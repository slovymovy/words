                "senses": [
                    {
                        "sense_id": "ec24cfca-dd6e-3c55-a6d3-6078f343cd12",
                        "entry_id": "d3eaf8fe-b395-38a0-916e-6938578a018d",
                        "glosses": [
                            "Hominidae familie in de orde primaten mensaap, mensachtige"
                        ],
                        "tags": [
                            "primaten"
                        ],
                        "examples": [
                            {
                                "example_id": "cc65079c-417b-4d09-a58a-cd0898e3184c",
                                "sense_id": "ec24cfca-dd6e-3c55-a6d3-6078f343cd12",
                                "text": "Is de reeks oersoep, hominide (mensaap) en Jezus Christus (de Waarheid en het Leven) het totaalplaatje van het leven? Of is het evolutiefilosofie?"
                            },
                            {
                                "example_id": "0371793d-d59e-4aad-9ad8-6ce5235d270d",
                                "sense_id": "ec24cfca-dd6e-3c55-a6d3-6078f343cd12",
                                "text": "In de wetenschap wordt driftig gewerkt aan de verbetering van de mensensoort. De kerk laat echter na hierop een ethisch antwoord te geven. Dat stelt ds. J. A. Bos in zijn proefschrift over de kerk en een nieuwe ”hominide”, een nieuwe versie van de ”homo sapiens”."
                            },
                            {
                                "example_id": "b36f75ca-0735-4cd2-8fbf-5226581d4d5a",
                                "sense_id": "ec24cfca-dd6e-3c55-a6d3-6078f343cd12",
                                "text": "De nieuwe ontdekking staaft ook de theorie dat de rechtop lopende hominiden gedurende een lange periode over grote delen van het Afrikaanse continent ronddoolden."
                            }
                        ]
                    }
