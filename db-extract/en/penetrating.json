                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67904d57-5085-47de-bd6a-63c75fcb7d4b",
                                "sense_id": "5067e0a6-6936-328c-bf0c-597503e4941a",
                                "text": "The skunk produces a penetrating odor."
                            },
                            {
                                "example_id": "cd96e008-7918-4785-8dcc-5247f9f8058b",
                                "sense_id": "5067e0a6-6936-328c-bf0c-597503e4941a",
                                "text": "As the rest of the film was made on location in the railway yards of Havre and not in a studio, and was given a sound-track of penetrating vividness, this whole production gives the closest possible ring of truth of any film about railways."
                            }
                        ]
                    },
                    {
                        "sense_id": "15f3cfc5-5abb-358c-a707-9ee941ec15f5",
                        "entry_id": "557bb23b-8fab-3768-bdc5-27d9b36d20b5",
                        "glosses": [
                            "Looking deeply into; piercing"
                        ],
                        "tags": [],
                        "examples": [
