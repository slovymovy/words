                        "entry_id": "617855e5-6f76-3d14-bd4f-3587ea441fed",
                        "glosses": [
                            "chłodnia, w której niską temperaturę uzyskuje się przez zastosowanie lodu naturalnego lub sztucznego"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
