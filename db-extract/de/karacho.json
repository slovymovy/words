                "senses": [
                    {
                        "sense_id": "f7d1421a-ea5a-3fd8-bb36-bb97243c8638",
                        "entry_id": "67716621-887e-3056-af23-9f054cdefa76",
                        "glosses": [
                            "hohe Geschwindigkeit, viel Schwung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c485a34-58a0-4173-a9d8-a92db0708375",
                                "sense_id": "f7d1421a-ea5a-3fd8-bb36-bb97243c8638",
                                "text": "Er bretterte mit Karacho über die Autobahn."
                            },
                            {
                                "example_id": "91f81503-dd48-4161-a864-cf6f96efd4af",
                                "sense_id": "f7d1421a-ea5a-3fd8-bb36-bb97243c8638",
                                "text": "„Die Schranke öffnete sich sehr langsam, und hinter der Schranke gab es lauter Steinbarrikaden, die verhindern sollten, dass ein Ostberliner in einem schnellen Wagen und mit Karacho hinüber in den Westen raste.“"
                            },
                            {
                                "example_id": "d58fc704-de90-4099-9622-4c3d1bd17c55",
                                "sense_id": "f7d1421a-ea5a-3fd8-bb36-bb97243c8638",
                                "text": "„Mit Karacho aus dem Kreisverkehr geflogen - Sattelschlepper kippte am Pöllinger Kreisel um“"
                            },
                            {
                                "example_id": "102bfc05-52ba-4286-b212-24ab7dd50893",
                                "sense_id": "f7d1421a-ea5a-3fd8-bb36-bb97243c8638",
                                "text": "„Ich würde sie mit Karacho hochgehen lassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cb9ca448-9913-4dae-b45f-99c6a4d0a9bc",
                        "source_entry_id": "67716621-887e-3056-af23-9f054cdefa76",
