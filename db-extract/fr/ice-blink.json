                    {
                        "sense_id": "2f5846bc-113f-3be7-9124-0337afeae229",
                        "entry_id": "fc58a93b-d0b0-349e-9a8c-25054d2d30bc",
                        "glosses": [
                            "Apparence particulière de l'atmosphère, blancheur de l'horizon due à la réverbération des glaces."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4aa62ce4-720d-404c-a564-56c7feb8ea80",
                                "sense_id": "2f5846bc-113f-3be7-9124-0337afeae229",
                                "text": "En approchant d'un champ de neige ou de glace, on aperçoit toujours une bande d'un blanc éblouissant au-dessus de l'horizon : c'est ce qu'on nomme l’ice-blink. Ce phénomène fait connaître d'avance, non-seulement la forme, mais encore la nature de la glace dont on approche."
                            },
                            {
                                "example_id": "382d4228-7859-4371-bafb-58d0d30f2fb4",
                                "sense_id": "2f5846bc-113f-3be7-9124-0337afeae229",
                                "text": "La banquise heureusement semble former un cap au Sud, et aucun ice-blink ne se montre derrière lui jusqu'à un horizon très net."
                            }
                        ]
                    }
                ],
