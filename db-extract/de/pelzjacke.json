                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bda0dc54-c722-4d56-8a8e-0dd090c49ee3",
                                "sense_id": "1b222844-628c-3939-83f1-b2f6dff01314",
                                "text": "„Kardashian wurde mit ihrer Halbschwester Kendall Jenner in New York fotografiert, sie trug ein weißes Ballkleid und eine Pelzjacke und hatte offenbar gerade Szenen bei einer fiktionalen Gala im Metropolitan Museum of Art gedreht.“"
                            },
                            {
                                "example_id": "553ade46-c452-4d9c-94f9-86024f3f70de",
                                "sense_id": "1b222844-628c-3939-83f1-b2f6dff01314",
                                "text": "„Sie trug ihre Pelzjacke, ihre Schneeschuhe und einen kleinen Wollschal um den Kopf – wie die Frauen sich heutzutage in den Strandbädern ein seidenes Taschentuch um die Haare binden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
