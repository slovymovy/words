                "senses": [
                    {
                        "sense_id": "e642fdae-5f0d-370d-8d4d-06a7872fdb0e",
                        "entry_id": "97416534-23fe-3a2c-8363-771b9befe73c",
                        "glosses": [
                            "Steuer, die auf Einnahmen für den Staat (Fiskus) abzielt"
                        ],
                        "tags": [
                            "Steuerwesen"
                        ],
                        "examples": [
                            {
                                "example_id": "5c0df4f1-10fe-4590-8125-8ee5d63b3ef8",
                                "sense_id": "e642fdae-5f0d-370d-8d4d-06a7872fdb0e",
                                "text": "„Offensichtlich entspricht Definition 5 nicht der Zerlegung partieller Wohlfahrtseffekte, die sich aus der jeweils isolierten Betrachtung der Emissions- bzw. Fiskalsteuer ergeben hat.“"
                            },
                            {
                                "example_id": "28923400-fe9b-4db9-96fb-2e7e54965d53",
                                "sense_id": "e642fdae-5f0d-370d-8d4d-06a7872fdb0e",
                                "text": "„Die Kausalabgabe wird dadurch zur Gemengsteuer … Eine solche kennzeichnet sich durch die Verbindung einer Kausalabgabe mit einer Fiskalsteuer in einer einheitlichen Abgabe.“"
                            },
                            {
                                "example_id": "17357f1f-3f19-4e3d-8e8e-c29cedd169bf",
                                "sense_id": "e642fdae-5f0d-370d-8d4d-06a7872fdb0e",
                                "text": "„Die gegenteilige Meinung, nämlich daß die Reichssteuerbefugnis nur Fiskalsteuern umfasse, wäre vermutlich … ebenfalls vertreten worden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
