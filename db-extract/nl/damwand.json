                                    {
                                        "sense_id": "da61bb9e-d038-350b-9fc2-05c78ec09268",
                                        "entry_id": "a14f7429-2f7b-3194-894d-b00aeb8b587e",
                                        "glosses": [
                                            "Any of several structures used to restrain a vertical-faced mass of earth."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4defa44-436e-44c7-be36-54d6e2b5c4c7",
                                                "sense_id": "da61bb9e-d038-350b-9fc2-05c78ec09268",
                                                "text": "Masonry flying arches strutting the retaining walls in Chorley cutting, Manchester-Blackpool line, L.M.S.R."
                                            },
                                            {
                                                "example_id": "78ab0c0e-938d-478c-88eb-feb9bbd57300",
                                                "sense_id": "da61bb9e-d038-350b-9fc2-05c78ec09268",
                                                "text": "The viaduct is joined to the embankment by retaining walls, which have been strengthened since they were constructed by the addition of stay bolts extending right through the embankment and fastened outside each retaining wall."
                                            },
                                            {
                                                "example_id": "8d32ab68-41bc-4923-af86-674c62a4b70c",
                                                "sense_id": "da61bb9e-d038-350b-9fc2-05c78ec09268",
                                                "text": "In order to accommodate the new platform 4 and the reversibly signalled slow line, a deep cutting had to be cut back and held up in places with a concrete retaining wall."
                                            },
                                            {
                                                "example_id": "578ead6c-c07b-42f9-9ef5-1e27d08646f5",
                                                "sense_id": "da61bb9e-d038-350b-9fc2-05c78ec09268",
                                                "text": "Biddle even notes how Brunel, after observing how one retaining wall had part-collapsed during the construction of one of the GWR's Bristol tunnels during heavy rains, \"decided to leave it like that and planted it with ivy to represent a ruined medieval gateway\"."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
