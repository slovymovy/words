                        "examples": [
                            {
                                "example_id": "d6828120-5b72-443c-9636-13d8863a7d9d",
                                "sense_id": "b82cb868-a49f-35b4-b970-2d542629a68e",
                                "text": "A good sherris-sack hath a twofold operation in it. It ascends me into the brain; dries me there all the foolish and dull and curdy vapours which environ it; makes it apprehensive, quick, forgetive, full of nimble fiery."
                            },
                            {
                                "example_id": "eeaf00b2-7c7b-47fd-a2f4-58e6965f2a55",
                                "sense_id": "b82cb868-a49f-35b4-b970-2d542629a68e",
                                "text": "The oil by degrees gets covered with a curdy mass, which after some time settles to the bottom, while itself becomes limpid and colorless."
                            }
                        ]
                    }
