{
    "word_family": [
        "pebbly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "70fcd99e-0054-38dc-be7d-9ea58c53ae51",
                    "sense_definition": "A small stone, especially one rounded by the action of water.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "stone",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children enjoyed throwing <w>pebbles</w> into the calm lake.",
                            "target_lang_translations": {
                                "zh": "孩子们喜欢往平静的湖里扔<w>鹅卵石</w>。"
                            }
                        },
                        {
                            "text": "She walked barefoot along the beach, feeling the smooth <w>pebbles</w> under her feet.",
                            "target_lang_translations": {
                                "zh": "她赤脚走在沙滩上，感受着脚下光滑的<w>鹅卵石</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "smooth pebble",
                        "beach pebble"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种小石头，尤指经水流冲刷而圆滑的石头。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "鹅卵石",
                                "target_lang_sense_clarification": "指经水流冲刷而成的圆滑小石子。"
                            },
                            {
                                "target_lang_word": "砾石",
                                "target_lang_sense_clarification": "指较小的碎石，常用于地质或建筑。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7a424313-41bd-3656-a9f2-621cbfc01c99",
                    "sense_definition": "A geological particle between 4 and 64 mm in diameter.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "stone",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sediment sample contained a high concentration of <w>pebbles</w>.",
                            "target_lang_translations": {
                                "zh": "沉积物样本中含有高浓度的<w>砾石</w>。"
                            }
                        },
                        {
                            "text": "Geologists classify this specific size of rock fragment as a <w>pebble</w>.",
                            "target_lang_translations": {
                                "zh": "地质学家将这种特定尺寸的岩石碎片归类为<w>砾石</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "地质学上指直径在4到64毫米之间的岩石颗粒。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "砾石",
                                "target_lang_sense_clarification": "地质学分类中的砾石。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4ee3a33d-8b1d-3581-be8e-7a152a5bb960",
                    "sense_definition": "A type of slow-burning gunpowder formed into large cubical grains.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "explosive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The historical artillery used <w>pebble</w> powder to achieve a more controlled burn.",
                            "target_lang_translations": {
                                "zh": "历史上的火炮使用<w>颗粒火药</w>以实现更可控的燃烧。"
                            }
                        },
                        {
                            "text": "Engineers analyzed the combustion rate of the <w>pebble</w> in the test chamber.",
                            "target_lang_translations": {
                                "zh": "工程师们在测试室中分析了<w>颗粒火药</w>的燃烧速率。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cube powder",
                        "prismatic powder",
                        "peb"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Refers to historical gunpowder technology."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一种制成大立方体颗粒的慢燃火药。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "颗粒火药",
                                "target_lang_sense_clarification": "历史上的火药技术。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3cbd4094-0e06-3a01-995c-d5d4135013fd",
                    "sense_definition": "A small piece of crack cocaine.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "drug",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police confiscated several <w>pebbles</w> during the raid.",
                            "target_lang_translations": {
                                "zh": "警方在突袭中没收了几<w>块</w>快克可卡因。"
                            }
                        },
                        {
                            "text": "He was arrested for possession of a single <w>pebble</w> of the drug.",
                            "target_lang_translations": {
                                "zh": "他因持有单一<w>块</w>该毒品而被捕。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Used in the context of illegal drug trade."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一小块快克可卡因。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "快克可卡因块",
                                "target_lang_sense_clarification": "毒品俚语。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5572eeef-030d-3e24-a6b9-c7cd7e644fa4",
                    "sense_definition": "A small droplet of water sprayed onto ice to create surface irregularities.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "ice_sport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ice technician carefully applied a <w>pebble</w> to ensure the stone glides correctly.",
                            "target_lang_translations": {
                                "zh": "制冰师小心地在冰面上<w>喷洒水滴</w>，以确保冰壶能正确滑行。"
                            }
                        },
                        {
                            "text": "The quality of the <w>pebble</w> on the ice is crucial for professional curling.",
                            "target_lang_translations": {
                                "zh": "冰面上<w>水滴</w>的质量对于职业冰壶比赛至关重要。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "冰壶运动中喷洒在冰面上形成细小凸起的水滴。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "冰面水滴",
                                "target_lang_sense_clarification": "冰壶运动术语。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4ba78ff6-1032-30d9-a313-67b1da70af05",
                    "sense_definition": "Transparent and colourless rock crystal.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "stone",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The antique spectacles were fitted with lenses made of clear <w>pebble</w>.",
                            "target_lang_translations": {
                                "zh": "这副古董眼镜配有由透明<w>水晶</w>制成的镜片。"
                            }
                        },
                        {
                            "text": "Collectors value the clarity of the natural <w>pebble</w> crystal.",
                            "target_lang_translations": {
                                "zh": "收藏家们非常看重天然<w>水晶</w>的净度。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Refers to historical use of rock crystal."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "透明无色的岩石水晶。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "水晶",
                                "target_lang_sense_clarification": "指天然透明的石英晶体。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b497b52d-b595-34f6-992c-9313bff17850",
                    "sense_definition": "To pave a surface with pebbles.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "paving",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They decided to <w>pebble</w> the garden path for a natural look.",
                            "target_lang_translations": {
                                "zh": "他们决定在花园小径上<w>铺设鹅卵石</w>，以营造自然的外观。"
                            }
                        },
                        {
                            "text": "The workers began to <w>pebble</w> the driveway using smooth river stones.",
                            "target_lang_translations": {
                                "zh": "工人们开始用光滑的河石<w>铺设</w>车道。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "用鹅卵石铺设地面。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "铺设鹅卵石",
                                "target_lang_sense_clarification": "指铺路动作。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "03a0cd85-fd9f-38af-a2c0-f0a3001762a7",
                    "sense_definition": "To deposit water droplets on ice to create a textured surface.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "ice_sport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crew will <w>pebble</w> the ice before the championship match begins.",
                            "target_lang_translations": {
                                "zh": "工作人员将在锦标赛开始前对冰面进行<w>喷洒处理</w>。"
                            }
                        },
                        {
                            "text": "It is essential to <w>pebble</w> the ice evenly to maintain consistent friction.",
                            "target_lang_translations": {
                                "zh": "必须均匀地<w>喷洒</w>冰面，以保持摩擦力的一致性。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "在冰面上喷洒水滴以形成纹理表面。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "喷洒冰面",
                                "target_lang_sense_clarification": "冰壶运动术语。"
                            }
                        ]
                    }
