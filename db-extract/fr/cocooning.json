            {
                "entry_id": "f1a70043-f663-3303-966f-e925a2fc27c3",
                "word": "cocooning",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c1c9e3c6-8a59-4958-9f94-00908d04ed71",
                        "entry_id": "f1a70043-f663-3303-966f-e925a2fc27c3",
                        "tags": [
