        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "02b0ef8b-a3e7-349e-9801-096c20c68262",
                "word": "houndstooth",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "3493eb64-9734-4aee-a1e3-2bad9584ff4a",
                        "entry_id": "02b0ef8b-a3e7-349e-9801-096c20c68262",
                        "tags": [
                            "plural"
                        ],
                        "form": "houndsteeth"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4774eba1-a178-3a81-8193-7f232c455e77",
                        "entry_id": "02b0ef8b-a3e7-349e-9801-096c20c68262",
                        "glosses": [
                            "A two-colour fabric pattern of broken checks."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33deea8e-5ee1-46b6-961f-42b6c443b6ef",
                                "sense_id": "4774eba1-a178-3a81-8193-7f232c455e77",
                                "text": "Other patterns include varied adaptations of paisleys, Tree of Life motifs, tiles, scenics, patchworks, ticking, soft-edge geometries, sports themes, crewel shapes, houndsteeth, and a plethora of florals."
                            },
                            {
                                "example_id": "fc1de4a5-4417-468f-92ea-505bc6156dc2",
                                "sense_id": "4774eba1-a178-3a81-8193-7f232c455e77",
                                "text": "A houndstooth fabric is composed of tiny, interlocking pinwheel motifs. There are many houndstooth knitting patterns[…]; to add an extra touch to these patterns, work them in nubby or textured yarns."
                            },
                            {
                                "example_id": "ca77099b-6859-4c99-80dc-05683151b549",
                                "sense_id": "4774eba1-a178-3a81-8193-7f232c455e77",
                                "text": "Sophisticated houndstooth checks highlight a toddler's jacket and hat."
                            }
                        ]
                    },
                    {
                        "sense_id": "ba8acba8-f511-3a0e-91e6-901aee683e3e",
                        "entry_id": "02b0ef8b-a3e7-349e-9801-096c20c68262",
                        "glosses": [
                            "Fabric with a houndstooth pattern; an item of clothing made with such fabric."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb307c15-8faf-4574-bd43-fc1146d47159",
                                "sense_id": "ba8acba8-f511-3a0e-91e6-901aee683e3e",
                                "text": "Their ties were tidier, their houndsteeth toothier … they ended up looking more Windsorian than Windsor."
                            },
                            {
                                "example_id": "794aada3-be79-4833-9eeb-1b0dc9ef3da8",
                                "sense_id": "ba8acba8-f511-3a0e-91e6-901aee683e3e",
                                "text": "Her dress is wool too, brown and black houndsteeth that belonged to her mother."
                            }
                        ]
                    },
                    {
                        "sense_id": "a14bc1ec-847a-38d1-942a-cbf0fde26c00",
                        "entry_id": "02b0ef8b-a3e7-349e-9801-096c20c68262",
                        "glosses": [
                            "Hound's tongue, a plant of species Cynoglossum officinale"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "65584b2a-464f-4f26-9cfe-28acd38fc477",
                        "source_entry_id": "02b0ef8b-a3e7-349e-9801-096c20c68262",
                        "source_sense_description": "fabric pattern",
                        "target_lang_word": "pied-de-poule",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pied-de-poule",
