                "senses": [
                    {
                        "sense_id": "2f957d57-2839-3160-8d34-465600fb6a5a",
                        "entry_id": "6fc0525a-e4e5-34fe-8925-608098b97dda",
                        "glosses": [
                            "Qui n'est pas ou qui n'a pas été pleuré."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d29dc29-03fc-49a9-af1f-b4a19ba0d28b",
                                "sense_id": "2f957d57-2839-3160-8d34-465600fb6a5a",
                                "text": "Je dis avec le poète : « Vous qui vivez, pensez aux morts », ne laissez le cher défunt ni impleuré, ni oublié ; accordez, comme nous, un souvenir, un long souvenir à sa mémoire honorée."
                            },
                            {
                                "example_id": "6222b0da-ac09-4511-83b3-a8b03fcde99d",
                                "sense_id": "2f957d57-2839-3160-8d34-465600fb6a5a",
                                "text": "— Il savait qu'à se retourner, celle qu'il voulait ramener à la vie se transformerait en statue de sel, donc de larmes, précise Cocteau, fussent-elles des larmes impleurées."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0922e84a-fcde-4250-93a1-6759922aff54",
                        "source_entry_id": "6fc0525a-e4e5-34fe-8925-608098b97dda",
                        "source_sense_id": "2f957d57-2839-3160-8d34-465600fb6a5a",
                        "target_lang_word": "unwept",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unwept",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "799c9890-56c8-399e-a48c-0e525bd75e3a",
                                        "entry_id": "9c742f33-661a-3620-838e-c033bb2ec9ba",
                                        "glosses": [
                                            "Not wept."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e584b6c6-4cc2-4d11-8ef4-32c8938f7fa3",
                                                "sense_id": "799c9890-56c8-399e-a48c-0e525bd75e3a",
                                                "text": "Wish those nights not spent, / Long, unhappy nights, / Which in sighings went / Over lost delights? / Wish those tears unwept, / When you seemed unkind?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2797c5fb-ddf5-351d-94e3-6a5226cfbe6e",
                                        "entry_id": "9c742f33-661a-3620-838e-c033bb2ec9ba",
                                        "glosses": [
                                            "Unmourned."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed467b7f-be0e-4417-8ca0-f571a8f50637",
                                                "sense_id": "2797c5fb-ddf5-351d-94e3-6a5226cfbe6e",
                                                "text": "A pale light, rising in the outer air, fell straight upon the bed; and on it, plundered and bereft, unwatched, unwept, uncared for, was the body of this man."
                                            },
                                            {
                                                "example_id": "b42f49f3-ad73-4054-92e3-2f2fa7957ec7",
                                                "sense_id": "2797c5fb-ddf5-351d-94e3-6a5226cfbe6e",
                                                "text": "It was but a few days after the poor mother had gone to her lonely burying-place; and was laid, unwept and disregarded, in a vault full of strangers."
                                            },
                                            {
                                                "example_id": "59054f2e-72f3-48f8-8573-87872a81a0c3",
                                                "sense_id": "2797c5fb-ddf5-351d-94e3-6a5226cfbe6e",
                                                "text": "Let fall thy tears! Let rise thy strain! / So canst thou never be among / Those heritors of man's disdain, / Th' unwept, unhonored, and unsung."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
