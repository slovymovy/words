                    },
                    {
                        "translation_id": "f96dc945-a967-4335-b8f2-028cca603f74",
                        "source_entry_id": "171ad7d0-b642-3340-9f7e-41334a30c672",
                        "source_sense_id": "d5d6dc4f-7c76-33e8-ad4f-b2e95055d2be",
