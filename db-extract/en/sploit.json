                        "examples": [
                            {
                                "example_id": "bba7251b-c3c2-4da3-adc8-2580f6a05855",
                                "sense_id": "e888065a-914f-37ba-8134-b6c0c7d3d351",
                                "text": "Other exploit creators were less careful, turning out garbage sploits that sometimes wouldn't work at all or would even crash a target service most of the time."
                            },
                            {
                                "example_id": "0b3b7eb6-fa69-457b-966b-7b41cb5fcaf0",
                                "sense_id": "e888065a-914f-37ba-8134-b6c0c7d3d351",
                                "text": "In other words, some script-kiddie blindly launching a “sploit” to a range of addresses does not exactly embody the essence of this category."
                            }
                        ]
