                                "target_senses": [
                                    {
                                        "sense_id": "a4a09734-c558-3a34-9ed2-1c1ea0c9cbda",
                                        "entry_id": "8189e10b-d79c-35f2-bef1-023fa91776b9",
                                        "glosses": [
                                            "meist gewollte Kombination hell durchscheinender oder dunklerer Stellen im Papier, hervorgerufen durch örtliche Papierverdünnung/-verdickung und/oder Papierverdichtung und/oder regionale Transparenzveränderung der Faser"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6429e4bf-6192-4ff6-8f03-ffe248267855",
                                                "sense_id": "a4a09734-c558-3a34-9ed2-1c1ea0c9cbda",
                                                "text": "Geldscheine haben oftmals ein Wasserzeichen."
                                            },
                                            {
                                                "example_id": "b1cf8124-2662-44ae-8e5a-74f4e16b22af",
                                                "sense_id": "a4a09734-c558-3a34-9ed2-1c1ea0c9cbda",
                                                "text": "„Zur Briefmarkenausstellung wurde bereits für die erste Marke 1840 (Großbritannien) Papier mit Wasserzeichen verwendet.“"
                                            },
                                            {
                                                "example_id": "89fd59d3-fcdb-45fa-8f38-b6ed63974683",
                                                "sense_id": "a4a09734-c558-3a34-9ed2-1c1ea0c9cbda",
                                                "text": "„Die Wasserzeichen der verwendeten Papiersorten verweisen auf Padua.“"
                                            },
                                            {
                                                "example_id": "68626dbe-f789-4ad0-852d-9f4337918a9e",
                                                "sense_id": "a4a09734-c558-3a34-9ed2-1c1ea0c9cbda",
                                                "text": "„Er besteht nur aus einer Zeile auf einem Blatt Papier mit Wasserzeichen, das, wie ich weiß, pro Blatt fünf Kronen kostet, und aus einem Bündel fotokopierter Zeitungsausschnitte, das von einer Büroklammer zusammengehalten wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
