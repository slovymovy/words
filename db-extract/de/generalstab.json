                ],
                "senses": [
                    {
                        "sense_id": "a069cd42-809d-3c94-9b60-d26e7477be5a",
                        "entry_id": "e51452de-12bb-3e17-a089-c65c128f0869",
                        "glosses": [
                            "oberstes militärisches Beratungsgremium"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca2fdb92-b27f-404a-b8b6-e663ce1da4b4",
                                "sense_id": "a069cd42-809d-3c94-9b60-d26e7477be5a",
                                "text": "„Währenddessen rangen Generalstab und Reichskanzlei um letzte Entscheidungen.“"
                            },
                            {
                                "example_id": "b54c6010-31d2-42c6-80f1-b1c4315b3ecd",
                                "sense_id": "a069cd42-809d-3c94-9b60-d26e7477be5a",
                                "text": "„Hier saß der Generalstab der Luftwaffe für die Westfront.“"
                            },
                            {
                                "example_id": "0e7f0fb1-8e68-4bb5-beab-c63524a816f6",
                                "sense_id": "a069cd42-809d-3c94-9b60-d26e7477be5a",
                                "text": "„Im November 1944 segnete Stalin den Angriffsplan des sowjetischen Generalstabs ab.“"
                            },
                            {
                                "example_id": "22ec22f6-e31e-4435-819c-2ef7ce6f895c",
                                "sense_id": "a069cd42-809d-3c94-9b60-d26e7477be5a",
                                "text": "„Der Generalstab der 7. Flotte hatte mittlerweile sein Hauptquartier in La Baule bezogen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "28c793f3-2445-48ac-bae7-4404031bfe49",
                        "source_entry_id": "e51452de-12bb-3e17-a089-c65c128f0869",
