                "senses": [
                    {
                        "sense_id": "c349bee1-4d08-3077-8a9d-61f8f1636d47",
                        "entry_id": "1a836276-0132-3139-96fa-b7d8e2729e99",
                        "glosses": [
                            "книжн., поэт. текущий, струящийся тихо (о реке, потоке)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbd2c62f-f1a5-4356-bcbd-e2356dffb53b",
                                "sense_id": "c349bee1-4d08-3077-8a9d-61f8f1636d47",
                                "text": "Отвечает ветер буйный, — // Там за речкой тихоструйной // Есть высокая гора, // В ней глубокая нора;"
                            },
                            {
                                "example_id": "0133b0dc-9cda-4fa1-bfe0-291bf030c9f6",
                                "sense_id": "c349bee1-4d08-3077-8a9d-61f8f1636d47",
                                "text": "Валка — узкая, тихоструйная речонка с отлогими берегами, глухо заросшими высокой травой."
                            }
                        ]
                    }
