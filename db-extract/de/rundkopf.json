                "senses": [
                    {
                        "sense_id": "c7b27a74-abd9-321d-be75-b6c6ca39170c",
                        "entry_id": "8773ff45-1d3d-3a69-9a00-81fa102cff86",
                        "glosses": [
                            "runde Form oder auch rundes Ende von oder an Etwas langem, nennt man Rundkopf"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5e5e7bc2-374b-33d4-b7cb-7588eeebeb34",
                        "entry_id": "8773ff45-1d3d-3a69-9a00-81fa102cff86",
                        "glosses": [
                            "rundlich ausgebildetes Ende an einem länglichen Rohr oder Stab, aus Kunststoff, Glas oder Metall"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d812924b-d126-454a-add3-d3990c8d0bcc",
                                "sense_id": "5e5e7bc2-374b-33d4-b7cb-7588eeebeb34",
                                "text": "Das runde Ende eines Reagenzglases ist ein Rundkopf, welches von einem Glasbläser, an einem Glasrohr geformt wird"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "4f5e0aab-2ef1-380d-ae5e-95f152dff1f9",
                        "entry_id": "8773ff45-1d3d-3a69-9a00-81fa102cff86",
                        "glosses": [
                            "Spottname und abwertende Bezeichnung von Personen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4f3d8dd-04bb-43a3-bba1-60b9affbc7f5",
                                "sense_id": "4f5e0aab-2ef1-380d-ae5e-95f152dff1f9",
                                "text": "Der Spottname für einen Anhänger des Parlaments im englischen Bürgerkrieg 1644–49 (wegen des kurzen Haarschnitts) war Rundkopf"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "4b0b07a6-3c98-3a1d-94a5-5326d6865ff5",
                        "entry_id": "8773ff45-1d3d-3a69-9a00-81fa102cff86",
                        "glosses": [
                            "rundlicher Kopf an einer Schraube mit Schlitz oder Kreuzschlitz; auch Inbussysteme"
                        ],
                        "tags": [
                            "Maschinenbau"
                        ],
                        "examples": [
                            {
                                "example_id": "6bcf15da-8efa-4e6a-8cc6-ac1a12c5c7ea",
                                "sense_id": "4b0b07a6-3c98-3a1d-94a5-5326d6865ff5",
                                "text": "Bezeichnung nach DIN 96 lautet: A2 5.5X50 Holzschraube Rundkopf Schlitz DIN 96-A2 und ist ein Norm-Teil"
                            },
                            {
                                "example_id": "6a154187-2d1c-42ee-8c67-c55584d0f7e3",
                                "sense_id": "4b0b07a6-3c98-3a1d-94a5-5326d6865ff5",
                                "text": "„Rundkopf (Panhead) Schrauben sind mit verschiedenen Antrieben (Pozi oderTorx) erhältlich. Der Rundkopf der Schraube liegt direkt am Werkstück an.“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    },
                    {
                        "sense_id": "d9da9cb4-7254-37a3-a2bc-cfcdb3f5fdc3",
                        "entry_id": "8773ff45-1d3d-3a69-9a00-81fa102cff86",
                        "glosses": [
                            "charakteristische Spezifizierung einer Samenzelle zur Unterscheidung von Anderen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f862e2e-27c4-42c5-b5c9-6bd70b086dc7",
                                "sense_id": "d9da9cb4-7254-37a3-a2bc-cfcdb3f5fdc3",
                                "text": "„Ein großes Problem entsteht, wenn der Spermienkopf nicht über die Enzyme verfügt, die notwendig sind, um die Wand der Eizelle aufzulösen. Diese Spermien weisen runde Köpfe auf und heißen deswegen Rundkopf-Spermien (Globozoospermie)."
                            }
                        ],
                        "sense_index_json": "\"5\""
                    }
