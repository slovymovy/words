                                                "sense_id": "0129accb-5153-3073-9630-a6208bc4ec49",
                                                "text": "„Er mußte diesem verdammten Schafhirten einmal die Leviten lesen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
