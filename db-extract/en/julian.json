                                "target_senses": [
                                    {
                                        "sense_id": "0febdca6-2b4c-3e4d-9ade-b8a31f64e866",
                                        "entry_id": "ea074867-78eb-3702-bba7-e4ed5c015654",
                                        "glosses": [
                                            "Qui est lié à Jules César et à sa décision d’instaurer l’alternance entre trois années de trois cent soixante-cinq jours et une année bissextile de trois cent soixante-six jours."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0d94a0c-9f1c-40d4-a941-101070c59f7e",
                                                "sense_id": "0febdca6-2b4c-3e4d-9ade-b8a31f64e866",
                                                "text": "La fête de la Nativité copte tombe toujours le 29 du mois de kyahk qui correspond maintenant au 7 janvier, mais avant la réforme du calendrier julien par le Pape Grégoire XIII, le 29 kyahk correspondait au 25 décembre."
                                            },
                                            {
                                                "example_id": "29045f8f-9519-435b-9b57-d3f849a6c7a8",
                                                "sense_id": "0febdca6-2b4c-3e4d-9ade-b8a31f64e866",
                                                "text": "Calendrier julien."
                                            },
                                            {
                                                "example_id": "02c06fc5-ae75-4a66-8a2e-4952a94d5f2c",
                                                "sense_id": "0febdca6-2b4c-3e4d-9ade-b8a31f64e866",
                                                "text": "Année julienne."
                                            },
                                            {
                                                "example_id": "90bde412-8b59-409a-add2-969286c1713c",
                                                "sense_id": "0febdca6-2b4c-3e4d-9ade-b8a31f64e866",
                                                "text": "Correction julienne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eb0fe4a3-0b8a-4bb3-b2ae-351c84da3563",
                        "source_entry_id": "f91df852-f29b-3a27-ac26-d6c0d9024644",
                        "source_sense_description": "of or relating to Julius Caesar",
                        "target_lang_word": "julianisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "julianisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a72e71f4-c917-3b0f-8353-5f45a6c4a70c",
                                        "entry_id": "c911b654-ef1a-37ec-895e-0aa515536005",
                                        "glosses": [
                                            "auf den Kalender bezogen, der unter Julius Caesar eingeführt wurde (Vergleiche gregorianisch)"
                                        ],
                                        "tags": [
                                            "oft in festen Wendungen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7a05019-a383-49a3-8e49-600fae0373d7",
                                                "sense_id": "a72e71f4-c917-3b0f-8353-5f45a6c4a70c",
                                                "text": "„Das erste Schaltjahr des julianischen Kalenders ist das Jahr 45 v. Chr., die nächsten folgen alle drei Jahre bis 9 v. Chr.“"
                                            },
                                            {
                                                "example_id": "ff4d4c80-79e0-4b9a-8a39-e7b9addeca59",
                                                "sense_id": "a72e71f4-c917-3b0f-8353-5f45a6c4a70c",
                                                "text": "„Demgegenüber wird der julianische Kalender nach der Sonne berechnet, wobei nicht - wie beim sog. „makedonischen\" Kalender - der Monat die entscheidende Zeiteinheit bildet, sondern vielmehr der Tag bzw. das Jahr.“"
                                            },
                                            {
                                                "example_id": "667cde1c-1988-4d2f-92f4-b5c80761c03f",
                                                "sense_id": "a72e71f4-c917-3b0f-8353-5f45a6c4a70c",
                                                "text": "„Ist das Datum julianisch, so wird das zugehörige gregorianische Datum in runden Klammern beigefügt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ad05aae5-2263-3d79-8929-2d829598590e",
                                        "entry_id": "c911b654-ef1a-37ec-895e-0aa515536005",
                                        "glosses": [
                                            "auf das julianische Datum bezogen – also die Zeitrechnung, die die Tage seit dem 1. Januar 4713 v. Chr. durchgängig zählt"
                                        ],
                                        "tags": [
                                            "oft in festen Wendungen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64691c2d-0780-47d7-af3c-c7e4f681f6f9",
                                                "sense_id": "ad05aae5-2263-3d79-8929-2d829598590e",
                                                "text": "„Da die Zählung in biblischen Zeiträumen beginnt, nimmt das julianische Datum heute bereits recht hohe Werte an.“"
                                            },
                                            {
                                                "example_id": "2678ae0b-0f9c-46ab-b394-6df854c0b362",
                                                "sense_id": "ad05aae5-2263-3d79-8929-2d829598590e",
                                                "text": "„Die julianische Zählweise geht auf Josef Justus Scaliger zurück, geboren in der Nacht vom 4. zum 5. August 1540 in Agen, Frankreich.“"
                                            },
                                            {
                                                "example_id": "0a825e5a-b6a5-4b89-8fd1-5b51b8659065",
                                                "sense_id": "ad05aae5-2263-3d79-8929-2d829598590e",
                                                "text": "„Sollten Sie eine PHP-Version vor 5.3 einsetzen, erhalten sie mithilfe von gregoriantojd() das julianische Datum für eine Gruppe von Datumsbestandteilen.“"
                                            },
                                            {
                                                "example_id": "5f23208e-18aa-455a-b3e9-6919dd2c94bb",
                                                "sense_id": "ad05aae5-2263-3d79-8929-2d829598590e",
                                                "text": "„Die Funktion könnte ein julianisches Datum zurückliefern, also eine laufende dem aktuellen Datum entsprechende Zahl beginnend mit 0 für den 1. Januar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
