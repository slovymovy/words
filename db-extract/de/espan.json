                    {
                        "translation_id": "c0910d63-1b3a-4d3f-a588-520d42832b0e",
                        "source_entry_id": "ad1ed249-46a6-37d8-8dc2-6609023481ca",
                        "source_sense_id": "c4fa2e4c-17f3-381f-9380-db0e4a43d33f",
                        "source_sense_description": "landschaftlich, (alemannisch, schwäbisch, bairisch, mittelfränkisch): von Vieh beweidetes Land",
                        "target_lang_word": "pasture",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pasture",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "da566e72-e3cb-3ee6-8062-7374e3649648",
                                        "entry_id": "516ddbba-c31d-3930-8bab-3c9ba48a5f2a",
                                        "glosses": [
                                            "Land, specifically, an open field, on which livestock is kept for feeding."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d45c91c0-16f2-34bf-9cee-750bdb04c117",
                                        "entry_id": "516ddbba-c31d-3930-8bab-3c9ba48a5f2a",
                                        "glosses": [
                                            "Ground covered with grass or herbage, used or suitable for the grazing of livestock."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce31ecdc-f187-4dda-a6ca-6833159b8184",
                                                "sense_id": "d45c91c0-16f2-34bf-9cee-750bdb04c117",
                                                "text": "He maketh me to lie down in green pastures."
                                            },
                                            {
                                                "example_id": "2804240b-4694-41ab-bc8b-1b9e20409095",
                                                "sense_id": "d45c91c0-16f2-34bf-9cee-750bdb04c117",
                                                "text": "So graze as you find pasture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a656abee-c16f-353f-9015-bb51c36035f9",
                                        "entry_id": "516ddbba-c31d-3930-8bab-3c9ba48a5f2a",
                                        "glosses": [
                                            "Food, nourishment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "820ebeb7-8205-44db-a028-394edba85baa",
                                                "sense_id": "a656abee-c16f-353f-9015-bb51c36035f9",
                                                "text": "Ne euer is he wont on ought to feed, / But toades and frogs, his pasture poysonous […]."
                                            },
                                            {
                                                "example_id": "2907fc8d-b9f2-42d0-80d5-4bab96695d15",
                                                "sense_id": "a656abee-c16f-353f-9015-bb51c36035f9",
                                                "text": "It was reserved for Christians to torture bread, the staff of life, bread for which children in whole districts wail, bread, the gift of pasture to the poor, bread, for want of which thousands of our fellow beings annually perish by famine; it was reserved for Christians to torture the material of bread by fire, to create a chemical and maddening poison, burning up the brain and brutalizing the soul, and producing evils to humanity, in comparison of which, war, pestilence, and famine, cease to be evils."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pasture",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4d219c39-6963-307b-ac84-2ca52fb1157a",
                                        "entry_id": "8b7e77a4-6036-3f4c-9a59-645b6fde08d2",
                                        "glosses": [
                                            "To move animals into a pasture."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c5f63990-354d-3260-a6da-c51b958bccfc",
                                        "entry_id": "8b7e77a4-6036-3f4c-9a59-645b6fde08d2",
                                        "glosses": [
                                            "To graze."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7079fd3e-a054-3bd6-810b-8e607e530b08",
                                        "entry_id": "8b7e77a4-6036-3f4c-9a59-645b6fde08d2",
                                        "glosses": [
                                            "To feed, especially on growing grass; to supply grass as food for."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2329087-b9a4-4e3a-9608-871249f7c212",
                                                "sense_id": "7079fd3e-a054-3bd6-810b-8e607e530b08",
                                                "text": "The farmer pastures fifty oxen."
                                            },
                                            {
                                                "example_id": "7bf52949-0d87-4802-9378-fd1bfa049b35",
                                                "sense_id": "7079fd3e-a054-3bd6-810b-8e607e530b08",
                                                "text": "The land will pasture forty cows."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3411f5c8-eac6-40c3-b66a-f64486d8ea5c",
                        "source_entry_id": "ad1ed249-46a6-37d8-8dc2-6609023481ca",
                        "source_sense_id": "c4fa2e4c-17f3-381f-9380-db0e4a43d33f",
                        "source_sense_description": "landschaftlich, (alemannisch, schwäbisch, bairisch, mittelfränkisch): von Vieh beweidetes Land",
                        "target_lang_word": "pâturage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pâturage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "73b599cb-11b9-3656-ae2e-c8e5ca10d5f3",
                                        "entry_id": "f0f4fb19-bf5e-34eb-b558-6369add039b5",
                                        "glosses": [
                                            "Lieu couvert d’herbe où les bestiaux pâturent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "772b8344-121e-4ec1-8d63-18c0fbf78bc9",
                                                "sense_id": "73b599cb-11b9-3656-ae2e-c8e5ca10d5f3",
                                                "text": "Nous avions laissé au-dessous de nous, dans la montée du bois Magnuen, les hêtres et les sapins : les pâturages seuls poussaient à l’endroit où nous étions parvenus."
                                            },
                                            {
                                                "example_id": "e4f71c6d-7263-4218-aa3f-623fa81e9d4e",
                                                "sense_id": "73b599cb-11b9-3656-ae2e-c8e5ca10d5f3",
                                                "text": "Les pâturages, enclavés dans les bois de tous côtés, sauf au levant, où des haies vives érigeaient leurs épaisses barrières épineuses, restaient d’un vert dru malgré la chaleur torride de cette fin d’été."
                                            },
                                            {
                                                "example_id": "55eab031-4e09-402d-b8eb-5372492d1ff8",
                                                "sense_id": "73b599cb-11b9-3656-ae2e-c8e5ca10d5f3",
                                                "text": "Parmi les facteurs locaux, nous citerons d’abord la dégradation des pâturages causée par les abus de la transhumance, d’immenses troupeaux ayant été amenés des pays du Sud pour y trouver, pendant l’été, leur pâture."
                                            },
                                            {
                                                "example_id": "e89bfbd4-a321-4a69-a9ca-36b6a76dfb25",
                                                "sense_id": "73b599cb-11b9-3656-ae2e-c8e5ca10d5f3",
                                                "text": "Les landes siliceuses connaissent souvent une grande abondance de Fougères : au Pays basque la Fougère-aigle constitue d’importants pâturages qui rougeoient à l’automne."
                                            },
                                            {
                                                "example_id": "a344fbbd-dd39-4479-b0ea-ef3736e217e1",
                                                "sense_id": "73b599cb-11b9-3656-ae2e-c8e5ca10d5f3",
                                                "text": "Un jour ils suivirent la Serre jusqu'à Thiéry-Pré et, avant la ferme, ils laissèrent pâturages et vaches pour plonger par un layon dans la lumière glauque jusqu'au cœur du silence bourdonnant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "002c0547-eaf8-32e5-8fb6-e7c9545ebf83",
                                        "entry_id": "f0f4fb19-bf5e-34eb-b558-6369add039b5",
                                        "glosses": [
                                            "Droit de pâturage, Droit d’usage de ces lieux."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4211ab3-d75f-4c70-bf90-d946e862268f",
                                                "sense_id": "002c0547-eaf8-32e5-8fb6-e7c9545ebf83",
                                                "text": "Avoir droit de pâturage sur une terre. - Jouir du pâturage dans un pré."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c36e1750-1bc8-3986-9026-5dca0df1a418",
                                        "entry_id": "f0f4fb19-bf5e-34eb-b558-6369add039b5",
                                        "glosses": [
                                            "Redevance perçue par le souverain pour accéder à ce droit d'usage."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2fefe963-01ec-3e55-9854-19058b1da370",
                                        "entry_id": "f0f4fb19-bf5e-34eb-b558-6369add039b5",
                                        "glosses": [
                                            "Action de faire pâturer les bestiaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea85ab1c-ab80-4a9b-b7ac-a9356986ce65",
                                                "sense_id": "2fefe963-01ec-3e55-9854-19058b1da370",
                                                "text": "Notons en passant que le pâturage intensif amène une réduction notable et même la disparition de certaines Graminées (Koeleria, Festuca)."
                                            },
                                            {
                                                "example_id": "9c5f315b-997f-4c8e-8d3f-87c0b82696cf",
                                                "sense_id": "2fefe963-01ec-3e55-9854-19058b1da370",
                                                "text": "La forêt est le lieu de pâturage le plus fréquent du bétail, elle abrite en particulier d’innombrables troupeaux de porcs."
                                            },
                                            {
                                                "example_id": "24ef530f-233f-4ff7-8a18-8ac113165f72",
                                                "sense_id": "2fefe963-01ec-3e55-9854-19058b1da370",
                                                "text": "En prairies permanentes, des modes de gestion adaptés (pâturage tournant notamment) peuvent favoriser la présence de légumineuses et leur diversité, indicateur de valeur pastorale et de qualité fourragère."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
