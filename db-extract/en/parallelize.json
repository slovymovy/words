                                "target_senses": [
                                    {
                                        "sense_id": "e3e19a32-fc12-3790-ba6a-ef744ae37376",
                                        "entry_id": "cf69fa72-43a1-36b8-864a-5d7dc1b15330",
                                        "glosses": [
                                            "Mettre en parallèle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76be983e-08ef-4ab3-88cb-85f6345706dc",
                                                "sense_id": "e3e19a32-fc12-3790-ba6a-ef744ae37376",
                                                "text": "Le cardage a pour but de nettoyer les filaments, de les isoler, d'en éliminer les matières étrangères et de paralléliser les fibres pour en former un ruban."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89ee1bf5-1830-3b56-8f83-2e68b6c4ca9e",
                                        "entry_id": "cf69fa72-43a1-36b8-864a-5d7dc1b15330",
                                        "glosses": [
                                            "Multiplier les processus d’une application informatique pour traiter plus de données simultanément."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ae68ca7-6959-479e-b2a9-d84f3caaae5b",
                                                "sense_id": "89ee1bf5-1830-3b56-8f83-2e68b6c4ca9e",
                                                "text": "Je parallélise, tu parallélises, ils parallélisent\nAvant de rentrer plus en détail dans la parallélisation, il est nécessaire tout d’abord de comprendre comment est structuré le serveur PostgreSQL. Le serveur exécute les requêtes qui lui sont envoyées par les clients. Pour ce faire, il démarre des processus (nommés « workers »), 8 par défaut. Ils peuvent déjà exécuter en parallèle des requêtes envoyées par les clients."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3298ec9f-9361-428c-be46-bb532f6b5c77",
                        "source_entry_id": "e1f27442-4f01-3d1c-a489-3a73f1ae8da4",
                        "source_sense_description": "make parallel",
                        "target_lang_word": "parallelisieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "parallelisieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "220092ea-78f3-33a3-838c-45d7e029f1d2",
                                        "entry_id": "6a5f3a4b-0861-3247-a419-72be6244af88",
                                        "glosses": [
                                            "Programmcode so (um-)gestalten, dass dieser parallel auf mehreren CPU's laufen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0ed1d6a-baf4-434d-9ae5-5bd02d673bbc",
                                                "sense_id": "220092ea-78f3-33a3-838c-45d7e029f1d2",
                                                "text": "Leider lassen sich nicht alle Aufgaben gleich gut parallelisieren. Es kommt eben auch vor, dass ein Thread auf einen anderen warten muss."
                                            },
                                            {
                                                "example_id": "d04836f6-6ef7-422d-8334-bb9ce56cfd72",
                                                "sense_id": "220092ea-78f3-33a3-838c-45d7e029f1d2",
                                                "text": "Die ersten beiden Schritte lassen sich prinzipiell vollständig parallelisieren, da bei beiden eine große Anzahl gleicher Operationen auf voneinander unabhängige Daten ausgeführt werden muß."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "20dc73eb-ff4a-3db6-a4e4-8216f523bb6c",
                                        "entry_id": "6a5f3a4b-0861-3247-a419-72be6244af88",
                                        "glosses": [
                                            "Abläufe gestalten, dass diese parallel (und weitgehend) unabhängig voneinander ablaufen können"
                                        ],
                                        "tags": [
                                            "Prozessmanagement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a36fee6e-d2c6-41b4-9c29-200fa5096ca5",
                                                "sense_id": "20dc73eb-ff4a-3db6-a4e4-8216f523bb6c",
                                                "text": "Wo möglich, können Geschäftsprozesse, die sequentiell ablaufen, parallelisiert werden."
                                            },
                                            {
                                                "example_id": "ff7f2694-1ecc-4ab8-9897-e435d79f24d6",
                                                "sense_id": "20dc73eb-ff4a-3db6-a4e4-8216f523bb6c",
                                                "text": "Aktivitäten in einem Geschäftsprozess müssen nicht immer sequentiell ablaufen, sondern können auch parallelisiert werden, um schnellere Durchlaufzeiten zu ermöglichen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
