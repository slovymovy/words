                                    {
                                        "sense_id": "8761770f-9ea4-3556-abee-190853a894f4",
                                        "entry_id": "1cc1aff1-8f50-375c-a973-1650950e5e30",
                                        "glosses": [
                                            "The jack in the game of bowls."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1762df65-396b-4eff-9dfc-46b762cf53bb",
                                                "sense_id": "8761770f-9ea4-3556-abee-190853a894f4",
                                                "text": "Faith, keep a bachelor still, and go to bowls, sir, Follow your mistress there, and prick and save, sir; For other mistresses will make you a slave, sir"
                                            },
                                            {
                                                "example_id": "87491717-9476-4b2c-8a1d-a1df3fd8dcac",
                                                "sense_id": "8761770f-9ea4-3556-abee-190853a894f4",
                                                "text": "She took a bowl, drew up her skirt with her left hand, and rolled the weighted ball with a deft motion. It lightly kissed the mistress and stopped a few inches away."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5057572-3389-3c1f-bf44-c7d6cab75147",
                                        "entry_id": "1cc1aff1-8f50-375c-a973-1650950e5e30",
                                        "glosses": [
                                            "A female companion to a master (a man with control, authority or ownership)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2c77d017-b1b7-37c7-836b-c53fdfc89cec",
                                        "entry_id": "1cc1aff1-8f50-375c-a973-1650950e5e30",
                                        "glosses": [
                                            "Female equivalent of master."
                                        ],
                                        "tags": [
                                            "feminine",
                                            "form-of"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "214693fb-85b8-3923-8928-599de0a2dd41",
                                        "entry_id": "1cc1aff1-8f50-375c-a973-1650950e5e30",
                                        "glosses": [
                                            "Female equivalent of mister."
                                        ],
                                        "tags": [
                                            "feminine",
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "mistress",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b5888db6-ab40-3ca9-a329-3d602174a448",
                                        "entry_id": "936ba680-c000-3d28-9572-9c53967445e6",
                                        "glosses": [
                                            "Of a woman: to master; to learn or develop to a high degree of proficiency."
                                        ],
                                        "tags": [
                                            "rare",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23a1bfba-7e83-49c1-9197-c68949794d06",
                                                "sense_id": "b5888db6-ab40-3ca9-a329-3d602174a448",
                                                "text": "These films give a glimpse of women on the way to mistressing their own destiny."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e42cd19-00f8-3769-9aaa-8af0c8773b9c",
                                        "entry_id": "936ba680-c000-3d28-9572-9c53967445e6",
                                        "glosses": [
                                            "To act or take the role of a mistress."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93c752a3-c659-446a-8874-dfe9e1efea6b",
                                                "sense_id": "4e42cd19-00f8-3769-9aaa-8af0c8773b9c",
                                                "text": "[…] housewifery, maternity, charity, the life conventual, the chatter of a court, the mistressing of a great house […]"
                                            }
                                        ]
                                    }
                                ]
