{
    "word_family": [
        "pursue",
        "pursuit",
        "pursuance"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e228a6eb-b0d3-36d0-961f-5602e315726d",
                    "sense_definition": "In conformance to, or in agreement with; usually followed by the word to.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "conformance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company updated its privacy policy <w>pursuant</w> to the new government regulations.",
                            "target_lang_translations": {
                                "ru": "Компания обновила свою политику конфиденциальности <w>согласно</w> новым правительственным постановлениям."
                            }
                        },
                        {
                            "text": "And <w>pursuant</w> to this idea of a holiday, he insisted upon playing cards after we had eaten.",
                            "target_lang_translations": {
                                "ru": "И <w>в соответствии</w> с этой идеей праздника он настоял на игре в карты после того, как мы поели."
                            }
                        }
                    ],
                    "synonyms": [
                        "according",
                        "consistent",
                        "conformable"
                    ],
                    "antonyms": [
                        "contrary",
                        "inconsistent"
                    ],
                    "common_phrases": [
                        "pursuant to this idea",
                        "pursuant to the law",
                        "pursuant to the agreement"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal or legal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В соответствии с чем-либо или согласно чему-либо; обычно используется с предлогом «to»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "согласно",
                                "target_lang_sense_clarification": "в соответствии с законом или правилом"
                            },
                            {
                                "target_lang_word": "в соответствии с",
                                "target_lang_sense_clarification": "сообразно чему-либо"
                            },
                            {
                                "target_lang_word": "во исполнение",
                                "target_lang_sense_clarification": "в целях выполнения приказа или договора"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "6591b0cb-fb68-3603-a8e4-55bdbbae69d7",
                    "sense_definition": "In a manner that follows as a result; accordingly or consequently.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "consequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The board reached a decision and <w>pursuant</w> issued a public statement regarding the merger.",
                            "target_lang_translations": {
                                "ru": "Правление приняло решение и <w>соответственно</w> опубликовало официальное заявление относительно слияния."
                            }
                        },
                        {
                            "text": "The contract was signed and <w>pursuant</w> the funds were transferred to the account.",
                            "target_lang_translations": {
                                "ru": "Контракт был подписан, и <w>вследствие этого</w> средства были переведены на счет."
                            }
                        }
                    ],
                    "synonyms": [
                        "consequently",
                        "accordingly",
                        "therefore"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal or legal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Таким образом, что это следует как результат; соответственно или вследствие этого."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "соответственно",
                                "target_lang_sense_clarification": "в качестве логического следствия"
                            },
                            {
                                "target_lang_word": "вследствие этого",
                                "target_lang_sense_clarification": "как результат предыдущего действия"
                            },
                            {
                                "target_lang_word": "согласно этому",
                                "target_lang_sense_clarification": "в силу принятого решения"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}