                                "sense_id": "ab848271-7f86-34b0-8405-223002474e03",
                                "text": "Chez les plantes, certains peroxysomes sont capables de convertir les acides gras en glucose."
                            },
                            {
                                "example_id": "1bdf2247-f6b3-4ef1-8e03-a8520b57da69",
                                "sense_id": "ab848271-7f86-34b0-8405-223002474e03",
                                "text": "Le peroxysome est un organite à simple membrane."
                            }
                        ]
