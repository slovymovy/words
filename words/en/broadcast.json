                                "target_lang_word": "передача",
                                "target_lang_sense_clarification": "отдельная программа"
                            },
                            {
                                "target_lang_word": "трансляция",
                                "target_lang_sense_clarification": "процесс показа в эфире"
                            },
                            {
                                "target_lang_word": "вещание",
                                "target_lang_sense_clarification": "работа радио или телевидения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "广播",
                                "target_lang_sense_clarification": "无线电节目"
                            },
                            {
                                "target_lang_word": "转播",
                                "target_lang_sense_clarification": "电视或电台的节目传输"
                            }
                        ]
                    }
