                        "entry_id": "deca5aa1-d1a5-3ed3-b0c1-e00272028811",
                        "glosses": [
                            "Eigenschaft, einen Sachverhalt ohne Umschweife, das heißt, ohne vom Kern der zu vermittelnden Aussage abzurücken, darzustellen, beziehungsweise danach zu handeln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "114dc9b2-2323-4083-ae90-be00804db7aa",
                                "sense_id": "5dc168cc-e795-3c51-bd59-4f71591fc941",
                                "text": "Von ihrer Gradlinigkeit im Denken bin ich tief beeindruckt."
                            },
                            {
                                "example_id": "3c3f7b54-562a-4bbb-9824-f065d7390b6e",
                                "sense_id": "5dc168cc-e795-3c51-bd59-4f71591fc941",
                                "text": "Die Gradlinigkeit des Vorgehens ist exemplarisch für die Handlungsweise der Gruppe."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
