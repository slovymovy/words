                                "example_id": "474a5721-3e93-4043-aacf-1b7d4485af40",
                                "sense_id": "dc86986c-305c-3f8f-a10f-eed284c21680",
                                "text": "La Révolution, si elle est un seul bloc, est à la fois hyper-politique, parce que constituante, et anti-politique parce qu’unanimiste, fraternelle et assermentée."
                            },
                            {
                                "example_id": "1e072589-96f0-43e5-9a43-c696b2447c5d",
                                "sense_id": "dc86986c-305c-3f8f-a10f-eed284c21680",
                                "text": "Nous sommes convaincus que le Siècle n’est pas plus disposé à mourir pour ses idées anti-religieuses que pour ses idées anti-politiques."
                            }
                        ]
                    }
