                "senses": [
                    {
                        "sense_id": "e5f69ce0-a93c-34b3-823a-ab4e7e49a694",
                        "entry_id": "5f6b9c15-14f1-3d08-86b8-8d90b4fdbe76",
                        "glosses": [
                            "Qui peut être débordé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fbf64f3-b35a-4dca-9957-c8f360390847",
                                "sense_id": "e5f69ce0-a93c-34b3-823a-ab4e7e49a694",
                                "text": "Que dans la circonstance présente, l’ennemi n’étant point débordable, que couvrant son objet immédiatement, il n’est pas possible de le tourner de près, ni d’un peu plus loin ; que par conséquent il est inattaquable, quoiqu’inférieur, parce que, dans cette situation, vous ne pourriez prendre sur lui l’avantage du nombre."
                            },
                            {
                                "example_id": "16d304ee-d1bb-4fe3-b274-7f6a4d0772f4",
                                "sense_id": "e5f69ce0-a93c-34b3-823a-ab4e7e49a694",
                                "text": "L’attaque est possible quand l’infanterie est en petit nombre, dans une position médiocre, facilement débordable, avec un terrain découvert en arrière."
                            },
                            {
                                "example_id": "3ce5615a-ddf7-4425-945e-6fda4bc13fd2",
                                "sense_id": "e5f69ce0-a93c-34b3-823a-ab4e7e49a694",
                                "text": "Je m’attendais à ce qu’il frappe encore plus fort, qu’il soit moins débordable, et je me suis tenu trop loin de ma ligne."
                            }
                        ]
                    },
                    {
                        "sense_id": "c480e5c5-2555-3f19-b157-5d8c3ce62ff5",
                        "entry_id": "5f6b9c15-14f1-3d08-86b8-8d90b4fdbe76",
                        "glosses": [
                            "Qui peut déborder, sortir de son lit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2011e53c-c313-41ce-abc6-3fec17503586",
                                "sense_id": "c480e5c5-2555-3f19-b157-5d8c3ce62ff5",
                                "text": "Son cours est débordable et dangereux, son lit embarrassé et souvent barré de rochers, sa navigation difficile."
                            },
                            {
                                "example_id": "34b4885f-2dbc-491a-b6c3-4b7058cec4bf",
                                "sense_id": "c480e5c5-2555-3f19-b157-5d8c3ce62ff5",
                                "text": "Les parameras sont nombreuses, les rivières facilement débordables, les communications mauvaises."
                            },
                            {
                                "example_id": "000859e3-3ed0-4b8c-9abc-48168a377fe2",
                                "sense_id": "c480e5c5-2555-3f19-b157-5d8c3ce62ff5",
                                "text": "Et cette Moselotte, si facilement débordable et indomptable, leur jouait tant de tours !"
                            }
                        ]
                    }
                ],
