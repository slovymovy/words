                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1cc8bde8-1450-3848-8054-56e083e4da5b",
                                        "entry_id": "e75fc0e3-8477-37ff-b8d1-24bed896245f",
