                "senses": [
                    {
                        "sense_id": "65609d72-a407-31b7-8082-2717c3a2e101",
                        "entry_id": "34d981a6-9875-3409-942f-839ecebe95ee",
                        "glosses": [
                            "Not feeling excitement or keen interest; placid; bored."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "907a9ee4-9023-489b-8e3b-d760ae673675",
                                "sense_id": "65609d72-a407-31b7-8082-2717c3a2e101",
                                "text": "Having seen the film twice before, I felt distinctly unexcited at the prospect of a third viewing."
                            }
                        ]
                    },
                    {
                        "sense_id": "8d9a191d-7a15-3677-8734-16b8c0af5224",
                        "entry_id": "34d981a6-9875-3409-942f-839ecebe95ee",
                        "glosses": [
                            "Not in a state of excitation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d80b04d-42f5-4f5f-9550-05304d2e4708",
                                "sense_id": "8d9a191d-7a15-3677-8734-16b8c0af5224",
                                "text": "From some excited bodies there proceeds for a certain distance to others unexcited, a light, which is reflected from the latter to the former, and in the reflexion snaps; and which upon touching the skin of a man or beast is felt with a smarting: This snapping light is call'd the electrical Sparks."
                            }
                        ]
                    }
                ],
