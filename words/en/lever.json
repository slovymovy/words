{
    "word_family": [
        "leverage"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b2ce723c-67e5-3c66-bd5c-a94cdfdd1c00",
                    "sense_definition": "A handle or bar used to operate a mechanism or control a device.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He pulled the emergency <w>lever</w> to stop the train. controls",
                            "target_lang_translations": {
                                "ru": "Он потянул за аварийный <w>рычаг</w>, чтобы остановить поезд."
                            }
                        },
                        {
                            "text": "You need to pull the emergency <w>lever</w> immediately to halt the entire system.Stop the process by pulling the emergency <w>lever</w>.",
                            "target_lang_translations": {
                                "ru": "Вам нужно немедленно потянуть за аварийный <w>рычаг</w>, чтобы остановить всю систему."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pull the lever",
                        "gear lever"
                    ],
                    "target_lang_definitions": {
                        "ru": "Рукоятка или рычаг для управления механизмом или устройством."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рычаг",
                                "target_lang_sense_clarification": "элемент управления механизма"
                            },
                            {
                                "target_lang_word": "рукоятка",
                                "target_lang_sense_clarification": "деталь для захвата рукой и управления"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8caa381c-0661-3725-8bdf-3505cd70905e",
                    "sense_definition": "A simple machine consisting of a rigid bar pivoted at a fixed point (fulcrum) used to apply force.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A crowbar acts as a simple <w>lever</w> to lift heavy stones. Use a <w>lever</w> to raise the box.",
                            "target_lang_translations": {
                                "ru": "Лом работает как простой <w>рычаг</w> для подъема тяжелых камней."
                            }
                        },
                        {
                            "text": "They used a long wooden <w>lever</w> to move the heavy rock out of the way.",
                            "target_lang_translations": {
                                "ru": "Они использовали длинный деревянный <w>рычаг</w>, чтобы убрать тяжелый камень с дороги."
                            }
                        }
                    ],
                    "common_phrases": [
                        "use a lever"
                    ],
                    "target_lang_definitions": {
                        "ru": "Простой механизм в виде стержня, вращающегося вокруг точки опоры, используемый для приложения силы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рычаг",
                                "target_lang_sense_clarification": "простейший механизм в физике"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "890ce97d-24ec-34c8-bc1f-cb8f54301c9a",
                    "sense_definition": "To lift, move, or force something open using a lever.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He managed to <w>lever</w> open the wooden crate with a heavy metal bar. We will <w>lever</w> open the door.",
                            "target_lang_translations": {
                                "ru": "Ему удалось <w>вскрыть</w> деревянный ящик с помощью тяжелого металлического лома."
                            }
                        },
                        {
                            "text": "The workers had to <w>lever</w> the massive stone out of the garden path.",
                            "target_lang_translations": {
                                "ru": "Рабочим пришлось <w>сдвинуть рычагом</w> огромный камень с садовой дорожки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "lever open"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приподнимать, передвигать или поддевать что-либо с помощью рычага."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поднимать рычагом",
                                "target_lang_sense_clarification": "применять рычаг для подъема"
                            },
                            {
                                "target_lang_word": "приподнимать",
                                "target_lang_sense_clarification": "с усилием поддевать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b621c96-6ff4-35bd-a248-3e226b24018b",
                    "sense_definition": "To raise or shift one's body or an object with effort, as if using a lever.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tried to <w>lever</w> himself up from the deep armchair. Carefully <w>lever</w> yourself up.",
                            "target_lang_translations": {
                                "ru": "Он попытался <w>приподняться</w> из глубокого кресла."
                            }
                        },
                        {
                            "text": "She managed to <w>lever</w> herself out of bed despite her injured knee.",
                            "target_lang_translations": {
                                "ru": "Ей удалось <w>подняться</w> с кровати, несмотря на травмированное колено."
                            }
                        }
                    ],
                    "common_phrases": [
                        "lever oneself up"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приподнимать или перемещать свое тело или предмет с усилием, используя упор."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подниматься",
                                "target_lang_sense_clarification": "с трудом вставать или опираться"
                            },
                            {
                                "target_lang_word": "с трудом поднимать",
                                "target_lang_sense_clarification": "перемещать тело с усилием"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bfdfa5ef-897f-33f1-974e-bb1af8ca845d",
                    "sense_definition": "To use something to gain an advantage or achieve a specific outcome; to exert influence.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company tried to <w>lever</w> its market position to gain better contracts. They will <w>lever</w> their advantage.",
                            "target_lang_translations": {
                                "ru": "Компания попыталась <w>использовать</w> свое положение на рынке для получения более выгодных контрактов."
                            }
                        },
                        {
                            "text": "Politicians often seek to <w>lever</w> public opinion to pass new legislation.",
                            "target_lang_translations": {
                                "ru": "Политики часто стараются <w>использовать</w> общественное мнение для проведения новых законов."
                            }
                        }
                    ],
                    "common_phrases": [
                        "lever advantage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Использовать что-либо для получения преимущества или достижения результата; оказывать влияние."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "использовать как рычаг",
                                "target_lang_sense_clarification": "применять для оказания давления или влияния"
                            },
                            {
                                "target_lang_word": "использовать в своих интересах",
                                "target_lang_sense_clarification": "извлекать выгоду из положения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1cb0e781-c02f-3cea-a0b8-98293723da27",
                    "sense_definition": "To increase the proportion of debt used to finance a business or investment.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The firm decided to <w>lever</w> up its balance sheet to finance the recent acquisition. They want to <w>lever</w> up.",
                            "target_lang_translations": {
                                "ru": "Фирма решила <w>привлечь заемный капитал</w> для финансирования недавнего приобретения."
                            }
                        },
                        {
                            "text": "Investors warned that attempting to <w>lever</w> the company too much could increase financial risk.",
                            "target_lang_translations": {
                                "ru": "Инвесторы предупредили, что попытка слишком сильно <w>увеличить долговую нагрузку</w> компании может повысить финансовые риски."
                            }
                        }
                    ],
                    "common_phrases": [
                        "lever up"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "business/finance context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Увеличивать доля заемного капитала для финансирования бизнеса или инвестиций."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "использовать заемный капитал",
                                "target_lang_sense_clarification": "финансовый леверидж"
                            },
                            {
                                "target_lang_word": "повышать финансовый леверидж",
                                "target_lang_sense_clarification": "увеличивать уровень долга"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "b0fbaf0f-f2db-3104-a3f3-8bf90eee125e",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Lever</w> attended the annual conference yesterday afternoon.",
                            "target_lang_translations": {
                                "ru": "Господин <w>Левер</w> присутствовал на ежегодной конференции вчера днем."
                            }
                        },
                        {
                            "text": "We met with Dr. <w>Lever</w> to discuss the proposed changes to the project.",
                            "target_lang_translations": {
                                "ru": "Мы встретились с доктором <w>Левером</w>, чтобы обсудить предлагаемые изменения в проекте."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Левер",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "a8c77ab5-241d-3f8f-8275-4bfe8aeb5e11",
                    "sense_definition": "Rather; preferably.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I had <w>lever</w> die than betray my country to the enemy.",
                            "target_lang_translations": {
                                "ru": "Я <w>скорее</w> умру, чем предам свою страну врагу."
                            }
                        },
                        {
                            "text": "She had <w>lever</w> stay at home than attend such an uncomfortable event.",
                            "target_lang_translations": {
                                "ru": "Она <w>предпочла бы</w> остаться дома, чем идти на такое некомфортное мероприятие."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Охотнее; предпочтительнее (устаревшее)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скорее",
                                "target_lang_sense_clarification": "предпочтительнее (уст.)"
                            },
                            {
                                "target_lang_word": "охотнее",
                                "target_lang_sense_clarification": "с большим желанием (уст.)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}