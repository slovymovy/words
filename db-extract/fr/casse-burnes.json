                            {
                                "example_id": "769a0c4d-4cc0-47f0-9f8b-a0435b06a5e5",
                                "sense_id": "23b622b3-e348-34bc-a360-36ee1a7229b8",
                                "text": "Je ne survivrai pas au cours de maths tellement c'est casse-burnes. Sinon il ne se passe que de la merde et mon Tchernobyl me fait mal à la gorge et mes règles au ventre."
                            },
                            {
                                "example_id": "74710cfa-64fb-47ee-ac1c-54efd041bac4",
                                "sense_id": "23b622b3-e348-34bc-a360-36ee1a7229b8",
                                "text": "Il faut savoir trouver un équilibre, et si ma femme sent que je la comprends pas, elle peut pas me faire confiance. Et si ma femme me fait pas confiance elle devient casse-burnes, et si elle devient casse-burnes, je m'éloigne, et si je m'éloigne trop, je finis par aller baiser ailleurs."
                            }
                        ]
                    }
