                "senses": [
                    {
                        "sense_id": "cfb4e829-4b58-3d00-8b8d-36d104280120",
                        "entry_id": "56304dd6-bb36-31ad-b60b-18179f29294c",
                        "glosses": [
                            "Theke, an der nur Sekt ausgeschenkt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7550c21e-3a91-4592-beba-d686ab08959e",
                                "sense_id": "cfb4e829-4b58-3d00-8b8d-36d104280120",
                                "text": "„Es wird WLAN für die Berichterstatter geben, ein Catering mit Tagesessen, VIP-Stand, Bier- wie Sekttheke soll den \"Event-Charakter\" unterstreichen.“"
                            },
                            {
                                "example_id": "61b6e8a7-1c0c-437b-b4b6-7fac802219e7",
                                "sense_id": "cfb4e829-4b58-3d00-8b8d-36d104280120",
                                "text": "„Heimlich still und leise haben die Bürger dort Sekttheke, Bistrotische und Bänke aufgebaut.“"
                            },
                            {
                                "example_id": "99b11732-cbd4-4c50-bb92-083d303fa020",
                                "sense_id": "cfb4e829-4b58-3d00-8b8d-36d104280120",
                                "text": "„Außerdem ist auch die \"Wein- und Sekttheke\" des Chores wieder vor dem Schuhhaus Link geöffnet.“"
                            },
                            {
                                "example_id": "9a710a1c-22a9-4a84-95e5-ce67be8617c3",
                                "sense_id": "cfb4e829-4b58-3d00-8b8d-36d104280120",
                                "text": "„Ebenso Richard und Marianne Knoth, die mit ihrer Sekttheke seit 25 Jahren dabei sind, sowie Aloys und Carmen Eckes, die seit 20 Jahren mit ihrem \"Sektzelt auf dem Gräfenbach\", zur festen Einrichtung des Volksfestes zählen. …“"
                            },
                            {
                                "example_id": "d00f2377-626c-4b20-b489-8fdb6880fcaf",
                                "sense_id": "cfb4e829-4b58-3d00-8b8d-36d104280120",
                                "text": "„Neu ist die Wein- und Sekttheke und ein kleiner bayerischer Biergarten im Zelt, in dem gezapftes Weißbier angeboten wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
