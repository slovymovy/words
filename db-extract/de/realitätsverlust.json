                "senses": [
                    {
                        "sense_id": "8c4859f1-2c1b-39fc-b063-25c06d7e34cc",
                        "entry_id": "d755548c-c7b6-319b-af73-b9334e18ef8e",
                        "glosses": [
                            "geistige Unfähigkeit eines Menschen, das eigene Handeln mit der Objektivität der realen Welt und der Denkweise seines Umfeldes in Einklang zu bringen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64ff5f06-2952-4d50-9334-d521cbff58f6",
                                "sense_id": "8c4859f1-2c1b-39fc-b063-25c06d7e34cc",
                                "text": "Auslöser für Realitätsverlust können traumatisierende Erlebnisse, Schock, Drogen- und Alkoholmissbrauch, aber auch der Beginn schwerer psychischer Erkrankungen, wie Schizophrenie sein."
                            },
                            {
                                "example_id": "5cf97759-061b-4198-94a5-653f0eb74b2d",
                                "sense_id": "8c4859f1-2c1b-39fc-b063-25c06d7e34cc",
                                "text": "„Die Schizophrenie ist eine schwere psychische Erkrankung, die mit einem tiefgreifenden Realitätsverlust einhergeht.“"
                            },
                            {
                                "example_id": "65096bd1-bdc2-44cc-954b-6c92af315b40",
                                "sense_id": "8c4859f1-2c1b-39fc-b063-25c06d7e34cc",
                                "text": "„Der deutsche Realitätsverlust fand seinen Niederschlag in dem Streit um die »Kriegsziele«, der, zunächst unter der Decke, später öffentlich, die deutsche Innenpolitik während der ganzen Kriegsdauer beherrschte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
