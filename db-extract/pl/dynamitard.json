                                    },
                                    {
                                        "sense_id": "a42af055-570d-3f0c-8fb0-9acbb78b7846",
                                        "entry_id": "7b290d53-cff4-321d-866d-6a84d74dd653",
                                        "glosses": [
                                            "A high-pressure salesman."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06b746be-6d01-4f52-b0ad-84872146a6f8",
                                                "sense_id": "a42af055-570d-3f0c-8fb0-9acbb78b7846",
                                                "text": "Would you say it was fair to describe these salesmen that were in your crews as dynamiters, or suede shoe salesmen?"
                                            }
