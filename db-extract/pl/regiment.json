                    },
                    {
                        "sense_id": "86af396b-8911-3651-a346-064dc5a68a1f",
                        "entry_id": "7dd7893d-b7c1-34d5-ac54-ad024cd1c0d7",
                        "glosses": [
                            "odpowiednik polskiego pułku w strukturze sił zbrojnych niektórych krajów"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "73f73b42-9ace-3b14-89aa-b28fe9bf2177",
                        "entry_id": "7dd7893d-b7c1-34d5-ac54-ad024cd1c0d7",
                        "glosses": [
                            "krótka laska będąca w armiach europejskich XIV-XVIII wieku oznaką naczelnego dowódcy; odpowiednik polskiej buławy"
                        ],
                        "tags": [],
