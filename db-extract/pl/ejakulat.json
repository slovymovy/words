                    },
                    {
                        "translation_id": "38b99aa6-372f-47e1-bdc5-f0c8e5ea42ac",
                        "source_entry_id": "f0490d80-ca3e-3133-84af-895af1be3600",
                        "source_sense_id": "8a9d4b41-8948-301e-a3b0-908d7eb57df1",
                        "target_lang_word": "ejakulát",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ejakulát",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "d3a4c349-2704-3c8b-9279-edd1d3beed09",
                                        "entry_id": "d632432f-831d-37ce-93ae-9ee763276843",
                                        "glosses": [
                                            "výměšek pohlavních žláz samce skládající se ze spermií a semenné plazmy"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "891c55e6-67b6-405f-9b94-d3ef34a0a0b7",
                                                "sense_id": "d3a4c349-2704-3c8b-9279-edd1d3beed09",
                                                "text": "Pokud chce muž darovat sperma, stačí, aby v jeho ejakulátu bylo třicet procent životaschopných spermií."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f645e9f6-a7bb-359f-9dcb-2438acd56a67",
                                        "entry_id": "d632432f-831d-37ce-93ae-9ee763276843",
                                        "glosses": [
                                            "výměšek Skeneho žlázy ženy"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "772be6ba-a26b-4d46-95c8-f61ebd51b8e4",
                                                "sense_id": "f645e9f6-a7bb-359f-9dcb-2438acd56a67",
                                                "text": "Stejně jako u mužů, i ženský ejakulát obsahuje fruktózu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "280be304-e59e-41b8-ba13-eb08c1ce2a73",
                        "source_entry_id": "f0490d80-ca3e-3133-84af-895af1be3600",
                        "source_sense_id": "8a9d4b41-8948-301e-a3b0-908d7eb57df1",
                        "target_lang_word": "éjaculat",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "éjaculat",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "33939c37-36d5-3617-b012-df1f66980b61",
                                        "entry_id": "999cf617-982e-32ea-9879-76a368af68bd",
                                        "glosses": [
                                            "Fluide qui est éjaculé lors de l'orgasme masculin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0394eba4-1d2f-4042-a9ac-72ec4c342170",
                                                "sense_id": "33939c37-36d5-3617-b012-df1f66980b61",
                                                "text": "C’est d’ailleurs la raison pour laquelle il est tout à fait possible de micro-injecter un spermatozoïde provenant aussi bien du testicule où il aura été prélevé chirurgicalement que de l’éjaculat."
                                            },
                                            {
                                                "example_id": "6a1346bf-356f-4a0b-823f-b875d22489cb",
                                                "sense_id": "33939c37-36d5-3617-b012-df1f66980b61",
                                                "text": "Comme actionné par une pompe, il suivait le rythme des pulsions cardiaques, proche, en cela, de l'éjaculat assujetti aux secousses péniennes."
                                            },
                                            {
                                                "example_id": "66205f3c-d888-4b85-ad83-bab503595c04",
                                                "sense_id": "33939c37-36d5-3617-b012-df1f66980b61",
                                                "text": "Chez certains passereaux comme le mérion superbe australien, le mâle pèse 11 g mais produit un éjaculat contenant 8 milliards de spermatozoïde dans des testicules pesant 3,4 % de sa masse corporelle, ce qui est à comparer à la production de 100 millions de spermatozoïde par éjaculat et à des testicules de 0,08 % de la masse corporelle chez l'humain."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c2dabd53-ae3c-4d1b-a30d-6e9da2862872",
                        "source_entry_id": "f0490d80-ca3e-3133-84af-895af1be3600",
