                                "target_lang_word": "отнимать",
                                "target_lang_sense_clarification": "разговорное о вычитании"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "减去",
                                "target_lang_sense_clarification": "数学动作"
                            }
                        ]
                    }
                }
