                "senses": [
                    {
                        "sense_id": "42c08e77-7591-38a4-8d2e-462cf1cf5dc8",
                        "entry_id": "e7b15a7f-45fa-373a-bccb-d2fda9f966fe",
                        "glosses": [
                            "hummock, tussock, mound, hillock"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c247c10-9026-4810-8e66-ff5188d948e1",
                                "sense_id": "42c08e77-7591-38a4-8d2e-462cf1cf5dc8",
                                "text": "Мне приходи́лось перепры́гивать с ко́чки на ко́чку; в покрыва́вшем их густо́м бу́ром мху но́ги тону́ли, то́чно в мя́гком ковре́.",
                                "translation": "I had to jump from hillock to hillock; my feet sank in the thick brown moss which covered them as it were with a soft carpet.",
                                "english": "I had to jump from hillock to hillock; my feet sank in the thick brown moss which covered them as it were with a soft carpet."
                            }
                        ]
                    }
                ],
