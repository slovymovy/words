                "senses": [
                    {
                        "sense_id": "fb648c25-7049-3114-8453-27d111e03e47",
                        "entry_id": "fbd688f8-e5fe-306e-9e34-803b4f9236cc",
                        "glosses": [
                            "Betrieb, der Abfälle verwertet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f666ebb6-fa2f-4386-aaf0-3830dabb0b1a",
                                "sense_id": "fb648c25-7049-3114-8453-27d111e03e47",
                                "text": "„Wegen eines größeren Brandes mit starker Rauchentwicklung in einem Abfallbetrieb sind Anwohner im emsländischen Werlte zeitweise aufgerufen worden, Fenster und Türen geschlossen zu halten.“"
                            },
                            {
                                "example_id": "559d431a-ddc3-4177-aa01-a0f79baffe8a",
                                "sense_id": "fb648c25-7049-3114-8453-27d111e03e47",
                                "text": "„Und nachdem Pappe und Papier jahrzehntelang ihr Dasein als ungewollter Abfall fristeten, will nun jeder Altpapier zum Nulltarif, denn damit erwirtschaften die Abfallbetriebe neben Altmetall den meisten Gewinn.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
