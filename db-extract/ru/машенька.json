                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d09be5f-4c86-48b3-a0d4-38261c35f371",
                                "sense_id": "7f46f8d0-5dd7-31f0-876c-f509ab1af6ed",
                                "text": "Скромная Машенька потупила глаза в землю и сделалась немою."
                            },
                            {
                                "example_id": "f57e44c0-4717-4af9-bd02-8dcbba2c5e55",
                                "sense_id": "7f46f8d0-5dd7-31f0-876c-f509ab1af6ed",
                                "text": "У Машеньки безошибочный вкус, ей и не надо много читать, она всегда чувствует книгу."
                            }
                        ]
                    }
