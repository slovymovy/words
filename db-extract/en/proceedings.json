                            {
                                "target_word": "afloop",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "3a92a17e-5fd9-32f0-bc08-1e1fca19e3d6",
                                        "entry_id": "d7af0fc7-be65-3db7-82d4-90590786c9b0",
                                        "glosses": [
                                            "eerste persoon enkelvoud tegenwoordige tijd van aflopen"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "with-subordinate-clause"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90fb8208-a27b-4982-a5e8-184f611d2985",
                                                "sense_id": "3a92a17e-5fd9-32f0-bc08-1e1fca19e3d6",
                                                "text": "... dat ik afloop."
                                            },
                                            {
                                                "example_id": "cf560169-2497-437b-b48a-b1617e531f37",
                                                "sense_id": "3a92a17e-5fd9-32f0-bc08-1e1fca19e3d6",
                                                "text": "Naast hem staat een vrouw die in de korte tijd waarin ik op haar afloop al drie keer op haar horloge heeft gekeken."
                                            }
