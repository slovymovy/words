                "senses": [
                    {
                        "sense_id": "a5f4bec0-83c6-3ee5-ac11-a63d6afb9d1d",
                        "entry_id": "14525efa-94a8-3b50-b51a-8c93f67ced8e",
                        "glosses": [
                            "ein Hinweis, der schriftlich, optisch oder akustisch vor etwas warnt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccc98066-6337-4425-918f-5ded34d64c92",
                                "sense_id": "a5f4bec0-83c6-3ee5-ac11-a63d6afb9d1d",
                                "text": "Der Bruchpilot musste die Maschine am 12. Juli 2000 notlanden, weil der Treibstoff ausgegangen war. Der Flugkapitän soll optische und akustische Warnhinweise missachtet haben."
                            },
                            {
                                "example_id": "2336f2eb-148a-4bb9-8255-6638ff3db4bc",
                                "sense_id": "a5f4bec0-83c6-3ee5-ac11-a63d6afb9d1d",
                                "text": "Am Bildrand sollen die Worte »Unterstützt durch Produktplatzierung« eingeblendet werden. Wird dieser Warnhinweis bald ständig über den Bildschirm flimmern?"
                            },
                            {
                                "example_id": "70356d90-e609-4e62-9e1c-945b37553adc",
                                "sense_id": "a5f4bec0-83c6-3ee5-ac11-a63d6afb9d1d",
                                "text": "Das Verbraucherschutzministerium möchte Bubble Tea einem Zeitungsbericht zufolge mit einem Warnhinweis versehen. Beim Verkauf des Modegetränks seien «Hinweise zur Verschluckungsgefahr bei Kindern erforderlich»."
                            },
                            {
                                "example_id": "7906f39f-88cd-4b1c-a762-6dcbb4c9623e",
                                "sense_id": "a5f4bec0-83c6-3ee5-ac11-a63d6afb9d1d",
                                "text": "Aus Angst vor Schadensersatzklagen in Milliardenhöhe werden die Warnhinweise für Produkte immer absurder."
                            },
                            {
                                "example_id": "03ae44bb-b186-4b99-b0cb-8910ce06fd9b",
                                "sense_id": "a5f4bec0-83c6-3ee5-ac11-a63d6afb9d1d",
                                "text": "Weil über Facebook angekündigte Feiern in jüngster Zeit häufiger in Großveranstaltungen ausarteten, reagiert das soziale Netzwerk jetzt mit Warnhinweisen: Minderjährige sollen so an folgenschweren Party-Einladungen gehindert werden."
                            },
                            {
                                "example_id": "64a96297-2b13-4e6e-b54a-778866d08a51",
                                "sense_id": "a5f4bec0-83c6-3ee5-ac11-a63d6afb9d1d",
                                "text": "Im Kampf gegen die Magersucht von jungen Frauen und Mädchen will eine französische Abgeordnete nachbearbeitete Werbefotos in Hochglanzmagazinen mit einem Warnhinweis versehen lassen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
