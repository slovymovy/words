                    },
                    {
                        "translation_id": "7d2e8789-823f-48d1-97f4-8b3f9c9053bb",
                        "source_entry_id": "a3c3f8c9-d1a4-34b3-a122-992e45e400b7",
                        "source_sense_id": "5b9e0b7a-5ea8-375e-86fd-f36721e879d1",
                        "source_sense_description": "Arzneistoff aus der Gruppe der Benzodiazepine mit mittlerer Wirkungsdauer, der zur kurzzeitigen Behandlung von Angst- und Panikstörungen eingesetzt wird",
                        "target_lang_word": "Xanax",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Xanax",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "53245a96-b9bb-3e8f-8ce1-a4b3d4f807b1",
                                        "entry_id": "43838827-4da7-30bb-ae12-b5dd650af02b",
                                        "glosses": [
                                            "A brand name for alprazolam."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d389bf5b-9ad6-4d35-a74e-7e1ab9514965",
                                                "sense_id": "53245a96-b9bb-3e8f-8ce1-a4b3d4f807b1",
                                                "text": "A half-dozen black beauties gave him the edge he needed, a couple of purple egg-shaped Xanaxes cooled his nerves."
                                            },
                                            {
                                                "example_id": "3e8e57d3-1ef7-46e2-baff-ab769b53ff38",
                                                "sense_id": "53245a96-b9bb-3e8f-8ce1-a4b3d4f807b1",
                                                "text": "“After taking one or two Xanax every night for eight years, my doctor told me I had to stop,” says a middle-aged Montgomery County homemaker."
                                            },
                                            {
                                                "example_id": "82310dc6-d5bb-4ca7-a57c-11d1347e7ae0",
                                                "sense_id": "53245a96-b9bb-3e8f-8ce1-a4b3d4f807b1",
                                                "text": "My rage is controlled, barely, by a Xanax and an Absolut on the rocks."
                                            },
                                            {
                                                "example_id": "b1618c59-fe3f-4662-a874-5e28e67ec1d9",
                                                "sense_id": "53245a96-b9bb-3e8f-8ce1-a4b3d4f807b1",
                                                "text": "Also in Mr. Ledger’s system were three anti-anxiety medications: diazepam, the generic name for Valium; alprazolam, commonly known as Xanax; and temazepam[…]."
                                            },
                                            {
                                                "example_id": "2eba311a-1a89-4973-97cb-ebe817f503cd",
                                                "sense_id": "53245a96-b9bb-3e8f-8ce1-a4b3d4f807b1",
                                                "text": "“Medication can be part of a psychotropic arsenal,” he said, discussing one therapist who urged him to stop taking Xanax so he could address his anxiety directly and not mask the physical symptoms."
                                            },
                                            {
                                                "example_id": "331e5c71-8165-4202-a1e6-7b21f60534a0",
                                                "sense_id": "53245a96-b9bb-3e8f-8ce1-a4b3d4f807b1",
                                                "text": "Take a deep, healing breath, and imagine that you're not even on Twitter, or Facebook, or Xanax."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
