                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9579ee0-65f7-4f79-8d1f-175704331763",
                                "sense_id": "d6b1124d-37b0-3478-b46a-4b515f99e65a",
                                "text": "Prèler. C'est frotter avec la prèle les blancs de dorure pour les rendre bien lisses avant"
                            },
                            {
                                "example_id": "29b9743e-a79d-45ca-b180-b257e6199c26",
                                "sense_id": "d6b1124d-37b0-3478-b46a-4b515f99e65a",
                                "text": "PRELER, en termes de doreur sur bois, se dit de l'action de frotter à la prêle des parties blanchies & qu'on doit brunir, pour les rendre encore plus douces."
                            }
                        ]
