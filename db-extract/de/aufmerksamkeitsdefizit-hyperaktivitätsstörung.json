                "senses": [
                    {
                        "sense_id": "7d4aa150-9aac-33d5-8694-79d590569494",
                        "entry_id": "8496fee7-a78e-3299-83da-716d73c77266",
                        "glosses": [
                            "bereits im Kindesalter beginnende psychische Störung bei Aufmerksamkeit und Impulsivität, die sich durch ausgeprägte körperliche Unruhe (Hyperaktivität) äußert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02421947-07e5-4dae-914c-896b3e13def2",
                                "sense_id": "7d4aa150-9aac-33d5-8694-79d590569494",
                                "text": "Marta leidet stark an der Aufmerksamkeitsdefizit-Hyperaktivitätsstörung."
                            },
                            {
                                "example_id": "5a0dcd2b-320a-4bae-8435-ca8944ca8a34",
                                "sense_id": "7d4aa150-9aac-33d5-8694-79d590569494",
                                "text": "„So könnte ADHS (Aufmerksamkeitsdefizit-Hyperaktivitätsstörung) eventuell aus ganz praktischer Sicht erklärt werden.“"
                            },
                            {
                                "example_id": "c4cdb31b-d0e6-4dad-a3e8-2ae6c3a3cc7d",
                                "sense_id": "7d4aa150-9aac-33d5-8694-79d590569494",
                                "text": "„Unter dem Namen Aufmerksamkeitsdefizit-Hyperaktivitätsstörung gab es nun für alle ADHS-Fälle ein einheitliches Diagnoseschema.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
