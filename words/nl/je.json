                {
                    "sense_id": "e0c736a5-722f-37c2-add8-9603c49d412a",
                    "sense_definition": "De onbenadrukte vorm van het persoonlijk voornaamwoord <w>jij</w> (tweede persoon enkelvoud, onderwerp).",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "subject_sg",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ga <w>je</w> vanavond mee naar de bioscoop?",
                            "target_lang_translations": {
                                "en": "Are <w>you</w> coming to the cinema tonight?",
                                "ru": "<w>Ты</w> пойдешь сегодня вечером в кино?",
                                "de": "Kommst <w>du</w> heute Abend mit ins Kino?",
                                "es": "¿Vienes <w>tú</w> al cine esta noche?"
                            }
                        },
                        {
                            "text": "Wat heb <w>je</w> gisteren eigenlijk gedaan?",
                            "target_lang_translations": {
                                "en": "What did <w>you</w> actually do yesterday?",
                                "ru": "Что <w>ты</w> вчера, собственно, делал?",
                                "de": "Was hast <w>du</w> gestern eigentlich gemacht?",
                                "es": "¿Qué hiciste <w>tú</w> ayer en realidad?"
                            }
                        }
                    ],
                    "synonyms": [
                        "jij"
                    ],
                    "common_phrases": [
                        "weet je",
                        "heb je",
                        "kun je",
                        "wil je"
                    ],
                    "traits": [
