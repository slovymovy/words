                "senses": [
                    {
                        "sense_id": "016c584b-7cd8-32e6-a672-478864284248",
                        "entry_id": "3b5e73d9-2c5d-3ee5-831d-13ebd02d18be",
                        "glosses": [
                            "Ausflug, der an einem Sonntag unternommen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77826a86-1164-4c61-98dc-0060393d4767",
                                "sense_id": "016c584b-7cd8-32e6-a672-478864284248",
                                "text": "„Wenn der Wiener einen Sonntagsausflug mache, wirke er in seinem Grant so, als ob er es nicht mehr erwarten könne, endlich wieder \"heimzukehren in den Wochentag\".“"
                            },
                            {
                                "example_id": "26807fe3-b758-494c-b611-5172f00953bc",
                                "sense_id": "016c584b-7cd8-32e6-a672-478864284248",
                                "text": "„Dann stieg ich wieder hinauf in die Stadt, aber mein Sonntagsausflug war noch nicht zu Ende.“"
                            },
                            {
                                "example_id": "49da8c9c-9894-4622-9109-3f97928f7870",
                                "sense_id": "016c584b-7cd8-32e6-a672-478864284248",
                                "text": "„Eines kalten Morgens im zeitigen Frühjahr 1928, als sie und Adrienne beim Frühstück saßen und ihren nächsten Sonntagsausflug mit dem Citroën planten, durchzuckte Sylvia beim ersten Schluck Kaffee plötzlich ein stechender Schmerz, der von der Schläfe bis zum Kinn ausstrahlte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
