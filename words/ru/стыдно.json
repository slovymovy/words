            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "721c8eba-2f10-3cdf-abab-72daa7548ad6",
                    "sense_definition": "О чувстве стыда, неловкости или вины, испытываемом кем-либо.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "feeling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мне стало <w>стыдно</w> за свои грубые слова.",
                            "target_lang_translations": {
                                "en": "I felt <w>ashamed</w> of my rude words.",
                                "tr": "Kaba sözlerimden dolayı <w>utandım</w>.",
                                "es": "Me sentí <w>avergonzado</w> por mis palabras groseras.",
                                "fr": "J'ai eu <w>honte</w> de mes paroles blessantes."
                            }
                        },
                        {
                            "text": "Ему было <w>стыдно</w> смотреть ей в глаза.",
                            "target_lang_translations": {
                                "en": "He was <w>ashamed</w> to look her in the eyes.",
                                "tr": "Onun gözlerinin içine bakmaya <w>utanıyordu</w>.",
                                "es": "Le daba <w>vergüenza</w> mirarla a los ojos.",
                                "fr": "Il avait <w>honte</w> de la regarder dans les yeux."
                            }
                        }
                    ],
                    "synonyms": [
                        "неловко",
                        "неудобно",
                        "совестно",
                        "позорно"
                    ],
                    "common_phrases": [
                        "мне стыдно",
                        "как не стыдно",
                        "стало стыдно",
                        "стыдно сказать"
                    ],
                    "target_lang_definitions": {
                        "en": "Regarding a feeling of shame, awkwardness, or guilt experienced by someone.",
                        "tr": "Birinin hissettiği utanç, mahcubiyet veya suçluluk duygusu hakkında.",
                        "es": "Sobre el sentimiento de vergüenza, incomodidad o culpa experimentado por alguien.",
                        "fr": "Concerne un sentiment de honte, de gêne ou de culpabilité éprouvé par quelqu'un."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ashamed",
                                "target_lang_sense_clarification": "feeling personal shame or guilt"
                            },
                            {
                                "target_lang_word": "embarrassed",
                                "target_lang_sense_clarification": "feeling socially awkward or uncomfortable"
                            }
                        ],
                        "tr": [
