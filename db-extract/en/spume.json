                                    {
                                        "sense_id": "f1164782-9798-3183-aeb6-c6ee229a42ba",
                                        "entry_id": "c79f552e-0b1d-3e71-abae-3f839ce47e5b",
                                        "glosses": [
                                            "de luchtige massa die bij heftige beweging van zeewatergolven ontstaat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08b299eb-c030-4bbd-a4f1-ff68b5879f97",
                                                "sense_id": "f1164782-9798-3183-aeb6-c6ee229a42ba",
                                                "text": "Op het strand ligt na een storm vaak een flinke hoeveelheid zeeschuim."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "568ffb7f-6388-33d1-b9b3-e1c983a9d13c",
                                        "entry_id": "c79f552e-0b1d-3e71-abae-3f839ce47e5b",
                                        "glosses": [
                                            "de inwendige schelp van een zeekat (een tienarmige inktvis), die onder meer op het Noordzeestrand wordt aangetroffen en die enige gelijkenis vertoond met een vlok #1"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ffd0df2c-d738-4de9-930d-f1d4bc37f748",
                                                "sense_id": "568ffb7f-6388-33d1-b9b3-e1c983a9d13c",
                                                "text": "Een stuk zeeschuim wordt soms gebruikt als bron van kalk in vogelkooien."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e10c0ef-5076-315b-a40d-f9f17d587eb2",
