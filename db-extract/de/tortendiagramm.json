                                "target_word": "camembert",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5b6a702a-f0f9-3a2b-93dc-c820650b186d",
                                        "entry_id": "cf6dcae0-d216-3fa7-8db1-242d3bdf1048",
