                "senses": [
                    {
                        "sense_id": "a43dbb0d-e16d-3c0b-ba7c-4e409d6c5555",
                        "entry_id": "37f98e47-adc8-324d-9854-3d431c6ef7d4",
                        "glosses": [
                            "ungeschickter Mensch; Person, die sich ungeschickt ausdrückt, sodass sie oft/leicht falsch verstanden werden kann; aber auch ein ungehobelter, unhöflicher Mensch"
                        ],
                        "tags": [
                            "colloquial",
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "15ba04f3-fa2a-4e99-a40d-09ac27e64224",
                                "sense_id": "a43dbb0d-e16d-3c0b-ba7c-4e409d6c5555",
                                "text": "»Er ist und bleibt ein Stoffel!«, sagte er. »Weißt du, Luba, was ein Stoffel ist?« »Nein.« »So etwas wie ein Affenmännchen, das saftige Feigen frisst und sein durstendes Frauchen zusehen lässt.«"
                            },
                            {
                                "example_id": "f820148f-16ce-4c83-9428-cc306f1553ac",
                                "sense_id": "a43dbb0d-e16d-3c0b-ba7c-4e409d6c5555",
                                "text": "Was sollte sie jetzt von ihm denken! Wahrscheinlich sagte sie sich, er wäre ein Stoffel. Oder ein Blödkopf. Oder völlig gefühllos."
                            },
                            {
                                "example_id": "3ccff903-65d4-4e7a-bfc3-2bc89b1af59b",
                                "sense_id": "a43dbb0d-e16d-3c0b-ba7c-4e409d6c5555",
                                "text": "Er dachte: Ich bin zu kalt. Ich bin ein Stoffel! Ich müßte forscher sein."
                            },
                            {
                                "example_id": "d04bedec-2a51-4ff9-9f06-213e24ec9892",
                                "sense_id": "a43dbb0d-e16d-3c0b-ba7c-4e409d6c5555",
                                "text": "So ein Stoffel, der kann ja nicht mal grüßen!"
                            },
                            {
                                "example_id": "fb7a0cdd-af67-4bd7-ad7b-9f3376ff656c",
                                "sense_id": "a43dbb0d-e16d-3c0b-ba7c-4e409d6c5555",
                                "text": "Matthias ist so ungeschickt, ein echter Stoffel eben, deshalb haben wir ihm genau diesen Spitznamen gegeben."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ff07f061-e34a-4ad6-97b3-ec64de0b81f0",
                        "source_entry_id": "37f98e47-adc8-324d-9854-3d431c6ef7d4",
                        "source_sense_id": "a43dbb0d-e16d-3c0b-ba7c-4e409d6c5555",
                        "target_lang_word": "boor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7dca29c0-a79f-3c3b-a314-20eb0d1ee113",
                                        "entry_id": "874cd61f-2f57-3533-a799-df980abf3ef3",
                                        "glosses": [
                                            "A peasant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "727ef383-6011-412f-bf44-52e4bd91464f",
                                                "sense_id": "7dca29c0-a79f-3c3b-a314-20eb0d1ee113",
                                                "text": "Not swear it, now I am a gentleman? Let boors and franklins say it, I’ll swear it."
                                            },
                                            {
                                                "example_id": "b67d62d7-5486-48f7-ab27-8d45fcce7b0c",
                                                "sense_id": "7dca29c0-a79f-3c3b-a314-20eb0d1ee113",
                                                "text": "For all the rich array and goodly port and countenance of Corinius, he seemed but a very boor beside the Lord Brandoch Daha, and dearly did each hate the other."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d40eac4-4fbe-3175-a746-2bc8b1ce1695",
                                        "entry_id": "874cd61f-2f57-3533-a799-df980abf3ef3",
                                        "glosses": [
                                            "A Boer, white South African of Dutch or Huguenot descent."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "00a94902-5c40-3d3f-bde6-4367bc52b1a6",
                                        "entry_id": "874cd61f-2f57-3533-a799-df980abf3ef3",
                                        "glosses": [
                                            "A yokel, country bumpkin."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b0ba5e00-72cd-359b-aa28-b072a38ef81e",
                                        "entry_id": "874cd61f-2f57-3533-a799-df980abf3ef3",
                                        "glosses": [
                                            "An uncultured person; a vulgarian."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "367635d2-d061-48ea-8df1-fe3e60ebf3de",
                                                "sense_id": "b0ba5e00-72cd-359b-aa28-b072a38ef81e",
                                                "text": "I question if any man ever saw his absent friend more clearly than did Shakespeare his Falstaff, for instance, or Scott his Balfour of Burleigh. But does it, therefore, follow that either of these great writers would, when hungry, have summoned up before him a clearer picture of his approaching dinner, than does the equally hungry or very much hungrier boor? This I doubt; and on the same principle I doubt if the said boor would see his dinner more clearly than a wolf, bear, or tiger would theirs when in quest of it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e77596e1-8896-4102-a98c-be751315047e",
                        "source_entry_id": "37f98e47-adc8-324d-9854-3d431c6ef7d4",
                        "source_sense_id": "a43dbb0d-e16d-3c0b-ba7c-4e409d6c5555",
                        "target_lang_word": "plouc",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plouc",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4c9a2c07-4eae-3575-9c09-53c74627009d",
                                        "entry_id": "d0288222-77be-31cd-ae3d-8f7a4f9602a8",
                                        "glosses": [
                                            "Paysan, campagnard."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e90e16e-d72f-402e-9c56-731b2cc4e443",
                                                "sense_id": "4c9a2c07-4eae-3575-9c09-53c74627009d",
                                                "text": "Un lieu n'est privilégié que par notre enfance et nous ne devons jamais le quitter si nous voulons qu'à leur tour nos enfants s'y accrochent. Les miens étaient des banlieusards et Soledot, pour eux, un trou hanté par deux cents ploucs."
                                            },
                                            {
                                                "example_id": "db1ba167-b99b-410b-b650-0493fa08788f",
                                                "sense_id": "4c9a2c07-4eae-3575-9c09-53c74627009d",
                                                "text": "Dans le film « Fantasia chez les ploucs », Lino Ventura incarne Sagamore Noonan qui vit tranquillement dans une ferme où il distille clandestinement du whisky."
                                            },
                                            {
                                                "example_id": "f2183738-8ca0-4d76-9acf-e62118d9dd06",
                                                "sense_id": "4c9a2c07-4eae-3575-9c09-53c74627009d",
                                                "text": "Moi, on s’est un peu foutu de ma gueule parce que je suis d’origine bretonne, ça faisait plouc, et plouc, c’est un vrai mot breton qui veut dire paysan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f256614-b6fe-3b5c-885a-68e243c81f9b",
                                        "entry_id": "d0288222-77be-31cd-ae3d-8f7a4f9602a8",
                                        "glosses": [
                                            "Péquenaud, rustre, bouseux, cul-terreux, rustique"
                                        ],
                                        "tags": [
                                            "offensive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac40d4ee-970c-49c6-b984-0a4ad49f383b",
                                                "sense_id": "3f256614-b6fe-3b5c-885a-68e243c81f9b",
                                                "text": "Il n’est jamais allé en ville ; c’est un vrai plouc."
                                            },
                                            {
                                                "example_id": "0b476beb-c770-4a7f-87d7-1a53db403edf",
                                                "sense_id": "3f256614-b6fe-3b5c-885a-68e243c81f9b",
                                                "text": "Comment son père avait-il pu croire qu’il pourrait remplacer Antonin par un plouc pareil, un plouc, oui, comme disait Georges lui-même qui fustigeait les ploucs du monde entier et venait, sans le savoir, d’en introduire un dans sa propre maison ?"
                                            },
                                            {
                                                "example_id": "33c042e9-c278-43d1-88b6-48e9fcdfa408",
                                                "sense_id": "3f256614-b6fe-3b5c-885a-68e243c81f9b",
                                                "text": "— Émouvant, non, sa naïveté ?\n— C’est un plouc de l’île Maurice…"
                                            },
                                            {
                                                "example_id": "7cbaad95-a025-4802-9c21-b21b47236ebf",
                                                "sense_id": "3f256614-b6fe-3b5c-885a-68e243c81f9b",
                                                "text": "Beaucoup disaient voir ses défauts et les condamner. Mais ils l’appuyaient tout de même. Pourquoi ? Parce qu’ils sont fâchés et frustrés. (...). C'est simple : ils en ont assez de passer pour des ploucs arriérés et racistes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37d1e969-812b-34e3-909b-3ad033dd58ff",
                                        "entry_id": "d0288222-77be-31cd-ae3d-8f7a4f9602a8",
                                        "glosses": [
                                            "Soldat sans grade."
                                        ],
                                        "tags": [
                                            "Belgique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c445b7b-6ef2-4d22-bb4e-22f5604ef129",
                                                "sense_id": "37d1e969-812b-34e3-909b-3ad033dd58ff",
                                                "text": "J’ai passé mon service militaire comme simple plouc."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "plouc",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3774c962-5436-3e88-a259-e921a9937a12",
                                        "entry_id": "90513c09-44d3-3a3b-9909-f6e7a5404c4d",
                                        "glosses": [
                                            "Balourd, lourdaud, rustique, rustre."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ba575eb-3de9-4325-a7a5-c94372cff41b",
                                                "sense_id": "3774c962-5436-3e88-a259-e921a9937a12",
                                                "text": "Sa robe fait plouc."
                                            },
                                            {
                                                "example_id": "fe149543-165e-4a6f-a5df-46b2180a418c",
                                                "sense_id": "3774c962-5436-3e88-a259-e921a9937a12",
                                                "text": "Chemise à manches courtes pour un costard : c’est plouc ?"
                                            },
                                            {
                                                "example_id": "a22222a3-9ebb-4b38-97b7-0dff148f89ff",
                                                "sense_id": "3774c962-5436-3e88-a259-e921a9937a12",
                                                "text": "Refusant l’idée plouc et puritaine qu’on ne sorte les couverts d’argent que pour “les grandes occasions”, j’ai inversé les rôles afin d’améliorer l’ordinaire : ne suis-je pas 1 propriétaire ingénieux ?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "plouc",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4f82c405-a690-3216-99db-eac63a14b02c",
                                        "entry_id": "70e88448-beea-3582-a19a-52547ba1e06d",
                                        "glosses": [
                                            "Bruit de la chute d’une goutte de liquide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eaea0e1f-bce6-4a80-803f-ff8e955dcc87",
                                                "sense_id": "4f82c405-a690-3216-99db-eac63a14b02c",
                                                "text": "Plouc !\nUne goutte\nPlouc plouc !\nDeux gouttes\nLa pluie arrive\nRangez calebasses et marmites"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ca2634c-8499-3ae4-8ef2-e5850dc36df7",
                                        "entry_id": "70e88448-beea-3582-a19a-52547ba1e06d",
                                        "glosses": [
                                            "Bruit produit par le tir d'une arme équipée d'un silencieux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "769f3435-fc5f-46b5-9d11-eafe6af8aada",
                                                "sense_id": "1ca2634c-8499-3ae4-8ef2-e5850dc36df7",
                                                "text": "Il se laissa choir au moment où retentissait le « plouc » révélateur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
