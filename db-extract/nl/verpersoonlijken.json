                                    },
                                    {
                                        "sense_id": "99aa6cb7-1b47-3714-864c-c82133cf7204",
                                        "entry_id": "b3f58922-b16b-30fc-b06c-ff672c48d0ea",
                                        "glosses": [
                                            "To be an epitome of."
                                        ],
                                        "tags": [
                                            "British",
                                            "English",
                                            "Oxford",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5270f9df-d23b-4369-8048-3a574db6295f",
                                                "sense_id": "99aa6cb7-1b47-3714-864c-c82133cf7204",
                                                "text": "The framework of Combinatory Categorial Grammar epitomizes the rule-based generalized categorial architecture."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "04156de9-3a4b-4ca1-bb0c-a94c31120bf0",
                        "source_entry_id": "7c7793ac-a6e6-303e-8ca0-54f771126878",
                        "source_sense_id": "c67a7c49-fe54-3768-9cfd-cbba65e96d7d",
                        "source_sense_description": "als een persoon voorstellen van iets dat niet tastbaar is",
                        "target_lang_word": "embody",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "embody",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1b1a1db1-b4ff-3f4e-b41f-9465288e4a92",
                                        "entry_id": "abcc5b87-d128-352d-b3f3-878c397bec6d",
                                        "glosses": [
                                            "To represent in a physical or concrete form; to incarnate or personify."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00b0b0eb-66cc-49c6-859d-cc490e8210ad",
                                                "sense_id": "1b1a1db1-b4ff-3f4e-b41f-9465288e4a92",
                                                "text": "As the car salesman approached, wearing a plaid suit and slicked-back hair, he seemed to embody sleaze."
                                            },
                                            {
                                                "example_id": "0ceb8aae-3314-4ce3-ae85-665d344a5308",
                                                "sense_id": "1b1a1db1-b4ff-3f4e-b41f-9465288e4a92",
                                                "text": "The soul, while it is embodied, can no more be divided from sin."
                                            },
                                            {
                                                "example_id": "68584f9b-ec7e-42ae-b20d-ad2379ae6f46",
                                                "sense_id": "1b1a1db1-b4ff-3f4e-b41f-9465288e4a92",
                                                "text": "Francesca shook her head as she answered, \"Ah! expectations are such unreasonable things! It was impossible for even France to realise the dreams of youth and solitude! What ever embodies our idea of perfection?\""
                                            },
                                            {
                                                "example_id": "48b2e961-5b9d-469f-894a-3ec2f2798a13",
                                                "sense_id": "1b1a1db1-b4ff-3f4e-b41f-9465288e4a92",
                                                "text": "The generational shift Mr. Obama once embodied is, in fact, well under way, but it will not change Washington as quickly — or as harmoniously — as a lot of voters once hoped."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b40d1c0-a6b8-3dd8-a80b-512fe77ee508",
                                        "entry_id": "abcc5b87-d128-352d-b3f3-878c397bec6d",
                                        "glosses": [
                                            "To represent in some other form, such as a code of laws."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0915a71e-b1f6-4287-ba56-85f1b7bdb349",
                                                "sense_id": "8b40d1c0-a6b8-3dd8-a80b-512fe77ee508",
                                                "text": "The US Constitution aimed to embody the ideals of diverse groups of people, from Puritans to Deists."
                                            },
                                            {
                                                "example_id": "8e7d285b-f711-486d-9fa4-dc11656ec2a7",
                                                "sense_id": "8b40d1c0-a6b8-3dd8-a80b-512fe77ee508",
                                                "text": "The principle was recognized by some of the early Greek philosophers who embodied it in their systems."
                                            },
                                            {
                                                "example_id": "0c83ef0b-4883-4d32-ace4-54fb4c293bc0",
                                                "sense_id": "8b40d1c0-a6b8-3dd8-a80b-512fe77ee508",
                                                "text": "Given these entrenched ideological assumptions about the colonial order, it is no wonder that the state and those groups with an interest in the status quo viewed with suspicion and hostility any challenges to the fixed and \"natural\" boundaries between different sorts of people. These attitudes were perhaps best embodied by the so-called Two Republic system of Spanish America, a sprawling collection of royal legislation, local administrative policies, and informal practices, through which Spanish colonizers attempted to separate native peoples from other colonial subjects."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e63bb01-33a4-3cb0-95c8-c5ade91a9842",
                                        "entry_id": "abcc5b87-d128-352d-b3f3-878c397bec6d",
                                        "glosses": [
                                            "To comprise or include as part of a cohesive whole; to be made up of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36f8a28f-77c8-4f7e-932f-223cb92d162e",
                                                "sense_id": "1e63bb01-33a4-3cb0-95c8-c5ade91a9842",
                                                "text": "With the exception of the Great Eastern Line, these embody the most complete systematisation of steam or diesel-operated main line services that has yet taken place in the country."
                                            },
                                            {
                                                "example_id": "5f319752-9f90-4bca-9b13-196ba5077196",
                                                "sense_id": "1e63bb01-33a4-3cb0-95c8-c5ade91a9842",
                                                "text": "For use in a nursery for cradling a baby to sleep, a baby cradler comprising, in combination, a stand embodying a mobile base, uprights attached to and rising perpendicularly from the base and having axially aligned bearings, [...]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4afe8601-d78e-39e9-8cb5-de27d591f1af",
                                        "entry_id": "abcc5b87-d128-352d-b3f3-878c397bec6d",
                                        "glosses": [
                                            "To unite in a body or mass."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9fb39dee-7f02-430b-a979-a9ee76257d4b",
                                                "sense_id": "4afe8601-d78e-39e9-8cb5-de27d591f1af",
                                                "text": "Nay, my good friend—the people will remain / Embodied peaceably, till Parliament / Confirm the royal charter: tell your king so: / We will await the Charter's confirmation, / Meanwhile comporting ourselves orderly / As peaceful citizens, not risen in tumult, / But to redress their evils."
                                            },
                                            {
                                                "example_id": "e541333c-ab73-42fa-96f0-1f74bf82ccfb",
                                                "sense_id": "4afe8601-d78e-39e9-8cb5-de27d591f1af",
                                                "text": "So when inclement winters vex the plain / With piercing frosts, or thick-descending rain, / To warmer seas the cranes embodied fly, / With noise, and order, through the midway sky;"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
