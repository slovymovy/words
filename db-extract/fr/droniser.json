                "senses": [
                    {
                        "sense_id": "02fefdcf-4267-3b6f-9b4f-92a5ce374210",
                        "entry_id": "7cbb2fe0-bb01-3b9d-8a77-3fd70d0f51e7",
                        "glosses": [
                            "Rendre utilisable en tant que drone (véhicule qui peut être commandé à distance)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "722641c4-81b3-4374-98d8-1fe757384e1e",
                                "sense_id": "02fefdcf-4267-3b6f-9b4f-92a5ce374210",
                                "text": "La société a la capacité de « droniser » (rendre autonome) tout type de véhicule (bateaux, quads, engins de chantier, etc… ^([sic : etc.]))"
                            },
                            {
                                "example_id": "480b0c8b-72f9-4428-9e19-fc88fd2837bd",
                                "sense_id": "02fefdcf-4267-3b6f-9b4f-92a5ce374210",
                                "text": "Pas besoin de droniser complètement un avion, ce qui va demander des décennies."
                            },
                            {
                                "example_id": "40cbd2fb-4fb7-4d47-ad88-7688f236b915",
                                "sense_id": "02fefdcf-4267-3b6f-9b4f-92a5ce374210",
                                "text": "Le marché des bateaux à droniser pour leur donner la capacité de naviguer par téléopération, voire de manière autonome, est également un marché important."
                            }
                        ]
                    },
                    {
                        "sense_id": "c5cc4af2-333a-307c-936b-8a439064f285",
                        "entry_id": "7cbb2fe0-bb01-3b9d-8a77-3fd70d0f51e7",
                        "glosses": [
                            "Se doter de drones."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "a6d8bec9-5a2b-430f-8ea7-23d75e7eb6ce",
                                "sense_id": "c5cc4af2-333a-307c-936b-8a439064f285",
                                "text": "L’Armée de Terre se transforme et \"se dronise\" !"
                            }
                        ]
                    }
