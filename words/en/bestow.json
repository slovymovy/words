{
    "word_family": [
        "bestowal",
        "bestower",
        "bestowment"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fe80c350-64a5-30b2-a85f-631b21974a7d",
                    "sense_definition": "To give something to someone, especially as a gift, an honor, or a formal gesture.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "giving",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The university decided to <w>bestow</w> an honorary degree upon the former president for his years of service.",
                            "target_lang_translations": {
                                "ru": "Университет решил <w>присудить</w> почетную степень бывшему президенту за его многолетнюю службу."
                            }
                        },
                        {
                            "text": "It is a great honor to <w>bestow</w> a gift on such a distinguished guest during the ceremony.",
                            "target_lang_translations": {
                                "ru": "Это большая честь — <w>вручить</w> подарок столь почетному гостю во время церемонии."
                            }
                        }
                    ],
                    "synonyms": [
                        "bestowing",
                        "bestowment"
                    ],
                    "antonyms": [
                        "withhold",
                        "take",
                        "withdraw"
                    ],
                    "common_phrases": [
                        "bestow a gift",
                        "bestow an honor",
                        "bestow upon"
                    ],
                    "target_lang_definitions": {
                        "ru": "Дарить что-либо кому-либо, особенно в качестве подарка, почести или официального жеста."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "даровать",
                                "target_lang_sense_clarification": "высокий стиль, о наградах или милости"
                            },
                            {
                                "target_lang_word": "присуждать",
                                "target_lang_sense_clarification": "о степени или награде"
                            },
                            {
                                "target_lang_word": "вручать",
                                "target_lang_sense_clarification": "торжественно передавать"
                            },
                            {
                                "target_lang_word": "пожаловать",
                                "target_lang_sense_clarification": "устаревшее, о чине или награде"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bd1f149b-6477-3669-b96d-8a11db8f0cb7",
                    "sense_definition": "To provide someone with a place to stay or to find accommodation for them.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "accommodation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The captain had to <w>bestow</w> the passengers in the remaining cabins after the storm damaged the ship.",
                            "target_lang_translations": {
                                "ru": "Капитану пришлось <w>разместить</w> пассажиров в оставшихся каютах после того, как шторм повредил корабль."
                            }
                        },
                        {
                            "text": "They will <w>bestow</w> the travelers for the night in the guest wing of the manor.",
                            "target_lang_translations": {
                                "ru": "Путешественников <w>поселят</w> на ночь в гостевом крыле поместья."
                            }
                        }
                    ],
                    "synonyms": [
                        "house",
                        "put up"
                    ],
                    "antonyms": [
                        "evict",
                        "displace"
                    ],
                    "common_phrases": [
                        "bestow for the night"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Used more frequently in older literature regarding lodging."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Предоставлять кому-либо место для проживания или находить жилье."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "размещать",
                                "target_lang_sense_clarification": "предоставлять помещение"
                            },
                            {
                                "target_lang_word": "поселять",
                                "target_lang_sense_clarification": "давать жилье"
                            },
                            {
                                "target_lang_word": "расквартировывать",
                                "target_lang_sense_clarification": "официальное или военное размещение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f7700790-5d2b-3a66-bcf3-00e56d118059",
                    "sense_definition": "To put something away in a safe place for storage or safekeeping.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "storage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer needed a larger barn to <w>bestow</w> his fruits after a particularly successful harvest.",
                            "target_lang_translations": {
                                "ru": "Фермеру понадобился амбар побольше, чтобы <w>сложить</w> фрукты после особенно успешного урожая."
                            }
                        },
                        {
                            "text": "She looked for a secure chest where she could <w>bestow</w> her money away from prying eyes.",
                            "target_lang_translations": {
                                "ru": "Она искала надежный сундук, где могла бы <w>спрятать</w> свои деньги от посторонних глаз."
                            }
                        }
                    ],
                    "synonyms": [
                        "lay out"
                    ],
                    "antonyms": [
                        "discard",
                        "lose"
                    ],
                    "common_phrases": [
                        "bestow in safety"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Common in early modern English for stowing items."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Убирать что-либо в надежное место для хранения или сбережения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "складывать",
                                "target_lang_sense_clarification": "помещать на хранение"
                            },
                            {
                                "target_lang_word": "припрятывать",
                                "target_lang_sense_clarification": "убирать в надежное место"
                            },
                            {
                                "target_lang_word": "хранить",
                                "target_lang_sense_clarification": "содержать в сохранности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b8c49c1-6cde-3515-a0a5-65b5a8df8228",
                    "sense_definition": "To use or apply something, such as time or effort, for a specific purpose.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "usage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He chose to <w>bestow</w> his time in learning new languages while traveling abroad.",
                            "target_lang_translations": {
                                "ru": "Он решил <w>уделить</w> свое время изучению новых языков во время путешествия за границу."
                            }
                        },
                        {
                            "text": "The scholar would <w>bestow</w> many hours on his research every single day.",
                            "target_lang_translations": {
                                "ru": "Ученый <w>тратил</w> много часов на свои исследования каждый божий день."
                            }
                        }
                    ],
                    "antonyms": [
                        "waste",
                        "idle"
                    ],
                    "common_phrases": [
                        "bestow time",
                        "bestow labor"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Now more commonly replaced by 'spend' or 'devote'."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Использовать или применять что-либо, например время или усилия, для определенной цели."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "употреблять",
                                "target_lang_sense_clarification": "использовать для дела"
                            },
                            {
                                "target_lang_word": "уделять",
                                "target_lang_sense_clarification": "о времени или внимании"
                            },
                            {
                                "target_lang_word": "тратить",
                                "target_lang_sense_clarification": "расходовать ресурс"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ee06431d-6e69-3d20-aad6-6241372f7be9",
                    "sense_definition": "To give someone, typically a daughter, in marriage to another person.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "marriage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king intended to <w>bestow</w> his daughter on the prince to secure a political alliance.",
                            "target_lang_translations": {
                                "ru": "Король намеревался <w>выдать</w> свою дочь за принца, чтобы закрепить политический союз."
                            }
                        },
                        {
                            "text": "In the play, the father refuses to <w>bestow</w> her upon a man she does not love.",
                            "target_lang_translations": {
                                "ru": "В пьесе отец отказывается <w>отдавать</w> ее за человека, которого она не любит."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bestow in marriage"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Reflects historical social customs regarding marriage."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выдавать кого-либо, обычно дочь, замуж за другого человека."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выдавать",
                                "target_lang_sense_clarification": "замуж"
                            },
                            {
                                "target_lang_word": "отдавать",
                                "target_lang_sense_clarification": "в замужество"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "952e2a70-2dfd-3b75-9c9c-f6b282b1273f",
                    "sense_definition": "To behave or conduct oneself in a particular manner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young knight sought to learn how he might <w>bestow</w> himself to be regarded well by the court.",
                            "target_lang_translations": {
                                "ru": "Молодой рыцарь стремился научиться тому, как ему следует <w>держаться</w>, чтобы двор был о нем высокого мнения."
                            }
                        },
                        {
                            "text": "They watched from the shadows to see how the stranger would <w>bestow</w> himself in the tavern.",
                            "target_lang_translations": {
                                "ru": "Они наблюдали из тени, чтобы увидеть, как незнакомец будет <w>вести себя</w> в таверне."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bestow oneself"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used reflexively in older literature."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вести себя или держаться определенным образом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "держаться",
                                "target_lang_sense_clarification": "вести себя в обществе"
                            },
                            {
                                "target_lang_word": "вести себя",
                                "target_lang_sense_clarification": "манера поведения"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "90cb14af-7e1b-3ce3-bf19-07de2984fdf9",
                    "sense_definition": "The act of presenting something to someone, particularly as a gift or honor; a <w>bestowal</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "giving",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The poet complained that despite his hard work, he received a very poor <w>bestow</w> for his efforts.",
                            "target_lang_translations": {
                                "ru": "Поэт жаловался, что, несмотря на его тяжелый труд, он получил очень скудное <w>вознаграждение</w> за свои усилия."
                            }
                        },
                        {
                            "text": "The ceremony concluded with the formal <w>bestow</w> of the medals to the brave soldiers.",
                            "target_lang_translations": {
                                "ru": "Церемония завершилась официальным <w>вручением</w> медалей отважным солдатам."
                            }
                        }
                    ],
                    "synonyms": [
                        "bestowing",
                        "bestowment"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "The noun form is now almost entirely replaced by 'bestowal'."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт вручения чего-либо кому-либо, особенно в качестве подарка или почести."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дарование",
                                "target_lang_sense_clarification": "акт передачи дара"
                            },
                            {
                                "target_lang_word": "вручение",
                                "target_lang_sense_clarification": "торжественный акт"
                            },
                            {
                                "target_lang_word": "пожалование",
                                "target_lang_sense_clarification": "официальное награждение"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}