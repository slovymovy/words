                    }
                ],
                "senses": [
                    {
                        "sense_id": "d8e2cbd7-c1ea-3b88-a9ec-5481827df769",
                        "entry_id": "f0fff494-64c9-36a1-b948-0506a573b41b",
                        "glosses": [
                            "To try or attempt again."
                        ],
                        "tags": [
                            "ambitransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "b03e8cdd-f8ab-498b-82ac-415d554c6196",
                                "sense_id": "d8e2cbd7-c1ea-3b88-a9ec-5481827df769",
                                "text": "to retry connecting to the Internet after an error"
                            },
                            {
                                "example_id": "7fc99d24-8e84-4824-9509-6e92494c851f",
                                "sense_id": "d8e2cbd7-c1ea-3b88-a9ec-5481827df769",
                                "text": "On October 20, Forsen streamed on Twitch as he retried to defeat the Ender Dragon as fast as he could."
                            },
                            {
                                "example_id": "e0846a39-8b16-4272-be57-aa8044855d49",
                                "sense_id": "d8e2cbd7-c1ea-3b88-a9ec-5481827df769",
                                "text": "There’s a chance the error code appeared as a mistake, so retrying could help you get back to the fight in no time."
                            },
                            {
                                "example_id": "361c444a-2fa7-4fe4-a29e-bb10df500ff0",
                                "sense_id": "d8e2cbd7-c1ea-3b88-a9ec-5481827df769",
                                "text": "The problem? Unlike dying during the Great Ape Vegeta fight, you can’t retry right away."
                            }
                        ]
                    },
                    {
                        "sense_id": "3f99bf5c-9df5-3d3a-8027-08c8143362c9",
                        "entry_id": "f0fff494-64c9-36a1-b948-0506a573b41b",
                        "glosses": [
                            "To try judicially a second time."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "7731a13d-7b52-4c5f-ad21-0cb1b74af5c6",
                                "sense_id": "3f99bf5c-9df5-3d3a-8027-08c8143362c9",
                                "text": "to retry a case"
                            },
                            {
                                "example_id": "14e94be5-0ad5-450c-8a76-68775555c687",
                                "sense_id": "3f99bf5c-9df5-3d3a-8027-08c8143362c9",
                                "text": "to retry an accused person"
                            },
                            {
                                "example_id": "7774b1d8-96b8-4358-be64-65358583feb4",
                                "sense_id": "3f99bf5c-9df5-3d3a-8027-08c8143362c9",
                                "text": "Despite mounting evidence against her, the jury found Casey not guilty. Since then, she’s thrown out numerous accusations about her family, a number of which she alleged in the 2022 docu-series Casey Anthony: Where the Truth Lies. But amid the release of a new documentary involving her parents, George and Cindy, could she be retried?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dafc3162-c3b2-4daa-ba88-e7787a175719",
                        "source_entry_id": "f0fff494-64c9-36a1-b948-0506a573b41b",
                        "source_sense_description": "to try or attempt again",
                        "target_lang_word": "herkansen",
                        "target_lang_code": "nl",
