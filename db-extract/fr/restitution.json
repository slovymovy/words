            {
                "entry_id": "4cea30cc-c70f-3471-b7d3-e31073732a84",
                "word": "restitution",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7dcbee19-690f-40d2-b0c6-4bfc3f2ccdf6",
                        "entry_id": "4cea30cc-c70f-3471-b7d3-e31073732a84",
                        "tags": [
                            "plural"
                        ],
                        "form": "restitutions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "478a5e3d-013b-3ee0-b54d-2867246649ac",
                        "entry_id": "4cea30cc-c70f-3471-b7d3-e31073732a84",
                        "glosses": [
                            "Action par laquelle on restitue, on rend."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52a6f7cd-67ee-48a5-9f26-edb91c0ba0f2",
                                "sense_id": "478a5e3d-013b-3ee0-b54d-2867246649ac",
                                "text": "La restitution de K est assurée, à parts à peu près égales, par le pluviolessivage des feuilles jaunissantes (24 kg/ha/an), la litière des arbres (27 kg/ha/an) et la strate herbacée (26 kg/ha/an), […]."
                            },
                            {
                                "example_id": "100ab11d-6951-4176-b681-e0f5f0005d5d",
                                "sense_id": "478a5e3d-013b-3ee0-b54d-2867246649ac",
                                "text": "Vous êtes obligé, tenu à restitution."
                            },
                            {
                                "example_id": "e2407cf3-172d-4248-933a-d938003ced89",
                                "sense_id": "478a5e3d-013b-3ee0-b54d-2867246649ac",
                                "text": "Il ne veut point entendre parler de restitution, Faire restitution."
                            }
                        ]
                    },
                    {
                        "sense_id": "a6f860e7-0cf0-3f09-857a-23470eaebeb8",
                        "entry_id": "4cea30cc-c70f-3471-b7d3-e31073732a84",
                        "glosses": [
                            "Action par laquelle on rétablit, on remet une chose en son premier état."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98db044d-ae20-461e-9a68-2317e60553f9",
                                "sense_id": "a6f860e7-0cf0-3f09-857a-23470eaebeb8",
                                "text": "La restitution d’un texte, d’un passage de quelque auteur."
                            },
                            {
                                "example_id": "57cc0c91-3b85-44c0-b64a-14fcdcca8cd1",
                                "sense_id": "a6f860e7-0cf0-3f09-857a-23470eaebeb8",
                                "text": "La restitution de cette statue, de cette inscription est heureuse."
                            }
                        ]
                    },
                    {
                        "sense_id": "cdae3296-6d82-37c1-bb6f-fd5f5b58b180",
                        "entry_id": "4cea30cc-c70f-3471-b7d3-e31073732a84",
                        "glosses": [
                            "Rendu d’un monument, d’un édifice détruit, à l’aide des vestiges qui subsistent encore, de descriptions, de renseignements, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1da618fd-9a2b-4dbc-98dc-8af62fa2521b",
                                "sense_id": "cdae3296-6d82-37c1-bb6f-fd5f5b58b180",
                                "text": "La restitution d’un monument, d’un édifice."
                            },
                            {
                                "example_id": "f7e143d9-d154-4e96-8f42-7db7642ad8b0",
                                "sense_id": "cdae3296-6d82-37c1-bb6f-fd5f5b58b180",
                                "text": "La restitution d’une maison romaine."
                            }
                        ]
                    },
                    {
                        "sense_id": "cd5a4b83-ae73-3074-bffc-12a4db79efc8",
                        "entry_id": "4cea30cc-c70f-3471-b7d3-e31073732a84",
                        "glosses": [
                            "Reproduction."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5852d1e9-eccc-4a27-ab36-76abab089f77",
                                "sense_id": "cd5a4b83-ae73-3074-bffc-12a4db79efc8",
                                "text": "Médailles monnaies de restitution, ou simplement restitutions, médailles qui reproduisent des médailles frappées au type d’un ancien souverain."
                            }
                        ]
                    },
                    {
                        "sense_id": "41572c9b-fd1f-317d-98e7-c2ac030ce80a",
                        "entry_id": "4cea30cc-c70f-3471-b7d3-e31073732a84",
                        "glosses": [
                            "Jugements qui relèvent quelqu’un d’un engagement qu’il avait contracté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92bf6b2b-b000-4e78-a2e6-c47e657590be",
                                "sense_id": "41572c9b-fd1f-317d-98e7-c2ac030ce80a",
                                "text": "La restitution d’un mineur contre des actes qu’il a passés en minorité, et dans lesquels il a été lésé."
                            },
                            {
                                "example_id": "3c5b63f6-b0e5-4dfa-aa74-e4d7ec94030b",
                                "sense_id": "41572c9b-fd1f-317d-98e7-c2ac030ce80a",
                                "text": "Restitution en entier."
                            }
                        ]
                    }
                ],
                "translations": [
