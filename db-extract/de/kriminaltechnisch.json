                ],
                "senses": [
                    {
                        "sense_id": "b9e4c0d0-0139-3437-97f7-af8005a197ec",
                        "entry_id": "7dda6982-6f69-300d-a926-fcf55ddb9654",
                        "glosses": [
                            "Kriminaltechnik betreffend, auf Kriminaltechnik bezogen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c0501c5-8877-4f9e-b584-5b71c00536c1",
                                "sense_id": "b9e4c0d0-0139-3437-97f7-af8005a197ec",
                                "text": "„Er hatte ein Mikroskop und Objektträger mitgebracht. Außerdem ein kriminaltechnisches Handbuch.“"
                            },
                            {
                                "example_id": "cac70173-2e6e-4a82-bedf-f880602b585f",
                                "sense_id": "b9e4c0d0-0139-3437-97f7-af8005a197ec",
                                "text": "„Für eine kriminaltechnische Untersuchung der Brandstelle brauchte Yu präzise Fotos.“"
                            },
                            {
                                "example_id": "dad76b96-4f78-487c-88cd-691fcd854cfe",
                                "sense_id": "b9e4c0d0-0139-3437-97f7-af8005a197ec",
                                "text": "„Bennie Griessel hörte zu, wie Cupido das kriminaltechnische Labor in Plattekloof anrief und bat, Leute nach Stellenbosch zu schicken, um Fingerabdrücke abzunehmen.“"
                            },
                            {
