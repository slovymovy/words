                "senses": [
                    {
                        "sense_id": "edcd07db-05b0-371a-b7a2-190dac1a0e8f",
                        "entry_id": "8409d161-4f99-3a94-a1b5-23fe523afd1c",
                        "glosses": [
                            "Vergleichsobjekt mit nicht reflektierender Oberfläche, das (in der kontrollierten Studio-Umgebung) einen korrekten Weißabgleich (das Kalibrieren der Kamera) ermöglicht"
                        ],
                        "tags": [
                            "Fotografie",
                            "Film"
                        ],
                        "examples": [
                            {
                                "example_id": "913fea7d-e600-48b3-9499-27316c6580e0",
                                "sense_id": "edcd07db-05b0-371a-b7a2-190dac1a0e8f",
                                "text": "„Alles, was Sie für diesen manuellen Weißabgleich brauchen, ist eine Weißabgleichkarte – zur Not geht auch eine graue Pappe. Platzieren Sie diese Referenz im Bild oder drücken Sie sie Ihrem Model in die Hand. Wenn Sie kein Hilfsmittel parat haben, wählen Sie eine Bildpartie, die in natura hellgrau ist.“"
                            },
                            {
                                "example_id": "05a80c49-ca41-4628-9e83-174bed4fe020",
                                "sense_id": "edcd07db-05b0-371a-b7a2-190dac1a0e8f",
                                "text": "„Das bedeutet, dass man die Wahl des Weißabgleichs für die Aufnahme des einzelnen Bildes nicht notwendigerweise vor Ort vornehmen muss und den größtmöglichen Spielraum bei der Nachbearbeitung hat. Die zusätzliche Aufnahme einer Weißabgleichkarte oder Graukarte kann sich bei dieser Nachbearbeitung jedoch als nützlich herausstellen, da sich der notwendige Weißpunkt nicht in jedem Motiv finden lässt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
