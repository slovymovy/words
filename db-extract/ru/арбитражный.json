                                    },
                                    {
                                        "sense_id": "8db04de3-db87-3217-b771-ab4979320b50",
                                        "entry_id": "0fe628ea-40d8-300b-a395-cec4576aa26d",
                                        "glosses": [
                                            "A process through which two or more parties use an arbitrator or arbiter in order to resolve a dispute."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
