                        "glosses": [
                            "The act of cancelling part of a claim by deducting a smaller claim which the claimant owes to the defendant."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "58d9a2b6-4eda-3e06-b392-9ec7eba652f5",
                        "entry_id": "ae913ac0-f719-3991-9fd6-bdd90167180f",
                        "glosses": [
                            "Embezzlement."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "48576b66-fde9-440c-8022-d5456e5f6ae5",
                                "sense_id": "58d9a2b6-4eda-3e06-b392-9ec7eba652f5",
                                "text": "Granting that Mr. Ireland had gone into his office at ten minutes to ten o'clock at night for the purpose of extracting £5000 worth of notes and gold from the bank safe, whilst giving the theft the appearance of a night burglary; […] why should he, at nine o'clock the following morning, fall in a dead faint and get cerebral congestion at sight of a defalcation he knew had occurred?"
                            },
                            {
                                "example_id": "1c736057-ad87-4ec3-a18c-e6d60637d194",
                                "sense_id": "58d9a2b6-4eda-3e06-b392-9ec7eba652f5",
                                "text": "“Why should Eldridge commit murder?[…]There was only one possible motive—namely, he wished to avoid detection as James Selby of Anaconda Ltd. He had settled down in Estrepps. There were several persons in the town who had suffered from his defalcations.[…]”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eeaf4651-c939-44d0-93b9-e6c0c59a5d34",
                        "source_entry_id": "ae913ac0-f719-3991-9fd6-bdd90167180f",
                        "source_sense_description": "embezzlement",
                        "target_lang_word": "Veruntreuung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Veruntreuung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "84e762dd-9412-3e8f-9e33-fb37273f85c3",
                                        "entry_id": "a54ab8de-7c69-328e-8b8b-88f93e7765e2",
                                        "glosses": [
                                            "rechtswidrige Aneignung fremden Eigentums, das sich bereits im eigenen Besitz befindet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9d9174c-9d16-45ac-8168-52adcc888390",
                                                "sense_id": "84e762dd-9412-3e8f-9e33-fb37273f85c3",
                                                "text": "„Die Veruntreuung wurde im Rahmen der seit Herbst verstärkten Kontrollen festgestellt.“"
                                            },
                                            {
                                                "example_id": "5aebfca2-89aa-44e0-9af1-253bb88d0496",
                                                "sense_id": "84e762dd-9412-3e8f-9e33-fb37273f85c3",
                                                "text": "„Eigenmächtige und vertragswidrige Ausdehnung der Mietdauer allein begründet nicht Veruntreuung eines Mietwagens.“"
                                            },
                                            {
                                                "example_id": "43eac837-bda0-426e-baf7-f2f1e5f58ed0",
                                                "sense_id": "84e762dd-9412-3e8f-9e33-fb37273f85c3",
                                                "text": "„Der Verdacht lautet auf Betrug, ungetreue Geschäftsbesorgung, Geldwäscherei und Veruntreuung.“"
                                            },
                                            {
                                                "example_id": "b6d7d8b5-5085-4cd6-a2bf-5f6312ca6413",
                                                "sense_id": "84e762dd-9412-3e8f-9e33-fb37273f85c3",
                                                "text": "„So lese ich gerade, dass Middelhoff zu drei Jahren Haft wegen Veruntreuung verurteilt worden ist, wegen umgerechnet 750.000 Euro.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "280fcf9a-4bd8-4e9f-bfec-5fe08a2b5343",
