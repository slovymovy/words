                        ],
                        "examples": [
                            {
                                "example_id": "e9a4725e-2bcd-446b-b024-a9e6c1c1ff57",
                                "sense_id": "745a3779-560d-3e61-a6af-901b4adeca75",
                                "text": "zawierać odłącznik",
                                "translation": "to include a disconnector",
                                "english": "to include a disconnector"
                            },
                            {
                                "example_id": "47b8b8b3-16c5-491b-94c3-bbf5b16906ee",
                                "sense_id": "745a3779-560d-3e61-a6af-901b4adeca75",
                                "text": "nowoczesne odłączniki",
                                "translation": "modern disconnectors",
                                "english": "modern disconnectors"
                            },
                            {
                                "example_id": "82499d16-f872-41d2-8a3d-ef66e82b9326",
                                "sense_id": "745a3779-560d-3e61-a6af-901b4adeca75",
                                "text": "odłącznik akumulatorów/sieci trakcyjnej/wysokiego napięcia",
                                "translation": "battery/overhead line/high voltage disconnector",
                                "english": "battery/overhead line/high voltage disconnector"
                            },
                            {
                                "example_id": "e4cdba7b-9b84-4e3d-b469-068ca340a8e7",
                                "sense_id": "745a3779-560d-3e61-a6af-901b4adeca75",
                                "text": "pokrętło odłącznika",
                                "translation": "disconnector knob",
                                "english": "disconnector knob"
                            },
                            {
                                "example_id": "de347834-316c-4940-a5d8-fb598e8d28b9",
                                "sense_id": "745a3779-560d-3e61-a6af-901b4adeca75",
                                "text": "klucz do odłączników",
                                "translation": "key for disconnectors",
                                "english": "key for disconnectors"
                            },
                            {
                                "example_id": "acbf42a5-f46f-4685-ae7a-2855326c4deb",
                                "sense_id": "745a3779-560d-3e61-a6af-901b4adeca75",
                                "text": "Głównymi częściami składowymi rozdzielni wysokiego napięcia są wyłączniki, odłączniki, i szyny zbiorcze.",
                                "translation": "The main components of high-voltage switchgear are circuit breakers, disconnectors, and busbars.",
                                "english": "The main components of high-voltage switchgear are circuit breakers, disconnectors, and busbars."
                            },
                            {
                                "example_id": "3069de7c-acd1-4a75-9e00-1fc817eb653e",
                                "sense_id": "745a3779-560d-3e61-a6af-901b4adeca75",
                                "text": "Obwód główny urządzenia łukowo–rezystancyjno–elektrodowego zawiera odłącznik, wyłącznik, uzwojenie pierwotne i wtórne transformatora piecowego[…], tor wielkoprądowy, oraz elektrody.",
                                "translation": "The main circuit of the arc–resistive–electrode device includes the disconnector, the circuit breaker, the primary and secondary windings of the furnace transformer […], the high-current path, and the electrodes.",
                                "english": "The main circuit of the arc–resistive–electrode device includes the disconnector, the circuit breaker, the primary and secondary windings of the furnace transformer […], the high-current path, and the electrodes."
                            },
                            {
                                "example_id": "61e835e8-c23e-47e0-9fb2-7bce399068cc",
                                "sense_id": "745a3779-560d-3e61-a6af-901b4adeca75",
                                "text": "Sytuację poprawi wymiana ręcznych odłączników sekcyjnych na sieci na sterowane radiowo — uważa Jan Burzej.",
                                "translation": "The situation will be improved by replacing manual section disconnectors on the network with radio-controlled ones — believes Jan Burzej.",
                                "english": "The situation will be improved by replacing manual section disconnectors on the network with radio-controlled ones — believes Jan Burzej."
                            },
                            {
                                "example_id": "ef3396a7-7772-4b19-8d29-776e78bf5d18",
                                "sense_id": "745a3779-560d-3e61-a6af-901b4adeca75",
                                "text": "Po zakończeniu pracy odłączyć akumulatory przedstawiając pokrętło odłącznika akumulatorów.",
                                "translation": "When work is complete, disconnect the batteries by adjusting the battery disconnector knob.",
                                "english": "When work is complete, disconnect the batteries by adjusting the battery disconnector knob."
                            }
                        ]
                    },
