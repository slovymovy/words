                                        "glosses": [
                                            "The act by which something is launched; a launch."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12653d65-5e86-4846-bb73-0aec693b0ccd",
                                                "sense_id": "0f7a5b09-f5d5-3318-a057-fd397c4a2f39",
                                                "text": "The launching of the Titanic."
                                            },
                                            {
                                                "example_id": "e64a1fd6-0e19-4817-aefa-a318409ae62a",
                                                "sense_id": "0f7a5b09-f5d5-3318-a057-fd397c4a2f39",
                                                "text": "By 1940 they had conducted 25 successful launchings of A5 rockets, which reached 10 miles altitude and had a range of 12 miles."
                                            }
                                        ]
