                "senses": [
                    {
                        "sense_id": "724d7844-cc9e-3a9e-aea5-66bc7289b9f8",
                        "entry_id": "130a5ab5-eade-32e0-92a2-b0c6cea53d2d",
                        "glosses": [
                            "gesetzliche oder private Versicherung gegen die Folgen von Arbeitslosigkeit, im deutschen Sprachraum bei Arbeitnehmern als Pflichtversicherung ausgestaltet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8f4056a-8649-4267-9579-0a6a991b1945",
                                "sense_id": "724d7844-cc9e-3a9e-aea5-66bc7289b9f8",
                                "text": "Als Angestellte muss Franka Beiträge in die gesetzliche Arbeitslosenversicherung einzahlen."
                            },
                            {
                                "example_id": "866e99c5-b52e-4470-aadb-78cd4291e39a",
                                "sense_id": "724d7844-cc9e-3a9e-aea5-66bc7289b9f8",
                                "text": "Schon viele Politiker haben versprochen, die Beiträge zur Arbeitslosenversicherung zu senken."
                            },
                            {
                                "example_id": "4c2f1495-fdda-4605-a224-2aad52a84356",
                                "sense_id": "724d7844-cc9e-3a9e-aea5-66bc7289b9f8",
                                "text": "Olaf hat eine private Arbeitslosenversicherung abgeschlossen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7f877fe3-6afd-3c03-bc92-9abad0d2a83d",
                        "entry_id": "130a5ab5-eade-32e0-92a2-b0c6cea53d2d",
                        "glosses": [
                            "Träger der gesetzlichen Arbeitslosenversicherung (staatliche Einrichtung) oder privates Versicherungsunternehmen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "edf08fe5-28f1-4e1c-b1c2-b771d2e6a297",
                                "sense_id": "7f877fe3-6afd-3c03-bc92-9abad0d2a83d",
                                "text": "Die Arbeitslosenversicherung überwies Marina ein Jahr lang 900 Euro monatlich, danach erhielt sie nur noch Hartz IV."
