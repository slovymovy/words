                    },
                    {
                        "sense_id": "f5fc2ac0-a4d4-3a9a-99bb-bec99d5a4989",
                        "entry_id": "347a89f7-3489-31a6-ab88-b9cefd5aad74",
                        "glosses": [
                            "także o człowieku"
                        ],
                        "tags": [
                            "colloquial",
                            "ironic",
                            "offensive"
                        ],
                        "examples": [
                            {
                                "example_id": "e5a0de17-03e5-44dd-a6f5-e75199364cbb",
                                "sense_id": "f5fc2ac0-a4d4-3a9a-99bb-bec99d5a4989",
                                "text": "Gdzie znajdziemy garnitur dla takiego małpoluda jak ty?"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c35aac93-6210-4225-81bc-e56b3d3c5de9",
                        "source_entry_id": "347a89f7-3489-31a6-ab88-b9cefd5aad74",
                        "source_sense_id": "336dffe0-6b9b-31ff-b8c0-4acbf7342a56",
                        "target_lang_word": "anthropoid",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anthropoid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "adf73962-e39e-3ec2-b371-c6e872c99586",
                                        "entry_id": "d2aef2ae-3fed-3fb3-b481-3f081575dd69",
                                        "glosses": [
                                            "Having characteristics of a human, usually in terms of shape or appearance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b534a558-b181-40ea-8679-5427d6d51424",
                                                "sense_id": "adf73962-e39e-3ec2-b371-c6e872c99586",
                                                "text": "“And I am sorry for the man she loves,” said the girl, “for he loves her. I never met him, but from what Jane tells me he must be a very wonderful person. It seems that he was born in an African jungle, and brought up by fierce, anthropoid apes.”"
                                            },
                                            {
                                                "example_id": "58599b89-fd49-4cad-99b6-80d24a1205ff",
                                                "sense_id": "adf73962-e39e-3ec2-b371-c6e872c99586",
                                                "text": "The origin and development of language led to the differentiation of man from all other forms of animal life. Without this form of thought-communication and preservation man would never have achieved any higher degree of cerebration than the anthropoid ape."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60742976-31cd-33c5-88df-00d953c958b2",
                                        "entry_id": "d2aef2ae-3fed-3fb3-b481-3f081575dd69",
                                        "glosses": [
                                            "Having characteristics of a human, usually in terms of shape or appearance.",
                                            "Of the pelvis, having an anteroposterior diameter equal or exceeding the transverse diameter."
                                        ],
                                        "tags": [
                                            "in pelvimetry"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d5daf6e0-1995-3acf-84ea-1730011f55b7",
                                        "entry_id": "d2aef2ae-3fed-3fb3-b481-3f081575dd69",
                                        "glosses": [
                                            "Having characteristics of an ape."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "anthropoid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ae508e47-0958-3778-9686-4eee97631b82",
                                        "entry_id": "40ae686b-1833-3339-9e68-53dd5c93af48",
                                        "glosses": [
                                            "An anthropoid animal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8dfa906c-7238-4f74-954d-df188a119139",
                                                "sense_id": "ae508e47-0958-3778-9686-4eee97631b82",
                                                "text": "The tribe of anthropoids over which Kerchak ruled with an iron hand and bared fangs, numbered some six or eight families, each family consisting of an adult male with his females and their young, numbering in all some sixty or seventy apes."
                                            },
                                            {
                                                "example_id": "c876d366-4848-4bd8-ba7f-124497bb4c3a",
                                                "sense_id": "ae508e47-0958-3778-9686-4eee97631b82",
                                                "text": "Here and there a little group of shattered Indians marked where one of the anthropoids had turned to bay, and sold his life dearly."
                                            },
                                            {
                                                "example_id": "22eb5ef2-1747-4edf-8810-70d069c60cf0",
                                                "sense_id": "ae508e47-0958-3778-9686-4eee97631b82",
                                                "text": "Imagine for a moment that mankind, together with the printed and artistic lore of all the ages, were suddenly destroyed. Any new race of anthropoids which might arise would be in precisely the same position as the primitive races of mankind were in the days of Adam and Eve, and little better than the animals of to-day."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2a1ce9a7-58f8-420d-ab2d-501bb249e4ff",
                        "source_entry_id": "347a89f7-3489-31a6-ab88-b9cefd5aad74",
                        "source_sense_id": "336dffe0-6b9b-31ff-b8c0-4acbf7342a56",
                        "target_lang_word": "apeman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apeman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f34a9240-e7f4-3c3f-8c7f-2bac6184c1c0",
                                        "entry_id": "27ca71bf-3847-38f3-81b6-b8d89885830f",
                                        "glosses": [
                                            "A prehistoric man resembling an ape, especially one held to be a precursor to modern humans; a non-human australopithecine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96da5e1e-9ed2-4264-bd28-e9b130665f5c",
                                                "sense_id": "f34a9240-e7f4-3c3f-8c7f-2bac6184c1c0",
                                                "text": "Only above the eyebrows, where the sloping forehead and low, curved skull of the ape-man were in sharp contrast to the broad brow and magnificent cranium of the European, could one see any marked difference."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7238981b-cf1a-351c-984d-13799ae68e40",
                                        "entry_id": "27ca71bf-3847-38f3-81b6-b8d89885830f",
                                        "glosses": [
                                            "A human raised from childhood by apes (generally in reference to, or in imitation of, the fictional character Tarzan)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "638614f4-6620-4bbf-af4a-440a2a22d29c",
                                                "sense_id": "7238981b-cf1a-351c-984d-13799ae68e40",
                                                "text": "How may we judge him, by what standards, this ape-man with the heart and head and body of an English gentleman, and the training of a wild beast?"
                                            },
                                            {
                                                "example_id": "f35656fc-48b8-4c34-b066-7c7dd9b09e61",
                                                "sense_id": "7238981b-cf1a-351c-984d-13799ae68e40",
                                                "text": "Like countless other ape men, this Tarzan (who is voiced by Tony Goldwyn, but looks like a dreadlocked Calvin Klein model) is raised to feral hunkdom by a gorilla couple, Kala (Glenn Close) and Kerchak (Lance Henrikson), who disagree on the appropriateness of introducing human children to the brute society of American-accented apes."
                                            },
                                            {
                                                "example_id": "cd8153b4-81cf-4d70-85fb-5d490addd646",
                                                "sense_id": "7238981b-cf1a-351c-984d-13799ae68e40",
                                                "text": "Human Nature has as its hero a caged ape man, and, like him, it has been hanging around for quite a while awaiting release."
                                            },
                                            {
                                                "example_id": "48fd6277-aa78-45ab-9440-21c4b15d1979",
                                                "sense_id": "7238981b-cf1a-351c-984d-13799ae68e40",
                                                "text": "Apes leap to and fro, ape men swing from trees, and even a giant, menacing spider gets in on the act."
                                            },
                                            {
                                                "example_id": "76bf78a4-3629-4957-bbf2-cea9729dc1c0",
                                                "sense_id": "7238981b-cf1a-351c-984d-13799ae68e40",
                                                "text": "Weissmuller introduced the Ape Man's famous victory cry, a recorded blend of a soprano's high C, a hyena howl played backwards, a camel's bleat, the twang of a violin string and an Olympic hero bellowing at the top of his voice. It was echoed in neighbourhoods from Cardiff to California, followed by the sound of snapping arms and legs as kids toppled from trees, casualty departments packed with failed young ape men."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96e54e9f-9e97-3de3-b54a-6416893aa4e3",
                                        "entry_id": "27ca71bf-3847-38f3-81b6-b8d89885830f",
                                        "glosses": [
                                            "A reputed or legendary, large, bipedal, ape-like creature, as Bigfoot or the Yeti, or a primitive australopithecine still extant today."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
