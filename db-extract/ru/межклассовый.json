                        "translation_id": "292cfebd-a05a-4c51-bac3-e9ff6f0ce979",
                        "source_entry_id": "10baf617-cc64-3ace-aa83-aa59bc4c6664",
                        "source_sense_description": "существующий, происходящий между различными классами",
                        "target_lang_word": "intergroup",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intergroup",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "da13c047-9605-39a0-b804-e9d002b98da1",
                                        "entry_id": "38ec26f0-d8fa-3a86-b862-a64df5762c44",
                                        "glosses": [
                                            "Taking place between groups, especially between social groups."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1ad22a3-91f0-4d06-b9e3-76c70411dc9d",
                                                "sense_id": "da13c047-9605-39a0-b804-e9d002b98da1",
                                                "text": "And because people derive personal esteem and meaning from their group memberships, they are naturally inclined to evaluate their ingroups positively in comparison to outgroups. When an ingroup’s dominant social position is secure or not contested by lower-status outgroups, intergroup harmony is expected to prevail. But when perceived as illegitimate and/or challenged by other groups, ingroup members can be expected to defend their group’s social position by engaging in pro-ingroup and/or anti-outgroup behaviors."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "intergroup",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "03bc4d52-d54c-3ba1-b08d-77eb9a494938",
                                        "entry_id": "96821088-9744-33a4-bb5f-d37cfb945121",
                                        "glosses": [
                                            "A group of members of the European Parliament of no particular party or committee, to facilitate the exchange of views."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34838628-f86e-4644-9c0f-ffd930c7af21",
                                                "sense_id": "03bc4d52-d54c-3ba1-b08d-77eb9a494938",
                                                "text": "Often compared to non-governmental organizations (NGOs) or associations, intergroups are also similar to lobbying groups because they receive external assistance in the form of financial and/or secretarial support."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
