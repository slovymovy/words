                                    {
                                        "sense_id": "1096f327-870d-3cb8-a6c5-31dce73373a7",
                                        "entry_id": "d0d7e267-1b05-3878-a75c-e2e5fc95f362",
                                        "glosses": [
                                            "Fine couche de cellules vivantes située à l’intérieur de l’endoderme, délimitant le cylindre central des racines, et jouant un rôle central dans la formation des racines secondaires. Il participe également, de manière secondaire, à la circulation de l’eau et des solutés."
                                        ],
                                        "tags": [
                                            "Histologie végétale"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "890fefff-9005-4cd5-8d90-a6b11bf4ca2f",
                                                "sense_id": "1096f327-870d-3cb8-a6c5-31dce73373a7",
                                                "text": "Les racines secondaires issues du péricycle, situé autour du faisceau conducteur, permettent d'accroître l'étendue du tissu racinaire."
                                            },
                                            {
                                                "example_id": "3374fbb5-250c-46ca-86c8-304564f98ff4",
                                                "sense_id": "1096f327-870d-3cb8-a6c5-31dce73373a7",
                                                "text": "Le péricycle n’est souvent constitué que de cellules parenchymales, mais le sclérenchyme peut être présent."
                                            }
                                        ]
                                    }
                                ]
                            }
