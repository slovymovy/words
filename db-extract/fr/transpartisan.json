                        "cross_references": [
                            {
                                "target_word": "parteiübergreifend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "efa52ebc-03e4-3e51-a036-11af81d3dcd6",
                                        "entry_id": "50e8fb16-aad3-31b7-afbb-ce49cc85486e",
                                        "glosses": [
                                            "mehr als eine Partei betreffend; mehrere Parteien umfassend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1833982-4ed6-44ac-b2fd-c963cd44fdcc",
                                                "sense_id": "efa52ebc-03e4-3e51-a036-11af81d3dcd6",
                                                "text": "„Trotz des parteiübergreifenden Kompromisses in der Sache wurden die redaktionellen Verbesserungen zu einer Frage von Sieg oder Niederlage und ein verschwurbelter Gesetzeswortlaut unter dem Vorwand der Normenkontinuität zu einer parteipolitischen Prestigefrage.“"
                                            },
                                            {
                                                "example_id": "0abf6570-9338-4112-8804-07771e833730",
                                                "sense_id": "efa52ebc-03e4-3e51-a036-11af81d3dcd6",
                                                "text": "„Parteiübergreifend empören sich Abgeordnete über die Arroganz des Regierungschefs und seiner Minister.“"
                                            },
                                            {
                                                "example_id": "9e2bc591-d27c-4d50-9d37-cb8f9f70189f",
                                                "sense_id": "efa52ebc-03e4-3e51-a036-11af81d3dcd6",
                                                "text": "„In Deutschland fordern Politiker parteiübergreifend eine Impfpflicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b0c4282e-b469-4b2f-981b-4c6ba7f509cc",
                        "source_entry_id": "9c50f5fa-5541-3a7b-a094-eb0fe39b202c",
                        "source_sense_id": "f6b088c1-d27b-3fd9-8dc0-c53af073c4a1",
