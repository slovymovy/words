                ],
                "senses": [
                    {
                        "sense_id": "617f38fc-cca3-34a9-b7e2-04a688b9fbc5",
                        "entry_id": "a85390dd-acf9-3862-a5aa-9d11fffb943d",
                        "glosses": [
                            "uitkomen met een lage kaart of met een laag bod in een bepaalde kleur als teken aan je partner dat je nog meer hoge kaarten in die kleur hebt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e99de24-3b76-444f-9d2c-06ca0f399874",
                                "sense_id": "617f38fc-cca3-34a9-b7e2-04a688b9fbc5",
                                "text": "Oost heeft een vijfkaart troef, enorme aftroefwaarde en een behoorlijke tweede kleur. Alles bij elkaar opgeteld meer dan voldoende voor de manche. Overigens zal west ook ingaan op een eventuele invite."
                            },
                            {
                                "example_id": "a0a1185c-bcad-4a14-9f3e-c5c72dbd5c1c",
                                "sense_id": "617f38fc-cca3-34a9-b7e2-04a688b9fbc5",
                                "text": "Ondanks zijn driekaart schoppen mee liet hij de 5-3 schoppenfit voor wat het was en gaf met 2SA een invite voor 3SA!"
                            }
                        ]
                    },
                    {
                        "sense_id": "93b5347d-0e61-396e-8974-60be9a7947f6",
                        "entry_id": "a85390dd-acf9-3862-a5aa-9d11fffb943d",
                        "glosses": [
                            "een opening in je verdediging laten vallen om een bepaalde reactie van je tegenstander uit te lokken"
                        ],
                        "tags": [
                            "schermen"
                        ],
                        "examples": [
                            {
                                "example_id": "fdf918e0-1309-4456-9d2c-1076ec32aa0a",
                                "sense_id": "93b5347d-0e61-396e-8974-60be9a7947f6",
                                "text": "De derobement op handhouding 6 als invite. Op het ijzercontact willen maken van de tegenstander wordt er ontweken en direct de aanval geplaatst."
                            },
                            {
                                "example_id": "89679a7b-e88e-4f31-a3a0-65ddeb28989a",
                                "sense_id": "93b5347d-0e61-396e-8974-60be9a7947f6",
                                "text": "Staat men tegenover een tegenstander, die gaarne rechtstreeksche steken toebrengt, dan zal men door een invite of slag gevolgd door het loslaten van de voeling, deze uitlokken, om te kunnen weren en riposteeren."
                            }
                        ]
                    },
                    {
                        "sense_id": "d6542b95-748a-3bc4-81be-17fc40e995e5",
                        "entry_id": "a85390dd-acf9-3862-a5aa-9d11fffb943d",
                        "glosses": [
                            "hint in vragende vorm, vraag die eigenlijk bedoeld is als een indirecte aansporing"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "3d71b8d9-342f-45b6-81d9-d20cbf75603f",
                                "sense_id": "d6542b95-748a-3bc4-81be-17fc40e995e5",
                                "text": "Een hoge jongensstem gierde over de hei: ‘Nou, wat mot je van me? Hè, wat mot je? Nou zeg dan op, wat je van me mot. Zeg het dan, wat je van me...’ Maar voor het flanelletje, tot wie deze invite was gericht, er met enige welgekozen woorden op kon ingaan, lagen al het rooie shirt en het flanelletje tegen de vlakte. De rest moedigde aan: ‘Hup dan Koos, hup dan Japie...’"
                            }
                        ]
                    }
