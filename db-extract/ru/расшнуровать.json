                                        "glosses": [
                                            "To remove the knot from laces; to undo laces."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cde1a7ce-5c0a-45fd-8a76-3ee24b0a27ef",
                                                "sense_id": "ab8467c0-b3c1-3429-b03e-7ade91da93ca",
                                                "text": "Unlace your shoes before taking them off."
                                            },
                                            {
                                                "example_id": "4025f782-b51d-4a73-8e89-94f995987482",
                                                "sense_id": "ab8467c0-b3c1-3429-b03e-7ade91da93ca",
                                                "text": "Bradly tapped the ashes from his pipe, signifying a leisured interlude over. \"Time to get a move on,\" he said, and began to unlace his boots for wading."
                                            }
                                        ]
                                    },
                                    {
