                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ffa03107-9b2c-3a48-a571-e0520a54266f",
                                        "entry_id": "4711b71c-a889-335b-8abf-d8b51c5cc9cb",
                                        "glosses": [
                                            "Having the authority or capability to make a selection."
                                        ],
                                        "tags": [
