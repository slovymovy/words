                "senses": [
                    {
                        "sense_id": "c9a77b80-beec-31ad-841f-db8dfaae0fd2",
                        "entry_id": "67ddf0bd-d8af-3193-b00f-7da971c7900a",
                        "glosses": [
                            "door paarden getrokken wagen die men gebruikt bij een wedstrijd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ec78815-fb51-4b8f-a523-b0d93ae206dc",
                                "sense_id": "c9a77b80-beec-31ad-841f-db8dfaae0fd2",
                                "text": "In de aflevering met Mary Dresselhuys ging het overigens óók over een verboden liefde. Een adellijke weduwe beziet de tuinman op zijn tractor... zo bespiedt Phaedra prins Hippolytus op zijn renwagen."
                            },
                            {
                                "example_id": "39bb2859-208e-419a-84e1-e95e1c03309a",
                                "sense_id": "c9a77b80-beec-31ad-841f-db8dfaae0fd2",
                                "text": "Kinderen maken een rit in de Romeinse renwagen, doen mee met allerlei spellen, leren Latijn in de Romeinse school en tonen hun creatieve talenten."
                            }
                        ]
                    },
                    {
                        "sense_id": "223d3cf2-ede2-3dbe-8995-e6e496f082a8",
                        "entry_id": "67ddf0bd-d8af-3193-b00f-7da971c7900a",
                        "glosses": [
                            "raceauto"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be483535-7196-419c-9426-322efb449e86",
                                "sense_id": "223d3cf2-ede2-3dbe-8995-e6e496f082a8",
                                "text": "Enzo Ferrari zag de motor nog als het belangrijkste deel van een renwagen, niet het chassis. Maar de geavanceerde aerodynamica heeft de Formule I-wereld volledig op zijn kop gezet."
                            },
                            {
                                "example_id": "96b332c1-396d-4130-a2f0-503dd46f2cf1",
                                "sense_id": "223d3cf2-ede2-3dbe-8995-e6e496f082a8",
                                "text": "Maar ook virtueel racen in de BMW-renwagen van Formule 1-coureur Nick Heidfeld in de beruchte Nordschleife, het bochtenstelsel op de Nürburgring, is een absolute topper onder de jeugd."
                            }
                        ]
                    }
