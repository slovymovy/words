                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intolérablement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ef41c774-9d6e-3d57-a3ec-fb92a3ec0f4e",
                                        "entry_id": "cbecf00e-5aea-32a4-9b31-006eba65d915",
                                        "glosses": [
                                            "D’une manière intolérable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "533b7a73-c924-4fc1-9d38-4000c976d2b4",
                                                "sense_id": "ef41c774-9d6e-3d57-a3ec-fb92a3ec0f4e",
                                                "text": "Pour la troisième fois, et sur un ton intolérablement agressif, il réitéra son insolente question. Un silence gros de danger suivit."
                                            },
                                            {
                                                "example_id": "7be1d82f-492e-44d5-bac1-b88a3193bb02",
                                                "sense_id": "ef41c774-9d6e-3d57-a3ec-fb92a3ec0f4e",
                                                "text": "Encore que quelques phrases soient intolérablement mal écrites. Proust dit toujours exactement ce qu’il veut dire. Et c’est parce qu’il y parvient si bien qu’il s’y complaît."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d8a43c9c-3d77-4981-b109-04fc439db2d8",
                        "source_entry_id": "4594bb68-f4bc-3363-97d0-220e93a057c5",
                        "source_sense_id": "7166d5c4-7a92-391b-92ec-bd7fd52798f2",
                        "target_lang_word": "insupportablement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "insupportablement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "955a189f-2343-3d73-aeac-367b763583c8",
                                        "entry_id": "20f29134-8c12-3750-90c2-9926a21438f6",
                                        "glosses": [
                                            "D’une manière insupportable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "363fbb31-9aa9-4724-92f4-5dc54fa738d7",
                                                "sense_id": "955a189f-2343-3d73-aeac-367b763583c8",
                                                "text": "Tout deviendra insupportablement si cher à Paris, qu’il n’y aura plus de moyen d’y demeurer."
                                            },
                                            {
                                                "example_id": "043451ae-901a-4565-8724-d47f4db40edd",
                                                "sense_id": "955a189f-2343-3d73-aeac-367b763583c8",
                                                "text": "César éclata d’un rire aussitôt étouffé. Insupportablement théâtral, ce matin, pensa Julia."
                                            },
                                            {
                                                "example_id": "23ae4ff9-19c0-4a19-8bf9-c6fff35c3709",
                                                "sense_id": "955a189f-2343-3d73-aeac-367b763583c8",
                                                "text": "Ils étaient insupportablement jeunes et beaux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
