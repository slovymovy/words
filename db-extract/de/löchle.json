                ],
                "senses": [
                    {
                        "sense_id": "2014b052-d2e8-3ce1-8d92-dfdd0f58a2ee",
                        "entry_id": "a522ee91-4582-3e2a-a622-87b950c22256",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2e31d2e-9baf-429d-9cdd-b86be6d0ed52",
                                "sense_id": "2014b052-d2e8-3ce1-8d92-dfdd0f58a2ee",
                                "text": "Frau Löchle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "e9fff4fc-dd07-4a1f-afe5-ed07f5cb1bf5",
                                "sense_id": "2014b052-d2e8-3ce1-8d92-dfdd0f58a2ee",
                                "text": "Herr Löchle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "eec8e2eb-1ec6-4f7e-bf65-6cd50c630af5",
                                "sense_id": "2014b052-d2e8-3ce1-8d92-dfdd0f58a2ee",
                                "text": "Die Löchles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "3e6b1b07-6ad8-44de-b793-9ad35535d146",
                                "sense_id": "2014b052-d2e8-3ce1-8d92-dfdd0f58a2ee",
                                "text": "Der Löchle trägt nie die Schals, die die Löchle ihm strickt."
                            },
                            {
                                "example_id": "b5b155c4-556a-490e-ae96-729e885bec5d",
                                "sense_id": "2014b052-d2e8-3ce1-8d92-dfdd0f58a2ee",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Löchle kommt, geht der Herr Löchle.“"
                            },
                            {
                                "example_id": "07e09e33-b8ce-435f-85c7-4795879bb485",
                                "sense_id": "2014b052-d2e8-3ce1-8d92-dfdd0f58a2ee",
                                "text": "Löchle kommt und geht."
                            },
                            {
                                "example_id": "8a1f97a2-a6a6-4848-95f0-918b1164856a",
                                "sense_id": "2014b052-d2e8-3ce1-8d92-dfdd0f58a2ee",
                                "text": "Löchles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
