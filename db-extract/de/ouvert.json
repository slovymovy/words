                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a017c39d-96b3-3eb9-8565-90f4aa6db24a",
                                        "entry_id": "43924013-813a-332b-ae3a-97320dd4c4cf",
                                        "glosses": [
                                            "Qualifie une ville qui n’a pas de fortifications ou dont l’armée n’assure pas la défense, en laissant l’ennemi l’investir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
