                "senses": [
                    {
                        "sense_id": "6543e290-c33f-3aed-af8b-04d46ba7daba",
                        "entry_id": "35b526a9-3537-3b56-93f2-bee05baed140",
                        "glosses": [
                            "Knoten zum Verbinden von gleich dicken Tauen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb435d55-ee57-43ef-8f51-cd6f835c24a0",
                                "sense_id": "6543e290-c33f-3aed-af8b-04d46ba7daba",
                                "text": "„Außerdem banden sie Knoten wie den sogenannten Mastwurf, Zimmermannsschlag, Schotenstich und Kreuzknoten.“"
                            },
                            {
                                "example_id": "29f160c2-c6ee-4698-8133-8fa7ffb2b067",
                                "sense_id": "6543e290-c33f-3aed-af8b-04d46ba7daba",
                                "text": "„Es gibt Jungen in der Truppe des Sportlehrers, die ein besonderes Training erhalten, Campingausflüge machen und nach der Schule in seinem Büro Kreuzknoten lernen dürfen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
