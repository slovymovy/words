                ],
                "senses": [
                    {
                        "sense_id": "7a9cc822-0555-3f25-b76d-540c81a42a14",
                        "entry_id": "ece4c113-a2c1-3122-bcb5-e214cdc19296",
                        "glosses": [
                            "Mourir."
                        ],
                        "tags": [
                            "dated",
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "a3ef8509-1a8d-46d8-9c4f-e34619a63373",
                                "sense_id": "7a9cc822-0555-3f25-b76d-540c81a42a14",
                                "text": "S’il ne suffit pas à la tâche, s’il flanche, — ou si, par catastrophe plus radicale encore, il défuncte en cours de route — c’en sera fait : toute la nichée passera l’arme à gauche !"
                            },
                            {
                                "example_id": "16413a84-d6a7-49fb-bf53-78782e89a2fa",
                                "sense_id": "7a9cc822-0555-3f25-b76d-540c81a42a14",
                                "text": "Selon « la discipline républicaine », le Parti Communiste se désiste pour le socialiste arrivé en tête, et réciproquement, même si l’union de la gauche bat de plus en plus de l’aile jusqu’à défuncter."
                            },
                            {
                                "example_id": "4cf49df5-1161-4f67-a88d-3276855676d3",
                                "sense_id": "7a9cc822-0555-3f25-b76d-540c81a42a14",
                                "text": "Comment est-il arrivé là-bas, son grand-oncle qui vient de défuncter ?"
                            }
                        ]
                    }
                ],
