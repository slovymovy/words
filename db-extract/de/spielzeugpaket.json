                "senses": [
                    {
                        "sense_id": "abd1f2a1-1600-36d3-97f5-6ba1786803ad",
                        "entry_id": "17958778-80ff-3a1b-a687-e96cf6d4e238",
                        "glosses": [
                            "Paket, das Spielzeug enthält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1dd09c3b-612f-4c86-9a37-22eae5dac903",
                                "sense_id": "abd1f2a1-1600-36d3-97f5-6ba1786803ad",
                                "text": "„An einem Tag werden auf die Demokratische Republik Vietnam 200 Tonnen Bomben und 10 000 Spielzeugpakete abgeworfen. Das Spielzeug soll den kleinen Nordvietnamesen das Herbstkinderfest verschönen.“"
                            },
                            {
                                "example_id": "2bf93ab3-f269-42e9-a7d3-0747771c0636",
                                "sense_id": "abd1f2a1-1600-36d3-97f5-6ba1786803ad",
                                "text": "„Durch Post meiner Eltern hatte ich erfahren, daß mein Cousin aus Wallensen, Sie wissen noch, der zu Weihnachten immer ein Spielzeugpaket von uns bekam, z.Zt. in Kertsch lag.“"
                            },
                            {
                                "example_id": "51f57e9d-0c7d-43cf-8f3a-ef9f714516df",
                                "sense_id": "abd1f2a1-1600-36d3-97f5-6ba1786803ad",
                                "text": "„Mary hatte, wie es schien aus Versehen, mit dem Ellbogen eines der Spielzeugpakete vom Tisch gestreift.“"
                            },
                            {
                                "example_id": "254a5caf-9e6c-4229-b260-96f9741aed81",
                                "sense_id": "abd1f2a1-1600-36d3-97f5-6ba1786803ad",
                                "text": "„Zu den täglichen Blumensendungen und Geschenken kamen jetzt auch Spielzeugpakete für Grace hinzu, die Lincoln vom ersten Augenblick an ins Herz geschlossen hatte.“"
                            },
                            {
                                "example_id": "47cbb691-10aa-4bb5-adf9-28078101e406",
                                "sense_id": "abd1f2a1-1600-36d3-97f5-6ba1786803ad",
                                "text": "„Die kostenlosen Spielzeugpakete, die von einzelnen Spielwarenherstellern zur Verfügung gestellt werden, übergeben Fachhändler an die Einrichtungen und übernehmen eine Spielepatenschaft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
