                "forms": [],
                "senses": [
                    {
                        "sense_id": "b7ccdd47-6e51-3365-abde-ecdcbcd972e9",
                        "entry_id": "c8eef2eb-edc9-381d-a109-18f25f627f27",
                        "glosses": [
                            "Partie supérieure du mât."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "293a22b0-e028-4b8a-8578-3a01d841baac",
                                "sense_id": "b7ccdd47-6e51-3365-abde-ecdcbcd972e9",
                                "text": "бом, на морском языке, перед названием какой-либо части корабельного вооружения, означает принадлежность его к четвертому или высшему колену мачт; нижнее колено, мачта; второе, стеньга.",
                                "translation": "Bom, en langage naval, devant le nom d’une partie quelconque de l’armement d’un navire, signifie qu’il appartient au quatrième ou au plus haut grade de mâts."
                            }
                        ]
                    },
                    {
                        "sense_id": "ad08a226-2dc4-354e-a520-16692965aa32",
                        "entry_id": "c8eef2eb-edc9-381d-a109-18f25f627f27",
                        "glosses": [
                            "Barrière, barrage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7852017d-53c6-4c78-ac6b-cc8938fbaeb9",
                                "sense_id": "ad08a226-2dc4-354e-a520-16692965aa32",
                                "text": "Бом или бон м. нем. гол. застава, запор, заворы, для временной задержки путников; шлагбаум, шлагбон, шламбов, застава из поперечного через дорогу бревна́, лежащего на перевесе; запор, перевес, журав, очеп."
                            }
                        ]
                    }
