                ],
                "senses": [
                    {
                        "sense_id": "c0a65058-02ea-3101-b49b-0e33fdc339a3",
                        "entry_id": "25307d9e-bc4d-3c4a-8f20-125f24b39707",
                        "glosses": [
                            "Que l’on peut raconter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b4fff95-35e0-450c-b19d-031375a2cb56",
                                "sense_id": "c0a65058-02ea-3101-b49b-0e33fdc339a3",
                                "text": "Vous sentez que je ne puis vous raconter de l’histoire de Léonie et de Jean-Louis que ce qu’il y a de racontable ; c’est pourquoi je me dispenserai d’entrer dans des détails fort ennuyeux pour vous et pour moi."
                            },
                            {
                                "example_id": "7b224cc5-7ed5-419a-9433-43dcdcbad43d",
                                "sense_id": "c0a65058-02ea-3101-b49b-0e33fdc339a3",
                                "text": "La nullité n’est pas racontable, la dérision n’est pas racontable, la bêtise n’est pas racontable — cet événement même, au bout du compte, étant des plus douteux."
                            },
                            {
                                "example_id": "0a1f7718-9b5c-4f5a-b01c-32d3d28facd0",
                                "sense_id": "c0a65058-02ea-3101-b49b-0e33fdc339a3",
                                "text": "Les vraies sensations diffractées mais insistantes ne sont pas racontables, ce sont de petits tourments sans visage ; on ne peut s’appuyer sur rien."
                            }
                        ]
                    }
                ],
