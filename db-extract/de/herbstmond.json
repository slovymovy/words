                "senses": [
                    {
                        "sense_id": "64ef80cb-9464-3f0c-aebe-501b908d400d",
                        "entry_id": "ac5ada2f-1872-3ea2-b10a-8782a05a5590",
                        "glosses": [
                            "Mond im Herbst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ce60b8d-380c-4f98-8fb7-ef9490851f03",
                                "sense_id": "64ef80cb-9464-3f0c-aebe-501b908d400d",
                                "text": "„Doch der Herbstmond schien nur schwach und fahl, deshalb waren wir uns dessen nicht sicher.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c43b4615-7e0b-33e7-b352-569caaef9fe5",
                        "entry_id": "ac5ada2f-1872-3ea2-b10a-8782a05a5590",
                        "glosses": [
                            "Monat, in dem die dritte, kühle Jahreszeit, der Herbst beginnt, Monat des ersten Vollmondes nach dem Sommer: September"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "42208163-ce80-470c-a7a9-7b4be20bc68f",
                                "sense_id": "c43b4615-7e0b-33e7-b352-569caaef9fe5",
                                "text": "„Aber ob Johanne auch vermeinte, die traurigen Tage trügen Blei an den Füßen, […] sie gingen doch dahin, und der milde Herbstmond war da, ehvor sie sich dessen versah. Die Blätter, die im Lenz frisch grün herfür gesproßt waren, färbten sich falb, die Blüthen reiften zu Früchten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
