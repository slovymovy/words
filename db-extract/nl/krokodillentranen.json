                "translations": [
                    {
                        "translation_id": "fac8dd78-0889-4a56-907c-de528087a962",
                        "source_entry_id": "1a81cbbb-3242-3942-a27e-3c39e750cc99",
                        "source_sense_id": "e2a07755-eef0-35d9-9887-4e83c2dfa799",
                        "source_sense_description": "uitingen van gespeeld verdriet of berouw",
                        "target_lang_word": "Krokodilsträne",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Krokodilsträne",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8e0e9677-fbb0-3d59-bbc3-e3ff85f3ba0b",
                                        "entry_id": "680ab65e-9e4f-3cef-926d-ae396fce838f",
                                        "glosses": [
                                            "eine Mitgefühl und echte Betroffenheit heuchelnde Träne"
                                        ],
                                        "tags": [
                                            "figurative",
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9552bc3-b3c3-4334-bd7a-29886979c379",
                                                "sense_id": "8e0e9677-fbb0-3d59-bbc3-e3ff85f3ba0b",
                                                "text": "Das sind ja bloß Krokodilstränen."
                                            },
                                            {
                                                "example_id": "a9b632e2-def0-4e98-8d5c-98de0f439954",
                                                "sense_id": "8e0e9677-fbb0-3d59-bbc3-e3ff85f3ba0b",
                                                "text": "»Auch wenn du jetzt Krokodilstränen heulst: ich glaube dir kein Wort!«"
                                            },
                                            {
                                                "example_id": "8f89dc16-33f1-4940-943d-72308970f997",
                                                "sense_id": "8e0e9677-fbb0-3d59-bbc3-e3ff85f3ba0b",
                                                "text": "„Kommentar: Schickt Fähren übers Mittelmeer! […] In einer ungewöhnlich offenen Stellungnahme hat die EU-Kommission alle Staaten, aber auch ihre Bürger aufgerufen, nicht länger Krokodilstränen zu vergießen, sondern zu handeln.“"
                                            },
                                            {
                                                "example_id": "144dce00-4227-44b2-ba8e-732e14527c25",
                                                "sense_id": "8e0e9677-fbb0-3d59-bbc3-e3ff85f3ba0b",
                                                "text": "[…] jemand [Uli Hoeneß], der Steuern in zweistelliger Millionenhöhe hinterzogen hat, ist als Präsident [des FC Bayern München] nicht mehr tragbar - Krokodilstränen hin oder her."
                                            },
                                            {
                                                "example_id": "3eaf9669-eb85-44c3-b771-a28664db4749",
                                                "sense_id": "8e0e9677-fbb0-3d59-bbc3-e3ff85f3ba0b",
                                                "text": "[…] jeder [erkennt] auf den ersten Blick am Hals eine Drosselmarke. Und diese Drosselmarke ist bei der Leichenschau nicht erkannt worden […]. […] hätten die Angehörigen jetzt hier dem Verstorbenen einen Rollkragenpullover angezogen und ihn im offen Sarg aufgebaut, hätten sie noch Krokodilstränen vergießen können, dann wäre dieses Tötungsdelikt nicht entdeckt worden."
                                            },
                                            {
                                                "example_id": "3cd1cdeb-4537-49e3-a1dc-4317639e1076",
                                                "sense_id": "8e0e9677-fbb0-3d59-bbc3-e3ff85f3ba0b",
                                                "text": "„Für die kritischen Stimmen, die man in den letzten Tagen aus dem Wallis hört und die einen Ausverkauf der Heimat beklagen, zeigt Theler wenig Verständnis. Das sei nur Show. «Da werden zwar Krokodilstränen vergossen, aber ich sehe auch, wie zögerlich die Leute hier ihre Geldbeutel öffnen.»“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
