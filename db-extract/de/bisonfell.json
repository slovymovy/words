                "senses": [
                    {
                        "sense_id": "91c71110-7572-34ec-ae1d-0d9fff984306",
                        "entry_id": "0f8a5def-90c0-3929-ade2-be7144cc7c01",
                        "glosses": [
                            "(abgezogenes) Fell eines Bisons"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2cef280d-6207-436d-844e-08910e5d8571",
                                "sense_id": "91c71110-7572-34ec-ae1d-0d9fff984306",
                                "text": "„Die Kundschafter entdeckten an einem Hügelhang auf einem Bisonfell die fünfjährige Adelaide und die siebenjährige Julia German, die von den verfolgten Cheyennes zurückgelassen worden waren.“"
                            },
                            {
                                "example_id": "6cb7ba13-4191-416d-8e15-17521d1cfb16",
                                "sense_id": "91c71110-7572-34ec-ae1d-0d9fff984306",
                                "text": "„In umgekehrter Richtung stieg die Abhängigkeit der monokulturellen Ausbeutung der Bisons von nicht kontrollierbaren Marktfaktoren weiter an, als nach etwa 1830 Bisonfelle und -häute im Cross-frontier-Handel wichtiger als Fleischprodukte wurden.“"
                            },
                            {
                                "example_id": "3e804764-5427-42bd-96c1-a9b1115eb1ac",
                                "sense_id": "91c71110-7572-34ec-ae1d-0d9fff984306",
                                "text": "„Ursprünglich mit Bisonfellen bedeckt, war das leicht zu errichtende kegelförmige Stangenzelt bei den nomadisierenden Plains- und Präriestämmen zwischen Mississippi-Missouri und Felsengebirge die übliche Wohnform.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
