                                "target_senses": [
                                    {
                                        "sense_id": "c46e1eb7-affc-3fa7-84ba-94361834ef5e",
                                        "entry_id": "c03350f7-2471-3c5c-9473-fa1b8ed2a3bc",
                                        "glosses": [
                                            "von eigenen Ideen erfüllt (die auch ungewöhnlich und befremdlich sein können); auf eigenen Ideen bestehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "784d88a3-af01-4fe0-9738-36b8a21a06ea",
                                                "sense_id": "c46e1eb7-affc-3fa7-84ba-94361834ef5e",
                                                "text": "\"Eigenwillig ist Sean Penn noch immer, dabei allerdings mehr als erfolgreich und das nicht nur als Schauspieler.\""
                                            },
                                            {
                                                "example_id": "cb2a8962-59f6-478d-9203-6301e0fb4f17",
                                                "sense_id": "c46e1eb7-affc-3fa7-84ba-94361834ef5e",
