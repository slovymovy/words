        "fr-extract.jsonl": [
            {
                "entry_id": "aabed6be-ecf2-34fa-8d07-dece47a022ee",
                "word": "caban",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "460e0675-73ed-4b2b-9073-bf8e9cd6f110",
                        "entry_id": "aabed6be-ecf2-34fa-8d07-dece47a022ee",
                        "tags": [
                            "plural"
                        ],
                        "form": "cabans"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0aa63fa0-f54b-3a4d-b58d-4d4ff6252b99",
                        "entry_id": "aabed6be-ecf2-34fa-8d07-dece47a022ee",
                        "glosses": [
                            "Vêtement de dessus avec des manches et un capuchon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a72c3b10-9f83-406b-b8dc-b30cbc34800a",
                                "sense_id": "0aa63fa0-f54b-3a4d-b58d-4d4ff6252b99",
                                "text": "Un individu s’approche pourtant, un brave homme vêtu d’un caban rapiécé."
                            },
                            {
                                "example_id": "e077b5d2-44dd-4f16-a7b7-4b34b61a919f",
                                "sense_id": "0aa63fa0-f54b-3a4d-b58d-4d4ff6252b99",
                                "text": "Devant cette Anglaise, je me sentis tout honteux de n’avoir ni gants blancs, ni lorgnon, ni souliers vernis, et je jetai un regard confus sur les broderies extravagantes de mon caban bleu de ciel. Pour la première fois, depuis six mois, je compris que je n’étais pas convenable, et que je n’avais pas l’air gentleman."
                            },
                            {
                                "example_id": "ef5e9edd-fcec-4101-bdd4-73d92221dfd1",
                                "sense_id": "0aa63fa0-f54b-3a4d-b58d-4d4ff6252b99",
                                "text": "Je me penche pour ramasser son caban. Elle me lorgne, l’œil narquois, méchant pour tout dire. Son caban sous le bras, je me dirige vers la porte. Je l’ouvre. Je flanque le caban sur le palier. Je détends le bras pour l’inviter à quitter le studio."
                            },
                            {
                                "example_id": "f901e773-1f2c-470f-b77e-6d2cd22ea49d",
                                "sense_id": "0aa63fa0-f54b-3a4d-b58d-4d4ff6252b99",
                                "text": "Malgré les souffrances physiques que j’endure au moment où je trace ces lignes, je me souviens non sans une mélancolie amusée de l’abominable caban bleu marine dont m’affublait l’autrice de mes jours sans tenir compte de mes supplications : […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "fb129a5a-b701-329c-9cb6-0d9f146e7cd6",
                        "entry_id": "aabed6be-ecf2-34fa-8d07-dece47a022ee",
                        "glosses": [
                            "Manteau-capote de laine foncée couverte de toile imperméable, parfois accompagné d’une capuche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6265368-ce56-40e7-819f-4ef65ccb6543",
                                "sense_id": "fb129a5a-b701-329c-9cb6-0d9f146e7cd6",
                                "text": "Son caban de matelot, bleu marine, arrêté aux genoux, lui donnait un air de collégien en uniforme de sortie."
                            }
                        ]
                    },
                    {
                        "sense_id": "f05eb096-54dc-3555-a928-0e5691022d0b",
                        "entry_id": "aabed6be-ecf2-34fa-8d07-dece47a022ee",
                        "glosses": [
                            "Étoffe de laine foulonnée rendue imperméable par la conservation d’une partie du suint, utilisée notamment pour la confection de chapeaux et de vêtements de marin."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "076f14ec-cfab-40e7-8d11-9a192eebeb14",
                        "source_entry_id": "aabed6be-ecf2-34fa-8d07-dece47a022ee",
                        "target_lang_word": "pea jacket",
