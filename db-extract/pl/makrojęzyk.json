                    },
                    {
                        "translation_id": "4607a984-77ae-4232-a2a7-db6881ed5fd2",
                        "source_entry_id": "92e38c81-85f6-3c0c-bef6-8d447cfae1a6",
                        "source_sense_id": "b237c932-990c-397a-9827-e64ca7e29756",
                        "target_lang_word": "Makrosprache",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Makrosprache",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b8a5e56e-e14e-370d-9407-5bd4bba06f4e",
                                        "entry_id": "dc1a658b-7546-3e3b-9fc0-c86d3be2905d",
                                        "glosses": [
                                            "Programmiersprache, mit der Makros (eine Abfolge von Befehlen oder Aktionen) geschrieben werden können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4ee3391-51b4-4553-9968-692a599b888d",
                                                "sense_id": "b8a5e56e-e14e-370d-9407-5bd4bba06f4e",
                                                "text": "„Aus solchen und ähnlichen Bedürfnissen heraus entstand über die verschiedenen Excel-Versionen eine Programmiersprache, oder genauer gesagt eine Makrosprache.“"
                                            },
                                            {
                                                "example_id": "0ae90022-248a-4313-8e7f-d0590b064ca9",
                                                "sense_id": "b8a5e56e-e14e-370d-9407-5bd4bba06f4e",
                                                "text": "„Die meisten Programmpakete wie z. B. Microsoft Office oder Lotus SmartSuite verfügen jeweils über eine eigene Makrosprache (Visual Basic for Applications oder LotusScript).“"
                                            },
                                            {
                                                "example_id": "5df497e9-7843-4954-8ca6-24a0b90f0792",
                                                "sense_id": "b8a5e56e-e14e-370d-9407-5bd4bba06f4e",
                                                "text": "„Bezieht man eine Word-Datei von einem fremden Rechner, so kann ein in der Makrosprache geschriebener Virus darin enthalten sein (Makrovirus), der im Dokument nicht als Text sichtbar ist“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
