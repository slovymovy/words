    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fb782df5-a828-3014-b960-aabeccf455a1",
                    "sense_definition": "Mettre en tas des objets les uns sur les autres.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "accumulation_materielle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a passé l'après-midi à <w>entasser</w> des bûches près de la cheminée."
                        },
                        {
                            "text": "Nous devons <w>entasser</w> soigneusement ces vieux cartons pour gagner de la place."
                        }
                    ],
                    "synonyms": [
                        "empiler"
                    ],
                    "common_phrases": [
                        "entasser des bûches",
                        "entasser des cartons"
                    ]
                },
                {
                    "sense_id": "dc3dcda4-d199-33f1-8e9c-411b0b052d9d",
                    "sense_definition": "Accumuler ou ranger des choses sans ordre et pêle-mêle.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "accumulation_materielle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a fini par <w>entasser</w> du linge sale sur le fauteuil de sa chambre."
                        },
                        {
                            "text": "Tu ne devrais pas <w>entasser</w> tous ces vieux papiers sur ton bureau."
                        }
                    ],
                    "common_phrases": [
                        "entasser du linge"
                    ]
                },
                {
                    "sense_id": "d78c8f08-34f2-3a2f-8f0e-d5bfda581e95",
                    "sense_definition": "Réunir ou faire tenir des personnes dans un espace trop étroit.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "regroupement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chauffeur a décidé d'<w>entasser</w> des passagers supplémentaires dans le bus déjà plein."
                        },
                        {
                            "text": "Les organisateurs ont <w>entassé</w> des dizaines de spectateurs dans cette petite pièce."
                        }
                    ],
                    "common_phrases": [
                        "entasser des passagers"
                    ]
                },
                {
                    "sense_id": "3183d071-04ad-35cd-9a5a-cb26316765ff",
                    "sense_definition": "Accumuler beaucoup d'argent ou de biens matériels avec avidité.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "accumulation_materielle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet homme avare cherche constamment à <w>entasser</w> de l'argent sans jamais le dépenser."
                        },
                        {
                            "text": "Au lieu d'<w>entasser</w> des richesses inutiles, il préfère vivre simplement et voyager."
                        }
                    ],
                    "common_phrases": [
                        "entasser de l'argent",
                        "entasser des richesses"
                    ]
                }
            ]
        }
    ]
