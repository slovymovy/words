                "senses": [
                    {
                        "sense_id": "c2df8d71-c5b1-3fe2-82ed-f71fec50e104",
                        "entry_id": "7480df44-1e83-3082-8bea-c7fd219b9da4",
                        "glosses": [
                            "Entspannung in der Weihnachtszeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea7a07d7-30b0-488b-b1cd-8f854e4ad9d4",
                                "sense_id": "c2df8d71-c5b1-3fe2-82ed-f71fec50e104",
                                "text": "„Deswegen würden die öffentlichen Verkehrsmittel in der Zeit von 10 bis 15 Uhr stillgelegt, die Ladengeschäfte dürften nur in den Stunden mit Tageslicht (9 bis 15 Uhr) öffnen, die Weihnachtsruhe in den Betrieben müsse um acht Tage verlängert werden und die Schulen müssten bis zum 21. 1. 1947 geschlossen bleiben.“"
                            },
                            {
                                "example_id": "18ae3b93-b319-4089-abc4-f0db51b65a4d",
                                "sense_id": "c2df8d71-c5b1-3fe2-82ed-f71fec50e104",
                                "text": "„Die Prager Detektive konnten keine Weihnachtsruhe halten.“"
                            },
                            {
                                "example_id": "9b672e27-2ecf-4979-b2a9-90ce94928f23",
                                "sense_id": "c2df8d71-c5b1-3fe2-82ed-f71fec50e104",
                                "text": "„Allmählich merkt man , daß die Weihnachtsruhe zu Ende geht. Das Wetter ist wunderbar. Wenn man zum Fenster hinausschaut, möchte man den Eindruck haben, als lebten wir im März oder im April.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
