                    }
                ],
                "translations": [
                    {
                        "translation_id": "bcdfab6d-c805-42cc-b088-d5f6128ea8aa",
                        "source_entry_id": "6d729d8a-4c20-3915-9ac2-b1050042389b",
                        "source_sense_id": "1b6bc992-cb8d-3580-9c80-95988f59d1b6",
                        "target_lang_word": "snowboarder",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "snowboarder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "126a6876-437f-3a6b-a5fa-89896348b52e",
                                        "entry_id": "7338a73b-bc8e-38a9-a697-edc6efc771a6",
                                        "glosses": [
                                            "Someone who snowboards."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f90a057-c7b3-49de-86b2-fbaa215f1cf8",
                                                "sense_id": "126a6876-437f-3a6b-a5fa-89896348b52e",
                                                "text": "The same is true in freeskiing, in which skiers pull tricks on some of the same terrain as snowboarders."
                                            },
                                            {
                                                "example_id": "9fffc99f-aae2-45a9-b32a-697c539df0f9",
                                                "sense_id": "126a6876-437f-3a6b-a5fa-89896348b52e",
                                                "text": "To Enni Rukajarvi, a Finnish snowboarder, the temperatures were not a problem — it was warmer than it often is at home, she pointed out — but the wind was tricky."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e983f345-59d7-4c69-9219-f40928e5cbbf",
                        "source_entry_id": "6d729d8a-4c20-3915-9ac2-b1050042389b",
                        "source_sense_id": "1b6bc992-cb8d-3580-9c80-95988f59d1b6",
                        "target_lang_word": "snowboardista",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "snowboardista",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "e3fe4e21-2a07-37d7-9319-0aa69612e558",
                                        "entry_id": "26f02fab-724c-30dc-88a8-9025b6dd5230",
                                        "glosses": [
                                            "jezdec na snowboardu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57e65bf3-1ffb-4cf4-8093-813b4ae6a447",
                                                "sense_id": "e3fe4e21-2a07-37d7-9319-0aa69612e558",
                                                "text": "Nemyslete si však, že když si začátečník snowboardista koupí nejlepší snowboard ze všech, bude za chvíli jednička na svahu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "71219b42-8c91-4b58-8f94-858f56c1ade2",
                        "source_entry_id": "6d729d8a-4c20-3915-9ac2-b1050042389b",
                        "source_sense_id": "1b6bc992-cb8d-3580-9c80-95988f59d1b6",
                        "target_lang_word": "Snowboarder",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Snowboarder",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f9f6618a-a3d7-343a-8803-58e4df668ed4",
                                        "entry_id": "f1941c65-cf5b-36cd-836c-e3862046dcb5",
                                        "glosses": [
                                            "(männliche) Person, die mit einem Snowboard auf Schnee gleitet; Person, die snowboardet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66eecabb-ab95-4a5f-9d55-2d1440af1ee9",
                                                "sense_id": "f9f6618a-a3d7-343a-8803-58e4df668ed4",
                                                "text": "Beim Skifahren in den Alpen ist sein Vater mit einem Snowboarder zusammengestoßen."
                                            },
                                            {
                                                "example_id": "d2928c19-0973-4f49-9556-2380cd06f001",
                                                "sense_id": "f9f6618a-a3d7-343a-8803-58e4df668ed4",
                                                "text": "„Nachdenklich stimmt auch, daß immer mehr Skiläufer von Snowboardern niedergefahren werden.“"
                                            },
                                            {
                                                "example_id": "63f6edef-6fc1-47d8-baa1-d5c5d3f4b548",
                                                "sense_id": "f9f6618a-a3d7-343a-8803-58e4df668ed4",
                                                "text": "„In diesem Winter rasen erstmals so viele Snowboarder wie Skifahrer die deutschen Pisten runter.“"
                                            },
                                            {
                                                "example_id": "ff151650-29f1-42cf-8db1-cd11083e589f",
                                                "sense_id": "f9f6618a-a3d7-343a-8803-58e4df668ed4",
                                                "text": "„Strahlend blauer Himmel, knirschender Schnee, bestens präparierte Pisten, gemütliche Hütten mit freundlichen Gastgebern - allein die Vorstellung lässt das Herz jedes Skifahrers und Snowboarders höher schlagen.“"
                                            },
                                            {
                                                "example_id": "dd0deac4-0403-425b-906d-1782507c7716",
                                                "sense_id": "f9f6618a-a3d7-343a-8803-58e4df668ed4",
                                                "text": "„So ein Snowboarder prägt die Kulturlandschaft nachhaltiger als Generationen von hoch subventionierten Bergbauern.“"
                                            },
                                            {
                                                "example_id": "585ff2ec-bcd0-42a1-a4e5-af761279c000",
                                                "sense_id": "f9f6618a-a3d7-343a-8803-58e4df668ed4",
                                                "text": "„Weil sechs Engländer einen Snowboarder aus einem Tobel retten wollten, musste eine Suchaktion nach dem englischen Sextett ausgelöst werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4acfd99e-dfed-4d28-999c-7bf2cfeaeb4f",
                        "source_entry_id": "6d729d8a-4c20-3915-9ac2-b1050042389b",
                        "source_sense_id": "1b6bc992-cb8d-3580-9c80-95988f59d1b6",
                        "target_lang_word": "Snowboardfahrer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Snowboardfahrer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "17a752d1-c28d-3418-b124-4e17fbb0a6b4",
                                        "entry_id": "fa298fde-b433-386b-a817-0f4c4d109704",
                                        "glosses": [
                                            "Person, die mit einem Snowboard auf Schnee gleitet/die Snowboard fährt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e9df781-9a9b-46e2-9284-8efce5fbb84a",
                                                "sense_id": "17a752d1-c28d-3418-b124-4e17fbb0a6b4",
                                                "text": "„Jeden Winter kommen im Alpenraum einige Dutzend Menschen durch Lawinen zu Tode. Oftmals trifft es Ski- oder Snowboardfahrer, die abseits der präparierten Pisten ihrem Freizeitvergnügen nachgehen.“"
                                            },
                                            {
                                                "example_id": "0eaf9298-46cd-41bc-b4ac-8c8faf1e26af",
                                                "sense_id": "17a752d1-c28d-3418-b124-4e17fbb0a6b4",
                                                "text": "„Die von Ski- und Snowboardfahrern verursachten Lawinen gehen zumeist nicht von einem Punkt aus, sondern reißen entlang einer Linie an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
