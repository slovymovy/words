                        "glosses": [
                            "D’un peuple sémite qui a envahi le delta du Nil, dans l’Égypte antique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b09086c-3040-40ff-bf9b-1139e993ceb3",
                                "sense_id": "29282780-a3a6-37dc-8cc5-5cc6c5efffc9",
                                "text": "Qu’est-ce que le prince hyksos fait ici ?"
                            },
                            {
                                "example_id": "a3491ae5-10c8-47b7-9414-4ecd30f4ac20",
                                "sense_id": "29282780-a3a6-37dc-8cc5-5cc6c5efffc9",
                                "text": "Un rien provocateur, il vient également édifier un palais à Avaris, l’ancienne capitale hyksos."
                            },
                            {
                                "example_id": "f532125c-c2da-4cfd-88ab-01876aff97c6",
                                "sense_id": "29282780-a3a6-37dc-8cc5-5cc6c5efffc9",
                                "text": "Après la fin tragique de Séqénenrê, prince de Oueset - la future Thèbes -, l’Égypte retombe sous la domination de l'envahisseur hyksos."
                            }
                        ]
                    }
                ],
