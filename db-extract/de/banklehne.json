                    {
                        "sense_id": "432337d9-4c72-30fe-afb9-7d6019b0c201",
                        "entry_id": "fb3a441d-0eee-38d1-9f48-d2e5fb5c551f",
                        "glosses": [
                            "Arm- oder Rückenlehne an einer Bank"
