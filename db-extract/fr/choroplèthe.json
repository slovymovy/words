                                        "examples": [
                                            {
                                                "example_id": "74616591-e6b8-4e1d-a318-6cc495484e8e",
                                                "sense_id": "a415c686-4a3a-352e-ab8a-2ea9b16d732a",
                                                "text": "The choropleths were generated using the SAS/GRAPH software package [23].[…]On each choropleth, the blocks in the key are labeled between zero and one, in interval increments of 0.05 over the range of the sample cdf values."
                                            },
                                            {
                                                "example_id": "c3a1ca9c-90c0-4551-8a41-c4806a97cd00",
                                                "sense_id": "a415c686-4a3a-352e-ab8a-2ea9b16d732a",
                                                "text": "An elevation matrix approximation provides us with very small, regularly placed units which can overcome many of the problems of choropleth representation."
                                            },
                                            {
                                                "example_id": "9c18c436-1443-47b0-af2c-c1f82f5712a7",
                                                "sense_id": "a415c686-4a3a-352e-ab8a-2ea9b16d732a",
                                                "text": "2012, R. B. Thapa, R. C. Estoque, 6: Grographically Weighted Regression in Geospatial Analysis, Yuji Murayama, Progress in Geospatial Analysis, page 90,\nPrevious approaches to mapping the results of GWR have primarily employed an equal-step classification and sequential no-hue color scheme for choropleth mapping of parameter estimates."
                                            }
                                        ]
