        "nl-extract.jsonl": [
            {
                "entry_id": "b7ac7ffa-157c-3a3b-9060-59db16da7e23",
                "word": "medegevoel",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "fbf64f4f-7388-3e3b-b963-62caa1542ade",
                        "entry_id": "b7ac7ffa-157c-3a3b-9060-59db16da7e23",
                        "glosses": [
                            "het gevoel dat men deelt met een ander zodat men met die persoon kan meeleven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "102db324-9e88-482d-ac1d-73c933c25b33",
                                "sense_id": "fbf64f4f-7388-3e3b-b963-62caa1542ade",
                                "text": "Deze plicht moeten wij vrijwillig en uit medegevoel op ons nemen."
                            },
                            {
                                "example_id": "52c5bd8c-1384-4027-81d2-105700f58fff",
                                "sense_id": "fbf64f4f-7388-3e3b-b963-62caa1542ade",
                                "text": "Moeders! Jullie zijn als de ooi die jongen baart die alleen maar dienen om om het leven gebracht en uiteengereten te worden in een onbeschrijfelijk gevecht! Wat baat het echter me te beklagen over iets waaraan toch niets te doen is als de koning geen greintje medegevoel heeft voor mij of mijn zoon?' De koning, die door die woorden pijnlijk getroffen was, kon zich niet meer bedwingen en dikke tranen rolden over zijn wangen."
                            }
                        ]
                    }
                ],
