    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "1623d40c-ee8d-330a-8a0b-7714d8e7a9a6",
                "word": "goodly",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "37e31ef4-51a9-4165-aa56-c838904c8b12",
                        "entry_id": "1623d40c-ee8d-330a-8a0b-7714d8e7a9a6",
                        "tags": [
                            "comparative"
                        ],
                        "form": "goodlier"
                    },
                    {
                        "form_id": "a4aab2c7-cf40-4e5e-b85e-e0092e434a34",
                        "entry_id": "1623d40c-ee8d-330a-8a0b-7714d8e7a9a6",
                        "tags": [
                            "superlative"
                        ],
                        "form": "goodliest"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "837f841b-4f8c-3caf-955e-01ece3f0d0f9",
                        "entry_id": "1623d40c-ee8d-330a-8a0b-7714d8e7a9a6",
                        "glosses": [
                            "Good; pleasing in appearance; attractive; comely; graceful; pleasant; desirable."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "803c7e9b-8827-4c3f-8a3a-7fadd68c52e2",
                                "sense_id": "837f841b-4f8c-3caf-955e-01ece3f0d0f9",
                                "text": "Her goodly thighs, whoſe glory did appear, / Like a triumphal Arch,[…]"
                            },
                            {
                                "example_id": "f4401225-edc6-44a4-8c88-6554e0641f86",
                                "sense_id": "837f841b-4f8c-3caf-955e-01ece3f0d0f9",
                                "text": "The diuell can cite Scripture for his purpoſe, / An euill ſoule producing holy witneſſe, / Is like a villaine with a ſmiling cheeke, / A goodly apple rotten at the heart. / O what a goodly outſide falſehood hath."
                            },
                            {
                                "example_id": "bc524055-c00c-4cc2-9a65-8cc850a29c44",
                                "sense_id": "837f841b-4f8c-3caf-955e-01ece3f0d0f9",
                                "text": "O Sin, thou knowest that all thy shame in her\nWas made a goodly thing."
                            },
                            {
                                "example_id": "ddbe7d3e-80f6-444e-85f1-be169d4f42e0",
                                "sense_id": "837f841b-4f8c-3caf-955e-01ece3f0d0f9",
                                "text": "Then the prince left her and betook himself to the palace of the King his father, who rejoiced in his return and met him and welcomed him; and the Prince said to him, \"Know that I have left her without the city in such a garden and come to tell thee, that thou mayst make ready the procession of estate and go forth to meet her and show her the royal dignity and troops and guards.\" Answered the King, \"With joy and gladness\"; and straightway bade decorate the town with the goodliest adornment."
                            }
                        ]
                    },
                    {
                        "sense_id": "39ae7227-301a-3400-8bdd-a30bf41aefa4",
                        "entry_id": "1623d40c-ee8d-330a-8a0b-7714d8e7a9a6",
                        "glosses": [
                            "Quite large; considerable; sufficient; adequate; more than enough."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e930228e-754c-44d8-b312-890e8e774ac2",
                                "sense_id": "39ae7227-301a-3400-8bdd-a30bf41aefa4",
                                "text": "a goodly sum of money"
                            },
                            {
                                "example_id": "31088d35-9719-4eb1-9ff9-1e6668bdc317",
                                "sense_id": "39ae7227-301a-3400-8bdd-a30bf41aefa4",
                                "text": "walking at a goodly pace"
                            },
                            {
                                "example_id": "11fa02cf-b8ec-42dc-92bd-c5dc4044093a",
                                "sense_id": "39ae7227-301a-3400-8bdd-a30bf41aefa4",
                                "text": "Like any kid who played a game or two in school, I happened early on a golden rule: if I ate a goodly amount, I had better wait a goodly time before starting play—at least half an hour, preferably more."
                            },
                            {
                                "example_id": "d92206c7-bd42-4787-85d8-1c96f987fad9",
                                "sense_id": "39ae7227-301a-3400-8bdd-a30bf41aefa4",
                                "text": "I am glad I brought a goodly supply of needlework with me. It's about all there is to do."
                            },
                            {
                                "example_id": "a39257cd-a55c-44f5-ba8c-9e943d837231",
                                "sense_id": "39ae7227-301a-3400-8bdd-a30bf41aefa4",
                                "text": "After stopping at these stations, my train has become busy. Returning day-trippers make up a goodly number, along with young people heading for a night out in Bristol, which is where I change once again."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "1879ec1a-6885-3b33-8cc3-60b30e96261b",
