{
    "word_family": [
        "barmy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b2aab5c1-2c85-39d1-9972-9b02a23b6742",
                    "sense_definition": "A soft, round individual bread roll, typically eaten with savoury fillings.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He ordered a hot sausage <w>barm</w> from the bakery for breakfast.",
                            "target_lang_translations": {
                                "pl": "Na śniadanie zamówił w piekarni ciepłą <w>bułkę</w> z kiełbasą."
                            }
                        },
                        {
                            "text": "Would you like some butter on your <w>barm</w> before we make the sandwich?",
                            "target_lang_translations": {
                                "pl": "Czy chcesz posmarować masłem swoją <w>bułkę</w>, zanim zrobimy kanapkę?"
                            }
                        }
                    ],
                    "synonyms": [
                        "roll",
                        "bun",
                        "bap"
                    ],
                    "common_phrases": [
                        "barm cake",
                        "sausage barm",
                        "bacon barm"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Primarily used in North West England"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Miękka, okrągła bułka, zwykle podawana z wytrawnym nadzieniem."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "bułka",
                                "target_lang_sense_clarification": "ogólne określenie małego pieczywa"
                            },
                            {
                                "target_lang_word": "bułeczka",
                                "target_lang_sense_clarification": "drożdżowa lub miękka bułka"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "07be60b8-89b4-3f7e-81e4-70a20617afec",
                    "sense_definition": "The frothy yeast foam that forms on the surface of fermenting beer or malt liquors, historically used as leaven for baking.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "fermentation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The traditional baker gathered fresh <w>barm</w> from the local brewery to raise his dough.",
                            "target_lang_translations": {
                                "pl": "Tradycyjny piekarz zebrał świeże <w>drożdże piwne</w> z lokalnego browaru, aby wyrosło mu ciasto."
                            }
                        },
                        {
                            "text": "A thick layer of <w>barm</w> floated across the surface of the fermenting vat.",
                            "target_lang_translations": {
                                "pl": "Gruba warstwa <w>piany drożdżowej</w> unosiła się na powierzchni kadzi fermentacyjnej."
                            }
                        }
                    ],
                    "synonyms": [
                        "yeast",
                        "leaven"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Frequently used in historical or traditional contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Piana drożdżowa powstająca na powierzchni fermentującego piwa lub brzeczki słodowej, dawniej używana jako zaczyn do pieczenia chleba."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "drożdże piwne",
                                "target_lang_sense_clarification": "piana lub osad drożdżowy z piwa"
                            },
                            {
                                "target_lang_word": "szumowiny piwne",
                                "target_lang_sense_clarification": "piana z fermentującego piwa"
                            },
                            {
                                "target_lang_word": "zaczyn",
                                "target_lang_sense_clarification": "drożdże używane do wyrobu ciasta"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d0c60323-1902-3bdc-8301-b4effd1f5ee0",
                    "sense_definition": "The bosom, breast, or lap of a person.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "body",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mother gently cradled the tired infant against her warm <w>barm</w>.",
                            "target_lang_translations": {
                                "pl": "Matka delikatnie utuliła zmęczone niemowlę na swoim ciepłym <w>łonie</w>."
                            }
                        },
                        {
                            "text": "He held the ancient treasure tightly to his <w>barm</w> through the storm.",
                            "target_lang_translations": {
                                "pl": "Przez całą burzę mocno przyciskał starożytny skarb do swojej <w>piersi</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "bosom",
                        "lap"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Historical or poetic usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Łono, pierś lub kolana osoby (znaczenie archaiczne lub poetyckie)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "łono",
                                "target_lang_sense_clarification": "archaicznie lub poetycko: pierś, kolana"
                            },
                            {
                                "target_lang_word": "pierś",
                                "target_lang_sense_clarification": "poetycko: miejsce przytulenia"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1f1c63be-9756-3e9e-b80d-3809f8db6cc2",
                    "sense_definition": "To produce foam or froth, especially during fermentation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fermentation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The liquid began to <w>barm</w> as the yeast became active inside the barrel.",
                            "target_lang_translations": {
                                "pl": "Płyn zaczął się <w>pienić</w>, gdy drożdże uaktywniły się wewnątrz beczki."
                            }
                        },
                        {
                            "text": "After two days of brewing, the ale <w>barmed</w> vigorously at the surface.",
                            "target_lang_translations": {
                                "pl": "Po dwóch dniach warzenia piwo mocno <w>pieniło się</w> na powierzchni."
                            }
                        }
                    ],
                    "synonyms": [
                        "froth",
                        "foam"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "Historical or dialectal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Pienić się, wytwarzać pianę, szczególnie podczas fermentacji."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "pienić się",
                                "target_lang_sense_clarification": "wytwarzać pianę, burzyć się"
                            },
                            {
                                "target_lang_word": "burzyć się",
                                "target_lang_sense_clarification": "fermentować burzliwie z pianą"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}