                                        "entry_id": "bd94b45c-a64b-37d9-b151-81d4208bb29c",
                                        "glosses": [
                                            "czyn, zachowanie wymagające odwagi, męstwa; postawa właściwa bohaterowi"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
