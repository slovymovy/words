                "senses": [
                    {
                        "sense_id": "e4c46480-af28-3434-b484-4e19067f522f",
                        "entry_id": "f6ee31f8-6b79-3291-9c10-5cd6b3293620",
                        "glosses": [
                            "nurt stylistyczny w sztuce i literaturze europejskiej XVIII wieku, odznaczający się asymetrią oraz motywami egzotycznymi, lekkością i dekoracyjnością form"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "137e1e46-6351-4298-b522-9c70779b047c",
                                "sense_id": "e4c46480-af28-3434-b484-4e19067f522f",
                                "text": "Rozkwit rokoka nastąpił za Ludwika XV."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "95e29eb4-024a-447e-9896-cb29cd57e3b5",
                        "source_entry_id": "f6ee31f8-6b79-3291-9c10-5cd6b3293620",
                        "source_sense_id": "e4c46480-af28-3434-b484-4e19067f522f",
                        "target_lang_word": "rococo",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rococo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a599e1b-8967-3e05-9942-4f7dca5abf35",
                                        "entry_id": "5052f96b-45cc-316f-bd97-309fdd3d91f8",
                                        "glosses": [
                                            "A style of baroque architecture and decorative art, from 18th-century France, having elaborate ornamentation."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90c863fd-90c5-4140-8fda-e5ed8eca1a4b",
                                                "sense_id": "5a599e1b-8967-3e05-9942-4f7dca5abf35",
                                                "text": "They built a rococo aedicule that stands around the Tomb today."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d78ec105-15e2-36ab-a15f-012110db2207",
                                        "entry_id": "5052f96b-45cc-316f-bd97-309fdd3d91f8",
                                        "glosses": [
                                            "A piece of ornamentation in this style."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8c53d41-6813-41e5-bb69-fa6af2e75385",
                                                "sense_id": "d78ec105-15e2-36ab-a15f-012110db2207",
                                                "text": "Above the two chief figures are rococos on either side of the clock face. These, like all the other work, are in bold relief and wrought with great delicacy and grace. On the top of the clock is a realistic scene from nature."
                                            },
                                            {
                                                "example_id": "2380c75d-4634-4f01-bff5-eb12946b1666",
                                                "sense_id": "d78ec105-15e2-36ab-a15f-012110db2207",
                                                "text": "The marzipan and that kind of malleable ceramic, the rococo decorations, the flowers made of hard sugar, the frosted blue surfaces, kind of gray, the pearls, the legal coloring... all of it supposedly suitable for human consumption."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rococo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7bc2d69d-2c5d-3274-b7e4-8754850af2b6",
                                        "entry_id": "e276156a-f07e-3004-8a8a-f9422bd2eaa4",
                                        "glosses": [
