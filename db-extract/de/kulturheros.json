                    {
                        "translation_id": "1213e8fa-c02e-420d-986d-a029f5cb0b5d",
                        "source_entry_id": "e780ee6f-9324-30dd-99ab-7bcf1e198e08",
                        "source_sense_id": "3d4ed0a1-ade6-3168-8d70-6a61a724f4af",
                        "source_sense_description": "Erfinder oder Übermittler einer Kulturtechnik",
                        "target_lang_word": "culture hero",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "culture hero",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "482e00ff-7c32-3f07-819c-b96b57055f70",
                                        "entry_id": "11c2675c-ac08-3ed9-b212-c898da0bd90f",
                                        "glosses": [
                                            "A mythical character or real person who is renowned as the exemplar of the values or achievements of a society, group, or time period."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b8b84d2-68e2-46d0-96ce-575c28961533",
                                                "sense_id": "482e00ff-7c32-3f07-819c-b96b57055f70",
                                                "text": "A precisely similar notion was found by Avila among the Indians of Huarochiri, whose divine culture-hero imposed, by a curse or a blessing, their character and habits on the beasts."
                                            },
                                            {
                                                "example_id": "b1610ab8-fe40-486e-8b05-28631e07569e",
                                                "sense_id": "482e00ff-7c32-3f07-819c-b96b57055f70",
                                                "text": "[T]he U.S. has long been the Land of Efficiency. . . . Here mass production was born, the assembly line for good or ill became the modern cornucopia, and Henry Ford once reigned as the leading culture hero."
                                            },
                                            {
                                                "example_id": "81e666b7-6ab2-4672-bf8a-116cde178691",
                                                "sense_id": "482e00ff-7c32-3f07-819c-b96b57055f70",
                                                "text": "[T]hese were mostly Russian intellectuals, hard-core Stalinists, and democratic socialists . . . whose book-lined apartments were filled with leftist tracts and records by the Red Army Chorus and the black American Communist culture hero Paul Robeson."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
