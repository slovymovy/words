                        "sense_id": "5f8f2340-4d89-3904-9b56-e3ce2e30a9d9",
                        "entry_id": "137a4b0f-7cdf-37ba-a807-0bea0f6012ab",
                        "glosses": [
                            "Gros orgue de Barbarie, souvent motorisé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20a69753-0035-475d-9f35-cf11c1b1f5d6",
                                "sense_id": "5f8f2340-4d89-3904-9b56-e3ce2e30a9d9",
                                "text": "Mais voilà qu’ tout au bout d’ la rue\nEst arrivé un limonaire\nAvec un vieil air du tonnerre\nÀ vous fair’ chialer tant et plus."
                            },
                            {
                                "example_id": "7d63f5fc-2be5-41d4-b708-33be648a9112",
                                "sense_id": "5f8f2340-4d89-3904-9b56-e3ce2e30a9d9",
                                "text": "Nous passons vite au large d'un manège de chevaux de bois à l’ancienne dont le limonaire me vrille les oreilles."
                            }
                        ]
                    }
                ],
