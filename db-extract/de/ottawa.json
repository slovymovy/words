                    {
                        "translation_id": "b0ba1932-08a7-4c91-986f-cd12f325f182",
                        "source_entry_id": "144929e5-bf53-3ce9-8104-ca551f234551",
                        "source_sense_id": "23696b37-b32e-3bd5-8ab7-19f1cde340c3",
