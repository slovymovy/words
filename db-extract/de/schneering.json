                "senses": [
                    {
                        "sense_id": "740b82da-75b0-3a6e-a4b1-b38c6abc808d",
                        "entry_id": "af5b6f75-0cb7-3cbf-92f8-1085130f3ce3",
                        "glosses": [
                            "seltenes meteorologisches Phänomen, bei dem sich ein Stück der Schneedecke zylindrisch aufwickelt, wenn es aufgrund der Schwerkraft einen Hang oder dergleichen hinab in Bewegung gerät oder durch Einwirkung des Windes über den Boden geweht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9dcbfcca-e0be-41c4-8d36-beb6ef1a940b",
                                "sense_id": "740b82da-75b0-3a6e-a4b1-b38c6abc808d",
                                "text": "„Zum Beispiel, daß die Bauern mit hochgewendeten Gesichtern um den Kapellenberg kreisen, wenn sie den ansteigenden Acker pflügen, der jetzt aufgeworfene Schneeringe, wie kleine Terrassen, bildet, daß die andern Hügel, die aus der Ebene ragen, alle kleiner sind und unförmig und in gemessenem Abstand stehen, wie unvollkommene Vasallen und mißglückte Versuche, weil s[ie] nicht noch einmal wiederholen konnten, was der Kapellenberg an Größe und Gleichmäßigkeit vollbrachte.“"
                            },
                            {
                                "example_id": "4ccbd56c-3b1d-4a63-bde3-9bfb122dd6e1",
                                "sense_id": "740b82da-75b0-3a6e-a4b1-b38c6abc808d",
                                "text": "„Frau Holle verteilte Schneeringe.“"
                            },
                            {
                                "example_id": "0dec51f5-40c2-4396-a769-fa717aac1ca2",
                                "sense_id": "740b82da-75b0-3a6e-a4b1-b38c6abc808d",
                                "text": "„Der Forscher Roald Amundsen hatte seinen Beschreibungen zufolge die seltsamen Schneeringe schon während seiner Expedition zum Südpol im Jahre 1911 gesehen.“"
                            },
                            {
                                "example_id": "5be25bff-0976-435b-8297-2930eb84c3ab",
                                "sense_id": "740b82da-75b0-3a6e-a4b1-b38c6abc808d",
                                "text": "„Ein besonderer optischer Hingucker sind auch Schneeringe. Die auch Schneewalzen genannten, einem Muff ähnelnden Gebilde entstehen, wenn sich ein Stück der Schneedecke an einem Abhang oder vom Wind getrieben aufwickelt.“"
                            },
                            {
                                "example_id": "b0248b3f-8f04-46f7-933d-57b7383f86b1",
                                "sense_id": "740b82da-75b0-3a6e-a4b1-b38c6abc808d",
                                "text": "«Schneeringe entstehen auf ähnliche Weise, wie ein Schneemann – allerdings ohne Zutun des Menschen.»"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
