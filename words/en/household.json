                            {
                                "target_lang_word": "хозяйственный",
                                "target_lang_sense_clarification": "относящийся к товарам для дома, мылу"
                            },
                            {
                                "target_lang_word": "домашний",
                                "target_lang_sense_clarification": "относящийся к семье или обязанностям"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ev",
                                "target_lang_sense_clarification": "evle veya ev işleriyle ilgili"
                            },
                            {
                                "target_lang_word": "evsel",
                                "target_lang_sense_clarification": "atıklar, eşyalar veya tüketimle ilgili"
                            },
                            {
                                "target_lang_word": "ev işi",
                                "target_lang_sense_clarification": "ev temizliği ve günlük işlerle ilgili"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "家用",
                                "target_lang_sense_clarification": "指供家庭使用的物品"
                            },
                            {
                                "target_lang_word": "家务",
                                "target_lang_sense_clarification": "指家庭内部的日常事务"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "75784d7c-380b-35fc-aeeb-195bf92b79da",
                    "sense_definition": "Very well known to many people.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "famous",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After starring in the hit movie, she quickly became a <w>household</w> name.",
                            "target_lang_translations": {
                                "ru": "После главной роли в хитовом фильме её имя быстро стало <w>известным в каждом доме</w>.",
                                "tr": "Büyük ilgi gören filmde rol aldıktan sonra, kısa sürede <w>herkesin bildiği bir</w> isim haline geldi.",
                                "zh": "在出演那部热门电影后，她很快变得<w>家喻户晓</w>。"
                            }
                        },
                        {
                            "text": "The brand has become a <w>household</w> word for quality and reliability.",
                            "target_lang_translations": {
                                "ru": "Этот бренд стал <w>нарицательным</w> символом качества и надежности.",
                                "tr": "Marka, kalite ve güvenilirlik konusunda <w>dillere pelesenk olmuş bir</w> sözcük haline geldi.",
                                "zh": "这个品牌已成为质量与可靠的<w>家喻户晓</w>的代名词。"
                            }
                        }
                    ],
                    "synonyms": [
                        "famous",
                        "well-known",
                        "familiar"
                    ],
                    "antonyms": [
                        "unknown",
                        "obscure"
                    ],
                    "common_phrases": [
                        "household name",
                        "household word"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень хорошо известный широкому кругу людей.",
                        "tr": "Herkes tarafından çok iyi bilinen veya tanınan.",
                        "zh": "广为人知的，家喻户晓的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "общеизвестный",
                                "target_lang_sense_clarification": "знакомый всем"
                            },
                            {
                                "target_lang_word": "знакомый каждому",
                                "target_lang_sense_clarification": "в составе идиом типа 'household name'"
