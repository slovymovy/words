                {
                    "sense_id": "3800f507-9775-35e1-b828-df53b6363cd6",
                    "sense_definition": "A competitive swimming event that combines the four strokes of butterfly, backstroke, breaststroke, and freestyle.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mixture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He won the gold medal in the individual <w>medley</w> at the national championships.",
