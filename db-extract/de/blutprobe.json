                "senses": [
                    {
                        "sense_id": "0d735cce-3a55-36a0-9052-db0749ccb583",
                        "entry_id": "ac5e61e4-5e3d-3b77-9c84-b894b78a178b",
                        "glosses": [
                            "für Untersuchungen entnommenes Blut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09e64b45-bb66-43d2-a066-afa6e1428acf",
                                "sense_id": "0d735cce-3a55-36a0-9052-db0749ccb583",
                                "text": "Die Reste der Blutprobe wurden für spätere Untersuchungen aufbewahrt."
                            },
                            {
                                "example_id": "64a46990-5c9c-4e09-9076-84b8bf71f1fe",
                                "sense_id": "0d735cce-3a55-36a0-9052-db0749ccb583",
                                "text": "Die Blutprobe war verunreinigt, der Test konnte daher nicht durchgeführt werden."
                            },
                            {
                                "example_id": "b30aac14-392e-410c-aab7-21de992a92d1",
                                "sense_id": "0d735cce-3a55-36a0-9052-db0749ccb583",
                                "text": "„Diagramme, die Elissa Epel damals anhand der Blutproben ihrer pflegenden Mütter erstellte, beweisen den Zusammenhang.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b5666f7a-8d14-3063-bbe8-2a1303ce5228",
                        "entry_id": "ac5e61e4-5e3d-3b77-9c84-b894b78a178b",
                        "glosses": [
                            "Entnahme und Untersuchung von Blut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba6263be-f7cf-423a-9e40-6a94325e877b",
                                "sense_id": "b5666f7a-8d14-3063-bbe8-2a1303ce5228",
                                "text": "Für den Test auf HIV wird eine Blutprobe durchgeführt."
                            },
                            {
                                "example_id": "5dc534b7-c29f-4e6d-a39e-f6bdc12c0b6a",
                                "sense_id": "b5666f7a-8d14-3063-bbe8-2a1303ce5228",
                                "text": "Nach dem Unfall wurde eine Blutprobe angeordnet, um festzustellen, ob der Fahrer betrunken war."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
