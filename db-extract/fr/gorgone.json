            {
                "entry_id": "4b684321-1d69-39c9-a241-e09d8f186deb",
                "word": "gorgone",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "44f7614a-83d8-4ea1-afec-f62f70c557d4",
                        "entry_id": "4b684321-1d69-39c9-a241-e09d8f186deb",
                        "tags": [
                            "plural"
                        ],
                        "form": "gorgones"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ad562a52-2f5c-3213-bcd2-74f29a8e67df",
                        "entry_id": "4b684321-1d69-39c9-a241-e09d8f186deb",
                        "glosses": [
                            "Gorgone."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ec521cb-d402-47f0-8284-4088c50d9580",
                                "sense_id": "ad562a52-2f5c-3213-bcd2-74f29a8e67df",
                                "text": "Gorgone trouvée gisante sur le sol, perte de connaissance et déshydratation."
                            },
                            {
                                "example_id": "a0de99e4-2913-44f5-91da-96bd0f0d2783",
                                "sense_id": "ad562a52-2f5c-3213-bcd2-74f29a8e67df",
                                "text": "Et la décoration s’avère d’un raffinement inouï. Sur ses deux anses en volutes, la gorgone Méduse est représentée avec un visage effrayant, un corselet d’écailles et les jambes serpentiformes."
                            }
                        ]
                    },
                    {
                        "sense_id": "268dd565-1914-3271-8db2-a4a8e02f75b3",
                        "entry_id": "4b684321-1d69-39c9-a241-e09d8f186deb",
                        "glosses": [
                            "Genre de polypiers communs en Méditerranée, ils ressemblent à des arbrisseaux."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "910294b2-2c0a-3288-b409-d9cec56142ac",
                        "entry_id": "4b684321-1d69-39c9-a241-e09d8f186deb",
                        "glosses": [
                            "Espèce de papillon diurne de la famille des nymphalidés."
                        ],
                        "tags": [
                            "Lépidoptérologie"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "9ec70d22-472c-357b-a068-c7b8684f3ad8",
                        "entry_id": "4b684321-1d69-39c9-a241-e09d8f186deb",
                        "glosses": [
                            "Femme méchante ou très laide."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "3042d4a5-6440-302d-82d2-b39ebc0d2909",
                        "entry_id": "4b684321-1d69-39c9-a241-e09d8f186deb",
                        "glosses": [
                            "Tête décorative, vue de face, à la bouche ouverte, à chevelure de serpents."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f84bd28-44b9-4d64-b4b7-647134cdd4a0",
                                "sense_id": "3042d4a5-6440-302d-82d2-b39ebc0d2909",
                                "text": "On eût dit que quelque autre église avait envoyé à l’assaut de Notre-Dame ses gorgones, ses dogues, ses drées, ses démons."
                            }
                        ]
                    }
                ],
                "translations": [
