    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b4bbb269-2510-3729-a609-666e78f5b4f8",
                    "sense_definition": "Simple past tense and past participle of <w>lodge</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bullet was <w>lodged</w> deep in the wooden wall.",
                            "target_lang_translations": {
                                "ru": "Пуля <w>застряла</w> глубоко в деревянной стене."
                            }
                        },
                        {
                            "text": "They <w>lodged</w> a formal complaint with the local council yesterday.",
                            "target_lang_translations": {
                                "ru": "Вчера они <w>подали</w> официальную жалобу в местный совет."
                            }
                        }
                    ],
                    "common_phrases": [
                        "lodged a complaint",
                        "lodged in the throat"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle form"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола lodge; застрявший, застрял, подал (жалобу)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "застрявший",
                                "target_lang_sense_clarification": "о предмете, застрявшем где-либо"
                            },
                            {
                                "target_lang_word": "застрял",
                                "target_lang_sense_clarification": "форма прошедшего времени от застрять"
                            },
                            {
                                "target_lang_word": "подал",
                                "target_lang_sense_clarification": "о жалобе, иске, заявлении"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "35a6b5a7-ba39-392a-83b0-339690de397f",
                    "sense_definition": "Lying down, with the head raised; used of beasts of the chase (such as deer), as couchant is used of beasts of prey.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The coat of arms featured a stag <w>lodged</w> on a field of green.",
                            "target_lang_translations": {
                                "ru": "На гербе был изображен олень, <w>лежащий</w> на зеленом поле."
                            }
                        },
                        {
                            "text": "In heraldry, a deer depicted as <w>lodged</w> represents peace and policy.",
                            "target_lang_translations": {
                                "ru": "В геральдике олень, изображенный <w>лежащим</w>, символизирует мир и благоразумие."
                            }
                        }
                    ],
                    "synonyms": [
                        "couchant"
                    ],
                    "common_phrases": [
                        "stag lodged"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily used in heraldic contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В геральдике: лежащий с поднятой головой (об оленях и других промысловых зверях)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лежащий",
                                "target_lang_sense_clarification": "геральдический термин, с поднятой головой"
                            }
                        ]
                    }
                }
            ]
        }
    ]
