                ],
                "senses": [
                    {
                        "sense_id": "ba318c26-5518-3c31-b3a7-82f387ec8c90",
                        "entry_id": "421891a0-2baa-3a97-a7bd-775d37ff1b36",
                        "glosses": [
                            "отрезок, промежуток времени в тридцать минут; половина часа"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b831dbe3-3583-43e2-863e-bd5f19e6b226",
                                "sense_id": "ba318c26-5518-3c31-b3a7-82f387ec8c90",
                                "text": "Одна заря сменить другую // Спешит, дав ночи полчаса."
                            },
                            {
                                "example_id": "65350236-00c8-4faa-8a02-3c4a0ef8a2ea",
                                "sense_id": "ba318c26-5518-3c31-b3a7-82f387ec8c90",
                                "text": "Глядел на мужа с полчаса."
                            },
                            {
                                "example_id": "c172b6e4-6c45-4ea3-8f0a-0b17a5ab62e3",
                                "sense_id": "ba318c26-5518-3c31-b3a7-82f387ec8c90",
                                "text": "За полчаса до отхода поезда."
                            },
                            {
                                "example_id": "18d3d250-1357-4fb8-953e-97955bb26c89",
                                "sense_id": "ba318c26-5518-3c31-b3a7-82f387ec8c90",
                                "text": "Через полчаса начнут."
                            },
                            {
                                "example_id": "d16fa7af-593e-4f6b-b993-47601cf74743",
                                "sense_id": "ba318c26-5518-3c31-b3a7-82f387ec8c90",
                                "text": "В полчаса добежал до дому."
                            },
                            {
                                "example_id": "628461c9-7e55-475c-985b-a07dd131e04d",
                                "sense_id": "ba318c26-5518-3c31-b3a7-82f387ec8c90",
                                "text": "В получа́се езды от города."
                            },
                            {
                                "example_id": "0872c621-90aa-45ae-8b02-5d271921887d",
                                "sense_id": "ba318c26-5518-3c31-b3a7-82f387ec8c90",
                                "text": "Каждые полчаса полоскать горло."
                            },
                            {
                                "example_id": "27c16732-6603-4bbe-aeba-a00071a21171",
                                "sense_id": "ba318c26-5518-3c31-b3a7-82f387ec8c90",
                                "text": "Получасом раньше, позже."
                            },
                            {
                                "example_id": "90f5cbf2-5586-49aa-8c4e-cb900be77d31",
                                "sense_id": "ba318c26-5518-3c31-b3a7-82f387ec8c90",
                                "text": "Мне засчитали все получасы́ ежедневной сверхурочной работы за месяц."
                            },
                            {
                                "example_id": "c5d798a7-5d42-451b-a521-b73259c9b7aa",
                                "sense_id": "ba318c26-5518-3c31-b3a7-82f387ec8c90",
                                "text": "Дачные поезда здесь отходят каждые полчаса."
                            }
                        ]
                    }
                ],
