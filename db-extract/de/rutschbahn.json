                ],
                "senses": [
                    {
                        "sense_id": "d442746e-5181-3a4f-bea8-0d97ff9675d7",
                        "entry_id": "dd2c8632-7905-3efd-a368-f48763475247",
                        "glosses": [
                            "glatte, entweder ebene oder abschüssige, begrenzte Fläche, auf der man rutschen/herunterrutschen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f92acf33-c18d-40ab-8aa9-815a180cae5e",
                                "sense_id": "d442746e-5181-3a4f-bea8-0d97ff9675d7",
                                "text": "Die Rutschbahnen im Schwimmbad sind bei Kindern sehr beliebt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b72b31bf-eb87-4750-9786-d3abbc43e5c1",
                        "source_entry_id": "dd2c8632-7905-3efd-a368-f48763475247",
                        "source_sense_id": "d442746e-5181-3a4f-bea8-0d97ff9675d7",
                        "source_sense_description": "glatte, entweder ebene oder abschüssige, begrenzte Fläche, auf der man rutschen/herunterrutschen kann",
                        "target_lang_word": "toboggan",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "toboggan",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e793a600-9875-3045-8c44-89b543a711d4",
                                        "entry_id": "32712427-b881-318e-a5e7-bb198be669f1",
                                        "glosses": [
                                            "Traineau ou luge utilisée en Amérique du Nord pour glisser sur une pente."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f264620-0d6d-4a5c-a01c-7105ac0211b8",
                                                "sense_id": "e793a600-9875-3045-8c44-89b543a711d4",
                                                "text": "Notre tabagane n'a rien de commun avec le toboggan des Français, si ce n'est que les deux servent à glisser. Celui-ci est formé d'une armature d'acier qui repose sur des patins longs et assez bas et que recouvre une planche rembourrée, tandis que notre tabagane est sans patins et faite de longues planches minces et étroites, recourbées à l'avant et recouvertes parfois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3431df02-8ec7-3554-a9a0-c991dff192de",
                                        "entry_id": "32712427-b881-318e-a5e7-bb198be669f1",
                                        "glosses": [
                                            "Piste à une ou plusieurs pentes, rectiligne ou en spirale, installée en général dans les aires de jeux, que l’on descend en glissant assis."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc0cf164-d1ee-4739-b353-7164638c4fe4",
                                                "sense_id": "3431df02-8ec7-3554-a9a0-c991dff192de",
                                                "text": "Simon a passé une heure sur ce toboggan, hier soir, en présence de son père. Il n'est pas tombé une seule fois. Alors cesse de jouer les rabat-joie et écoute ce que j'ai à te dire."
                                            },
                                            {
                                                "example_id": "b74fef0d-b8e6-4c4d-a461-e1c81927971b",
                                                "sense_id": "3431df02-8ec7-3554-a9a0-c991dff192de",
                                                "text": "Le prêtre disparut dans l’escalier de la chaire comme dans la spirale d’un toboggan."
                                            },
                                            {
                                                "example_id": "aa1d7c4e-2ab2-46f6-b6d2-8eddad13bfe2",
                                                "sense_id": "3431df02-8ec7-3554-a9a0-c991dff192de",
                                                "text": "Il suffit pour s'en convaincre de faire le tour des jardins individuels où l'on rencontre, à de nombreux exemplaires, les toboggans et balançoires Euro-loisirs, les lanternes Leroy-Merlin et l’herbe de la Pampa en provenance directe du Jardiland."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e20c2ae-fe43-3f8a-bd0d-27b4a4230245",
                                        "entry_id": "32712427-b881-318e-a5e7-bb198be669f1",
                                        "glosses": [
                                            "Glissière permettant de laisser descendre des marchandises ou des matériaux d’un étage à un autre."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e65e5ce8-a182-427c-aa42-fff34746acd9",
                                                "sense_id": "1e20c2ae-fe43-3f8a-bd0d-27b4a4230245",
                                                "text": "Les gravats furent rapidement évacués grâce au toboggan qui les amenait directement dans la benne située au rez-de-chaussée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fdeac4b3-70d7-37b8-8558-cec5b9c5ae95",
                                        "entry_id": "32712427-b881-318e-a5e7-bb198be669f1",
                                        "glosses": [
                                            "Dispositif d’évacuation de secours sur les avions."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bc6f56b1-cc4c-392f-b997-0f4e962f7144",
                                        "entry_id": "32712427-b881-318e-a5e7-bb198be669f1",
                                        "glosses": [
                                            "Autopont, voie de circulation automobile construite sur une courte distance pour enjamber une autre voie."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31792510-5e09-49c2-90a8-a4f8dea5cd42",
                                                "sense_id": "bc6f56b1-cc4c-392f-b997-0f4e962f7144",
                                                "text": "La construction de mini-tunnels et de toboggans permettra de désengorger les carrefours successifs et d’améliorer ainsi la circulation des véhicules."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
