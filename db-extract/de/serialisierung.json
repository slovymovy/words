                "senses": [
                    {
                        "sense_id": "ed5ebf87-9cd3-3afc-9a38-c8ebb5a1e9a8",
                        "entry_id": "4cc12bda-4467-3cd4-9a9f-6d4d16ee9e77",
                        "glosses": [
                            "Umwandlung eines Objekts in einen Bytestrom"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29695f47-e28d-4f9e-9363-00e79ff5c3fb",
                                "sense_id": "ed5ebf87-9cd3-3afc-9a38-c8ebb5a1e9a8",
                                "text": "Serialisierung dient meist dazu, ein Objekt zu persistieren oder es über ein Netz zu versenden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4a1e67bf-59f2-3fd6-b965-0a40bdcdb205",
                        "entry_id": "4cc12bda-4467-3cd4-9a9f-6d4d16ee9e77",
                        "glosses": [
                            "Ergebnis der Umwandlung eines Objekts in einen Bytestrom"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c80cde31-3605-4eba-a381-eac51a632a16",
                                "sense_id": "4a1e67bf-59f2-3fd6-b965-0a40bdcdb205",
                                "text": "Wenn Serialisierungen einen zu großen Overhead enthalten, kann die Netzbelastung unnötig groß werden."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "38a5b240-6322-3305-82ee-33b6555b4fbb",
                        "entry_id": "4cc12bda-4467-3cd4-9a9f-6d4d16ee9e77",
                        "glosses": [
                            "Stellung der Wörter und Wortgruppen (Satzglieder) im Satz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f570907-ec62-471d-a77b-6fb452e6eb49",
                                "sense_id": "38a5b240-6322-3305-82ee-33b6555b4fbb",
                                "text": "„Um die Serialisierung möglichst einfach formulieren zu können, das heißt möglichst wenige Ausnahmen formulieren zu müssen, gebrauchen wir die Reihenfolge der Ausdrücke als Gesichtspunkt für die Formulierung der Operator-Operand-Struktur, wobei darauf zu achten ist, daß die Interpretationsregeln an diese Hierarchie anschließen und die Interpretation stets durch Applikation der Interpretation des Operators auf die des Operandums erfolgen kann.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
