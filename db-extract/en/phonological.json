                    },
                    {
                        "translation_id": "101a03be-2aba-407d-b7ed-3c7446c44e68",
                        "source_entry_id": "85e175ac-35ee-334b-8894-dbb24e6c214c",
                        "source_sense_description": "of or relating to phonology",
                        "target_lang_word": "fonologisch",
