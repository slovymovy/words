                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9435c951-69ce-3f0a-872c-a2bcdbac783b",
                        "entry_id": "0ea3c8f5-a863-3890-9ad0-fac92ecc6378",
                        "glosses": [
