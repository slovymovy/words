                {
                    "sense_id": "4b490a6a-ecd5-3e3e-a327-fe90912539a6",
                    "sense_definition": "Visage ou tête d'une personne.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "tete_visage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En voyant sa drôle de <w>bobine</w>, tout le monde a commencé à rire.",
                            "target_lang_translations": {
                                "en": "Seeing his funny <w>mug</w>, everyone started to laugh.",
                                "ru": "Увидев его смешную <w>рожу</w>, все начали смеяться.",
                                "de": "Beim Anblick seiner komischen <w>Visage</w> fingen alle an zu lachen.",
                                "es": "Al ver su <w>cara</w> tan graciosa, todo el mundo empezó a reír.",
                                "zh": "看到他那副滑稽的<w>尊容</w>，大家都笑了起来。"
                            }
                        },
                        {
                            "text": "Il tirait une sale <w>bobine</w> après avoir appris la mauvaise nouvelle.",
                            "target_lang_translations": {
                                "en": "He was pulling a sour <w>mug</w> after hearing the bad news.",
                                "ru": "Узнав о плохой новости, он скорчил кислую <w>рожу</w>.",
                                "de": "Nachdem er die schlechte Nachricht erfahren hatte, zog er eine saure <w>Fresse</w>.",
                                "es": "Tenía <w>cara</w> de disgusto tras enterarse de la mala noticia.",
                                "zh": "听到那个坏消息后，他板着一张难看的<w>脸</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "visage"
                    ],
                    "common_phrases": [
                        "drôle de bobine",
                        "sale bobine"
                    ],
                    "traits": [
