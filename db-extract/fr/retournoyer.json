                        "examples": [
                            {
                                "example_id": "94f9c47f-aa6e-4406-8b21-50bdfa1b8657",
                                "sense_id": "9c4c8fd0-4d18-39d9-b85b-5383061cc482",
                                "text": "Le roi, s'étant un jour égaré à la chasse dans une vaste forêt, fit tant en tournoyant et retournoyant de côté et d'autre, qu'il se trouva au bord d'un ruisseau dont l'eau étoit belle et claire ;"
                            },
                            {
                                "example_id": "ace5ffcb-cb8b-4cf6-bd16-59ee6b6c4aa8",
                                "sense_id": "9c4c8fd0-4d18-39d9-b85b-5383061cc482",
                                "text": "Nos ancêtres les faisaient tournoyer et retournoyer, leurs machètes."
                            }
                        ]
                    }
