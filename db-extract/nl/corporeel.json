                "translations": [
                    {
                        "translation_id": "cf2a5ed8-a0f6-4f0b-aefb-f7d4a2d53334",
                        "source_entry_id": "9f40236a-624e-395c-99ce-b1b27c9217b5",
                        "source_sense_id": "a0219c4e-f4c9-375d-a9d1-2a4d126cc71b",
                        "source_sense_description": "lichamelijk",
                        "target_lang_word": "körperlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "körperlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8b76dd1e-ac54-31ca-b299-2912cfa1dd05",
                                        "entry_id": "296fe70d-b9a6-3b1c-94e0-aca695822268",
                                        "glosses": [
                                            "den menschlichen oder tierischen Körper betreffend, auf ihn bezogen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ee6b2b4-e17f-420a-90e5-8bdaaf34e957",
                                                "sense_id": "8b76dd1e-ac54-31ca-b299-2912cfa1dd05",
                                                "text": "„Beim Fliegen überlistet der Pilot mittels seines Verstandes die Natur, die ihn körperlich nicht zum Fliegen geschaffen hat.“"
                                            },
                                            {
                                                "example_id": "12bbbaef-8315-436c-881b-f672bae6d7c3",
                                                "sense_id": "8b76dd1e-ac54-31ca-b299-2912cfa1dd05",
                                                "text": "Stress bedeutet durch eine Bedrohung hervorgerufene psychische und körperliche Anpassungsreaktion."
                                            },
                                            {
                                                "example_id": "2a09c039-e4f5-45aa-9ce4-6ba4b9f9476e",
                                                "sense_id": "8b76dd1e-ac54-31ca-b299-2912cfa1dd05",
                                                "text": "Am Sonntag war er von Trauernden körperlich angegriffen worden."
                                            },
                                            {
                                                "example_id": "f45263cc-e2f8-489a-b9f7-a36ef1f45d7d",
                                                "sense_id": "8b76dd1e-ac54-31ca-b299-2912cfa1dd05",
                                                "text": "Die treiben sich durch gegenseitigen Konkurrenzkampf nach oben, am Ende schaffen es die körperlich und mental stärksten ins Nationalteam."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d9522eca-218f-38b9-acc8-8b6ca68ced32",
                                        "entry_id": "296fe70d-b9a6-3b1c-94e0-aca695822268",
                                        "glosses": [
                                            "Objekte der materiellen Welt betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "915a7445-d429-4b8b-b6f5-c70221a24954",
                                                "sense_id": "d9522eca-218f-38b9-acc8-8b6ca68ced32",
                                                "text": "Dort geht es um ein Instrument von Arp Schnitger, von dessen Klangkörper es wie in Dresden keinerlei körperliche Spur mehr gibt."
                                            },
                                            {
                                                "example_id": "b2c357bb-0b81-48d5-95f5-0288b32f984c",
                                                "sense_id": "d9522eca-218f-38b9-acc8-8b6ca68ced32",
                                                "text": "Wenn wir denken, denken wir in der Realität der Masse, in Bezug auf die körperliche Manifestation, und die kleinsten Teilchen der Materie."
                                            },
                                            {
                                                "example_id": "6eefc12f-400c-45d8-9fa3-7e0c01bc3b8b",
                                                "sense_id": "d9522eca-218f-38b9-acc8-8b6ca68ced32",
                                                "text": "Was auf diesen Bildern erscheint, ist die stilisierte körperliche Oberfläche als dessen säkulares Legat."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8b6cb8dd-5897-4c93-a1f9-ce578f867841",
