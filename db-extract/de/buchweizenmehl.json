                        "sense_id": "b71c147b-bea6-3008-b903-206d816376f1",
                        "entry_id": "fc46a10e-65e1-3626-bc21-58521c84465a",
                        "glosses": [
                            "aus gemahlenen Buchweizenkörnern hergestelltes Mehl"
                        ],
                        "tags": [
                            "Nahrungsmittel"
                        ],
                        "examples": [
                            {
                                "example_id": "fe5377cd-786a-418d-8b43-280ad3f35089",
                                "sense_id": "b71c147b-bea6-3008-b903-206d816376f1",
                                "text": "„Manche Mehlarten (von Mais, Hirse, Reis und Buchweizen) bestehen fast nur aus solchen Stärkekörpern, die oft sehr charakteristisch sind. Beim Buchweizenmehle sind diese Stärkekörper sehr charakteristisch, länglich, scharf begränzt, kantig, fast prismatisch krystallartig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
