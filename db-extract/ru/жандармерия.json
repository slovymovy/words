                    {
                        "translation_id": "80d11ea3-790f-45b7-a7e7-ea50efb4d01c",
                        "source_entry_id": "5d1b16a3-3ec1-3202-a8f4-c75c4976b20e",
                        "target_lang_word": "Gendarmerie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gendarmerie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "860f1ca6-5afd-393f-a849-488f36dffb68",
                                        "entry_id": "da4d0daf-86c1-37c3-8c2c-90080feae082",
                                        "glosses": [
                                            "Polizeiapparat in meist ländlichen Gebieten, oft aus dem Militär entstanden oder in dieses eingegliedert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0f71678-e3ae-442d-8cd1-aae5c3f032b7",
                                                "sense_id": "860f1ca6-5afd-393f-a849-488f36dffb68",
                                                "text": "„Die Gendarmerie patrouilliert an den Austernbänken im Kajak und per Drohne.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2a9f17cd-3c15-4884-b7a7-6c8fec32f3a2",
                        "source_entry_id": "5d1b16a3-3ec1-3202-a8f4-c75c4976b20e",
                        "target_lang_word": "gendarmerie",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gendarmerie",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "1248af30-73db-3efb-aea6-3042450c9c53",
                                        "entry_id": "562f890b-c51f-385b-bb9a-9bdbf519d7e5",
                                        "glosses": [
                                            "op militaire leest geschoeide politie in Frankrijk, vergelijkbaar met de Koninklijke Marechaussee in Nederland"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2863dde-ac7f-4c4f-857d-bcfec987212b",
                                                "sense_id": "1248af30-73db-3efb-aea6-3042450c9c53",
                                                "text": ",,We hebben hier te maken met mensen die niet komen om te demonstreren maar willen rellen en we willen de mankracht hebben om hen geen vrije hand te geven’', aldus de eerste minister. Volgens de premier gaan ook tien pantservoertuigen van de gendarmerie de weg op. Dat is voor het eerst sinds de rellen in de buitenwijken van Parijs in 2005."
                                            },
                                            {
                                                "example_id": "df2ffae5-94c5-4986-aeaf-9f5d8322af72",
                                                "sense_id": "1248af30-73db-3efb-aea6-3042450c9c53",
                                                "text": "Gedwee blazen de gauwdieven opnieuw de aftocht. Zodra ze terugkeren, staat de gendarmerie wel paraat. Een van de mannen wordt direct in de kraag gevat. Vijf anderen weten te ontkomen, maar worden later alsnog opgepakt. De overvallers riskeren meerdere jaren cel, schrijft Het Laatste Nieuws. Een minderjarige dader is in een jeugdinrichting geplaatst."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "08424f04-83a0-4864-87ca-e30957f5e33f",
