                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "57edce65-4e6c-3b61-a9be-184595c8d49b",
                        "entry_id": "cccc1032-3f78-3cd8-89ec-b058dc911a33",
                        "glosses": [
                            "A compartment in a police van to hold a prisoner being transported."
                        ],
                        "tags": [
                            "UK",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "d2b554d6-0b46-4a09-920c-310038884d0b",
                                "sense_id": "57edce65-4e6c-3b61-a9be-184595c8d49b",
                                "text": "They shoved me in the back of a police van and started driving to the cop shop. I was sitting in the sweatbox, wondering how the Dibble had got onto me so quickly, when I heard a voice from another section of the van say, 'Are you P from Macclesfield?'"
                            },
                            {
                                "example_id": "cabd9b72-2667-44bd-ba93-df08e204afa7",
                                "sense_id": "57edce65-4e6c-3b61-a9be-184595c8d49b",
                                "text": "[…] she was finally hustled into a sweatbox, as prisoners and prison staff called it, and was off to meet her new home for the foreseeable future."
                            }
                        ]
                    },
                    {
                        "sense_id": "30f977cd-76ac-3354-84a2-a58eca7f5a68",
                        "entry_id": "cccc1032-3f78-3cd8-89ec-b058dc911a33",
                        "glosses": [
                            "A small overheated cell or room used for solitary confinement or torture."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7e37fb0-b02c-4136-9c91-943ea2212d18",
                                "sense_id": "30f977cd-76ac-3354-84a2-a58eca7f5a68",
                                "text": "In the summer of 1945, one young boy died of heart failure while locked in a sweatbox, a popular corrective at that time."
                            },
                            {
                                "example_id": "9e3e72c2-e133-41b6-a7bc-c75c3caf9352",
                                "sense_id": "30f977cd-76ac-3354-84a2-a58eca7f5a68",
                                "text": "Don't step in the wrong spot\nYou will gеt caught\nWhen you step in the swеatbox\nThey'll make you talk"
                            }
                        ]
                    },
                    {
                        "sense_id": "dee4e495-7652-3c7e-ba6c-b65420d915e2",
