                    {
                        "translation_id": "578b558e-fbe8-4665-a5ef-3182e3b244c7",
                        "source_entry_id": "79f27906-90ef-301d-9bab-88488b614463",
                        "source_sense_id": "f7986ff3-e9d3-32d3-8529-8bc2ff2fbfd3",
