                "senses": [
                    {
                        "sense_id": "0f4bf6c9-793d-3508-be12-f71b1714686a",
                        "entry_id": "20e75531-f778-34ef-aa35-2675618c1362",
                        "glosses": [
                            "устар. прич. от гантировать; покрытый перчаткой"
                        ],
                        "tags": [
                            "participle"
                        ],
                        "examples": [
                            {
                                "example_id": "24ac6ddc-5de0-49ff-93a0-b615aed05d10",
                                "sense_id": "0f4bf6c9-793d-3508-be12-f71b1714686a",
                                "text": "Молодой человек погрозил ему гантированным пальчиком."
                            },
                            {
                                "example_id": "525d33a4-ede7-4088-b109-42729c2297b0",
                                "sense_id": "0f4bf6c9-793d-3508-be12-f71b1714686a",
                                "text": "Несколько раз она приподымала с милым, опасливым жестом свою гантированную ручку, чтоб остановить меня, но каждый раз отнимала её в недоумении и страхе назад."
                            }
                        ]
                    }
