                            {
                                "example_id": "3d8ff429-9ab9-42f2-ac1a-d080f6f4bb9d",
                                "sense_id": "ae40f67a-0375-34e7-83c2-ad0a4100bdb2",
                                "text": "„Voor de cd zijn de oude opnames opnieuw onder handen genomen door producent Berthus Westerhuis. Door de nieuwe mix en een remaster klinken de nummers beter dan we hadden durven denken”, zegt de zanger."
                            },
                            {
                                "example_id": "4f9f2a65-a7ae-4209-97d2-0badd98d2cd2",
                                "sense_id": "ae40f67a-0375-34e7-83c2-ad0a4100bdb2",
                                "text": "Het varen daarentegen is nog steeds een groot genot. De zeegevechten waren reeds onderdeel van Assassin’s Creed IV: Black Flag, het deel voorafgaand aan Rogue, en ook in de remaster is dit deel van de game aanwezig."
                            }
                        ]
