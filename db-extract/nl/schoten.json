                            {
                                "example_id": "22a888c0-5c5b-43f7-b2ee-bacdcdafdae0",
                                "sense_id": "5b61ed45-6d2e-3f2d-8dc3-80d7818a0db8",
                                "text": "Wij schoten."
                            },
                            {
                                "example_id": "40138be9-3004-49d7-814e-3afea61f3f1b",
                                "sense_id": "5b61ed45-6d2e-3f2d-8dc3-80d7818a0db8",
                                "text": "Jullie schoten."
                            },
                            {
                                "example_id": "7970eb02-2e0f-444d-b084-20cea4747c95",
                                "sense_id": "5b61ed45-6d2e-3f2d-8dc3-80d7818a0db8",
                                "text": "Zij schoten."
                            },
                            {
                                "example_id": "772f5f38-121b-42d3-a9a1-5143a2da2398",
                                "sense_id": "5b61ed45-6d2e-3f2d-8dc3-80d7818a0db8",
                                "text": "Waakzaam schoten mijn ogen alle kanten op, speurend naar verborgen slangen in het struikgewas."
                            },
                            {
                                "example_id": "cd0c59a3-5b33-4556-ab33-6309199c7973",
                                "sense_id": "5b61ed45-6d2e-3f2d-8dc3-80d7818a0db8",
                                "text": "' Mijn ogen schoten naar het gedicht op de rol en ik werd misselijk van angst dat ze om het bureau heen zou lopen en het zou zien."
                            }
                        ]
                    }
