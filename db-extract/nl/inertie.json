                    },
                    {
                        "translation_id": "8480e657-6c90-4dc9-bd47-26e1f81671fe",
                        "source_entry_id": "ff33a138-6651-35dc-bc87-87c12caf7e6d",
                        "source_sense_id": "d42c98ab-3d29-3c99-86ec-1f6075b3a506",
                        "source_sense_description": "traagheid",
                        "target_lang_word": "inertia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inertia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "04d9f7c9-424f-3b85-9bbe-af5c18f5d20e",
                                        "entry_id": "a2c68c25-5720-338b-9b9e-06072029c4f6",
                                        "glosses": [
                                            "The property of a body that resists any change to its uniform motion; equivalent to its mass."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "88f6f705-d61a-3e46-a84c-25744221139d",
                                        "entry_id": "a2c68c25-5720-338b-9b9e-06072029c4f6",
                                        "glosses": [
                                            "In a person, unwillingness to take action."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5aaa9830-6c77-4822-ad39-e8bd3e47129f",
                                                "sense_id": "88f6f705-d61a-3e46-a84c-25744221139d",
                                                "text": "Men […] have immense irresolution and inertia."
                                            },
                                            {
                                                "example_id": "29520a1a-29ae-47aa-9d92-1098ada774e9",
                                                "sense_id": "88f6f705-d61a-3e46-a84c-25744221139d",
                                                "text": "Not all the surviving veteran chiefs would actually fight. Some remained nominally in the resistance but in practice delayed at their bases, pretexting a lack of ammunition for their uncertain inertia."
                                            },
                                            {
                                                "example_id": "03c611ab-6580-4ecf-88b7-9ae62b64fea2",
                                                "sense_id": "88f6f705-d61a-3e46-a84c-25744221139d",
                                                "text": "City had been woeful, their anger at their own inertia summed up when Samir Nasri received a booking for dissent, and they did not have a shot on target until the 66th minute."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34d23829-62b7-3419-a20e-f554473672a0",
                                        "entry_id": "a2c68c25-5720-338b-9b9e-06072029c4f6",
                                        "glosses": [
                                            "Lack of activity; sluggishness; said especially of the uterus, when, in labour, its contractions have nearly or wholly ceased."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9d256a08-81e0-494f-a5e9-14af3b52a83a",
                        "source_entry_id": "ff33a138-6651-35dc-bc87-87c12caf7e6d",
                        "source_sense_id": "d42c98ab-3d29-3c99-86ec-1f6075b3a506",
                        "source_sense_description": "traagheid",
                        "target_lang_word": "inertie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inertie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7a6615d0-a21a-3ce4-86b2-30714437e3ba",
                                        "entry_id": "7dabf1da-30e8-373f-b178-a16a69ea1f7f",
                                        "glosses": [
                                            "État de ce qui est inerte."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75725f81-01c2-4d8b-b146-1d1d83042391",
                                                "sense_id": "7a6615d0-a21a-3ce4-86b2-30714437e3ba",
                                                "text": "Principe d’inertie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d09afc63-50dc-3feb-85e2-42e17707ea20",
                                        "entry_id": "7dabf1da-30e8-373f-b178-a16a69ea1f7f",
                                        "glosses": [
                                            "Absence de réaction chimique en présence d’une substance"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5467ed34-163f-38cf-843f-2745572a09e0",
                                        "entry_id": "7dabf1da-30e8-373f-b178-a16a69ea1f7f",
                                        "glosses": [
                                            "Résistance passive qu’opposent les corps du fait de leur masse au changement de l’état de repos ou de mouvement dans lequel ils se trouvent."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "feee2465-5dc7-4497-9759-37f50130440b",
                                                "sense_id": "5467ed34-163f-38cf-843f-2745572a09e0",
                                                "text": "Buridan attaque la métaphysique du mouvement du Stagirite. Au principe aristotélicien : « Tout mobile est mû par un moteur distinct de lui », […], il substitue le principe d’inertie ou de conservation de l'impulsion, en l'absence de toute force appliquée. […], : le véritable moteur d'un mobile n'est autre que l'impulsion (impetus) déposée en lui par la force qui l'a lancé."
                                            },
                                            {
                                                "example_id": "1d022335-1d4e-4e31-86fd-882f6d7841c8",
                                                "sense_id": "5467ed34-163f-38cf-843f-2745572a09e0",
                                                "text": "En physique, l'inertie est la tendance pour un objet à conserver sa vitesse en l'absence de force extérieure. Si vous lancez une balle dans l'espace, elle n'arrêtera jamais sa lancée, sauf si un objet comme une planète l'attire par gravité. En démographie, ce terme sert à illustrer le fait que les mouvements sont dans ce domaine généralement très lents."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a970670-8b49-38d0-a45a-9d2a98591ca1",
                                        "entry_id": "7dabf1da-30e8-373f-b178-a16a69ea1f7f",
                                        "glosses": [
                                            "Résistance passive d’une personne, qui consiste principalement à ne pas obéir, à ne pas exécuter ce qui est commandé."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50acc411-f429-4c55-a546-f1318e7c141d",
                                                "sense_id": "5a970670-8b49-38d0-a45a-9d2a98591ca1",
                                                "text": "Il oppose à toutes les réclamations la force d’inertie."
                                            },
                                            {
                                                "example_id": "667718a7-8ac4-4478-9ad3-afe7d9f9d6d8",
                                                "sense_id": "5a970670-8b49-38d0-a45a-9d2a98591ca1",
                                                "text": "Il rencontra dans la nation une force d’inertie qui neutralisa toutes ses mesures."
                                            },
                                            {
                                                "example_id": "0e82f29e-7984-48a6-9d5a-8cccc6fe3837",
                                                "sense_id": "5a970670-8b49-38d0-a45a-9d2a98591ca1",
                                                "text": "Dans l’hypothèse où les textes en vigueur n’ont été que partiellement appliqués, peut-on en fournir l’explication (mauvaise information, inertie, complexité, manque de moyens, textes d’application pris avec retard ou inefficaces) ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0abb4cd1-4839-3bae-8058-bfe42de86146",
                                        "entry_id": "7dabf1da-30e8-373f-b178-a16a69ea1f7f",
                                        "glosses": [
                                            "Manque absolu d’activité ou d’énergie."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49cba85c-0a7f-4016-b783-585bdf5110e3",
                                                "sense_id": "0abb4cd1-4839-3bae-8058-bfe42de86146",
                                                "text": "Rester dans une complète inertie."
                                            },
                                            {
                                                "example_id": "b00f436d-5b3b-4a76-ba93-f18db9e2e2c1",
                                                "sense_id": "0abb4cd1-4839-3bae-8058-bfe42de86146",
                                                "text": "Être plongé dans une profonde inertie."
                                            },
                                            {
                                                "example_id": "a7f873c3-5964-45aa-8135-8e8d3904d684",
                                                "sense_id": "0abb4cd1-4839-3bae-8058-bfe42de86146",
                                                "text": "Tirez-le de cette inertie."
                                            },
                                            {
                                                "example_id": "38d40568-4b6c-40ec-9f81-f617f8697ffa",
                                                "sense_id": "0abb4cd1-4839-3bae-8058-bfe42de86146",
                                                "text": "Vivre dans un état d’indifférence et d’inertie."
                                            },
                                            {
                                                "example_id": "e6f34593-0396-4214-bc52-21f15f303ec0",
                                                "sense_id": "0abb4cd1-4839-3bae-8058-bfe42de86146",
                                                "text": "Tomber, languir dans l’inertie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
