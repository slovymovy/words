                                "target_senses": [
                                    {
                                        "sense_id": "bf72ead7-c3cd-3d7e-b254-6967857fbee7",
                                        "entry_id": "decf38c1-e6dd-3be6-b763-e34c38c3d1ff",
                                        "glosses": [
