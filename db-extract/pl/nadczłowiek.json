                    {
                        "sense_id": "9515aeb4-c20b-3dc4-9e25-5e97a01b2415",
                        "entry_id": "b6705a7d-2c84-3b3d-856e-2081e14743be",
                        "glosses": [
                            "jednostka przewyższająca pod każdym względem wszystkich ludzi"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41002b95-d884-4b90-90fa-90707fe450a8",
                                "sense_id": "9515aeb4-c20b-3dc4-9e25-5e97a01b2415",
                                "text": "Nietzscheański nadczłowiek jest obdarzony niezwykłą wolą mocy i nie ograniczają go normy moralne ustanowione przez społeczeństwo."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
