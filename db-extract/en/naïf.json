                "senses": [
                    {
                        "sense_id": "fc001415-1ed1-3829-b920-8cc686d33e5c",
                        "entry_id": "aaef5483-7b86-33f7-bb31-a2cb2d1c8479",
                        "glosses": [
                            "Naive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8272c357-eb68-4a40-9852-ff2332a1aa0c",
                                "sense_id": "fc001415-1ed1-3829-b920-8cc686d33e5c",
                                "text": "Doenitz was naïf to assume that England would have stood idly by while Germany built up her U-boat force to four figures; but it was true enough that the German Navy was unprepared for a submarine war."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "98de1d8b-4a75-30d8-b4ec-bff7e05b0333",
                "word": "naïf",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "f123eaf3-8ef4-4fe9-a187-c52e5dfd31a3",
                        "entry_id": "98de1d8b-4a75-30d8-b4ec-bff7e05b0333",
                        "tags": [
                            "plural"
                        ],
                        "form": "naïfs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e8913af5-3e65-3d4d-8dcc-0b14575c18cf",
                        "entry_id": "98de1d8b-4a75-30d8-b4ec-bff7e05b0333",
                        "glosses": [
                            "One who is naive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1055b5f5-e5c3-48ec-9aed-35264bd1774e",
                                "sense_id": "e8913af5-3e65-3d4d-8dcc-0b14575c18cf",
                                "text": "Now I could see there was no real rogue here, but a naïf who thought that world would always turn for him."
                            },
                            {
                                "example_id": "6d902357-4034-4267-9f56-9950d8a6cef8",
                                "sense_id": "e8913af5-3e65-3d4d-8dcc-0b14575c18cf",
                                "text": "On “Fearless,” Swift sharpened her lyrical specificity, using proper nouns and detailed renderings of conversations and experiences to create an indelible image of Taylor Swift, the savvy naïf."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6316e77d-3c27-48d7-91a0-91125573facd",
                        "source_entry_id": "98de1d8b-4a75-30d8-b4ec-bff7e05b0333",
                        "source_sense_id": "e8913af5-3e65-3d4d-8dcc-0b14575c18cf",
                        "source_sense_description": "one who is naive",
                        "target_lang_word": "naïf",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "naïf",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3a59d8a1-1bbe-305d-b956-cdac8f3e9abc",
                                        "entry_id": "b1bad0ad-0032-3ed1-a825-bf7bc1248fdc",
                                        "glosses": [
                                            "Naturel, ingénu, sans fard, sans apprêt, sans artifice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b6dae40-eddb-4178-a388-261f0ae0a45f",
                                                "sense_id": "3a59d8a1-1bbe-305d-b956-cdac8f3e9abc",
                                                "text": "La population de Saint-David m’intéressait fort par ses mœurs simples et naïves et parlait un curieux patois anglais plein d’expressions maritimes."
                                            },
                                            {
                                                "example_id": "63b798f6-7449-47bb-871c-f96df3ec8113",
                                                "sense_id": "3a59d8a1-1bbe-305d-b956-cdac8f3e9abc",
                                                "text": "Du reste, on n’y regardait pas de si près, et l’on pouvait tout aussi bien, au XVIᵉ siècle, accommoder ces cantiques naïfs sur des airs de danse, que, cent ans après, ajuster les noëls de de la Monnoye sur les airs des ballets de Lulli, le Rigodon de Galathée, sa Chaconne du grand ballet du Roy, l’ouverture de Bellérophon, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "884ddb52-dc94-30b8-8486-6f577d82f581",
                                        "entry_id": "b1bad0ad-0032-3ed1-a825-bf7bc1248fdc",
                                        "glosses": [
                                            "Qui retrace simplement la vérité, qui imite la nature sans laisser paraître d’artifice ni d’effort."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b8dff1e-076f-4c32-9db9-a81020bdedac",
                                                "sense_id": "884ddb52-dc94-30b8-8486-6f577d82f581",
                                                "text": "Faire une description, une relation, une peinture naïve de quelque chose."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33f6e7de-1556-3302-a205-b48fb17f9ac5",
                                        "entry_id": "b1bad0ad-0032-3ed1-a825-bf7bc1248fdc",
                                        "glosses": [
                                            "Qui n’est pas concerté, qui n’est pas étudié."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61589116-4544-4693-8758-f47516231017",
                                                "sense_id": "33f6e7de-1556-3302-a205-b48fb17f9ac5",
                                                "text": "Avoir quelque chose de naïf dans l’humeur, dans l’esprit, dans l’air."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28f6eb06-3fe0-3b9f-af8c-f5f4ab2941ef",
                                        "entry_id": "b1bad0ad-0032-3ed1-a825-bf7bc1248fdc",
                                        "glosses": [
                                            "Qui dit sa pensée sans détour, ingénument, en parlant des personnes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "380d0d34-9b4c-47c5-bbb2-cd399d502e0a",
                                                "sense_id": "28f6eb06-3fe0-3b9f-af8c-f5f4ab2941ef",
                                                "text": "C’est un homme naïf, une personne franche et naïve."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "799e3055-f024-3c40-9bb1-2d61aa4951fe",
                                        "entry_id": "b1bad0ad-0032-3ed1-a825-bf7bc1248fdc",
                                        "glosses": [
                                            "Qui dit, par un excès de simplicité, ce qu’il aurait intérêt à cacher."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be3e1a32-ba9c-423b-8c2d-c966a51dc4b4",
                                                "sense_id": "799e3055-f024-3c40-9bb1-2d61aa4951fe",
                                                "text": "Que la réalité ne corresponde pas au rêve, seuls les naïfs s’en étonneront. D’abord, il y eut autant de rêves que de rêveurs. […] Enfin, et surtout, si les hommes pouvaient réaliser leurs utopies, cela se saurait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8c0fb70-e798-3925-8dc2-da680ed5e48d",
                                        "entry_id": "b1bad0ad-0032-3ed1-a825-bf7bc1248fdc",
                                        "glosses": [
                                            "Qui, par excès de simplicité, se laisse facilement tromper."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f7c367d-4498-4b49-a784-10ef52371fd9",
                                                "sense_id": "e8c0fb70-e798-3925-8dc2-da680ed5e48d",
                                                "text": "Il leur faut des électeurs ouvriers assez naïfs pour se laisser duper par des phrases ronflantes sur le collectivisme futur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02e6aaf5-e725-3f2f-9594-f2b98e4612c6",
                                        "entry_id": "b1bad0ad-0032-3ed1-a825-bf7bc1248fdc",
                                        "glosses": [
                                            "Qualifie certaines choses de l’humanité, dans tous les sens analogues."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee54a6d3-150c-4626-9e5d-da6fcb9bdc17",
                                                "sense_id": "02e6aaf5-e725-3f2f-9594-f2b98e4612c6",
                                                "text": "Amour-propre naïf."
                                            },
                                            {
                                                "example_id": "a438f6d8-160f-4f0e-8aa6-5202d49dedbe",
                                                "sense_id": "02e6aaf5-e725-3f2f-9594-f2b98e4612c6",
                                                "text": "Une vanité naïve."
                                            },
                                            {
                                                "example_id": "bec798d2-56f4-4c77-8b8f-f77620a9184d",
                                                "sense_id": "02e6aaf5-e725-3f2f-9594-f2b98e4612c6",
                                                "text": "Il lui est échappé une réponse bien naïve."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35999315-508d-30d0-a8a3-98787eaad43e",
                                        "entry_id": "b1bad0ad-0032-3ed1-a825-bf7bc1248fdc",
                                        "glosses": [
                                            "Vierge de tout traitement."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "naïf",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9752e65b-3cca-3035-aace-9c5c403d9a5d",
                                        "entry_id": "2063d844-d1b6-340e-ad41-277509681f5d",
                                        "glosses": [
                                            "Personne naïve."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9283b7ed-30c5-4301-98aa-d5d8f495b86f",
                                                "sense_id": "9752e65b-3cca-3035-aace-9c5c403d9a5d",
                                                "text": "Il faut admettre que le titre de cet ouvrage pourrait à lui seul donner à croire que son auteur est un naïf, un candide ou encore un provocateur niais."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
