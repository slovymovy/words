                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "3d261438-3202-4508-8848-07d9a340fa2a",
                                "sense_id": "775d08d1-72c9-3d99-ad0d-a8a276671d20",
                                "text": "Vergiss einfach, was in diesem Käseblatt geschrieben steht."
                            },
                            {
                                "example_id": "bee3ef8d-a30f-4f97-929e-a74d5998d55d",
                                "sense_id": "775d08d1-72c9-3d99-ad0d-a8a276671d20",
                                "text": "Das kannst du auch nur in irgend so einem Käseblatt gelesen haben."
                            }
                        ],
