                ],
                "senses": [
                    {
                        "sense_id": "8ace02a0-bc65-3e28-9cbd-edbcea17cc44",
                        "entry_id": "59fc515b-b227-31ca-9337-9eec21dde498",
                        "glosses": [
                            "an einer Weste angebrachte, kleine Tasche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c96aa4af-b6bb-4315-b0f0-846d898b6c2a",
                                "sense_id": "8ace02a0-bc65-3e28-9cbd-edbcea17cc44",
                                "text": "In seiner Westentasche steckte eine goldene Taschenuhr."
                            },
                            {
                                "example_id": "c2a39827-2fd9-4084-a49a-1b17b274cfd0",
                                "sense_id": "8ace02a0-bc65-3e28-9cbd-edbcea17cc44",
                                "text": "„Und dann geschieht es, daß er, ohne den Blick abzuwenden, in die Westentasche greift und sanft und zärtlich einen Weinpfropfen aus der Tasche nimmt, um ihn verzückt an die Nase zu führen und ein Weilchen fromm daran zu riechen.“"
                            },
                            {
                                "example_id": "7c2ca399-459a-4cc3-a3e9-2ea6e9c4a3e2",
                                "sense_id": "8ace02a0-bc65-3e28-9cbd-edbcea17cc44",
                                "text": "„Doktor Smoaks holte seine Uhr aus der Westentasche und warf einen flüchtigen Blick darauf.“"
                            },
                            {
                                "example_id": "ecfc84f7-6450-4da7-9918-c27db2858377",
                                "sense_id": "8ace02a0-bc65-3e28-9cbd-edbcea17cc44",
                                "text": "„Er schob die Tabatiere in die Westentasche, zog sie wieder heraus, hielt sie einige Male an die Nase und blieb dann vor Balaschow stehen.“"
                            },
                            {
                                "example_id": "3316a3c2-3edd-407a-9490-e2b917668137",
                                "sense_id": "8ace02a0-bc65-3e28-9cbd-edbcea17cc44",
                                "text": "„Thomas zog die geliebte Repetieruhr aus der Westentasche und ließ sie schlagen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
