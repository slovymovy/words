                        "glosses": [
                            "The main island of the archipelago of Japan."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4b1a89c-d062-4ac8-a45f-afe7b41ca73d",
                                "sense_id": "f58f4671-610c-3a14-827e-93ae8d0bb3ea",
                                "text": "A fascination with Hokkaido's wild country first drew the veterinarian to Abashiri, and he is a leading expert on the Ezo red fox. Like much of Hokkaido's wildlife, this fox is not found on Honshu."
                            },
                            {
                                "example_id": "e0db98b5-46cb-47f4-bb63-e1e8ff58b422",
                                "sense_id": "f58f4671-610c-3a14-827e-93ae8d0bb3ea",
                                "text": "In the past, the Ainu (their selfname meaning 'person'), traditionally huntergatherers, occupied not only Hokkaido but also a considerable part of the island of Honshu until the middle the eighteenth century, […]"
                            }
                        ]
                    }
