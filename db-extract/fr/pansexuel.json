                                "example_id": "632ea834-d7b0-4181-a494-958aa58ac08c",
                                "sense_id": "173bd22e-2688-33f5-85ed-8ce6432a9884",
                                "text": "Lui, le pansexuel, se fait avoir par sa propre théorie qui resurgit dans le réel."
                            }
