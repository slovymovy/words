                                        "sense_id": "bf2c36b4-eb86-35f2-96dd-265397bf982e",
                                        "entry_id": "c91d1ad1-e048-34a6-a15d-cd4d33d284cb",
                                        "glosses": [
                                            "durch Abstammung oder besondere Leistungen privilegierte Schicht"
