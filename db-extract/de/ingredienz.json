                                        "sense_id": "26814ffc-b1bb-3aec-8b4c-167e6ab774f7",
                                        "entry_id": "ec1d926a-a044-3cb3-929e-cdde73350007",
                                        "glosses": [
                                            "A smaller, self-contained part of a larger entity. Often refers to a manufactured object that is part of a larger device."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a1bc149-1038-4093-b2d9-4072db6d75bc",
                                                "sense_id": "26814ffc-b1bb-3aec-8b4c-167e6ab774f7",
                                                "text": "A CPU is a component of a computer."
                                            },
                                            {
                                                "example_id": "8c5d57a7-82cb-4130-a7a4-a8f9126d7197",
                                                "sense_id": "26814ffc-b1bb-3aec-8b4c-167e6ab774f7",
                                                "text": "Oxygen levels on Earth skyrocketed 2.4 billion years ago, when cyanobacteria evolved photosynthesis:[…]. The evolutionary precursor of photosynthesis is still under debate, and a new study sheds light. The critical component of the photosynthetic system is the “water-oxidizing complex”, made up of manganese atoms and a calcium atom."
                                            },
                                            {
                                                "example_id": "ea93a380-e89a-456c-bda7-3b94a041129c",
                                                "sense_id": "26814ffc-b1bb-3aec-8b4c-167e6ab774f7",
                                                "text": "Lying is a key component of communism."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e37bdfc6-c2cc-3ffc-93d1-622542375224",
                                        "entry_id": "ec1d926a-a044-3cb3-929e-cdde73350007",
                                        "glosses": [
                                            "A connected subgraph that is not part of any larger connected subgraph."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
