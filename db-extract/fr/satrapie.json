        "fr-extract.jsonl": [
            {
                "entry_id": "6afef4ab-c9d0-34b7-b8a9-20a261c0b71c",
                "word": "satrapie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e21d9cac-4ae8-4c57-b3d9-45724553b5dc",
                        "entry_id": "6afef4ab-c9d0-34b7-b8a9-20a261c0b71c",
                        "tags": [
                            "plural"
                        ],
                        "form": "satrapies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "01a8d694-6879-37e7-8e3f-de048ba60e7a",
                        "entry_id": "6afef4ab-c9d0-34b7-b8a9-20a261c0b71c",
                        "glosses": [
                            "Gouvernement d’un satrape."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d29fecb-45c9-4bd9-a448-31523223e13b",
                                "sense_id": "01a8d694-6879-37e7-8e3f-de048ba60e7a",
                                "text": "Les mages d’Atropatène, munis de pyrées ambulants montés sur des chars de prière, pénétrèrent dans le pays derrière les cavaliers et, parcourant une à une les satrapies arméniennes, s’acharnèrent à éteindre les croyances locales et à humilier les divinités dissidentes."
                            },
                            {
                                "example_id": "79d39e2c-a49c-4125-8ca4-db5a26b423e2",
                                "sense_id": "01a8d694-6879-37e7-8e3f-de048ba60e7a",
                                "text": "Pour faire corps et chair et renverser les satrapies existantes, un autre type d'intelligence sociale et d'imagination culturelle est à inventer."
                            }
                        ]
                    },
                    {
                        "sense_id": "351570b5-944d-3e15-ad05-4a0d9d8d42c0",
                        "entry_id": "6afef4ab-c9d0-34b7-b8a9-20a261c0b71c",
                        "glosses": [
                            "(par extension) Gouvernement despotique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "640333fa-7d32-43f2-82a1-fc5887a3f154",
                                "sense_id": "351570b5-944d-3e15-ad05-4a0d9d8d42c0",
                                "text": "Près de quarante ans après que « le vent de l’est » eut emporté les satrapies africaines de la guerre froide, et malgré la « relance » qu’aurait pu être le Printemps arabe, l’état de la démocratie en Afrique atteste ce fait ."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f4511d90-93be-4664-a1ac-ee459a5c2e30",
                        "source_entry_id": "6afef4ab-c9d0-34b7-b8a9-20a261c0b71c",
                        "target_lang_word": "Satrapie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "cf354c9f-9a8a-46bf-8e8a-4943d9fa77eb",
                        "source_entry_id": "6afef4ab-c9d0-34b7-b8a9-20a261c0b71c",
                        "target_lang_word": "satrapy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "satrapy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dec0d51b-8062-3df6-a3b3-0eee75d0b9f2",
                                        "entry_id": "a5f82332-a427-3b7e-9ff0-418d84e0a97f",
                                        "glosses": [
                                            "The territory governed by a satrap; a province of any of several ancient empires of West Asia (specifically, of the Median or Achaemenid empires or certain of their successors, including the Sasanian Empire and Hellenistic empires)."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f03c6ad-7f1f-49e3-9184-b8979e4ac335",
                                                "sense_id": "dec0d51b-8062-3df6-a3b3-0eee75d0b9f2",
                                                "text": "Several, which occur as one Satrapy in the system given by Herodotus, are given in the lists as distinct provinces."
                                            },
                                            {
                                                "example_id": "c2fd219c-0431-4b05-8046-ff5268b3d31c",
                                                "sense_id": "dec0d51b-8062-3df6-a3b3-0eee75d0b9f2",
                                                "text": "1951, W. W. Tarn, The Greeks in Bactria and India, Cambridge University Press, 2nd Edition, Digital printing 2010, page 1,\nThe Seleucid empire in its turn was still, in outward shape, very much the empire of Persia under different rulers; the great satrapies still remained, their military nature emphasised by the governor of a satrapy being no longer called satrap but strategos, 'general'."
                                            },
                                            {
                                                "example_id": "3af8fea4-d995-4b32-ab29-07bbf5c2cf29",
                                                "sense_id": "dec0d51b-8062-3df6-a3b3-0eee75d0b9f2",
                                                "text": "A satrapy′s borders were generally the same as those of the previously independent kingdom, with the satrap stationed in the old capital.[…]The Great King expected two things from the satrapies: a regular supply of taxes (called \"tribute\" because it underlined the satrapy′s subordination to the king) and units for the Persian army when needed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
