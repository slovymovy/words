                                                "example_id": "bea02c26-6d64-4fc4-a977-eb1786135d85",
                                                "sense_id": "3003d4f7-6ff6-3db7-a777-b246dd6b6585",
                                                "text": "Elle promena ma plume dans l’encrier, comme un aviron dans un lac, et me la jeta au nez le bec en avant."
                                            }
