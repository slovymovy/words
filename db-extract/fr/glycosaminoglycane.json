                        "entry_id": "7eca3123-af74-340f-bfeb-f4e6404716e2",
                        "glosses": [
                            "Composant important des tissus conjonctifs de nature glucidique (répétition de diholosides) et à caractère acide."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81c5a7ed-1d41-4bf7-aba3-191055349faa",
                                "sense_id": "2c39275b-cc17-346c-b048-7ffa626abe0c",
                                "text": "La plupart des chaînes de glycosaminoglycane consistent en des répétitions d’un disaccharide constitué d’un sucre aminé (souvent N-acétylé) et d’acide uronique (un sucre avec un groupe carboxylate)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "415a3ee8-9e06-4e98-ac30-44405eb7a8d8",
                        "source_entry_id": "7eca3123-af74-340f-bfeb-f4e6404716e2",
                        "source_sense_id": "2c39275b-cc17-346c-b048-7ffa626abe0c",
