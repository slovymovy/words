                    }
                ],
                "senses": [
                    {
                        "sense_id": "c8aca0a1-682f-30f1-8d5c-4636b3d25459",
                        "entry_id": "b45afeab-60a7-3a15-8c53-382572560e41",
                        "glosses": [
                            "A small, hollow case of choux pastry with a filling."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72a37504-5f25-44cd-9f25-4c5427aa74f0",
                                "sense_id": "c8aca0a1-682f-30f1-8d5c-4636b3d25459",
                                "text": "Dover sole, and Oeufs Mornay\n Profiteroles and Peach Flambe\n The waiters dance on fingertips\n The nights we dine at Hotel Ritz"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "43a6f064-6191-4b51-aa6d-c768181a4fc1",
                        "source_entry_id": "b45afeab-60a7-3a15-8c53-382572560e41",
                        "source_sense_id": "c8aca0a1-682f-30f1-8d5c-4636b3d25459",
                        "source_sense_description": "choux pastry with filling",
                        "target_lang_word": "profiterole",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "profiterole",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "26970697-5cfd-3adf-9034-2fde6c9e79ff",
                                        "entry_id": "0b60b631-5a0f-3044-a8ab-e1245b2d7e51",
                                        "glosses": [
                                            "Petit chou, souvent fourré de crème glacée."
                                        ],
                                        "tags": [
                                            "Pâtisserie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e690321-3851-463f-89fb-3f31139ab35b",
                                                "sense_id": "26970697-5cfd-3adf-9034-2fde6c9e79ff",
                                                "text": "La profiterole qui tenait en équilibre dans la cuillère de Maggy tomba directement sur son nouveau pantalon en lin crème tellement elle fut choquée."
                                            },
                                            {
                                                "example_id": "5f4b3fe0-f53f-45b8-ad15-d8c46315a0d8",
                                                "sense_id": "26970697-5cfd-3adf-9034-2fde6c9e79ff",
                                                "text": "Il est peu apparent que le petit bonhomme [l'élève de l'abbé] se trouve un jour réduit, dans les bois ou ailleurs, à des ragoûts de truffes ou à des profiteroles au chocolat pour toute nourriture.",
                                                "translation": "Jean-Jacques Rousseau, Lettre à l'abbé M., 14 mars 1770"
                                            },
                                            {
                                                "example_id": "9cb26685-0954-4303-b01d-d1658607a4bf",
                                                "sense_id": "26970697-5cfd-3adf-9034-2fde6c9e79ff",
                                                "text": "Jed décida, finalement, de sortir les profiteroles. Son père les considéra avec stupéfaction, comme un objet entièrement nouveau, à quoi rien, dans sa vie antérieure, ne l’aurait préparé. Il en prit une, la fit tourner entre ses doigts, la considérant avec autant d’intérêt qu’il l’aurait fait d’une crotte de chien ; mais il la mit, finalement, dans sa bouche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6590249f-bac1-311a-b4d1-418da8cb89f5",
                                        "entry_id": "0b60b631-5a0f-3044-a8ab-e1245b2d7e51",
                                        "glosses": [
                                            "Petit pain sans mie cuit sous la cendre et que l'on garnit de petits morceaux d'abats, de béatilles. → voir vol-au-vent"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0990604c-6f3c-44b5-8937-95acaa895fe1",
                                                "sense_id": "6590249f-bac1-311a-b4d1-418da8cb89f5",
                                                "text": "Par éviscération abdominale, le légiste (aidé d’une brigade de mitrons) dénombra par ordre d’entrée en scène : 18 tartelettes amandines, 26 pets-de-nonne, 13 paris-brest, 8 polonaises, 3 apfelstrudels, 1 demi saint-honoré, 5 poires Bourdaloue, 6 religieuses, 34 profiteroles, 3 quarts de kugelhopf, 1 brioche à la parisienne, 1 cake à l’ancienne, 3 babas au rhum et 137 éclairs au chocolat et 2 au café."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d3aa858a-9569-405b-8549-e70516647e8c",
                        "source_entry_id": "b45afeab-60a7-3a15-8c53-382572560e41",
                        "source_sense_id": "c8aca0a1-682f-30f1-8d5c-4636b3d25459",
