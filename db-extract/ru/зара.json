                "senses": [
                    {
                        "sense_id": "6a8b083c-df48-330a-831b-1d25bff80ba7",
                        "entry_id": "1e6b011f-28bb-314f-add8-c24900810f59",
                        "glosses": [
                            "итальянское название хорватского города Задар"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "604fd152-9ede-433a-bf27-51fe7fa5152b",
                                "sense_id": "6a8b083c-df48-330a-831b-1d25bff80ba7",
                                "text": "Австрия Загреб, 18 (31), X. Во всей Далмации приняты чрезвычайные меры против могущего возникнуть народного восстания. Из Каттаро перенесена военная казна в Задар (Зара)."
                            },
                            {
                                "example_id": "71e3e782-9419-4ea4-9299-4e7667309059",
                                "sense_id": "6a8b083c-df48-330a-831b-1d25bff80ba7",
                                "text": "К вечеру того же дня подул попутный ветер. Сутки двигались с этим ветром, но затем пришлось войти в далматинский порт Зара, потому что начал дуть противоположный ветер, называемый итальянцами сирокко."
                            }
                        ]
                    }
