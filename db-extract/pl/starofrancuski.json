                    },
                    {
                        "translation_id": "3af16f08-421f-4321-b8be-7c580915922b",
                        "source_entry_id": "e2293e56-fb8d-32d5-886b-45ccec3aa7fb",
                        "source_sense_id": "afd85a6f-605c-3ea9-9980-130eba994332",
                        "target_lang_word": "Altfranzösisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Altfranzösisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8cbaa3e9-3b83-36ef-a422-fc030d8df014",
                                        "entry_id": "b9654f9c-ac6f-3e01-aa35-dc9ced2f8e50",
                                        "glosses": [
                                            "bis ins 14. Jahrhundert vorwiegend in Nord- und Zentralfrankreich, Belgien und in Teilen der Schweiz gesprochene romanische Sprache, die vom Mittelfranzösischen abgelöst wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f89fbc7d-a9db-41f1-b0e6-b10be2b3e692",
                                                "sense_id": "8cbaa3e9-3b83-36ef-a422-fc030d8df014",
                                                "text": "„Frankreich war kulturelles und wissenschaftliches Zentrum Europas und das Altfranzösische wurde neben dem Mittellatein zur wirkungsmächtigsten Vernakularsprache des europäischen Mittelalters.“"
                                            },
                                            {
                                                "example_id": "fac6a001-666c-44f3-84c2-36c99edf88fd",
                                                "sense_id": "8cbaa3e9-3b83-36ef-a422-fc030d8df014",
                                                "text": "„Zahlreiche Wörter der Romanischen Komponente lassen sich eindeutig auf das Altfranzösische oder sogar ein mittelalterliches Jüdisch-Französisch zurückführen.“"
                                            },
                                            {
                                                "example_id": "71c58f4f-0ca5-4e6a-a2dc-933fa5869b39",
                                                "sense_id": "8cbaa3e9-3b83-36ef-a422-fc030d8df014",
                                                "text": "„Mit den äußeren gesellschaftlichen Formen, die die deutschen Ritter übernahmen, gelangten jetzt auch viele Wörter aus dem Altfranzösischen (aus dem Französischen des 11. bis 13. Jahrhunderts) ins Mittelhochdeutsche.“"
                                            },
                                            {
                                                "example_id": "fd578445-7c5d-426a-94d8-3bd33e4c8a56",
                                                "sense_id": "8cbaa3e9-3b83-36ef-a422-fc030d8df014",
                                                "text": "„Im Altfranzösischen ist er ein Meister; von den Surrealisten hat er vorzügliche Übertragungen gemacht; aber eine einfache Sache zu sagen, wie: »Zum Teufel, hau doch ab, du alter Hurenbock!« – das bringt er nicht fertig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
