                    "sense_id": "755ac5d9-4c56-3e3c-be70-5d1fb9ea4d23",
                    "sense_definition": "gebruikt om te benadrukken dat iets echt of waar is",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "nadruk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik heb <w>werkelijk</w> geen idee waar mijn sleutels zijn gebleven.",
                            "target_lang_translations": {
                                "en": "I <w>really</w> have no idea where my keys have gone.",
                                "ru": "У меня <w>действительно</w> нет ни малейшего представления, куда делись мои ключи.",
                                "pl": "<w>Naprawdę</w> nie mam pojęcia, gdzie podziały się moje klucze.",
                                "de": "Ich habe <w>wirklich</w> keine Ahnung, wo meine Schlüssel geblieben sind.",
                                "fr": "Je n'ai <w>vraiment</w> aucune idée d'où sont passées mes clés.",
                                "it": "Non ho <w>davvero</w> idea di dove siano finite le mie chiavi.",
                                "cs": "Já <w>opravdu</w> nemám tušení, kam se mé klíče poděly.",
                                "tr": "Anahtarlarımın nereye gittiğine dair <w>gerçekten</w> hiçbir fikrim yok.",
                                "es": "No tengo <w>realmente</w> ni idea de dónde han ido a parar mis llaves.",
                                "zh": "我<w>真的</w>不知道我的钥匙去哪儿了。"
                            }
                        },
                        {
                            "text": "Het was <w>werkelijk</w> prachtig om de zon in de zee te zien zakken.",
                            "target_lang_translations": {
                                "en": "It was <w>truly</w> beautiful to see the sun sink into the sea.",
                                "ru": "Это было <w>по-настоящему</w> прекрасно — видеть, как солнце погружается в море.",
                                "pl": "To było <w>rzeczywiście</w> piękne, patrzeć jak słońce zachodzi do morza.",
                                "de": "Es war <w>wirklich</w> wunderschön, die Sonne im Meer versinken zu sehen.",
                                "fr": "C'était <w>vraiment</w> magnifique de voir le soleil se coucher dans la mer.",
                                "it": "È stato <w>veramente</w> bellissimo vedere il sole tramontare nel mare.",
                                "cs": "Bylo to <w>skutečně</w> nádherné vidět slunce zapadat do moře.",
                                "tr": "Güneşin denize batışını izlemek <w>gerçekten</w> harikaydı.",
                                "es": "Fue <w>verdaderamente</w> hermoso ver al sol ponerse en el mar.",
                                "zh": "看着太阳落入海中，那景象<w>确实</w>美极了。"
                            }
                        }
                    ],
