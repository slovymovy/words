                        "entry_id": "0189bb83-a6fd-3c75-b39e-68d4ec1fdca2",
                        "glosses": [
                            "een kermisattractie waarbij je met een wagentje door een constructie rijdt waarbij je steeds enge dingen tegen komt waarvan je zou kunnen schrikken."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f6c780b-1ecb-4d4a-b020-adcb5a32a7c4",
                                "sense_id": "5417183c-2404-3c0d-aac3-454ce5130812",
                                "text": "Het meisje werd door de jongen liefdevol beschermd tijdens de rit door het spookhuis."
                            }
                        ]
                    },
                    {
                        "sense_id": "62196e5f-8748-3b7c-af1e-00a3e3596621",
                        "entry_id": "0189bb83-a6fd-3c75-b39e-68d4ec1fdca2",
                        "glosses": [
                            "een huis waarin het zou spoken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c66aab8f-befb-4a92-b1a5-8d4bb473a0f4",
                                "sense_id": "62196e5f-8748-3b7c-af1e-00a3e3596621",
                                "text": "In Engeland zijn er veel spookhuizen in het meer nuchtere Nederland voelen spoken zich minder thuis en zijn er dan ook veel minder van dit soort betoverde gebouwen."
                            }
                        ]
                    },
                    {
                        "sense_id": "c5187e72-1d9c-3bf3-868a-e30776e4efaf",
                        "entry_id": "0189bb83-a6fd-3c75-b39e-68d4ec1fdca2",
                        "glosses": [
                            "een oud, leeg en verlaten huis"
