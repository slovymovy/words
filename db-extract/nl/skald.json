                ],
                "senses": [
                    {
                        "sense_id": "c680fa51-d0b0-32f9-8c73-fa06927091d6",
                        "entry_id": "c3be14ad-9644-3f71-8dbf-b0d3029b782f",
                        "glosses": [
                            "een Noordse hofdichter, heldendichter, volksdichter, dichterzanger en geschiedschrijver"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "640dfd97-d5a1-4c2c-ac38-5d42182b3c25",
                                "sense_id": "c680fa51-d0b0-32f9-8c73-fa06927091d6",
                                "text": "Skalden schreven gedichten over de Noordse mythologie in allitererende versvorm."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e8310120-e707-4663-b01f-21459c664999",
                        "source_entry_id": "c3be14ad-9644-3f71-8dbf-b0d3029b782f",
                        "source_sense_id": "c680fa51-d0b0-32f9-8c73-fa06927091d6",
                        "source_sense_description": "een Noordse hofdichter, heldendichter, volksdichter, dichterzanger en geschiedschrijver.",
                        "target_lang_word": "Skalde",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Skalde",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a8de4258-12fa-38d5-b72e-728e7363d95d",
                                        "entry_id": "4745bfde-d1f9-3c87-b6b8-8e1f806c69f7",
                                        "glosses": [
                                            "reisender Dichter im mittelalterlichen Island und Norwegen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8a5f5db-788a-4fb8-bb75-a2c11a0186ea",
                                                "sense_id": "a8de4258-12fa-38d5-b72e-728e7363d95d",
                                                "text": "„Bereits in den Jahren der Landnahme ziehen Skalden über die Vulkaninsel: reisende Dichter, die von Hof zu Hof ziehen, um gegen Lohn Preislieder zu verfassen.“"
                                            },
                                            {
                                                "example_id": "cec7bdc3-ec6d-44dc-9793-097764001e0f",
                                                "sense_id": "a8de4258-12fa-38d5-b72e-728e7363d95d",
                                                "text": "„Denn der Wert des Preisliedes wird nicht durch die Wärme und Aufrichtigkeit der vom Dichter darin ausgesprochenen Gefühle bestimmt - war der Skalde doch ein fahrender Sänger, der von Hof zu Hof zog - sondern nur durch die genaue Befolgung der für diese Gattung gültigen Regeln.“"
                                            },
                                            {
                                                "example_id": "13f3d800-1fbe-448f-9483-702b01230647",
                                                "sense_id": "a8de4258-12fa-38d5-b72e-728e7363d95d",
                                                "text": "„Meines Vaters Helden hatten menschlichere Züge, vor allem mußten sie, um sein volles Vertrauen zu haben, wenigstens Stammväter, oder vor allen Dingen Skalden sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a8366406-1355-4e6c-bc42-df53ed6a3fe9",
                        "source_entry_id": "c3be14ad-9644-3f71-8dbf-b0d3029b782f",
                        "source_sense_id": "c680fa51-d0b0-32f9-8c73-fa06927091d6",
                        "source_sense_description": "een Noordse hofdichter, heldendichter, volksdichter, dichterzanger en geschiedschrijver.",
                        "target_lang_word": "Barde",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Barde",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fdae9019-cea0-372d-8288-479ec4c0c832",
                                        "entry_id": "91134dc7-38ce-3795-9a6e-f3589a51ab5d",
                                        "glosses": [
                                            "keltischer Sänger und Dichter"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d50af562-0aea-4b6d-8e4a-5f1ace8e90d5",
                                                "sense_id": "fdae9019-cea0-372d-8288-479ec4c0c832",
                                                "text": "„Die Barden erscheinen hauptsächlich als Dichter, Sänger, Musiker (auf der ‚Krotta‘ oder Leier) und Lobpreiser, ihre genaue Beziehung zu Druiden und Vaten bleibt im Dunkeln.“"
                                            },
                                            {
                                                "example_id": "40c033f2-95d7-4fba-a5ca-59ff0ba42296",
                                                "sense_id": "fdae9019-cea0-372d-8288-479ec4c0c832",
                                                "text": "„Für Unterhaltung bei den Gastmählern sorgten vor allem die Barden (…): Dichter und Sänger, die ihre Heldengesänge meist in Begleitung einer Harfe vortrugen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8a67e715-f563-3bc4-9053-0826248cc3bc",
                                        "entry_id": "91134dc7-38ce-3795-9a6e-f3589a51ab5d",
                                        "glosses": [
                                            "jemand, der Lieder verfasst und selbst vorträgt"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58771843-c60f-42f1-8c3e-b44fab5ae9d0",
                                                "sense_id": "8a67e715-f563-3bc4-9053-0826248cc3bc",
                                                "text": "„Der niederbayerische Barde Fredl Fesl schaffte es mit seiner unnachahmlichen Art, dass seine Fans Tränen lachten.“"
                                            },
                                            {
                                                "example_id": "df4b27a5-0904-42e2-afae-acb7dab8c4af",
                                                "sense_id": "8a67e715-f563-3bc4-9053-0826248cc3bc",
                                                "text": "„Die Lächerlichkeit der Situation entgeht Hoffmann nicht; keinerlei Lächerlichkeit ist ihm jemals entgangen, und im gleichen Sinn wie Sterne ist er ein wahrhafter Barde des Grotesken.“"
                                            },
                                            {
                                                "example_id": "f44e2941-f620-4e39-957c-19550de8e28c",
                                                "sense_id": "8a67e715-f563-3bc4-9053-0826248cc3bc",
                                                "text": "„Was jedoch überrascht, ist, dass der Barde viele seiner Wörter wieder streicht und eine sehr sparsame Zeichensetzung wählt: Es gibt einige wenige Kommas und ein paar Punkte, aber keine Frage- und Ausrufezeichen, auch nicht an Stellen, an denen wir sie ohne jeden Skrupel einsetzen würden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Barde",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "29a9c566-26c7-3cbc-a238-10c786c3dd67",
                                        "entry_id": "6051c60f-1b16-3a39-a6ef-83d3054071ae",
                                        "glosses": [
                                            "Scheibe von (fettem) Speck, mit der mageres Fleisch beim Braten umwickelt oder belegt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec4dc249-2f0f-409a-8877-2fe2d30868e0",
                                                "sense_id": "29a9c566-26c7-3cbc-a238-10c786c3dd67",
                                                "text": "Barden um die Wachtelbrüstchen verhindern das Austrocknen des Fleisches."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c67ca453-6cc4-4a3c-a348-4797f24e1fd6",
                        "source_entry_id": "c3be14ad-9644-3f71-8dbf-b0d3029b782f",
