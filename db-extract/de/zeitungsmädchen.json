                "senses": [
                    {
                        "sense_id": "b4721762-f37b-3d11-b3c9-42e0b7fd0b2a",
                        "entry_id": "aafec222-3a59-323e-998d-e6e35223a087",
                        "glosses": [
                            "junge, weibliche Person, die auf der Straße Zeitungen verkauft oder ins Haus liefert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bcc00938-60a8-4477-9cba-24240ae4a210",
                                "sense_id": "b4721762-f37b-3d11-b3c9-42e0b7fd0b2a",
                                "text": "„Den Liedtext summt Lilly, wenn sie in der ‚Realität‘ auf das sie ‚vertretende‘ Zeitungsmädchen, die Doppelgänger-‚Realität‘ der durch Konsenstext der Medienwelt konstituierten Identität, trifft: […]“"
                            },
                            {
                                "example_id": "617a93ea-6ae1-49a4-8bee-73b79ec0e400",
                                "sense_id": "b4721762-f37b-3d11-b3c9-42e0b7fd0b2a",
                                "text": "„Natürlich wurde ich an diesem Abend ohnehin nicht wirklich wahrgenommen. War ich doch kaum mehr als ein Zeitungsmädchen.“"
                            },
                            {
                                "example_id": "8cd92ff1-8dd7-4e57-8ffd-6473f8e66114",
                                "sense_id": "b4721762-f37b-3d11-b3c9-42e0b7fd0b2a",
                                "text": "„Du steckst schon so lange in diesem Scheiß-Kaff fest und jeder kennt dich als das kleine Zeitungsmädchen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
