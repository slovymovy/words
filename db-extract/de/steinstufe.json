                        "glosses": [
                            "Stufe, die aus Stein besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a28daa5f-70f1-4099-8ecc-eb20f34fba6e",
                                "sense_id": "191f8a97-5697-37c7-be51-f408ec9cf12d",
                                "text": "„Wenige breit ausgetretene Steinstufen führten zu einem freistehenden Rundbogen, der vermutlich einmal zum Innentor eines antiken Palastes gehört hatte.“"
                            },
                            {
                                "example_id": "ef458dff-2797-4eef-9e04-b4e0856553ca",
                                "sense_id": "191f8a97-5697-37c7-be51-f408ec9cf12d",
                                "text": "„Da gehen Steinstufen hinunter in eine Kneipe.“"
                            },
                            {
                                "example_id": "87b9dc4d-f5ac-4571-bd79-2d63dccccd09",
                                "sense_id": "191f8a97-5697-37c7-be51-f408ec9cf12d",
                                "text": "„Die Böden in der Burg sind weggefault, und du steigst die Steinstufen hinauf, die Dunkelheit ringsum wird mit jedem Schritt nach oben tiefer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
