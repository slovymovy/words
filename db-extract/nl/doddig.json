                "senses": [
                    {
                        "sense_id": "88275e08-fbed-3a25-a435-a3bddb704afb",
                        "entry_id": "f35fecd9-568e-3bc2-9f17-514eb1b6c781",
                        "glosses": [
                            "op een zachte manier lief"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fef431e3-132a-472a-ac0f-73e56c76e6e6",
                                "sense_id": "88275e08-fbed-3a25-a435-a3bddb704afb",
                                "text": "Alleen... ik ben een zonen-moeder. En op het moment dat ik je groot gelijk geef, slaat ook bij mij de paniek toe: wie van van mijn twee kinderen zal op een kwade dag aan één of andere balk hangen... Want een hart breken, dat zullen ze. En zo zie ik uiteindelijk ook mijn eigen doddige hartenbrekers bij jou op zolder bungelen."
                            },
                            {
                                "example_id": "7630aabf-df89-4234-9d79-21d75d3f6125",
                                "sense_id": "88275e08-fbed-3a25-a435-a3bddb704afb",
                                "text": "Was Heel Holland Bakt voorheen zo’n doddig bakprogamma, met de rel rond kandidaat Maroeska Metz kwam daar dit jaar definitief een einde aan."
                            }
                        ]
                    }
                ],
