                "senses": [
                    {
                        "sense_id": "3a540095-b3be-3603-9070-f9c349667875",
                        "entry_id": "6376d667-5948-3717-b792-f32fe7ba5f8d",
                        "glosses": [
                            "Veranstaltung, die der Aufklärung, Unterrichtung und Diskussion über ein Thema dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dcd1dc9a-a6b1-4637-a33b-4f52eeb9b4c5",
                                "sense_id": "3a540095-b3be-3603-9070-f9c349667875",
                                "text": "„Er kannte es aus einer Informationsveranstaltung des Sicherheitsdienstes der Botschaft, in der es als einer der Orte genannt worden war, an denen sich ein Botschaftsmitarbeiter niemals, unter gar keinen Umständen aufhalten durfte.“"
                            },
                            {
                                "example_id": "b98e7cbe-da8f-4336-a19b-5b0613ed5d03",
                                "sense_id": "3a540095-b3be-3603-9070-f9c349667875",
                                "text": "„Das Landratsamt hatte Anfang Juni wegen der beiden Fälle zu einer Informationsveranstaltung eingeladen und Antworten auf Fragen besorgter Anwohner gegeben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
