                ],
                "senses": [
                    {
                        "sense_id": "b2c562a3-1734-3bcf-90a5-8e53b353be02",
                        "entry_id": "75bf4505-d518-316b-b54c-11dbe67daa76",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f86fbc0-e408-4c04-b6d1-98869f00027d",
                                "sense_id": "b2c562a3-1734-3bcf-90a5-8e53b353be02",
                                "text": "Frau Frenzle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "d89b5ae8-be0d-43c5-ac4a-b519f0f20b25",
                                "sense_id": "b2c562a3-1734-3bcf-90a5-8e53b353be02",
                                "text": "Herr Frenzle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "b3351a8c-cc4d-4d4f-b8e1-3df36c0446f8",
                                "sense_id": "b2c562a3-1734-3bcf-90a5-8e53b353be02",
                                "text": "Die Frenzles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "52c34db3-4468-4294-a7a0-05995c826b6d",
                                "sense_id": "b2c562a3-1734-3bcf-90a5-8e53b353be02",
                                "text": "Der Frenzle trägt nie die Schals, die die Frenzle ihm strickt."
                            },
                            {
                                "example_id": "a1df4cc4-252d-4f95-b6f3-35618817f20b",
                                "sense_id": "b2c562a3-1734-3bcf-90a5-8e53b353be02",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Frenzle kommt, geht der Herr Frenzle.“"
                            },
                            {
                                "example_id": "a7253b0e-cab3-44a8-9133-504a2993c44a",
                                "sense_id": "b2c562a3-1734-3bcf-90a5-8e53b353be02",
                                "text": "Frenzle kommt und geht."
                            },
                            {
                                "example_id": "e3e4d3fd-4e7f-4445-a810-84492d7157dc",
                                "sense_id": "b2c562a3-1734-3bcf-90a5-8e53b353be02",
                                "text": "Frenzles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
