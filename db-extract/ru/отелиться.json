                    {
                        "translation_id": "abc46b07-9da3-41fa-ba68-a67d6ff1757d",
                        "source_entry_id": "2d6243b4-f442-35ab-896c-0cbfd6daba85",
                        "source_sense_id": "5efd0d4a-03e1-3162-991d-ecc7d2c3fae9",
                        "target_lang_word": "vêler",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vêler",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "55940a6d-cdfe-360b-a0aa-ecb78b13e14c",
                                        "entry_id": "c8a2ae1a-89c6-3846-ab74-6cad9e0a4550",
                                        "glosses": [
                                            "Mettre bas, en parlant d’une vache."
                                        ],
                                        "tags": [
                                            "Élevage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "985d8aaa-2166-4ad0-a8bf-610cfa7c3206",
                                                "sense_id": "55940a6d-cdfe-360b-a0aa-ecb78b13e14c",
                                                "text": "Pourvu que la Coliche ne vêle pas en même temps que moi ! répétait Lise chaque matin."
                                            },
                                            {
                                                "example_id": "f61eb47c-cea2-4b22-bc82-300fced383d9",
                                                "sense_id": "55940a6d-cdfe-360b-a0aa-ecb78b13e14c",
                                                "text": "Pourtant cette nuit-là, on avait mal dormi : la génisse aux Mortiers vêlait et le Camille y avait veillé jusqu’au petit jour."
                                            },
                                            {
                                                "example_id": "ed4a3a94-84ac-4b2f-949c-c0a54446a508",
                                                "sense_id": "55940a6d-cdfe-360b-a0aa-ecb78b13e14c",
                                                "text": "Or, cette année-là, vers la fin de l’été, l’oncle Stavolo eut une vache prête à vêler. C’était la plus belle vache d’Eckerswir, de l’espèce suisse, grande, couleur café au lait, très-bonne laitière, et qui s’appelait Rœsel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3cf33f48-ca7f-3809-a497-348b230a083a",
                                        "entry_id": "c8a2ae1a-89c6-3846-ab74-6cad9e0a4550",
                                        "glosses": [
                                            "Rejeter d’importantes masses de glace dans la mer, en parlant d’un glacier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b660edc-5a56-4882-b6e5-0386fcc846fe",
                                                "sense_id": "3cf33f48-ca7f-3809-a497-348b230a083a",
                                                "text": "L’inlandsis du continent groenlandais se déversant lentement mais continuellement dans les fjords par des glaciers importants, vêle des icebergs de tailles variant à l’infini […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
