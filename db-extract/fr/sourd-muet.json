                                                "sense_id": "346cb75c-5be9-3680-83b8-f2404f635a11",
                                                "text": "Meine Mutter ist taubstumm."
                                            },
                                            {
                                                "example_id": "36db4ea8-8e17-4e4d-a343-38043c069d9b",
                                                "sense_id": "346cb75c-5be9-3680-83b8-f2404f635a11",
                                                "text": "Sie bringt taubstummen Kindern die Gebärdensprache bei."
                                            },
