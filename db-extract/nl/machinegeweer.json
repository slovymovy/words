                                "sense_id": "e4c6dabd-f235-3b25-b965-f4114b142d3d",
                                "text": "Het machinegeweer vuurde een stroom kogels uit.",
                                "translation": "The machine gun fired a stream of bullets.",
                                "english": "The machine gun fired a stream of bullets."
                            },
                            {
                                "example_id": "c0cad231-01e3-4ea5-b3af-bc52831a708b",
                                "sense_id": "e4c6dabd-f235-3b25-b965-f4114b142d3d",
                                "text": "Hij droeg een zwaar machinegeweer tijdens de missie.",
                                "translation": "He carried a heavy machine gun during the mission.",
