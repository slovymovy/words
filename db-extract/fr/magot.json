                        ],
                        "examples": [
                            {
                                "example_id": "874ace62-cfee-4e23-9efd-b8919986cbe2",
                                "sense_id": "422bfddc-efaf-3adc-be56-20f9f1d59bcd",
                                "text": "— Enfin, il n'en parle toujours pas dans son testament. Et, tout de même, s'il venait à mourir, tout d'un coup, sans avoir le temps de se reconnaître, le magot serait à nous."
                            }
