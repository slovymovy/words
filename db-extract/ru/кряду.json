                        "entry_id": "010a57c5-db82-32dc-8eca-29d4cc355cee",
                        "glosses": [
                            "straight, in a row, in succession, running"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "193ffa05-5bc8-4213-8f5e-632ac4104b41",
                                "sense_id": "63735934-d228-3032-831e-949d51459ebf",
                                "text": "Две но́чи кря́ду",
                                "translation": "two nights in a row",
                                "english": "two nights in a row"
                            },
                            {
                                "example_id": "b925adb1-77a7-4e39-9555-28e12798d488",
                                "sense_id": "63735934-d228-3032-831e-949d51459ebf",
                                "text": "Во́семь часо́в кря́ду",
                                "translation": "eight hours straight",
                                "english": "eight hours straight"
                            },
                            {
                                "example_id": "e2525fd6-b72b-486d-8866-17607c161485",
                                "sense_id": "63735934-d228-3032-831e-949d51459ebf",
                                "text": "Доктор был бледен и покачивался, и заметно было, что если он только приляжет — он заснет на несколько суток кряду.",
                                "translation": "The doctor was pale and tottering, and one could see that if he were only to lie down for an instant he would fall asleep and remain so without waking for several days running.",
                                "english": "The doctor was pale and tottering, and one could see that if he were only to lie down for an instant he would fall asleep and remain so without waking for several days running."
                            }
                        ]
                    }
                ],
