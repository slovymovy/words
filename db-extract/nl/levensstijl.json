                ],
                "senses": [
                    {
                        "sense_id": "05b061bb-f82e-3a5b-8e12-0f03c1dedf57",
                        "entry_id": "aefd55c5-ad3a-3cc8-85e3-a84b8c6a7d3e",
                        "glosses": [
                            "manier van leven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4ab2acd-bdc6-4909-876c-3275e355eccb",
                                "sense_id": "05b061bb-f82e-3a5b-8e12-0f03c1dedf57",
                                "text": "De Franse levensstijl blijft een uiterst aantrekkelijk concept waaraan goed wordt verdiend, zoals Michel Houellebecq constateerde in zijn laatste roman De kaart en het gebied: luxe, elegantie, goed eten en drinken."
                            },
                            {
                                "example_id": "cd5eac2e-5065-499f-838c-4d56f5881fc3",
                                "sense_id": "05b061bb-f82e-3a5b-8e12-0f03c1dedf57",
                                "text": "Mijn lichaam moest zich constant aanpassen aan de lange afstanden en mijn nieuwe levensstijl waardoor ik heel snel steeds weer honger had."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "633df604-45e4-463d-a736-0d35c2fbcf4c",
                        "source_entry_id": "aefd55c5-ad3a-3cc8-85e3-a84b8c6a7d3e",
                        "source_sense_id": "05b061bb-f82e-3a5b-8e12-0f03c1dedf57",
                        "target_lang_word": "lifestyle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lifestyle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4cdb8979-f28d-342e-8a45-ebf778147a99",
                                        "entry_id": "2ed762bb-861a-31b1-a670-259f7f46a857",
                                        "glosses": [
                                            "A style of living that reflects the attitudes and values of a person or group."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5885dd56-a9d8-466c-8db5-0c6b19c4d41b",
                                                "sense_id": "4cdb8979-f28d-342e-8a45-ebf778147a99",
                                                "text": "The Neolithic Revolution (about 8000-3000 B.C.E.) was characterized by people moving from nomadic lifestyles to agricultural lifestyles."
                                            },
                                            {
                                                "example_id": "473245df-819b-4129-b5e1-1e76cc6de21a",
                                                "sense_id": "4cdb8979-f28d-342e-8a45-ebf778147a99",
                                                "text": "I ended my aimless-roaming-short-term-odd-jobs lifestyle and joyfully went to work at a local restaurant in Langley Park, Maryland, as a carhop."
                                            },
                                            {
                                                "example_id": "e4f33ada-2496-4174-905b-712f0a4080a1",
                                                "sense_id": "4cdb8979-f28d-342e-8a45-ebf778147a99",
                                                "text": "As we scroll through the curated lifestyles of the influencers we follow on Instagram or YouTube, it can seem like they have it all together and never had to suffer a day in their lives."
                                            },
                                            {
                                                "example_id": "9df43080-d85c-482c-9de7-cbb55c72a849",
                                                "sense_id": "4cdb8979-f28d-342e-8a45-ebf778147a99",
                                                "text": "And yet queer and transgender people are finding a place in a lifestyle that, at least online, often occupies the same digital space as content from conservative creators, said Devin Proctor, an assistant professor of anthropology at Elon University in North Carolina who studies how we construct identities online."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "769c3438-d5cb-3d84-bda7-75e3d155a104",
                                        "entry_id": "2ed762bb-861a-31b1-a670-259f7f46a857",
                                        "glosses": [
                                            "The totality of the likes and dislikes of a particular section of the market, especially when expressed in terms of the products and services that they would buy; a marketing strategy based on the self-image of such a group."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
