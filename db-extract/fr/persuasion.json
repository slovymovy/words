                                        "entry_id": "dcd5a324-b752-3729-a081-a3efe4dc4e04",
                                        "glosses": [
                                            "The capability of a person or argument to convince or persuade someone to accept a desired way of thinking."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd0e1f8b-c093-4d0f-8e43-3756846caa1f",
                                                "sense_id": "9e5412d2-47eb-349f-a8a1-21a0f932f39e",
                                                "text": "By using the utmost tact and persuasiveness, he was inducing his uncle to cough up very grudgingly a small quarterly allowance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
