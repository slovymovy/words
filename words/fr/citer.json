{
    "word_family": [
        "citation",
        "citateur",
        "réciter",
        "inciter",
        "susciter"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f47d807d-d4a6-3165-90f9-84724f8edc37",
                    "sense_definition": "Rapporter exactement les paroles de quelqu'un ou reproduire textuellement un passage d'un auteur.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "discours",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur demande aux étudiants de <w>citer</w> un auteur célèbre dans leur dissertation."
                        },
                        {
                            "text": "Dans son exposé, elle a <w>cité</w> plusieurs phrases tirées d'un poème classique."
                        }
                    ],
                    "synonyms": [
                        "rapporter"
                    ],
                    "common_phrases": [
                        "citer un auteur",
                        "citer un passage"
                    ]
                },
                {
                    "sense_id": "c89ee50a-76af-36c7-8a89-bc69c99d9e86",
                    "sense_definition": "Mentionner ou énumérer des faits, des noms ou des cas particuliers.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "discours",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pouvez-vous <w>citer</w> un exemple concret pour illustrer cette règle de grammaire ?"
                        },
                        {
                            "text": "Le journaliste a refusé de <w>citer</w> les noms de ses informateurs au cours de l'interview."
                        }
                    ],
                    "synonyms": [
                        "mentionner",
                        "nommer"
                    ],
                    "antonyms": [
                        "omettre"
                    ],
                    "common_phrases": [
                        "citer un exemple",
                        "citer des noms"
                    ]
                },
                {
                    "sense_id": "a854460c-100a-3bbb-b407-a7e23e0ade92",
                    "sense_definition": "Assigner légalement une personne à comparaître devant un tribunal ou une autorité judiciaire.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "justice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'avocat a décidé de <w>citer</w> plusieurs témoins pour éclaircir les circonstances du vol."
                        },
                        {
                            "text": "Le prévenu est formellement <w>cité</w> à comparaître devant le tribunal correctionnel dès lundi matin."
                        }
                    ],
                    "synonyms": [
                        "assigner",
                        "convoquer"
                    ],
                    "common_phrases": [
                        "citer à comparaître",
                        "citer un témoin"
                    ]
                },
                {
                    "sense_id": "b3b0f352-8238-3f6d-b2e4-b0f25bcd288a",
                    "sense_definition": "Signaler ou honorer publiquement une personne pour une action d'éclat ou une conduite remarquable.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "distinction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce jeune pompier a été <w>cité</w> à l'ordre du jour pour son courage exceptionnel."
                        },
                        {
                            "text": "Toute l'équipe l'a <w>cité</w> en exemple de persévérance et de grand professionnalisme."
                        }
                    ],
                    "synonyms": [
                        "distinguer",
                        "féliciter"
                    ],
                    "antonyms": [
                        "blâmer"
                    ],
                    "common_phrases": [
                        "citer en exemple"
                    ]
                },
                {
                    "sense_id": "190be94f-9c1b-302c-9ccc-f066a5f00a65",
                    "sense_definition": "En tauromachie, attirer et provoquer la charge du taureau en se plaçant devant lui.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "tauromachie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le torero avance avec prudence au centre de l'arène pour <w>citer</w> la bête."
                        },
                        {
                            "text": "Avec sa cape rouge, le matador <w>cite</w> le taureau afin de déclencher son attaque rapide."
                        }
                    ],
                    "synonyms": [
                        "provoquer"
                    ],
                    "common_phrases": [
                        "citer le taureau"
                    ]
                }
            ]
        }
    ]
}