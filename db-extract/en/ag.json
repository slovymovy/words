                        "examples": [
                            {
                                "example_id": "9f5cddc1-a337-4124-8fce-7c53b04ef514",
                                "sense_id": "5e33ba2e-d30a-30a6-a71a-1c5a36e74f02",
                                "text": "He got his degree from the state ag college."
                            },
                            {
                                "example_id": "3772dce3-58c6-4cdd-8011-eef678377663",
                                "sense_id": "5e33ba2e-d30a-30a6-a71a-1c5a36e74f02",
                                "text": "My class is over on ag campus."
                            },
                            {
                                "example_id": "efd48231-29a3-4a5c-9b55-0ded9c7f899a",
                                "sense_id": "5e33ba2e-d30a-30a6-a71a-1c5a36e74f02",
                                "text": "Even the most ag-centric member of the Agriculture Committee […]"
                            },
                            {
                                "example_id": "4ab7ab30-552c-4f07-854e-420ecb310b60",
                                "sense_id": "5e33ba2e-d30a-30a6-a71a-1c5a36e74f02",
                                "text": "[…] fruits and vegetables, oddly referred to in ag-speak as specialty crops, […]"
