                    }
                ],
                "senses": [
                    {
                        "sense_id": "eb46796b-ac11-38e5-945e-94c3ad4dd6ed",
                        "entry_id": "9105be93-87ad-3de0-83ca-067b57a3a7e7",
                        "glosses": [
                            "osoba pracująca w przemyśle metalowym"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98cf4db9-b988-4bf3-af5c-5dc4d9259b15",
                                "sense_id": "eb46796b-ac11-38e5-945e-94c3ad4dd6ed",
                                "text": "Świerczewski uczęszczał do szkoły powszechnej, w której skończył dwie klasy. Wraz z ojcem podjął naukę tokarstwa metali, a po jego śmierci w 1912 pracował w warszawskich zakładach Gerlacha jako pomocnik tokarza i tokarz metalowiec"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "7026e359-560a-31c9-8d8a-8e9437d32797",
                        "entry_id": "9105be93-87ad-3de0-83ca-067b57a3a7e7",
                        "glosses": [
                            "muzyk wykonujący muzykę rockową w jej odmianach nazywanych metalem (np. heavy metal, death metal, black metal, doom metal itd.)"
                        ],
                        "tags": [
                            "środ."
                        ],
                        "examples": [
                            {
                                "example_id": "a078d93c-dff9-4ba3-9829-d22025a44f0b",
                                "sense_id": "7026e359-560a-31c9-8d8a-8e9437d32797",
                                "text": "Liczyła na to, że po koncercie pozna któregoś z metalowców."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "52f82bd2-88f2-351a-8040-53d3cc4bbd7f",
                        "entry_id": "9105be93-87ad-3de0-83ca-067b57a3a7e7",
                        "glosses": [
                            "członek subkultury skupiającej się wokół środowiska związanego z heavy metalem i jego odmianami"
                        ],
                        "tags": [
                            "środ."
                        ],
                        "examples": [
                            {
                                "example_id": "ad43db86-3898-4785-9add-300b25e47a6b",
                                "sense_id": "52f82bd2-88f2-351a-8040-53d3cc4bbd7f",
                                "text": "Klasyczny styl metalowców, spotykany powszechnie od lat 80. XX wieku, to długie włosy, dżinsowe spodnie, glany, katany (często z naszywkami ulubionych zespołów), skórzane kurtki, „ramoneski”, na które często nakłada się dżinsowe kamizelki"
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "6bde1902-6a96-3131-92f4-e387d4b09911",
                        "entry_id": "9105be93-87ad-3de0-83ca-067b57a3a7e7",
                        "glosses": [
                            "wielbiciel muzyki nazywanej metalem"
                        ],
                        "tags": [
                            "colloquial",
                            "youth"
                        ],
                        "examples": [
                            {
                                "example_id": "144391d2-c182-4375-990f-c6a69ae73c7d",
                                "sense_id": "6bde1902-6a96-3131-92f4-e387d4b09911",
                                "text": "Pamiętam nieformalną „wojnę” między depeszowcami a metalowcami."
                            }
                        ],
                        "sense_index_json": "\"1.4\""
                    }
                ],
