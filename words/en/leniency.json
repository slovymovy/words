    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "197ab780-5a35-3c6f-86c9-28c1526a61ef",
                    "sense_definition": "The quality of being merciful or tolerant, especially in the context of punishment or judgment.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "leniency_quality_or_act",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The convicted felon asked for <w>leniency</w>, but the judge refused and gave the maximum sentence.",
                            "target_lang_translations": {
                                "ru": "Осуждённый преступник просил о <w>снисхождении</w>, но судья отказал и назначил максимальный срок.",
                                "nl": "De veroordeelde misdadiger vroeg om <w>clementie</w>, maar de rechter weigerde en legde de maximale straf op.",
                                "zh": "被定罪的重犯请求<w>宽大</w>处理，但法官予以拒绝并处以顶格刑罚。"
                            }
                        },
                        {
                            "text": "The defense lawyer decided to appeal for <w>leniency</w> due to the defendant's youth.",
                            "target_lang_translations": {
                                "ru": "Адвокат решил просить о <w>снисхождении</w>, ссылаясь на молодость подсудимого.",
                                "nl": "De advocaat besloot te pleiten voor <w>mildheid</w> vanwege de jonge leeftijd van de verdachte.",
                                "zh": "鉴于被告年纪尚轻，辩护律师决定恳请对其予以<w>从轻处理</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "clemency",
                        "lenience",
                        "mercy"
                    ],
                    "antonyms": [
                        "severity",
                        "harshness",
                        "strictness"
                    ],
                    "common_phrases": [
                        "ask for leniency",
                        "appeal for leniency",
                        "show leniency",
                        "plead for leniency"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проявление мягкости, терпимости или милосердия, особенно при назначении наказания или вынесении приговора.",
                        "nl": "De eigenschap van genadig of mild zijn, vooral bij het opleggen van een straf of oordeel.",
                        "zh": "宽大、仁慈或容忍的品质，尤指在惩罚、审判或定罪时予以从轻发落。"
                    },
                    "translations": {
