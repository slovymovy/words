                "translations": [
                    {
                        "translation_id": "b723e2c8-d5ae-4da4-aad5-d788bca4a64c",
                        "source_entry_id": "b82d388a-a438-3f8c-8391-5431aeec36d7",
                        "source_sense_id": "d9027517-fdc6-399e-8111-a303fa562299",
                        "source_sense_description": "oranje knipperende lamp aan de zijkant van een voertuig, gebruikt om aan te geven dat men het voertuig naar rechts of links wil manoeuvreren",
                        "target_lang_word": "Blinker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Blinker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c9af1279-e9b3-372a-9aa6-0ae300b24ea4",
                                        "entry_id": "f2ec3ede-670f-3cda-9d76-c0e17d197c94",
                                        "glosses": [
                                            "Teil der Lichtanlage in Kraftfahrzeugen; zeigt die Richtung an, in die man abbiegen möchte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3003b041-2b1f-4758-af59-ae513cd11a83",
                                                "sense_id": "c9af1279-e9b3-372a-9aa6-0ae300b24ea4",
                                                "text": "Der Blinker vorne links ist kaputt."
                                            },
                                            {
                                                "example_id": "9ced4d9e-da1c-4dd9-80a3-87eaad1bbcc8",
                                                "sense_id": "c9af1279-e9b3-372a-9aa6-0ae300b24ea4",
                                                "text": "„Keine Vollbremsung diesmal - Eos sieht in den Rückspiegel, während sie den Wagen verlangsamt und auf die Seite lenkt, und vergißt auch den Blinker nicht.“"
                                            },
                                            {
                                                "example_id": "5c986ea0-acf6-4a2a-a5b0-554ebb5fc6e6",
                                                "sense_id": "c9af1279-e9b3-372a-9aa6-0ae300b24ea4",
                                                "text": "„Dann setzte er den rechten Blinker und bog langsam auf den Parkplatz ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1c54310a-d707-3605-b48d-e9023209f141",
                                        "entry_id": "f2ec3ede-670f-3cda-9d76-c0e17d197c94",
                                        "glosses": [
                                            "künstlicher Angelköder aus Blech oder Perlmutt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab4a7340-6058-4c7f-815a-20a226772c90",
                                                "sense_id": "1c54310a-d707-3605-b48d-e9023209f141",
                                                "text": "Seine Anglerausrüstung bestand aus Ruten, Rolle, Schur und Blinker."
                                            },
                                            {
                                                "example_id": "3db07f26-0da2-4154-8342-a693bf93d120",
                                                "sense_id": "1c54310a-d707-3605-b48d-e9023209f141",
                                                "text": "„Sieht man einmal vom Spezialfall des Fliegenfischens ab, so steht der finnische Binnenseeangler beim Blick in seinen Köderkasten vor drei Auswahlmöglichkeiten: Spinner, Wobbler oder Blinker.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "14c61005-5382-4838-9a05-ef530c9e1c58",
                        "source_entry_id": "b82d388a-a438-3f8c-8391-5431aeec36d7",
                        "source_sense_id": "d9027517-fdc6-399e-8111-a303fa562299",
                        "source_sense_description": "oranje knipperende lamp aan de zijkant van een voertuig, gebruikt om aan te geven dat men het voertuig naar rechts of links wil manoeuvreren",
