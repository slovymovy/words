                        "entry_id": "dca1132a-6910-3f88-b203-dd76434ae759",
                        "glosses": [
                            "Exclamation de colère, d’irritation ou de surprise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d29765ed-619b-4195-a5b5-d83158ac07c2",
                                "sense_id": "a84a42fb-d3cd-3afd-9465-7d9987251b06",
                                "text": "« Merdouille de merdouille ! », s’exclama un jour une personne un peu snob de mon entourage en apprenant qu’un problème de transport public l’empêcherait d’aller là où elle voulait se rendre."
                            }
                        ]
                    }
