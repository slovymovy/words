                ],
                "senses": [
                    {
                        "sense_id": "e7a30ce5-3e59-3d76-8164-7bd3c44473e5",
                        "entry_id": "61ac9d2e-d034-3e03-b9d5-8ccf2ec8a62c",
                        "glosses": [
                            "Drüse in der Lederhaut (Corium), die durch die Poren der Oberhaut (Epidermis) den gebildeten Schweiß nach außen absondert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ab3bf7b-5b96-45c5-a348-38d72df1b9e1",
                                "sense_id": "e7a30ce5-3e59-3d76-8164-7bd3c44473e5",
                                "text": "„Der Mensch hat über den gesamten Körper verteilt etwa drei Millionen Schweißdrüsen.“"
                            },
                            {
                                "example_id": "cfdadadb-e814-4b03-92ec-b05933cbdc2c",
                                "sense_id": "e7a30ce5-3e59-3d76-8164-7bd3c44473e5",
                                "text": "„Felltragende Tiere haben zwar auch Schweißdrüsen, doch dieser Schweiß ist eher schaumig-klebrig.“"
                            },
                            {
                                "example_id": "28d96411-3cda-420d-addf-1fb57f8164b8",
                                "sense_id": "e7a30ce5-3e59-3d76-8164-7bd3c44473e5",
                                "text": "„Die Absonderung von Schweiß aus den Schweißdrüsen (Schweißsekretion) führt durch die entstehende Verdunstungskälte zu einer kontrollierten Absenkung der Körpertemperatur.“"
                            },
                            {
                                "example_id": "cc8a22bd-d86d-4ebe-91d0-5eb798db1bea",
                                "sense_id": "e7a30ce5-3e59-3d76-8164-7bd3c44473e5",
                                "text": "„Zirka 200 Millionen kleine Schweißdrüsen münden an der Körperoberfläche eines einzigen Menschen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
