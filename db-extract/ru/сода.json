                                        "entry_id": "7fc8be63-8da2-3ee9-9ee5-e00f36eb2eb7",
                                        "glosses": [
                                            "Carbonated water (water impregnated with pressurised carbon dioxide, originally made with sodium bicarbonate)."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "034048f2-92bc-4748-80e8-e1263fcf5791",
                                                "sense_id": "33d34992-228b-3636-a35d-4d9c845ee259",
                                                "text": "A waiter brought his aperitif, which was a small scotch and soda, and as he sipped it gratefully he sighed.\n ‘Civilized,’ he said to Mr. Campion. ‘Humanizing.’ […] ‘Cigars and summer days and women in big hats with swansdown face-powder, that's what it reminds me of.’"
                                            }
