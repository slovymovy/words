                "senses": [
                    {
                        "sense_id": "b4762dd0-c1ea-3e06-9088-f774ad0ac8b8",
                        "entry_id": "d54924cc-4623-3b23-9c57-0aee78c60d36",
                        "glosses": [
                            "Qui se rapporte à un bey et plus particulièrement au bey de Tunis."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19c01d1a-437f-4b39-92b3-04498210fb3a",
                                "sense_id": "b4762dd0-c1ea-3e06-9088-f774ad0ac8b8",
                                "text": "Le pouvoir beylical, l’administration beylicale."
                            },
                            {
                                "example_id": "53b73481-9ab4-43a7-9967-1fcd1d9e8d8b",
                                "sense_id": "b4762dd0-c1ea-3e06-9088-f774ad0ac8b8",
                                "text": "Par le traité du Bardo (1881), la France s’engage à assurer la pérennité du régime monarchique beylical et à conserver au bey son statut de souverain, mais de fait, celui-ci perd tous ses pouvoirs."
                            },
                            {
                                "example_id": "224862c9-ff6b-4f98-8449-f00ce576915f",
                                "sense_id": "b4762dd0-c1ea-3e06-9088-f774ad0ac8b8",
                                "text": "L’hymne beylical, souvent appelé Salut beylical (سلام الباي), fut l’hymne national de la Tunisie beylicale entre 1846 et 1957, date de proclamation de la république."
                            },
                            {
                                "example_id": "e9cdd402-7158-4759-88cb-312d1a68da55",
                                "sense_id": "b4762dd0-c1ea-3e06-9088-f774ad0ac8b8",
                                "text": "En juin, ils avaient quitté Tunis et l’appartement au charme beylical de la rue de la Commission pour s’installer au Bordj, la durée de l’été."
                            }
                        ]
                    },
                    {
                        "sense_id": "a26ae8e7-549e-36ef-b69b-c8b312165412",
