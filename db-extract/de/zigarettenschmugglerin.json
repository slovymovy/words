                        "glosses": [
                            "weibliche Person, die Zigaretten unter Umgehung der Zollvorschriften über eine Staatsgrenze bringt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfe0e2a1-2d96-428c-9c2c-8a0eb7e6af03",
                                "sense_id": "aa741cac-0511-3c2f-b0ee-d6bce2e67fbf",
                                "text": "Die Zigarettenschmugglerin versuchte im Schutz der Dunkelheit die Grenze zu überqueren."
                            },
                            {
                                "example_id": "06d29d11-98ab-4031-811b-cf162ede413d",
                                "sense_id": "aa741cac-0511-3c2f-b0ee-d6bce2e67fbf",
                                "text": "„Sie war nämlich wieder einmal schwanger, als die Carabinieri an ihre Tür klopften, um sie, die Zigarettenschmugglerin, abzuholen, damit sie ihre Haftstrafe absitzen möge.“"
                            }
                        ],
