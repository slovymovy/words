                    {
                        "sense_id": "ece38fb3-3d00-3b62-a03b-76bb0dc7d033",
                        "entry_id": "fdb78f73-9b42-37a5-aa7c-f523485b5dd5",
                        "glosses": [
                            "Entrepreneuriat, entreprise, qualité (d'une personne) d'être entrepreneur, esprit d'entreprise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d17fb44-0216-4245-8b84-b0cf728161f3",
                                "sense_id": "ece38fb3-3d00-3b62-a03b-76bb0dc7d033",
                                "text": "Der Unternehmerverband argumentiert, dass zu viel Regulierung das freie Unternehmertum erdrücken könnte.",
                                "translation": "La Fédération des entreprises fait valoir que trop de réglementation pourrait étouffer la libre entreprise."
                            },
                            {
                                "example_id": "08fcba78-73b3-4a66-ac39-26b22628b6ac",
                                "sense_id": "ece38fb3-3d00-3b62-a03b-76bb0dc7d033",
                                "text": "Das Ziel der Vergabe von Mikrokrediten ist es, das lokale Unternehmertum zu fördern und dadurch Armut zu lindern.",
                                "translation": "L'objectif de l'octroi de microcrédits est de promouvoir l'entrepreneuriat local et de réduire ainsi la pauvreté."
                            }
                        ]
