                ],
                "senses": [
                    {
                        "sense_id": "7721d643-cf26-3b7c-8edf-80a447608c27",
                        "entry_id": "99de4ed9-ea8b-3eb8-ba79-1caacef17e5f",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e4c300c-5b12-4f14-95f0-3d3c81245589",
                                "sense_id": "7721d643-cf26-3b7c-8edf-80a447608c27",
                                "text": "Frau Tietz ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "c025d7e0-91e8-4514-bcf6-1fb274fe692a",
                                "sense_id": "7721d643-cf26-3b7c-8edf-80a447608c27",
                                "text": "Herr Tietz wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "7fa7fb01-77d8-4dda-877f-8094f34d432e",
                                "sense_id": "7721d643-cf26-3b7c-8edf-80a447608c27",
                                "text": "Die Tietzens fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "ee1728dd-6f05-4343-b3e8-a3d5dd51ea51",
                                "sense_id": "7721d643-cf26-3b7c-8edf-80a447608c27",
                                "text": "Der Tietz trägt nie die Schals, die die Tietz ihm strickt."
                            },
                            {
                                "example_id": "8bb0497a-96e2-465f-b260-646c8f4ac0e8",
                                "sense_id": "7721d643-cf26-3b7c-8edf-80a447608c27",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Tietz kommt, geht der Herr Tietz.“"
                            },
                            {
                                "example_id": "d8efae54-1915-4a4c-a7e7-956bb235ee6a",
                                "sense_id": "7721d643-cf26-3b7c-8edf-80a447608c27",
                                "text": "Tietz kommt und geht."
                            },
                            {
                                "example_id": "81802b8b-1a39-4e09-bce7-3327f49f4805",
                                "sense_id": "7721d643-cf26-3b7c-8edf-80a447608c27",
                                "text": "Tietzes kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
