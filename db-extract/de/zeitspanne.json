                    },
                    {
                        "translation_id": "2deaac7e-af94-4e7e-b162-27043155f132",
                        "source_entry_id": "c0ff0af9-461d-3a33-8e41-787ef75e65ab",
                        "source_sense_id": "608dbfea-cac0-3f17-83eb-fd2a09cbfca0",
                        "source_sense_description": "abgegrenzter, abgeschlossener, genau bestimmter Zeitabschnitt",
                        "target_lang_word": "délai",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "délai",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ab5f9d30-a1f0-3237-9a62-32bd36546feb",
                                        "entry_id": "5dde1db8-e1bf-3544-9ae7-4e8bcf92a49c",
                                        "glosses": [
                                            "Temps accordé pour faire une chose, ou à l’expiration duquel on sera tenu de faire une certaine chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cab6dfa8-f79a-4a47-899d-e1c91489d8d8",
                                                "sense_id": "ab5f9d30-a1f0-3237-9a62-32bd36546feb",
                                                "text": "Cette procédure a pour but d’abréger les délais et de diminuer les frais dans les causes entre locateurs et locataires. Elle n'exclue pas la procédure ordinaire; mais on comprend qu'elle lui est de beaucoup préférable pour ces nombreux litiges dont la nature même exige une instruction rapide et une prompte solution."
                                            },
                                            {
                                                "example_id": "17bdb658-d474-4e7b-843c-333f8328fe97",
                                                "sense_id": "ab5f9d30-a1f0-3237-9a62-32bd36546feb",
                                                "text": "Il ne leur donna qu’un délai d’un mois pour quitter le pays. Les retardataires étaient menacés d’être mis à mort."
                                            },
                                            {
                                                "example_id": "01989a71-cdbd-4b90-ab0c-9f859fb88f07",
                                                "sense_id": "ab5f9d30-a1f0-3237-9a62-32bd36546feb",
                                                "text": "Entre le volume à rénover, la capacité de financement, la capacité des énergéticiens et des professionnels du BTP — quand on sait qu’il y a, par exemple, huit à dix mois de délai pour avoir des huisseries — le calendrier me semble très ambitieux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "de355026-9243-4b37-b0a0-ae302c83e9e4",
                        "source_entry_id": "c0ff0af9-461d-3a33-8e41-787ef75e65ab",
                        "source_sense_id": "608dbfea-cac0-3f17-83eb-fd2a09cbfca0",
                        "source_sense_description": "abgegrenzter, abgeschlossener, genau bestimmter Zeitabschnitt",
                        "target_lang_word": "laps de temps",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "laps de temps",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1301f53b-cc3e-328a-a686-bf2fe3c80f50",
                                        "entry_id": "713d51b4-2995-3f25-8b83-d0f2304bfb9e",
                                        "glosses": [
                                            "Espace de temps."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78afec7e-dab4-4b83-b38e-3707badc89ca",
                                                "sense_id": "1301f53b-cc3e-328a-a686-bf2fe3c80f50",
                                                "text": "Cette petite femme, en un laps de temps relativement court, était la cause de cette transformation."
                                            },
