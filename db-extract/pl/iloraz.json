                                    {
                                        "sense_id": "e384d20a-5b64-3173-8b77-27c1b4d91bd5",
                                        "entry_id": "bcd96546-0680-36cd-8285-70b6d95e11e1",
                                        "glosses": [
                                            "The number (either a fraction or an integer) resulting from the division of one number by another."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1255b6d7-8ac8-4401-a6cc-c4b5cb431702",
                                                "sense_id": "e384d20a-5b64-3173-8b77-27c1b4d91bd5",
                                                "text": "Dividing 12 by 4 yields a quotient of 3."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22bb7fcc-0ba1-3196-a8b9-70af64904862",
                                        "entry_id": "bcd96546-0680-36cd-8285-70b6d95e11e1",
                                        "glosses": [
                                            "By analogy, the result of any process that is the inverse of multiplication as defined for any mathematical entities other than numbers."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e702a58a-2c28-3c68-a271-2fa718a4397b",
                                        "entry_id": "bcd96546-0680-36cd-8285-70b6d95e11e1",
                                        "glosses": [
                                            "A quotum or quota."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "rare"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7c1c76e3-59e0-3106-939c-4c2fcd32477f",
                                        "entry_id": "bcd96546-0680-36cd-8285-70b6d95e11e1",
                                        "glosses": [
                                            "The number of runs scored per wicket lost when batting, divided by the number of runs conceded per wicket taken when bowling — used as a league table tiebreaker in some first-class tournaments."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0338f5fc-c6c0-4c76-9184-327a374427c8",
