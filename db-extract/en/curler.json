                                "target_senses": [
                                    {
                                        "sense_id": "482a36d5-19a8-39d7-8b48-ca62b2e4fb53",
                                        "entry_id": "fa6b5d42-41f2-330c-b946-91b371e4c965",
                                        "glosses": [
                                            "Joueur de curling."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b10293b7-788a-43ca-8448-c4610c152084",
                                                "sense_id": "482a36d5-19a8-39d7-8b48-ca62b2e4fb53",
                                                "text": "En plus, pour pratiquer le curling (étant moi-même curleur) je peux vous assurer que le jeu se trouve très différent selon le côté où vous jouez."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3f3486c7-2a85-4a1a-bcbe-002251dc0526",
