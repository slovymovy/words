                    {
                        "translation_id": "5af8269f-a0b2-47f1-8959-95a2658df7de",
                        "source_entry_id": "dd647fb8-ee19-3b04-bf4b-ec23848369ff",
                        "source_sense_id": "e80e49f7-e277-3e01-8bf2-3a335559b313",
                        "source_sense_description": "bepaald circa 20 cm lang knolgewas, Pastinaca sativa",
                        "target_lang_word": "panais",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "panais",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "34215a90-673d-386c-a5c1-3b7b79c998ae",
                                        "entry_id": "e8c185d7-3911-3d2e-bbbb-8bd0498dd80d",
                                        "glosses": [
                                            "Plante potagère, de la famille des apiacées (ombellifères)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ee8c10c-7e7f-4abd-8d4b-a65c6ec8a19c",
                                                "sense_id": "34215a90-673d-386c-a5c1-3b7b79c998ae",
                                                "text": "Les panais se multiplient de graine, laquelle est plate, de figure ovale, & de couleur brune : […]."
                                            },
                                            {
                                                "example_id": "196d6cd9-767c-4551-adbf-e31ee9a6bc06",
                                                "sense_id": "34215a90-673d-386c-a5c1-3b7b79c998ae",
                                                "text": "Il y avait dans ce temps-là de grands hivers, de brûlants étés. J’ai connu, depuis, des étés dont la couleur, si je ferme les yeux, est celle de la terre ocreuse, fendillée entre les tiges du blé et sous la géante ombelle du panais sauvage, celle de la mer grise ou bleue."
                                            },
                                            {
                                                "example_id": "523399e0-755e-49e3-94e0-46571f0cee4e",
                                                "sense_id": "34215a90-673d-386c-a5c1-3b7b79c998ae",
                                                "text": "Comme la carotte, le panais réclame des terres profondes et fraîches, fumées à l’avance ou enrichies des mêmes engrais minéraux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c161e860-f6cf-3f7c-be56-23a77a72bbd8",
                                        "entry_id": "e8c185d7-3911-3d2e-bbbb-8bd0498dd80d",
                                        "glosses": [
                                            "Racine de cette plante qui est d’un blanc jaunâtre et d’une saveur douce."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "094cf1b3-b200-4d89-bfd4-24d8c21943a6",
                                                "sense_id": "c161e860-f6cf-3f7c-be56-23a77a72bbd8",
                                                "text": "C’était un lascar maigre et décoloré comme un panais mais avec des yeux de cirage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "236d0516-c573-3dba-a01c-2466d0c0ba03",
                                        "entry_id": "e8c185d7-3911-3d2e-bbbb-8bd0498dd80d",
                                        "glosses": [
                                            "Pénis, sexe masculin."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33fb03c6-e968-4310-8444-7bf26ea0cc07",
                                                "sense_id": "236d0516-c573-3dba-a01c-2466d0c0ba03",
                                                "text": "La femme, c’est d’abord la mère, le creuset du monde. Alors que l’homme est un pauvre type qui se balade avec son panais à la main, en souhaitant qu’il soit dur ; désemparé, effondré quand il ne l’est pas, comme si c’était le siège de l’honneur et de l’intelligence."
                                            }
                                        ]
                                    }
                                ]
                            },
