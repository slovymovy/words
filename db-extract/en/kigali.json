                                "sense_id": "73ee1fa7-6a25-313a-9ee6-0a3765ed5aab",
                                "text": "The United Nations refugee agency (UNHCR) warned there was a risk some migrants sent to Rwanda could be returned to countries from which they had fled. Kigali denied the allegations and accused UNHCR of lying."
                            },
                            {
                                "example_id": "49c7de1a-7912-48f7-964d-c83fbc5857eb",
                                "sense_id": "73ee1fa7-6a25-313a-9ee6-0a3765ed5aab",
                                "text": "The importance of cows in Kigali is on show at the King’s Palace Museum, which is home to a herd of long horned Inyambo cattle."
                            }
                        ]
