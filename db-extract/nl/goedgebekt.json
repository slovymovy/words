                        "examples": [
                            {
                                "example_id": "da3edcb9-91ad-482d-93a8-ea65b82d047b",
                                "sense_id": "596ce03f-501f-366b-82ea-4b998a9bd491",
                                "text": "Ze was bloedmooi, goedgebekt en boeiend."
                            },
                            {
                                "example_id": "2c723069-6b78-4a7d-9ffb-6057d948d397",
                                "sense_id": "596ce03f-501f-366b-82ea-4b998a9bd491",
                                "text": "Faiza Oulahsen is met haar 26 jaar één van de jongste campagneleiders ooit. \"Ze is goedgebekt, gefocust en precies wat wij zoeken in een campagneleider die het gevecht om de Noordpool aan moet gaan met miljardenbedrijven\", zegt Greenpeace. Ze studeerde in Amsterdam politicologie met als specialisatie internationale betrekkingen. In 2011 solliciteerde ze bij Greenpeace."
                            }
                        ]
