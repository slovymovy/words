                "senses": [
                    {
                        "sense_id": "5af4fe3e-8b33-30fc-b7d8-2b6836b75659",
                        "entry_id": "2a78e9ec-9768-3d1e-8095-d175b54004c7",
                        "glosses": [
                            "Geruchswahrnehmung die von Stoffen stammt, die riechen und sich mit dem Wind bewegen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60bc5d38-a91e-40b2-9a66-7a8e606f3297",
                                "sense_id": "5af4fe3e-8b33-30fc-b7d8-2b6836b75659",
                                "text": "„Der Geruchsstoffstrom stellt zusammen mit der meteorologischen Häufigkeitsverteilung die zentralen Eingangsparameter der Ausbreitungsrechnung dar, mit deren Hilfe die Immissionsprognose durchgeführt wird.“"
                            },
                            {
                                "example_id": "7566557d-b160-45e7-ad22-c0828e3b991a",
                                "sense_id": "5af4fe3e-8b33-30fc-b7d8-2b6836b75659",
                                "text": "„In die Ausbreitungsrechnung gehen zahlreiche Größen ein, zum Beispiel: Der Geruchsstoffstrom (Geruchseinheiten GE/m³), ermittelt aus Emissionsmassenstrom (m³/h) und Geruchsstoffkonzentration in der Abluft (GE/h) […]“"
                            },
                            {
                                "example_id": "da404198-5e44-4f88-a886-1e59b3f02b0f",
                                "sense_id": "5af4fe3e-8b33-30fc-b7d8-2b6836b75659",
                                "text": "„Mit dem so ermittelten Geruchsstoffstrom kann anschließend die eigentliche Immissionsprognose (unter Berücksichtigung des Merkblattes \"Anforderungen an die meteorologischen Eingangsdaten für Ausbreitungsrechnung nach Ta Luft\"; s. Anlage 1) gemäß GIRL erfolgen.“"
                            },
                            {
                                "example_id": "794ad990-7c6b-4614-ae47-653b2df15eb6",
                                "sense_id": "5af4fe3e-8b33-30fc-b7d8-2b6836b75659",
                                "text": "„Für den Bereich Vor-, Haupt- und Nachrotte wurde das Lagervolumen berechnet und mit dem spezifischen Emissionsfaktor der VDI Richtlinie der entsprechende Geruchsstoffstrom ermittelt.“"
                            },
                            {
                                "example_id": "71a64555-cfdc-45a4-a78e-ece3a2159b2a",
                                "sense_id": "5af4fe3e-8b33-30fc-b7d8-2b6836b75659",
                                "text": "„Vergleicht man jetzt den für das Klärwerk B hochgerechneten Geruchsstoffstrom für hypothetische Fahnenmessungen mit dem hochgerechneten Geruchsstoffstrom der sich aus einer Kaminlösung errechnen lässt, so kann eine erhebliche Geruchsminderung abgeleitet werden, da kein Aerosol mehr verfrachtet werden kann und die große bodennahe Oberflächenquelle in eine abgehobene Punktquelle umgebaut wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
