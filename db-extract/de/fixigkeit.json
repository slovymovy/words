                "senses": [
                    {
                        "sense_id": "c4bc4dfc-3023-3ffc-b01a-4d4c1d88c9f7",
                        "entry_id": "6e6d77b7-bbc7-3383-94c1-83925e5c0e69",
                        "glosses": [
                            "Eigenschaft/Fähigkeit, sehr schnell zu agieren/reagieren"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "54ffff10-31df-4820-ac53-f64d1e613156",
                                "sense_id": "c4bc4dfc-3023-3ffc-b01a-4d4c1d88c9f7",
                                "text": "„Die Fixigkeit der Reaktion ist so groß in dieser Stadt, daß man oft nicht weiß, was gemeint ist.“"
                            },
                            {
                                "example_id": "393d64fa-35cf-4304-86d0-cfc6611a7b42",
                                "sense_id": "c4bc4dfc-3023-3ffc-b01a-4d4c1d88c9f7",
                                "text": "„In der Fixigkeit war ich dir über, aber in der Richtigkeit warst du mir über.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
