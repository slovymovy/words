                                        "glosses": [
                                            "муз. струнный ударно-клавишный музыкальный инструмент с горизонтальным (рояль) или вертикальным (пианино) расположением струн и с педалями для усиления и ослабления звука"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
