                                    {
                                        "sense_id": "ae3d09d5-b84b-38a4-8292-a22bb20183f3",
                                        "entry_id": "64920a09-665b-300b-92a5-19a24ef6a8b1",
                                        "glosses": [
                                            "Contact qui s’établit par les yeux ; fait de voir quelqu’un ou quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b634dc1d-dac3-424d-a6fb-239105490592",
                                                "sense_id": "ae3d09d5-b84b-38a4-8292-a22bb20183f3",
                                                "text": "Il croisa alors le regard gourmand d’une jeune femme. Le contact visuel établi, la demoiselle se rapprocha."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
