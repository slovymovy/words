                        "examples": [
                            {
                                "example_id": "b5c1a58e-ac96-4885-ab69-5a6a8cfba512",
                                "sense_id": "fc7ceaf9-dc9c-3e08-b6cb-9caaa0b7dad0",
                                "text": "L’Hexanchus griseus est une espèce d’hexanche, que l’on nomme aussi griset."
                            },
                            {
                                "example_id": "678ca352-15f1-4b25-95f6-21ee4678674a",
                                "sense_id": "fc7ceaf9-dc9c-3e08-b6cb-9caaa0b7dad0",
                                "text": "Parmi ces derniers, j’observais l’hexanche, espèce de chien de mer muni de six fentes respiratoires, le télescope aux yeux énormes, le malarmat-cuirassé, aux thoracines grises, aux pectorales noires, que protégeait son plastron de plaques osseuses d’un rouge pâle, puis enfin le grenadier, qui, vivant par douze cents mètres de profondeur, supportait alors une pression de cent vingt atmosphères."
                            }
                        ]
                    }
