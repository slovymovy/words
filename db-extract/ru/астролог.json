                "senses": [
                    {
                        "sense_id": "afd7048d-9492-39a4-914f-7c9bce1509a2",
                        "entry_id": "4cf65437-218f-3fbd-8e5e-31e155859423",
                        "glosses": [
                            "тот, кто занимается астрологией"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "77f8fc7d-2768-4772-9fa5-a8d68f43e313",
                        "source_entry_id": "4cf65437-218f-3fbd-8e5e-31e155859423",
                        "source_sense_id": "afd7048d-9492-39a4-914f-7c9bce1509a2",
                        "target_lang_word": "astrologer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "astrologer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d5cb7274-a0e5-38c7-befb-05e731ba7261",
                                        "entry_id": "4d8219d8-847d-3c1a-89eb-ea28a34c092e",
                                        "glosses": [
                                            "One who studies or practices astrology."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acecf860-b5c7-4572-88af-1733bf747ee7",
                                                "sense_id": "d5cb7274-a0e5-38c7-befb-05e731ba7261",
                                                "text": "Nicolaus Copernicus and Johannes Kepler both made a living as astrologers."
                                            },
                                            {
                                                "example_id": "bc99d59e-690e-405b-bf8e-7e972e4b6bc1",
                                                "sense_id": "d5cb7274-a0e5-38c7-befb-05e731ba7261",
                                                "text": "When witchcraft became a statutory offence again in 1563, astrologers reincurred the risk of prosecution […]"
                                            },
                                            {
                                                "example_id": "db30f01d-432d-4bcf-8b43-d226d3dc6637",
                                                "sense_id": "d5cb7274-a0e5-38c7-befb-05e731ba7261",
                                                "text": "Astrologers, when they observe this pattern, insist that it corresponds to the zodiacal progression. I am not an astrologer and I hold no brief for it, but I do believe the origins of astrology are not with the Chaldeans of Mesopotamia but with the hunters and gatherers of the Stone Age."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "30843f2e-4677-4d82-8cfd-91d2739591bc",
                        "source_entry_id": "4cf65437-218f-3fbd-8e5e-31e155859423",
                        "source_sense_id": "afd7048d-9492-39a4-914f-7c9bce1509a2",
                        "target_lang_word": "stargazer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stargazer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9cb26633-c9f4-3ab3-892b-5bc7e5988aad",
                                        "entry_id": "5540c828-740d-3549-9608-a23615c01a41",
                                        "glosses": [
                                            "Someone who gazes at the stars; an astronomer or astrologer (now especially an amateur one)."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "244d0ebe-ceed-4885-8f0f-b75b54510fa7",
                                                "sense_id": "9cb26633-c9f4-3ab3-892b-5bc7e5988aad",
                                                "text": "Thou art wearied in the multitude of thy counsels: let now the astrologers, the starre-gazers, the monethly prognosticators stand vp, and saue thee from these things that shall come vpon thee."
                                            },
                                            {
                                                "example_id": "ff66f21c-0362-4d2d-adaf-8a26fb77b405",
                                                "sense_id": "9cb26633-c9f4-3ab3-892b-5bc7e5988aad",
                                                "text": "[…] the four satellites of Jupiter, which, it is thought, were probably visible to certain of the more sharp-sighted stargazers of ancient Babylonia."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1dd75f12-d1ee-307d-be24-b43c4bda5d3b",
                                        "entry_id": "5540c828-740d-3549-9608-a23615c01a41",
                                        "glosses": [
                                            "Any of family Uranoscopidae of bottom-dwelling fish."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "423838ca-df71-46d5-878c-cab45d92a3d9",
                                                "sense_id": "1dd75f12-d1ee-307d-be24-b43c4bda5d3b",
                                                "text": "A stargazer is a frightening fish by any sretch of the imagination, but not until the day I first saw one in its own world did I understand its true nature."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1a3997b6-c780-40c2-89fd-f902a11b3bc5",
                        "source_entry_id": "4cf65437-218f-3fbd-8e5e-31e155859423",
                        "source_sense_id": "afd7048d-9492-39a4-914f-7c9bce1509a2",
                        "target_lang_word": "astrólogo",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "astrólogo",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "38cfb7f5-0669-389d-bae0-b307777b079e",
                                        "entry_id": "615c431a-232c-35e0-85f3-ad8955dfc26d",
                                        "glosses": [
                                            "Persona que practica la astrología."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "46abd5e3-0a6b-4289-bb5f-335d5385548a",
                        "source_entry_id": "4cf65437-218f-3fbd-8e5e-31e155859423",
                        "source_sense_id": "afd7048d-9492-39a4-914f-7c9bce1509a2",
                        "target_lang_word": "Astrologe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Astrologe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "57cd37bc-66ff-3cde-b543-d6f0293c6601",
                                        "entry_id": "7534419c-fff0-3ef6-9573-53a949755335",
                                        "glosses": [
                                            "ein Anhänger der Astrologie oder der Sterndeutekunst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acdf21f7-6c03-40d4-825f-4dba91afec44",
                                                "sense_id": "57cd37bc-66ff-3cde-b543-d6f0293c6601",
                                                "text": "Astrologen werden immer noch von manchen Menschen ernst genommen."
                                            },
                                            {
                                                "example_id": "c01e64af-159e-4d00-9de6-c975a8dca222",
                                                "sense_id": "57cd37bc-66ff-3cde-b543-d6f0293c6601",
                                                "text": "„Unter den letzteren bemerkte ich einen gewissen Uceda, der als Astrologe auftrat und sich eifrig um meine Freundschaft bemühte.“"
                                            },
                                            {
                                                "example_id": "c5dd8642-171a-42a7-a1d5-3b8a5fc30f1c",
                                                "sense_id": "57cd37bc-66ff-3cde-b543-d6f0293c6601",
                                                "text": "„Während große Feldherren und Fürsten der Zeit hochrangige Astrologen beschäftigten, um in die Zukunft zu schauen, mussten sich die Unterschichten mit den Künsten alter, umherziehender Bettlerinnen begnügen.“"
                                            },
                                            {
                                                "example_id": "d5d8ed37-56aa-4aa8-82e3-784cc941b5bc",
                                                "sense_id": "57cd37bc-66ff-3cde-b543-d6f0293c6601",
                                                "text": "„Bei der nächsten Tournee trat der Astrologe als Saxofonist in die Gruppe ein.“"
                                            },
                                            {
                                                "example_id": "e07b2001-8422-4872-992a-5ba41f77f032",
                                                "sense_id": "57cd37bc-66ff-3cde-b543-d6f0293c6601",
                                                "text": "„Das ist auf jeden Fall eine vortreffliche Logik, außer wenn es sich um ein Unheil handelt, das von den Astrologen angekündigt und so aufgefaßt wird, wie man es nach ihrem Willen tun soll; denn entweder ist ein so angekündigtes Unheil vermeidbar, und das Horoskop wird damit zu einer Kinderei, oder es ist tatsächlich eine Vorhersage des Schicksals, und dann ist es unvemeidbar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "43842df7-f4f5-4f9b-abec-6d3e5d1e573e",
                        "source_entry_id": "4cf65437-218f-3fbd-8e5e-31e155859423",
