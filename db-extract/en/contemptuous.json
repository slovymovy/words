                    {
                        "translation_id": "e34bdb15-42fa-46d4-94f1-3f0937a2c81b",
                        "source_entry_id": "3ef8152b-1171-3fe3-8841-a262cad9c984",
                        "source_sense_description": "showing contempt",
                        "target_lang_word": "minachting",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "minachting",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "1aef29ca-1216-38ee-a25d-fe17d5f9c004",
                                        "entry_id": "d336b2d1-d04e-3c18-8d51-ffc3e960599c",
                                        "glosses": [
                                            "het minderwaardig vinden, het geen gunstige mening hebben over"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e66c1d3-fa3d-4cff-9eab-5d4d80f05704",
                                                "sense_id": "1aef29ca-1216-38ee-a25d-fe17d5f9c004",
                                                "text": "Hij liet zijn minachting maar al te duidelijk blijken."
                                            },
                                            {
                                                "example_id": "7fd14d21-a3de-4f21-ae62-d84397937e24",
                                                "sense_id": "1aef29ca-1216-38ee-a25d-fe17d5f9c004",
                                                "text": "'Mevrouw, prinses Elfilda is een schitterende ster die aan het koninklijk firmament straalt, waar ze ook thuishoort. IHij deed geen poging zijn minachting te verbergen. 'Dat ze u en uw dochters hier uitnodigt voor het souper is een teken van haar medeleven, vergevingsgezindheid en gulheid.'Inderdaad, meneer,'mompelde ik. 'Dat is inderdaad zo.'"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fae34e0d-f1c1-4f11-a95f-723b0b5dd117",
                        "source_entry_id": "3ef8152b-1171-3fe3-8841-a262cad9c984",
                        "source_sense_description": "showing contempt",
                        "target_lang_word": "méprisant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "méprisant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "53e72097-2a5d-3697-b0ba-53b104edec4a",
                                        "entry_id": "739c82b0-f8c8-3848-9b4d-ee55ba6003d1",
                                        "glosses": [
                                            "Qui marque du mépris."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b697ceb8-f959-4122-a92f-9a8ff1868c80",
                                                "sense_id": "53e72097-2a5d-3697-b0ba-53b104edec4a",
                                                "text": "Quoique très instruite, elle n'avoit ni les caprices, ni l’humeur qu'on attribue aux gens de lettres, qui tantôt se livrent à une loquacité importune, tantôt se renferment dans un silence méprisant."
                                            },
                                            {
                                                "example_id": "94e6676f-140b-4e0e-b85f-4865d1643d02",
                                                "sense_id": "53e72097-2a5d-3697-b0ba-53b104edec4a",
                                                "text": "Vous avez, docteur, de bien curieuses fréquentations, dit-il d'un ton un peu méprisant, un représentant de ces mauvais moines adorateurs du démon ! Que les Chinois sérieux estiment un peu plus qu'un soldat, mais un peu moins qu'une prostituée !"
                                            },
                                            {
                                                "example_id": "f8bbc2fd-2c0b-4193-ad44-4a25c05f1f83",
                                                "sense_id": "53e72097-2a5d-3697-b0ba-53b104edec4a",
                                                "text": "Il suffit de faire un tour sous des posts récents des chercheuses pour lire un certain nombre de réponses méprisantes ou dénialistes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "méprisant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d7ec1aa4-06c7-37a0-9b02-fe0e625eff74",
                                        "entry_id": "f429fa32-dad8-30c6-a23e-8050ac65ebf8",
                                        "glosses": [
                                            "Participe présent du verbe mépriser."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55100244-b5a3-4eda-a287-5ecf7ad8c028",
                                                "sense_id": "d7ec1aa4-06c7-37a0-9b02-fe0e625eff74",
                                                "text": "Quelle catin! et il éprouvait un furieux besoin de se venger d'elle, sans motif, en la méprisant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2440d664-b5fd-42e5-ab77-97a75f7e4f47",
                        "source_entry_id": "3ef8152b-1171-3fe3-8841-a262cad9c984",
                        "source_sense_description": "showing contempt",
                        "target_lang_word": "dédaigneux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dédaigneux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "46276d37-dcca-35c0-82ab-9cdf94829ede",
                                        "entry_id": "5da66afc-7373-35dc-8549-311bd749b6a5",
                                        "glosses": [
                                            "Qui a ou qui marque du dédain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37525311-804d-41fe-bfaf-7aae2ceba2fa",
                                                "sense_id": "46276d37-dcca-35c0-82ab-9cdf94829ede",
                                                "text": "Ceux-ci, d’ailleurs, un peu hautains et dédaigneux, affectaient souvent de regarder comme indignes d’eux les amusements habituels des gosses."
                                            },
                                            {
                                                "example_id": "c0e140dc-f2f6-457d-8923-e7a47626a843",
                                                "sense_id": "46276d37-dcca-35c0-82ab-9cdf94829ede",
                                                "text": "Il tira une chaise, s'installa à califourchon et son regard fit le tour de la chambre avec une lippe dédaigneuse et apitoyée."
                                            },
                                            {
                                                "example_id": "6f3d6bfb-727b-4229-8e13-43891c48d07f",
                                                "sense_id": "46276d37-dcca-35c0-82ab-9cdf94829ede",
                                                "text": "Joseph détourna la tête, mais il saisit du coin de l’œil le regard dédaigneux dont on le couvrit en passant, et le sang lui monta aux joues."
                                            },
                                            {
                                                "example_id": "70f8a186-b22b-4de5-a6d8-90a2724917ab",
                                                "sense_id": "46276d37-dcca-35c0-82ab-9cdf94829ede",
                                                "text": "L’homme revint vers la porte, semblant pressé de refouler ces intrus trop curieux, et dédaigneux de ses richesses : des adonis marmoréens, des chandeliers, des meubles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "26abcb04-726f-4e72-bc86-9eb185c96537",
                        "source_entry_id": "3ef8152b-1171-3fe3-8841-a262cad9c984",
                        "source_sense_description": "showing contempt",
                        "target_lang_word": "contempteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "contempteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a299a334-0c5a-3768-9152-4e0b94f443e6",
                                        "entry_id": "6da1b19d-d59d-38cf-a726-716d41f81f57",
                                        "glosses": [
                                            "Celui qui méprise quelqu’un ou quelque chose."
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1839b63d-1303-4f56-8217-ca7c16a7bc54",
                                                "sense_id": "a299a334-0c5a-3768-9152-4e0b94f443e6",
                                                "text": "[…] ses puissances n’en résident pas moins au fond de son être, et […] un jour elles se réveilleront pour étonner de leur fière originalité et de leur indomptable énergie et leurs timides apologistes et leurs insolents contempteurs."
                                            },
                                            {
                                                "example_id": "d0d02ffe-2b9d-4160-aaf5-beb61099160c",
                                                "sense_id": "a299a334-0c5a-3768-9152-4e0b94f443e6",
                                                "text": "Les vieux d’avant la Révolution étaient morts ; les jeunes passèrent presque tous à la thèse de l’infaillibilité papale ; mais il resta encore une profonde différence entre ces ultramontains de la dernière heure et les hardis contempteurs de la scolastique et de l’église gallicane sortis de l’école de Lamennais."
                                            },
                                            {
                                                "example_id": "2dca7093-a559-42d4-a40c-a4806d7bd412",
                                                "sense_id": "a299a334-0c5a-3768-9152-4e0b94f443e6",
                                                "text": "Ce contempteur de la ruse ment. Ce flétrisseur de la lâcheté use et mésuse de petits papiers. Pouah !"
                                            },
                                            {
                                                "example_id": "52c642b6-708b-46dc-b774-fdab17456541",
                                                "sense_id": "a299a334-0c5a-3768-9152-4e0b94f443e6",
                                                "text": "Les contempteurs du burkini (ou du hijab) n’ont de cesse de renvoyer aux pratiques dans les théocraties islamiques : dans ces pays, nous disent-ils, les femmes se battent pour avoir le droit de se dévêtir en public."
                                            },
                                            {
                                                "example_id": "d3a89214-0d42-4369-8b98-0be9597d9e1f",
                                                "sense_id": "a299a334-0c5a-3768-9152-4e0b94f443e6",
                                                "text": "Assimilés à des parasites suçant le lait déjà avarié de notre Hexagone déclinant, tantôt à des tire-au-flanc dont le poil dans la main prendrait, à écouter leurs contempteurs plus remontés que des coucous suisses, des allures de poutre de Bamako, ils sont devenus l'ennemi public numéro un."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a75c7403-58e4-40ee-ae90-88f4d2ef5741",
                        "source_entry_id": "3ef8152b-1171-3fe3-8841-a262cad9c984",
                        "source_sense_description": "showing contempt",
                        "target_lang_word": "respektlos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "respektlos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0f8dad19-54e2-341f-b0f0-33030540559c",
                                        "entry_id": "22bcd000-0015-36fd-b5a8-4c4c1483684d",
                                        "glosses": [
                                            "ohne Respekt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38dfdd90-de43-4cf1-b861-d0693cca764b",
                                                "sense_id": "0f8dad19-54e2-341f-b0f0-33030540559c",
                                                "text": "Sein respektloses Verhalten gegenüber dem Lehrer hatte Konsequenzen."
                                            },
                                            {
                                                "example_id": "86cdd514-9b04-4a1a-81cb-ba6c796cbc0f",
                                                "sense_id": "0f8dad19-54e2-341f-b0f0-33030540559c",
                                                "text": "„Ein Kunde einer Pizzeria dürfte einen gehörigen Schock erlebt haben, als sein Blick auf den Kassenzettel fiel: Ein Angestellter des Restaurants hatte darauf respektlose Worte hinterlassen.“"
                                            },
                                            {
                                                "example_id": "d0694205-8972-41a7-978c-71f6e73da939",
                                                "sense_id": "0f8dad19-54e2-341f-b0f0-33030540559c",
                                                "text": "„Double-Gewinner Niko Kovac vom FC Bayern München hat einen respektlosen Umgang mit den Fußball-Trainern in der Bundesliga beklagt.“"
                                            },
                                            {
                                                "example_id": "3d5dd527-f2f3-40ed-80e6-5802f61e0943",
                                                "sense_id": "0f8dad19-54e2-341f-b0f0-33030540559c",
                                                "text": "„Über Trumps respektlosen Umgang mit verheirateten Frauen hat auch Trumps ehemalige Geschäftspartnerin Jill Harth berichtet, die über einen längeren Zeitraum von ihm sexuell belästigt worden sein soll.“"
                                            },
                                            {
                                                "example_id": "0b5fdaf6-f058-429a-b0b9-cb023ee2c910",
                                                "sense_id": "0f8dad19-54e2-341f-b0f0-33030540559c",
                                                "text": "„Diskus-Olympiasieger Christoph Harting hat nach seinen respektlosen Äußerungen und herablassenden Sprüchen über Verband und Konkurrenten offenbar einen Denkzettel erhalten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
