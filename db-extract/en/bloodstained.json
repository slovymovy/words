                    },
                    {
                        "translation_id": "bb7d45ec-6c87-4cca-87e7-4b09c728f478",
                        "source_entry_id": "398fb13d-3c29-3abf-ae73-d52b6faf3aef",
                        "source_sense_description": "stained, spotted or otherwise discolored with blood",
                        "target_lang_word": "sanglant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sanglant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "97e3d288-a447-3f93-a716-be99348305e1",
                                        "entry_id": "50275415-aec0-3b71-97c3-2869382e7c03",
                                        "glosses": [
                                            "Qui est taché de sang, souillé de sang."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24e5acdc-74be-473d-bf72-af37bdcbdcf9",
                                                "sense_id": "97e3d288-a447-3f93-a716-be99348305e1",
                                                "text": "Mort sanglante, mort violente avec effusion de sang."
                                            },
                                            {
                                                "example_id": "68ff5a14-b694-45c5-bc50-d4ad5bc3572d",
                                                "sense_id": "97e3d288-a447-3f93-a716-be99348305e1",
                                                "text": "Bizarrement, son cadavre sanglant ne la dérangeait pas : il lui faisait à peu près le même effet qu’un zombie de pacotille dans une maison hantée de fête foraine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9e12d76-2183-37c7-8cf5-bbf98b252c1e",
                                        "entry_id": "50275415-aec0-3b71-97c3-2869382e7c03",
                                        "glosses": [
                                            "Où il y a beaucoup de sang répandu ; qui cause beaucoup de morts et de blessés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "774177db-dabe-4a0f-9caa-6ae886dde54d",
                                                "sense_id": "e9e12d76-2183-37c7-8cf5-bbf98b252c1e",
                                                "text": "Les mœurs des compagnonnages furent longtemps fort remarquables par leur brutalité ; avant 1840, il y avait constamment des bagarres, souvent sanglantes, entre groupes de rites différents."
                                            },
                                            {
                                                "example_id": "9abe0019-4df8-4a13-b077-5fc2b4cac8d4",
                                                "sense_id": "e9e12d76-2183-37c7-8cf5-bbf98b252c1e",
                                                "text": "Surpris, les Français tournèrent bride, mais reprenant l’offensive ils engagèrent avec les cosaques, qu’ils mirent en fuite, un sanglant corps à corps jusque dans les rues du hameau de Jacqueville, puis tranquillement reprirent la route de Fontainebleau."
                                            },
                                            {
                                                "example_id": "3791dec0-af2c-46c9-923a-b0c342cd3d9c",
                                                "sense_id": "e9e12d76-2183-37c7-8cf5-bbf98b252c1e",
                                                "text": "La femelle n’assiste plus à des combats sanglants et la raison dit que cela est beaucoup mieux."
                                            },
                                            {
                                                "example_id": "fa4d1267-11c9-4d33-96c2-141525330f2f",
                                                "sense_id": "e9e12d76-2183-37c7-8cf5-bbf98b252c1e",
                                                "text": "Que les instruments qui ont servi à ourdir cette sanglante machination politique doivent disparaître, cela est évident."
                                            },
                                            {
                                                "example_id": "d030e2c7-7df3-4b6a-aadd-035b61a4e157",
                                                "sense_id": "e9e12d76-2183-37c7-8cf5-bbf98b252c1e",
                                                "text": "Le gouvernement ordonne une répression sanglante. Arrestations, pendaisons, exécutions sommaire plongent Tripoli dans un bain de sang."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58681024-1ac9-3cf0-af88-ed728e7e611c",
                                        "entry_id": "50275415-aec0-3b71-97c3-2869382e7c03",
                                        "glosses": [
                                            "Qui a la couleur du sang ; sanguin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7682aaad-ac85-486f-8541-d2085eacd8f1",
                                                "sense_id": "58681024-1ac9-3cf0-af88-ed728e7e611c",
                                                "text": "Le ciel avait pris des reflets sanglants, et un vent impétueux balayait devant lui la flamme et la fumée."
                                            },
                                            {
                                                "example_id": "a8f31adc-928e-4ada-9948-6d4f3de5e8db",
                                                "sense_id": "58681024-1ac9-3cf0-af88-ed728e7e611c",
                                                "text": "Mais soudain, au bord occidental de l’immense dais noir, le soleil couchant reparaît un instant, sanglant, embrasant le camp entier d’une lueur surnaturelle. Les tentes semblent flamber, toutes rouges entre la plaine d’un vert invraisemblable et les nuages violacés, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa8a156e-716b-3a96-88cf-68c75f557841",
                                        "entry_id": "50275415-aec0-3b71-97c3-2869382e7c03",
                                        "glosses": [
                                            "Qui est outrageux, profondément blessant."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d50a3f1f-6e54-4ef0-92ec-118e355706b7",
                                                "sense_id": "fa8a156e-716b-3a96-88cf-68c75f557841",
                                                "text": "Un sanglant affront."
                                            },
                                            {
                                                "example_id": "287cecfe-8ef1-4315-9d15-21354fc7e3e8",
                                                "sense_id": "fa8a156e-716b-3a96-88cf-68c75f557841",
                                                "text": "Une injure sanglante."
                                            },
                                            {
                                                "example_id": "b5894918-5a98-45e0-98d0-dcd25a27681a",
                                                "sense_id": "fa8a156e-716b-3a96-88cf-68c75f557841",
                                                "text": "Il lui a fait un reproche sanglant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53c86d9f-9f28-3c56-8706-83c74a2ff19b",
                                        "entry_id": "50275415-aec0-3b71-97c3-2869382e7c03",
                                        "glosses": [
                                            "Coupable d’un grave forfait, de crimes."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c071f8f-8468-4d5b-b249-f72db716b850",
                                                "sense_id": "53c86d9f-9f28-3c56-8706-83c74a2ff19b",
                                                "text": "Comme un nuage noir qui gronde sur les cimes,\nVoici venir, pour la curée, ô Roi sanglant,\nLa meute aux crocs aigus que fouettent tes victimes."
                                            }
                                        ]
                                    }
                                ]
                            },
