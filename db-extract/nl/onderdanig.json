                            {
                                "example_id": "fbaf9336-549c-4756-ac89-d53aa00b5511",
                                "sense_id": "6b7dee6b-d1eb-38e1-97ee-0a1b3368bea8",
                                "text": "Tijdens een audiëntie met de keizer is het belangrijk je onderdanig op te stellen.",
                                "translation": "During an audience with the emperor, it is important to comport oneself with obedience.",
                                "english": "During an audience with the emperor, it is important to comport oneself with obedience."
                            },
                            {
                                "example_id": "7dc3268c-e00c-450d-bfee-556e67289d43",
                                "sense_id": "6b7dee6b-d1eb-38e1-97ee-0a1b3368bea8",
                                "text": "Je hoeft niet zo onderdanig te doen, je bent geen hond.",
                                "translation": "You don't have to behave so submissively, you're not a dog.",
                                "english": "You don't have to behave so submissively, you're not a dog."
                            }
                        ]
