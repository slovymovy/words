                        "glosses": [
                            "urządzenie do mechanicznego dojenia zwierząt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6751926f-d120-4bf9-a014-6c959e950f58",
                                "sense_id": "b6cfc913-f6cf-3585-bcf2-1d9c683ab1a1",
                                "text": "Obory były na wszystkich trzech folwarkach, a krów około dwustu. Dojarek elektrycznych jeszcze nie znano, więc udój, trzy razy dziennie, odbywał się ręcznie"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "13a9f9ca-e2ba-35d7-9740-101a4e32f0c3",
                        "entry_id": "61900ec9-91a0-39c8-b47d-167561643139",
                        "glosses": [
                            "kobieta dojąca zwierzę mleczne"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1cee82f6-e980-43ba-9105-dc951ae50324",
                                "sense_id": "13a9f9ca-e2ba-35d7-9740-101a4e32f0c3",
                                "text": "Była to naprawdę utalentowana i oddana swojemu zawodowi dojarka"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
