                "senses": [
                    {
                        "sense_id": "07451822-d094-3035-8ba0-d1891c6484ee",
                        "entry_id": "f5ca4dab-81ce-35b7-8264-ed885dbeab55",
                        "glosses": [
                            "Fixation de l’extrémité d’un câble, d’une chaîne sur l’organeau d’une ancre."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "e48d14bc-70ca-3050-b0ab-a91c04b54a73",
                        "entry_id": "f5ca4dab-81ce-35b7-8264-ed885dbeab55",
                        "glosses": [
                            "Fixation de l’autre extrémité dans la cale ou le puits à chaînes (la baille)."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "685bfe96-692b-3c17-8b0d-b9c8112d5be7",
                        "entry_id": "f5ca4dab-81ce-35b7-8264-ed885dbeab55",
                        "glosses": [
                            "Petit bout qui relie la fin de la chaine de mouillage au bateau (anneau en fond de cale de rangement de mouillage). Cela évite de perdre l’intégralité de son mouillage (chaîne et ancre) en cas de mauvaise manœuvre de mouillage et en même temps, cela permet de conserver une partie sectionnable au couteau, sous charge, en cas de besoin pour larguer le mouillage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c00811e9-4576-4de5-a938-3591d82548dc",
                                "sense_id": "685bfe96-692b-3c17-8b0d-b9c8112d5be7",
                                "text": "L’amarrage que l’on nomme étalingure peut être réalisé à l’aide d’un cordage, frappé d’un côté sur la chaîne par un nœud de chaise cousu, bloqué de l’autre par un nœud en huit dans une cloison ou frappé par un nœud sur une membrure ou un piton au fond du bateau."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "628f1f66-645b-49b5-88d0-de284e0948e3",
                        "source_entry_id": "f5ca4dab-81ce-35b7-8264-ed885dbeab55",
                        "target_lang_word": "clinch",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clinch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "302f2ae6-0de6-39c0-8eac-f9a31f2ecc05",
                                        "entry_id": "4ec6a3b8-ff14-31b6-bbc2-8a8aa4f6c716",
                                        "glosses": [
                                            "To bend and hammer the point of (a nail) so it cannot be removed."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5e019f8c-54a6-3f91-96c3-2b79b8d10b21",
                                        "entry_id": "4ec6a3b8-ff14-31b6-bbc2-8a8aa4f6c716",
                                        "glosses": [
                                            "To clasp; to interlock."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74816c88-f4e9-4d65-9595-dd19fb8daffd",
                                                "sense_id": "5e019f8c-54a6-3f91-96c3-2b79b8d10b21",
                                                "text": "“Beloved shipmates, clinch the last verse of the first chapter of Jonah—‘And God had prepared a great fish to swallow up Jonah.’”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3060571c-92e7-3755-96cb-d89b07d740ce",
                                        "entry_id": "4ec6a3b8-ff14-31b6-bbc2-8a8aa4f6c716",
                                        "glosses": [
                                            "To fasten securely or permanently."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1b452504-acab-3822-9c56-2d415f931615",
                                        "entry_id": "4ec6a3b8-ff14-31b6-bbc2-8a8aa4f6c716",
                                        "glosses": [
                                            "To make certain; to finalize."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b3cc82d-1245-4d2b-9946-8b9f91dd8cae",
                                                "sense_id": "1b452504-acab-3822-9c56-2d415f931615",
                                                "text": "I already planned to buy the car, but the color was what really clinched it for me."
                                            },
                                            {
                                                "example_id": "45c3f819-40f2-4a39-adc3-59f757048f6f",
                                                "sense_id": "1b452504-acab-3822-9c56-2d415f931615",
                                                "text": "Vincent Kompany was sent off after conceding a penalty that was converted by Stephen Hunt to give Wolves hope. But Adam Johnson's curling shot in stoppage time clinched the points."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6b83407-110b-3e50-a6c8-2747fa3e5342",
                                        "entry_id": "4ec6a3b8-ff14-31b6-bbc2-8a8aa4f6c716",
                                        "glosses": [
                                            "To hold firmly; to clench"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ea492eb3-e5df-31b9-aaff-1c37a034d8c0",
                                        "entry_id": "4ec6a3b8-ff14-31b6-bbc2-8a8aa4f6c716",
                                        "glosses": [
                                            "To set closely together; to close tightly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1885cff9-80b2-4d5a-b2fa-0d91eba64b81",
                                                "sense_id": "ea492eb3-e5df-31b9-aaff-1c37a034d8c0",
                                                "text": "to clinch the teeth or the fist"
                                            },
                                            {
                                                "example_id": "abc36e5b-629a-44b1-a91e-acadb1a22601",
                                                "sense_id": "ea492eb3-e5df-31b9-aaff-1c37a034d8c0",
                                                "text": "[T]ry if the heads of the nails [of horseshoes] be fast, and whether they be well clinched; if not, send presently for a smith; always stand by while the smith is employed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28260bae-4339-37e4-9374-c041a2659f14",
                                        "entry_id": "4ec6a3b8-ff14-31b6-bbc2-8a8aa4f6c716",
                                        "glosses": [
                                            "To hold a boxing opponent with one or both arms so as to avoid being hit while resting momentarily"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5001db14-291d-3aaa-9c7a-3a155a1f51bf",
                                        "entry_id": "4ec6a3b8-ff14-31b6-bbc2-8a8aa4f6c716",
                                        "glosses": [
                                            "To secure a spot (e.g., at the divisional championship) before the end of regular season play by having an insurmountable lead."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec3da3d9-a652-4d90-beaa-86fa8c9bc492",
                                                "sense_id": "5001db14-291d-3aaa-9c7a-3a155a1f51bf",
                                                "text": "It put the U.S. on the brink of clinching a spot in the quarterfinals."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8197c624-7063-3d13-887a-cd14767c07cf",
                                        "entry_id": "4ec6a3b8-ff14-31b6-bbc2-8a8aa4f6c716",
                                        "glosses": [
                                            "To embrace passionately."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
