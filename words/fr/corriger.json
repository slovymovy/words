    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "af76da89-0cc0-3f13-91b9-6e5552b9a4e6",
                    "sense_definition": "Rectifier une erreur, faire disparaître un défaut ou rendre une chose conforme à la règle.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "rectifier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu dois <w>corriger</w> cette phrase avant de rendre ton devoir."
                        },
                        {
                            "text": "Le logiciel nous aide à <w>corriger</w> les fautes d'orthographe rapidement."
                        }
                    ],
                    "synonyms": [
                        "rectifier",
                        "redresser"
                    ],
                    "common_phrases": [
                        "corriger une erreur",
                        "corriger ses fautes"
                    ]
                },
                {
                    "sense_id": "1e1cdb96-8488-3839-b5a5-8e7334b5817e",
                    "sense_definition": "Examiner le travail d'un élève pour y relever les erreurs et attribuer une note.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "rectifier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur passe toute la soirée à <w>corriger</w> les copies d'examen."
                        },
                        {
                            "text": "Nous allons <w>corriger</w> l'exercice ensemble au tableau."
                        }
                    ],
                    "synonyms": [
                        "noter"
                    ],
                    "common_phrases": [
                        "corriger les copies",
                        "corriger un exercice"
                    ]
                },
                {
                    "sense_id": "fcb7e102-cf8e-3c8a-8eed-c4b54ba506c9",
                    "sense_definition": "Infliger une punition corporelle ou une réprimande sévère pour redresser un comportement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sanction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le bandit menaçait de <w>corriger</w> quiconque oserait lui désobéir."
                        },
                        {
                            "text": "Autrefois, certains maîtres n'hésitaient pas à <w>corriger</w> les enfants indisciplinés."
                        }
                    ],
                    "synonyms": [
                        "châtier",
                        "punir"
                    ],
                    "antonyms": [
                        "récompenser"
                    ]
                },
                {
                    "sense_id": "e55f546d-6c5f-3684-8fe1-092366e94012",
                    "sense_definition": "Relever et marquer les coquilles ou défauts de composition sur une épreuve d'imprimerie.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "rectifier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le secrétaire de rédaction prend le temps de <w>corriger</w> les épreuves avant le tirage."
                        },
                        {
                            "text": "Elle passe des heures à <w>corriger</w> les placards du journal."
                        }
                    ],
                    "common_phrases": [
                        "corriger les épreuves"
                    ]
                },
                {
                    "sense_id": "ff2fb5f2-abdb-386c-a11c-c2b651ec8139",
                    "sense_definition": "Compenser ou atténuer un effet négatif, réparer un tort ou une situation défavorable.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "attenuer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette nouvelle loi tente de <w>corriger</w> les inégalités économiques grandissantes."
                        },
                        {
                            "text": "Il espérait <w>corriger</w> la mauvaise impression laissée lors du premier entretien."
                        }
                    ],
                    "synonyms": [
                        "compenser",
                        "réparer"
                    ],
                    "antonyms": [
                        "aggraver"
                    ],
                    "common_phrases": [
                        "corriger le tir"
                    ]
                },
                {
                    "sense_id": "517ebaac-4062-300f-bb5a-c68e5aa61bc5",
                    "sense_definition": "Atténuer ou tempérer une saveur, une sensation ou une propriété excessive.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "attenuer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "On ajoute un peu de sucre pour <w>corriger</w> l'acidité de la sauce tomate."
                        },
                        {
                            "text": "Il verse de l'eau fraîche pour <w>corriger</w> la force de cette liqueur."
                        }
                    ],
                    "synonyms": [
                        "adoucir",
                        "tempérer"
                    ],
                    "common_phrases": [
                        "corriger l'acidité"
                    ]
                },
                {
                    "sense_id": "527e040f-0ec8-3783-9dd2-30c8538ebd37",
                    "sense_definition": "Rectifier une trajectoire ou un cap pour tenir compte de la dérive ou d'écarts de mesure.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "rectifier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le navigateur doit <w>corriger</w> la route du navire face au vent violent."
                        },
                        {
                            "text": "Les pilotes ont réussi à <w>corriger</w> la trajectoire de l'appareil à temps."
                        }
                    ],
                    "common_phrases": [
                        "corriger la trajectoire"
                    ]
                }
            ]
        }
    ]
