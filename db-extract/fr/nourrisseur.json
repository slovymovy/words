                "senses": [
                    {
                        "sense_id": "c5961b26-d81d-3cd1-99a7-0f92f62a8d4f",
                        "entry_id": "2e12c93b-b55b-3d18-a6be-5563cc27daa0",
                        "glosses": [
                            "Celui qui nourrit."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "c4c1ad25-d6a3-468b-856f-3cb63a24ba9b",
                                "sense_id": "c5961b26-d81d-3cd1-99a7-0f92f62a8d4f",
                                "text": "Frère, dit le garde forestier d'un ton grave, êtes-vous donc devenu nourrisseur de marmots depuis qu'on vous a réformé comme soldat ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "be138a32-5842-385f-9a8b-3ba6f0f23820",
                        "entry_id": "2e12c93b-b55b-3d18-a6be-5563cc27daa0",
                        "glosses": [
                            "Synonyme de éleveur → voir nourrissage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a77bd55f-8c9b-4920-af26-7b5f5057ba4f",
                                "sense_id": "be138a32-5842-385f-9a8b-3ba6f0f23820",
                                "text": "La présence d'un nourrisseur au 130 de la rue du Château conduit à des tas de fumier et de paille dans la cour 48."
                            }
                        ]
                    },
                    {
                        "sense_id": "b3afd079-907b-3867-98d0-91681f8c9bcb",
                        "entry_id": "2e12c93b-b55b-3d18-a6be-5563cc27daa0",
                        "glosses": [
                            "Petit éleveur, installé à la périphérie immédiate des grandes villes — notamment Paris – et qui écoulait sa production sur les marchés de la ville."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "7db45597-c27f-41e6-94c5-20b3d23091a0",
                                "sense_id": "b3afd079-907b-3867-98d0-91681f8c9bcb",
                                "text": "Un grand nombre des fermiers, des meuniers, des nourrisseurs, des cultivateurs aux environs de Paris rêvent pour leurs filles les gloires du comptoir, et voient dans un détaillant, dans un bijoutier, dans un changeur, un gendre beaucoup plus selon leur cœur qu’un notaire ou qu’un avoué dont l’élévation sociale les inquiète ; ils ont peur d’être méprisés plus tard par ces sommités de la Bourgeoisie."
                            }
                        ]
                    }
                ],
