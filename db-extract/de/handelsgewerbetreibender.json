                "senses": [
                    {
                        "sense_id": "27e69a3b-889d-3825-a6d8-9d8a065446da",
                        "entry_id": "0b3bd109-1eec-3cf5-9a00-9bc64935dbb5",
                        "glosses": [
                            "Inhaber eines Handelsbetriebes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "882695cd-9dc9-4be3-afa0-b7c49664f6c0",
                                "sense_id": "27e69a3b-889d-3825-a6d8-9d8a065446da",
                                "text": "„Ein Handelsgewerbetreibender ist Kaufmann.“"
                            },
                            {
                                "example_id": "3bbb916b-2090-4023-9f03-1f354f0f38e0",
                                "sense_id": "27e69a3b-889d-3825-a6d8-9d8a065446da",
                                "text": "„Der Stille ist – soweit dies nicht vertraglich ausgeschlossen ist – bis zur Höhe der Einlage an der Verlusttragung beteiligt; für Schulden aus dem Geschäftsbetrieb haftet den Gläubigern allerdings nur der Handelsgewerbetreibende; im Insolvenzfall hat der Stille sogar Gläubigerrechte.“"
                            },
                            {
                                "example_id": "c26ed080-d0c5-4abf-8180-b9b7fef55f6b",
                                "sense_id": "27e69a3b-889d-3825-a6d8-9d8a065446da",
                                "text": "„Die Einbeziehung anders als nach der bisherigen Rechtslage, nun aller Handelsgewerbetreibender – bisher waren nur Händler wertvoller Güter einbezogen – sowie der Unternehmensberater und der Versicherungsvermittler ist eine Erweiterung des Kreises der Verpflichteten gegenüber der Rechtslage vor der gegenständlichen Novelle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
