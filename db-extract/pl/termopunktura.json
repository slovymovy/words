                "senses": [
                    {
                        "sense_id": "b635fb84-4e8a-3701-8038-0f3ee6c308be",
                        "entry_id": "d54d596b-f03c-37d5-8618-c1d66e9f91ec",
                        "glosses": [
                            "sposób leczenia, wywodzący się z medycyny chińskiej, polegający na drażnieniu wybranych punktów ciała wysoką temperaturą za pomocą żarzących się suszonych ziół"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "116964fd-f2d5-4749-884c-df4632257ec7",
                                "sense_id": "b635fb84-4e8a-3701-8038-0f3ee6c308be",
                                "text": "Termopunktura jest od wieków stosowana na Dalekim Wschodzie, a obecnie także w Europie czy Ameryce, choć badania naukowe nie potwierdzają jej skuteczności."
                            },
                            {
                                "example_id": "123cfaa0-3232-495c-a7ec-aa6f55da3a9c",
                                "sense_id": "b635fb84-4e8a-3701-8038-0f3ee6c308be",
                                "text": "Można powiedzieć, że stawianie baniek to polski odpowiednik termopunktury."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
