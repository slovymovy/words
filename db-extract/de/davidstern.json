                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "étoile de David",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9b4555e2-6400-3522-82c6-24d696790ebb",
                                        "entry_id": "3fe7f631-073b-33c2-b57b-bdbbe4564303",
                                        "glosses": [
                                            "Hexagramme régulier, symbole du judaïsme (✡), que l’on trouve notamment sur les façades des synagogues du monde entier, dans le sceau de Salomon, sur le drapeau israélien."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd46b1ca-6fad-403a-ad16-07ceca0cf3e8",
                                                "sense_id": "9b4555e2-6400-3522-82c6-24d696790ebb",
                                                "text": "Il y a eu \"Big bang\", une boule à facettes faisant tourbillonner étoiles de David et croissants musulmans."
                                            },
                                            {
                                                "example_id": "44af0d7d-aed3-4813-8074-60c825c6d503",
                                                "sense_id": "9b4555e2-6400-3522-82c6-24d696790ebb",
                                                "text": "Pour tricoter son histoire autour de ce thème, Philippe Girard a dessiné l’étoile de David, a inséré la mort de Leonard Cohen au centre et a décidé que chaque pointe de l’étoile représenterait une décennie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
