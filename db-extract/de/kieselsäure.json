                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b32315f2-2390-4bc5-ba48-cf26d3da1684",
                                "sense_id": "d9ad9a10-9da2-3617-8571-446cd7993165",
                                "text": "„Die Kieselsäure hat das Holz in Stein verwandelt, der, als der Sand weiterzog, wieder freigelegt wurde und auf dem Markt landete.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a2f2c73c-eb2b-474a-82ac-dbd097087ea7",
                        "source_entry_id": "a84e5ba4-f184-37a3-961c-998f27f3d0c5",
                        "source_sense_id": "d9ad9a10-9da2-3617-8571-446cd7993165",
                        "source_sense_description": "Sauerstoffsäure des Siliciums",
