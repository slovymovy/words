                    },
                    {
                        "translation_id": "fe1791f7-f6d3-4289-9b1e-0b5f48a3fda3",
                        "source_entry_id": "4794e969-db9f-37e9-bc24-c9f5c7efed97",
                        "source_sense_id": "e901c016-0ad5-3ea2-b12e-886dd60eb760",
                        "target_lang_word": "monastýr",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "b8360949-8a81-4b09-b5cf-6ff0fa4c594a",
                        "source_entry_id": "4794e969-db9f-37e9-bc24-c9f5c7efed97",
                        "source_sense_id": "e901c016-0ad5-3ea2-b12e-886dd60eb760",
                        "target_lang_word": "monastère",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monastère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c63a1b73-d9c2-3330-97e8-d2358f0b2d18",
                                        "entry_id": "dadbfe2d-4895-3427-a1f6-492d184f054a",
                                        "glosses": [
                                            "Couvent, lieu habité par des moines, des moniales ou religieuses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5890a379-a3b4-4244-98cd-7da189fa09bf",
                                                "sense_id": "c63a1b73-d9c2-3330-97e8-d2358f0b2d18",
                                                "text": "Le repos sans la prière qui vivifiait les monastères, sans la méditation qui peuplait les thébaïdes, devient une maladie, dit sentencieusement M. Joseph."
                                            },
                                            {
                                                "example_id": "7ae631b9-e1b9-4e5f-a264-80798163cb21",
                                                "sense_id": "c63a1b73-d9c2-3330-97e8-d2358f0b2d18",
                                                "text": "Wary de Dommartin la rebâtit ; d’abord bénédictin au monastère de Saint-Epvre à Toul, puis prieur de Varangéville il céda ensuite son prieuré, moyennant redevance, à Jean de Nicolinis ; […]."
                                            },
                                            {
                                                "example_id": "4b95c378-837f-4040-bea0-cf6e4133cf3c",
                                                "sense_id": "c63a1b73-d9c2-3330-97e8-d2358f0b2d18",
                                                "text": "La vermine des catacombes s’épanouissait lentement au soleil ; les couvents et monastères champignonnaient, rongeant le sol gaulois comme une lèpre hideuse."
                                            },
                                            {
                                                "example_id": "9dffdd23-a835-455d-93a8-bf1e88f89b0d",
                                                "sense_id": "c63a1b73-d9c2-3330-97e8-d2358f0b2d18",
                                                "text": "L’Église a besoin de ces jardins de Dieu que sont les monastères contemplatifs, qui donnent à la terre une prise d’air sur le ciel."
                                            },
                                            {
                                                "example_id": "51319edc-e460-492e-8cbf-961fbd9466b9",
                                                "sense_id": "c63a1b73-d9c2-3330-97e8-d2358f0b2d18",
                                                "text": "Avant que la Chine n’envahisse le Tibet en 1950, plusieurs centaines de milliers de moines (et de nonnes) vivaient dans quelque 6000 monastères."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "04838546-3e1b-4db0-ba94-6da46003a44a",
                        "source_entry_id": "4794e969-db9f-37e9-bc24-c9f5c7efed97",
                        "source_sense_id": "e901c016-0ad5-3ea2-b12e-886dd60eb760",
                        "target_lang_word": "монастырь",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "монастырь",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "3589177c-c239-3bf9-8637-a040c447cd9f",
                                        "entry_id": "0719dd5d-efc7-3036-a89c-3b6152fdd084",
                                        "glosses": [
                                            "религ. община монахов или монахинь, представляющая собой церковно-хозяйственную организацию, обычно владеющую землями и капиталами"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46810cb1-1c32-484d-a548-d99164b5834e",
                                                "sense_id": "3589177c-c239-3bf9-8637-a040c447cd9f",
                                                "text": "Когда всё надоест, уйду в монастырь."
                                            },
                                            {
                                                "example_id": "e03f521a-be8c-4d75-8322-ad8ade0c06ea",
                                                "sense_id": "3589177c-c239-3bf9-8637-a040c447cd9f",
                                                "text": "Мужской монастырь."
                                            },
                                            {
                                                "example_id": "f69fb9ce-69e2-4ebd-bf06-2e1ed62c277c",
                                                "sense_id": "3589177c-c239-3bf9-8637-a040c447cd9f",
                                                "text": "Женский монастырь."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a545c702-b7ac-3f48-9a4f-59e16f62be00",
                                        "entry_id": "0719dd5d-efc7-3036-a89c-3b6152fdd084",
                                        "glosses": [
                                            "собир. члены этой общины"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31e46638-4813-40d3-a671-fdb2aa37d252",
                                                "sense_id": "a545c702-b7ac-3f48-9a4f-59e16f62be00",
                                                "text": "Однако вскоре весь монастырь узнал о прибытии благодетельницы."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb0f3967-7054-3d3d-9079-71bc60387abe",
                                        "entry_id": "0719dd5d-efc7-3036-a89c-3b6152fdd084",
                                        "glosses": [
                                            "совокупность церквей, жилых помещений и территорий, принадлежащих такой общине"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c3e72c3-bced-4089-ba3c-84b44382d346",
                                                "sense_id": "eb0f3967-7054-3d3d-9079-71bc60387abe",
                                                "text": "За год мы собрали средства на восстановление монастыря."
                                            },
                                            {
                                                "example_id": "91ccdde4-c052-473e-a7dc-ba532b95c4a9",
                                                "sense_id": "eb0f3967-7054-3d3d-9079-71bc60387abe",
                                                "text": "Сквозь пары // Вдали чернели две горы, // Наш монастырь из-за одной // Сверкал зубчатою стеной."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
