                "senses": [
                    {
                        "sense_id": "0d1b7fc9-d5ae-3532-8f07-3e2cde2bb641",
                        "entry_id": "267617db-629a-3450-9027-5b9793df4610",
                        "glosses": [
                            "männliche und weibliche Person, die zusammen als Paar ein Votiv abgeben; Votation"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d088877e-ec9f-4be9-be14-60e275f70b5f",
                                "sense_id": "0d1b7fc9-d5ae-3532-8f07-3e2cde2bb641",
                                "text": "„Vor roten, gerafften Vorhängen an den Bildrändern kniet in Betbänken ein Votantenpaar.“"
                            },
                            {
                                "example_id": "d5918cce-3c6b-49ef-bdc8-26738dc1ff57",
                                "sense_id": "0d1b7fc9-d5ae-3532-8f07-3e2cde2bb641",
                                "text": "„Darunter kniet das Votantenpaar vor einer weiten, mit Bäumen bestandenen Landschaft mit Gebirgshintergrund.“"
                            },
                            {
                                "example_id": "7968c960-ac70-441b-ae4c-7d9d8ccf6437",
                                "sense_id": "0d1b7fc9-d5ae-3532-8f07-3e2cde2bb641",
                                "text": "„In der rechten Bildhälfte kniet das Votantenpaar vor Buschwerk.“"
                            },
                            {
                                "example_id": "fc9116c1-1e53-4883-b2b9-7ef07b930bad",
                                "sense_id": "0d1b7fc9-d5ae-3532-8f07-3e2cde2bb641",
                                "text": "„Im Raum davor kniet das städtische Votantenpaar mit einem Sohn auf Betbänken.“"
                            },
                            {
                                "example_id": "4515b3e8-4aa5-4107-af86-a59dbcd56e52",
                                "sense_id": "0d1b7fc9-d5ae-3532-8f07-3e2cde2bb641",
                                "text": "„Wachsvotiv, Votantenpaar, Niederbayern, erste Hälfte 17. Jahrhundert, Nachguss 1972. Bei nicht genau zu definierenden Krankheiten oder Verletzungen sowie bei Bedrohung der ganzen Person wurden Votanten in ganzer Person abgebildet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
