                "translations": [
                    {
                        "translation_id": "a9d7cff3-29c7-429b-bf37-13427bb6dfbb",
                        "source_entry_id": "01915a49-d50a-3d4b-a458-cc903692c364",
                        "target_lang_word": "verdorren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verdorren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "805ae0a5-0e7c-31db-bbee-769fa5c8eb0d",
                                        "entry_id": "32758128-0915-3d65-a2bb-e1cae47a2b22",
                                        "glosses": [
                                            "langsam immer trockener werden bis hin zum Absterben"
                                        ],
                                        "tags": [
                                            "auxiliary verb"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c668f062-5a71-4dc0-b727-28e1c543b386",
                                                "sense_id": "805ae0a5-0e7c-31db-bbee-769fa5c8eb0d",
                                                "text": "Der Apfelbaum verdorrt, wenn wir ihn nicht jede Woche gießen."
                                            },
                                            {
                                                "example_id": "67993cdc-ab24-42f9-b113-d82cc17cc718",
                                                "sense_id": "805ae0a5-0e7c-31db-bbee-769fa5c8eb0d",
                                                "text": "Mit dem Zug zuckelten wir langsam durch die verdorrende Landschaft."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d0897680-a645-3368-b045-a0a060cb4577",
                                        "entry_id": "32758128-0915-3d65-a2bb-e1cae47a2b22",
                                        "glosses": [
                                            "langsam die Feuchtigkeit entziehen"
                                        ],
                                        "tags": [
                                            "auxiliary",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "194e2cae-284f-40c9-a7c1-3dc2cbc93dcf",
                                                "sense_id": "d0897680-a645-3368-b045-a0a060cb4577",
                                                "text": "„Und so war es nur noch eine Frage der Zeit, bis auch diese letzten Pflanzen von der unbarmherzigen Sonne verdorrt wurden.“"
                                            },
                                            {
                                                "example_id": "1494787d-5e67-491f-99d9-27bd7b7323ea",
                                                "sense_id": "d0897680-a645-3368-b045-a0a060cb4577",
                                                "text": "„Abwechselnd von der Sonne verdorrte Weideplätze, die sich aber in der Regenzeit mit dem schönsten Grün bekleiden und Palmyrapflanzungen.“ (1851)"
                                            },
                                            {
                                                "example_id": "b703bf95-b377-4610-ab1c-0b34dadb4e2f",
                                                "sense_id": "d0897680-a645-3368-b045-a0a060cb4577",
                                                "text": "„Das Jesum einschliessende židov zeigt, dass es eben nicht der wunderbare Erfolg des Willens Jesu war (Meyer), sondern, dass Gott den Wunsch Jesu (V. 14) erfüllt und durch seine Wundermacht den Baum verdorrt hatte.“ (1892)"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
