{
    "word_family": [
        "mystère",
        "mystérieusement",
        "mystifier",
        "mystification",
        "démystifier",
        "démystification"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8e51cbf9-ff48-3b01-a177-75993f5b4deb",
                    "sense_definition": "Qui est difficile ou impossible à comprendre, qui renferme une énigme ou un secret.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "incompréhensible",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La police tente d'élucider cette disparition <w>mystérieuse</w> survenue dans la forêt la semaine dernière."
                        },
                        {
                            "text": "Un bruit <w>mystérieux</w> résonnait chaque nuit dans le grenier de la vieille maison abandonnée."
                        }
                    ],
                    "synonyms": [
                        "énigmatique",
                        "sibyllin"
                    ],
                    "antonyms": [
                        "éclaircissable"
                    ],
                    "common_phrases": [
                        "disparition mystérieuse",
                        "bruit mystérieux"
                    ]
                },
                {
                    "sense_id": "24e3d878-8d39-344d-beaf-3fce0756a85f",
                    "sense_definition": "Qui garde volontairement le secret ou qui fait des cachotteries sur ses affaires.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "comportement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon collègue garde un air <w>mystérieux</w> dès qu'on lui pose des questions sur ses projets."
                        },
                        {
                            "text": "Elle affichait un sourire <w>mystérieux</w> qui laissait deviner une très agréable surprise pour nous tous."
                        }
                    ],
                    "common_phrases": [
                        "air mystérieux",
                        "sourire mystérieux"
                    ]
                },
                {
                    "sense_id": "2207734b-012e-31e5-87fe-2379c542606d",
                    "sense_definition": "Qui recèle une vérité divine ou spirituelle cachée, inaccessible à la seule raison humaine.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "incompréhensible",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le théologien a consacré plusieurs années à étudier le sens <w>mystérieux</w> de ces textes anciens."
                        },
                        {
                            "text": "Le prêtre évoquait l'union <w>mystérieuse</w> du Christ et de son Église pendant la messe."
                        }
                    ],
                    "common_phrases": [
                        "sens mystérieux"
                    ]
                }
            ]
        }
    ]
}