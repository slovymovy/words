                    },
                    {
                        "form_id": "bbfa81d8-d4f0-4294-afa6-85a517654ce1",
                        "entry_id": "c8b22746-424d-32bb-a14e-9e51a93cba56",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Gideons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3fbe972e-0d25-31ff-99ae-0f5de8ef23df",
                        "entry_id": "c8b22746-424d-32bb-a14e-9e51a93cba56",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2223f9b7-f45b-4fc6-8560-8bdbe3f76bf7",
                                "sense_id": "3fbe972e-0d25-31ff-99ae-0f5de8ef23df",
                                "text": "Frau Gideon ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "3d0e66d0-2790-4d73-8388-701803b32ef0",
                                "sense_id": "3fbe972e-0d25-31ff-99ae-0f5de8ef23df",
                                "text": "Herr Gideon wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "ccb158dc-655d-48dc-9b01-e2c3e1ffa9d9",
                                "sense_id": "3fbe972e-0d25-31ff-99ae-0f5de8ef23df",
                                "text": "Die Gideons fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "bdc8382b-f5d8-4803-93fe-ad3266ea4728",
                                "sense_id": "3fbe972e-0d25-31ff-99ae-0f5de8ef23df",
                                "text": "Der Gideon trägt nie die Schals, die die Gideon ihm strickt."
                            },
                            {
                                "example_id": "f6a29c4b-eee0-4995-a82b-c390c4dea184",
                                "sense_id": "3fbe972e-0d25-31ff-99ae-0f5de8ef23df",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Gideon kommt, geht der Herr Gideon.“"
                            },
                            {
                                "example_id": "9e1d891e-3443-4140-80f9-6016c4c627ed",
                                "sense_id": "3fbe972e-0d25-31ff-99ae-0f5de8ef23df",
                                "text": "Gideon kommt und geht."
                            },
                            {
                                "example_id": "69344dd6-b4cd-4953-9999-18162e5ddb29",
                                "sense_id": "3fbe972e-0d25-31ff-99ae-0f5de8ef23df",
                                "text": "Gideons kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
