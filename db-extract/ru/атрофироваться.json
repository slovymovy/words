                        "translation_id": "9fd7a256-5b57-41ef-b7f7-ebb58dee332c",
                        "source_entry_id": "a7262d3b-ad81-37d3-9258-05c2a003b434",
                        "source_sense_id": "6fbb2b1d-d751-3f14-b31b-9f73686ecb8a",
