                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беспокойство",
                                "target_lang_sense_clarification": "состояние или действие, нарушающее покой"
                            },
                            {
                                "target_lang_word": "докучание",
                                "target_lang_sense_clarification": "назойливое поведение"
                            },
                            {
                                "target_lang_word": "назойливость",
                                "target_lang_sense_clarification": "постоянное приставание"
                            }
                        ]
                    }
                }
            ]
        }
    ]
