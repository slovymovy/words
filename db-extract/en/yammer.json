                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "38fbff07-8ec3-3c54-b274-977a6ce2e126",
                        "entry_id": "eec4d6b4-cb46-3a96-b30e-5c7c518be3f7",
                        "glosses": [
                            "To repeat on and on, usually loudly or in complaint."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "85c07095-0603-3ea5-864d-c1af33c8efce",
                        "entry_id": "eec4d6b4-cb46-3a96-b30e-5c7c518be3f7",
                        "glosses": [
                            "To make an outcry; to clamor."
                        ],
                        "tags": [
                            "intransitive",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "ba19e4d3-9eac-4d29-922b-40c43553b455",
                                "sense_id": "85c07095-0603-3ea5-864d-c1af33c8efce",
                                "text": "It was a ship, but a whale to the Dark Nebula’s minnow; and on its side was the Spaceship-and-Sun of the Empire. Every alarm on the ship yammered hysterically."
                            }
                        ]
                    },
                    {
                        "sense_id": "f6dd1a89-688a-3d77-913b-476d40869aac",
                        "entry_id": "eec4d6b4-cb46-3a96-b30e-5c7c518be3f7",
                        "glosses": [
                            "to repeatedly call someone's name."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "30b0710d-3377-4109-9188-404964524a69",
                        "source_entry_id": "eec4d6b4-cb46-3a96-b30e-5c7c518be3f7",
                        "source_sense_description": "to complain peevishly",
                        "target_lang_word": "jammern",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jammern",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2eb3810c-58db-3f54-90ab-cc2a2256cc5a",
                                        "entry_id": "38422027-1abb-3dc8-b259-592c778cff26",
                                        "glosses": [
                                            "sich weinerlich (und traurig) beschweren, wehklagen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "448e9003-f4ab-4f2e-b3d5-48795dce9d3d",
                                                "sense_id": "2eb3810c-58db-3f54-90ab-cc2a2256cc5a",
                                                "text": "Es wird viel gejammert, aber nichts getan."
                                            },
                                            {
                                                "example_id": "c816ea72-343b-4eb8-a7d7-46010747b13a",
                                                "sense_id": "2eb3810c-58db-3f54-90ab-cc2a2256cc5a",
                                                "text": "Jammer' nicht!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9c0c085b-80c5-36df-bfb0-91cf7eac3e42",
                                        "entry_id": "38422027-1abb-3dc8-b259-592c778cff26",
                                        "glosses": [
                                            "etwas oder jemand betrübt, bekümmert, dauert jemanden"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4181747f-1d4a-4e36-acaf-c382f915388b",
                                                "sense_id": "9c0c085b-80c5-36df-bfb0-91cf7eac3e42",
                                                "text": "Es jammert mich zu sehen, wie die zwei Eheleute einander das Leben versauern."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "857a7124-6648-42bb-b77e-a072e8392403",
                        "source_entry_id": "eec4d6b4-cb46-3a96-b30e-5c7c518be3f7",
                        "source_sense_description": "to complain peevishly",
                        "target_lang_word": "ныть",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ныть",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "0e8e6f17-a681-3909-9d8d-4e010b34470f",
                                        "entry_id": "cab7821d-8d7b-32ae-9e5f-36e10a4df599",
                                        "glosses": [
                                            "разг. издавать тягучие жалобные звуки"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebc5339a-88fe-4824-8c62-473221d4b875",
                                                "sense_id": "0e8e6f17-a681-3909-9d8d-4e010b34470f",
                                                "text": "А ветер стонет и ноет. «Бедное, бедное дитя мое!» ― стонет ветер."
                                            },
                                            {
                                                "example_id": "f61462f0-32f5-4626-9205-e2cfae3bb9b8",
                                                "sense_id": "0e8e6f17-a681-3909-9d8d-4e010b34470f",
                                                "text": "Уж на что я, бывало, завидовала мухам: вот, думала я, кому хорошо на свете пожить; да услыхала раз ночью, как муха у паука в лапках ноет, — нет, думаю, и на них есть гроза."
                                            },
                                            {
                                                "example_id": "6b6a17de-18e5-4e7a-811e-0be6a18306dc",
                                                "sense_id": "0e8e6f17-a681-3909-9d8d-4e010b34470f",
                                                "text": "Завтра при укладывании он непременно потребует сказку и будет ныть до тех пор, пока не расскажут."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "788be5c8-76de-3713-9059-5df994446836",
                                        "entry_id": "cab7821d-8d7b-32ae-9e5f-36e10a4df599",
                                        "glosses": [
                                            "перен., разг. надоедливо жаловаться на что-либо; плакаться"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "781234c2-9482-4fa9-b306-50d8a072e608",
                                                "sense_id": "788be5c8-76de-3713-9059-5df994446836",
                                                "text": "Говорим о трагизме жизни, не зная её, любим ныть, жаловаться, стонать…"
                                            },
                                            {
                                                "example_id": "7f4773e8-1a16-43e9-aabf-f7bc38e4e9c9",
                                                "sense_id": "788be5c8-76de-3713-9059-5df994446836",
                                                "text": "Ныли они обо всём: о предстоящих родах Зины, о грубости Егора Николаевича, об отсутствии женихов для Сони, о тоске деревенской жизни и об ехидстве прислуги, за которою никак не усмотришь."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d1a52dd-8e80-32d6-b270-bf3b005eb9b3",
                                        "entry_id": "cab7821d-8d7b-32ae-9e5f-36e10a4df599",
                                        "glosses": [
                                            "перен., разг. давать о себе знать ощущением тупой, тягучей боли"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82f890a3-cdc4-43e3-b280-7dc4fd588794",
                                                "sense_id": "9d1a52dd-8e80-32d6-b270-bf3b005eb9b3",
                                                "text": "Тело ныло от перехода; в ногах разгоралась замученная тяжелым переходом боль."
                                            },
                                            {
                                                "example_id": "dc76b4d8-19e1-45ed-b4df-f313e4bb47a7",
                                                "sense_id": "9d1a52dd-8e80-32d6-b270-bf3b005eb9b3",
                                                "text": "Словно больной, надоедливый зуб, сердце всё ныло и ныло так тихо, но непрестанно, и так долго, так однообразно…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
