            "senses": [
                {
                    "sense_id": "07a8e73e-9281-3621-9194-f0cb1a850348",
                    "sense_definition": "The simple past tense of the verb <w>see</w>.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>saw</w> a very interesting movie last night.",
                            "target_lang_translations": {
                                "ru": "Вчера вечером я <w>смотрел</w> очень интересный фильм.",
                                "es": "Anoche <w>vi</w> una película muy interesante."
                            }
                        },
                        {
                            "text": "She <w>saw</w> her friend walking down the street.",
                            "target_lang_translations": {
                                "ru": "Она <w>увидела</w> свою подругу, идущую по улице.",
                                "es": "Ella <w>vio</w> a su amiga caminando por la calle."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense of see"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время глагола \"видеть\".",
                        "es": "El tiempo pasado simple del verbo ver."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "увидеть",
                                "target_lang_sense_clarification": "прош. время от see — видеть, увидеть"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "vi",
                                "target_lang_sense_clarification": "primera persona del singular del pretérito perfecto simple de ver"
                            },
                            {
                                "target_lang_word": "vio",
                                "target_lang_sense_clarification": "tercera persona del singular del pretérito perfecto simple de ver"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "81066bb9-6bb7-363c-832b-616f7e863ff8",
                    "sense_definition": "To cut or divide something using a saw.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cutting_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He had to <w>saw</w> the branch off the tree because it was dead.",
                            "target_lang_translations": {
                                "ru": "Ему пришлось <w>отпилить</w> ветку от дерева, потому что она засохла.",
                                "es": "Tuvo que <w>serrar</w> la rama del árbol porque estaba muerta."
                            }
                        },
                        {
                            "text": "The workers <w>sawed</w> through the metal pipes.",
                            "target_lang_translations": {
                                "ru": "Рабочие <w>распилили</w> металлические трубы.",
                                "es": "Los trabajadores <w>serraron</w> las tuberías de metal."
                            }
                        }
                    ],
                    "common_phrases": [
                        "saw off",
                        "saw down",
                        "saw through"
                    ],
                    "target_lang_definitions": {
                        "ru": "Резать или разделять что-либо с помощью пилы.",
                        "es": "Cortar o dividir algo usando una sierra."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пилить",
                                "target_lang_sense_clarification": "разрезать пилой"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "serrar",
                                "target_lang_sense_clarification": "cortar con sierra"
                            },
                            {
                                "target_lang_word": "cortar",
                                "target_lang_sense_clarification": "acción general de dividir con una herramienta"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1858d08b-61e7-3d4b-8058-6d3e1ec7a9f9",
                    "sense_definition": "To make a back-and-forth motion similar to using a saw.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The speaker <w>sawed</w> the air with his hands to emphasize his point.",
                            "target_lang_translations": {
                                "ru": "Оратор <w>рассекал</w> воздух руками, чтобы подчеркнуть свою мысль.",
                                "es": "El orador <w>movía las manos de atrás hacia adelante</w> en el aire para enfatizar su punto."
                            }
                        },
                        {
                            "text": "He <w>sawed</w> away at the violin strings.",
                            "target_lang_translations": {
                                "ru": "Он <w>пилил</w> смычком по струнам скрипки.",
                                "es": "Él <w>serruchaba</w> las cuerdas del violín."
                            }
                        }
                    ],
                    "common_phrases": [
                        "saw away"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать возвратно-поступательные движения, похожие на работу пилой.",
                        "es": "Hacer un movimiento de vaivén similar al uso de una sierra."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пилить",
                                "target_lang_sense_clarification": "совершать движения вперёд-назад, как пилой"
                            },
                            {
                                "target_lang_word": "водить туда-сюда"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "mover de atrás hacia adelante",
                                "target_lang_sense_clarification": "describir el movimiento físico"
                            },
                            {
                                "target_lang_word": "serruchar",
                                "target_lang_sense_clarification": "usado coloquialmente para movimientos de vaivén"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "082849d8-b5fa-3630-9271-6081c55d942e",
                    "sense_definition": "A tool with a thin blade that has sharp teeth along the edge, used for cutting hard materials like wood or metal.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "tool_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The carpenter used a hand <w>saw</w> to cut the board.",
                            "target_lang_translations": {
                                "ru": "Плотник использовал ручную <w>пилу</w>, чтобы отрезать доску.",
                                "es": "El carpintero usó un <w>serrucho</w> para cortar la tabla."
                            }
                        },
                        {
                            "text": "You should wear safety glasses when using an electric <w>saw</w>.",
                            "target_lang_translations": {
                                "ru": "При использовании электрической <w>пилы</w> следует надевать защитные очки.",
                                "es": "Deberías usar gafas de seguridad al usar una <w>sierra</w> eléctrica."
                            }
                        }
                    ],
                    "common_phrases": [
                        "circular saw",
                        "hand saw",
                        "chain saw",
                        "table saw"
                    ],
                    "target_lang_definitions": {
                        "ru": "Инструмент с тонким лезвием, имеющим острые зубья по краю, используемый для резки твердых материалов, таких как дерево или металл.",
                        "es": "Herramienta con una hoja delgada que tiene dientes afilados a lo largo del borde, utilizada para cortar materiales duros como madera o metal."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пила",
                                "target_lang_sense_clarification": "инструмент"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "sierra",
                                "target_lang_sense_clarification": "herramienta de corte"
                            },
                            {
                                "target_lang_word": "serrucho",
                                "target_lang_sense_clarification": "sierra de mano"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "77b4dcd1-1e0a-35eb-bd73-126d0e3cb255",
                    "sense_definition": "A well-known saying or proverb that expresses a general truth.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He quoted an old <w>saw</w> about saving money for a rainy day.",
                            "target_lang_translations": {
                                "ru": "Он процитировал старую <w>пословицу</w> о том, что нужно откладывать деньги на черный день.",
                                "es": "Él citó un viejo <w>refrán</w> sobre ahorrar dinero para los tiempos difíciles."
                            }
                        },
                        {
                            "text": "The speech was full of wise <w>saws</w> and advice.",
                            "target_lang_translations": {
                                "ru": "Речь была полна мудрых <w>изречений</w> и советов.",
                                "es": "El discurso estaba lleno de sabios <w>proverbios</w> y consejos."
                            }
                        }
                    ],
                    "synonyms": [
                        "saying",
                        "proverb",
                        "adage",
                        "maxim"
                    ],
                    "common_phrases": [
                        "old saw"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "often used in the phrase 'old saw'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Известное высказывание или пословица, выражающая общую истину.",
                        "es": "Un dicho o proverbio bien conocido que expresa una verdad general."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пословица",
                                "target_lang_sense_clarification": "краткое народное изречение"
                            },
                            {
                                "target_lang_word": "поговорка",
                                "target_lang_sense_clarification": "образное выражение"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "refrán",
                                "target_lang_sense_clarification": "frase tradicional que expresa un consejo"
                            },
                            {
                                "target_lang_word": "proverbio",
                                "target_lang_sense_clarification": "sentencia o enseñanza moral"
                            },
                            {
                                "target_lang_word": "dicho",
                                "target_lang_sense_clarification": "expresión popular"
                            }
                        ]
                    }
                }
            ]
        },
