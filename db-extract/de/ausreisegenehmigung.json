                "senses": [
                    {
                        "sense_id": "e185b3c8-ac93-3ce7-b030-9a7340086300",
                        "entry_id": "f4727e1d-8cd5-3915-ab07-c1ae1b6d3379",
                        "glosses": [
                            "Erlaubnis, ein Land verlassen zu dürfen; ausreisen zu dürfen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36ee845f-d814-4354-b145-da8fab02aff3",
                                "sense_id": "e185b3c8-ac93-3ce7-b030-9a7340086300",
                                "text": "„Derzeit müssen Kubaner für Auslandsreisen eine Ausreisegenehmigung beantragen, die mit Bearbeitungsgebühren rund 500 Dollar (etwa 380 Euro) kostet und damit für kubanische Verhältnisse kaum erschwinglich ist.“"
                            },
                            {
                                "example_id": "1353caec-4983-46c9-ae7c-9426c0a80d9a",
                                "sense_id": "e185b3c8-ac93-3ce7-b030-9a7340086300",
                                "text": "„Derweil bringen Mitglieder des Regimes angeblich ihre Familien außer Landes. Um nicht aufzufallen, hätten sie bei den Behörden um Ausreisegenehmigungen, \"zum Zweck der medizinischen Behandlung\" ersucht, berichtet das regimekritische unabhängige syrische Nachrichtenportal All4Syria.“"
                            },
                            {
                                "example_id": "98cb68ed-27ef-47a6-a702-418f8f048e3e",
                                "sense_id": "e185b3c8-ac93-3ce7-b030-9a7340086300",
                                "text": "„Er werde umgehend eine Ausreisegenehmigung beantragen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
