                        "entry_id": "24670ed4-7b86-3fd5-ab7b-0b302b1de433",
                        "glosses": [
                            "Film, dessen Handlung erfunden ist und zur Unterhaltung dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9825f35-3cd6-44dd-a138-682109b25fc9",
                                "sense_id": "fc19082d-f7b3-39c3-864f-3abe4f871020",
                                "text": "Die Sonnenallee ist ein Spielfilm über das Leben in der DDR."
                            },
                            {
                                "example_id": "cf161680-3001-481b-82cc-2179d933d053",
                                "sense_id": "fc19082d-f7b3-39c3-864f-3abe4f871020",
                                "text": "„Um die Filmtheater offenzuhalten, mußten sie den Vertrieb von alten deutschen Spielfilmen in Erwägung ziehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
