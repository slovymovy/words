                ],
                "senses": [
                    {
                        "sense_id": "34e7d1e4-f295-3c3b-b321-181053b6d358",
                        "entry_id": "5efb66a2-3d84-39fa-989d-811da48131c7",
                        "glosses": [
                            "A native or inhabitant of Lutetia."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa4712ec-afd0-46d6-a5e1-c33acbb1498a",
                                "sense_id": "34e7d1e4-f295-3c3b-b321-181053b6d358",
                                "text": "It is possible that, when they left their islands, a justifiable concern for their own safety in wartime led the Lutetians to settle at the points that were least exposed to aggression."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1d4b9769-ddc1-4231-a46c-ac9d2fa58483",
                        "source_entry_id": "5efb66a2-3d84-39fa-989d-811da48131c7",
                        "source_sense_id": "34e7d1e4-f295-3c3b-b321-181053b6d358",
