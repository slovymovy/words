                    {
                        "sense_id": "4669d680-496a-36d2-a7fb-1a96426c00d3",
                        "entry_id": "2f6a7432-c80e-3519-a439-a133221dfdfd",
                        "glosses": [
                            "etwas, das (aufgrund seiner Besonderheiten) Ansehen erhalten und ein vorbildlich für andere sein soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac257d86-a974-4e2d-b083-5b5c2f66c135",
                                "sense_id": "4669d680-496a-36d2-a7fb-1a96426c00d3",
                                "text": "„Eines der künftigen Vorzeigeobjekte wird der Mission E sein, der erste vollelektrische Porsche.“"
                            },
                            {
                                "example_id": "e1381493-b3f5-446e-80f0-b9817c6435d4",
                                "sense_id": "4669d680-496a-36d2-a7fb-1a96426c00d3",
                                "text": "„Mittendrin lag das architektonische Vorzeigeobjekt Isbjerget, ein futuristischer Wohnkomplex mit schräg aufsteigenden Dächern, dessen Gestaltung an schwimmende Eisberge erinnerte.“"
                            },
                            {
                                "example_id": "e54b8084-7095-492c-bc3d-61bb6c70be90",
                                "sense_id": "4669d680-496a-36d2-a7fb-1a96426c00d3",
                                "text": "„Viele Großsiedlungen galten bei ihrer Eröffnung als Vorzeigeobjekte, auf die die Kommunen stolz waren.“"
                            },
                            {
                                "example_id": "b182cde2-152b-4894-9a36-b6f3ba1fdf4f",
                                "sense_id": "4669d680-496a-36d2-a7fb-1a96426c00d3",
                                "text": "„Für viele Eltern sind die Kinder Prestige- und Vorzeigeobjekte, die nach ihren eigenen Vorstellungen funktionieren müssen.“"
                            },
                            {
                                "example_id": "3e2336b4-b20b-4204-b9f0-25289314dd4c",
                                "sense_id": "4669d680-496a-36d2-a7fb-1a96426c00d3",
                                "text": "„Vorzeigeobjekte sind Neubauten wie das ‚Urban Environment House‘ in Helsinki, eine Büroimmobilie mit Photovoltaik auf dem Dach, Regenwassernutzung und 500 Fahrradständern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
