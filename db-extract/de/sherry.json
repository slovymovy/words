                                        "glosses": [
                                            "Nom anglais du xérès."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf59a182-6e61-4da8-b8fb-64ca043219dd",
                                                "sense_id": "eca8cbe1-8807-3220-b251-60d895f02b0c",
                                                "text": "Fi du porto, du sherry, du madère !"
                                            },
                                            {
                                                "example_id": "e0a0073a-9361-468e-8f11-d3deb64958b4",
                                                "sense_id": "eca8cbe1-8807-3220-b251-60d895f02b0c",
                                                "text": "Elles allèrent dans un petit restaurant, près de l'hôtel, se perchèrent sur de hauts tabourets et mangèrent des picadas au bar en buvant du sherry."
                                            },
                                            {
                                                "example_id": "13637b86-3dc0-4fb1-ada0-2f7f20227532",
                                                "sense_id": "eca8cbe1-8807-3220-b251-60d895f02b0c",
                                                "text": "On y trouve de simples bar-rooms, où les consommateurs se tiennent debout près du comptoir et avalent lestement leur verre de brandy, de sherry, de wisky ou de brandy cocktail, en grignotant un morceau de biscuit et de fromage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
