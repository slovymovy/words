                        "cross_references": [
                            {
                                "target_word": "marshmallow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ba4ffd33-fa05-3cb6-927d-280848490398",
                                        "entry_id": "c8d0e8c7-85fe-34a7-8988-a00c80840bdc",
                                        "glosses": [
                                            "Marsh mallow, a species of mallow, Althaea officinalis, that grows in marshy terrain."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5b4f451-7d1c-4399-968d-e7e43f6a5791",
                                                "sense_id": "ba4ffd33-fa05-3cb6-927d-280848490398",
                                                "text": "Our common Marsh Mallows have diverse soft, hoary white stalks rising to be three or four foot high, spreading forth many branches."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7c1ac20-53a1-3f2e-ba83-095a61179911",
                                        "entry_id": "c8d0e8c7-85fe-34a7-8988-a00c80840bdc",
                                        "glosses": [
                                            "A type of confectionery, originally (since Ancient Egyptian times) made from this plant, but now generally made of sugar or corn syrup, gelatin that has been presoftened in water, gum arabic, flavorings, and sometimes beaten egg whites, all whipped to a spongy consistency."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d0f3096-2bde-4705-b4f5-effe28f53e28",
                                                "sense_id": "d7c1ac20-53a1-3f2e-ba83-095a61179911",
                                                "text": "The Disagreeable Girl is a female of the genus homo persuasion, built around a digestive apparatus that possesses marked marshmallow proclivities."
                                            },
                                            {
                                                "example_id": "28aaa818-b85a-4d12-9f14-3c9e426bbc4f",
                                                "sense_id": "d7c1ac20-53a1-3f2e-ba83-095a61179911",
                                                "text": "It was an apple marshmallow sundae, I recollect. I dug my spoon into it with an assumption of gaiety which I was far from feeling."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b59fb6dc-8f23-3e26-92f6-324b7eaa5362",
                                        "entry_id": "c8d0e8c7-85fe-34a7-8988-a00c80840bdc",
                                        "glosses": [
                                            "Someone who is soft and benign."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9dd84207-571f-40bc-a94c-5c977f9a43e1",
                                                "sense_id": "b59fb6dc-8f23-3e26-92f6-324b7eaa5362",
                                                "text": "He acts like a total badass, but he's really just a marshmallow once you get to know him."
                                            },
                                            {
                                                "example_id": "a85bbcfa-9904-474f-8b6f-b02282144957",
                                                "sense_id": "b59fb6dc-8f23-3e26-92f6-324b7eaa5362",
                                                "text": "You're a marshmallow, Glenn."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "marshmallow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "52350e1e-9abb-388e-b458-5bf18fb9134d",
                                        "entry_id": "f572cd9e-bdd2-3373-81dd-4a0428a22108",
                                        "glosses": [
                                            "To soften (literally or figuratively)."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79630a52-3502-4452-b1d2-19b74e0c87cd",
                                                "sense_id": "52350e1e-9abb-388e-b458-5bf18fb9134d",
                                                "text": "For i could still feel her small face in my hands, her lips marshmallowing under the brushing knuckle of my index, the hard press of her capable contoured body."
                                            },
                                            {
                                                "example_id": "bfe0300b-4640-4ae5-ae19-43b455645ae9",
                                                "sense_id": "52350e1e-9abb-388e-b458-5bf18fb9134d",
                                                "text": "He didn't know if touching me meant that I would marshmallow up or if he would have to brace himself for a blow."
                                            },
                                            {
                                                "example_id": "ae33963b-0cd5-4458-a7c0-b3f3ebb36128",
                                                "sense_id": "52350e1e-9abb-388e-b458-5bf18fb9134d",
                                                "text": "Various dishes heaped with food were tucked haphazardly all over: mounds of whipped potatoes, medleys of buttered vegetables, marshmallowed sweet potatoes, oyster stuffing, cranberry sauce (fresh from the can) and even more dishes"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
