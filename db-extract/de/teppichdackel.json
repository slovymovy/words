                "senses": [
                    {
                        "sense_id": "ea62c269-d96f-39f2-b7d9-00984e05b8ce",
                        "entry_id": "6cc640d5-413d-3f6a-bba0-f4bd1ab0894d",
                        "glosses": [
                            "Haushaltsgerät, das ohne Strom betrieben wird und dazu dient, rein mechanisch den Fußboden von Verschmutzungen zu reinigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97e3bdee-22ae-4578-8b3b-bc1059e4908c",
                                "sense_id": "ea62c269-d96f-39f2-b7d9-00984e05b8ce",
                                "text": "Teppichdackel beseitigen mit drehenden Borsten Flusen, Krümel und Staub und werden mit der Hand betrieben."
                            },
                            {
                                "example_id": "ebb7734e-07e0-4a7e-9f58-b177bcba9895",
                                "sense_id": "ea62c269-d96f-39f2-b7d9-00984e05b8ce",
                                "text": "„Ich weiß wirklich nicht mehr, ob ich damals auch schon einen elektrischen Staubsauger mein eigen nannte und der Teppichdackel als Zusatzgerät diente, oder ob ich nur mit ihm meine Teppiche reinigte.“"
                            },
                            {
                                "example_id": "3815335c-256e-4a67-a0e6-705a04263717",
                                "sense_id": "ea62c269-d96f-39f2-b7d9-00984e05b8ce",
                                "text": "Die Wortbildung Teppichdackel könnte deshalb gewählt worden sein, weil das Gerät dicht am Boden bewegt wird."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
