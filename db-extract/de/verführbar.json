                "senses": [
                    {
                        "sense_id": "82e445d4-521d-3a0d-9db1-c47661de82b8",
                        "entry_id": "e3017b9e-342b-3603-b6ac-33e64edc8f63",
                        "glosses": [
                            "so, dass jemand mit geringem Aufwand verführt werden kann"
