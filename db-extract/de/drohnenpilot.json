                "senses": [
                    {
                        "sense_id": "db0d884f-0b9d-311f-9934-f18ec9d03206",
                        "entry_id": "92830492-a0ce-3596-82c2-78baf2d13c36",
                        "glosses": [
                            "Person, die eine Drohne per Fernsteuerung kontrolliert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3349b113-c09b-40fd-83f1-ef1c8cd08ee9",
                                "sense_id": "db0d884f-0b9d-311f-9934-f18ec9d03206",
                                "text": "„Er habe zwar nur in wenigen Fällen selbst die Rakete abgefeuert. Aber als Drohnenpilot sei er an all diesen Einsätzen beteiligt gewesen, deshalb fühle er sich verantwortlich.“"
                            },
                            {
                                "example_id": "b147ba85-5e9e-40ab-8e11-23667f9dd9f5",
                                "sense_id": "db0d884f-0b9d-311f-9934-f18ec9d03206",
                                "text": "„Albanischen Fussballfans ist der Drohnenpilot mit dem Namen Ballist Morina bekannt, wie die «SonntagsZeitung» schreibt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
