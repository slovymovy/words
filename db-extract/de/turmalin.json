                                        "sense_id": "bcfc2096-4b2d-3e84-9f56-6130fd10892b",
                                        "entry_id": "c4aa8486-f30e-3e1d-9092-3a6b28aeaa0a",
                                        "glosses": [
                                            "A transparent gemstone cut from it."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
