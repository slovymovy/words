                "senses": [
                    {
                        "sense_id": "f6c96f0b-e8f3-3921-8e5c-1652ab6b3ecb",
                        "entry_id": "7687d39e-48de-3207-9ac6-025493ff24c4",
                        "glosses": [
                            "tabel met beperkende regels in een specifieke volgorde, die laat zien hoe volgens de theorie een taalgebruiker tot de beste keus uit een aantal mogelijke vormen komt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "158a1760-4315-4c6a-a015-9fe23ea57f74",
                                "sense_id": "f6c96f0b-e8f3-3921-8e5c-1652ab6b3ecb",
                                "text": "In de OT worden de keuzes tussen de kandidaat-vormen uitgedrukt in schema's, gewoonlijk ‘tableaus’ genoemd, waarin een sterretje een schending van een beperking aanduidt. Het vingertje wijst naar de ‘winnende’ kandidaat."
                            },
                            {
                                "example_id": "61646ee5-7910-48a8-a76a-1e9dff97149c",
                                "sense_id": "f6c96f0b-e8f3-3921-8e5c-1652ab6b3ecb",
                                "text": "Het enige wat in de tableau bepaald wordt is de positie van de hoofdklemtoon."
                            }
                        ]
                    }
                ],
