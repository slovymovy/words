                        "form": "die Macis"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "225ce5bf-7baa-3d2f-8424-fec88a61d2bc",
                        "entry_id": "0ea97921-67bf-3bcc-b9af-68aaf9bb55db",
                        "glosses": [
                            "getrockneter Samenmantel des Muskatnussbaumes (umschließt die Muskatnuss), die als Küchengewürz und Arzneidroge verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57b30763-ea2c-471a-ae06-c5ec4e9cda63",
                                "sense_id": "225ce5bf-7baa-3d2f-8424-fec88a61d2bc",
                                "text": "„In erster Linie finden die Nüsse und die Macis Verwendung als Gewürz.“"
                            },
                            {
                                "example_id": "e0688032-5248-46e7-8c37-0a3bd28e78ba",
                                "sense_id": "225ce5bf-7baa-3d2f-8424-fec88a61d2bc",
                                "text": "„Was den Geschmack betrifft, wurde die Macis höher eingeschätzt als die Muskatnuß, eine Tatsache, die sich auch im Preis niederschlug.“"
                            },
                            {
                                "example_id": "34382d03-d4f9-4bd4-a64a-d751c5dcfa46",
                                "sense_id": "225ce5bf-7baa-3d2f-8424-fec88a61d2bc",
                                "text": "„Getrocknet ist die Macis blassgelb, man kauft sie am besten schon fertig gemahlen.“"
                            },
                            {
                                "example_id": "26e6fa6a-ed74-499f-9665-fc5832976c93",
                                "sense_id": "225ce5bf-7baa-3d2f-8424-fec88a61d2bc",
                                "text": "„1778 erfolgte die erste Ernte auf Mauritius. Seitdem ist die Macis aus der Parfüm-, Seifen- und Salbenherstellung sowie der Wurstzubereitung und natürlich dem Kartoffelbrei nicht mehr wegzudenken“."
                            },
                            {
                                "example_id": "caa8ad7a-554d-488e-a05e-f0f4d63c6615",
                                "sense_id": "225ce5bf-7baa-3d2f-8424-fec88a61d2bc",
                                "text": "„Wie die eigentlichen Macis oder Muskatnüsse späterhin so hoch im Preise stiegen, suchte man sie wieder hervor.“"
                            },
                            {
                                "example_id": "ac448808-f65b-4df1-931c-caa49690d4d0",
                                "sense_id": "225ce5bf-7baa-3d2f-8424-fec88a61d2bc",
                                "text": "„Die Macis werden nach vorsichtigem Ablösen aus der Frucht einzeln zusammengedrückt und nach dem Trocknen in Kisten von 140 kg verpackt.“"
                            },
                            {
                                "example_id": "e33b8f83-de55-4903-a4a1-d9dfda2079cc",
                                "sense_id": "225ce5bf-7baa-3d2f-8424-fec88a61d2bc",
                                "text": "„Besonders die Macis ist mancherlei Fälschungen unterworfen.“"
                            },
                            {
                                "example_id": "d5736d0d-6fce-40b1-8115-b075b6facd23",
                                "sense_id": "225ce5bf-7baa-3d2f-8424-fec88a61d2bc",
                                "text": "„Macis ist hinsichtlich des Geschmacks die feinere Schwester der bekannten Muskatnuss.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
