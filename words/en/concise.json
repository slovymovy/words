{
    "word_family": [
        "conciseness",
        "concisely"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a777169e-a545-3f02-908a-1adca4e898a6",
                    "sense_definition": "Brief, yet including all important information.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "brevity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The report was <w>concise</w> and provided all the necessary data for the meeting.",
                            "target_lang_translations": {
                                "pl": "Raport był <w>zwięzły</w> i zawierał wszystkie niezbędne dane na spotkanie.",
                                "nl": "Het rapport was <w>beknopt</w> en bevatte alle nodige gegevens voor de vergadering."
                            }
                        },
                        {
                            "text": "Please keep your summary <w>concise</w> so the board members can read it quickly.",
                            "target_lang_translations": {
                                "pl": "Proszę, aby podsumowanie było <w>zwięzłe</w>, żeby członkowie zarządu mogli je szybko przeczytać.",
                                "nl": "Houd je samenvatting alstublieft <w>bondig</w>, zodat de bestuursleden deze snel kunnen lezen."
                            }
                        }
                    ],
                    "synonyms": [
                        "brief",
                        "succinct",
                        "to the point",
                        "crisp",
                        "terse"
                    ],
                    "antonyms": [
                        "verbose"
                    ],
                    "common_phrases": [
                        "concise summary",
                        "concise explanation"
                    ],
                    "target_lang_definitions": {
                        "pl": "Krótki, ale zawierający wszystkie istotne informacje.",
                        "nl": "Kort en bondig, maar met alle belangrijke informatie."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "zwięzły",
                                "target_lang_sense_clarification": "zawierający dużo treści w niewielkiej liczbie słów"
                            },
                            {
                                "target_lang_word": "lakoniczny",
                                "target_lang_sense_clarification": "oszczędny w słowach, krótki"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "beknopt",
                                "target_lang_sense_clarification": "tot de essentie teruggebracht"
                            },
                            {
                                "target_lang_word": "bondig",
                                "target_lang_sense_clarification": "kort en krachtig van formulering"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fc4fc738-75fa-32f6-9052-f07f5c6abbc9",
                    "sense_definition": "Physically short or truncated.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "brevity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist created a <w>concise</w> design that lacked the usual broad proportions.",
                            "target_lang_translations": {
                                "pl": "Artysta stworzył <w>zwarty</w> projekt, któremu brakowało typowych, szerokich proporcji.",
                                "nl": "De kunstenaar creëerde een <w>compact</w> ontwerp dat de gebruikelijke brede verhoudingen miste."
                            }
                        },
                        {
                            "text": "The <w>concise</w> structure of the sculpture made it appear smaller than expected.",
                            "target_lang_translations": {
                                "pl": "<w>Zwarta</w> struktura rzeźby sprawiała, że wydawała się ona mniejsza, niż oczekiwano.",
                                "nl": "De <w>gedrongen</w> structuur van het beeldhouwwerk deed het kleiner lijken dan verwacht."
                            }
                        }
                    ],
                    "synonyms": [
                        "short-winded",
                        "tight",
                        "taut"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in older texts to describe physical dimensions."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Fizycznie krótki lub o zwartej strukturze.",
                        "nl": "Fysiek kort, gedrongen of compact van vorm."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "zwarty",
                                "target_lang_sense_clarification": "mający zwartą, skondensowaną strukturę"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "compact",
                                "target_lang_sense_clarification": "weinig ruimte innemend, dicht opeen"
                            },
                            {
                                "target_lang_word": "gedrongen",
                                "target_lang_sense_clarification": "kort en stevig van bouw"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "216ed201-bd31-3151-832a-de4baaeb58f7",
                    "sense_definition": "To make concise; to abridge or summarize.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "brevity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The editor had to <w>concise</w> the long manuscript into a short article.",
                            "target_lang_translations": {
                                "pl": "Redaktor musiał <w>skrócić</w> długi rękopis do krótkiego artykułu.",
                                "nl": "De redacteur moest het lange manuscript <w>inkorten</w> tot een kort artikel."
                            }
                        },
                        {
                            "text": "It is difficult to <w>concise</w> such a complex topic into a few sentences.",
                            "target_lang_translations": {
                                "pl": "Trudno jest <w>streszczać</w> tak złożony temat w kilku zdaniach.",
                                "nl": "Het is moeilijk om zo'n complex onderwerp in een paar zinnen <w>samen te vatten</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Uczynić coś zwięzłym; streścić lub skrócić.",
                        "nl": "Beknopt maken; samenvatten of inkorten."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "streszczać",
                                "target_lang_sense_clarification": "przedstawiać w skróconej formie"
                            },
                            {
                                "target_lang_word": "skracać",
                                "target_lang_sense_clarification": "czynić coś krótszym"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "inkorten",
                                "target_lang_sense_clarification": "minder lang maken"
                            },
                            {
                                "target_lang_word": "samenvatten",
                                "target_lang_sense_clarification": "in het kort weergeven"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}