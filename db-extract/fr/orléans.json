            {
                "entry_id": "da4e2aa6-b869-3b94-8f80-4f649a0d886f",
                "word": "orléans",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d58a9850-4f04-30c2-b4b0-107aabca75b8",
                        "entry_id": "da4e2aa6-b869-3b94-8f80-4f649a0d886f",
                        "glosses": [
                            "Étoffe légère de laine et de coton, qu’on employait pour les vêtements d’été."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14a788ad-dc1c-4cf7-95a0-ba022273ab9e",
                                "sense_id": "d58a9850-4f04-30c2-b4b0-107aabca75b8",
                                "text": "Sa toilette de voyage, des plus élégantes, contrastait avec la simplicité de celle de sa fille; celle-ci portait l'uniforme des pensionnaires du couvent des Dames des Cinq-Plaies de Bordeaux, robe d’orléans grise, ceinture bleue, un petit chapeau de paille avec un ruban bleu."
                            },
                            {
                                "example_id": "38ba66ba-9644-4632-aceb-8729d593345f",
                                "sense_id": "d58a9850-4f04-30c2-b4b0-107aabca75b8",
                                "text": "Il portait, l'été des vêtements d’orléans noire, et l'hiver un paletot bleu foncé auquel on avait recommandé de ressembler au paletot de tout le monde : […]."
                            },
                            {
                                "example_id": "84b188e1-2ecf-4531-8e8d-c68ee1c49809",
                                "sense_id": "d58a9850-4f04-30c2-b4b0-107aabca75b8",
                                "text": "Par dessus le corsage à fronces, un caraco d’orléans, costume complété par un bonnet ruché d'où émergeait une figure maigre."
                            }
                        ]
                    }
                ],
