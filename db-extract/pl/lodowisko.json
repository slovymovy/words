                                "target_senses": [
                                    {
                                        "sense_id": "d8dad245-e12b-3831-b56c-cfb1132b7965",
                                        "entry_id": "479fecf2-9f8d-303c-b19d-fae32d65bd40",
                                        "glosses": [
                                            "Surface d'eau glacée sur laquelle on peut faire du patinage ou du hockey sur glace."
                                        ],
                                        "tags": [
                                            "Sports de glace"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1fb0290b-83a8-42be-a203-5acbc52e68a6",
                                                "sense_id": "d8dad245-e12b-3831-b56c-cfb1132b7965",
                                                "text": "En France, la plupart des patinoires sont dotées d'un système de réfrigération."
                                            },
                                            {
                                                "example_id": "8aa166b4-b50f-4cba-bd6d-71744fc09a6b",
                                                "sense_id": "d8dad245-e12b-3831-b56c-cfb1132b7965",
                                                "text": "« On a décidé de faire une patinoire chez moi pour pas qu'il y ait de rassemblement et qu'on joue ensemble, moi et mon frère. On joue en équipe et c'est l'fun », a enchaîné son fils Gabriel, âgé de 9 ans."
                                            },
                                            {
                                                "example_id": "39cc3af5-b14b-4116-a181-9615cf30fac8",
                                                "sense_id": "d8dad245-e12b-3831-b56c-cfb1132b7965",
                                                "text": "Tôt ou tard, sur la patinoire comme à l'extérieur, Perry risque d'être très utile au Canadien, lui qui compte 1045 matchs d'expérience en saison régulière et 145 autres en séries éliminatoires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3088a4e4-6dc8-32b0-9543-31e3224dd3e3",
                                        "entry_id": "479fecf2-9f8d-303c-b19d-fae32d65bd40",
                                        "glosses": [
                                            "Bâtiment abritant la surface d'eau glacée et doté de gradins."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "231f6adb-d9db-3a2e-959f-070b2a2738cc",
                                        "entry_id": "479fecf2-9f8d-303c-b19d-fae32d65bd40",
                                        "glosses": [
                                            "Aire de jeu d’un théâtre ou d’un match d’improvisation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
