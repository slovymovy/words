{
    "word_family": [
        "padding",
        "padded"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "163dfdad-b568-3a90-a216-3b4b1ea252aa",
                    "sense_definition": "A number of sheets of paper fastened together along one edge, used for writing or drawing.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "stationery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I bought a new sketch <w>pad</w> for my art class.",
                            "target_lang_translations": {
                                "ru": "Я купил новый <w>альбом</w> для эскизов для занятий по рисованию.",
                                "zh": "我为美术课买了一本新的<w>素描本</w>。"
                            }
                        },
                        {
                            "text": "She wrote the grocery list on a small <w>pad</w> by the phone.",
                            "target_lang_translations": {
                                "ru": "Она написала список продуктов в маленьком <w>блокноте</w> у телефона.",
                                "zh": "她在电话旁的小<w>便签本</w>上写下了购物清单。"
                            }
                        }
                    ],
                    "synonyms": [
                        "notepad",
                        "notebook"
                    ],
                    "common_phrases": [
                        "note pad",
                        "sketch pad",
                        "writing pad",
                        "legal pad"
                    ],
                    "target_lang_definitions": {
                        "ru": "Блок листов бумаги, скрепленных с одного края, используемый для письма или рисования.",
                        "zh": "一叠装订在一起的纸，用于书写或绘画。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "блокнот",
                                "target_lang_sense_clarification": "тетрадь с отрывными листами"
                            },
                            {
                                "target_lang_word": "альбом",
                                "target_lang_sense_clarification": "для рисования"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "便签本",
                                "target_lang_sense_clarification": "用于记录的纸本"
                            },
                            {
                                "target_lang_word": "素描本",
                                "target_lang_sense_clarification": "用于绘画的纸本"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "93baa0e0-0047-3172-bd99-355be91e1374",
                    "sense_definition": "A thick piece of soft material used to protect something, make it more comfortable, or give it shape.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "cushioning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The football player wore a shoulder <w>pad</w> under his jersey.",
                            "target_lang_translations": {
                                "ru": "Футболист надел <w>наплечник</w> под футболку.",
                                "zh": "足球运动员在球衣下戴了<w>护肩</w>。"
                            }
                        },
                        {
                            "text": "Put a <w>pad</w> on the chair to make it more comfortable to sit on.",
                            "target_lang_translations": {
                                "ru": "Положи <w>подушку</w> на стул, чтобы сидеть было удобнее.",
                                "zh": "在椅子上放个<w>垫子</w>，坐起来会更舒服。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "knee pad",
                        "shoulder pad",
                        "mattress pad",
                        "brake pad"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кусок мягкого материала, используемый для защиты, придания формы или удобства.",
                        "zh": "用于保护、增加舒适度或定型的柔软材料。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "накладка",
                                "target_lang_sense_clarification": "защитный элемент"
                            },
                            {
                                "target_lang_word": "подушечка",
                                "target_lang_sense_clarification": "мягкая подкладка"
                            },
                            {
                                "target_lang_word": "подкладка",
                                "target_lang_sense_clarification": "внутренний слой"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "护垫",
                                "target_lang_sense_clarification": "运动防护用具"
                            },
                            {
                                "target_lang_word": "垫子",
                                "target_lang_sense_clarification": "增加舒适度的软垫"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "50f055cd-6f8a-3412-bb6f-770354463ef6",
                    "sense_definition": "A layer of absorbent material worn by women to absorb menstrual flow.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "hygiene",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She keeps a spare <w>pad</w> in her bag just in case.",
                            "target_lang_translations": {
                                "ru": "Она держит запасную <w>прокладку</w> в сумке на всякий случай.",
                                "zh": "她包里总是备着一片<w>卫生巾</w>，以防万一。"
                            }
                        },
                        {
                            "text": "You can buy a box of sanitary <w>pads</w> at the pharmacy.",
                            "target_lang_translations": {
                                "ru": "Вы можете купить коробку гигиенических <w>прокладок</w> в аптеке.",
                                "zh": "你可以在药店买到一盒<w>卫生巾</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "sanitary pad"
                    ],
                    "target_lang_definitions": {
                        "ru": "Слой впитывающего материала, используемый женщинами для личной гигиены.",
                        "zh": "女性经期使用的吸收性卫生用品。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прокладка",
                                "target_lang_sense_clarification": "средство гигиены"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "卫生巾",
                                "target_lang_sense_clarification": "女性经期卫生用品"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b4ce6010-32c2-3e88-aaa7-d275d7e99a8d",
                    "sense_definition": "The soft, fleshy part on the underside of an animal's paw or the tip of a human finger.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dog had a thorn stuck in the <w>pad</w> of its paw.",
                            "target_lang_translations": {
                                "ru": "У собаки застряла колючка в <w>подушечке</w> лапы.",
                                "zh": "那只狗的爪子<w>肉垫</w>里扎进了一根刺。"
                            }
                        },
                        {
                            "text": "Use the <w>pad</w> of your thumb to unlock the phone screen.",
                            "target_lang_translations": {
                                "ru": "Используйте <w>подушечку</w> большого пальца, чтобы разблокировать экран телефона.",
                                "zh": "用你的大拇指<w>指腹</w>来解锁手机屏幕。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "paw pad",
                        "finger pad"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мягкая часть на нижней стороне лапы животного или кончике пальца человека.",
                        "zh": "动物爪子底部或人类指尖的柔软肉质部分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подушечка",
                                "target_lang_sense_clarification": "часть пальца или лапы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "肉垫",
                                "target_lang_sense_clarification": "动物爪底的软垫"
                            },
                            {
                                "target_lang_word": "指腹",
                                "target_lang_sense_clarification": "手指尖的柔软部分"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8fa0faee-5ac0-3ab1-a529-dd61cfe7ea7c",
                    "sense_definition": "A flat surface on an electronic device that is sensitive to touch or pressure, used for control or input.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Use the track <w>pad</w> to move the cursor across the screen.",
                            "target_lang_translations": {
                                "ru": "Используйте <w>тачпад</w>, чтобы перемещать курсор по экрану.",
                                "zh": "使用<w>触摸板</w>在屏幕上移动光标。"
                            }
                        },
                        {
                            "text": "The drummer hit the electronic <w>pad</w> to trigger a sound effect.",
                            "target_lang_translations": {
                                "ru": "Барабанщик ударил по электронному <w>пэду</w>, чтобы запустить звуковой эффект.",
                                "zh": "鼓手敲击电子<w>打击板</w>来触发音效。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "mouse pad",
                        "touch pad",
                        "track pad",
                        "launch pad"
                    ],
                    "target_lang_definitions": {
                        "ru": "Плоская поверхность на электронном устройстве, чувствительная к касанию, используемая для управления.",
                        "zh": "电子设备上用于控制或输入的感应平面。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тачпад",
                                "target_lang_sense_clarification": "сенсорная панель ввода"
                            },
                            {
                                "target_lang_word": "панель",
                                "target_lang_sense_clarification": "сенсорная поверхность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "触摸板",
                                "target_lang_sense_clarification": "笔记本电脑的控制面板"
                            },
                            {
                                "target_lang_word": "鼠标垫",
                                "target_lang_sense_clarification": "放置鼠标的垫子"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b179a361-6152-32c4-a642-0252df4df1b4",
                    "sense_definition": "A person's home or apartment.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "home",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They went back to his <w>pad</w> to watch a movie after dinner.",
                            "target_lang_translations": {
                                "ru": "После ужина они пошли к нему на <w>хату</w>, чтобы посмотреть фильм.",
                                "zh": "晚饭后他们回到他的<w>住处</w>看电影。"
                            }
                        },
                        {
                            "text": "He has a really nice bachelor <w>pad</w> in the city center.",
                            "target_lang_translations": {
                                "ru": "У него отличная холостяцкая <w>берлога</w> в центре города.",
                                "zh": "他在市中心有一间很棒的<w>单身公寓</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bachelor pad"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Дом или квартира человека (сленг).",
                        "zh": "某人的住所或公寓（俚语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хата",
                                "target_lang_sense_clarification": "сленг: квартира"
                            },
                            {
                                "target_lang_word": "берлога",
                                "target_lang_sense_clarification": "сленг: холостяцкое жилье"
                            },
                            {
                                "target_lang_word": "жильё",
                                "target_lang_sense_clarification": "место проживания"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "住处",
                                "target_lang_sense_clarification": "非正式的居住地"
                            },
                            {
                                "target_lang_word": "单身公寓",
                                "target_lang_sense_clarification": "指代单身男性的住所"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e013d6d9-15cb-34f0-a60b-79c4c25a54fc",
                    "sense_definition": "A designated flat area where a helicopter can take off and land.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "aviation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The helicopter landed safely on the hospital's roof <w>pad</w>.",
                            "target_lang_translations": {
                                "ru": "Вертолет благополучно приземлился на <w>площадку</w> на крыше больницы.",
                                "zh": "直升机安全降落在医院屋顶的<w>停机坪</w>上。"
                            }
                        },
                        {
                            "text": "We waited by the landing <w>pad</w> for the medical transport to arrive.",
                            "target_lang_translations": {
                                "ru": "Мы ждали медицинский транспорт у посадочной <w>площадки</w>.",
                                "zh": "我们在<w>停机坪</w>旁等待医疗运输机到达。"
                            }
                        }
                    ],
                    "synonyms": [
                        "helipad"
                    ],
                    "common_phrases": [
                        "landing pad"
                    ],
                    "target_lang_definitions": {
                        "ru": "Специально отведенная плоская площадка для взлета и посадки вертолетов.",
                        "zh": "直升机起降的专用平坦区域。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "площадка",
                                "target_lang_sense_clarification": "вертолетная"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "停机坪",
                                "target_lang_sense_clarification": "直升机起降平台"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bc2c4d3d-80c9-3eb1-b478-697af2f67d60",
                    "sense_definition": "The large, flat, floating leaf of a water lily.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "botany",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A green frog sat motionless on a large lily <w>pad</w>.",
                            "target_lang_translations": {
                                "ru": "Зеленая лягушка неподвижно сидела на большом <w>листе</w> кувшинки.",
                                "zh": "一只绿青蛙一动不动地坐在大<w>荷叶</w>上。"
                            }
                        },
                        {
                            "text": "The pond was covered in flowers and green <w>pads</w>.",
                            "target_lang_translations": {
                                "ru": "Пруд был покрыт цветами и зелеными <w>листьями</w>.",
                                "zh": "池塘里开满了花，铺满了绿色的<w>荷叶</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "lily pad"
                    ],
                    "target_lang_definitions": {
                        "ru": "Большой плоский плавающий лист кувшинки.",
                        "zh": "睡莲的大而平坦的浮叶。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лист",
                                "target_lang_sense_clarification": "кувшинки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "荷叶",
                                "target_lang_sense_clarification": "睡莲或荷花的叶子"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "41c6eba5-f734-3b61-8815-1a200c134100",
                    "sense_definition": "To walk with soft, steady steps, making very little noise.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>padded</w> barefoot across the kitchen floor to get a glass of water.",
                            "target_lang_translations": {
                                "ru": "Она босиком <w>прошлёпала</w> по кухне, чтобы взять стакан воды.",
                                "zh": "她赤着脚<w>轻步走</w>过厨房地板去拿一杯水。"
                            }
                        },
                        {
                            "text": "The large cat <w>padded</w> silently through the tall grass.",
                            "target_lang_translations": {
                                "ru": "Большая кошка бесшумно <w>ступала</w> по высокой траве.",
                                "zh": "那只大猫在长草丛中无声地<w>轻步走</w>过。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Идти мягкими, ровными шагами, почти не создавая шума.",
                        "zh": "脚步轻柔、平稳地行走，几乎不发出声音。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шлёпать",
                                "target_lang_sense_clarification": "идти с мягким звуком"
                            },
                            {
                                "target_lang_word": "ступать",
                                "target_lang_sense_clarification": "мягко идти"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "轻步走",
                                "target_lang_sense_clarification": "形容走路声音轻"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "da36e87a-31f3-3b7a-bf3b-ed4c5ff87820",
                    "sense_definition": "To increase the size or length of something by adding unnecessary material or false information.",
                    "learner_level": "C2",
                    "frequency": "Middle",
                    "semantic_group_id": "increase",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tried to <w>pad</w> his essay with extra adjectives to meet the word count.",
                            "target_lang_translations": {
                                "ru": "Он пытался <w>раздуть</w> свое эссе лишними прилагательными, чтобы набрать нужное количество слов.",
                                "zh": "他试图在文章中加入多余的形容词来<w>充数</w>，以达到字数要求。"
                            }
                        },
                        {
                            "text": "The contractor was accused of trying to <w>pad</w> the bill with hidden fees.",
                            "target_lang_translations": {
                                "ru": "Подрядчика обвинили в попытке <w>раздуть</w> счет скрытыми комиссиями.",
                                "zh": "承包商被指控试图通过隐形费用来<w>虚报</w>账单。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "pad the bill",
                        "pad out"
                    ],
                    "target_lang_definitions": {
                        "ru": "Увеличивать объем чего-либо путем добавления ненужного материала или ложной информации.",
                        "zh": "通过添加不必要的内容或虚假信息来增加某物的篇幅或金额。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раздувать",
                                "target_lang_sense_clarification": "искусственно увеличивать объем"
                            },
                            {
                                "target_lang_word": "наполнять",
                                "target_lang_sense_clarification": "водой (в тексте)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "充数",
                                "target_lang_sense_clarification": "凑足数量"
                            },
                            {
                                "target_lang_word": "虚报",
                                "target_lang_sense_clarification": "夸大金额"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "bf30582f-65eb-3947-8a5c-7f7864491100",
                    "sense_definition": "A word used to imitate a soft, flat sound, such as bare footsteps.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I could hear her feet going <w>pad</w>, <w>pad</w>, <w>pad</w> along the hallway.",
                            "target_lang_translations": {
                                "ru": "Я слышал, как ее ноги делали <w>шлёп</w>, <w>шлёп</w>, <w>шлёп</w> по коридору.",
                                "zh": "我能听到她走廊里<w>啪嗒</w>、<w>啪嗒</w>、<w>啪嗒</w>的脚步声。"
                            }
                        },
                        {
                            "text": "The only sound was the soft <w>pad</w> of the dog walking on the carpet.",
                            "target_lang_translations": {
                                "ru": "Единственным звуком был мягкий <w>топот</w> собаки, идущей по ковру.",
                                "zh": "唯一的声音是狗在毯子上走动时发出的<w>啪嗒</w>声。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Слово, имитирующее мягкий, глухой звук шагов.",
