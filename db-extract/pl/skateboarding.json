                                "target_senses": [
                                    {
                                        "sense_id": "201ac74f-0edb-356f-96fa-9a702de66892",
                                        "entry_id": "7c18588e-03d8-36e3-82da-a3f979438f2c",
                                        "glosses": [
                                            "The act of riding on a skateboard."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a1d313a-413e-4769-b0b3-9fadd56d126d",
                                                "sense_id": "201ac74f-0edb-356f-96fa-9a702de66892",
                                                "text": "Thirteen-year-old Cui Chenxi of China clinched gold in women’s skateboarding at the Asian Games on Wednesday, becoming the country’s youngest gold medalist as teenage girls continue to dominate the sport."
                                            }
                                        ]
                                    }
                                ]
