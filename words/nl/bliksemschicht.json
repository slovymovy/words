    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0cc1ad22-affd-342b-ace3-a0e7c633d5fb",
                    "sense_definition": "Een zichtbare elektrische ontlading in de lucht tijdens onweer; een bliksemstraal die door de hemel schiet.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "natuurverschijnsel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tijdens de zware storm verlichtte een felle <w>bliksemschicht</w> plotseling de hele donkere hemel.",
                            "target_lang_translations": {
                                "en": "During the severe storm, a bright <w>bolt of lightning</w> suddenly illuminated the entire dark sky."
                            }
                        },
                        {
                            "text": "Het luchtschip doorkliefde een wolkendek waaruit <w>bliksemschichten</w> opvonkten.",
                            "target_lang_translations": {
                                "en": "The airship cut through a layer of clouds from which <w>lightning bolts</w> sparked."
                            }
                        }
                    ],
                    "synonyms": [
                        "bliksemstraal",
                        "bliksem",
                        "bliksemflits",
                        "bliksemslag",
                        "weerlicht"
                    ],
                    "common_phrases": [
                        "felle bliksemschicht"
                    ],
                    "target_lang_definitions": {
                        "en": "A visible electrical discharge in the air during a thunderstorm; a flash of lightning shooting through the sky."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bolt of lightning",
                                "target_lang_sense_clarification": "a single discharge of lightning"
                            },
                            {
                                "target_lang_word": "lightning bolt",
                                "target_lang_sense_clarification": "a flash of lightning"
                            },
                            {
                                "target_lang_word": "flash of lightning",
                                "target_lang_sense_clarification": "sudden light from lightning"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c61125f3-a1fb-3b6d-bd33-e6b9d5d41fad",
                    "sense_definition": "Een plotselinge, heldere inval of een schokkend moment van helderheid of inspiratie.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "figuurlijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het idee voor zijn nieuwe boek kwam als een <w>bliksemschicht</w> bij hem binnen toen hij op de bus wachtte.",
                            "target_lang_translations": {
                                "en": "The idea for his new book came to him like a <w>flash of inspiration</w> while he was waiting for the bus."
                            }
                        },
                        {
                            "text": "Hij werd als door een <w>bliksemschicht</w> getroffen door het plotselinge besef dat hij zijn sleutels kwijt was.",
                            "target_lang_translations": {
                                "en": "He was struck as if by a <w>bolt from the blue</w> by the sudden realization that he had lost his keys."
                            }
                        }
                    ],
                    "common_phrases": [
                        "als een bliksemschicht"
                    ],
                    "target_lang_definitions": {
                        "en": "A sudden, bright idea or a shocking moment of clarity or inspiration."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bolt from the blue",
                                "target_lang_sense_clarification": "a sudden, unexpected event or realization"
                            },
                            {
                                "target_lang_word": "flash of inspiration",
                                "target_lang_sense_clarification": "a sudden bright idea"
                            },
                            {
                                "target_lang_word": "bolt of lightning",
                                "target_lang_sense_clarification": "figurative sudden shock or realization"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}