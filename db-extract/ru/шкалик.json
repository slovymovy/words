                "senses": [
                    {
                        "sense_id": "427c3b25-1690-39e7-8a88-192470502329",
                        "entry_id": "3fd1e94e-4468-39af-bbaf-a96b9ac95a64",
                        "glosses": [
                            "разг. небольшая бутылка крепкого спиртного напитка вместимостью около 60 мл"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e4b07dd-f081-4483-a3cd-d7531bca2db2",
                                "sense_id": "427c3b25-1690-39e7-8a88-192470502329",
                                "text": "На душе было скверно, я купил ещё шкалик водки у метро, выпил, совсем захмелел."
                            }
                        ]
                    },
                    {
                        "sense_id": "3e122573-d383-3c23-8233-004cd5ed1652",
                        "entry_id": "3fd1e94e-4468-39af-bbaf-a96b9ac95a64",
                        "glosses": [
                            "устар. единица измерения объёма для жидких тел в русской системе мер, равная 1/200 части ведра"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6b5f5de-627e-479a-96d5-b64519e229af",
                                "sense_id": "3e122573-d383-3c23-8233-004cd5ed1652",
                                "text": "На эти деньги можно было очень сытно прожить день, но Вяхиря била мать, если он не приносил ей на шкалик или на косушку водки."
                            }
                        ]
                    }
