                                "text": "Onguent vésicatoire."
                            },
                            {
                                "example_id": "f9cc2046-37f8-45a9-9893-dd9847936ccf",
                                "sense_id": "9d2339a5-0e0c-33f6-b150-3a457d196791",
                                "text": "Emplâtre vésicatoire."
                            },
                            {
