                        ],
                        "form": "ionen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "663381de-9dea-3227-813d-3b5d430d050c",
                        "entry_id": "44dc9295-7b1b-3b8b-aab9-600ca86ef58e",
                        "glosses": [
                            "atoom of een molecuul die elektrisch geladen is door een gebrek aan of overschot van één of meer elektronen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6c8d104-7165-4691-8ebc-5b561440efe5",
                                "sense_id": "663381de-9dea-3227-813d-3b5d430d050c",
                                "text": "In 2024 rapporteerden onderzoekers van de STAR Collaboration bij de Relativistic Heavy Ion Collider (RHIC) van Brookhaven National Laboratory in New York over het kortstondig creëren van een toen ongekend zware antimateriekern, genaamd antihyperwaterstof-4."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "57f128e3-6dbe-4b14-a499-1b8c649bf4c5",
                        "source_entry_id": "44dc9295-7b1b-3b8b-aab9-600ca86ef58e",
                        "source_sense_id": "663381de-9dea-3227-813d-3b5d430d050c",
                        "target_lang_word": "Ion",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ion",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6c9e8cdc-39b6-3853-b1cf-1a3bb9493925",
                                        "entry_id": "4eb94384-605b-3ebe-8fcb-9891041467ea",
                                        "glosses": [
                                            "elektrisch geladenes Teilchen, das aus einem neutralen Atom oder Molekül durch Anlagerung oder Abgabe von Elektronen (Ionisation) entsteht"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea77a38d-af70-4d0e-a20d-11e7d4de3823",
                                                "sense_id": "6c9e8cdc-39b6-3853-b1cf-1a3bb9493925",
                                                "text": "Dieses Ion ist zweifach positiv geladen."
                                            },
                                            {
                                                "example_id": "be0fc274-2490-439b-b394-321972054308",
                                                "sense_id": "6c9e8cdc-39b6-3853-b1cf-1a3bb9493925",
                                                "text": "„Weder gibt es einen Plus- noch einen Minuspol, sondern nur ein Gefälle von geladenen Teilchen wie Elektronen oder Ionen.“"
                                            },
                                            {
                                                "example_id": "a9c01a7c-7d95-40e8-8de6-3bb600f0f051",
                                                "sense_id": "6c9e8cdc-39b6-3853-b1cf-1a3bb9493925",
                                                "text": "[…] „Beim Lösen eines Salzes muss zunächst die Gitterenergie aufgewendet werden, um die Anziehungskräfte zwischen den Ionen im Kristallgitter zu überwinden und die Ionen voneinenader zu trennen.“"
                                            },
                                            {
                                                "example_id": "7b220e33-21c8-4039-bbf2-577a7b1f0c53",
                                                "sense_id": "6c9e8cdc-39b6-3853-b1cf-1a3bb9493925",
                                                "text": "„Manche Ionen binden ihre Hydrathülle so fest, dass beim Auskristallisieren des Salzes ein Teil der Wasser-Moleküle in das Kristallgitter eingebaut wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
