                                        "entry_id": "0133524d-1c8b-3277-87ab-1672583ffaa0",
                                        "glosses": [
                                            "Of or relating to the material world, as opposed to sacred or clerical."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "relational",
                                            "usually"
