                ],
                "senses": [
                    {
                        "sense_id": "51701c01-5701-36d2-ad08-f38ee190ca9d",
                        "entry_id": "08196902-e4f7-3091-8be3-5b0e4ca8b44a",
                        "glosses": [
                            "stwierdzenie rodzaju choroby"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48ed77ad-e226-409f-96ee-89b6dfb469b0",
                                "sense_id": "51701c01-5701-36d2-ad08-f38ee190ca9d",
                                "text": "W dokumentacji medycznej rozpoznania należy wpisywać zgodnie z międzynarodową klasyfikacją ICD-10."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "f9afcb40-e7fc-3f33-af6d-734ee2c5c518",
                        "entry_id": "08196902-e4f7-3091-8be3-5b0e4ca8b44a",
                        "glosses": [
                            "rozpatrzenie sprawy przez sąd lub organ administracji"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22983d6e-6f26-4648-a172-3c57c1b6bda4",
                                "sense_id": "f9afcb40-e7fc-3f33-af6d-734ee2c5c518",
                                "text": "Poucza się stronę, że w przypadku nieuzupełnienia braków formalnych podanie zostanie pozostawione bez rozpoznania."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "fa479ad3-06b9-39a8-a0d2-13069974cc1e",
                        "entry_id": "08196902-e4f7-3091-8be3-5b0e4ca8b44a",
                        "glosses": [
                            "działalność wojsk na polu walki mająca na celu zdobycie informacji o nieprzyjacielu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e70cc66d-fa4a-4851-b780-cfc5cbaadccb",
                                "sense_id": "fa479ad3-06b9-39a8-a0d2-13069974cc1e",
                                "text": "Rozpoznanie bojem prowadzi często do nieproporcjonalnie wysokich strat w stosunku do osiąganych efektów operacyjnych."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "828b1e15-9d61-3236-8eac-da1ee97d0811",
                        "entry_id": "08196902-e4f7-3091-8be3-5b0e4ca8b44a",
                        "glosses": [
                            "dokonanie identyfikacji"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57aaf393-07d8-4c5c-abb4-b4a6dd6b11ff",
                                "sense_id": "828b1e15-9d61-3236-8eac-da1ee97d0811",
                                "text": "Syn denata przybył do kostnicy na rozpoznanie zwłok."
                            }
                        ],
                        "sense_index_json": "\"1.4\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ac1d6fed-ccc9-4744-95c8-5ef3a95f4174",
                        "source_entry_id": "08196902-e4f7-3091-8be3-5b0e4ca8b44a",
                        "source_sense_id": "fa479ad3-06b9-39a8-a0d2-13069974cc1e",
                        "target_lang_word": "разведка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "разведка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a3efd4b1-bb70-3a7b-a0ac-4284a63037e2",
                                        "entry_id": "53fc99b9-1d5f-34d6-902e-7f1746c9c718",
                                        "glosses": [
                                            "действие по значению гл. разведывать; выяснение чего-либо ранее неизвестного"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0ab2ede-dbbf-4bac-8e5c-b4ba9245450d",
                                                "sense_id": "a3efd4b1-bb70-3a7b-a0ac-4284a63037e2",
                                                "text": "Нам нужно произвести разведку и узнать, что они замышляют."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ea3b758-95de-3886-a063-f3957282dac4",
                                        "entry_id": "53fc99b9-1d5f-34d6-902e-7f1746c9c718",
                                        "glosses": [
                                            "воен. подразделение, занимающееся разведкой [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9963bd8-7356-47a0-8c35-bc72e9e0fa68",
                                                "sense_id": "7ea3b758-95de-3886-a063-f3957282dac4",
                                                "text": "Он — фронтовик, служил в разведке, был командиром взвода, награждён медалью «За отвагу»."
                                            },
                                            {
                                                "example_id": "594dd333-3f50-4507-b2af-202b93fd7b88",
                                                "sense_id": "7ea3b758-95de-3886-a063-f3957282dac4",
                                                "text": "Американская разведка, по его словам, располагала «фрагментарной» информацией о возможных закупках Ираком урана в Африке."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
