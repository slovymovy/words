                            "singular"
                        ],
                        "form": "das Handwerkszeug"
                    },
                    {
                        "form_id": "84b8a367-f03a-41bd-9d90-f0cb57f24ef7",
                        "entry_id": "85fa8d24-adf2-35c6-91e5-1959d9bba08b",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Handwerkszeuge"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e0e47218-e8f7-3a71-acad-cbeefaf7e8ca",
                        "entry_id": "85fa8d24-adf2-35c6-91e5-1959d9bba08b",
                        "glosses": [
                            "Gegenstände, Geräte, Dinge, die für Arbeiten mit der Hand, für das Handwerk benötigt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6608b35-7336-467a-96b3-4d0d62ecd86a",
                                "sense_id": "e0e47218-e8f7-3a71-acad-cbeefaf7e8ca",
                                "text": "„Die grundlegenden mechanischen Maschinenelemente wie Rad, Hebel, Rolle, schiefe Ebene (Keil) und alle wichtigeren Handwerkszeuge (Axt, Hammer, Säge) waren schon in vorgeschichtlichen Zeiten bekannt.“"
                            },
                            {
                                "example_id": "b981fb6b-4702-4a40-bc44-5cb775cf8ed2",
                                "sense_id": "e0e47218-e8f7-3a71-acad-cbeefaf7e8ca",
                                "text": "„Wie der Bauer nicht ohne sein Ackergerät oder Vertreter anderer Berufe ohne ihr spezielles Handwerkszeug, so kommen Wissenschaftler wie Techniker und überhaupt Fachleute aller Disziplinen nicht ohne eine genau definierte Begrifflichkeit aus: eben ihre von Fach zu Fach verschiedene Terminologie.“"
                            },
                            {
                                "example_id": "37a7c632-5d3b-4d9f-80e8-5b09fe661f4c",
                                "sense_id": "e0e47218-e8f7-3a71-acad-cbeefaf7e8ca",
                                "text": "„Georg K. Glaser steht an seiner Werkbank und erklärt mir Handwerkszeug wie Niet-, Schlicht- und Kugelhammer, Fausteisen, Rehfuß, Geisfuß, Postillion, Salzfass.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
