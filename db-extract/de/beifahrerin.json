                "senses": [
                    {
                        "sense_id": "3e6ffbf5-36f4-3ce6-8862-7f39fbdb4c8c",
                        "entry_id": "cbd4b280-1826-3296-8e57-3925f702c36b",
                        "glosses": [
                            "weibliche Person, die auf dem Sitz neben dem Fahrer/Lenker eines Fahrzeugs mitfährt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de38cf9e-b113-43ac-919f-6280a319c4fd",
                                "sense_id": "3e6ffbf5-36f4-3ce6-8862-7f39fbdb4c8c",
                                "text": "„Relativ glimpflich – mit leichten Prellungen – kam Berichten zufolge die schwangere Beifahrerin im Unglücksauto davon.“"
                            },
                            {
                                "example_id": "eb02e29a-3a0d-4f3f-bc3c-1cd580394849",
                                "sense_id": "3e6ffbf5-36f4-3ce6-8862-7f39fbdb4c8c",
                                "text": "„Bei einem Autounfall auf einer Bundesstraße im Westerwald ist am Dienstag eine Beifahrerin lebensbedrohlich verletzt worden.“"
                            },
                            {
                                "example_id": "7f084d00-0707-4582-a15e-fb34ab6de4d6",
                                "sense_id": "3e6ffbf5-36f4-3ce6-8862-7f39fbdb4c8c",
                                "text": "„Die unbekannte Beifahrerin war noch an der Unfallstelle ihren Verletzungen erlegen, wie es im üblichen Zeitungsdeutsch hieß.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
