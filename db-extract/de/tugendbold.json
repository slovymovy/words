                "senses": [
                    {
                        "sense_id": "d8e47aeb-9de2-3487-8737-7e7e0dce1811",
                        "entry_id": "dfe18d4c-b0e3-314c-818e-6a61dd324fec",
                        "glosses": [
                            "Person, die besonders viel Wert auf sittliches, moralisch einwandfreies Verhalten legt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bceb70ca-d976-46ae-883c-8a5d84fcc4fc",
                                "sense_id": "d8e47aeb-9de2-3487-8737-7e7e0dce1811",
                                "text": "„Mit tausend Freuden nehme ich die Schuld auf mich! Sie müssen sich jetzt rein fühlen. Sie müssen sich jetzt für den sittenstrengen Mustermenschen, für den Tugendbold von unerschütterlichen Grundsätzen halten – sonst können Sie das Kind in seiner bodenlosen Unerfahrenheit gar nicht heiraten …“"
                            },
                            {
                                "example_id": "8b1516fd-d7e0-4ea7-99fa-00cc0a2826c2",
                                "sense_id": "d8e47aeb-9de2-3487-8737-7e7e0dce1811",
                                "text": "„Aber das ist bloß der Prolog, die erheiternde Einstimmung, die uns zumal den jungen Schiller eben nicht als Tugendbold und Moraltrompeter, sondern als sinnenfrohen, lebenslustigen Bohemien vorführt.“"
                            },
                            {
                                "example_id": "3e046cd4-0b0a-46c6-aded-0cf9825ced3d",
                                "sense_id": "d8e47aeb-9de2-3487-8737-7e7e0dce1811",
                                "text": "„Das war, bevor er die Wunde ausbrannte, indem er sich in einen Tugendbold verwandelte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5b2dcd46-1142-417b-bddd-33fd60fa15d8",
                        "source_entry_id": "dfe18d4c-b0e3-314c-818e-6a61dd324fec",
