                        "glosses": [
                            "A polysaccharide that resembles a sugar, often insoluble and not sweet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "497d1f53-ee0e-4f46-b4c5-249d085d4045",
                                "sense_id": "f5bf8ab7-5c64-3fe3-aaa2-0eb8f7fb3236",
                                "text": "A sweet taste is possessed by nearly all sugars, to a greater or less extent, though in some of the rarer saccharoids the character is very feebly marked."
                            },
                            {
                                "example_id": "feb19c60-5a95-4452-bf10-8417d73e521c",
                                "sense_id": "f5bf8ab7-5c64-3fe3-aaa2-0eb8f7fb3236",
                                "text": "While the errors of the indirect procedure are chiefly manifested at high blood sugar levels, still we feel that in any critical study of the saccharoids the direct yeast procedure is the method of choice."
                            }
                        ]
                    }
