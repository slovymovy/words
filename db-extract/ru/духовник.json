                "senses": [
                    {
                        "sense_id": "317510a1-07cd-31ef-9200-f725789ad6b1",
                        "entry_id": "d1e04f57-ed01-3105-b033-dd86878ccf41",
                        "glosses": [
                            "религ. духовный или религиозный наставник, учитель"
                        ],
                        "tags": [],
