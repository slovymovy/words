            "senses": [
                {
                    "sense_id": "323cae67-b17f-395d-aa0f-7ee570df912d",
                    "sense_definition": "Handlung des Abschiednehmens oder des Sagens von Lebewohl zu einer Person.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "abschied",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die <w>Verabschiedung</w> am Flughafen fiel den beiden Freunden nach dem langen Besuch sichtlich schwer."
                        },
                        {
                            "text": "Zur <w>Verabschiedung</w> umarmte sie ihre Kollegin herzlich und wünschte ihr alles Gute für die Zukunft."
                        }
                    ],
                    "antonyms": [
                        "Begrüßung",
                        "Empfang"
                    ],
                    "common_phrases": [
                        "zur Verabschiedung"
                    ]
                },
                {
                    "sense_id": "250d0ac2-65c9-3867-af16-9fcb44465c41",
                    "sense_definition": "Gültiger Beschluss oder Annahme eines Gesetzentwurfs durch ein Parlament oder Gesetzgebungsorgan.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gesetzgebung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die <w>Verabschiedung</w> des neuen Gesetzes führte im Parlament zu einer langen und hitzigen Debatte."
                        },
                        {
                            "text": "Nach der endgültigen <w>Verabschiedung</w> der Reform treten die neuen Regelungen bereits im nächsten Monat in Kraft."
                        }
                    ],
                    "synonyms": [
                        "Annahme",
                        "Inkraftsetzung"
                    ],
                    "antonyms": [
                        "Aufhebung"
                    ],
                    "common_phrases": [
                        "Verabschiedung des Gesetzes"
                    ]
                },
                {
                    "sense_id": "26042da8-e9cf-340f-af60-831060252afd",
                    "sense_definition": "Formelle oder feierliche Entlassung aus einem Amt oder Dienstverhältnis, meist in den Ruhestand.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "amtsende",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bei seiner feierlichen <w>Verabschiedung</w> in den Ruhestand dankte der Direktor allen langjährigen Mitarbeitern."
                        },
                        {
                            "text": "Zur offiziellen <w>Verabschiedung</w> der Botschafterin reisten hochrangige Politiker aus dem ganzen Land an."
                        }
                    ],
                    "synonyms": [
                        "Abberufung",
                        "Entpflichtung"
                    ],
                    "antonyms": [
                        "Aufnahme"
                    ],
                    "common_phrases": [
                        "Verabschiedung in den Ruhestand"
                    ]
                },
                {
                    "sense_id": "df4020df-87d1-3207-b7e4-e79da3093c29",
                    "sense_definition": "Feierlicher Abschied von einer verstorbenen Person im Rahmen einer Trauerfeier oder Bestattung.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "trauer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die <w>Verabschiedung</w> des Verstorbenen fand im engsten Kreis der Familie auf dem Friedhof statt."
                        },
                        {
                            "text": "Zur feierlichen <w>Verabschiedung</w> in der Kapelle versammelten sich viele Freunde und Verwandte."
                        }
                    ],
                    "synonyms": [
                        "Begräbnis",
                        "Beisetzung",
                        "Bestattung",
                        "Totenfeier"
                    ]
                }
            ]
