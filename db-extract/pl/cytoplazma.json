                        ]
                    },
                    {
                        "translation_id": "3b8bcf03-5260-441c-9d7c-652bb9b8cc7e",
                        "source_entry_id": "eb629a8f-dfde-3e70-8d78-fc4a007dfd65",
                        "source_sense_id": "9a8f7ef9-93fe-3e73-8adc-815b32ea9b4a",
                        "target_lang_word": "Zytoplasma",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zytoplasma",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6d4f3541-2a63-3713-a145-cb01903bdde0",
                                        "entry_id": "0b3d8309-159c-38f2-8801-a288aacf54bf",
                                        "glosses": [
                                            "der von der Zellmembran umgebene Teil der Zelle ohne den Zellkern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14095004-ddbe-4e33-834d-85da250600d3",
                                                "sense_id": "6d4f3541-2a63-3713-a145-cb01903bdde0",
                                                "text": "Im Innenraum einer Zelle, dem Zytoplasma, laufen Abertausende biochemischer Reaktionen ab."
                                            },
                                            {
                                                "example_id": "5a2c457b-a636-4855-a3c8-b41f41959d46",
                                                "sense_id": "6d4f3541-2a63-3713-a145-cb01903bdde0",
                                                "text": "Aminoacyl-tRNA-Synthetasen (AARS) sind Enzyme, die in allen Lebewesen im Zytoplasma vorkommen und wichtig für die Translation (ein Teil der Proteinbiosynthese) sind."
                                            },
                                            {
                                                "example_id": "2277bed1-8575-42f7-b2a3-6a621c476264",
                                                "sense_id": "6d4f3541-2a63-3713-a145-cb01903bdde0",
                                                "text": "Will eine Zelle ihre Proteine vervielfachen, erzeugt sie Kopien der betreffenden Gene in Form von Boten- oder mRNAs (nach englisch messenger, Bote) und schleust sie aus dem Kern ins Zytoplasma."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
