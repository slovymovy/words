                                        "examples": [
                                            {
                                                "example_id": "fe6ae515-8d68-41a5-890c-24b2e0855e40",
                                                "sense_id": "efbc8167-b114-3478-af31-c71567ed0bc7",
                                                "text": "There may have been a vague communality of purpose, but we were never a team."
                                            }
