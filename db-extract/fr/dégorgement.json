                "entry_id": "58ff408a-6b39-3562-991b-1020af51225b",
                "word": "dégorgement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "353b1cd5-979d-491b-82af-0a64012e6961",
                        "entry_id": "58ff408a-6b39-3562-991b-1020af51225b",
                        "tags": [
                            "plural"
                        ],
                        "form": "dégorgements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b8426c48-69d2-3f81-a6d4-b5dbe604f3cb",
                        "entry_id": "58ff408a-6b39-3562-991b-1020af51225b",
                        "glosses": [
                            "Action de dégorger, de se dégorger ou résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec3806bf-f78a-450a-a03f-fd994e7a9e23",
                                "sense_id": "b8426c48-69d2-3f81-a6d4-b5dbe604f3cb",
                                "text": "Le dégorgement des humeurs."
                            },
                            {
                                "example_id": "d9329bd7-cba0-45bd-afab-9a1657dd82bd",
                                "sense_id": "b8426c48-69d2-3f81-a6d4-b5dbe604f3cb",
                                "text": "Il lui survint un dégorgement de bile."
                            },
                            {
                                "example_id": "8ca65dce-e5c5-4e5a-b27c-8ce9a11ebfeb",
                                "sense_id": "b8426c48-69d2-3f81-a6d4-b5dbe604f3cb",
                                "text": "Le dégorgement d’un égout, d’un tuyau, d’un évier, d’une gouttière."
                            },
                            {
                                "example_id": "68f37240-ff72-4b47-9736-4a189cb9d749",
                                "sense_id": "b8426c48-69d2-3f81-a6d4-b5dbe604f3cb",
                                "text": "Dégorgement des sangsues."
                            },
                            {
                                "example_id": "e04e833c-1cce-4da4-a3a7-511b98564050",
                                "sense_id": "b8426c48-69d2-3f81-a6d4-b5dbe604f3cb",
                                "text": "Le dégorgement des cuirs, des laines."
                            },
                            {
                                "example_id": "b5a9163a-545f-4289-bd27-1071bc357533",
                                "sense_id": "b8426c48-69d2-3f81-a6d4-b5dbe604f3cb",
                                "text": "Les moulins à foulon servent au dégorgement des draps."
                            },
                            {
                                "example_id": "a476e315-4395-412a-83f6-89aebc9799f9",
                                "sense_id": "b8426c48-69d2-3f81-a6d4-b5dbe604f3cb",
                                "text": "Ils regardaient les grands arbres accablés sous l'averse, la large vallée embrumée par ce dégorgement des nuages sombres et bas, et tout au loin le clocher de l'église dressé comme une pointe grise dans la pluie battante."
                            },
                            {
                                "example_id": "7363481a-6805-4647-b46d-f1955e83621c",
                                "sense_id": "b8426c48-69d2-3f81-a6d4-b5dbe604f3cb",
                                "text": "Vainement, le baron, sachant bien qu’une simple phrase de lui amènerait un dégorgement plus fangeux, implorait-il du regard l’intervention du comte."
                            },
                            {
                                "example_id": "bad722ad-aa87-4238-92e9-a71c731a082d",
                                "sense_id": "b8426c48-69d2-3f81-a6d4-b5dbe604f3cb",
                                "text": "C’était l’heure où les ateliers de nouveau se remplissent et le métro absorbait et vomissait des fourmis à tête d’homme. Yves suivit longtemps, d’un œil halluciné, cette absorption et ce dégorgement d’humanité."
                            }
                        ]
                    },
                    {
                        "sense_id": "eb29332f-c37b-3fae-918d-f091b72f79f6",
                        "entry_id": "58ff408a-6b39-3562-991b-1020af51225b",
                        "glosses": [
                            "Chantier, local ou ligne automatique où sont décapsulées les bouteilles de champagne pour en éliminer le dépôt de levures."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e59487f-3345-4639-8c59-e8c991102b63",
                                "sense_id": "eb29332f-c37b-3fae-918d-f091b72f79f6",
                                "text": "Un chantier de dégorgement est constitué d'un bac de congélation des cols de bouteilles, d'une dégorgeuse, d'une doseuse, d'une boucheuse et d'une museleuse."
                            }
                        ]
                    }
