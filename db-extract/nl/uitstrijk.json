                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29506791-14e1-4a57-b8d5-60b1906bccec",
                                                "sense_id": "c21ad6d1-7a8b-3fd1-a68d-43a5ad6026cc",
                                                "text": "Couvrir une toile n'est pas la charger de couleurs, c'est ébaucher en frottis, c'est disposer des masses en tons légers et transparents."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b429a13-633d-3822-be4f-a11b18637c4b",
                                        "entry_id": "caa48da8-acdd-3b48-80db-341c0f89d0ee",
                                        "glosses": [
                                            "Application d’une couleur transparente sur les coupes de la pierre pour imiter la couleur de la matière employée, dans une peinture architecturale."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "38f859ed-3d23-34e7-9d43-955fa1f8d7cb",
