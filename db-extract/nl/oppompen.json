                                        "glosses": [
                                            "To swell; to puff up."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d648733-7dbd-4756-9984-9f494e6384e6",
                                                "sense_id": "2fe23377-e270-3f97-beac-9a287e4245f3",
                                                "text": "to inflate somebody with pride or vanity"
                                            },
                                            {
                                                "example_id": "0bbb3afd-f58c-4843-bc5c-d4014342ec2d",
                                                "sense_id": "2fe23377-e270-3f97-beac-9a287e4245f3",
                                                "text": "[I]f they find / Some stain or blemish in a name of note, / Not grieving that their greatest are so small, / Inflate themselves with some insane delight, / And judge all nature from her feet of clay, […]"
