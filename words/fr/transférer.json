                    "sense_id": "f549e105-bd83-3d21-be37-9eea71d3932a",
                    "sense_definition": "Déplacer une personne, un objet ou des données d'un endroit vers un autre.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "deplacement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'hôpital a décidé de <w>transférer</w> le patient vers une clinique plus moderne.",
                            "target_lang_translations": {
                                "en": "The hospital decided to <w>transfer</w> the patient to a more modern clinic.",
                                "ru": "Больница решила <w>перевести</w> пациента в более современную клинику.",
                                "de": "Das Krankenhaus hat entschieden, den Patienten in eine modernere Klinik zu <w>verlegen</w>.",
                                "es": "El hospital decidió <w>trasladar</w> al paciente a una clínica más moderna.",
                                "zh": "医院决定把病人<w>转移</w>到一家更现代化的诊所。"
                            }
                        },
                        {
                            "text": "Vous devez <w>transférer</w> vos dossiers importants sur une clé USB sécurisée.",
                            "target_lang_translations": {
                                "en": "You must <w>transfer</w> your important files to a secure USB stick.",
                                "ru": "Вы должны <w>перенести</w> важные файлы на защищённую флешку.",
                                "de": "Sie müssen Ihre wichtigen Dateien auf einen sicheren USB-Stick <w>übertragen</w>.",
                                "es": "Debe <w>transferir</w> sus archivos importantes a una memoria USB segura.",
                                "zh": "您必须把重要文件<w>传输</w>到一个安全的U盘里。"
                            }
                        }
                    ],
                    "synonyms": [
                        "déplacer",
                        "transporter"
                    ],
                    "common_phrases": [
                        "transférer des données",
                        "transférer des fichiers",
                        "transférer un patient"
                    ],
                    "target_lang_definitions": {
