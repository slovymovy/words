                ],
                "senses": [
                    {
                        "sense_id": "f4e0162b-15f6-30c5-bb7c-199740113bfe",
                        "entry_id": "edf51e39-dc86-365c-bf76-231b80bcc1b1",
                        "glosses": [
                            "zusätzliches Zeichen bei einem Wappen, das den Eigentümer von anderen unterscheidet"
                        ],
                        "tags": [
                            "Heraldik"
                        ],
                        "examples": [
                            {
                                "example_id": "7358f328-353d-4b1e-b91c-198f3991567a",
                                "sense_id": "f4e0162b-15f6-30c5-bb7c-199740113bfe",
                                "text": "„Beizeichen, brisures, sind Merkmale in einem Wappen, wodurch sich verschiedene Linien eines Hauses oder Stammes, jüngere Kinder von älteren, uneheliche von den ehelichen unterscheiden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "53b2864d-e427-3ad6-af45-edbbf225ac52",
                        "entry_id": "edf51e39-dc86-365c-bf76-231b80bcc1b1",
                        "glosses": [
                            "zusätzliches Zeichen bei einer Münze, das das Ausgabejahr oder den Ausgabeort zeigt"
                        ],
                        "tags": [
                            "Numismatik"
                        ],
                        "examples": [
                            {
                                "example_id": "d77da918-4354-40f8-b232-8e58ee0259a5",
                                "sense_id": "53b2864d-e427-3ad6-af45-edbbf225ac52",
                                "text": "Auf den braunschweigischen Münzen war jedes Jahr der Löwe zu sehen, aber so fügte man doch ein Beizeichen (Biemark) hinzu, welches jährlich verändert wurde."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "835e8cbe-7d36-3ae5-9ebd-543525b1e6a9",
                        "entry_id": "edf51e39-dc86-365c-bf76-231b80bcc1b1",
                        "glosses": [
                            "zusätzliches Zeichen bei einer Fährte, das eine Identifizierung der Wildart möglich macht"
                        ],
                        "tags": [
                            "Jägersprache"
                        ],
                        "examples": [
                            {
                                "example_id": "1c104229-8394-4647-a9ca-e8cfd831b7ea",
                                "sense_id": "835e8cbe-7d36-3ae5-9ebd-543525b1e6a9",
                                "text": "„Mehrere andere Zeichen, welche mit der Fährte nichts gemein haben, aber oft viel dazu beitragen, alle Zweifel zu beseitigen, nennt man Beizeichen.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
