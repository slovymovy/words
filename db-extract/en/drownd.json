                        ],
                        "examples": [
                            {
                                "example_id": "1861f4ab-2b4d-49df-ba85-afea9019e899",
                                "sense_id": "fbb2eb2a-e4f4-3c6f-a67f-398fff84daab",
                                "text": "By which the little brookes forsooke their boundes,\nAnd water all the passages so drownds […]"
                            },
                            {
                                "example_id": "8b3146ae-4845-4ac3-898e-fabf79069d41",
                                "sense_id": "fbb2eb2a-e4f4-3c6f-a67f-398fff84daab",
                                "text": "\"I know now!\" exclaimed Tom; \"somebody's drownded!\""
                            },
                            {
                                "example_id": "9c3a7e90-827d-448b-ac2b-b64aa525be2c",
                                "sense_id": "fbb2eb2a-e4f4-3c6f-a67f-398fff84daab",
                                "text": "\"Next time yous come along we'll have had a drop o' rain, an' then you can drownd yourselfs if you want to,\" said the stationmaster."
                            }
                        ]
                    }
                ],
