            {
                "entry_id": "4ea5f966-5085-31c5-a33b-9cfdbb6e5eea",
                "word": "gladiateur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9fdf3835-95c6-414e-8666-98ac826187cc",
                        "entry_id": "4ea5f966-5085-31c5-a33b-9cfdbb6e5eea",
                        "tags": [
