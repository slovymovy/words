                "senses": [
                    {
                        "sense_id": "e80ee816-0243-3626-baac-5d1adc4b30bd",
                        "entry_id": "1749d7ff-daad-3af0-834f-10be5bb6f5a5",
                        "glosses": [
                            "osoba zajmująca się geografią lub ucząca geografii"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae1b1b9b-3f56-488d-9be8-d1885a6edb08",
                                "sense_id": "e80ee816-0243-3626-baac-5d1adc4b30bd",
                                "text": "Był on pierwszym geografem, który opisał Indie."
                            },
                            {
                                "example_id": "3dd1a6a0-d608-4c87-a1e5-d61374b0d444",
                                "sense_id": "e80ee816-0243-3626-baac-5d1adc4b30bd",
                                "text": "Jedziemy na wycieczkę w Góry Stołowe z naszym geografem."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d4bc026f-d13c-4786-ba34-97c22d5d6f28",
                        "source_entry_id": "1749d7ff-daad-3af0-834f-10be5bb6f5a5",
                        "source_sense_id": "e80ee816-0243-3626-baac-5d1adc4b30bd",
                        "target_lang_word": "geographer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "geographer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e37881f6-c25d-3dba-a3b8-4d8423618436",
                                        "entry_id": "e16c2727-4b2e-3316-97b1-d428964bb516",
                                        "glosses": [
                                            "A specialist in geography."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acffbc0f-fd24-4086-9b0c-ea82b3e6ea1d",
                                                "sense_id": "e37881f6-c25d-3dba-a3b8-4d8423618436",
                                                "text": "Alternatively, geographers Simon Lewis and Mark Maslin have suggested that 1610 might be a better candidate for a crucial human-induced step change."
                                            },
                                            {
                                                "example_id": "7dff09be-6995-4a3a-8343-ce27332df943",
                                                "sense_id": "e37881f6-c25d-3dba-a3b8-4d8423618436",
                                                "text": "Some experts, such as geographer Jared Diamond in his 2005 book, “Collapse,” used Easter Island as a cautionary tale of how the exploitation of limited resources can result in catastrophic population decline, ecological devastation and the destruction of a society through infighting."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d25cf79c-412e-4871-8650-1f2cc89787ba",
                        "source_entry_id": "1749d7ff-daad-3af0-834f-10be5bb6f5a5",
                        "source_sense_id": "e80ee816-0243-3626-baac-5d1adc4b30bd",
                        "target_lang_word": "zeměpisec",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zeměpisec",
