                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "1518266c-836c-4afd-8095-2bb6956273ef",
                                "sense_id": "cf0e7560-c41a-3ce6-ae1b-d2c0cd7ebf1d",
                                "text": "An intelligent costermonger, who was with me when I saw the two brothers, told me that “a costermonger would rather be thought to have come out of prison than out of a workhouse,” for his “mates” would say, if they heard he had been locked up, “O, he’s only been quodded for pitching into a crusher.”"
                            }
                        ]
                    }
