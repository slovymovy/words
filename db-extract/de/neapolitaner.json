                    {
                        "sense_id": "9f050ae0-fa4c-32f1-b2e5-5ce81eaccb36",
                        "entry_id": "e49ae83f-4a80-3e2f-beeb-5a36271dc0da",
                        "glosses": [
                            "Einwohner der italienischen Stadt Neapel, aus Neapel stammende Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4581bc2a-72de-43a8-b53e-46131307ac7e",
                                "sense_id": "9f050ae0-fa4c-32f1-b2e5-5ce81eaccb36",
                                "text": "Die Neapolitanerin und der Neapolitaner lernten sich in Grönland kennen."
                            },
                            {
                                "example_id": "87a8d556-45bf-4af6-8ff7-f147df6e7724",
                                "sense_id": "9f050ae0-fa4c-32f1-b2e5-5ce81eaccb36",
                                "text": "„So etwas bekommen die Neapolitaner nicht alle Tage zu sehen. Auf dem Marktplatz vollstreckt der Henker das Todesurteil am König.“"
                            },
                            {
                                "example_id": "5d9b5657-fb21-47f5-8eba-2ea47ccb960f",
                                "sense_id": "9f050ae0-fa4c-32f1-b2e5-5ce81eaccb36",
                                "text": "„Der Gärtner war ein Neapolitaner und seit dreißig Jahren sein Sklave.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
