                "senses": [
                    {
                        "sense_id": "35f2fa43-eee3-338b-8744-7523c47776f4",
                        "entry_id": "a43ee6b8-2ab7-395e-b1b5-b741d2bc53b1",
                        "glosses": [
                            "Pièce d’armure qui protège les épaules."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1779e374-13ce-44dc-8163-1d01f64e8de0",
                                "sense_id": "35f2fa43-eee3-338b-8744-7523c47776f4",
                                "text": "Le soldat de base, le piquier par exemple, s’équipait en général, si l’on en croit les recommandations de Montluc et les commandes d’armes reçues par les armuriers parisiens, d’un casque (morion), d’un gorgerin, d’une cuirasse, de brassards, de cubitières, de spallières, de canons d'avant-bras et de gantelets ; quelquefois, des tassettes couvraient ses jambes."
                            },
                            {
                                "example_id": "792b7264-5221-41b6-b97e-95b94f375c11",
                                "sense_id": "35f2fa43-eee3-338b-8744-7523c47776f4",
                                "text": "Cependant, sous Louis XIV, on représentait encore bien des seigneurs en corps de cuirasse et avec bras armé de canon, spallières et cubitières."
                            }
                        ]
                    }
                ],
