                    {
                        "translation_id": "79dee04a-3b6f-4da2-b60b-91bbd76d761d",
                        "source_entry_id": "24598bf8-a693-3da9-af90-0877867bc26e",
                        "source_sense_id": "bec32202-f59a-3f3a-85fe-cb5597640a3b",
                        "source_sense_description": "jüdische Religion; zumeist im Plural: Anhänger des Chassidismus",
