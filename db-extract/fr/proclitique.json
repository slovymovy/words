                "forms": [
                    {
                        "form_id": "9cfb8e2c-10ac-4a82-a613-c58eebba456e",
                        "entry_id": "8c0b02ec-130b-3e8f-9ebe-45450047ba79",
                        "tags": [
                            "plural"
                        ],
                        "form": "proclitiques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bb309420-9fe5-31bc-9147-c9c6b17ad368",
                        "entry_id": "8c0b02ec-130b-3e8f-9ebe-45450047ba79",
                        "glosses": [
                            "Clitique phonétiquement attaché au mot suivant. En français, le pronom je dans je vous le donne et l’article dans le livre sont des proclitiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70648466-ac57-48c6-8607-4016e7ede4a0",
                                "sense_id": "bb309420-9fe5-31bc-9147-c9c6b17ad368",
                                "text": "Les proclitiques donnent leur accent au mot suivant."
                            },
                            {
                                "example_id": "9cc74088-7257-40d0-9e4f-b0aba4b3b39a",
                                "sense_id": "bb309420-9fe5-31bc-9147-c9c6b17ad368",
                                "text": "Le proclitique est un mot qui s’appuie sur le mot suivant et en fait, pour la prononciation, réellement partie."
                            },
                            {
                                "example_id": "656ea025-59ad-4a93-8f84-7d7cb8753726",
                                "sense_id": "bb309420-9fe5-31bc-9147-c9c6b17ad368",
                                "text": "La prononciation actuelle de Monsieur tient au fait que ce mot s’emploie le plus souvent comme proclitique (c’est-à-dire comme un mot qui, s’appuyant sur le mot suivant avec lequel il forme une unité phonétique, est dépourvu d’accent tonique) devant un nom propre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2b8a8c48-a6fd-4c2a-b0c1-aedcc2f3ddee",
                        "source_entry_id": "8c0b02ec-130b-3e8f-9ebe-45450047ba79",
                        "source_sense_id": "bb309420-9fe5-31bc-9147-c9c6b17ad368",
                        "target_lang_word": "Proklitikon",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Proklitikon",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f43641d2-4106-3962-955f-b2b7157f353c",
                                        "entry_id": "26e63ef4-b4d1-3c0d-9b47-9edb2e2d1dfb",
                                        "glosses": [
                                            "Wörter oder Wortteile, die am Anfang eines anderen Wortes angefügt werden, dabei oft einen Teil ihrer Lautsubstanz verlieren und unbetont sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b8295a5-cdbf-4a83-be82-7f9555e3ea95",
                                                "sense_id": "f43641d2-4106-3962-955f-b2b7157f353c",
                                                "text": "Proklitika bilden zusammen mit dem Wort, an das sie angefügt sind, ein phonetisches Wort."
                                            },
                                            {
                                                "example_id": "49e1d1ea-8096-41b0-978c-5277b62d4686",
                                                "sense_id": "f43641d2-4106-3962-955f-b2b7157f353c",
                                                "text": "Der Vorgang, der zu einem Proklitikon führt, heißt Proklise."
                                            },
                                            {
                                                "example_id": "99119cdc-f7ae-4b4b-bfef-40e79f33b41f",
                                                "sense_id": "f43641d2-4106-3962-955f-b2b7157f353c",
                                                "text": "„Eine weitere Auswertung der Position der Betonung bezogen auf Wortformen (phonologisches Wort unter Einschluss von Pro- und Enklitika) zeigt, dass bei ungerader Silbenanzahl eines Wortes genau die in der Mitte liegende Silbe die Betonung trägt, während bei gerader Silbenanzahl eine der zwei mittleren Silben eine Betonung (…) auf sich nimmt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3411b92d-c9e4-43ea-8d75-f1f38eb6c067",
                        "source_entry_id": "8c0b02ec-130b-3e8f-9ebe-45450047ba79",
