                            {
                                "example_id": "1d09f577-8f5d-4ad0-ae0f-101b2ad36c23",
                                "sense_id": "6bdf264e-7cf5-3fd5-96db-0bbe1cc23dfc",
                                "text": "Pflegebedürftigkeit betrifft vor allem Ältere sowie körperlich und geistig Behinderte."
                            },
                            {
                                "example_id": "6b7cefa2-38bd-4174-a5ff-19e95dd16f6d",
                                "sense_id": "6bdf264e-7cf5-3fd5-96db-0bbe1cc23dfc",
                                "text": "Pflegebedürftigkeit kann eine Belastung (für den Betroffenen als auch die Angehörigen) sein."
                            },
                            {
                                "example_id": "612ed2c4-1d27-416b-aca3-e8cb52bb09ee",
                                "sense_id": "6bdf264e-7cf5-3fd5-96db-0bbe1cc23dfc",
                                "text": "„Das Alter ist eine Rückkehr zur Kindheit, bedenklich ist nur, dass man statt kindlich kindisch wird und der Pflegebedürftigkeit zuwächst, statt dass man ihr entwächst.“"
