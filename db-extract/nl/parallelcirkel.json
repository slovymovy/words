                        "entry_id": "e1dd35a6-a8e6-378f-a40d-6333b1358646",
                        "glosses": [
                            "een cirkel op het aardoppervlak, waarop alle punten met gelijke geografische breedte (noord of zuid) liggen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c500c30-7335-4c6a-aa6e-7f1c21c8b710",
                                "sense_id": "f11f72e2-db41-3b26-95ea-7fcfaafde939",
                                "text": "De Steenbokskeerkring is een bekende parallelcirkel op het zuidelijk halfrond."
                            }
                        ]
                    }
