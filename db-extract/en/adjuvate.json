                    {
                        "translation_id": "f8b004af-8e29-4b85-b9e7-f1e6120c9e08",
                        "source_entry_id": "71054774-2753-3b82-add9-4246af85aa6d",
                        "source_sense_id": "8cf247a8-aa40-3d7f-a484-c89e35e1afcc",
                        "source_sense_description": "veraltet: unterstützen, helfen",
                        "target_lang_word": "unterstützen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unterstützen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d679825f-f0f4-3824-9562-2dc92883e7c4",
                                        "entry_id": "e051a6fe-fe22-3f02-965b-221258bd290e",
                                        "glosses": [
                                            "jemandem bei etwas helfen, entweder durch tatkräftige Hilfe oder auch durch einen finanziellen Beitrag"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52e84cae-c019-4d6b-846e-62dd5c4a5e6f",
                                                "sense_id": "d679825f-f0f4-3824-9562-2dc92883e7c4",
                                                "text": "Sie unterstützten die Widerstandskämpfer bei ihrem Aufstand."
                                            },
                                            {
                                                "example_id": "1f5b18d0-6a42-4cff-80b6-e3cea2329dbf",
                                                "sense_id": "d679825f-f0f4-3824-9562-2dc92883e7c4",
                                                "text": "„Klöster und Private unterstützten den bettelnden Landstreicher.“"
                                            },
                                            {
                                                "example_id": "41e40abd-754f-4f5c-a290-ce579719e187",
                                                "sense_id": "d679825f-f0f4-3824-9562-2dc92883e7c4",
                                                "text": "„Bei der Präsidentenwahl in der Ukraine 2004 unterstützte Russland massiv den prorussischen Kandidaten Viktor Janukowitsch.“"
                                            },
                                            {
                                                "example_id": "0f1fb241-5f4a-4edb-bc26-1fc1d1ad3334",
                                                "sense_id": "d679825f-f0f4-3824-9562-2dc92883e7c4",
                                                "text": "[Russlands Krieg gegen die Ukraine 2022-…:] „Deutschland unterstützt die Ukraine seit Beginn der russischen Invasion mit Waffen, Hilfsgütern und eigenem Know-how.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "47f1336e-9861-3ec0-a8ef-179564d02272",
                                        "entry_id": "e051a6fe-fe22-3f02-965b-221258bd290e",
                                        "glosses": [
                                            "etwas gutheißen, dafür sein und es gut finden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f23e739f-e28e-4ac5-a966-3005f59a9838",
                                                "sense_id": "47f1336e-9861-3ec0-a8ef-179564d02272",
                                                "text": "Ich unterstütze dieses Vorhaben."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "44389018-a695-345b-b689-4f98d4406a93",
                                        "entry_id": "e051a6fe-fe22-3f02-965b-221258bd290e",
                                        "glosses": [
                                            "kompatibel sein"
                                        ],
                                        "tags": [
                                            "EDV"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39db832c-fc4a-4236-89d3-f3ce6ba79ae7",
                                                "sense_id": "44389018-a695-345b-b689-4f98d4406a93",
                                                "text": "Diese Software wird von ihrem Betriebssystem nicht unterstützt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "unterstützen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "44c1df61-4e4e-3f81-9803-c1d238075044",
                                        "entry_id": "1644a102-c262-327e-97c1-8ca97fd0a4f9",
                                        "glosses": [
                                            "haltend, stützend von der unteren Seite her platzieren, eine Stütze unter etwas setzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b96f8f8-b01f-4599-b40e-1ad36342d771",
                                                "sense_id": "44c1df61-4e4e-3f81-9803-c1d238075044",
                                                "text": "„Ein kleines Männchen, das sein Rohr mit einem goldenen Kopfe bedachtsam seinem Kinne untergestützt hatte, kam jetzt gravitätisch anspaziert.“ (1795)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fa40a410-c7ec-41aa-a636-b971acaf3d4d",
                        "source_entry_id": "71054774-2753-3b82-add9-4246af85aa6d",
                        "source_sense_id": "8cf247a8-aa40-3d7f-a484-c89e35e1afcc",
                        "source_sense_description": "veraltet: unterstützen, helfen",
                        "target_lang_word": "helfen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "helfen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "13b89032-aae3-346f-aec1-4c8fc2c26159",
                                        "entry_id": "a035ab47-63be-3033-85ac-ebbc9bd91462",
                                        "glosses": [
                                            "(mit Dativ, seltener mit Akkusativ) jemandem das Tun einer Sache durch Übernehmen bestimmter Teile oder einen Ratschlag ermöglichen oder erleichtern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af941519-a1d3-42fb-9434-b402332bc121",
                                                "sense_id": "13b89032-aae3-346f-aec1-4c8fc2c26159",
                                                "text": "Lass mich dir helfen, dann geht es schneller."
                                            },
                                            {
                                                "example_id": "e53bdeb1-3014-4a16-b897-c0f944e99fe5",
                                                "sense_id": "13b89032-aae3-346f-aec1-4c8fc2c26159",
                                                "text": "„Was hülfe es dem Menschen, so er die ganze Welt gewönne und nähme Schaden an seiner Seele?“"
                                            },
                                            {
                                                "example_id": "4401d53a-f535-4572-98a0-ee5ca3b4aff0",
                                                "sense_id": "13b89032-aae3-346f-aec1-4c8fc2c26159",
                                                "text": "„Der Rabe Ralf, dem niemand half, half sich allein.“"
                                            },
                                            {
                                                "example_id": "fa9c6d38-538d-40de-83bd-d81dd1c38606",
                                                "sense_id": "13b89032-aae3-346f-aec1-4c8fc2c26159",
                                                "text": "Dumm kann der Mensch sein, er muss sich nur zu helfen wissen."
                                            },
                                            {
                                                "example_id": "12fcee34-a84f-4fbc-8fbf-2d0efa0a360a",
                                                "sense_id": "13b89032-aae3-346f-aec1-4c8fc2c26159",
                                                "text": "„Zwei Schimpansen, die einander nie gesehen, nie mit einander gekämpft und einander nie die Läuse aus dem Pelz gesucht haben, wissen nicht, ob sie einander über den Weg trauen können, ob es sich lohnt, dem anderen zu helfen, oder welcher der beiden in der Rangordnung über dem anderen steht.“"
                                            },
                                            {
                                                "example_id": "f3b8e8ab-c86e-4342-b32c-b4c50b347b24",
                                                "sense_id": "13b89032-aae3-346f-aec1-4c8fc2c26159",
                                                "text": "„Ein Russe ist, wer eine Datscha hat. Kleine Obst- und Gemüsegärten außerhalb der Großstädte haben schon immer den Menschen von Kaliningrad bis Wladiwostok geholfen, Lebensmittelkrisen und andere schlechte Zeiten durchzustehen.“"
                                            },
                                            {
                                                "example_id": "69c9efb6-e524-4d6f-a565-3a22cd5ae350",
                                                "sense_id": "13b89032-aae3-346f-aec1-4c8fc2c26159",
                                                "text": "Bakterien helfen uns in unserem Darm beim Verdauen."
                                            },
                                            {
                                                "example_id": "1b514753-5a5c-450c-850a-915cbf1a7026",
                                                "sense_id": "13b89032-aae3-346f-aec1-4c8fc2c26159",
                                                "text": "„Norwegen will der Ukraine mit umgerechnet fast einer Milliarde Euro helfen.“"
                                            },
                                            {
                                                "example_id": "a6f219eb-33e6-4461-bb5e-a35f1c8df2a4",
                                                "sense_id": "13b89032-aae3-346f-aec1-4c8fc2c26159",
                                                "text": "„In der Kirche hat der Papſt den Herzog Bugslav über des Kaiſers und aller Fürſten Abgeordnete sitzen laſſen, und hat ihn helfen müſſen zur Meſſe dienen und dem Papſt das Waſſer zur Ablution ſchenken.“."
                                            },
                                            {
                                                "example_id": "38de1df5-e791-4e15-a4b2-d5f7e54aba59",
                                                "sense_id": "13b89032-aae3-346f-aec1-4c8fc2c26159",
                                                "text": "„Es iſt ein hübſcher artiger Menſch, und recht gut, denn er hat einem Baurenbuben helfen die Schafe ſuchen, und hat ihn von Schlägen gerettet.“"
                                            },
                                            {
                                                "example_id": "bf4bb88d-ccf8-42b6-9ab5-ef76c2965236",
                                                "sense_id": "13b89032-aae3-346f-aec1-4c8fc2c26159",
                                                "text": "„»[…] Man hat schon vor zweitausend Jahren diese Geschichte erzählt: Der Mann, der verprügelt im Straßengraben liegt und alle gehen vorbei. Jeder hat gute Gründe, warum er nicht hilft.«“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bc6c0e6c-9dcb-3187-85af-b06538b73212",
                                        "entry_id": "a035ab47-63be-3033-85ac-ebbc9bd91462",
                                        "glosses": [
                                            "wirken, wirksam sein"
                                        ],
                                        "tags": [
                                            "von Medizin und Magie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3311597-ba8d-4493-bfd4-a1b4079367dd",
                                                "sense_id": "bc6c0e6c-9dcb-3187-85af-b06538b73212",
                                                "text": "Ein Kamillendampfbad hilft bei Erkältung."
                                            },
                                            {
                                                "example_id": "017071cc-a42a-4715-8e3e-cb9848be12c6",
                                                "sense_id": "bc6c0e6c-9dcb-3187-85af-b06538b73212",
                                                "text": "Nimm Fixauxilin, das hilft sofort!"
                                            },
                                            {
                                                "example_id": "277ccf61-5539-4a90-afc9-e8bb908ebe90",
                                                "sense_id": "bc6c0e6c-9dcb-3187-85af-b06538b73212",
                                                "text": "„In alten Zeiten, als das Wünschen noch geholfen hat …“ – (Anfang mehrerer Märchen der Brüder Grimm)"
                                            },
                                            {
                                                "example_id": "44d3d8a8-4676-42bf-900a-878082a59817",
                                                "sense_id": "bc6c0e6c-9dcb-3187-85af-b06538b73212",
                                                "text": "Gegen die Klimakatastrophe hilft nur, den CO₂-Ausstoß so schnell wie möglich zu senken."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
