                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4d349de2-e4bb-4b93-bfc3-9ce3f24af43f",
                        "source_entry_id": "2237b3f9-ee13-3f2c-99bb-696a23029161",
                        "source_sense_id": "329d1626-a72e-33d8-88a7-89ed3c3cbc7a",
                        "target_lang_word": "Haydn",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Haydn",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2e3937e1-2b8e-3f9c-abab-225697ebdf28",
                                        "entry_id": "9793df57-0521-380e-bf86-0cc946ff2a35",
                                        "glosses": [
                                            "A surname from German; (music) used specifically of Franz Joseph Haydn (1732–1809), an Austrian composer of the Classical period."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bcd64104-a90f-4d15-920c-0f4b773c4e46",
                                                "sense_id": "2e3937e1-2b8e-3f9c-abab-225697ebdf28",
                                                "text": "Two years ago I rashly accepted a commission from Tring Chamber Music and Paul Barritt, leader of the Hallé orchestra, to write poems to read between movements of Haydn's quartet Opus 51, which meditates on Christ's \"Seven Last Words\". Haydn, commissioned in 1785 by Cádiz cathedral, wrote this music to go between words so it's hard to perform and listen to without some."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5422bb22-8e45-48c9-b5eb-70accfc6e995",
                        "source_entry_id": "2237b3f9-ee13-3f2c-99bb-696a23029161",
                        "source_sense_id": "329d1626-a72e-33d8-88a7-89ed3c3cbc7a",
                        "target_lang_word": "Haydn",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Haydn",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4f6aa952-162a-374e-827f-ceb845eb67c0",
                                        "entry_id": "d2a1b2f7-aaf3-32ef-acdf-b911d8f0694d",
                                        "glosses": [
                                            "deutscher Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28e33e35-67d5-4a71-877e-9a331b4d8ff7",
                                                "sense_id": "4f6aa952-162a-374e-827f-ceb845eb67c0",
                                                "text": "Haydns kamen, sahen und siegten."
                                            },
                                            {
                                                "example_id": "d4b13c2f-95e7-43a8-b456-6e7fa8260bea",
                                                "sense_id": "4f6aa952-162a-374e-827f-ceb845eb67c0",
                                                "text": "Frau Haydn ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "ebe73f95-2c1e-47f2-8629-4cd54a348106",
                                                "sense_id": "4f6aa952-162a-374e-827f-ceb845eb67c0",
                                                "text": "Herr Haydn wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "2eb0a4a9-d2fa-4c09-9424-8ea49e947e5b",
                                                "sense_id": "4f6aa952-162a-374e-827f-ceb845eb67c0",
                                                "text": "Die Haydns fliegen heute nach La Paz."
                                            },
                                            {
                                                "example_id": "c92347d3-fdc7-4908-99d0-73642223efc0",
                                                "sense_id": "4f6aa952-162a-374e-827f-ceb845eb67c0",
                                                "text": "Der Haydn trägt nie die Schals, die die Haydn ihm strickt."
                                            },
                                            {
                                                "example_id": "6826db41-9f7c-4b84-a209-ce9da6410ec5",
                                                "sense_id": "4f6aa952-162a-374e-827f-ceb845eb67c0",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Haydn kommt, geht der Herr Haydn.“"
                                            },
                                            {
                                                "example_id": "0c0c16a4-c378-4a08-8757-edaba0f06f7e",
                                                "sense_id": "4f6aa952-162a-374e-827f-ceb845eb67c0",
                                                "text": "Haydn kommt und geht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
