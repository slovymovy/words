                                    },
                                    {
                                        "sense_id": "ea13fd73-508e-3e37-a529-fb164991e20b",
                                        "entry_id": "cf5cd882-845d-3256-8bbf-905ceb5a8d24",
                                        "glosses": [
                                            "A movement or organisation of people who resist political convention."
                                        ],
                                        "tags": [
                                            "with-definite-article"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3c1c156-019e-41c3-bc04-6d43526e08ce",
                                                "sense_id": "ea13fd73-508e-3e37-a529-fb164991e20b",
                                                "text": "the French underground during World War II"
                                            },
                                            {
                                                "example_id": "58406fdf-6160-409b-aa18-8872689d29fe",
                                                "sense_id": "ea13fd73-508e-3e37-a529-fb164991e20b",
                                                "text": "Victor, please, don't go to the underground meeting tonight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a29540fd-cf98-3054-abb5-290762baf4b7",
