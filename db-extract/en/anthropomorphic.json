                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anthropomorphe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c038ea17-b0d8-394f-bdb5-156b6b44fb50",
                                        "entry_id": "d36c704b-5310-3077-971c-8be81e91c50a",
                                        "glosses": [
                                            "À forme humaine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96a1eb95-a38d-46ce-b93b-42369a0bea7d",
                                                "sense_id": "c038ea17-b0d8-394f-bdb5-156b6b44fb50",
                                                "text": "En bas à gauche : plaquette de calcaire à silhouette anthropomorphe."
                                            },
                                            {
                                                "example_id": "02556e44-82fd-474c-99e2-8496fe47642a",
                                                "sense_id": "c038ea17-b0d8-394f-bdb5-156b6b44fb50",
                                                "text": "Ces pichets à forme humaine, que les érudits qualifient d’anthropomorphes, en font partie."
                                            },
                                            {
                                                "example_id": "11ca6129-be22-4edd-b88b-b32997d571f6",
                                                "sense_id": "c038ea17-b0d8-394f-bdb5-156b6b44fb50",
                                                "text": "Un lâcher de pigeons, c’est la cohérence parfaite anthropomorphe de l’air et du temps ! De fait, Marie était devenue une aficionado (enfin da !) des lâchers de pigeons. C’est un spectacle qui dépasse, et de loin, le Cirque du Soleil !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "anthropomorphe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
