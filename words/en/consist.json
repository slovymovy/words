{
    "word_family": [
        "consistency",
        "consistent",
        "inconsistent",
        "inconsistency"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "80bef104-1264-37a6-86f4-9163c3738246",
                    "sense_definition": "To exist in agreement or be compatible with something else.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "compatibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new regulations must <w>consist</w> with the existing laws of the land.",
                            "target_lang_translations": {
                                "ru": "Новые правила должны <w>согласовываться</w> с существующими законами страны."
                            }
                        },
                        {
                            "text": "It is difficult to see how his actions <w>consist</w> with his stated principles.",
                            "target_lang_translations": {
                                "ru": "Трудно понять, как его действия <w>соответствуют</w> его заявленным принципам."
                            }
                        }
                    ],
                    "common_phrases": [
                        "consist with liberty",
                        "consist with reason"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used with 'with'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Существовать в согласии или быть совместимым с чем-либо другим."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "согласовываться",
                                "target_lang_sense_clarification": "быть в соответствии"
                            },
                            {
                                "target_lang_word": "соответствовать",
                                "target_lang_sense_clarification": "не противоречить"
                            },
                            {
                                "target_lang_word": "сочетаться",
                                "target_lang_sense_clarification": "гармонировать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "794ec0df-b104-36dd-8fb2-a8625dc94588",
                    "sense_definition": "To be composed of or to be identical to.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "existence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The district shall <w>consist</w> the counties of Tompkins and Seneca.",
                            "target_lang_translations": {
                                "ru": "Округ будет <w>состоять</w> из округов Томпкинс и Сенека."
                            }
                        },
                        {
                            "text": "True happiness does not <w>consist</w> in the mere possession of money.",
                            "target_lang_translations": {
                                "ru": "Истинное счастье не <w>заключается</w> в одном лишь обладании деньгами."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "this transitive usage is rare in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Состоять из чего-либо или быть тождественным чему-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "состоять",
                                "target_lang_sense_clarification": "быть составленным из чего-либо"
                            },
                            {
                                "target_lang_word": "заключаться",
                                "target_lang_sense_clarification": "иметь своей сутью"
                            },
                            {
                                "target_lang_word": "складываться",
                                "target_lang_sense_clarification": "образовываться из частей"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d9e7ae9a-7285-38de-930c-9de2acdf20c4",
                    "sense_definition": "A specific lineup or sequence of railroad cars that make up a train unit.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "railway_terminology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The train's <w>consist</w> included a baggage car and four passenger cars.",
                            "target_lang_translations": {
                                "ru": "<w>Состав</w> поезда включал багажный вагон и четыре пассажирских вагона."
                            }
                        },
                        {
                            "text": "The yardmaster checked the <w>railroad</w> <w>consist</w> before the locomotive departed.",
                            "target_lang_translations": {
                                "ru": "Начальник станции проверил железнодорожный <w>состав</w> перед отправлением локомотива."
                            }
                        }
                    ],
                    "synonyms": [
                        "rake",
                        "formation"
                    ],
                    "common_phrases": [
                        "railroad consist",
                        "train consist"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily North American railroad usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Определенный набор или последовательность железнодорожных вагонов, образующих единый состав поезда."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "состав",
                                "target_lang_sense_clarification": "железнодорожный поезд или группа вагонов"
                            },
                            {
                                "target_lang_word": "формирование",
                                "target_lang_sense_clarification": "структура поезда"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}