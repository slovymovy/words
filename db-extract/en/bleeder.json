                    },
                    {
                        "translation_id": "3d4320f2-9689-4958-83c6-dd372ee8aecb",
                        "source_entry_id": "10b0a856-b7e9-3e92-9c86-2c195754b3a7",
                        "source_sense_description": "person who is easily made to bleed",
                        "target_lang_word": "Bluter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bluter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e65278fc-8f29-3f90-8dcf-c29fc79eda13",
                                        "entry_id": "a5abc975-adb4-3436-9bb4-6e73ad02919b",
                                        "glosses": [
                                            "jemand, der an der Bluterkrankheit (Hämophilie) leidet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d4134a9-59df-41e9-8bb0-db2b03b8fa52",
                                                "sense_id": "e65278fc-8f29-3f90-8dcf-c29fc79eda13",
                                                "text": "„Selbst als längst bewiesen war, daß das Aids-Virus über Blut und Gerinnungspräparate übertragen wird, blieben die Verantwortlichen untätig. […] Tausende von Menschen, darunter viele Bluter, infizierten sich mit der unheilbaren Immunschwäche.“"
                                            },
                                            {
                                                "example_id": "fa265987-7bb8-4f53-a2c8-223f65b0d094",
                                                "sense_id": "e65278fc-8f29-3f90-8dcf-c29fc79eda13",
                                                "text": "„Alle anderen würden zu Blutern werden und an einer einfachen Schnittverletzung verenden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cae11031-aacb-452f-8283-8390d561f19e",
                        "source_entry_id": "10b0a856-b7e9-3e92-9c86-2c195754b3a7",
                        "source_sense_description": "person who is easily made to bleed",
