    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "5432cf75-5aa7-351e-83cf-9162af0c9a3f",
                "word": "gasbag",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "15d85a7a-b5ab-48a9-8cc9-bfb009836e83",
                        "entry_id": "5432cf75-5aa7-351e-83cf-9162af0c9a3f",
                        "tags": [
                            "plural"
                        ],
                        "form": "gasbags"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e758a655-6317-3126-81b0-10ed89d7a390",
                        "entry_id": "5432cf75-5aa7-351e-83cf-9162af0c9a3f",
                        "glosses": [
                            "A bag or bladder to hold a reservoir of gas, as in a hot-air balloon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25dc55ad-07fa-471c-b993-ab7491fe2f06",
                                "sense_id": "e758a655-6317-3126-81b0-10ed89d7a390",
                                "text": "In half an hour a good-sized gas-bag had been formed, and the jerking and straining upon the thongs showed that it was capable of considerable lift."
                            },
                            {
                                "example_id": "d397b1e8-60e6-41a9-b946-11363af00cba",
                                "sense_id": "e758a655-6317-3126-81b0-10ed89d7a390",
                                "text": "By this method of construction a considerable amount of support can be imparted to the gasbag, though it does not dispense with the services of the ballonet, as does the entirely rigid type."
                            },
                            {
                                "example_id": "da08a15d-cc62-4d31-844c-132cd9b4c5bf",
                                "sense_id": "e758a655-6317-3126-81b0-10ed89d7a390",
                                "text": "A novel robotic gasbag polishing technique based on flexible polishing principle has been presented by S.M. Ji et al., which can make polishing process more stable and effective because the rubber gasbag provides cushioning action and almost all abrasive particles in the contact area are involved in the process of material removal on mould surface, etc […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "e4df09de-9aa5-334d-a777-127c5105921b",
                        "entry_id": "5432cf75-5aa7-351e-83cf-9162af0c9a3f",
                        "glosses": [
                            "A lighter-than-air aircraft; a balloon or dirigible."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "007d25fa-828d-34ff-8f27-d94f36219456",
                        "entry_id": "5432cf75-5aa7-351e-83cf-9162af0c9a3f",
                        "glosses": [
                            "A person who is overly garrulous or prone to making empty, unsupportable statements; a windbag."
                        ],
                        "tags": [
                            "derogatory",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "b35315a4-4471-4a08-a106-22608f31d2ec",
                                "sense_id": "007d25fa-828d-34ff-8f27-d94f36219456",
                                "text": "Not that the Reverend James is absolutely a pretentious gasbag any more than Marchbanks is an inspired prophet. He has a definite, a positive part in the world's work."
                            },
                            {
                                "example_id": "639e832c-fef7-4cca-8830-c4f8293e3f6b",
                                "sense_id": "007d25fa-828d-34ff-8f27-d94f36219456",
                                "text": "You would think the fate of civilization itself rested on the outcome of my trial, based on some of those gasbags who were only too happy to speculate, postulate and pontificate about my situation."
                            },
                            {
                                "example_id": "653892dc-ca74-4cf1-9779-ec6ae7aa48b2",
                                "sense_id": "007d25fa-828d-34ff-8f27-d94f36219456",
                                "text": "Most, however, do real work, undistracted by meetings and gasbag colleagues."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
