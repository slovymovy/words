        "fr-extract.jsonl": [
            {
                "entry_id": "ce13f1a6-20ea-3e33-a20b-4bfcaf37bf76",
                "word": "acropole",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "06c962f0-3a3e-4026-9dc4-c05ec7a48bb5",
                        "entry_id": "ce13f1a6-20ea-3e33-a20b-4bfcaf37bf76",
                        "tags": [
                            "plural"
                        ],
                        "form": "acropoles"
                    },
                    {
                        "form_id": "6cc62456-e8a8-454d-bcf0-d42d7096c983",
                        "entry_id": "ce13f1a6-20ea-3e33-a20b-4bfcaf37bf76",
                        "tags": [],
                        "form": "acropolis"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "814b9d78-1576-3eba-a5d0-dbe498573845",
                        "entry_id": "ce13f1a6-20ea-3e33-a20b-4bfcaf37bf76",
                        "glosses": [
                            "Ville haute, partie de la ville située sur une éminence fortifiée par la nature et par l’art et contenant le principal temple de la cité."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "9deff668-f6e1-4365-9f7d-5b9d225ae68b",
                                "sense_id": "814b9d78-1576-3eba-a5d0-dbe498573845",
                                "text": "Une acropole était à la fois une citadelle et un sanctuaire."
                            },
                            {
                                "example_id": "f311650e-2001-42f0-8616-ee336f4d39a2",
                                "sense_id": "814b9d78-1576-3eba-a5d0-dbe498573845",
                                "text": "La plus célèbre de toutes les acropoles est celle d’Athènes."
                            },
                            {
                                "example_id": "691b7ab4-0707-47f7-8aa4-c31d307eba4e",
                                "sense_id": "814b9d78-1576-3eba-a5d0-dbe498573845",
                                "text": "L’acropole de Corinthe portait le nom particulier d’Acrocorinthe."
                            },
                            {
                                "example_id": "e3de8aec-4f41-4a39-8643-69a692090530",
                                "sense_id": "814b9d78-1576-3eba-a5d0-dbe498573845",
                                "text": "Les premiers sondages avaient révélé qu'une partie des constructions de l'acropole avaient été détruites par le feu."
                            },
                            {
                                "example_id": "b25cc633-89ba-4411-972a-8f4418a737e2",
                                "sense_id": "814b9d78-1576-3eba-a5d0-dbe498573845",
                                "text": "Mieux qu'Athenes, le pont d'un bateau en route vers les Amériques offre à l'homme moderne une acropole pour sa prière."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "03ad4640-1d08-45dd-9596-44d47d248484",
                        "source_entry_id": "ce13f1a6-20ea-3e33-a20b-4bfcaf37bf76",
                        "source_sense_id": "814b9d78-1576-3eba-a5d0-dbe498573845",
                        "target_lang_word": "Akropolis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Akropolis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6d9fbe39-16fe-3028-811e-6e9dfffffc23",
                                        "entry_id": "f4ad982a-cd42-358b-abef-d7826fb86d63",
                                        "glosses": [
                                            "eine für viele griechische Städte in der Antike typische burgähnliche Anlage, meist auf einem Hügel, oberhalb der Unterstadt gelegen"
                                        ],
                                        "tags": [
                                            "im weitesten Sinne"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ddb4ba0b-23e9-42fd-96fe-1f43a84ed49a",
                                                "sense_id": "6d9fbe39-16fe-3028-811e-6e9dfffffc23",
                                                "text": "„…zeichnet sich erst für die Mittlere Bronzezeit eine neuerliche dichte Besiedlung des attischen Landes ab. Vor allem entstehen jetzt zahlreiche befestigte Akropolen lokaler Fürsten in ausgeprägten Sicherheitslagen.“"
                                            },
                                            {
                                                "example_id": "228b8542-c861-4d29-9350-3eb3961316b5",
                                                "sense_id": "6d9fbe39-16fe-3028-811e-6e9dfffffc23",
                                                "text": "„Die Akropolis von Mykene mit ihrem Befestigungswall, dem Löwentor und dem intramuralen Rundgrab ist ein Paradebeispiel dieser Epoche […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bf647055-75a7-361c-a234-c6ddff98d874",
                                        "entry_id": "f4ad982a-cd42-358b-abef-d7826fb86d63",
                                        "glosses": [
                                            "Akropolis von Athen"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da5f006d-d53b-4cde-b0da-377c1681ce4d",
                                                "sense_id": "bf647055-75a7-361c-a234-c6ddff98d874",
                                                "text": "„Die über der Stadt [Athen] thronende Akropolis mit dem ionischen Parthenon blickt auf eine wuchernde, moderne, kosmopolitische Großstadt in neuem Wohlstand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c72ad0e0-c7bc-4d85-b6bd-0411492aa4be",
                        "source_entry_id": "ce13f1a6-20ea-3e33-a20b-4bfcaf37bf76",
                        "source_sense_id": "814b9d78-1576-3eba-a5d0-dbe498573845",
                        "target_lang_word": "acropolis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "acropolis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f54a7786-393a-3208-ae6d-22f00ee84b1e",
                                        "entry_id": "9f3de74c-cd0c-31fc-814f-ce517ef568ac",
                                        "glosses": [
                                            "A promontory (usually fortified with a citadel) forming the hub of many Grecian cities, and around which many were built for defensive purposes before and during the classical period; compare Acropolis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc76719a-8ae4-4ca8-97a9-471373fa8a2a",
                                                "sense_id": "f54a7786-393a-3208-ae6d-22f00ee84b1e",
                                                "text": "The Etruscans, then, appear in general as an industrious people ( φιλότεχνον ἔθνος), of a bold and lofty spirit of enterprise, which was greatly favoured by their priestly aristocratic constitution. Massive walls, mostly of irregular blocks, surround their cities (not merely their acropoleis); the art of protecting the country from inundations by the construction of canals, and outlets from lakes, was very zealously practised by them."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0bd65572-7092-4764-8a4d-887160d2658d",
                        "source_entry_id": "ce13f1a6-20ea-3e33-a20b-4bfcaf37bf76",
                        "source_sense_id": "814b9d78-1576-3eba-a5d0-dbe498573845",
