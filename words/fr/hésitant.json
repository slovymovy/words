        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5155c4f7-c789-3281-aa02-521e24e91dd6",
                    "sense_definition": "Participe présent de <w>hésiter</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En <w>hésitant</w> trop longtemps, vous risquez de manquer cette occasion unique de voyager.",
                            "target_lang_translations": {
                                "en": "By <w>hesitating</w> too long, you risk missing this unique opportunity to travel.",
                                "ru": "Слишком долго <w>колеблясь</w>, вы рискуете упустить эту уникальную возможность путешествовать.",
                                "de": "Indem Sie zu lange <w>zögern</w>, riskieren Sie, diese einmalige Reisemöglichkeit zu verpassen.",
                                "es": "<w>Dudando</w> demasiado tiempo, corre el riesgo de perder esta oportunidad única de viajar.",
                                "zh": "如果您<w>犹豫</w>太久，就可能错过这次难得的旅行机会。"
                            }
                        },
                        {
                            "text": "Le suspect répondait aux questions en <w>hésitant</w> sur chaque détail de son alibi.",
                            "target_lang_translations": {
                                "en": "The suspect answered the questions while <w>hesitating</w> over every detail of his alibi.",
                                "ru": "Подозреваемый отвечал на вопросы, <w>колеблясь</w> насчёт каждой детали своего алиби.",
                                "de": "Der Verdächtige beantwortete die Fragen, indem er bei jedem Detail seines Alibis <w>zögerte</w>.",
                                "es": "El sospechoso respondía a las preguntas <w>dudando</w> de cada detalle de su coartada.",
                                "zh": "嫌疑人回答问题时，对不在场证明的每个细节都<w>犹豫</w>不决。"
                            }
                        }
                    ],
                    "common_phrases": [
