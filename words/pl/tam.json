{
    "word_family": [
        "tamten",
        "tamtejszy",
        "stamtąd"
    ],
    "entries": [
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "fe084ca3-60d5-3468-a32f-245a0528451d",
                    "sense_definition": "Wskazuje miejsce oddalone od mówiącego (tam, w tamtym miejscu).",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "miejsce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Moja książka leży <w>tam</w> na stole w pokoju obok.",
                            "target_lang_translations": {
                                "ru": "Моя книга лежит <w>там</w> на столе в соседней комнате.",
                                "en": "My book is lying <w>there</w> on the table in the next room."
                            }
                        },
                        {
                            "text": "Spójrz <w>tam</w> na to wysokie drzewo w ogrodzie.",
                            "target_lang_translations": {
                                "ru": "Посмотри <w>туда</w> на то высокое дерево в саду.",
                                "en": "Look <w>there</w> at that tall tree in the garden."
                            }
                        }
                    ],
                    "antonyms": [
                        "tu",
                        "tutaj"
                    ],
                    "common_phrases": [
                        "tam na stole",
                        "tam w oddali"
                    ],
                    "target_lang_definitions": {
                        "ru": "Указывает на место, удалённое от говорящего (там, в том месте).",
                        "en": "Indicates a place distant from the speaker (there, in that place)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "там",
                                "target_lang_sense_clarification": "в том месте"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "there",
                                "target_lang_sense_clarification": "in or at that place"
                            },
                            {
                                "target_lang_word": "over there",
                                "target_lang_sense_clarification": "at a distance in a specific direction"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "312ad75d-e110-3a13-bc48-eef60b7997e2",
                    "sense_definition": "Wskazuje kierunek ruchu do tamtego miejsca (w tamtą stronę).",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "kierunek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chodźmy <w>tam</w> i zobaczmy, co się dzieje.",
                            "target_lang_translations": {
                                "ru": "Пойдём <w>туда</w> и посмотрим, что происходит.",
                                "en": "Let's go <w>there</w> and see what is happening."
                            }
                        },
                        {
                            "text": "Musimy iść <w>tam</w> przed wieczorem, żeby zdążyć na pociąg.",
                            "target_lang_translations": {
                                "ru": "Нам нужно идти <w>туда</w> до вечера, чтобы успеть на поезд.",
                                "en": "We have to go <w>there</w> before evening to catch the train."
                            }
                        }
                    ],
                    "antonyms": [
                        "tu",
                        "tutaj"
                    ],
                    "common_phrases": [
                        "iść tam",
                        "jechać tam"
                    ],
                    "target_lang_definitions": {
                        "ru": "Указывает на направление движения к тому месту (туда, в ту сторону).",
                        "en": "Indicates the direction of movement to that place (in that direction)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "туда",
                                "target_lang_sense_clarification": "в направлении того места"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "there",
                                "target_lang_sense_clarification": "to or into that place"
                            },
                            {
                                "target_lang_word": "over there",
                                "target_lang_sense_clarification": "towards that distant place"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "c8f3bae8-cacf-359b-bd1e-5456eb29cdc8",
                    "sense_definition": "W tamtym miejscu, w tamtą stronę.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "miejsce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Byłem w Warszawie i bardzo podobało mi się <w>tam</w> stare miasto.",
                            "target_lang_translations": {
                                "ru": "Я был в Варшаве, и мне очень понравилось <w>там</w> старый город.",
                                "en": "I was in Warsaw and I really liked the old town <w>there</w>."
                            }
                        },
                        {
                            "text": "Nie idź <w>tam</w>, bo droga jest teraz zamknięta.",
                            "target_lang_translations": {
                                "ru": "Не ходи <w>туда</w>, потому что дорога сейчас закрыта.",
                                "en": "Don't go <w>there</w> because the road is closed now."
                            }
                        }
                    ],
                    "antonyms": [
                        "tu",
                        "tutaj"
                    ],
                    "common_phrases": [
                        "tam i z powrotem"
                    ],
                    "target_lang_definitions": {
                        "ru": "В том месте, в ту сторону.",
                        "en": "In that place, in that direction."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "там",
                                "target_lang_sense_clarification": "в том месте"
                            },
                            {
                                "target_lang_word": "туда",
                                "target_lang_sense_clarification": "в ту сторону"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "there",
                                "target_lang_sense_clarification": "in or to that place"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "127a6869-3bd8-3dba-b1ea-40659ba263bb",
                    "sense_definition": "Partuła osłabiająca znaczenie wypowiedzi lub wskazująca na brak precyzji.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "oslabienie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kupiłem w sklepie chleb, masło i coś <w>tam</w> jeszcze do jedzenia.",
                            "target_lang_translations": {
                                "ru": "Я купил в магазине хлеб, масло и что-то <w>там</w> ещё из еды.",
                                "en": "I bought bread, butter, and <w>something or other</w> else to eat at the store."
                            }
                        },
                        {
                            "text": "On zawsze mówi jakieś <w>tam</w> bzdury, których nikt nie słucha.",
                            "target_lang_translations": {
                                "ru": "Он всегда говорит какую-то <w>там</w> ерунду, которую никто не слушает.",
                                "en": "He always talks some <w>kind of</w> nonsense that nobody listens to."
                            }
                        }
                    ],
                    "common_phrases": [
                        "coś tam",
                        "jakiś tam"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "używane w potocznej mowie"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Частица, ослабляющая значение высказывания или указывающая на неточность.",
                        "en": "A particle weakening the meaning of an utterance or indicating a lack of precision."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "там",
                                "target_lang_sense_clarification": "в сочетаниях вроде 'что-то там', 'какой-то там'"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "or something",
                                "target_lang_sense_clarification": "used to refer to an imprecise thing"
                            },
                            {
                                "target_lang_word": "some kind of",
                                "target_lang_sense_clarification": "used to dismissively refer to something vague"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5980761c-50f7-3a52-ad4b-cc56cefcc77c",
                    "sense_definition": "Partuła wyrażająca dystans, powątpiewanie lub obojętność mówiącego wobec czegoś.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dystans",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ja <w>tam</w> wolę zostać w domu, zamiast iść na tę imprezę.",
                            "target_lang_translations": {
                                "ru": "Я-<w>то</w> лучше останусь дома, вместо того чтобы идти на эту вечеринку.",
                                "en": "I <w>for one</w> prefer to stay at home instead of going to this party."
                            }
                        },
                        {
                            "text": "On <w>tam</w> wie swoje i nikogo nie będzie słuchał.",
                            "target_lang_translations": {
                                "ru": "Он-<w>то</w> знает своё и никого слушать не будет.",
                                "en": "He <w>anyway</w> knows his own mind and won't listen to anyone."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ja tam wolę"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "używane w potocznej mowie"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Частица, выражающая дистанцию, сомнение или безразличие говорящего к чему-либо.",
                        "en": "A particle expressing distance, doubt, or indifference of the speaker towards something."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "там",
                                "target_lang_sense_clarification": "выражает личное отношение, например 'я-то там'"
                            },
                            {
                                "target_lang_word": "уж",
                                "target_lang_sense_clarification": "усилительная частица"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "for one",
                                "target_lang_sense_clarification": "expressing personal preference or stance"
                            },
                            {
                                "target_lang_word": "personally",
                                "target_lang_sense_clarification": "expressing one's own attitude"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c82c9ff3-8100-3037-835c-7c02e1a23e66",
                    "sense_definition": "Forma dopełniacza liczby mnogiej rzeczownika <w>tama</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "odmiana",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W tym regionie nie ma żadnych wielkich <w>tam</w> na rzekach.",
                            "target_lang_translations": {
                                "ru": "В этом регионе нет никаких крупных <w>плотин</w> на реках.",
                                "en": "There are no large <w>dams</w> on the rivers in this region."
                            }
                        },
                        {
                            "text": "Budowa tych nowych <w>tam</w> wodnych zajmie wiele lat.",
                            "target_lang_translations": {
                                "ru": "Строительство этих новых водных <w>плотин</w> займёт много лет.",
                                "en": "The construction of these new water <w>dams</w> will take many years."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "dopełniacz liczby mnogiej"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма родительного падежа множественного числа существительного tama (плотина, дамба).",
                        "en": "Genitive plural form of the noun 'tama' (dam)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плотин",
                                "target_lang_sense_clarification": "род. падеж мн. числа от 'плотина'"
                            },
                            {
                                "target_lang_word": "дамб",
                                "target_lang_sense_clarification": "род. падеж мн. числа от 'дамба'"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "dams",
                                "target_lang_sense_clarification": "plural of dam (barrier holding back water)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}