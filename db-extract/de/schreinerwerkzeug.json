                "senses": [
                    {
                        "sense_id": "016872c0-d934-38a6-9933-9f1b96cf6635",
                        "entry_id": "5d7a4eb9-e706-32f0-a54c-5cf3dbaa213e",
                        "glosses": [
                            "Werkzeug, das der Ausübung des Schreinerberufes dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a127d2c-b669-42b0-a6c9-de94cb42caf1",
                                "sense_id": "016872c0-d934-38a6-9933-9f1b96cf6635",
                                "text": "„Er baute sie ohne jegliche technische Hilfsmittel mit seinem gewöhnlichen Schreinerwerkzeug.“"
                            },
                            {
                                "example_id": "264e901d-a50b-4b80-82a0-dae59a369fec",
                                "sense_id": "016872c0-d934-38a6-9933-9f1b96cf6635",
                                "text": "„Außer den gewöhnlichen Schreinerwerkzeugen - Säge , Hobel und Beil - mußten die Gesellen Szepter und Reichsapfel im Zuge vorantragen.“"
                            },
                            {
                                "example_id": "2f9ecc23-d70a-414a-a438-cdfeb237cff2",
                                "sense_id": "016872c0-d934-38a6-9933-9f1b96cf6635",
                                "text": "„Er stößt auf sein altes wiedergefundenes Schreinerwerkzeug. Es wurde ihm vom Meister Matthäus geschenkt, der eine Sonne aus Holz geschnitzt hat. An dieser Sonne verbrannte sich jeder, der sie ungläubig berührte.“"
                            },
                            {
                                "example_id": "8b62e1b2-a523-4b3c-be80-ee568b8f067e",
                                "sense_id": "016872c0-d934-38a6-9933-9f1b96cf6635",
                                "text": "„Das Schreinerwerkzeug wegräumen und es vorne im Bug verstauen. Das Boot fegen, ein wenig aufräumen. Dann schauen, ob ich eine Mitfahrgelegenheit zum Supermarkt bekommen konnte, um dort Essen und Bier für die Party einzukaufen.“"
                            },
                            {
                                "example_id": "3b087ea7-bdb7-4a13-a7b3-d82c677499b7",
                                "sense_id": "016872c0-d934-38a6-9933-9f1b96cf6635",
                                "text": "„[…] auch wolle er dafür sorgen, daß ich in der Zwischenzeit einige Sols verdienen könne, denn, sagte er, hier liegt ein kleines Schreinerwerkzeug, das ein durchreisender Deutscher, welcher nach Buenos-Aires ging, zurückgelassen hat.“"
                            },
                            {
                                "example_id": "6583a200-5e08-4f03-b9bb-ba1840647c62",
                                "sense_id": "016872c0-d934-38a6-9933-9f1b96cf6635",
                                "text": "„In dem Lagerhausbefand sich eine kleine Maschinenwerkstatt neben mehreren Werkbänken, auf denen Schreinerwerkzeug bereitlag.“"
                            },
                            {
                                "example_id": "2a163864-5449-4957-a447-89d127289390",
                                "sense_id": "016872c0-d934-38a6-9933-9f1b96cf6635",
                                "text": "Der Hobel ist das Schreinerwerkzeug par excellence."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
