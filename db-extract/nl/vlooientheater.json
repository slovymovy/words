                        "sense_id": "9b27d716-f106-379a-b8fb-2e190ae414b1",
                        "entry_id": "e4b3c248-3243-3ad4-b480-c40af986c3b2",
                        "glosses": [
                            "een oude kermisattractie, waar vlooien voertuigjes als kleine koetsjes trekken, draaimolens in beweging zetten, of bijvoorbeeld ballen op doel schieten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8042034-c237-43dc-94f1-5900e9634cff",
                                "sense_id": "9b27d716-f106-379a-b8fb-2e190ae414b1",
                                "text": "De ambulance met Tonio erin zette zich sprongsgewijs in beweging, met achterlating van een vlooientheater vol onafgebroken hippelende minifiguurtjes."
                            },
                            {
                                "example_id": "d072642c-54bd-4b6f-ad8f-b8a08338f8b4",
                                "sense_id": "9b27d716-f106-379a-b8fb-2e190ae414b1",
                                "text": "Hier ben ik heel boos over, ik vind het onbegrijpelijk en verstandsloos. Het enige theater dat op deze manier opengaat is het vlooientheater.”"
                            },
                            {
                                "example_id": "8f0908bf-2118-43a5-a6d9-56b43576052b",
                                "sense_id": "9b27d716-f106-379a-b8fb-2e190ae414b1",
                                "text": "Voor een Duitse circusdirecteur voltrok zich woensdag een klein drama: al zijn 300 vlooien overleden door de kou tijdens hun transport. Dat maakte de circusdirecteur van het vlooientheater Robert Birk zondag bekend. De insecten zouden dit weekend optreden tijdens een jaarmarkt in Mechernich."
                            }
                        ]
                    }
