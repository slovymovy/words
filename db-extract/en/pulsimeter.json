                        "entry_id": "aab0ca7a-ed9f-3ba1-93db-9cc3670e8da2",
                        "glosses": [
                            "Any of various devices designed to monitor someone's pulse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83a51238-a12c-49c8-88eb-05bb1e3a5847",
                                "sense_id": "8179f262-c334-34da-9b57-65a9ca578103",
                                "text": "In order not to affect users' habits of using mobiles and to avoid the electromagnetic interference effects of the pacemaker, we have designed a wristable sphygmomanometer and pulsimeter which uses bluetooth power class II [7,8] as the device for short-distance transmission."
                            },
                            {
                                "example_id": "aea45dc3-10b6-4668-8de3-0bfbbd730028",
                                "sense_id": "8179f262-c334-34da-9b57-65a9ca578103",
                                "text": "The pulsimeter consisted of a leaden bob attached to a long thread, the length of which could be adjusted gradually until the rate of oscillation of the pendulum thus formed coincided with the patient's pulse-beat."
                            }
                        ]
                    }
