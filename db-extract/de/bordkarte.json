                "senses": [
                    {
                        "sense_id": "b478d6f2-f534-30e6-b55e-8cf1660b3671",
                        "entry_id": "1fe658ca-8601-35dc-98cc-38403b5ff127",
                        "glosses": [
                            "Karte mit der Flugnummer und der Nummer des ihm zugewiesenen Sitzplatzes, die ein Fluggast beim Einchecken bekommt"
                        ],
                        "tags": [
                            "Flugwesen"
                        ],
                        "examples": [
                            {
                                "example_id": "740ef3ff-1bca-49c9-bde1-ea2a77136ab8",
                                "sense_id": "b478d6f2-f534-30e6-b55e-8cf1660b3671",
                                "text": "„In seinen Händen hält er ein Dossier in A4-Format. Statt Pass und Bordkarte legt er den Tunisair-Angestellten wortlos das Dokument hin.“"
                            },
                            {
                                "example_id": "84e15dff-9397-4dca-bd67-70e5b0901262",
                                "sense_id": "b478d6f2-f534-30e6-b55e-8cf1660b3671",
                                "text": "„Auf diese Weise können Reisende noch bequem von zu Hause ihre Bordkarte für Hin- und Rückflug herunterladen, denn unterwegs ist ein Internet-Zugriff oft nicht oder nur eingeschränkt möglich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
