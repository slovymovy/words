                ],
                "senses": [
                    {
                        "sense_id": "cfc335c7-a70d-33d9-b818-64c2986eafb9",
                        "entry_id": "2fa3d151-6635-3520-8637-6c4cc9bcf3e6",
                        "glosses": [
                            "рег. хорошо отточенный, острый"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7554abe-826e-45b9-8453-24a1c3d0a205",
                                "sense_id": "cfc335c7-a70d-33d9-b818-64c2986eafb9",
                                "text": "В руках сабля вострая, золотая, царский подарок."
                            }
                        ]
                    },
                    {
                        "sense_id": "abdf0cd5-036f-32c8-9d17-0330f1bb7b75",
                        "entry_id": "2fa3d151-6635-3520-8637-6c4cc9bcf3e6",
                        "glosses": [
                            "рег. суживающийся к концу, имеющий заострённую форму"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a8dc0e7-2d5a-4443-a1d7-d2eb4f4bf91c",
                                "sense_id": "abdf0cd5-036f-32c8-9d17-0330f1bb7b75",
                                "text": "Посреди рабочих торчит если не подрядчик, по крайней мере колоновожатый Алексей с вострым носом и физиономией коростеля."
                            }
                        ]
                    },
                    {
                        "sense_id": "17e621b6-1929-389e-8df1-0c7b2134d6f9",
                        "entry_id": "2fa3d151-6635-3520-8637-6c4cc9bcf3e6",
                        "glosses": [
                            "перен. проницательный, живой (о взгляде, взоре)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39bddfa1-b077-4fbc-841f-2fe0e6d2019e",
                                "sense_id": "17e621b6-1929-389e-8df1-0c7b2134d6f9",
                                "text": "Наутро ― под окном казанский «князь», в ватной шапке горшком, лопоухий, глаза вострые ― как сквозь замочную скважину. ― Купи, барина, шали шёлковые хороши ― купи, кавалер любить будет. Ай, хороши! ― причмокнет, подкинет шаль на руке, ― и ухмыляется, будто сквозь замочную скважину всё подглядел, всё знает."
                            },
                            {
                                "example_id": "faf65e6b-99d3-4d41-b533-4d53291dad6a",
                                "sense_id": "17e621b6-1929-389e-8df1-0c7b2134d6f9",
                                "text": "Молчим. Главный вострый ― щуп, щуп меня глазами, как никогда людей не видавши."
                            }
                        ]
                    }
                ],
