                        "glosses": [
                            "Déchet de soie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "295f7e64-6de0-4649-9ba5-c6be4930b3ba",
                                "sense_id": "11b0adb1-a2a8-39a1-8f2a-0d0040ec08af",
                                "text": "Quand les cocons sont trop vieux … ils cassent continuellement et ils font un déchet considérable ; le frison alors est énorme, ainsi que ce qu'on appelle bassinat (ou résidu de la bassine) ; enfin le rendement en soie est presque nul."
                            },
                            {
                                "example_id": "e7ecb2d3-407e-432c-ad53-bccf50ea7e68",
                                "sense_id": "11b0adb1-a2a8-39a1-8f2a-0d0040ec08af",
                                "text": "Ce sont les pointus ou vitrės. Ils produisent un déchet appelé vulgairement, dans le Midi, bassinat (plongé dans la bassine)."
                            }
                        ]
                    }
