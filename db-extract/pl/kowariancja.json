                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ковариация",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "fe93d3d8-0842-3507-b760-a06a375a29e4",
                                        "entry_id": "ca4dc0e4-a64b-3c9b-bfea-54da3b68af50",
                                        "glosses": [
                                            "матем. взаимозависимое совместное изменение двух и более признаков"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ed853d3-ddda-4bc3-b168-320d7babf728",
                                                "sense_id": "fe93d3d8-0842-3507-b760-a06a375a29e4",
                                                "text": "Ковариация массивов, в частности, означает, что элемент массива с типом элемента B может фактически являться элементом массива с типом элемента A."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
