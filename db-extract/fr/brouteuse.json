                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89ba5834-e7b7-47d9-80cb-4133a0c1f277",
                                "sense_id": "efdfb99e-59a5-336d-8e99-8826612bad4a",
                                "text": "Ah, cette licorne, brouteuse d’étoiles et de rayons de lune, jamais les chasseurs ne pourraient l’abattre !"
                            }
