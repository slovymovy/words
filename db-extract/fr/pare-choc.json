                "senses": [
                    {
                        "sense_id": "512c2c93-17d1-3cc7-9d38-5d9efc913db7",
                        "entry_id": "fa73d129-6270-35fe-b085-20cc26f3e525",
                        "glosses": [
                            "Élément de la carrosserie permettant d'atténuer les chocs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6fbe703-e5ee-4a4d-9d7c-e909538584aa",
                                "sense_id": "512c2c93-17d1-3cc7-9d38-5d9efc913db7",
                                "text": "Une autre fois encore, tard, en revenant du cinéma, distrait, je butai devant le Planzpalace dans le pare-choc d'une voiture où s'était entassée toute une famille de Ripalous."
                            },
                            {
                                "example_id": "24e90b2a-3467-46fa-8f9e-2f6874dfcee2",
                                "sense_id": "512c2c93-17d1-3cc7-9d38-5d9efc913db7",
                                "text": "Les gros camions ont des pare-chocs imposants, comme s'ils s'attendaient au pire."
                            },
                            {
                                "example_id": "cab8a1b8-74e7-466a-9941-51ee37f68556",
                                "sense_id": "512c2c93-17d1-3cc7-9d38-5d9efc913db7",
                                "text": "Alvaro redémarra aussi sec faisant fumer le caoutchouc en un copieux « burn » façon dragster, la Volvo resta collée au pare-choc."
                            }
                        ]
                    },
                    {
                        "sense_id": "fd33403a-bec4-30e8-8cc5-2c130a61fbe6",
                        "entry_id": "fa73d129-6270-35fe-b085-20cc26f3e525",
                        "glosses": [
                            "Poitrine d’une femme, surtout si elle a de gros seins."
                        ],
                        "tags": [
                            "familiar",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "673c13da-cf0b-4744-879a-541b8c32753d",
                                "sense_id": "fd33403a-bec4-30e8-8cc5-2c130a61fbe6",
                                "text": "T’as vu l’pare-choc de cette meuf ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "14175b1b-57f9-4f11-8452-cd827586bca1",
                        "source_entry_id": "fa73d129-6270-35fe-b085-20cc26f3e525",
                        "target_lang_word": "Stoßstange",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stoßstange",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c53d29c3-a353-3f4b-a17b-8d02b6549762",
                                        "entry_id": "8ffbf6e6-0af9-33e1-bc7b-a7efa7d3c163",
                                        "glosses": [
                                            "der im Allgemeinen vorderste beziehungsweise hinterste Teil eines Autos"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3298c544-84aa-4d7d-9725-f82744ce3c11",
                                                "sense_id": "c53d29c3-a353-3f4b-a17b-8d02b6549762",
                                                "text": "„Als er in der Nacht zum Montag gegen 1.30 Uhr zurückkam, entdeckte er, dass die Stoßstange vorne links verkratzt war.“"
                                            },
                                            {
                                                "example_id": "a4b33f34-5406-49ce-aa7d-a1ffde064300",
                                                "sense_id": "c53d29c3-a353-3f4b-a17b-8d02b6549762",
                                                "text": "„Fast in allen Wohnstraßen das gleiche Bild: Die Autos stehen Stoßstange an Stoßstange am Straßenrand, dazwischen Transporter von Kleinunternehmern, manchmal auch noch ein Anhänger.“"
                                            },
                                            {
                                                "example_id": "4b70d9dc-6844-44a7-b961-fa028bcbb67e",
                                                "sense_id": "c53d29c3-a353-3f4b-a17b-8d02b6549762",
                                                "text": "„Stoßstange an Stoßstange folgte er dem Auto Dr. Prachers, das sich durch den Verkehr quälte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1fbaab8f-665f-32d0-818f-62d1114b55f6",
                                        "entry_id": "8ffbf6e6-0af9-33e1-bc7b-a7efa7d3c163",
                                        "glosses": [
                                            "No glosses available"
                                        ],
                                        "tags": [
                                            "no-gloss"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "064211c4-2731-4dd4-a1c3-7b10ae9eaefe",
                                                "sense_id": "1fbaab8f-665f-32d0-818f-62d1114b55f6",
                                                "text": "„Abweichend von der Anordnung beim Ricardo-Motor werden die hängenden Ventile über Stoßstangen betätigt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a3220e8d-8fe0-4e42-a39b-3e73ac0528d0",
