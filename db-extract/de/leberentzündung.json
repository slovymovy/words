                "senses": [
                    {
                        "sense_id": "f8d273d1-c6ff-3b94-b001-7e3468a0d4b7",
                        "entry_id": "956d402d-c7cc-339c-a9bb-d90130ba9c71",
                        "glosses": [
                            "akute oder chronische Entzündung des Gewebes der Leber"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "197ea73f-9f0e-4b7a-ba69-b2f11a19d6af",
                                "sense_id": "f8d273d1-c6ff-3b94-b001-7e3468a0d4b7",
                                "text": "„Nach Jahren meldete sich seine alte Leberentzündung, die er weiterhin mit Whisky, Gin und Bier genährt hatte.“"
                            },
                            {
                                "example_id": "303d1556-83b6-41b0-8b95-519df3887fa9",
                                "sense_id": "f8d273d1-c6ff-3b94-b001-7e3468a0d4b7",
                                "text": "„Man fand eine Leberzirrhose, wahrscheinlich die Folge einer Leberentzündung, die Einstein während des Ersten Weltkriegs durchgemacht hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c1be6702-fab5-44cb-8c63-6a05da01722d",
                        "source_entry_id": "956d402d-c7cc-339c-a9bb-d90130ba9c71",
                        "source_sense_id": "f8d273d1-c6ff-3b94-b001-7e3468a0d4b7",
