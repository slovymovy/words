                        "glosses": [
                            "Homme chargé de rabattre les clients vers les taxis, les cars, dans les gares."
                        ],
                        "tags": [
                            "Sénégal"
                        ],
                        "examples": [
                            {
                                "example_id": "22b54e5d-a9b2-42f5-b5dd-99457a4692f8",
                                "sense_id": "ed7798f8-229e-361e-b146-dbabcc30e987",
                                "text": "Tout se passe comme si le propriétaire n’avait guère les moyens de contrôler le conducteur, qui lui-même n’a aucune prise sur l’apprenti, soumis à son tour à la loi du coxeur."
                            }
                        ]
                    },
