                "senses": [
                    {
                        "sense_id": "678a751e-b001-359d-9729-f5381bb0701b",
                        "entry_id": "71323107-39a9-3009-8765-4f8d08d9f6bf",
                        "glosses": [
                            "A female given name from Welsh."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78000e3f-209b-418c-b8b2-6daca356c0b4",
                                "sense_id": "678a751e-b001-359d-9729-f5381bb0701b",
                                "text": "Janet Fielding's Tegan also says goodbye to Doctor Who in \"Resurrection of the Daleks,\" and her farewell has an abrupt air to it.[…]Tegan simply has a temper tantrum and says she has seen too much violence. She then runs off into a warehouse and disappears."
                            },
                            {
                                "example_id": "21b83b74-6c56-42e7-94ea-3e1cfdfd5ced",
                                "sense_id": "678a751e-b001-359d-9729-f5381bb0701b",
                                "text": "The lad felt most honoured when Tegan called him her best friend."
                            },
                            {
                                "example_id": "b1b62e75-b606-4609-a948-a9971ba54885",
                                "sense_id": "678a751e-b001-359d-9729-f5381bb0701b",
                                "text": "Canadian indie-rock duo Tegan and Sara Quin have spent a lifetime answering the question: \"So which one of you is which?\""
                            },
                            {
                                "example_id": "804462ab-be53-46c7-a2a2-a9899f1f92d1",
                                "sense_id": "678a751e-b001-359d-9729-f5381bb0701b",
                                "text": "Following a restless and difficult day, Tegan, who is 11 weeks old, falls asleep cuddled up with her mother Carys on the sofa."
                            }
                        ]
                    },
                    {
                        "sense_id": "71c871b1-7684-3d78-890c-f00f05da01de",
                        "entry_id": "71323107-39a9-3009-8765-4f8d08d9f6bf",
                        "glosses": [
                            "A male given name from Irish. Alternative form of Teagan."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85b5c07a-a92c-417d-9ac9-bc80d31fd607",
                                "sense_id": "71c871b1-7684-3d78-890c-f00f05da01de",
                                "text": "'But,' Tegan prompted, pulling Elise toward him like he wanted something firm to hold onto. 'But it was empty.'"
                            }
                        ]
                    },
                    {
                        "sense_id": "1878390f-7723-345c-92b0-0b0c1864fee9",
                        "entry_id": "71323107-39a9-3009-8765-4f8d08d9f6bf",
                        "glosses": [
                            "A surname."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbfb9225-d446-41dc-85ee-cc2204937567",
                                "sense_id": "1878390f-7723-345c-92b0-0b0c1864fee9",
                                "text": "Their next door neighbor told Ott she had seen Tegan the night before the report was made and he did not have any bruises on his head."
                            }
                        ]
                    }
                ],
