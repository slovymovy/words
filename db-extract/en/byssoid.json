                        "glosses": [
                            "Synonym of byssaceous."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84f32b1e-2a3e-4df5-b651-bc19e3db1f26",
                                "sense_id": "10b7dcc1-ef50-3bdc-8ad9-28b07b64accd",
                                "text": "The opinions already expressed in 'The Phytologist,' relative to the nature of the byssoid substance found on the roots of Monotropa, from all stations that have supplied specimens for examination, are as follows."
                            },
                            {
                                "example_id": "62062d02-bca1-4217-a29a-7c82e257d128",
                                "sense_id": "10b7dcc1-ef50-3bdc-8ad9-28b07b64accd",
                                "text": "At first consisting of loose, distinct, byssoid fibres, in which state it frequently remains without producing a true hymenium, next forming a thin, resupinate, silky, subpulverulent stratum, with a beautiful byssoid margin, at length furnished with a true hymenium, and beset with minute white bristles."
                            },
                            {
                                "example_id": "a83669f5-9ad2-4145-b8ba-9f514205308b",
                                "sense_id": "10b7dcc1-ef50-3bdc-8ad9-28b07b64accd",
                                "text": "Hypothallus below the entire thallus, byssoid, whitish, composed of 1-2 μm thick hypae."
                            }
                        ]
                    }
                ],
