                    "frequency": "Middle",
                    "semantic_group_id": "cel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nasza firma <w>zmierza</w> do osiągnięcia pozycji lidera na rynku.",
                            "target_lang_translations": {
