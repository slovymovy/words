    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "a108fd6a-719b-34e6-acb0-bed172b32842",
                "word": "boatload",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "6cf234bb-22b7-435d-8109-8d1bc946b8c9",
                        "entry_id": "a108fd6a-719b-34e6-acb0-bed172b32842",
                        "tags": [
                            "plural"
                        ],
                        "form": "boatloads"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6773e47c-5991-3c4b-9efa-a567672b51df",
                        "entry_id": "a108fd6a-719b-34e6-acb0-bed172b32842",
                        "glosses": [
                            "Cargo or passengers that fill a boat."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c54ba4f-b57a-4e25-aa56-494cc452e622",
                                "sense_id": "6773e47c-5991-3c4b-9efa-a567672b51df",
                                "text": "a boatload of ferry passengers"
                            },
                            {
                                "example_id": "49cbe7b4-8770-4aa9-add1-6faeb121f2eb",
                                "sense_id": "6773e47c-5991-3c4b-9efa-a567672b51df",
                                "text": "Just then two boats[-]load of natives appeared, and our owner having agreed with them to tow us into harbour, they tried to do so, assisted by our own boat, but could make no way. […] Those who live on the coast have plenty of fish; but when inland, as we are here, they only go to the sea occasionally, and then bring home cockles and other shell-fish by the boatload."
                            }
                        ]
                    },
                    {
                        "sense_id": "7da5dc6e-c65d-38f1-872b-a6acaeae1146",
                        "entry_id": "a108fd6a-719b-34e6-acb0-bed172b32842",
                        "glosses": [
                            "A large quantity."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "00bf61da-c7f3-48f8-8915-34c90adda03d",
                                "sense_id": "7da5dc6e-c65d-38f1-872b-a6acaeae1146",
                                "text": "He showed up an hour later with a whole boatload of hamburgers, chips, cookies, and assorted other munchies, not to mention sodas and beer, and we all fell in and stuffed ourselves silly."
                            },
                            {
                                "example_id": "48de73f1-5e18-4a77-bc85-a78a4e61026c",
                                "sense_id": "7da5dc6e-c65d-38f1-872b-a6acaeae1146",
                                "text": "What's a fair price to pay for video perfection, or even something that looks a lot like it? In the case of high-definition movie discs, the answer may not just be \"a boatload of money,\" but having to keep two incompatible players under the TV set."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bc05a049-0e58-4baf-9493-648e3a62790f",
                        "source_entry_id": "a108fd6a-719b-34e6-acb0-bed172b32842",
                        "source_sense_description": "A large quantity.",
                        "target_lang_word": "Bootsladung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "3e6db254-3c4e-4301-9141-ce713e21f8e4",
                        "source_entry_id": "a108fd6a-719b-34e6-acb0-bed172b32842",
                        "source_sense_description": "A large quantity.",
                        "target_lang_word": "Batzen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Batzen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bf29cac6-b2ab-3a45-85a4-9130f38ebb3d",
                                        "entry_id": "1682ecf9-0bf4-3499-b479-52478202f80b",
                                        "glosses": [
                                            "eine Münze im süddeutschen und Schweizer Raum"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34b49b22-6e8a-467b-85fe-b8c8de4a81a1",
                                                "sense_id": "bf29cac6-b2ab-3a45-85a4-9130f38ebb3d",
                                                "text": "Der Batzen ist eine Münze, die zwischen 1492 und 1850 in Bern geprägt wurde."
                                            },
                                            {
                                                "example_id": "d8e3a528-bc7d-45a6-bc2c-1177d44c916c",
                                                "sense_id": "bf29cac6-b2ab-3a45-85a4-9130f38ebb3d",
                                                "text": "„Doch bereits in einer urkundlichen Erwähnung von 1595 verkündete ein Vogt aus Tuttlingen bei seinem Amtsantritt, dass die Metzger zu Postritten verpflichtet seien, wofür sie für den Tag und je ein Pferd 5 Batzen erhalten sollten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8e3fc0a3-7cc4-3b25-ad25-155961efd2d5",
                                        "entry_id": "1682ecf9-0bf4-3499-b479-52478202f80b",
                                        "glosses": [
                                            "ein größerer Klumpen eines weichen Materials"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85a417db-98d8-4022-a22c-a6bf6a589032",
                                                "sense_id": "8e3fc0a3-7cc4-3b25-ad25-155961efd2d5",
                                                "text": "Ein fetter Batzen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2bb61189-cfba-3b56-a86b-f042edcc1d0a",
                                        "entry_id": "1682ecf9-0bf4-3499-b479-52478202f80b",
                                        "glosses": [
                                            "ein großer Geldbetrag"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7891d75-ad36-459d-9664-31e5a65028bd",
                                                "sense_id": "2bb61189-cfba-3b56-a86b-f042edcc1d0a",
                                                "text": "Ich fand einen Batzen Geld auf der Straße."
                                            },
                                            {
                                                "example_id": "43c7a858-80d9-46f9-9e39-5ec75aa0d7cd",
                                                "sense_id": "2bb61189-cfba-3b56-a86b-f042edcc1d0a",
                                                "text": "„Seine Schwägerin in Irland war nach langen Jahren des Siechtums an Krebs gestorben, und dieser Krebs hatte ihn einen ganz schönen Batzen gekostet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
