                        "entry_id": "56700b3e-6fec-314b-8116-7eae97e88365",
                        "glosses": [
                            "Émettre plus que la normale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f11f1076-cee5-4194-81d2-f3e4134ce0f6",
                                "sense_id": "65425172-9681-3df8-b31e-ad0b6f96a05a",
                                "text": "Les billets vont rester plus longtemps en circulation et le monopole a une capacité plus importante à surémettre."
                            },
                            {
                                "example_id": "04477142-e26e-4a6e-8518-cf6459645777",
                                "sense_id": "65425172-9681-3df8-b31e-ad0b6f96a05a",
                                "text": "Premièrement, une distinction entre les billets émis par les différentes banques ne peut être faite, aussi une banque pourrait surémettre des billets sans être sanctionnée (McCulloch, 1831, p. 46-9)."
                            }
                        ]
                    }
