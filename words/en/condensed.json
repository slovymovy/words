{
    "word_family": [
        "condense",
        "condensation",
        "condenser",
        "condensability"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "627decb9-94a6-33fa-89f3-913c3333ceba",
                    "sense_definition": "Highly concentrated, or packed into a small space.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "concentration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The designer chose a <w>condensed</w> typeface to fit the long headline onto the narrow page.",
                            "target_lang_translations": {
                                "ru": "Дизайнер выбрал <w>узкий</w> шрифт, чтобы уместить длинный заголовок на узкой странице."
                            }
                        },
                        {
                            "text": "You can make a delicious dessert by mixing <w>condensed</w> milk with fresh lime juice.",
                            "target_lang_translations": {
                                "ru": "Вы можете приготовить вкусный десерт, смешав <w>сгущённое</w> молоко со свежим соком лайма."
                            }
                        }
                    ],
                    "synonyms": [
                        "compact",
                        "compressed",
                        "concentrated"
                    ],
                    "antonyms": [
                        "expanded",
                        "diluted"
                    ],
                    "common_phrases": [
                        "condensed milk",
                        "condensed version",
                        "condensed typeface"
                    ],
                    "target_lang_definitions": {
                        "ru": "Высококонцентрированный или плотно упакованный в небольшом пространстве."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сгущённый",
                                "target_lang_sense_clarification": "о жидкостях, например, молоке"
                            },
                            {
                                "target_lang_word": "узкий",
                                "target_lang_sense_clarification": "о шрифтах"
                            },
                            {
                                "target_lang_word": "сжатый",
                                "target_lang_sense_clarification": "о тексте или формате"
                            },
                            {
                                "target_lang_word": "уплотнённый",
                                "target_lang_sense_clarification": "о структуре или пространстве"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e06add97-443e-310c-a285-9b8972285215",
                    "sense_definition": "Simple past and past participle of <w>condense</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "grammatical_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The steam <w>condensed</w> into water droplets on the cold surface of the window.",
                            "target_lang_translations": {
                                "ru": "Пар <w>конденсировался</w> в капли воды на холодной поверхности окна."
                            }
                        },
                        {
                            "text": "The editor <w>condensed</w> the long manuscript into a short article for the magazine.",
                            "target_lang_translations": {
                                "ru": "Редактор <w>сократил</w> длинную рукопись до короткой статьи для журнала."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола condense (конденсироваться, сокращать)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "конденсировался",
                                "target_lang_sense_clarification": "о паре или газе"
                            },
                            {
                                "target_lang_word": "сократил",
                                "target_lang_sense_clarification": "о тексте или информации"
                            },
                            {
                                "target_lang_word": "сгустил",
                                "target_lang_sense_clarification": "о веществе"
                            }
                        ]
                    }
                }
            ]
        }
    ]
