                        "glosses": [
                            "Relatif aux langues du sous-groupe appelé yoruboïde."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "856f6c1a-ad1d-4f42-9a8f-c9693688bc4a",
                                "sense_id": "3ca2c857-f04b-3b92-9a05-218fd9584285",
                                "text": "Les Itcha forment une petite communauté habitant au centre-ouest du Bénin. Ils parlent une langue appartenant au groupe linguistique dit « yoruboïde »."
                            },
                            {
                                "example_id": "085cac17-2c6b-4eb4-8a8d-aaa7bf444b3b",
                                "sense_id": "3ca2c857-f04b-3b92-9a05-218fd9584285",
                                "text": "La même tendance s’observe avec l’ethnie yoruboïde Nago qui semble génétiquement moins distante des Fon que du reste des populations du Bénin."
                            }
                        ]
                    }
