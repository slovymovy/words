                                "sense_id": "2b458184-c6d7-38fe-9b99-8135b6b22bfa",
                                "text": "Le pain a été bénit par le prêtre."
                            }
                        ]
                    },
                    {
                        "sense_id": "9c52ef25-b20c-3212-9d3c-a25a327ab141",
                        "entry_id": "50bce474-d324-38a0-9c65-468aab171037",
                        "glosses": [
                            "Troisième personne du singulier de l’indicatif présent de bénir."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "037402bf-b62a-441f-8a0b-b9cee03bc123",
                                "sense_id": "9c52ef25-b20c-3212-9d3c-a25a327ab141",
                                "text": "Le prêtre s’agenouille devant la croix, puis bénit le pain et le vin."
                            }
                        ]
                    },
                    {
                        "sense_id": "80b004a3-e344-3fa4-a41a-6df629be8432",
                        "entry_id": "50bce474-d324-38a0-9c65-468aab171037",
                        "glosses": [
                            "Troisième personne du singulier du passé simple du verbe bénir."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "b58134a5-0d81-4dda-be1e-553a7c850bc5",
                                "sense_id": "80b004a3-e344-3fa4-a41a-6df629be8432",
                                "text": "Il prit le pain, le bénit, le donna à ses disciples."
                            }
                        ]
                    }
