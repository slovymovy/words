        "fr-extract.jsonl": [
            {
                "entry_id": "35e12820-9f72-38fa-a5b5-529d41eb7f25",
                "word": "renom",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e7ada182-352b-4cf0-b54c-c505d3f6baad",
                        "entry_id": "35e12820-9f72-38fa-a5b5-529d41eb7f25",
                        "tags": [
                            "plural"
                        ],
                        "form": "renoms"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9c1a3b35-456f-3e0b-a62b-1b80527fdcba",
                        "entry_id": "35e12820-9f72-38fa-a5b5-529d41eb7f25",
                        "glosses": [
                            "Réputation ; opinion que le public a d’une personne, d’une chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93b9ebce-4088-4ef6-ab26-1f707a5303af",
                                "sense_id": "9c1a3b35-456f-3e0b-a62b-1b80527fdcba",
                                "text": "Après les palais des petits souverains, ce qui brille du plus vif éclat, ce sont les hôtels en renom et parfois les musées dont le nombre est assez grand."
                            },
                            {
                                "example_id": "fb61c411-e2e0-4132-83b4-af5ec9ab439a",
                                "sense_id": "9c1a3b35-456f-3e0b-a62b-1b80527fdcba",
                                "text": "Un jour, à la Croix-Rouge,\nNous étions dix à douze,\nTous grinches de renom.\nNous attendions la sorgue,\nVoulant poisser les bogues\nPour faire du billon."
                            },
                            {
                                "example_id": "fb2df092-273d-4815-9ca3-0160130d88b5",
                                "sense_id": "9c1a3b35-456f-3e0b-a62b-1b80527fdcba",
                                "text": "C'était le mercredi 15 novembre de l'an de grâce 1665. Ce soir-là, il y avait petit souper et grande compagnie, rue Vieille-du-Temple, chez La Vienne, le baigneur à la mode, l'étuviste en renom, le barbier du monde élégant."
                            },
                            {
                                "example_id": "cf96fe75-3cb8-4d5e-a68d-ac7948dd4f74",
                                "sense_id": "9c1a3b35-456f-3e0b-a62b-1b80527fdcba",
                                "text": "Là, dans cette rue non loin de la grande poste, la boutique d'une chanteuse parisienne en renom efface à tout jamais l'idée du foulard et du madras dans l'esprit des belles Foyalaises."
                            },
                            {
                                "example_id": "930f528b-b55f-4e9c-a15f-d0b9ffb17afa",
                                "sense_id": "9c1a3b35-456f-3e0b-a62b-1b80527fdcba",
                                "text": "Je présentai Howard à Fazel — ils ne se connaissaient que de renom ; ce dernier n’était pas venu depuis plus d’un an à Tabriz, pourtant sa ville d’origine."
                            },
                            {
                                "example_id": "29096dd0-bf75-499f-bef0-a387d1adca8b",
                                "sense_id": "9c1a3b35-456f-3e0b-a62b-1b80527fdcba",
                                "text": "En France, les tatouages sont autorisés dans l'armée, à condition qu'ils «ne portent pas atteinte au renom de l’armée» et qu'ils ne soient «ni à caractère raciste, politique, extrémiste, homophobe, religieux», selon le ministère des Armées."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "29d2625c-65cd-49b4-850a-9616c3e3d9a6",
                        "source_entry_id": "35e12820-9f72-38fa-a5b5-529d41eb7f25",
                        "source_sense_id": "9c1a3b35-456f-3e0b-a62b-1b80527fdcba",
                        "target_lang_word": "renown",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "renown",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1e4b109f-b59c-37d0-9590-f772785f06d8",
                                        "entry_id": "bcd52aa8-8af9-356f-8121-ceffd0b61684",
                                        "glosses": [
                                            "Fame; celebrity; wide recognition."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e233d85-6c4a-4d64-8365-d43af46a1493",
                                                "sense_id": "1e4b109f-b59c-37d0-9590-f772785f06d8",
                                                "text": "She is a theame of honour and renowne, / A ſpurre to valiant and magnanimous deeds, / Whoſe preſent courage may beate downe our foes, / And fame in time to come canonize us, […]"
                                            },
                                            {
                                                "example_id": "0edefe53-e9d6-4eb7-a5d7-aafc22f3bb98",
                                                "sense_id": "1e4b109f-b59c-37d0-9590-f772785f06d8",
                                                "text": "And they rose up before Moses, with certain of the children of Israel, two hundred and fifty princes of the assembly, famous in the congregation, men of renown: […]"
                                            },
                                            {
                                                "example_id": "675580e6-bc6f-426d-b5d7-6b9fab587267",
                                                "sense_id": "1e4b109f-b59c-37d0-9590-f772785f06d8",
                                                "text": "[…] Nor envy we / Thy great Renown, nor grudge thy Victory; / 'Tis thine, O King, th' Afflicted to redreſs, / And Fame has fill'd the World with thy Succeſs; […]"
                                            },
                                            {
                                                "example_id": "f69176cd-1176-47c4-9103-a5970bdf41e7",
                                                "sense_id": "1e4b109f-b59c-37d0-9590-f772785f06d8",
                                                "text": "There sleep the mighty dead as in life they slept, warriors and princes of high renown."
                                            },
                                            {
                                                "example_id": "37b42298-70fe-45b9-969f-92c15f0c5327",
                                                "sense_id": "1e4b109f-b59c-37d0-9590-f772785f06d8",
                                                "text": "[…] one day local fame would become world renown […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1285ef19-a78f-3b64-9e99-64a281b8d86f",
                                        "entry_id": "bcd52aa8-8af9-356f-8121-ceffd0b61684",
                                        "glosses": [
                                            "Reports of nobleness or achievements; praise."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94ba5732-e9d2-49b7-8339-e0b2241e5c92",
                                                "sense_id": "1285ef19-a78f-3b64-9e99-64a281b8d86f",
                                                "text": "[…] She / Is daughter to this famous Duke of Milan, / Of whom so often I have heard renown, / But never saw before;"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "renown",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c4e258ee-90fd-3510-9592-fc6fe748e0ac",
