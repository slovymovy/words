                    "frequency": "High",
                    "semantic_group_id": "personne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette jeune <w>demoiselle</w> a gentiment aidé une dame âgée à traverser la rue."
                        },
                        {
                            "text": "Ma sœur a choisi sa meilleure amie comme <w>demoiselle</w> d'honneur pour son mariage."
                        }
                    ],
