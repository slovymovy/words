{
    "word_family": [
        "steal",
        "stealth",
        "stealthy",
        "stolen"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "720c3ea1-27ba-3759-897b-d5be48d506a1",
                    "sense_definition": "The simple past tense of <w>steal</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "verb_form_past",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Someone <stole> my wallet while I was on the crowded bus.",
                            "target_lang_translations": {
                                "ru": "Кто-то <украл> мой кошелек, пока я ехал в переполненном автобусе.",
                                "zh": "我在拥挤的公交车上时，有人<w>偷</w>了我的钱包。"
                            }
                        },
                        {
                            "text": "The young actor <stole> the show with his incredible performance.",
                            "target_lang_translations": {
                                "ru": "Молодой актер <затмил всех> своим невероятным выступлением.",
                                "zh": "那位年轻演员凭借其出色的表演<w>抢</w>尽了风头。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "stole the show",
                        "stole a glance",
                        "stole away",
                        "stole a march"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время глагола <w>steal</w> (красть).",
                        "zh": "动词 steal 的过去式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "украл",
                                "target_lang_sense_clarification": "прошедшее время, совершенный вид"
                            },
                            {
                                "target_lang_word": "крал",
                                "target_lang_sense_clarification": "прошедшее время, несовершенный вид"
                            },
                            {
                                "target_lang_word": "своровал",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "偷",
                                "target_lang_sense_clarification": "动词，指非法占有他人财物"
                            },
                            {
                                "target_lang_word": "抢走",
                                "target_lang_sense_clarification": "指夺取或抢占风头"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "47f51dd0-a2ac-3fc6-b837-675ee16e9129",
                    "sense_definition": "The past participle of <w>steal</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "verb_form_pp",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He had <stole> away into the night before anyone noticed he was gone.",
                            "target_lang_translations": {
                                "ru": "Он <ускользнул> в ночь, прежде чем кто-либо заметил его исчезновение.",
                                "zh": "在没人注意到他离开之前，他已经悄悄地<w>溜</w>进了夜色中。"
                            }
                        },
                        {
                            "text": "My heart was <stole> by the beauty of the landscape.",
                            "target_lang_translations": {
                                "ru": "Мое сердце было <похищено> красотой пейзажа.",
                                "zh": "我的心被那美丽的风景所<w>吸引</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Standard English uses 'stolen' as the past participle."
                        },
                        {
                            "trait_type": "dialectal",
                            "comment": "Used in some non-standard dialects."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие прошедшего времени от <w>steal</w> (устаревшая или диалектная форма).",
                        "zh": "动词 steal 的过去分词（非标准用法）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "украденный",
                                "target_lang_sense_clarification": "причастие"
                            },
                            {
                                "target_lang_word": "похищенный",
                                "target_lang_sense_clarification": "причастие, более формально"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "被偷的",
                                "target_lang_sense_clarification": "形容词，表示被盗窃的状态"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a8e699b9-da24-3609-b780-170bc6d8853f",
                    "sense_definition": "A long scarf or shawl, often made of fur or expensive fabric, worn loosely over the shoulders.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "garment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore an elegant fur <stole> to keep warm at the opera.",
                            "target_lang_translations": {
                                "ru": "Она надела элегантный меховой <палантин>, чтобы согреться в опере.",
                                "zh": "她在歌剧院时披着一条优雅的皮草<w>披肩</w>来保暖。"
                            }
                        },
                        {
                            "text": "The bride wrapped a white <stole> around her shoulders for the evening reception.",
                            "target_lang_translations": {
                                "ru": "Невеста накинула белый <палантин> на плечи для вечернего приема.",
                                "zh": "新娘在晚宴招待会上将一条白色的<w>披肩</w>围在肩上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "shawl",
                        "wrap",
                        "scarf"
                    ],
                    "common_phrases": [
                        "fur stole",
                        "mink stole"
                    ],
                    "target_lang_definitions": {
                        "ru": "Длинный шарф или накидка, часто из меха или дорогой ткани, которую носят на плечах.",
                        "zh": "一种长围巾或披肩，通常由皮草或昂贵面料制成，松松地披在肩上。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "палантин",
                                "target_lang_sense_clarification": "широкая накидка, часто меховая"
                            },
                            {
                                "target_lang_word": "накидка",
                                "target_lang_sense_clarification": "общий термин"
                            },
                            {
                                "target_lang_word": "горжетка",
                                "target_lang_sense_clarification": "меховой шарф"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "披肩",
                                "target_lang_sense_clarification": "披在肩上的服饰"
                            },
                            {
                                "target_lang_word": "皮草围巾",
                                "target_lang_sense_clarification": "特指皮草材质的款式"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5d8e7497-0129-3d3f-bd29-4ed12cdb5b5c",
                    "sense_definition": "A long, narrow strip of cloth worn around the neck by clergy or as part of academic graduation dress.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "garment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The priest kissed his <stole> before placing it around his neck for the service.",
                            "target_lang_translations": {
                                "ru": "Священник поцеловал свою <столу>, прежде чем надеть ее на шею для службы.",
                                "zh": "牧师在做礼拜前亲吻了他的<w>圣带</w>，然后将其戴在脖子上。"
                            }
                        },
                        {
                            "text": "Every graduate wore a colorful <stole> representing their field of study.",
                            "target_lang_translations": {
                                "ru": "Каждый выпускник был в цветной <ленте>, символизирующей его область обучения.",
                                "zh": "每位毕业生都佩戴了一条代表其专业领域的彩色<w>绶带</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "vestment",
                        "sash"
                    ],
                    "common_phrases": [
                        "graduation stole",
                        "priest's stole"
                    ],
                    "target_lang_definitions": {
                        "ru": "Длинная узкая лента из ткани, которую носят на шее священнослужители или выпускники учебных заведений.",
                        "zh": "一种长而窄的布带，由神职人员佩戴或作为学术毕业服饰的一部分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стола",
                                "target_lang_sense_clarification": "католическое облачение"
                            },
                            {
                                "target_lang_word": "лента",
                                "target_lang_sense_clarification": "часть академической одежды"
                            },
                            {
                                "target_lang_word": "епитрахиль",
                                "target_lang_sense_clarification": "православный аналог"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "圣带",
                                "target_lang_sense_clarification": "神职人员佩戴的礼仪带"
                            },
                            {
                                "target_lang_word": "毕业绶带",
                                "target_lang_sense_clarification": "毕业典礼上佩戴的装饰带"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b316424c-dcd7-32ef-b3e5-479d8c53e452",
                    "sense_definition": "A horizontal plant stem that grows along the ground and forms new plants at intervals; a stolon.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "botany",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The strawberry plant spreads rapidly by sending out a <stole> across the soil.",
                            "target_lang_translations": {
                                "ru": "Клубника быстро разрастается, пуская <ус> по земле.",
                                "zh": "草莓植株通过在土壤表面伸出<w>匍匐茎</w>来迅速蔓延。"
                            }
                        },
                        {
                            "text": "New roots began to form where the <stole> touched the damp earth.",
                            "target_lang_translations": {
                                "ru": "Новые корни начали формироваться там, где <столон> касался влажной земли.",
                                "zh": "在<w>匍匐茎</w>接触到潮湿泥土的地方，开始长出新的根系。"
                            }
                        }
                    ],
                    "synonyms": [
                        "stolon",
                        "runner"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical or archaic variant of stolon"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Горизонтальный стебель растения, растущий вдоль земли и образующий новые растения; столон.",
                        "zh": "植物沿地面生长的水平茎，可间隔长出新植株；即匍匐茎。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "столон",
                                "target_lang_sense_clarification": "ботанический термин"
                            },
                            {
                                "target_lang_word": "ус",
                                "target_lang_sense_clarification": "например, у клубники"
                            },
                            {
                                "target_lang_word": "побег",
                                "target_lang_sense_clarification": "общий термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "匍匐茎",
                                "target_lang_sense_clarification": "植物学专业术语"
                            },
                            {
                                "target_lang_word": "走茎",
                                "target_lang_sense_clarification": "植物学专业术语"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}