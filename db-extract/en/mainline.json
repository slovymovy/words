    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "c2e083cd-aa79-37e3-857b-edb4219e07e1",
                "word": "mainline",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0e8785c6-0cdd-3e56-af18-d4dabc9515d9",
                        "entry_id": "c2e083cd-aa79-37e3-857b-edb4219e07e1",
                        "glosses": [
                            "Normal, principal or standard."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "e0502cc0-e567-4757-9fba-3a238fbe09b2",
                                "sense_id": "0e8785c6-0cdd-3e56-af18-d4dabc9515d9",
                                "text": "At a time when mainline denominations are engaged in massive closures of small rural churches, independent charismatics are strategically helping to rechurch rural Canada."
                            },
                            {
                                "example_id": "3681bda1-de39-421b-a92a-429e14085714",
                                "sense_id": "0e8785c6-0cdd-3e56-af18-d4dabc9515d9",
                                "text": "This doesn’t necessarily mean Christians are joining mainline congregations — the survey measures self-identification, not church affiliation. It is, nevertheless, a striking turnabout after years when mainline Protestantism was considered moribund and evangelical Christianity full of dynamism."
                            }
                        ]
                    },
                    {
                        "sense_id": "02213dae-97bc-3d2b-b19e-b42dea900c41",
                        "entry_id": "c2e083cd-aa79-37e3-857b-edb4219e07e1",
                        "glosses": [
                            "Of or pertaining to the principal route or line of a railway."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "13189de8-443c-3e55-9a8b-0c05aba8b7b0",
                        "entry_id": "c2e083cd-aa79-37e3-857b-edb4219e07e1",
                        "glosses": [
                            "Of or pertaining to a surface railway as distinct from an underground, elevated or light rail one."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "d8430a95-d116-3e3b-8b3b-28a3292b3ecf",
                        "entry_id": "c2e083cd-aa79-37e3-857b-edb4219e07e1",
                        "glosses": [
                            "Of a sequence of opening moves: being part of a main line (\\\"a standard sequence of opening moves considered to be best play\\\")."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "14ac6f31-b43a-48d6-a09d-a1fecb6f2740",
                                "sense_id": "d8430a95-d116-3e3b-8b3b-28a3292b3ecf",
                                "text": "After 3 e5 the Czech Benoni Defense is created. Unlike the mainline 3 e6, which aims for tactical counterplay in the center, Black aims for solidity there. He will choose later what flank to attack on."
                            },
                            {
                                "example_id": "f2ef285b-9e3d-407f-87c0-76837dfaaa50",
                                "sense_id": "d8430a95-d116-3e3b-8b3b-28a3292b3ecf",
                                "text": "Short's pragmatic approach to the match was to avoid mainline theory and the teenager's computer preparation."
                            },
                            {
                                "example_id": "ce138efa-2432-4e23-a0fe-a3a9e94e6060",
                                "sense_id": "d8430a95-d116-3e3b-8b3b-28a3292b3ecf",
                                "text": "The first classical game featured a fairly mainline Nimzo-Indian Defense, with the players following one of So's October 2021 games until move 20."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
