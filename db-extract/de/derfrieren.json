                "senses": [
                    {
                        "sense_id": "aa7c85dd-ce56-3cfa-95bf-bf7592986553",
                        "entry_id": "7e71ba53-281d-306f-a1fa-b9cc47669420",
                        "glosses": [
                            "erfrieren"
