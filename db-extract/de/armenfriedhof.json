                        "sense_id": "bdf6cd0a-e993-3d91-b1b9-3dd59e28d5ce",
                        "entry_id": "48cd7599-868e-3ebd-8e04-fd6cdfee0e8b",
                        "glosses": [
                            "Friedhof für arme Leute"
