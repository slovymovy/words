                    {
                        "sense_id": "f3cf8758-57c8-371d-b39a-98d068e777e0",
                        "entry_id": "86e619db-67f0-33cd-8faf-0aee0cfb92e8",
                        "glosses": [
                            "Rejet de métal en fusion par l'avant d'une tuyère."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "135c33d6-b73d-3004-a3c9-49fd214ed245",
                        "entry_id": "86e619db-67f0-33cd-8faf-0aee0cfb92e8",
                        "glosses": [
                            "Salive"
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "bced3734-f8d8-4b6e-b42a-3eb4ae706fd4",
                                "sense_id": "135c33d6-b73d-3004-a3c9-49fd214ed245",
                                "text": "C'est avec de la crache. Elle crache délicatement et fait couler un filet de bave sur le sol avec lequel elle humidifie le bout d'un petit bâton."
                            },
                            {
                                "example_id": "78a404ef-1c75-448b-9978-834640af0387",
                                "sense_id": "135c33d6-b73d-3004-a3c9-49fd214ed245",
                                "text": "Avec un peu de vieux plâtre pris entre les pierres et de la crache, il fit un mortier dans lequel les vis complaisantes firent semblant de tenir."
                            },
                            {
                                "example_id": "5043b9c9-5274-4d8c-a3e5-325070e56705",
                                "sense_id": "135c33d6-b73d-3004-a3c9-49fd214ed245",
                                "text": "Mais, pour gagner cette salle à manger toute d'élégance maritime, briquée à l'huile de coude (et à la crache pratique courante pour le « fini »), quel trajet !"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "a5493808-b696-3845-851e-80fdf9098f12",
                "word": "crache",
