                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1805506-deaa-4303-a735-7a6dd5881982",
                                                "sense_id": "8b80c6c2-9717-33f9-b399-d4e9dbb9dfe5",
                                                "text": "Ich übernehme hierfür die Verantwortlichkeit."
                                            },
                                            {
                                                "example_id": "1c9f66dd-2403-4f21-a3b1-965f953e2ba4",
                                                "sense_id": "8b80c6c2-9717-33f9-b399-d4e9dbb9dfe5",
                                                "text": "Moralische Verantwortlichkeit benötigt, der vorherrschenden Meinung nach, einen freien Willen."
                                            }
                                        ],
