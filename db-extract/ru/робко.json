                    {
                        "translation_id": "de05cd53-c522-4bef-b101-74069ee46435",
                        "source_entry_id": "a70eadb2-d7f6-3de1-a5e6-342e2eace5b1",
                        "target_lang_word": "ängstlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ängstlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "64b5117c-5530-3df9-81a6-a7b5d42fdc20",
                                        "entry_id": "10a2f5f0-0396-3165-9c1e-9a0166b9d16a",
                                        "glosses": [
                                            "von Angst ergriffen, erfüllt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a568197-0069-4c44-ba60-2f7f001eac3b",
                                                "sense_id": "64b5117c-5530-3df9-81a6-a7b5d42fdc20",
                                                "text": "„… allmählich verschwanden die Menschen, ich armes Kind irrte ängstlich umher, stand endlich vor der Weidenhecke eines wüsten Bauerhofes und sah dort einen Mann, der mit dem Spaten die Erde aufwühlte, und neben ihm ein häßlich hämisches Weib, das etwas wie einen abgeschnittenen Menschenkopf in der Schürze hielt, …“ (Heinrich Heine:Heinrich Heine: „Ideen. Das Buch Le Grand“)"
                                            },
                                            {
                                                "example_id": "c5db7cae-8d27-458f-812b-c8d2653518d0",
                                                "sense_id": "64b5117c-5530-3df9-81a6-a7b5d42fdc20",
                                                "text": "Nun sei doch nicht so ängstlich, der Hund tut dir nichts!"
                                            },
                                            {
                                                "example_id": "18fa6369-5a38-49d1-a054-bdbac6cba1ec",
                                                "sense_id": "64b5117c-5530-3df9-81a6-a7b5d42fdc20",
                                                "text": "Sie warf ihrem Vater einen ängstlichen Blick zu."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "af2b0f15-2311-308c-9511-e311fe1fccf7",
                                        "entry_id": "10a2f5f0-0396-3165-9c1e-9a0166b9d16a",
                                        "glosses": [
                                            "peinlich genau, akkurat"
                                        ],
                                        "tags": [
                                            "adverbiell"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "def51077-74aa-4af9-80f9-014f7225adca",
                                                "sense_id": "af2b0f15-2311-308c-9511-e311fe1fccf7",
                                                "text": "Peter ist immer so ängstlich bemüht, ja kein Frage zu verpassen."
                                            },
                                            {
                                                "example_id": "85e31e26-0561-4376-b290-86c8905d3a3e",
                                                "sense_id": "af2b0f15-2311-308c-9511-e311fe1fccf7",
                                                "text": "Der Revisor ist ängstlich bestrebt, keinen Fehler zu machen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "66dd821f-20c7-3a94-acdf-3a3f29c8903e",
                                        "entry_id": "10a2f5f0-0396-3165-9c1e-9a0166b9d16a",
                                        "glosses": [
                                            "nicht so eilig, nicht so genau"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e804bc20-fb11-4edf-9523-ef6829169e4f",
                                                "sense_id": "66dd821f-20c7-3a94-acdf-3a3f29c8903e",
                                                "text": "Das ist jetzt nicht so ängstlich mit der Post, die kann auch morgen raus."
                                            },
                                            {
                                                "example_id": "2f73b0aa-aa9c-4392-aade-d90aeda3d57a",
                                                "sense_id": "66dd821f-20c7-3a94-acdf-3a3f29c8903e",
                                                "text": "Du musst nicht so ängstlich mit der Temperaturwahl sein, ein paar Grad mehr oder weniger spielen hier keine Rolle."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
