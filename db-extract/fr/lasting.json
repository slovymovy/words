                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "44ec7b73-719b-30c8-91bd-63eba4438b9e",
                                        "entry_id": "fe626e77-edc6-3bd6-90d6-da3e28a013e5",
                                        "glosses": [
                                            "The action or state of persisting; the time during which something or someone persists."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1dac9e0d-ebea-47e3-a5f2-4d93e0015b53",
                                                "sense_id": "44ec7b73-719b-30c8-91bd-63eba4438b9e",
                                                "text": "1598, I. D. (possibly John Dee) (translator), Aristotles Politiques, or Discourses of Gouernment, London: Adam Islip, Chapter 12, p. 334,\nBut all things that haue beginning, must come to an end, and whatsoeuer groweth, must likewise deminish, being subiect to corruption and change, according to the time appointed vnto it by the course of Nature, as is seene by experience in plants, and in wights, which haue their ages and lastings certaine and determined."
                                            },
                                            {
                                                "example_id": "4d9a09c1-6725-4ba1-91d1-7391d61ba066",
                                                "sense_id": "44ec7b73-719b-30c8-91bd-63eba4438b9e",
                                                "text": "[…] it may be some kinde of Prophecy, of the continuance, and lasting of these Letters, that having been scattered, more then Sibyls leaves, I cannot say into parts, but corners of the World, they have recollected and united themselves […]"
                                            },
                                            {
                                                "example_id": "081290cc-78f9-42f1-ac92-cb951ba918ac",
                                                "sense_id": "44ec7b73-719b-30c8-91bd-63eba4438b9e",
                                                "text": "But concerning the several degrees of lasting, wherewith Ideas are imprinted on the Memory, we may observe […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5961d35a-a0e7-4a08-a498-be79d1b59cab",
