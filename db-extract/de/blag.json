                "senses": [
                    {
                        "sense_id": "66052039-ed8d-34bf-bf3d-1c3ac350f9ae",
                        "entry_id": "93013bc0-4354-3f19-bb04-5517a88a4a0e",
                        "glosses": [
                            "child, kid (up to circa 14 years)"
                        ],
                        "tags": [
                            "Germany",
                            "Western",
                            "colloquial",
                            "mixed",
                            "neuter",
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "ed454cc3-a1d3-4e1b-babd-da7dfaa08498",
                                "sense_id": "66052039-ed8d-34bf-bf3d-1c3ac350f9ae",
                                "text": "Eigentlich hab ich die Blagen ja ganz gern.",
                                "translation": "Actually, I really do like those kids in a way.",
                                "english": "Actually, I really do like those kids in a way."
                            },
                            {
                                "example_id": "10406a17-f8c6-4621-84cf-64433876b8cd",
                                "sense_id": "66052039-ed8d-34bf-bf3d-1c3ac350f9ae",
                                "text": "Blag! Wat haste denn jetz' wieder gemacht?!",
                                "translation": "Kid! What did you do this time?!",
                                "english": "Kid! What did you do this time?!"
                            },
                            {
                                "example_id": "83e906ca-b1a6-493f-8222-6c22cca49d23",
                                "sense_id": "66052039-ed8d-34bf-bf3d-1c3ac350f9ae",
                                "text": "Die Mutter reagiert mit schlimmen Krankheitssymptomen, die wir undankbaren Blagen zwar nie sehen, dafür aber ständig zu hören bekommen.",
                                "translation": "The mother reacts with dire symptoms of illness that we ungrateful brats, might it be that we do not see them ever, hear nonetheless without cease.",
                                "english": "The mother reacts with dire symptoms of illness that we ungrateful brats, might it be that we do not see them ever, hear nonetheless without cease."
                            }
                        ]
                    }
                ],
