{
    "word_family": [
        "tabooing"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "48fc05f1-2067-3656-9788-d16721074604",
                    "sense_definition": "Excluded or forbidden from use, approach, or mention.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "forbidden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Discussing politics at the dinner table is considered <w>taboo</w> in this family.",
                            "target_lang_translations": {
                                "ru": "Обсуждение политики за обеденным столом считается <w>табу</w> в этой семье."
                            }
                        },
                        {
                            "text": "Certain topics remain <w>taboo</w> in professional settings to avoid conflict.",
                            "target_lang_translations": {
                                "ru": "Некоторые темы остаются <w>запретными</w> в профессиональной среде во избежание конфликтов."
                            }
                        }
                    ],
                    "common_phrases": [
                        "strictly taboo",
                        "socially taboo"
                    ],
                    "target_lang_definitions": {
                        "ru": "Запрещенный, недопустимый к использованию, приближению или упоминанию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "табуированный",
                                "target_lang_sense_clarification": "находящийся под запретом"
                            },
                            {
                                "target_lang_word": "запретный",
                                "target_lang_sense_clarification": "недозволенный, неприкасаемый"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2a8abe17-13bc-3464-9804-4a6a47261b70",
                    "sense_definition": "A social or cultural ban that prevents people from doing or mentioning something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "forbidden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>taboo</w> against public displays of affection is fading in many modern societies.",
                            "target_lang_translations": {
                                "ru": "<w>Табу</w> на публичное проявление чувств постепенно исчезает во многих современных обществах."
                            }
                        },
                        {
                            "text": "Breaking a cultural <w>taboo</w> can lead to severe social consequences in some communities.",
                            "target_lang_translations": {
                                "ru": "Нарушение культурного <w>табу</w> в некоторых сообществах может повлечь серьезные социальные последствия."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cultural taboo",
                        "social taboo"
                    ],
                    "target_lang_definitions": {
                        "ru": "Социальный или культурный запрет на совершение или упоминание чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "табу",
                                "target_lang_sense_clarification": "строгий социальный или культурный запрет"
                            },
                            {
                                "target_lang_word": "запрет",
                                "target_lang_sense_clarification": "общее ограничение"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "72a93a3e-e062-33b1-a6a2-c89cde8b128a",
                    "sense_definition": "To officially ban or forbid something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "forbidden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government decided to <w>taboo</w> the use of certain chemicals in food production.",
                            "target_lang_translations": {
                                "ru": "Правительство решило <w>наложить табу на</w> использование определенных химических веществ в производстве продуктов питания."
                            }
                        },
                        {
                            "text": "Local leaders moved to <w>taboo</w> the practice to preserve the sanctity of the site.",
                            "target_lang_translations": {
                                "ru": "Местные лидеры приняли меры, чтобы <w>запретить</w> эту практику ради сохранения святости этого места."
                            }
                        }
                    ],
                    "synonyms": [
                        "tabooize"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально запрещать или налагать запрет на что-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "табуировать",
                                "target_lang_sense_clarification": "налагать табу"
                            },
                            {
                                "target_lang_word": "налагать табу",
                                "target_lang_sense_clarification": "запрещать"
                            },
                            {
                                "target_lang_word": "запрещать",
                                "target_lang_sense_clarification": "ставить под запрет"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}