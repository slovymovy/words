                                                "sense_id": "9d65927b-8621-3e20-85e0-ce711cfe67ba",
                                                "text": "Burada beş nüfus var."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72be9c9a-c834-3038-b33b-da7aa0a1bc65",
                                        "entry_id": "a6d5f09b-a146-3a02-8b88-a4a27c14bb76",
                                        "glosses": [
                                            "ortak bir özellik gösteren kişilerin bütünü"
                                        ],
