                "forms": [],
                "senses": [
                    {
                        "sense_id": "5ffdc0f5-5468-3245-b346-aa7ea9b53bb2",
                        "entry_id": "bc671d86-27a2-3e9d-90e7-f6b581ad4054",
                        "glosses": [
                            "nietsontziend en gewelddadig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f27d5130-85b3-449d-b264-5d0e2a0e5294",
                                "sense_id": "5ffdc0f5-5468-3245-b346-aa7ea9b53bb2",
                                "text": "Zelfs het bruutste optreden vermocht de opstand niet neer te slaan."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1b3c99ff-31d8-4b70-a4c3-3240b429bb91",
                        "source_entry_id": "bc671d86-27a2-3e9d-90e7-f6b581ad4054",
                        "source_sense_id": "5ffdc0f5-5468-3245-b346-aa7ea9b53bb2",
                        "source_sense_description": "nietsontziend en gewelddadig",
                        "target_lang_word": "brutal",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brutal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "26004f48-2b4f-3158-87ce-bc10678caaf4",
                                        "entry_id": "bdc25b16-9463-39e1-b4b2-2670fab51382",
                                        "glosses": [
                                            "dazu neigen, rücksichtslos, übermäßig, unangebracht und oft unbeherrscht gewalttätig, verletzend oder quälerisch zu sein, meist ohne Reue oder Skrupel."
                                        ],
                                        "tags": [
                                            "von Menschen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81e1cf41-c94e-4afb-8e3b-a8159ec47c2b",
                                                "sense_id": "26004f48-2b4f-3158-87ce-bc10678caaf4",
                                                "text": "Er war schon immer ein brutaler Mensch."
                                            },
                                            {
                                                "example_id": "1f91f277-6d09-48f0-986e-dbf5710a403b",
                                                "sense_id": "26004f48-2b4f-3158-87ce-bc10678caaf4",
                                                "text": "„Viele Szenen der aufgefundenen Drehbuchfassung zeigen das brutale Verhalten weißer Großgrundbesitzer Sklaven gegenüber, unter anderem Schläge und emotionale Gewalt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c0b4cbe3-6d02-3649-9803-64a7226df65d",
                                        "entry_id": "bdc25b16-9463-39e1-b4b2-2670fab51382",
                                        "glosses": [
                                            "rücksichtslos, übermäßig und unangebracht gewalttätig, verletzend und quälerisch"
                                        ],
                                        "tags": [
                                            "Handlungen",
                                            "Taten"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6405bcc-5c51-4e56-b956-061e38a0fe0d",
                                                "sense_id": "c0b4cbe3-6d02-3649-9803-64a7226df65d",
                                                "text": "„Viele Szenen der aufgefundenen Drehbuchfassung zeigen das brutale Verhalten weißer Großgrundbesitzer Sklaven gegenüber, unter anderem Schläge und emotionale Gewalt.“"
                                            },
                                            {
                                                "example_id": "218544c1-17da-4c15-82a6-efeb6ad93a73",
                                                "sense_id": "c0b4cbe3-6d02-3649-9803-64a7226df65d",
                                                "text": "„Die schmale Allee wird nach zwei Kilometern von Stacheldraht und Betonklötzen brutal durchtrennt.“"
                                            },
                                            {
                                                "example_id": "50ba45e2-3674-4cdb-9d7d-10dda8d39a09",
                                                "sense_id": "c0b4cbe3-6d02-3649-9803-64a7226df65d",
                                                "text": "Der Aufstand wurde brutal niedergeworfen."
                                            },
                                            {
                                                "example_id": "847bcf67-5ddb-4996-a5d2-7ab56cb7b7ad",
                                                "sense_id": "c0b4cbe3-6d02-3649-9803-64a7226df65d",
                                                "text": "Er war bekannt für seine brutalen Methoden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5de424d2-3faa-442b-ac2a-9546dc2f2e22",
                        "source_entry_id": "bc671d86-27a2-3e9d-90e7-f6b581ad4054",
                        "source_sense_id": "5ffdc0f5-5468-3245-b346-aa7ea9b53bb2",
                        "source_sense_description": "nietsontziend en gewelddadig",
                        "target_lang_word": "rabiat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rabiat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9917d567-72e7-3c3b-93e9-598e4c46a649",
                                        "entry_id": "7eb7a3c7-4340-3342-bec0-e66e689b083f",
                                        "glosses": [
                                            "mit Gewalt vorgehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61bcfef3-ef76-4b2e-8f10-4bb8fb0d4055",
                                                "sense_id": "9917d567-72e7-3c3b-93e9-598e4c46a649",
                                                "text": "Seine Angriffe waren so rabiat, dass es zu schweren Verletzungen kam."
                                            },
                                            {
                                                "example_id": "16822d95-7193-4a9b-95d7-31757b73fbde",
                                                "sense_id": "9917d567-72e7-3c3b-93e9-598e4c46a649",
                                                "text": "„Entsprechend rabiat ging Jermolow vor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d82601cd-4d95-34d1-b9c1-6dd8bef59b32",
                                        "entry_id": "7eb7a3c7-4340-3342-bec0-e66e689b083f",
                                        "glosses": [
                                            "sich ohne Rücksichtnahme ein- oder durchsetzend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8d0d33e-5d49-49cb-9635-1abc5c6b115a",
                                                "sense_id": "d82601cd-4d95-34d1-b9c1-6dd8bef59b32",
                                                "text": "Viele Unternehmen setzen Entlassungen rabiat um."
                                            },
                                            {
                                                "example_id": "ed9128f4-83cd-4b64-a16d-c5f40ed005e3",
                                                "sense_id": "d82601cd-4d95-34d1-b9c1-6dd8bef59b32",
                                                "text": "„Auch gegenüber dem rabiaten Expansionskurs der USA zeigte sich die britische Regierung nachgiebig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
