                        "examples": [
                            {
                                "example_id": "68b51360-8c8d-491f-9259-563568767f62",
                                "sense_id": "85c31e47-b8aa-3795-888b-7cdc9c501637",
                                "text": "Ein Beschreibung eines hethitisch–hurrischen Beschwörungsrituals wird Ašdu, der Hurriterin zugeschrieben."
                            },
                            {
                                "example_id": "24c65f3a-c10a-415f-8633-848abaca16e9",
                                "sense_id": "85c31e47-b8aa-3795-888b-7cdc9c501637",
                                "text": "„Auch den mittelassyrischen königlichen Hof kann man forthin als international bezeichnen – assyrische Königsfrauen waren oft Ausländerinnen (z.B. Babylonierinnen, Hurriterinnen) […]“"
                            }
