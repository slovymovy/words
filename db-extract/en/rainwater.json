                    {
                        "translation_id": "b04eff70-f34f-40a1-9827-7213db9fff34",
                        "source_entry_id": "f7d03c63-d8c1-376f-ab86-28f9574bbbaa",
                        "source_sense_description": "water sourced from rain",
                        "target_lang_word": "regenwater",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "regenwater",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "79bca3de-5355-3295-888a-8f353a8d42db",
                                        "entry_id": "37666e38-a7b7-3faa-afb1-69bd14c3cc0b",
                                        "glosses": [
                                            "water dat in de vorm van regen uit de hemel komt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0736cbe-00ba-4c45-abe8-df7632bf2fa5",
                                                "sense_id": "79bca3de-5355-3295-888a-8f353a8d42db",
                                                "text": "Regenwater opvangen voor hergebruik kan heel gemakkelijk door het installeren van een regenton."
                                            },
                                            {
                                                "example_id": "56095deb-05f9-46bf-a3bd-3d2aacc3dfd3",
                                                "sense_id": "79bca3de-5355-3295-888a-8f353a8d42db",
                                                "text": "Het reservoir is van een fabriek nabij een inmiddels gesloten fosfaatmijn in de buurt van de stad Tampa. Het water is een mix van zout water, gemengd met afval- en regenwater. Volgens het milieudepartement van Florida bevat het verhoogde niveaus van fosfor en stikstof en is het water relatief zuur, maar is het hoogstwaarschijnlijk niet giftig."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "86e8be9e-03ea-44f9-8499-4727ce58d217",
                        "source_entry_id": "f7d03c63-d8c1-376f-ab86-28f9574bbbaa",
                        "source_sense_description": "water sourced from rain",
                        "target_lang_word": "eaux de pluie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "7548a8b8-9c28-4f7d-9c72-d16fa783bedc",
                        "source_entry_id": "f7d03c63-d8c1-376f-ab86-28f9574bbbaa",
                        "source_sense_description": "water sourced from rain",
                        "target_lang_word": "Regenwasser",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Regenwasser",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9297be55-5687-317b-a00a-9e5bdda57ab2",
                                        "entry_id": "e0a51be7-9448-383d-b80c-a0d35078daa8",
                                        "glosses": [
                                            "Wasser aus natürlichem Niederschlag, das nicht durch Gebrauch verunreinigt wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f83b70cb-5530-4335-a978-5a2235d3afc2",
                                                "sense_id": "9297be55-5687-317b-a00a-9e5bdda57ab2",
                                                "text": "Regenwasser kann in meist unterirdischen Zisternen aufgefangen und als Brauch- oder Nutzwasser verwendet werden."
                                            },
                                            {
                                                "example_id": "cd58b644-1c7d-4ae3-a666-df15fed57ce7",
                                                "sense_id": "9297be55-5687-317b-a00a-9e5bdda57ab2",
                                                "text": "„Er setzte sich auf einen Stein, das Regenwasser rann ihm über den Kopf und die Schultern.“"
                                            },
                                            {
                                                "example_id": "16f636dc-0840-490f-be02-75760da4ae0f",
                                                "sense_id": "9297be55-5687-317b-a00a-9e5bdda57ab2",
                                                "text": "„Schmutz und Regenwasser spritzten über ihn und seine Kameraden hin.“"
                                            },
                                            {
                                                "example_id": "3b5e05bc-b908-423c-823a-56f389b5bc9b",
                                                "sense_id": "9297be55-5687-317b-a00a-9e5bdda57ab2",
                                                "text": "„Es hat dann aber furchtbar zu regnen begonnen, und das Regenwasser hat so laut auf das Dach des Campinghauses geprasselt, dass ich wieder Angst bekam.“"
                                            },
                                            {
                                                "example_id": "d1439d9e-279b-43d1-b042-9629a0ce508a",
                                                "sense_id": "9297be55-5687-317b-a00a-9e5bdda57ab2",
                                                "text": "„Götzens ›Schloss‹ verfügte nicht über einen Brunnen, allenfalls über eine Zisterne, in die über Dachrinnen und Rohrleitungen das Regenwasser lief.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
