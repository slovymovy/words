                                            "Schifffahrt"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2cf9f862-07a3-4eb2-8463-f1e7ee6081b4",
                                                "sense_id": "7b7e1f41-f7c0-3613-b1ef-977eeb970f43",
                                                "text": "LeSeur hatte alle Abteilungsleiter zu einer Not-Personalversammlung einberufen, und schon trafen die Leiter der Hotellerie- und Unterhaltungsabteilung, der Purser, der Bootsmann und der Chefsteward ein."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "60308ae0-5dad-3408-90d1-ce8c2f07b1dd",
                                        "entry_id": "a5e3ab5b-0792-3ca9-8f6e-78c0d776d67b",
                                        "glosses": [
                                            "leitender Steward in einem Flugzeug"
                                        ],
                                        "tags": [
                                            "Luftfahrt"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0896b797-a823-42be-a1d1-c68ff649084d",
                                                "sense_id": "60308ae0-5dad-3408-90d1-ce8c2f07b1dd",
                                                "text": "Als Purser führen Sie das Kabinenteam an Bord eines Flugzeuges."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
