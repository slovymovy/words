{
    "word_family": [
        "snoozer",
        "snoozy"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "47f10bdf-f4d9-3b46-b268-90f21736b9d0",
                    "sense_definition": "To sleep lightly, especially for a short period of time.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sleep",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cat likes to <w>snooze</w> in the warm sunshine by the window.",
                            "target_lang_translations": {
                                "ru": "Кошка любит <w>дремать</w> на теплом солнышке у окна."
                            }
                        },
                        {
                            "text": "The manager caught him <w>snoozing</w> at his desk during the meeting.",
                            "target_lang_translations": {
                                "ru": "Менеджер поймал его на том, что он <w>клевал носом</w> за столом во время совещания."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Спать некрепким сном, особенно недолгое время; дремать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дремать",
                                "target_lang_sense_clarification": "некрепко спать"
                            },
                            {
                                "target_lang_word": "вздремнуть",
                                "target_lang_sense_clarification": "поспать немного"
                            },
                            {
                                "target_lang_word": "подремать",
                                "target_lang_sense_clarification": "провести некоторое время в полусне"
                            },
                            {
                                "target_lang_word": "прикорнуть",
                                "target_lang_sense_clarification": "прилечь ненадолго поспать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1aa864ee-1531-39f4-8cdc-a0af3f190714",
                    "sense_definition": "To temporarily silence an alarm or dismiss a notification so that it sounds again later.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "alarm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I usually <w>snooze</w> my alarm twice before finally getting out of bed.",
                            "target_lang_translations": {
                                "ru": "Обычно я дважды <w>откладываю</w> будильник, прежде чем наконец встать с кровати."
                            }
                        },
                        {
                            "text": "You can <w>snooze</w> the calendar notification for ten minutes if you are busy.",
                            "target_lang_translations": {
                                "ru": "Вы можете <w>отложить</w> уведомление календаря на десять минут, если вы заняты."
                            }
                        }
                    ],
                    "common_phrases": [
                        "snooze an alarm"
                    ],
                    "target_lang_definitions": {
                        "ru": "Временно отключить сигнал будильника или уведомление, чтобы оно сработало позже."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "откладывать будильник",
                                "target_lang_sense_clarification": "переносить сигнал будильника на позже"
                            },
                            {
                                "target_lang_word": "отложить",
                                "target_lang_sense_clarification": "перенести сигнал или уведомление на более позднее время"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bf025b80-7f74-3e5c-a3a0-ed61c4f6019c",
                    "sense_definition": "A brief, light sleep; a nap.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sleep",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After a long lunch, he decided to take a quick <w>snooze</w> on the couch.",
                            "target_lang_translations": {
                                "ru": "После долгого обеда он решил устроить себе <w>короткий сон</w> на диване."
                            }
                        },
                        {
                            "text": "I felt much better after having a short <w>snooze</w> before the evening shift.",
                            "target_lang_translations": {
                                "ru": "Мне стало намного лучше после того, как я немного <w>вздремнул</w> перед вечерней сменой."
                            }
                        }
                    ],
                    "common_phrases": [
                        "take a snooze",
                        "have a snooze"
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткий, некрепкий сон; дрёма."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дрёма",
                                "target_lang_sense_clarification": "полусон, дремота"
                            },
                            {
                                "target_lang_word": "дремота",
                                "target_lang_sense_clarification": "сонное состояние"
                            },
                            {
                                "target_lang_word": "короткий сон",
                                "target_lang_sense_clarification": "недолгий сон"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0adad922-aa71-30fc-be44-ad5b1d438f4f",
                    "sense_definition": "A feature or control on an alarm clock or device that temporarily silences an alarm.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "alarm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He rolled over and hit the <w>snooze</w> instead of getting out of bed.",
                            "target_lang_translations": {
                                "ru": "Он перевернулся на другой бок и нажал <w>повтор будильника</w> вместо того, чтобы вставать с кровати."
                            }
                        },
                        {
                            "text": "My phone offers a ten-minute <w>snooze</w> whenever the morning alarm goes off.",
                            "target_lang_translations": {
                                "ru": "Мой телефон предлагает десятиминутный <w>повтор сигнала</w> каждый раз, когда срабатывает утренний будильник."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hit the snooze"
                    ],
                    "target_lang_definitions": {
                        "ru": "Функция или кнопка на будильнике или электронном устройстве, временно отключающая сигнал."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "повтор сигнала",
                                "target_lang_sense_clarification": "кнопка или режим повтора будильника"
                            },
                            {
                                "target_lang_word": "кнопка отсрочки будильника",
                                "target_lang_sense_clarification": "кнопка, переносящая сигнал на позже"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3039434b-10f5-32e9-ae09-3553d4d0e989",
                    "sense_definition": "An event, performance, or object that is extremely boring or uninteresting.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "boring",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lecture was a total <w>snooze</w>, and several students fell asleep.",
                            "target_lang_translations": {
                                "ru": "Лекция была сплошной <w>тоской</w>, и несколько студентов даже уснули."
                            }
                        },
                        {
                            "text": "Critics agreed that the new movie was an absolute <w>snooze</w> from start to finish.",
                            "target_lang_translations": {
                                "ru": "Критики сошлись во мнении, что новый фильм был абсолютной <w>скукотищей</w> от начала и до самого конца."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used casually to describe something very boring"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Крайне скучное, неинтересное или усыпляющее событие, представление или зрелище."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тоска",
                                "target_lang_sense_clarification": "нечто крайне скучное"
                            },
                            {
                                "target_lang_word": "скукотища",
                                "target_lang_sense_clarification": "разг., нестерпимо скучное событие или зрелище"
                            },
                            {
                                "target_lang_word": "усыпляющее зрелище",
                                "target_lang_sense_clarification": "очень нудное мероприятие или фильм"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}