                    "frequency": "VeryLow",
                    "semantic_group_id": "sports_equipment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The skater launched off the ramp and landed smoothly on the <w>tabletop</w>.",
                            "target_lang_translations": {
                                "es": "El skater saltó desde la rampa y aterrizó suavemente en la <w>meseta</w>."
                            }
                        },
                        {
                            "text": "They added a new concrete <w>tabletop</w> to the local skatepark last month.",
                            "target_lang_translations": {
                                "es": "Añadieron un nuevo <w>tabletop</w> de hormigón al skatepark local el mes pasado."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Used in skateboarding and BMX contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Un elemento fijo que se asemeja a una mesa, utilizado para realizar trucos de skate o ciclismo."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "tabletop",
                                "target_lang_sense_clarification": "rampa o obstáculo plano en deportes extremos"
                            },
                            {
                                "target_lang_word": "meseta",
                                "target_lang_sense_clarification": "obstáculo con parte superior plana"
                            }
                        ]
                    }
                }
            ]
        },
        {
