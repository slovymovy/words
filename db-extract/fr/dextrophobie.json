                        "glosses": [
                            "Peur de tout ce qui se situe à droite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4dcc4ff0-ed86-41e0-a3e7-9812aeaba836",
                                "sense_id": "1b45995a-2480-3ae3-ba66-cf4dbd2bd8af",
                                "text": "Dans quelques cas, la phobie est plus appréciable: un malade de Rouzaud présentait par exemple de la dextrophobie; dès qu’une personne marchait à sa droite ou lorsqu’il longeait un mur situé à sa droite, il était pris d'une angoisse qui le clouait sur place."
                            }
                        ]
