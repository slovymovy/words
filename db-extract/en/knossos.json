                                            {
                                                "example_id": "07470afb-98ad-4999-a4aa-408ea2a8c19c",
                                                "sense_id": "d2915534-63ac-3f59-a6c3-78b2f889c59d",
                                                "text": "„Als der englische Archäologe Sir Arthur Evans im Jahre 1900 in Knossos südlich von Heraklion auf der Insel Kreta die umfangreichen Reste einer bronzezeitlichen Palastanlage entdeckte, stieß er in ein noch unerforschtes Kapitel der europäischen Geschichte vor.“"
                                            },
                                            {
                                                "example_id": "3540d8b5-2874-4e84-a8b8-01fde106822b",
                                                "sense_id": "d2915534-63ac-3f59-a6c3-78b2f889c59d",
                                                "text": "„Der bedeutendste Palast lag in Knossos und war möglicherweise das Zentrum eines politisch geeinten Kreta.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
