                                    {
                                        "sense_id": "aa50ac1d-f59b-380a-bd7c-a58a2214c7ce",
                                        "entry_id": "9cd320ff-570b-36b9-b92a-19845749a960",
                                        "glosses": [
                                            "The act of fooling oneself, of willfully not accepting the obvious."
                                        ],
