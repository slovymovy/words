                                            "Physiologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "960d71f7-a4ee-4c0b-9e87-0232f417feaa",
                                                "sense_id": "b4e6e2ca-b643-38cf-a150-ca4ca5c2cb2c",
                                                "text": "„Tagsüber gelten 6-7 Miktionen als normale Miktionsfrequenz.“"
                                            },
                                            {
                                                "example_id": "139f7ada-0fd8-4ec5-a056-302a166ecdc8",
                                                "sense_id": "b4e6e2ca-b643-38cf-a150-ca4ca5c2cb2c",
                                                "text": "„Nachts finden gewöhnlich keine Miktionen statt.“"
                                            },
                                            {
                                                "example_id": "30de370d-0d56-4c31-b5d3-930ce28e2706",
                                                "sense_id": "b4e6e2ca-b643-38cf-a150-ca4ca5c2cb2c",
                                                "text": "„Als Restharn bezeichnet man die Menge an Harn (Urin), die nach einer normalen Miktion in der Harnblase zurückbleibt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
