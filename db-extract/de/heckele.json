                "senses": [
                    {
                        "sense_id": "d0699075-5396-38b0-b4c5-96cdcf20a57b",
                        "entry_id": "339d83ff-2886-3751-ade3-66e754ddeed7",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6bb429f-30b5-48d3-98ba-5ba4e3aa7ace",
                                "sense_id": "d0699075-5396-38b0-b4c5-96cdcf20a57b",
                                "text": "Frau Heckele ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "93a5eab3-e65a-4b76-85a1-d0d2d42ecaf9",
                                "sense_id": "d0699075-5396-38b0-b4c5-96cdcf20a57b",
                                "text": "Herr Heckele wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "a216532c-ba97-420b-8ca3-6cfa9337d054",
                                "sense_id": "d0699075-5396-38b0-b4c5-96cdcf20a57b",
                                "text": "Die Heckeles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "38956416-ca4b-45b7-8fb0-5e9b08f8e67f",
                                "sense_id": "d0699075-5396-38b0-b4c5-96cdcf20a57b",
                                "text": "Der Heckele trägt nie die Schals, die die Heckele ihm strickt."
                            },
                            {
                                "example_id": "63b107d8-bc08-4d25-9184-02a02462a4fb",
                                "sense_id": "d0699075-5396-38b0-b4c5-96cdcf20a57b",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Heckele kommt, geht der Herr Heckele.“"
                            },
                            {
                                "example_id": "c54df2f6-c6a9-4b4e-a3ef-3968f9dc4228",
                                "sense_id": "d0699075-5396-38b0-b4c5-96cdcf20a57b",
                                "text": "Heckele kommt und geht."
                            },
                            {
                                "example_id": "2dc3998a-b60e-4889-b4af-0eb3795917dc",
                                "sense_id": "d0699075-5396-38b0-b4c5-96cdcf20a57b",
                                "text": "Heckeles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
