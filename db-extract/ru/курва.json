                                                "example_id": "ac11dbdb-177e-4023-a324-dd96c17d4448",
                                                "sense_id": "f04dcc52-c355-3150-8114-8ac9ce26d3c7",
                                                "text": "Czekaj, czy ja, kurwa, czegoś nie zapomniałem z domu?"
