                    },
                    {
                        "translation_id": "3708e779-e87b-4f98-b31d-66f90cabd3ae",
                        "source_entry_id": "dec81638-1bad-39d0-81e0-6d19181e9273",
                        "source_sense_id": "fb32efaa-2725-33d5-a97b-1c5486e6ea5c",
                        "source_sense_description": "type of helmet",
                        "target_lang_word": "morion",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "morion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b255278c-603a-365d-b074-1a6c52bb6063",
                                        "entry_id": "9a916033-8150-32bb-a96f-16aff984b9bb",
                                        "glosses": [
                                            "Sorte d’armure de tête plus légère que le casque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "826ba622-c282-443e-8a6b-e631cb1023c7",
                                                "sense_id": "b255278c-603a-365d-b074-1a6c52bb6063",
                                                "text": "Il n’avait qu’un simple morion."
                                            },
                                            {
                                                "example_id": "6cc74feb-32de-42b3-9c4e-144fad126d35",
                                                "sense_id": "b255278c-603a-365d-b074-1a6c52bb6063",
                                                "text": "Sous la camisole de mailles et le morion d'acier, les deux hommes devaient être en nage, mais ils s'abstinrent de toute plainte."
                                            },
                                            {
                                                "example_id": "ddcd4adf-7d5d-4e48-8454-644961440ec5",
                                                "sense_id": "b255278c-603a-365d-b074-1a6c52bb6063",
                                                "text": "Notre troupe comptait en tout une dizaine de blessés, dont trois des nôtres […] Cabusse, d'une balle qui, ayant percé son morion et rasé son cuir chevelu, le faisait saigner comme un boeuf."
                                            },
                                            {
                                                "example_id": "80e0e7dc-fdf0-414e-83cd-d0000440d535",
                                                "sense_id": "b255278c-603a-365d-b074-1a6c52bb6063",
                                                "text": "Il tenait son morion de vache à la main, comme un paysan intimidé devant son propriétaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4896ed6a-0ec7-3e79-9c95-88ee2e417225",
                                        "entry_id": "9a916033-8150-32bb-a96f-16aff984b9bb",
                                        "glosses": [
                                            "Punition militaire qui consistait en des coups de hampe de hallebarde, etc., sur le derrière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48904d37-fd1d-4dc1-b090-84f6f468b8db",
                                                "sense_id": "4896ed6a-0ec7-3e79-9c95-88ee2e417225",
                                                "text": "Donner le morion."
                                            },
                                            {
                                                "example_id": "542e52f9-19bd-438d-9625-c85f548a1c91",
                                                "sense_id": "4896ed6a-0ec7-3e79-9c95-88ee2e417225",
                                                "text": "Que sur peine de morion,\nAutant chevalier que pion,\nPersonne ne mit pied à terre."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "morion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a90c9184-9852-334d-8fdc-3d72a1af324d",
                                        "entry_id": "66a3a357-87a4-3487-b6ce-96504d5f2071",
                                        "glosses": [
                                            "Morelle somnifère."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "527be9e2-8e3a-3a1a-bf5c-3cda14a45926",
                                        "entry_id": "66a3a357-87a4-3487-b6ce-96504d5f2071",
                                        "glosses": [
                                            "variété de quartz d'un noir rougeâtre, transparente et brillante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b9186a9-cc8a-48c1-8309-7e55b723c4fb",
                                                "sense_id": "527be9e2-8e3a-3a1a-bf5c-3cda14a45926",
                                                "text": "MORION, (Hist. nat.) nom donné par Pline & d’autres anciens naturalistes à une pierre noire à l’extérieur, mais qui, tenue entre l’œil & le feu ou une flamme, paroissoit être transparente & d’un beau rouge. On l’appelloit aussi pramnion. Il paroit que c’étoit un crystal ou fluor noir."
                                            },
                                            {
                                                "example_id": "9e813673-6b4f-4ff1-81f8-3a9a66a26d4a",
                                                "sense_id": "527be9e2-8e3a-3a1a-bf5c-3cda14a45926",
                                                "text": "Il existe en ce moment à Berne une collection de morions, ou cristaux enfumés, d'une grande beauté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e0e2e30-725d-3bc2-b439-9119756446b8",
                                        "entry_id": "66a3a357-87a4-3487-b6ce-96504d5f2071",
                                        "glosses": [
                                            "Genre de coléoptère pentamère, voisin du scarite."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "939e21ff-9040-3a90-9d27-68a789794be8",
                                        "entry_id": "66a3a357-87a4-3487-b6ce-96504d5f2071",
                                        "glosses": [
                                            "Genre de coquilles univalves."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "morion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "48853d06-8dbe-392e-b60a-15f0c8e36fe1",
                                        "entry_id": "b9b4798c-92dc-3ca7-831a-d687e50e0331",
                                        "glosses": [
                                            "Bouffon."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b5e3da6-d275-41a4-9340-2eefe9c4f638",
                                                "sense_id": "48853d06-8dbe-392e-b60a-15f0c8e36fe1",
                                                "text": "Morions, s. m. pl. (Hist. anc.) personnages bossus, boiteux, contrefaits, tête pointue, à longues oreilles, & à physionomie ridicule, qu’on admettoit dans les festins, pour amuser les convives. Plus un morion était hideux, plus chèrement il était acheté. Il y en a qui ont été payés jusqu’à 2000 sesterces."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66d217c3-2285-3df0-9296-321a8ec06588",
                                        "entry_id": "b9b4798c-92dc-3ca7-831a-d687e50e0331",
                                        "glosses": [
                                            "Bouffon.",
                                            "Orchis bouffon (Anacamptis morio)."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
