                        "translation_id": "1525000d-26c7-4738-a586-a18fe0f86b6d",
                        "source_entry_id": "b939ffec-b56d-3bd4-be9d-b26ab0b26281",
                        "source_sense_id": "694938e5-0564-3979-8683-dfe8453c5fae",
                        "source_sense_description": "lamp(en) aan de achterkant van een voertuig",
                        "target_lang_word": "Rücklicht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rücklicht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "11c62a0f-34fc-3702-9a9e-33f4ab05b203",
                                        "entry_id": "1a53d718-6a4c-3afb-8ab6-1f911c8f7c74",
                                        "glosses": [
                                            "an Fahrzeugen angebrachte Beleuchtung an der Rückseite"
                                        ],
                                        "tags": [
                                            "Fahrzeugtechnik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27c27176-c2bb-4a39-a8b9-4d43e732f361",
                                                "sense_id": "11c62a0f-34fc-3702-9a9e-33f4ab05b203",
                                                "text": "Eines der Rücklichter an deinem Wagen leuchtet nicht mehr, du musst es reparieren."
                                            },
                                            {
                                                "example_id": "6c06cf18-e6b0-4e5a-b4f7-e25b64762801",
                                                "sense_id": "11c62a0f-34fc-3702-9a9e-33f4ab05b203",
                                                "text": "„Es ist noch früh und noch dunkel; die Rücklichter der vorausfahrenden Autos spiegeln sich zitternd auf dem nassen Asphalt.“"
                                            },
                                            {
                                                "example_id": "e1a7f48b-4a2a-4d57-a19a-d2e9a7f6b2dd",
                                                "sense_id": "11c62a0f-34fc-3702-9a9e-33f4ab05b203",
                                                "text": "„Die kurvige Straße war kaum befahren, wir hatten seit einer Weile keine anderen Scheinwerfer oder Rücklichter mehr gesehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7ff5d766-0c9f-4e18-b9bf-d01156ad2c07",
                        "source_entry_id": "b939ffec-b56d-3bd4-be9d-b26ab0b26281",
