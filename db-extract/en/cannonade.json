    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "ed587ccc-64bc-37b0-a0f2-72554e153996",
                "word": "cannonade",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "a8af47c9-bfbf-4e70-9de4-6d5928dabf64",
                        "entry_id": "ed587ccc-64bc-37b0-a0f2-72554e153996",
                        "tags": [
                            "plural"
                        ],
                        "form": "cannonades"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0056e926-347e-360b-afad-fdc3b3c76cc6",
                        "entry_id": "ed587ccc-64bc-37b0-a0f2-72554e153996",
                        "glosses": [
                            "The firing of artillery for a length of time."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17001be4-55a0-44ff-9a0f-9aaca6657031",
                                "sense_id": "0056e926-347e-360b-afad-fdc3b3c76cc6",
                                "text": "A furious cannonade was kept up from the whole circle of batteries on the devoted town."
                            }
                        ]
                    },
                    {
                        "sense_id": "9cf4cdf0-c243-3954-92a6-403ce906ba37",
                        "entry_id": "ed587ccc-64bc-37b0-a0f2-72554e153996",
                        "glosses": [
                            "A loud noise like a cannonade; a booming."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "4c8e18e2-2334-48c5-8f8e-3f3697306441",
                                "sense_id": "9cf4cdf0-c243-3954-92a6-403ce906ba37",
                                "text": "Not for a regiment's parade, / Nor evil laws or rulers made, / Blue Walden rolls its cannonade, […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5821efb5-70f9-4dce-b056-692a530d91f9",
                        "source_entry_id": "ed587ccc-64bc-37b0-a0f2-72554e153996",
                        "source_sense_description": "firing of artillery",
                        "target_lang_word": "canonnade",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "canonnade",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1c896a76-8416-3d6d-9ca4-88b1089070c7",
                                        "entry_id": "62fc4a32-0905-302f-b772-22c65324c62b",
                                        "glosses": [
                                            "Tir simultané de plusieurs canons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5986f67a-1c06-40e1-a0b3-aa2232be80df",
                                                "sense_id": "1c896a76-8416-3d6d-9ca4-88b1089070c7",
                                                "text": "A l'exception de quelques traînards, ses troupes se trouvaient déjà entre Chaumont-Porcien et Seraincourt, quand une canonnade éclatant sur ses derrières vient annoncer l'arrivée des Allemands devant la première de ces localités."
                                            },
                                            {
                                                "example_id": "51cc5e5c-f4c4-46a1-8db5-2cf45cf75cec",
                                                "sense_id": "1c896a76-8416-3d6d-9ca4-88b1089070c7",
                                                "text": "La canonnade de Valmy retentissait encore à l’heure où se réunissait la Convention nationale, le 21 septembre 1792."
                                            },
                                            {
                                                "example_id": "7b8957a1-04fa-43a7-885c-88283b898de0",
                                                "sense_id": "1c896a76-8416-3d6d-9ca4-88b1089070c7",
                                                "text": "Vers huit heures, la canonnade est si violente que la brume se lève."
                                            },
                                            {
                                                "example_id": "574b3eca-d6ae-4811-beb6-ecb23e0de96b",
                                                "sense_id": "1c896a76-8416-3d6d-9ca4-88b1089070c7",
                                                "text": "Les Français qui étaient sortis de l'Argonne, avaient occupé la colline de Valmy d'où ils canonnèrent les Prussiens. Brunswick dut livrer contre eux une bataille à front renversé ; il fut surpris par l'allant des Français et la vigueur de leur canonnade."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93c07225-36cf-3e09-a19b-15e6179382f0",
                                        "entry_id": "62fc4a32-0905-302f-b772-22c65324c62b",
                                        "glosses": [
                                            "Suite d'éléments servant à faire une attaque."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8182aa16-6673-41c7-a26c-b8ff5042891f",
                                                "sense_id": "93c07225-36cf-3e09-a19b-15e6179382f0",
                                                "text": "Un moment désarçonnés par une attaque aussi inattendue, ils répliquent par une canonnade de cinq articles signés « Un ultramontain »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a3a5a0a9-e82b-4c39-89e0-c3f164e8be10",
                        "source_entry_id": "ed587ccc-64bc-37b0-a0f2-72554e153996",
                        "source_sense_description": "firing of artillery",
                        "target_lang_word": "Kanonade",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kanonade",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b707c98c-2946-3f7c-8851-53e1006d5138",
                                        "entry_id": "f990687a-bb54-37f5-9502-2bdbdf37de9d",
                                        "glosses": [
                                            "anhaltender, dauerhafter Beschuss durch Geschütze"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dcf20fad-3cb5-4291-a857-703c272739c4",
                                                "sense_id": "b707c98c-2946-3f7c-8851-53e1006d5138",
                                                "text": "„Bei dieser 14-stündigen gigantischen Kanonade wurden auf deutscher Seite mehr als 3500 Schuss abgefeuert, auf britischer Seite sogar mehr als 4500.“"
                                            },
                                            {
                                                "example_id": "8186c25d-dc59-4f5a-b674-5b3c6c7fdbd0",
                                                "sense_id": "b707c98c-2946-3f7c-8851-53e1006d5138",
                                                "text": "„Es kam zu der bekannten erfolglosen Kanonade bei Valmy, nach der sich die preußischen Truppen wieder an den Rhein zurückzogen.“"
                                            },
                                            {
                                                "example_id": "bbb269db-14c2-4ad4-9686-e4d139305fe0",
                                                "sense_id": "b707c98c-2946-3f7c-8851-53e1006d5138",
                                                "text": "„Als das Licht des neuen Tages durchdringt, wird die Stille durch eine ungeheure Kanonade zerrissen.“"
                                            },
                                            {
                                                "example_id": "4e782a02-9376-4be0-9d74-0e65af59495d",
                                                "sense_id": "b707c98c-2946-3f7c-8851-53e1006d5138",
                                                "text": "„Sie standen untätig herum, genossen die Aussicht über das Tal und sprachen von der gewaltigen Kanonade von Eylau, an der die Batterie teilgenommen hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9f395cea-7eb0-32b8-9408-d63f9270381f",
                                        "entry_id": "f990687a-bb54-37f5-9502-2bdbdf37de9d",
                                        "glosses": [
                                            "eine große Menge von etwas"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
