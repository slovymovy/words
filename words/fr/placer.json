            "senses": [
                {
                    "sense_id": "529097ae-b851-301b-a868-9c25dc9bcdc7",
                    "sense_definition": "Mettre ou disposer une personne ou une chose dans un endroit précis.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "positionnement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a <w>placé</w> les assiettes sur la grande table de la cuisine avant le repas."
                        },
                        {
                            "text": "Ces documents sont importants, il faut les <w>placer</w> soigneusement dans le tiroir du bureau."
                        }
                    ],
                    "synonyms": [
