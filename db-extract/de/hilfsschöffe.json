                "senses": [
                    {
                        "sense_id": "0ea5a86d-c32f-3a0f-9fa2-1c6b4d239982",
                        "entry_id": "584455f7-2bac-37f5-94e6-6f7d39cd8c10",
                        "glosses": [
                            "Schöffe (Laienrichter), der bei Verhinderung eines Hauptschöffen nachrückt und dessen Aufgaben übernimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6ad134f-cb57-4fb1-8501-e70bc45f3ed2",
                                "sense_id": "0ea5a86d-c32f-3a0f-9fa2-1c6b4d239982",
                                "text": "„‚Auch der Laienrichter muss voll da sein während des Prozesses. Schläft er, kann das einen Revisionsgrund darstellen‘, sagte der Sprecher. Daher sei ein Hilfsschöffe kurzfristig eingesprungen und das Gericht habe noch einmal von vorn verhandelt.“"
                            },
                            {
                                "example_id": "b1fceddc-29a8-46cf-abda-6c1b8decea82",
                                "sense_id": "0ea5a86d-c32f-3a0f-9fa2-1c6b4d239982",
                                "text": "„Werden Hauptschöffen von der Schöffenliste gestrichen, so treten die Hilfsschöffen, die nach der Reihenfolge der Hilfsschöffenliste an nächster Stelle stehen, […] an die Stelle der gestrichenen Hauptschöffen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
