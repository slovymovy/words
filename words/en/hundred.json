            "senses": [
                {
                    "sense_id": "ffe979e3-0950-3971-b3ec-e340af02090e",
                    "sense_definition": "A numerical value equal to 100; ten times ten.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "number_value",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There are one <w>hundred</w> centimeters in a meter.",
                            "target_lang_translations": {
                                "ru": "В одном метре <w>сто</w> сантиметров.",
                                "zh": "一米有<w>一百</w>厘米。"
                            }
                        },
                        {
                            "text": "She has collected over a <w>hundred</w> books on the subject.",
                            "target_lang_translations": {
                                "ru": "Она собрала более <w>ста</w> книг по этой теме.",
                                "zh": "她收集了超过<w>一百</w>本关于这个主题的书。"
                            }
                        }
                    ],
                    "synonyms": [
                        "one hundred"
                    ],
                    "common_phrases": [
                        "hundreds of",
                        "a few hundred",
                        "one hundred percent"
                    ],
                    "target_lang_definitions": {
                        "ru": "Числовое значение, равное 100; десять раз по десять.",
                        "zh": "数值等于100的数字；十个十。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сто",
                                "target_lang_sense_clarification": "числительное"
                            },
                            {
