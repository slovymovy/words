                                "target_senses": [
                                    {
                                        "sense_id": "18ed060c-4d5f-3bf3-9b71-61401c7c3b57",
                                        "entry_id": "1f9164eb-f2a1-39c7-8748-84e6c313690f",
                                        "glosses": [
                                            "религ. учение о переселении души умершего во вновь родившийся организм"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3e79503-fdf1-421b-80e8-f1de309c75ea",
                                                "sense_id": "18ed060c-4d5f-3bf3-9b71-61401c7c3b57",
                                                "text": "Для восточных верований в метемпсихоз плоть человека не имеет никакого значения; душа человека может перейти в кошку, и потому нет смысла жизни, смысла земной истории, так как смысл этот тесно связан с утверждением безусловного значения плоти."
                                            }
                                        ]
                                    }
                                ]
                            }
