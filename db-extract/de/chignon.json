                        "translation_id": "1bfd7b1d-93f5-4ed3-a780-be07bee50150",
                        "source_entry_id": "049aa1cc-f259-34f0-8918-f5e7ee58d523",
                        "source_sense_id": "f6f95f3b-e763-3d55-a4d8-2d6e3e576d1a",
