                "senses": [
                    {
                        "sense_id": "0506f49e-d0f8-3956-8315-8a006f3c0048",
                        "entry_id": "350301d2-1bde-3ec9-9dc6-673a852c2986",
                        "glosses": [
                            "met veel kracht trappen"
                        ],
                        "tags": [
                            "informal",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "2820c0aa-5a40-42ae-99bb-12b312c70a8f",
                                "sense_id": "0506f49e-d0f8-3956-8315-8a006f3c0048",
                                "text": "„We weten dat hij een goede trap heeft”, vertelde Pennings. „Maar vaak als Roycel een vrije trap nam, ging de bal met een boogje naar het doel. Wel richting de hoek, maar meestal kon de keeper de bal dan vrij gemakkelijk pakken. Romeo van Aerde (assistent-trainer) en ik hebben hem eens gezegd: ‘Peer hem nou eens loeihard naar de goal.’”"
                            },
                            {
                                "example_id": "0d6f9f1e-a809-4dda-966a-affe9db6f458",
                                "sense_id": "0506f49e-d0f8-3956-8315-8a006f3c0048",
                                "text": "⧖ Na een der aanvallen van Ajax krijgen we een worsteling van Knappert met een der D.V.S.'ers, Knappert blijft echter meester van den bal en peert hem plotseling hard in 't net."
                            }
                        ]
                    }
