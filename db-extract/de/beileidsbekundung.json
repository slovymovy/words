                "senses": [
                    {
                        "sense_id": "c78f0453-89d7-35af-a403-e6d38b9eda66",
                        "entry_id": "0271fff6-5893-3494-a76e-754ca5e041ba",
                        "glosses": [
                            "Ausdruck der Anteilnahme gegenüber den Betroffenen im Fall des Todes eines Angehörigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b3853eb-3c34-44d1-abb2-209a4d76a21f",
                                "sense_id": "c78f0453-89d7-35af-a403-e6d38b9eda66",
                                "text": "„David Camerons Beileidsbekundung ließ nicht lange auf sich warten. Südafrikas Präsident Jacob Zuma hatte gerade erst den Tod Nelson Mandelas verkündet, da twitterte der britische Premier schon: ‚Ein großes Licht in der Welt ist erloschen. Nelson Mandela war ein Held unserer Zeit‘, schrieb Cameron. Er war damit der erste ausländische Regierungschef, der öffentlich seine Anteilnahme über den Tod Mandelas äußerte.“"
                            },
                            {
                                "example_id": "25ae343d-473e-429f-9318-3be9094d4b75",
                                "sense_id": "c78f0453-89d7-35af-a403-e6d38b9eda66",
                                "text": "„Als Großmutter starb, brachte ich es nicht über mich, irgendetwas zu dir zu sagen, nicht einmal eine trockene Beileidsbekundung.“"
                            },
                            {
                                "example_id": "bc87bd55-1632-4247-9a48-8ec20cf6bd4b",
                                "sense_id": "c78f0453-89d7-35af-a403-e6d38b9eda66",
                                "text": "„Sie ergriff seine Hand und legte ihre andere darüber, fast wie zu einer Beileidsbekundung.“"
                            },
                            {
                                "example_id": "71a33219-6f39-4061-b700-8865c2dae576",
                                "sense_id": "c78f0453-89d7-35af-a403-e6d38b9eda66",
                                "text": "„Anteilnahme zeigte er, als Präsident Lincoln und seine Frau Mary 1862 ihren kleinen Sohn Willie durch eine Infektionskrankheit verloren; Pierce schrieb eine sehr persönliche, einfühlsame Beileidsbekundung an das Paar.“"
                            },
                            {
                                "example_id": "813e5ad7-5998-4a3d-8929-92fa592e4278",
                                "sense_id": "c78f0453-89d7-35af-a403-e6d38b9eda66",
                                "text": "„Douglas Ingrams Angehörige warfen Erde und Blumen auf seinen Sarg, um anschließend die Beileidsbekundungen der hier Versammelten entgegenzunehmen.“"
                            },
                            {
                                "example_id": "970b6da1-74aa-483c-9665-919a1e5434a4",
                                "sense_id": "c78f0453-89d7-35af-a403-e6d38b9eda66",
                                "text": "„Jeder mitfühlende oder besorgte Satz und jede Beileidsbekundung, die ihm nun in den Sinn kam, hätte zu weit mehr geführt, als er ihr geben konnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
