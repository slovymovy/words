                                    {
                                        "sense_id": "61f8a3e2-d06c-3931-bd00-f43e4eca24d2",
                                        "entry_id": "b9ce5fa4-0a70-3935-aea3-804b588e2bbf",
                                        "glosses": [
                                            "Pays qui était sous la domination d’un comte palatin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ca542f7-7127-4ada-823c-18d11b6c4a75",
                                                "sense_id": "61f8a3e2-d06c-3931-bd00-f43e4eca24d2",
                                                "text": "Le Palatinat du Rhin."
                                            },
                                            {
                                                "example_id": "444dbf0f-c04d-4aa7-9073-77c98739c6f5",
                                                "sense_id": "61f8a3e2-d06c-3931-bd00-f43e4eca24d2",
                                                "text": "Je pris congé de lui le lendemain pour continuer mes explorations dans le nord du Palatinat."
                                            },
                                            {
                                                "example_id": "bd4f2bc0-b363-40bf-9946-7d7359956406",
                                                "sense_id": "61f8a3e2-d06c-3931-bd00-f43e4eca24d2",
                                                "text": "Lorsqu’il arriva, embrassant l’immense horizon bleuâtre du regard, avec toutes les cimes inférieures, les vallées verdoyantes, les rochers et les pics, et la plaine du Palatinat sur sa gauche à perte de vue, en un coup d’œil il reconnut tous les postes et l’état de la chasse."
                                            },
                                            {
                                                "example_id": "046c93e7-3c77-4e66-b202-01ad6f851fda",
                                                "sense_id": "61f8a3e2-d06c-3931-bd00-f43e4eca24d2",
                                                "text": "Les villes du Palatinat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7c26c8e-8034-3f3c-8326-e3460dd2259b",
                                        "entry_id": "b9ce5fa4-0a70-3935-aea3-804b588e2bbf",
                                        "glosses": [
                                            "Pays qui était sous la domination d’un comte palatin.",
                                            "Comté palatin du Rhin (en allemand : Kurpfalz), État historique du Saint-Empire romain germanique, aujourd'hui réparti entre les länder de Bade-Wurtemberg et de Rhénanie-Palatinat."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7e7c8214-8d34-3545-93c5-4e70b79e179d",
                                        "entry_id": "b9ce5fa4-0a70-3935-aea3-804b588e2bbf",
                                        "glosses": [
                                            "Pays qui était sous la domination d’un comte palatin.",
                                            "Région d'Allemagne occidentale (en allemand : Pfalz ou Rheinpfalz), comprise dans le land de Rhénanie-Palatinat."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
