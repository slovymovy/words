                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4f8ead27-c828-31cd-8b81-63871d229a6a",
                                        "entry_id": "aa2e7208-04eb-3ca6-a226-1d1edf17339c",
                                        "glosses": [
                                            "Facing in the other direction."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "631c4d94-621b-40c7-8e64-3b96f7a6dfee",
                                                "sense_id": "4f8ead27-c828-31cd-8b81-63871d229a6a",
                                                "text": "They were moving in opposite directions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "965cae17-8517-3ebd-acbe-9b38816c0eda",
                                        "entry_id": "aa2e7208-04eb-3ca6-a226-1d1edf17339c",
                                        "glosses": [
                                            "Of either of two complementary or mutually exclusive things."
                                        ],
                                        "tags": [
