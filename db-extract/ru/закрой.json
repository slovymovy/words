                "senses": [
                    {
                        "sense_id": "459a5209-0574-383e-9237-55b4fc2ea0df",
                        "entry_id": "19f114f1-08fb-3ea6-9b9a-23a5221e4e91",
                        "glosses": [
                            "спец. действие по значению гл. закроить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f8d91dd-02f2-4bff-813c-c0557801ad71",
                                "sense_id": "459a5209-0574-383e-9237-55b4fc2ea0df",
                                "text": "Изменение технологии закроя женских блузок позволило пересмотреть нормы времени и снизить трудоемкость…"
                            },
                            {
                                "example_id": "57b406c6-4ce9-4ce8-afb8-8a0861391e7d",
                                "sense_id": "459a5209-0574-383e-9237-55b4fc2ea0df",
                                "text": "Высокую экономическую эффективность дал ввод в эксплуатацию четырех механизированных поточных линий каландрования и закроя деталей клееной и формовой обуви."
                            }
                        ]
                    },
