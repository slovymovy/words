                {
                    "sense_id": "b16a50f2-61c1-32f5-9c05-b042853e349a",
                    "sense_definition": "erklären oder beweisen, dass eine Information, Aussage oder Vermutung wahr und zutreffend ist",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "verifizieren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die neuen Untersuchungsergebnisse <w>bestätigen</w> unsere ursprüngliche Vermutung eindeutig."
                        },
                        {
                            "text": "Der Zeuge konnte die Angaben der Polizei vor Gericht vollständig <w>bestätigen</w>."
                        }
                    ],
                    "synonyms": [
                        "bekräftigen",
                        "verifizieren",
                        "bejahen"
                    ],
                    "antonyms": [
                        "widerlegen",
                        "entkräften",
                        "falsifizieren"
                    ],
                    "common_phrases": [
