                                        "sense_id": "e8067b87-fde5-3393-9af0-7aac28e24ee1",
                                        "entry_id": "e2baaa80-9f09-3c29-b7b7-aeb8748ed3a7",
                                        "glosses": [
                                            "rozšíření cévy nebo srdce na místě, kde byla stěna oslabena chorobou"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01356491-fbc4-425c-a20c-5bf3f684d179",
                                                "sense_id": "e8067b87-fde5-3393-9af0-7aac28e24ee1",
                                                "text": "Aneurysma nehmatám."
                                            },
                                            {
                                                "example_id": "270e8e42-aa05-4860-9785-30db07748685",
                                                "sense_id": "e8067b87-fde5-3393-9af0-7aac28e24ee1",
                                                "text": "Příčinou úmrtí pravnučky posledního českého krále Karla I. Habsburského (1887–1922) bylo podle lékařů aneurysma srdce."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "648880d3-fcff-48aa-bf7a-caebc9e1f742",
                        "source_entry_id": "812c0c71-eefa-3da3-88de-c6ed89a27352",
                        "source_sense_id": "8a92c9bb-b07a-3d45-aaa5-3ebaa3093c6d",
                        "source_sense_description": "abnormal blood-filled swelling",
                        "target_lang_word": "aneurysma",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aneurysma",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "cfad6717-2885-3778-94f4-a38eb0f80a16",
                                        "entry_id": "3824e33b-abe3-37c8-93a1-62d94a457d5e",
                                        "glosses": [
                                            "een ziekelijke verwijding in een slagader"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9460946b-d129-4d32-874e-cddd4e04eea6",
                                                "sense_id": "cfad6717-2885-3778-94f4-a38eb0f80a16",
                                                "text": "Nadat ik dat allemaal had verteld waren we een hele poos stil, tot hij ten slotte zei: 'Mijn moeder heeft na haar aneurysma iets van een halfjaar in het ziekenhuis gelegen."
                                            },
                                            {
                                                "example_id": "88735aed-397b-46fb-aa94-baeda01383e5",
                                                "sense_id": "cfad6717-2885-3778-94f4-a38eb0f80a16",
                                                "text": "'Mijn moeder is al jaren dood' En zo is het. Aneurysma. Eén geknapte ader en boem. Het vogeltje lag op haar kant. Beter zo, zeiden de mensen. Beter zo, zei ik. En dat was dat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9f3fc734-a7bc-456d-818a-62f9fb13d033",
                        "source_entry_id": "812c0c71-eefa-3da3-88de-c6ed89a27352",
                        "source_sense_id": "8a92c9bb-b07a-3d45-aaa5-3ebaa3093c6d",
                        "source_sense_description": "abnormal blood-filled swelling",
                        "target_lang_word": "aderverwijding",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "9934d7ff-a86c-4bdd-9bca-7c41a05507a9",
                        "source_entry_id": "812c0c71-eefa-3da3-88de-c6ed89a27352",
                        "source_sense_id": "8a92c9bb-b07a-3d45-aaa5-3ebaa3093c6d",
                        "source_sense_description": "abnormal blood-filled swelling",
                        "target_lang_word": "anévrisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anévrisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5e591ca4-c3ca-3986-8e52-a9aa683d1e5e",
                                        "entry_id": "c6c008ec-60b5-32e6-853f-c2047d7ae000",
                                        "glosses": [
                                            "Tumeur produite sur le trajet d’une artère par la dilatation des membranes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bac75394-57f2-4d11-8d11-61cb9a63207d",
                                                "sense_id": "5e591ca4-c3ca-3986-8e52-a9aa683d1e5e",
                                                "text": "L’autopsie à laquelle on a procédé sur-le-champ a démontré que cette mort était due à la rupture d’un anévrisme à son dernier période."
                                            },
                                            {
                                                "example_id": "b78dcad4-6784-4a49-a7e6-015e0717de5e",
                                                "sense_id": "5e591ca4-c3ca-3986-8e52-a9aa683d1e5e",
                                                "text": "Je me rappelle, à la Charité, un malheureux atteint d’un énorme anévrisme de l’aorte, lequel avait rongé peu à peu la cage thoracique et battait sous la peau. Nous attendions, d’une minute à l’autre, l`issue fatale."
                                            },
                                            {
                                                "example_id": "8d3da1f6-6c6f-432f-9827-ed8bb993b85e",
                                                "sense_id": "5e591ca4-c3ca-3986-8e52-a9aa683d1e5e",
                                                "text": "Le curé ne s’en effrayait pas pour les enfants, mais bien pour les vieux, qui risquaient d’être emportés par une rupture d’anévrisme ou de n’importe quoi, avec un noir péché sur la conscience."
                                            },
                                            {
                                                "example_id": "a1a291b0-d8eb-46ca-af8f-ab5ab4cdcaad",
                                                "sense_id": "5e591ca4-c3ca-3986-8e52-a9aa683d1e5e",
                                                "text": "Pépé-Salpêtre, ayant accroché sa ligne par mégarde, avait sans doute essayé de la dégager, puis, n'y réussissant pas, s’était subitement mis en colère, avait esquissé un grand geste pour tout rompre, et s’était effectivement rompu du coup son gut et son anévrisme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "772927d6-f461-36b3-bdd3-d6f6c2b315cd",
                                        "entry_id": "c6c008ec-60b5-32e6-853f-c2047d7ae000",
                                        "glosses": [
                                            "Lésion des veines et des artères."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bff4c26c-97d5-3949-9bfb-884090c509ee",
                                        "entry_id": "c6c008ec-60b5-32e6-853f-c2047d7ae000",
                                        "glosses": [
                                            "Dilatation morbide du cœur."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca4cfcb8-a6cb-44dc-acee-6b011608010c",
                                                "sense_id": "bff4c26c-97d5-3949-9bfb-884090c509ee",
                                                "text": "Diplomate, un anévrisme suspend dans votre cœur la mort à un fil."
                                            },
                                            {
                                                "example_id": "838fecb4-652f-4ac4-866f-11caad52be05",
                                                "sense_id": "bff4c26c-97d5-3949-9bfb-884090c509ee",
                                                "text": "Mon père venait de mourir d’un anévrisme dont il souffrait depuis longtemps, et ce fut moi qui reçus la lettre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "698f0be5-5710-4919-ae41-a5042738c2b8",
                        "source_entry_id": "812c0c71-eefa-3da3-88de-c6ed89a27352",
                        "source_sense_id": "8a92c9bb-b07a-3d45-aaa5-3ebaa3093c6d",
                        "source_sense_description": "abnormal blood-filled swelling",
                        "target_lang_word": "anévrysme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anévrysme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "299ae842-31bf-3904-8dc6-7ce492fa3b82",
                                        "entry_id": "0309f0c4-84e6-3471-9023-7c8f46a277a4",
                                        "glosses": [
                                            "Variante de anévrisme."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cdd66709-c89c-48de-8bae-1bb1e652e314",
                                                "sense_id": "299ae842-31bf-3904-8dc6-7ce492fa3b82",
                                                "text": "Ainsi, il paraît logique d’anticoaguler les patients présentant une cardiopathie à haut risque de récidive embolique : prothèses valvulaires mécaniques, valvulopathies mitrales, infarctus du myocarde récent, cardiomyopathies dilatées, anévrysmes ventriculaires, fibrillation auriculaire non rhumatismale associée à un thrombus intracavitaire."
                                            },
                                            {
                                                "example_id": "8bfd6926-b2f2-4e68-a362-be9a73a02ec4",
                                                "sense_id": "299ae842-31bf-3904-8dc6-7ce492fa3b82",
                                                "text": "La paroi postérieure du cœur droit présentait une ulcération profonde qui s’était convertie en un anévrysme partiel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7d588df0-b2c8-4803-ad8b-37909f233d97",
                        "source_entry_id": "812c0c71-eefa-3da3-88de-c6ed89a27352",
                        "source_sense_id": "8a92c9bb-b07a-3d45-aaa5-3ebaa3093c6d",
                        "source_sense_description": "abnormal blood-filled swelling",
