                "senses": [
                    {
                        "sense_id": "87de166c-7d51-30b4-8e29-b8cf7f42fcf1",
                        "entry_id": "ceca4826-0047-3ba7-b94b-f9cb1b97a39e",
                        "glosses": [
                            "Donner un caractère furtif à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34cf7c18-b74b-436e-8dc6-a6c9bd3ca778",
                                "sense_id": "87de166c-7d51-30b4-8e29-b8cf7f42fcf1",
                                "text": "De par sa conception un drone est plus fin qu'un chasseur, autant en profiter et le furtiviser au maximum."
                            },
                            {
                                "example_id": "24d20462-4027-41ce-937f-6e26fcb42ba5",
                                "sense_id": "87de166c-7d51-30b4-8e29-b8cf7f42fcf1",
                                "text": "Furtiviser les navires de combat est-ce raisonnable ?"
                            },
                            {
                                "example_id": "1f1062e1-3768-4482-bbf2-34fa1b66e7a4",
                                "sense_id": "87de166c-7d51-30b4-8e29-b8cf7f42fcf1",
                                "text": "On voit mal en revanche comment “furtiviser” les hélicoptères, matériels dont tous les conflits depuis la “seconde guerre d’Indochine” ont montré la vulnérabilité par rapport à celles des avions, à nombre de sorties égal, (pendant la guerre du Golfe, 31 hélicoptères américains y ont été perdus contre 34 avions, pour un taux de sortie presque dix fois moindre)."
                            }
                        ]
                    }
