{
    "word_family": [
        "divorcé",
        "divorcée",
        "divorcement"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b103ed09-f0ff-3d28-93b5-8ccc33e04ef4",
                    "sense_definition": "The legal dissolution of a marriage.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "legal_marriage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Richard obtained a <w>divorce</w> from his wife some years ago.",
                            "target_lang_translations": {
                                "ru": "Ричард получил <w>развод</w> со своей женой несколько лет назад.",
                                "zh": "理查德几年前与妻子<w>离婚</w>了。"
                            }
                        },
                        {
                            "text": "Many unhappy couples decide to file for <w>divorce</w> after counseling fails.",
                            "target_lang_translations": {
                                "ru": "Многие несчастные пары решают подать на <w>развод</w>, когда консультации не помогают.",
                                "zh": "许多不幸福的夫妻在咨询无效后决定申请<w>离婚</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "marriage"
                    ],
                    "common_phrases": [
                        "file for divorce",
                        "get a divorce",
                        "end in divorce",
                        "divorce papers"
                    ],
                    "target_lang_definitions": {
                        "ru": "Юридическое расторжение брака.",
                        "zh": "婚姻关系的法律解除。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "развод",
                                "target_lang_sense_clarification": "расторжение брака"
                            },
                            {
                                "target_lang_word": "расторжение брака",
                                "target_lang_sense_clarification": "официальный термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "离婚",
                                "target_lang_sense_clarification": "解除婚姻关系"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a88b4778-237a-3bab-812e-24d4411b5ab2",
                    "sense_definition": "A separation of connected things.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "abstract_separation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>divorce</w> of a product from its manufacturing process is common in modern retail.",
                            "target_lang_translations": {
                                "ru": "<w>Отделение</w> продукта от процесса его производства является обычным явлением в современной розничной торговле.",
                                "zh": "在现代零售业中，产品与其制造过程的<w>脱节</w>是很常见的。"
                            }
                        },
                        {
                            "text": "There is often a <w>divorce</w> between what politicians say and what they actually do.",
                            "target_lang_translations": {
                                "ru": "Часто существует <w>разрыв</w> между тем, что говорят политики, и тем, что они делают на самом деле.",
                                "zh": "政客们的言行之间往往存在<w>脱节</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "separation",
                        "severance",
                        "partition"
                    ],
                    "common_phrases": [
                        "divorce from reality",
                        "divorce of ownership"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разделение связанных вещей или понятий.",
                        "zh": "事物或概念之间的分离或脱节。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разрыв",
                                "target_lang_sense_clarification": "отсутствие связи, несоответствие"
                            },
                            {
                                "target_lang_word": "отделение",
                                "target_lang_sense_clarification": "обособление"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "脱节",
                                "target_lang_sense_clarification": "事物之间失去联系"
                            },
                            {
                                "target_lang_word": "分离",
                                "target_lang_sense_clarification": "事物被分开"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7ab0b95d-eeb9-35c7-8bc1-f1858a6a527d",
                    "sense_definition": "To end one's own marriage to a person legally.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "legal_action_personal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Lucy <w>divorced</w> Steve when she discovered that he had been unfaithful.",
                            "target_lang_translations": {
                                "ru": "Люси <w>развелась</w> со Стивом, когда узнала, что он был неверен.",
                                "zh": "露西发现史蒂夫不忠后，便与他<w>离婚</w>了。"
                            }
                        },
                        {
                            "text": "She wants to <w>divorce</w> her husband, but they have to sort out the finances first.",
                            "target_lang_translations": {
                                "ru": "Она хочет <w>развестись</w> с мужем, но сначала им нужно разобраться с финансами.",
                                "zh": "她想和丈夫<w>离婚</w>，但他们得先处理好财务问题。"
                            }
                        }
                    ],
                    "synonyms": [
                        "split up",
                        "separate from"
                    ],
                    "antonyms": [
                        "marry"
                    ],
                    "common_phrases": [
                        "divorce one's husband",
                        "divorce one's wife"
                    ],
                    "target_lang_definitions": {
                        "ru": "Юридически расторгнуть свой брак с кем-либо.",
                        "zh": "在法律上结束自己的婚姻关系。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "развестись",
                                "target_lang_sense_clarification": "расторгнуть брак (сов. вид)"
                            },
                            {
                                "target_lang_word": "разводиться",
                                "target_lang_sense_clarification": "расторгать брак (несов. вид)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "离婚",
                                "target_lang_sense_clarification": "解除婚姻"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "336a5638-d2a8-3f62-9321-1eb45f218086",
                    "sense_definition": "To obtain a legal divorce.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "legal_action_personal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Edna and Simon <w>divorced</w> last year after growing apart.",
                            "target_lang_translations": {
                                "ru": "Эдна и Саймон <w>развелись</w> в прошлом году после того, как отдалились друг от друга.",
                                "zh": "埃德娜和西蒙在感情疏远后，于去年<w>离婚</w>了。"
                            }
                        },
                        {
                            "text": "They decided to <w>divorce</w> amicably for the sake of their children.",
                            "target_lang_translations": {
                                "ru": "Они решили <w>развестись</w> мирно ради своих детей.",
                                "zh": "为了孩子，他们决定和平<w>离婚</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "split up",
                        "separate"
                    ],
                    "antonyms": [
                        "marry"
                    ],
                    "common_phrases": [
                        "divorce amicably"
                    ],
                    "target_lang_definitions": {
                        "ru": "Получить юридический развод.",
                        "zh": "获得法律上的离婚。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "развестись",
                                "target_lang_sense_clarification": "оформить развод"
                            },
                            {
                                "target_lang_word": "разводиться",
                                "target_lang_sense_clarification": "расторгать брак"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "离婚",
                                "target_lang_sense_clarification": "办理离婚手续"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b1590e62-3f88-3663-9e60-a2213fd9b14d",
                    "sense_definition": "To separate something that was connected.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "abstract_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The radical group voted to <w>divorce</w> itself from the main faction.",
                            "target_lang_translations": {
                                "ru": "Радикальная группа проголосовала за то, чтобы <w>отделиться</w> от основной фракции.",
                                "zh": "激进派投票决定从主要派系中<w>脱离</w>出来。"
                            }
                        },
                        {
                            "text": "You cannot <w>divorce</w> scientific progress from its ethical implications.",
                            "target_lang_translations": {
                                "ru": "Нельзя <w>отделять</w> научный прогресс от его этических последствий.",
                                "zh": "你不能将科学进步与其伦理影响<w>分开</w>来看。"
                            }
                        }
                    ],
                    "synonyms": [
                        "separate",
                        "dissociate",
                        "disassociate"
                    ],
                    "common_phrases": [
                        "divorce oneself from"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отделить что-то, что было связано.",
                        "zh": "将原本连接的事物分开。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отделять",
                                "target_lang_sense_clarification": "разъединять"
                            },
                            {
                                "target_lang_word": "отделиться",
                                "target_lang_sense_clarification": "обособиться (возвр.)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "脱离",
                                "target_lang_sense_clarification": "与某事物断开联系"
                            },
                            {
                                "target_lang_word": "分开",
                                "target_lang_sense_clarification": "使事物不再关联"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9c27db16-f8a4-3a15-bc4e-5f32577e5012",
                    "sense_definition": "To legally dissolve a marriage between two people.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "legal_action_official",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A ship captain can marry couples, but cannot <w>divorce</w> them.",
                            "target_lang_translations": {
                                "ru": "Капитан корабля может женить пары, но не может <w>разводить</w> их.",
                                "zh": "船长可以为新人主持婚礼，但不能为他们<w>判离</w>。"
                            }
                        },
                        {
                            "text": "Only a judge has the authority to <w>divorce</w> the couple officially.",
                            "target_lang_translations": {
                                "ru": "Только судья имеет полномочия официально <w>развести</w> пару.",
                                "zh": "只有法官才有权正式<w>判离</w>这对夫妻。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Юридически расторгнуть брак между двумя людьми (о должностном лице).",
                        "zh": "法律上判决两人解除婚姻关系（指司法人员）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "развести",
                                "target_lang_sense_clarification": "расторгнуть чужой брак"
                            },
                            {
                                "target_lang_word": "разводить",
                                "target_lang_sense_clarification": "расторгать чужой брак"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "判离",
                                "target_lang_sense_clarification": "法院判决离婚"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "57b40c13-4629-3417-9f9f-a869008da4f7",
                    "sense_definition": "The 65th sura (chapter) of the Qur'an.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "document_or_program_name",
                    "examples": [
                        {
                            "text": "The scholar referenced the <w>Divorce</w> chapter during his lecture on family law.",
                            "target_lang_translations": {
                                "ru": "Ученый ссылался на суру «<w>Развод</w>» во время своей лекции по семейному праву.",
                                "zh": "学者在讲授家庭法时引用了《<w>离婚章</w>》。"
                            }
                        },
                        {
                            "text": "He recited verses from <w>Divorce</w> during the evening prayer.",
                            "target_lang_translations": {
                                "ru": "Он читал стихи из суры «<w>Развод</w>» во время вечерней молитвы.",
                                "zh": "他在晚祷时诵读了《<w>离婚章</w>》中的经文。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "65-я сура (глава) Корана.",
                        "zh": "《古兰经》的第65章。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Развод",
                                "target_lang_sense_clarification": "название суры"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "离婚章",
                                "target_lang_sense_clarification": "《古兰经》篇章名"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}