                ],
                "senses": [
                    {
                        "sense_id": "db70aa86-82cb-3257-9cf4-06817a55dade",
                        "entry_id": "f19b77fa-2e46-3082-b519-c091361003ef",
                        "glosses": [
                            "Puffer, der zu gleichen Teilen aus Acetat und Essigsäure besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a05aa18-a4d6-400d-bc53-a0ebbca00fa1",
                                "sense_id": "db70aa86-82cb-3257-9cf4-06817a55dade",
                                "text": "„Pufferlösungen lassen sich also herstellen, indem man schwache Säuren mit ihrem Salz zum Beispiel der Acetatpuffer aus Essigsäure und Natriumacetat schwache Basen mit ihrem Salz zum Beispiel der Ammoniumpuffer aus Ammoniumchlorid und Ammoniak mischt.“"
                            },
                            {
                                "example_id": "eebd35de-993d-4a6e-90db-b5d0399eb0e9",
                                "sense_id": "db70aa86-82cb-3257-9cf4-06817a55dade",
                                "text": "„So kann ein 10 mM Acetatpuffer eine Pufferkapazität von 0,005 im Bereich von pH 4,5-5 haben, […]“"
                            },
                            {
                                "example_id": "8917a90f-d9cd-4238-ae2b-c07e092af30b",
                                "sense_id": "db70aa86-82cb-3257-9cf4-06817a55dade",
                                "text": "„Nun fügt man 139 cm3 0,2 m Acetatpuffer Рн 4,2 11110 84,5 g Ammoniumsulfat zu und zentrifugiert nach 15 min (7 min, 13 000 Touren/ min).“"
                            },
                            {
                                "example_id": "d595166e-0f7e-4f5d-ad4d-621af397a704",
                                "sense_id": "db70aa86-82cb-3257-9cf4-06817a55dade",
                                "text": "„Schließlich ist noch die Arbeit von OERTEL et al. [135] erwähnenswert; sie trennten Sulfate und Glucuronide in der S-Kammer auf DEAE- und ECTEOLA-Cellulose (MN 300 G) einerseits mit Acetatpuffern verschiedener Molarität, andererseits säurehaltigen Alkoholen.“"
                            },
                            {
                                "example_id": "c4d9bd5d-d69f-43f0-9eda-148f6e235c16",
                                "sense_id": "db70aa86-82cb-3257-9cf4-06817a55dade",
                                "text": "„Zu 2,9 cm³ Acetatpuffer, die sich in einem 5 cm³-Meßkolben befinden, gibt man 0,1 cm³ Serum.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
