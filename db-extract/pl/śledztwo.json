                    }
                ],
                "translations": [
                    {
                        "translation_id": "6b797e82-8c38-42ba-a4e6-e98181433f48",
                        "source_entry_id": "a0d36f03-7a8a-3280-92a2-134f1989bccd",
                        "source_sense_id": "a148462b-0f0a-3432-b018-c4e6bc910ffc",
                        "target_lang_word": "investigation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "investigation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4d8038d0-b27c-3fd6-943a-e295b2be386c",
                                        "entry_id": "6774607a-5dc4-3eaa-8f61-4ca3ec210202",
                                        "glosses": [
                                            "The act of investigating; the process of inquiring into or following up; research, especially patient or thorough inquiry or examination"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef974f5d-0dac-4288-8259-bc704c87dc96",
                                                "sense_id": "4d8038d0-b27c-3fd6-943a-e295b2be386c",
                                                "text": "The investigation into the crime has led to various leads as well as plenty of dead ends."
                                            },
                                            {
                                                "example_id": "a7d93fd7-bf7f-40d6-afb4-7436b454426e",
                                                "sense_id": "4d8038d0-b27c-3fd6-943a-e295b2be386c",
                                                "text": "Despite thorough investigation, the perpetrator of the attacks remains unknown."
                                            },
                                            {
                                                "example_id": "0a55e79e-dbc3-4116-a011-6dec7a3d2281",
                                                "sense_id": "4d8038d0-b27c-3fd6-943a-e295b2be386c",
                                                "text": "carry out an investigation"
                                            },
                                            {
                                                "example_id": "cc2b12d8-ceff-472c-960a-c4cc4a00dd17",
                                                "sense_id": "4d8038d0-b27c-3fd6-943a-e295b2be386c",
                                                "text": "the matter is awaiting investigation"
                                            },
                                            {
                                                "example_id": "88fa932c-c1a7-4223-a70b-90a1f9b9e810",
                                                "sense_id": "4d8038d0-b27c-3fd6-943a-e295b2be386c",
                                                "text": "The case is still under investigation."
                                            },
                                            {
                                                "example_id": "36c437ef-fb3e-4569-a710-7f52ea2c497a",
                                                "sense_id": "4d8038d0-b27c-3fd6-943a-e295b2be386c",
                                                "text": "\"Ag-gag laws criminalize undercover investigations by prohibiting one or more of three types of behavior: trespass, recording of videos, and failure to submit a video to law enforcement.\""
                                            },
                                            {
                                                "example_id": "c7d2d76e-f807-4d24-8f78-d8a2f92ff7fb",
                                                "sense_id": "4d8038d0-b27c-3fd6-943a-e295b2be386c",
                                                "text": "The White House counsel, Donald F. McGahn II, has cooperated extensively in the special counsel investigation, sharing detailed accounts about the episodes at the heart of the inquiry into whether President Trump obstructed justice, […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "24d869ef-f129-46aa-b4a6-2b600dce25da",
                        "source_entry_id": "a0d36f03-7a8a-3280-92a2-134f1989bccd",
                        "source_sense_id": "a148462b-0f0a-3432-b018-c4e6bc910ffc",
                        "target_lang_word": "следствие",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "следствие",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "aa1da2b9-edac-3e7c-a24a-0c0dee4dbee8",
                                        "entry_id": "3b4b322c-6eda-32fa-8676-14310163fa73",
                                        "glosses": [
                                            "то, что произошло как результат чего-либо произошедшего ранее"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f48ee68a-3740-4159-bb0e-9b58ba520f73",
                                                "sense_id": "aa1da2b9-edac-3e7c-a24a-0c0dee4dbee8",
                                                "text": "Извините, прелестные, что я осмелился сравнить вас с Софиею: трудно противиться сердцу, а оно руководствует мною при сочинении сей повести; притом же ваши достоинства сделались виднее и следствие доказало их превосходство."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26f106a1-487c-3a8e-bfed-42d218a6c525",
                                        "entry_id": "3b4b322c-6eda-32fa-8676-14310163fa73",
                                        "glosses": [
                                            "филос. то, что следует, вытекает из чего-либо; вывод, заключение"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "следствие",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b0d506cd-939f-3a11-9637-42e640c77182",
                                        "entry_id": "1dcae872-1f97-3e5e-8559-02ab4d15290f",
                                        "glosses": [
                                            "юр. процесс, направленный на выяснение обстоятельств чего-либо (обычно преступления), доказательств и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ecccdc6-c980-4187-8f74-93502ed16d36",
                                                "sense_id": "b0d506cd-939f-3a11-9637-42e640c77182",
                                                "text": "Я хотел бы отметить, что мы закончили следствие в рекордные сроки ― за 29 дней, хотя там было назначено 183 экспертизы, а потерпевшими были признаны 172 человека."
                                            }
                                        ]
