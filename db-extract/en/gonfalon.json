                    {
                        "translation_id": "3a8c71c5-e80b-4ea8-897c-c6ec5c732967",
                        "source_entry_id": "129e4b0c-4889-3a40-b989-e36d284a196c",
                        "source_sense_description": "a standard or ensign",
                        "target_lang_word": "gonfalon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gonfalon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0f4d6a18-81c6-386f-87b6-e0564966cc41",
                                        "entry_id": "5d9b5fc5-797d-3285-9283-5efdebae4ef4",
                                        "glosses": [
                                            "Fanion dont les chevaliers ornaient leur lance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2891a56-37bd-4992-af41-86a3d739e849",
                                                "sense_id": "0f4d6a18-81c6-386f-87b6-e0564966cc41",
                                                "text": "Et ton nom brodé d’or sur mon blanc gonfalon."
                                            },
                                            {
                                                "example_id": "7d98a9ed-5877-47df-bfb2-ef2e988d9957",
                                                "sense_id": "0f4d6a18-81c6-386f-87b6-e0564966cc41",
                                                "text": "Un gonfalon élimé, au sommet d’une perche plantée devant l’entrée, portait le nom du propriétaire..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6adf826-d0c7-3ffc-af50-9d036b72531a",
                                        "entry_id": "5d9b5fc5-797d-3285-9283-5efdebae4ef4",
                                        "glosses": [
                                            "Bannière d’église à trois ou quatre fanons, qui sont des pièces pendantes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18e8e83a-e2aa-40e2-a173-4a4bfa8b7f4a",
                                                "sense_id": "d6adf826-d0c7-3ffc-af50-9d036b72531a",
                                                "text": "Au bas de la nef est suspendu le gonfalon pontifical qui avec le médaillon portatif en bois doré, forme les insignes de la Basilique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "372df336-c61b-33c4-b774-190548bd0a01",
                                        "entry_id": "5d9b5fc5-797d-3285-9283-5efdebae4ef4",
                                        "glosses": [
                                            "Bannière des républiques ou communes italiennes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca55370d-c7c5-4037-84e1-ef314974a1df",
                                                "sense_id": "372df336-c61b-33c4-b774-190548bd0a01",
                                                "text": "Le gonfalonier était le gardien du gonfalon, ou étendard, dans les communes médiévales italiennes, surtout en Toscane."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2c6be78-6dfa-38f0-b942-58ab17a527df",
                                        "entry_id": "5d9b5fc5-797d-3285-9283-5efdebae4ef4",
                                        "glosses": [
                                            "Voir gonfanon."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "46406590-56c6-394b-bab3-56053b8f0787",
                                        "entry_id": "5d9b5fc5-797d-3285-9283-5efdebae4ef4",
                                        "glosses": [
                                            "Confrérie de séculiers dits pénitents à qui saint Bonaventure prescrivit en 1264 une forme particulière de prières ; plus tard Grégoire XIII confirma cette confrérie et lui donna le soin de délivrer les chrétiens esclaves des mains des infidèles."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
