                            {
                                "example_id": "e8292437-b027-480a-b38b-1ca3856099fd",
                                "sense_id": "d0098df8-a3d2-3a3c-addd-e947f72b7cf7",
                                "text": "Bhutan to górzyste małe państwo na południowych zboczach Himalajów."
