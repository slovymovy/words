                "senses": [
                    {
                        "sense_id": "a77c70c4-cef1-3f21-99bb-e5fdbf017527",
                        "entry_id": "ed896c6b-fbc6-3767-a304-ff31a4a7a200",
                        "glosses": [
                            "истор. женская половина дома"
                        ],
                        "tags": [
                            "в Древней Греции"
                        ],
                        "examples": [
                            {
                                "example_id": "27d9bc9e-f2a7-4472-8800-14c9bb982832",
                                "sense_id": "a77c70c4-cef1-3f21-99bb-e5fdbf017527",
                                "text": "Ей отводилась отдельная половина дома, называвшаяся гинекеем, откуда она не имела права выходить, когда у её мужа сидели гости — мужчины."
                            }
                        ]
                    },
                    {
                        "sense_id": "8741c885-b827-3251-9adb-f5164f729625",
                        "entry_id": "ed896c6b-fbc6-3767-a304-ff31a4a7a200",
                        "glosses": [
                            "устар., высок. женские комнаты в дворянских домах Российской империи"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "219b796e-df59-462c-9c25-d532bbb6925b",
                                "sense_id": "8741c885-b827-3251-9adb-f5164f729625",
                                "text": "Не без труда умаслил я моего Трохима и ввёл его в освещённый гинекей Софьи Самойловны."
                            }
                        ]
                    },
                    {
                        "sense_id": "3f3dd414-94e8-3b1a-9117-d0a5f1538966",
                        "entry_id": "ed896c6b-fbc6-3767-a304-ff31a4a7a200",
                        "glosses": [
                            "перен. женское окружение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a7fdba0-0de1-44fc-bccc-2f2dc4d0ccf4",
                                "sense_id": "3f3dd414-94e8-3b1a-9117-d0a5f1538966",
                                "text": "К тому же и рос я, так сказать, в гинекее: с мамою, с няней, с бабушкой, с сестрой Женей."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ee60e585-d7b2-423d-ac27-7dcabb6f3848",
                        "source_entry_id": "ed896c6b-fbc6-3767-a304-ff31a4a7a200",
                        "target_lang_word": "gynaeceum",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gynaeceum",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c01db45f-84c1-347a-8d67-38d55d92a957",
                                        "entry_id": "86c5f6e0-ed57-329f-862c-1e71d47c0a47",
                                        "glosses": [
                                            "The women's quarters in a household; (hence, loosely) any building or area for women."
                                        ],
                                        "tags": [
                                            "Ancient-Rome"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f4057d0-33a2-4d3f-acbc-09d7dc655543",
                                                "sense_id": "c01db45f-84c1-347a-8d67-38d55d92a957",
                                                "text": "A master, however this may be, was very jealous of the inmates of his gyneceum, and he permitted no one to enter the place, which was protected as a sanctuary in the legislation of the Barbarians."
                                            },
                                            {
                                                "example_id": "0307cbb5-a9bb-4586-a40f-56b6675b606c",
                                                "sense_id": "c01db45f-84c1-347a-8d67-38d55d92a957",
                                                "text": "It was agreeable to see men, after days in this gyneceum, bringing the place to life, to see waiters speeding to their command."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2951de84-1689-372a-9d23-dc3b1b31d36a",
                                        "entry_id": "86c5f6e0-ed57-329f-862c-1e71d47c0a47",
                                        "glosses": [
                                            "An establishment in Rome where female workers made clothing and furniture for royalty."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b1c768cd-f901-37fe-b017-d400554b733f",
                                        "entry_id": "86c5f6e0-ed57-329f-862c-1e71d47c0a47",
                                        "glosses": [
                                            "A gynoecium."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df559b8d-2767-4465-be31-b6b874eaca1f",
                                                "sense_id": "b1c768cd-f901-37fe-b017-d400554b733f",
                                                "text": "The androecium functions by providing the pollen-grains which are necessary to bring about fertilisation of the ovules in the gynaeceum."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
