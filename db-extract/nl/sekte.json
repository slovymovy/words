                    },
                    {
                        "translation_id": "aa1fb2cc-b48a-4cdd-b290-0d6817961251",
                        "source_entry_id": "de275a12-ac01-38af-b91b-a69940e78bdb",
                        "source_sense_id": "2cc97eea-a1ea-3f0a-9113-b95638d35179",
                        "source_sense_description": "religieuze groepering die opziet naar een bepaald mens als leider",
                        "target_lang_word": "sect",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sect",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2d2277c1-d2b6-3056-9f66-d3034d31feaa",
                                        "entry_id": "1e7f50fa-ab24-3fcb-b2e3-daf712e70d1d",
                                        "glosses": [
                                            "An offshoot of a larger religion or denomination."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "970d1e78-50f0-4cd6-a0d6-7a9f016a7d68",
                                                "sense_id": "2d2277c1-d2b6-3056-9f66-d3034d31feaa",
                                                "text": "a religious sect"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e850e6e-4542-33d0-b6de-925991b98eae",
                                        "entry_id": "1e7f50fa-ab24-3fcb-b2e3-daf712e70d1d",
                                        "glosses": [
                                            "A group following a specific ideal or a leader."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c4ce4c0-5c41-4f09-aac2-c46c51f5995e",
                                                "sense_id": "8e850e6e-4542-33d0-b6de-925991b98eae",
                                                "text": "Zen Center welcomes visitors, guests, and prospective students, but it does not engage in systematic institutional or network recruiting of new members, unlike the Christian sect and Erhard Seminars Training."
                                            },
                                            {
                                                "example_id": "edd17324-ecf6-4aa0-9e64-9f7f9f48d744",
                                                "sense_id": "8e850e6e-4542-33d0-b6de-925991b98eae",
                                                "text": "Every person who is not a fellow member, and every social, religious and political institution that lies outside the sect's domain, is portrayed as a representative of Satan's world. In our research, we found that Moonies and members of many Christian sects with similar religious and political doctrines often focus on such beliefs to the exclusion of all other thought."
                                            },
                                            {
                                                "example_id": "ae5128e1-271c-4281-a436-965447597225",
                                                "sense_id": "8e850e6e-4542-33d0-b6de-925991b98eae",
                                                "text": "Peoples Temple and the Branch Davidians both approximated the 'apocalyptic sect' as an ideal type. In such sects the end of the world is taken as a central tenet."
                                            },
                                            {
                                                "example_id": "4317db90-d7c8-4e2f-908c-2315a8b2547c",
                                                "sense_id": "8e850e6e-4542-33d0-b6de-925991b98eae",
                                                "text": "There are scores of modern religious cults and sects that have been influenced by Hinduism to varying degrees. Werner Erhard, founder of 'Landmark Education's 'The Forum',' and 'est' seminars, which have about 700,000 graduates, was influenced by Hinduism through Swami Muktananda, one of Erhard's principal gurus."
                                            },
                                            {
                                                "example_id": "6d7193b6-34c1-4f15-b47c-791d00ca40e6",
                                                "sense_id": "8e850e6e-4542-33d0-b6de-925991b98eae",
                                                "text": "The Indiana Peoples Temple was essentially a sect, which was joined by new religious movement members in California, which then recruited black church members as it focused its ministry on the residents of urban California."
                                            },
                                            {
                                                "example_id": "7b1a78e2-f090-4fb7-adee-f22dcffd0052",
                                                "sense_id": "8e850e6e-4542-33d0-b6de-925991b98eae",
                                                "text": "Branch Davidians are a modern religious sect that claims to be an offshoot of the Seventh-Day Adventist Church. The church renounced any connection with the sect in the 1930s."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dfe6b5a7-106c-30f4-ba92-9df48eea6599",
                                        "entry_id": "1e7f50fa-ab24-3fcb-b2e3-daf712e70d1d",
                                        "glosses": [
                                            "A cutting; a scion."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "sect",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cf40d79e-7415-3815-af82-5aad9fe6f255",
                                        "entry_id": "fffd5438-69a7-3d4f-8bb2-345ac05c2a6e",
                                        "glosses": [
                                            "An ancient astrological concept, a form of polarity by which heavenly bodies were designated as either diurnal or nocturnal."
                                        ],
                                        "tags": [
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e0ec4f24-a709-488c-be81-d6206ca354e9",
                        "source_entry_id": "de275a12-ac01-38af-b91b-a69940e78bdb",
                        "source_sense_id": "2cc97eea-a1ea-3f0a-9113-b95638d35179",
                        "source_sense_description": "religieuze groepering die opziet naar een bepaald mens als leider",
                        "target_lang_word": "secte",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "secte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c0df7eed-fc9f-3242-800a-28699f064eb1",
                                        "entry_id": "27466193-68be-3b81-a4f2-b0e165a44707",
                                        "glosses": [
                                            "Ensemble de personnes professant une même doctrine religieuse, philosophique ou autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab87a728-49af-4498-a782-4b6b54e5a2b3",
                                                "sense_id": "c0df7eed-fc9f-3242-800a-28699f064eb1",
                                                "text": "La secte d’Épicure."
                                            },
                                            {
                                                "example_id": "385f2790-bc94-40c9-ac63-67362dc7ff38",
                                                "sense_id": "c0df7eed-fc9f-3242-800a-28699f064eb1",
                                                "text": "La secte des stoïciens."
                                            },
                                            {
                                                "example_id": "d360ef48-4f9b-4cf6-b87b-d7c999f01eb4",
                                                "sense_id": "c0df7eed-fc9f-3242-800a-28699f064eb1",
                                                "text": "Toute secte, en quelque genre que ce puisse être, est le ralliement du doute et de l'erreur. […] Il n'y a point de secte en géométrie ; on ne dit point un euclidien, un archimédien. Quand la vérité est évidente, il est impossible qu'il s'élève des partis et des factions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9c665bc-f613-3a0b-a8aa-93a26f86d453",
                                        "entry_id": "27466193-68be-3b81-a4f2-b0e165a44707",
                                        "glosses": [
                                            "Groupe dissident minoritaire, clos sur lui-même et créé en opposition à des pratiques religieuses dominantes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d189920-33be-4efd-9928-d023ca7cf946",
                                                "sense_id": "e9c665bc-f613-3a0b-a8aa-93a26f86d453",
                                                "text": "Ainsi, ceux qui s’étaient séparés de l’Église romaine appartenaient déjà à deux sectes très distinctes : les uns au luthéranisme, les autres au zwinglianisme, précurseur du calvinisme."
                                            },
                                            {
                                                "example_id": "a89ff055-e475-4910-bdd6-07394a0c2c39",
                                                "sense_id": "e9c665bc-f613-3a0b-a8aa-93a26f86d453",
                                                "text": "Ce village, […], avait déjà, […], acquis toute l’importance d’une ville. Deux tavernes regorgeaient de buveurs, trois temples de sectes différentes servaient à réunir les fidèles."
                                            },
                                            {
                                                "example_id": "61b87005-6157-41f7-91f8-f3e0e3603414",
                                                "sense_id": "e9c665bc-f613-3a0b-a8aa-93a26f86d453",
                                                "text": "Chez les peuples protestants, il y a d’autant plus d’ardeur morale que l’Église établie est plus fortement battue en brèche par des sectes dissidentes."
                                            },
                                            {
                                                "example_id": "8b030c5d-b059-4a8f-a6a5-3e9f739635ba",
                                                "sense_id": "e9c665bc-f613-3a0b-a8aa-93a26f86d453",
                                                "text": "L’éclosion des sectes dissidentes au sein du christianisme n’a donc fait qu’aiguiser les passions anti-juives de l’Église."
                                            },
                                            {
                                                "example_id": "9ecbddee-fe76-472e-8b3a-099069a2a89f",
                                                "sense_id": "e9c665bc-f613-3a0b-a8aa-93a26f86d453",
                                                "text": "La renaissance d’un certain patriotisme de clocher se traduisit par la prolifération des sectes manichéennes et millénaristes."
                                            },
                                            {
                                                "example_id": "18a1c37c-9f15-402c-8649-1a483f1d9f5a",
                                                "sense_id": "e9c665bc-f613-3a0b-a8aa-93a26f86d453",
                                                "text": "Cette secte japonaise, dirigée par Daisaku Ikeda depuis le 3 mai 1960, est le pendant laïque de l’ordre des moines bouddhistes de l’obédience Nichiren Shoshu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b2b5d25-04ef-304a-b419-eef585a2973c",
                                        "entry_id": "27466193-68be-3b81-a4f2-b0e165a44707",
                                        "glosses": [
                                            "Groupe religieux ou autre dont la visée est d’exploiter ses adeptes au profit d’un ou plusieurs gourous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "237d9a8e-8021-4620-bde3-5500b6120a5f",
                                                "sense_id": "1b2b5d25-04ef-304a-b419-eef585a2973c",
                                                "text": "Sur un plan plus particulier, quiconque a lu mes textes sait que j'ai toujours fustigé les identités, les sectes et les folklores, ironisé sur la « gouroufication » et les « japoniaiseries »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
