                        "glosses": [
                            "Any of the genus Dichondra of prostrate perennial herbaceous plants with creeping stems."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34412161-3287-489e-b447-57c43f1ad894",
                                "sense_id": "dfb5f143-7cd4-3fdb-8eb2-4dd041b6f669",
                                "text": "But the Agricultural Extension Services in several southern states have listed dichondra — a member of the bindweed family — under \"weeds,\" where it appears by the name ponyfoot."
                            },
                            {
                                "example_id": "3b8a71bd-5b2e-4dc7-ba52-cb7e54d4bf7b",
                                "sense_id": "dfb5f143-7cd4-3fdb-8eb2-4dd041b6f669",
                                "text": "“That’s silver ponyfoot,” she said, using the apt common name for a kind of dichondra."
                            }
                        ]
