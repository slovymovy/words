                                            {
                                                "example_id": "3b54b8c2-58e9-44fc-865f-6438e54b90dc",
                                                "sense_id": "8b030395-9201-3d3e-9de1-9a5c5d7d5a17",
                                                "text": "Oděv svoji slavnostní zbroj, usedl na koně a vyrazil do bitvy."
                                            }
                                        ]
