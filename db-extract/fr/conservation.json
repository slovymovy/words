                                "target_senses": [
                                    {
                                        "sense_id": "eb308d13-f36b-30f0-beee-3056a0d152c6",
                                        "entry_id": "4319c568-522c-3685-bdfd-9bd5166725d4",
                                        "glosses": [
                                            "ato ou efeito de conservar"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4e1a1511-e225-3d31-9ed1-cb8aa735922b",
                                        "entry_id": "4319c568-522c-3685-bdfd-9bd5166725d4",
                                        "glosses": [
                                            "conjunto de diretrizes planejadas para o manejo e utilização sustentada dos recursos naturais, a um nível ótimo de rendimento e preservação da diversidade biológica"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "848acf9a-3ba4-4d2a-bbb4-9e37573bd909",
                                                "sense_id": "4e1a1511-e225-3d31-9ed1-cb8aa735922b",
                                                "text": "Na prática, dizem os pesquisadores, isso significaria pagar as pessoas para cumprirem a lei, além de não garantir a conservação da floresta."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fbf311c9-a918-4c0c-816b-faedddea9515",
                        "source_entry_id": "9f80580e-2b5c-3748-81a7-97092fb33093",
                        "target_lang_word": "хранение",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "хранение",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "aa1ec215-9e21-3bf2-ae5b-7b8f3ace9757",
                                        "entry_id": "3a24171f-1715-356a-a457-bb4eb139f751",
                                        "glosses": [
                                            "действие по значению гл. хранить"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ef0b1b6-8ba5-44cc-b378-a3200d3ac4f6",
                                                "sense_id": "aa1ec215-9e21-3bf2-ae5b-7b8f3ace9757",
                                                "text": "Почти у каждого был свой сундук с замком, для хранения казённых вещей."
                                            },
                                            {
                                                "example_id": "2bad628a-d3cb-4ad2-bc38-504f88a6084b",
                                                "sense_id": "aa1ec215-9e21-3bf2-ae5b-7b8f3ace9757",
                                                "text": "Вспомнил я тут, как старуха рассказывала мне, что в погребах для хранения вин обязательно вентиляция устраивается, да и раньше об этом слышал…"
                                            },
                                            {
                                                "example_id": "8f978a00-9c79-4950-8831-d21d9765828c",
                                                "sense_id": "aa1ec215-9e21-3bf2-ae5b-7b8f3ace9757",
                                                "text": "У жильцов происходило ранее назначенное общее собрание при участии представительницы из райсовета, как вдруг в дом явилась с обходом военная комиссия, проверявшая разрешения на хранение оружия и изымавшая неразрешённое."
                                            },
                                            {
                                                "example_id": "135a22ed-e272-4410-9e97-e2de12804753",
                                                "sense_id": "aa1ec215-9e21-3bf2-ae5b-7b8f3ace9757",
                                                "text": "Для хранения числа-кода в памяти компьютера выделяются биты или разряды двоичного представления числа."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
