                        "glosses": [
                            "Extrêmement corrompu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e81abf2a-9a0e-403d-ad60-82cada378d79",
                                "sense_id": "2fb06656-6195-3345-b14c-26fe50780215",
                                "text": "Administration très lourde, ultra-corrompue, systèmes de financement extrêmement complexes et dissuasifs pour les étrangers."
                            },
                            {
                                "example_id": "df3048a5-8a25-4fb8-a1ef-145478fbd786",
                                "sense_id": "2fb06656-6195-3345-b14c-26fe50780215",
                                "text": "Il est que, de plus en plus, les fragiles États nés de la décolonisation et les couches étroites ultra-corrompues et inefficaces qui les dirigent vont entrer en décomposition."
                            },
                            {
                                "example_id": "a6e663a3-7155-4e71-a03d-a6c2c9e2357e",
                                "sense_id": "2fb06656-6195-3345-b14c-26fe50780215",
                                "text": "On pourrait citer l’étonnante levée de boucliers, de trahisons, de subversion partisane qui s’est faite en France, dans les milieux ultra-corrompus de la presse, radio et télévision, lors du grand tournant pro-arabe du général de Gaulle en janvier 1969."
                            }
                        ]
                    }
