                    }
                ],
                "senses": [
                    {
                        "sense_id": "8884fd15-4e5b-3f79-ab36-6213c1a48201",
                        "entry_id": "77925f82-804c-3ec0-82c8-b3a2c585d124",
                        "glosses": [
                            "основательно расположиться, усесться где-либо, за что-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f85df078-3941-40ac-9195-2aec5baa111a",
                                "sense_id": "8884fd15-4e5b-3f79-ab36-6213c1a48201",
                                "text": "Засесть за стол."
                            }
                        ]
                    },
                    {
                        "sense_id": "de0a55f5-83ca-367f-81c1-30af4a158f17",
                        "entry_id": "77925f82-804c-3ec0-82c8-b3a2c585d124",
                        "glosses": [
                            "перен., разг. основательно заняться какой-либо работой (обычно требующей сидячего положения)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3161b104-2f22-4acf-81c9-04613205e28c",
                                "sense_id": "de0a55f5-83ca-367f-81c1-30af4a158f17",
                                "text": "Я наконец-то засел за занятия и начал учиться."
                            }
                        ]
                    },
                    {
                        "sense_id": "47d212a7-3009-3512-982c-8b52739c2e5a",
                        "entry_id": "77925f82-804c-3ec0-82c8-b3a2c585d124",
                        "glosses": [
                            "физически остаться где-либо надолго, не выезжая, не выходя"
                        ],
                        "tags": [
                            "о человеке"
                        ],
                        "examples": [
                            {
                                "example_id": "f08582d4-3245-46e2-aa49-25ab129a6359",
                                "sense_id": "47d212a7-3009-3512-982c-8b52739c2e5a",
                                "text": "Войска, взявши неприятельскую крепость, укрепились и засели в ней."
                            }
                        ]
                    },
                    {
                        "sense_id": "7f9158f4-14c5-38a0-b123-db3d1027fd95",
                        "entry_id": "77925f82-804c-3ec0-82c8-b3a2c585d124",
                        "glosses": [
                            "перен. прочно, надолго занять какое-нибудь место"
                        ],
                        "tags": [
                            "о человеке"
                        ],
                        "examples": [
                            {
                                "example_id": "723ce2c8-48dc-4076-9efd-b30aed6490e6",
                                "sense_id": "7f9158f4-14c5-38a0-b123-db3d1027fd95",
                                "text": "На три года засел в тюрьме."
                            },
                            {
                                "example_id": "7bc0eb07-d201-4169-ba02-5caa7954bc76",
                                "sense_id": "7f9158f4-14c5-38a0-b123-db3d1027fd95",
                                "text": "В этом учреждении засели бюрократы."
                            }
                        ]
                    },
                    {
                        "sense_id": "f7e1b879-dca7-382f-acf0-d2b5e6087a5e",
                        "entry_id": "77925f82-804c-3ec0-82c8-b3a2c585d124",
                        "glosses": [
                            "застрять, глубоко вонзившись, остаться внутри чего-нибудь, застрять в чем-нибудь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "671b86b4-5500-45f4-8935-9de989ed4211",
                                "sense_id": "f7e1b879-dca7-382f-acf0-d2b5e6087a5e",
                                "text": "Пуля засела в левом боку."
                            },
                            {
                                "example_id": "adeed1fe-9fa0-4390-846d-3f2128268e4f",
                                "sense_id": "f7e1b879-dca7-382f-acf0-d2b5e6087a5e",
                                "text": "Пробка от шампанского засела в бутылке и никак не выходит."
                            }
                        ]
                    },
                    {
                        "sense_id": "3caff559-c257-332d-a284-d42589606063",
                        "entry_id": "77925f82-804c-3ec0-82c8-b3a2c585d124",
                        "glosses": [
                            "перен. ?"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd1caeb8-8bb2-495e-bc39-590eabcdff4b",
                                "sense_id": "3caff559-c257-332d-a284-d42589606063",
                                "text": "Засела у меня в голове мысль, что всё это неправильно."
                            },
                            {
                                "example_id": "523a6334-407d-42f4-8a59-f8983e8d55ef",
                                "sense_id": "3caff559-c257-332d-a284-d42589606063",
                                "text": "В квартире засел такой отвратительный запах, что не выветришь его за месяц."
                            }
                        ]
                    }
                ],
