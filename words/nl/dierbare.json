                {
                    "sense_id": "a5b361ac-2c60-328e-a55d-e3643fb4d8cd",
                    "sense_definition": "Een overledene met wie je een sterke relatie had",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "geliefde_persoon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het verlies van een <w>dierbare</w> is een van de zwaarste dingen die je kunt meemaken.",
                            "target_lang_translations": {
                                "ru": "Потеря <w>близкого</w> — это одно из самых тяжелых испытаний, которые можно пережить.",
                                "de": "Der Verlust eines <w>geliebten Menschen</w> gehört zu den schwersten Dingen, die man erleben kann."
                            }
                        },
                        {
                            "text": "Tijdens de ceremonie staken we kaarsen aan ter nagedachtenis aan onze overleden <w>dierbaren</w>.",
                            "target_lang_translations": {
                                "ru": "Во время церемонии мы зажгли свечи в память о наших умерших <w>близких</w>.",
                                "de": "Während der Zeremonie zündeten wir Kerzen zum Gedenken an unsere verstorbenen <w>Angehörigen</w> an."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een dierbare verliezen",
                        "afscheid nemen van een dierbare"
                    ],
                    "target_lang_definitions": {
                        "ru": "Умерший близкий человек, с которым у вас была сильная связь",
                        "de": "Eine verstorbene Person, zu der man eine enge Beziehung hatte"
                    },
                    "translations": {
