                "senses": [
                    {
                        "sense_id": "8b905a8e-20eb-3680-9c78-791c4ca8947e",
                        "entry_id": "b8848bed-ace4-3e61-bdb3-662ef9e74ab7",
                        "glosses": [
                            "größte europäische Käferart (bis zu 7 cm) mit braunschwarzer Färbung"
                        ],
                        "tags": [
                            "Entomologie"
                        ],
                        "examples": [
                            {
                                "example_id": "89972e62-d39e-4be7-b6f8-eb570951084a",
                                "sense_id": "8b905a8e-20eb-3680-9c78-791c4ca8947e",
                                "text": "In der Roten Liste gefährdeter Arten ist der Hirschkäfer als stark gefährdet eingestuft."
                            },
                            {
                                "example_id": "eaf6496c-6d34-4e2e-8937-d2873a10188e",
                                "sense_id": "8b905a8e-20eb-3680-9c78-791c4ca8947e",
                                "text": "„Sie bückte sich und hob den auffälligen schwarzbraunen Hirschkäfer auf, der über ihre nackten Füße krabbelte und der sich mit seinem Geweih in ihren geschnürten Sandalen verfangen hatte.“"
                            },
                            {
                                "example_id": "2ba42b6d-3002-4575-b65e-71c797d1b107",
                                "sense_id": "8b905a8e-20eb-3680-9c78-791c4ca8947e",
                                "text": "„In vielen Aktivitäten unterscheidet sich der Homo sapiens nicht wesentlich von Hirschkäfern oder Stabheuschrecken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
