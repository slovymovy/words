                "senses": [
                    {
                        "sense_id": "b61029c3-8ae3-3dda-abc1-620c76f2d0ad",
                        "entry_id": "9c3e494b-7671-347c-931d-29a0e821dd32",
                        "glosses": [
                            "Travailler à l’aide d’une machine à disque, d'un cultivateur-tasseur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97cdeb1c-5ebb-4f2f-830a-bef14d31df74",
                                "sense_id": "b61029c3-8ae3-3dda-abc1-620c76f2d0ad",
                                "text": "Dès que le sol est essoré le printemps, il faut « disquer » en long et en large."
                            },
                            {
                                "example_id": "2b95a6ff-0c5b-490c-8dc6-710dfd5167bf",
                                "sense_id": "b61029c3-8ae3-3dda-abc1-620c76f2d0ad",
                                "text": "N’oublions pourtant pas de disquer les labours d’automne au printemps, si nous voulons y mettre du maïs, de la betterave ou du tabac."
                            }
                        ]
                    },
                    {
                        "sense_id": "d14e8850-fb8a-3529-8d52-e28a5d434ee4",
                        "entry_id": "9c3e494b-7671-347c-931d-29a0e821dd32",
                        "glosses": [
                            "Enregistrer sur disque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97eb09e8-1d33-45e2-bea6-d293d6a00829",
                                "sense_id": "d14e8850-fb8a-3529-8d52-e28a5d434ee4",
                                "text": "Le jouer, c’est déjà mal, mais le disquer n’est pas pardonnable."
                            }
                        ]
                    }
                ],
