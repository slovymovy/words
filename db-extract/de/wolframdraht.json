                "senses": [
                    {
                        "sense_id": "356f210a-aeb6-3e27-bd59-85884fab8d0a",
                        "entry_id": "e718a3fd-2900-3ef9-b642-129d4d9e0bbc",
                        "glosses": [
                            "aus Wolfram hergestellter Draht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3fde17fa-a8a1-4f00-aa0b-b6b31cfc6a45",
                                "sense_id": "356f210a-aeb6-3e27-bd59-85884fab8d0a",
                                "text": "„Sie sind haltbarer und brauchen weniger Energie als die klassischen Glaskolben mit dem Wolframdraht.“"
                            },
                            {
                                "example_id": "e61b3000-79ec-4e8a-876f-6cca3efc427b",
                                "sense_id": "356f210a-aeb6-3e27-bd59-85884fab8d0a",
                                "text": "„Statt einen Wolframdraht zum Glühen zu bringen, besteht die LED nur aus einem winzigen Chip kristalliner Halbleiterschichten, die Strom in Licht umwandeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
