                    }
                ],
                "translations": [
                    {
                        "translation_id": "94ce6351-3b6b-4189-b12f-052ffe33e160",
                        "source_entry_id": "e9cbf31d-2aa5-3257-9898-9ede8d7a477e",
                        "source_sense_id": "0b867677-9e79-30cc-907c-f9cdb75d373a",
                        "target_lang_word": "исповедание",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "исповедание",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "7ec3b7fa-9dcc-3b56-b411-42b40079d81b",
                                        "entry_id": "7842b240-bd6f-3b33-a3b5-4cd268c15a8f",
                                        "glosses": [
                                            "религ. действие по значению гл. исповедать"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6fa46a6-fbec-43b7-b804-5153c3e76730",
                                                "sense_id": "7ec3b7fa-9dcc-3b56-b411-42b40079d81b",
                                                "text": "Напоминая о сердечном внутреннем исповедании, которое должен всякий совершить внутри самого себя в сию минуту, диакон взывает: Главы ваши Господеви преклоните!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10ee48c4-b49e-33de-b603-57ab180aba2e",
                                        "entry_id": "7842b240-bd6f-3b33-a3b5-4cd268c15a8f",
                                        "glosses": [
                                            "книжн. религия, вероисповедание, конфессия"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60bab3b5-70e3-4d74-a655-5fa84d3b1ff6",
                                                "sense_id": "10ee48c4-b49e-33de-b603-57ab180aba2e",
                                                "text": "И над всеми его «Речами о религии» веет скептически-пантеистическим исповеданием Фауста: полуверой, полуневерием ― под предлогом непознаваемости."
                                            },
                                            {
                                                "example_id": "3a8a5032-087c-4732-a0ae-9253d7675552",
                                                "sense_id": "10ee48c4-b49e-33de-b603-57ab180aba2e",
                                                "text": "Странное это семейство. Отец ― римско-католического исповедания, недавно перекрестился, мать немка. Часть детей ― лютеране, другая ― православные."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
