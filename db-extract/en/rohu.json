                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c98489bb-a718-4748-a607-694fd38a4b67",
                                "sense_id": "79b0c0b3-017a-3abf-bfa3-ded21d46754a",
                                "text": "“Well,” said the fakir, “when you come to the Bhagirathi river you will see a big fish, a Rohu; and you must get him to carry you to Prince Majnun's country, or you will never reach it.”"
                            },
                            {
                                "example_id": "75063577-89b5-4d66-a908-71ec2c0529a3",
                                "sense_id": "79b0c0b3-017a-3abf-bfa3-ded21d46754a",
                                "text": "He caught a Rahu fish weighing around three kilos, and brought home a pair of pigeons for his wife to cook."
                            }
                        ]
