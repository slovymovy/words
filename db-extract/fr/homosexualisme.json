                        "cross_references": [
                            {
                                "target_word": "homosexualismus",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "cb617776-e402-3704-81e4-810ed3cee76c",
                                        "entry_id": "7ac1de89-42ad-3b9a-a361-33d151cd7e1b",
                                        "glosses": [
                                            "homosexuální orientace pojatá jako ideologie (snaha o veřejné uznání a právní kodifikaci homosexuality)"
                                        ],
                                        "tags": [
                                            "neologism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5214503-e815-40ac-84e1-2d5a1bb9ecef",
                                                "sense_id": "cb617776-e402-3704-81e4-810ed3cee76c",
                                                "text": "„Pokládám to za dobrý pokus o významové odstínění homosexuality jako vlastnosti a homosexualismu jako myšlenkového směru,“ hodnotí bohemistka Olga Martincová, vedoucí dvoudílného slovníku neologismů s názvem Nová slova v češtině."
                                            },
                                            {
                                                "example_id": "0334b4bb-2e26-4ccf-bcdb-7c1e2c1755ac",
                                                "sense_id": "cb617776-e402-3704-81e4-810ed3cee76c",
                                                "text": "Argumentační rámec Zdravého rozumu tvoří vztah mezi „homosexualitou“ a „homosexualismem“. To druhé je snaha o veřejné uznání a právní kodifikaci homosexuality. Homosexualita je špatná, ale homosexualismus je prý dokonce „přirovnáván ke komunismu“ a „podobně jako komunismus posouvá osobní problém do polohy ideologické výzvy“."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
