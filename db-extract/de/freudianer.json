                    {
                        "sense_id": "d326466a-1d10-3788-b8ea-1f280ee447e0",
                        "entry_id": "1d8bd4d2-8e6b-310c-8c91-eaef68f18f0c",
                        "glosses": [
                            "Anhänger der Lehre Sigmund Freuds"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eab39fc2-350c-4852-a9d1-a3b12ed61a0d",
                                "sense_id": "d326466a-1d10-3788-b8ea-1f280ee447e0",
                                "text": "Also, er ist Freudianer, und das sagt doch alles."
                            },
                            {
                                "example_id": "4f7451a8-44cb-4490-a44a-0ee257df503a",
                                "sense_id": "d326466a-1d10-3788-b8ea-1f280ee447e0",
                                "text": "„Ich lache über die seichten Endokrinologen, über Gimpel und Emporkömmlinge wie die Freudianer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e4169de0-61f0-48e4-b209-810b0828b0ce",
                        "source_entry_id": "1d8bd4d2-8e6b-310c-8c91-eaef68f18f0c",
                        "source_sense_id": "d326466a-1d10-3788-b8ea-1f280ee447e0",
                        "source_sense_description": "Anhänger der Lehre w:Sigmund Freuds",
                        "target_lang_word": "Freudian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Freudian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "485adca8-2eb8-3de2-8f96-a07f97cca92a",
                                        "entry_id": "dbf3f914-d6b8-3f7b-81df-25e7282719ce",
                                        "glosses": [
                                            "Of or relating to Austrian neurologist Sigmund Freud's scientific theory and psychotherapy called psychoanalysis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "456a97d8-95cb-447f-9838-5a1bb0218f26",
                                                "sense_id": "485adca8-2eb8-3de2-8f96-a07f97cca92a",
                                                "text": "But perhaps the greatest threat of Freudian theory concerned what lurks in the unconscious mind."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "464fb1c2-56b8-319e-9ac0-da542f5cbb89",
                                        "entry_id": "dbf3f914-d6b8-3f7b-81df-25e7282719ce",
                                        "glosses": [
                                            "Relating to or influenced by the Austrian neurologist Sigmund Freud (1856-1939)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a9f6a6c4-53b0-37e6-86b4-3b84a1043489",
                                        "entry_id": "dbf3f914-d6b8-3f7b-81df-25e7282719ce",
                                        "glosses": [
                                            "Susceptible to analysis in terms of unconscious thoughts or desires."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Freudian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ea47b007-1318-346b-9e00-abc32d1e8663",
                                        "entry_id": "997cce62-37a7-35ae-92a4-9f262d1b91f3",
                                        "glosses": [
                                            "A follower of Freud or his methods."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2c026fc-b137-47cb-9e57-0d8265a56a12",
                                                "sense_id": "ea47b007-1318-346b-9e00-abc32d1e8663",
                                                "text": "To the world at large, relativity seemed to pull the rug out from under perceived reality. And for many advanced thinkers of the 1920s, from Dadaists to Cubists to Freudians, that was a fitting credo, reflecting what science historian David Cassidy calls \"the incomprehensiveness of the contemporary scene--the fall of monarchies, the upheaval of the social order, indeed, all the turbulence of the 20th century.\""
                                            }
                                        ]
                                    }
                                ]
                            }
