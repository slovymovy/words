                "senses": [
                    {
                        "sense_id": "e511f6e6-5b14-3484-b885-a10f3cd08fef",
                        "entry_id": "584f7cad-01bd-3f7b-bbde-c69f78748b50",
                        "glosses": [
                            "stevige paaltje om auto's te weren dat in het wegdek kan verzinken op momenten dat toegang voor een auto wel gewenst is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17beaa46-cec8-4245-851b-73d0c28b44e7",
                                "sense_id": "e511f6e6-5b14-3484-b885-a10f3cd08fef",
                                "text": "Sommigen rijden achter de bus aan en klappen vervolgens op de poller die na de bus weer omhoog komt."
                            },
                            {
                                "example_id": "a9d8e416-ed78-4eee-ac77-a5f7ccfd6302",
                                "sense_id": "e511f6e6-5b14-3484-b885-a10f3cd08fef",
                                "text": "Met de invoer van het verkeerscirculatieplan (VCP) zijn straten voor doorgaand verkeer afgesloten met ‘pollers’. Dat zijn automatische paaltjes, die alleen op gezette tijden omlaag gaan voor mensen met een ontheffing. In totaal worden op elf plaatsen pollers geplaatst, soms in beide rijrichtingen, zoals het Spui."
                            }
                        ]
                    }
