        "nl-extract.jsonl": [
            {
                "entry_id": "6ab94147-f5d6-3344-bae4-426f157987fa",
                "word": "rondspoken",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4cb1edaf-40a6-3424-afdc-b1520e9195ea",
                        "entry_id": "6ab94147-f5d6-3344-bae4-426f157987fa",
                        "glosses": [
                            "zonder duidelijk doel ergens bewegen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fbde4b3-fc15-4d3f-8160-dd62461770c4",
                                "sense_id": "4cb1edaf-40a6-3424-afdc-b1520e9195ea",
                                "text": "Na het horen van dit verhaal zal geen enkel kind in Zuid-Afrika snoepen van de Kerstman zijn koekjes. Volgens de legende was er een jongen, genaamd Danny, die alle koekjes had opgegeten. Zijn grootmoeder was vervolgens ontzettend kwaad, waarna ze hem uit woede vermoordde. Nu zijn het geesten die gedurende Kerstmis bij huizen rondspoken."
                            }
                        ]
                    },
                    {
                        "sense_id": "54a033f2-0e41-35f8-8818-b3204184aaff",
                        "entry_id": "6ab94147-f5d6-3344-bae4-426f157987fa",
                        "glosses": [
                            "van een vervelende gedachte dat ze op een vervelende manier maar aanwezig blijft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52e019d3-72cc-4bcd-b8d2-897ed3cbad84",
                                "sense_id": "54a033f2-0e41-35f8-8818-b3204184aaff",
                                "text": "Dat de Zwitserse autoriteiten niet verder willen onderzoeken, ervaart ze als een loden last. „De vragen blijven rondspoken.”"
                            },
                            {
                                "example_id": "657b39f4-ae5b-46d3-a164-733178c26788",
                                "sense_id": "54a033f2-0e41-35f8-8818-b3204184aaff",
                                "text": "Toch is Nadal voor hem een soort angstgegner, zo blijkt uit de 34 onderlinge wedstrijden tot nu toe. Nadal won 23 keer, Federer dus slechts elf keer. In finales van grandslamtoernooien is de tussenstand zelfs 8-2 voor de man van Mallorca. Dat zijn cijfers die morgen ook in het achterhoofd van Federer zullen rondspoken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e02b4bb1-2b73-4eff-966d-d99f8389960f",
                        "source_entry_id": "6ab94147-f5d6-3344-bae4-426f157987fa",
                        "source_sense_id": "4cb1edaf-40a6-3424-afdc-b1520e9195ea",
                        "target_lang_word": "haunt",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "haunt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c0332def-5abe-3090-b220-af9651ce024e",
                                        "entry_id": "7946243d-129f-3f6f-bdba-58d6a134a7c6",
                                        "glosses": [
                                            "To inhabit or to visit frequently (most often used in reference to ghosts)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3fdd8b79-7929-44e5-a5c7-de06ffb10554",
                                                "sense_id": "c0332def-5abe-3090-b220-af9651ce024e",
                                                "text": "A couple of ghosts haunt the old, burnt-down house."
                                            },
                                            {
                                                "example_id": "6bc606b6-a643-4667-9a29-24cfc2598cd6",
                                                "sense_id": "c0332def-5abe-3090-b220-af9651ce024e",
                                                "text": "You wrong me Sir,thus ſtill to haunt my houſe."
                                            },
                                            {
                                                "example_id": "3f15f081-f11d-470d-ba87-e3622deac59d",
                                                "sense_id": "c0332def-5abe-3090-b220-af9651ce024e",
                                                "text": "Foul spirits haunt my resting place."
                                            },
                                            {
                                                "example_id": "29ad4ead-5ff2-4c39-9c17-edc22f76d251",
                                                "sense_id": "c0332def-5abe-3090-b220-af9651ce024e",
                                                "text": "those cares that haunt the court and town"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d0c58d0-7d0c-3f05-b816-5aad765afa67",
                                        "entry_id": "7946243d-129f-3f6f-bdba-58d6a134a7c6",
                                        "glosses": [
                                            "To make uneasy, restless."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5bf21394-e2e0-4fe6-b3de-c7a25b7f4c47",
                                                "sense_id": "4d0c58d0-7d0c-3f05-b816-5aad765afa67",
                                                "text": "The memory of his past failures haunted him."
                                            },
                                            {
                                                "example_id": "61aebbde-abac-4709-ba9a-942b929fefec",
                                                "sense_id": "4d0c58d0-7d0c-3f05-b816-5aad765afa67",
                                                "text": "The murder of Déagol haunted Gollum, and he had made up a defence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c17e473d-ec57-3c87-922a-95995516b336",
                                        "entry_id": "7946243d-129f-3f6f-bdba-58d6a134a7c6",
                                        "glosses": [
                                            "To stalk; to follow."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0280077b-910a-42fd-8436-86ede8077962",
                                                "sense_id": "c17e473d-ec57-3c87-922a-95995516b336",
                                                "text": "The policeman haunted him, following him everywhere."
                                            },
                                            {
                                                "example_id": "17cb3c65-31a3-474f-8a11-f834df8bcbe6",
                                                "sense_id": "c17e473d-ec57-3c87-922a-95995516b336",
                                                "text": "Ex's and the oh-oh-oh's, they haunt me / Like ghosts, they want me / To make 'em a-a-all / They won't let go / Ex's and oh's"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8bc5bf84-5381-3ebd-86db-b32560bd9009",
                                        "entry_id": "7946243d-129f-3f6f-bdba-58d6a134a7c6",
                                        "glosses": [
                                            "To live habitually; to stay, to remain."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1df06eee-1aad-4484-b168-3b7d12c1be01",
                                                "sense_id": "8bc5bf84-5381-3ebd-86db-b32560bd9009",
                                                "text": "Ieſus therfore walked no more openly amõge the iewes : butt went his waye thence vnto a countre ny to a wildernes into a cite called effraym / and there haunted with his diſciples."
                                            },
                                            {
                                                "example_id": "3496c980-5581-4cd8-b20a-2d6e6caa0a16",
                                                "sense_id": "8bc5bf84-5381-3ebd-86db-b32560bd9009",
                                                "text": "[…]That yonder in that faithfull wilderneſſe / Huge monſters haunt,and many dangers dwell;[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37589ef2-5968-3b39-9e5a-73771e3652a6",
                                        "entry_id": "7946243d-129f-3f6f-bdba-58d6a134a7c6",
                                        "glosses": [
                                            "To accustom; habituate; make accustomed to."
                                        ],
                                        "tags": [
                                            "Northern-England",
                                            "Scotland",
                                            "UK",
                                            "dialectal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed906b9f-a231-40d3-a484-111852d83066",
                                                "sense_id": "37589ef2-5968-3b39-9e5a-73771e3652a6",
                                                "text": "[…]haunte thi silf to pite [or pitee].",
                                                "translation": "[…] haunt thyself to piety.",
                                                "english": "[…] haunt thyself to piety."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "725be273-6aa8-33b1-90ff-33c938ea2cf6",
                                        "entry_id": "7946243d-129f-3f6f-bdba-58d6a134a7c6",
                                        "glosses": [
                                            "To practise; to devote oneself to."
                                        ],
                                        "tags": [
                                            "Northern-England",
                                            "Scotland",
                                            "UK",
                                            "dialectal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5b83b5b-fb63-4179-9caf-4840f837fd37",
                                                "sense_id": "725be273-6aa8-33b1-90ff-33c938ea2cf6",
                                                "text": "Leave honest pleasure, and haunt no good pastime."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55a490cd-f28e-345c-9da7-cf7fb165ce4c",
                                        "entry_id": "7946243d-129f-3f6f-bdba-58d6a134a7c6",
                                        "glosses": [
                                            "To persist in staying or visiting."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ae10f3b-142c-4c8b-a948-3583005e73c5",
                                                "sense_id": "55a490cd-f28e-345c-9da7-cf7fb165ce4c",
                                                "text": "I haue charg’d thee not to haunt about my doores:[…]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "haunt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "74215c89-d474-3906-8593-2a8b54c90167",
                                        "entry_id": "58d969e7-ae5d-3d81-bcba-3330214c99dd",
                                        "glosses": [
                                            "A place at which one is regularly found; a habitation or hangout."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e74231f-42be-49aa-87c7-b74611c2a662",
                                                "sense_id": "74215c89-d474-3906-8593-2a8b54c90167",
                                                "text": "The shopping mall is a popular haunt of the local teenagers in this town."
                                            },
                                            {
                                                "example_id": "78c7099c-9965-4c48-a5b4-6aa8e7e3774a",
                                                "sense_id": "74215c89-d474-3906-8593-2a8b54c90167",
                                                "text": "I went back the town I used to live and visited all my old haunts."
                                            },
                                            {
                                                "example_id": "cd01055e-3790-4374-b8b8-68d87d0fb363",
                                                "sense_id": "74215c89-d474-3906-8593-2a8b54c90167",
                                                "text": "It is a great rock or cliff on the loneliest part of the mountains, and, … is known by the name of the Garden Rock. Near the foot of it is a small lake, the haunt of the solitary bittern, with water-snakes basking in the sun on the leaves of the pond-lilies which lie on the surface."
                                            },
                                            {
                                                "example_id": "3d93637a-5ebe-467b-aa37-23ed2fdad2e8",
                                                "sense_id": "74215c89-d474-3906-8593-2a8b54c90167",
                                                "text": "Both Jack and Fletcher had graduated the year before, but still took an interest in their old haunts, and patronized the fellows who were not yet through."
                                            },
                                            {
                                                "example_id": "92287dcd-2ca5-4c31-849f-18e3bc662e5f",
                                                "sense_id": "74215c89-d474-3906-8593-2a8b54c90167",
                                                "text": "Wyoming has been a favorite haunt of paleontologists for the past century ever since westering pioneers reported that many vertebrate fossils were almost lying on the ground."
                                            },
                                            {
                                                "example_id": "31b1aa90-fc00-4777-9d54-7df0209a7c10",
                                                "sense_id": "74215c89-d474-3906-8593-2a8b54c90167",
                                                "text": "It shall be the haunt of jackals, an abode for ostriches."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "942e6b64-3205-3e24-b50d-03517b5f604c",
                                        "entry_id": "58d969e7-ae5d-3d81-bcba-3330214c99dd",
                                        "glosses": [
                                            "A ghost."
                                        ],
                                        "tags": [
                                            "dialectal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ba42e2c1-a9fc-32d4-b448-16e87d586ba3",
                                        "entry_id": "58d969e7-ae5d-3d81-bcba-3330214c99dd",
                                        "glosses": [
                                            "A lair or feeding place of animals."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5cf2f06-a177-4e41-b832-7081cc975722",
                                                "sense_id": "ba42e2c1-a9fc-32d4-b448-16e87d586ba3",
                                                "text": "The lofty mountains roſe faint to the ſight and loſt their foreheads in the diſtant ſkies: the little hills, cloathed in darker green and ſkirted with embroidered vales, diſcovered the ſecret haunts of kids and bounding roes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
