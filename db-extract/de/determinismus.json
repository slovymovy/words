                    {
                        "translation_id": "a5a5daec-7176-4dce-b8e9-07b9944f9076",
                        "source_entry_id": "da8dcca7-ccde-3405-b1ec-7f3786e94463",
                        "source_sense_id": "d3ca4151-72e2-39ec-8251-23b530038dec",
                        "source_sense_description": "Philosophie: die Lehre von der kausalen (Vor-)Bestimmtheit allen Geschehens",
                        "target_lang_word": "determinism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "determinism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cb913e6b-ee60-3a32-9aa7-c4cf535b1e14",
                                        "entry_id": "326d9395-d213-3b95-a535-688ac77941c6",
                                        "glosses": [
                                            "The doctrine that all actions are determined by the current state and immutable laws of the universe, with no possibility of choice."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc357463-ae08-4784-acf0-6b932930927b",
                                                "sense_id": "cb913e6b-ee60-3a32-9aa7-c4cf535b1e14",
                                                "text": "Pereboom’s book presents probably the best available argument for hard incompatibilism (the view that free will is not compatible with causal determinism), and his defence of the sourcehood view is just part of this overall argument."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2f0d9f9-e0c4-330a-9f56-1a8f145175f9",
                                        "entry_id": "326d9395-d213-3b95-a535-688ac77941c6",
                                        "glosses": [
                                            "The property of having behavior determined only by initial state and input."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "efd4ad69-0368-47af-b2b9-68a6a623acff",
                        "source_entry_id": "da8dcca7-ccde-3405-b1ec-7f3786e94463",
                        "source_sense_id": "d3ca4151-72e2-39ec-8251-23b530038dec",
                        "source_sense_description": "Philosophie: die Lehre von der kausalen (Vor-)Bestimmtheit allen Geschehens",
                        "target_lang_word": "déterminisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "déterminisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2429f347-02df-3aa4-ad2a-00107087dbee",
                                        "entry_id": "54194f70-a56e-3ccb-a0d2-4cca5c7db329",
                                        "glosses": [
                                            "Qualité des systèmes, des processus dont l’issue ne dépend que des conditions initiales."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "020f012f-2e65-3503-8674-823f075a7835",
                                        "entry_id": "54194f70-a56e-3ccb-a0d2-4cca5c7db329",
                                        "glosses": [
                                            "Système d’après lequel les phénomènes de la nature sont fatalement produits par un enchaînement nécessaire d’antécédents et de conséquents, de causes et d’effets."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85920c25-700c-4dd2-96b0-e962996d18e2",
                                                "sense_id": "020f012f-2e65-3503-8674-823f075a7835",
                                                "text": "Le déterminisme du volubilisme est à l'origine de travaux nombreux mais il semble toutefois que jusqu'à présent on reste encore, pour une large part, dans le domaine de l'hypothèse."
                                            },
                                            {
                                                "example_id": "8999fae3-a309-480d-8090-4bcfb50e2d19",
                                                "sense_id": "020f012f-2e65-3503-8674-823f075a7835",
                                                "text": "L’absence de liberté résulte donc de l’antagonisme de deux déterminismes comportementaux et de la domination de l’un sur l’autre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59130f5d-0b45-300d-a59f-ccad39dec546",
                                        "entry_id": "54194f70-a56e-3ccb-a0d2-4cca5c7db329",
                                        "glosses": [
                                            "Système qui nie l’influence du libre arbitre sur les actes humains."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dfae268e-8c6c-4f9e-ad66-eab0fec114be",
                                                "sense_id": "59130f5d-0b45-300d-a59f-ccad39dec546",
                                                "text": "Le déterminisme de Spinoza."
                                            },
                                            {
                                                "example_id": "1687dad0-1f78-4e58-a3b0-2755fe2cbb6d",
                                                "sense_id": "59130f5d-0b45-300d-a59f-ccad39dec546",
                                                "text": "Il est tout à fait possible d’embrasser les promesses de la transformation numérique sans négliger pour autant de prendre les précautions nécessaires pour la santé et l’environnement. Il ne faut pas tomber dans le déterminisme technologique et croire que nous n’avons aucun pouvoir sur ces technologies."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
