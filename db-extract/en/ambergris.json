                                                "sense_id": "858596d4-cd59-368f-88a2-5de12d27c300",
                                                "text": "Ambra wird heute synthetisch hergestellt."
                                            },
                                            {
                                                "example_id": "d4f3e679-29b1-43c5-a928-d10d3ce4c1aa",
                                                "sense_id": "858596d4-cd59-368f-88a2-5de12d27c300",
                                                "text": "Frische Ambra riecht sehr unangenehm."
                                            },
                                            {
                                                "example_id": "d5bf9d7f-dc3b-47ef-a7c4-8bed795c54f8",
                                                "sense_id": "858596d4-cd59-368f-88a2-5de12d27c300",
                                                "text": "„Im obersten Knopfloch seines Rockes trug er einen großen Strauß aus Tuberosen und Narzissen; ein starker Duft von Ambra entströmte der Pomade, mit der er Perücke und Brauen am Kopf festgeklebt hatte, und sein durchdringender Mundgeruch mißfiel zwar nicht Madame D'Urfé, war mir aber unerträglich.“"
                                            },
                                            {
                                                "example_id": "dc8fbd6c-3250-4b2d-9c19-951d91c0355e",
                                                "sense_id": "858596d4-cd59-368f-88a2-5de12d27c300",
                                                "text": "„Die Berberin brachte Clerfayt lautlos Ambra.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
