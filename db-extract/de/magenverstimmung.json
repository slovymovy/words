                ],
                "senses": [
                    {
                        "sense_id": "8ae7977a-ee4f-3050-bf16-8e6984d68a32",
                        "entry_id": "322e6883-4ad6-306b-84be-70d80a201d9e",
                        "glosses": [
                            "aus verschiedenen Gründen verursachte Störung in der Magenflora"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85ce2949-5a30-4442-89d5-aa5a807176e5",
                                "sense_id": "8ae7977a-ee4f-3050-bf16-8e6984d68a32",
                                "text": "„Der Magen ist mannigfachen Reizen und bakteriellen Infektionen ausgesetzt, die zu Magenschleimhautentzündungen und Magenverstimmung (Dyspepsie) führen können.“"
                            },
                            {
                                "example_id": "aa709cde-85dc-4c00-863c-386a7aff74b9",
                                "sense_id": "8ae7977a-ee4f-3050-bf16-8e6984d68a32",
                                "text": "„Aber Mutter geht früher als sonst ins Bett, weil eine Magenverstimmung sie plagt.“"
                            },
                            {
                                "example_id": "ca581740-2166-4dbb-b8e9-f203ccb3053b",
                                "sense_id": "8ae7977a-ee4f-3050-bf16-8e6984d68a32",
                                "text": "„Elma hatte die Kopfschmerzen und Magenverstimmungen schon wieder völlig vergessen und sah sich das Bild auf ihrem Handy genau an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cde9eeae-b030-49cc-a5cf-3da00119f552",
                        "source_entry_id": "322e6883-4ad6-306b-84be-70d80a201d9e",
                        "source_sense_id": "8ae7977a-ee4f-3050-bf16-8e6984d68a32",
