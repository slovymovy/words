                        "glosses": [
                            "Ventiler moins que la normale."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "3f8e35f4-30b9-3d9c-b746-f86b3f2b1c76",
                        "entry_id": "78487f9f-273d-371c-9d17-36def56ad00a",
                        "glosses": [
                            "Respirer moins rapidement et moins profondément que la normale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5afb7a96-adc2-4aaf-b3c1-e48868d030c3",
                                "sense_id": "3f8e35f4-30b9-3d9c-b746-f86b3f2b1c76",
                                "text": "En peropératoire, il est recommandé d’hypoventiler l’enfant de manière à induire une acidose respiratoire et une vasconstriction pulmonaire qui diminue le débit du shunt (FiO2 0.21, PaCO2 45-50 mmHg)."
                            },
                            {
                                "example_id": "5ff38957-b68b-482b-9fdf-cc1c8120df3f",
                                "sense_id": "3f8e35f4-30b9-3d9c-b746-f86b3f2b1c76",
                                "text": "En clair, il faut « hypoventiler »."
                            },
                            {
                                "example_id": "b56433c4-f4f2-4ab8-b89a-72eb6eed4d41",
                                "sense_id": "3f8e35f4-30b9-3d9c-b746-f86b3f2b1c76",
                                "text": "Comment le fait que les bicarbonates augmentent améne la personne à hypoventiler ?"
                            }
                        ]
                    }
