{
    "word_family": [
        "pendaison",
        "pendentif",
        "pendouiller",
        "pendule"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8ff060b9-c69a-3b10-bbd0-5424d619d3e7",
                    "sense_definition": "Fixer ou attacher quelque chose en hauteur sans qu'il touche le sol.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "accrochage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il va <w>pendre</w> son manteau au crochet derrière la porte d'entrée."
                        },
                        {
                            "text": "Nous allons <w>pendre</w> ce lustre en cristal au-dessus de la table du salon."
                        }
                    ],
                    "synonyms": [
                        "accrocher",
                        "suspendre"
                    ],
                    "antonyms": [
                        "décrocher"
                    ],
                    "common_phrases": [
                        "pendre la crémaillère"
                    ]
                },
                {
                    "sense_id": "b836202d-1929-3699-ba13-c0bd45693b81",
                    "sense_definition": "Être suspendu en l'air, descendre dans le vide depuis un point d'attache.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "accrochage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De lourdes grappes de raisin mûr <w>pendent</w> aux branches de la vigne."
                        },
                        {
                            "text": "Une longue corde <w>pendait</w> du haut du clocher jusqu'au sol de l'église."
                        }
                    ],
                    "common_phrases": [
                        "pendre au nez"
                    ]
                },
                {
                    "sense_id": "b2434795-020a-3875-aec6-91cd948c6e94",
                    "sense_definition": "Mettre à mort un condamné en l'étranglant au moyen d'une corde fixée au cou.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au Moyen Âge, les juges pouvaient condamner les voleurs à être <w>pendus</w> sur la place publique."
                        },
                        {
                            "text": "Le shérif a menacé de <w>pendre</w> les bandits avant le coucher du soleil."
                        }
                    ]
                },
                {
                    "sense_id": "7de9a927-746b-37b5-bf42-ac087e83710a",
                    "sense_definition": "Se donner la mort en se suspendant par le cou.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Accablé par la ruine et le désespoir, le marchand a tenté de se <w>pendre</w>."
                        },
                        {
                            "text": "Dans cette sombre tragédie, le traître choisit de se <w>pendre</w> dans sa chambre isolée."
                        }
                    ]
                },
                {
                    "sense_id": "50e4f1c6-be7b-3120-9b07-e15661938353",
                    "sense_definition": "Tomber ou descendre trop bas de manière flasque ou disgracieuse.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avec l'âge, la peau fatiguée commençait à <w>pendre</w> tristement autour de ses joues."
                        },
                        {
                            "text": "Le rideau déchiré s'était décroché et continuait de <w>pendre</w> maladroitement vers le plancher."
                        }
                    ],
                    "synonyms": [
                        "tomber"
                    ]
                }
            ]
        }
    ]
}