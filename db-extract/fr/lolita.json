            {
                "entry_id": "af400451-56fd-3e5f-8d12-2eab61881cb1",
                "word": "lolita",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "804ce6d9-1f21-47c4-ae3d-b17e846ff509",
