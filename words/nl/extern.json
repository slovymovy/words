                {
                    "sense_id": "131c6177-3471-3de8-85eb-7a25c3804f31",
                    "sense_definition": "afkomstig van buiten een bepaalde organisatie, groep of systeem",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "buiten_behorend",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het bedrijf besloot een <w>externe</w> adviseur in te huren voor het project.",
                            "target_lang_translations": {
                                "en": "The company decided to hire an <w>external</w> consultant for the project.",
                                "ru": "Компания решила нанять <w>внешнего</w> консультанта для этого проекта."
                            }
                        },
                        {
                            "text": "Een <w>externe</w> factor beïnvloedde de resultaten van het onderzoek aanzienlijk.",
                            "target_lang_translations": {
                                "en": "An <w>external</w> factor significantly influenced the results of the study.",
