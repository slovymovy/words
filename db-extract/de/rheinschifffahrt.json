                        "glosses": [
                            "ohne Plural: Gesamtheit des Schiffsverkehrs auf dem Rhein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "012f8c5a-4ab5-4851-8c5e-94d45a33a289",
                                "sense_id": "b385a066-5635-34d3-8224-b3608d0bede6",
                                "text": "„Hier ist erneut der Tourismus im Fokus der Betrachtung, aber auch das Thema Rheinschifffahrt kann aufgegriffen werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
