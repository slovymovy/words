{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f91a02c1-8616-3199-bdde-a64d15c12925",
                    "sense_definition": "An interruption, break, or pause in an activity or process.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "break",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The band decided to go on <w>hiatus</w> after their final world tour.",
                            "target_lang_translations": {
                                "cs": "Kapela se po svém posledním světovém turné rozhodla dát si <w>pauzu</w>."
                            }
                        },
                        {
                            "text": "After a long <w>hiatus</w> from acting, she returned to the stage.",
                            "target_lang_translations": {
                                "cs": "Po dlouhé <w>přestávce</w> v herectví se vrátila na jeviště."
                            }
                        }
                    ],
                    "synonyms": [
                        "break",
                        "pause",
                        "interruption",
                        "recess"
                    ],
                    "common_phrases": [
                        "on hiatus"
                    ],
                    "target_lang_definitions": {
                        "cs": "Dočasné přerušení, pauza nebo zastavení v činnosti či procesu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "pauza",
                                "target_lang_sense_clarification": "obecné označení pro dočasné přerušení"
                            },
                            {
                                "target_lang_word": "přestávka",
                                "target_lang_sense_clarification": "vynechání činnosti, často plánované"
                            },
                            {
                                "target_lang_word": "přerušení",
                                "target_lang_sense_clarification": "dočasné zastavení probíhajícího děje"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f7ac9139-999b-353b-8a99-0bbe22c2a7f8",
                    "sense_definition": "A gap or missing part in a series or sequence.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "gap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is a significant <w>hiatus</w> in the historical records of that century.",
                            "target_lang_translations": {
                                "cs": "V historických záznamech z onoho století je značná <w>mezera</w>."
                            }
                        },
                        {
                            "text": "The researcher identified a <w>hiatus</w> in the data that made the conclusion uncertain.",
                            "target_lang_translations": {
                                "cs": "Výzkumník identifikoval v datech <w>mezeru</w>, kvůli které byl závěr nejistý."
                            }
                        }
                    ],
                    "synonyms": [
                        "gap",
                        "lapse"
                    ],
                    "target_lang_definitions": {
                        "cs": "Mezera nebo chybějící část v řadě či posloupnosti."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "mezera",
                                "target_lang_sense_clarification": "prázdné místo v řadě nebo v informacích"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4408c7d6-5fb8-3ef2-a50a-1abe5ca9a4e0",
                    "sense_definition": "A break in the continuity of geological rock layers.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "gap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>hiatus</w> in the sedimentary rock indicates a long period of erosion.",
                            "target_lang_translations": {
                                "cs": "<w>Hiát</w> v sedimentární hornině naznačuje dlouhé období eroze."
                            }
                        },
                        {
                            "text": "Geologists studied the <w>hiatus</w> to understand the ancient environmental changes.",
                            "target_lang_translations": {
                                "cs": "Geologové studovali <w>hiát</w>, aby pochopili dávné změny životního prostředí."
                            }
                        }
                    ],
                    "synonyms": [
                        "gap"
                    ],
                    "target_lang_definitions": {
                        "cs": "Přerušení kontinuity geologických vrstev hornin."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "hiát",
                                "target_lang_sense_clarification": "odborný termín pro přerušení sedimentace"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5225cac4-8b80-3d6e-87a5-17ec4a654d44",
                    "sense_definition": "A natural opening or passage in an anatomical structure or organ.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "opening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The diaphragm contains a <w>hiatus</w> through which the esophagus passes.",
                            "target_lang_translations": {
                                "cs": "Bránice obsahuje <w>hiát</w>, kterým prochází jícen."
                            }
                        },
                        {
                            "text": "A small <w>hiatus</w> in the muscle wall can sometimes lead to a hernia.",
                            "target_lang_translations": {
                                "cs": "Malá <w>skulina</w> ve svalové stěně může někdy vést ke kýle."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Přirozený otvor nebo průchod v anatomické struktuře či orgánu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "hiát",
                                "target_lang_sense_clarification": "anatomický otvor"
                            },
                            {
                                "target_lang_word": "skulina",
                                "target_lang_sense_clarification": "úzký otvor nebo štěrbina"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0c3b2c4e-78c9-3f1e-9a0a-fa5b5fa1a129",
                    "sense_definition": "A break between two vowels that are pronounced separately without a consonant between them.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The word 'cooperate' contains a <w>hiatus</w> between the two vowels.",
                            "target_lang_translations": {
                                "cs": "Slovo 'cooperate' obsahuje mezi dvěma samohláskami <w>hiát</w>."
                            }
                        },
                        {
                            "text": "In some languages, a <w>hiatus</w> is avoided by inserting a glottal stop.",
                            "target_lang_translations": {
                                "cs": "V některých jazycích se <w>hiátu</w> předchází vložením rázové souhlásky."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Setkání dvou samohlásek na rozhraní slov nebo slabik, které jsou vyslovovány odděleně."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "hiát",
                                "target_lang_sense_clarification": "lingvistický termín pro střet samohlásek"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}