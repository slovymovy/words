{
    "word_family": [
        "length",
        "lengthen",
        "lengthily",
        "lengthiness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4d577bd7-c28f-33d0-a276-bd9b63696b99",
                    "sense_definition": "Lasting for a long time, often longer than necessary or expected.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "duration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She died last night after a <w>lengthy</w> illness.",
                            "target_lang_translations": {
                                "ru": "Она умерла прошлой ночью после <w>продолжительной</w> болезни.",
                                "es": "Murió anoche tras una <w>prolongada</w> enfermedad."
                            }
                        },
                        {
                            "text": "The committee engaged in a <w>lengthy</w> discussion regarding the new policy.",
                            "target_lang_translations": {
                                "ru": "Комитет вступил в <w>длительную</w> дискуссию по поводу новой политики.",
                                "es": "El comité mantuvo una <w>larga</w> discusión sobre la nueva política."
                            }
                        }
                    ],
                    "synonyms": [
                        "extended",
                        "prolonged",
                        "protracted",
                        "long"
                    ],
                    "antonyms": [
                        "brief",
                        "short"
                    ],
                    "common_phrases": [
                        "lengthy process",
                        "lengthy discussion",
                        "lengthy delay",
                        "lengthy investigation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Продолжающийся долгое время, часто дольше, чем необходимо или ожидалось.",
                        "es": "Que dura mucho tiempo, a menudo más de lo necesario o de lo esperado."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "длительный",
                                "target_lang_sense_clarification": "продолжающийся долго"
                            },
                            {
                                "target_lang_word": "затяжной",
                                "target_lang_sense_clarification": "длящийся слишком долго, утомительный"
                            },
                            {
                                "target_lang_word": "продолжительный",
                                "target_lang_sense_clarification": "занимающий много времени"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "largo",
                                "target_lang_sense_clarification": "de gran duración"
                            },
                            {
                                "target_lang_word": "prolongado",
                                "target_lang_sense_clarification": "que se extiende más de lo habitual"
                            },
                            {
                                "target_lang_word": "interminable",
                                "target_lang_sense_clarification": "excesivamente largo o tedioso"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "36dd13d1-c3fe-3768-8ce5-d0f49f5a31e6",
                    "sense_definition": "Describing a person who speaks or writes using too many words.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verbosity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>lengthy</w> preacher made the service last much longer than usual.",
                            "target_lang_translations": {
                                "ru": "<w>Многословный</w> проповедник затянул службу намного дольше обычного.",
                                "es": "El <w>prolijo</w> predicador hizo que el servicio durara mucho más de lo habitual."
                            }
                        },
                        {
                            "text": "He is a <w>lengthy</w> storyteller who tends to include every minor detail.",
                            "target_lang_translations": {
                                "ru": "Он <w>многословный</w> рассказчик, который склонен включать каждую мелкую деталь.",
                                "es": "Es un narrador <w>prolijo</w> que suele incluir hasta el más mínimo detalle."
                            }
                        }
                    ],
                    "synonyms": [
                        "long-winded",
                        "verbose",
                        "wordy"
                    ],
                    "antonyms": [
                        "concise",
                        "terse"
                    ],
                    "target_lang_definitions": {
                        "ru": "Описывает человека, который говорит или пишет, используя слишком много слов.",
                        "es": "Dicho de una persona: que habla o escribe usando demasiadas palabras."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "многословный",
                                "target_lang_sense_clarification": "использующий лишние слова"
                            },
                            {
                                "target_lang_word": "растянутый",
                                "target_lang_sense_clarification": "о речи или повествовании"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "prolijo",
                                "target_lang_sense_clarification": "demasiado extenso al hablar o escribir"
                            },
                            {
                                "target_lang_word": "verborreico",
                                "target_lang_sense_clarification": "que habla con excesiva palabrería"
                            },
                            {
                                "target_lang_word": "pesado",
                                "target_lang_sense_clarification": "aburrido por extenderse demasiado"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}