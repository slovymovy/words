{
    "word_family": [
        "muffle",
        "muffler"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d8383cc0-ff82-3726-9a5d-f81a0e15f75a",
                    "sense_definition": "Stifled or covered up; diminished in sound or intensity by interference.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sound_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>muffled</w> curse escaped my lips when I stubbed my toe.",
                            "target_lang_translations": {
                                "cs": "Když jsem si narazil palec, vyklouzla mi ze rtů <w>tlumená</w> kletba."
                            }
                        },
                        {
                            "text": "We heard the <w>muffled</w> sound of music coming from the apartment next door.",
                            "target_lang_translations": {
                                "cs": "Slyšeli jsme <w>tlumený</w> zvuk hudby vycházející z bytu od sousedů."
                            }
                        }
                    ],
                    "synonyms": [
                        "deadened",
                        "dull"
                    ],
                    "common_phrases": [
                        "muffled sound",
                        "muffled voice"
                    ],
                    "target_lang_definitions": {
                        "cs": "Zvuk nebo hlas, který je tlumený, zastřený nebo méně intenzivní kvůli překážce."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "tlumený",
                                "target_lang_sense_clarification": "obecné označení pro zvuk, který není jasný nebo hlasitý"
                            },
                            {
                                "target_lang_word": "zastřený",
                                "target_lang_sense_clarification": "používá se zejména pro hlas nebo zvuk, který zní jako přes vrstvu materiálu"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8edef3f2-5392-33d9-9477-a444707f2c86",
                    "sense_definition": "Simple past and past participle of <w>muffle</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>muffled</w> her laughter with a silk handkerchief.",
                            "target_lang_translations": {
                                "cs": "Svůj smích si <w>ztlumila</w> hedvábným kapesníkem."
                            }
                        },
                        {
                            "text": "The heavy curtains <w>muffled</w> the noise from the busy street outside.",
                            "target_lang_translations": {
                                "cs": "Těžké závěsy <w>utlumily</w> hluk z rušné ulice venku."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle of a verb"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Minulý čas a příčestí trpné slovesa muffle, znamenající ztlumit nebo utišit zvuk."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "ztlumil/a",
                                "target_lang_sense_clarification": "minulý čas slovesa ztlumit"
                            },
                            {
                                "target_lang_word": "utlumil/a",
                                "target_lang_sense_clarification": "minulý čas slovesa utlumit, často ve smyslu potlačení hluku"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}