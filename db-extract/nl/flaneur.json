                "senses": [
                    {
                        "sense_id": "f2c7a6ee-8701-35fb-abd5-d306989f5421",
                        "entry_id": "e9ae8532-e170-31c4-9262-1c5e0109779c",
                        "glosses": [
                            "elegante slenteraar of wandelaar"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53af6cb0-4f83-4810-ab85-6945f3478cce",
                                "sense_id": "f2c7a6ee-8701-35fb-abd5-d306989f5421",
                                "text": "Langs het uitgestrekte industrieterrein, Strijp S geheten, zingen borden dat hier straks niet meer wordt geschaft maar geluncht en dat arbeiders zullen plaatsmaken voor flaneurs. Die beweringen doen onwerkelijk aan voor wie de puinhopen en verlaten fabrieken vanuit de trein passeert."
                            },
                            {
                                "example_id": "5e1d17b9-8e08-479b-bd90-db605084165d",
                                "sense_id": "f2c7a6ee-8701-35fb-abd5-d306989f5421",
                                "text": "De kilometerslange straat langs de Nieuwe Waterweg heet Boulevard Rozenburg. Wie bij zo’n weidse benaming denkt aan grand hotels, coutureboutiques en elegante flaneurs, komt hier niet helemaal aan zijn trekken."
                            }
                        ]
                    }
