                        "examples": [
                            {
                                "example_id": "04b84278-31c3-4b4d-bb25-c2dbfd6d52f5",
                                "sense_id": "dd746aff-17f6-380d-9f83-a54750c8a518",
                                "text": "Il s’agissait seulement du vocable « maman », une labiale douce, et du vocable « papa », une labiale dure."
                            },
                            {
                                "example_id": "64b8946b-7236-4077-925f-8875cd6c397e",
                                "sense_id": "dd746aff-17f6-380d-9f83-a54750c8a518",
                                "text": "14 octobre 1940 – J’ai l’impression d’avoir déjà un peu moins d’appétit pour les labiales fricatives. Quelque chose est en perte de vitesse en moi… et je n’ai pas vingt ans !"
                            }
                        ]
                    }
