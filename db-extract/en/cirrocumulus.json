                "entry_id": "5a122b46-0c52-38cd-b847-f9504e9eb3c9",
                "word": "cirrocumulus",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "812f0160-ccfa-457c-9bc8-43dec1bf69e8",
                        "entry_id": "5a122b46-0c52-38cd-b847-f9504e9eb3c9",
                        "tags": [
                            "plural"
                        ],
                        "form": "cirrocumuli"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "707a21f9-fc3b-3736-a82e-841b032e2e5e",
                        "entry_id": "5a122b46-0c52-38cd-b847-f9504e9eb3c9",
                        "glosses": [
                            "A principal high-level cloud type appearing as a thin, white patch of cloud without shadows, composed of very small droplets in the form of grains or ripples. The elements may be merged or separate, and more or less regularly arranged; they subtend an angle of less than 1° when observed at an angle of more than 30° above the horizon. Holes or rifts often occur in a sheet of cirrocumulus. Abbreviated Cc."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "25336d81-0961-4c9f-adb1-1e0cbe1a1884",
                        "source_entry_id": "5a122b46-0c52-38cd-b847-f9504e9eb3c9",
                        "source_sense_id": "707a21f9-fc3b-3736-a82e-841b032e2e5e",
                        "source_sense_description": "a cloud type",
                        "target_lang_word": "schapenwolk",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schapenwolk",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "ad002027-f6ef-3df0-a623-075b7298aeb1",
                                        "entry_id": "4156ecaf-de14-3aac-9467-508439f28944",
                                        "glosses": [
                                            "wolk die zich als een witte, wollige vlok aftekent tegen de hemel, meestal in een patroon van dergelijke wolken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4060516c-f911-4807-b9cc-3bcfeeea4eea",
                                                "sense_id": "ad002027-f6ef-3df0-a623-075b7298aeb1",
                                                "text": "David loopt over het strand, de zon schijnt, schapenwolken drijven over de duinen, de zee ruist als vanouds."
                                            },
                                            {
                                                "example_id": "6e9f3f49-67f9-442e-9c07-5758093a40bc",
                                                "sense_id": "ad002027-f6ef-3df0-a623-075b7298aeb1",
                                                "text": "De vlakke, groene omgeving oogt Hollands, de lucht is bedekt met schapenwolkjes."
                                            },
                                            {
                                                "example_id": "b03bc8ee-431d-46ea-b433-db8ac9d21470",
                                                "sense_id": "ad002027-f6ef-3df0-a623-075b7298aeb1",
                                                "text": "Ik was net dood, steeg op naar de hemel, ins Blaue hinein, en ontwaarde Petrus. Alleen zijn ontblote bovenlichaam - mooie jongen trouwens - stak uit boven een spierwitte schapenwolk."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4be9ef4d-df17-4d87-a56f-5edea8cd7e6b",
                        "source_entry_id": "5a122b46-0c52-38cd-b847-f9504e9eb3c9",
                        "source_sense_id": "707a21f9-fc3b-3736-a82e-841b032e2e5e",
                        "source_sense_description": "a cloud type",
                        "target_lang_word": "cirrocumulus",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cirrocumulus",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "ad80b828-ba4d-381e-bcfa-ee5a710b699c",
                                        "entry_id": "c40790d2-af1b-3d7c-a3a0-d750e9b71c9b",
                                        "glosses": [
                                            "een soort wolk die op grote hoogte, 6 tot 10 km in grotere velden voorkomt, vaak een golfachtige structuur heeft en de aankondiger van een komend koufront is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b399c6e8-29ec-4e2a-ab4d-83d8967b1af7",
                                                "sense_id": "ad80b828-ba4d-381e-bcfa-ee5a710b699c",
                                                "text": "Kijk die cirrocumulus eens, het weer gaat vast verslechteren."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3b3f3ef5-81b6-47cc-8a08-cb66afacbb8c",
