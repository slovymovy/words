                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d14869d0-cc8d-4a8e-9b04-a87c427800b2",
                                "sense_id": "da3e57a6-868b-3a0b-84ac-d295712c1c4d",
                                "text": "„Außerdem ist [der Rückwärtsgang] mit einer gerade verzahnten Übersetzung ausgestattet, während die Zahnräder für die Geradeausfahrt schräg verzahnt sind.“"
                            },
                            {
                                "example_id": "addd3f19-c0a2-4458-83e9-9191a52dfb48",
                                "sense_id": "da3e57a6-868b-3a0b-84ac-d295712c1c4d",
                                "text": "„Dann unternahmen sie mehrere Geradeausfahrten, angefangen an den Markierungsbojen, wobei sie den weißen Rumpf des NOAA-Schiffs als Bezugspunkt benutzten, um ihren Kurs zu halten.“"
                            }
                        ],
