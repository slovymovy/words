                                    {
                                        "sense_id": "3a4f18df-9eb7-3c3c-aa90-2630a10ae3f3",
                                        "entry_id": "a9117005-71b7-3ba1-9610-d538858f9f04",
                                        "glosses": [
                                            "zu den Komoren gehörig, von den Komoren kommend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09dee74b-1c7f-4da0-8312-30e99a80f14b",
                                                "sense_id": "3a4f18df-9eb7-3c3c-aa90-2630a10ae3f3",
                                                "text": "Der komorische Außenminister ist heute in Berlin."
                                            },
                                            {
                                                "example_id": "432830ee-2ad6-4f4d-a70e-394ed017dda6",
                                                "sense_id": "3a4f18df-9eb7-3c3c-aa90-2630a10ae3f3",
                                                "text": "„Letztere stellen eine tragende Säule der komorischen Wirtschaft dar, denn von ihnen gehen monatliche Überweisungen an ihre Familien in die Heimat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d342fbbc-58c3-3f4c-a3c3-d0795ffe1f5d",
                                        "entry_id": "a9117005-71b7-3ba1-9610-d538858f9f04",
                                        "glosses": [
                                            "zum Volk der Komorer gehörig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d4db058-e1b5-422b-ac37-ab775131c4aa",
                                                "sense_id": "d342fbbc-58c3-3f4c-a3c3-d0795ffe1f5d",
                                                "text": "Er brachte seine komorische Ehefrau mit."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "91ab02e9-13fc-32c4-abba-2d3d21a440ad",
                                        "entry_id": "a9117005-71b7-3ba1-9610-d538858f9f04",
                                        "glosses": [
                                            "zur Sprache Komorisch gehörig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec349e8f-4f97-485f-a3c8-78db3d04e03c",
                                                "sense_id": "91ab02e9-13fc-32c4-abba-2d3d21a440ad",
                                                "text": "Ich habe wieder ein paar komorische Wörter gelernt."
                                            },
                                            {
                                                "example_id": "25136912-9f5a-40b9-8cd6-4930bad3b56b",
                                                "sense_id": "91ab02e9-13fc-32c4-abba-2d3d21a440ad",
                                                "text": "„Um meinen Landsleuten aus Marseille also einen Dienst zu erweisen, habe ich die schwierige Aufgabe angenommen, einen Einführungskurs in die komorische Sprache vorzubereiten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
