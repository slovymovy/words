                ],
                "senses": [
                    {
                        "sense_id": "2b51402e-3f26-3e98-9bd1-75859703aaea",
                        "entry_id": "eda9767f-2c65-3c37-92cd-268e6b5ebc2d",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01726fc2-f536-4ec3-b669-8e913f7b27bb",
                                "sense_id": "2b51402e-3f26-3e98-9bd1-75859703aaea",
                                "text": "Frau Cserny ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "369ac3c8-57b4-49a8-962e-8932e32e86a5",
                                "sense_id": "2b51402e-3f26-3e98-9bd1-75859703aaea",
                                "text": "Herr Cserny wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "91ece805-7c44-4dc3-96ae-662cb543ae14",
                                "sense_id": "2b51402e-3f26-3e98-9bd1-75859703aaea",
                                "text": "Die Csernys kommen heute aus dem Eichsfeld."
                            },
                            {
                                "example_id": "e43189f1-e880-487b-bda5-b93efd9b3b5c",
                                "sense_id": "2b51402e-3f26-3e98-9bd1-75859703aaea",
                                "text": "Der Cserny trägt nie die Schals, die die Cserny ihm strickt."
                            },
                            {
                                "example_id": "6e48d8db-1afe-40e6-b9ee-69a5451f11e0",
                                "sense_id": "2b51402e-3f26-3e98-9bd1-75859703aaea",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Cserny kommt, geht der Herr Cserny.“"
                            },
                            {
                                "example_id": "b5352154-79fb-4595-901c-5df35fc74199",
                                "sense_id": "2b51402e-3f26-3e98-9bd1-75859703aaea",
                                "text": "Cserny kommt und geht."
                            },
                            {
                                "example_id": "5c162f32-a2b0-4313-aac7-61831352d2ec",
                                "sense_id": "2b51402e-3f26-3e98-9bd1-75859703aaea",
                                "text": "Csernys kamen, sahen und siegten."
                            },
                            {
                                "example_id": "57623517-0bf3-420f-9ec5-a9f910a3a5aa",
                                "sense_id": "2b51402e-3f26-3e98-9bd1-75859703aaea",
                                "text": "An verregneten Herbsttagen ist Familie Csernys liebste Beschäftigung das Bemalen von Hühnereiern."
                            },
                            {
                                "example_id": "a456c70b-0d18-4134-883d-9f8b21aa529d",
                                "sense_id": "2b51402e-3f26-3e98-9bd1-75859703aaea",
                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Cserny das Schmücken von Weihnachtsbäumen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
