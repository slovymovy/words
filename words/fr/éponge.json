            "senses": [
                {
                    "sense_id": "9c3a92dd-13de-3978-aab1-0837278bc9e8",
                    "sense_definition": "Objet spongieux et absorbant destiné à la toilette ou au nettoyage.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "ustensile",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'utilise une <w>éponge</w> humide pour nettoyer la table de la cuisine."
                        },
                        {
                            "text": "Après la vaisselle, n'oublie pas de bien rincer l'<w>éponge</w>."
                        }
                    ],
                    "common_phrases": [
