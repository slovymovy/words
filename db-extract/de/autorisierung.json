                    },
                    {
                        "form_id": "25d19c5d-bd6a-49bb-ad7b-6feb640ab3d0",
                        "entry_id": "fe58c19a-32fd-3ace-98ab-fbd6baf5c46f",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Autorisierung"
                    },
                    {
                        "form_id": "c736e64b-b627-45cb-a50e-59fb5b1e6c9a",
                        "entry_id": "fe58c19a-32fd-3ace-98ab-fbd6baf5c46f",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Autorisierungen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3f41a9ec-3d38-35ce-998b-4762870cf8c5",
                        "entry_id": "fe58c19a-32fd-3ace-98ab-fbd6baf5c46f",
                        "glosses": [
                            "Erteilung einer Vollmacht oder Befugnis, auch die Vollmacht selbst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ebc674eb-7e05-419a-aa0b-cbd81e05f4f0",
                                "sense_id": "3f41a9ec-3d38-35ce-998b-4762870cf8c5",
                                "text": "„Die Autoren der Kunstwerke, wie sie im vorherigen Artikel erwähnt wurden, könnten das exklusive Recht zur Reproduktion oder zur Autorisierung der Reproduktion abtreten und würden dabei trotzdem das Besitzrecht über das Originalwerk behalten.“"
                            },
                            {
                                "example_id": "ec6d71bc-c240-48bc-930f-4c89edca0f82",
                                "sense_id": "3f41a9ec-3d38-35ce-998b-4762870cf8c5",
                                "text": "„Hat ein Zahlungsdienstleister einen Zahlungsvorgang ohne Autorisierung vorgenommen, hat er keinen Anspruch auf Ersatz seiner Auslagen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d2d8929e-b6f0-3944-af62-4a32ab702668",
                        "entry_id": "fe58c19a-32fd-3ace-98ab-fbd6baf5c46f",
                        "glosses": [
                            "Erteilung einer Genehmigung, auch die Genehmigung selbst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1e754da-fcb7-4724-bf6a-a76cafedb8fb",
                                "sense_id": "d2d8929e-b6f0-3944-af62-4a32ab702668",
                                "text": "Können Sie mir eine Autorisierung für den Interviewtext vorlegen?"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "4b023a35-b2fd-30e5-ad5a-60e43f9e760e",
                        "entry_id": "fe58c19a-32fd-3ace-98ab-fbd6baf5c46f",
                        "glosses": [
                            "Nachweis der Identität (die mit gewissen Rechten verknüpft ist)"
                        ],
                        "tags": [
                            "EDV",
                            "Online-Geschäfte"
                        ],
                        "examples": [
                            {
                                "example_id": "a4da47f3-0dd1-4d13-83c8-8e16a1c0bb9c",
                                "sense_id": "4b023a35-b2fd-30e5-ad5a-60e43f9e760e",
                                "text": "„Die Autorisierung zur Tätigung einer Zahlung wird aus einer anderen Autorisierung abgeleitet: Wer Zugang zu einem Telefon, einem Handy oder einer Internetverbindung hat, belegt damit, so wird unterstellt, dass er der Gläubiger des dazugehörigen Vertrags ist.“"
                            },
                            {
                                "example_id": "4ef0da18-c012-4a54-8173-db374d4c8ff2",
                                "sense_id": "4b023a35-b2fd-30e5-ad5a-60e43f9e760e",
                                "text": "„Bei der Autorisierung wird der Zugang zu Datenbanken oder Anwendungen mittels Access-Control-Listen oder Zertifikaten oder anderer Zugangskontrollmethoden überprüft und bei Berechtigung Zugang gewährt.“"
                            },
                            {
                                "example_id": "8db3d7a9-343e-4474-a9c4-25ad44245e4d",
                                "sense_id": "4b023a35-b2fd-30e5-ad5a-60e43f9e760e",
                                "text": "„Der Verkauf oder Einkauf von Gütern und Dienstleistungen in einer geschützten Umgebung fordert die Autorisierung über eine eigenständige Stelle in Form einer Site-Zertifizierung oder „digital ID“ (siehe unten).“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e229c17e-5153-41b1-87b4-3198a7a9103e",
                        "source_entry_id": "fe58c19a-32fd-3ace-98ab-fbd6baf5c46f",
                        "source_sense_id": "3f41a9ec-3d38-35ce-998b-4762870cf8c5",
                        "source_sense_description": "Erteilung einer Vollmacht oder Befugnis, auch die Vollmacht selbst",
                        "target_lang_word": "authorization",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "authorization",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "540ca18b-c4a8-341c-93b6-c164074a34aa",
                                        "entry_id": "df57cc17-28cf-3254-8bde-aaa8469e4096",
                                        "glosses": [
                                            "An act of authorizing."
                                        ],
                                        "tags": [
                                            "British",
                                            "English",
                                            "Oxford",
                                            "US",
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8f375f1-762b-4f4c-b01f-8cb632167e11",
                                                "sense_id": "540ca18b-c4a8-341c-93b6-c164074a34aa",
                                                "text": "Our proposal thus envisages a new procedure for the authorization of experimental program"
                                            },
                                            {
                                                "example_id": "06da4cc9-4f25-4d6d-b4d2-5cc7eca36085",
                                                "sense_id": "540ca18b-c4a8-341c-93b6-c164074a34aa",
                                                "text": "His authorization of decapitation targeting is incompatible with his theory of limited war"
                                            },
                                            {
                                                "example_id": "7307111a-49a5-4ca1-a82a-c7cb07eed43b",
                                                "sense_id": "540ca18b-c4a8-341c-93b6-c164074a34aa",
                                                "text": "Its purpose is to govern the authorization of credit institutions and the provision of financial services throughout the EC."
                                            },
                                            {
                                                "example_id": "6e5b42fa-3c06-418d-915f-6f2a34adc22b",
                                                "sense_id": "540ca18b-c4a8-341c-93b6-c164074a34aa",
                                                "text": "She pushed buttons at a new, small oval kind of telescreen, quickly gathering together the high-level authorizations it had taken hours of preparation to collect."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23348603-c12c-3837-abbe-22c169ad3ea8",
                                        "entry_id": "df57cc17-28cf-3254-8bde-aaa8469e4096",
                                        "glosses": [
                                            "The state of being authorized to do something or to be somewhere; formally granted permission."
                                        ],
                                        "tags": [
                                            "British",
                                            "English",
                                            "Oxford",
                                            "US",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50ffdb3d-6ced-4865-b4f8-05cffabe97e0",
                                                "sense_id": "23348603-c12c-3837-abbe-22c169ad3ea8",
                                                "text": "I've got authorization. Call the office and you'll see."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "071263c4-2f1c-34dd-bbfd-37cdce32af88",
                                        "entry_id": "df57cc17-28cf-3254-8bde-aaa8469e4096",
                                        "glosses": [
                                            "A document giving formal sanction, permission or warrant."
                                        ],
                                        "tags": [
                                            "British",
                                            "English",
                                            "Oxford",
                                            "US",
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b90b1587-bb20-4306-924a-aaaddce04f46",
                                                "sense_id": "071263c4-2f1c-34dd-bbfd-37cdce32af88",
                                                "text": "Can I see your authorization?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21f07119-3fbe-3349-af34-9bdb84cb5862",
                                        "entry_id": "df57cc17-28cf-3254-8bde-aaa8469e4096",
                                        "glosses": [
                                            "Permission, possibly limited, to spend funds for a specific budgetary purpose."
                                        ],
                                        "tags": [
                                            "British",
                                            "English",
                                            "Oxford",
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff3c0633-eb64-4f11-8633-c4b7d60cca00",
                                                "sense_id": "21f07119-3fbe-3349-af34-9bdb84cb5862",
                                                "text": "We've had the authorization for years, but we've never gotten an appropriation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
