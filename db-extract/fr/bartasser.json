                "senses": [
                    {
                        "sense_id": "e477ca99-4028-3dc5-a046-be9be3ac99b9",
                        "entry_id": "681c4fd3-7874-3dde-a6b7-6ac1ee0e14c3",
                        "glosses": [
                            "Sortir des itinéraires normaux, avoir des difficultés pour arriver à destination."
                        ],
                        "tags": [
                            "France"
                        ],
                        "examples": [
                            {
                                "example_id": "b71672f9-06b1-42cc-882b-98e33dcb1320",
                                "sense_id": "e477ca99-4028-3dc5-a046-be9be3ac99b9",
                                "text": "À la descente du ferry, pas besoin de bartasser 3 heures dans le maquis, ni de lutter contre les cochons sauvages pour localiser le site : on ne voit (presque) que ça !"
                            },
                            {
                                "example_id": "c39026f8-6f51-4d76-a47d-a49bf1fa776f",
                                "sense_id": "e477ca99-4028-3dc5-a046-be9be3ac99b9",
                                "text": "Bartasser au cours d’une randonnée, c’est passer au milieu des buissons, sortir des sentiers battus."
                            },
                            {
                                "example_id": "d39b77bd-309b-4289-9e4f-7397789a16b2",
                                "sense_id": "e477ca99-4028-3dc5-a046-be9be3ac99b9",
                                "text": "À partir de là, l’itinéraire suit des pistes et devient un peu monotone, nous préférons bartasser un peu pour trouver un itinéraire inédit."
                            }
                        ]
                    }
                ],
