                                        "examples": [
                                            {
                                                "example_id": "101b7e22-a018-43b2-90d4-69d15920f74e",
                                                "sense_id": "aac0e487-f583-37fa-b7f2-b52a8b1b901c",
                                                "text": "By 1968, CSM was in such a powerful position that he gave orders to FBI Director J. Edgar Hoover, and “worked hard to keep any President from knowing” he even existed."
                                            },
                                            {
                                                "example_id": "9d2724d7-a685-400a-8535-17a8da0e8d3a",
                                                "sense_id": "aac0e487-f583-37fa-b7f2-b52a8b1b901c",
                                                "text": "Although the CSM has few lines, metaphorically he represents all the secret U.S. operatives of the cold war and after."
                                            },
                                            {
                                                "example_id": "1cb9387b-4439-4951-bb46-a1eece7b0bfb",
                                                "sense_id": "aac0e487-f583-37fa-b7f2-b52a8b1b901c",
                                                "text": "By the way, I realize the CSM is the show’s resident villain, but the WMM has always struck me as being more sinister."
                                            }
