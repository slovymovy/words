    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "abf65735-7fb7-3466-a5df-247a506d0d6c",
                "word": "lifesaver",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "fdbb798f-874d-47b8-a888-c6ef3cc536c7",
                        "entry_id": "abf65735-7fb7-3466-a5df-247a506d0d6c",
                        "tags": [
                            "plural"
                        ],
                        "form": "lifesavers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b028fa3c-bd5b-37d8-a2ec-b34667210248",
                        "entry_id": "abf65735-7fb7-3466-a5df-247a506d0d6c",
                        "glosses": [
                            "Someone or something that saves lives."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b631856-cc3a-4f20-8d2e-f4f9b195ad8f",
                                "sense_id": "b028fa3c-bd5b-37d8-a2ec-b34667210248",
                                "text": "My dad loves his job as a surf lifesaver."
                            },
                            {
                                "example_id": "d6fb6d9c-300a-479b-99d5-ed3629b6bb4e",
                                "sense_id": "b028fa3c-bd5b-37d8-a2ec-b34667210248",
                                "text": "Paramedics are not just ordinary workers, but lifesavers with a very important job."
                            },
                            {
                                "example_id": "1785e8f7-b174-4e7b-b657-0c868d619cc6",
                                "sense_id": "b028fa3c-bd5b-37d8-a2ec-b34667210248",
                                "text": "Dexamethasone hailed as lifesaver for up to a million Covid patients worldwide [title]"
                            },
                            {
                                "example_id": "f4059e46-60ec-4acf-a35e-87b1bc485797",
                                "sense_id": "b028fa3c-bd5b-37d8-a2ec-b34667210248",
                                "text": "Ms Rybicki began filming just as a second IRB drove out to the rogue boat, collecting the first lifesaver into the boat en route."
                            }
                        ]
                    },
                    {
                        "sense_id": "3643b7cd-5f0c-3328-9b78-5e767d10b5f3",
                        "entry_id": "abf65735-7fb7-3466-a5df-247a506d0d6c",
                        "glosses": [
                            "Someone or something that is very useful or helpful."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "9a135ba8-d41b-43a6-af5e-1e566ac3f7f1",
                                "sense_id": "3643b7cd-5f0c-3328-9b78-5e767d10b5f3",
                                "text": "Thank you so much for fixing my car; you're a real lifesaver!"
                            },
                            {
                                "example_id": "d3f1744b-ceb7-4937-b693-849dbe4a2ccf",
                                "sense_id": "3643b7cd-5f0c-3328-9b78-5e767d10b5f3",
                                "text": "This shop is a lifesaver on a hot day when you're craving a cold drink."
                            },
                            {
                                "example_id": "b3dbdccb-bf00-40a8-9d80-35d6b34a2caf",
                                "sense_id": "3643b7cd-5f0c-3328-9b78-5e767d10b5f3",
                                "text": "Both Netflix and Amazon Prime Video have been lifesavers during the pandemic. Having both is ideal."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0b30bf2b-4383-4e9f-95c8-d9a780007d11",
                        "source_entry_id": "abf65735-7fb7-3466-a5df-247a506d0d6c",
                        "source_sense_description": "that saves lives",
                        "target_lang_word": "secouriste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "secouriste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b4aa3af6-b8fe-326d-b8db-8a8a5a19a269",
                                        "entry_id": "1306f3db-257e-3223-992b-a818e14d6692",
                                        "glosses": [
                                            "Personne qui porte secours, qui apporte une aide de première urgence aux blessés ou accidentés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0d6ba5c-090c-4935-a0f3-fcd485406d2e",
                                                "sense_id": "b4aa3af6-b8fe-326d-b8db-8a8a5a19a269",
                                                "text": "Le secouriste diplômé peut, s'il le désire, faire partie des équipes de premiers secours intervenant lors de catastrophes ou de situations particulières (secours sur route, sur eau, en montagne, etc...)."
                                            },
                                            {
                                                "example_id": "e3886d9e-ef8f-499b-9757-fec37047ee31",
                                                "sense_id": "b4aa3af6-b8fe-326d-b8db-8a8a5a19a269",
                                                "text": "Aujourd'hui, les acteurs du secours sont nombreux : secouristes professionnels, infirmiers, médecins, équipages d’hélicoptère mais aussi marins, montagnards et spéléologues bénévoles."
                                            },
                                            {
                                                "example_id": "5ece0a75-0496-40f8-ade5-f38744005677",
                                                "sense_id": "b4aa3af6-b8fe-326d-b8db-8a8a5a19a269",
                                                "text": "Dès l'arrivée franchie, il a été terrassé par un arrêt cardiaque. Comme nous savons que c'est fréquent, il est tombé au pied d'une ravissante secouriste de la protection civile qui a commencé les gestes, et les médecins urgentistes du Samu ont été à ses côtés en moins de quatre minutes."
                                            },
                                            {
                                                "example_id": "edf790c9-6912-4eb4-88c4-84fb455132c7",
                                                "sense_id": "b4aa3af6-b8fe-326d-b8db-8a8a5a19a269",
                                                "text": "Les secouristes et les autres membres de l’expédition arrivaient enfin à l’épave de l’avion, lorsque les hommes montaient à bord, le spectacle qu'ils avaient devant leurs yeux était plus horrible qu'ils auraient pu l’imaginer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e0932948-8060-4ba3-ae26-4313c12fce88",
                        "source_entry_id": "abf65735-7fb7-3466-a5df-247a506d0d6c",
                        "source_sense_description": "that saves lives",
                        "target_lang_word": "sauveteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sauveteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e4e1efeb-025f-3f8c-9fa7-dbdc11abe41b",
                                        "entry_id": "f8ff2ffb-440b-3486-b2a8-bd0cd6251758",
                                        "glosses": [
                                            "Celui qui prend part à un sauvetage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f89e4fc-a868-4d31-8ba5-672d6239d39c",
                                                "sense_id": "e4e1efeb-025f-3f8c-9fa7-dbdc11abe41b",
                                                "text": "Il eut une médaille comme sauveteur."
                                            },
                                            {
                                                "example_id": "14c3948c-f86f-4731-8ca9-5a156d2de9a1",
                                                "sense_id": "e4e1efeb-025f-3f8c-9fa7-dbdc11abe41b",
                                                "text": "Une brigade de sauvetage du comté de Los Angeles (L.A. County Beach Patrol) menée par le lieutenant Mitch Buchannon et composée d'une dizaine de sauveteurs doit faire face chaque jour aux dangers de la plage, tout en composant avec leur vie personnelle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e436159-74f6-3a5b-9871-53ba0b696ed4",
                                        "entry_id": "f8ff2ffb-440b-3486-b2a8-bd0cd6251758",
                                        "glosses": [
                                            "Un bateau sauveteur, Une embarcation employée au sauvetage."
                                        ],
                                        "tags": [
                                            "Par apposition"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89e1488a-c416-4ba9-abaf-710e13747227",
                                                "sense_id": "4e436159-74f6-3a5b-9871-53ba0b696ed4",
                                                "text": "Comme chaque année en début de saison estivale, de nombreux effectifs, de gendarmerie, maîtres-nageurs sauveteurs, sapeurs-pompiers, agents techniques et contractuels, viennent renforcer les services de la mairie michelaise."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
