            "senses": [
                {
                    "sense_id": "795d1cb7-49c6-35ba-bf76-63adb9dc1082",
                    "sense_definition": "In a shy, modest, or flirtatious manner, often intended to be alluring.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She smiled <w>coyly</w> at him from across the crowded room.",
                            "target_lang_translations": {
                                "fr": "Elle lui a souri <w>d'un air mutin</w> depuis l'autre bout de la pièce bondée.",
                                "ru": "Она <w>кокетливо</w> улыбнулась ему через переполненную комнату."
                            }
                        },
                        {
                            "text": "The actress <w>coyly</w> avoided answering questions about her private life.",
                            "target_lang_translations": {
                                "fr": "L'actrice a évité <w>avec réserve</w> de répondre aux questions sur sa vie privée.",
                                "ru": "Актриса <w>уклончиво</w> уходила от ответов на вопросы о своей личной жизни."
                            }
                        }
                    ],
                    "synonyms": [
                        "shyly",
                        "demurely",
                        "flirtatiously"
                    ],
                    "antonyms": [
                        "boldly",
                        "brazenly"
                    ],
                    "target_lang_definitions": {
                        "fr": "D'une manière timide, modeste ou séductrice, souvent dans le but d'attirer l'attention.",
                        "ru": "Застенчиво, скромно или кокетливо, часто с целью привлечь внимание или показаться привлекательным."
                    },
                    "translations": {
