                "senses": [
                    {
                        "sense_id": "7dc9eab1-c61f-3527-8462-672372d2582d",
                        "entry_id": "7b397c28-17d3-3558-90db-a3212419278b",
                        "glosses": [
                            "Celui qui cultive les fleurs à titre professionnel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5e8b029-fd09-4450-8858-86bffde1fa11",
                                "sense_id": "7dc9eab1-c61f-3527-8462-672372d2582d",
                                "text": "Les narcisses étaient ses fleurs préférées, elle en faisait souvent venir de chez un floriculteur."
                            },
                            {
                                "example_id": "c20a0f1d-6bfa-483a-ad5e-3a93f11e6987",
                                "sense_id": "7dc9eab1-c61f-3527-8462-672372d2582d",
                                "text": "Cet endroit ne ressemblait à aucun autre. On aurait dit une œuvre créée par un horticulteur floriculteur tant il était agréable de s'y promener et de s’y laisser emporter."
                            },
                            {
                                "example_id": "03bd6362-992f-447f-870d-7755bbfde2df",
                                "sense_id": "7dc9eab1-c61f-3527-8462-672372d2582d",
                                "text": "Comparé aux métiers de la mécanique, le floriculteur est l’horloger, le mécanicien de précision de l’horticulture."
                            }
                        ]
                    }
                ],
