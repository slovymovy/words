                                        ]
                                    },
                                    {
                                        "sense_id": "21fdbb8b-ec89-35fd-8f2c-c91d8a463205",
                                        "entry_id": "d65f7756-f7d9-3876-afb5-396d03143811",
                                        "glosses": [
                                            "On time; punctual."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2d27ef3-8494-4cbf-ba48-0684975fbf54",
                                                "sense_id": "21fdbb8b-ec89-35fd-8f2c-c91d8a463205",
                                                "text": "Be prompt for your appointment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb62dabe-4268-3f38-ab96-3cd21214a373",
                                        "entry_id": "d65f7756-f7d9-3876-afb5-396d03143811",
                                        "glosses": [
                                            "Ready; willing to act."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f41b06b-c1f6-4a84-828c-26bcea7a55d3",
                                                "sense_id": "cb62dabe-4268-3f38-ab96-3cd21214a373",
                                                "text": "Tell him, I am prompt / To lay my Crowne at's feete, and there to kneele."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8cb1c244-2010-3ce6-bb13-84e52bbbd301",
                                        "entry_id": "d65f7756-f7d9-3876-afb5-396d03143811",
                                        "glosses": [
                                            "Front: closest or nearest, in futures trading."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0239b9a-ed30-4bc3-8429-329ee57778c5",
                                                "sense_id": "8cb1c244-2010-3ce6-bb13-84e52bbbd301",
                                                "text": "When physical crude oil transactions are priced, they are usually marked to the prompt month futures contract. The prompt month futures contract is the next futures contract to settle."
                                            },
                                            {
                                                "example_id": "beb8f38a-74ab-4889-bd93-30cb37bd7479",
                                                "sense_id": "8cb1c244-2010-3ce6-bb13-84e52bbbd301",
                                                "text": "The settlement ratio is determined as follows: i) If the prompt futures price of coal at maturity is less than or equal to the floor price, the ratio will be one."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "prompt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "961d369a-ce98-309e-83a1-8a6fb245f963",
