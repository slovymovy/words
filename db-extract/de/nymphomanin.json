                                "text": "Ich habe eine Nymphomanin in Behandlung."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0cf28f7e-e8cd-3e4d-a654-6802394cbac8",
                        "entry_id": "c69d51fb-5e4b-3792-a655-73ee53aecbf2",
                        "glosses": [
                            "eine liebestolle und sexuell unersättliche Frau"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "087996b2-8b15-4d4b-af31-f8755d07ebde",
                                "sense_id": "0cf28f7e-e8cd-3e4d-a654-6802394cbac8",
                                "text": "Die Helga ist so'ne richtige Nymphomanin."
                            },
                            {
                                "example_id": "d55c8544-4a5a-422e-a899-026fbc7fd5ba",
                                "sense_id": "0cf28f7e-e8cd-3e4d-a654-6802394cbac8",
                                "text": "„Sie war eine Nymphomanin, lebenslustig und sehr bescheiden in ihren Ansprüchen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
