                "senses": [
                    {
                        "sense_id": "17da7212-147e-3288-9e64-47a7ac2c28d8",
                        "entry_id": "a35c2f82-34ba-3258-a9e5-493f9f68f11d",
                        "glosses": [
                            "Faire perdre son blason (ou ses blasons) à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41dc72ad-09a2-4300-a56b-1c1fbdd5a043",
                                "sense_id": "17da7212-147e-3288-9e64-47a7ac2c28d8",
                                "text": "Vrain-Lucas ne fut que légèrement condamné et on étouffa l’affaire. Si on était allé plus loin, il eût fallu vérifier et parfois déblasonner une grande partie de la salle des Croisades."
                            },
                            {
                                "example_id": "206907a4-dcc2-469b-a281-c4cbd1995f2b",
                                "sense_id": "17da7212-147e-3288-9e64-47a7ac2c28d8",
                                "text": "Vois-tu, mon cher confident… pour nous autres pauvres gentilshommes qui ne voulons pas émigrer, on vit trop mal chez l’étranger… nous n’avons qu’un parti à prendre, c’est de nous déblasonner et de donner des gages à la Révolution…"
                            }
                        ]
                    }
                ],
