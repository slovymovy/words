                                        "sense_id": "cfadf8f4-fe9f-349d-b7ae-52ed81a9cb8e",
                                        "entry_id": "bd09d959-d51e-36ea-9029-1400751294a9",
                                        "glosses": [
                                            "Ballsport zwischen zwei Mannschaften, bei dem ein Spieler versucht, mit einem Ball gegnerische Tore umzuwerfen, und ein Spieler der gegnerischen Mannschaft versucht diesen Ball mit einem Schlagholz möglichst weit ins Feld zu schlagen, um Punkte zu erzielen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb0701d4-0620-4491-820d-47d9eb6bd86d",
                                                "sense_id": "cfadf8f4-fe9f-349d-b7ae-52ed81a9cb8e",
                                                "text": "Beim Cricket besteht eine Mannschaft aus 11 Spielern."
                                            },
                                            {
                                                "example_id": "3d4fcd28-7c02-49a4-9ed9-d5e622c23c1d",
                                                "sense_id": "cfadf8f4-fe9f-349d-b7ae-52ed81a9cb8e",
                                                "text": "„Auf Langeoog beginnt das Schlagballturnier, ein Sport, der für mich ebenso rätselhaft ist wie Cricket.“"
                                            },
                                            {
                                                "example_id": "961e9dbc-fd15-4cd2-94e5-4bc56473877b",
                                                "sense_id": "cfadf8f4-fe9f-349d-b7ae-52ed81a9cb8e",
                                                "text": "„Ich erinnere mich, wie ich als Teenager in der High School einmal Cricket gespielt habe.“"
                                            },
                                            {
                                                "example_id": "7597e16c-d440-4b32-924a-5c51b7613069",
                                                "sense_id": "cfadf8f4-fe9f-349d-b7ae-52ed81a9cb8e",
                                                "text": "„Inzwischen ist sie erwachsen genug, um zu wissen, dass das Zerstückeln von Frauen ein älterer Sport ist als Cricket, aber nicht minder beliebt und ebenso vielen dunklen Ritualen und verworrenen Regeln unterworfen, die alle zu kennen scheinen, nur sie nicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
