    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "bbf4b940-e544-332c-97fe-1db51698a394",
                    "sense_definition": "strijdbaar, fel en onbuigzaam in een conflict of discussie",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "figuurlijk_strijdbaar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De minister reageerde met een <w>geharnaste</w> verklaring op de felle kritiek van de oppositie.",
                            "target_lang_translations": {
                                "en": "The minister responded with a <w>fierce</w> statement to the sharp criticism from the opposition."
                            }
                        },
                        {
                            "text": "Na de felle discussie nam de vakbond een <w>geharnast</w> standpunt in.",
                            "target_lang_translations": {
                                "en": "After the heated discussion, the union took an <w>uncompromising</w> stance."
                            }
                        }
                    ],
                    "synonyms": [
                        "strijdbaar",
                        "fel",
                        "onbuigzaam",
                        "militant"
                    ],
                    "antonyms": [
                        "gematigd",
                        "meegaand"
                    ],
                    "common_phrases": [
                        "geharnast standpunt",
                        "geharnaste verklaring"
                    ],
                    "target_lang_definitions": {
                        "en": "combative, fierce, and unyielding in a conflict or discussion"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fierce",
                                "target_lang_sense_clarification": "intense and aggressive in tone"
                            },
                            {
                                "target_lang_word": "uncompromising",
                                "target_lang_sense_clarification": "unwilling to make concessions"
                            },
                            {
                                "target_lang_word": "militant",
                                "target_lang_sense_clarification": "combative and aggressive in support of a cause"
                            },
                            {
                                "target_lang_word": "vehement",
                                "target_lang_sense_clarification": "showing strong and forceful feeling"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5ec2221a-cd6e-31d6-ad95-1211b9c628d1",
                    "sense_definition": "voorzien van of gekleed in een metalen harnas",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "letterlijk_harnas",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>geharnaste</w> ridders draafden in volle vaart op elkaar af tijdens het toernooi.",
                            "target_lang_translations": {
                                "en": "The <w>armored</w> knights galloped towards each other at full speed during the tournament."
                            }
                        },
                        {
                            "text": "In de kasteelzaal stond een <w>geharnaste</w> figuur die de bezoekers schrik aanjoeg.",
                            "target_lang_translations": {
                                "en": "In the castle hall stood an <w>armored</w> figure that frightened the visitors."
                            }
                        }
                    ],
                    "synonyms": [
                        "gepantserd"
                    ],
                    "common_phrases": [
                        "geharnaste ridder"
                    ],
                    "target_lang_definitions": {
                        "en": "equipped with or wearing metal armor"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "armored",
                                "target_lang_sense_clarification": "wearing or covered with protective armor"
                            },
                            {
                                "target_lang_word": "clad in armor",
                                "target_lang_sense_clarification": "wearing a suit of armor"
                            }
                        ]
                    }
                }
            ]
        },
        {
