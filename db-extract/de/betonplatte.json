                ],
                "senses": [
                    {
                        "sense_id": "4e171e87-7af6-3bbf-a7d9-ad419f46d9c0",
                        "entry_id": "52263c0f-b32c-3163-b1c9-48b531d5c9de",
                        "glosses": [
                            "Platte, hergestellt aus Beton"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "230aebde-3c6a-44d6-b4a0-42bf92b339de",
                                "sense_id": "4e171e87-7af6-3bbf-a7d9-ad419f46d9c0",
                                "text": "„Bislang unbekannte Täter haben eine rund 13 000 Kilogramm schwere Betonplatte angehoben und sich so Zugang zu dem unterirdischen Stollensystem verschafft.“"
                            },
                            {
                                "example_id": "00b97820-7ad4-4a43-83c8-88121a8102d0",
                                "sense_id": "4e171e87-7af6-3bbf-a7d9-ad419f46d9c0",
                                "text": "„Sam liegt auf dem schmalen Weg aus Betonplatten, der den Gemüsegarten in zwei Hälften teilt.“"
                            },
                            {
                                "example_id": "5520fd70-6b90-45cb-83ba-d20ad81bccf6",
                                "sense_id": "4e171e87-7af6-3bbf-a7d9-ad419f46d9c0",
                                "text": "„Auf dem Nachhauseweg, den Blick auf meine Füße gerichtet, während unter meinen Schuhen Kies, Kopfsteinpflaster und Betonplatten abwechselten, ging mir die Sache mit den beiden wieder und wieder durch den Kopf.“"
                            },
                            {
                                "example_id": "7399b084-08a5-4d04-9561-598f4f812571",
                                "sense_id": "4e171e87-7af6-3bbf-a7d9-ad419f46d9c0",
                                "text": "„Wir gingen weiter durch die Fußgängerzone, wo die Betonplatten die Regentropfen aufsaugten, kaum dass sie gelandet waren, weiter zum Rathaus und in den Trachtenladen, wo eine Frau vor einer Wand aus Wollknäueln saß.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
