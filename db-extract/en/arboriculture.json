                "senses": [
                    {
                        "sense_id": "6919d930-f4ef-36f1-a63b-44071ea997d6",
                        "entry_id": "677f8942-c3c2-367f-b477-817310445e92",
                        "glosses": [
                            "The branch of horticulture concerned with the planting, growth, and maintenance of trees."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "2428b095-83fc-4e50-8ab5-596fe64544e8",
                                "sense_id": "6919d930-f4ef-36f1-a63b-44071ea997d6",
                                "text": "Merely external emancipation has made of the modern woman an artificial being, who reminds one of the products of French arboriculture with its arabesque trees and shrubs, pyramids, wheels and wreaths; anything, except the forms which would be reached by the expression of her own inner qualities."
                            },
                            {
                                "example_id": "d2be3c51-74bf-4363-b879-760b3f41687e",
                                "sense_id": "6919d930-f4ef-36f1-a63b-44071ea997d6",
                                "text": "The small cat of the youngest Bull granddaughter scrambled up a tree, and was too scared to come down. […] The children danced and clapped their hands as the box was raised to the kitten, who sniffed at it, scowled, and turned her head to the study of arboriculture."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f2efdba3-611a-4ed1-aa65-fd887a60d342",
                        "source_entry_id": "677f8942-c3c2-367f-b477-817310445e92",
                        "source_sense_id": "6919d930-f4ef-36f1-a63b-44071ea997d6",
                        "source_sense_description": "branch of horticulture concerned with the planting and growth of trees",
