                                        "glosses": [
                                            "immer während, oder mindestens über einen langen Zeitraum hinweg"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4862e6e1-e10d-47fc-84f8-2f37285d1f95",
                                                "sense_id": "4a897449-1a15-32fd-855a-55c8b9ba168b",
                                                "text": "„Das Beherrschen des Kletterns und des Fliegens, die Kontrolle über die Wand oder das Fluggerät, die Souveränität auch bei unvorhersehbaren Überraschungen, wird ständig messbar und erlebbar.“"
                                            },
                                            {
                                                "example_id": "14b085b2-05c2-4dc3-be4f-8aee84e6e8d8",
                                                "sense_id": "4a897449-1a15-32fd-855a-55c8b9ba168b",
                                                "text": "Das ist mein ständiger Wohnsitz."
                                            },
                                            {
                                                "example_id": "b2d9f5da-2bc4-4de8-b629-659cf1eca3ac",
                                                "sense_id": "4a897449-1a15-32fd-855a-55c8b9ba168b",
                                                "text": "Im Flughafenbistro ist ständig Betrieb."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "60ef12e6-f6b9-3693-a7fa-81d9d78bc1f6",
                                        "entry_id": "fb73d218-a306-3b1d-bd06-30e6d5623c4d",
                                        "glosses": [
                                            "sich immer wiederholend, ununterbrochen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07169d2e-7af7-4d92-b8d7-ad5cc0ee198b",
                                                "sense_id": "60ef12e6-f6b9-3693-a7fa-81d9d78bc1f6",
                                                "text": "Wieso rufst du mich ständig an?"
                                            },
                                            {
                                                "example_id": "7f7e2640-e001-4263-85d7-22751821474c",
                                                "sense_id": "60ef12e6-f6b9-3693-a7fa-81d9d78bc1f6",
                                                "text": "Deine ständigen Klagen und Vorwürfe kann ich nicht mehr hören."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
