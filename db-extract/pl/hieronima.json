                                "target_senses": [
                                    {
                                        "sense_id": "a89947c6-46b2-30fb-9bc8-02e96f860d57",
                                        "entry_id": "3db8c33a-39cd-396f-a1fc-65262ed550e1",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b30f417-db55-444d-ad1a-7d252935a1db",
                                                "sense_id": "a89947c6-46b2-30fb-9bc8-02e96f860d57",
                                                "text": "Il faut dire que j’ai un prénom peu commun auquel je tiens. « Jéromine, Jéromine... » Je le répète dans ma tête."
                                            },
                                            {
                                                "example_id": "b430f18f-e4ea-4cd6-8ae8-6aa61368d4a8",
                                                "sense_id": "a89947c6-46b2-30fb-9bc8-02e96f860d57",
                                                "text": "Le journaliste Jean Mariole, amoureux de la jouvencelle, et désireux de plaire au père, entreprend de ramener Jéromine à son mari."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
