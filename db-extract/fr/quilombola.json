                        "glosses": [
                            "Membre d’un quilombo, descendant des marrons ayant quittés les plantations au Brésil."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8aee123f-ab31-4209-824b-48d4fb67f3e7",
                                "sense_id": "c1bd3da7-286f-3c71-8619-137a8df209e2",
                                "text": "Aujourd’hui, les quilombolas luttent pour la reconnaissance de leurs droits inscrits dans la constitution de 1988."
                            },
                            {
                                "example_id": "28c9e532-e252-418b-9cdf-77a48b0a1919",
                                "sense_id": "c1bd3da7-286f-3c71-8619-137a8df209e2",
                                "text": "Le plus célèbre quilombola du passé fut Zumbi dos Palmares, icône de la résistance anti-esclavagiste et anti-colonialiste afro-brésilienne."
                            }
                        ]
                    }
