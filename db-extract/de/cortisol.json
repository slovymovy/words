                ],
                "senses": [
                    {
                        "sense_id": "b93bbbe5-10ae-33ca-9862-6d7e22c1c605",
                        "entry_id": "3ba7e8b5-681f-333d-8a8d-aa66431ecdb2",
                        "glosses": [
                            "in der Nebennierenrinde produziertes und Entzündungen hemmendes Hormon, das für viele Stoffwechselvorgänge zuständig ist und unter anderem den Blutzuckerspiegel durch Bereitstellung von Glukose erhöht, um in Stresssituationen Energie zur Verfügung zu stellen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9143d9cb-d9da-4202-8795-7059c0de8afe",
                                "sense_id": "b93bbbe5-10ae-33ca-9862-6d7e22c1c605",
                                "text": "„In lebensgefährlichen Situationen wird der Körper mit Stresshormonen wie Cortisol und Adrenalin überschwemmt.“"
                            },
                            {
                                "example_id": "ee860daa-2d07-4cc1-a51c-ddc91f1874f4",
                                "sense_id": "b93bbbe5-10ae-33ca-9862-6d7e22c1c605",
                                "text": "„Normalerweise schützt die Plazenta den Fötus vor dem Stresshormon Cortisol.“"
                            },
                            {
                                "example_id": "64ebadad-df4e-44bf-bc02-1c517999f2ec",
                                "sense_id": "b93bbbe5-10ae-33ca-9862-6d7e22c1c605",
                                "text": "„Cortisol verhindert die Reparatur der Telomere: Stress macht alt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ac481e7a-7992-42cf-9070-2927e8af3347",
