{
    "word_family": [
        "cap"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5d807a07-a03c-374c-bbd5-0bd03d193da8",
                    "sense_definition": "The amount of a substance that fits inside a cap.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Add a <w>capful</w> of detergent to the washing machine before starting the cycle.",
                            "target_lang_translations": {
                                "cs": "Před spuštěním cyklu přidejte do pračky <w>uzávěr</w> pracího prostředku."
                            }
                        },
                        {
                            "text": "She poured a <w>capful</w> of medicine into the small plastic cup.",
                            "target_lang_translations": {
                                "cs": "Nalila <w>víčko</w> léku do malého plastového kelímku."
                            }
                        }
                    ],
                    "common_phrases": [
                        "a capful of"
                    ],
                    "target_lang_definitions": {
                        "cs": "Množství látky, které se vejde do uzávěru (např. lahve)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "uzávěr",
                                "target_lang_sense_clarification": "množství odpovídající objemu uzávěru"
                            },
                            {
                                "target_lang_word": "víčko",
                                "target_lang_sense_clarification": "množství odpovídající objemu víčka"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e74fa51-43d7-30e1-b609-cf7935ab075b",
                    "sense_definition": "A small or light puff of wind.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "weather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sails hung limp because there was not even a <w>capful</w> of wind to move the boat.",
                            "target_lang_translations": {
                                "cs": "Plachty bezvládně visely, protože nefoukal ani <w>závan</w> větru, který by pohnul lodí."
                            }
                        },
                        {
                            "text": "We waited for hours, but only a <w>capful</w> of wind stirred the trees.",
                            "target_lang_translations": {
                                "cs": "Čekali jsme hodiny, ale stromy rozhýbal jen slabý <w>závan</w> větru."
                            }
                        }
                    ],
                    "synonyms": [
                        "breeze",
                        "gust"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This usage is largely literary or archaic."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Slabý závan nebo poryv větru."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "závan",
                                "target_lang_sense_clarification": "velmi slabý pohyb vzduchu"
                            },
                            {
                                "target_lang_word": "poryv",
                                "target_lang_sense_clarification": "krátké zesílení větru"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}