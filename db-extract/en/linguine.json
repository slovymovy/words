                ],
                "senses": [
                    {
                        "sense_id": "5aa8370a-a9a7-30b8-b884-30c01cce7d22",
                        "entry_id": "0c7c2b4c-fcb3-33b0-9699-d878c851c296",
                        "glosses": [
                            "Ribbons of pasta, cut from a sheet, not as wide as tagliatelle."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2be0af9f-5025-4a15-8a64-fe1b8467a186",
                        "source_entry_id": "0c7c2b4c-fcb3-33b0-9699-d878c851c296",
                        "source_sense_id": "5aa8370a-a9a7-30b8-b884-30c01cce7d22",
                        "source_sense_description": "ribbons of pasta narrower than tagliatelle",
                        "target_lang_word": "linguine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "linguine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4fc1cc42-5a02-3089-900a-eef0a7923166",
                                        "entry_id": "305824c4-683a-3c49-a84a-0b9f40f9c32f",
                                        "glosses": [
                                            "Pâte alimentaire longue italienne originaire de la Ligurie, proche du spaghetti mais de forme aplatie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2753a2f5-340d-414f-8d5b-3ff10d501410",
                                                "sense_id": "4fc1cc42-5a02-3089-900a-eef0a7923166",
                                                "text": "Ce soir-là, figuraient au menu le jarret d’agneau au thym et agrumes, le filet mignon et poêlée de foie gras, le pavé de mahi-mahi grillé et tombée portugaise, la linguine aux pleurotes et huile de truffes et le tartare de bœuf italien."
                                            },
                                            {
                                                "example_id": "3f64fbbe-8e35-4e3c-a8d8-aa7863613b7f",
                                                "sense_id": "4fc1cc42-5a02-3089-900a-eef0a7923166",
                                                "text": "La première forme d'agrégat ressemble, à l’échelle du millionième du millimètre, à un spaghetti tandis que la deuxième est longue et aplatie, rappelant la forme d’une pâte plus large comme la linguine."
                                            },
                                            {
                                                "example_id": "e6608740-fcf0-4287-8738-4bc2bc0f29af",
                                                "sense_id": "4fc1cc42-5a02-3089-900a-eef0a7923166",
                                                "text": "Elle aura opté pour quelque-chose de simple, mais bon. Des linguines. Des linguines fraîches à la sauce tomate et au basilic."
                                            },
                                            {
                                                "example_id": "e771606d-bb43-4588-8cb7-210b22c7f3d8",
                                                "sense_id": "4fc1cc42-5a02-3089-900a-eef0a7923166",
                                                "text": "Tu imagines ? Des linguine “ ail et piment ” avec un bon bourgogne ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
