                        "glosses": [
                            "Juif originaire essentiellement du Nord et de l’Est de l’Europe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4aafcf26-aceb-4099-90fe-cf06de104ef5",
                                "sense_id": "4f060825-fa8f-326b-9850-1d5efdcf74ee",
                                "text": "Il tente d'expliquer que les Juifs d’Europe de l’Est, les Ashkénazes, ne descendent pas des Hébreux mais des Khazars, peuple caucasien converti au judaïsme au huitième siècle. … En remettant en question l’ascendance juive des Ashkénazes, Koestler suscita une violente polémique."
                            }
                        ]
                    }
