                        "cross_references": [
                            {
                                "target_word": "карча",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "fba49b7c-0b22-35dd-8885-1b3761421c07",
                                        "entry_id": "91deea39-ff59-32d0-b831-be351b20f587",
                                        "glosses": [
                                            "диал. затонувшее дерево, бревно или пень с корнем"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "108a4af3-597e-4cc2-9dfd-736315aae9b6",
                                                "sense_id": "fba49b7c-0b22-35dd-8885-1b3761421c07",
                                                "text": "Вода сбыла, — там, гляди, мель, там карча, там камень; всё это надо усчитать и вовремя обойти, чтобы к пристани доплыть целому…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43c938fa-7ac1-3425-a23c-0e63f0e34581",
                                        "entry_id": "91deea39-ff59-32d0-b831-be351b20f587",
                                        "glosses": [
                                            "диал. вывернутый из земли корень"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d177f43e-09f9-48aa-83d6-a6f821444ad2",
                                                "sense_id": "43c938fa-7ac1-3425-a23c-0e63f0e34581",
                                                "text": "Голова у меня ходила вокруг, я боялся, как бы не слететь с карчи, и удерживал коня, который хотел выпрыгнуть на ту же карчу."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
