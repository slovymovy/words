{
    "word_family": [
        "ah",
        "aah"
    ],
    "entries": [
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "8f54f000-02c5-33cb-832c-6022eaf5809f",
                    "sense_definition": "Used to express emotions such as realization, relief, surprise, or pleasure.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sound_expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Ahh</w>, now I understand what you mean.",
                            "target_lang_translations": {
                                "ru": "<w>А</w>, теперь я понимаю, что ты имеешь в виду.",
                                "zh": "<w>啊</w>，我现在明白你的意思了。"
                            }
                        },
                        {
                            "text": "<w>Ahh</w>, that warm tea feels good on my throat.",
                            "target_lang_translations": {
                                "ru": "<w>Ах</w>, этот теплый чай так приятен горлу.",
                                "zh": "<w>啊</w>，这杯热茶喝下去嗓子真舒服。"
                            }
                        }
                    ],
                    "synonyms": [
                        "oh",
                        "wow",
                        "ah"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для выражения эмоций, таких как осознание, облегчение, удивление или удовольствие.",
                        "zh": "用于表达领悟、宽慰、惊讶或愉悦等情感的感叹词。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "а",
                                "target_lang_sense_clarification": "выражение осознания или понимания"
                            },
                            {
                                "target_lang_word": "ах",
                                "target_lang_sense_clarification": "выражение удовольствия или удивления"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "啊",
                                "target_lang_sense_clarification": "表示领悟或理解"
                            },
                            {
                                "target_lang_word": "啊哈",
                                "target_lang_sense_clarification": "表示突然的发现或领悟"
                            },
                            {
                                "target_lang_word": "啊",
                                "target_lang_sense_clarification": "表示宽慰或愉悦"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2732662f-2604-37f1-bf66-87190bcd636e",
                    "sense_definition": "An utterance of the sound \"ahh\", usually expressing amazement, delight, or wonder.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sound_expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The spectacular fireworks display drew loud <w>ahhs</w> from the crowd.",
                            "target_lang_translations": {
                                "ru": "Зрелищный фейерверк вызвал громкие <w>ахи</w> у толпы.",
                                "zh": "壮观的烟花表演引得人群发出阵阵<w>惊叹</w>。"
                            }
                        },
                        {
                            "text": "There were many oohs and <w>ahhs</w> as the magician performed his tricks.",
                            "target_lang_translations": {
                                "ru": "Было много охов и <w>ахов</w>, пока фокусник показывал свои трюки.",
                                "zh": "魔术师表演魔术时，台下充满了<w>惊叹</w>声。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "oohs and ahhs"
                    ],
                    "target_lang_definitions": {
                        "ru": "Звук или возглас \"ах\", обычно выражающий изумление, восторг или чудо.",
                        "zh": "指发出“啊”的声音，通常用来表达惊叹、喜悦或赞美。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ах",
                                "target_lang_sense_clarification": "существительное, обозначающее звук"
                            },
                            {
                                "target_lang_word": "возглас восхищения",
                                "target_lang_sense_clarification": "описание звука"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "惊叹声",
                                "target_lang_sense_clarification": "指人群发出的赞叹声"
                            },
                            {
                                "target_lang_word": "赞叹",
                                "target_lang_sense_clarification": "指表达惊奇或喜悦的呼声"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "acc75197-2c51-3dab-bd66-7a0757b9519a",
                    "sense_definition": "A pronunciation spelling of <w>ass</w>, often used in slang to refer to a person or oneself.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to get your <w>ahh</w> to work on time.",
                            "target_lang_translations": {
                                "ru": "Тебе нужно притащить свою <w>задницу</w> на работу вовремя.",
                                "zh": "你得准时把你的<w>屁股</w>挪到工作岗位上去。"
                            }
                        },
                        {
                            "text": "I laughed my <w>ahh</w> off when I saw that video.",
                            "target_lang_translations": {
                                "ru": "Я смеялся до упаду, чуть <w>задницу</w> не надорвал, когда увидел это видео.",
                                "zh": "看到那个视频时，我笑得<w>屁股</w>都要掉下来了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "internet slang or AAVE"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фонетическое написание слова \"ass\" (задница), часто используемое в сленге для обозначения человека или самого себя.",
                        "zh": "“ass”的俚语拼写，常用于指代某人或自己，带有粗俗色彩。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "задница",
                                "target_lang_sense_clarification": "сленг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "屁股",
                                "target_lang_sense_clarification": "俚语，指代身体部位或人"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f8b6e89f-3e33-3bf5-828c-14197878c21b",
                    "sense_definition": "To make an exclamation of \"ahh\", typically to express pleasure or amazement.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sound_expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The audience oohed and <w>ahhed</w> at the beautiful light show.",
                            "target_lang_translations": {
                                "ru": "Зрители охали и <w>ахали</w>, глядя на красивое световое шоу.",
                                "zh": "观众们对着美丽的灯光秀不停地<w>惊叹</w>。"
                            }
                        },
                        {
                            "text": "He <w>ahhed</w> in relief after taking off his tight shoes.",
                            "target_lang_translations": {
                                "ru": "Он <w>ахнул</w> от облегчения, сняв тесные туфли.",
                                "zh": "脱掉紧绷的鞋子后，他如释重负地<w>感叹</w>了一声。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "ooh and ahh"
                    ],
                    "target_lang_definitions": {
                        "ru": "Издавать возглас \"ах\", обычно для выражения удовольствия или изумления.",
                        "zh": "发出“啊”的感叹声，通常用于表达愉悦或惊叹。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ахать",
                                "target_lang_sense_clarification": "издавать звуки удивления или удовольствия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "惊叹",
                                "target_lang_sense_clarification": "发出赞叹的声音"
                            },
                            {
                                "target_lang_word": "感叹",
                                "target_lang_sense_clarification": "发出表示宽慰或愉悦的声音"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}