                                "target_senses": [
                                    {
                                        "sense_id": "02bf511c-b5e3-3f8b-a8f1-21d169865f1c",
                                        "entry_id": "c55c614f-5d65-33ea-997a-6e2b64b66b87",
                                        "glosses": [
                                            "das Geschlecht der Karolinger oder deren Kultur betreffend"
                                        ],
                                        "tags": [
                                            "Geschichte / Kunst- und Kulturgeschichte"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4dfafef3-b941-4a1d-9ba5-b15335c4c112",
                                                "sense_id": "02bf511c-b5e3-3f8b-a8f1-21d169865f1c",
                                                "text": "„Die Architektur der karolingischen Kaiserpfalz in Ingelheim ist durch antike Vorbilder geprägt, was sich an der Form einiger Hauptgebäude wie Aula regia, Exedra oder Trikonchos ablesen lässt.“"
                                            },
                                            {
                                                "example_id": "1cca8e99-9e52-4722-825a-e1c6cd0d2a65",
                                                "sense_id": "02bf511c-b5e3-3f8b-a8f1-21d169865f1c",
                                                "text": "„Ohne Zweifel lag der Hauptakzent der karolingischen Bildungsreform auf dem religiösen Sektor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
