                "senses": [
                    {
                        "sense_id": "2eae209d-831a-35be-8ede-cd559e126930",
                        "entry_id": "65edcb3b-5abe-3916-a278-7101b5cace96",
                        "glosses": [
                            "Geschoss, das von einem Mörser verschossen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf8ca366-f7f7-44c5-9e2b-d5dcc0166fe5",
                                "sense_id": "2eae209d-831a-35be-8ede-cd559e126930",
                                "text": "„Auf dem von Israel besetzten Teil des Golan sei zuvor eine mutmaßlich bei den innersyrischen Kämpfen im Grenzgebiet abgefeuerte Mörsergranate eingeschlagen, teilte die Armee am Freitag weiter mit.“"
                            },
                            {
                                "example_id": "608e6788-419e-4dce-a157-e6895d61c091",
                                "sense_id": "2eae209d-831a-35be-8ede-cd559e126930",
                                "text": "„Eine französische Mörsergranate aus dem Zweiten Weltkrieg hat am Montagnachmittag, Polizei und Feuerwehr in Atem gehalten.“"
                            },
                            {
                                "example_id": "d3bde3fc-7e32-4c88-bb0a-75ac4d23f17d",
                                "sense_id": "2eae209d-831a-35be-8ede-cd559e126930",
                                "text": "„Eine Mörsergranate war durch die Wand gekommen und hatte alles weggeblasen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
