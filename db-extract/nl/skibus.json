                        "examples": [
                            {
                                "example_id": "4cc1b1f1-e925-4ce2-a7ec-550f5e78289b",
                                "sense_id": "92c755e8-e8c8-3ee7-a7fa-c65777c6ec41",
                                "text": "Het onderzoek naar hoe het drama met de Belgische skibus is kunnen gebeuren, loopt nog. Maar op basis van de al gekende informatie maakte newsdirect.nma.com.tw deze computeranimatie."
                            },
                            {
                                "example_id": "93e930da-ff44-4f17-a549-2563312cb7c2",
                                "sense_id": "92c755e8-e8c8-3ee7-a7fa-c65777c6ec41",
                                "text": "Bij een ongeluk met een skibus in Centraal-Japan zijn zeker veertien mensen om het leven gekomen. De bus was op weg naar een skigebied toen hij vrijdag verongelukte op een weg bij de stad Karuizawa. De bus schoot de verkeerde weghelft op en sloeg over de kop de berm in."
                            },
                            {
                                "example_id": "7a6af923-783c-4a4a-8d5f-c6dd06fecbf2",
                                "sense_id": "92c755e8-e8c8-3ee7-a7fa-c65777c6ec41",
                                "text": "Vanuit de stad rijdt een gratis skibus naar alle negen aan- gesloten skigebieden. De Nordkette is ook met de Nordkettenbahn bereikbaar."
                            }
                        ]
