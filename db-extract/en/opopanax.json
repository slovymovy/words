                        "entry_id": "cc87f064-6996-304d-9f62-06dfab90b00d",
                        "glosses": [
                            "A gum resin obtained from the root of Opopanax chironium, formerly used in medicine."
                        ],
                        "tags": [
                            "countable",
                            "obsolete",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "ea8af7d9-d002-334d-a4e7-18c3d76266c6",
                        "entry_id": "cc87f064-6996-304d-9f62-06dfab90b00d",
                        "glosses": [
                            "A perfume made from the gum resin of various trees."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "3b5a8c0b-ea8a-4c9c-a125-4a7d48343f15",
                                "sense_id": "ea8af7d9-d002-334d-a4e7-18c3d76266c6",
                                "text": "they were hit by a strong polyaromatic gust [...] which included alcohol fumes, tobacco and hemp-smoke, a spectrum of inexpensive scent in which opopanax and vervain figured prominently"
                            }
                        ]
                    },
                    {
                        "sense_id": "9199553d-8c22-33aa-a339-b1e6e0fa903c",
