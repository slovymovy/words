            {
                "entry_id": "dad21b39-77b9-3493-bf1b-27c13f94641d",
                "word": "maquignon",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5387b62f-9a73-4ecb-9602-e2bac35ce4c2",
                        "entry_id": "dad21b39-77b9-3493-bf1b-27c13f94641d",
                        "tags": [
