                        "glosses": [
                            "Action de crocheter."
                        ],
                        "tags": [
                            "Serrurerie"
                        ],
                        "examples": [
                            {
                                "example_id": "0ffcba7c-5d9e-4d36-b2dc-823acc66b233",
                                "sense_id": "ef549a78-ada2-3f05-9a8d-8db0938e2423",
                                "text": "Le crochetage d’une serrure."
                            },
                            {
                                "example_id": "c2175a8b-6c5c-4b0e-81f0-306707ad0559",
                                "sense_id": "ef549a78-ada2-3f05-9a8d-8db0938e2423",
                                "text": "— Allons chercher les pinces.\nL’abîme est définitivement creusé comme avec une pioche de cimetière. Ce crochetage de serrures engage le Comité autant que la fusillade des généraux."
                            },
                            {
                                "example_id": "bc1f14af-9361-4b4b-bab0-d0f9b70315c3",
                                "sense_id": "ef549a78-ada2-3f05-9a8d-8db0938e2423",
                                "text": "Dans la seconde et demie suivant le crochetage de la serrure, la porte ne sera toujours pas ouverte."
                            }
                        ]
                    },
                    {
                        "sense_id": "021d6a4c-fd2f-339a-acba-5eca4f955eb0",
                        "entry_id": "8c61def6-79fb-311f-b114-5ebb03942420",
                        "glosses": [
                            "Opération exécuté par le métier rectiligne dans les usines de bonneterie."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
