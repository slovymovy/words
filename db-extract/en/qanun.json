                                            {
                                                "example_id": "220225d9-6709-429c-9828-851d61dbc0a8",
                                                "sense_id": "3888aebe-228f-330d-9f15-030294211721",
                                                "text": "Dünya'nın en büyük kanunu, nefsini müdafaa ve muhafaza etmek için karnını doyurmaktır."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "226c4cda-22ad-3ee4-9420-9f69cf185eef",
                                        "entry_id": "dd085cd0-aae0-30be-89dd-a40dfa814677",
                                        "glosses": [
                                            "Dikdörtgen şeklinde, bir köşesi kesik, yassı bir sandık üzerine gerilmiş tellerden oluşan, tırnak adı verilen çalgıçlarla çalınan ince saz çalgısı"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fbb5363-5d73-477b-b667-95b50eb4d18d",
                                                "sense_id": "226c4cda-22ad-3ee4-9420-9f69cf185eef",
                                                "text": "Kanunun ilk kez Fârâbî tarafından yapıldığı söylenir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62bfbdd1-53fe-3da7-8ebf-8742618c856d",
                                        "entry_id": "dd085cd0-aae0-30be-89dd-a40dfa814677",
                                        "glosses": [
                                            "Bilimde çok sayıda deney ve gözlemlerden sonra, aynı şartlarda aynı sonuçları verdiği kesin olarak belirlenen durum"
                                        ],
                                        "tags": [
                                            "tabii bilimler"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56b3fbe0-e9e4-44de-a03c-78b0e32e59fa",
                                                "sense_id": "62bfbdd1-53fe-3da7-8ebf-8742618c856d",
                                                "text": "Genel Rölativite Teorisi, Newton'un kütle çekim kanununun yerine yenisini getirmiştir."
                                            },
                                            {
                                                "example_id": "c372308f-65fd-467f-8992-10369c26728b",
                                                "sense_id": "62bfbdd1-53fe-3da7-8ebf-8742618c856d",
                                                "text": "Tabiat kanunu öyle şiddetli bir zorlayıcıdır ki kanunlarının gereğine her şeyi uydurur, boyun eğdirir."
                                            }
                                        ]
