                ],
                "senses": [
                    {
                        "sense_id": "d8f71b7a-edf4-368a-a795-6c4f7274cded",
                        "entry_id": "a04fe27a-6bb7-3243-b09c-3ac9014c04c6",
                        "glosses": [
                            "Procéder à une cyberattaque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ec4aa92-b393-45e0-a8a4-e5d738a1de04",
                                "sense_id": "d8f71b7a-edf4-368a-a795-6c4f7274cded",
                                "text": "En effet, les hackers cyberattaquent les PME. Ces dernières sont, par exemple, victimes de racket, de vol de brevet."
                            },
                            {
                                "example_id": "985b00d4-9307-421a-9b6a-f7f55cb5aad1",
                                "sense_id": "d8f71b7a-edf4-368a-a795-6c4f7274cded",
                                "text": "Les hackers ont trouvé la faille pour cyberattaquer les chaînes hôtelières : ils passent par les bureaux de réception, les boutiques…"
                            },
                            {
                                "example_id": "21a60e91-02ea-4a78-9b18-af4b6218ba41",
                                "sense_id": "d8f71b7a-edf4-368a-a795-6c4f7274cded",
                                "text": "\"C'est très grave pour un entreprise qui se fait cyberattaquer ou cybermenacer\", a-t-il souligné."
                            }
                        ]
                    }
                ],
