    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ead92983-547c-3260-9d8d-0d0d6a140d78",
                    "sense_definition": "Perdre du poids, devenir plus mince.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "corps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis qu'il court tous les matins, il a beaucoup <w>maigri</w>.",
                            "target_lang_translations": {
                                "en": "Since he has been running every morning, he has <w>slimmed down</w> a lot.",
                                "ru": "С тех пор как он каждое утро бегает, он сильно <w>похудел</w>.",
                                "de": "Seit er jeden Morgen läuft, hat er viel <w>abgenommen</w>.",
                                "es": "Desde que corre todas las mañanas, ha <w>adelgazado</w> mucho.",
                                "zh": "自从他每天早上跑步以来，他<w>瘦</w>了很多。"
                            }
                        },
                        {
                            "text": "Tu <w>maigris</w> rapidement parce que tu ne manges plus assez le soir.",
                            "target_lang_translations": {
                                "en": "You're <w>slimming down</w> quickly because you no longer eat enough in the evening.",
                                "ru": "Ты быстро <w>худеешь</w>, потому что вечером ешь уже недостаточно.",
                                "de": "Du <w>nimmst</w> schnell <w>ab</w>, weil du abends nicht mehr genug isst.",
                                "es": "<w>Adelgazas</w> rápidamente porque ya no comes lo suficiente por la noche.",
                                "zh": "你<w>瘦</w>得很快，因为晚上已经吃得不够了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "mincir",
                        "s'amincir"
                    ],
                    "antonyms": [
                        "grossir"
                    ],
                    "common_phrases": [
                        "maigrir de plusieurs kilos"
                    ],
                    "target_lang_definitions": {
                        "en": "To lose weight and become thinner.",
                        "ru": "Терять вес, становиться стройнее.",
                        "de": "Körpergewicht verlieren und schlanker werden.",
                        "es": "Perder peso y hacerse más delgado.",
                        "zh": "减轻体重，变得更瘦。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lose weight",
                                "target_lang_sense_clarification": "become thinner"
                            },
                            {
                                "target_lang_word": "slim",
                                "target_lang_sense_clarification": "lose weight, by dieting"
                            },
                            {
                                "target_lang_word": "slim down",
                                "target_lang_sense_clarification": "informal, losing body weight"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "худеть",
                                "target_lang_sense_clarification": "терять вес на диете"
                            },
                            {
                                "target_lang_word": "похудеть",
                                "target_lang_sense_clarification": "стать стройнее, сбросить килограммы"
                            }
                        ],
