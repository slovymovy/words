                        "translation_id": "e9cda950-e23c-4de9-8f42-3305cee8597b",
                        "source_entry_id": "bdfc71b6-7db0-3539-a679-8f1f3ae647f3",
                        "source_sense_id": "8ef4e7b8-1fe6-33cf-88bc-5785459baaf7",
