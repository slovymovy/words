    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2a85fdfe-39c7-3a3d-b186-036309c94a22",
                    "sense_definition": "present participle and gerund of <w>quiet</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "action_of_silencing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mother was <w>quieting</w> her crying baby by singing a soft and gentle lullaby.",
                            "target_lang_translations": {
                                "ru": "Мать <w>успокаивала</w> своего плачущего ребенка, напевая тихую и нежную колыбельную."
                            }
                        },
                        {
                            "text": "He succeeded in <w>quieting</w> the crowd before starting his important announcement to the public.",
                            "target_lang_translations": {
                                "ru": "Ему удалось <w>утихомирить</w> толпу перед тем, как начать свое важное объявление для публики."
                            }
                        }
                    ],
                    "synonyms": [
                        "silencing",
                        "calming",
                        "soothing",
                        "hushing"
                    ],
                    "antonyms": [
                        "disturbing",
                        "agitating",
                        "rousing"
                    ],
                    "common_phrases": [
                        "quieting the crowd",
                        "quieting a baby",
                        "quieting one's mind"
                    ],
                    "target_lang_definitions": {
                        "ru": "причастие настоящего времени и герундий от глагола quiet (успокаивать, утихомиривать)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "успокаивающий",
                                "target_lang_sense_clarification": "делающий кого-то спокойным"
                            },
                            {
                                "target_lang_word": "утихомиривание",
                                "target_lang_sense_clarification": "процесс приведения в тишину или порядок"
                            },
                            {
                                "target_lang_word": "усмирение",
                                "target_lang_sense_clarification": "подавление шума или волнения"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3b2b04c4-7ddf-3b5c-86f4-623d5179c27e",
                    "sense_definition": "The act of making something quiet or peaceful",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "action_of_silencing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden <w>quieting</w> of the engine made the driver realize that something was wrong.",
                            "target_lang_translations": {
                                "ru": "Внезапное <w>затихание</w> двигателя заставило водителя понять, что что-то не так."
                            }
                        },
                        {
                            "text": "There was a gradual <w>quieting</w> of the storm as the winds began to die down.",
                            "target_lang_translations": {
                                "ru": "Наблюдалось постепенное <w>утихание</w> шторма, когда ветры начали стихать."
                            }
                        }
                    ],
                    "synonyms": [
                        "silencing",
                        "muffling"
                    ],
                    "antonyms": [
                        "amplification"
                    ],
                    "common_phrases": [
                        "gradual quieting",
                        "sudden quieting"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по приведению чего-либо в состояние тишины или покоя"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "затишье",
                                "target_lang_sense_clarification": "наступление тишины"
                            },
                            {
                                "target_lang_word": "утихание",
                                "target_lang_sense_clarification": "постепенное прекращение шума или бури"
                            },
                            {
                                "target_lang_word": "ослабление",
                                "target_lang_sense_clarification": "снижение интенсивности звука или действия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}
