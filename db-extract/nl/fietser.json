                "senses": [
                    {
                        "sense_id": "b6ef423a-5e3a-3c59-8467-2650d4d0ecbd",
                        "entry_id": "2c4c38e6-e4a7-3fd5-a539-c9e154b19eb4",
                        "glosses": [
                            "iemand die met een fiets rijdt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9eef9e5-8f41-4c2e-bd0b-24151d04d530",
                                "sense_id": "b6ef423a-5e3a-3c59-8467-2650d4d0ecbd",
                                "text": "Fietsers lopen groot gevaar als ze in de \"dode hoek\" van een vrachtwagen fietsen."
                            },
                            {
                                "example_id": "91aba35a-5a99-4199-b5fb-d38f79624ec8",
                                "sense_id": "b6ef423a-5e3a-3c59-8467-2650d4d0ecbd",
                                "text": "Dat moet veranderen, vindt minister Madlener van Infrastructuur, want elk jaar belanden veel mensen na een fietsongeluk op de spoedeisende hulp. Vorig jaar waren dat 74.300 fietsers, van wie 48.900 met ernstig letsel, blijkt uit nieuwe cijfers van VeiligheidNL. En de groep met ernstig letsel wordt steeds groter."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "14126864-3c34-48d1-83b1-8b442c31b0ae",
                        "source_entry_id": "2c4c38e6-e4a7-3fd5-a539-c9e154b19eb4",
                        "source_sense_id": "b6ef423a-5e3a-3c59-8467-2650d4d0ecbd",
                        "source_sense_description": "iemand die met een fiets rijdt",
                        "target_lang_word": "Radfahrer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Radfahrer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "24111d84-c186-3352-bcd7-04265d92b0f3",
                                        "entry_id": "d6f41d9c-105a-38f0-aab5-f324811f3f7b",
                                        "glosses": [
                                            "jemand, der mit dem Fahrrad fährt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "900d88f7-cdd1-4138-8020-160e051392c3",
                                                "sense_id": "24111d84-c186-3352-bcd7-04265d92b0f3",
                                                "text": "Auch als Radfahrer muss man auf den Verkehr achten."
                                            },
                                            {
                                                "example_id": "bf369897-2bd3-4515-a563-2338aeb83d01",
                                                "sense_id": "24111d84-c186-3352-bcd7-04265d92b0f3",
                                                "text": "„Die Bergwanderer in der Provence feuern jeden Radfahrer, der an ihnen vorbeikriecht, mit allez! allez! an.“"
                                            },
                                            {
                                                "example_id": "4c7293dc-70bc-417c-9ca3-8407b043b6d2",
                                                "sense_id": "24111d84-c186-3352-bcd7-04265d92b0f3",
                                                "text": "„Nachdenklich zieht er sein Portemonnaie hervor, nimmt zwei Zehnpfennigstücke heraus und zieht an einem grünen Automaten neben dem der Wahrsagerin eine Packung Pfefferminz.“"
                                            },
                                            {
                                                "example_id": "f07fc05e-2b3b-4afd-a163-dd60c89bb7ad",
                                                "sense_id": "24111d84-c186-3352-bcd7-04265d92b0f3",
                                                "text": "„Ein Radfahrer fiel ihm auf, der »energisch« an ihm vorbeifuhr.“"
                                            },
                                            {
                                                "example_id": "5180668d-db2a-4ba2-b6fb-3f9c4ca26845",
                                                "sense_id": "24111d84-c186-3352-bcd7-04265d92b0f3",
                                                "text": "„Vollends zum Problemkreisel wird der Stern aber erst durch einen Verkehrsteilnehmer, der sich – vielerorts und gerade in Bremen politisch angefeuert – zunehmend bemerkbar macht: den Radfahrer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4fad9b2d-3b3e-3851-9301-2987d19a1d0b",
                                        "entry_id": "d6f41d9c-105a-38f0-aab5-f324811f3f7b",
                                        "glosses": [
                                            "jemand, der nach oben buckelt und nach unten „tritt“, das heißt autoritär auftritt"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ba8f5120-2513-4f00-94fa-2dc3f0548ba9",
                        "source_entry_id": "2c4c38e6-e4a7-3fd5-a539-c9e154b19eb4",
                        "source_sense_id": "b6ef423a-5e3a-3c59-8467-2650d4d0ecbd",
                        "source_sense_description": "iemand die met een fiets rijdt",
                        "target_lang_word": "cyclist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cyclist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a77c9781-627f-3e08-ac92-01fef39824e8",
                                        "entry_id": "c7301625-fd05-33f0-9735-d0e2ecc79011",
                                        "glosses": [
                                            "A person who rides a cycle, especially a bicycle, or who habitually engages in cycling."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86b53b58-04a3-480f-a9f8-dea89db7059c",
                                                "sense_id": "a77c9781-627f-3e08-ac92-01fef39824e8",
                                                "text": "A solitary cyclist was coming towards us. His head was down and his shoulders rounded, as he put every ounce of energy that he possessed on to the pedals. He was flying like a racer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9a0e9d0-82a9-3827-9d42-2dee0701ff30",
                                        "entry_id": "c7301625-fd05-33f0-9735-d0e2ecc79011",
                                        "glosses": [
                                            "A motorcyclist."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8382e2db-c5f5-4929-9754-a8eb64110c1e",
                                                "sense_id": "e9a0e9d0-82a9-3827-9d42-2dee0701ff30",
                                                "text": "Most of the cyclists were members of the Pagans' Motorcycle Club of Washington."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "63173d1d-e4d6-4cad-9a0a-bca8ff08df69",
                        "source_entry_id": "2c4c38e6-e4a7-3fd5-a539-c9e154b19eb4",
                        "source_sense_id": "b6ef423a-5e3a-3c59-8467-2650d4d0ecbd",
                        "source_sense_description": "iemand die met een fiets rijdt",
                        "target_lang_word": "cycliste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cycliste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "105e27c2-68b4-35f4-ba9d-d48b0ce056be",
                                        "entry_id": "e85d81cc-c60c-3e90-b926-63a879844ed1",
                                        "glosses": [
                                            "Qui concerne le cyclisme."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "cycliste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ed19d106-adda-3061-9407-6dcb4b495647",
                                        "entry_id": "ebe35584-713f-39ac-93e5-d05fa3531af2",
                                        "glosses": [
                                            "Personne qui pratique le cyclisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c548dc8-b999-47df-85d0-ef11d3aa8d09",
                                                "sense_id": "ed19d106-adda-3061-9407-6dcb4b495647",
                                                "text": "Entre La Couarde-sur-Mer et Ars-en-Ré, le cycliste découvrira les marais salants qui se déploient à perte de vue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d107e6b-dc5b-3a51-b727-7c1ce899b28e",
                                        "entry_id": "ebe35584-713f-39ac-93e5-d05fa3531af2",
                                        "glosses": [
                                            "Personne qui va à bicyclette."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4708f6e5-6bc4-4f7f-a72f-a170ce93b93e",
                                                "sense_id": "5d107e6b-dc5b-3a51-b727-7c1ce899b28e",
                                                "text": "On me dit qu'un cycliste est tombé de sa machine, et que, dans sa chute, son fusil est parti tout seul: alors on a fait feu dans sa direction."
                                            },
                                            {
                                                "example_id": "b0cff143-77fc-4a49-865a-6fde15365abd",
                                                "sense_id": "5d107e6b-dc5b-3a51-b727-7c1ce899b28e",
                                                "text": "— Il ne doit pas y avoir beaucoup de cyclistes dans Paris. Surtout place de la Concorde…\n— On m’a dit qu’il y en avait encore…\n— C’est vrai, s’écria Busard. J’en ai même connu un. Il est venu en vacances ici. C’était un porteur de journaux.\n— Il y a longtemps ?\n— En 1946.\n— Maintenant les porteurs de journaux doivent avoir des mobylettes.\n— Pas nécessairement, dit Busard. Ça dépend du prix de revient et de l’amortissement."
                                            },
                                            {
                                                "example_id": "d3ec2751-4324-44d7-824e-feeefd981764",
                                                "sense_id": "5d107e6b-dc5b-3a51-b727-7c1ce899b28e",
                                                "text": "Le cataphote rouge vacille et brille à l'arrière de la bicyclette et bouge suivant les zigzags et les mouvements que fait le cycliste invisible sur la selle."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cycliste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0d6861e2-929e-36e7-a02b-583149353843",
                                        "entry_id": "c758381d-37e9-3b6a-9125-1281d9391c09",
                                        "glosses": [
                                            "Short moulant, à l'origine porté par les cyclistes puis devenu un vêtement à la mode pour les femmes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85be8df9-48fe-4fbe-8864-0a018447cc7a",
                                                "sense_id": "0d6861e2-929e-36e7-a02b-583149353843",
                                                "text": "L’homme porte un cycliste noir, et c’est tout."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
