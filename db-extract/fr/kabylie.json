        "fr-extract.jsonl": [
            {
                "entry_id": "1b83fcc7-61f6-31aa-9bc5-bea8fa793a08",
                "word": "Kabylie",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "cd725dff-9975-361e-805d-b68854b67019",
                        "entry_id": "1b83fcc7-61f6-31aa-9bc5-bea8fa793a08",
                        "glosses": [
                            "Région historique et ethnolinguistique située dans le nord de l’Algérie, à l’est d’Alger."
                        ],
                        "tags": [
                            "toponymic"
                        ],
                        "examples": [
                            {
                                "example_id": "db45668c-0c27-47f1-a4a9-52421b0e6cf4",
                                "sense_id": "cd725dff-9975-361e-805d-b68854b67019",
                                "text": "Avant la conquête française, la Kabylie ne connaissait pas d’autre mode de répression que la vengeance privée et les Kabyles n’étaient pas de mauvaises gens."
                            },
                            {
                                "example_id": "054284ab-a5a2-4664-ab87-58efc7ddbda2",
                                "sense_id": "cd725dff-9975-361e-805d-b68854b67019",
                                "text": "La variante sur le Hodna, baptisée Étincelle, visait à couper l’approvisionnement des katibas de Kabylie en provenance de Tunisie par le Hodna et les Aurès."
                            },
                            {
                                "example_id": "df279e06-98f3-4fdf-b013-3b3d58bd1d91",
                                "sense_id": "cd725dff-9975-361e-805d-b68854b67019",
                                "text": "Il y a un an, il avait accusé le Maroc, le Mouvement pour l’autonomie de la Kabylie (MAK) et le mouvement islamiste Rachad, deux organisations classées comme terroristes en Algérie, d’être à l’origine des incendies gigantesques qui ont frappé le pays."
                            },
                            {
                                "example_id": "3c7b40e6-0c0a-45d6-a840-77ef5aacedb0",
                                "sense_id": "cd725dff-9975-361e-805d-b68854b67019",
                                "text": "Ce constat le ramena vers son propre passé, et il se revit en Kabylie. Avec cette même rage au ventre, cette même haine, cette violence égale."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a109ddc1-6792-433f-b61a-f8ad4bbc20d8",
                        "source_entry_id": "1b83fcc7-61f6-31aa-9bc5-bea8fa793a08",
                        "source_sense_id": "cd725dff-9975-361e-805d-b68854b67019",
                        "target_lang_word": "Kabylei",
                        "target_lang_code": "de",
