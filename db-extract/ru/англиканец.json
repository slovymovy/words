                    {
                        "translation_id": "ba91fd91-cc3f-416c-8ddc-eafcc8c64d25",
                        "source_entry_id": "43eed073-830f-3fd4-92fb-9f82fd954380",
                        "source_sense_id": "a2055cf1-5709-373d-bae8-456c00172637",
