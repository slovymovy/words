                ],
                "senses": [
                    {
                        "sense_id": "af7828e3-4339-37c6-8361-b4bc69779407",
                        "entry_id": "38b71ae7-935d-3c53-a9be-fe10c8632c84",
                        "glosses": [
                            "Zusammenschluss von Personen, die kulturelle Aktivitäten fördern wollen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec82e726-d1e0-46bc-a972-ac918684b012",
                                "sense_id": "af7828e3-4339-37c6-8361-b4bc69779407",
                                "text": "„Der damals gebildete Verein spaltete sich sehr bald, und es zweigte sich von ihm der sogenannte ‚Kulturbund‘ ab, dessen Teilnehmerinnen mit wenigen Ausnahmen den radikalsten Ansichten anhingen.“ (1891)"
                            },
                            {
                                "example_id": "74dc3b3d-7508-43d3-846f-6fdb6bb8c46c",
                                "sense_id": "af7828e3-4339-37c6-8361-b4bc69779407",
                                "text": "„In diesen Zusammenhang gehören auch Versuche in den Regionen, die Wirksamkeit der zwischen 1933 und 1941 bestehenden jüdischen Kulturbünde wissenschaftlich zu rekonstruieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "95f3b2b8-7d65-3274-b17e-52d7605c2e51",
                        "entry_id": "38b71ae7-935d-3c53-a9be-fe10c8632c84",
                        "glosses": [
                            "Massenorganisation zur Schaffung einer sozialistischen Kultur in der Gesellschaft"
                        ],
                        "tags": [
                            "historical",
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "e82d81eb-66fa-4c99-8706-a31b7cde1044",
                                "sense_id": "95f3b2b8-7d65-3274-b17e-52d7605c2e51",
                                "text": "„Nur wer als Sammler im Kulturbund organisiert war, erhielt seit 1953 einen Sammlerausweis zum Bezug der Sonderpostwertzeichen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
