{
    "word_family": [
        "bludger"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ae4b5508-859c-3ec2-8771-8b2306625b7e",
                    "sense_definition": "An easy task or a school subject that requires very little effort",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "easy_task",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Most students chose the drama elective because they heard it was a total <w>bludge</w>.",
                            "target_lang_translations": {
                                "ru": "Большинство студентов выбрали драму в качестве факультатива, потому что слышали, что это полная <w>халява</w>."
                            }
                        },
                        {
                            "text": "Taking that introductory course turned out to be a real <w>bludge</w> for him.",
                            "target_lang_translations": {
                                "ru": "Этот вводный курс оказался для него настоящей <w>лафой</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "doddle"
                    ],
                    "common_phrases": [
                        "total bludge",
                        "bit of a bludge"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Australia and New Zealand"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Легкая задача или учебный предмет, не требующий практически никаких усилий"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "халява",
                                "target_lang_sense_clarification": "о чем-то очень легком"
                            },
                            {
                                "target_lang_word": "лафа",
                                "target_lang_sense_clarification": "безделье или легкая работа"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "86dd2da1-9032-3232-b40e-0dd7cc7e1e6b",
                    "sense_definition": "The act of avoiding work or living off the efforts of others",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "avoidance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He finally decided to get a job and get off the <w>bludge</w> after months of unemployment.",
                            "target_lang_translations": {
                                "ru": "После нескольких месяцев безработицы он наконец решил найти работу и перестать <w>тунеядствовать</w>."
                            }
                        },
                        {
                            "text": "Her constant <w>bludge</w> on her parents' generosity eventually led to a family argument.",
                            "target_lang_translations": {
                                "ru": "Ее постоянное <w>иждивенчество</w> за счет щедрости родителей в конце концов привело к семейной ссоре."
                            }
                        }
                    ],
                    "common_phrases": [
                        "off the bludge"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Australia and New Zealand"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Уклонение от работы или жизнь за счет усилий других людей"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тунеядство",
                                "target_lang_sense_clarification": "образ жизни бездельника"
                            },
                            {
                                "target_lang_word": "безделье",
                                "target_lang_sense_clarification": "состояние ничегонеделания"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "33958596-b954-3a33-80f9-7209d2f3860a",
                    "sense_definition": "To do nothing or be idle, especially when one is supposed to be working",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "idleness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you <w>bludge</w> all afternoon, you will never finish the project on time.",
                            "target_lang_translations": {
                                "ru": "Если ты будешь <w>бездельничать</w> весь день, ты никогда не закончишь проект вовремя."
                            }
                        },
                        {
                            "text": "The boss caught him trying to <w>bludge</w> in the break room during the busiest shift.",
                            "target_lang_translations": {
                                "ru": "Начальник поймал его, когда тот пытался <w>сачкануть</w> в комнате отдыха во время самой загруженной смены."
                            }
                        }
                    ],
                    "synonyms": [
                        "idle",
                        "laze",
                        "lounge"
                    ],
                    "common_phrases": [
                        "bludge all day"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Australia and New Zealand"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ничего не делать или бездельничать, особенно когда нужно работать"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бездельничать",
                                "target_lang_sense_clarification": "проводить время в праздности"
                            },
                            {
                                "target_lang_word": "сачковать",
                                "target_lang_sense_clarification": "уклоняться от работы"
                            },
                            {
                                "target_lang_word": "бить баклуши",
                                "target_lang_sense_clarification": "заниматься пустяками вместо дела"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bbe98d3e-f96c-3626-bbe0-927e8eedb14b",
                    "sense_definition": "To avoid responsibilities or duties, often leaving them for others to complete",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "avoidance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to <w>bludge</w> school and go to the beach with his friends instead.",
                            "target_lang_translations": {
                                "ru": "Он решил <w>прогулять</w> школу и вместо этого пойти на пляж с друзьями."
                            }
                        },
                        {
                            "text": "It is not fair to <w>bludge</w> on your teammates when everyone else is working hard.",
                            "target_lang_translations": {
                                "ru": "Нечестно <w>халявить</w> за счет своих товарищей по команде, когда все остальные усердно работают."
                            }
                        }
                    ],
                    "synonyms": [
                        "shirk"
                    ],
                    "common_phrases": [
                        "bludge school",
                        "bludge on others"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Australia and New Zealand"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Избегать обязанностей, часто перекладывая их на других"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отлынивать",
                                "target_lang_sense_clarification": "уклоняться от дела"
                            },
                            {
                                "target_lang_word": "прогуливать",
                                "target_lang_sense_clarification": "не посещать занятия или работу"
                            },
                            {
                                "target_lang_word": "халявить",
                                "target_lang_sense_clarification": "работать спустя рукава"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d33426dd-076d-3ecb-8e98-8801ef9a09c3",
                    "sense_definition": "To obtain something from someone else without giving anything in return",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "taking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He managed to <w>bludge</w> a cigarette from a stranger outside the station.",
                            "target_lang_translations": {
                                "ru": "Ему удалось <w>стрельнуть</w> сигарету у незнакомца возле станции."
                            }
                        },
                        {
                            "text": "I forgot my wallet, so I had to <w>bludge</w> a few dollars for lunch.",
                            "target_lang_translations": {
                                "ru": "Я забыл кошелек, поэтому мне пришлось <w>перехватить</w> несколько долларов на обед."
                            }
                        }
                    ],
                    "synonyms": [
                        "cadge",
                        "scrounge",
                        "sponge"
                    ],
                    "common_phrases": [
                        "bludge a cigarette"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Australia and New Zealand"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Получать что-либо от другого человека, ничего не давая взамен"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "клянчить",
                                "target_lang_sense_clarification": "выпрашивать что-то"
                            },
                            {
                                "target_lang_word": "стрелять",
                                "target_lang_sense_clarification": "просить сигарету или мелочь"
                            },
                            {
                                "target_lang_word": "выцыганить",
                                "target_lang_sense_clarification": "хитростью получить что-то"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "084d338a-6c15-3620-99ad-8968fec6ff85",
                    "sense_definition": "To live off someone else or state welfare despite being able to work",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "idleness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician criticized those who <w>bludge</w> on the system instead of seeking employment.",
                            "target_lang_translations": {
                                "ru": "Политик раскритиковал тех, кто <w>паразитирует</w> на системе вместо того, чтобы искать работу."
                            }
                        },
                        {
                            "text": "He was accused of trying to <w>bludge</w> off his relatives for years.",
                            "target_lang_translations": {
                                "ru": "Его обвинили в том, что он годами пытался <w>сидеть на шее</w> у своих родственников."
                            }
                        }
                    ],
                    "synonyms": [
                        "freeload",
                        "sponge"
                    ],
                    "common_phrases": [
                        "bludge off the state"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Australia and New Zealand"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Жить за чужой счет или на государственное пособие, имея возможность работать"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тунеядствовать",
                                "target_lang_sense_clarification": "жить за чужой счет"
                            },
                            {
                                "target_lang_word": "паразитировать",
                                "target_lang_sense_clarification": "жить за счет других"
                            },
                            {
                                "target_lang_word": "сидеть на шее",
                                "target_lang_sense_clarification": "быть иждивенцем"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a9ea09d5-cdb1-316a-9a77-db0988ea5baa",
                    "sense_definition": "To live off the earnings of a prostitute",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "exploitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the historical underworld, some men would <w>bludge</w> on the earnings of local workers.",
                            "target_lang_translations": {
                                "ru": "В криминальном мире прошлого некоторые мужчины <w>жили за счет доходов</w> местных работниц."
                            }
                        },
                        {
                            "text": "The investigation revealed how he managed to <w>bludge</w> for years without a legal job.",
                            "target_lang_translations": {
                                "ru": "Расследование показало, как ему удавалось <w>сутенерствовать</w> годами, не имея легальной работы."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Australia and New Zealand"
                        },
                        {
                            "trait_type": "slang",
                            "comment": "historical or specific criminal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Жить за счет доходов проститутки"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сутенерствовать",
                                "target_lang_sense_clarification": "заниматься сутенерством"
                            },
                            {
                                "target_lang_word": "жить на содержании",
                                "target_lang_sense_clarification": "в контексте эксплуатации"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}