                        "sense_id": "1af9bd45-2edc-3e57-a0fc-11c7445609ae",
                        "entry_id": "839fcbf7-fd7a-32a7-a5ef-30faf4ea96da",
                        "glosses": [
                            "Offended; having taken umbrage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ed02ac0-adf3-42d5-a72f-c1b7501bd3a7",
                                "sense_id": "1af9bd45-2edc-3e57-a0fc-11c7445609ae",
                                "text": "I feel very, very affronted by this process which did not include us, at least in the interview stage so we could have the benefit of an exchange with these individuals."
                            },
                            {
                                "example_id": "e4ea9166-6e9c-4642-be53-402fbae7ae2b",
                                "sense_id": "1af9bd45-2edc-3e57-a0fc-11c7445609ae",
                                "text": "[…] a majority (59 per cent) would be affronted by the Church taking a stand on parliamentary legislation; and Poles would be even more affronted (81 per cent) by priests telling people how to vote."
                            },
                            {
                                "example_id": "2f3c5a7a-aedd-4af6-9a8f-5279dc5c08a7",
                                "sense_id": "1af9bd45-2edc-3e57-a0fc-11c7445609ae",
                                "text": "Simon was affronted at being recalled and even more affronted at being asked to account for his actions – this did not bode well."
                            }
                        ]
                    },
                    {
                        "sense_id": "92fa9d4f-48a5-3eca-a356-cab04e0194a6",
                        "entry_id": "839fcbf7-fd7a-32a7-a5ef-30faf4ea96da",
                        "glosses": [
                            "Synonym of affronté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4512e31e-52e6-44fb-8a8b-26808695fa79",
                                "sense_id": "92fa9d4f-48a5-3eca-a356-cab04e0194a6",
                                "text": "PROVENANCE The arms on f.25 are argent a lion rampant affronted azure, with claws and tongue gules; these are perhaps the arms of Acciajaoli, of Florence (cf. the sale in these rooms, 7 December 1992, lot 74), or Nini, of Siena[…]"
                            }
                        ]
                    }
