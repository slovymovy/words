                        "examples": [
                            {
                                "example_id": "20801eff-2d69-4f09-bda7-4351fa5463b2",
                                "sense_id": "6310197d-08c7-3ffb-81ac-a4274906a846",
                                "text": "De achtste kruistocht eindigde zonder veel succes.",
                                "translation": "The eighth crusade ended without much success.",
                                "english": "The eighth crusade ended without much success."
                            },
                            {
                                "example_id": "53604ca9-e9ed-43e5-ab31-f5f41f3f3d5f",
                                "sense_id": "6310197d-08c7-3ffb-81ac-a4274906a846",
                                "text": "De kruistochten hadden een diepe invloed op de middeleeuwse geschiedenis.",
                                "translation": "The crusades had a profound impact on medieval history.",
                                "english": "The crusades had a profound impact on medieval history."
                            }
                        ]
