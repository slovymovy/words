                                        "entry_id": "4e868a74-a314-3db3-a29a-88eb742f5c94",
                                        "glosses": [
                                            "Science qui consiste à étudier l’histoire du magnétisme terrestre par l’observation des roches anciennes."
                                        ],
                                        "tags": [
                                            "Magnétisme"
                                        ],
                                        "examples": [
