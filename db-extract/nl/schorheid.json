                                        "entry_id": "d5b17523-0f21-3038-b641-643222b3c4f0",
                                        "glosses": [
                                            "The state or characteristic of being raspy."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d38be0d4-fcb0-43b6-bdf6-a7353c397057",
                                                "sense_id": "9a7a6d7b-d418-3ec3-8a0f-731bcd0244ca",
                                                "text": "The speaking voice was clear and strong with no raspiness, but there was a noticeable rasp in the loud singing voice."
                                            }
                                        ]
