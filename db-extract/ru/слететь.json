                        "entry_id": "fa487809-7521-36b0-a4f7-3f77b15403b0",
                        "glosses": [
                            "to fly down (from), to fly away (from)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80cfa263-6f39-4dd8-bd60-7463466f6d4a",
                                "sense_id": "2a525336-81e5-3a99-8aef-cdf2cb52dd7d",
                                "text": "воробе́й слете́л с кры́ши",
                                "translation": "the sparrow flew down from the roof",
                                "english": "the sparrow flew down from the roof"
                            },
                            {
                                "example_id": "a9cc4ac4-3bfc-441f-a551-17871a58339b",
                                "sense_id": "2a525336-81e5-3a99-8aef-cdf2cb52dd7d",
                                "text": "ба́бочка слете́ла с цветка́",
                                "translation": "the butterfly flew away from the flower",
                                "english": "the butterfly flew away from the flower"
                            }
                        ]
                    },
                    {
                        "sense_id": "4de1ba9c-22ae-3e66-9084-8bb316c6ec4f",
                        "entry_id": "fa487809-7521-36b0-a4f7-3f77b15403b0",
                        "glosses": [
                            "to fall down (from), to fall (off)"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "62ff1378-586e-4be4-818f-f50b3a918390",
                                "sense_id": "4de1ba9c-22ae-3e66-9084-8bb316c6ec4f",
                                "text": "бума́ги слете́ли со стола́",
                                "translation": "the papers fell off the table",
                                "english": "the papers fell off the table"
                            },
                            {
                                "example_id": "da4055ed-7613-410b-9f53-bb9232abd782",
                                "sense_id": "4de1ba9c-22ae-3e66-9084-8bb316c6ec4f",
                                "text": "ма́льчик слете́л с ло́шади",
                                "translation": "the boy fell off the horse",
                                "english": "the boy fell off the horse"
                            }
                        ]
                    },
                    {
                        "sense_id": "fec82c79-b1cc-35eb-a0d0-f90632e5599f",
