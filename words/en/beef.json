{
    "word_family": [
        "beefy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "22048679-803f-3cf1-84ec-cd682c0e3a25",
                    "sense_definition": "The meat obtained from cattle (cows, bulls, or oxen).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "meat_food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We are having roast <w>beef</w> and potatoes for dinner.",
                            "target_lang_translations": {
                                "ru": "У нас на ужин запеченная <w>говядина</w> с картошкой.",
                                "zh": "我们晚餐吃烤<w>牛肉</w>配土豆。",
                                "pl": "Na obiad mamy pieczoną <w>wołowinę</w> z ziemniakami."
                            }
                        },
                        {
                            "text": "I prefer chicken, but my brother loves <w>beef</w>.",
                            "target_lang_translations": {
                                "ru": "Я предпочитаю курицу, но мой брат любит <w>говядину</w>.",
                                "zh": "我更喜欢鸡肉，但我弟弟爱吃<w>牛肉</w>。",
                                "pl": "Wolę kurczaka, ale mój brat uwielbia <w>wołowinę</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "roast beef",
                        "ground beef",
                        "corned beef",
                        "beef jerky"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мясо крупного рогатого скота (коров, быков или волов).",
                        "zh": "牛的肉。",
                        "pl": "Mięso pozyskiwane z bydła (krów, byków lub wołów)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "говядина",
                                "target_lang_sense_clarification": "мясо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "牛肉",
                                "target_lang_sense_clarification": "食用肉类"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "wołowina",
                                "target_lang_sense_clarification": "mięso z wołu lub krowy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3e7805a4-e7f8-3dc7-b77b-9a0b2f5586d2",
                    "sense_definition": "A complaint, argument, or long-standing disagreement between people.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "conflict",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has a serious <w>beef</w> with his neighbor about the noise.",
                            "target_lang_translations": {
                                "ru": "У него серьезные <w>тёрки</w> с соседом из-за шума.",
                                "zh": "他因为噪音问题和邻居有严重的<w>过节</w>。",
                                "pl": "Ma poważny <w>zatarg</w> z sąsiadem o hałas."
                            }
                        },
                        {
                            "text": "They finally settled their <w>beef</w> and shook hands.",
                            "target_lang_translations": {
                                "ru": "Они наконец уладили свой <w>конфликт</w> и пожали руки.",
                                "zh": "他们最终化解了<w>矛盾</w>并握手言和。",
                                "pl": "W końcu zażegnali swój <w>konflikt</w> i podali sobie ręce."
                            }
                        }
                    ],
                    "common_phrases": [
                        "have a beef",
                        "start beef",
                        "settle a beef"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "common in informal contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Жалоба, спор или давние разногласия между людьми.",
                        "zh": "人与人之间的抱怨、争吵或长期不和。",
                        "pl": "Skarga, spór lub długotrwałe nieporozumienie między ludźmi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разборка",
                                "target_lang_sense_clarification": "сленг: конфликт, выяснение отношений"
                            },
                            {
                                "target_lang_word": "конфликт",
                                "target_lang_sense_clarification": "разногласие"
                            },
                            {
                                "target_lang_word": "тёрки",
                                "target_lang_sense_clarification": "сленг: неприятности, споры"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "矛盾",
                                "target_lang_sense_clarification": "冲突或不和"
                            },
                            {
                                "target_lang_word": "过节",
                                "target_lang_sense_clarification": "指积怨或仇恨"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "konflikt",
                                "target_lang_sense_clarification": "ogólne określenie sporu"
                            },
                            {
                                "target_lang_word": "zatarg",
                                "target_lang_sense_clarification": "spór lub nieporozumienie"
                            },
                            {
                                "target_lang_word": "spina",
                                "target_lang_sense_clarification": "potocznie: konflikt, napięta sytuacja"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7c5d99bf-0824-3ebc-95b6-54999b653e72",
                    "sense_definition": "Consisting of or containing beef as an ingredient.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "meat_food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She ordered a hearty <w>beef</w> stew for lunch.",
                            "target_lang_translations": {
                                "ru": "Она заказала сытное <w>говяжье</w> рагу на обед.",
                                "zh": "她午餐点了一份丰盛的<w>牛肉</w>炖菜。",
                                "pl": "Zamówiła na lunch sycący gulasz <w>wołowy</w>."
                            }
                        },
                        {
                            "text": "The <w>beef</w> sandwich comes with a side of fries.",
                            "target_lang_translations": {
                                "ru": "Сэндвич с <w>говядиной</w> подается с картошкой фри.",
                                "zh": "这份<w>牛肉</w>三明治配有薯条。",
                                "pl": "Kanapka <w>wołowa</w> podawana jest z frytkami."
                            }
                        }
                    ],
                    "common_phrases": [
                        "beef stew",
                        "beef stock",
                        "beef patty"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состоящий из говядины или содержащий её в качестве ингредиента.",
                        "zh": "由牛肉制成或含有牛肉成分的。",
                        "pl": "Składający się z wołowiny lub zawierający ją jako składnik."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "говяжий",
                                "target_lang_sense_clarification": "сделанный из говядины"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "牛肉",
                                "target_lang_sense_clarification": "作定语表示成分"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "wołowy",
                                "target_lang_sense_clarification": "zrobiony z wołowiny"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "56f03672-4bc1-32cf-971d-d927d5a6f94c",
                    "sense_definition": "Relating to the raising of cattle for meat production.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "meat_food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The region is famous for its many <w>beef</w> farms.",
                            "target_lang_translations": {
                                "ru": "Этот регион славится своими многочисленными <w>мясными</w> фермами.",
                                "zh": "该地区以其众多的<w>肉用</w>农场而闻名。",
                                "pl": "Region słynie z wielu farm <w>mięsnych</w>."
                            }
                        },
                        {
                            "text": "They raise <w>beef</w> cattle in the open fields.",
                            "target_lang_translations": {
                                "ru": "Они выращивают <w>мясной</w> скот на открытых полях.",
                                "zh": "他们在开阔的田野里饲养<w>肉用</w>牛。",
                                "pl": "Hodują bydło <w>mięsne</w> na otwartych polach."
                            }
                        }
                    ],
                    "common_phrases": [
                        "beef cattle",
                        "beef farming",
                        "beef industry"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к разведению крупного рогатого скота для производства мяса.",
                        "zh": "与饲养肉牛以生产肉类相关的。",
                        "pl": "Dotyczący hodowli bydła w celu produkcji mięsa."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мясной",
                                "target_lang_sense_clarification": "о породе скота или направлении хозяйства"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "肉用",
                                "target_lang_sense_clarification": "指专门用于产肉的品种或产业"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "mięsny",
                                "target_lang_sense_clarification": "o rasie bydła lub typie hodowli"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a85381da-8440-383a-bb17-2ee672fb4bd2",
                    "sense_definition": "To make something stronger, bigger, or more effective (usually followed by 'up').",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "strength",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company decided to <w>beef</w> up its security systems.",
                            "target_lang_translations": {
                                "ru": "Компания решила <w>усилить</w> свои системы безопасности.",
                                "zh": "公司决定<w>加强</w>其安全系统。",
                                "pl": "Firma zdecydowała się <w>wzmocnić</w> swoje systemy bezpieczeństwa."
                            }
                        },
                        {
                            "text": "We need to <w>beef</w> up the team with some experienced players.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>укрепить</w> команду несколькими опытными игроками.",
                                "zh": "我们需要引入一些经验丰富的球员来<w>充实</w>队伍。",
                                "pl": "Musimy <w>wzmocnić</w> zespół kilkoma doświadczonymi graczami."
                            }
                        }
                    ],
                    "synonyms": [
                        "beef up"
                    ],
                    "target_lang_definitions": {
                        "ru": "Укрепить, усилить или сделать что-то более эффективным (обычно с предлогом 'up').",
                        "zh": "使某物更强、更大或更有效（通常后接 up）。",
                        "pl": "Uczynić coś silniejszym, większym lub bardziej efektywnym (zazwyczaj z 'up')."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "усиливать",
                                "target_lang_sense_clarification": "делать мощнее"
                            },
                            {
                                "target_lang_word": "укреплять",
                                "target_lang_sense_clarification": "делать надежнее"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "加强",
                                "target_lang_sense_clarification": "使更稳固或有效"
                            },
                            {
                                "target_lang_word": "充实",
                                "target_lang_sense_clarification": "使内容或力量更丰富"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "wzmocnić",
                                "target_lang_sense_clarification": "uczynić silniejszym"
                            },
                            {
                                "target_lang_word": "podrasować",
                                "target_lang_sense_clarification": "potocznie: ulepszyć, wzmocnić"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "29a52e8d-8510-3990-90b2-9b2a42e0eda6",
                    "sense_definition": "To have a long-standing disagreement or fight with someone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "conflict",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Those two groups have been <w>beefing</w> for years.",
                            "target_lang_translations": {
                                "ru": "Эти две группы <w>враждуют</w> уже много лет.",
                                "zh": "那两个团体已经<w>结怨</w>多年了。",
                                "pl": "Te dwie grupy <w>kłócą się</w> od lat."
                            }
                        },
                        {
                            "text": "It is better to talk it out than to keep <w>beefing</w> with each other.",
                            "target_lang_translations": {
                                "ru": "Лучше всё обсудить, чем продолжать <w>грызться</w> друг с другом.",
                                "zh": "与其一直互相<w>争执</w>，不如把话说开。",
                                "pl": "Lepiej to przegadać, niż ciągle <w>kłócić się</w> ze sobą."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Иметь давние разногласия или враждовать с кем-то.",
                        "zh": "与某人有长期的分歧或争斗。",
                        "pl": "Mieć długotrwałe nieporozumienie lub walczyć z kimś."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "враждовать",
                                "target_lang_sense_clarification": "находиться в конфликте"
                            },
                            {
                                "target_lang_word": "грызться",
                                "target_lang_sense_clarification": "сленг: постоянно ссориться"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "结怨",
                                "target_lang_sense_clarification": "产生仇恨或长期不和"
                            },
                            {
                                "target_lang_word": "争执",
                                "target_lang_sense_clarification": "持续的争吵"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "mieć z kimś na pieńku",
                                "target_lang_sense_clarification": "idiom: być w konflikcie"
                            },
                            {
                                "target_lang_word": "kłócić się",
                                "target_lang_sense_clarification": "pozostawać w sporze"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "786b0d81-7afa-3089-886a-53d513884519",
                    "sense_definition": "To complain or grumble about something.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "conflict",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stop <w>beefing</w> about the weather and let's go.",
                            "target_lang_translations": {
                                "ru": "Хватит <w>ныть</w> из-за погоды, пошли.",
                                "zh": "别再为天气<w>抱怨</w>了，我们走吧。",
                                "pl": "Przestań <w>narzekać</w> na pogodę i chodźmy."
                            }
                        },
                        {
                            "text": "He sat in the corner <w>beefing</w> about his bad luck.",
                            "target_lang_translations": {
                                "ru": "Он сидел в углу, <w>жалуясь</w> на свое невезение.",
                                "zh": "他坐在角落里为自己的坏运气<w>发牢骚</w>。",
                                "pl": "Siedział w kącie i <w>marudził</w> na swojego pecha."
                            }
                        }
                    ],
                    "common_phrases": [
                        "beef about"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Жаловаться или ворчать по поводу чего-либо.",
                        "zh": "对某事抱怨或发牢骚。",
                        "pl": "Narzekać lub marudzić na coś."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жаловаться",
                                "target_lang_sense_clarification": "выражать недовольство"
                            },
                            {
                                "target_lang_word": "ворчать",
                                "target_lang_sense_clarification": "высказывать недовольство в раздраженной манере"
                            },
                            {
                                "target_lang_word": "ныть",
                                "target_lang_sense_clarification": "разг.: надоедливо жаловаться"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "抱怨",
                                "target_lang_sense_clarification": "表达不满"
                            },
                            {
                                "target_lang_word": "发牢骚",
                                "target_lang_sense_clarification": "不满地唠叨"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "narzekać",
                                "target_lang_sense_clarification": "wyrażać niezadowolenie"
                            },
                            {
                                "target_lang_word": "marudzić",
                                "target_lang_sense_clarification": "potocznie: narzekać w irytujący sposób"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}