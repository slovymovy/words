                                "target_senses": [
                                    {
                                        "sense_id": "c08e298e-82e3-3854-88e9-5da7b1a861d5",
                                        "entry_id": "4c5871cb-8807-33ba-87c9-3eab07706e6c",
                                        "glosses": [
                                            "vedlejší světová strana mezi severem a západem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8dfe3158-6178-4fd1-b6e5-02a0c3dc8805",
                                                "sense_id": "c08e298e-82e3-3854-88e9-5da7b1a861d5",
                                                "text": "Na mnoha místech na severozápadě Německa v noci na včerejšek popadaly stromy na železnici."
                                            }
                                        ]
