                        "examples": [
                            {
                                "example_id": "f0fdff76-b60d-4387-a024-d8d13b0d12ee",
                                "sense_id": "528da9b7-8a42-3838-b1a0-eb18bfe04ad5",
                                "text": "There exists a strange tetralogue entitled: “A study of the first scene of Shakespeare’s Coriolanus.” In it Brecht tried to record his preliminary discussions with his assistants."
                            },
                            {
                                "example_id": "70676b57-7198-4431-a95d-f95e8aca9fd4",
                                "sense_id": "528da9b7-8a42-3838-b1a0-eb18bfe04ad5",
                                "text": "It sets the scene for the second layer of the work, the ‘tetralogue’ or four-sided dialogue between Smitho, a serious and enquiring English gentleman, Prudenzio, a classicist pedant, Frulla, a rude servant, and Teofilo, the narrator."
                            },
                            {
                                "example_id": "aab80ed5-285a-4ece-acc7-c58766473345",
                                "sense_id": "528da9b7-8a42-3838-b1a0-eb18bfe04ad5",
                                "text": "Collaborative problem-solving has been assessed by tetralogues that have two agents interacting with two humans[…]."
                            }
