                "senses": [
                    {
                        "sense_id": "d03c011c-a015-337f-9019-67edaa4bd266",
                        "entry_id": "41794b79-c9ee-3cd9-8364-0cb2287a0c52",
                        "glosses": [
                            "örtliche Behörde, die für die Verwaltung der Steuerabgaben der Bevölkerung an den Staat verantwortlich ist"
                        ],
                        "tags": [
                            "Staatsorgan"
                        ],
                        "examples": [
                            {
                                "example_id": "428571d9-0ca7-4282-a0f6-960f7f5f6782",
                                "sense_id": "d03c011c-a015-337f-9019-67edaa4bd266",
                                "text": "Das Finanzamt versendet Steuerbescheide mit der Post."
                            },
                            {
                                "example_id": "0cf57bce-d8ac-4f1c-9a25-8b1cc6be8e16",
                                "sense_id": "d03c011c-a015-337f-9019-67edaa4bd266",
                                "text": "„Auch die Finanzämter treiben noch immer zu wenig Geld ein, die Außenstände bei Steuern und Abgaben liegen bei 70 Prozent des BIP.“"
                            },
                            {
                                "example_id": "99b9fde3-0a56-47ae-8fb4-5639b20a2056",
                                "sense_id": "d03c011c-a015-337f-9019-67edaa4bd266",
                                "text": "„Ich wischte den Hörer mit einer Mahnung vom Finanzamt trocken und nahm ihn ab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "bd8b1ea6-1648-3805-bd19-f090600a21bf",
                        "entry_id": "41794b79-c9ee-3cd9-8364-0cb2287a0c52",
                        "glosses": [
                            "Gebäude, in dem diese Behörde [1] ihren Sitz hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9014d8b0-39de-4d81-8fcb-c424e1cf0bf3",
                                "sense_id": "bd8b1ea6-1648-3805-bd19-f090600a21bf",
                                "text": "Den Paternoster im Finanzamt München gibt es leider nicht mehr."
                            }
                        ],
