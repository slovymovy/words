                                "target_senses": [
                                    {
                                        "sense_id": "764124ae-e535-3285-934d-75a3f12910b4",
                                        "entry_id": "cc734ccd-65a3-3bfc-bfe0-d77fd1b360aa",
                                        "glosses": [
                                            "The crumbly, decayed portions of wooden members of buildings, especially at or below grade, usually caused by a fungal infection."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0101fce2-7451-4887-95de-86399939393d",
                                                "sense_id": "764124ae-e535-3285-934d-75a3f12910b4",
                                                "text": "They are, for the most part, low-roofed, mouldy rooms, where innumerable rolls of parchment, which have been perspiring in secret for the last century, send forth an agreeable odour, which is mingled by day with the scent of the dry-rot, and by night with the various exhalations which arise from damp cloaks, festering umbrellas, and the coarsest tallow candles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "574e39d6-d17e-3297-ad7f-b9cc45f6fb67",
                                        "entry_id": "cc734ccd-65a3-3bfc-bfe0-d77fd1b360aa",
                                        "glosses": [
                                            "Any progression of decay, corruption, or obsolescence."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b63cf8c-07e5-4e03-b0b0-968219d18a33",
                                                "sense_id": "574e39d6-d17e-3297-ad7f-b9cc45f6fb67",
                                                "text": "Therefore I am like a moth to Ephraim, and like dry rot to the house of Judah."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d811a088-fa36-329a-aab4-9140cccdcf21",
