                    "sense_id": "00eb1163-b6ee-3b81-9517-d83bac84bd67",
                    "sense_definition": "Plural of <w>horse</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer keeps several <w>horses</w> in the large stable behind the house.",
                            "target_lang_translations": {
                                "ru": "Фермер держит несколько <w>лошадей</w> в большой конюшне за домом.",
                                "zh": "农夫在屋后的那个大马厩里养了几匹<w>马</w>。"
                            }
                        },
                        {
                            "text": "Wild <w>horses</w> can still be found roaming in some remote areas.",
                            "target_lang_translations": {
                                "ru": "Диких <w>лошадей</w> все еще можно встретить бродящими в некоторых отдаленных районах.",
                                "zh": "在一些偏远地区仍然可以见到野<w>马</w>出没。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "wild horses",
                        "ride horses",
                        "hold your horses"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Множественное число от слова «лошадь» (крупное непарнокопытное животное).",
                        "zh": "马的复数形式，指一种大型奇蹄目哺乳动物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лошади",
                                "target_lang_sense_clarification": "животные"
                            },
                            {
                                "target_lang_word": "кони",
                                "target_lang_sense_clarification": "самцы или поэтическое название"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "马",
                                "target_lang_sense_clarification": "指代马匹这一物种"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "796e9605-3f89-385b-81bf-7c3afc225133",
                    "sense_definition": "A slang term for horsepower, referring to the power output of an engine.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This modified car engine packs over four hundred <w>horses</w> under the hood.",
                            "target_lang_translations": {
                                "ru": "Этот модифицированный двигатель имеет более четырехсот <w>лошадей</w> под капотом.",
                                "zh": "这台改装过的汽车引擎在引擎盖下拥有超过四百<w>马力</w>。"
                            }
                        },
                        {
                            "text": "You can really feel the extra <w>horses</w> when you accelerate onto the highway.",
                            "target_lang_translations": {
                                "ru": "Вы действительно чувствуете дополнительных <w>лошадок</w>, когда разгоняетесь на шоссе.",
                                "zh": "当你加速驶入高速公路时，真的能感受到那额外的<w>马力</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "horsepower"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сленговое название лошадиных сил, обозначающее мощность двигателя.",
                        "zh": "俚语，指发动机的功率，即马力。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лошади",
                                "target_lang_sense_clarification": "лошадиные силы (разг.)"
                            },
                            {
                                "target_lang_word": "лошадки",
                                "target_lang_sense_clarification": "мощность двигателя (уменьш.-ласк.)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "马力",
                                "target_lang_sense_clarification": "发动机功率单位"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "52b6a529-d8ee-3129-827a-4965f5d592b1",
                    "sense_definition": "Third-person singular simple present indicative of <w>horse</w>.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He often <w>horses</w> around with his friends instead of doing his homework.",
                            "target_lang_translations": {
                                "ru": "Он часто <w>дурачится</w> с друзьями вместо того, чтобы делать домашнее задание.",
                                "zh": "他经常和朋友们一起<w>胡闹</w>，而不去写作业。"
                            }
                        },
                        {
                            "text": "The wealthy owner <w>horses</w> his cavalry regiment with the finest steeds available.",
                            "target_lang_translations": {
                                "ru": "Богатый владелец <w>снабжает лошадьми</w> свой кавалерийский полк, предоставляя лучших скакунов.",
                                "zh": "这位富有的主人为他的骑兵团<w>配备</w>了现有的最好的战马。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "verb form"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма третьего лица единственного числа глагола «to horse» (снабжать лошадьми или дурачиться).",
                        "zh": "动词 horse 的第三人称单数形式，意为胡闹或提供马匹。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дурачится",
                                "target_lang_sense_clarification": "в сочетании с around"
                            },
                            {
                                "target_lang_word": "снабжает лошадьми",
                                "target_lang_sense_clarification": "обеспечивает транспортом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "胡闹",
                                "target_lang_sense_clarification": "指与人嬉戏打闹"
                            },
                            {
                                "target_lang_word": "配备马匹",
