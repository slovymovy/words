                "senses": [
                    {
                        "sense_id": "28bf3924-c403-3771-87eb-ae3a83a6eeaf",
                        "entry_id": "7e90f8e4-6fe4-38f0-89d1-edc1a334e74e",
                        "glosses": [
                            "To desist, to stop, to cease."
                        ],
                        "tags": [
                            "Northern-England",
