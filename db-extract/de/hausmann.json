                                    {
                                        "sense_id": "6f427e26-c057-3d7e-8a88-535ee5fbc4b0",
                                        "entry_id": "f13658b0-0079-35be-abd3-46667512323a",
                                        "glosses": [
                                            "A man who tends to his home as a housekeeper or homemaker; the male equivalent of a housewife."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c5074a8-5fa5-43f7-aa3d-e4d118bd7ab2",
                                                "sense_id": "6f427e26-c057-3d7e-8a88-535ee5fbc4b0",
                                                "text": "He’s always thought of himself as boring, “a white-bread suburban househusband.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "52616979-5b94-47e6-a183-575bf3df5e0f",
