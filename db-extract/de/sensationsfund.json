                    {
                        "sense_id": "4867777b-4bf1-378e-9d53-c74cf882475f",
                        "entry_id": "e750155c-f01e-3fc0-a8c5-897331112b9c",
                        "glosses": [
                            "Aufsehen erregende Entdeckung mit großer Bedeutung für ein Fachgebiet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3537945b-9fa0-4013-92d4-c03e7a49c32a",
                                "sense_id": "4867777b-4bf1-378e-9d53-c74cf882475f",
                                "text": "„US-Archäologen haben im ägyptischen Abydos einen Sensationsfund gemacht: Das Team um Josef Wegner grub die Grabstätte eines bisher unbekannten Pharaos aus.“"
                            },
                            {
                                "example_id": "6ded10d7-76de-450f-9690-003e778919d7",
                                "sense_id": "4867777b-4bf1-378e-9d53-c74cf882475f",
                                "text": "„In einer schwäbischen Höhle machen Archäologen einen Sensationsfund. Ihre Venus aus Elfenbein ist weltweit die älteste Figur, die einen Menschen darstellt.“"
                            }
                        ],
