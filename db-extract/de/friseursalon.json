                "senses": [
                    {
                        "sense_id": "b3306650-d295-3035-8b4e-da00b7c4ca84",
                        "entry_id": "8ff2530a-34de-3ca9-9672-1b6aa7e10647",
                        "glosses": [
                            "Betrieb/Salon eines Friseurs/einer Friseurin/Friseuse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3d7de24-2096-4bec-bf4f-0791117f0964",
                                "sense_id": "b3306650-d295-3035-8b4e-da00b7c4ca84",
                                "text": "„Im Friseursalon war es gerammelt voll.“"
                            },
                            {
                                "example_id": "cdf94e23-5a8d-4149-b5b3-7d2230faff6d",
                                "sense_id": "b3306650-d295-3035-8b4e-da00b7c4ca84",
                                "text": "„Der Friseursalon ist eine geschützte Enklave.“"
                            },
                            {
                                "example_id": "10c2b4d1-751a-408f-a58a-b04f0069a489",
                                "sense_id": "b3306650-d295-3035-8b4e-da00b7c4ca84",
                                "text": "„Chisom ließ sich gerade im Friseursalon in der Adeniran Ogunsanyastraße die Dauerwelle auffrischen, als ein ungaublich dicker Mann in Begleitung einer jungen Frau eintrat.“"
                            },
                            {
                                "example_id": "8ead55f9-f786-43a5-b31f-8c09b7477570",
                                "sense_id": "b3306650-d295-3035-8b4e-da00b7c4ca84",
                                "text": "„Erst als wir an Finkelsteins Friseursalon vorbeikamen, wachte ich auf und begann zu heulen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
