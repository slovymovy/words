                        "examples": [
                            {
                                "example_id": "67b3f89a-d6c9-425a-b625-5144306e7b33",
                                "sense_id": "93104b10-39b9-35f4-9bec-0828fa29636f",
                                "text": "Ík vind waspeen echt totaal smakeloos. Bospeen is wel lekker, maar een goeie knoestige winterpeen is echt heerlijk, daar zit veel meer smaak aan dan aan waspeen."
                            },
                            {
                                "example_id": "6ea3aac2-d964-4e3e-a324-e0b375e133a8",
                                "sense_id": "93104b10-39b9-35f4-9bec-0828fa29636f",
                                "text": "Zo blijkt er een fors cultuurverschil te bestaan tussen Katwijk aan Zee, waar vanouds de haringvisserij centraal stond en Katwijk aan den Rijn. Daar leefde men van de tuinbouw - de Katwijkers concentreerden zich op de verbouw van waspeen -, tot de groenteveiling in 2001 ter ziele ging."
                            }
                        ]
                    }
