                    {
                        "sense_id": "24c75d8e-0356-3660-87e4-69b5fc43fd31",
                        "entry_id": "9a97a50a-cc9b-3e03-a9e7-8d6adb3db2a8",
                        "glosses": [
                            "Brassard métallique dont les gladiateurs se protégeaient le bras droit et les archers le bras gauche."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "287c5f36-f332-4da7-8a11-cf30cea08401",
                                "sense_id": "24c75d8e-0356-3660-87e4-69b5fc43fd31",
                                "text": "Sa main droite (...) portait la manicle de cuir comme le ceste des lutteurs."
                            }
                        ]
                    },
                    {
                        "sense_id": "5a4dbca2-1b5d-3253-a1f6-73be4125cb40",
                        "entry_id": "9a97a50a-cc9b-3e03-a9e7-8d6adb3db2a8",
                        "glosses": [
                            "Gant de cuir protégeant la main d'un cordonnier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12a50bf7-7544-4d77-9235-31683fbdf335",
                                "sense_id": "5a4dbca2-1b5d-3253-a1f6-73be4125cb40",
                                "text": "il prend sur son établi un objet de cuir qu'on appelle la « manicle » et il en arme ses mains. C'est exactement le ceste des gladiateurs romains. Quelquefois d'ailleurs le ceste s'appelait aussi « manicle ». C'est une mitaine de cuir ; elle protège la paume de la main."
                            },
                            {
                                "example_id": "2d1c8b2e-392d-495a-9d82-141ef41fb7b3",
                                "sense_id": "5a4dbca2-1b5d-3253-a1f6-73be4125cb40",
                                "text": "Les infirmiers étaient obligés de porter des manicles de cuir, comme les forgerons."
                            }
                        ]
                    }
