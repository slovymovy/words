                    {
                        "sense_id": "46da03a5-a19d-3f21-8494-fbc6884e0f87",
                        "entry_id": "4568de68-0a18-391b-a822-e8f27c326f0c",
                        "glosses": [
                            "characterized by, or conducive to poor health"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c0a38d0-8e87-4ecd-a189-a9362089cc55",
                                "sense_id": "46da03a5-a19d-3f21-8494-fbc6884e0f87",
                                "text": "The villagers lived in unhealthy surroundings."
                            },
                            {
                                "example_id": "c0d6143e-ca73-45da-b6b4-73ba78bd9c3d",
                                "sense_id": "46da03a5-a19d-3f21-8494-fbc6884e0f87",
                                "text": "It makes up an estimated 73 percent of the U.S. food supply, and contains stereotypically “unhealthy” products like sodas, candies and hot dogs as well as seemingly “healthy” ones like whole grain breads, breakfast cereals, flavored yogurts and plant milks."
                            }
                        ]
                    },
                    {
                        "sense_id": "268bb33b-49ce-3fd8-9d3a-9e1f68b1ff7b",
                        "entry_id": "4568de68-0a18-391b-a822-e8f27c326f0c",
                        "glosses": [
                            "sick or ill"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2a3a12e-6974-4bf3-93dc-3e8ccb7e6267",
                                "sense_id": "268bb33b-49ce-3fd8-9d3a-9e1f68b1ff7b",
                                "text": "He was an unhealthy child."
                            },
                            {
                                "example_id": "542cde00-95fe-40e4-9bcc-42cbdca60bef",
                                "sense_id": "268bb33b-49ce-3fd8-9d3a-9e1f68b1ff7b",
                                "text": "‘And at once he'll be on his high-horse – he knows everything! – and he'll prove, prove, that all unhealthy children must be lethal-chambered or the world will go to pieces.’"
                            }
                        ]
                    },
                    {
                        "sense_id": "b378d1f5-3f50-3d4f-918d-7603f5a73500",
                        "entry_id": "4568de68-0a18-391b-a822-e8f27c326f0c",
                        "glosses": [
                            "tending to corrupt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5f1df4b-4794-43b4-ae05-d2613709226d",
                                "sense_id": "b378d1f5-3f50-3d4f-918d-7603f5a73500",
                                "text": "He liked unhealthy reading material."
                            }
                        ]
                    },
                    {
                        "sense_id": "4cedb931-d428-3169-b1ab-dde17fb3a61a",
                        "entry_id": "4568de68-0a18-391b-a822-e8f27c326f0c",
                        "glosses": [
                            "characterized by disturbed mental health"
                        ],
                        "tags": [],
                        "examples": [
