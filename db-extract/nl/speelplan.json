                        "examples": [
                            {
                                "example_id": "bec7eff3-ebd3-4b00-a9e1-e4d974b8d076",
                                "sense_id": "dadd4e1d-12a7-357d-ab91-bc59ddd421b6",
                                "text": "De gemeente heeft een nieuw speelplan voor Het Nijrees gepresenteerd. De tieners in de wijk krijgen een speelplek aan de Wintertuin waar een trapveld moet komen, beschermd door een aarden wal. Maar nog is niet iedereen tevreden."
                            }
                        ]
                    },
                    {
                        "sense_id": "503fd467-fa6a-3ed1-9a1d-e2e0ab469e8e",
                        "entry_id": "65aab3b7-f309-3289-b676-07caef168189",
                        "glosses": [
                            "manier van spelen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a6ee73d-ecb9-4c4c-a51c-df69c3d06aec",
                                "sense_id": "503fd467-fa6a-3ed1-9a1d-e2e0ab469e8e",
                                "text": "'Het was net niet goed genoeg', zei Boeljon over haar laatste ronde. 'Ik heb gespeeld zoals ik altijd speel met hetzelfde speelplan. Ik ben tevreden over mijn spel de laatste maanden, maar mijn spel was vandaag net niet top', aldus de Nederlandse, die zich nu weer gaat richten op de toernooien op de Amerikaanse tour LPGA."
                            },
                            {
                                "example_id": "f56efa59-b0ba-450b-86eb-feda2bab2109",
                                "sense_id": "503fd467-fa6a-3ed1-9a1d-e2e0ab469e8e",
                                "text": "FC Twente gaat zondag tegen Willem II naar alle waarschijnlijkheid voortborduren op het speelplan waarmee woensdag De Graafschap met 4-2 werd verslagen."
                            }
                        ]
                    }
