                    "frequency": "Middle",
                    "semantic_group_id": "waardering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dit nieuwe voorstel <w>smaakte</w> hun totaal niet.",
                            "target_lang_translations": {
