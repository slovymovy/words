                            {
                                "example_id": "c95a584e-4645-4fcf-99d3-5c15335d2569",
                                "sense_id": "0a7d5559-9512-392e-b2aa-f2435e03c5e3",
                                "text": "„Die Suppenküche soll im Sommer wieder an den alten Standort zurückkehren.“"
                            }
