                "forms": [],
                "senses": [
                    {
                        "sense_id": "af4198b9-9923-3147-a042-84269955fc1a",
                        "entry_id": "efd0fbf5-5e8d-35f1-8b46-c5b29aff9a98",
                        "glosses": [
                            "Troisième et dernière période du Néoprotérozoïque, de -635 millions d'années à -541 millions d'années."
                        ],
                        "tags": [],
