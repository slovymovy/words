                    {
                        "sense_id": "7bddb5d7-e20c-3d96-b862-fcf55e831754",
                        "entry_id": "9c0ec634-2fd0-344e-bb72-9c3ef8b2d284",
                        "glosses": [
                            "de zesde, de zevende of de achtste maand van het jaar"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39d76010-b7ca-44a9-8af2-61e7ce942653",
                                "sense_id": "7bddb5d7-e20c-3d96-b862-fcf55e831754",
                                "text": "Juni, juli en augustus zijn zomermaanden ."
                            }
                        ]
                    },
                    {
                        "sense_id": "9557f04e-7850-380b-a226-3333c1a2c73b",
                        "entry_id": "9c0ec634-2fd0-344e-bb72-9c3ef8b2d284",
                        "glosses": [
                            "oude naam voor de zesde maand van het kalenderjaar"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "67e56777-e16a-4ef5-98bf-8802760412aa",
                        "source_entry_id": "9c0ec634-2fd0-344e-bb72-9c3ef8b2d284",
                        "source_sense_id": "7bddb5d7-e20c-3d96-b862-fcf55e831754",
                        "source_sense_description": "zomermaand",
                        "target_lang_word": "Sommermonat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sommermonat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "191abb6d-7ed9-3855-a200-4f5817f74ee4",
                                        "entry_id": "e5cfc07b-fbab-3c4d-bbac-4c7919a315d7",
                                        "glosses": [
                                            "im Sommer liegender Monat; genaue Abgrenzung unterschiedlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32e89139-59f5-45ff-99ae-a457f398e9b6",
                                                "sense_id": "191abb6d-7ed9-3855-a200-4f5817f74ee4",
                                                "text": "Besonders in den Sommermonaten ist die Ostsee ein beliebtes Urlaubsziel."
                                            },
                                            {
                                                "example_id": "57bd74cd-359c-47d4-8a8c-7af32cef792f",
                                                "sense_id": "191abb6d-7ed9-3855-a200-4f5817f74ee4",
                                                "text": "Der Juli ist im Durchschnitt der wärmste Sommermonat."
                                            },
                                            {
                                                "example_id": "fb9b25c2-d87f-4788-b4c2-ba7b18dc5991",
                                                "sense_id": "191abb6d-7ed9-3855-a200-4f5817f74ee4",
                                                "text": "„Magdeburger Stadtführer können seit diesem Jahr während der Sommermonate auf dem Domplatz eine neue Attraktion zeigen: Die Licht- und Wasserskulpturen sind seit Ende April in Betrieb.“"
                                            },
                                            {
                                                "example_id": "b69f85ac-54ef-4713-b72c-b409337d26a8",
                                                "sense_id": "191abb6d-7ed9-3855-a200-4f5817f74ee4",
                                                "text": "„In den Sommermonaten färben sie besonders den Süden violett, lassen ihn schimmern und Island blühen.“"
                                            },
                                            {
                                                "example_id": "d4a5cb3d-92f4-42dd-b328-88d6daf2c4cd",
                                                "sense_id": "191abb6d-7ed9-3855-a200-4f5817f74ee4",
                                                "text": "„Während der Sommermonate des Jahres 1948 hatte sich unsere Armee verwandelt.“"
                                            },
                                            {
                                                "example_id": "1e081734-8cf8-4404-8ed4-c2e3fa5dca40",
                                                "sense_id": "191abb6d-7ed9-3855-a200-4f5817f74ee4",
                                                "text": "„Die Auslieferung der Kalender wurde immer in die Sommermonate gelegt, da waren Semesterferien, und als Packer wurden Studenten engagiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9a999acb-6394-3163-a076-5481084c66eb",
                                        "entry_id": "e5cfc07b-fbab-3c4d-bbac-4c7919a315d7",
                                        "glosses": [
                                            "Juni"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
