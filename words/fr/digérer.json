            "pos": "verb",
            "senses": [
                {
                    "sense_id": "be833624-9fa3-3ae4-90fe-33bf3b829dbe",
                    "sense_definition": "Transformer les aliments dans l'organisme afin d'en assimiler les éléments nutritifs.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physiologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après ce repas très copieux, il a besoin d'une promenade pour bien <w>digérer</w>."
                        },
                        {
                            "text": "Mon grand-père ne <w>digère</w> plus facilement les sauces trop grasses."
                        }
                    ],
                    "common_phrases": [
                        "bien digérer",
                        "mal digérer",
                        "digérer les aliments"
                    ]
                },
                {
                    "sense_id": "011aba0f-c628-323b-8d09-a6894a4f8d20",
                    "sense_definition": "Accepter ou surmonter péniblement un événement désagréable ou une contrariété.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "émotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'équipe adverse n'a toujours pas <w>digéré</w> sa lourde défaite en finale."
                        },
                        {
                            "text": "Il lui faudra plusieurs jours pour <w>digérer</w> cette mauvaise nouvelle inattendue."
                        }
                    ],
                    "synonyms": [
                        "accepter"
                    ],
                    "common_phrases": [
                        "ne pas digérer",
                        "digérer la nouvelle",
                        "avoir du mal à digérer"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Très fréquent au figuré, souvent employé à la forme négative."
