                                        "examples": [
                                            {
                                                "example_id": "66538a82-0c5e-4cf2-8538-980daddd44b4",
                                                "sense_id": "99d27b6c-482b-31e1-b07e-6e6179670493",
                                                "text": "Vous savez bien qu’il ne rentrera pas, puisque c’est le jour de paye."
                                            },
                                            {
                                                "example_id": "07388aa8-3266-4c71-8444-e26b32d0beeb",
                                                "sense_id": "99d27b6c-482b-31e1-b07e-6e6179670493",
                                                "text": "Le choix presque général du jour de paye le samedi est encore pour l’ouvrier une cause d’inconduite car s’il possède un peu d’argent il cède inévitablement aux occasions de plaisir que lui présente le dimanche."
                                            }
