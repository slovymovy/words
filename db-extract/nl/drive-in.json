                    },
                    {
                        "translation_id": "f885d4d6-ba63-4c22-80ec-5635171b0d8c",
                        "source_entry_id": "91ad03ad-aede-3485-81e7-af6663f01bf1",
                        "source_sense_id": "1862c4b7-b79e-340c-afe8-c793d8013898",
