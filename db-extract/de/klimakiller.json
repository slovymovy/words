                "senses": [
                    {
                        "sense_id": "56739186-853e-3819-97f6-2b0dac318ccd",
                        "entry_id": "a92c6ff5-c509-3df0-a1c4-7ad78cf7cd1b",
                        "glosses": [
                            "eine chemische Verbindung (Molekül), die negative Wirkung auf das Klima hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff5fa2b6-b82e-4adc-b8fb-133ac236b003",
                                "sense_id": "56739186-853e-3819-97f6-2b0dac318ccd",
                                "text": "CO₂ und Methan sind typische Klimakiller."
                            },
                            {
                                "example_id": "aebe6245-594c-484f-b0c6-c65eff17fdff",
                                "sense_id": "56739186-853e-3819-97f6-2b0dac318ccd",
                                "text": "„Doch so gefährlich Methan auch als Klimakiller ist, als Hauptbestandteil von Erdgas und Biogas spielt es eine wichtige Rolle im täglichen Energiebedarf.“"
                            },
                            {
                                "example_id": "91f344d2-c8ae-4574-aca7-5a154388dbbd",
                                "sense_id": "56739186-853e-3819-97f6-2b0dac318ccd",
                                "text": "„Das Herstellen wie auch das Schreddern von Beton verbraucht enorm viel Energie und gilt deshalb als Klimakiller.“"
                            },
                            {
                                "example_id": "8696afce-ffad-4a9b-ae5a-e93f4b827db1",
                                "sense_id": "56739186-853e-3819-97f6-2b0dac318ccd",
                                "text": "„Die Zementproduktion ist ein Klimakiller.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7014a2d4-55eb-3e3e-8c7e-7c4addf61f6e",
                        "entry_id": "a92c6ff5-c509-3df0-a1c4-7ad78cf7cd1b",
                        "glosses": [
                            "etwas, das die Produktion von [1] fördert"
                        ],
