                                                "sense_id": "af31fb50-8e61-34e2-8d42-c7f6391e3c4d",
                                                "text": "Amper i miliamper mają ten sam wymiar"
                                            },
                                            {
                                                "example_id": "b025e61c-bd60-4401-823f-692730388aed",
                                                "sense_id": "af31fb50-8e61-34e2-8d42-c7f6391e3c4d",
                                                "text": "Wielkości o tym samym wymiarze można dodawać."
                                            }
