            "senses": [
                {
                    "sense_id": "f3b21b0c-77d6-35c5-b986-5e6c0a414cfd",
                    "sense_definition": "Een gemeenschappelijk gebied, overeenkomst of punt van overeenstemming tussen verschillende zaken of personen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "overeenkomst",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hoewel ze uit verschillende culturen komen, vonden ze snel een <w>raakvlak</w> in hun liefde voor muziek.",
                            "target_lang_translations": {
                                "en": "Although they come from different cultures, they quickly found <w>common ground</w> in their love for music."
                            }
                        },
                        {
                            "text": "Er is weinig <w>raakvlak</w> tussen deze twee politieke partijen.",
                            "target_lang_translations": {
                                "en": "There is little <w>overlap</w> between these two political parties."
                            }
                        }
                    ],
                    "synonyms": [
                        "overeenkomst",
                        "raakpunt",
                        "overlapping"
                    ],
                    "antonyms": [
                        "verschil"
                    ],
                    "common_phrases": [
                        "weinig raakvlak",
                        "gemeenschappelijk raakvlak"
                    ],
                    "target_lang_definitions": {
                        "en": "A common ground, point of agreement, or area of overlap between different things or people."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "common ground",
                                "target_lang_sense_clarification": "shared interests, beliefs, or ideas"
                            },
                            {
                                "target_lang_word": "overlap",
                                "target_lang_sense_clarification": "shared area of interest or responsibility"
                            },
                            {
                                "target_lang_word": "point of contact",
                                "target_lang_sense_clarification": "a connection or meeting point between different subjects"
                            },
                            {
                                "target_lang_word": "interface",
                                "target_lang_sense_clarification": "a point where two systems or subjects meet and interact"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2f65eb44-7e53-3134-9b0e-242e501ceaf7",
                    "sense_definition": "Het platte vlak dat een gekromd oppervlak in één enkel punt of langs een lijn raakt.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "meetkunde",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de wiskundeles moesten we de vergelijking van het <w>raakvlak</w> aan een bol berekenen.",
                            "target_lang_translations": {
                                "en": "In math class, we had to calculate the equation of the <w>tangent plane</w> to a sphere."
                            }
                        },
                        {
                            "text": "Het <w>raakvlak</w> staat loodrecht op de straal van de cirkel in het raakpunt.",
                            "target_lang_translations": {
                                "en": "The <w>tangent plane</w> is perpendicular to the radius of the circle at the point of tangency."
                            }
                        }
                    ],
                    "common_phrases": [
                        "vergelijking van het raakvlak"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "mathematical terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The flat plane that touches a curved surface at a single point or along a line."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tangent plane",
                                "target_lang_sense_clarification": "geometry"
                            }
                        ]
                    }
                }
            ]
