                                        "glosses": [
                                            "A woman's close-fitting bodice, underbodice, or corset having such a feature."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "838eafc4-279c-4118-8cf0-646a86a95c1f",
                                                "sense_id": "c7bd5119-12ae-31ce-b55d-becb074e9bb9",
                                                "text": "Will she be able to pull off the double act? Can she play the cosy tradwife and still be the sexpot in a basque?"
                                            }
