{
    "word_family": [
        "gâchis",
        "gâterie",
        "gâteux",
        "gâtisme",
        "gâte-sauce"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4ee51dee-f8b7-30a2-b945-1ef9f87c2868",
                    "sense_definition": "Combler quelqu'un de cadeaux, de douceurs ou d'attentions bienveillantes.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "bienveillance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour son anniversaire, ses grands-parents aiment toujours le <w>gâter</w> avec de nombreux présents."
                        },
                        {
                            "text": "Nous avons décidé de <w>gâter</w> notre ami en lui préparant un délicieux dîner ce soir."
                        }
                    ],
                    "synonyms": [
                        "choyer",
                        "dorloter"
                    ],
                    "antonyms": [
                        "négliger",
                        "priver"
                    ],
                    "common_phrases": [
                        "gâter les enfants",
                        "se faire gâter"
                    ]
                },
                {
                    "sense_id": "14fe0de0-b687-3ce9-a4de-820ac5fd9da5",
                    "sense_definition": "Faire preuve de trop d'indulgence envers quelqu'un, particulièrement un enfant, au risque de développer ses caprices ou ses défauts.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "education",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Si tu cèdes à toutes ses colères, tu vas finir par <w>gâter</w> ce jeune garçon."
                        },
                        {
                            "text": "Ces parents <w>gâtent</w> tellement leur fille qu'elle refuse désormais d'entendre le moindre refus."
                        }
                    ],
                    "synonyms": [
                        "pourrir"
                    ],
                    "antonyms": [
                        "sévir"
                    ],
                    "common_phrases": [
                        "gâter un enfant",
                        "enfant gâté"
                    ]
                },
                {
                    "sense_id": "5ef4efe1-0a82-3ca0-9ea7-583b9aa986e4",
                    "sense_definition": "Détériorer, abîmer l'état matériel d'une chose ou compromettre un moment agréable.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "deterioration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une averse soudaine est venue <w>gâter</w> notre après-midi de pique-nique dans la forêt."
                        },
                        {
                            "text": "Le violent orage a <w>gâté</w> les récoltes de blé dans toute la vallée."
                        }
                    ],
                    "synonyms": [
                        "abîmer",
                        "endommager",
                        "gâcher",
                        "ruiner"
                    ],
                    "antonyms": [
                        "améliorer",
                        "arranger",
                        "réparer"
                    ],
                    "common_phrases": [
                        "gâter le plaisir",
                        "gâter la fête"
                    ]
                },
                {
                    "sense_id": "7bc6e354-a638-3d42-81d8-e37da9e2ecc4",
                    "sense_definition": "En parlant d'un aliment ou d'un produit périssable, s'altérer, s'avarier ou devenir impropre à la consommation.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "avariement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ne laisse pas cette crème sur la table car elle va vite se <w>gâter</w>."
                        },
                        {
                            "text": "La viande se <w>gâte</w> facilement si elle n'est pas immédiatement conservée au frais."
                        }
                    ],
                    "synonyms": [
                        "pourrir",
                        "s'avarier",
                        "tourner"
                    ],
                    "antonyms": [
                        "se conserver"
                    ],
                    "common_phrases": [
                        "se gâter au soleil",
                        "commencer à se gâter"
                    ]
                },
                {
                    "sense_id": "44f32529-8d7e-3d97-aaba-2d55c471136b",
                    "sense_definition": "En parlant du temps ou du climat, devenir mauvais, nuageux ou orageux.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "meteo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Regarde ces nuages sombres au loin, le temps commence à se <w>gâter</w> sérieusement."
                        },
                        {
                            "text": "Les randonneurs ont préféré rentrer au chalet avant que le ciel ne se <w>gâte</w> totalement."
                        }
                    ],
                    "synonyms": [
                        "se dégrader"
                    ],
                    "antonyms": [
                        "s'apaiser",
                        "s'éclaircir"
                    ],
                    "common_phrases": [
                        "le temps se gâte"
                    ]
                },
                {
                    "sense_id": "b5b40df0-042d-3e6c-85cd-5617a77cb845",
                    "sense_definition": "En parlant d'une situation, d'un différend ou d'une ambiance, empirer ou prendre une mauvaise tournure.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "situation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dès qu'ils ont abordé les questions d'argent, l'ambiance a commencé à se <w>gâter</w>."
                        },
                        {
                            "text": "Les affaires se <w>gâtent</w> pour cette entreprise qui accumule d'importantes dettes financières."
                        }
                    ],
                    "synonyms": [
                        "dégénérer",
                        "empirer",
                        "s'envenimer"
                    ],
                    "antonyms": [
                        "s'apaiser",
                        "s'arranger"
                    ],
                    "common_phrases": [
                        "les choses se gâtent",
                        "l'ambiance se gâte"
                    ]
                }
            ]
        }
    ]
}