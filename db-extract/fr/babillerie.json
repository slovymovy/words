                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e1fd83e-eead-49e3-80b9-0eec8104bd91",
                                "sense_id": "4edbfdcf-9954-344e-9cdc-c3e3f4a47b2d",
                                "text": "Ce sont ordinairement des amitiés des jeunes gens qui se tiennent aux moustaches, aux cheveux, aux oeillades, aux habits, à la morgue, à la babillerie."
                            },
                            {
                                "example_id": "f4241133-705d-4493-8803-704165ec4c70",
                                "sense_id": "4edbfdcf-9954-344e-9cdc-c3e3f4a47b2d",
                                "text": "La babillerie d’Aline lui était importune et il eût aimé qu’elle enrubannât de quelques vives métaphores ces charités d’arrière-cuisine."
                            },
                            {
                                "example_id": "458df918-93db-4470-9026-5ebbd7a5ecd0",
                                "sense_id": "4edbfdcf-9954-344e-9cdc-c3e3f4a47b2d",
                                "text": "C’était une babillerie perpétuelle dans les rues; rien que le dit du mercier contenait deux cents rimes pour crier sa marchandise."
                            }
                        ]
                    }
