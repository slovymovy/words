                "senses": [
                    {
                        "sense_id": "978137dc-56a6-377e-96d0-9f19878e2792",
                        "entry_id": "863fad80-e220-38ee-a551-ba88a85e61ed",
                        "glosses": [
                            "A Scotsman."
                        ],
                        "tags": [
                            "archaic",
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "671c5e4a-50d4-40e8-9921-93e4d9360aec",
                                "sense_id": "978137dc-56a6-377e-96d0-9f19878e2792",
                                "text": "“They can live upon barley-meal without a morsel of meat from week-end to week-end, can these miserable Sawnies,” quoth another."
                            },
                            {
                                "example_id": "9ffd50e2-1a1c-4e3a-b228-1eb79aea5e75",
                                "sense_id": "978137dc-56a6-377e-96d0-9f19878e2792",
                                "text": "He took the gibe and scowled at me--he spoke always like a Sawney, and could never pass for English; but in his pleasure at the discovery he had made he let the word pass."
                            }
                        ]
                    }
                ],
