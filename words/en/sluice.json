{
    "word_family": [
        "sluice-gate",
        "sluicing"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "be3957c0-d739-38a3-b476-31ff298fd191",
                    "sense_definition": "An artificial channel or sliding gate for controlling the flow of water.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "water_control",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engineer opened the <w>sluice</w> to let excess water out of the canal.",
                            "target_lang_translations": {
                                "de": "Der Ingenieur öffnete die <w>Schleuse</w>, um überschüssiges Wasser aus dem Kanal abzulassen."
                            }
                        },
                        {
                            "text": "Workers cleared debris near the <w>sluice</w> gate to ensure a smooth flow.",
                            "target_lang_translations": {
                                "de": "Arbeiter beseitigten Trümmer in der Nähe des <w>Schleusentors</w>, um einen reibungslosen Fluss zu gewährleisten."
                            }
                        }
                    ],
                    "synonyms": [
                        "floodgate",
                        "water gate"
                    ],
                    "common_phrases": [
                        "open the sluice",
                        "canal sluice",
                        "sluice gate"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein künstlicher Kanal oder Schieber zur Regulierung des Wasserflusses."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Schleuse",
                                "target_lang_sense_clarification": "Wasserregulierung oder Schifffahrt"
                            },
                            {
                                "target_lang_word": "Schleusentor",
                                "target_lang_sense_clarification": "Absperrung einer Schleuse"
                            },
                            {
                                "target_lang_word": "Siel",
                                "target_lang_sense_clarification": "Deichschleuse zur Entwässerung"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3addedc3-9c07-315a-92e0-8b983f425492",
                    "sense_definition": "A long sloping trough with water running through it, used to wash gold-bearing earth.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "mining",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Miners poured gravel into the <w>sluice</w> to separate the gold dust.",
                            "target_lang_translations": {
                                "de": "Bergleute schütteten Kies in die <w>Waschrinne</w>, um den Goldstaub zu trennen."
                            }
                        },
                        {
                            "text": "They built a long wooden <w>sluice</w> box beside the mountain river.",
                            "target_lang_translations": {
                                "de": "Sie bauten eine lange hölzerne <w>Goldwaschrinne</w> neben dem Bergfluss."
                            }
                        }
                    ],
                    "synonyms": [
                        "sluice box"
                    ],
                    "common_phrases": [
                        "wooden sluice",
                        "mining sluice"
                    ],
                    "target_lang_definitions": {
                        "de": "Rinne mit fließendem Wasser zum Auswaschen von goldhaltiger Erde im Bergbau."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Waschrinne",
                                "target_lang_sense_clarification": "im Goldbergbau"
                            },
                            {
                                "target_lang_word": "Goldwaschrinne",
                                "target_lang_sense_clarification": "speziell für Gold"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2d5d1163-696e-3cb7-a8ab-d83732be9703",
                    "sense_definition": "An instance of eliding the complement of a wh-phrase in linguistics.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sentence contains a <w>sluice</w> where the clause following 'someone' is omitted.",
                            "target_lang_translations": {
                                "de": "Der Satz enthält ein <w>Sluicing</w>, bei dem der Teilsatz nach 'jemand' ausgelassen wird."
                            }
                        },
                        {
                            "text": "Linguists analyze how a <w>sluice</w> is interpreted in natural conversation.",
                            "target_lang_translations": {
                                "de": "Linguisten analysieren, wie ein <w>Sluicing</w> in der natürlichen Konversation interpretiert wird."
                            }
                        }
                    ],
                    "synonyms": [
                        "sluicing"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical linguistic term"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Linguistisches Phänomen, bei dem die Ergänzung eines W-Wortes ausgelassen wird."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Sluicing",
                                "target_lang_sense_clarification": "linguistischer Fachbegriff"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d5a62375-0522-32fe-8120-26761b6de11f",
                    "sense_definition": "To wash, rinse, or flush with a heavy stream of water.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "washing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The workers used a heavy hose to <w>sluice</w> down the outdoor deck.",
                            "target_lang_translations": {
                                "de": "Die Arbeiter benutzten einen dicken Schlauch, um die Terrasse <w>abzuspritzen</w>."
                            }
                        },
                        {
                            "text": "She had to <w>sluice</w> the mud off her boots before entering the house.",
                            "target_lang_translations": {
                                "de": "Sie musste den Schlamm von ihren Stiefeln <w>abspülen</w>, bevor sie das Haus betrat."
                            }
                        }
                    ],
                    "synonyms": [
                        "flush",
                        "rinse",
                        "wash"
                    ],
                    "common_phrases": [
                        "sluice down",
                        "sluice out"
                    ],
                    "target_lang_definitions": {
                        "de": "Mit einem starken Wasserstrahl waschen, spülen oder abspülen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "abspülen",
                                "target_lang_sense_clarification": "mit viel Wasser reinigen"
                            },
                            {
                                "target_lang_word": "durchspülen",
                                "target_lang_sense_clarification": "kräftig spülen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f200feca-9901-3f44-bd68-f083657aba0b",
                    "sense_definition": "To pour, flow, or rush out in large quantities.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "flowing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Heavy rainwater began to <w>sluice</w> down the sides of the mountain.",
                            "target_lang_translations": {
                                "de": "Starker Regen begann die Berghänge hinabzu<w>strömen</w>."
                            }
                        },
                        {
                            "text": "Water started to <w>sluice</w> over the top of the barrier during the storm.",
                            "target_lang_translations": {
                                "de": "Während des Sturms begann Wasser über die Oberkante der Barriere zu <w>stürzen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "pour",
                        "gush",
                        "stream"
                    ],
                    "common_phrases": [
                        "sluice down",
                        "sluice over"
                    ],
                    "target_lang_definitions": {
                        "de": "In großen Mengen gießen, fließen oder strömen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "strömen",
                                "target_lang_sense_clarification": "in großen Mengen fließen"
                            },
                            {
                                "target_lang_word": "stürzen",
                                "target_lang_sense_clarification": "heftig fließen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "297842be-6b72-3049-9f94-f1da87806774",
                    "sense_definition": "To process earth or gravel in a sluice box to extract gold or minerals.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "mining",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Prospectors spent all afternoon trying to <w>sluice</w> gold from the stream gravel.",
                            "target_lang_translations": {
                                "de": "Goldsucher verbrachten den ganzen Nachmittag damit, zu versuchen, Gold aus dem Bachkies zu <w>waschen</w>."
                            }
                        },
                        {
                            "text": "They hope to <w>sluice</w> enough ore to make the venture profitable.",
                            "target_lang_translations": {
                                "de": "Sie hoffen, genug Erz durch <w>Auswaschen</w> zu gewinnen, damit sich das Unternehmen lohnt."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sluice for gold"
                    ],
                    "target_lang_definitions": {
                        "de": "Erde oder Kies in einer Waschrinne verarbeiten, um Gold oder Mineralien zu gewinnen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Gold waschen",
                                "target_lang_sense_clarification": "mit der Waschrinne Gold gewinnen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}