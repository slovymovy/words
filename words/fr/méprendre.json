    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "88f496e2-a3cb-3d19-a167-a351acc504cc",
                    "sense_definition": "Se tromper en portant un jugement, ou prendre une personne ou une chose pour une autre.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il ne faut pas se <w>méprendre</w> sur les intentions réelles de notre nouvel interlocuteur."
                        },
                        {
                            "text": "Elle craint de se <w>méprendre</w> en interprétant le silence de ses collègues comme un refus."
                        }
                    ],
                    "synonyms": [
                        "se tromper"
                    ],
                    "common_phrases": [
                        "se méprendre sur",
                        "à ne pas s'y méprendre"
                    ]
                },
                {
                    "sense_id": "97f9cb83-c37e-33d4-b94c-c246f99f840c",
                    "sense_definition": "Signifier à une personne qu'elle dépasse les limites permises ou qu'elle manque de respect.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gardez un ton courtois avec moi car vous vous <w>méprenez</w> sur la personne à qui vous parlez."
                        },
                        {
                            "text": "Le directeur lui a rappelé sèchement qu'il se <w>méprenait</w> s'il pensait pouvoir contester cette décision."
                        }
                    ],
                    "common_phrases": [
                        "vous vous méprenez"
                    ]
                }
            ]
        }
    ]
