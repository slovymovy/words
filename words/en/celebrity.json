{
    "word_family": [
        "celebrate",
        "celebration",
        "celebrated",
        "celebratory",
        "celebrant"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d096ec7c-32ea-3c26-884b-46095096c3bd",
                    "sense_definition": "A famous person who is widely recognized by the general public for their success or accomplishments.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The actor became a huge <w>celebrity</w> after his first major movie.",
                            "target_lang_translations": {
                                "ru": "После своего первого крупного фильма актер стал настоящей <w>знаменитостью</w>.",
                                "zh": "那位演员在出演第一部大片后，成了一位大<w>名人</w>。"
                            }
                        },
                        {
                            "text": "She enjoys being a <w>celebrity</w> and signing autographs for her fans.",
                            "target_lang_translations": {
                                "ru": "Ей нравится быть <w>знаменитостью</w> и раздавать автографы своим поклонникам.",
                                "zh": "她很享受作为<w>名人</w>的生活，并乐于为粉丝签名。"
                            }
                        }
                    ],
                    "synonyms": [
                        "star",
                        "big name",
                        "celeb",
                        "luminary",
                        "notable",
                        "media darling",
                        "famous person"
                    ],
                    "antonyms": [
                        "nobody"
                    ],
                    "common_phrases": [
                        "internet celebrity",
                        "local celebrity",
                        "celebrity culture",
                        "celebrity status"
                    ],
                    "target_lang_definitions": {
                        "ru": "Знаменитый человек, широко известный публике благодаря своему успеху или достижениям.",
                        "zh": "因成功或成就而广为人知的著名人物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "знаменитость",
                                "target_lang_sense_clarification": "известная личность"
                            },
                            {
                                "target_lang_word": "звезда",
                                "target_lang_sense_clarification": "популярный артист"
                            },
                            {
                                "target_lang_word": "селебрити",
                                "target_lang_sense_clarification": "медийная персона"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "名人",
                                "target_lang_sense_clarification": "广为人知的人"
                            },
                            {
                                "target_lang_word": "明星",
                                "target_lang_sense_clarification": "演艺界或体育界的著名人物"
                            },
                            {
                                "target_lang_word": "名流",
                                "target_lang_sense_clarification": "社会地位高且出名的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0b2267d7-43af-3682-86d5-20f58d807225",
                    "sense_definition": "The state of being famous or widely known; fame.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His sudden <w>celebrity</w> made it difficult for him to go out in public unnoticed.",
                            "target_lang_translations": {
                                "ru": "Его внезапная <w>известность</w> мешала ему появляться на людях незамеченным.",
                                "zh": "他突然获得的<w>知名度</w>使他很难在公共场合不被认出来。"
                            }
                        },
                        {
                            "text": "The young writer achieved <w>celebrity</w> with the publication of her memoir.",
                            "target_lang_translations": {
                                "ru": "Молодая писательница обрела <w>известность</w> после публикации своих мемуаров.",
                                "zh": "这位年轻作家在出版回忆录后获得了<w>名声</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fame",
                        "renown",
                        "distinction",
                        "eminence"
                    ],
                    "antonyms": [
                        "obscurity",
                        "anonymity"
                    ],
                    "common_phrases": [
                        "achieve celebrity",
                        "rise to celebrity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние известности или широкой популярности; слава.",
                        "zh": "出名或广为人知的状态；名声。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "известность",
                                "target_lang_sense_clarification": "популярность"
                            },
                            {
                                "target_lang_word": "слава",
                                "target_lang_sense_clarification": "общее признание"
                            },
                            {
                                "target_lang_word": "знаменитость",
                                "target_lang_sense_clarification": "состояние прославленности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "知名度",
                                "target_lang_sense_clarification": "被大众了解的程度"
                            },
                            {
                                "target_lang_word": "名声",
                                "target_lang_sense_clarification": "社会上的声望"
                            },
                            {
                                "target_lang_word": "声望",
                                "target_lang_sense_clarification": "名誉和威望"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "285a8f64-55ed-32f2-8084-5017b9e7ffa9",
                    "sense_definition": "A formal rite or ceremony.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient <w>celebrity</w> was performed with great solemnity by the priests.",
                            "target_lang_translations": {
                                "ru": "Древняя <w>церемония</w> была проведена жрецами с большой торжественностью.",
                                "zh": "祭司们以极其庄严的方式举行了那场古老的<w>仪式</w>。"
                            }
                        },
                        {
                            "text": "They observed the religious <w>celebrity</w> according to strict tradition.",
                            "target_lang_translations": {
                                "ru": "Они соблюдали религиозное <w>торжество</w> в соответствии со строгой традицией.",
                                "zh": "他们按照严格的传统遵守了那项宗教<w>典礼</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historic usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Торжественный обряд или церемония.",
                        "zh": "正式的仪式或典礼。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "торжество",
                                "target_lang_sense_clarification": "торжественный обряд, церемония"
                            },
                            {
                                "target_lang_word": "церемония"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "仪式",
                                "target_lang_sense_clarification": "正式的礼仪"
                            },
                            {
                                "target_lang_word": "典礼",
                                "target_lang_sense_clarification": "隆重的仪式"
                            }
                        ]
                    }
                }
            ]
        }
    ]
