                "senses": [
                    {
                        "sense_id": "c39ceed5-62e2-3dff-bc72-521fdc985b73",
                        "entry_id": "72c5a11c-c696-3cf5-bb49-32bbf462b924",
                        "glosses": [
                            "Kenntnisse oder Fertigkeiten, die man für eine Arbeit braucht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b172a6fc-2104-438c-85fe-fd656b241e5a",
                                "sense_id": "c39ceed5-62e2-3dff-bc72-521fdc985b73",
                                "text": "Das Rüstzeug für ein erfolgreiches Studium erlangen."
                            },
                            {
                                "example_id": "fd1f96d0-d53b-48a2-b567-eeabb47bed3c",
                                "sense_id": "c39ceed5-62e2-3dff-bc72-521fdc985b73",
                                "text": "„Das Rüstzeug für seine verfassungsrechtlichen Konzepte holte er sich beim Jurastudium in Wien.“"
                            },
                            {
                                "example_id": "d4088359-89b1-4dc8-8cc0-91a47e8b1a1d",
                                "sense_id": "c39ceed5-62e2-3dff-bc72-521fdc985b73",
                                "text": "„Die ernüchtende Besichtigung des Fundaments der Wissenschaft kommt erst, wenn wir das notwendige Rüstzeug und den erforderlichen Mut beisammen haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "fd5744a0-7e27-3175-ac64-be61062da31d",
                        "entry_id": "72c5a11c-c696-3cf5-bb49-32bbf462b924",
                        "glosses": [
                            "Werkzeuge, die man für eine Arbeit braucht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7dcd05d-394f-4500-9fc3-ad4f38b8c50a",
                                "sense_id": "fd5744a0-7e27-3175-ac64-be61062da31d",
                                "text": "Er hat nicht das richtige Rüstzeug für die auszuführenden Arbeiten dabei."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fc0e4caf-c4a2-4981-822e-b8f8c276ba9d",
                        "source_entry_id": "72c5a11c-c696-3cf5-bb49-32bbf462b924",
                        "source_sense_id": "c39ceed5-62e2-3dff-bc72-521fdc985b73",
                        "source_sense_description": "Kenntnisse oder Fertigkeiten, die man für eine Arbeit braucht",
                        "target_lang_word": "know-how",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "know-how",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ab414e38-1311-387a-b67f-dc5124cacc0f",
                                        "entry_id": "5460d9d1-fbbc-3e37-b89f-a3e71b6b1ff1",
                                        "glosses": [
                                            "The knowledge and skill to be able to (do something correctly)."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2448b225-e70b-4c58-aaff-c02f9d6c5c1e",
                                                "sense_id": "ab414e38-1311-387a-b67f-dc5124cacc0f",
                                                "text": "Marlo has the know-how to fix your computer."
                                            },
                                            {
                                                "example_id": "ba1bfe9b-a482-4ec0-a722-dd72b5d5ab1f",
                                                "sense_id": "ab414e38-1311-387a-b67f-dc5124cacc0f",
                                                "text": "American innovators — with their world-class strengths in product design, marketing and finance — may have a historic opportunity to convert the scientific know-how from abroad into market gains and profits. Mr. Hill views the transition to “the postscientific society” as an unrecognized bonus for American creators of new products and services."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a5b80326-da29-40d2-94cd-912f73ae1405",
                        "source_entry_id": "72c5a11c-c696-3cf5-bb49-32bbf462b924",
                        "source_sense_id": "c39ceed5-62e2-3dff-bc72-521fdc985b73",
                        "source_sense_description": "Kenntnisse oder Fertigkeiten, die man für eine Arbeit braucht",
                        "target_lang_word": "connaissances",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "connaissances",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "06953d61-7b11-36cd-9df6-30c10fa1c229",
                                        "entry_id": "6e54a1ce-3998-3452-b5f0-e1e2fa087f2a",
                                        "glosses": [
                                            "Pluriel de connaissance."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "150f83cc-0bca-461d-b2a0-890856a15e10",
                                                "sense_id": "06953d61-7b11-36cd-9df6-30c10fa1c229",
                                                "text": "Nous avons donc besoin de disposer de l’arbre entier des connaissances, où les liaisons verticales fournissent précisément les articulations nécessaires, et permettent finalement de resensorialiser les concepts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3f06192b-d271-4cd5-b6a7-1cef07d63d40",
                        "source_entry_id": "72c5a11c-c696-3cf5-bb49-32bbf462b924",
                        "source_sense_id": "fd5744a0-7e27-3175-ac64-be61062da31d",
                        "source_sense_description": "Werkzeuge, die man für eine Arbeit braucht",
                        "target_lang_word": "equipment",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "equipment",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d9b72a87-943e-3e65-b24b-a1b2749a0e76",
                                        "entry_id": "a50588fd-fc67-324d-a4e8-9573e15cba0a",
                                        "glosses": [
                                            "The act of equipping, or the state of being equipped, as for a voyage or expedition."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4bc28791-9dce-4934-a86e-1d48bb263b60",
                                                "sense_id": "d9b72a87-943e-3e65-b24b-a1b2749a0e76",
                                                "text": "The equipment of the fleet was therefore hastened by de Witt ; in hopes that , by striking at first a successful blow , he might inspire courage into the dismayed States"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1aec590-907e-31d0-a77f-d3253462e442",
                                        "entry_id": "a50588fd-fc67-324d-a4e8-9573e15cba0a",
                                        "glosses": [
                                            "Any items used in equipping something or someone, for example things needed for an expedition or voyage."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a95e163-8cc9-4283-a135-9f12d3b13ef2",
                                                "sense_id": "d1aec590-907e-31d0-a77f-d3253462e442",
                                                "text": "We need more gardening equipment if we want to properly landscape our yard, not just a rake and some gloves."
                                            },
                                            {
                                                "example_id": "72d04ec0-c08a-47f7-9713-c6b2ee67bf2a",
                                                "sense_id": "d1aec590-907e-31d0-a77f-d3253462e442",
                                                "text": "The sports shop sells different kits of famous clubs, and equipment from all kind of sports."
                                            },
                                            {
                                                "example_id": "124b0ea7-6398-4553-8d53-ddb688c00592",
                                                "sense_id": "d1aec590-907e-31d0-a77f-d3253462e442",
                                                "text": "Tompkins is considered a hero in the deep ecology movement and works hand in hand with his wife Kris, the former CEO of the outdoor clothing and equipment company Patagonia."
                                            },
                                            {
                                                "example_id": "ef7a840c-130a-43de-b4f9-c5f966a6f1c6",
                                                "sense_id": "d1aec590-907e-31d0-a77f-d3253462e442",
                                                "text": "Armed and dight, In the equipments of a knight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d3e1b7c-1187-38ff-8e1a-efd3cf00bddf",
                                        "entry_id": "a50588fd-fc67-324d-a4e8-9573e15cba0a",
                                        "glosses": [
                                            "The male genitalia."
                                        ],
                                        "tags": [
                                            "humorous",
                                            "slang",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46ce009d-1f83-49df-92b0-0c7b08d28902",
                                                "sense_id": "2d3e1b7c-1187-38ff-8e1a-efd3cf00bddf",
                                                "text": "The segment advises the reader matter-of-factly that “the penis [of a whale] should be tucked inside the body and when needed enlarged into an erection”. At the very least, the statement sounds odd. At most, it could make human penis owners consider that their equipment might not represent the highest evolutionary ideal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "95f2b4b3-479e-4837-b847-f2d5a6fec776",
                        "source_entry_id": "72c5a11c-c696-3cf5-bb49-32bbf462b924",
                        "source_sense_id": "fd5744a0-7e27-3175-ac64-be61062da31d",
                        "source_sense_description": "Werkzeuge, die man für eine Arbeit braucht",
                        "target_lang_word": "outillage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "outillage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8d734b57-da02-3346-90e5-15d258e8fa5c",
                                        "entry_id": "9b225e8d-63f3-3f37-a425-ec2f90670090",
                                        "glosses": [
                                            "Ensemble des outils qui servent pour l’usage d’une machine, pour une exploitation industrielle, agricole, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9e0ece1-1ef9-4083-8a0c-abca8b8c887d",
                                                "sense_id": "8d734b57-da02-3346-90e5-15d258e8fa5c",
                                                "text": "Maintenant, l’usine fabriquait surtout des bicyclettes. Lorsque Grandidier, qui sortait de l’École des arts et métiers, de Châlons, l’avait prise, elle périclitait, mal gérée, s’attardant à la fabrication des petits moteurs, à l’aide d’un outillage vieilli."
                                            },
                                            {
                                                "example_id": "a807d9b6-0a31-4286-bbd9-fb2f837a047c",
                                                "sense_id": "8d734b57-da02-3346-90e5-15d258e8fa5c",
                                                "text": "Elle estime, comme G. de Molinari, que le progrès moral du prolétariat est aussi nécessaire que le progrès matériel de l’outillage, pour porter l'industrie moderne au niveau toujours plus élevé que la science technologique permet d'atteindre."
                                            },
                                            {
                                                "example_id": "2c96a633-e90a-429d-b470-7cfb294a8d16",
                                                "sense_id": "8d734b57-da02-3346-90e5-15d258e8fa5c",
                                                "text": "Les grands propriétaires ont, naturellement, été les premiers à se servir d'un outillage perfectionné : cela leur a permis de produire et, par cela aussi, de vendre meilleur marché."
                                            },
                                            {
                                                "example_id": "cd287141-06d7-4646-bb5e-af6aeafc3f2a",
                                                "sense_id": "8d734b57-da02-3346-90e5-15d258e8fa5c",
                                                "text": "Il y a très peu d'années encore, la faux, la faucille, la binette et la houe constituaient l'essentiel de l’outillage du paysan, qui possédait également et généralement une sulfateuse à main pour traiter sa vigne en limite de parcelles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6c7c5bbe-dfe9-4cbd-8ebd-9147b518cb3f",
