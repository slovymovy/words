                                    {
                                        "sense_id": "5616d673-0038-313f-8c5a-9c522dedc51b",
                                        "entry_id": "25124cb6-f563-306e-a219-3ab3f0981572",
                                        "glosses": [
                                            "Plante vivace à fleurs blanches printanières, commune dans les sous-bois et prairies humides de l’hémisphère nord."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3eae6a22-d381-474a-8953-daee3dfb4a72",
                                                "sense_id": "5616d673-0038-313f-8c5a-9c522dedc51b",
                                                "text": "Sous les taillis de Charmes ou de Châtaigniers ou encore sous les belles futaies de Chênes ou de Hêtres, l’Anémone Sylvie donne au printemps de magnifiques tapis neigeux."
                                            },
                                            {
                                                "example_id": "eeb43a68-4bb0-494d-8276-ead412189e72",
                                                "sense_id": "5616d673-0038-313f-8c5a-9c522dedc51b",
                                                "text": "L’anémone sylvie (Anemone nemorosa, Renonculacées) fait partie de ces plantes vernales des sous-bois qui fleurissent au premier printemps, avant que les feuilles ne poussent sur les arbres et n’obscurcissent fortement le couvert."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
