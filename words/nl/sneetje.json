                    "sense_id": "6c2118d5-d3d3-3026-a326-7f98949fe333",
                    "sense_definition": "Een dunne afgesneden plak, meestal van brood.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "voedsel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wil je één <w>sneetje</w> of twee?",
                            "target_lang_translations": {
                                "it": "Vuoi una <w>fetta</w> o due?"
                            }
                        },
                        {
                            "text": "Ik eet elke ochtend een <w>sneetje</w> bruin brood met kaas.",
                            "target_lang_translations": {
                                "it": "Ogni mattina mangio una <w>fetta</w> di pane integrale con il formaggio."
                            }
                        }
                    ],
                    "synonyms": [
                        "plak"
                    ],
                    "common_phrases": [
                        "sneetje brood"
                    ],
                    "target_lang_definitions": {
                        "it": "Una fetta sottile tagliata, solitamente di pane."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "fetta",
                                "target_lang_sense_clarification": "termine generico per una porzione tagliata di cibo"
                            },
                            {
                                "target_lang_word": "fettina",
                                "target_lang_sense_clarification": "diminutivo, spesso usato per indicare una fetta piccola o sottile"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "783577d8-82ac-37ab-a6c9-1850581a8358",
                    "sense_definition": "Verkleinwoord van <w>snee</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "grammatica",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er zat een klein <w>sneetje</w> in haar vinger door het mes.",
                            "target_lang_translations": {
                                "it": "Aveva un piccolo <w>taglietto</w> sul dito a causa del coltello."
                            }
                        },
                        {
                            "text": "Het <w>sneetje</w> in het papier was nauwelijks zichtbaar.",
                            "target_lang_translations": {
