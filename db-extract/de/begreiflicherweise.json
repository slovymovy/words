            {
                "entry_id": "682e2c23-00df-3fb0-a0d5-61599c1b713a",
                "word": "begreiflicherweise",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7cf53a42-d9f1-352e-a4fb-01f163ef4e9a",
                        "entry_id": "682e2c23-00df-3fb0-a0d5-61599c1b713a",
                        "glosses": [
                            "was leicht zu begreifen, nachzuvollziehen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ffa714c2-c67f-4854-aa89-b44c3898d339",
                                "sense_id": "7cf53a42-d9f1-352e-a4fb-01f163ef4e9a",
                                "text": "„Der unglückliche König empfand es außerordentlich peinlich, daß an allen Türen Öffnungen angebracht waren, um ihn zu beobachten. Diese unaufhörlich auf ihm ruhenden Blicke erregten begreiflicherweise seinen Unwillen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a66a523c-305b-4577-9f22-3d1dc4a89950",
                        "source_entry_id": "682e2c23-00df-3fb0-a0d5-61599c1b713a",
                        "source_sense_id": "7cf53a42-d9f1-352e-a4fb-01f163ef4e9a",
                        "source_sense_description": "was leicht zu begreifen, nachzuvollziehen ist",
                        "target_lang_word": "understandably",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "understandably",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dc891245-be27-3c04-a6f3-24b532f5fb20",
                                        "entry_id": "511a9d64-1df8-3c4e-a864-f4bd0dc523d4",
                                        "glosses": [
                                            "For reasons that are easy to understand or sympathise with."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9b9f482-7d29-42f5-97e6-cd2dbcf2fc8e",
                                                "sense_id": "dc891245-be27-3c04-a6f3-24b532f5fb20",
                                                "text": "Understandably, he was too embarrassed to speak."
                                            },
                                            {
                                                "example_id": "4eb8329b-e3a0-4d7d-9c5b-ffabc981f932",
                                                "sense_id": "dc891245-be27-3c04-a6f3-24b532f5fb20",
                                                "text": "Embarrassed, he understandably refused to speak."
                                            },
                                            {
                                                "example_id": "d783dc17-b7e2-48eb-bc4e-dba1f1c7efe3",
                                                "sense_id": "dc891245-be27-3c04-a6f3-24b532f5fb20",
                                                "text": "He was understandably embarrassed, and could not speak."
                                            },
                                            {
                                                "example_id": "86f578ad-61f7-427d-b367-aac99bcc1e11",
                                                "sense_id": "dc891245-be27-3c04-a6f3-24b532f5fb20",
                                                "text": "Everton were, perhaps understandably, deflated at the setback and it was no surprise when Suarez added Liverpool's second after 82 minutes. Distin and Baines were involved in a mix-up as the Uruguayan advanced into the area, and he was not about to pass up the gift to shoot low past Howard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ead5e2a2-473a-3451-975d-743267eb83ef",
                                        "entry_id": "511a9d64-1df8-3c4e-a864-f4bd0dc523d4",
                                        "glosses": [
                                            "In an understandable manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e856a179-6eaa-4f03-a03f-7ee1ac6696c7",
                                                "sense_id": "ead5e2a2-473a-3451-975d-743267eb83ef",
                                                "text": "When presenting in front of the class, take care to speak clearly and understandably."
                                            },
                                            {
                                                "example_id": "dd805714-2288-4c68-af48-39c8b7cc366a",
                                                "sense_id": "ead5e2a2-473a-3451-975d-743267eb83ef",
                                                "text": "Accordingly, even though readers always and understandably speak of the theories adumbrated by Socrates here as \"Plato's theories\", one ought not to speak of them so without some compunction--the writing itself, and also Plato the author, present these always in a spirit of open-ended exploration, and sometimes there are contextual clues indicating that Socrates exaggerates or goes what the argument truly justifies, and so on."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "572d2ba7-810c-41cf-8961-a31d9c7370b2",
                        "source_entry_id": "682e2c23-00df-3fb0-a0d5-61599c1b713a",
                        "source_sense_id": "7cf53a42-d9f1-352e-a4fb-01f163ef4e9a",
                        "source_sense_description": "was leicht zu begreifen, nachzuvollziehen ist",
                        "target_lang_word": "pochopitelně",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pochopitelně",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "e695721c-3ca4-3b8e-9862-d7579c1d70bf",
                                        "entry_id": "9aed099d-3f4b-351e-8a80-875ca35956da",
                                        "glosses": [
                                            "pochopitelným, srozumitelným způsobem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1ba857d-fca7-4f13-a31f-461904f53251",
                                                "sense_id": "e695721c-3ca4-3b8e-9862-d7579c1d70bf",
                                                "text": "Chceš-li, aby ti rozuměli, musíš jim to vysvětlit pochopitelně."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pochopitelně",
