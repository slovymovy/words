                        ],
                        "form": "die Labsal"
                    },
                    {
                        "form_id": "482bfa74-8370-4964-9dd6-6d1e3c74699d",
                        "entry_id": "d9dae958-b184-34d7-9fc5-c13e6673a264",
                        "tags": [
                            "accusative",
