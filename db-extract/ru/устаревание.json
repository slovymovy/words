                                        "sense_id": "fcc3e88d-0ad9-3a76-b266-251e1a23b564",
                                        "entry_id": "5ef1faf2-f81c-346e-a55d-1466c1ddf3ff",
                                        "glosses": [
                                            "UK, Australia, New Zealand, and South Africa standard spelling of aging."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3a743e3-eb57-4df3-adf9-40a3aa4e5bc0",
                                                "sense_id": "fcc3e88d-0ad9-3a76-b266-251e1a23b564",
                                                "text": "\"The Tees Valley has ageing diesel trains that predate any form of emission control."
                                            },
                                            {
                                                "example_id": "4cf42e54-a7ac-422d-a37c-b39651e7fc19",
                                                "sense_id": "fcc3e88d-0ad9-3a76-b266-251e1a23b564",
                                                "text": "These two events have exposed the road haulage industry as being reliant on a poorly paid and ageing workforce, dependent on employees recruited from low-wage countries in Europe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0140e4e7-2dda-405f-bb9a-e85cca763874",
                        "source_entry_id": "bf2d1963-2dfa-3a61-a812-c5c3c651d1af",
                        "source_sense_id": "6acf0d89-a454-3455-8b8b-612571a10614",
                        "target_lang_word": "obsolescense",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
