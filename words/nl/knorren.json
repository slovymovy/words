{
    "word_family": [
        "geknor",
        "knorrig",
        "knorpot"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "aee2fb1b-6341-30ef-acec-c0d76bafba00",
                    "sense_definition": "Het geluid maken dat kenmerkend is voor een varken, of een soortgelijk laag, rollend geluid maken (bijvoorbeeld door de maag).",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "geluid-maken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De varkens in de stal <w>knorren</w> luid wanneer de boer met het voer binnenkomt.",
                            "target_lang_translations": {
                                "en": "The pigs in the barn <w>grunt</w> loudly when the farmer comes in with the food."
                            }
                        },
                        {
                            "text": "Ik heb honger, mijn maag begint te <w>knorren</w>.",
                            "target_lang_translations": {
                                "en": "I am hungry, my stomach is starting to <w>rumble</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "maag begint te knorren"
                    ],
                    "target_lang_definitions": {
                        "en": "To make the characteristic sound of a pig, or to make a similar low, rumbling sound (for example, by the stomach)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "grunt",
                                "target_lang_sense_clarification": "of a pig"
                            },
                            {
                                "target_lang_word": "rumble",
                                "target_lang_sense_clarification": "of a stomach"
                            },
                            {
                                "target_lang_word": "growl",
                                "target_lang_sense_clarification": "of a stomach"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "02a8ea6b-4471-3bf2-b8c5-f84f56839b50",
                    "sense_definition": "Op een norse, ontevreden manier klagen of mopperen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ontevredenheid-uiten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij bleef de hele ochtend <w>knorren</w> over het slechte weer.",
                            "target_lang_translations": {
                                "en": "He kept <w>grumbling</w> about the bad weather all morning."
                            }
                        },
                        {
                            "text": "In plaats van constructief te overleggen, zat hij alleen maar te <w>knorren</w> tegen zijn collega's.",
                            "target_lang_translations": {
                                "en": "Instead of consulting constructively, he was just <w>grousing</w> at his colleagues."
                            }
                        }
                    ],
                    "synonyms": [
                        "mopperen",
                        "brommen",
                        "klagen"
                    ],
                    "common_phrases": [
                        "lopen te knorren"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Vaak gebruikt in informele contexten voor mopperen."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To complain or grumble in a sullen, dissatisfied manner."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "grumble",
                                "target_lang_sense_clarification": "to complain in a low, dissatisfied voice"
                            },
                            {
                                "target_lang_word": "grouse",
                                "target_lang_sense_clarification": "to complain or grumble"
                            },
                            {
                                "target_lang_word": "mutter",
                                "target_lang_sense_clarification": "to complain in a low voice"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "33b6b076-9b54-34b3-a880-1249f5f20b91",
                    "sense_definition": "Een zagend of ronkend geluid maken tijdens de slaap.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "geluid-maken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mijn opa ligt op de bank luidruchtig te <w>knorren</w>.",
                            "target_lang_translations": {
                                "en": "My grandfather is lying on the couch <w>snoring</w> loudly."
                            }
                        },
                        {
                            "text": "Ik kon niet slapen omdat mijn kamergenoot de hele nacht lag te <w>knorren</w>.",
                            "target_lang_translations": {
                                "en": "I couldn't sleep because my roommate was <w>snoring</w> all night."
                            }
                        }
                    ],
                    "synonyms": [
                        "snurken",
                        "snorken"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informeel synoniem voor snurken."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To make a sawing or snoring sound during sleep."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "snore",
                                "target_lang_sense_clarification": "to breathe with a harsh noise during sleep"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}