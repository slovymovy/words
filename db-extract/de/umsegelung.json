                ],
                "senses": [
                    {
                        "sense_id": "09e2113c-add3-3aab-a9da-472c10ae9b11",
                        "entry_id": "268453eb-6ab9-3c92-b9d1-3b45d3c636be",
                        "glosses": [
                            "Umfahren eines geographischen Punktes (beispielsweise einer Insel, eines Kaps) per Schiff unter Segeln"
                        ],
                        "tags": [
                            "Schifffahrt"
                        ],
                        "examples": [
                            {
                                "example_id": "c4c11e5c-3e38-4d3a-b768-5ca0b23773f9",
                                "sense_id": "09e2113c-add3-3aab-a9da-472c10ae9b11",
                                "text": "Die Umsegelung des Kap Hoorn gilt als besonders gefährlich."
                            },
                            {
                                "example_id": "29bc1147-d84f-451c-83ed-eac509f2da22",
                                "sense_id": "09e2113c-add3-3aab-a9da-472c10ae9b11",
                                "text": "[Schlagzeile:] „29.01.1616 - Erste Umsegelung von Kap Hoorn“"
                            },
                            {
                                "example_id": "4f7050e4-9b68-4399-831d-369f7f40954c",
                                "sense_id": "09e2113c-add3-3aab-a9da-472c10ae9b11",
                                "text": "„Nach der Umsegelung von Kap Hoorn waren nur noch drei Schiffe übrig, ein weiteres Jahr später nur noch das Flaggschiff mit dem unverwüstlichen Kommandeur des einstigen Geschwaders an der Spitze.“"
                            },
                            {
                                "example_id": "3376239c-d17a-4217-93ce-79bd57aa4a6c",
                                "sense_id": "09e2113c-add3-3aab-a9da-472c10ae9b11",
                                "text": "„Matthew Flinders […] gelang als Erstem die Umsegelung Australiens.“"
                            },
                            {
                                "example_id": "71d9f62a-e3c0-401e-9ba5-18da97404d72",
                                "sense_id": "09e2113c-add3-3aab-a9da-472c10ae9b11",
                                "text": "„Lediglich genug Zeit sollte man mitbringen: Für eine entspannte Umsegelung Rügens sind zwei Urlaubswochen nicht zu wenig.“"
                            },
                            {
                                "example_id": "cbbd0f68-f6c5-4db4-99d7-851e170c4089",
                                "sense_id": "09e2113c-add3-3aab-a9da-472c10ae9b11",
                                "text": "„Ein Bruder von Christoph Columbus, Kartograf in Lissabon, zog die Südspitze Afrikas so weit in die Länge, dass die Umsegelung des Kontinents aussichtslos erscheinen sollte. Konkurrenten sollten abgeschreckt werden.“"
                            },
                            {
                                "example_id": "2c0232e3-a88a-40f8-b449-43cd52b54a95",
                                "sense_id": "09e2113c-add3-3aab-a9da-472c10ae9b11",
                                "text": "„Der portugiesische Seefahrer Vasco da Gama landete am 20. Mai 1498 nach der ersten erfolgreichen Umsegelung Afrikas am Strand Kappad, etwa 30 km nördlich von Calicut.“"
                            },
                            {
                                "example_id": "09ce33e1-03de-4ee0-a6dd-4766a2a1fb6b",
                                "sense_id": "09e2113c-add3-3aab-a9da-472c10ae9b11",
                                "text": "„Diese Wetterbesonderheit ist seit dem Altertum bekannt, da geschichtlich überliefert ist, dass die Flotte der Perser beim ersten Feldzug unter Darius I. bei der Umsegelung des Athos in einen schweren Sturm geraten waren, der erhebliche Verluste verursacht hatte.“"
                            },
                            {
                                "example_id": "45019a84-ad07-429d-9c8d-2a78579b4d53",
                                "sense_id": "09e2113c-add3-3aab-a9da-472c10ae9b11",
                                "text": "„Der Weg durch das Rote Meer und den Suezkanal ist die direkteste Verbindung ins Mittelmeer und damit zurück nach Europa. Leider führt diese Route am Horn von Afrika in Somalia vorbei, wo die Gefahr von Piraterie sehr groß ist. Yachten haben also das Piratenrisiko gegen die wesentlich weitere Strecke einer Umsegelung von Afrika abzuwägen.“"
                            },
                            {
                                "example_id": "8e2c716c-1ab0-45ea-adb6-8a0215081a29",
                                "sense_id": "09e2113c-add3-3aab-a9da-472c10ae9b11",
                                "text": "„Doch der Russe Fjodor Konjuchow, 65, war sein ganzes Leben lang ein bisschen extremer als der Rest: Er hat im Vietnamkrieg gekämpft, hat den Mount Everest ebenso bestiegen wie die höchsten Berge aller anderen Kontinente, ist allein über Atlantik und Pazifik gerudert, zum Nord- und Südpol gewandert - und noch so einiges mehr, eine Umsegelung der Antarktis zum Beispiel.“"
                            },
                            {
                                "example_id": "02c54f6d-e228-4b15-8371-32466992d187",
                                "sense_id": "09e2113c-add3-3aab-a9da-472c10ae9b11",
                                "text": "Die präzise Umsegelung der Leetonne entschied das Rennen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ab256e58-9046-3eba-80c5-74e9ba8a53a6",
                        "entry_id": "268453eb-6ab9-3c92-b9d1-3b45d3c636be",
                        "glosses": [
                            "Umfahren eines Hindernisses (beispielsweise einer Klippe, einer Untiefe, eines anderen Schiffes) per Schiff unter Segeln"
                        ],
                        "tags": [
                            "Schifffahrt"
                        ],
                        "examples": [
                            {
                                "example_id": "fc379be3-e122-4364-b59a-0d3b1f69882d",
                                "sense_id": "ab256e58-9046-3eba-80c5-74e9ba8a53a6",
                                "text": "Hätte die Yacht genügend Abstand zur Küste gehalten und der Skipper eine weiträumige Umsegelung erwogen, wäre sie nicht auf Grund gelaufen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
