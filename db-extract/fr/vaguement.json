        "fr-extract.jsonl": [
            {
                "entry_id": "3960fb2a-f770-38c0-a347-4d288b510134",
                "word": "vaguement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a4541a4c-a91a-3457-8846-7967b1b2eaa1",
                        "entry_id": "3960fb2a-f770-38c0-a347-4d288b510134",
                        "glosses": [
                            "D’une manière vague."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "b3c254b2-456e-49bc-822a-0b72eed03d12",
                                "sense_id": "a4541a4c-a91a-3457-8846-7967b1b2eaa1",
                                "text": "Tous les habitants de la factorerie, hommes et femmes, s'y trouvaient rassemblés, vaguement éclairés par la lumière des lampes."
                            },
                            {
                                "example_id": "4e8ce6fc-03bb-4612-a619-9c15a9ee1bdc",
                                "sense_id": "a4541a4c-a91a-3457-8846-7967b1b2eaa1",
                                "text": "Elle n'avait commencé à penser, très vaguement, que du jour où elle avait aimé."
                            },
                            {
                                "example_id": "690f8b6d-6431-41c3-97d4-9850f685b6b3",
                                "sense_id": "a4541a4c-a91a-3457-8846-7967b1b2eaa1",
                                "text": "Il labourait dans le parc et cultivait assez de terrain pour nourrir ses chevaux et ses gens ; il y bottelait trois cents milliers de foin excellent, et n’en comptait que cent, en s’autorisant d’une permission vaguement accordée par le comte."
                            },
                            {
                                "example_id": "63145d4e-3eff-43d9-9d65-0692bf4c076b",
                                "sense_id": "a4541a4c-a91a-3457-8846-7967b1b2eaa1",
                                "text": "A l'infini, les sables ardents sont bosselés de touffes pâles, vaguement teintées d'un mélange de vert, de bleu et de gris, — les touffes de hâd arrondies, basses, compactes, hérissées de menus piquants."
                            },
                            {
                                "example_id": "d02af268-22fa-4708-822c-217fd8bf499b",
                                "sense_id": "a4541a4c-a91a-3457-8846-7967b1b2eaa1",
                                "text": "Le traité avait pour objectif de délimiter « les régions sous-marines » du golfe de Paria qui sépare Trinité-et-Tobago, alors colonie britannique, du Venezuela. L'accord fixait ainsi trois segments depuis les bouches du Dragon jusqu'aux bouches du Serpent. Les surfaces délimitées respectaient vaguement ce qu'aurait pu donner une ligne d’équidistance."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "68f0ba24-b953-48f5-b4a9-a70c4eafb6b9",
                        "source_entry_id": "3960fb2a-f770-38c0-a347-4d288b510134",
                        "source_sense_id": "a4541a4c-a91a-3457-8846-7967b1b2eaa1",
                        "target_lang_word": "vaguely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vaguely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5bf6abee-27df-333b-aacc-e0073765a285",
                                        "entry_id": "4a4c389f-6d07-3659-9b5b-43bb560ef026",
                                        "glosses": [
                                            "In a vague manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0cf33fc1-ff8e-4696-8aef-41b117389218",
                                                "sense_id": "5bf6abee-27df-333b-aacc-e0073765a285",
                                                "text": "He looked vaguely around the room, as if lost."
                                            },
                                            {
                                                "example_id": "834fa86b-a09e-4f8a-a048-95edead8351a",
                                                "sense_id": "5bf6abee-27df-333b-aacc-e0073765a285",
                                                "text": "The youth pointed vaguely. \"Over there,\" he replied."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09102f5d-b9ea-3ff3-b830-b2f7e09f9cc8",
                                        "entry_id": "4a4c389f-6d07-3659-9b5b-43bb560ef026",
                                        "glosses": [
                                            "Loosely; more or less; somewhat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae650bb1-6866-417a-8efc-44ae2d1c4667",
                                                "sense_id": "09102f5d-b9ea-3ff3-b830-b2f7e09f9cc8",
                                                "text": "12 July 2012, Sam Adams, AV Club Ice Age: Continental Drift\nPreceded by a Simpsons short shot in 3-D—perhaps the only thing more superfluous than a fourth Ice Age movie—Ice Age: Continental Drift finds a retinue of vaguely contemporaneous animals coping with life in the post-Pangaea age."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
