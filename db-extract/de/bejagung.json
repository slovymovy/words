                                "example_id": "5ce133b7-d096-46b3-b265-63a876b59789",
                                "sense_id": "6276abea-1992-3c5c-9f73-475aa1ae8ac6",
                                "text": "In unserem Revier brauchen wir ein neues Konzept für die Bejagung der Wildschweine."
                            },
