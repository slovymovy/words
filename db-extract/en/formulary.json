                "senses": [
                    {
                        "sense_id": "5feb261d-b6e1-3286-b8ac-eeb8e67cd904",
                        "entry_id": "18ca22a7-e1e7-3afd-a958-739fa6a63610",
                        "glosses": [
                            "A list of formulas; a collection of set forms to be followed, especially in religious belief."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98213f9a-3d51-445e-b9e3-545277de1464",
                                "sense_id": "5feb261d-b6e1-3286-b8ac-eeb8e67cd904",
                                "text": "“Pray,” replied the Colonel, “do you believe in all the doctrines to be found in the public creeds and formularies of our own church.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "5c13b847-b18e-3194-8e54-5d06afa178c2",
                        "entry_id": "18ca22a7-e1e7-3afd-a958-739fa6a63610",
                        "glosses": [
                            "A pharmacopoeia or list of available drugs, particularly prescription drugs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4156e4b1-388a-4ce1-82f3-51c2cf85200d",
                                "sense_id": "5c13b847-b18e-3194-8e54-5d06afa178c2",
                                "text": "However, when used appropriately under medical guidance, this drug is a safe and essential part of a physician's formulary."
                            }
                        ]
                    },
                    {
                        "sense_id": "72a51a87-1b92-3d75-afdb-f15903a929a9",
                        "entry_id": "18ca22a7-e1e7-3afd-a958-739fa6a63610",
                        "glosses": [
                            "A list of drugs, created by health insurers, hospitals, or prescription drug plans, that defines how costs for any drug are shared between patient and health care provider, typically broken down by tiers such as preferred generics with lowest copay, or preferred brand with higher copay, or non-preferred brand and not covered tiers with the highest cost to the patient."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af8254ac-278f-4d0a-bb42-139ceb28f36d",
                                "sense_id": "72a51a87-1b92-3d75-afdb-f15903a929a9",
                                "text": "Even if beneficiaries want to stay in their current plan, they should still check that the drugs they take are remaining on their plan's formulary and on the same co-pay \"tier\" as before."
                            }
                        ]
                    },
                    {
                        "sense_id": "4beb17a3-f3c8-35bb-be5b-5f8504e48fc6",
                        "entry_id": "18ca22a7-e1e7-3afd-a958-739fa6a63610",
                        "glosses": [
                            "An ancient or medieval collection of models for official writings."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "d9ad904e-9735-3146-9f2c-a8434e1adca4",
                        "entry_id": "18ca22a7-e1e7-3afd-a958-739fa6a63610",
