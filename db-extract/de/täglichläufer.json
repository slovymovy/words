                ],
                "senses": [
                    {
                        "sense_id": "dbd82ac2-83f8-3e61-8107-2f1b652ad70b",
                        "entry_id": "48192897-4011-3389-8631-b542468ff7f5",
                        "glosses": [
                            "Person, die (meistens über einen langen Zeitraum hinweg) jeden Tag läuft, Person, die an einem sogenannten Laufstreak teilnimmt"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "169fbf98-f1d7-4f43-91be-0f8a7589c00a",
                                "sense_id": "dbd82ac2-83f8-3e61-8107-2f1b652ad70b",
                                "text": "„Er ist Veganer, Täglichläufer mit einem Streak von über 1300 Läufen und ist in 45 Tagen den E1 quer durch Deutschland gelaufen.“"
                            },
                            {
                                "example_id": "97482c19-7ff6-44d7-97fc-dec02e64e4c7",
                                "sense_id": "dbd82ac2-83f8-3e61-8107-2f1b652ad70b",
                                "text": "„Viele meiner Leser kennen meine Geschichte vom 160 kg Übergewichtigen zum Täglichläufer, der nun schon seit 8 Jahren, 3 Monaten und einer Woche jeden Tag joggen geht.“"
                            },
                            {
                                "example_id": "80b72c76-b886-4944-b009-3c1e9afb4d09",
                                "sense_id": "dbd82ac2-83f8-3e61-8107-2f1b652ad70b",
                                "text": "„Seit heute stehe ich auf der 14. Jahresebene in der Zunft der Täglichläufer, ein würdiger Moment in diesem meinem Leben, welchen ich feierlich zelebrieren werde.“"
                            },
                            {
                                "example_id": "7134ecc9-a092-4e0e-8b2d-d7f15c0f71ec",
                                "sense_id": "dbd82ac2-83f8-3e61-8107-2f1b652ad70b",
                                "text": "„Als Täglichläufer bin ich wie der Name sagt täglich unterwegs, egal bei welchem Wetter und ich habe einen entsprechend ‚großen‘ Kleiderschrank für Laufklamotten.“"
                            },
                            {
                                "example_id": "6497afd1-e4f3-437d-a102-d5d3d6e2e27a",
                                "sense_id": "dbd82ac2-83f8-3e61-8107-2f1b652ad70b",
                                "text": "„Im Spätsommer 2019 lief der Ultradistanz- und Täglichläufer Anthony Horyna einmal quer durch Deutschland. 1.900 Kilometer am Stück. 1 Marathon pro Tag.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
