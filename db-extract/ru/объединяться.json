                    },
                    {
                        "translation_id": "8b5405f3-2eab-448e-8612-e0ae3467128d",
                        "source_entry_id": "93abd70c-6c71-39e2-8c4f-c6863c3b9b23",
                        "source_sense_description": "образовывать единое целое",
                        "target_lang_word": "consolidate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "consolidate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "64da0f9b-e895-3169-a479-509579101f7d",
                                        "entry_id": "58406c7b-66cf-3466-a9bb-839a3249e4a2",
                                        "glosses": [
                                            "To combine into a single unit; to group together or join."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a370109-476b-4958-9706-acd59dc863a9",
                                                "sense_id": "64da0f9b-e895-3169-a479-509579101f7d",
                                                "text": "He consolidated his luggage into a single large bag."
                                            },
                                            {
                                                "example_id": "27950398-6414-43c8-9e37-0cc381005d55",
                                                "sense_id": "64da0f9b-e895-3169-a479-509579101f7d",
                                                "text": "With large credits borrowed in the name of Charlottenhütte he managed to gain control over the Rhein-Elbe Union, another large steel firm which in 1926 consolidated with one of its subcompanies, the old and respected Gelsenkirchen Mining Company, and assumed the latter’s name."
                                            },
                                            {
                                                "example_id": "26663574-abba-4127-be25-d5637505676b",
                                                "sense_id": "64da0f9b-e895-3169-a479-509579101f7d",
                                                "text": "The second spot, “One Thing,” shows the unlikely custom car shop workin', musclebound dude-bro, who loves his iPhone because it consolidates the iPod, camera, cell phone and SMS device he used to carry around in “a little bag.”"
                                            },
                                            {
                                                "example_id": "7802d787-0831-4e9b-aabd-e89b7a7704b2",
                                                "sense_id": "64da0f9b-e895-3169-a479-509579101f7d",
                                                "text": "It[China] had a buoyant economy outperforming forecasts. Its unemployment rate was among the lowest in years. While consolidating his power for a second term, Mr Xi proudly pointed to China's \"flourishing\" growth model as something other countries could emulate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a8c7af8-f51f-30f1-9970-5ba0c88519fe",
                                        "entry_id": "58406c7b-66cf-3466-a9bb-839a3249e4a2",
                                        "glosses": [
                                            "To make stronger or more solid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed02deab-9ee9-444a-b5df-45406db311ee",
                                                "sense_id": "0a8c7af8-f51f-30f1-9970-5ba0c88519fe",
                                                "text": "These infamous little green men appeared during the decisive seizures or buildings and facilities, only to disappear when associated militias and local troops arrived to consolidate the gains. In this way they provided a measure of deniability—however superficial or implausible—for Moscow.⁴⁰"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d131d037-bbc6-36bc-91bd-5bd79c510aac",
                                        "entry_id": "58406c7b-66cf-3466-a9bb-839a3249e4a2",
                                        "glosses": [
                                            "With respect to debt, to pay off several debts with a single loan."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "consolidate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "040d78aa-3a8a-3c49-99fe-e9e5942decc6",
                                        "entry_id": "9cbd47e6-fac3-305e-8e93-5c39cf9d3968",
                                        "glosses": [
                                            "Formed into a solid mass; made firm; consolidated."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a7e3348-9369-4851-86fc-180317d50fde",
                                                "sense_id": "040d78aa-3a8a-3c49-99fe-e9e5942decc6",
                                                "text": "A gentleman [should learn to ride] while he is tender and the brawns and sinews of his thighs not fully consolidate."
                                            }
                                        ]
