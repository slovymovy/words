                "senses": [
                    {
                        "sense_id": "9113843d-d579-33cb-9116-a7c3e82f005b",
                        "entry_id": "b957469c-8461-3e1d-8388-5ae4cb3b33b3",
                        "glosses": [
                            "zonder opleiding of training te hebben ontvangen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a37b970e-be78-447d-a602-80058f23d287",
                                "sense_id": "9113843d-d579-33cb-9116-a7c3e82f005b",
                                "text": "... als ongeoefend strijder had hij Bergsma gestoken met het mes nog in de schede."
                            },
                            {
                                "example_id": "44c0dc86-4bdc-4829-a9b2-d76d22a59121",
                                "sense_id": "9113843d-d579-33cb-9116-a7c3e82f005b",
                                "text": "Veel Libiërs hebben een dubbel gevoel in deze periode. Niemand kent nog het aantal slachtoffers, maar sinds het begin van de opstand, nu zo'n zes maanden geleden, zijn er duizenden mensen gedood. Zonen en mannen die ongeoefend en onvoorbereid naar het front gingen, vrouwen en kinderen die op het verkeerde moment op de verkeerde plek waren. Hele wijken liggen in puin. Voedsel en water zijn schaars."
                            }
                        ]
                    }
                ],
