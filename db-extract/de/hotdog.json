                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hot-dog",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "46788f19-1aa9-32e5-8076-c96de73ff68d",
                                        "entry_id": "3bf8b792-fd8e-3fdd-81ca-8c30c49ea3ba",
                                        "glosses": [
                                            "Sandwich composé d’une saucisse placée dans un pain coupé en deux, appelé pain à hot-dog, souvent mangé avec du ketchup, de la moutarde, de la mayonnaise ou de la relish."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6da916dc-b918-4dcc-bc36-960678be1ba1",
                                                "sense_id": "46788f19-1aa9-32e5-8076-c96de73ff68d",
                                                "text": "Devant le théâtre j’achète et je goûte un hot-dog (petit pain au lait garni à l’intérieur d’une saucisse chaude et de moutarde). Conquis, j’en achète un véritable stock que je dévore, pendant la répétition, devant les musiciens amusés."
                                            },
                                            {
                                                "example_id": "d1e4c182-4ddc-40bd-9baf-95eb9506a34f",
                                                "sense_id": "46788f19-1aa9-32e5-8076-c96de73ff68d",
                                                "text": "Au début, Marie-Jeanne fera la cuisine ; rien que des grillades et des hot-dogs.\n— Des hot-dogs ?\n— Des petites saucisses.\n— Pourquoi ne parles-tu pas français ?"
                                            },
                                            {
                                                "example_id": "1de9f98e-12e7-4030-b95f-802f1d6f8249",
                                                "sense_id": "46788f19-1aa9-32e5-8076-c96de73ff68d",
                                                "text": "Au-delà des feux d’artifice et des hot-dogs gratuits du premier juillet, les festivités entourant l’anniversaire de l’avènement de la Confédération semblent ainsi chercher un aspect de son passé à célébrer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
