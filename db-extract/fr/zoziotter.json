                        "glosses": [
                            "Chanter, pousser son cri, en parlant d’un oiseau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37d6c477-fde8-48b9-9d00-b4085d96feda",
                                "sense_id": "a1e8a551-9e6f-39e3-872b-28f119d16d95",
                                "text": "trop de bonheur que d'entendre les zozios zoziotter, les mouches péter à l'air pur et sentir de nouveau la bouse fraiche dans ce léger courant d'air..."
                            },
                            {
                                "example_id": "fca29701-01da-45b2-98fa-1ac1f6d17a51",
                                "sense_id": "a1e8a551-9e6f-39e3-872b-28f119d16d95",
                                "text": "Salut Titoune, je n'savais pas que tu zozotais, un zoziau qui zoziotte, drôle d'oiseau l'pioupiou."
                            },
                            {
                                "example_id": "9ceb6caf-89cc-4baf-acca-e7bfa866dde6",
                                "sense_id": "a1e8a551-9e6f-39e3-872b-28f119d16d95",
                                "text": "ça gromotte ça lolurote ça débagote ça asticote ça chipote ça tricote ça tripote ça tarabiscote ça margotte ça pisote ça frigulote ça fringote ça gringotte ça truissotte ça chuchote ça zoziotte..."
                            }
                        ]
                    }
