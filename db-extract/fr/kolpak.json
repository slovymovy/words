                                        "entry_id": "dd25645f-6cbf-3e41-9ef3-ebdbe09bc5d6",
                                        "glosses": [
                                            "wysoka czapka bez daszka o cylindrycznym lub stożkowatym kształcie, futrzana lub obszyta futrem, noszona w średniowieczu przez Tatarów, popularna w Polsce od XV do XIX w."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1.2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c1a70893-f79d-4c47-a164-6bc16a2a8a8a",
                        "source_entry_id": "17f351c9-51ae-39df-8612-34e392ad33d0",
                        "source_sense_id": "d5ead895-4399-3eb1-acb8-bc10e6518dab",
                        "target_lang_word": "колпак",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "колпак",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "358d6dc3-576f-3a2c-9d1c-4da00e1cfa26",
                                        "entry_id": "b3157366-7fa2-353d-9359-63275c01d487",
                                        "glosses": [
                                            "конусообразный или овальный головной убор, служащий для различных целей"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8f082ce-2acd-42ad-8150-72d97960afa2",
                                                "sense_id": "358d6dc3-576f-3a2c-9d1c-4da00e1cfa26",
                                                "text": "Изолирующий колпак регулируется по размеру завязками сзади."
                                            },
                                            {
                                                "example_id": "de6cce6b-62de-4dfe-a1ac-0de974b3f033",
                                                "sense_id": "358d6dc3-576f-3a2c-9d1c-4da00e1cfa26",
                                                "text": "Вильям Шекспир говорил о том, что дурацкий колпак мозгов не испортит."
                                            },
                                            {
                                                "example_id": "bf4ae769-0b07-48d3-be89-e9885fdc869d",
                                                "sense_id": "358d6dc3-576f-3a2c-9d1c-4da00e1cfa26",
                                                "text": "Ночной колпак старого холостяка."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3d74f78-53bd-371e-b263-167aff9fd562",
                                        "entry_id": "b3157366-7fa2-353d-9359-63275c01d487",
                                        "glosses": [
                                            "конусообразная или округлая покрышка к разным предметам"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed3c0587-d2d3-46ad-9241-81040f840f65",
                                                "sense_id": "a3d74f78-53bd-371e-b263-167aff9fd562",
                                                "text": "Флюгарки, парапеты, кровля, колпаки заборные."
                                            },
                                            {
                                                "example_id": "528788a1-60ad-4a7a-a4cb-b4c74e42443c",
                                                "sense_id": "a3d74f78-53bd-371e-b263-167aff9fd562",
                                                "text": "Колпак для кальяна."
                                            },
                                            {
                                                "example_id": "edf274ef-089b-4708-be06-ee694af02d7d",
                                                "sense_id": "a3d74f78-53bd-371e-b263-167aff9fd562",
                                                "text": "Колпак колеса."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04d785bc-2d84-3db4-be7f-8c9a5c080502",
                                        "entry_id": "b3157366-7fa2-353d-9359-63275c01d487",
                                        "glosses": [
                                            "микол. род грибов из семейства кортинариевых"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "570f2f6c-ea96-458c-9859-b5b1a9b3d043",
                                                "sense_id": "04d785bc-2d84-3db4-be7f-8c9a5c080502",
                                                "text": "Колпак кольчатый принадлежит к съедобным грибам высшей категории и по вкусовым качествам не уступает ни белому, ни тем более моховикам-маслятам."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a1a91fb-4cde-39cc-a3eb-be256d23e203",
                                        "entry_id": "b3157366-7fa2-353d-9359-63275c01d487",
                                        "glosses": [
                                            "прост., устар. глупый, недалёкий человек, простак"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "356aa4b1-4b86-444e-9e52-2be33fc9a017",
                                                "sense_id": "3a1a91fb-4cde-39cc-a3eb-be256d23e203",
                                                "text": "У нас в образованном обществе особенно священных преданий ведь нет, Авдотья Романовна: разве кто какой-нибудь себе по книгам составит… али из летописей что-нибудь выведет. Но ведь это больше ученые и, знаете, в своем роде все колпаки, так что даже и неприлично светскому человеку."
                                            },
                                            {
                                                "example_id": "46287d34-3015-41e8-b447-edd09b8280b4",
                                                "sense_id": "3a1a91fb-4cde-39cc-a3eb-be256d23e203",
                                                "text": "— Да, по-вашему, каждый обиженный муж есть колпак!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
