        "fr-extract.jsonl": [
            {
                "entry_id": "dde5a18e-862d-332e-b18a-480e8d8d008b",
                "word": "grégaire",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6198d46f-00f7-48fb-bcec-d1c0750c7049",
                        "entry_id": "dde5a18e-862d-332e-b18a-480e8d8d008b",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "grégaires"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bf6ab805-1523-3161-98da-1f65c9df3850",
                        "entry_id": "dde5a18e-862d-332e-b18a-480e8d8d008b",
                        "glosses": [
                            "Qualifie une espèce vivant en groupe ou en communauté sans nécessairement présenter une organisation sociale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "519609f3-ba36-41c4-9f81-0da7f03f9a4f",
                                "sense_id": "bf6ab805-1523-3161-98da-1f65c9df3850",
                                "text": "Alors que les aigrettes se nourrissent essentiellement dans les milieux aquatiques, le garde-bœufs est une espèce grégaire terrestre qui vit en association étroite avec le bétail et les ongulés sauvages qu'il suit."
                            }
                        ]
                    },
                    {
                        "sense_id": "35fee9d7-b049-3279-9666-11ace7505b13",
                        "entry_id": "dde5a18e-862d-332e-b18a-480e8d8d008b",
                        "glosses": [
                            "Qui pousse des êtres à former des groupes et à avoir les mêmes comportements."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "9ceeb14c-cc60-4c9d-94ce-e14b83de4d9c",
                                "sense_id": "35fee9d7-b049-3279-9666-11ace7505b13",
                                "text": "Cependant il ne s’agit pas de votes qui seraient tellement unanimes qu’on pourrait les croire grégaires."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a35e138d-bcfc-426e-a44d-341b4a1d9e7a",
                        "source_entry_id": "dde5a18e-862d-332e-b18a-480e8d8d008b",
                        "target_lang_word": "Herdentrieb",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Herdentrieb",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5c65f085-3354-3e00-bc02-e8ea0b221872",
                                        "entry_id": "d5b0b88a-d9b0-3438-a5e8-28152623985c",
                                        "glosses": [
                                            "der Trieb von Herdentieren, in Herden zusammenzuleben und der Herde zu folgen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e6a8266-e1e8-4807-af37-1199924a7dbd",
                                                "sense_id": "5c65f085-3354-3e00-bc02-e8ea0b221872",
                                                "text": "„Die Kühe einer Herde wenden sich beim Weiden bevorzugt in dieselbe Richtung. Die warme Sonne, der kalte Wind und der Herdentrieb mussten bereits als Erklärung dafür herhalten.“"
                                            },
                                            {
                                                "example_id": "5090fd46-8f59-4079-8841-4a65b5178357",
                                                "sense_id": "5c65f085-3354-3e00-bc02-e8ea0b221872",
                                                "text": "„Die Theorie zum Herdentrieb des Triceratops lässt sich mit Funden bestätigen, bei denen eine große Zahl an Triceratops nebeneinander lag.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7c7d1363-d8f4-3a79-8ddf-cb5b2f1cc785",
                                        "entry_id": "d5b0b88a-d9b0-3438-a5e8-28152623985c",
                                        "glosses": [
                                            "die Neigung, sich sozialen Gruppen und deren Führern anzuschließen und deren Verhalten nachzuahmen"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c30ecd5-4199-4c89-8333-8753e2e351a2",
                                                "sense_id": "7c7d1363-d8f4-3a79-8ddf-cb5b2f1cc785",
                                                "text": "„Der uns angeborene Herdentrieb wird auch an Fußgängerampeln wirksam.“"
                                            },
                                            {
                                                "example_id": "7c2936c7-e964-4aa3-bd92-5116f8193879",
                                                "sense_id": "7c7d1363-d8f4-3a79-8ddf-cb5b2f1cc785",
                                                "text": "„Ein bekannter Ökonom vertritt die Auffassung, dass der Herdentrieb zahlreiche Finanzmarktteilnehmer in die Irre geführt hat.“"
                                            },
                                            {
                                                "example_id": "fc7e1210-bb9f-44ee-b579-05dc4af77da4",
                                                "sense_id": "7c7d1363-d8f4-3a79-8ddf-cb5b2f1cc785",
                                                "text": "„Ich war eigentlich kein Fan von solchen Veranstaltungen, aber hier war der Herdentrieb unersetzlich, um die Angst zu überwinden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "54682113-b686-4dd0-85cb-35d4273414cb",
                        "source_entry_id": "dde5a18e-862d-332e-b18a-480e8d8d008b",
