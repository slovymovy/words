                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b00fc06f-d567-3093-a0d7-d1b3fe6f50d3",
                        "entry_id": "271f455d-0842-3301-996e-d814ee9e1e54",
                        "glosses": [
                            "Roi de Pylos qui vécut trois âges d’homme."
                        ],
                        "tags": [
                            "Anthroponyme"
                        ],
                        "examples": [
                            {
                                "example_id": "e77c48b4-e9b8-42e3-95f2-7b7bcfb3fd33",
                                "sense_id": "b00fc06f-d567-3093-a0d7-d1b3fe6f50d3",
                                "text": "— Mon cher Athos, dit Aramis, vous parlez comme Nestor, qui était, comme chacun sait, le plus sage des Grecs."
                            },
                            {
                                "example_id": "7ce4aead-8983-4ebb-97ec-4d3bf02e1c6c",
                                "sense_id": "b00fc06f-d567-3093-a0d7-d1b3fe6f50d3",
                                "text": "Certains organes de presse, contrôlés par les faiseurs, comme L’Éclaireur commercial ou La Gazette des renseignements mutuels, tirent à boulets rouges sur Vidock, le qualifiant « d’ignoble personnage » ou de « Nestor » dont les intelligences finissaient."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
