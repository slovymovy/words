    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1d622348-db7d-3664-bc9c-dc6801006e35",
                    "sense_definition": "ordeloos of slordig ergens liggen zonder opgeruimd te zijn",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "slordig liggen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door al die <w>slingerende</w> kleren is mijn kamer een complete rotzooi.",
                            "target_lang_translations": {
                                "en": "Because of all those clothes <w>lying around</w>, my room is a complete mess."
                            }
                        },
                        {
                            "text": "Je moet je boeken niet overal laten <w>slingeren</w> als je klaar bent met studeren.",
                            "target_lang_translations": {
                                "en": "You shouldn't leave your books <w>lying around</w> everywhere when you're finished studying."
                            }
                        }
                    ],
                    "synonyms": [
                        "rondliggen"
                    ],
                    "antonyms": [
                        "opruimen"
                    ],
                    "common_phrases": [
                        "laten slingeren",
                        "overal slingeren"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in household contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To lie around in a messy or disorderly way without being put away."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lie around",
                                "target_lang_sense_clarification": "of objects being scattered messily"
                            },
                            {
                                "target_lang_word": "be cluttered",
                                "target_lang_sense_clarification": "of a space filled with messy items"
                            },
                            {
                                "target_lang_word": "be strewn",
                                "target_lang_sense_clarification": "scattered untidily"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "30109059-04bd-3ff7-a347-1c8f38ea4832",
                    "sense_definition": "zwaaiend of onregelmatig heen en weer bewegend voortbewegen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De dronken man liep over de straat te <w>slingeren</w>.",
                            "target_lang_translations": {
                                "en": "The drunk man was <w>staggering</w> across the street."
                            }
                        },
                        {
                            "text": "De auto begon gevaarlijk te <w>slingeren</w> op de gladde weg.",
                            "target_lang_translations": {
                                "en": "The car began to <w>swerve</w> dangerously on the slippery road."
                            }
                        }
                    ],
                    "synonyms": [
                        "zwenken",
                        "wiebelen"
                    ],
                    "common_phrases": [
                        "over de weg slingeren"
                    ],
                    "target_lang_definitions": {
                        "en": "To move forward in a swinging, irregular, or swaying motion."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "swerve",
                                "target_lang_sense_clarification": "moving unsteadily from side to side"
                            },
                            {
                                "target_lang_word": "sway",
                                "target_lang_sense_clarification": "moving unsteadily while walking or driving"
                            },
                            {
                                "target_lang_word": "fishtail",
                                "target_lang_sense_clarification": "of a vehicle sliding out of control"
                            },
                            {
                                "target_lang_word": "stagger",
                                "target_lang_sense_clarification": "walking unsteadily"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c544378c-006d-3a0e-ae7a-ee890837e024",
                    "sense_definition": "iets met een krachtige, zwaaiende beweging wegwerpen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "werpen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>slingerde</w> de steen met een grote boog in het water.",
                            "target_lang_translations": {
                                "en": "He <w>hurled</w> the stone into the water with a wide arc."
                            }
                        },
                        {
                            "text": "De atleet <w>slingerde</w> de discus ver over het veld.",
                            "target_lang_translations": {
                                "en": "The athlete <w>flung</w> the discus far across the field."
                            }
                        }
                    ],
                    "synonyms": [
                        "gooien",
                        "werpen",
                        "keilen"
                    ],
                    "common_phrases": [
                        "ver weg slingeren"
                    ],
                    "target_lang_definitions": {
