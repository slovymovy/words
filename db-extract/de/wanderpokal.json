                "senses": [
                    {
                        "sense_id": "7e9e7ef9-696a-3442-b06f-555b47bad7c0",
                        "entry_id": "19b64535-7337-3d8c-8b38-a993756cc30d",
                        "glosses": [
                            "a travelling trophy; a cup for a recurring contest held by the most recent winner"
                        ],
                        "tags": [
                            "masculine",
                            "strong"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "57abccf0-7e8c-39b8-b753-1bfe8eff0779",
                        "entry_id": "19b64535-7337-3d8c-8b38-a993756cc30d",
                        "glosses": [
                            "anything that is owned for a while and then habitually lost or handed over"
                        ],
                        "tags": [
                            "figuratively",
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "7d66bde1-a25f-46b2-b087-3e9a5a88f40e",
                                "sense_id": "57abccf0-7e8c-39b8-b753-1bfe8eff0779",
                                "text": "Die Erde ist ein Wanderpokal. Ein Wanderpokal, der immer den Völkern gegeben wird, die ihn verdienen; die im Kampf um das Dasein sich stark genug erweisen, die eigene Existenzgrundlage sicherzustellen. Ein Wanderpokal, der den Völkern genommen wird, die schwach werden [...].",
                                "translation": "The earth is a travelling trophy. A travelling trophy that is always given to those peoples who deserve it, who in the struggle for survival prove to be strong enough to secure their own means of existence. A travelling trophy that is taken away from those peoples who become weak ….",
                                "english": "The earth is a travelling trophy. A travelling trophy that is always given to those peoples who deserve it, who in the struggle for survival prove to be strong enough to secure their own means of existence. A travelling trophy that is taken away from those peoples who become weak …."
                            }
                        ]
                    },
                    {
                        "sense_id": "3e278adb-6380-3c67-922e-4dcd20e01176",
                        "entry_id": "19b64535-7337-3d8c-8b38-a993756cc30d",
                        "glosses": [
                            "a promiscuous person (usually female); a slut, town bicycle"
                        ],
