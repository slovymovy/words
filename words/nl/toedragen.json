            "senses": [
                {
                    "sense_id": "6f9ad776-5a06-3c6e-bca3-00b9ea163169",
                    "sense_definition": "bepaalde gevoelens (zoals liefde, vriendschap of haat) koesteren of hebben voor iets of iemand",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gevoelens_koesteren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij <w>draagt</w> haar oude leraar nog altijd een warm hart <w>toe</w>.",
                            "target_lang_translations": {
                                "en": "She still <w>wishes</w> her old teacher <w>well</w>."
                            }
                        },
                        {
                            "text": "Ik weet niet welke gevoelens hij mij werkelijk <w>toedraagt</w>.",
                            "target_lang_translations": {
                                "en": "I do not know what feelings he actually <w>bears</w> towards me."
                            }
                        }
                    ],
                    "synonyms": [
                        "koesteren"
                    ],
                    "common_phrases": [
                        "een warm hart toedragen"
                    ],
                    "target_lang_definitions": {
                        "en": "To harbor or have certain feelings (such as love, friendship, or hatred) towards someone or something."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bear",
                                "target_lang_sense_clarification": "feelings towards someone"
                            },
                            {
                                "target_lang_word": "harbor",
                                "target_lang_sense_clarification": "feelings or sentiments"
                            },
                            {
                                "target_lang_word": "have",
                                "target_lang_sense_clarification": "feelings for someone"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1226ffd7-3565-3005-ac78-e3f21a2d342a",
                    "sense_definition": "plaatsvinden, gebeuren of geschieden",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "gebeuren",
                    "name_type": "no",
                    "examples": [
                        {
