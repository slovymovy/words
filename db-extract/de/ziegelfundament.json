                        "examples": [
                            {
                                "example_id": "6925fdee-7c6d-49d1-aabd-8bf8c25cc010",
                                "sense_id": "736d3277-fc50-380d-9e51-cd034acc1066",
                                "text": "„Die Sonne war eben erst über dem großen Berghang aufgegangen, auf dem sich verlassene urzeitliche Ziegelfundamente, abgetragene Mauern und einzelne geborstene Säulen und Sockel bis hinab zum Ufer des Yath erstreckten, als Carter nach seinem Zebra schaute.“"
                            },
                            {
                                "example_id": "3a0e5dea-b48c-4cec-80b6-69d2101c9dfd",
                                "sense_id": "736d3277-fc50-380d-9e51-cd034acc1066",
                                "text": "„Edgerton untersuchte an der Fundstelle sorgfältig Kopf und Hals des Opfers, bis er sich überzeugt hatte, dass sie nur an dem niedrigen Ziegelfundament Blut verloren hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
