                            {
                                "example_id": "fa76d369-b01a-4a86-b012-4ab6b79f6d12",
                                "sense_id": "ed5c783f-11e5-3269-baf8-3b88b6e49f5f",
                                "text": "Jusqu’ici nous avons vu des Avignonnais, des Aptésiens, des Aixois, des Marseillais, des Toulonnais ; maintenant il s’agit de voir ce qu’est le Provençal."
                            },
                            {
                                "example_id": "852a035b-94f0-4db5-8f93-b6ce7bfc2f7d",
                                "sense_id": "ed5c783f-11e5-3269-baf8-3b88b6e49f5f",
                                "text": "Quant à l’insalubrité prétendue de cette ville, à l’époque actuelle les Aixois, ou Aquisextains, indignés, la nient."
                            }
                        ]
                    },
