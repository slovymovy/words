                                    }
                                ]
                            },
                            {
                                "target_word": "torse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "da481aa0-0d24-3ed2-855f-0cf019f4af71",
                                        "entry_id": "b6590162-e588-3558-97b2-65621353d1ad",
                                        "glosses": [
                                            "Féminin singulier de tors."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eef66f30-783f-4095-8bc5-f25332ae32f5",
                                                "sense_id": "da481aa0-0d24-3ed2-855f-0cf019f4af71",
                                                "text": "Tout ce qu’ils aimaient de l’Italie, les grandes fenêtres ouvertes sur la lumière, les colonnades torses des balcons, l’ornementation à l’antique des façades, était acquis comme de grasses prébendes à cet ignoble de Griffes."
                                            },
                                            {
                                                "example_id": "43c1745e-47ec-49e6-ae1b-8fb422dac271",
                                                "sense_id": "da481aa0-0d24-3ed2-855f-0cf019f4af71",
                                                "text": "Louie avait une jambe torse, Perrine un œil aveugle, et Noé, à huit ans, faisait la taille d’un enfant de cinq ans."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
