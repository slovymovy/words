                                "target_senses": [
                                    {
                                        "sense_id": "c59e0ee2-7c07-3d8a-bf0c-5496ba43c4a0",
                                        "entry_id": "aaf74b37-7e41-3e29-a37e-899a7522fb32",
                                        "glosses": [
                                            "von Menschen erbaute (kleine) Burg aus Sand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7d83bdc-db7a-4732-9d58-cc94e0f6100e",
                                                "sense_id": "c59e0ee2-7c07-3d8a-bf0c-5496ba43c4a0",
                                                "text": "„Wie aus dieser neuen Flexibilität die filigranen Strukturen der Welt erwachsen, veranschaulichte er mit einer Sanduhr: In ihr rieselt der Sand nicht einfach zu dem gewohnten Haufen im Stundenglas, sondern formt dort eine kühn geschwungene Sandburg.“"
                                            },
                                            {
                                                "example_id": "8a0824b6-8349-4561-8fcd-10c199188849",
                                                "sense_id": "c59e0ee2-7c07-3d8a-bf0c-5496ba43c4a0",
                                                "text": "„Auch die eine oder andere Sandburg nimmt es mit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
