                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63ebdb96-7057-47ad-ae0c-484e4ad7083b",
                                "sense_id": "40c88a0f-25e4-38f4-af38-9e60148860f1",
                                "text": "Он велел достать письмо из кармана и придвинуть к кровати столик с лимонадом и витушкой ― восковой свечкой и, надев очки, стал читать."
                            }
                        ]
                    },
                    {
                        "sense_id": "f2822e24-1fe0-3926-b31f-d37dab4974ea",
                        "entry_id": "b00acb08-7f96-36c9-94f2-daa5d6cbdf39",
                        "glosses": [
                            "разг. витая булка"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "931cce9a-8f63-486b-b63c-19b84122ffab",
                                "sense_id": "f2822e24-1fe0-3926-b31f-d37dab4974ea",
                                "text": "Русская натура любит делать дела широко, а потому пекарь получил приказание печь калачи, сайки, валять баранки и витушки."
                            }
                        ]
                    }
