                "senses": [
                    {
                        "sense_id": "69326bbd-5a28-36b1-9bb5-d0c5c4cd77b0",
                        "entry_id": "c9b20c7c-3eef-37c6-9c5f-074d4a5f38e6",
                        "glosses": [
                            "die Auslandsrückholung von verletzten oder kranken Personen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7783df45-df69-4319-8746-48e59c4434f6",
                                "sense_id": "69326bbd-5a28-36b1-9bb5-d0c5c4cd77b0",
                                "text": "„Diese Versicherung kann sich lohnen, weil die Krankenkassen aus der Grundversicherung für Repatriierungen aus dem Ausland maximal 5000 Franken zahlen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e0afd278-a2c3-3a35-950b-df2a944e2bda",
                        "entry_id": "c9b20c7c-3eef-37c6-9c5f-074d4a5f38e6",
                        "glosses": [
                            "Rückführung von Flüchtlingen und verschleppten Personen in ihr Heimatland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df04ad90-27d8-4472-a28a-22ca47636d05",
                                "sense_id": "e0afd278-a2c3-3a35-950b-df2a944e2bda",
                                "text": "„Da sich im Lager über 2.000 Überlebende aus der Tschechoslowakei befanden, wurde die Repatriierung auf zwei oder sogar drei[220] aufeinanderfolgende Tage verteilt.“"
                            },
                            {
                                "example_id": "51e12fb4-fa08-4eea-b632-bb5b10596501",
                                "sense_id": "e0afd278-a2c3-3a35-950b-df2a944e2bda",
                                "text": "„Im Rahmen des Programms für freiwillige Rückkehr der Internationalen Organisation für Migration (IOM) hilft das flämische Rote Kreuz bei der Repatriierung zum Herkunftsland.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "94105c91-cf91-326b-9ba0-063ee93a8cb2",
