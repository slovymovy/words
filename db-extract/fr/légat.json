                "forms": [
                    {
                        "form_id": "b1db01ae-aff0-4d79-aec6-9fe0cdcd7e0f",
                        "entry_id": "545c2cd0-1c48-318d-bf58-2ce15e5b427d",
                        "tags": [
                            "plural"
                        ],
                        "form": "légats"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "63da23ea-b357-3e78-ba2a-66e8a032e56c",
                        "entry_id": "545c2cd0-1c48-318d-bf58-2ce15e5b427d",
                        "glosses": [
                            "Ambassadeur, lieutenant d’un commandant d'armée, ou haut fonctionnaire romain."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "14e716ea-80b6-3508-b5c0-6b939094c06c",
                        "entry_id": "545c2cd0-1c48-318d-bf58-2ce15e5b427d",
                        "glosses": [
                            "Cardinal préposé par le pape pour gouverner quelque province de l’état ecclésiastique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2088c6cc-fb0f-4c84-a1df-8bd858707818",
                                "sense_id": "14e716ea-80b6-3508-b5c0-6b939094c06c",
                                "text": "En 1145, un légat pontifical prêcha contre eux. Eudes et sa troupe d'« éonites » gagnèrent alors la Gascogne, puis la Champagne."
                            }
                        ]
                    },
                    {
                        "sense_id": "0ee1d5f4-c626-30d5-9a96-2573a7cbed04",
                        "entry_id": "545c2cd0-1c48-318d-bf58-2ce15e5b427d",
                        "glosses": [
                            "Cardinal envoyé, avec des pouvoirs extraordinaires, par le Pape auprès d’un gouvernement, à un concile, etc."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "80e38a30-4b8c-43a4-a772-7e2be59b289d",
                                "sense_id": "0ee1d5f4-c626-30d5-9a96-2573a7cbed04",
                                "text": "Parmi un concours de peuple considérable — estimé à 150 000 personnes —, la cérémonie serait présidée par S. Em. le cardinal Villeneuve, archevêque de Québec, légat de Sa Sainteté le pape Pie XII, entouré de nombreux évêques et archevêques : […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "79631ade-777a-3db4-8bc3-d87e65d2b754",
                        "entry_id": "545c2cd0-1c48-318d-bf58-2ce15e5b427d",
                        "glosses": [
                            "(vieilli) Diplomate d'un rang inférieur à celui d'ambassadeur (ministre plénipotentiaire) à la tête d'une mission diplomatique nommée légation."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2b0bb098-7abe-4e78-8381-c3209036b6de",
                        "source_entry_id": "545c2cd0-1c48-318d-bf58-2ce15e5b427d",
                        "target_lang_word": "legate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "legate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d582e00e-6934-3a4d-8532-48baa69bc5b0",
                                        "entry_id": "924f8a92-8692-335b-a17f-cd0809033059",
                                        "glosses": [
                                            "A deputy representing the pope, specifically a papal ambassador sent on special ecclesiastical missions."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1988ad6a-d8e4-3834-a951-997cf5e3500c",
                                        "entry_id": "924f8a92-8692-335b-a17f-cd0809033059",
                                        "glosses": [
                                            "An ambassador or messenger."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68d10df5-9375-44d3-af20-672f725f2c2e",
                                                "sense_id": "1988ad6a-d8e4-3834-a951-997cf5e3500c",
                                                "text": "The dark figure on the raised white terrace; legate of the sun facing the sun; the most ancient royal power."
                                            },
                                            {
                                                "example_id": "8ab7f9bf-f96d-4bd4-8c03-3422445e82e4",
                                                "sense_id": "1988ad6a-d8e4-3834-a951-997cf5e3500c",
                                                "text": "Moſt great and puiſant Monarke of the earth,\nYour Baſſoe wil accompliſh your beheſt:\nAnd ſhew your pleaſure to the Perſean,\nAs fits the Legate of the ſtately Turke."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7e12c98-371c-3cb0-8614-0cb1d07d8cbe",
                                        "entry_id": "924f8a92-8692-335b-a17f-cd0809033059",
                                        "glosses": [
                                            "The deputy of a provincial governor or general in ancient Rome."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05b9b2ba-5b7d-4fd2-81a0-02347c4fe6f6",
                                                "sense_id": "d7e12c98-371c-3cb0-8614-0cb1d07d8cbe",
                                                "text": "Legate, I had the news last night—my cohort ordered home\nBy ships to Portus Itius and thence by road to Rome."
                                            }
                                        ]
                                    }
                                ]
                            },
