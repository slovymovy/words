                        "glosses": [
                            "Full of leaps: requiring one to leap or making many leaps."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1fc956f5-fcc8-4a39-8c3c-477aa95f27d5",
                                "sense_id": "d620c21a-7d2c-34d0-8e8d-dd1bf5c5eaea",
                                "text": "Pity ('tis true) revolves their leapful springs, Smil'd thanks, attoning pray'rs, embracing clings, Sallies of guileless joy, gay gleams offense, Soft stroking flatt'ries — active impotence ;"
                            },
                            {
                                "example_id": "30761273-cc92-41b6-b571-26f034e29857",
                                "sense_id": "d620c21a-7d2c-34d0-8e8d-dd1bf5c5eaea",
                                "text": "O leapful look, assault of eye, hurdle the decorous delay."
                            },
                            {
                                "example_id": "aeed3b9b-0a40-4bb1-829f-76cde7fde5a7",
                                "sense_id": "d620c21a-7d2c-34d0-8e8d-dd1bf5c5eaea",
                                "text": "Bony rocks jut up from the water, forming a haphazard, leapful path, a path that looks like a twisted spine, to the bluff on the other side."
                            }
                        ]
                    }
