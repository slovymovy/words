                        "tags": [],
                        "examples": [
                            {
                                "example_id": "245b1cc6-6bec-4867-a069-6463869d0446",
                                "sense_id": "76cd60c8-27a3-3807-8d94-181b80ec3cdf",
                                "text": "Ik moet altijd een middagdutje doen rond een uur of drie."
                            },
                            {
                                "example_id": "5ed3a0b9-f502-4f61-a5d9-d687fba3bb25",
                                "sense_id": "76cd60c8-27a3-3807-8d94-181b80ec3cdf",
                                "text": "Dutjes zijn niet voor iedereen heilzaam. De één staat na een middagdut verkwikt weer op, de ander ontwaakt volkomen brak. Waarom, dat weten slaaponderzoekers niet. Zij kunnen wel twee algemene wenken geven aan iedereen die een dutje overweegt."
                            }
                        ]
