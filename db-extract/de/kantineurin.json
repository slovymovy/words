                        "sense_id": "50f6cb9c-30a0-3fa0-a123-7aeb6670d8f0",
                        "entry_id": "9f6a52f8-9ecc-30ab-96ed-29f638078b6e",
                        "glosses": [
                            "Betreiberin einer Kantine"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "f38f22e3-2841-4661-a231-927a0441c3e1",
                                "sense_id": "50f6cb9c-30a0-3fa0-a123-7aeb6670d8f0",
                                "text": "„\"Ich wollt' von Mozzarella und so wegkommen\", erklärt Kantineurin Gabi Rautnig, weshalb sie einen Koch aus Mauritius engagierte, ihre schon im \"Depot Café\" sehr erfolgreichen Pita-Sandwiches verfeinerte, sich Gedanken zum Thema Salat machte und auch der Suppe einen würdigen Platz auf der Karte einräumen will, etwa in Form einer kreolischen Fischsuppe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3e807e24-65f0-4b62-832b-2c3af644b1bc",
                        "source_entry_id": "9f6a52f8-9ecc-30ab-96ed-29f638078b6e",
                        "source_sense_id": "50f6cb9c-30a0-3fa0-a123-7aeb6670d8f0",
                        "source_sense_description": "Betreiberin einer Kantine",
                        "target_lang_word": "cantinière",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cantinière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e0f1df8d-734b-3be8-9c2a-3cb39b89cf29",
                                        "entry_id": "797e1530-5a2b-3f47-b1df-b5190721a75a",
                                        "glosses": [
                                            "Celle qui tient une cantine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37d1fe39-a6d7-4278-9aeb-e532c9f93fda",
                                                "sense_id": "e0f1df8d-734b-3be8-9c2a-3cb39b89cf29",
                                                "text": "– Mademoiselle m’a mise à la porte ; elle a dit que j’aille dans le préau trouver la cantinière."
                                            },
                                            {
                                                "example_id": "b8cf58bf-5764-4c83-8e26-67d9e2c96bab",
                                                "sense_id": "e0f1df8d-734b-3be8-9c2a-3cb39b89cf29",
                                                "text": "On le décrit remontant du Comtat-Venaissin et faisant un « arrestadou à Saint-Didier-en-Velay ». Là, officie « la petite Marie », cabaretière et cantinière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "961d6246-02f5-3710-b828-5cc163f792d6",
                                        "entry_id": "797e1530-5a2b-3f47-b1df-b5190721a75a",
                                        "glosses": [
                                            "Femme qui tenait la cantine d’un régiment."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5cd9dfc-76fc-4cdc-af3b-82d3c7a87075",
                                                "sense_id": "961d6246-02f5-3710-b828-5cc163f792d6",
                                                "text": "Il n’y aura jamais que deux cantinières par bataillon complet, et une pour les quatre compagnies de dépôt […]."
                                            },
                                            {
                                                "example_id": "2f5fe395-b655-43fd-b58b-0a1b7839b1ee",
                                                "sense_id": "961d6246-02f5-3710-b828-5cc163f792d6",
                                                "text": "Dans un coin, la cantinière dormait, la bouche ouverte, pelotonnée sur un banc devant sa petite table chargée de bouteilles vides et de verres troubles."
                                            },
                                            {
                                                "example_id": "1d75c139-6653-461b-862e-bd4045a09723",
                                                "sense_id": "961d6246-02f5-3710-b828-5cc163f792d6",
                                                "text": "L’alcool fit son effet car aussitôt, Bonaventure entonna un refrain repris par les autres soldats:\n« La cantinière aux beaux bras est le plaisir des jeunes soldats\nLes jeunes soldats sont militaires pour embrasser la cantinière\nGauche, droit, sabre au côté ! La cantinière se laisse baiser\nEt en avant et en avant la cantinière ! »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
