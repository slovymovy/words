        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "c18bc3e8-e896-3356-badb-190e7b86c42e",
                    "sense_definition": "A female given name, usually a diminutive of Katherine.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "name_katherine",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "My aunt <w>Kitty</w> makes the best apple pie in the whole family.",
                            "target_lang_translations": {
                                "ru": "Моя тетя <w>Китти</w> готовит лучший яблочный пирог во всей семье.",
                                "zh": "我的姑妈<w>基蒂</w>做的苹果派是全家最好吃的。"
                            }
                        },
                        {
                            "text": "She prefers to be called <w>Kitty</w> instead of her full name, Katherine.",
                            "target_lang_translations": {
                                "ru": "Она предпочитает, чтобы её называли <w>Китти</w>, а не полным именем Кэтрин.",
                                "zh": "她更喜欢别人叫她<w>基蒂</w>，而不是她的全名 Katherine。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Женское имя, обычно уменьшительная форма имени Кэтрин.",
                        "zh": "女性名字，通常是 Katherine 的昵称。"
                    },
                    "translations": {
                        "ru": [
