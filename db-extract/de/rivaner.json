                        "glosses": [
                            "in Luxemburg übliche Bezeichnung für die Rebsorte Müller-Thurgau"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5990bd1-cf15-4227-8ac8-4f0896325566",
                                "sense_id": "8c5601b0-01bf-335f-8884-99a84de832a6",
                                "text": "\"Hauptrebsorte\" in Luxemburg \"ist der Rivaner, wie der Müller-Thurgau hier heißt, der einfache Alltagsweine ergibt.\""
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
