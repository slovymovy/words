                        "entry_id": "c48ceb05-8a1d-3270-85f9-6c68704aacec",
                        "glosses": [
                            "rurka gwintowana zewnętrznie z dwóch stron, używana jako złączka w połączeniach rurowych"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "347b6f91-546c-3da4-94a9-1d7fd8037a31",
                        "entry_id": "c48ceb05-8a1d-3270-85f9-6c68704aacec",
                        "glosses": [
                            "tulejka mosiężna z przewężeniem z jednej strony i gwintowanym wewnętrznie kołnierzem z drugiej, łącząca obręcz koła roweru ze szprychą"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f670f12-bfa5-4566-9274-9290d0205916",
                                "sense_id": "347b6f91-546c-3da4-94a9-1d7fd8037a31",
                                "text": "Jak już wcześniej wspomniałem, wybrałem znakomity rower górski Gary Fisher Montare. Dostałem także wielką torbę części zapasowych: łańcuch, szprychy, nyple, ogumienie — wszystko niepotrzebnie."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
