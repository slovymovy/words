                ],
                "senses": [
                    {
                        "sense_id": "a95e28c4-f923-3719-833f-9abb2b5111a9",
                        "entry_id": "0e62fdfd-2a7a-32fa-b636-e0a07257caa7",
                        "glosses": [
                            "opnieuw tot leven komen van iets dat allang afgelopen, opgeheven of overleden was"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3631c03-95cc-4bb2-8da6-693aeaab4611",
                                "sense_id": "a95e28c4-f923-3719-833f-9abb2b5111a9",
                                "text": "De moordaanslag van gisternacht op drie politieagenten in de Atheense ‘anarchistenwijk’ Exárchia heeft allerwegen vrees gewekt voor herleving van het terrorisme, dat in 2001 met de ontmanteling van de organisatie ‘17 november’ (24 doden in 26 jaar) leek te zijn bedwongen."
                            },
                            {
                                "example_id": "13b3c40d-a31a-4891-8f4f-aaa33e4c35d4",
                                "sense_id": "a95e28c4-f923-3719-833f-9abb2b5111a9",
                                "text": "Davutoglu zei vandaag dat de wet de vrijheid van meningsuiting aantast en het begin zou inluiden van een nieuwe inquisitie in Europa. 'Als elk parlement besluiten neemt over zijn kijk op de geschiedenis, begint een nieuwe inquisitie in Europa. Helaas is de herleving een schande voor Frankrijk.'"
                            },
                            {
                                "example_id": "5b8d3f69-4163-4e2a-b432-cf08558d0c91",
                                "sense_id": "a95e28c4-f923-3719-833f-9abb2b5111a9",
                                "text": "Wie vanuit Eibergen de op/afrit van de N18 opzoekt, wordt sinds een paar dagen met de herleving van de vroegere Geldersch-Overijsselsche Lokaalspoorweg geconfronteerd. Een stuk spoorlijn aan de ene kant en een stuk aan de andere kant flankeert de N18-aansluiting."
                            },
                            {
                                "example_id": "b4e9c1c8-fef0-4c74-9f49-ddf8f01ca704",
                                "sense_id": "a95e28c4-f923-3719-833f-9abb2b5111a9",
                                "text": "Het draagt allemaal bij aan de herleving van een roemruchte periode. Daar hoort ook de aparte expositie van fotograaf Rudy Leukfeldt bij, Blues from Heaven. Heel bijzonder hoe hij Muskee heeft vereeuwigd, als heerser van Drenthe, op een hunebed."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d6090f2a-4195-4c65-bd71-f63621705b96",
                        "source_entry_id": "0e62fdfd-2a7a-32fa-b636-e0a07257caa7",
                        "source_sense_id": "a95e28c4-f923-3719-833f-9abb2b5111a9",
                        "target_lang_word": "comeback",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "comeback",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "28ed8640-9027-390f-a831-346a6e74fc54",
                                        "entry_id": "3887a6c2-c9d7-390f-83cb-c03113d8a72b",
                                        "glosses": [
                                            "A return (e.g. to popularity, success, etc.) after an extended period of obscurity or underperformance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9bc43ec-1916-4556-870e-615807f25c96",
                                                "sense_id": "28ed8640-9027-390f-a831-346a6e74fc54",
                                                "text": "That fad went out with the eighties, but I think it's making a comeback."
                                            },
                                            {
                                                "example_id": "0f587577-65a7-4a14-962f-f6c66a598e45",
                                                "sense_id": "28ed8640-9027-390f-a831-346a6e74fc54",
                                                "text": "According to rumors in the entertainment world on December 6, Girls' Generation will be making a comeback next year with a masculine concept. They have supposedly decided on the title song in their new album and have begun filming the music video on December 6. It appears they have started preparing for a full-scale comeback! It will be the girls' first Korean comeback in a year since \"I Got a Boy.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e709296-066d-37ec-ae2f-9deb1d0285ce",
                                        "entry_id": "3887a6c2-c9d7-390f-83cb-c03113d8a72b",
                                        "glosses": [
                                            "A retort or answer, particularly a quick or clever one."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f59a8b6d-bba0-4f8b-995e-dc2f1e1cecc5",
                                                "sense_id": "2e709296-066d-37ec-ae2f-9deb1d0285ce",
                                                "text": "I wish I had thought of a quick comeback for his comment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "068af6a6-39e3-3e49-8d19-5e21cac8433e",
                                        "entry_id": "3887a6c2-c9d7-390f-83cb-c03113d8a72b",
                                        "glosses": [
                                            "An occurrence of an athlete or sports team in a competition overcoming a substantial disadvantage in points to win or draw."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e5777d6-3155-49c8-9b57-4b232fe6db06",
                                                "sense_id": "068af6a6-39e3-3e49-8d19-5e21cac8433e",
                                                "text": "Newcastle produced a stunning comeback from 4-0 down to earn a draw that shocked title hopefuls Arsenal."
                                            }
                                        ]
                                    }
                                ]
                            },
