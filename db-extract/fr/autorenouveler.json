                        "glosses": [
                            "Se renouveler par soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d36e89a-b27f-41fd-915c-00ceade7ccb2",
                                "sense_id": "698fa9b8-9c06-313f-b787-d71dbfbfb87f",
                                "text": "Un écosystème en bonne santé est capable de s'autorenouveler."
                            },
                            {
                                "example_id": "d889b3fa-be54-4b80-b23b-e0ac90a3ba97",
                                "sense_id": "698fa9b8-9c06-313f-b787-d71dbfbfb87f",
                                "text": "Elles se caractérisent par leur capacité, d'une part à s'autorenouveler, c'est à dire à reproduire des CS identiques à elles-mêmes, et d'autre part à se différencier en un ou plusieurs types cellulaires spécialisés."
                            },
                            {
                                "example_id": "a6b5d77e-f6c0-4671-afa1-c0d52c31e6e4",
                                "sense_id": "698fa9b8-9c06-313f-b787-d71dbfbfb87f",
                                "text": "Prenant le contrepied des théories de la survivance, Bensa montre la vivacité et l'adaptabilité de ces cultes, leur capacité intacte d'autorenouveler leur sens et leur logique, et de dire symboliquement ce qui se dit ailleurs dans le langage de la technique."
                            }
                        ]
                    }
