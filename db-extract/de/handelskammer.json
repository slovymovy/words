                "senses": [
                    {
                        "sense_id": "2ce6a50f-27d1-3150-a375-eacd612ed179",
                        "entry_id": "244805cf-dc6b-34bb-a7fc-71a40db1c34a",
                        "glosses": [
                            "Vertretung von Wirtschaftsunternehmen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2894f312-7c09-4974-9837-5ce450e41e44",
                                "sense_id": "2ce6a50f-27d1-3150-a375-eacd612ed179",
                                "text": "„Sie ermutigt darüber hinaus jede zweckmäßige Informationstätigkeit der österreichischen Bundeswirtschaftskammer im Einvernehmen mit der Handelskammer Triest und der Autonomen Hafenbehörde von Triest auch mittels Veranstaltung von Seminaren und Austausch von Delegationen.“"
                            },
                            {
                                "example_id": "f3f45ca4-61ee-4072-b928-8b4df74d6869",
                                "sense_id": "2ce6a50f-27d1-3150-a375-eacd612ed179",
                                "text": "„Ich sagte den Vortrag ab, den ich vor der Handelskammer von Palm Springs halten sollte.“"
                            },
                            {
                                "example_id": "fb73dfee-ba29-4da4-8e66-1f2b600d1eb0",
                                "sense_id": "2ce6a50f-27d1-3150-a375-eacd612ed179",
                                "text": "„Aber sie empfanden sich als neue Elite von unten; die Macht in den Handelskammern hatten dagegen die Deutschen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
