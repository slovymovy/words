                        "sense_id": "4772e419-54f9-3218-8465-f2527729e12c",
                        "entry_id": "8e9707cf-e01d-37dc-88ff-b9e4fd97d56a",
                        "glosses": [
                            "een extra bezorging nadat een eerdere (onvolledige) bezorging heeft plaatsgevonden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94f28117-a2af-4ccf-9579-2157a8a287ad",
                                "sense_id": "4772e419-54f9-3218-8465-f2527729e12c",
                                "text": "\"Zoiets is nooit eerder gebeurd\", aldus hoofdredacteur Klaus Van Isacker. Waar voor de oorspronkelijke oplage van deze weekendkrant 120.000 exemplaren voorzien werden, werden er zaterdag nog 30.000 bijgedrukt voor naleveringen in de krantenwinkels."
                            },
                            {
                                "example_id": "10c8bfd9-50a9-4b10-adb8-6fba47459286",
                                "sense_id": "4772e419-54f9-3218-8465-f2527729e12c",
                                "text": "Nu komt het voor dat soldaten bij opkomst hun schoenen ‘op nalevering’ krijgen - doordat de voorraden zijn geslonken. Dat betekent dus dat nieuwe soldaten beginnen zonder hun laarzen. Dan schaam ik mij als commandant echt kapot.’"
                            }
                        ]
                    }
