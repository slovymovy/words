                                "target_senses": [
                                    {
                                        "sense_id": "3bf8497a-137d-3c44-8b43-6aea92131fd8",
                                        "entry_id": "44894a1f-7090-3444-bf4b-f30cdec2ad74",
                                        "glosses": [
