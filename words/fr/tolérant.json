            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4870d410-7bb7-3695-bf05-83235d5fa28a",
                    "sense_definition": "Qui se montre indulgent, compréhensif et admet chez autrui des manières de penser ou de vivre différentes des siennes.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "indulgence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nos professeurs essaient d'être <w>tolérants</w> face aux petites erreurs des élèves."
                        },
                        {
                            "text": "Mon grand-père a un esprit très <w>tolérant</w> et écoute toujours l'avis des autres."
                        }
                    ],
                    "synonyms": [
                        "compréhensif",
                        "indulgent",
                        "ouvert"
                    ],
                    "antonyms": [
                        "intolérant"
                    ],
                    "common_phrases": [
                        "esprit tolérant"
                    ]
                },
                {
                    "sense_id": "217e7069-329f-3e0a-9ae6-3e150bca7085",
                    "sense_definition": "Qui accepte et respecte la liberté de conscience ainsi que les croyances religieuses différentes des siennes.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "indulgence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette ville historique abritait une société <w>tolérante</w> où plusieurs religions coexistaient pacifiquement."
                        },
                        {
                            "text": "Il est resté profondément croyant mais toujours <w>tolérant</w> envers ceux qui pensent différemment."
                        }
                    ],
                    "antonyms": [
                        "intolérant"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4361d5c4-57d2-3bb3-b903-477002329eda",
                    "sense_definition": "Participe présent de <w>tolérer</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En <w>tolérant</w> de tels retards, la direction a créé de mauvaises habitudes dans l'équipe."
                        },
                        {
                            "text": "Il a réussi à apaiser le conflit en <w>tolérant</w> les critiques sans s'énerver."
