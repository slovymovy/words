                ],
                "senses": [
                    {
                        "sense_id": "c021f6e2-7720-3a82-9f8b-a8bfcf0c7d62",
                        "entry_id": "63907e1a-4d91-34e1-a9a3-7aad913351c9",
                        "glosses": [
                            "Se conditionner soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42d2ad1a-c369-4459-a678-4d6739f455f9",
                                "sense_id": "c021f6e2-7720-3a82-9f8b-a8bfcf0c7d62",
                                "text": "Il insiste sur le fait que l'homme peut retarder sa réponse, choisir entre plusieurs réponses, qu'il peut s'auto-stimuler, s'auto-conditionner."
                            },
                            {
                                "example_id": "5cb75f39-4bd7-4d19-a506-421c02eb8714",
                                "sense_id": "c021f6e2-7720-3a82-9f8b-a8bfcf0c7d62",
                                "text": "Comprendre l'impact des postures sur les émotions éprouvées : savoir s'auto-conditionner pour se réguler."
                            },
                            {
                                "example_id": "dacf422e-5ad1-40f7-bd33-badebfbf939b",
                                "sense_id": "c021f6e2-7720-3a82-9f8b-a8bfcf0c7d62",
                                "text": "\"En politique, quelle est la différence entre suivre la ligne d'un parti et s'auto-conditionner ?"
                            }
                        ]
                    }
                ],
