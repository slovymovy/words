                "forms": [],
                "senses": [
                    {
                        "sense_id": "3b24116f-937f-3bde-ab09-3be4a8a7b4b7",
                        "entry_id": "bcc682ef-3f35-386b-a18f-53f45582dd10",
                        "glosses": [
                            "Participe passé masculin singulier du verbe coordonner."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "a5086f42-7a76-4cae-a2cd-485cb806904c",
                                "sense_id": "3b24116f-937f-3bde-ab09-3be4a8a7b4b7",
                                "text": "Et c’est le nouveau sous-préfet de Marmande Nérac, Michel Gouriou, qui a chapeauté et coordonné sur place les opérations après cette sortie de route, « dont nous ne connaissons pas à ce stade la raison et que l’enquête devra déterminer »."
                            }
                        ]
                    }
