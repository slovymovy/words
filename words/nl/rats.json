                    "frequency": "VeryLow",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>rats</w> de bladeren snel bij elkaar voordat het begint te regenen.",
