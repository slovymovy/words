                "senses": [
                    {
                        "sense_id": "4f6ae9a7-fe2b-3ee9-b088-1b4f7fe83e47",
                        "entry_id": "cce52b85-b6f3-32b7-a87d-2fb0824cbf11",
                        "glosses": [
                            "Faire revenir à une vision normale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac44510a-946c-4e6f-a02f-62dd4c5586d9",
                                "sense_id": "4f6ae9a7-fe2b-3ee9-b088-1b4f7fe83e47",
                                "text": "À l’issue du calcul donné par la biométrie, on obtient la vergence théorique de l’implant qui peut emmétropiser l’œil examiné."
                            },
                            {
                                "example_id": "d8552e5b-8db4-4a5a-8fb5-60911b83f9de",
                                "sense_id": "4f6ae9a7-fe2b-3ee9-b088-1b4f7fe83e47",
                                "text": "On choisit donc soit d’emmétropiser le patient de loin (95 % des cas) ou de près (< 5 % des cas) : il voit bien de loin sans correction, mais nécessite une addition de près, soit l'inverse : il voit bien de près sans correction et nécessite une correction de loin."
                            }
                        ]
                    }
