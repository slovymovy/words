                    },
                    {
                        "translation_id": "6c8db9e9-fd0c-4fae-b51c-72568e498a9e",
                        "source_entry_id": "6c1da12e-3b17-3109-b198-204ddb43887a",
                        "source_sense_id": "c36e6357-2073-36f9-9b38-331a9d845a34",
                        "source_sense_description": "lange Reihe von Personen",
                        "target_lang_word": "queue",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "queue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6798c437-6248-3843-bbd4-dd08ad0dbc26",
                                        "entry_id": "d9923511-f4e5-3fab-9645-50220177cd6f",
                                        "glosses": [
                                            "Appendice postérieur, plus ou moins développé, qui termine la colonne vertébrale d’un très grand nombre de vertébrés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18e7d89c-e6d8-47a9-90ba-371bfc15e50b",
                                                "sense_id": "6798c437-6248-3843-bbd4-dd08ad0dbc26",
                                                "text": "C’est un étalon barbe, pas grand, mais bien formé et bien musclé, un alezan étoile de blanc au front, dont la robe dorée, la queue et la crinière blondes, longues et fournies, reluisent au soleil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8d1e65e-2655-3c7f-99bb-8a8d5c01b0c0",
                                        "entry_id": "d9923511-f4e5-3fab-9645-50220177cd6f",
                                        "glosses": [
                                            "Plat, mets avec cet organe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1cdd1f94-d001-4dbd-a343-20a250afe66d",
                                                "sense_id": "c8d1e65e-2655-3c7f-99bb-8a8d5c01b0c0",
                                                "text": "Servir une queue de mouton. Potage de queue de bœuf. Queue de bœuf en hochepot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9eedf215-f8dd-3905-b7f5-ff5a30f0c49b",
                                        "entry_id": "d9923511-f4e5-3fab-9645-50220177cd6f",
                                        "glosses": [
                                            "Grandes plumes qui sortent du croupion des oiseaux et qui leur servent pour se diriger dans l’air."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24053ba7-4a7f-4bac-b4ed-30285a680e03",
                                                "sense_id": "9eedf215-f8dd-3905-b7f5-ff5a30f0c49b",
                                                "text": "La queue des hirondelles est fourchée. Une queue de paon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e0e2483-cf33-3742-b2e7-d6a82c38d26b",
                                        "entry_id": "d9923511-f4e5-3fab-9645-50220177cd6f",
                                        "glosses": [
                                            "Partie qui s’étend du ventre jusqu’à l’extrémité opposée à la tête, chez les poissons, les cétacés, les serpents et quelques insectes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba37ed38-2db8-4150-9958-deaae9499ab7",
                                                "sense_id": "3e0e2483-cf33-3742-b2e7-d6a82c38d26b",
                                                "text": "Queue de saumon. Une baleine peut renverser une barque d’un coup de queue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d2129d0-4553-34ea-8b48-ed7aba762d86",
                                        "entry_id": "d9923511-f4e5-3fab-9645-50220177cd6f",
                                        "glosses": [
                                            "Partie mobile d'un animalcule, qui sert à sa locomotion."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a82a92d4-554b-47f3-a355-001b6d6f30db",
                                                "sense_id": "7d2129d0-4553-34ea-8b48-ed7aba762d86",
                                                "text": "L’œuf pondu par une ascidie composée s’organise rapidement, […]. Comme chez la hermelle et le taret, il se change en larve de toutes pièces ; cette larve à corps ovalaire est munie d’une longue queue qui lui donne quelque ressemblance avec un têtard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d0f77e7-14f8-33cc-8d9c-48b948025e6d",
                                        "entry_id": "d9923511-f4e5-3fab-9645-50220177cd6f",
                                        "glosses": [
                                            "Choses qui ont quelque rapport (de ressemblance ou de position) avec cet appendice :"
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3d1c21b-9529-471e-979d-b5613ac75432",
                                                "sense_id": "6d0f77e7-14f8-33cc-8d9c-48b948025e6d",
                                                "text": "La queue d’une poêle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "007cc69f-068c-31a7-8aea-ed6ac984e2b1",
                                        "entry_id": "d9923511-f4e5-3fab-9645-50220177cd6f",
                                        "glosses": [
                                            "Se dit des cheveux à l’arrière de la tête, lorsqu’ils sont attachés ensemble près du crâne. Longue tresse que portent les hommes en Extrême-Orient."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8de99f9e-6900-4da3-b6f7-95400f0e99da",
                                                "sense_id": "007cc69f-068c-31a7-8aea-ed6ac984e2b1",
                                                "text": "Une perruque à queue."
                                            },
                                            {
                                                "example_id": "2547156a-aefc-41be-86de-8d2ccb417ad1",
                                                "sense_id": "007cc69f-068c-31a7-8aea-ed6ac984e2b1",
                                                "text": "Dans la plus triste des chambres éclairées par ces vitres sales, on trouvait, devant un ancien bureau de Boule, un grand homme sec, portant par principe politique, de la poudre et une queue ; car il avouait souvent et avec plaisir que les cheveux courts et sans poudre étaient bien plus commodes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5d5f4aa-4fc1-369f-bda0-c4543a0f9161",
                                        "entry_id": "d9923511-f4e5-3fab-9645-50220177cd6f",
                                        "glosses": [
                                            "Canne, flèche ou tige avec laquelle le joueur pousse les billes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4f27682-f9cd-4bcb-b273-d1e8d06d5bf2",
                                                "sense_id": "f5d5f4aa-4fc1-369f-bda0-c4543a0f9161",
                                                "text": "Comme on passait au billard, elle se trouva à côté de Leuwen et séparée du reste de la société ; les hommes étaient occupés à choisir des queues, elle se trouva seule à côté de Lucien."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f7de6e2-1777-3ac6-bb5b-044281f8a97a",
                                        "entry_id": "d9923511-f4e5-3fab-9645-50220177cd6f",
                                        "glosses": [
                                            "Pénis, sexe de l’homme."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7dc48cd8-0824-4f5e-8496-e3fc03a0a4bf",
                                                "sense_id": "9f7de6e2-1777-3ac6-bb5b-044281f8a97a",
                                                "text": "Le plus beau con de la famille, c’est le sien ; et je mouille pour elle quand elle ôte sa chemise, moi qui ne suis pas gousse, moi qui aime la queue."
                                            },
                                            {
                                                "example_id": "3455b6ec-cbca-4460-970a-35b544a8f372",
                                                "sense_id": "9f7de6e2-1777-3ac6-bb5b-044281f8a97a",
                                                "text": "Revues de chaussures (Vous manque un clou là, jeune homme ! N’en compte que quatorze ! Comment se fait-il ?), revues de sacs à brosses et de musettes, revues de paquetages, revues de ceci, revues de cela, mais point de revues d’orteils, de nombrils, de trompes d’Eustache… Ou de revues de queues, selon le terme en vigueur."
                                            },
                                            {
                                                "example_id": "2c0df3c5-972c-40f1-bfe6-94efba598f48",
                                                "sense_id": "9f7de6e2-1777-3ac6-bb5b-044281f8a97a",
                                                "text": "L’une des héroïnes des Mille et une nuits fait même l’éloge de la queue, en lui donnant toutes sortes de sobriquets : le Bélier, le Forgeron, le Père au turban, le Père des délices. Chez les Tunisiens, on parle aussi du Timide, du Pleureur, du Remuant, de l’Inspecteur, du Frotteur, du Guérisseur de l’envie, du Borgne et du Chauve."
                                            },
                                            {
                                                "example_id": "4c5837a0-4c91-4ef4-b4a5-56877b932951",
                                                "sense_id": "9f7de6e2-1777-3ac6-bb5b-044281f8a97a",
                                                "text": "Avais-je couché avec le travesti latino ? M’avait-il/elle sucé la queue pendant que j’étais dans le coaltar ? En étais-je réellement arrivé là : capable de n’importe quoi, totalement irrécupérable ?"
                                            },
                                            {
                                                "example_id": "091c628e-4560-49cd-a650-5bf63dc704f0",
                                                "sense_id": "9f7de6e2-1777-3ac6-bb5b-044281f8a97a",
                                                "text": "Mutatis mutandis, Hélène fut à M&mnoux ce que Judith Toumignon était à Clochemerle, sans atteindre la chaudasserie extrême de la Jacqueline de La Terre de Zola, qui se fait sauter du soir au matin par tout ce qui porte une queue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5709cbc5-6e5e-3579-95de-660ba563f1d0",
                                        "entry_id": "d9923511-f4e5-3fab-9645-50220177cd6f",
                                        "glosses": [
                                            "Le trait qui part du corps d’une note et monte ou descend, perpendiculairement aux lignes de la portée."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ce78ce6d-cdfd-3293-ac39-61f77ace3f46",
                                        "entry_id": "d9923511-f4e5-3fab-9645-50220177cd6f",
                                        "glosses": [
                                            "Ce qui dépasse par en bas du corps de certaines lettres (« g, j, p, q, y ») ou certain chiffre (« 9 »)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "586f51e4-03f5-4a27-87a6-facf090dba89",
                                                "sense_id": "ce78ce6d-cdfd-3293-ac39-61f77ace3f46",
                                                "text": "— Vas-y, Chalume, fous-moi une queue à mon zéro de chimie, disait Faouen. Ça t’coûte rien, non !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35225cd5-ac72-3734-a162-fb5c40b3334a",
                                        "entry_id": "d9923511-f4e5-3fab-9645-50220177cd6f",
                                        "glosses": [
                                            "Extrémité d’une pierre longue, entrant dans la construction d’un mur ou d’une voûte."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "104773b7-1fa0-359c-9091-d6928ba4b6a9",
                                        "entry_id": "d9923511-f4e5-3fab-9645-50220177cd6f",
                                        "glosses": [
                                            "Longue traînée lumineuse qui accompagne la tête d’une comète."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5cc23c74-16eb-4027-b257-f4ceff1e7938",
                                                "sense_id": "104773b7-1fa0-359c-9091-d6928ba4b6a9",
                                                "text": "Cette comète avait la queue tournée vers l’orient."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a0a3508-2c38-33b6-98dd-c7d3d5ce7b0b",
                                        "entry_id": "d9923511-f4e5-3fab-9645-50220177cd6f",
                                        "glosses": [
                                            "Partie arrière du fuselage, et plus particulièrement l’empennage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "990595f1-a2df-44a8-b91f-21f2e31b81ae",
                                                "sense_id": "2a0a3508-2c38-33b6-98dd-c7d3d5ce7b0b",
                                                "text": "Sur le bord du fleuve […] il rencontra un autre aéroplane qui lui parut à peine endommagé […] Il reposait là, abandonné, et l’eau clapotait sur l’extrémité de sa longue queue."
                                            },
                                            {
                                                "example_id": "c75c1120-5d1c-4027-952e-1ef32a2ef213",
                                                "sense_id": "2a0a3508-2c38-33b6-98dd-c7d3d5ce7b0b",
                                                "text": "Un arbre, par-ci par-là, rompait la monotonie des arbustes alignés, mais quelque chose qui n’était pas un arbre se dressait vers le ciel : la queue d’un avion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d191bcf6-f0b6-38f8-9a9f-25e66d383b26",
                                        "entry_id": "d9923511-f4e5-3fab-9645-50220177cd6f",
                                        "glosses": [
                                            "Languette."
                                        ],
                                        "tags": [
                                            "Chancellerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "029968d3-e87a-49bf-a90a-1baaff9157f7",
                                                "sense_id": "d191bcf6-f0b6-38f8-9a9f-25e66d383b26",
                                                "text": "Lettre scellée sur simple queue, celle dont le sceau est sur la partie du parchemin coupée en forme de queue."
                                            },
                                            {
                                                "example_id": "c13dc6e5-5e59-49b5-b7b6-5e2cdfddc07a",
                                                "sense_id": "d191bcf6-f0b6-38f8-9a9f-25e66d383b26",
                                                "text": "Lettre scellée sur double queue, celle dont le sceau est sur une bande de parchemin qui passe au travers de la lettre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1858c311-0ef5-3249-96bf-aa0444ee5a1d",
                                        "entry_id": "d9923511-f4e5-3fab-9645-50220177cd6f",
                                        "glosses": [
                                            "Pétiole ou pédoncule des fleurs, feuilles ou fruits, qui les relie à la plante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f1b12b5-3b0a-4f40-bd28-f8600f63963e",
                                                "sense_id": "1858c311-0ef5-3249-96bf-aa0444ee5a1d",
                                                "text": "[…] je m’amusais à mâcher des raisins et à chiquenauder les queues à travers la chambre."
                                            },
                                            {
                                                "example_id": "ebd6fca8-7593-428f-9887-123106fdda45",
                                                "sense_id": "1858c311-0ef5-3249-96bf-aa0444ee5a1d",
                                                "text": "Une queue de cerise. Il ne faut pas couper la queue des fruits qu’on veut garder."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d44f3c01-31a5-3f9b-a14a-f7060db63789",
                                        "entry_id": "d9923511-f4e5-3fab-9645-50220177cd6f",
                                        "glosses": [
                                            "Tige des fleurs cueillies."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "13ed84a0-d3be-3aa7-b340-fb5e57dd40dc",
                                        "entry_id": "d9923511-f4e5-3fab-9645-50220177cd6f",
                                        "glosses": [
                                            "Fin, bout d’une chose."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fdafc84c-9460-472f-bff9-73d5e143cbe7",
                                                "sense_id": "13ed84a0-d3be-3aa7-b340-fb5e57dd40dc",
                                                "text": "La queue du bois, de l’hiver, d’un cortège. Produits de queue. La queue d’une onde de choc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f03f4770-19ca-3a7b-8000-66dc33f5ad53",
                                        "entry_id": "d9923511-f4e5-3fab-9645-50220177cd6f",
                                        "glosses": [
                                            "Traîne d’une robe."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df8a3d7f-911b-460a-85ad-dfd4acf2af01",
                                                "sense_id": "f03f4770-19ca-3a7b-8000-66dc33f5ad53",
                                                "text": "Les prélats, les princesses, etc., se font porter la queue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2443e574-4468-31ad-875a-3d111afc9630",
                                        "entry_id": "d9923511-f4e5-3fab-9645-50220177cd6f",
                                        "glosses": [
                                            "Dernière partie les derniers rangs d’une file, d’un cortège, d’une compagnie, d’un corps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "726bb2b6-47b0-4a7d-8a24-ad17ed3297ba",
                                                "sense_id": "2443e574-4468-31ad-875a-3d111afc9630",
                                                "text": "La queue d’une procession, d’un cortège, d’un convoi. La queue d’un régiment, d’une armée. Attaquer une armée en queue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b230739-31f9-3373-a51a-0b77c01537f6",
                                        "entry_id": "d9923511-f4e5-3fab-9645-50220177cd6f",
                                        "glosses": [
                                            "Dernier ou plus médiocre élément de quelque chose."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eaca4325-1b32-43a1-939e-bd8172573c1c",
                                                "sense_id": "0b230739-31f9-3373-a51a-0b77c01537f6",
                                                "text": "Des vignes, à Nogent, j’en ai jamais vu la queue d’une."
                                            },
                                            {
                                                "example_id": "71518b3e-145a-44e4-9e92-16f180a4dc1f",
                                                "sense_id": "0b230739-31f9-3373-a51a-0b77c01537f6",
                                                "text": "Elle n'avait en rien conforté la thèse du rédacteur en chef, considérant leur rencontre au salon de thé comme une tentative de manipulation par un pseudo-privé en manque de clientèle et qui avançait des révélations sans la queue d'une preuve. Autant dire, intox, bidon, pipeau et couille de loup dans le jargon professionnel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b99d15f7-40af-3a1f-9101-8c5ad0fea35e",
                                        "entry_id": "d9923511-f4e5-3fab-9645-50220177cd6f",
                                        "glosses": [
                                            "Rang, alignement, file d’attente."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93f35202-95fe-49e3-90a9-811df04ae80c",
                                                "sense_id": "b99d15f7-40af-3a1f-9101-8c5ad0fea35e",
                                                "text": "La queue du Romantisme. Il est à la queue de sa classe."
                                            },
                                            {
                                                "example_id": "f0d316b0-e160-4799-9742-bfbe7e42e5cf",
                                                "sense_id": "b99d15f7-40af-3a1f-9101-8c5ad0fea35e",
                                                "text": "La foule est si grande dans cet étroit espace, resserré entre le salon et la chaussée des voitures, qu’on a souvent peine à porter la main à sa poche pour prendre son mouchoir ; il faut emboîter le pas et suivre la file comme à une queue de théâtre (au temps où les théâtres avaient des queues)."
                                            },
                                            {
                                                "example_id": "776401bd-f120-4b9e-87ab-8600131a2d2f",
                                                "sense_id": "b99d15f7-40af-3a1f-9101-8c5ad0fea35e",
                                                "text": "Que font ces gens, devant ce magasin? Ils font la queue, une queue qui s’étend jusqu’à la rue prochaine. Ils sont là de deux ou trois cents, très calmes, patients, qui attendent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41f86036-5776-3b25-b4bb-8795541fc448",
                                        "entry_id": "d9923511-f4e5-3fab-9645-50220177cd6f",
                                        "glosses": [
                                            "Au piquet et autres jeux de cartes, somme indépendante de l’enjeu principal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e25ae4b9-f38e-426e-996e-cdbc887e8602",
                                                "sense_id": "41f86036-5776-3b25-b4bb-8795541fc448",
                                                "text": "Queue des jetons, des paris, la totalité des jetons ou paris, qui revient au joueur gagnant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5fc1498b-b733-3a70-9e98-579d52aecf3c",
                                        "entry_id": "d9923511-f4e5-3fab-9645-50220177cd6f",
                                        "glosses": [
                                            "Nom donné à la partie ou à la tranche inférieure d’un volume ; tranche de queue."
                                        ],
                                        "tags": [
                                            "Reliure"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba289231-43b8-41c2-b29d-70ee076f6d53",
                                                "sense_id": "5fc1498b-b733-3a70-9e98-579d52aecf3c",
                                                "text": "La tranche de queue est la partie sur laquelle repose un livre debout."
                                            },
                                            {
                                                "example_id": "4b5b8cce-86eb-407c-a423-4c9ad2bcd638",
                                                "sense_id": "5fc1498b-b733-3a70-9e98-579d52aecf3c",
                                                "text": "Les livres doivent être stockés verticalement sur la tranche de queue. Il est conseillé de stocker à plat les volumes dont la hauteur dépasse 400 mm."
                                            }
                                        ]
                                    }
                                ]
                            },
