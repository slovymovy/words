{
    "word_family": [
        "naar",
        "naarheid"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "15844d98-3e99-36b5-bf05-1af2951e10bf",
                    "sense_definition": "Een toestand van ellende, verdriet of grote problemen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ellende",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij vertelt Job niet waarom hem al die <w>narigheid</w> is overkomen.",
                            "target_lang_translations": {
                                "en": "He doesn't tell Job why all that <w>misery</w> has happened to him."
                            }
                        },
                        {
                            "text": "Na jaren van <w>narigheid</w> en financiële zorgen vond de familie eindelijk rust.",
                            "target_lang_translations": {
                                "en": "After years of <w>trouble</w> and financial worries, the family finally found peace."
                            }
                        }
                    ],
                    "synonyms": [
                        "akeligheid"
                    ],
                    "antonyms": [
                        "voorspoed",
                        "geluk"
                    ],
                    "common_phrases": [
                        "veel narigheid",
                        "alle narigheid"
                    ],
                    "target_lang_definitions": {
                        "en": "A state of misery, sadness, or great problems."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "misery",
                                "target_lang_sense_clarification": "great unhappiness or distress"
                            },
                            {
                                "target_lang_word": "wretchedness",
                                "target_lang_sense_clarification": "a state of extreme misfortune"
                            },
                            {
                                "target_lang_word": "trouble",
                                "target_lang_sense_clarification": "serious problems or difficulties"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5b768d45-3800-304f-8f15-56d9fd12eb4f",
                    "sense_definition": "Iets wat als zeer onprettig of vervelend wordt ervaren.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "onprettigheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De regen zorgde voor de nodige <w>narigheid</w> tijdens onze kampeervakantie.",
                            "target_lang_translations": {
                                "en": "The rain caused quite some <w>unpleasantness</w> during our camping holiday."
                            }
                        },
                        {
                            "text": "Ik wil liever geen <w>narigheid</w> veroorzaken door over dat onderwerp te beginnen.",
                            "target_lang_translations": {
                                "en": "I'd rather not cause any <w>trouble</w> by bringing up that subject."
                            }
                        }
                    ],
                    "synonyms": [
                        "akeligheid"
                    ],
                    "antonyms": [
                        "plezier"
                    ],
                    "common_phrases": [
                        "geen narigheid",
                        "nodige narigheid"
                    ],
                    "target_lang_definitions": {
                        "en": "Something that is experienced as very unpleasant or annoying."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "trouble",
                                "target_lang_sense_clarification": "unpleasantness or difficulty"
                            },
                            {
                                "target_lang_word": "misery",
                                "target_lang_sense_clarification": "unpleasant circumstances"
                            },
                            {
                                "target_lang_word": "unpleasantness",
                                "target_lang_sense_clarification": "something disagreeable or annoying"
                            }
                        ]
                    }
                }
            ]
        }
    ]
