                "senses": [
                    {
                        "sense_id": "6715596a-1131-3155-acbe-92d656ae60e9",
                        "entry_id": "8047b5d9-01eb-3649-8f2c-7ad37e9c2365",
                        "glosses": [
                            "Wahrnehmung von Geruch in der Umgebungsluft oder an sich selbst, der nach verbranntem Schwefel riecht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbc715b8-89a1-41f5-b3b3-b2807bd2ae7d",
                                "sense_id": "6715596a-1131-3155-acbe-92d656ae60e9",
                                "text": "„Über Köln hängt offenbar ein stechender Schwefelgeruch - viele Anwohner rufen bei der Feuerwehr an, vor allem aus dem Süden der Stadt. “"
                            },
                            {
                                "example_id": "76982221-6139-45ff-9a4c-a4703cf2cd74",
                                "sense_id": "6715596a-1131-3155-acbe-92d656ae60e9",
                                "text": "„Denn dann war es vorbei, wiederholt der Busfahrer, und ich meine, einen leichten, von seinen Händen ausgehenden Schwefelgeruch zu riechen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
