                "senses": [
                    {
                        "sense_id": "67731b69-3adf-3c82-855b-32390e453e96",
                        "entry_id": "a4fc345c-ee5c-3411-927b-da7d470b4797",
                        "glosses": [
                            "balzendes Verhalten von Tieren am Abend oder in der Dämmerung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d913b6b9-6f8b-4cdb-8488-f761e19019f8",
                                "sense_id": "67731b69-3adf-3c82-855b-32390e453e96",
                                "text": "„Balzt der Hahn am Abend, so ist es die Abendbalz, in der Frühe die Frühbalz, zu Baum die Hochbalz, zu Boden die Bodenbalz, am Tage bei vollem Sonnenschein die Sonnenbalz.“"
                            },
                            {
                                "example_id": "d901ac38-6f04-45b0-81d3-c48ab5c7a45c",
                                "sense_id": "67731b69-3adf-3c82-855b-32390e453e96",
                                "text": "„Ich gab noch etwa 20 Minuten zu und wollte das Knappen oder die Abendbalz abwarten.“"
                            },
                            {
                                "example_id": "5d6ac4b8-337a-418e-a846-e189110c836f",
                                "sense_id": "67731b69-3adf-3c82-855b-32390e453e96",
                                "text": "„Während der Balzzeit unterscheiden wir Frühbalz, Abendbalz, Hochbalz, Bodenbalz, Vor-, Haupt- und Nachbalz.“"
                            },
                            {
                                "example_id": "d0df69e0-5590-4a7d-a42d-6a8694eaa9a3",
                                "sense_id": "67731b69-3adf-3c82-855b-32390e453e96",
                                "text": "„Im Anschluß an die Abendbalz fliegt das ♂ regelmäßig zur Jagd, und am Horstfelsen tritt Ruhe ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
