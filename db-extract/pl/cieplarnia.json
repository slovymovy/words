                        "entry_id": "223248a5-2406-35eb-b8f5-41982c519796",
                        "glosses": [
                            "szklarnia, całkowicie lub częściowo przeszklony budynek, posiadający ogrzewanie, służący do uprawy roślin niezależnie od temperatury otoczenia"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "add76244-b5ef-41fa-bbac-6da42a9c8c1e",
                                "sense_id": "52fd97a9-930c-32ca-b0ba-c645b829285f",
                                "text": "Policja aresztowała go, bo hodował konopie indyjskie w cieplarni."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
