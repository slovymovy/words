                "senses": [
                    {
                        "sense_id": "f174efca-19ca-3b37-a81a-5c5a957b9fa6",
                        "entry_id": "f0fc9ca5-03d1-330d-8d0e-4684ca798c88",
                        "glosses": [
                            "Einst besondere Kolonie-Art (besonders in Nordamerika); eine Kolonie, bei welcher das Rechtsverhältnis zwischen dem König und der Kolonie durch eine, einer Verfassung ähnelnden, Urkunde (Charta, engl. charter) geregelt war."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5e927f0-0865-473f-a98d-411b0035ccc1",
                                "sense_id": "f174efca-19ca-3b37-a81a-5c5a957b9fa6",
                                "text": "Connecticut und Rhode-Island waren einmal Charter-Kolonien."
                            },
                            {
                                "example_id": "82269c5a-a8d3-40f9-a852-33f4f79e556c",
                                "sense_id": "f174efca-19ca-3b37-a81a-5c5a957b9fa6",
                                "text": "Etwa zeitgleich und durchaus in gegenseitiger Kenntnis voneinander entwickelte sich weiter nördlich ein völlig anderer Typ englischer Kolonie: der der radikal protestantischen Charter-Kolonie."
                            },
                            {
                                "example_id": "d18c307d-dd06-44e7-973e-f52c44be473a",
                                "sense_id": "f174efca-19ca-3b37-a81a-5c5a957b9fa6",
                                "text": "[…] und das Sultanat Brunei (seit 1888) als Schutzstaaten, die Kronkolonie Labuan (seit 1846), zu Brunei gehörig, und die Charter-Kolonie British North Borneo (seit 1881), nach dem Zweiten Weltkrieg, gleich Sarawak, Kronkolonie."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
