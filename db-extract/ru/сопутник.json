                "senses": [
                    {
                        "sense_id": "ec3f8c0c-607a-3835-81b0-064c84fb8307",
                        "entry_id": "2334088c-92f0-3ec0-91de-7409b551e083",
                        "glosses": [
                            "книжн., поэт., устар. спутник"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f281428-3f3a-41df-b9c9-a4ca4105e4e9",
                                "sense_id": "ec3f8c0c-607a-3835-81b0-064c84fb8307",
                                "text": "Плывучи к берегу среди радости и восторга спасения, Павел — так звали спасшего нас сопутника — рассказал нам следующее:"
                            },
                            {
                                "example_id": "0577afd1-afa6-4f43-8635-693b26f6a0f2",
                                "sense_id": "ec3f8c0c-607a-3835-81b0-064c84fb8307",
                                "text": "Теон… вдруг видит Эсхина, и вмиг узнает сопутника юныя жизни."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5a008d83-9c18-41fb-a6d6-0d86fc388d32",
                        "source_entry_id": "2334088c-92f0-3ec0-91de-7409b551e083",
                        "source_sense_id": "ec3f8c0c-607a-3835-81b0-064c84fb8307",
                        "target_lang_word": "companion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
