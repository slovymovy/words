                                        "entry_id": "0f992a03-8223-3787-b2a2-11eda7ea12d8",
                                        "glosses": [
                                            "In an official manner; according to official rules or regulations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fcb1266-af36-4518-8dec-ecc9f9f3f069",
                                                "sense_id": "06fda80d-e398-3392-85f9-00ec85b21618",
                                                "text": "[T]here was nothing to drink except orange crush - officially."
                                            },
                                            {
                                                "example_id": "506ca26a-9cf5-4f98-b841-1da9e650766b",
                                                "sense_id": "06fda80d-e398-3392-85f9-00ec85b21618",
                                                "text": "Wearing his best suit and sunglasses, the sultan of Slowjamastan officially declared independence from the United States of America at 12:26 p.m. on December 1, 2021 as he broadcast the secession live from his open-air government “office” in Dublândia, the capital of the Republic of Slowjamastan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a443be1e-91cd-3ef1-9b87-3f59915b01c6",
                                        "entry_id": "0f992a03-8223-3787-b2a2-11eda7ea12d8",
                                        "glosses": [
                                            "Thoroughly, completely."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f2212ae-a9f4-41ea-873b-b44b60247f5b",
                                                "sense_id": "a443be1e-91cd-3ef1-9b87-3f59915b01c6",
                                                "text": "That’s it! I’m officially outraged."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
