                    },
                    {
                        "translation_id": "016a4a87-9f08-4486-bf57-1e463706758a",
                        "source_entry_id": "2f25bbf8-4bed-3189-ae79-3261f3417149",
                        "source_sense_id": "5fea388f-5076-3538-bf9c-64fe809e69f1",
                        "target_lang_word": "gemeinschaftlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gemeinschaftlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "942567c7-e0d8-3734-8a64-61719970d449",
                                        "entry_id": "286c214a-bf87-3a79-bdc9-05a9455bf4c2",
                                        "glosses": [
                                            "von mehreren Personen gemeinsam durchgeführt oder mehreren Personen gemeinsam gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b355845a-891f-477c-9ac5-6eb4b2e9f8d3",
                                                "sense_id": "942567c7-e0d8-3734-8a64-61719970d449",
                                                "text": "Die Staatsanwaltschaft äußerte in ihrem Plädoyer, dass der Angeklagte einen gemeinschaftlichen heimtückischen Mord aus Habgier begangen habe. Es sei unwichtig, wer genau auf das Opfer geschossen habe, da beide Täter gemeinschaftlich gehandelt hätten."
                                            },
                                            {
                                                "example_id": "f0b56abe-48c7-4464-9ec6-add6a6bb0912",
                                                "sense_id": "942567c7-e0d8-3734-8a64-61719970d449",
                                                "text": "Die Täter trugen bei ihrer Festnahme außerdem mehrere Molotowcocktails bei sich, weswegen sie wegen gemeinschaftlicher Sachbeschädigung und versuchter schwerer Brandstiftung und gefährlicher Körperverletzung vor Gericht gestellt wurden."
                                            },
                                            {
                                                "example_id": "2c5105f8-f37f-4d71-b19a-b7745f485428",
                                                "sense_id": "942567c7-e0d8-3734-8a64-61719970d449",
                                                "text": "„Wir haben gemeinschaftlich an diesem Projekt gearbeitet, wir teilen auch die Erfolge daraus zusammen.“"
                                            },
                                            {
                                                "example_id": "9260472a-44d7-4297-8912-67378eb4bbcb",
                                                "sense_id": "942567c7-e0d8-3734-8a64-61719970d449",
                                                "text": "Wikipedia-Gründer Jimmy Wales hat einem Interview mit dem Toronto Star zufolge gesagt, dass er eine „stabile“ Ausgabe der gemeinschaftlich erstellten Enzyklopädie in Erwägung ziehe."
                                            },
                                            {
                                                "example_id": "1efa7900-dc32-469f-bfa6-5279f6bb6a4b",
                                                "sense_id": "942567c7-e0d8-3734-8a64-61719970d449",
                                                "text": "In deutschen Städten entstehen vermehrt Wohnprojekte, in denen mehrere Generationen gemeinschaftlich unter einem Dach wohnen."
                                            },
                                            {
                                                "example_id": "43bc26f2-9d71-42c2-a183-87e4747c2222",
                                                "sense_id": "942567c7-e0d8-3734-8a64-61719970d449",
                                                "text": "„Wir haben in unserer Gemeinde selber sehr viele kurdischstämmige Gläubige, die mit uns die fünfmaligen Gebete hier in der Moschee gemeinschaftlich beten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
