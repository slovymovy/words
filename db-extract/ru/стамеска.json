                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8ef8cfd-b46e-4e7a-944a-9f97f361d8ca",
                                                "sense_id": "d3f35a54-4c52-3a31-aa97-bc112f55bd72",
                                                "text": "„Besucher können den Künstlern bei der Arbeit mit Kettensäge, Raspel und Beitel zuschauen und verfolgen, wie das Holz Form annimmt.“"
                                            }
                                        ],
