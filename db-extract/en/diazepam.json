                                            {
                                                "example_id": "84fd7f8b-caa8-42ef-a8bf-1b17f4d25f1d",
                                                "sense_id": "5a561aa6-6954-3110-a814-f517c08b022b",
                                                "text": "Diazepam is een langwerkend slaapmiddel in de groep van de benzodiazepines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "166f8df4-3693-3633-8f00-53e1075f7480",
                                        "entry_id": "93074785-f702-3144-a40a-06c58f1b2b50",
                                        "glosses": [
                                            "een tablet met diazepam als werkend medicament, slaaptablet in het algemeen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4fc8a4e-0f0a-49f5-ac04-c8e5fabd355f",
                                                "sense_id": "166f8df4-3693-3633-8f00-53e1075f7480",
                                                "text": "Ach als ik niet kan slapen neem ik toch gewoon een diazepammetje"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c58d2373-3e54-4b4d-b9a4-4970fa4ea43d",
