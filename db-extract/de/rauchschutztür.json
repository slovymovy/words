                ],
                "senses": [
                    {
                        "sense_id": "7bf859f7-013a-30d0-94e8-b36d760e53cc",
                        "entry_id": "78ed2fa2-7520-3c7e-9675-dd538908a630",
                        "glosses": [
                            "spezielle Tür, die im Brandfall selbsttätig schließt und das Passieren von Rauch verhindern soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82cf94b9-3384-469d-ad37-eab571a9ef10",
                                "sense_id": "7bf859f7-013a-30d0-94e8-b36d760e53cc",
                                "text": "„Nach DIN 18095 „Rauchschutztüren“ Teil 1 „Begriffe und Anforderungen“ sowie Teil 2 „Prüfungen“ sind Rauchschutztüren selbstschließende Türen und dazu bestimmt, im eingebauten und geschlossenen Zustand den Durchtritt von Rauch zu behindern.“"
                            },
                            {
                                "example_id": "5decd6c1-7d19-4cee-8e52-8463ab4308a4",
                                "sense_id": "7bf859f7-013a-30d0-94e8-b36d760e53cc",
                                "text": "„Ist der Abschluss einer Öffnung sowohl durch eine Rauchschutztür (RS) nach DIN 18095-1 als auch durch eine Feuerschutztür nach DIN 4102-5 Brandverhalten von Baustoffen und Bauteilen; Feuerschutzabschlüsse, Abschlüsse in Fahrschachtwänden und gegen Feuer widerstandsfähige Verglasungen, Begriffe, Anforderungen und Prüfungen gefordert (z.B. feuerhemmender, rauchdichter, selbstschließender Abschluss), muss eine Tür eingebaut werden, die beide Anforderungen erfüllt, d.h. eine Feuerschutztür mit Rauchschutzfunktion.“"
                            },
                            {
                                "example_id": "de0618a2-c55a-4716-9cbc-9f606d9d0c85",
                                "sense_id": "7bf859f7-013a-30d0-94e8-b36d760e53cc",
                                "text": "„T30 Aluminium-Feuer- und Rauchschutztüren erhalten Sie mit der exklusiven spiegellosen Zarge ohne sichtbaren Zargenspiegel auf der Bandseite.“"
                            },
                            {
                                "example_id": "4370176d-2f86-4d37-b9af-51ac6a8bd5f4",
                                "sense_id": "7bf859f7-013a-30d0-94e8-b36d760e53cc",
                                "text": "Rauchschutztüren sind selbstschließende Abschlüsse, die der Ausbreitung von Rauch entgegenwirken."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
