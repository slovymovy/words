                        "target_lang_word": "Cantique des Cantiques",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Cantique des Cantiques",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d750517e-3254-3338-969d-e031ba33466c",
                                        "entry_id": "15940960-6d38-3eab-a648-a7e55b1bcae2",
                                        "glosses": [
                                            "Nom du vingt-sixième livre de l’Ancien Testament, composé de huit chapitres. Ce livre narre l'histoire de Salomon, qui y fit l’éloge de la reine de Saba."
                                        ],
                                        "tags": [
                                            "Biblical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3942aca-d2df-4002-b6c6-69e23dd83eb8",
                                                "sense_id": "d750517e-3254-3338-969d-e031ba33466c",
                                                "text": "Ces ennemis de la vie, de l’amour et de la fécondité se réclament du Dieu des Patriarches, du Dieu qui a si visiblement favorisé les époux vigoureux et les pères prolifiques ; du Dieu qui a dicté le Cantique des Cantiques, le chant le plus ardent, le plus voluptueux qui ait retenti sous une nuit orientale, et qui, si je le redisais du haut de cette chaire, atterrerait leur pudeur huguenote."
                                            },
                                            {
                                                "example_id": "d7a4cc20-2a14-4349-98da-e854f93afc61",
                                                "sense_id": "d750517e-3254-3338-969d-e031ba33466c",
                                                "text": "Hé ! s’écria Hâan, si tu trouves la brasserie monotone, toi, ce n’est pas ta faute, car, Dieu merci ! tu peux te vanter de t’y faire du bon sang ; tu t’es joliment moqué du monde, hier, avec tes citations du Cantique des cantiques. Ha ! ha ! ha !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
