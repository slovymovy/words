                        ],
                        "form": "die Glasmacher"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7a2e4b47-62e7-388c-9e1b-caf199ae0b16",
                        "entry_id": "bf1cfe61-3235-3591-9147-73017a58edfa",
                        "glosses": [
                            "jemand, der Glas herstellt und weiterverarbeitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac25612f-610f-4c5c-8f53-448d016c17bd",
                                "sense_id": "7a2e4b47-62e7-388c-9e1b-caf199ae0b16",
                                "text": "„Ansonsten waren vielen Herren, die über den Spessart bestimmen wollten, die Glasmacher eher lästig: Sie wollten lieber und in Ruhe jagen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "96526ab3-f989-4216-a3a3-a44d8d17faaa",
                        "source_entry_id": "bf1cfe61-3235-3591-9147-73017a58edfa",
                        "source_sense_id": "7a2e4b47-62e7-388c-9e1b-caf199ae0b16",
                        "source_sense_description": "jemand, der Glas herstellt und weiterverarbeitet",
                        "target_lang_word": "glassmaker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glassmaker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "29dd31ff-fa59-3c21-bd5b-e5881eefa2c7",
                                        "entry_id": "d039ba81-44bd-3a5c-9c6b-02785d14fc09",
                                        "glosses": [
                                            "A person or company that makes glass or glass items."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d321b4be-8735-47ed-9c5f-6e0c1b4f91b3",
                        "source_entry_id": "bf1cfe61-3235-3591-9147-73017a58edfa",
                        "source_sense_id": "7a2e4b47-62e7-388c-9e1b-caf199ae0b16",
                        "source_sense_description": "jemand, der Glas herstellt und weiterverarbeitet",
                        "target_lang_word": "verrier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verrier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "03961ef2-368f-3709-aa26-5b55e18c3652",
                                        "entry_id": "622be1ff-8f29-3a43-9889-2035098ba5a3",
                                        "glosses": [
                                            "Relatif au verre ou à sa fabrication."
                                        ],
                                        "tags": [
                                            "Verrerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "334c94ba-247a-4d1c-9fd6-95f8b8c4061c",
                                                "sense_id": "03961ef2-368f-3709-aa26-5b55e18c3652",
                                                "text": "Suivant Carlo Marin et le comte Filiasi, auteurs italiens, la naissance de l’industrie verrière vénitienne serait presque contemporaine de la fondation de la ville, attribuée, comme on sait, à l’émigration de quelques familles d’Aquilée et de Padoue qui, fuyant les armées d’Attila, vinrent chercher un refuge dans les îles des lagunes vers l’an 420."
                                            },
                                            {
                                                "example_id": "fe65e7ed-5a84-4cda-81d2-f539c406aefc",
                                                "sense_id": "03961ef2-368f-3709-aa26-5b55e18c3652",
                                                "text": "Pour résoudre tous les problèmes d’émissions atmosphériques, le four verrier idéal serait le four électrique à voûte froide."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "verrier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2566b230-fd7f-3a7d-abee-48462ead7a3f",
                                        "entry_id": "05213ec5-5da3-3dd2-9ec2-008d947d25e5",
                                        "glosses": [
                                            "Artisan qui fait du verre et des ouvrages de verre."
                                        ],
                                        "tags": [
                                            "Métier",
                                            "Verrerie"
                                        ],
                                        "note": "ne pas confondre avec vitrier",
                                        "examples": [
                                            {
                                                "example_id": "3f1653a9-6a7b-44f4-b264-baa24fff7d1e",
                                                "sense_id": "2566b230-fd7f-3a7d-abee-48462ead7a3f",
                                                "text": "Personne n’ignore, en effet, que les verriers sont tous gentils-hommes de naissance et ne montrent qu’à leurs fils le noble métier de souffleur."
                                            },
                                            {
                                                "example_id": "7afe2a82-2658-4b94-9fec-b521bc8e36ed",
                                                "sense_id": "2566b230-fd7f-3a7d-abee-48462ead7a3f",
                                                "text": "Et jamais, en somme, l’on n’a découvert le nom de l’un des premiers architectes, de l’un des sculpteurs, de l’un des verriers de cette cathédrale ?"
                                            },
                                            {
                                                "example_id": "b300fbd4-88f7-43be-91cf-031c6f08f273",
                                                "sense_id": "2566b230-fd7f-3a7d-abee-48462ead7a3f",
                                                "text": "Nos verriers de l’Est, reprend M. Daum, ont un tact parfait en ce genre de fabrication limonadière et du Nord au Midi les amateurs français en sont tributaires."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ecbd5967-7879-4d53-8c33-c7661254d6ca",
                        "source_entry_id": "bf1cfe61-3235-3591-9147-73017a58edfa",
