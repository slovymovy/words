{
    "word_family": [
        "expose",
        "exposition",
        "expository",
        "exposer"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dad19c45-2055-327d-9ca5-9fe27cea716f",
                    "sense_definition": "The condition of being exposed, uncovered, or unprotected; the state of having contact with something.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "state_of_contact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should limit your <w>exposure</w> to the sun during the hottest part of the day.",
                            "target_lang_translations": {
                                "ru": "Вам следует ограничить <w>воздействие</w> солнца в самое жаркое время дня.",
                                "zh": "在一天中最热的时候，你应该减少在阳光下的<w>暴露</w>。"
                            }
                        },
                        {
                            "text": "Regular <w>exposure</w> to a new language is essential for learning it quickly.",
                            "target_lang_translations": {
                                "ru": "Регулярный <w>контакт</w> с новым языком необходим для его быстрого изучения.",
                                "zh": "经常<w>接触</w>一门新语言对于快速学习至关重要。"
                            }
                        }
                    ],
                    "synonyms": [
                        "contact",
                        "vulnerability"
                    ],
                    "antonyms": [
                        "protection",
                        "shelter"
                    ],
                    "common_phrases": [
                        "exposure to sunlight",
                        "limit exposure",
                        "radiation exposure"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние нахождения под воздействием чего-либо (например, солнца, радиации) или отсутствия защиты; контакт с чем-либо.",
                        "zh": "处于某种环境或影响之下，或缺乏保护的状态；与某事物接触。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "воздействие",
                                "target_lang_sense_clarification": "влияние внешней среды (солнца, радиации)"
                            },
                            {
                                "target_lang_word": "контакт",
                                "target_lang_sense_clarification": "соприкосновение с чем-либо (например, с языком или вирусом)"
                            },
                            {
                                "target_lang_word": "подверженность",
                                "target_lang_sense_clarification": "склонность или открытость влиянию"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "接触",
                                "target_lang_sense_clarification": "与某事物或环境的关联"
                            },
                            {
                                "target_lang_word": "暴露",
                                "target_lang_sense_clarification": "处于某种影响之下"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3e51cfdb-9d7a-3dad-af83-45e9960155d5",
                    "sense_definition": "A harmful physical condition caused by prolonged lack of protection from cold weather or the elements.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "medical_condition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lost hikers were found suffering from severe <w>exposure</w> and dehydration.",
                            "target_lang_translations": {
                                "ru": "Заблудившихся туристов нашли страдающими от сильного <w>переохлаждения</w> и обезвоживания.",
                                "zh": "迷路的徒步旅行者被发现时正遭受严重的<w>失温</w>和脱水。"
                            }
                        },
                        {
                            "text": "Without proper clothing, there is a high risk that you could die of <w>exposure</w> in these mountains.",
                            "target_lang_translations": {
                                "ru": "Без подходящей одежды существует высокий риск умереть от <w>переохлаждения</w> в этих горах.",
                                "zh": "如果没有合适的衣服，在这座山上很有可能会死于<w>失温</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "die of exposure",
                        "suffering from exposure"
                    ],
                    "target_lang_definitions": {
                        "ru": "Опасное для жизни физическое состояние, вызванное длительным пребыванием на холоде без надлежащей защиты.",
                        "zh": "因长期缺乏保护而暴露在寒冷或恶劣天气中导致的严重身体状况。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переохлаждение",
                                "target_lang_sense_clarification": "медицинское состояние от холода"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "失温",
                                "target_lang_sense_clarification": "因寒冷导致的体温过低"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "46f2449d-6537-314d-ae93-da60f89cd0e5",
                    "sense_definition": "The act of revealing something private, secret, or illegal to the public.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "revelation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The journalist threatened the <w>exposure</w> of the politician's secret deals.",
                            "target_lang_translations": {
                                "ru": "Журналист угрожал <w>разоблачением</w> тайных сделок политика.",
                                "zh": "记者威胁要<w>揭露</w>这位政客的秘密交易。"
                            }
                        },
                        {
                            "text": "He was arrested by the police for indecent <w>exposure</w> in a public park.",
                            "target_lang_translations": {
                                "ru": "Он был арестован полицией за непристойное <w>обнажение</w> в общественном парке.",
                                "zh": "他因在公园里有不雅的<w>暴露</w>行为而被警察逮捕。"
                            }
                        }
                    ],
                    "synonyms": [
                        "revelation",
                        "disclosure",
                        "uncovering"
                    ],
                    "antonyms": [
                        "concealment",
                        "cover-up"
                    ],
                    "common_phrases": [
                        "indecent exposure",
                        "public exposure"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт раскрытия тайной, скрытой или незаконной информации; публичное обнажение.",
                        "zh": "将私人、秘密或非法信息公之于众的行为；公开的身体裸露。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разоблачение",
                                "target_lang_sense_clarification": "раскрытие тайны или преступления"
                            },
                            {
                                "target_lang_word": "огласка",
                                "target_lang_sense_clarification": "предание публичности"
                            },
                            {
                                "target_lang_word": "обнажение",
                                "target_lang_sense_clarification": "физическое оголение тела"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "揭露",
                                "target_lang_sense_clarification": "公开秘密或非法行为"
                            },
                            {
                                "target_lang_word": "暴露",
                                "target_lang_sense_clarification": "身体的公开裸露"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9373e0c0-5e03-3bb6-b696-f789f062a07e",
                    "sense_definition": "The condition of being at risk of financial losses in investments or business.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "financial_risk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bank is trying to reduce its <w>exposure</w> to risky loans in the housing market.",
                            "target_lang_translations": {
                                "ru": "Банк пытается снизить свою <w>уязвимость</w> перед рискованными кредитами на рынке жилья.",
                                "zh": "银行正试图降低其在房地产市场中高风险贷款的<w>风险敞口</w>。"
                            }
                        },
                        {
                            "text": "Investors are worried about their financial <w>exposure</w> due to the currency fluctuations.",
                            "target_lang_translations": {
                                "ru": "Инвесторы обеспокоены своими финансовыми <w>рисками</w> из-за колебаний валютных курсов.",
                                "zh": "投资者担心货币波动带来的财务<w>风险</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "risk",
                        "liability"
                    ],
                    "antonyms": [
                        "security"
                    ],
                    "common_phrases": [
                        "financial exposure",
                        "risk exposure"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "business"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Риск финансовых потерь в инвестициях или бизнесе; степень зависимости от рыночных факторов.",
                        "zh": "在投资或商业中面临财务损失的风险程度。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уязвимость",
                                "target_lang_sense_clarification": "степень риска"
                            },
                            {
                                "target_lang_word": "риск",
                                "target_lang_sense_clarification": "вероятность финансовых потерь"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "风险敞口",
                                "target_lang_sense_clarification": "金融领域中面临的风险程度"
                            },
                            {
                                "target_lang_word": "风险",
                                "target_lang_sense_clarification": "财务上的不确定性"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "53a33c36-53ec-36be-a9ca-629971ebec8a",
                    "sense_definition": "The direction in which a building, room, or piece of land faces.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "orientation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They rented a cabin with a beautiful southern <w>exposure</w> that gets sunlight all day.",
                            "target_lang_translations": {
                                "ru": "Они сняли домик с прекрасной южной <w>ориентацией</w>, который освещается солнцем весь день.",
                                "zh": "他们租了一间有着优美南向<w>朝向</w>的小木屋，整天都能晒到太阳。"
                            }
                        },
                        {
                            "text": "Plants that require a lot of light grow best in a garden with a western <w>exposure</w>.",
                            "target_lang_translations": {
                                "ru": "Светолюбивые растения лучше всего растут в саду с западным <w>расположением</w>.",
                                "zh": "需要充足光照的植物在西向<w>朝向</w>的花园里长得最好。"
                            }
                        }
                    ],
                    "synonyms": [
                        "orientation",
                        "aspect"
                    ],
                    "common_phrases": [
                        "southern exposure",
                        "northern exposure"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сторона света, на которую обращено здание, окно или участок земли.",
                        "zh": "建筑物、房间或土地所朝向的方向。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ориентация",
                                "target_lang_sense_clarification": "расположение относительно сторон света"
                            },
                            {
                                "target_lang_word": "расположение",
                                "target_lang_sense_clarification": "местоположение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "朝向",
                                "target_lang_sense_clarification": "建筑物或土地的方位"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1bae3ae2-e141-3e72-abec-790ee34c0e21",
                    "sense_definition": "An instance of taking a photograph, or the amount of time light is allowed to reach the film or sensor.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "photography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need a long <w>exposure</w> to capture the movement of the stars at night.",
                            "target_lang_translations": {
                                "ru": "Вам нужна длинная <w>выдержка</w>, чтобы запечатлеть движение звезд ночью.",
                                "zh": "你需要长时间的<w>曝光</w>才能捕捉到夜晚星辰的轨迹。"
                            }
                        },
                        {
                            "text": "I have only three <w>exposures</w> left on this roll of film before it is full.",
                            "target_lang_translations": {
                                "ru": "У меня осталось всего три <w>кадра</w> на этой пленке, прежде чем она закончится.",
                                "zh": "这卷胶卷只剩下三个<w>底片</w>就要拍完了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "long exposure",
                        "double exposure"
                    ],
                    "target_lang_definitions": {
                        "ru": "Количество света, попадающего на фотопленку или матрицу; отдельный кадр на пленке.",
                        "zh": "摄影中光线照射胶片或传感器的时间长度，或指拍摄的单张照片。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выдержка",
                                "target_lang_sense_clarification": "время воздействия света"
                            },
                            {
                                "target_lang_word": "экспозиция",
                                "target_lang_sense_clarification": "количество света в фотографии"
                            },
                            {
                                "target_lang_word": "кадр",
                                "target_lang_sense_clarification": "снимок на пленке"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "曝光",
                                "target_lang_sense_clarification": "光线照射感光材料的过程"
                            },
                            {
                                "target_lang_word": "底片",
                                "target_lang_sense_clarification": "胶卷上的单张拍摄空间"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}