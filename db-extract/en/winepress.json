    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "6c0544d6-3021-3e3d-b306-8d4092922a09",
                "word": "winepress",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "b44cc25d-f416-4988-9669-fb259a7722cb",
