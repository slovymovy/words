                                                "sense_id": "d6acfe2c-9e8a-3281-990b-30b540e8b674",
                                                "text": "Aluminium kann auf verschiedene Weise unlösbar zum Verbund mit anderen Werkstoffen (Metallen oder Nichtmetallen) kombiniert werden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
