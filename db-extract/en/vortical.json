                    {
                        "form_id": "77484400-66dd-4257-a1fb-25cb97f0b721",
                        "entry_id": "55017b60-ed76-3b05-8189-28a8bbe9662f",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most vortical"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6c4d082a-91be-3f83-a148-640b3a2d4967",
                        "entry_id": "55017b60-ed76-3b05-8189-28a8bbe9662f",
                        "glosses": [
                            "Of or pertaining to a vortex; containing vortices; moving in a vortex."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7bc771b-9c93-4892-906a-53ae9bbc7732",
                                "sense_id": "6c4d082a-91be-3f83-a148-640b3a2d4967",
                                "text": "The motions of this odd Liquor were not only various, but frequently Vortical; to be satisfyed of which I sometimes put short bits of straw, or Fragments of some such like stuff, upon the discovered part of the surface of the Liquor, by which they were carryed towards very distant, if not opposite, parts of the Vessel at the same time."
                            },
                            {
                                "example_id": "6694a75d-959d-42af-b2bc-c737b68b3947",
                                "sense_id": "6c4d082a-91be-3f83-a148-640b3a2d4967",
                                "text": "He assumed, in brief, that infinite space is filled with infinite matter; that matter was originally in a chaotic, formless condition; that the cosmical bodies arose at first from vortical motions in the original mass."
                            },
                            {
                                "example_id": "f07c4eba-76ed-435e-8b68-47bb2f14893f",
                                "sense_id": "6c4d082a-91be-3f83-a148-640b3a2d4967",
                                "text": "The book's owner, Maurice Conchis (Anthony Quinn) befriends Urfe and brings him into his vortical universe."
                            },
                            {
                                "example_id": "74127ff4-dffa-48fe-96c4-3f4479bb6a49",
                                "sense_id": "6c4d082a-91be-3f83-a148-640b3a2d4967",
                                "text": "In many cases, examination of the flow fields in greater detail reveals a more vortical or turbulent flow around the collimated core."
                            },
                            {
                                "example_id": "c0616f53-52d8-425c-9c90-3baa8a12b259",
                                "sense_id": "6c4d082a-91be-3f83-a148-640b3a2d4967",
                                "text": "Motion around the eddy is called vortical, and motion along the axis is called jetal."
                            }
                        ]
                    }
                ],
