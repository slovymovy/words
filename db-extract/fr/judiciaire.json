        "fr-extract.jsonl": [
            {
                "entry_id": "0cf91cdc-cd45-3e82-96a1-3829a63767d8",
                "word": "judiciaire",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "af04126b-cf9f-4459-a481-b0cdfbab3d50",
                        "entry_id": "0cf91cdc-cd45-3e82-96a1-3829a63767d8",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "judiciaires"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3a1c4ca6-1136-3aba-b015-d5e3bbc24901",
                        "entry_id": "0cf91cdc-cd45-3e82-96a1-3829a63767d8",
                        "glosses": [
                            "Relatif à la justice ou son administration."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c2c3598-4601-4e92-a8c9-a5be5ac1bf9f",
                                "sense_id": "3a1c4ca6-1136-3aba-b015-d5e3bbc24901",
                                "text": "Eussiez-vous imaginé l'ordre judiciaire le plus parfait, eussiez-vous trouvé les juges les plus intègres et les plus éclairés, il restera toujours quelque place à l'erreur ou à la prévention."
                            },
                            {
                                "example_id": "a9b4265e-7f9a-49a8-8842-92f525f37030",
                                "sense_id": "3a1c4ca6-1136-3aba-b015-d5e3bbc24901",
                                "text": "Ces conjectures et ces raisonnements se pressaient dans la cervelle de Scaër, pendant que les assassins fuyaient en emportant ce qu'on appelle en style judiciaire le corps du délit."
                            },
                            {
                                "example_id": "a34054a0-ed86-4594-a765-a2698a876340",
                                "sense_id": "3a1c4ca6-1136-3aba-b015-d5e3bbc24901",
                                "text": "L'astrologie judiciaire était alors en vogue. La haute raison du président de L'Alouette condamnait cette science frivole et chimérique. Il écrivit pour la discréditer et en démontrer le vide et la nullité."
                            }
                        ]
                    },
                    {
                        "sense_id": "d41bb6d2-d6f8-3c95-97df-d00397faba20",
                        "entry_id": "0cf91cdc-cd45-3e82-96a1-3829a63767d8",
                        "glosses": [
                            "Relatif au déroulement d’un procès."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93ccf721-b7bb-4d6a-9bed-1c5d4c40a050",
                                "sense_id": "d41bb6d2-d6f8-3c95-97df-d00397faba20",
                                "text": "Par aveu judiciaire, un plaideur reconnaît au cours d’un procès l’exactitude d’un fait allégué contre lui et dont dépend l’issue du litige."
                            },
                            {
                                "example_id": "3d1c8bb3-ab7d-41f6-9e1a-037abd2e7dc5",
                                "sense_id": "d41bb6d2-d6f8-3c95-97df-d00397faba20",
                                "text": "Les multirécidivistes sont paranos, ils connaissent le travail de la police et font des contre-observations. À chaque fois qu'ils tombent, ils analysent en détail le dossier judiciaire pour connaître ce qui leur a été fatal, apprenant de leurs maladresses."
                            },
                            {
                                "example_id": "c52e7ed1-2472-49eb-b1c3-2021c84af612",
                                "sense_id": "d41bb6d2-d6f8-3c95-97df-d00397faba20",
                                "text": "Les gérants de l’ancien parc saint-georgeais, Samuel Lesueur et Yann Cosson sont déjà plongés dans une bataille judiciaire avec la Ville de Saint-Georges-de-Didonne qui a décidé de se séparer d’eux."
                            }
                        ]
                    },
                    {
                        "sense_id": "5805c607-9721-3faf-a0ec-f89c59de429c",
                        "entry_id": "0cf91cdc-cd45-3e82-96a1-3829a63767d8",
                        "glosses": [
                            "Qui découle d’une décision de justice."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "665a728b-2994-4dc1-9599-9cbbc69edf29",
                                "sense_id": "5805c607-9721-3faf-a0ec-f89c59de429c",
                                "text": "Si des étrangers sont punis de l’expulsion judiciaire exécutoire après subissement de la peine privative de liberté, il ne reste pas de place pour la libération conditionnelle avec patronage; […]."
                            }
                        ]
                    }
                ],
