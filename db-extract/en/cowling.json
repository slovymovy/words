                                            {
                                                "example_id": "9f8bb2b8-1ae1-4fde-bf87-100a450c702d",
                                                "sense_id": "115acf24-dc45-3b8c-a411-51cf19873fe6",
                                                "text": "La circulation à Paris lui avait paru exécrable, dangereuse, des maniaques au volant qui avaient l'œil fixé sur le bout du capot comme des gosses dans des autos-tamponnantes."
                                            },
                                            {
                                                "example_id": "db1e94f8-52e7-4405-80a7-8f4c36de577c",
                                                "sense_id": "115acf24-dc45-3b8c-a411-51cf19873fe6",
                                                "text": "Les capots des moteurs sont le plus souvent réalisés avec des sandwichs constitués de peaux en carbone-époxy collées sur des âmes en nida aluminium."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67239df0-01bd-310e-be5c-7aff6fa179e4",
                                        "entry_id": "e5b98be4-6d74-30ab-adb3-32213f0b8c39",
                                        "glosses": [
                                            "Tout dispositif destiné à protéger.",
                                            "Capuchon de toile qui protège certains objets de l’air et des chocs."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "85edddb5-68c7-33fe-9b43-0d28508d1c07",
                                        "entry_id": "e5b98be4-6d74-30ab-adb3-32213f0b8c39",
                                        "glosses": [
                                            "Tout dispositif destiné à protéger.",
                                            "Ce qui protège l'accès d'un escalier de navire."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2bc578cc-d3f8-41a1-8067-1c5c13b1de40",
                                                "sense_id": "85edddb5-68c7-33fe-9b43-0d28508d1c07",
                                                "text": "Quant à moi, c’est sur le pont que j’ai l’intention de passer la nuit, et je remonte par le capot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42f599b1-21d2-3284-b3e6-61d1e016d816",
                                        "entry_id": "e5b98be4-6d74-30ab-adb3-32213f0b8c39",
                                        "glosses": [
                                            "Tout dispositif destiné à protéger.",
                                            "Long manteau d'hiver pourvu d’un capuchon."
                                        ],
                                        "tags": [
                                            "Canada"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64a8a6a2-e46b-423d-a8d4-65471da67853",
                                                "sense_id": "42f599b1-21d2-3284-b3e6-61d1e016d816",
                                                "text": "Le père Chapdelaine arrachait les glaçons formés sur sa moustache, retirait lentement son capot doublé en peau de mouton, et s’installait près du poêle avec un soupir d’aise."
                                            }
                                        ]
                                    },
