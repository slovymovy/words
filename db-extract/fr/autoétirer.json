                "senses": [
                    {
                        "sense_id": "f53e04ba-ffa3-347d-adf2-be0aaf2e95c5",
                        "entry_id": "c3916793-74eb-3d45-8d80-76daa4218c08",
                        "glosses": [
                            "Étirer soi-même (sans l’assistance d’un professionnel)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c50585c0-a0b7-448c-b54f-adf283e17cb9",
                                "sense_id": "f53e04ba-ffa3-347d-adf2-be0aaf2e95c5",
                                "text": "Il avait mis au point une table d’opération plus adaptée, un cadre permettant aux malades de s’autoétirer avec un système de poulies, etc."
                            },
                            {
                                "example_id": "35122dba-41c5-4a9e-a7d8-322380230e3e",
                                "sense_id": "f53e04ba-ffa3-347d-adf2-be0aaf2e95c5",
                                "text": "Autoétirer les fléchisseurs et les extenseurs du poignet."
                            },
                            {
                                "example_id": "829cee32-d7e1-4653-8e8f-5c88fddfa952",
                                "sense_id": "f53e04ba-ffa3-347d-adf2-be0aaf2e95c5",
                                "text": "S’autoétirer debout ou assis sur un tabouret le dos plaqué contre un mur. Souffler en se grandissant comme si l’on voulait que la tête touche le plafond."
                            }
                        ]
                    }
