                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b08b253-68ad-4369-ad68-54a50e6dc90b",
                                "sense_id": "52882218-b2a3-335b-bed7-4d2606f89629",
                                "text": "„Der Schmied hämmert weiter auf sein Eisen, immer zwei schnelle und drei langsame Schläge, genau im Rhythmus der Basslinie eines seiner alten Lieblingssongs von Radiohead.“"
                            },
                            {
                                "example_id": "c72b3049-e565-4e4f-b8de-7b92dab79d08",
                                "sense_id": "52882218-b2a3-335b-bed7-4d2606f89629",
                                "text": "„Jedesmal wenn er ein Lied beendet hatte, riefen die Männer nach Zugaben, baten um Lieblingssongs, und es wurde viel gelacht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
