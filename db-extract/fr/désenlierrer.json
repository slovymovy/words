                                "example_id": "fab5a4ba-9a8f-4455-80c6-3c6ad86a7afb",
                                "sense_id": "7e593616-800c-3270-ab10-cc4aaa6592f7",
                                "text": "Il bûcheronnent les uns les autres.\nAbattent leurs stères leurs pages désenlierrent les énigmes des vieux troncs.\nRecherchent l’appui des solitaires."
                            },
                            {
                                "example_id": "1d1820fe-c8b2-4450-9081-c468ca30e9a8",
                                "sense_id": "7e593616-800c-3270-ab10-cc4aaa6592f7",
                                "text": "Je suppose que « désenlierrer les énigmes » est le travail de l’observateur dans les ruines."
                            },
                            {
                                "example_id": "876ce29c-1d58-4771-b7c2-ba2e9d9b7e04",
                                "sense_id": "7e593616-800c-3270-ab10-cc4aaa6592f7",
                                "text": "Il a passé la main, dit Chastagnier en aidant l’Américain à se désenlierrer de la poigne du cadavre."
                            }
                        ]
