                    {
                        "translation_id": "208907f9-d5ca-4f32-9924-b2f10176e613",
                        "source_entry_id": "6873f509-4585-35f3-911a-fc999be3a599",
                        "source_sense_id": "d777f471-e8b7-34ce-bca4-547739e61c10",
                        "source_sense_description": "bullfrog",
                        "target_lang_word": "ouaouaron",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ouaouaron",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0268e967-1013-3bbe-b0c6-9f63fc9aa510",
                                        "entry_id": "d545bf52-f137-3021-808e-293f2bbb0ad1",
                                        "glosses": [
                                            "Grosse grenouille verte d’Amérique du Nord dont le coassement s’apparente au beuglement d’une vache."
                                        ],
                                        "tags": [
                                            "Louisiane",
                                            "Canada"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a08dc6cb-cf6f-4e10-85d5-06bd3af299f9",
                                                "sense_id": "0268e967-1013-3bbe-b0c6-9f63fc9aa510",
                                                "text": "Quand le ouaouaron mâle coasse, il remplit son sac vocal d’air."
                                            },
                                            {
                                                "example_id": "bd2c74e3-8eb2-43cf-a5e7-082c36d4bb76",
                                                "sense_id": "0268e967-1013-3bbe-b0c6-9f63fc9aa510",
                                                "text": "Mais bientôt, plus loin, près de la rivière, les grenouilles et les ouaouarons firent un grand concert."
                                            },
                                            {
                                                "example_id": "468a9022-fefb-4bd0-8070-00dd1b10421b",
                                                "sense_id": "0268e967-1013-3bbe-b0c6-9f63fc9aa510",
                                                "text": "Elle l’avait recueilli, l’avait lové dans le duvet d’un oreiller, l’avait nourri au compte-gouttes avec de l’eau sucrée, puis avec de petits morceaux de proies diverses — musaraignes dodues et ouaouarons bien gras."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "612f89af-3e10-4b45-91e3-a84b7113aee2",
                        "source_entry_id": "6873f509-4585-35f3-911a-fc999be3a599",
                        "source_sense_id": "d777f471-e8b7-34ce-bca4-547739e61c10",
                        "source_sense_description": "bullfrog",
                        "target_lang_word": "Ochsenfrosch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ochsenfrosch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3869eab3-2bc8-33ba-b56b-29b418fe6d40",
                                        "entry_id": "b0eb449b-0818-342d-a043-7334357aa937",
                                        "glosses": [
                                            "sehr große, weltweit verbreitete Froschart"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e8fa426-f8fa-4e43-b848-e839686715b4",
                                                "sense_id": "3869eab3-2bc8-33ba-b56b-29b418fe6d40",
                                                "text": "„Die Hälfte des Baus war den Elementen ungeschützt ausgesetzt und wir konnten, nicht weit entfernt in den Sümpfen, die Ochsenfrösche belfern hören, wir konnten die Abgasfackeln wie ferne defekte Sterne glimmern sehen.“"
                                            },
                                            {
                                                "example_id": "7b73adcf-947d-4d8e-acd5-76d23bdb62e2",
                                                "sense_id": "3869eab3-2bc8-33ba-b56b-29b418fe6d40",
                                                "text": "„Sonia griff nach einem Ochsenfrosch mit übergroßen Augen aus Porzellan.“"
                                            },
                                            {
                                                "example_id": "5a55c224-326b-484f-b5ec-a6638b894422",
                                                "sense_id": "3869eab3-2bc8-33ba-b56b-29b418fe6d40",
                                                "text": "„Triumphierend blies er sich auf wie ein Ochsenfrosch und landete einen Schwinger, schlug den Kopf des Gegners mit schrecklicher Wucht ein.“"
                                            },
                                            {
                                                "example_id": "ae5869ec-df29-430f-b9e7-4a51386900f1",
                                                "sense_id": "3869eab3-2bc8-33ba-b56b-29b418fe6d40",
                                                "text": "„Ochsenfrösche krächzten, und überall um sie herum summten Moskitos mit einer Beharrlichkeit, die sie fast wahnsinnig machte.“"
                                            },
                                            {
                                                "example_id": "e2a5a33c-50b9-4853-8dba-e63a341a8999",
                                                "sense_id": "3869eab3-2bc8-33ba-b56b-29b418fe6d40",
                                                "text": "„›Wenn sie alles über jemand herausbekommen wollen, was es gibt, dann machen sie das mit ihm. Trensenbereifen. Seine Innenseite nach außen stülpen, so wie man bei einem Ochsenfrosch das Innerste nach außen stülpt.‹“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
