                    {
                        "translation_id": "348e8dd2-1f4e-4cd2-9493-11a8f43c8fd0",
                        "source_entry_id": "93ab9f0f-570c-3171-8dae-f140f2dc2dc9",
                        "source_sense_description": "housekeeper",
                        "target_lang_word": "hoofdverpleegster",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hoofdverpleegster",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "618cb156-d591-3e3c-984b-7458eba0fe88",
                                        "entry_id": "7f6bd996-81ff-3dce-9f36-986da0564f94",
                                        "glosses": [
                                            "vrouwelijke verpleegkundige die de leiding heeft over een ziekenhuisafdeling"
                                        ],
                                        "tags": [
                                            "beroep"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed11b33e-0de6-4f34-84c5-a1d3ccb89682",
                                                "sense_id": "618cb156-d591-3e3c-984b-7458eba0fe88",
                                                "text": "Na verschillende gastrollen in televisieseries, waaronder een in Star Trek in 1966, werd Kellerman in 1970 bekend als Major Margaret ‘Hot Lips’ Houlihan in M*A*SH, de verfilming van het boek MASH: A Novel About Three Army Doctors, waar later ook de populaire serie van gemaakt werd. Kellerman werd voor haar vertolking van de hoofdverpleegster van het veldhospitaal genomineerd voor een Oscar en een Golden Globe."
                                            },
                                            {
                                                "example_id": "ebf19234-5be1-495a-b48e-00d4b6dc7cae",
                                                "sense_id": "618cb156-d591-3e3c-984b-7458eba0fe88",
                                                "text": "Reijn vindt de rollen die zij en Katja spelen mooi, zegt ze in dagblad Metro. 'Het zijn mannelijke vrouwen. Niet van die trutjes. Ze werken hard, zijn cynisch en seksueel weird of ze gebruiken mannen.' Ze herkent zichzelf er wel een beetje in. 'Ik leid ook een beetje het leven van een man. Net als hoofdverpleegster Charlie heb ik ook nog geen goede balans gevonden tussen werk en privé.'"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b652d02c-872b-47ee-890a-c9e336041a2d",
