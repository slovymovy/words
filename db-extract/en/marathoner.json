                        "sense_id": "a58ddced-5b66-3920-9fe4-df3af73b141d",
                        "entry_id": "38874c2b-29c3-3add-8f7b-260bc5907c18",
                        "glosses": [
                            "Someone who participates in a marathon or other long-distance races."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af28866f-88c7-4b89-bc85-2bf7c93fa107",
                                "sense_id": "a58ddced-5b66-3920-9fe4-df3af73b141d",
                                "text": "She called on all the marathoners to go to Staten Island to help with the clean-up effort and to bring the clothes they would have shed at the start to shelters or other places where displaced people were in need."
                            },
                            {
                                "example_id": "b0d98943-7d9f-4275-afd8-bde532c8287c",
                                "sense_id": "a58ddced-5b66-3920-9fe4-df3af73b141d",
                                "text": "“I just go as long as I can before my legs get too heavy and my head gets in a haze,” said Chris Zablocki, the best marathoner most elite marathoners have never heard of."
                            }
                        ]
                    }
                ],
