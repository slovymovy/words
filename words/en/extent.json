{
    "word_family": [
        "extend",
        "extension",
        "extensive",
        "extensively"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c33262f4-dda2-37b1-8082-f84969b31eea",
                    "sense_definition": "The size, area, or degree to which something extends or exists.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We do not yet know the full <w>extent</w> of the damage caused by the storm.",
                            "target_lang_translations": {
                                "ru": "Мы ещё не знаем полный <w>масштаб</w> ущерба, причинённого штормом.",
                                "zh": "我们尚不清楚这场风暴造成的破坏<w>规模</w>。"
                            }
                        },
                        {
                            "text": "To some <w>extent</w>, I agree with your opinion on the matter.",
                            "target_lang_translations": {
                                "ru": "В некоторой <w>степени</w> я согласен с вашим мнением по этому вопросу.",
                                "zh": "在某种<w>程度</w>上，我同意你对这件事的看法。"
                            }
                        }
                    ],
                    "synonyms": [
                        "expanse",
                        "extension"
                    ],
                    "common_phrases": [
                        "to some extent",
                        "to a great extent",
                        "the full extent",
                        "to what extent"
                    ],
                    "target_lang_definitions": {
                        "ru": "Размер, область или степень, в которой что-либо распространяется или существует.",
                        "zh": "某事物延伸或存在的范围、程度或大小。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сте́пень",
                                "target_lang_sense_clarification": "уровень или градация (часто в выражении «в некоторой степени»)"
                            },
                            {
                                "target_lang_word": "масшта́б",
                                "target_lang_sense_clarification": "размах или охват явления (например, масштаб бедствия)"
                            },
                            {
                                "target_lang_word": "разме́р",
                                "target_lang_sense_clarification": "величина или физическая протяжённость"
                            },
                            {
                                "target_lang_word": "ме́ра",
                                "target_lang_sense_clarification": "предел или количество (в выражении «в какой-то мере»)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "程度",
                                "target_lang_sense_clarification": "用于表示某种情况或状态的深浅或范围"
                            },
                            {
                                "target_lang_word": "范围",
                                "target_lang_sense_clarification": "用于表示事物影响或存在的界限"
                            },
                            {
                                "target_lang_word": "规模",
                                "target_lang_sense_clarification": "用于表示事物的大小或影响的广度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1563910f-c2f9-3648-b310-a75486f0e3ae",
                    "sense_definition": "A contiguous area of storage in a file system.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The file system allocates a new <w>extent</w> on the disk to store the data.",
                            "target_lang_translations": {
                                "ru": "Файловая система выделяет новый <w>экстент</w> на диске для хранения данных.",
                                "zh": "文件系统在磁盘上分配了一个新的<w>数据区</w>来存储数据。"
                            }
                        },
                        {
                            "text": "Using a large <w>extent</w> can improve read performance for big files.",
                            "target_lang_translations": {
                                "ru": "Использование большого <w>экстента</w> может улучшить производительность чтения крупных файлов.",
                                "zh": "使用较大的<w>数据区</w>可以提高大文件的读取性能。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Непрерывная область памяти в файловой системе.",
                        "zh": "文件系统中连续的存储区域。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "эксте́нт",
                                "target_lang_sense_clarification": "технический термин: непрерывная область данных"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "数据区",
                                "target_lang_sense_clarification": "计算机存储中连续分配的物理或逻辑空间"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9fdcb423-784e-328f-9027-8b4aa02dda8f",
                    "sense_definition": "A writ directing a sheriff to seize the property of a debtor.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The court issued an <w>extent</w> to recover the debts owed to the Crown.",
                            "target_lang_translations": {
                                "ru": "Суд выдал <w>экстент</w> для взыскания долгов перед Короной.",
                                "zh": "法院签发了<w>扣押令</w>以追回欠王室的债务。"
                            }
                        },
                        {
                            "text": "Under the old law, an <w>extent</w> allowed for the immediate seizure of land.",
                            "target_lang_translations": {
                                "ru": "Согласно старому закону, <w>экстент</w> позволял немедленно наложить арест на землю.",
                                "zh": "根据旧法，<w>扣押令</w>允许立即没收土地。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "historical legal term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Судебный приказ шерифу об аресте имущества должника.",
                        "zh": "一种授权治安官扣押债务人财产的法律令状。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "эксте́нт",
                                "target_lang_sense_clarification": "исторический юридический термин: приказ об аресте имущества"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "扣押令",
                                "target_lang_sense_clarification": "法律术语，指强制执行财产扣押的命令"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e76b22ea-09b4-3e71-a02b-191e02eff93a",
                    "sense_definition": "Extended or stretched out.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "With arms <w>extent</w>, the figure in the painting reached towards the sky.",
                            "target_lang_translations": {
                                "ru": "С <w>распростёртыми</w> руками фигура на картине тянулась к небу.",
                                "zh": "画中的人物<w>伸展</w>双臂，向天空探去。"
                            }
                        },
                        {
                            "text": "The ancient map showed the kingdom <w>extent</w> across the entire valley.",
                            "target_lang_translations": {
                                "ru": "Древняя карта показывала королевство, <w>простирающееся</w> через всю долину.",
                                "zh": "古地图显示该王国<w>伸展</w>至整个山谷。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Растянутый или распростёртый.",
                        "zh": "伸展或张开的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "распростёртый",
                                "target_lang_sense_clarification": "вытянутый в пространстве (устаревшее или поэтическое)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "伸展的",
                                "target_lang_sense_clarification": "形容物体向外延伸的状态"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}