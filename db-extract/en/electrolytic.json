                                    {
                                        "sense_id": "0f6b1adf-19b7-3e47-9222-fa8426393107",
                                        "entry_id": "1ac68878-c958-30f2-a6bd-9a571185ad6f",
                                        "glosses": [
                                            "Relatif à l’électrolyse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee167c26-ccec-458b-8048-078235d98790",
                                                "sense_id": "0f6b1adf-19b7-3e47-9222-fa8426393107",
                                                "text": "La valeur la plus forte pour les échantillons obtenus par voie électrolytique ne peut être attribuée à un état allotropique particulier du métal, car après fusion, le coefficient d'aimantation de ces échantillons n'a pas changé."
                                            },
                                            {
                                                "example_id": "a5b56168-1222-47fb-9c3f-c69fb253fc07",
                                                "sense_id": "0f6b1adf-19b7-3e47-9222-fa8426393107",
                                                "text": "Le traitement dans les bacs électrolytiques se fait de la manière suivante : …"
                                            },
                                            {
                                                "example_id": "d88482da-0b5c-423f-81f7-df1006e0bbc9",
                                                "sense_id": "0f6b1adf-19b7-3e47-9222-fa8426393107",
                                                "text": "Comme l’explique le directeur d’une nouvelle étude parue dans le journal «Environmental pollution», le professeur Patrick Drogui, le traitement par oxydation électrolytique des eaux usées ne requiert aucun ajout chimique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "461cb744-f209-3771-9b89-06b2872d28b5",
                                        "entry_id": "1ac68878-c958-30f2-a6bd-9a571185ad6f",
                                        "glosses": [
                                            "Relatif aux électrolytes, qui contient des électrolytes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "984fa543-0789-45d1-b2a8-81c27d29af13",
                                                "sense_id": "461cb744-f209-3771-9b89-06b2872d28b5",
                                                "text": "Une solution électrolytique est obtenue par dissolution d'un soluté […] dans un solvant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4cafed5d-f78e-41c5-ab04-e3554e6f2ef0",
                        "source_entry_id": "c7fabe5d-d1dd-342f-8541-daa09b196cbd",
                        "source_sense_description": "Translations",
                        "target_lang_word": "elektrolytisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "elektrolytisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "40ac33fc-1084-3290-8eaf-f8bbb673965e",
                                        "entry_id": "ef6e435d-e5f5-37ff-ab8b-697cd1e0e20d",
                                        "glosses": [
                                            "die Elektrolyse, den Elektrolyten betreffend"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a61a947-012a-48e9-8e3b-b462cf8f63e9",
                                                "sense_id": "40ac33fc-1084-3290-8eaf-f8bbb673965e",
                                                "text": "Im Gegensatz zu dem metallischen nimmt der elektrolytische Widerstand mit der Temperatur ab."
                                            },
                                            {
                                                "example_id": "b6b1f1fd-c1ad-40c5-a06e-9e16f7fa92bf",
                                                "sense_id": "40ac33fc-1084-3290-8eaf-f8bbb673965e",
                                                "text": "Viele Verbindungen leiten im geschmolzenen Zustande elektrolytisch."
                                            },
                                            {
                                                "example_id": "d768ae69-f18a-42fc-a755-1479daa388c9",
                                                "sense_id": "40ac33fc-1084-3290-8eaf-f8bbb673965e",
                                                "text": "Elektrolytisches Polieren ist eine elektrochemische Behandlung, die zur Einebnung und zum Glänzen einer ursprünglich matten und rauen metallischen Oberfläche führt."
                                            },
                                            {
                                                "example_id": "0202086d-7c9c-44df-970b-8e55971eef75",
                                                "sense_id": "40ac33fc-1084-3290-8eaf-f8bbb673965e",
                                                "text": "Das aus sauren kolloidfreien Kupfervitriollösungen elektrolytisch abgeschiedene Kupfer hat kristallinisches Gefüge."
                                            },
                                            {
                                                "example_id": "d52bca12-1591-4dd8-b08a-36fae13f5dbb",
                                                "sense_id": "40ac33fc-1084-3290-8eaf-f8bbb673965e",
                                                "text": "Die Isotonie (Isosmie) des Organismus ist an die gleichbleibende Konzentration seiner mineralischen Bestandteile gebunden, wobei ihre elektrolytische Dissoziation infolge der Einwirkung auf die Größe des osmotischen Druckes in Rechnung gesetzt werden muß."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
