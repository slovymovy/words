        "fr-extract.jsonl": [
            {
                "entry_id": "b22a481e-0177-3d24-b8be-a968de51d824",
                "word": "culturisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "05460fe6-5712-4def-97c3-2fa89727ab87",
                        "entry_id": "b22a481e-0177-3d24-b8be-a968de51d824",
                        "tags": [
                            "plural"
                        ],
                        "form": "culturismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "61dd5319-a8cc-3fae-b567-895d83e35c43",
                        "entry_id": "b22a481e-0177-3d24-b8be-a968de51d824",
                        "glosses": [
                            "Sport qui consiste à développer sa musculature."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca164362-6f27-4bf8-b253-3b9ff4e1f93e",
                                "sense_id": "61dd5319-a8cc-3fae-b567-895d83e35c43",
                                "text": "Il se dirigea vers l’allée, progressant par petites foulées, tels ces athlètes qui se présentent devant le podium lors d’un concours de culturisme."
                            },
                            {
                                "example_id": "e2df4fc4-3d69-47f0-a730-7f58b6d7f6db",
                                "sense_id": "61dd5319-a8cc-3fae-b567-895d83e35c43",
                                "text": "C’est en faisant de la rééducation que j’ai commencé à tâter du culturisme."
                            },
                            {
                                "example_id": "d9bd9516-62f1-4e02-9752-47d0d3fa9fa4",
                                "sense_id": "61dd5319-a8cc-3fae-b567-895d83e35c43",
                                "text": "La carnitine est également très appréciée des fanas du fitness et du culturisme, que certains médecins nomment « bigorexiques » – des malades atteints d'une nouvelle forme de trouble obsessionnel de l'alimentation et du comportement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aff4b674-dbf5-4e70-b0fd-7a99b895b340",
                        "source_entry_id": "b22a481e-0177-3d24-b8be-a968de51d824",
                        "source_sense_id": "61dd5319-a8cc-3fae-b567-895d83e35c43",
                        "target_lang_word": "bodybuilding",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bodybuilding",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c204c8d7-cc6a-333b-90c6-7a7c6c73dfc9",
                                        "entry_id": "fa9200ab-9b35-37ed-a071-6954cd580e94",
                                        "glosses": [
                                            "A sport in which the aesthetics of muscular development is the basis for competition."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f80abce-499d-4d68-80cc-09ae707dc585",
                                                "sense_id": "c204c8d7-cc6a-333b-90c6-7a7c6c73dfc9",
                                                "text": "Like those activities, bodybuilding is an obsession, a living (for a few), and a way of life for the people involved in it—a subculture, in a word, with its own values, aesthetics and vocabulary."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48eabc07-9b40-33cf-b139-e78d6426f1ba",
                                        "entry_id": "fa9200ab-9b35-37ed-a071-6954cd580e94",
                                        "glosses": [
                                            "Work done to construct or repair the body of an automobile."
                                        ],
                                        "tags": [
                                            "dated",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b262f956-134e-4603-9996-b2b6294629fd",
                                                "sense_id": "48eabc07-9b40-33cf-b139-e78d6426f1ba",
                                                "text": "In my day, if you filled out your shirt, people assumed you played football or wrestled. The term bodybuilding had more to do with cars than lifting weights."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
