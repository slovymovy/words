                                "target_lang_sense_clarification": "искать и приобретать подержанные вещи"
                            },
                            {
                                "target_lang_word": "ходить по барахолкам",
                                "target_lang_sense_clarification": "посещать блошиные рынки или комиссионки"
                            },
                            {
                                "target_lang_word": "заниматься трифтингом",
                                "target_lang_sense_clarification": "увлекаться покупками в секонд-хендах"
                            }
