                "senses": [
                    {
                        "sense_id": "24c477ee-937b-3f67-94ae-224100b587be",
                        "entry_id": "9fc13be6-1e40-37f6-9636-dc78f32d69e7",
                        "glosses": [
                            "Structure creuse en forme d’entonnoir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d0a5816-8d74-43ef-98bd-b6d992886b24",
                                "sense_id": "24c477ee-937b-3f67-94ae-224100b587be",
                                "text": "L’infundibulum pulmonaire (ou chambre de chasse ventriculaire droite ou cône artériel) correspondant à la partie du ventricule droit précédent la bifurcation des deux artères pulmonaires."
                            },
                            {
                                "example_id": "aba4b078-1177-4970-a584-6505471f5182",
                                "sense_id": "24c477ee-937b-3f67-94ae-224100b587be",
                                "text": "L’infundibulum du cerveau se trouve sur la partie ventrale du diencéphale, situé en arrière du chiasma optique, accroché à l’hypophyse, il est prolongé par une évagination bilobée suivie par une partie non lobée."
                            },
                            {
                                "example_id": "9f0c0b7f-4cef-4a6d-a970-b609933b49f6",
                                "sense_id": "24c477ee-937b-3f67-94ae-224100b587be",
                                "text": "L’infundibulum des trompes utérines, partie terminale des trompes donnant lieu aux ovaires."
                            }
                        ]
                    }
                ],
