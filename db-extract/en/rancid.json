                                                "sense_id": "0e71960f-4332-348d-9bb5-07e402a22a9c",
                                                "text": "Ce lard, cette huile sent le rance."
                                            },
                                            {
                                                "example_id": "0271b41c-9e22-4264-8106-bd574c79d803",
                                                "sense_id": "0e71960f-4332-348d-9bb5-07e402a22a9c",
                                                "text": "Le rance et le pourri sont aux habitations ce que la naphtaline est aux vêtements suspendus dans l’armoire."
                                            }
                                        ]
                                    }
                                ]
                            },
