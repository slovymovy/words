                {
                    "sense_id": "37ac330e-e937-311f-b010-df1ae14b38c7",
                    "sense_definition": "Ensemble des facteurs physiques, géologiques et climatiques propres à une zone ou à une planète.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "nature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'<w>environnement</w> aride du désert contraint les espèces vivantes à de remarquables adaptations."
                        },
                        {
                            "text": "Sur cette exoplanète lointaine, l'<w>environnement</w> présente une pression atmosphérique trop écrasante."
