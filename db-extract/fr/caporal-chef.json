                        "glosses": [
                            "Grade donné dans l’Armée de terre et l’Armée de l’air françaises, situé entre son supérieur hiérarchique, le sergent, et son subordonné, le caporal, correspondant au quartier-maître de première classe dans la Marine nationale française, et dont le code OTAN est OR-4."
                        ],
                        "tags": [
                            "France"
                        ],
                        "examples": [
                            {
                                "example_id": "63715f2b-983b-4432-8316-161f7411ce4b",
                                "sense_id": "bb4cc6dd-9fb1-3db6-a23d-6d1001570113",
                                "text": "Au bout de la salle, devant une porte, un petit caporal chef, imberbe et blond, en uniforme de fantaisie, était assis devant une table."
                            }
                        ]
                    },
