                                        "entry_id": "1e72ea9c-03ac-3f13-9402-9e5fb88f3398",
                                        "glosses": [
                                            "Maßeinheit der Frequenz; 1 Hz = 1 Schwingung pro Sekunde"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
