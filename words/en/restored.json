                {
                    "sense_id": "9bde428f-e42f-3324-8adb-d15a7f33d129",
                    "sense_definition": "having been returned to a former, original, or perfect condition through repair or renovation",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "renovation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The collectors were amazed to see the <w>restored</w> vintage car looking exactly as it did in 1960.",
                            "target_lang_translations": {
                                "ru": "Коллекционеры были поражены, увидев <w>отреставрированный</w> винтажный автомобиль, выглядящий точно так же, как в 1960 году."
                            }
                        },
                        {
                            "text": "They spent years living in a <w>restored</w> farmhouse that they had renovated with their own hands.",
                            "target_lang_translations": {
                                "ru": "Они провели годы, живя в <w>восстановленном</w> фермерском доме, который отремонтировали своими руками."
                            }
                        }
                    ],
                    "synonyms": [
                        "renovated",
                        "refurbished",
                        "rebuilt",
                        "renewed"
                    ],
                    "antonyms": [
                        "dilapidated",
                        "damaged",
                        "ruined"
                    ],
                    "common_phrases": [
                        "fully restored",
                        "beautifully restored",
                        "restored condition"
                    ],
                    "target_lang_definitions": {
