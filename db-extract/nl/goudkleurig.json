                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e23e7551-331f-4881-b358-cdd1fcafc0c7",
                                "sense_id": "e089f537-8e43-33c0-bd9c-acd48c5540b0",
                                "text": "Zirkonium heeft een goudkleurig aanzien."
                            },
                            {
                                "example_id": "5484ad8f-5f80-4e3f-949f-91acacd61ea4",
                                "sense_id": "e089f537-8e43-33c0-bd9c-acd48c5540b0",
                                "text": "Rijen vensters gloeiden goudkleurig op, en het ruitvormige glas glinsterde. De enige vensters van glas die ik kende, waren de smalle boogramen in de kerk."
                            }
                        ]
                    }
