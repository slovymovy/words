                        "translation_id": "7295f2de-7ce3-45a9-b97f-c70c32b46cfa",
                        "source_entry_id": "78a0be86-72e6-305f-8873-2cfdd6b8881c",
                        "source_sense_id": "72b76f9e-e917-38ac-9473-a6d7bd30ab68",
