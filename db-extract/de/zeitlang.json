                ],
                "senses": [
                    {
                        "sense_id": "1f7cc6e4-a99b-31af-b1df-a4fee87059bd",
                        "entry_id": "cbf5a72f-f70e-30d9-9ffb-d4878d58ecdc",
                        "glosses": [
                            "unbestimmter Zeitraum"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d2b1742-6097-43be-8172-e3c75a2eefc7",
                                "sense_id": "1f7cc6e4-a99b-31af-b1df-a4fee87059bd",
                                "text": "Darüber muss ich erst eine Zeitlang nachdenken."
                            },
                            {
                                "example_id": "774b031a-4e14-4124-8f8f-474f63ce380b",
                                "sense_id": "1f7cc6e4-a99b-31af-b1df-a4fee87059bd",
                                "text": "„Eine Zeitlang wandert er durch die Runden der trinkfreudigen Männer im Offiziersklub, spielt Poker und erlaubt sich einige wenige Seitensprünge.“"
                            },
                            {
                                "example_id": "0b9d0dd4-f673-436a-be9c-a6660d4c1276",
                                "sense_id": "1f7cc6e4-a99b-31af-b1df-a4fee87059bd",
                                "text": "„Eine Zeitlang saßen sie schweigend da.“"
                            },
                            {
                                "example_id": "168622f3-f4a3-4b8a-87ba-0d7b65c935b0",
                                "sense_id": "1f7cc6e4-a99b-31af-b1df-a4fee87059bd",
                                "text": "„Eine Zeitlang war der interkonfessionelle Konflikt fast so tödlich wie die Pest.“"
                            },
                            {
                                "example_id": "c83e51f4-acd7-4f27-bf2b-46946d6afd01",
                                "sense_id": "1f7cc6e4-a99b-31af-b1df-a4fee87059bd",
                                "text": "„Eine Zeitlang ging es mir gut.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
