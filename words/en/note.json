                {
                    "sense_id": "9484050a-3cb2-3617-ace3-a63500137dd0",
                    "sense_definition": "Careful attention, observation, or notice.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please take <w>note</w> of the emergency exits located at the back.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, обратите <w>внимание</w> на запасные выходы, расположенные сзади.",
                                "zh": "请<w>注意</w>位于后方的紧急出口。"
                            }
                        },
                        {
                            "text": "The students took no <w>note</w> of the teacher's warning.",
                            "target_lang_translations": {
                                "ru": "Студенты не обратили <w>внимания</w> на предупреждение учителя.",
                                "zh": "学生们对老师的警告完全没有<w>注意</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "attention",
                        "mark"
                    ],
                    "common_phrases": [
                        "take note",
                        "worthy of note"
