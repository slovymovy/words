                "senses": [
                    {
                        "sense_id": "5c5361f7-b537-3f68-b1f2-ea37b96d008d",
                        "entry_id": "2ff50c4e-2c7d-3552-8f37-9b0d2d9233ac",
                        "glosses": [
                            "Propulser grâce à un turbopropulseur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ef561a1-ac22-4614-b10f-f8cd6c4e47ec",
                                "sense_id": "5c5361f7-b537-3f68-b1f2-ea37b96d008d",
                                "text": "Ils ont probablement des chasseurs pulsants de la classe Scorpion, capables de se turbopropulser en orbite basse si nécessaire."
                            }
                        ]
                    },
                    {
                        "sense_id": "b627fa8a-52a3-3e5b-a48c-1c5a7567b97c",
                        "entry_id": "2ff50c4e-2c7d-3552-8f37-9b0d2d9233ac",
                        "glosses": [
                            "Rendre beaucoup plus efficace."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e32a33c9-d541-4467-b2bb-21f9abdca656",
                                "sense_id": "b627fa8a-52a3-3e5b-a48c-1c5a7567b97c",
                                "text": "Quelques conseils pour turbopropulser vos cours!"
                            },
                            {
                                "example_id": "ddd7a357-ba09-41c8-8d76-6731e3ecc527",
                                "sense_id": "b627fa8a-52a3-3e5b-a48c-1c5a7567b97c",
                                "text": "Alors les mecs, on se cotise et on s'achète un grand champ de colza pour turbopropulser nos écobagnoles?"
                            }
                        ]
                    }
