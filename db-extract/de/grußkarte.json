                "senses": [
                    {
                        "sense_id": "72e15305-ac3e-3c81-bc89-514c85695d5c",
                        "entry_id": "20b4107d-05e3-3bc5-8838-97224f5af52f",
                        "glosses": [
                            "(digitale) Postkarte, mit der man jemandem (meist zu einem besonderen Anlass) Grüße übermittelt als Zeichen der Verbundenheit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfc2e147-0f5c-45af-b083-b92118c86ce4",
                                "sense_id": "72e15305-ac3e-3c81-bc89-514c85695d5c",
                                "text": "Er schickte seinem Freund jedes Jahr zu Weihnachten eine schöne Grußkarte und ein paar Geschenke."
                            },
                            {
                                "example_id": "4e8113cf-fd1a-4be7-b3e6-babb69d34c59",
                                "sense_id": "72e15305-ac3e-3c81-bc89-514c85695d5c",
                                "text": "„Die besten Arten von Grußkarten, die man jemandem geben kann, sind Karten, die eine persönliche Note haben.“"
                            },
                            {
                                "example_id": "94ae143f-6e8d-47cd-b41e-2eff922aa510",
                                "sense_id": "72e15305-ac3e-3c81-bc89-514c85695d5c",
                                "text": "„Überraschen Sie Freunde und Familie doch mal mit diesen selbstgemachten Grußkarten in Marmor-Optik.“"
                            },
                            {
                                "example_id": "458ea1b6-22e0-4b32-b142-4e151364038a",
                                "sense_id": "72e15305-ac3e-3c81-bc89-514c85695d5c",
                                "text": "„Druckgrafikerin und Buchkünstlerin Heidrun Klimmey vom Shop Quadrados aus Bad Doberan zeigt, wie mit einfachen Mitteln in der eigenen Küche Post- oder Grußkarten hergestellt werden können, aus Recyclingmaterial ganz ohne Druckpresse.“"
                            },
                            {
                                "example_id": "4e592d32-2429-470d-9aa9-a4595ce8b6e4",
                                "sense_id": "72e15305-ac3e-3c81-bc89-514c85695d5c",
                                "text": "„Ein Familienporträt als Ostergruß, das geht via Smartphone-App. Dort gestalten Sie ihre Grußkarte selbst, bezahlen und der Anbieter druckt die Karte aus und sorgt für die Zustellung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
