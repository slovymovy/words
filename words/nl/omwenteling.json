    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "eeabb8fd-a6d6-34f4-b20a-355e1c312156",
                    "sense_definition": "een volledige draaiing van een voorwerp om zijn eigen as of om een ander punt",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "draaiing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De aarde maakt in vierentwintig uur een volledige <w>omwenteling</w> om haar as.",
                            "target_lang_translations": {
                                "en": "The Earth makes a complete <w>revolution</w> on its axis in twenty-four hours."
                            }
                        },
                        {
                            "text": "De motor maakt duizenden <w>omwentelingen</w> per minuut om de auto aan te drijven.",
                            "target_lang_translations": {
                                "en": "The engine makes thousands of <w>revolutions</w> per minute to power the car."
                            }
                        }
                    ],
                    "common_phrases": [
                        "volledige omwenteling",
                        "omwentelingen per minuut"
                    ],
                    "target_lang_definitions": {
                        "en": "a complete rotation of an object around its own axis or around another point"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "revolution",
                                "target_lang_sense_clarification": "a complete turn or orbit"
                            },
                            {
                                "target_lang_word": "rotation",
                                "target_lang_sense_clarification": "turning around an axis"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "27d6b307-bf0c-3284-9ecc-7917f8f38d78",
                    "sense_definition": "een plotselinge en radicale verandering in het bestuur of de sociale orde van een land",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verandering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gelukkig verliep deze politieke <w>omwenteling</w> zonder enig geweld in de straten.",
                            "target_lang_translations": {
                                "en": "Fortunately, this political <w>revolution</w> took place without any violence in the streets."
                            }
                        },
                        {
                            "text": "Na de grote <w>omwenteling</w> kreeg het volk eindelijk meer democratische rechten.",
                            "target_lang_translations": {
                                "en": "After the great <w>upheaval</w>, the people finally gained more democratic rights."
                            }
                        }
                    ],
                    "synonyms": [
                        "revolutie"
                    ],
                    "common_phrases": [
                        "politieke omwenteling",
                        "sociale omwenteling"
                    ],
                    "target_lang_definitions": {
                        "en": "a sudden and radical change in the government or social order of a country"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "revolution",
                                "target_lang_sense_clarification": "political upheaval"
                            },
                            {
                                "target_lang_word": "overthrow",
                                "target_lang_sense_clarification": "removal of a government"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b1cb5f77-5387-340e-9378-546d1399fcb1",
                    "sense_definition": "een zeer grote en ingrijpende verandering in de bestaande verhoudingen of denkwijzen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verandering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De relativiteitstheorie betekende een ware <w>omwenteling</w> in de moderne natuurkunde.",
                            "target_lang_translations": {
                                "en": "The theory of relativity represented a true <w>revolution</w> in modern physics."
                            }
                        },
                        {
                            "text": "De uitvinding van het internet zorgde voor een digitale <w>omwenteling</w> in onze communicatie.",
                            "target_lang_translations": {
                                "en": "The invention of the internet caused a digital <w>revolution</w> in our communication."
                            }
                        }
                    ],
                    "synonyms": [
                        "revolutie"
                    ],
                    "common_phrases": [
                        "digitale omwenteling",
                        "ware omwenteling"
                    ],
                    "target_lang_definitions": {
                        "en": "a very large and profound change in existing relations or ways of thinking"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "revolution",
                                "target_lang_sense_clarification": "vast change in a discipline or mindset"
                            },
                            {
                                "target_lang_word": "upheaval",
                                "target_lang_sense_clarification": "major social or structural change"
                            },
                            {
                                "target_lang_word": "breakthrough",
                                "target_lang_sense_clarification": "significant progress or discovery"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}