                    {
                        "translation_id": "40b22ad2-1d12-4796-84ed-37f4a3edaa6d",
                        "source_entry_id": "4dfa9676-64de-37ad-9c7e-97b36f007002",
                        "source_sense_id": "76aff20e-2b8b-3950-b6d0-dd91512d0315",
