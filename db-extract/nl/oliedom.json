                "senses": [
                    {
                        "sense_id": "ebffb9aa-a6d0-3a55-8f7b-cf050badd8d6",
                        "entry_id": "20ab3b23-bc12-34ec-ab2a-5be370ab1edf",
                        "glosses": [
