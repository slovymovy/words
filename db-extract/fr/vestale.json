                                "target_senses": [
                                    {
                                        "sense_id": "30cfc4ba-fd0b-34c8-94b5-afdf1909a38f",
                                        "entry_id": "94929fcd-3516-3606-a1c8-4488fdca1fce",
                                        "glosses": [
                                            "sacerdotessa dell'antica Roma dedita al culto della dea Vesta, il cui ufficio comprendeva la cura del fuoco sacro della dea e l'obbligo della verginità"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9fff01d1-ebbf-470e-ac86-91b6b3609e06",
                                                "sense_id": "30cfc4ba-fd0b-34c8-94b5-afdf1909a38f",
                                                "text": "secondo la leggenda, la madre di Romolo e Remo era una vestale"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "198fc775-3511-3f7c-a92a-cabd391d2307",
                                        "entry_id": "94929fcd-3516-3606-a1c8-4488fdca1fce",
                                        "glosses": [
                                            "persona (di ambo i sessi) che è o si dichiara difensore indefesso di una data idea o principio morale"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c5045bf-850e-4bdb-b050-60bc35b504b8",
                                                "sense_id": "198fc775-3511-3f7c-a92a-cabd391d2307",
                                                "text": "si presenta come la vestale della moralità tradizionale"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4acf5df7-2060-4798-9d38-97c2f1366029",
                        "source_entry_id": "a35aa32d-6c16-3979-89a6-448e96e21780",
                        "source_sense_id": "7166d11a-5927-3fdc-8840-75c5cc452694",
