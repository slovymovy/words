                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f621ac3-a2d4-49b5-89f6-c560e9447615",
                                                "sense_id": "7f7e46fe-d132-3d56-b1aa-9e353b480be2",
                                                "text": "Mezi hosty byla i nejznámější obránkyně lidských práv v současném Rusku Ludmila Alexejevová."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab4dff4b-91f6-3a12-9a32-da6706111964",
                                        "entry_id": "f5113184-189b-3753-aa73-d709c2fbade0",
                                        "glosses": [
                                            "žena hrající v obraně"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09402cd0-b1d8-45ee-a39d-7f94411406bc",
                                                "sense_id": "ab4dff4b-91f6-3a12-9a32-da6706111964",
                                                "text": "Angela Ruggiero během své patnáctileté reprezentační kariéry byla klíčovou obránkyní národního týmu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
