                    "frequency": "Middle",
                    "semantic_group_id": "animal equipment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stable worker gently slipped the leather <w>halter</w> over the young horse's head."
                        },
                        {
                            "text": "Make sure you tie the rope securely to the <w>halter</w> before leading the cow into the barn."
