                            },
                            {
                                "target_lang_word": "подмышечная впадина",
                                "target_lang_sense_clarification": "более формальный или медицинский термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "71df3381-af8f-3c4d-a0f7-92615e330b0e",
                    "sense_definition": "A place or thing that is considered very unpleasant or undesirable.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "metaphorical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small town was often called the <w>armpit</w> of the state due to its pollution.",
                            "target_lang_translations": {
                                "ru": "Этот городок часто называли <w>дырой</w> штата из-за его загрязнённости."
                            }
                        },
                        {
                            "text": "He complained that the old office building was the <w>armpit</w> of the company.",
                            "target_lang_translations": {
                                "ru": "Он жаловался, что старое офисное здание было худшей <w>помойкой</w> в компании."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Used in a derogatory or informal manner."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Крайне неприятное, непривлекательное или гиблое место."
