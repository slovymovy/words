                "senses": [
                    {
                        "sense_id": "443dd13c-94ee-340f-881a-696d21438d65",
                        "entry_id": "dde1c855-1c90-39b3-97d7-fbf0c70488a3",
                        "glosses": [
                            "Relatif aux protéines."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3cbf725a-be74-4960-93ae-1dd7059af69e",
                                "sense_id": "443dd13c-94ee-340f-881a-696d21438d65",
                                "text": "Ces produits, appelés matières albuminoïdes ou substances protéiques, jouent un rôle essentiel dans le développement des êtres vivants : l'albumine de l'œuf, la fibrine du sang, la caséine du lait, le gluten de la farine appartiennent à ce groupe."
                            },
                            {
                                "example_id": "04749f48-f49e-4168-8e7d-172acce86d64",
                                "sense_id": "443dd13c-94ee-340f-881a-696d21438d65",
                                "text": "Votre article sur la possible modification génétique de l’apport protéique des Anotrichium yagii pour transformer une algue invasive en complément nutritif est passionnant."
                            }
                        ]
                    }
                ],
