                    "frequency": "High",
                    "semantic_group_id": "uśmiech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W progu powitał nas niezwykle <w>uśmiechnięty</w> kelner i zaprosił do stolika.",
                            "target_lang_translations": {
                                "ru": "На пороге нас встретил необычайно <w>улыбчивый</w> официант и пригласил к столику."
                            }
                        },
                        {
                            "text": "Dziecko miało wesołe oczy i było bardzo <w>uśmiechnięte</w> przez cały dzień.",
                            "target_lang_translations": {
                                "ru": "У ребёнка были весёлые глаза, и он был очень <w>улыбчивым</w> весь день."
