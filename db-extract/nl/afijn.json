                "senses": [
                    {
                        "sense_id": "8411e0b7-4794-348f-b9e0-64c85e9747ec",
                        "entry_id": "3b8a39c1-1832-346e-be2c-0eb31f0fe848",
                        "glosses": [
                            "enfin, welnu"
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "f45751da-04e2-4e5d-a7b1-d5918abdf38f",
                                "sense_id": "8411e0b7-4794-348f-b9e0-64c85e9747ec",
                                "text": "Afijn, Meskini stond op om zijn schoenen aan te trekken toen hij een schelle kreet achter zich hoorde."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fd59e65a-a78e-4bae-ac82-5191eb637c2d",
                        "source_entry_id": "3b8a39c1-1832-346e-be2c-0eb31f0fe848",
                        "source_sense_id": "8411e0b7-4794-348f-b9e0-64c85e9747ec",
                        "target_lang_word": "enfin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enfin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a5049800-68fb-393a-a025-16090e851e38",
                                        "entry_id": "fbe81637-e4f5-3260-ad15-9cf749d7d320",
                                        "glosses": [
                                            "À la fin ; après un long temps ; après une longue attente."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51ba5adf-60ff-49fd-9ac5-a8e0a4e5a089",
                                                "sense_id": "a5049800-68fb-393a-a025-16090e851e38",
                                                "text": "Mais, comme elle débouchait enfin sur la place Gaillon, la jeune fille s'arrêta net de surprise."
                                            },
                                            {
                                                "example_id": "f7f1323b-953d-4ecf-a946-89c8e0faa5bc",
                                                "sense_id": "a5049800-68fb-393a-a025-16090e851e38",
                                                "text": "Mais tandis que notre politique marocaine restait inconsistante, notre opinion publique avait enfin commencé à s’intéresser au Maroc."
                                            },
                                            {
                                                "example_id": "c5e0e856-a05e-47aa-9f2b-dc45a4fd75b0",
                                                "sense_id": "a5049800-68fb-393a-a025-16090e851e38",
                                                "text": "Après s'être empêtrés à plusieurs reprises dans les roulières boueuses et avoir poussé sur la voiture dans le but d'alléger la charge de Grattan, Elwin et Mary arrivèrent enfin à la cabane."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b364593-33b1-32bc-b881-d1f51b4349e4",
                                        "entry_id": "fbe81637-e4f5-3260-ad15-9cf749d7d320",
                                        "glosses": [
                                            "À la fin d’une énumération, pour abréger, en résumé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9bfd8f29-6a4b-4e8f-8548-029bf18380f1",
                                                "sense_id": "3b364593-33b1-32bc-b881-d1f51b4349e4",
                                                "text": "Les champs, les bois, tout enfin dans ce domaine présente un aspect lamentable."
                                            },
                                            {
                                                "example_id": "bdcb13aa-6d32-4d7f-a15f-58564a204c4c",
                                                "sense_id": "3b364593-33b1-32bc-b881-d1f51b4349e4",
                                                "text": "Il était affable, plein de dévouement, de charité pour les pauvres, ami de la justice, enfin l’idole de tous ses sujets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af4d750c-8575-3f2d-ab6b-4114c6403072",
                                        "entry_id": "fbe81637-e4f5-3260-ad15-9cf749d7d320",
                                        "glosses": [
                                            "Après tout, en conclusion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1427a29-80fd-4d0f-b6a0-cb9a8bc69fbb",
                                                "sense_id": "af4d750c-8575-3f2d-ab6b-4114c6403072",
                                                "text": "Puisque enfin vous le voulez."
                                            },
                                            {
                                                "example_id": "bb8d7d74-e112-4244-a44c-1fde2b66d045",
                                                "sense_id": "af4d750c-8575-3f2d-ab6b-4114c6403072",
                                                "text": "Car enfin que pouvait-il faire ?"
                                            },
                                            {
                                                "example_id": "4ec192d3-0975-4523-8d81-7b2847d575e6",
                                                "sense_id": "af4d750c-8575-3f2d-ab6b-4114c6403072",
                                                "text": "Mais enfin que vous a-t-il dit ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "292e0120-e68a-3229-b541-38e326e1563f",
                                        "entry_id": "fbe81637-e4f5-3260-ad15-9cf749d7d320",
                                        "glosses": [
                                            "Introduit une correction ou une précision de ce qui était dit précédemment."
                                        ],
                                        "tags": [
                                            "Épanorthose"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2533673d-5ef2-4577-a035-3e2ca2f20306",
                                                "sense_id": "292e0120-e68a-3229-b541-38e326e1563f",
                                                "text": "[…] : la plaque tectonique de droite qui recouvre la télé depuis 1995 au moins s’est effondrée. Enfin presque, pasque faut pas déconner non plus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32f95a3b-2394-3b14-aec5-faa8553a417b",
                                        "entry_id": "fbe81637-e4f5-3260-ad15-9cf749d7d320",
                                        "glosses": [
                                            "Marque une conclusion résignée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fdf9dfe-0fda-4f9e-b7bf-4c68d80026a2",
                                                "sense_id": "32f95a3b-2394-3b14-aec5-faa8553a417b",
                                                "text": "Et il faut à chaque fois tout reconstruire derrière leur passage. Enfin, c'est la vie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a665c646-3a78-342d-a15e-9cde426907fc",
                                        "entry_id": "fbe81637-e4f5-3260-ad15-9cf749d7d320",
                                        "glosses": [
                                            "Exprime l’impatience, la réprobation ou l’exaspération."
                                        ],
                                        "tags": [
                                            "Interjection"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05613b91-72dd-4aa7-a716-2e4f177486d9",
                                                "sense_id": "a665c646-3a78-342d-a15e-9cde426907fc",
                                                "text": "Mais arrêtez, enfin !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
