                                    },
                                    {
                                        "sense_id": "0a08aa09-e86c-3420-9fa4-bc7f27224b26",
                                        "entry_id": "41d8820f-941b-39ad-a3f8-7d5ae8766a82",
                                        "glosses": [
                                            "Chef politique, dans le monde musulman."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30e60c8d-2208-4925-b6c7-997dca241ff6",
                                                "sense_id": "0a08aa09-e86c-3420-9fa4-bc7f27224b26",
                                                "text": "Il tentera surtout de convaincre le raïs égyptien, Hosni Moubarak, que la priorité des priorités n’est pas le conflit israélo-palestinien, mais plutôt la menace que constitue l’Iran pour la région."
                                            }
                                        ]
