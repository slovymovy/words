                ],
                "senses": [
                    {
                        "sense_id": "e1cf12f9-267c-34b8-8221-cb381110049a",
                        "entry_id": "a448df9e-9217-36c6-b40e-e92d4a6420b6",
                        "glosses": [
                            "Brei aus grob gemahlenem Haferkörnern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e305cb0-3426-4e3f-a5bf-fd3f65350226",
                                "sense_id": "e1cf12f9-267c-34b8-8221-cb381110049a",
                                "text": "Die Kinder bekommen heute Hafergrütze zum Frühstück."
                            },
                            {
                                "example_id": "92aff8b8-6687-4abe-9768-e4d5340b2341",
                                "sense_id": "e1cf12f9-267c-34b8-8221-cb381110049a",
                                "text": "„Man macht daraus die Hafergrütze […], indem man auf der Mühle die Spelzen abstossen lässt.“"
                            },
                            {
                                "example_id": "530d5eb0-1eea-4448-a80a-9ee37ff7c10c",
                                "sense_id": "e1cf12f9-267c-34b8-8221-cb381110049a",
                                "text": "„Der Herr aß weiter seine Hafergrütze, kniff die Augen zusammen und zog die Augenbrauen hoch, wie man es macht, wenn man Karten spielt und die andern nicht merken sollen, was man in der Hand hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
