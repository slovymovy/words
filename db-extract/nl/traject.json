                        "entry_id": "b66a9d89-ef64-3ec0-8d9b-ad2d14bbf0cb",
                        "glosses": [
                            "de af te leggen of afgelegde weg van een voorwerp door de ruimte"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a87d690b-11fb-340b-8342-996c12705b4a",
                        "entry_id": "b66a9d89-ef64-3ec0-8d9b-ad2d14bbf0cb",
                        "glosses": [
                            "weg of route"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f604e61-2925-4c8c-b76e-d364835fc549",
                                "sense_id": "a87d690b-11fb-340b-8342-996c12705b4a",
                                "text": "Toch blijft de Nationale 7 een mythisch traject, een Franse Route 66, aan een tweede leven begonnen als nostalgische attractie. 'De mensen willen terugkeren naar een gelukkige tijd', zegt Patrick Henriroux (55), patron van tweesterrenrestaurant La Pyramide in Vienne."
                            }
                        ]
                    },
                    {
                        "sense_id": "9f468dad-0cc4-3422-90c5-1d84e85a8cd1",
                        "entry_id": "b66a9d89-ef64-3ec0-8d9b-ad2d14bbf0cb",
                        "glosses": [
                            "gang van zaken; reeks gebeurtenissen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c06f0fe-6c54-473a-9bb1-1ebce4971893",
                                "sense_id": "9f468dad-0cc4-3422-90c5-1d84e85a8cd1",
                                "text": "De jonge ondernemer is hoopvol dat de Italiaanse anti-hennepwet na een juridisch traject zal sneuvelen. Hoogst onzeker is hoelang dat zal duren. En die onzekerheid is bad for business, merkt hij al maanden: \"Investeerders gaan naar landen waar het veiliger is en klanten durven geen bestellingen meer te plaatsen.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e6c99e36-4032-4a0e-95bd-7f067f4bbfa8",
                        "source_entry_id": "b66a9d89-ef64-3ec0-8d9b-ad2d14bbf0cb",
                        "source_sense_id": "96339912-ed6d-3d08-b28d-714638fffb10",
                        "source_sense_description": "de af te leggen of afgelegde weg van een voorwerp door de ruimte",
                        "target_lang_word": "Bahn",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bahn",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2bccb127-0134-3ac4-a609-22714ebe241b",
                                        "entry_id": "3bb52b5c-1b3c-385c-b10e-69a36888fc53",
                                        "glosses": [
                                            "Strecke, die von einem Körper in einer vorgeschriebenen Richtung durchmessen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db51b78a-60a1-4fc1-8271-471c7d538f2e",
                                                "sense_id": "2bccb127-0134-3ac4-a609-22714ebe241b",
                                                "text": "Cecilie geriet nun endgültig auf die schiefe Bahn."
                                            },
                                            {
                                                "example_id": "76e9377a-2155-4448-9b73-433f81750faf",
                                                "sense_id": "2bccb127-0134-3ac4-a609-22714ebe241b",
                                                "text": "„Ich habe mein Leben wieder in der Hand, und es verläuft in ruhigen Bahnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f920d912-2b22-3081-8dea-41464ad0d6f0",
                                        "entry_id": "3bb52b5c-1b3c-385c-b10e-69a36888fc53",
                                        "glosses": [
                                            "in einer bestimmten Länge und Breite vorgegebene Spur für Fahrzeuge"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86061e43-d994-4e2d-98fc-31030ef031df",
                                                "sense_id": "f920d912-2b22-3081-8dea-41464ad0d6f0",
                                                "text": "Der Autoscooter wurde in die richtige Bahn gelenkt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "19595d27-10a8-39f3-b99a-d5f3fc516a06",
                                        "entry_id": "3bb52b5c-1b3c-385c-b10e-69a36888fc53",
                                        "glosses": [
                                            "festgelegte Strecke für sportliche Wettkämpfe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1c9ae03-6a9d-4157-9dff-d1c95f090d0c",
                                                "sense_id": "19595d27-10a8-39f3-b99a-d5f3fc516a06",
                                                "text": "Thekla ruft laut „Bahn frei!“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "36c9b30e-07de-3c02-a520-127937593c84",
                                        "entry_id": "3bb52b5c-1b3c-385c-b10e-69a36888fc53",
                                        "glosses": [
                                            "ein schienengebundenes Verkehrsmittel"
                                        ],
                                        "tags": [
                                            "Transportwesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "918f2b5b-754e-4697-8855-c1f2d35e91a6",
                                                "sense_id": "36c9b30e-07de-3c02-a520-127937593c84",
                                                "text": "Früher fuhr von der Ziegelei in die Lehmgrube noch eine Bahn."
                                            },
                                            {
                                                "example_id": "5c1ce743-99f1-40bf-858e-0e7c5b9085f3",
                                                "sense_id": "36c9b30e-07de-3c02-a520-127937593c84",
                                                "text": "Am Fahrkartenautomaten kann man die Verbundkarte für Bus und Bahn lösen."
                                            },
                                            {
                                                "example_id": "bd927472-bff2-4a4b-901e-b481cab5bf92",
                                                "sense_id": "36c9b30e-07de-3c02-a520-127937593c84",
                                                "text": "„Ich bin der letzte Kunde, ich komm' nicht los vom Hahn.",
                                                "translation": "Ich bin der letzte Kunde und immer noch nicht blau.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "36bb74a0-5950-3344-a3dd-5226c4b87469",
                                        "entry_id": "3bb52b5c-1b3c-385c-b10e-69a36888fc53",
                                        "glosses": [
                                            "Kurzform für die Eisenbahn"
                                        ],
                                        "tags": [
                                            "Eisenbahnwesen",
                                            "Transportwesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bdb88183-ab96-4586-929f-dcea39544664",
                                                "sense_id": "36bb74a0-5950-3344-a3dd-5226c4b87469",
                                                "text": "„Ich bin der letzte Kunde, ich komm' nicht los vom Hahn.",
                                                "translation": "Ich bin der letzte Kunde und immer noch nicht blau.“"
                                            },
                                            {
                                                "example_id": "c52cbac6-e8a5-4556-9846-e5843c1b7aa4",
                                                "sense_id": "36bb74a0-5950-3344-a3dd-5226c4b87469",
                                                "text": "„Sie machte sich schon früh auf den Weg und fuhr mit der Bahn bis Monschau.“"
                                            },
                                            {
                                                "example_id": "a3ceff92-e94d-4ed2-a985-58cd3927688e",
                                                "sense_id": "36bb74a0-5950-3344-a3dd-5226c4b87469",
                                                "text": "Kommt Theoderich mit der Bahn?"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "fea60768-816b-3fc6-a1c6-7120261eca81",
