                        "examples": [
                            {
                                "example_id": "5c14d604-676f-42c1-8458-8089b0202703",
                                "sense_id": "3607178b-9962-3118-b583-29de6fad92f9",
                                "text": "The reduplicated forms and the fineness of the diacritical strokes, render his book troublesome to the reader"
                            },
                            {
                                "example_id": "a041825d-4e3d-478b-af0a-5c10e48b7fb9",
                                "sense_id": "3607178b-9962-3118-b583-29de6fad92f9",
                                "text": "California, like several other states, prohibits the use of diacritical marks or accents on official documents. That means no tilde (~), no accent grave (`), no umlaut (¨) and certainly no cedilla (¸)."
                            }
                        ]
                    }
