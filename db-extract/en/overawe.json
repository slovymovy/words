                    },
                    {
                        "form_id": "7629ba8e-cb58-4bed-bd8c-6f5dc3daf54b",
                        "entry_id": "d928c40c-dca6-3781-b8e2-f4fc6f0369e0",
                        "tags": [
                            "past"
                        ],
                        "form": "overawed"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6f7aec5a-0c6c-3de3-a079-08e84ef3eee0",
                        "entry_id": "d928c40c-dca6-3781-b8e2-f4fc6f0369e0",
                        "glosses": [
                            "To restrain, subdue, or control by awe; to cow."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "24a0f1ea-59f0-4b6e-8ec8-a61245adcd91",
                                "sense_id": "6f7aec5a-0c6c-3de3-a079-08e84ef3eee0",
                                "text": "None doe you like, but an effeminate Prince, Whom like a Schoole-boy you may ouer-awe."
                            },
                            {
                                "example_id": "bbb19bbe-d7cf-4b7f-b4c6-ab1f579455f8",
                                "sense_id": "6f7aec5a-0c6c-3de3-a079-08e84ef3eee0",
                                "text": "His free and easy carriage evinced, that though acknowledging my assumptions, he was no way overawed by them; treating me as familiarly, indeed, as if I were a mere mortal, one of the abject generation of mushrooms."
                            },
                            {
                                "example_id": "29f1c0c1-6e90-4cee-baee-2ac6daea8fe4",
                                "sense_id": "6f7aec5a-0c6c-3de3-a079-08e84ef3eee0",
                                "text": "He kept the biggest estates, and where he lacked troops to overawe the natives he evicted the natives and made a game reserve."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9b72ed86-d49c-4d98-b1fb-4ccdb192d185",
                        "source_entry_id": "d928c40c-dca6-3781-b8e2-f4fc6f0369e0",
                        "source_sense_id": "6f7aec5a-0c6c-3de3-a079-08e84ef3eee0",
