                    {
                        "sense_id": "0c91a1ca-c16e-3caa-a357-77c347570d41",
                        "entry_id": "fc25f77b-690d-3b86-a43f-64976b74eb44",
                        "glosses": [
                            "A tube inserted into the body to drain or inject fluid."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "401f7886-bb23-44c1-b057-70be831ad03d",
                                "sense_id": "0c91a1ca-c16e-3caa-a357-77c347570d41",
                                "text": "Two or three cannulæ are requisite also for washing out the sinuses."
                            },
                            {
                                "example_id": "4ad9362c-7386-40f9-afb3-c52f63d58892",
                                "sense_id": "0c91a1ca-c16e-3caa-a357-77c347570d41",
                                "text": "The cannula had come askew in his nose and he pushed it straight, his hand moving slowly, like the hand of a man who is dreaming with his eyes open."
                            }
                        ]
                    },
                    {
                        "sense_id": "5ff71432-b0c0-32c4-84f4-d4841038a1f3",
                        "entry_id": "fc25f77b-690d-3b86-a43f-64976b74eb44",
                        "glosses": [
                            "A hose or tube that connects directly from an oxygen bottle or other source to the user's nose, commonly used by aircraft pilots or others needing direct oxygen breathing apparatus."
