                "senses": [
                    {
                        "sense_id": "d23b6e0f-bf1b-3bc1-a4c8-263d07cf91e6",
                        "entry_id": "1742fef5-4228-3e8d-9a12-24b515e92c2b",
                        "glosses": [
                            "ein Angehöriger eines Hirtenvolks, das in Namibia, Botsuana und Angola lebt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0988834-3d9d-4bd9-9516-34141f938f12",
                                "sense_id": "d23b6e0f-bf1b-3bc1-a4c8-263d07cf91e6",
                                "text": "„Im Betschuanaland führen die überlebenden Herero unter Führung von Samuel Maharero ein Minderheitendasein.“"
                            },
                            {
                                "example_id": "4e76de78-80ef-4eea-bf71-5ec685b623ce",
                                "sense_id": "d23b6e0f-bf1b-3bc1-a4c8-263d07cf91e6",
                                "text": "„Obwohl es sich bei den meisten gefangenen Herero und Nama um Frauen und Kinder und alte bzw. kranke Männer handelte, wurden viele von ihnen als Zwangsarbeiter eingesetzt.“"
                            },
                            {
                                "example_id": "aa7606e8-2549-42e6-a3c8-b1fceaea98b6",
                                "sense_id": "d23b6e0f-bf1b-3bc1-a4c8-263d07cf91e6",
                                "text": "„Weil Trotha die rebellierenden Herero militärisch nicht vollständig besiegen konnte, ließ er sie in eine Wüste treiben.“"
                            },
                            {
                                "example_id": "89928b2d-bff8-4dd6-ae2d-48a7eba3b5ec",
                                "sense_id": "d23b6e0f-bf1b-3bc1-a4c8-263d07cf91e6",
                                "text": "„Die verbleidenden Herero hatten irgendwie überlebt – im Exil, verstreut, in Konzentrationslagern, als Sklaven.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
