                                        "sense_id": "d3cbe78b-0d04-318f-b7cc-d4660305a072",
                                        "entry_id": "d0d8aa09-5857-39a4-8cea-c8de9f4a5b3e",
                                        "glosses": [
                                            "von besonders guter Qualität; in solch einer Güte kaum noch einmal vorkommend"
