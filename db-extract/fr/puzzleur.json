                        "sense_id": "31fd9bfe-0d24-379c-8fef-96b15a03be13",
                        "entry_id": "35fb2955-4265-3799-bed3-39d65881a1ff",
                        "glosses": [
                            "Homme qui aime faire des puzzles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c97707af-cd57-44cf-b906-5ccae0806336",
                                "sense_id": "31fd9bfe-0d24-379c-8fef-96b15a03be13",
                                "text": "Le puzzle, qui est l’objet du travail de reconstitution, a été conçu et réalisé dans une séquence précédente par les élèves du groupe de travail auquel appartient l’élève-correspondant mais pas le puzzleur."
                            },
                            {
                                "example_id": "70f84459-13e4-45e5-ac63-f4f7ec7ba6ac",
                                "sense_id": "31fd9bfe-0d24-379c-8fef-96b15a03be13",
                                "text": "L’idée lui en est venue non parce qu’on organise à Zurich en été des concours publics auxquels se livrent les puzzleurs, puzzlistes, puzzlophiles et puzzlâtres, fondus de puzzlologie du monde entier."
                            },
                            {
                                "example_id": "2eaa8b3a-556a-4520-a787-0f50d77b83e0",
                                "sense_id": "31fd9bfe-0d24-379c-8fef-96b15a03be13",
                                "text": "Les « puzzleurs » imaginent des combinaisons personnelles."
                            }
                        ]
                    }
