                "senses": [
                    {
                        "sense_id": "e8b762e9-a77b-38e0-98a9-425ad5519931",
                        "entry_id": "6f51c011-9da5-3f0d-8d36-c82c5587af20",
                        "glosses": [
                            "Gebiet im Bereich der Ostsee"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0adca86-c2a6-445e-bd2f-5638ca0214ec",
                                "sense_id": "e8b762e9-a77b-38e0-98a9-425ad5519931",
                                "text": "„Denn wenn beispielsweise im Ostseeraum ein Masterplan nicht aufgehe, dann spreche wenig dafür, dass er in Bangladesch sinnvoll ist.“"
                            },
                            {
                                "example_id": "30501a68-4926-4f43-8d50-3d947b820244",
                                "sense_id": "e8b762e9-a77b-38e0-98a9-425ad5519931",
                                "text": "„Haithabu, dessen Rang als Handelsmetropole des Ostseeraumes durch umfassende Ausgrabungen immer deutlicher hervortritt, war im 9. und 10. Jahrhundert der wichtigste Umschlagplatz für den Handel zwischen dem Westen und der skandinavisch-slawischen Welt.“"
                            },
                            {
                                "example_id": "f0bf6d36-3d0b-4a48-a21c-78607c311696",
                                "sense_id": "e8b762e9-a77b-38e0-98a9-425ad5519931",
                                "text": "„Zar Nikolaus I. wollte nicht zulassen, dass Preußen zur Großmacht im Ostseeraum wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
