{
    "word_family": [
        "wandel",
        "wandelen",
        "wandelend"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "eaf1090c-9a7b-3686-887d-679d71fdeeb9",
                    "sense_definition": "Iemand die zich te voet verplaatst.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "persoon_die_loopt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>wandelaar</w> liep rustig door het park.",
                            "target_lang_translations": {
                                "it": "Il <w>pedone</w> camminava tranquillamente attraverso il parco."
                            }
                        },
                        {
                            "text": "Elke <w>wandelaar</w> genoot van de frisse lucht tijdens de tocht.",
                            "target_lang_translations": {
                                "it": "Ogni <w>camminatore</w> si godeva l'aria fresca durante il tragitto."
                            }
                        }
                    ],
                    "synonyms": [
                        "voetganger"
                    ],
                    "common_phrases": [
                        "rustige wandelaar"
                    ],
                    "target_lang_definitions": {
                        "it": "Persona che si sposta a piedi."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "pedone",
                                "target_lang_sense_clarification": "Termine generico per chi cammina nel traffico o in città."
                            },
                            {
                                "target_lang_word": "camminatore",
                                "target_lang_sense_clarification": "Chiunque si muova camminando."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "da454e33-ec34-36e0-bf18-9575fab743de",
                    "sense_definition": "Iemand die voor zijn plezier of als sport lange afstanden te voet aflegt in de natuur.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "persoon_die_loopt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>wandelaar</w> heeft goede schoenen nodig voor de bergen.",
                            "target_lang_translations": {
                                "it": "L'<w>escursionista</w> ha bisogno di buone scarpe per la montagna."
                            }
                        },
                        {
                            "text": "Veel <w>wandelaars</w> trekken elk weekend de natuur in.",
                            "target_lang_translations": {
                                "it": "Molti <w>escursionisti</w> si immergono nella natura ogni fine settimana."
                            }
                        }
                    ],
                    "synonyms": [
                        "hiker"
                    ],
                    "common_phrases": [
                        "ervaren wandelaar",
                        "sportieve wandelaar"
                    ],
                    "target_lang_definitions": {
                        "it": "Persona che percorre lunghe distanze a piedi nella natura per piacere o sport."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "escursionista",
                                "target_lang_sense_clarification": "Chi pratica escursionismo in montagna o in natura."
                            },
                            {
                                "target_lang_word": "trekker",
                                "target_lang_sense_clarification": "Chi pratica trekking su percorsi lunghi o impegnativi."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2124b263-46cb-35bd-a805-372d03c058f6",
                    "sense_definition": "Iemand die buitenshuis een stuk loopt.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "persoon_die_loopt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vanwege het mooie weer waren er op de dijk een heel aantal <w>wandelaars</w>.",
                            "target_lang_translations": {
                                "it": "Grazie al bel tempo, c'erano molti <w>passeggiatori</w> sull'argine."
                            }
                        },
                        {
                            "text": "De <w>wandelaar</w> kreeg onderweg hulp van een vriendelijke bewoner.",
                            "target_lang_translations": {
                                "it": "Il <w>camminatore</w> ha ricevuto aiuto lungo la strada da un abitante gentile."
                            }
                        }
                    ],
                    "common_phrases": [
                        "aantal wandelaars"
                    ],
                    "target_lang_definitions": {
                        "it": "Persona che cammina all'aperto."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "camminatore",
                                "target_lang_sense_clarification": "Persona che sta facendo una passeggiata all'aperto."
                            },
                            {
                                "target_lang_word": "passeggiatore",
                                "target_lang_sense_clarification": "Chi cammina per svago o relax all'aperto."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}