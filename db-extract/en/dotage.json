                                    {
                                        "sense_id": "068a6215-ad8a-3199-bc1d-e7bee19a9158",
                                        "entry_id": "316ab827-f9c4-3cd2-9db0-f957e4159641",
                                        "glosses": [
                                            "Affaiblissement du corps et de l’esprit produit par la vieillesse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b53a45f-443d-4f2c-9b5c-c3e01b62c8d4",
                                                "sense_id": "068a6215-ad8a-3199-bc1d-e7bee19a9158",
                                                "text": "La vie du crapaud comporte-t-elle une phase de sénilité ? En tout cas, sa longévité est grande […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e6019075-ad11-4adf-867f-b49bb753a334",
                        "source_entry_id": "bbbd11ab-f7ed-37dc-bf17-b783d427a21b",
                        "source_sense_description": "senility",
                        "target_lang_word": "Senilität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Senilität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e32e6c85-6f33-3b33-afad-40de7b944223",
                                        "entry_id": "8d31871a-7fad-3a2b-b341-db1cba592007",
                                        "glosses": [
                                            "Eigenschaft, die in deutlichem Maße altersbedingtes Nachlassen, besonders in geistiger Hinsicht, (seniles Verhalten) zeigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d241cf33-426b-4b46-a64b-6c82948a3456",
                                                "sense_id": "e32e6c85-6f33-3b33-afad-40de7b944223",
                                                "text": "„Eine der Fragen, die man im Leben nie geklärt haben will, ist, wie sich der Beginn von Senilität anfühlt: Merkt man es, wenn sie anfängt? Und wenn: Merkt man es zuerst oder bemerken es die anderen vorher?“"
                                            },
                                            {
                                                "example_id": "804076bf-52f0-495c-a4d3-d6f5d4b75d48",
                                                "sense_id": "e32e6c85-6f33-3b33-afad-40de7b944223",
                                                "text": "„Für alle – die älteren, die mittelalten und die jungen – Versuchspersonen schien es eine Klischeevorstellung von alten Menschen zu geben, die einen ziemlich genau umrissenen Begriff von Senilität einschloss.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "82f19725-022f-4a2e-b80f-c39005a6dc52",
                        "source_entry_id": "bbbd11ab-f7ed-37dc-bf17-b783d427a21b",
                        "source_sense_description": "senility",
                        "target_lang_word": "Altersschwäche",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Altersschwäche",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e92ca96b-c738-3c08-ac76-d3a02dfcd850",
                                        "entry_id": "7180b68a-713e-3671-aed0-c770a1364e4b",
                                        "glosses": [
                                            "körperlicher und/oder geistiger Mangel, der sich mit zunehmendem Alter einstellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96aca1b6-bd98-489e-b86b-3ab92153a5ad",
                                                "sense_id": "e92ca96b-c738-3c08-ac76-d3a02dfcd850",
                                                "text": "Nachlassende geistige Fitness ist eine von vielen Formen der Altersschwäche."
                                            },
                                            {
                                                "example_id": "6fab4cb4-3ae3-4a64-b38d-2577afc74981",
                                                "sense_id": "e92ca96b-c738-3c08-ac76-d3a02dfcd850",
                                                "text": "„Als er sich wieder erheben wollte, brachte er es angesichts seines Leibesumfanges und seiner Altersschwäche lange Zeit nicht zustande.“"
                                            },
                                            {
                                                "example_id": "931c8060-9da7-4b59-b63d-b733a819c5ab",
                                                "sense_id": "e92ca96b-c738-3c08-ac76-d3a02dfcd850",
                                                "text": "„Es ist gerichtsbekannt, daß der Pflichtverteidiger des Angeklagten unter Altersschwäche leidet und einen Sprachfehler hat, so daß er kaum zu verstehen ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
