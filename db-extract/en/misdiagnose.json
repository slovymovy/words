                        "glosses": [
                            "To incorrectly diagnose."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "f4b9cb17-d0d0-4c8d-aed1-9682202e9267",
                                "sense_id": "54eef8ea-8a16-307d-a8cf-ed264ca6a20f",
                                "text": "Ulcerated BCC may mimic SCC, and Bowen's disease may be misdiagnosed for the superficial and morphoeic forms."
                            },
                            {
                                "example_id": "d6ecf8b6-44ac-4cbc-ab52-67724b182c3e",
                                "sense_id": "54eef8ea-8a16-307d-a8cf-ed264ca6a20f",
                                "text": "What would it cost you and the patient if you were to misdiagnose or miss something as a result of not giving the documentation process the attention it requires? What could happen if you misdocument a patient chart?"
                            },
                            {
                                "example_id": "b88b9a5e-df08-4384-955d-04ffaf9972ba",
                                "sense_id": "54eef8ea-8a16-307d-a8cf-ed264ca6a20f",
                                "text": "Big technology companies are still misdiagnosing why they have so many enemies."
                            },
                            {
                                "example_id": "dcf8f1b1-ebae-4c03-a630-4792d7c82211",
                                "sense_id": "54eef8ea-8a16-307d-a8cf-ed264ca6a20f",
                                "text": "I was alone when I read Ward’s piece, horizontal in bed after a long day, and it occurred to me that he might be misdiagnosing some of the reasons people appear to be spending more time alone, possibly underestimating the strength of virtual connections."
                            }
                        ]
                    }
