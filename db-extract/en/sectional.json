                                "example_id": "201564ce-2b85-48d2-8360-359c0a516503",
                                "sense_id": "474a145e-073a-3e4c-b472-7432fda4daee",
                                "text": "Our new sectional couch divided into pieces, but the pieces still wouldn't fit through the door."
                            }
                        ]
                    },
                    {
                        "sense_id": "69cf59da-6546-3748-aacd-2ccd744854e1",
                        "entry_id": "03441f80-d2c9-3c44-871e-4ea0d9ef56fe",
