                        "glosses": [
                            "Ordnung, die nach Abschluss des Krieges hergestellt werden soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55fabdab-aef7-4485-a281-7be518de7d65",
                                "sense_id": "ae97cf2c-c662-36c9-b4a3-546116488909",
                                "text": "„Noch spielten Fragen der Kriegführung eine große Rolle, doch mehr und mehr schoben sich Themen in den Vordergrund, die mit der Nachkriegsordnung zu tun hatten.“"
                            },
                            {
                                "example_id": "36f83230-1a3b-4fb2-99dc-1b3d448c2b8e",
                                "sense_id": "ae97cf2c-c662-36c9-b4a3-546116488909",
                                "text": "„Aber die Rückabwicklung der Nachkriegsordnung und die Wiederkehr der überwunden geglaubten Machtpolitik könnte alte nationale Erfahrungen in neuem Licht erscheinen lassen.“"
                            }
                        ],
