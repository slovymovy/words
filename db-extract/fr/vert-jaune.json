                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grüngelb",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1ad52c7f-6354-3301-842e-b5e52605d997",
                                        "entry_id": "4e62d131-67af-3ea2-b694-9ad9de3e1353",
                                        "glosses": [
                                            "einen gelben Farbton mit grünlichem Einschlag habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ccf7153-1d70-4800-a235-c7f3fcfaa75d",
                                                "sense_id": "1ad52c7f-6354-3301-842e-b5e52605d997",
                                                "text": "„Die Schale ist erst grüngelb und färbt sich dann zitronengelb.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d1972bd1-812f-3d8d-bbb7-14ab930e73b4",
                                        "entry_id": "4e62d131-67af-3ea2-b694-9ad9de3e1353",
                                        "glosses": [
                                            "nebeneinanderliegende grüne und gelbe Bereiche habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63fd9912-14c1-4a70-ba82-6f5c760b06f0",
                                                "sense_id": "d1972bd1-812f-3d8d-bbb7-14ab930e73b4",
                                                "text": "Heute hat er wieder seine grüngelb gestreifte Hose an."
                                            },
                                            {
                                                "example_id": "bf93bf8b-c4da-43ee-a648-39aeadb43be4",
                                                "sense_id": "d1972bd1-812f-3d8d-bbb7-14ab930e73b4",
                                                "text": "„Und Onkel Finger sah nicht grau und zerknittert aus, auch nicht grüngelb kariert und komisch, sondern beinahe würdevoll - trug er doch das prachtvolle Lobensteiner Oberhofmarschallsgewand.“"
                                            },
                                            {
                                                "example_id": "f516e50f-2ccd-4ef5-82ea-0772ee0d3ee7",
                                                "sense_id": "d1972bd1-812f-3d8d-bbb7-14ab930e73b4",
                                                "text": "„Der Teppich ist grüngelb gestreift, das Schweigen ist angespannt.“"
                                            },
                                            {
                                                "example_id": "b19548e4-c313-4169-a7eb-1a2812993e77",
                                                "sense_id": "d1972bd1-812f-3d8d-bbb7-14ab930e73b4",
                                                "text": "„Der Schutzleiter muß mit besonderer Sorgfalt verlegt werden und in seinem gesamten Verlauf grüngelb markiert sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
