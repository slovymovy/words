                    },
                    {
                        "sense_id": "e12f7ea6-3ce5-39c0-a07e-210e6cdb9a4b",
                        "entry_id": "a5eebba5-d648-3133-b7cf-baae487f4697",
                        "glosses": [
                            "Relatif aux variétés de la langue anglaise qui ont des voyelles rhotiques, comme l’anglais américain."
                        ],
                        "tags": [
                            "broadly"
                        ],
