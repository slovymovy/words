                ],
                "senses": [
                    {
                        "sense_id": "6bb357a3-bc47-31fd-9eff-8814287117d3",
                        "entry_id": "ec7e280d-de8e-32f5-bea5-e687786bc4a4",
                        "glosses": [
                            "Elektrisches System zur Erzeugung von elektrostatischen Ladungen zur Anhaftung, Fixierung"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "fef8274e-b19a-4aad-8cc0-68d302be3efa",
                                "sense_id": "6bb357a3-bc47-31fd-9eff-8814287117d3",
                                "text": "„Aufladesysteme ermöglichen eine elektrostatische Fixierung, d. h. ein \"Verkleben\" eines Objekts mittels elektrostatischer Ladung."
                            },
                            {
                                "example_id": "316b6b9f-a7e8-4df9-a90e-28bdd30a8a55",
                                "sense_id": "6bb357a3-bc47-31fd-9eff-8814287117d3",
                                "text": "„No Static Systems von Liros ist eine komplette Produktpalette von Antistatik-Geräten und Aufladungssystemen, die flexible Lösungen bei der Beseitigung von Problemen mit statischer Elektrizität bietet: Material kann schnell und effektiv auf Reichweiten bis zu 1000 mm ionisiert werden. Die Aufladungssysteme ermöglichen sauberes Anheften und Positionieren von Details im Produktionsverlauf.“"
                            },
                            {
                                "example_id": "d5b4402f-9f1d-4470-b9fc-229b7650be5f",
                                "sense_id": "6bb357a3-bc47-31fd-9eff-8814287117d3",
                                "text": "„Aufladesysteme dienen zum berührungslosen Aufbringen elektrostatischer Ladungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5879e2c5-d7ef-3f33-8085-76431a066f6f",
                        "entry_id": "ec7e280d-de8e-32f5-bea5-e687786bc4a4",
                        "glosses": [
                            "Maschinenbauliche Verbesserung eines Motors, Turboladers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "465bdeb1-6bfa-4c4d-981d-8ed61b2d069c",
                                "sense_id": "5879e2c5-d7ef-3f33-8085-76431a066f6f",
                                "text": "„Gemäß einem Ausführungsbeispiel der Erfindung ist ein Aufladesystem für einen Verbrennungsmotor angegeben, welches neben einem ersten Turbolader einen Rezirkulationspfad mit einem Gerät (29) zur Druckerhöhung aufweist.“"
                            },
                            {
                                "example_id": "f1f60628-7261-46c7-a716-2248845a3fc7",
                                "sense_id": "5879e2c5-d7ef-3f33-8085-76431a066f6f",
                                "text": "„Die grundsätzlichen Entwicklungsziele zukünftiger Verbrennungsmotoren für Pkw- und Nfz-Anwendungen machen weiterentwickelte Aufladesysteme notwendig. “"
                            },
                            {
                                "example_id": "5b76bcaa-6426-47bb-b40b-fed93306b1b7",
                                "sense_id": "5879e2c5-d7ef-3f33-8085-76431a066f6f",
                                "text": "„Seine Premiere feierte der Motor im A3 Sportback, der als erstes die Ottomotoren-Direkteinspritzung mit einem Aufladesystem aus dem Hause BorgWarner kombinierte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "dedf7e3d-9e71-3eb2-afd4-a63dfcbdf360",
                        "entry_id": "ec7e280d-de8e-32f5-bea5-e687786bc4a4",
                        "glosses": [
                            "Elektrisches System zur Aufladung von Elektrofahrzeugen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "868006c7-e5c4-4921-a002-8aaa126b9b42",
                                "sense_id": "dedf7e3d-9e71-3eb2-afd4-a63dfcbdf360",
                                "text": "„Zusammen mit Parkeon, einem Experten für städtische Mobilität, entwickelt das Unternehmen ein Aufladesystem für Elektrofahrzeuge mit integrierter Zahlungsfunktion für Parkplätze.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
