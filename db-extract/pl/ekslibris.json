                    {
                        "translation_id": "7cc99dee-776f-48e8-ae9f-8a9649b39b40",
                        "source_entry_id": "fc23598e-e178-3f20-ab5c-c379648b47ae",
                        "source_sense_id": "631513ef-3500-3957-a573-e00e1fa010be",
                        "target_lang_word": "bookplate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bookplate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3c44ba1f-a015-3bbe-901b-eed548ac1cd3",
                                        "entry_id": "4e6f85fe-b830-357e-8958-0241d238d91b",
                                        "glosses": [
                                            "A printed piece of paper pasted on one of the pages of a book, most often on the inside front cover, showing ownership and thus deterring theft."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a89c6bd-d70d-44f1-8b2f-a80264cf31ac",
                                                "sense_id": "3c44ba1f-a015-3bbe-901b-eed548ac1cd3",
                                                "text": "By the bed there was a bookcase with old French novels, left-behind Frederick Forsyths, odd leather-bound volumes of history and memoirs with the coroneted Kessler bookplate."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bookplate",
                                "target_lang_code": "en",
                                "target_senses": [
