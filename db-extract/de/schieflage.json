                "senses": [
                    {
                        "sense_id": "14678d67-38e3-3484-852d-ae09821487c7",
                        "entry_id": "526c73ca-847d-36b9-bca1-2e3b88add65a",
                        "glosses": [
                            "unerwünschte Position im Raum, die wegen mangelnder Balance von der Norm abweicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef554f4f-b968-40c1-8332-b1e34c41b471",
                                "sense_id": "14678d67-38e3-3484-852d-ae09821487c7",
                                "text": "„Im Inneren des Turmes hängt ein Pendel, das oben in der Mitte befestigt ist und durch die Schieflage unten beinahe die Seitenwand berührt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "252ce7ca-11eb-3661-94c0-a7086d307160",
                        "entry_id": "526c73ca-847d-36b9-bca1-2e3b88add65a",
                        "glosses": [
                            "Situation/Umstand, der als problematisch/schwierig/instabil gilt"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "e5919a57-38ee-4547-9f09-e504eeb8f20c",
                                "sense_id": "252ce7ca-11eb-3661-94c0-a7086d307160",
                                "text": "„Die Schieflage in der Auseinandersetzung mit Rechts- und Linksextremismus ist ein Symptom, das ebenso auf andere gesellschaftliche Bereiche zutrifft.“"
                            },
                            {
                                "example_id": "8cff661f-28a2-4664-9755-f8a556ea8c00",
                                "sense_id": "252ce7ca-11eb-3661-94c0-a7086d307160",
                                "text": "„Diese ökonomische Schieflage verstärkt bereits vorhandene kulturelle Unterschiede und deren Politisierung.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
