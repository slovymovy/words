                    }
                ],
                "translations": [
                    {
                        "translation_id": "83228543-841d-43f1-90d7-613d1232e2ba",
                        "source_entry_id": "d786a83e-ff81-3fd7-84a5-720878efa1ef",
                        "source_sense_id": "333ffca6-4921-3cf7-82d6-b5305c511591",
                        "target_lang_word": "délibérer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "délibérer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "709bd334-e999-3738-a549-8ee468d8a272",
                                        "entry_id": "12b81251-bc11-340b-aee4-0f80d13b69e5",
                                        "glosses": [
                                            "Se livrer à un examen approfondi à propos d’une question."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bbcd82be-d74c-4e8e-831e-4db14852c5a6",
                                                "sense_id": "709bd334-e999-3738-a549-8ee468d8a272",
                                                "text": "Il a longtemps délibéré sur ce qu’il devait faire."
                                            },
                                            {
                                                "example_id": "88c7c3eb-ebc8-4129-8e18-a9de518236ef",
                                                "sense_id": "709bd334-e999-3738-a549-8ee468d8a272",
                                                "text": "Je ne me déciderai pas à cela avant d’avoir mûrement délibéré."
                                            },
                                            {
                                                "example_id": "b4445bd9-e53c-414a-b770-2d1b989480ab",
                                                "sense_id": "709bd334-e999-3738-a549-8ee468d8a272",
                                                "text": "De propos délibéré, à dessein, exprès, après y avoir bien pensé."
                                            },
                                            {
                                                "example_id": "d96a5b24-8081-4936-b795-100505177fe2",
                                                "sense_id": "709bd334-e999-3738-a549-8ee468d8a272",
                                                "text": "On lui a rendu ce mauvais office de propos délibéré."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce118a73-f8d6-3be0-8032-f8db15f4eb22",
                                        "entry_id": "12b81251-bc11-340b-aee4-0f80d13b69e5",
                                        "glosses": [
                                            "Se livrer avec d’autres personnes à un examen approfondi à propos d’une question."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3383d36-ef14-492f-a217-cc7e7e01b499",
                                                "sense_id": "ce118a73-f8d6-3be0-8032-f8db15f4eb22",
                                                "text": "Le tribunal ordonna qu’il en serait délibéré dans la chambre du Conseil."
                                            },
                                            {
                                                "example_id": "8c5a6690-1be2-4197-8270-ab302adc932e",
                                                "sense_id": "ce118a73-f8d6-3be0-8032-f8db15f4eb22",
                                                "text": "Les délais accordés à l’héritier bénéficiaire pour faire inventaire et délibérer."
                                            },
                                            {
                                                "example_id": "48e96a05-b03a-46b6-819b-4c179943c88e",
                                                "sense_id": "ce118a73-f8d6-3be0-8032-f8db15f4eb22",
                                                "text": "Le roi et les privilégiés auraient voulu que les états délibérassent comme en 1614, c'est-à-dire « par ordre ». Les privilégiés auraient eu immanquablement la majorité et les états auraient été incapables d'opérer aucune réforme sérieuse."
                                            },
                                            {
                                                "example_id": "55f901ee-5688-46eb-870b-0f7784e01a9a",
                                                "sense_id": "ce118a73-f8d6-3be0-8032-f8db15f4eb22",
                                                "text": "Je vais en délibérer avec lui."
                                            },
                                            {
                                                "example_id": "f2fe4866-4f4c-4194-b12d-fb86ac2ad872",
                                                "sense_id": "ce118a73-f8d6-3be0-8032-f8db15f4eb22",
                                                "text": "Le jury, la cour a délibéré pendant trois heures."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a4e8fb4-32c7-320a-8515-f18bccba3cf7",
                                        "entry_id": "12b81251-bc11-340b-aee4-0f80d13b69e5",
                                        "glosses": [
                                            "Décider le résultat de cet examen approfondi."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9fef437a-f235-4e1f-9663-e9e322f8e942",
                                                "sense_id": "7a4e8fb4-32c7-320a-8515-f18bccba3cf7",
                                                "text": "C’est une chose bien délibérée."
                                            },
                                            {
                                                "example_id": "73c29bbf-7f77-4672-977d-0e897fbccbfc",
                                                "sense_id": "7a4e8fb4-32c7-320a-8515-f18bccba3cf7",
                                                "text": "Qu’a-t-on délibéré?"
                                            },
                                            {
                                                "example_id": "700f3b10-a34f-4075-b178-29fb6a4da478",
                                                "sense_id": "7a4e8fb4-32c7-320a-8515-f18bccba3cf7",
                                                "text": "J’ai délibéré de partir."
                                            },
                                            {
                                                "example_id": "b9d3c0f3-3898-494d-a27f-7e3893f122c6",
                                                "sense_id": "7a4e8fb4-32c7-320a-8515-f18bccba3cf7",
                                                "text": "On délibéra d’aller à l’ennemi."
                                            },
                                            {
                                                "example_id": "cadb8fd6-3522-4da0-99f9-480c27b96e61",
                                                "sense_id": "7a4e8fb4-32c7-320a-8515-f18bccba3cf7",
                                                "text": "Il a été délibéré en séance du Conseil."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8642c793-abed-4e71-91fc-03bb68106b18",
                        "source_entry_id": "d786a83e-ff81-3fd7-84a5-720878efa1ef",
                        "source_sense_id": "333ffca6-4921-3cf7-82d6-b5305c511591",
                        "target_lang_word": "conférer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conférer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "74213b86-8d8b-31a9-9d4c-5773a0d44e53",
                                        "entry_id": "f5137eee-884a-395a-abb0-33b661c3e2b4",
                                        "glosses": [
                                            "Parler ensemble, raisonner d’une affaire, d’un point de doctrine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b9a1736-2107-4684-aa9d-4cf72df1c126",
                                                "sense_id": "74213b86-8d8b-31a9-9d4c-5773a0d44e53",
                                                "text": "Pour le moment, séparons-nous ; car il ne faut pas qu’on nous voie conférer ensemble."
                                            },
                                            {
                                                "example_id": "035fd863-a190-4e63-99a8-046036e1c466",
                                                "sense_id": "74213b86-8d8b-31a9-9d4c-5773a0d44e53",
                                                "text": "Lorsqu’on prend un berger par son côté idéal, l’imagination en fait volontiers un être rêveur et contemplatif ; il s’entretient avec les planètes ; il confère avec les étoiles ; il lit dans le ciel."
                                            },
                                            {
                                                "example_id": "e894e492-2971-4272-9974-fd2c27c34fa4",
                                                "sense_id": "74213b86-8d8b-31a9-9d4c-5773a0d44e53",
                                                "text": "Elle demanda des conseils à la confrérie des « Mères chrétiennes » et conféra souvent avec ces demoiselles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d220fe45-2d69-3624-bda5-abd6809b463d",
                                        "entry_id": "f5137eee-884a-395a-abb0-33b661c3e2b4",
                                        "glosses": [
                                            "Comparer deux choses pour juger en quoi elles s’accordent et en quoi elles diffèrent."
                                        ],
                                        "tags": [],
                                        "note": "Il se dit particulièrement des lois, ordonnances, coutumes, matières de littérature, arts libéraux, etc",
                                        "examples": [
                                            {
                                                "example_id": "aa13fe07-dcd8-438b-8e64-ec100402df45",
                                                "sense_id": "d220fe45-2d69-3624-bda5-abd6809b463d",
                                                "text": "J’ai conféré la relation du diacre Georges avec les endroits de Rufin et de saint Jérôme relatifs à sainte Euphrosine. Je dois dire qu’elle ne concorde pas tout à fait."
                                            },
                                            {
                                                "example_id": "30522d26-81d0-496b-b1f2-41aa2ad4a7cd",
                                                "sense_id": "d220fe45-2d69-3624-bda5-abd6809b463d",
                                                "text": "Conférer les lois grecques avec les lois romaines."
                                            },
                                            {
                                                "example_id": "03debe3a-4236-424c-a9e6-acf2050f6aa1",
                                                "sense_id": "d220fe45-2d69-3624-bda5-abd6809b463d",
                                                "text": "Conférer un auteur avec un autre."
                                            },
                                            {
                                                "example_id": "7d87d980-9263-4a04-a628-45d362000fd9",
                                                "sense_id": "d220fe45-2d69-3624-bda5-abd6809b463d",
                                                "text": "Conférer deux manuscrits."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d84cf91-eca3-346d-9f64-e0a609cc1431",
                                        "entry_id": "f5137eee-884a-395a-abb0-33b661c3e2b4",
                                        "glosses": [
                                            "Attribuer ; accorder."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "408d003f-ad89-4c0e-87a7-aa8255f7f245",
                                                "sense_id": "1d84cf91-eca3-346d-9f64-e0a609cc1431",
                                                "text": "[…] pourtant la dominance toute locale du Genêt à balai ou de la Callune ou même de la Fougère Aigle, espèces sociales de « premier plan », confère à la lande une physionomie particulière."
                                            },
                                            {
                                                "example_id": "ac62b1c8-f0b9-4d5e-ba6b-f08800a0f66d",
                                                "sense_id": "1d84cf91-eca3-346d-9f64-e0a609cc1431",
                                                "text": "Mais c’était l’irrégularité de la couleur de ses iris, l’un bleu pâle et l’autre jaune, qui achevait de conférer à son visage une étrangeté indéfinissable."
                                            },
                                            {
                                                "example_id": "474e70a2-e218-47e0-9151-9a27d44664e0",
                                                "sense_id": "1d84cf91-eca3-346d-9f64-e0a609cc1431",
                                                "text": "Le fruit vert renferme un glucoside spécifique qui se dédouble en glucose et en élatérine. C'est ce composé néoformé qui confère à l’Ecballium son pouvoir purgatif très accusé, irritant même pour les muqueuses, […]."
                                            },
                                            {
                                                "example_id": "0d257c8f-2e7e-4076-9f58-5cf417dbfdc2",
                                                "sense_id": "1d84cf91-eca3-346d-9f64-e0a609cc1431",
                                                "text": "Sa tenue noire assortie à ses mèches ébouriffées lui conférait toujours cette allure rock’n’roll dépassée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
