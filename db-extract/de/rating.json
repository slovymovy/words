                "senses": [
                    {
                        "sense_id": "fbf2d2b9-7e02-3654-b898-489fa0bfdc3e",
                        "entry_id": "eeb51bfc-5bd8-33cc-9d00-eff5d30a691b",
                        "glosses": [
                            "Einschätzung, Bewertung eines Unternehmens durch Externe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02347e50-6ffb-4bb7-aef8-a9931446e310",
                                "sense_id": "fbf2d2b9-7e02-3654-b898-489fa0bfdc3e",
                                "text": "Die Fullpower AG hat ein Rating von A+."
                            },
                            {
                                "example_id": "50801897-d1b5-4cd8-bcde-762e09a32c05",
                                "sense_id": "fbf2d2b9-7e02-3654-b898-489fa0bfdc3e",
                                "text": "„Mit niedrigerem Rating werden künftige Kredite für die USA teurer - was die Lasten noch drückender machen könnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f3bcc9eb-74d6-4c20-aa78-4296fa8bf1f3",
                        "source_entry_id": "eeb51bfc-5bd8-33cc-9d00-eff5d30a691b",
