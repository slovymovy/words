                                    {
                                        "sense_id": "09a2c3f9-ae51-3adb-8ba3-006c19ab2449",
                                        "entry_id": "91671f15-846f-3bcd-87a5-cba75ed0ae4d",
                                        "glosses": [
                                            "Person, die den Dienstgrad eines Unteroffiziers innehat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83faa224-ba37-4b32-ba69-82d228aae493",
                                                "sense_id": "09a2c3f9-ae51-3adb-8ba3-006c19ab2449",
                                                "text": "„Ich bin Unteroffizier geworden.“"
                                            },
                                            {
                                                "example_id": "af19ee1c-8f0b-4a0c-8eac-c18ae8ac6323",
                                                "sense_id": "09a2c3f9-ae51-3adb-8ba3-006c19ab2449",
                                                "text": "„Der Unteroffizier ging weiter.“"
                                            },
                                            {
                                                "example_id": "0d5271ba-7d6f-4bf0-9747-1cf1167e25a6",
                                                "sense_id": "09a2c3f9-ae51-3adb-8ba3-006c19ab2449",
                                                "text": "„Ein Blick des Unteroffiziers Zache traf mich.“"
                                            },
                                            {
                                                "example_id": "ffae24cc-a6fc-43eb-a1dd-5ce878ce7fa5",
                                                "sense_id": "09a2c3f9-ae51-3adb-8ba3-006c19ab2449",
                                                "text": "„Es heißt, der Unteroffizier Stephan sei im Schützengraben von einem Schuss der feindlichen Artillerie getroffen worden.“"
                                            },
                                            {
                                                "example_id": "2f5c7e3f-425c-45b8-b9c4-fce771a1c9b8",
                                                "sense_id": "09a2c3f9-ae51-3adb-8ba3-006c19ab2449",
                                                "text": "„Einer der Offiziere und zwei der Unteroffiziere sprachen ein wenig Englisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e24adbb5-343e-408d-9d86-b4a1cae217a3",
