                        "target_lang_word": "Rasse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rasse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e9f52935-c0b6-336d-a44c-85e862f37fd6",
                                        "entry_id": "a87cbe6a-3c34-3c92-ac13-26675bd3f89c",
                                        "glosses": [
                                            "Untergruppe einer durch Zucht manipulierten Art mit willkürlich festgelegten gemeinsamen phänotypischen Merkmalen"
                                        ],
                                        "tags": [
                                            "Tierzucht"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "148cbb89-b46b-477e-9cf6-841b005d4495",
                                                "sense_id": "e9f52935-c0b6-336d-a44c-85e862f37fd6",
                                                "text": "Der Deutsche Schäferhund ist die verbreitetste Rasse der Schutzhunde."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a11daec3-4427-300a-b6d7-4fa7a3b4cd1d",
                                        "entry_id": "a87cbe6a-3c34-3c92-ac13-26675bd3f89c",
                                        "glosses": [
                                            "unscharfe Bezeichnung für unterschiedliche taxonomische Gruppen bei Menschen, Tieren und Pflanzen"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c13f3ca8-701a-4d25-b81e-72ae0d0e381c",
                                                "sense_id": "a11daec3-4427-300a-b6d7-4fa7a3b4cd1d",
                                                "text": "Mit der Lehre von Rassen des Menschen rechtfertigte die Biologie die Ausbeutung, Folter und Ermordung von Menschen aus Afrika, Nord- und Südamerika, Asien, Australien, Ozeanien und der Arktis."
                                            },
                                            {
                                                "example_id": "53ab29ee-bebd-4360-9cba-91888c54b92d",
                                                "sense_id": "a11daec3-4427-300a-b6d7-4fa7a3b4cd1d",
                                                "text": "„Schließlich ist das ja das Paradoxe am Rassismus: Es gibt keine sogenannten Rassen. Sie sind eine soziale Konstruktion, deren Folgen allerdings real sind: Rassen sind konstruiert worden, um Menschen zu klassifizieren, zu hierarchisieren und zu unterdrücken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1fadec88-acb7-3bf3-8355-8718c2cdbb31",
                                        "entry_id": "a87cbe6a-3c34-3c92-ac13-26675bd3f89c",
                                        "glosses": [
                                            "positiv ausgeprägte Qualitäten eines Individuums oder einer Sache"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "444efb66-cb68-4fac-8ee4-b9e2e6e17301",
                                                "sense_id": "1fadec88-acb7-3bf3-8355-8718c2cdbb31",
                                                "text": "Dieser Wein hat wirklich Rasse."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "30f3bfa6-4778-497f-9f07-8180865fd5cb",
                        "source_entry_id": "c0403306-4163-37b8-baec-8f9d3e412327",
                        "source_sense_description": "rank in the classification of organisms",
                        "target_lang_word": "Subspezies",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Subspezies",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "665ddbd6-45ee-3f4d-802f-18e7107cdd58",
                                        "entry_id": "e2985eb9-7791-372b-aea3-a203f1201834",
                                        "glosses": [
                                            "eine meist geografisch abgegrenzte differenzierte Ausbildung einer Spezies"
                                        ],
                                        "tags": [
                                            "jargon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "134c3f96-907c-4ee5-9743-0d3c47529b95",
                                                "sense_id": "665ddbd6-45ee-3f4d-802f-18e7107cdd58",
                                                "text": "„Eine Subspezies ist die Zusammenfassung phänotypisch ähnlicher Populationen einer Art, die ein geographisches Teilgebiet des Areals der Art bewohnen und sich taxonomisch von anderen Populationen der Art unterscheiden.“"
                                            },
                                            {
                                                "example_id": "6069ca5e-cd89-42ba-8fc6-5b84c13fe73a",
                                                "sense_id": "665ddbd6-45ee-3f4d-802f-18e7107cdd58",
                                                "text": "„Die Entwicklungsgeschichte des modernen Menschen ist mit rund 160000 Jahren schlicht zu kurz, um voneinander unterscheidbare Subspezies hervorzubringen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
