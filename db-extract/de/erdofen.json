                "senses": [
                    {
                        "sense_id": "b2311020-015c-3337-8b67-41bfeed58a06",
                        "entry_id": "b269839a-11b8-31d4-bd87-f606ef244fab",
                        "glosses": [
                            "Grube, in der Esswaren über von Feuer erhitzten Steinen gegart werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a576724-4eff-4d78-a804-63092205f785",
                                "sense_id": "b2311020-015c-3337-8b67-41bfeed58a06",
                                "text": "„Funde von Überresten aus Erdöfen in der großen Sandbucht Okia Flat in der Wickliffe Bay belegen, dass hier Maori gesiedelt hatten.“"
                            },
                            {
                                "example_id": "6ae40718-ea05-413e-80d0-c5b0263eaae6",
                                "sense_id": "b2311020-015c-3337-8b67-41bfeed58a06",
                                "text": "„Simen Tjing saß im Stübchen zum Frühlingsversteck und schaute den Maurern zu, die den Erdofen mauerten, um eine Feuerungsanlage außerhalb der Mauer zu schaffen, damit, wenn man Stroh einlegte, weder Qualm noch unangenehme Dünste ins Innere dringen konnten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
