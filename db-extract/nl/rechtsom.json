                "translations": [
                    {
                        "translation_id": "edc75e81-5454-47fe-ac15-adbaf9b3dba4",
                        "source_entry_id": "dad37c24-d408-30d5-95d4-c9ef5cc1df05",
                        "source_sense_id": "0ba3d09c-884d-3e2f-bdf3-cc2890ca88a3",
                        "source_sense_description": "in een rondgaande beweging met de klok mee",
                        "target_lang_word": "rechtsdrehend",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rechtsdrehend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9099a53e-2a54-392e-a82b-2a76890ae8f6",
                                        "entry_id": "7567e22b-043a-3b7c-a7d7-e24f6b026de5",
                                        "glosses": [
                                            "im Uhrzeigersinn, in mathematisch negativer Drehrichtung, positivem Drehsinn drehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92df026c-3493-479b-b9f5-370879c3a98e",
                                                "sense_id": "9099a53e-2a54-392e-a82b-2a76890ae8f6",
                                                "text": "Es gibt rechtsdrehende Ventilatoren bei denen das Laufrad rückwärtsgekrümmt ist."
                                            },
                                            {
                                                "example_id": "40cd5d8e-ed20-4ed2-92d4-7a74cbe3dd5e",
                                                "sense_id": "9099a53e-2a54-392e-a82b-2a76890ae8f6",
                                                "text": "„Das Thema lässt sich auch noch auf Motoren ausweiten, die zwar rechtsdrehend konstruiert sind, sich aber im Betrieb nicht immer daran halten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "35755b11-7bc1-3d14-84c8-218f5e907a23",
                                        "entry_id": "7567e22b-043a-3b7c-a7d7-e24f6b026de5",
                                        "glosses": [
                                            "die Ebene des polarisierten Lichts in optisch aktiven Substanzen nach rechts drehend"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f38e4d2f-8272-4ef1-9722-301bc96d2a8d",
                                                "sense_id": "35755b11-7bc1-3d14-84c8-218f5e907a23",
                                                "text": "Wird sie in wässriger Lösung mit polarisiertem Licht bestrahlt (Licht, dessen Wellen nur in einer einzigen Ebene schwingen), dreht die rechtsdrehende Milchsäure das Licht im Uhrzeigersinn. Dies wird mit \"+\" bezeichnet."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d21aeb31-883d-3ebf-9902-2a592888c714",
                                        "entry_id": "7567e22b-043a-3b7c-a7d7-e24f6b026de5",
                                        "glosses": [
                                            "Eigenschaft eines Gewindes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6dfe48e8-de6a-456e-a89a-0c284047add7",
                                                "sense_id": "d21aeb31-883d-3ebf-9902-2a592888c714",
                                                "text": "Ein Rechtsgewinde bedeutet, das man rechtsdrehend, also im Uhrzeigersinn, die Schraube reindreht."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ac7fc71b-1e55-4c48-98ad-e7931d623ac7",
                        "source_entry_id": "dad37c24-d408-30d5-95d4-c9ef5cc1df05",
                        "source_sense_id": "0ba3d09c-884d-3e2f-bdf3-cc2890ca88a3",
                        "source_sense_description": "in een rondgaande beweging met de klok mee",
                        "target_lang_word": "clockwise",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clockwise",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eea3c4ae-1ccc-3818-b12d-6c648bd92be5",
                                        "entry_id": "5b0d02ee-43a0-3caa-8160-a8387128a08c",
                                        "glosses": [
                                            "In a curve or twist corresponding to the movement of the hands of a clock."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "671bac64-3e84-4c03-b63e-a20c9bfce38a",
                                                "sense_id": "eea3c4ae-1ccc-3818-b12d-6c648bd92be5",
                                                "text": "Turn the handle clockwise to open it."
                                            },
                                            {
                                                "example_id": "9f76374f-4f90-413b-a1d6-07bd19c1434a",
                                                "sense_id": "eea3c4ae-1ccc-3818-b12d-6c648bd92be5",
                                                "text": "The main — or cooking — kitchen is an inhumanly immaculate expanse of burner rings and countertops where, according to tradition, the stations move clockwise from canapé to entremetier."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "clockwise",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e6b2d0b0-4780-3e06-af64-e5d2e6e867ee",
                                        "entry_id": "4c7fae04-0ecb-39e2-900b-431025850236",
                                        "glosses": [
                                            "Moving clockwise; having rotary motion in the manner of a clock."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20d6dd7c-cabc-4779-962e-42483a178d52",
                                                "sense_id": "e6b2d0b0-4780-3e06-af64-e5d2e6e867ee",
                                                "text": "In the southern hemisphere the flow of air around a low-pressure system is clockwise."
                                            },
                                            {
                                                "example_id": "b0ccfaa1-29b0-40b0-8749-7e7d161b17e8",
                                                "sense_id": "e6b2d0b0-4780-3e06-af64-e5d2e6e867ee",
                                                "text": "The clockwise beating of cilia results in a net flow of extraembryonic fluid leftwards […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e578fc0a-9721-4c4c-b672-7e7804974f96",
                        "source_entry_id": "dad37c24-d408-30d5-95d4-c9ef5cc1df05",
                        "source_sense_id": "0ba3d09c-884d-3e2f-bdf3-cc2890ca88a3",
