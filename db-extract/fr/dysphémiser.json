                ],
                "senses": [
                    {
                        "sense_id": "7ecdf560-940f-3a14-b0a5-7e9497551d17",
                        "entry_id": "fabe8cd6-c485-3210-bbd1-f91e5bc23060",
                        "glosses": [
                            "Utiliser un dysphémisme au lieu d’un terme standard, pour accentuer un jugement négatif ou pour montrer la transgression de certaines convenances."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "3e34b0e7-4474-44d3-8cce-de3b48f3b486",
                                "sense_id": "7ecdf560-940f-3a14-b0a5-7e9497551d17",
                                "text": "La question de la démarche première du locuteur, qui est plutôt d’euphémiser pour limiter la transgression, ou de dysphémiser pour relâcher la censure, peut rester équivoque dans certains contextes."
                            },
                            {
                                "example_id": "94338962-66ef-4adb-a61e-321d092a275d",
                                "sense_id": "7ecdf560-940f-3a14-b0a5-7e9497551d17",
                                "text": "Par le biais d’un large corpus en langue anglaise et dans une perspective aussi bien diachronique que synchronique, Denis Jamet observe que la catégorie des anthroponymes est la plus représentée lorsque l’on souhaite euphémiser ou dysphémiser en anglais."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b796121e-8f02-4629-bb3c-9710552f194e",
                        "source_entry_id": "fabe8cd6-c485-3210-bbd1-f91e5bc23060",
                        "source_sense_id": "7ecdf560-940f-3a14-b0a5-7e9497551d17",
                        "target_lang_word": "dysphemize",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dysphemize",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ee478f78-0a40-322e-8549-1866e9dd715a",
                                        "entry_id": "6db482d7-99e5-3b91-bde6-4eb8cfd060ce",
                                        "glosses": [
                                            "To describe in dysphemisms."
                                        ],
                                        "tags": [
                                            "rare",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9b0910c-f0fa-4c4d-8912-3c9906dc3cc2",
                                                "sense_id": "ee478f78-0a40-322e-8549-1866e9dd715a",
                                                "text": "As applied to the Internet, Portland calls it \"open access,\" while AT&T dysphemizes it as \"forced access.\""
                                            },
                                            {
                                                "example_id": "9cf7ede5-b43d-4f21-8643-9471960eb47b",
                                                "sense_id": "ee478f78-0a40-322e-8549-1866e9dd715a",
                                                "text": "Or will the Democratic convention treat the breathlessly watching nation to a credentials fight — dysphemized as a train wreck?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
