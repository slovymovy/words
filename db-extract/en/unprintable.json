                "senses": [
                    {
                        "sense_id": "e336d088-b41c-3887-882d-c003982a3c83",
                        "entry_id": "3f1e86e6-10ba-3b9d-ba9c-d7244e71da0b",
                        "glosses": [
                            "Not printable; obscene, or unable to be displayed textually."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "b6e35f1f-2cf1-426b-9561-95ba73c132c5",
                                "sense_id": "e336d088-b41c-3887-882d-c003982a3c83",
                                "text": "\"There was poor old Wadley, of the Zoological Institute. Wadley sent a message: 'The President of the Zoological Institute presents his compliments to Professor Challenger, and would take it as a personal favor if he would do them the honor to come to their next meeting.' The answer was unprintable.\" \"You don't say?\" \"Well, a bowdlerized version of it would run: 'Professor Challenger presents his compliments to the President of the Zoological Institute, and would take it as a personal favor if he would go to the devil.'\""
                            },
                            {
                                "example_id": "07a1a696-409b-4994-ab82-7f8417862f19",
                                "sense_id": "e336d088-b41c-3887-882d-c003982a3c83",
                                "text": "Once a neighbor complained that a Gilbreth had called the neighbor's boy a son of an unprintable word."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fe53c385-d992-4e42-b515-7f67eb212603",
                        "source_entry_id": "3f1e86e6-10ba-3b9d-ba9c-d7244e71da0b",
                        "source_sense_id": "e336d088-b41c-3887-882d-c003982a3c83",
                        "source_sense_description": "not printable",
                        "target_lang_word": "inimprimable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inimprimable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "93b5cf32-c8c3-3acb-8f5f-bf15b93b74b4",
                                        "entry_id": "2b27c9e8-80a7-345d-95ed-0196ccc08e2e",
                                        "glosses": [
                                            "Qui ne peut ou ne doit pas être imprimé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67687435-df88-4001-b90a-501745309c86",
                                                "sense_id": "93b5cf32-c8c3-3acb-8f5f-bf15b93b74b4",
                                                "text": "… enfin d’avoir icy cette autre grande quantité generale que l’auteur avoit jugée inimprimable, …"
                                            },
                                            {
                                                "example_id": "0672d86a-d350-4c95-9b79-e4164f6251f3",
                                                "sense_id": "93b5cf32-c8c3-3acb-8f5f-bf15b93b74b4",
                                                "text": "Heuzy m’a envoyé deux articles dont un interminable et je crois inimprimable, dont l’autre bon, mais inactuel."
                                            },
                                            {
                                                "example_id": "9d064aa2-275b-4936-8594-feedb77bceba",
                                                "sense_id": "93b5cf32-c8c3-3acb-8f5f-bf15b93b74b4",
                                                "text": "Une photo qui sort de chez le photographe est inimprimable telle quelle, il faut, pour la rendre apte à l’impression, recourir à des artifices."
                                            }
                                        ]
                                    }
                                ]
                            }
