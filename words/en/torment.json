{
    "word_family": [
        "tormentor",
        "tormenting",
        "tormentingly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9beb2ae5-b7f7-3035-8d18-f55050f61c6b",
                    "sense_definition": "To cause severe physical or mental suffering to someone or something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cause_suffering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cruel children would <w>torment</w> the flies by pulling their wings off.",
                            "target_lang_translations": {
                                "ru": "Жестокие дети <w>мучили</w> мух, отрывая им крылья."
                            }
                        },
                        {
                            "text": "The memory of his failure continued to <w>torment</w> him for many years.",
                            "target_lang_translations": {
                                "ru": "Воспоминание о неудаче продолжало <w>терзать</w> его долгие годы."
                            }
                        }
                    ],
                    "synonyms": [
                        "afflict",
                        "torture",
                        "agonize",
                        "rack",
                        "plague",
                        "harass"
                    ],
                    "antonyms": [
                        "comfort",
                        "soothe",
                        "relieve"
                    ],
                    "common_phrases": [
                        "torment the soul",
                        "torment with questions"
                    ],
                    "target_lang_definitions": {
                        "ru": "Причинять кому-либо сильные физические или душевные страдания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мучить",
                                "target_lang_sense_clarification": "подвергать страданиям"
                            },
                            {
                                "target_lang_word": "истязать",
                                "target_lang_sense_clarification": "жестоко мучить"
                            },
                            {
                                "target_lang_word": "терзать",
                                "target_lang_sense_clarification": "причинять сильную душевную боль"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f5b9609b-a434-3bfe-9810-f9cb881200f8",
                    "sense_definition": "Extreme physical or mental pain, anguish, or misery.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "state_of_suffering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He lived in constant mental <w>torment</w> after the tragic accident.",
                            "target_lang_translations": {
                                "ru": "После трагического случая он жил в постоянном душевном <w>мучении</w>."
                            }
                        },
                        {
                            "text": "The patient suffered through the <w>torment</w> of chronic back pain every day.",
                            "target_lang_translations": {
                                "ru": "Пациент каждый день терпел <w>муки</w> от хронической боли в спине."
                            }
                        }
                    ],
                    "synonyms": [
                        "misery",
                        "pain",
                        "anguish",
                        "distress",
                        "torture"
                    ],
                    "antonyms": [
                        "bliss",
                        "ecstasy",
                        "pleasure"
                    ],
                    "common_phrases": [
                        "mental torment",
                        "years of torment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крайняя физическая или душевная боль, страдание или несчастье."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мучение",
                                "target_lang_sense_clarification": "сильная боль или страдание"
                            },
                            {
                                "target_lang_word": "мука",
                                "target_lang_sense_clarification": "нравственное или физическое страдание"
                            },
                            {
                                "target_lang_word": "терзание",
                                "target_lang_sense_clarification": "сильное душевное беспокойство"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aa3a80d8-74f2-316e-8c92-3b1c750a61cb",
                    "sense_definition": "The act of inflicting torture, especially using a specific instrument.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "state_of_suffering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prisoner was subjected to various forms of <w>torment</w> to extract information.",
                            "target_lang_translations": {
                                "ru": "Заключенного подвергали различным видам <w>истязаний</w>, чтобы выведать информацию."
                            }
                        },
                        {
                            "text": "Historical museums often display devices used for the <w>torment</w> of criminals.",
                            "target_lang_translations": {
                                "ru": "В исторических музеях часто выставляют приспособления, использовавшиеся для <w>пыток</w> преступников."
                            }
                        }
                    ],
                    "synonyms": [
                        "torture",
                        "excruciation"
                    ],
                    "common_phrases": [
                        "instruments of torment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт причинения пыток, особенно с использованием специальных инструментов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "истязание",
                                "target_lang_sense_clarification": "жестокая пытка"
                            },
                            {
                                "target_lang_word": "пытка",
                                "target_lang_sense_clarification": "физическое насилие для допроса или наказания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bee28f83-77cf-3353-a484-6f9f4f064175",
                    "sense_definition": "An ancient war engine, such as a catapult, used for throwing stones or darts.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "war_engine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The Roman army utilized the <w>torment</w> to breach the city walls during the siege.",
                            "target_lang_translations": {
                                "ru": "Римская армия использовала <w>тормент</w>, чтобы пробить городские стены во время осады."
                            }
                        },
                        {
                            "text": "The heavy <w>torment</w> was capable of launching massive projectiles over great distances.",
                            "target_lang_translations": {
                                "ru": "Тяжелый <w>тормент</w> был способен метать массивные снаряды на большие расстояния."
                            }
                        }
                    ],
                    "synonyms": [
                        "catapult",
                        "ballista"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Refers to ancient military technology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Древнее осадное орудие, такое как катапульта, используемое для метания камней или стрел."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тормент",
                                "target_lang_sense_clarification": "древнее метательное орудие"
                            },
                            {
                                "target_lang_word": "катапульта",
                                "target_lang_sense_clarification": "машина для метания снарядов"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}