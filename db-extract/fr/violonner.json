                "senses": [
                    {
                        "sense_id": "c5991b46-0436-3f8b-8a82-b213ff839929",
                        "entry_id": "fa39917e-b9e0-3d8a-a048-4a0e28897817",
                        "glosses": [
                            "Jouer sur un violon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da361977-41e9-4098-8874-c1957dd110e8",
                                "sense_id": "c5991b46-0436-3f8b-8a82-b213ff839929",
                                "text": "On se reskypera un jour pour violonner encore, promis."
                            },
                            {
                                "example_id": "8a79da6c-993d-4f34-a2a4-7264dabaca04",
                                "sense_id": "c5991b46-0436-3f8b-8a82-b213ff839929",
                                "text": "Violonner ainsi sur de grosses batteries des mélodies à hurler, dignes d'un téléfilm à l'eau de rose ?"
                            },
                            {
                                "example_id": "2f3ba5c6-6588-4eca-86a4-964fd278dc52",
                                "sense_id": "c5991b46-0436-3f8b-8a82-b213ff839929",
                                "text": "Michel Leblond fait violonner les vieux murs de la maison hantée aussi sûrement qu'il déboisonne la légende du quêteux."
                            }
                        ]
                    }
