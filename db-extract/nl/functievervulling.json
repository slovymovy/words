                        "examples": [
                            {
                                "example_id": "f03be303-600d-48e4-9f8b-5d8918564682",
                                "sense_id": "18f89988-e099-3433-a094-ff3a0ec4dead",
                                "text": "\"Het afgelopen jaar is het accent van de functievervulling dusdanig verschoven dat zijn persoonlijke verwachtingen over de functie van directeur-generaal Belastingdienst en deze functievervulling onvoldoende op elkaar aansloten\", staat in een persbericht van de Rijksoverheid."
                            },
                            {
                                "example_id": "3e6d3fc3-0bef-41f6-b14a-a92b93422d20",
                                "sense_id": "18f89988-e099-3433-a094-ff3a0ec4dead",
                                "text": "De duur van de uitkering is gelijk aan de duur van het ministerschap of het staatssecretariaat. Ze duurt echter minimaal 2 jaar en maximaal 3 jaar en 2 maanden. Bij een functievervulling van minder dan 3 maanden krijgt een bewindspersoon overigens maar 6 maanden een uitkering."
                            }
                        ]
                    }
