                        "glosses": [
                            "A person who makes an ostentatious display of wealth or style."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "c19dcce3-bc72-4de0-88f8-9b25032df429",
                                "sense_id": "748e905f-c414-3cde-a97b-9e0e08f0c2a5",
                                "text": "High-tech “blingers” have talking bibles on CD-ROM. I call it “point and click” bling. Some folks I know have the Black heritage Bible with the kente cloth motif all over it. I call that Afrocentric bling."
                            },
                            {
                                "example_id": "072df11a-9cd6-48f3-a5de-27e315756811",
                                "sense_id": "748e905f-c414-3cde-a97b-9e0e08f0c2a5",
                                "text": "Is the black phenomenon of bling a parodic subversion of wealth and power or the expression of an aspiration to join the unequal scramble for fame and material success, if only through magical symbolisation rather than actuality in the experience of most would-be blingers of distinction?"
                            }
                        ]
                    }
