                ],
                "senses": [
                    {
                        "sense_id": "70136d27-1104-3c09-97c1-9c76ac8bc0ff",
                        "entry_id": "6eddace4-40e7-36d9-b5a9-676aebd9cceb",
                        "glosses": [
                            "Vérifier, par exemple d’une autre façon, quelque chose de déjà vérifié."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1cca4b15-f738-4949-8c8c-fd907c34c2d3",
                                "sense_id": "70136d27-1104-3c09-97c1-9c76ac8bc0ff",
                                "text": "Si l’on veut comprendre l’horreur dont Baudis fut victime, il faut lire ce document qui détaille et démasque le nombre de mensonges, machinations, incompétences (gendarmes et magistrats), personnages glauques qu’une partie de la presse (écrite et télé) mettait en valeur par goût du scandale et ignorance des règles fondamentales du journalisme (il faut vérifier et contre-vérifier, et ne jamais imprimer la rumeur comme un acquis)."
                            },
                            {
                                "example_id": "b39b7ef3-0535-45fe-a7e4-7170c5ed808b",
                                "sense_id": "70136d27-1104-3c09-97c1-9c76ac8bc0ff",
                                "text": "J’ai vérifié et revérifié et contre-vérifié aussi."
                            }
                        ]
                    }
