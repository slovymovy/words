                        "sense_id": "8b7b0809-4c58-344a-adbc-a881adc43c6b",
                        "entry_id": "e0cc280a-39aa-32a6-9655-8a3cf378a1e2",
                        "glosses": [
                            "Throughout a state (political subdivision of a federal union)."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "e7261fdc-dd05-4a30-82a0-627019136df6",
                                "sense_id": "8b7b0809-4c58-344a-adbc-a881adc43c6b",
                                "text": "Sharks are an ever-present hazard in South Australia…as of 2002 there had been nearly 50 attacks statewide, including a 48-hour period in September 2000 that saw two surfer fatalities."
                            },
                            {
                                "example_id": "217a0487-8af2-42c9-9c49-a7a0a221d81e",
                                "sense_id": "8b7b0809-4c58-344a-adbc-a881adc43c6b",
                                "text": "After an unsuccessful attempt to have The Grapes of Wrath banned statewide (the effort backfired), the AF commissioned and distributed a barrage of counternarratives."
                            },
                            {
                                "example_id": "d09d453c-fa99-4263-83ec-0c9c2da2356b",
                                "sense_id": "8b7b0809-4c58-344a-adbc-a881adc43c6b",
                                "text": "The state of Jalisco hired a single pharmacy company to provide all such medicines statewide."
                            }
                        ]
                    },
                    {
                        "sense_id": "335d7af9-c812-30d5-abd8-f316850eca79",
                        "entry_id": "e0cc280a-39aa-32a6-9655-8a3cf378a1e2",
                        "glosses": [
                            "Throughout a sovereign state; nationwide."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "17f1f847-cf27-4a24-8a7b-04e3e8efefc1",
                                "sense_id": "335d7af9-c812-30d5-abd8-f316850eca79",
                                "text": "Alternatives to the core Spanish identity were pressing only in the Catalon and Basque regions and not statewide."
                            },
                            {
                                "example_id": "01b285f5-3b70-4eb1-b59f-8c0b936fc713",
                                "sense_id": "335d7af9-c812-30d5-abd8-f316850eca79",
                                "text": "In the end, the Communist Party scored a stunning victory in the 26 May 1946 election, winning more than 40 percent in the Czech provinces and taking a substantial plurality of the vote statewide."
                            },
                            {
                                "example_id": "148b0177-9497-4c83-8717-765105b8622b",
                                "sense_id": "335d7af9-c812-30d5-abd8-f316850eca79",
                                "text": "The Solomons do not cohere ethnographically (there are 70 languages spoken statewide) and nor are they likely to, at least, not in the short term. This does not bode well for the capacity of any Solomons government to win national legitimacy."
                            }
                        ]
                    }
