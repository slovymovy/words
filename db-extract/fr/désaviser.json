                        "glosses": [
                            "Aviser de ne pas faire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0d6346c-a411-4c1d-8128-a5564a2259c6",
                                "sense_id": "d1958fef-ae7f-3cc0-b36c-dab728f6b2e3",
                                "text": "Il me dit qu’il avait demandé conseil auprès de Geordes De Leval et que celui-ci l’en avait désavisé."
                            },
                            {
                                "example_id": "5b8bb1e0-45ba-4ca2-bca6-4dcfb1e660bb",
                                "sense_id": "d1958fef-ae7f-3cc0-b36c-dab728f6b2e3",
                                "text": "Ô que je fus désavisé quand, à l’appétit d’une vaine peinture, je laissai la poursuite de la gloire que j’avois acquise à la joute !"
                            }
                        ]
                    }
