                "senses": [
                    {
                        "sense_id": "0b3c19d3-3cfc-3796-832b-39e7daf36da9",
                        "entry_id": "ecb4fd92-8698-38e6-a9d6-5e9507bf7fb3",
                        "glosses": [
                            "emotionale Abneigung, Abwendung vom Spielen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85f071fa-3b9e-4e99-be78-eaf4ae238a47",
                                "sense_id": "0b3c19d3-3cfc-3796-832b-39e7daf36da9",
                                "text": "„Ich erzählt’ euch vor’ge Nacht, dass ein Spielverdruss des Zwistes Anlass war, als dessen Zeuge Ihr zufäll’ger Weis’ erschienet.“"
                            },
                            {
                                "example_id": "cdb48cf0-aeb9-42b3-8261-cad9514a6f12",
                                "sense_id": "0b3c19d3-3cfc-3796-832b-39e7daf36da9",
                                "text": "„Eine aufdringliche Verschulung des Spiels kann allerdings zum Spielverdruss führen.“"
                            },
                            {
                                "example_id": "66a3dcbd-91a8-4af8-ae0e-7b485033e552",
                                "sense_id": "0b3c19d3-3cfc-3796-832b-39e7daf36da9",
                                "text": "„Spielen sollte keinen Spielverdruss erzeugen, sondern ganz im Gegenteil die Spiellust vermehren.“"
                            },
                            {
                                "example_id": "6cb9163c-1640-48e1-8d7e-96720fcb0e29",
                                "sense_id": "0b3c19d3-3cfc-3796-832b-39e7daf36da9",
                                "text": "„Die generelle Abschlußschwäche der WSV-Damen sorgte leider insgesamt für etwas Spielverdruss, die starke Zonenverteidigung ließ bei den Gegnerinnen von SCAL allerdings nicht viele Abschlüsse zu, so dass die WSV Damen den Vorsprung weiter ausbauen konnten und am Ende das Spiel sehr deutlich für den WSV entschieden haben.“"
                            },
                            {
                                "example_id": "4c0f10cf-3dad-4294-9d0b-b8518e7542d9",
                                "sense_id": "0b3c19d3-3cfc-3796-832b-39e7daf36da9",
                                "text": "„Im Lotto-Normalgeschäft herrscht dagegen Spielverdruss. Kein Wunder: Den staatlichen Glückmachern droht Unbill aus Brüssel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
