                        "target_lang_word": "Filzlaus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Filzlaus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "701fb604-f23a-3216-86dd-098e7f40a32d",
                                        "entry_id": "4a082ef1-8446-329d-98c1-dbedd436c0f1",
                                        "glosses": [
                                            "ein Insekt (Pthirus pubis), welches hauptsächlich in den menschlichen Schamhaaren lebt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a690b23-1045-43fe-87b4-7344e0098c1d",
                                                "sense_id": "701fb604-f23a-3216-86dd-098e7f40a32d",
                                                "text": "„In Anbetracht der Risiken stellt sich natürlich die Frage: Gibt es einen medizinischen Grund, die Haare im Intimbereich zu entfernen? Es gebe nur ganz wenige Krankheiten, die mit Körperbehaarung im Zusammenhang stehen - zum Beispiel Filzläuse oder ein Bakterienbefall.“"
                                            },
                                            {
                                                "example_id": "c4b8148e-56b5-424e-b736-30a9f1d41e64",
                                                "sense_id": "701fb604-f23a-3216-86dd-098e7f40a32d",
                                                "text": "„Filzläuse und Kleiderläuse gingen nicht auf den Kopf, das war ein altes Gesetz.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ebb2d075-017d-31c6-9a4d-8efda0067a63",
                                        "entry_id": "4a082ef1-8446-329d-98c1-dbedd436c0f1",
                                        "glosses": [
                                            "lästiger Mensch"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "edc298c2-e668-4181-8546-6b52743d6e0f",
                                                "sense_id": "ebb2d075-017d-31c6-9a4d-8efda0067a63",
                                                "text": "„‚Du Filzlaus. Du elende, stinkende, alte Filzlaus.‘ Jürgen Löffler umklammert mit beiden Händen den Hals des Alten, drückt zu.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
