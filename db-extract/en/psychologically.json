{
    "word": "psychologically",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "f37dfc10-8423-388d-af29-a529d97321f5",
                "word": "psychologically",
                "pos": "adv",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7b583c97-4f8a-3212-a115-d6ec2a379848",
                        "entry_id": "f37dfc10-8423-388d-af29-a529d97321f5",
                        "glosses": [
                            "In a psychological sense."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "625267b3-d878-47da-a0a4-a7fc23100db3",
                                "sense_id": "7b583c97-4f8a-3212-a115-d6ec2a379848",
                                "text": "The new novel is a psychologically complex thriller."
                            },
                            {
                                "example_id": "3f6b230e-f33f-4954-b018-eca993236f82",
                                "sense_id": "7b583c97-4f8a-3212-a115-d6ec2a379848",
                                "text": "In good times and bad, in sickness and health, the benefits of friendships between women are physically and psychologically undeniable."
                            }
                        ]
                    },
                    {
                        "sense_id": "1f18562f-2eac-32d4-a104-4efdd7e366e2",
                        "entry_id": "f37dfc10-8423-388d-af29-a529d97321f5",
                        "glosses": [
                            "Employing psychology."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "c2d4fa68-559b-41ad-bf88-e3e86bdf5f10",
                                "sense_id": "1f18562f-2eac-32d4-a104-4efdd7e366e2",
                                "text": "The patient's behaviour was interpreted psychologically."
                            },
                            {
                                "example_id": "a97c9215-956e-4025-aef7-5d4e76485600",
                                "sense_id": "1f18562f-2eac-32d4-a104-4efdd7e366e2",
                                "text": "The economics of rebuilding all the stations covered by the electrification would be prohibitive, but to help bring home to the Glasgow public that their North Clyde suburban service has been transformed, not merely re-equipped with new trains, stations have at least been associated psychologically with the rolling stock by a common colour scheme."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2dacd406-75d1-45f5-b1b4-0e8c797f40f6",
                        "source_entry_id": "f37dfc10-8423-388d-af29-a529d97321f5",
                        "source_sense_description": "in a psychological manner",
                        "target_lang_word": "psychologiquement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "psychologiquement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "284919ec-f895-3502-b81d-806db713662c",
                                        "entry_id": "ad8ea1b1-c153-3ff2-8457-060dd05f9934",
                                        "glosses": [
                                            "D'une manière psychologique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd2e07b8-5eb7-412a-b821-4cdaef4d48f2",
                                                "sense_id": "284919ec-f895-3502-b81d-806db713662c",
                                                "text": "L’appareil de production se présente comme une gigantesque machine à mobiliser psychologiquement et physiquement qui laisse choir les individus à risque, c’est-à-dire tous ceux qui incarnent une autre manière de vivre."
                                            },
                                            {
                                                "example_id": "14709c4d-ffe8-4afd-9a6c-c41d71425389",
                                                "sense_id": "284919ec-f895-3502-b81d-806db713662c",
                                                "text": "Comprimée sur soi, nous dit-il, l’humanité est normalement amenée à s’échauffer psychologiquement et à s’ultra-personnaliser."
                                            },
                                            {
                                                "example_id": "5c790056-8d9f-40cb-a36f-239f42fba4a1",
                                                "sense_id": "284919ec-f895-3502-b81d-806db713662c",
                                                "text": "Le « supporteurisme », terme peu usité et barbare, désigne cette attitude qui engage pleinement, autant physiquement que psychologiquement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2ee72eac-37fd-44e8-95f5-63cbca7ab06f",
                        "source_entry_id": "f37dfc10-8423-388d-af29-a529d97321f5",
                        "source_sense_description": "in a psychological manner",
                        "target_lang_word": "psychologisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "psychologisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1dfd6dcb-b65b-3fd3-8e38-9b329217e328",
                                        "entry_id": "1e1aeb47-3bf9-3a0b-8ed4-9f01fd852178",
                                        "glosses": [
                                            "die Psychologie betreffend, auf ihr beruhend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4439c763-92e3-47f3-95b3-0d82ac1b9e3d",
                                                "sense_id": "1dfd6dcb-b65b-3fd3-8e38-9b329217e328",
                                                "text": "„Klassische Initiativen zur Kundenbindung, wie etwa Bonus- und Punkteprogramme, werden heute durch psychologisch fundierte Kundenbeziehungspflege ergänzt und teilweise sogar ersetzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "963e982e-dedb-4e21-9b60-dfb63076492f",
                        "source_entry_id": "f37dfc10-8423-388d-af29-a529d97321f5",
                        "source_sense_description": "in a psychological manner",
                        "target_lang_word": "seelisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "seelisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "42094a17-0077-33f8-92d3-7fa276677f98",
                                        "entry_id": "8cab35e2-06e0-3cf3-b66f-f5fdb1125a8c",
                                        "glosses": [
                                            "die Seele, die innere Verfassung des Menschen betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad737e40-f2c4-4d0b-96b6-126489e0cb93",
                                                "sense_id": "42094a17-0077-33f8-92d3-7fa276677f98",
                                                "text": "Seine seelische Verfassung hat unter der Trennung gelitten."
                                            },
                                            {
                                                "example_id": "5cd37300-6319-4f0b-bce1-1c9eabc660df",
                                                "sense_id": "42094a17-0077-33f8-92d3-7fa276677f98",
                                                "text": "Dabei zeigt sich häufig: Nicht körperliche, sondern seelische Ursachen führen zu Schwindel."
                                            },
                                            {
                                                "example_id": "56a20ac1-f7a0-4283-80ce-d4a5262bbf2c",
                                                "sense_id": "42094a17-0077-33f8-92d3-7fa276677f98",
                                                "text": "\"Ein ausgeglichenes Wesen, keine seelischen Probleme\", hatten die psychologischen Experten befunden."
                                            },
                                            {
                                                "example_id": "c21f8ca5-08b6-47a7-ba9e-a022f09fe941",
                                                "sense_id": "42094a17-0077-33f8-92d3-7fa276677f98",
                                                "text": "Nach der AOK-Studie liegen seelische Störungen mittlerweile an vierter Stelle bei den Ursachen für eine Erkrankung Berufstätiger."
                                            },
                                            {
                                                "example_id": "aa5f3968-179f-4cd8-bee2-b586a683a888",
                                                "sense_id": "42094a17-0077-33f8-92d3-7fa276677f98",
                                                "text": "Es war etwas seelisch Schönes und seelisch Glückliches über sie gekommen, was sie nicht verstand und nicht zu deuten wußte."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
