                    },
                    {
                        "sense_id": "1a920aa3-c497-39e7-8470-9e4fc3392dd1",
                        "entry_id": "1b1faf63-3963-310f-b86e-2e448ffd1b09",
                        "glosses": [
                            "rumbling, growling (of the stomach)"
                        ],
                        "tags": [
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "4cbe4e16-16d5-4d05-9e2e-e0206d871fc9",
                                "sense_id": "1a920aa3-c497-39e7-8470-9e4fc3392dd1",
                                "text": "Ned Land, tourmenté par les tiraillements de son robuste estomac, se montait de plus en plus, et, malgré sa parole, je craignais véritablement une explosion, lorsqu’il se trouverait en présence de l’un des hommes du bord.",
                                "translation": "Tortured by the growling of his well–built stomach, Ned Land was getting more and more agitated, and despite his word, I was in real fear of an explosion when he stood in the presence of one of the men on board.",
                                "english": "Tortured by the growling of his well–built stomach, Ned Land was getting more and more agitated, and despite his word, I was in real fear of an explosion when he stood in the presence of one of the men on board."
                            },
                            {
                                "example_id": "82beb255-2bf7-4ba8-a7f0-745f34f80c34",
                                "sense_id": "1a920aa3-c497-39e7-8470-9e4fc3392dd1",
                                "text": "[…] des tiraillements d'estomac le rappelèrent à la réalité […]",
                                "translation": "[…] rumblings from his stomach recalled him to reality.",
                                "english": "[…] rumblings from his stomach recalled him to reality."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
