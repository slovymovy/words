                "senses": [
                    {
                        "sense_id": "932e3e28-bc5c-3eef-b273-82e634ed9dbe",
                        "entry_id": "749ee491-208d-3dd1-a67d-9ce86299f26f",
                        "glosses": [
                            "für die Zukunft angekündigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81240d72-420b-4781-a444-34e0a2e2b0ce",
                                "sense_id": "932e3e28-bc5c-3eef-b273-82e634ed9dbe",
                                "text": "Für die nächste Woche ist gutes Wetter prognostiziert."
                            },
                            {
                                "example_id": "b5c62bba-4880-4d9e-8000-b30b4c56d08a",
                                "sense_id": "932e3e28-bc5c-3eef-b273-82e634ed9dbe",
                                "text": "„660 Menschen versammeln sich in Frankreich auf einem Bergmassiv des Mont Blanc, um den für diesen Tag prognostizierten Weltuntergang zu überleben.“"
                            },
                            {
                                "example_id": "ceaf8eab-1d4e-4f1a-9898-e3e3357e63f4",
                                "sense_id": "932e3e28-bc5c-3eef-b273-82e634ed9dbe",
                                "text": "„Ob die oft prognostizierte Tendenz zur Dienstleistungsgesellschaft auch für Deutschland Gültigkeit hat, ist umstritten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
