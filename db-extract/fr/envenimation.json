                        "entry_id": "33444688-cb78-39f1-8b91-3617a6a0ff5f",
                        "glosses": [
                            "Inoculation d'un venin par morsure ou piqure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbd2fce9-67bd-4f5e-a7b5-b2dc0e458473",
                                "sense_id": "f6819700-4abf-3911-9e9e-53570458800e",
                                "text": "L’aspi-venin et autres pompes à venin sont d'une inefficacité technique notoire pour combattre les effets de l’envenimation."
                            }
                        ]
                    },
                    {
                        "sense_id": "092b1d8f-50fd-3933-a4ab-0d9680cfe00c",
                        "entry_id": "33444688-cb78-39f1-8b91-3617a6a0ff5f",
                        "glosses": [
                            "Effets de ce venin, après inoculation."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "a376278e-8c4e-409b-8d9f-8dee093d9f81",
                                "sense_id": "092b1d8f-50fd-3933-a4ab-0d9680cfe00c",
                                "text": "Deux types d’araignées sont distingués par les arachnologues : les mygalomorphes (ou araignées primitives),[…], et les aranéomorphes (araignées à proprement parler), où deux envenimations sont à développer, du fait de la présence en France métropolitaine, le latrodectisme et le loxoscélisme."
                            }
                        ]
                    }
