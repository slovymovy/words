                        "examples": [
                            {
                                "example_id": "1a83431c-09f0-412b-b905-61d3924f71fe",
                                "sense_id": "754cf4ce-1f97-3108-9ae7-99245aec0898",
                                "text": "Op Schiphol zijn zes Britten opgepakt vanwege een vechtpartij aan boord van een vliegtuig. Het gebeurde op een KLM-vlucht vanmorgen van Manchester naar Amsterdam. Een van de zes mannen raakte lichtgewond, meldt de Koninklijke Marechaussee."
                            },
                            {
                                "example_id": "1af5b5c4-e606-4c44-957a-00884912014e",
                                "sense_id": "754cf4ce-1f97-3108-9ae7-99245aec0898",
                                "text": "Een van de wielrenners die gewond raakte werd met de ambulance naar het ziekenhuis gebracht. Het gaat om een 72-jarige man. Hij liep een sleutelbeenbreuk en schaafwonden op. Het andere slachtoffer raakte lichtgewond, schrijft Omroep Brabant."
                            }
                        ]
