                                        "sense_id": "6c331a10-2670-3fa8-ab3b-545c677c0da0",
                                        "entry_id": "09c58295-0d41-3b86-bbd7-ff8f4302df3b",
                                        "glosses": [
                                            "A building or institution where money (originally, only coins) is produced under government licence."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e96b5c00-a981-3267-bdbc-04cb8c7d4bb2",
                                        "entry_id": "09c58295-0d41-3b86-bbd7-ff8f4302df3b",
                                        "glosses": [
                                            "A vast sum of money; (by extension) a large amount of something."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab34a659-56fa-4736-97e0-3498faf02b42",
                                                "sense_id": "e96b5c00-a981-3267-bdbc-04cb8c7d4bb2",
                                                "text": "That house is worth a mint."
                                            },
                                            {
                                                "example_id": "eb50f654-9460-4e77-a0a5-acea0ca8d131",
                                                "sense_id": "e96b5c00-a981-3267-bdbc-04cb8c7d4bb2",
                                                "text": "It must have cost a mint to produce!"
                                            },
                                            {
                                                "example_id": "7de6744e-aaa6-46a4-ae90-2e46b8477013",
                                                "sense_id": "e96b5c00-a981-3267-bdbc-04cb8c7d4bb2",
                                                "text": "to make a mint"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81f38b23-cdd2-31f3-b21c-a08d7b645032",
                                        "entry_id": "09c58295-0d41-3b86-bbd7-ff8f4302df3b",
                                        "glosses": [
                                            "Any place regarded as a source of unlimited supply; the supply itself."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01e51cc1-d66f-490c-abe1-20ba7c6aebbb",
                                                "sense_id": "81f38b23-cdd2-31f3-b21c-a08d7b645032",
                                                "text": "A mint of phrases in his brain."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mint",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8e55ea6f-eb6d-35eb-9d25-38aa2a859e7a",
                                        "entry_id": "5c6ece2f-93fa-3dc5-b32a-e93031541293",
                                        "glosses": [
                                            "To reproduce (coins), usually en masse, under licence."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b835901d-a45b-43bc-bec0-196062a6e9e5",
                                                "sense_id": "8e55ea6f-eb6d-35eb-9d25-38aa2a859e7a",
                                                "text": "For some time past the legal currency in the various Provinces has been insufficient for use. Formerly the two Provinces of Fuchien and Kuangtung minted some large, round copper coins of excellent workmanship that were said, by the people after they were put into circulation, to be convenient."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c93e35ac-05f8-3395-8a68-0928e4d865ce",
                                        "entry_id": "5c6ece2f-93fa-3dc5-b32a-e93031541293",
                                        "glosses": [
                                            "To invent; to forge; to fabricate; to fashion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81986aaa-fe86-4c5e-8dfc-78db6486168e",
                                                "sense_id": "c93e35ac-05f8-3395-8a68-0928e4d865ce",
                                                "text": "Titles […] as may appeare to be easily minted"
                                            },
                                            {
                                                "example_id": "503cd21f-c0c6-4a44-8034-fd168d3baea1",
                                                "sense_id": "c93e35ac-05f8-3395-8a68-0928e4d865ce",
                                                "text": "China’s newly minted national parks don’t just safeguard famous keystone species such as Siberian tigers, giant pandas and Hainan gibbons. They are also designed to preserve the shrinking ecosystems that support such iconic wildlife, ranging from sweltering (tropical jungles in the southern province of Hainan to the chilly maple forests of northern Heilongjiang and Jilin Provinces bordering Siberia."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61d733bf-5619-3f0a-89e7-725a0b7786fb",
                                        "entry_id": "5c6ece2f-93fa-3dc5-b32a-e93031541293",
                                        "glosses": [
                                            "To create a crypto token."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a67e920e-b0d6-4db9-8554-5b7014676441",
                                                "sense_id": "61d733bf-5619-3f0a-89e7-725a0b7786fb",
                                                "text": "Beeple’s collaged JPG was made, or “minted,” in February as a “nonfungible token,” or NFT."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mint",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a5b9180-98f0-39a0-88d7-61098b028392",
                                        "entry_id": "140dc12d-5ac9-3d75-86f4-1962512189d3",
                                        "glosses": [
                                            "Ellipsis of mint condition: like new."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis",
                                            "not-comparable"
