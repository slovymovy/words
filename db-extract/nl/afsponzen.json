                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a5a7e501-e65b-3c5c-9e5b-e11dbdda7c71",
                                        "entry_id": "52d659e4-e1f8-3220-bb27-4de70fc5212c",
                                        "glosses": [
                                            "To clean with a sponge"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d25f32c2-35e3-4ad3-9b26-52e2a03daec4",
                                                "sense_id": "a5a7e501-e65b-3c5c-9e5b-e11dbdda7c71",
                                                "text": "If your skin is dry and flaky all over, pour a few handfuls of salt in your bath water and sponge down your entire body. When you’re through, slather on the moisturizer."
                                            },
                                            {
                                                "example_id": "984008f3-e5db-436a-8cd1-51f1be13c33d",
                                                "sense_id": "a5a7e501-e65b-3c5c-9e5b-e11dbdda7c71",
                                                "text": "Painted wallcoverings can be sponged down, of course, but having a wallcovering with a plastic surface makes it more stain-resistant and easier to keep clean."
                                            },
                                            {
                                                "example_id": "34df9ce9-b6ae-426e-8d7f-3255b898b05e",
                                                "sense_id": "a5a7e501-e65b-3c5c-9e5b-e11dbdda7c71",
                                                "text": "When they awoke they were fed again and sponged down to make sure their fur was clean. At bed-time they were bathed again."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sponge down",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d5d5bc76-c825-313f-b4a8-9693f607b564",
                                        "entry_id": "3307d7ad-27a1-3d1a-9bc1-a2b076fad4af",
                                        "glosses": [
                                            "A quick clean of something (namely the body) with a sponge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1f9ecb3-5fb4-4502-a9a2-872ebc38c0cf",
                                                "sense_id": "d5d5bc76-c825-313f-b4a8-9693f607b564",
                                                "text": "When the pack is removed a cold or tepid sponge down should be given and the patient placed in a warm bed."
                                            },
                                            {
                                                "example_id": "70e85820-cb6f-4b8c-9b8a-ab7e09194467",
                                                "sense_id": "d5d5bc76-c825-313f-b4a8-9693f607b564",
                                                "text": "When high fever is present, a sponge down twice a day will add to the patient’s comfort."
                                            },
                                            {
                                                "example_id": "6d59e335-27f4-4dad-92ba-e308434a5c70",
                                                "sense_id": "d5d5bc76-c825-313f-b4a8-9693f607b564",
                                                "text": "“And how’s the nurse who can’t tell ’flu from measles?”\n“As good as the patient who’s scared of a sponge down!”’"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
