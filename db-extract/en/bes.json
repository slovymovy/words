            {
                "entry_id": "1621d409-5df1-32ac-b34c-62fedd3b8c6d",
                "word": "bes",
                "pos": "verb",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ce4e73bc-c6af-3022-bb65-77db59b67b0c",
                        "entry_id": "1621d409-5df1-32ac-b34c-62fedd3b8c6d",
                        "glosses": [
                            "third-person singular simple present indicative of be"
                        ],
                        "tags": [
                            "dialectal",
                            "form-of",
                            "indicative",
                            "present",
                            "singular",
                            "third-person"
                        ],
                        "examples": [
                            {
                                "example_id": "ac61097a-5234-4257-99cf-c8b107e92318",
                                "sense_id": "ce4e73bc-c6af-3022-bb65-77db59b67b0c",
                                "text": "She bes there these five yare, an' has sint hoome foor her broother an' sister, the mooney for their passage, an' they bes goone these thra yares."
                            },
                            {
                                "example_id": "af21331b-5c48-459f-94bd-0a0648c9e37e",
                                "sense_id": "ce4e73bc-c6af-3022-bb65-77db59b67b0c",
                                "text": "\"An' he bes free times as old as herself,\" he wailed, \" an' ugly as a squid ! But he bes rich — rich as any marchant — an' for the bread an' the fixin's an' the gold she bes takin' 'im.\""
                            },
                            {
                                "example_id": "79dd84f9-564e-4bf1-a1f3-5692c3727300",
                                "sense_id": "ce4e73bc-c6af-3022-bb65-77db59b67b0c",
                                "text": "And she bes white. Now, I bes what they use to call a house nigra. I don't work in no fields. And you know, I likes my color. Sho' not real fair, and not real dark either. I bes just who I be."
                            }
                        ]
                    },
                    {
                        "sense_id": "656cac95-e00d-34a1-86ef-f0e36308bf5f",
                        "entry_id": "1621d409-5df1-32ac-b34c-62fedd3b8c6d",
                        "glosses": [
