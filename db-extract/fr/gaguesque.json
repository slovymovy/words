                        "source_sense_description": "umgangssprachlich: komisch, merkwürdig, sonderbar",
                        "target_lang_word": "komisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "komisch",
