                ],
                "senses": [
                    {
                        "sense_id": "040b33e2-7ea1-3aad-9d66-f1e5c2a7d126",
                        "entry_id": "cf96f4e5-c555-34d5-aac6-059d63121537",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ba01e07-c4e0-401d-8c31-6d73db79cd89",
                                "sense_id": "040b33e2-7ea1-3aad-9d66-f1e5c2a7d126",
                                "text": "Frau Hörnle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "3b0d2c71-9f2c-4fb5-b92b-a1ac5a18ffcf",
                                "sense_id": "040b33e2-7ea1-3aad-9d66-f1e5c2a7d126",
                                "text": "Herr Hörnle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "4c1bf389-3cf6-48a2-8546-6ae12f1d49c3",
                                "sense_id": "040b33e2-7ea1-3aad-9d66-f1e5c2a7d126",
                                "text": "Die Hörnles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "86351867-cd7a-4f5c-97e0-c625eab7be7d",
                                "sense_id": "040b33e2-7ea1-3aad-9d66-f1e5c2a7d126",
                                "text": "Der Hörnle trägt nie die Pullover, die die Hörnle ihm strickt."
                            },
                            {
                                "example_id": "853afe74-1021-4908-ac19-7f7b4710625f",
                                "sense_id": "040b33e2-7ea1-3aad-9d66-f1e5c2a7d126",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hörnle kommt, geht der Herr Hörnle.“"
                            },
                            {
                                "example_id": "b2f6fee9-e7be-45e2-b827-6a1db50c7dca",
                                "sense_id": "040b33e2-7ea1-3aad-9d66-f1e5c2a7d126",
                                "text": "Hörnle kommt und geht."
                            },
                            {
                                "example_id": "22934584-630c-4718-aa81-5ffe900b8798",
                                "sense_id": "040b33e2-7ea1-3aad-9d66-f1e5c2a7d126",
                                "text": "Hörnles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
