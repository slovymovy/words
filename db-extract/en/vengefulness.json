                "entry_id": "e6d36d6f-bbbe-3fb7-a656-3783d9a33323",
                "word": "vengefulness",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0db16c64-9299-3257-bd69-5139af94ae46",
                        "entry_id": "e6d36d6f-bbbe-3fb7-a656-3783d9a33323",
                        "glosses": [
                            "The state or quality of being vengeful"
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "552ac0e5-d378-459c-ab4f-74885585490a",
                                "sense_id": "0db16c64-9299-3257-bd69-5139af94ae46",
                                "text": "The vengefulness of the king was legendary."
                            },
                            {
                                "example_id": "3a170bce-862d-4a5b-914a-5696e5171a1a",
                                "sense_id": "0db16c64-9299-3257-bd69-5139af94ae46",
                                "text": "To this day his reason has never recovered from that shock; a wild nightmare of vengefulness has possessed him ever since, and he has almost bankrupted his native ingenuities in inventing pains and miseries and humiliations and heartbreaks wherewith to embitter the brief lives of Adam's descendants."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fc8831c2-5977-42f4-8417-d9f3642a33f4",
                        "source_entry_id": "e6d36d6f-bbbe-3fb7-a656-3783d9a33323",
                        "source_sense_id": "0db16c64-9299-3257-bd69-5139af94ae46",
                        "source_sense_description": "state or quality of being vengeful",
                        "target_lang_word": "wraakzucht",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wraakzucht",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "e0c104ee-7bf7-311c-89eb-9423fbc1e04c",
                                        "entry_id": "988263eb-a9ab-3cdb-bd87-60c279a0063f",
                                        "glosses": [
                                            "sterke behoefte aan vergelding wegens een echt of vermeend onrecht dat iemand is aangedaan"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f0c2bf7-631a-4b36-9668-6e5e813b802f",
                                                "sense_id": "e0c104ee-7bf7-311c-89eb-9423fbc1e04c",
                                                "text": "Hij heeft de minnaar van zijn vrouw uit wraakzucht vermoord."
                                            },
                                            {
                                                "example_id": "bf66b98a-df1d-476e-899d-5c17351e1c6e",
                                                "sense_id": "e0c104ee-7bf7-311c-89eb-9423fbc1e04c",
                                                "text": "Een gauwdief gaat aan een vroom en eerlijk man vragen om met hem een deal te sluiten, maar hij krijgt een negatief antwoord. Dan gaat die gemenerd, louter uit spijt en wraakzucht, alle gelegenheden na om die goede man leed te berokkenen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
