                    {
                        "sense_id": "790356e3-86cb-351a-9a16-8ce93394a87e",
                        "entry_id": "45c2575e-c06e-3db2-ae16-b6c2bc0b0393",
                        "glosses": [
                            "een zitbank met twee zittingen die in een hoek t.o.v. elkaar staan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4edb4142-7b0e-4111-9257-7e86bdc5ad6e",
                                "sense_id": "790356e3-86cb-351a-9a16-8ce93394a87e",
                                "text": "Een hoekbank, twee grote fauteuils en een 40 inch televisie en zelfs indien gewenst een badkamer. Toch hebben we het hier niet over een woonkamer, maar over een ‘busje’. Het Amerikaanse Becker Automotive Designs tovert de Mercedes Sprinter om tot een soort privéjet voor de openbare weg.de Telegraaf WOUTER SPANJAART"
                            },
                            {
                                "example_id": "fc923a6c-3b21-42b2-91af-0594d125ca05",
                                "sense_id": "790356e3-86cb-351a-9a16-8ce93394a87e",
                                "text": "Hij zit daar verschanst in het hoekje van de hoekbank met een dik boek op schoot en naast hem z’n iPod, iPad, iPhone en aaiPoes (althans tot voor kort, want het arme beestje hebben we helaas voor de vakantie moeten laten inslapen)."
                            },
                            {
                                "example_id": "61dc21f4-ac82-4559-b2eb-2f5f6cd1c568",
                                "sense_id": "790356e3-86cb-351a-9a16-8ce93394a87e",
                                "text": "Er is echter ook steeds meer vraag naar het basispakket voor 193 euro inclusief btw per maand\", vertelt Oraile. \"We leveren dan een hoekbank, salontafel, televisiemeubel, eettafel, vier eettafelstoelen, een eenpersoonsbed en twee matrassen."
                            }
                        ]
                    }
