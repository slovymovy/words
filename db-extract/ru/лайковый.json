                ],
                "senses": [
                    {
                        "sense_id": "091b8827-7d29-30be-9452-6ffa1dc24cc2",
                        "entry_id": "32544798-3bae-3be9-95a0-bebb46a2682a",
                        "glosses": [
                            "изготовленный из лайки"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb53af97-c736-48c0-9bb9-01941119bfc4",
                                "sense_id": "091b8827-7d29-30be-9452-6ffa1dc24cc2",
                                "text": "Окончив речь, гость с обворожительной приятностью подшаркнул ногой, обутой в щегольской лайковый полусапожек, застёгнутый на перламутровые пуговки, и, несмотря на полноту корпуса, отпрыгнул тут же несколько назад с лёгкостью резинного мячика."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "748c91f6-2f68-44a3-a77c-312090f2199f",
                        "source_entry_id": "32544798-3bae-3be9-95a0-bebb46a2682a",
                        "source_sense_id": "091b8827-7d29-30be-9452-6ffa1dc24cc2",
                        "target_lang_word": "kid",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "70665cb0-0070-363b-a49f-deb0b307ba7a",
                                        "entry_id": "c1474eaa-0646-3161-8fd6-9ab5d0c0fa2d",
                                        "glosses": [
                                            "A child, adolescent, or (loosely) a young adult."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd2e80f7-c18b-4b76-9486-5f552e5437ef",
                                                "sense_id": "70665cb0-0070-363b-a49f-deb0b307ba7a",
                                                "text": "She's a kid. It's normal for her to have imaginary friends."
                                            },
                                            {
                                                "example_id": "291cd0bf-f1a7-4792-a525-4e74187d3800",
                                                "sense_id": "70665cb0-0070-363b-a49f-deb0b307ba7a",
                                                "text": "“So you’ve got the kid,” said Sikes, when they had all reached the room: closing the door as he spoke. ¶ “Yes, here he is,” replied Nancy. ¶ “Did he come quiet?” inquired Sikes. ¶ “Like a lamb,” rejoined Nancy."
                                            },
                                            {
                                                "example_id": "24bb74af-688a-4eeb-8e5e-0486814e6515",
                                                "sense_id": "70665cb0-0070-363b-a49f-deb0b307ba7a",
                                                "text": "I said, “I’ll send the first sane soul I meet to keep you company.” As luck would have it, I never met one,—only kids, and a baker, who wouldn’t leave his cart, or take it with him either."
                                            },
                                            {
                                                "example_id": "1183232d-83ec-4feb-aaa3-279affa77103",
                                                "sense_id": "70665cb0-0070-363b-a49f-deb0b307ba7a",
                                                "text": "\"I should never dream of calling a kid like you a woman,\" said Digory loftily."
                                            },
                                            {
                                                "example_id": "42a53662-0d35-4420-a2c9-fb06ccc6c495",
                                                "sense_id": "70665cb0-0070-363b-a49f-deb0b307ba7a",
                                                "text": "‘No,’ said Luke, grinning at her. ‘You’re not dull enough! […] What about the kid’s clothes? I don’t suppose they were anything to write home about, but didn’t you keep anything? A bootee or a bit of embroidery or anything at all?’"
                                            },
                                            {
                                                "example_id": "71f38216-99f0-4c85-84b3-595a7ed0d5da",
                                                "sense_id": "70665cb0-0070-363b-a49f-deb0b307ba7a",
                                                "text": "Our kids are why all of you are in this room today. Our kids are why you wake up wondering how you'll make a difference and go to bed thinking about tomorrow's lesson plan. Our kids are why you walk into that classroom every day even when you're not getting the support, or the pay, or the respect that you deserve - because you believe that every child should have a chance to succeed; that every child can be taught."
                                            },
                                            {
                                                "example_id": "bcd1e1cc-f95c-459e-b43c-137b9b72faf4",
                                                "sense_id": "70665cb0-0070-363b-a49f-deb0b307ba7a",
                                                "text": "She not my lover like \"Billie Jean\", but the kid is mine"
                                            },
                                            {
                                                "example_id": "02b3b6c7-a2e7-477f-aca6-99ed12467aa4",
                                                "sense_id": "70665cb0-0070-363b-a49f-deb0b307ba7a",
                                                "text": "Network Rail is now the biggest kid in the playground, so if it doesn't want to play it doesn't have to, and the trees still fall down every time someone gives a low pressure system a name."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66d9f46e-d0f9-3f0b-b7f8-8a4cd6b9ce68",
                                        "entry_id": "c1474eaa-0646-3161-8fd6-9ab5d0c0fa2d",
                                        "glosses": [
                                            "A child, adolescent, or (loosely) a young adult.",
                                            "A person whose childhood took place in a particular time period or area."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f56a4098-8dcc-4fa9-9933-8ad22fc75656",
                                                "sense_id": "66d9f46e-d0f9-3f0b-b7f8-8a4cd6b9ce68",
                                                "text": "Only '90s kids will remember this toy."
                                            },
                                            {
                                                "example_id": "d2d831d7-ac9b-46bd-98a6-0ea0f9c0699f",
                                                "sense_id": "66d9f46e-d0f9-3f0b-b7f8-8a4cd6b9ce68",
                                                "text": "He's been living in Los Angeles for years now, but he's a Florida kid."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a365bf85-854d-325a-81e9-bd636b313245",
                                        "entry_id": "c1474eaa-0646-3161-8fd6-9ab5d0c0fa2d",
                                        "glosses": [
                                            "A child, adolescent, or (loosely) a young adult.",
                                            "One's son or daughter, regardless of age."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51112c28-77ad-4c30-bcf9-faa617f25532",
                                                "sense_id": "a365bf85-854d-325a-81e9-bd636b313245",
                                                "text": "This is Bobby, he is our youngest kid."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "002c9c8c-6b03-3520-92ef-1ac00944603c",
                                        "entry_id": "c1474eaa-0646-3161-8fd6-9ab5d0c0fa2d",
                                        "glosses": [
                                            "A child, adolescent, or (loosely) a young adult.",
                                            "Used as a form of address for a child, teenager or young adult."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "adb2e6c5-1ed8-4402-ac7c-8439383cfacc",
                                                "sense_id": "002c9c8c-6b03-3520-92ef-1ac00944603c",
                                                "text": "Here's looking at you, kid."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4bd985f-b9ab-3eb2-8f98-85423d40b9db",
                                        "entry_id": "c1474eaa-0646-3161-8fd6-9ab5d0c0fa2d",
                                        "glosses": [
                                            "A child, adolescent, or (loosely) a young adult.",
                                            "An inexperienced person or one in a junior position."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23e83c54-0931-4e9f-9425-c47f1531acf6",
                                                "sense_id": "c4bd985f-b9ab-3eb2-8f98-85423d40b9db",
                                                "text": "2007 June 3, Eben Moglen, speech, Freeing the Mind: Free Software and the end of proprietary culture,\nI remember as a kid lawyer working at IBM in the summer of 1983, when a large insurance company in Hartford, Connecticut, for the first time asked to buy 12000 IBM PCs in a single order."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a9830f6-b749-3f26-b0fb-b7091800087c",
                                        "entry_id": "c1474eaa-0646-3161-8fd6-9ab5d0c0fa2d",
                                        "glosses": [
                                            "A young goat."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b06311a8-5bd1-4226-9a77-7157397c3cc0",
                                                "sense_id": "3a9830f6-b749-3f26-b0fb-b7091800087c",
                                                "text": "He treated the oxen like they didn't exist, but he treated the goat kid like a puppy."
                                            },
                                            {
                                                "example_id": "189e0184-791e-45a2-b080-7e4c4ad33be5",
                                                "sense_id": "3a9830f6-b749-3f26-b0fb-b7091800087c",
                                                "text": "I went indeed intending to kill a Kid out of my own Flock, and bring him home and dreſs it. But as I was going, I ſaw a She Goat lying down in the Shade, and two young Kids ſitting by her, […]"
                                            },
                                            {
                                                "example_id": "80c7bad1-c910-4488-8d13-44103a43b4b6",
                                                "sense_id": "3a9830f6-b749-3f26-b0fb-b7091800087c",
                                                "text": "The lofty mountains roſe faint to the ſight and loſt their foreheads in the diſtant ſkies: the little hills, cloathed in darker green and ſkirted with embroidered vales, diſcovered the ſecret haunts of kids and bounding roes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20b699dd-5f1f-3861-9127-4d3370298e6c",
                                        "entry_id": "c1474eaa-0646-3161-8fd6-9ab5d0c0fa2d",
                                        "glosses": [
                                            "A young goat.",
                                            "Kidskin."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "596284dc-1c04-4010-a2d5-6d2c1fd801fb",
                                                "sense_id": "20b699dd-5f1f-3861-9127-4d3370298e6c",
                                                "text": "I have three pairs of kid gloves. I've had kid mittens before from the Christmas tree, but never real kid gloves with five fingers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98fe3ded-c376-36fd-878b-cad88b96a7e1",
                                        "entry_id": "c1474eaa-0646-3161-8fd6-9ab5d0c0fa2d",
                                        "glosses": [
                                            "A young goat.",
                                            "The meat of a young goat."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e29de46-0cba-4020-b951-306c5b95b1bd",
                                                "sense_id": "98fe3ded-c376-36fd-878b-cad88b96a7e1",
                                                "text": "So saying, he gathered together, and brought to a flame, the decaying brands which lay scattered on the ample hearth; took from the larger board a mess of pottage and seethed kid, placed it upon the small table at which he had himself supped, and without waiting the Jew's thanks, went to the other side of the hall;—[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6e7ca2a-94f3-35f3-aa53-61ab998ef44d",
                                        "entry_id": "c1474eaa-0646-3161-8fd6-9ab5d0c0fa2d",
                                        "glosses": [
                                            "A young antelope."
                                        ],
