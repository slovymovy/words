                                        "entry_id": "65b0478c-04ad-3175-8fd9-e44f5f65a985",
                                        "glosses": [
                                            "in der Art und Weise der Poesie oder des Poeten, auf die Poesie oder den Poeten bezogen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6998040-3186-4742-a4e8-3eae052b966a",
                                                "sense_id": "51e6d409-dd2d-3500-be6e-9521292f626e",
                                                "text": "Wenn mir danach ist, lese ich gern ein poetisches Werk."
                                            },
                                            {
                                                "example_id": "456c33db-6300-4906-97fe-599a25ea6bc7",
                                                "sense_id": "51e6d409-dd2d-3500-be6e-9521292f626e",
                                                "text": "Das klingt sehr poetisch."
                                            },
                                            {
                                                "example_id": "806c6969-f2d0-4a45-8df0-8a8b4a099e51",
                                                "sense_id": "51e6d409-dd2d-3500-be6e-9521292f626e",
                                                "text": "„Die Poetik ist nur eine der Disziplinen, die sich mit poetischen Texten beschäftigen.“"
                                            },
                                            {
                                                "example_id": "03fc9569-73f3-4905-bc1a-5507b65957c1",
                                                "sense_id": "51e6d409-dd2d-3500-be6e-9521292f626e",
                                                "text": "„Ja, das Schreiben und das Lesen",
                                                "translation": "poetisch war ich nie!“"
                                            }
                                        ],
