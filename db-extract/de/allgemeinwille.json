                "senses": [
                    {
                        "sense_id": "184438d9-e12d-308f-94bd-93abd380eb14",
                        "entry_id": "176e8360-c0df-3e67-ba32-aaab8b620766",
                        "glosses": [
                            "Wille, der das Allgemeinwohl repräsentiert"
                        ],
                        "tags": [
                            "politische Philosophie"
                        ],
                        "examples": [
                            {
                                "example_id": "782103f4-49ff-48a8-bb74-873876c74090",
                                "sense_id": "184438d9-e12d-308f-94bd-93abd380eb14",
                                "text": "„Der Allgemeinwille ist nach Rousseau unzerstörbar.“"
                            },
                            {
                                "example_id": "d113564b-7912-4fdc-b0ca-ec5b38af8f07",
                                "sense_id": "184438d9-e12d-308f-94bd-93abd380eb14",
                                "text": "„Der Allgemeinwille als a priori existent unterstellt, müsse in Flächenstaaten bzw. in Massengesellschaften zum Ausdruck gebracht werden, ohne dass er sich in Volksversammlungen artikulieren, dort zum Ausdruck gebracht werden könnte.“"
                            },
                            {
                                "example_id": "063d17cc-9219-4dc7-b911-6e7cc1dac89d",
                                "sense_id": "184438d9-e12d-308f-94bd-93abd380eb14",
                                "text": "„Nur in der kompetenten Anpassung der Produktion an gegebene Bedürfnisse, nicht in der Rücksicht auf eine utopische Hörerschaft vermag nach solcher Logik der namenlose Allgemeinwille Gestalt zu gewinnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "742ff9cc-8482-4f2b-a727-f32d47055aff",
