                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "951bcd94-a099-46c4-9f63-84a7a2206a29",
                        "entry_id": "216ce81e-88d0-37f6-8ad2-5ce06b20259a",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "dulçaquicoles"
