                "senses": [
                    {
                        "sense_id": "a10fcbb1-108b-3dcf-8195-22ea044a01e3",
                        "entry_id": "f9d57921-e39a-3461-9f5b-b081773ec854",
                        "glosses": [
                            "Bereich zwischen Ägäis und angrenzendem Festland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53d0074b-3667-4cb7-a4e3-3e6340ecb2fc",
                                "sense_id": "a10fcbb1-108b-3dcf-8195-22ea044a01e3",
                                "text": "„Offenbar haben sich Notgrabungen in Knidos an der türkischen Ägäisküste im Lauf der Jahre zu Raubzügen entwickelt.“"
                            },
                            {
                                "example_id": "9dea2b0c-9ddc-4cc4-917f-00606fa7626e",
                                "sense_id": "a10fcbb1-108b-3dcf-8195-22ea044a01e3",
                                "text": "„Mehr als 68.000 Menschen setzten seit Jahresbeginn von der türkischen Ägäisküste zu den griechischen Inseln über, teilte das UNO-Flüchtlingshochkommissariat (UNHCR) mit.“"
                            },
                            {
                                "example_id": "b76b2634-6a3e-473d-8151-5fb53a4ed749",
                                "sense_id": "a10fcbb1-108b-3dcf-8195-22ea044a01e3",
                                "text": "„An der türkischen Ägäisküste sammeln sich Tausende von Flüchtlingen und Migranten, um ihre Weiterreise in die Europäische Union zu organisieren, die meisten stammen aus Syrien, andere aus Afghanistan, Pakistan und Iran.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
