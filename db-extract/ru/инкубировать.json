                    {
                        "translation_id": "ca61ef9a-bef2-47cd-a5e5-a33377f11948",
                        "source_entry_id": "966ffe43-c7a2-35e0-9030-4ab069472d4c",
                        "source_sense_id": "ecdd722d-28f6-3200-817c-5d194d882746",
                        "target_lang_word": "inkubieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inkubieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c16f0874-e532-3a6c-bfdd-723e1173999e",
                                        "entry_id": "46855eec-1098-3599-a639-f799190e1a63",
                                        "glosses": [
                                            "Krankheitserreger vermehren"
                                        ],
                                        "tags": [
                                            "Immunologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1d9ed29-b9eb-4e4d-98f9-8ea1a1027480",
                                                "sense_id": "c16f0874-e532-3a6c-bfdd-723e1173999e",
                                                "text": "„Die so behandelten Präparate wurden zusammen mit zwei nicht mit Speichel beschickten Kontrollschnitten in einem Brutkasten bei 379 C für etwa 2 Stunden inkubiert.“"
                                            },
                                            {
                                                "example_id": "94446d5b-ca35-47b0-b83d-cdfdb7427c67",
                                                "sense_id": "c16f0874-e532-3a6c-bfdd-723e1173999e",
                                                "text": "„Sodann 0,025 ml Suspension sensibilisierter Erythrozyten in jedes Näpfchen bringen, Platte schütteln und weitere 30 Min. inkubieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "94ff0407-6d03-4e90-8ef1-8d0f5c9f4415",
                        "source_entry_id": "966ffe43-c7a2-35e0-9030-4ab069472d4c",
                        "source_sense_id": "ecdd722d-28f6-3200-817c-5d194d882746",
                        "target_lang_word": "incuber",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
