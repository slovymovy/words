                    }
                ],
                "translations": [
                    {
                        "translation_id": "58c5390d-ace1-460a-982c-e2969d3157dc",
                        "source_entry_id": "4054b04f-57d2-3e70-aa41-92301e00f37c",
                        "source_sense_id": "02b4de13-0fee-3219-806d-8cd4fc64e801",
                        "source_sense_description": "großes Blechblasinstrument",
                        "target_lang_word": "Sousaphone",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "8869bbdc-89b7-4207-9dee-ed61f9fec4b5",
                        "source_entry_id": "4054b04f-57d2-3e70-aa41-92301e00f37c",
                        "source_sense_id": "02b4de13-0fee-3219-806d-8cd4fc64e801",
                        "source_sense_description": "großes Blechblasinstrument",
                        "target_lang_word": "soubassophone",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "soubassophone",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "842bcf56-57f5-3ad6-936a-256c21c0449f",
                                        "entry_id": "052143ec-9526-3c5e-8d3c-e566b7a0ca40",
                                        "glosses": [
                                            "Instrument de musique de la famille des cuivres doux, apparenté au tuba-contrebasse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a9c64a1-de10-40a0-a8b4-f47f2a18e9e0",
                                                "sense_id": "842bcf56-57f5-3ad6-936a-256c21c0449f",
                                                "text": "Citons enfin le contretuba ou contrebasse-tuba en ut à 4 ou 5 pistons qui sonne à l’octave inférieure des notes écrites, ainsi que, pour mémoire, les spectaculaires hélicon, sousaphone ou soubassophone, si prisés aux U.S.A."
                                            },
                                            {
                                                "example_id": "4127b9ae-a08a-4bf4-9672-a27ffe6c5053",
                                                "sense_id": "842bcf56-57f5-3ad6-936a-256c21c0449f",
                                                "text": "Les connaisseurs pouvaient reconnaître des instruments de la même famille tels que l’hélicon, le saxhorn, l’euphonium, le contre-tuba, l’alto, le bugle, le soubassophone…"
                                            },
                                            {
                                                "example_id": "eaf9ecd6-3aa5-400b-9131-3eb57bd6a384",
                                                "sense_id": "842bcf56-57f5-3ad6-936a-256c21c0449f",
                                                "text": "Le répertoire de Miri Gili vous invite à découvrir la variété des chansons tziganes, depuis les balades roumaines et manouches accompagnées au violon jusqu’aux danses de mariage et de fanfares accompagnées au soubassophone, en prenant soin de respecter l’esprit roman : \"La larme à l’œil mais le sourire aux lèvres\"… ou inversement…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a30df877-21f9-4afc-be52-aad692b64e5b",
                        "source_entry_id": "4054b04f-57d2-3e70-aa41-92301e00f37c",
                        "source_sense_id": "02b4de13-0fee-3219-806d-8cd4fc64e801",
                        "source_sense_description": "großes Blechblasinstrument",
                        "target_lang_word": "sousaphone",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sousaphone",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "13cc6c8b-de57-30ad-8202-1146bb48aafc",
                                        "entry_id": "fb22cfe5-f1bd-3a87-88aa-d70ec60f922c",
                                        "glosses": [
                                            "Soubassophone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "619e5649-9f1d-4662-a2bd-7c5cc65d6d51",
                                                "sense_id": "13cc6c8b-de57-30ad-8202-1146bb48aafc",
                                                "text": "La capitale nationale s’apprête à vibrer au son des cornemuses, des sousaphones et des balalaïkas alors que des centaines de musiciens provenant de six pays débarqueront en ville dans le cadre du 13ᵉ Festival international de musiques militaires de Québec (FIMMQ)."
                                            },
                                            {
                                                "example_id": "743ca4ae-5b88-43c0-9a2f-d6ad9542fb4e",
                                                "sense_id": "13cc6c8b-de57-30ad-8202-1146bb48aafc",
                                                "text": "En Amérique, tout est vif, criard : oui, leurs paysages, leurs humeurs, leurs sousaphones et leurs gratte-ciel, leurs steaks si épais, leurs pommes de la taille des pamplemousses, le caquetage aux mâchoires d’acier de leurs usines et de leurs taxis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
