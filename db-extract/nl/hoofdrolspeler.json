                "senses": [
                    {
                        "sense_id": "07259b22-906a-3255-bf62-c4b7e006bcee",
                        "entry_id": "eab1d010-ea8b-3e84-8a84-6b2e49d67d1b",
                        "glosses": [
                            "de persoon die de belangrijkste rol speelt in een toneelstuk of film"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "aa2ca82f-a8dc-4c7c-9278-262da53ff304",
                                "sense_id": "07259b22-906a-3255-bf62-c4b7e006bcee",
                                "text": "Het derde seizoen van de populaire serie Mocro Maffia is vanaf 29 januari te zien bij Videoland. Dat bevestigt een woordvoerder van RTL aan deze site. Hoofdrolspeler en producent van de misdaadserie Achmed Akkabi deelt op Twitter de aankondiging van de nieuwe reeks."
                            }
                        ]
                    },
                    {
                        "sense_id": "8e1703ad-f7c8-33ef-8ada-164f6b7373e7",
                        "entry_id": "eab1d010-ea8b-3e84-8a84-6b2e49d67d1b",
                        "glosses": [
                            "de persoon die de belangrijkste rol speelt in een bepaalde activiteit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9c90848-d81c-4fc5-b2e9-a5430f666d9b",
                                "sense_id": "8e1703ad-f7c8-33ef-8ada-164f6b7373e7",
                                "text": "De Belgische drummer en video producer Michael Schack zag na het volgen van de debatten in het Britse Lagerhuis maar één hoofdrolspeler: John Bercow. Ja, die van 'Order!'. Schack maakte een remix van de orders en gaat daarmee viral."
                            },
                            {
                                "example_id": "862efd8a-aee9-47de-a283-6fa10f5c2398",
                                "sense_id": "8e1703ad-f7c8-33ef-8ada-164f6b7373e7",
                                "text": "In de wandelgangen van het Lagerhuis wordt de gang van zaken gekenschetst als shakespeareaans. Johnson en de andere hoofdrolspelers David Cameron (aftredend premier) en Michael Gove (premierskandidaat) zijn samen groot geworden binnen de Conservatieve partij, maar liggen door de brexit met elkaar overhoop."
                            }
                        ]
                    }
                ],
