                                "target_senses": [
                                    {
                                        "sense_id": "f08ec8b0-b21c-3c0b-b997-6af14029bb69",
                                        "entry_id": "2e25583b-2d96-3f9f-926e-6637c1359e42",
                                        "glosses": [
