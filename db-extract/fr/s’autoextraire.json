                ],
                "senses": [
                    {
                        "sense_id": "19625705-d265-3462-9555-4e7722e12a18",
                        "entry_id": "08400224-dc7e-35ea-8049-faa0f707bd96",
                        "glosses": [
                            "S’extraire tout seul."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfb58c24-817a-4697-b9f0-775751bbd751",
                                "sense_id": "19625705-d265-3462-9555-4e7722e12a18",
                                "text": "C'est une trouée sans structure de supplément, une trouée ou action analytique par l'interne, laquelle permet au vivre vif de la vie de s'autoextraire."
                            },
                            {
                                "example_id": "c9b2e823-4f0c-4be4-86c1-dce8c3d45eee",
                                "sense_id": "19625705-d265-3462-9555-4e7722e12a18",
                                "text": "Si vous ne désirez installer aucun logiciel, ScreenShotCaptor permet aussi de s'autoextraire et de ne pas poursuivre l'installation."
                            },
                            {
                                "example_id": "f4ce94c3-443b-4625-93c6-3d1cf2b3ed2d",
                                "sense_id": "19625705-d265-3462-9555-4e7722e12a18",
                                "text": "Comme se suturer ou s'autoextraire une balle, effectivement, je crois qu'il y a beaucoup de fantasme la dedans."
                            }
                        ]
                    }
                ],
