                "senses": [
                    {
                        "sense_id": "4de65a08-50c4-3797-a138-65301bcdd251",
                        "entry_id": "838b81c5-6f2a-347b-93a2-6a163a1d34d1",
                        "glosses": [
                            "A regional trade agreement between Australia, Canada, Chile, China, Japan, Mexico, New Zealand, Papua New Guinea, Peru, Russia, South Korea, Taiwan (under the name Chinese Taipei), Hong Kong, the US, and members of ASEAN."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1b49fcd-8848-40b4-9573-a525b7edf17d",
                                "sense_id": "4de65a08-50c4-3797-a138-65301bcdd251",
                                "text": "The small resource-rich Pacific nation, which is due to host the Asia-Pacific Economic Cooperation (APEC) forum in November, has long struggled with violence and lawlessness."
                            },
                            {
                                "example_id": "b7f90c1a-9ba3-4f2a-b76e-01267c09e686",
                                "sense_id": "4de65a08-50c4-3797-a138-65301bcdd251",
                                "text": "Xi enters the APEC leaders’ summit, which officially begins Friday, having already hit his diplomatic stride in the G20 meeting in Bali earlier this week – where his aim was to cast China as an integral part of a global arena alongside Western powers after an absence from the world stage."
                            }
                        ]
                    }
                ],
