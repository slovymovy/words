                },
                {
                    "sense_id": "5f367aa3-d18a-3f73-95c3-1869d96acf2f",
                    "sense_definition": "Niegodny większego szacunku, banalny lub prostacki.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "wartosc",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jego zachowanie na spotkaniu to był po prostu <w>tani</w> gest pod publiczkę.",
                            "target_lang_translations": {
                                "ru": "Его поведение на встрече было просто <w>дешёвым</w> жестом на публику.",
                                "en": "His behavior at the meeting was simply a <w>cheap</w> gesture to play to the crowd.",
                                "de": "Sein Verhalten bei dem Treffen war einfach nur eine <w>billige</w> Geste für die Galerie."
                            }
                        },
                        {
                            "text": "Unikał <w>tanich</w> wymówek i od razu przyznał się do popełnionego błędu.",
                            "target_lang_translations": {
                                "ru": "Он избегал <w>дешёвых</w> отговорок и сразу признался в совершённой ошибке.",
                                "en": "He avoided <w>lame</w> excuses and immediately admitted his mistake.",
                                "de": "Er vermied <w>billige</w> Ausreden und gab seinen Fehler sofort zu."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tani gest",
                        "tania wymówka"
