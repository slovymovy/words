                        "cross_references": [
                            {
                                "target_word": "animal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "151a2b69-0002-3382-8e56-b0e6371ba543",
                                        "entry_id": "4cb86cdc-eb3f-39a6-9ac9-02e4489d207d",
                                        "glosses": [
                                            "Any member of the kingdom Animalia of multicellular organisms that are usually mobile, whose cells are not encased in a rigid cell wall (distinguishing them from plants and fungi) and which derive energy solely from the consumption of other organisms (further distinguishing them from plants)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88b12a15-ec05-4ef4-ae6d-dc7fcc9666b3",
                                                "sense_id": "151a2b69-0002-3382-8e56-b0e6371ba543",
                                                "text": "Humans, like other animals, need air to breathe and food to eat."
                                            },
                                            {
                                                "example_id": "f6cf8997-f2bb-42a5-bde2-25991789e1cb",
                                                "sense_id": "151a2b69-0002-3382-8e56-b0e6371ba543",
                                                "text": "It cannot be denied it [the chameleon] is (if not the moſt of any) a very abſtemious animall, and ſuch as by reaſon of its frigidity, paucity of bloud, and latitancy in the winter (about which time the obſervations are often made) will long ſubſist without a viſible ſuſtentation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fd89f83-6a78-344a-8145-83fbff8c0774",
                                        "entry_id": "4cb86cdc-eb3f-39a6-9ac9-02e4489d207d",
                                        "glosses": [
                                            "Any member of the kingdom Animalia other than a human."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "af8a8f3c-816d-36fe-abb5-dc244dccd144",
                                        "entry_id": "4cb86cdc-eb3f-39a6-9ac9-02e4489d207d",
                                        "glosses": [
                                            "A higher animal; an animal related to humans."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8575b302-7331-4919-9753-f74d66c7100b",
                                                "sense_id": "af8a8f3c-816d-36fe-abb5-dc244dccd144",
                                                "text": "When he's hungry my toddler opens his mouth like an animal instead of asking us to feed him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57871ddb-08aa-3b35-9663-beffcaddd2fb",
                                        "entry_id": "4cb86cdc-eb3f-39a6-9ac9-02e4489d207d",
                                        "glosses": [
                                            "A higher animal; an animal related to humans.",
                                            "A tetrapod; a land-dwelling nonhuman vertebrate."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "494a2461-15c6-4925-b7a9-8224e2313488",
                                                "sense_id": "57871ddb-08aa-3b35-9663-beffcaddd2fb",
                                                "text": "Ancient nomads, wishing to ward off the evening chill and enjoy a meal around a campfire, had to collect wood and then spend time and effort coaxing the heat of friction out from between sticks to kindle a flame. With more settled people, animals were harnessed to capstans or caged in treadmills to turn grist into meal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90eb250c-e59e-3091-bdcc-80b33f79e3f5",
                                        "entry_id": "4cb86cdc-eb3f-39a6-9ac9-02e4489d207d",
                                        "glosses": [
                                            "A higher animal; an animal related to humans.",
                                            "A warm-blooded animal; a mammal or bird."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d65092f3-631b-315c-8b28-6a756c6bcf26",
                                        "entry_id": "4cb86cdc-eb3f-39a6-9ac9-02e4489d207d",
                                        "glosses": [
                                            "A higher animal; an animal related to humans.",
                                            "A non-human mammal."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d809e258-3a1b-4478-9e38-7150832ab79b",
                                                "sense_id": "d65092f3-631b-315c-8b28-6a756c6bcf26",
                                                "text": "Birds are as popular as animals in the toy kingdom, especially pigeons, owls and domestic hens."
                                            },
                                            {
                                                "example_id": "5bf50888-7652-4657-8779-49a480cfbc9b",
                                                "sense_id": "d65092f3-631b-315c-8b28-6a756c6bcf26",
                                                "text": "I spent my summer studying the animals and birds of the two islands."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa4364dc-18a4-30f5-8cec-3a27aeeda28a",
                                        "entry_id": "4cb86cdc-eb3f-39a6-9ac9-02e4489d207d",
                                        "glosses": [
                                            "A person who behaves wildly; a bestial, brutal, brutish, cruel, or inhuman person."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c51574e8-3814-401c-978d-b0377e2b3334",
                                                "sense_id": "aa4364dc-18a4-30f5-8cec-3a27aeeda28a",
                                                "text": "My students are animals."
                                            },
                                            {
                                                "example_id": "d8bbd257-9953-4687-bc99-6473fd90f78c",
                                                "sense_id": "aa4364dc-18a4-30f5-8cec-3a27aeeda28a",
                                                "text": "Own me, I'll let you play the role\nI'll be your animal"
                                            },
                                            {
                                                "example_id": "2da0c69f-11ce-414d-bd51-04219b664b25",
                                                "sense_id": "aa4364dc-18a4-30f5-8cec-3a27aeeda28a",
                                                "text": "She speculated that things could deteriorate later: “I think they’re scared of the English, which is fair; we are animals.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8eeedb0e-f27e-3f4f-95f3-14fbdd650506",
                                        "entry_id": "4cb86cdc-eb3f-39a6-9ac9-02e4489d207d",
                                        "glosses": [
                                            "A person of a particular type specified by an adjective."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1bb2f06b-ad7b-4626-8980-0ccf65ddb16b",
                                                "sense_id": "8eeedb0e-f27e-3f4f-95f3-14fbdd650506",
                                                "text": "He's a political animal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f519acb6-e118-3593-900e-6f1ea54c1a7e",
                                        "entry_id": "4cb86cdc-eb3f-39a6-9ac9-02e4489d207d",
                                        "glosses": [
                                            "Matter, thing."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b95e38a-f75e-44cc-a69c-fadc889fe58b",
                                                "sense_id": "f519acb6-e118-3593-900e-6f1ea54c1a7e",
                                                "text": "a whole different animal"
                                            },
                                            {
                                                "example_id": "4c7721d4-d73a-4630-9bed-c0fcee96b4d5",
                                                "sense_id": "f519acb6-e118-3593-900e-6f1ea54c1a7e",
                                                "text": "no such animal"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "animal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1738633c-7598-37dd-a239-18d838b4d857",
                                        "entry_id": "35ee5cbd-cfe5-30c6-8950-a707e3a26456",
                                        "glosses": [
                                            "Of or relating to animals."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5012f18f-a913-45d6-8961-d04ebfd908d9",
                                                "sense_id": "1738633c-7598-37dd-a239-18d838b4d857",
                                                "text": "animal instincts"
                                            },
                                            {
                                                "example_id": "9d0c47a7-7c12-4ed0-a892-21d6d223fb0b",
                                                "sense_id": "1738633c-7598-37dd-a239-18d838b4d857",
                                                "text": "The season has been most unfavourable to animal life; and I, who am merely animal, have suffered much by it."
                                            },
                                            {
                                                "example_id": "d6541879-4563-450d-bac3-a07128fb9f66",
                                                "sense_id": "1738633c-7598-37dd-a239-18d838b4d857",
                                                "text": "[…]—according to Sanssure, Abbé Fortis, Bruckenman, Jameson, Dr. Richardson, &c. &c. both animal and vegetal remains have been detected in Basalt and Wacke."
                                            },
                                            {
                                                "example_id": "a31b11d8-2f62-44ff-bf0e-58c11797a40d",
                                                "sense_id": "1738633c-7598-37dd-a239-18d838b4d857",
                                                "text": "The body was covered with soft hair, and though undoubtedly human, it was very animal in its instincts and ways."
                                            },
                                            {
                                                "example_id": "05fd8034-a4e1-4f7c-ac1c-6851044e2c85",
                                                "sense_id": "1738633c-7598-37dd-a239-18d838b4d857",
                                                "text": "The unsatisfactory material at our command, however, renders it difficult to determine why we cannot prove a worship of a living incarnation for every deity who is represented on the monuments in a form either wholly or partially animal. We must wonder why, for example, the sacred hawk or hawks of Horus at Edfu (who never has human form) are scarcely mentioned."
                                            },
                                            {
                                                "example_id": "b5a37d49-51ff-4394-b075-5ed23aca3a70",
                                                "sense_id": "1738633c-7598-37dd-a239-18d838b4d857",
                                                "text": "He looked down at the tangled wet hair, the wild, bare, animal shoulders."
                                            },
                                            {
                                                "example_id": "e4287a18-4767-4a98-98d6-5ece49e8dfb5",
                                                "sense_id": "1738633c-7598-37dd-a239-18d838b4d857",
                                                "text": "I thought: if pain is the thing shared by all living creatures, then I’m no longer human or animal or vegetal; I am unplugged from the tick of metabolism; I am mineral."
                                            },
                                            {
                                                "example_id": "eaadeb60-0ae0-4652-8603-d2fa65db049b",
                                                "sense_id": "1738633c-7598-37dd-a239-18d838b4d857",
                                                "text": "In any case, the argument the inhabitants of these parts would have advanced as their strongest one against the so-called chastity belt would, of course, have been that living species, whether animal or vegetative, were made the way they were for an obvious reason."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6dc8f37e-2e2b-37b8-94c1-c54628efe54b",
                                        "entry_id": "35ee5cbd-cfe5-30c6-8950-a707e3a26456",
                                        "glosses": [
                                            "Raw, base, unhindered by social codes."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52bb9e32-7806-4a0e-ba22-c948841fc780",
                                                "sense_id": "6dc8f37e-2e2b-37b8-94c1-c54628efe54b",
                                                "text": "animal passions"
                                            },
                                            {
                                                "example_id": "ac37b866-5c0d-48c4-8901-1e1dc22a858d",
                                                "sense_id": "6dc8f37e-2e2b-37b8-94c1-c54628efe54b",
                                                "text": "But the line also distills pop culture’s big commandment about sex to its animal essence: If you’re not screwing somebody, you’re nobody."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0225cfa-9a29-3732-a959-c9691b76894a",
                                        "entry_id": "35ee5cbd-cfe5-30c6-8950-a707e3a26456",
                                        "glosses": [
                                            "Pertaining to the spirit or soul; relating to sensation or innervation."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d1ad8a7-e096-47c0-b090-a70de46de0b2",
                                                "sense_id": "a0225cfa-9a29-3732-a959-c9691b76894a",
                                                "text": "To explain what activated the flesh, ‘animal spirits’ were posited, superfine fluids which shuttled between the mind and the vitals, conveying messages and motion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee3c28fa-6ede-3629-b2dc-d4c6fffd2448",
                                        "entry_id": "35ee5cbd-cfe5-30c6-8950-a707e3a26456",
                                        "glosses": [
                                            "Excellent."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "not-comparable",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bcf062d8-22d8-4f01-b8d9-91192b77d72d",
