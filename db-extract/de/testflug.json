                        "sense_id": "31dfdf0c-6c9d-3f73-b576-87b1fad4e9f7",
                        "entry_id": "144b5e3c-76ff-3b0e-ad47-ab1e31076c21",
                        "glosses": [
                            "Flug, mit dem überprüft wird, ob bei einem Luftfahrzeug tatsächlich alles so funktioniert, wie es funktionieren soll"
                        ],
                        "tags": [
                            "Luftfahrt"
                        ],
                        "examples": [
                            {
                                "example_id": "08942195-da45-49d8-a45a-1b6098b53905",
                                "sense_id": "31dfdf0c-6c9d-3f73-b576-87b1fad4e9f7",
                                "text": "Die Rekordgeschwindigkeit unter bemannten Flugzeugen hält der Düsenjet Lockheed SR-71. Er erreichte im Juli 1976 bei einem Testflug über Kalifornien, USA, 3529,6 Kilometer pro Stunde!"
                            },
                            {
                                "example_id": "c8875fe2-492c-47f5-96d6-22f7b829ce75",
                                "sense_id": "31dfdf0c-6c9d-3f73-b576-87b1fad4e9f7",
                                "text": "„Das Raumschiff Spaceship Two seines Unternehmens Virgin Galactic hat am Samstag erstmals von seinem Startplatz für Weltraumtouristen in New Mexico aus einen kurzen suborbitalen Testflug absolviert.“"
                            }
                        ],
