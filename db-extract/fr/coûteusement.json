                        "sense_id": "9856ce35-1732-323e-9c7e-5447963abbc1",
                        "entry_id": "215c0a2e-6136-3f5d-804f-e577105b6545",
                        "glosses": [
                            "D’une manière coûteuse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1aaec84b-6f65-418a-bade-9ab3abc9fbb6",
                                "sense_id": "9856ce35-1732-323e-9c7e-5447963abbc1",
                                "text": "Cet édifice si coûteusement élevé fut détruit par un incendie."
                            },
                            {
                                "example_id": "5d303eb6-e8f8-4b8c-87f2-6c9a9bf54a72",
                                "sense_id": "9856ce35-1732-323e-9c7e-5447963abbc1",
                                "text": "Je vivais au-dessus de mon âge comme on vit au-dessus de ses moyens : avec zèle, avec fatigue, coûteusement, pour la montre."
                            }
                        ]
                    }
                ],
                "translations": [
