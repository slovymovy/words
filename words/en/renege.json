{
    "word_family": [
        "reneger"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "27bd4c28-0564-3222-bef4-29e4751ced71",
                    "sense_definition": "To break a promise or commitment; to go back on one's word.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "breaking commitments",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company decided to <w>renege</w> on its promise to provide health insurance for all part-time employees."
                        },
                        {
                            "text": "If you <w>renege</w> on a deal now, your reputation in the industry will be ruined forever."
                        }
                    ],
                    "synonyms": [
                        "default",
                        "backtrack",
                        "welsh"
                    ],
                    "antonyms": [
                        "honor",
                        "fulfill",
                        "keep"
                    ],
                    "common_phrases": [
                        "renege on a promise",
                        "renege on a deal",
                        "renege on a commitment"
                    ]
                },
                {
                    "sense_id": "4ca41a2e-2ca4-3787-943b-1fcc77561806",
                    "sense_definition": "In card games, to fail to follow suit when one is able and required to do so.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "card games",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The player accidentally <w>reneged</w> by playing a spade when he still had a heart in his hand."
                        },
                        {
                            "text": "If you <w>renege</w> in this game, the opposing team is automatically awarded the points for that round."
                        }
                    ],
                    "synonyms": [
                        "revoke"
                    ],
                    "antonyms": [
                        "follow suit"
                    ],
                    "common_phrases": [
                        "renege in cards"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in card games"
                        }
                    ]
                },
                {
                    "sense_id": "4bdfad46-6c72-3958-9061-ae117e253bd8",
                    "sense_definition": "To deny or renounce a belief, right, or quality.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "denial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient text describes a hero who would <w>renege</w> all temper and succumb to his passions."
                        },
                        {
                            "text": "They were accused of trying to <w>renege</w> the very rights they had fought so hard to establish."
                        }
                    ],
                    "synonyms": [
                        "renounce",
                        "abjure",
                        "disown"
                    ],
                    "antonyms": [
                        "embrace",
                        "assert",
                        "claim"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English in this sense"
                        }
                    ]
                }
            ]
        }
    ]
}