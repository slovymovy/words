                                            {
                                                "example_id": "2ed8ab03-ca4c-48e4-8794-715665486647",
                                                "sense_id": "8ac25c17-df27-3818-968d-bfb9a4c23920",
                                                "text": "Лев почувствовал себя безымянной болванкой на конвейере оболванивания."
                                            }
                                        ]
                                    },
