                    {
                        "sense_id": "39996503-1272-36a4-8668-19b8c3fbc878",
                        "entry_id": "89f58704-058b-3844-835c-c697ca894b26",
                        "glosses": [
                            "de verdikte melk die afgegeven wordt door een koe die recentelijk gekalfd heeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d299c6a-6a43-4ab0-97c2-41af704c5be9",
                                "sense_id": "39996503-1272-36a4-8668-19b8c3fbc878",
                                "text": "Sommige mensen vinden biest op een beschuitje een lekkernij."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7c38edd4-7bae-4285-9ad9-12ea7fd40920",
                        "source_entry_id": "89f58704-058b-3844-835c-c697ca894b26",
                        "source_sense_id": "39996503-1272-36a4-8668-19b8c3fbc878",
