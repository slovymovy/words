                    {
                        "sense_id": "d1c6a56f-4219-3751-ad9f-b300cd0535e0",
                        "entry_id": "3263ed0d-1d83-3444-9359-16922d18038e",
                        "glosses": [
                            "To bring back into alignment."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "0c4c8593-20e8-41a1-812d-1e5a41e8e95c",
                                "sense_id": "d1c6a56f-4219-3751-ad9f-b300cd0535e0",
                                "text": "There are some low-tech approaches to forming those good posture habits, like the Alexander Method. The Alexander Method is a process that helps realign posture mindfully. It’s often used by performers, and often involves a coach."
                            }
                        ]
                    },
                    {
                        "sense_id": "57218365-2c56-3cf4-acfa-18b8d8202b9b",
                        "entry_id": "3263ed0d-1d83-3444-9359-16922d18038e",
                        "glosses": [
                            "To align again or anew."
                        ],
                        "tags": [
                            "ambitransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "a5af7b21-aedd-45fe-8dd2-bbe3d1d6753c",
                                "sense_id": "57218365-2c56-3cf4-acfa-18b8d8202b9b",
                                "text": "Every major bridge, and many of the smaller ones, have been rebuilt, tunnels have been rebored, and long sections of track realigned."
                            },
                            {
                                "example_id": "04edd9f0-ace9-4f21-b5b9-6218a91e8797",
                                "sense_id": "57218365-2c56-3cf4-acfa-18b8d8202b9b",
                                "text": "One Nation, a new 501(c)4 linked to the Karl-Rove-backed American Crossroads super PAC, is spending more than $1.9 million on print, radio and digital ads highlighting the efforts of Illinois Sen. Mark Kirk, North Carolina Sen. Richard Burr, New Hampshire Sen. Kelly Ayotte, Ohio Sen. Rob Portman and Pennsylvania Sen. Pat Toomey to pass the “doc fix” legislation that realigned payments to Medicare providers with inflation."
                            },
                            {
                                "example_id": "77da85da-61a0-411d-b6b2-79448ec02d6e",
                                "sense_id": "57218365-2c56-3cf4-acfa-18b8d8202b9b",
                                "text": "“We aren’t just reducing bureaucratic sprawl. We are realigning the organization with its core mission and our new priorities in reversing the chronic disease epidemic,” Kennedy said on Thursday morning."
                            }
                        ]
                    }
                ],
