                                    {
                                        "sense_id": "59517cc0-4543-33fb-a9e3-0f1ca95c9bc5",
                                        "entry_id": "c449096c-8d8b-3768-a159-18fa1e9c9e43",
                                        "glosses": [
                                            "Stadt in Niedersachsen, Deutschland"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03a911e7-944a-4080-8000-1c5582be5657",
                                                "sense_id": "59517cc0-4543-33fb-a9e3-0f1ca95c9bc5",
                                                "text": "Braunschweig liegt nordwestlich des Harzes."
                                            },
                                            {
                                                "example_id": "be7d7c06-d589-4c64-a963-ab6254d51af8",
                                                "sense_id": "59517cc0-4543-33fb-a9e3-0f1ca95c9bc5",
                                                "text": "„Ich hatte nämlich bereits als Kind meine feste Vorstellung von Braunschweig.“"
                                            },
                                            {
                                                "example_id": "c172539f-d537-47d8-be20-b87f93881dbd",
                                                "sense_id": "59517cc0-4543-33fb-a9e3-0f1ca95c9bc5",
                                                "text": "„Sonst hätte ich meinen Aufenthalt in Braunschweig nicht so bald beendet.“"
                                            },
                                            {
                                                "example_id": "39d58d8d-e352-4beb-ad25-dd946d963759",
                                                "sense_id": "59517cc0-4543-33fb-a9e3-0f1ca95c9bc5",
                                                "text": "„Bis Braunschweig, wo sie Mesmer zu treffen hoffen, verbringen beide eine angenehme Reise.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
