                                        "examples": [
                                            {
                                                "example_id": "76ff22a1-ad90-422d-b9c6-1cb8095d78f8",
                                                "sense_id": "1dcd4606-79a1-352c-8cc2-aa909dee654f",
                                                "text": "She was a walking example of how fitness training can take you a long way."
