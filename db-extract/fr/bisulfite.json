                        ],
                        "examples": [
                            {
                                "example_id": "3b6e05ba-3e1d-4e6b-8b1d-7aceab2138b2",
                                "sense_id": "295e654d-9a46-3066-b40c-e9e8a659373d",
                                "text": "Après plusieurs traitements successifs et modérés, on obtient une cellulose fibreuse bien blanche qu'on passe finalement en solution d'acide sulfureux ou bisulfite de soude pour enlever le chlore."
                            },
                            {
                                "example_id": "94c5a40f-c67a-4a97-8ec7-cb1aa933dd4e",
                                "sense_id": "295e654d-9a46-3066-b40c-e9e8a659373d",
                                "text": "Le paracrésol est facilement transformé entre 200° et 230° en paraméthylcyclohexanol, contenant seulement des traces d’acétone, faciles à éliminer par le bisulfite."
                            }
                        ]
                    }
