                ],
                "translations": [
                    {
                        "translation_id": "cba113f0-ace3-488d-abab-1ef40c4e5229",
                        "source_entry_id": "8523e874-7f47-3109-b5b8-80413ddd4d93",
                        "source_sense_id": "0331cb20-6d8d-3cd9-a2f0-dcc1d13e318e",
                        "source_sense_description": "niet geordened",
                        "target_lang_word": "amorphous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amorphous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "77445753-206a-36f7-867c-5673da22265c",
                                        "entry_id": "daf4ebf4-7ff3-37aa-8973-fa0fd8d84463",
                                        "glosses": [
                                            "Lacking a definite form or clear shape."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a728e620-14a5-4ffb-ab55-4eefd5772e6c",
                                                "sense_id": "77445753-206a-36f7-867c-5673da22265c",
                                                "text": "amorphous blob"
                                            },
                                            {
                                                "example_id": "31688349-2743-4cdb-8db9-e31c7ebbc332",
                                                "sense_id": "77445753-206a-36f7-867c-5673da22265c",
                                                "text": "The enormous pile of spaghetti landed on the floor in an amorphous heap."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb85f7e8-4d35-3ad4-bf57-66781e6d3a26",
                                        "entry_id": "daf4ebf4-7ff3-37aa-8973-fa0fd8d84463",
                                        "glosses": [
                                            "Being without definite character or nature."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e32507d9-f5c4-4851-993c-6272b7f8b1c3",
                                                "sense_id": "bb85f7e8-4d35-3ad4-bf57-66781e6d3a26",
                                                "text": "Gudrun, new from her life in Chelsea and Sussex, shrank cruelly from this amorphous ugliness of a small colliery town in the Midlands. Yet forward she went, through the whole sordid gamut of pettiness, the long amorphous, gritty street."
                                            },
                                            {
                                                "example_id": "860b2519-eef2-43fb-8363-aeb7ebcfd9a6",
                                                "sense_id": "bb85f7e8-4d35-3ad4-bf57-66781e6d3a26",
                                                "text": "And people talking all the time about the AfD is just what it wants: to foster the impression that the others are ganging up against it. The “authentic” voice of “real people” v the amorphous elite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9993bd6d-cbb9-321c-b1d5-d194c5eafa9a",
                                        "entry_id": "daf4ebf4-7ff3-37aa-8973-fa0fd8d84463",
                                        "glosses": [
                                            "Lacking organization or unity."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6dac11fd-b6e4-3a2c-b879-7caf7fb1d85d",
                                        "entry_id": "daf4ebf4-7ff3-37aa-8973-fa0fd8d84463",
                                        "glosses": [
                                            "In the non-crystalline solid state of, or being a non-crystalline counterpart to, a crystalline solid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f60a891-ff3e-4e65-b7b6-03e25dec9bb8",
                                                "sense_id": "6dac11fd-b6e4-3a2c-b879-7caf7fb1d85d",
                                                "text": "Near-synonym: noncrystalline"
                                            },
                                            {
                                                "example_id": "356a9078-ce19-455d-a06f-1148b6d30098",
                                                "sense_id": "6dac11fd-b6e4-3a2c-b879-7caf7fb1d85d",
                                                "text": "Glass is an amorphous solid, but some glass is called \"crystal\" because it looks crystalline and has been called crystal since before humans even understood molecular structure at all."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab8f5b9f-4b6e-3124-8497-9a660c1055af",
                                        "entry_id": "daf4ebf4-7ff3-37aa-8973-fa0fd8d84463",
                                        "glosses": [
                                            "Infinite and not the disjoint union of two infinite subsets."
                                        ],
                                        "tags": [
                                            "of a set"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
