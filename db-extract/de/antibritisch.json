                    }
                ],
                "senses": [
                    {
                        "sense_id": "dfbba34c-41cf-3957-83d8-d256a57b3af4",
                        "entry_id": "beed6ec3-5958-37c4-8d53-65058d4aa80d",
                        "glosses": [
                            "gegen Großbritannien/Briten gerichtet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df86765a-1362-4508-8627-1030e7d0acce",
                                "sense_id": "dfbba34c-41cf-3957-83d8-d256a57b3af4",
                                "text": "„An seinem äußeren Erscheinungsbild änderte sich auch später wenig, was zu seiner antibritischen Rhetorik einen merkwürdigen Kontrast bildete.“"
                            },
                            {
                                "example_id": "f24f7516-f682-49c4-b748-d7429f067e9d",
                                "sense_id": "dfbba34c-41cf-3957-83d8-d256a57b3af4",
                                "text": "„Währenddessen gewann in Kabul eine antibritische Stimmung die Oberhand.“"
                            },
                            {
                                "example_id": "078cdfec-3afc-4874-95d9-7f1107cc90fb",
                                "sense_id": "dfbba34c-41cf-3957-83d8-d256a57b3af4",
                                "text": "„Dabei war der Mufti durchaus nicht antibritisch eingestellt: im Gegenteil: Viele hielten ihn für einen Freund, ja sogar für einen Agenten der Behörden.“"
                            },
                            {
                                "example_id": "abb60ba9-555a-4563-8b8a-fb5094b71de4",
                                "sense_id": "dfbba34c-41cf-3957-83d8-d256a57b3af4",
                                "text": "„Anders als seine Frau Alix von Hessen-Darmstadt, eine Enkelin Königin Victorias, ließ Nikolaus deutliche Sympathien für die Buren erkennen und schien einem antibritischen Vorgehen, notfalls auch im Alleingang, nicht abgeneigt zu sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [],
                "word_linkages": [
                    {
                        "linkage_id": "17a5c1f7-3cc3-4f98-b1d1-8aeb749d04e6",
