                "senses": [
                    {
                        "sense_id": "e4d2b323-0d85-3076-a7a7-cb3e0e524f5e",
                        "entry_id": "794776fa-748b-3e70-be1d-daa597fe01d8",
                        "glosses": [
                            "Tunnel, der unter den Bahngleisen hindurchführt und es Fußgängern oder Fahrzeugen ermöglicht, den Bereich der Bahnstrecke sicher zu überqueren, ohne den Zugverkehr zu behindern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccf1aac3-a5b7-41d7-9c9a-6af875b420b3",
                                "sense_id": "e4d2b323-0d85-3076-a7a7-cb3e0e524f5e",
                                "text": "„Die Stadtwerke Herford führen ab Dienstag, 15. April, Wartungsarbeiten an der Trinkwasserleitung an der Bahnunterführung in Schweicheln-Bermbeck durch.“"
                            },
                            {
                                "example_id": "fe93f044-b60a-4a1a-855e-709d297268cf",
                                "sense_id": "e4d2b323-0d85-3076-a7a7-cb3e0e524f5e",
                                "text": "„Die Bahnunterführung war – trotz Feuerwehr – wieder unpassierbar, und das Sperrschild in der Ackerstraße stand immer noch.“"
                            },
                            {
                                "example_id": "3a20785a-98b4-4fb2-b5b9-f2bc5c751f22",
                                "sense_id": "e4d2b323-0d85-3076-a7a7-cb3e0e524f5e",
                                "text": "„Am Ortseingang nach der Bahnunterführung biegen Sie scharf links ab und ereichen den Parkplatz am Bahnhof.“"
                            },
                            {
                                "example_id": "e62cc9db-0117-4f75-a24f-2e9b3bbe07c8",
                                "sense_id": "e4d2b323-0d85-3076-a7a7-cb3e0e524f5e",
                                "text": "„Ein Problem bleibt dann immer noch die wirklich gefahrvolle, unübersichtliche und viel zu enge Bahnunterführung.“"
                            },
                            {
                                "example_id": "559364f4-3c18-4ef1-bd46-64a6b1643cf2",
                                "sense_id": "e4d2b323-0d85-3076-a7a7-cb3e0e524f5e",
                                "text": "„Außerdem sei die Stadtverwaltung nach wie vor in Kontakt mit der Deutschen Bahn hinsichtlich einer möglichen Erweiterung der Bahnunterführung zwischen der Straße ‚Am Güterbahnhof‘ und der Saarbrücker Straße.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7642c931-6e62-4ee6-8aa1-7aacc038b325",
                        "source_entry_id": "794776fa-748b-3e70-be1d-daa597fe01d8",
                        "source_sense_id": "e4d2b323-0d85-3076-a7a7-cb3e0e524f5e",
