                    }
                ],
                "translations": [
                    {
                        "translation_id": "f1cf7337-e769-4062-95fb-d1ef15c62a77",
                        "source_entry_id": "617db0b9-5a00-349a-a6aa-be1dd035bf4b",
                        "source_sense_id": "e5c87278-4454-3579-88ac-a7093907a306",
                        "target_lang_word": "significantly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "significantly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e058acdd-93de-319a-80f0-073a3b0ebb00",
                                        "entry_id": "98a5be25-20bf-306c-8c46-5447f552659f",
                                        "glosses": [
                                            "In a significant manner or to a significant extent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad786888-7fd3-4d14-840e-6a4f0198b6da",
                                                "sense_id": "e058acdd-93de-319a-80f0-073a3b0ebb00",
                                                "text": "Irene's English significantly improved after taking a year out in Ireland."
                                            },
                                            {
                                                "example_id": "4084213f-8976-46a7-b30c-aeac57cecf9c",
                                                "sense_id": "e058acdd-93de-319a-80f0-073a3b0ebb00",
                                                "text": "The quality of life is significantly higher than it was twenty years ago."
                                            },
                                            {
                                                "example_id": "bf06dc41-3314-4bf5-a1d1-850d35c9468f",
                                                "sense_id": "e058acdd-93de-319a-80f0-073a3b0ebb00",
                                                "text": "It's the water that makes this area famous. […] That water is still being used to supply Blackford's two dominant industries, Tullibardine whisky distillery to the south of the village and, more significantly, Highland Spring Group's bottling plant to the north."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "edd2aa91-c74c-4833-a185-d2691a3cf71f",
                        "source_entry_id": "617db0b9-5a00-349a-a6aa-be1dd035bf4b",
                        "source_sense_id": "e5c87278-4454-3579-88ac-a7093907a306",
                        "target_lang_word": "extremely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "extremely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "735dbaf9-ff44-38d1-825e-8aeb3f3e87e4",
                                        "entry_id": "e5bf5b87-4cf8-366d-9216-d93d791e806f",
                                        "glosses": [
                                            "To an extreme degree."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7b11ba7-cbeb-4ade-a797-8de651f7a86b",
                                                "sense_id": "735dbaf9-ff44-38d1-825e-8aeb3f3e87e4",
                                                "text": "The National Center for Health Statistics' latest data indicate that quintuplets are extremely rare, with 66 reported sets of five or more babies in 2013."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2f4b882f-842f-4d88-a1d6-7275a8e5cea4",
                        "source_entry_id": "617db0b9-5a00-349a-a6aa-be1dd035bf4b",
                        "source_sense_id": "0cc77e5f-a1f5-3c55-9a69-fe5022454cf3",
                        "target_lang_word": "eminently",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eminently",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "60f196f1-af95-3478-8e10-4f481443fb91",
                                        "entry_id": "2c446332-53e6-3bf2-b551-11036ddbfcf7",
                                        "glosses": [
                                            "In an eminent or prominent manner."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1acde108-7997-3fd7-87e7-1068b1fea638",
                                        "entry_id": "2c446332-53e6-3bf2-b551-11036ddbfcf7",
                                        "glosses": [
                                            "To a great degree; notably; highly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1551d64c-33b9-4301-a42f-bd0f0cc68901",
                                                "sense_id": "1acde108-7997-3fd7-87e7-1068b1fea638",
                                                "text": "Everyone supported the nominee because she was eminently qualified."
                                            },
                                            {
                                                "example_id": "1d23e994-fe1d-4c16-94d2-f3c200a883b7",
                                                "sense_id": "1acde108-7997-3fd7-87e7-1068b1fea638",
                                                "text": "Here Mr. Bandparts at once proceeded to put the position as between master and pupil on an eminently sound footing, clearly exulting in this opportunity of exercising some baritone oratory that had suffered a period of disuse.",
                                                "translation": "Redheap",
                                                "english": "Redheap"
                                            },
                                            {
                                                "example_id": "a616a2a0-19ad-4907-9379-94c77f49ba2c",
                                                "sense_id": "1acde108-7997-3fd7-87e7-1068b1fea638",
                                                "text": "So while Ralph generally seems to inhabit a different, more glorious and joyful universe than everyone else here his yearning and heartbreak are eminently relateable."
                                            },
                                            {
                                                "example_id": "8afd0767-d7f7-4c1a-a70b-32259cde3b59",
                                                "sense_id": "1acde108-7997-3fd7-87e7-1068b1fea638",
                                                "text": "There's far more than just hot dogs to feast on too. The pizzas—gigantic, floppy, with a hyperreal waxy sheen—are mythic. They arrive exclusively in cheese, pepperoni, or supreme—the holy trinity—and will run you an eminently affordable $1.99 for a ridiculously huge wedge-shaped slice."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "22b9bf77-6281-4998-ab63-e3da9008b609",
                        "source_entry_id": "617db0b9-5a00-349a-a6aa-be1dd035bf4b",
                        "source_sense_id": "0cc77e5f-a1f5-3c55-9a69-fe5022454cf3",
                        "target_lang_word": "éminemment",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "éminemment",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a6a762c0-8981-38ff-983c-a7488915bf6e",
                                        "entry_id": "b8df2a6a-e7d2-3ccf-b9b4-3fbacb50dd3d",
                                        "glosses": [
                                            "À un degré éminent ; au plus haut point."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46c16835-6ed5-48f9-9c60-aa80ef0b5c26",
                                                "sense_id": "a6a762c0-8981-38ff-983c-a7488915bf6e",
                                                "text": "Quand ces qualités [oratoires] ne se trouveront pas éminemment dans un homme, il ne laissera pas de faire de bons discours, pourvu que […]"
                                            },
                                            {
                                                "example_id": "8c1bdd8e-df93-451b-a22f-63833ee88513",
                                                "sense_id": "a6a762c0-8981-38ff-983c-a7488915bf6e",
                                                "text": "L'air pur et vivifiant de cette île perdue au milieu de l'océan du Nord m'a paru éminemment favorable au déploiement de l'activité humaine ; j'ai été souvent étonné de la vigueur physique que l'on conquiert sous un rude climat et de la somme de travail qu'on y peut accomplir."
                                            },
                                            {
                                                "example_id": "2f1d26d2-f2fa-41ae-8367-d2d0059ae36a",
                                                "sense_id": "a6a762c0-8981-38ff-983c-a7488915bf6e",
                                                "text": "En particulier, cette dernière région, au sol essentiellement calcaire, et où les précipitations annuelles n'atteignent que 55 cm, est éminemment favorable aux espèces subsarmatiques et surtout subméditerranéennes […]."
                                            },
                                            {
                                                "example_id": "2f091f37-d4f1-47bf-9741-91a9ce7aefc5",
                                                "sense_id": "a6a762c0-8981-38ff-983c-a7488915bf6e",
                                                "text": "Dire que le désir était mort serait mentir, tout dans nos rapports était éminemment charnel, et pourtant, je le répète, éminemment pur."
                                            },
                                            {
                                                "example_id": "8cc1adb7-8137-4676-933f-2f96fe527a11",
                                                "sense_id": "a6a762c0-8981-38ff-983c-a7488915bf6e",
                                                "text": "Puis arriva Donald Trump. Mike Pence, comme des dizaines d’autres républicains, fut happé par ce personnage éminemment dangereux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ce68942-d833-3e9d-82e8-2b36d8a4cfca",
                                        "entry_id": "b8df2a6a-e7d2-3ccf-b9b4-3fbacb50dd3d",
                                        "glosses": [
                                            "Se dit par opposition à formellement."
                                        ],
                                        "tags": [
                                            "Scolastique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a67ecabc-7c92-495f-846b-702cb37cbe62",
                                                "sense_id": "4ce68942-d833-3e9d-82e8-2b36d8a4cfca",
                                                "text": "Il est vrai qu’elles [certaines qualités, l’étendue, la figure, la situation et le mouvement] ne sont point formellement en moi, puisque je ne suis qu’une chose qui pense ; mais, parce que ce sont seulement de certains modes de la substance et que je suis moi-même une substance, il semble qu’elles puissent être contenues en moi éminemment,"
                                            },
                                            {
                                                "example_id": "969eb760-d5fb-4fe2-b45f-c1eb43a31571",
                                                "sense_id": "4ce68942-d833-3e9d-82e8-2b36d8a4cfca",
                                                "text": "L’effet est contenu éminemment dans la cause."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "abdd56cd-cf43-40e3-9db2-4d2050be6b36",
                        "source_entry_id": "617db0b9-5a00-349a-a6aa-be1dd035bf4b",
                        "target_lang_word": "notably",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "notably",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e49f09ab-a330-3556-aaca-cd7fe3f4634e",
                                        "entry_id": "25e09929-12a0-3c69-a693-ce4a907dbdce",
                                        "glosses": [
                                            "As a pointed example; in a notable manner."
                                        ],
                                        "tags": [
                                            "focus"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9624f19-cb95-4c7c-9ab7-f960946c8ed3",
                                                "sense_id": "e49f09ab-a330-3556-aaca-cd7fe3f4634e",
                                                "text": "“Earth Two,” a new series by writer James Robinson and artist Nicola Scott, reintroduces the concept by putting a new spin on the original versions of characters like the Green Lantern, the Flash and Superman that diverges notably from the past several decades of DC lore."
                                            },
                                            {
                                                "example_id": "2dc511e9-8eee-44c5-abe1-f25f6236d954",
                                                "sense_id": "e49f09ab-a330-3556-aaca-cd7fe3f4634e",
                                                "text": "Allport's decision in 1872 to abolish Second Class on the Midland and effectively upgrade Third Class to the standards of Second, most notably with upholstered seating, sent shockwaves through the Victorian railway."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eea980cc-3012-45f0-8bff-d57e719d94a5",
                        "source_entry_id": "617db0b9-5a00-349a-a6aa-be1dd035bf4b",
                        "target_lang_word": "notablement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "notablement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "78c8bf10-11f8-3cd9-9821-dbf0fd48d720",
                                        "entry_id": "f06a60d3-732b-39b0-a17a-b4a66b7a7146",
                                        "glosses": [
                                            "D’une manière notable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5bc2cf02-5436-4dbb-87ed-4968c0efb999",
                                                "sense_id": "78c8bf10-11f8-3cd9-9821-dbf0fd48d720",
                                                "text": "Cette action contribua notablement à sa gloire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb3a26df-b12d-3f95-bbba-8df8e85aca06",
                                        "entry_id": "f06a60d3-732b-39b0-a17a-b4a66b7a7146",
                                        "glosses": [
                                            "Significativement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f69c46f7-68f8-4b00-8b4d-00c61813e64a",
                                                "sense_id": "bb3a26df-b12d-3f95-bbba-8df8e85aca06",
                                                "text": "Le bassin entier de la Brenne, à l'ouest de la route de Châteauroux à Lothiers, est notablement plus bas que les plateaux correspondants des bords de l'Indre ou de la Creuse."
                                            },
                                            {
                                                "example_id": "7824e206-1a0e-44b1-932a-b79b2aa45e90",
                                                "sense_id": "bb3a26df-b12d-3f95-bbba-8df8e85aca06",
                                                "text": "Nous avons eu entre les mains des sextants japonais, construits en métal léger, pendant la guerre, qui étaient notablement rongés par les embruns. De telles défectuosités ne se produisent plus maintenant, grâce à des parkérisations ou à des traitements très soignés du métal."
                                            },
                                            {
                                                "example_id": "7aa06fa3-720a-4c01-9e6a-1655809438a9",
                                                "sense_id": "bb3a26df-b12d-3f95-bbba-8df8e85aca06",
                                                "text": "À cause de la diffraction, on ne peut pas diaphragmer notablement un objectif formant ses images sur un petit capteur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
