        "fr-extract.jsonl": [
            {
                "entry_id": "3e58f4c1-4b8f-3872-bae5-31c38a15987b",
                "word": "débarquement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4d1725eb-1339-4c42-9afd-1b96e97cc19b",
                        "entry_id": "3e58f4c1-4b8f-3872-bae5-31c38a15987b",
                        "tags": [
                            "plural"
                        ],
                        "form": "débarquements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "597d8807-1de9-3c90-9c71-dbc642f26fe5",
                        "entry_id": "3e58f4c1-4b8f-3872-bae5-31c38a15987b",
                        "glosses": [
                            "Action de débarquer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31401396-4ecb-4485-83e0-372b74bfa401",
                                "sense_id": "597d8807-1de9-3c90-9c71-dbc642f26fe5",
                                "text": "L’embarquement et le débarquement s'opèrent à l'aide de barcasses d'un faible tirant d’eau, pouvant pénétrer dans une petite anse où les vagues viennent mourir au pied même des murs de la ville."
                            },
                            {
                                "example_id": "d3f9a62e-2808-4a6c-8953-a0e2c3492291",
                                "sense_id": "597d8807-1de9-3c90-9c71-dbc642f26fe5",
                                "text": "Lorsque nous arrivâmes à destination, la mer trop houleuse nous interdisait toute nouvelle tentative de débarquement."
                            },
                            {
                                "example_id": "52cd8168-df9b-4ce8-a594-b6272363e893",
                                "sense_id": "597d8807-1de9-3c90-9c71-dbc642f26fe5",
                                "text": "Le débarquement d'une automobile à quai était une manœuvre peu familière aux employés de la petite station, et le train s'attardait, et Psyché devenait impatiente."
                            },
                            {
                                "example_id": "31eacf5f-4490-4b6b-9de1-56629a4b5c2c",
                                "sense_id": "597d8807-1de9-3c90-9c71-dbc642f26fe5",
                                "text": "La période qui s'étend entre le débarquement japonais à l’embouchure du Wang-poo et le bombardement de Nagasaki tut pour la Chine particulièrement fertile en catastrophes."
                            },
                            {
                                "example_id": "6c21ac96-18f2-490c-a5c9-0d7dbb81515f",
                                "sense_id": "597d8807-1de9-3c90-9c71-dbc642f26fe5",
                                "text": "Les voisins continuaient d’acheter quelques légumes et apportaient aussi des nouvelles de la guerre. Mais la guerre ne les tira vraiment de leur solitude que le jour où ils eurent la certitude que le débarquement des Alliés en Normandie avait réussi."
                            }
                        ]
                    },
                    {
                        "sense_id": "9c86840f-f85a-3e93-8910-775f5de99121",
                        "entry_id": "3e58f4c1-4b8f-3872-bae5-31c38a15987b",
                        "glosses": [
                            "Action d’une personne qui débarque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5ba73ca-439d-49ef-8ecb-8b7c0ba79573",
                                "sense_id": "9c86840f-f85a-3e93-8910-775f5de99121",
                                "text": "Quand Napoléon III fut empoigné à Boulogne pour avoir donné une seconde représentation du débarquement à Cannes, on le jeta au cachot et on l'emmena à Paris sans lui donner le temps de changer de chemise."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bbf0f062-75f2-4b0e-a634-049a74bf06ff",
                        "source_entry_id": "3e58f4c1-4b8f-3872-bae5-31c38a15987b",
                        "target_lang_word": "Landung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Landung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a5f3ac1c-1393-3053-9d6d-5cf334b8d0d9",
                                        "entry_id": "9611c918-3276-34a5-9745-7eeda8ca4d11",
                                        "glosses": [
                                            "Aufsetzen eines Luft- oder Raumfahrzeuges"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b8cb3e8-6324-4c87-adc3-00ea7d0e6533",
                                                "sense_id": "a5f3ac1c-1393-3053-9d6d-5cf334b8d0d9",
                                                "text": "Der Pilot führte eine Landung durch."
                                            },
                                            {
                                                "example_id": "6c349e6c-e65f-4343-ad68-9a80e8b67b90",
                                                "sense_id": "a5f3ac1c-1393-3053-9d6d-5cf334b8d0d9",
                                                "text": "„Die Landung, der technisch anspruchsvollste Teil eines Drachenflugs, wird nicht mehr geschildert, und der Leser fragt sich, wie der psychisch und wohl auch flugtechnisch total überforderte Mann wohl gelandet sein mag.“"
                                            },
                                            {
                                                "example_id": "120feb51-370e-4407-a59c-c2a7271ebb7a",
                                                "sense_id": "a5f3ac1c-1393-3053-9d6d-5cf334b8d0d9",
                                                "text": "Der Zeppelin ging bei der Landung in Flammen auf."
                                            },
                                            {
                                                "example_id": "9bbb5418-5893-4c0d-abe8-39fc95d69c33",
                                                "sense_id": "a5f3ac1c-1393-3053-9d6d-5cf334b8d0d9",
                                                "text": "Zum Traum vom Fliegen gehört auch das sichere Landen: Doch das will dem US-Raumfahrtunternehmen SpaceX nicht recht gelingen. Wieder ging die Trägerrakete einer Weltraumkapsel bei der Landung zu Bruch."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c51309a5-f0c4-34c6-a950-73e7e96c9e73",
                                        "entry_id": "9611c918-3276-34a5-9745-7eeda8ca4d11",
                                        "glosses": [
                                            "Eintreffen von Truppen von See her"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de693618-1d6c-41ea-ade6-1ab574c3044b",
                                                "sense_id": "c51309a5-f0c4-34c6-a950-73e7e96c9e73",
                                                "text": "Die Landung der Alliierten in der Normandie war ein entscheidender Schritt zur Niederlage des Deutschen Reiches."
                                            },
                                            {
                                                "example_id": "dc29e06b-2102-43c2-b36d-b3ebba4bde09",
                                                "sense_id": "c51309a5-f0c4-34c6-a950-73e7e96c9e73",
                                                "text": "„Arabische Hirten hatten unsere Landung beobachtet und natürlich die Engländer alarmiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b00e1570-070a-38c0-b72e-513e1166b5c5",
                                        "entry_id": "9611c918-3276-34a5-9745-7eeda8ca4d11",
                                        "glosses": [
                                            "Abschwung der Wirtschaft, Rückgang der Konjunktur"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a883d3bc-c1dc-467e-a4bd-2b819decd45b",
                                                "sense_id": "b00e1570-070a-38c0-b72e-513e1166b5c5",
                                                "text": "Nach diesem Höhenflug war die Landung in den beiden vergangenen Jahren umso härter: 2011 wuchs die Wirtschaft [Brasiliens] nur noch um 2,5 Prozent. 2012 kam es sogar noch schlimmer. Die anfangs guten Prognosen korrigierte die Regierung im Laufe des Jahres immer wieder nach unten, am Ende war ein einziges Prozent übrig."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6c0400dd-cf63-4d23-b7fe-868cffa002b6",
                        "source_entry_id": "3e58f4c1-4b8f-3872-bae5-31c38a15987b",
