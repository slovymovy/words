                ],
                "senses": [
                    {
                        "sense_id": "1979ba06-15e4-3806-8d2e-2757d44a1aed",
                        "entry_id": "4e36b132-5eb7-3cc4-a051-2b20dd73c7c8",
                        "glosses": [
                            "An indigenous person; a native."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "456c65c0-fea3-43dd-9c38-18167ce4fe09",
                                "sense_id": "1979ba06-15e4-3806-8d2e-2757d44a1aed",
                                "text": "The price for all this chutzpah was that Malraux then had to take up the cause of the colonial indigenes as if it really mattered to him."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "98b13f79-1c72-43d8-b36a-e7b8d81193c7",
                        "source_entry_id": "4e36b132-5eb7-3cc4-a051-2b20dd73c7c8",
                        "source_sense_id": "1979ba06-15e4-3806-8d2e-2757d44a1aed",
                        "source_sense_description": "a native",
                        "target_lang_word": "Indigener",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Indigener",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a482d376-a792-3232-8b88-716cf7c0ffb6",
                                        "entry_id": "28b10ba5-f01a-3703-b487-66c6981ee3e7",
                                        "glosses": [
                                            "Person, die in einem bestimmten Gebiet geboren, in einem bestimmten Gebiet beheimatet ist"
                                        ],
                                        "tags": [
                                            "jargon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98ec47d5-77d2-470d-a0b7-421261ebf762",
                                                "sense_id": "a482d376-a792-3232-8b88-716cf7c0ffb6",
                                                "text": "„Vor dem kolonialen Gesetz galten Indigene als Minderjährige.“"
                                            },
                                            {
                                                "example_id": "003698f3-9867-4050-aefa-f6ecd99df23d",
                                                "sense_id": "a482d376-a792-3232-8b88-716cf7c0ffb6",
                                                "text": "„Die Geschichte zeigt: Wie Deutsche auf sie blickten, sagte schon immer mehr darüber aus, wer die Deutschen sein wollten, und wenig darüber, wer die Indigenen wirklich waren.“"
                                            },
                                            {
                                                "example_id": "eecf7a48-387c-421e-ae04-76f2bf0937da",
                                                "sense_id": "a482d376-a792-3232-8b88-716cf7c0ffb6",
                                                "text": "„Zu ihrem Erstaunen zeichneten sich in den Ablagerungen zwar sehr deutlich die Rodungen und der Landbau der europäischen Siedler ab, ein ökologischer Fußabdruck der Indigenen fand sich jedoch nicht.“"
                                            },
                                            {
                                                "example_id": "83cc9fd5-ac0c-40ce-a3fc-f44bc341d070",
                                                "sense_id": "a482d376-a792-3232-8b88-716cf7c0ffb6",
                                                "text": "„Weil seine Reise wirtschaftlich ein Desaster zu werden drohte, versklavte sein Eroberungstrupp Indigene und verkaufte sie auf den karibischen Märkten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
