                "word": "Marengo",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "82f4cbf3-4be6-3f57-b6b5-9e42b912c646",
                        "entry_id": "efdb48f5-56f1-3edc-81f2-4c4b83758db0",
                        "glosses": [
                            "Nom de famille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50fc1e64-2202-43f2-9859-3f1531d4565e",
                                "sense_id": "82f4cbf3-4be6-3f57-b6b5-9e42b912c646",
                                "text": "Le maire de Royan Patrick Marengo a récemment appris que la Ville de Rochefort comptait de nouveau installer une patinoire cet hiver après l’épisode de flambée des coûts de l’énergie."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "0937b5b9-0ca7-3bb4-b521-96e6ca3590b6",
                "word": "Marengo",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a418118e-208b-3c73-a1f3-10b889613245",
                        "entry_id": "0937b5b9-0ca7-3bb4-b521-96e6ca3590b6",
                        "glosses": [
                            "Village du Piémont italien site d’une bataille napoléonienne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7378874-f635-4def-b090-fffc27a14cab",
                                "sense_id": "a418118e-208b-3c73-a1f3-10b889613245",
                                "text": "Le 14, à l’aube du jour, les Autrichiens défilèrent sur les trois ponts de la Bormida, et attaquèrent avec fureur le village de Marengo. La résistance fut opiniâtre et longue."
                            }
                        ]
                    },
                    {
                        "sense_id": "b67a9cbc-8cfa-3e37-a498-483d2c52db3c",
                        "entry_id": "0937b5b9-0ca7-3bb4-b521-96e6ca3590b6",
                        "glosses": [
                            "Ancien département français d’Italie ayant existé de 1802 à 1814 et dont le chef-lieu était Alexandrie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cd2a5b2-9990-4a83-bf77-67f435d2922d",
                                "sense_id": "b67a9cbc-8cfa-3e37-a498-483d2c52db3c",
                                "text": "Le Sol du département de Marengo, par sa situation au pied des montagnes de la Ligurie, est très-froid, et par conséquent peu convenable aux productions du Midi."
                            }
                        ]
                    },
                    {
                        "sense_id": "4b86a6f9-4d19-3a6b-ba0c-d6236afe30d6",
                        "entry_id": "0937b5b9-0ca7-3bb4-b521-96e6ca3590b6",
                        "glosses": [
                            "Ancien nom de Hadjout, pendant la colonisation de l’Algérie française."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76d521e4-0fe1-4a67-9451-a5890cee8605",
                                "sense_id": "4b86a6f9-4d19-3a6b-ba0c-d6236afe30d6",
                                "text": "M’ma vit donc dans une sorte de bourgade, Hadjout, ex-Marengo, à soixante-dix kilomètres de la capitale."
                            }
                        ]
                    }
                ],
