                        ],
                        "form": "ademtochten"
                    },
                    {
                        "form_id": "14d53143-16f5-43cb-8623-254248bafdb2",
                        "entry_id": "665e1843-91fc-3909-adf1-77bbeae23d54",
                        "tags": [
                            "diminutive",
                            "singular"
                        ],
                        "form": "ademtochtje"
                    },
                    {
                        "form_id": "32a398d4-f7bc-40c8-8a15-ae7d6cfe6864",
                        "entry_id": "665e1843-91fc-3909-adf1-77bbeae23d54",
                        "tags": [
                            "diminutive",
                            "plural"
                        ],
                        "form": "ademtochtjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "221e95bd-dac0-3b3c-a60d-f985fa3ba4f1",
                        "entry_id": "665e1843-91fc-3909-adf1-77bbeae23d54",
                        "glosses": [
                            "één cyclus van in- en uitademing"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16b0e18c-6626-4ce6-8abb-50bbecbc89ae",
                                "sense_id": "221e95bd-dac0-3b3c-a60d-f985fa3ba4f1",
                                "text": "Ze zat achter afgeplakt glas, in een aparte cabine, op meters afstand van de broer die haar jarenlang zo in de greep hield. Toch was de spanning bij Sonja Holleeder duidelijk hoorbaar in iedere trillende ademtocht."
                            },
                            {
                                "example_id": "3ddaaa0f-efe7-40a7-861f-02244db7ce53",
                                "sense_id": "221e95bd-dac0-3b3c-a60d-f985fa3ba4f1",
                                "text": "Ze vulde haar longen om in één lange ademtocht te zeggen waar het op stond."
                            },
                            {
                                "example_id": "f9367c3c-3a4d-4c09-9503-c54fbfb2a1e1",
                                "sense_id": "221e95bd-dac0-3b3c-a60d-f985fa3ba4f1",
                                "text": "En dan galmde het zegeningen uit de monden van de bedelaars, die de nonnen zuinige glimlachjes ontlokten. Zo staat de bibliothecaresse erbij, hoort de verhalen aan, die ze al lijkt te kennen, met de piëteit van een non die, al staat ze nog zo in de ademtocht van de duivel, toch barmhartigheid kan schenken aan deze armzalige, gevallen ziel."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ee1c3339-d682-4c1d-b884-3f2602ce7402",
                        "source_entry_id": "665e1843-91fc-3909-adf1-77bbeae23d54",
                        "source_sense_id": "221e95bd-dac0-3b3c-a60d-f985fa3ba4f1",
                        "target_lang_word": "respiration",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "respiration",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f6bedf16-4d54-3f6f-ba93-a1d1206068df",
                                        "entry_id": "199170ba-6d4e-3db7-9a73-7fe59d3660c9",
                                        "glosses": [
                                            "The process of inhaling and exhaling; breathing, breath."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2d7e0e0-511e-44ac-ac55-e0b146de7beb",
                                                "sense_id": "f6bedf16-4d54-3f6f-ba93-a1d1206068df",
                                                "text": "In the dead state all is apparently without motion. No agent within indicates design, intelligence, or foresight: there is no respiration; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0af62c63-e597-3e18-a2ae-b6271a5ee6c6",
                                        "entry_id": "199170ba-6d4e-3db7-9a73-7fe59d3660c9",
                                        "glosses": [
                                            "An act of breathing; a breath."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9ab12ef-237e-497f-a6ab-ff6ebd37920b",
                                                "sense_id": "0af62c63-e597-3e18-a2ae-b6271a5ee6c6",
                                                "text": "Gowan snored, each respiration choking to a huddle fall, as though he would never breathe again."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f57a80d3-3f13-39da-985c-b9ea147eb45e",
                                        "entry_id": "199170ba-6d4e-3db7-9a73-7fe59d3660c9",
                                        "glosses": [
                                            "Any similar process in an organism that lacks lungs that exchanges gases with its environment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "efe6da05-eb14-33b2-a673-ff6c5f2e72bc",
                                        "entry_id": "199170ba-6d4e-3db7-9a73-7fe59d3660c9",
                                        "glosses": [
                                            "The process by which cells obtain chemical energy by the consumption of oxygen and the release of carbon dioxide."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "69f3372c-3506-4c00-94ff-501c2946c814",
                        "source_entry_id": "665e1843-91fc-3909-adf1-77bbeae23d54",
                        "source_sense_id": "221e95bd-dac0-3b3c-a60d-f985fa3ba4f1",
                        "target_lang_word": "inhalation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inhalation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "35dabf89-0479-3146-9913-ec85c1ae5f0a",
                                        "entry_id": "30e7ae23-f201-35cf-9d0a-9f84d2577b1f",
                                        "glosses": [
                                            "The act of inhaling; inbreathing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26cf8290-0c65-462c-a703-722ccf30b930",
                                                "sense_id": "35dabf89-0479-3146-9913-ec85c1ae5f0a",
                                                "text": "On Ickerson's part, with the help of \"a few post-jentacular inhalations,\" as he in his colossal manner was pleased to phrase it, \"from that fragrant weed which so propitiates clearness of thought, and tends to promote equanimity in action.\""
                                            },
                                            {
                                                "example_id": "905edb40-3921-4a6b-a7e1-30dd86bc31df",
                                                "sense_id": "35dabf89-0479-3146-9913-ec85c1ae5f0a",
                                                "text": "The girl stooped to pluck a rose, and as she bent over it, her profile was clearly outlined. She held the flower to her face with a long-drawn inhalation, then went up the steps, crossed the piazza, opened the door without knocking, and entered the house with the air of one thoroughly at home."
                                            },
                                            {
                                                "example_id": "d71b646a-6206-4bec-957b-884d3b413b17",
                                                "sense_id": "35dabf89-0479-3146-9913-ec85c1ae5f0a",
                                                "text": "The Invisible Killer Dihydrogen monoxide is colorless, odorless, tasteless, and kills uncounted thousands of people every year. Most of these deaths are caused by accidental inhalation of DHMO, but the dangers of dihydrogen monoxide do not end there."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a6224c3-6b98-3dad-9f7f-dc8eb50b0df3",
                                        "entry_id": "30e7ae23-f201-35cf-9d0a-9f84d2577b1f",
                                        "glosses": [
                                            "The substance (medicament) which is inhaled."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "66976ff5-9e84-4f16-9383-8736fff88fa0",
                        "source_entry_id": "665e1843-91fc-3909-adf1-77bbeae23d54",
                        "source_sense_id": "221e95bd-dac0-3b3c-a60d-f985fa3ba4f1",
                        "target_lang_word": "breath",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "breath",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5ebe9eef-9545-37a6-936a-2363c0aaef6e",
                                        "entry_id": "b510653d-3211-3ed2-bc31-0708ac56253f",
                                        "glosses": [
                                            "The act or process of breathing."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd6218fa-ccde-467d-ac0c-efa36401edf1",
                                                "sense_id": "5ebe9eef-9545-37a6-936a-2363c0aaef6e",
                                                "text": "I could hear the breath of the runner behind me."
                                            },
                                            {
                                                "example_id": "feff7904-7709-4525-88f2-6f7868e1794c",
                                                "sense_id": "5ebe9eef-9545-37a6-936a-2363c0aaef6e",
                                                "text": "The child's breath came quickly and unevenly."
                                            },
                                            {
                                                "example_id": "cb2aa3c5-0106-4ff1-919f-06af6198f802",
                                                "sense_id": "5ebe9eef-9545-37a6-936a-2363c0aaef6e",
                                                "text": "Breezes blowing from beds of iris quickened her breath with their perfume; she saw the tufted lilacs sway in the wind, and the streamers of mauve-tinted wistaria swinging, all a-glisten with golden bees; she saw a crimson cardinal winging through the foliage, and amorous tanagers flashing like scarlet flames athwart the pines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa0873f5-89e9-3aae-a8aa-5f1e30325ec9",
                                        "entry_id": "b510653d-3211-3ed2-bc31-0708ac56253f",
                                        "glosses": [
                                            "A single act of breathing in or out; a breathing of air."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ee46283-9a04-49e5-9162-50831bb17054",
                                                "sense_id": "aa0873f5-89e9-3aae-a8aa-5f1e30325ec9",
                                                "text": "I took a deep breath and started the test."
                                            },
                                            {
                                                "example_id": "569c9774-56ae-48d1-a81f-45f0e9bc6786",
                                                "sense_id": "aa0873f5-89e9-3aae-a8aa-5f1e30325ec9",
                                                "text": "Serene, smiling, enigmatic, she faced him with no fear whatever showing in her dark eyes.[…]She put back a truant curl from her forehead where it had sought egress to the world, and looked him full in the face now, drawing a deep breath which caused the round of her bosom to lift the lace at her throat."
                                            },
                                            {
                                                "example_id": "826000de-34fc-4ab5-b455-b58d9f382bfd",
                                                "sense_id": "aa0873f5-89e9-3aae-a8aa-5f1e30325ec9",
                                                "text": "She knew from avalanche safety courses that outstretched hands might puncture the ice surface and alert rescuers. She knew that if victims ended up buried under the snow, cupped hands in front of the face could provide a small pocket of air for the mouth and nose. Without it, the first breaths could create a suffocating ice mask."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1a0d459-fdef-3e0e-9d84-82fab7717c3b",
                                        "entry_id": "b510653d-3211-3ed2-bc31-0708ac56253f",
                                        "glosses": [
                                            "Air expelled from the lungs."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2b4336e-d13d-4da6-b840-503ab5d62433",
                                                "sense_id": "b1a0d459-fdef-3e0e-9d84-82fab7717c3b",
                                                "text": "I could feel the runner's breath on my shoulder."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56b6de6f-f7a9-3b79-80dc-b9bab3e0a059",
                                        "entry_id": "b510653d-3211-3ed2-bc31-0708ac56253f",
                                        "glosses": [
                                            "A rest or pause."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e17fd287-221e-493a-8f36-1ba79c2b3e93",
                                                "sense_id": "56b6de6f-f7a9-3b79-80dc-b9bab3e0a059",
                                                "text": "Let's stop for a breath when we get to the top of the hill."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd2dd2a7-ca83-3738-8d53-b8e08e7a8c53",
                                        "entry_id": "b510653d-3211-3ed2-bc31-0708ac56253f",
                                        "glosses": [
                                            "A small amount of something, such as wind, or common sense."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91a01581-235f-4cc1-ac92-2ce08085327b",
                                                "sense_id": "dd2dd2a7-ca83-3738-8d53-b8e08e7a8c53",
                                                "text": "Even with all the windows open, there is hardly a breath of air in here."
                                            },
                                            {
                                                "example_id": "98a75ab3-006f-4574-8f92-3908d0e57d3f",
                                                "sense_id": "dd2dd2a7-ca83-3738-8d53-b8e08e7a8c53",
                                                "text": "If she had a breath of common sense, she would never have spoken to the man in the first place."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "812450a1-8250-3e3e-9b8e-b06c05073826",
                                        "entry_id": "b510653d-3211-3ed2-bc31-0708ac56253f",
                                        "glosses": [
                                            "Fragrance; exhalation; odor; perfume."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f13ee10d-fb97-4e1c-ba59-b2b9c2c7bae9",
                                                "sense_id": "812450a1-8250-3e3e-9b8e-b06c05073826",
                                                "text": "Autumn[…]Who wakenest with thy balmy breath"
                                            },
                                            {
                                                "example_id": "a20474eb-9447-44ab-b8c0-bd47e00d9a51",
                                                "sense_id": "812450a1-8250-3e3e-9b8e-b06c05073826",
                                                "text": "the breath of flowers"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3089675-1a0a-37d5-b363-fa9a0526a5be",
                                        "entry_id": "b510653d-3211-3ed2-bc31-0708ac56253f",
                                        "glosses": [
                                            "Gentle exercise, causing a quicker respiration."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d550f19-ccf6-4fd8-97f4-2467f5ca8b79",
                                                "sense_id": "d3089675-1a0a-37d5-b363-fa9a0526a5be",
                                                "text": "an after dinner's breath"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "breath",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3f11117b-7702-3266-a950-f912a4692b98",
