                    "frequency": "Middle",
                    "semantic_group_id": "sport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'arbitre a adressé un <w>avertissement</w> au défenseur après une faute grossière."
                        },
                        {
                            "text": "Ce joueur a écopé d'un second <w>avertissement</w> synonyme d'expulsion directe."
