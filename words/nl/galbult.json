{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9068b88c-e950-3d1c-87ec-6b37fb6a73dd",
                    "sense_definition": "Een in korte tijd ontwikkelende, vaak heftig jeukende uitslag van de huid, die begint met rode vlekken en daarna in verdikte, bleke plekken kan overgaan.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "medische_symptomen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na het eten van aardbeien kreeg hij plotseling last van jeukende <w>galbulten</w> op zijn armen.",
                            "target_lang_translations": {
                                "en": "After eating strawberries, he suddenly suffered from itchy <w>hives</w> on his arms."
                            }
                        },
                        {
                            "text": "De arts legde uit dat een <w>galbult</w> een allergische reactie van de huid is.",
                            "target_lang_translations": {
                                "en": "The doctor explained that a <w>hive</w> is an allergic reaction of the skin."
                            }
                        }
                    ],
                    "synonyms": [
                        "netelroos"
                    ],
                    "common_phrases": [
                        "last van galbulten",
                        "jeukende galbulten"
                    ],
                    "target_lang_definitions": {
                        "en": "A rapidly developing, often severely itchy skin rash that starts with red spots and can progress to thickened, pale patches."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hives",
                                "target_lang_sense_clarification": "common term for itchy, swollen red bumps on the skin"
                            },
                            {
                                "target_lang_word": "urticaria",
                                "target_lang_sense_clarification": "medical term for hives"
                            },
                            {
                                "target_lang_word": "nettle-rash",
                                "target_lang_sense_clarification": "less common term for hives"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f3315fb-4113-36e4-aab5-1649ac5b1c51",
                    "sense_definition": "Ergens figuurlijk een sterke irritatie of allergische reactie van krijgen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "irritatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik krijg echt <w>galbulten</w> van die constante bureaucratie op het werk.",
                            "target_lang_translations": {
                                "en": "I seriously <w>break out in hives</w> from that constant bureaucracy at work."
                            }
                        },
                        {
                            "text": "Zij krijgt direct <w>galbulten</w> als mensen hun afspraken niet nakomen.",
                            "target_lang_translations": {
                                "en": "She immediately <w>gets hives</w> when people do not keep their appointments."
                            }
                        }
                    ],
                    "common_phrases": [
                        "galbulten krijgen van"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used figuratively to express strong irritation"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To experience strong irritation or a figurative allergic reaction to something."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to break out in hives",
                                "target_lang_sense_clarification": "figurative expression of extreme irritation"
                            },
                            {
                                "target_lang_word": "to get hives",
                                "target_lang_sense_clarification": "figurative expression of extreme irritation"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}