                "senses": [
                    {
                        "sense_id": "f2711a40-b9d2-375a-9375-e72abfe9fdd4",
                        "entry_id": "6d91e135-1fe4-3053-a2b7-01a2d0cd5e55",
                        "glosses": [
                            "mający dwa garby (najczęściej o wielbłądzie)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18c94867-b380-4e5b-bfc1-715e374b1257",
                                "sense_id": "f2711a40-b9d2-375a-9375-e72abfe9fdd4",
                                "text": "Już otwierałem usta, chcąc go nazwać dwugarbnym wielbłądem, gdy raptem zastanowiła mnie jego wyciągnięta ręka"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "adf2d415-8e90-4bac-adae-926d99651257",
                        "source_entry_id": "6d91e135-1fe4-3053-a2b7-01a2d0cd5e55",
                        "source_sense_id": "f2711a40-b9d2-375a-9375-e72abfe9fdd4",
                        "target_lang_word": "zweihöckerig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
