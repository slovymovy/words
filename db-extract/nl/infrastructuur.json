                                    },
                                    {
                                        "sense_id": "226688ca-e66a-319b-8724-c87717ce9107",
                                        "entry_id": "22c0bbc5-badc-33e5-9614-8edaa1e7e5c3",
                                        "glosses": [
                                            "Terrassements ou travaux d’art d’une voie ferrée."
                                        ],
                                        "tags": [],
                                        "examples": [
