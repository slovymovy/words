{
    "word_family": [
        "blur",
        "blurry"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ed87de95-5c1a-39d1-9c98-2f581947b851",
                    "sense_definition": "The present participle and gerund of <w>blur</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy rain was <w>blurring</w> the view through the windshield.",
                            "target_lang_translations": {
                                "ru": "Сильный дождь <w>размывал</w> вид через лобовое стекло."
                            }
                        },
                        {
                            "text": "Tears were <w>blurring</w> her vision as she read the sad letter.",
                            "target_lang_translations": {
                                "ru": "Слезы <w>затуманивали</w> ее зрение, пока она читала грустное письмо."
                            }
                        }
                    ],
                    "common_phrases": [
                        "blurring the lines",
                        "blurring the distinction"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс делания чего-либо нечетким, расплывчатым или менее ясным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "размывание",
                                "target_lang_sense_clarification": "процесс потери четкости контуров"
                            },
                            {
                                "target_lang_word": "затуманивание",
                                "target_lang_sense_clarification": "потеря ясности зрения или видимости"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ce1b1c56-91fb-39f7-9fc3-61287ada4427",
                    "sense_definition": "A patch or area that is unclear or indistinct.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "visual_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The photographer noticed several <w>blurrings</w> in the final image.",
                            "target_lang_translations": {
                                "ru": "Фотограф заметил несколько <w>размытостей</w> на итоговом снимке."
                            }
                        },
                        {
                            "text": "The artist used soft edges to create subtle <w>blurrings</w> in the background.",
                            "target_lang_translations": {
                                "ru": "Художник использовал мягкие края, чтобы создать тонкие <w>размытости</w> на заднем плане."
                            }
                        }
                    ],
                    "synonyms": [
                        "smudge",
                        "haze"
                    ],
                    "target_lang_definitions": {
                        "ru": "Участок изображения или предмет, который выглядит нечетким или размытым."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "размытость",
                                "target_lang_sense_clarification": "состояние отсутствия четкости"
                            },
                            {
                                "target_lang_word": "пятно",
                                "target_lang_sense_clarification": "неясный участок на изображении"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}