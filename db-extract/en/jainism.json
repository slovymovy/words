    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "755bc752-39b2-3a30-852e-4900f631148d",
                "word": "Jainism",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0d175af6-1753-3729-a017-7908bec4b11d",
                        "entry_id": "755bc752-39b2-3a30-852e-4900f631148d",
                        "glosses": [
                            "An ancient Dharmic religion, with a focus on nonviolence and personal effort to elevate the reincarnating soul towards moksha by liberating it from samsara."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58e73815-372a-49bd-adce-344778ee8802",
                                "sense_id": "0d175af6-1753-3729-a017-7908bec4b11d",
                                "text": "Jainism is similar to other eastern religions in believing in reincarnation."
                            },
                            {
                                "example_id": "15f2ac5e-1842-4293-bdc2-d29cb2911844",
                                "sense_id": "0d175af6-1753-3729-a017-7908bec4b11d",
                                "text": "I know enough about Jainism to know that Jains are some of the most extreme vegetarians around."
                            }
                        ]
                    },
                    {
                        "sense_id": "e9d65b56-f89d-3275-8614-199c2b1673ee",
                        "entry_id": "755bc752-39b2-3a30-852e-4900f631148d",
                        "glosses": [
                            "A nontheistic heterodox Indian philosophy"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "118b0d01-5127-4474-b05b-1424ca2033b9",
                        "source_entry_id": "755bc752-39b2-3a30-852e-4900f631148d",
                        "source_sense_description": "religion and philosophy",
                        "target_lang_word": "Jaïnisme",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "fec8b22a-7716-4e8f-ad87-49884657a273",
                        "source_entry_id": "755bc752-39b2-3a30-852e-4900f631148d",
                        "source_sense_description": "religion and philosophy",
                        "target_lang_word": "jaïnisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jaïnisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "325c0e9d-a81c-3d25-bbe7-a9c9300e1214",
                                        "entry_id": "16e63e26-8e70-3600-af42-3cd6f392a958",
                                        "glosses": [
                                            "Religion qui insiste sur les concepts d’ahimsa (non-violence) et de karma, et met l’accent sur l’ascétisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9968e0d-ec94-4562-9607-331c5420c75e",
                                                "sense_id": "325c0e9d-a81c-3d25-bbe7-a9c9300e1214",
                                                "text": "Le caractère peu missionnaire du jaïnisme est frappant et sa doctrine est fondamentalement aristocratique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6ceded43-cf5b-4e97-a360-7f3ebac02b24",
                        "source_entry_id": "755bc752-39b2-3a30-852e-4900f631148d",
                        "source_sense_description": "religion and philosophy",
                        "target_lang_word": "djaïnisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "djaïnisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bd654f77-dc6d-3bc4-8839-8359adae4980",
                                        "entry_id": "9b57becf-afca-3bc5-9a1a-b9f04dd43f02",
                                        "glosses": [
                                            "Variante orthographique de jaïnisme."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0094094-7eea-4771-9824-709a59c26f6e",
                                                "sense_id": "bd654f77-dc6d-3bc4-8839-8359adae4980",
                                                "text": "Mais deux réformateurs, vivant aux environs de 500 avant J.-C, firent radicalement éclater ce cadre et créèrent deux nouvelles religions, le djaïnisme et le bouddhisme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "06b47285-2d5a-4a56-a4b3-1fa3b1072c99",
                        "source_entry_id": "755bc752-39b2-3a30-852e-4900f631148d",
                        "source_sense_description": "religion and philosophy",
                        "target_lang_word": "jinisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jinisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8bd10acb-937f-3259-a182-f18dc5a86d54",
                                        "entry_id": "6e8b41c5-df3c-3e73-ba3b-fc0efa934af5",
                                        "glosses": [
                                            "Variante de jaïnisme."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a35ada7-ddc3-4873-bbbd-3a389a5c91f9",
                                                "sense_id": "8bd10acb-937f-3259-a182-f18dc5a86d54",
                                                "text": "Le bouddhisme et le jinisme ne sont pas autre chose, à l’origine, que des sectes réformatrices à l’intérieur de la communauté hindouiste naissante."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "35fbf7fe-c44f-4bc4-9ee1-a092606e98f9",
                        "source_entry_id": "755bc752-39b2-3a30-852e-4900f631148d",
                        "source_sense_description": "religion and philosophy",
                        "target_lang_word": "Jainismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jainismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1e4a0534-7240-3f3e-861e-731b86758d1a",
                                        "entry_id": "90fe2ac2-3b07-3a55-bbf6-dbcea6eba3a3",
                                        "glosses": [
                                            "in Indien beheimatete Religion, die etwa im 6./5. Jahrhundert v. Chr. entstanden ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "609e8f6a-9192-466c-b59e-0df003015de5",
                                                "sense_id": "1e4a0534-7240-3f3e-861e-731b86758d1a",
                                                "text": "„›Als Sie Geschichte studiert haben‹, sagt er, ›haben Sie da auch was von den Jainas gehört? Den Anhängern des Jainismus, einer Art Buddhismus?‹“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cb0bee35-ae01-45c1-9b63-bb7dd00c1a4f",
                        "source_entry_id": "755bc752-39b2-3a30-852e-4900f631148d",
