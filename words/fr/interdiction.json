{
    "word_family": [
        "interdire",
        "interdit"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6f773cb3-297a-37e1-8129-79801e1c630d",
                    "sense_definition": "Action de défendre de faire quelque chose ou règle interdisant un comportement.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "defense_reglementaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'<w>interdiction</w> de fumer dans les lieux publics fermés est strictement respectée par tous."
                        },
                        {
                            "text": "Le maire a finalement décidé de lever l'<w>interdiction</w> de circuler dans le quartier historique."
                        }
                    ],
                    "synonyms": [
                        "défense",
                        "prohibition"
                    ],
                    "antonyms": [
                        "autorisation",
                        "permission"
                    ],
                    "common_phrases": [
                        "interdiction de fumer",
                        "interdiction de stationner",
                        "lever une interdiction"
                    ]
                },
                {
                    "sense_id": "857a9d71-eecf-36f7-a2d3-cbf864e14937",
                    "sense_definition": "Défense légale d'exercer temporairement ou définitivement certaines fonctions ou une profession.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sanction_juridique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le tribunal a prononcé une <w>interdiction</w> d'exercer la médecine contre ce praticien négligent."
                        },
                        {
                            "text": "Ce haut fonctionnaire a été puni d'une <w>interdiction</w> temporaire de toute charge administrative."
                        }
                    ],
                    "synonyms": [
                        "suspension",
                        "radiation"
                    ],
                    "common_phrases": [
                        "interdiction temporaire",
                        "peine d'interdiction"
                    ]
                },
                {
                    "sense_id": "d68b0bff-b4ed-3eb1-a289-3b56ff9c23c1",
                    "sense_definition": "Privation totale ou partielle de certains droits civils ou civiques prononcée par un tribunal.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sanction_juridique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le coupable a été condamné à cinq ans d'<w>interdiction</w> des droits civiques et civils."
                        },
                        {
                            "text": "La justice lui a également imposé une <w>interdiction</w> de séjour dans tout le département."
                        }
                    ],
                    "synonyms": [
                        "déchéance"
                    ],
                    "antonyms": [
                        "réhabilitation"
                    ],
                    "common_phrases": [
                        "interdiction de séjour",
                        "interdiction des droits civiques"
                    ]
                },
                {
                    "sense_id": "4d58612e-187a-39b4-9ad2-8b8a89c62bfa",
                    "sense_definition": "Mesure judiciaire privant une personne incapable de la libre disposition et de la gestion de ses biens.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "protection_legale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La famille a réclamé l'<w>interdiction</w> du vieil homme affaibli pour protéger son patrimoine."
                        },
                        {
                            "text": "Ce jugement d'<w>interdiction</w> a entraîné la nomination immédiate d'un représentant légal."
                        }
                    ],
                    "synonyms": [
                        "tutelle",
                        "curatelle"
                    ],
                    "common_phrases": [
                        "jugement d'interdiction"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Remplacé en droit moderne par des régimes de tutelle ou de curatelle."
                        }
                    ]
                }
            ]
        }
    ]
