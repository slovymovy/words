                    {
                        "sense_id": "2a2e97df-c55e-3c72-a243-f870abad8b3f",
                        "entry_id": "8b1cc85d-d26d-3773-8977-c07db174ecec",
                        "glosses": [
                            "chinesische und japanische Richtung des Buddhismus, die auf Meditation beruht"
