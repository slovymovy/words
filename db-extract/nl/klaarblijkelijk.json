                                "target_senses": [
                                    {
                                        "sense_id": "9f0195ee-d734-31fb-86fc-0af31cb1ab28",
                                        "entry_id": "c72d2f8e-d821-3e27-b96b-e449a5b92d17",
                                        "glosses": [
                                            "Obviously true by simple observation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1ecdf01-e024-41f0-a2fb-95820bd8d863",
                                                "sense_id": "9f0195ee-d734-31fb-86fc-0af31cb1ab28",
                                                "text": "It was evident she was angry, after she slammed the door."
                                            },
                                            {
                                                "example_id": "33ff7502-5446-4877-86bc-d88ea370683c",
                                                "sense_id": "9f0195ee-d734-31fb-86fc-0af31cb1ab28",
                                                "text": "Maccario, it was evident, did not care to take the risk of blundering upon a picket, and a man led them by twisting paths until at last the hacienda rose blackly before them."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "00aa72fd-197f-44c0-859e-c2fba9452b4e",
                        "source_entry_id": "4dea95fe-955a-3e90-9d46-2bc1db603335",
                        "source_sense_id": "30870733-9066-3bfe-9cdd-a421daef706f",
                        "source_sense_description": "kennelijk",
                        "target_lang_word": "évident",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "évident",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9bd535c1-4dce-3546-8e0e-0955482cfdb8",
                                        "entry_id": "2ff31b9c-167a-3884-8986-edc027a338b8",
                                        "glosses": [
                                            "Dont le sens s’impose naturellement à l’esprit, qui a le caractère de l’évidence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3d06e72-3594-45f7-940a-246615e3323e",
                                                "sense_id": "9bd535c1-4dce-3546-8e0e-0955482cfdb8",
                                                "text": "Les autres convives européens ou asiatiques sont installés passim, avec l’évidente intention de faire honneur à ce repas."
                                            },
                                            {
                                                "example_id": "b1a4140a-370d-4ecb-a79e-2697465033b6",
                                                "sense_id": "9bd535c1-4dce-3546-8e0e-0955482cfdb8",
                                                "text": "En fait, dès 1865, il est évident que le penseur en chef du futur mouvement communiste international est embarqué dans une psychose économétrique de type thorézien."
                                            },
                                            {
                                                "example_id": "10332fa1-991a-4fda-9c64-5507a44c98cf",
                                                "sense_id": "9bd535c1-4dce-3546-8e0e-0955482cfdb8",
                                                "text": "Dès lors, supposer que dans une révolution un peu sérieuse et profonde c’est simplement le rapport entre la majorité et la minorité qui décide, c’est faire preuve d’une prodigieuse stupidité ; c’est s’en tenir à un préjugé archinaïf digne d’un vulgaire libéral ; c’est tromper les masses, leur cacher une évidente vérité historique."
                                            }
                                        ]
                                    }
                                ]
                            },
