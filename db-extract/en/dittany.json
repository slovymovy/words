                                "target_word": "dictame",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "679d27de-7677-3361-8ebd-e2ad0040a9fc",
                                        "entry_id": "e2ad6a5c-0977-30d2-8a01-a49775c22413",
                                        "glosses": [
                                            "Plante aromatique de la famille des labiées, passant chez les Grecs pour être un puissant vulnéraire."
                                        ],
                                        "tags": [
                                            "Anciennement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68ec2379-6711-42d0-9014-ab61f59bc47e",
                                                "sense_id": "679d27de-7677-3361-8ebd-e2ad0040a9fc",
                                                "text": "L'espèce origanum dictamnus correspond au dictame de Crète."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a48ac813-72a7-38a4-ac95-906af6f64253",
                                        "entry_id": "e2ad6a5c-0977-30d2-8a01-a49775c22413",
                                        "glosses": [
                                            "Autre nom de la fraxinelle, de la famille des rutacées."
                                        ],
                                        "tags": [
                                            "Aujourd'hui"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1190e88-bf5e-4637-9d1a-affd392c266d",
                                                "sense_id": "a48ac813-72a7-38a4-ac95-906af6f64253",
                                                "text": "L'espèce dictamnus albus, plus couramment appelée dictame."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dde792b5-3888-3817-ac3d-2565f1769e69",
                                        "entry_id": "e2ad6a5c-0977-30d2-8a01-a49775c22413",
                                        "glosses": [
                                            "Adoucissement, consolation des souffrances morales."
                                        ],
                                        "tags": [
                                            "Figuré et littéraire"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "630555fa-62c2-40cd-8c8d-dfe02ac8e5fb",
                                                "sense_id": "dde792b5-3888-3817-ac3d-2565f1769e69",
                                                "text": "Vers ce grand ciel clément où sont tous les dictames,\nLes aimés, les absents, les êtres purs et doux."
                                            },
                                            {
                                                "example_id": "ef8e4d3d-500a-44c1-b342-9ef0a952c7e9",
                                                "sense_id": "dde792b5-3888-3817-ac3d-2565f1769e69",
                                                "text": "Car vous êtes bénie entre toutes les femmes:\nVous avez le secret des bienfaisants dictames."
                                            },
                                            {
                                                "example_id": "02c97e97-8087-4c21-a3a9-372f9250a675",
                                                "sense_id": "dde792b5-3888-3817-ac3d-2565f1769e69",
                                                "text": "La meilleure preuve d’amitié que je puisse donner à une inconnue, en échange de ce dictame qui guérirait les morsures de la critique, n’est-ce pas de partager avec elle la moisson de mon expérience."
                                            },
                                            {
                                                "example_id": "53d2f456-745c-4820-a3de-75b753635928",
                                                "sense_id": "dde792b5-3888-3817-ac3d-2565f1769e69",
                                                "text": "Laisse-moi rêver, fût-ce un jour,\nCe jeune espoir, mon seul dictame."
                                            },
                                            {
                                                "example_id": "92164843-7d49-441c-82c8-82ae1f6830a7",
                                                "sense_id": "dde792b5-3888-3817-ac3d-2565f1769e69",
                                                "text": "Moins qu’une brute et presque un dieu,\nJe m’épuise et nage au milieu\nDes réconforts et des dictames."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc4747dd-bfe4-3e68-9dbf-6e2da83b482c",
                                        "entry_id": "e2ad6a5c-0977-30d2-8a01-a49775c22413",
                                        "glosses": [
                                            "Synonyme d'arrow-root."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
