                                        "sense_id": "b5050b3b-a4db-37a7-a4ec-04952b141d6e",
                                        "entry_id": "c6b423b3-46ad-3305-b42e-463b8b66caa3",
                                        "glosses": [
                                            "die Ehefrau eines Grafen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "036a7b8c-c0b6-4022-91f4-b6a44f2503a6",
                                                "sense_id": "b5050b3b-a4db-37a7-a4ec-04952b141d6e",
                                                "text": "Gräfin von Falckenburg hat sich zum Tee angekündigt."
                                            },
                                            {
                                                "example_id": "1a98ddb8-41e2-4383-896a-205afa56b8a4",
                                                "sense_id": "b5050b3b-a4db-37a7-a4ec-04952b141d6e",
                                                "text": "„Aber die Gräfin Thor von Thorfels könnte vielleicht ein Wörtchen dazu sagen?“"
                                            },
                                            {
                                                "example_id": "8663292e-b56a-4af6-a9e3-d7133c482be2",
                                                "sense_id": "b5050b3b-a4db-37a7-a4ec-04952b141d6e",
                                                "text": "„Die Gräfin, ein uneheliches Kind, war Tänzerin im Königlichen Ballett gewesen, getauft auf den Namen Louise Rasmussen.“"
                                            },
                                            {
                                                "example_id": "11c1b168-1297-4efd-9188-00917b9e525c",
                                                "sense_id": "b5050b3b-a4db-37a7-a4ec-04952b141d6e",
                                                "text": "„Und irgendwo unter den Großen sitzt auch die Gräfin.“"
                                            },
                                            {
                                                "example_id": "60d0da6a-77c5-4c53-93ae-ebf5426a84c4",
                                                "sense_id": "b5050b3b-a4db-37a7-a4ec-04952b141d6e",
                                                "text": "„Die Gräfin gab ihren Leuten Anweisung, was sie auf ihre Fluchtwagen laden sollten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
