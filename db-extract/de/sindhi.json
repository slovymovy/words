                "senses": [
                    {
                        "sense_id": "5aeff783-b2e7-3442-b77b-f940a47d8627",
                        "entry_id": "12dfb29c-274a-332e-a6e4-2924c78076a1",
                        "glosses": [
                            "indoarische Sprache, die im südlichen Pakistan und in Indien gesprochen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c23ef2aa-17bc-4b5a-b64a-aee1323ed7ef",
                                "sense_id": "5aeff783-b2e7-3442-b77b-f940a47d8627",
                                "text": "„In Indien ist Sindhi als eine von 22 Nationalsprachen Indiens anerkannt.“"
                            },
                            {
                                "example_id": "7b7e9e5d-90ae-471a-906a-8b0d7167a9f5",
                                "sense_id": "5aeff783-b2e7-3442-b77b-f940a47d8627",
                                "text": "„Außerdem beherrscht sie Sindhi, Paschtu und Punjabi, fließend, versteht sich.“"
                            },
                            {
                                "example_id": "78c81306-04be-44a3-ac35-cdbcf8619e19",
                                "sense_id": "5aeff783-b2e7-3442-b77b-f940a47d8627",
                                "text": "„Dieses Vorgehen jedoch führte direkt zu Spannungen. So kam es nach der Anerkennung von Sindhi als regionale Provinzsprache 1972 zu gewaltsamen Auseinandersetzungen zwischen Sindhis und Mohajirin, die nur durch das Einschreiten der Armee unter Kontrolle gebracht werden konnten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
