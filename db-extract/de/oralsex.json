                    {
                        "sense_id": "91daf744-55c1-3204-81bb-5ac6b8f5525b",
                        "entry_id": "20f4d5ce-ab87-3d6f-b0a8-9ab98dde0b49",
                        "glosses": [
                            "Sexualpraktik, bei der das Geschlechtsteil des Sexualpartners/der Sexualpartnerin mit dem Mund (den Lippen, der Zunge, den Zähnen) stimuliert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60892c04-e344-4ea5-932a-c387ab55d655",
                                "sense_id": "91daf744-55c1-3204-81bb-5ac6b8f5525b",
                                "text": "„Was Bill Clinton in den Augen forscher Republikaner zum Weichling stempelte, war neben seinem Hang zum Oralsex seine Doppelzüngigkeit.“"
                            },
                            {
                                "example_id": "c0025e54-56ae-4acd-94cb-e0646ffe9396",
                                "sense_id": "91daf744-55c1-3204-81bb-5ac6b8f5525b",
                                "text": "„Hermann sehnte sich derweil nach Oralsex. Seine Frau hatte die Erfüllung derartiger Träume abgelehnt.“"
                            },
                            {
                                "example_id": "0dce2ecb-ef75-4769-ae2a-22dd3ef74eae",
                                "sense_id": "91daf744-55c1-3204-81bb-5ac6b8f5525b",
                                "text": "„Irgendwie fand er es beruhigend, dass sich der Gegner über die theologischen Auswirkungen von Oralsex den Kopf zerbrach.“"
                            },
                            {
                                "example_id": "16d0887f-3254-40c6-b00b-790e204e8aa4",
                                "sense_id": "91daf744-55c1-3204-81bb-5ac6b8f5525b",
                                "text": "„An einem Abend im Jahr 1999 sah Kabukicho wie ein hell erleuchtetes Märchenland aus, nur dass die Neonreklamen Oralsex anstatt Kinderspielzeug anpriesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
