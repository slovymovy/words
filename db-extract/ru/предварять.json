                        "entry_id": "ca4f37c9-c80f-3eb6-b719-1749f2796bb7",
                        "glosses": [
                            "излагать перед чем-либо, предпосылать чему-либо"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c19b9068-5af1-3f57-9874-fd532569a5f5",
                        "entry_id": "ca4f37c9-c80f-3eb6-b719-1749f2796bb7",
