                    }
                ],
                "senses": [
                    {
                        "sense_id": "52848632-9a79-32c1-a02d-1fc84b9bfe5d",
                        "entry_id": "c01f0a85-12e1-3a4e-802f-c13fd107bb09",
                        "glosses": [
                            "морск. то же, что север"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69624b29-fe35-404c-8b04-49db88acc905",
                                "sense_id": "52848632-9a79-32c1-a02d-1fc84b9bfe5d",
                                "text": "Корабль отвык идти по курсу, сбивался то на зюйд, то на норд."
                            },
                            {
                                "example_id": "9a98530f-5e57-4eb2-acde-5e9603cb6082",
                                "sense_id": "52848632-9a79-32c1-a02d-1fc84b9bfe5d",
                                "text": "Мы возьмем курс прямо на ост, к подводному хребту, а потом вдоль него, на норд."
                            },
                            {
                                "example_id": "2bd6c4b9-926d-477a-8495-2c535ec0b732",
                                "sense_id": "52848632-9a79-32c1-a02d-1fc84b9bfe5d",
                                "text": "На совещании старший лейтенант доложил, что размеры льдины — четыреста семьдесят пять метров в длину с веста на ост, а ширина в том месте, где находится подлодка, — триста шестьдесят восемь метров с зюйда на норд."
                            }
                        ]
                    },
                    {
                        "sense_id": "faa16db4-1cef-3678-ab1f-13b71c073a42",
                        "entry_id": "c01f0a85-12e1-3a4e-802f-c13fd107bb09",
                        "glosses": [
                            "морск. северный ветер"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fa782a4-cf94-45f2-aba8-415a85fbd8bd",
                                "sense_id": "faa16db4-1cef-3678-ab1f-13b71c073a42",
                                "text": "За ужином он осторожно намекнул, что время для выхода в залив выбрано не самое лучшее: в декабре норд здесь задувает редко."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fee0ca9b-982b-455a-8c1b-287f0600651a",
                        "source_entry_id": "c01f0a85-12e1-3a4e-802f-c13fd107bb09",
                        "target_lang_word": "north",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "north",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9914bf71-6fc3-3feb-ae1f-dba7d2b3bac7",
                                        "entry_id": "2d3189be-daeb-3a53-876d-bd8a1185aa36",
                                        "glosses": [
                                            "The direction towards the pole to the left-hand side of someone facing east, specifically 0°, or (on another celestial object) the direction towards the pole lying on the northern side of the invariable plane."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8229e09-e3dd-40c4-9b8e-6521fd5988b4",
                                                "sense_id": "9914bf71-6fc3-3feb-ae1f-dba7d2b3bac7",
                                                "text": "Minnesota is in the north of the USA."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "855845c3-e979-39c7-a311-7eeaa6854169",
                                        "entry_id": "2d3189be-daeb-3a53-876d-bd8a1185aa36",
                                        "glosses": [
                                            "The up or positive direction."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c129087a-1663-42b7-84e0-32bc1b70bdbb",
                                                "sense_id": "855845c3-e979-39c7-a311-7eeaa6854169",
                                                "text": "Stock prices are heading back towards the north."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb78dd6b-5d17-3112-bef9-5669bcbed789",
                                        "entry_id": "2d3189be-daeb-3a53-876d-bd8a1185aa36",
                                        "glosses": [
                                            "The positive or north pole of a magnet, which seeks the magnetic pole near Earth's geographic North Pole (which, for its magnetic properties, is a south pole)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "63e2302a-94d5-390b-96e9-0f05def70488",
                                        "entry_id": "2d3189be-daeb-3a53-876d-bd8a1185aa36",
                                        "glosses": [
                                            "Alternative letter-case form of North (“a northern region; the inhabitants thereof”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cdec6c76-00af-4a61-8f96-a25cafcf4e95",
                                                "sense_id": "63e2302a-94d5-390b-96e9-0f05def70488",
                                                "text": "[…] and after independence the north clung to sugar production longer than the south, with the result that when the north took […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3821d74-75f0-3bb0-98c0-7f8483bf951f",
                                        "entry_id": "2d3189be-daeb-3a53-876d-bd8a1185aa36",
                                        "glosses": [
                                            "In a church: the direction to the left-hand side of a person facing the altar."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1eb598c-0c60-4f3a-b15c-446ece7b8614",
                                                "sense_id": "f3821d74-75f0-3bb0-98c0-7f8483bf951f",
                                                "text": "If candidates stand on the liturgical south facing the presider and liturgical assistants on the liturgical north, it will present better visual lines for the congregation than if they stand facing east and west with their backs toward the congregation."
                                            },
                                            {
                                                "example_id": "2cba0627-6577-4699-9756-db708ac13217",
                                                "sense_id": "f3821d74-75f0-3bb0-98c0-7f8483bf951f",
                                                "text": "Many early Christian basilicas were designed with twin ambos for the proclamation of the epistle (on the liturgical south side) and the Gospel (on the north). The separation of the ambos indicated the distinction that should be accorded the Gospel, which was proclaimed from the north as if evangelization needed to happen to the geographically southern part of the world."
                                            },
                                            {
                                                "example_id": "cd3754b3-9ffb-4880-ad56-a2b415ba73a3",
                                                "sense_id": "f3821d74-75f0-3bb0-98c0-7f8483bf951f",
                                                "text": "At St. Andrew's, ecclesiastical north, south, east, and west correspond to geographical northeast, southwest, southeast, and northwest."
                                            },
                                            {
                                                "example_id": "1dec3330-6bb8-4f28-9d9c-39e37b708710",
                                                "sense_id": "f3821d74-75f0-3bb0-98c0-7f8483bf951f",
                                                "text": "The new St Mary's Anglican Church, Walkerville, has an attached rectory flanking to the liturgical south and an attached parish hall flanking to the liturgical north, both half-timbered in the Tudor Revival style. [Referring to a church that is oriented SSE, making \"south\" WSW]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "north",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b850fcdd-96b7-32cd-bc4b-2fe8509dc09b",
                                        "entry_id": "9f07cf7e-1f53-33cd-a5e6-11741d9e4c54",
                                        "glosses": [
                                            "Of or pertaining to the north; northern."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "683a9ea3-581c-489a-a867-dcb111f394f8",
                                                "sense_id": "b850fcdd-96b7-32cd-bc4b-2fe8509dc09b",
                                                "text": "He lived in north Germany."
                                            },
                                            {
                                                "example_id": "56d622b0-d32b-4bd6-8d07-ece6c6a6f54b",
                                                "sense_id": "b850fcdd-96b7-32cd-bc4b-2fe8509dc09b",
                                                "text": "She entered through the north gate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d92af45-d6a0-30a1-9055-c7475e162bea",
                                        "entry_id": "9f07cf7e-1f53-33cd-a5e6-11741d9e4c54",
                                        "glosses": [
                                            "Toward the north; northward."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bcfb5842-8d19-447d-826c-13024bc28e22",
                                                "sense_id": "6d92af45-d6a0-30a1-9055-c7475e162bea",
                                                "text": "The most dangerous ones are those that develop during October and November and that follow a north path affecting the western part of the island."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d20cb9b2-3b70-3cf1-a174-7c3fe1123d6c",
                                        "entry_id": "9f07cf7e-1f53-33cd-a5e6-11741d9e4c54",
                                        "glosses": [
                                            "Of wind, from the north."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da483c2f-4a07-4de5-a9e8-69b42789b766",
                                                "sense_id": "d20cb9b2-3b70-3cf1-a174-7c3fe1123d6c",
                                                "text": "The north wind was cold."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "118d9615-f31f-3e30-8cb9-d2d3f0d860b1",
                                        "entry_id": "9f07cf7e-1f53-33cd-a5e6-11741d9e4c54",
                                        "glosses": [
                                            "Pertaining to the part of a corridor used by northbound traffic."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d7c43c8-ccf2-4985-aba8-95cbb071155d",
                                                "sense_id": "118d9615-f31f-3e30-8cb9-d2d3f0d860b1",
                                                "text": "north highway 1"
                                            },
                                            {
                                                "example_id": "90720ee8-782e-4861-afc7-72fd78199ecf",
                                                "sense_id": "118d9615-f31f-3e30-8cb9-d2d3f0d860b1",
                                                "text": "Traffic was doing the speed limit on North I-45 one minute and had come to a stand-still the next."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1352ba7f-11ab-38f5-a0dc-40165f2f9266",
                                        "entry_id": "9f07cf7e-1f53-33cd-a5e6-11741d9e4c54",
                                        "glosses": [
                                            "Designating, or situated in, the liturgical north (in a church, the direction to the left-hand side of a person facing the altar)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56b5c574-d370-4dc6-ab10-0af2384abf67",
                                                "sense_id": "1352ba7f-11ab-38f5-a0dc-40165f2f9266",
                                                "text": "[…] the high church had liked its clergy to preside at the Eucharist in an ad orientem position; the low church advocated what was called the north end position; but the Liturgical Movement asked the priest to take a basilical position, facing liturgical west, and now both Anglican factions could agree on this third position without either of them losing face."
                                            },
                                            {
                                                "example_id": "a3f25c02-7257-4623-bde8-c6c73a7d1bba",
                                                "sense_id": "1352ba7f-11ab-38f5-a0dc-40165f2f9266",
                                                "text": "Throughout the book I refer directionally to the altar and chancel of St. Andrew's as situated at ecclesiastical east (to avoid overcomplicating matters), not geographical or magnetic southeast. Thus, […] The north side faces the river (beyond the subdivision behind the church), and the south side, Ashley River Road. […] At St. Andrew's, ecclesiastical north, south, east, and west correspond to geographical northeast, southwest, southeast, and northwest. Unless otherwise indicated, compass directions given in this book are ecclesiastical, not geographical, reference points."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e492c463-5132-3ea5-870e-fa4c635d4ead",
                                        "entry_id": "9f07cf7e-1f53-33cd-a5e6-11741d9e4c54",
                                        "glosses": [
                                            "More or greater than."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7db7769-6366-4b8f-9855-a65dea18a47b",
                                                "sense_id": "e492c463-5132-3ea5-870e-fa4c635d4ead",
                                                "text": "The wedding ended up costing north of $50,000."
                                            },
                                            {
                                                "example_id": "20cee8be-9077-47fa-aa73-7d7fffa5f281",
                                                "sense_id": "e492c463-5132-3ea5-870e-fa4c635d4ead",
                                                "text": "The price you're offering had better be north of the highest price this company has ever traded for."
                                            },
                                            {
                                                "example_id": "d83f4a63-660d-4a81-8757-c573395fe178",
                                                "sense_id": "e492c463-5132-3ea5-870e-fa4c635d4ead",
                                                "text": "Some of the windscreens we replace cost north of $1800[.]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "north",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f7ff11f0-cd2e-36f9-a01b-acb72d2bbffc",
                                        "entry_id": "fa2af6f4-d740-39a7-90b1-07d1f5e4bfbd",
                                        "glosses": [
                                            "Toward the north; northward; northerly."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07e75cb3-f146-4649-ae51-23c174c73baf",
                                                "sense_id": "f7ff11f0-cd2e-36f9-a01b-acb72d2bbffc",
                                                "text": "Switzerland is north of Italy."
                                            },
                                            {
                                                "example_id": "6df293ae-c5c1-438b-9380-ccce9aabcf14",
                                                "sense_id": "f7ff11f0-cd2e-36f9-a01b-acb72d2bbffc",
                                                "text": "We headed north."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "north",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "af255eb6-737b-3782-8007-048552c0adb8",
                                        "entry_id": "21395d15-5b7c-3723-8aa7-790db34103cd",
                                        "glosses": [
                                            "To turn or move toward the north."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bac3e280-f921-4f86-8afb-36799033059f",
                                                "sense_id": "af255eb6-737b-3782-8007-048552c0adb8",
                                                "text": "When at B you had northed 3.71[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "61259f96-96c9-4d29-a422-fec6522ad1b0",
                        "source_entry_id": "c01f0a85-12e1-3a4e-802f-c13fd107bb09",
                        "target_lang_word": "noord",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "noord",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "1883c76f-49e0-3729-8b19-73f4302dc16f",
                                        "entry_id": "7c15ef88-be6c-3a12-9f9a-81d129c25e3f",
                                        "glosses": [
                                            "in de richting van de pool die in de Noordelijke IJszee gelegen is; wanneer je in de richting van opkomende zon kijkt, links"
                                        ],
                                        "tags": [
                                            "windstreek"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13a72586-c2b0-4740-9b58-ca8139e019e0",
                                                "sense_id": "1883c76f-49e0-3729-8b19-73f4302dc16f",
                                                "text": "De wind draaide van noord naar west."
                                            },
                                            {
                                                "example_id": "527e7ec4-228d-4b92-9842-d45aca4bebe4",
                                                "sense_id": "1883c76f-49e0-3729-8b19-73f4302dc16f",
                                                "text": "De buurstaat Oregon daarentegen liep ik in drie weken van zuid naar noord."
                                            },
                                            {
                                                "example_id": "f2f2f588-d912-4320-9dd4-cd339f05da09",
                                                "sense_id": "1883c76f-49e0-3729-8b19-73f4302dc16f",
                                                "text": "\"Dat wordt straks wel even wennen\", zegt machinist Jos van der Veen tegen RTV Noord. Hij had gisteravond zijn laatste rit naar het \"oude hoofdstation\"\". \"Ik vind het mooi om een stukje spoorweggeschiedenis mee te maken, zowel aan het einde van iets of het begin van iets. Nu mag ik het einde meemaken, hartstikke leuk.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
