                        "examples": [
                            {
                                "example_id": "733e0c2e-4d12-4acb-bcf0-f3c4675c0a2e",
                                "sense_id": "ec318407-841d-3c7c-adba-e7879dbdaa4c",
                                "text": "VPLP Design a développé une aile à deux volets, affalable, arisable et entièrement automatisée."
                            },
                            {
                                "example_id": "70fd48d2-29b7-4232-aac5-c727d615223a",
                                "sense_id": "ec318407-841d-3c7c-adba-e7879dbdaa4c",
                                "text": "Leur rigidité leur offre un rendement deux fois supérieur à celui des voiles classiques. Tout est restant arisables et affalables."
                            },
                            {
                                "example_id": "7eb4f32f-955f-4aec-b3a3-8fe0f00427a4",
                                "sense_id": "ec318407-841d-3c7c-adba-e7879dbdaa4c",
                                "text": "Ici, le second volet est remplacé par une voile classique, affalable et arrisable : c’est futé et très pratique."
                            }
                        ]
                    }
