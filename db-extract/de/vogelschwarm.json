                "senses": [
                    {
                        "sense_id": "c1e8dd5c-7df6-35ae-8686-60a1af11ab03",
                        "entry_id": "85536b47-e2ba-396a-804f-c1584bf7debe",
                        "glosses": [
                            "Schar von Vögeln; Gruppe von Vögeln, deren Mitglieder sich untereinander nicht individuell kennen, die aber gemeinsam einen Superorganismus bilden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a23dccf5-a013-46c6-8b56-d08b92db7f90",
                                "sense_id": "c1e8dd5c-7df6-35ae-8686-60a1af11ab03",
                                "text": "Der Vogelschwarm bietet dem einzelnen Vogel Schutz."
                            },
                            {
                                "example_id": "4edc962d-97db-407e-96d3-3a0324c223bb",
                                "sense_id": "c1e8dd5c-7df6-35ae-8686-60a1af11ab03",
                                "text": "„Riesige Vogelschwärme folgten der Großen Armee, nie zuvor war der Himmel so belebt gewesen.“"
                            },
                            {
                                "example_id": "d63294bb-3aa0-4ff1-9261-0816d7014c00",
                                "sense_id": "c1e8dd5c-7df6-35ae-8686-60a1af11ab03",
                                "text": "„Die Bilder des Airbus A320, der vor einem Monat in New York im Hudson River notwassern musste, sind vielen Flugpassagieren immer noch im Kopf. Ein Vogelschwarm war es gewesen, der das Flugzeug außerplanmäßig zum Aufsetzen gezwungen hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "83d162ee-85a4-435b-9ba6-347ab90c4087",
                        "source_entry_id": "85536b47-e2ba-396a-804f-c1584bf7debe",
                        "source_sense_id": "c1e8dd5c-7df6-35ae-8686-60a1af11ab03",
                        "source_sense_description": "Gruppe von Vögeln",
                        "target_lang_word": "flock",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flock",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c3de4f80-0f00-39db-b544-72e6ef479288",
                                        "entry_id": "abfe545c-6033-3a14-9c0a-879bec0552f8",
                                        "glosses": [
                                            "A number of birds together in a group, such as those gathered together for the purpose of migration."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "696f7cfe-d97a-3cd6-811b-746ba5eefa91",
                                        "entry_id": "abfe545c-6033-3a14-9c0a-879bec0552f8",
                                        "glosses": [
                                            "A large number of animals associated together in a group; commonly used of sheep, but (dated) also used for goats, farmed animals, and a wide variety of animals."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f04c85fe-9f41-4cc5-b4fb-c8e9df016bcb",
                                                "sense_id": "696f7cfe-d97a-3cd6-811b-746ba5eefa91",
                                                "text": "He told his father, and said it would be just suitable work for him to run about fields and woods amongst the strawberry hills after a flock of hares, and now and then lie down and take a nap on some sunny hill."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9886861e-83ab-3b28-b331-d09ce9dc5363",
                                        "entry_id": "abfe545c-6033-3a14-9c0a-879bec0552f8",
                                        "glosses": [
                                            "Those served by a particular pastor or shepherd."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3662b86-d4fe-42cd-9bdd-8dbf7fde6632",
                                                "sense_id": "9886861e-83ab-3b28-b331-d09ce9dc5363",
                                                "text": "But lapsed into so long a pause again / As half amazed, half frighted all his flock: [...]"
                                            },
                                            {
                                                "example_id": "b337c3dd-f128-48ee-ab04-0b2bd8c66eaa",
                                                "sense_id": "9886861e-83ab-3b28-b331-d09ce9dc5363",
                                                "text": "I also have other sheep that are not from this pen. I must lead them. They, too, will respond to my voice. So they will be one flock with one shepherd."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50c5c6d6-f379-309c-9df0-c5bcd777a212",
                                        "entry_id": "abfe545c-6033-3a14-9c0a-879bec0552f8",
                                        "glosses": [
                                            "A large number of people."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b1e1897-6b55-438c-bfc2-3528a600e706",
                                                "sense_id": "50c5c6d6-f379-309c-9df0-c5bcd777a212",
                                                "text": "The heathen […] came to Nicanor by flocks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c2f34ca-9818-3b83-a335-fbca7f8aae4e",
                                        "entry_id": "abfe545c-6033-3a14-9c0a-879bec0552f8",
                                        "glosses": [
                                            "A religious congregation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "flock",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e8ecd9c1-4f41-3847-af77-0e69bcb2663a",
                                        "entry_id": "47afbb38-1f2a-3061-9cf3-c47ce1519bcb",
                                        "glosses": [
                                            "To congregate in or head towards a place in large numbers."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af950ed2-2e3b-4aa7-a37c-afffaadaeea6",
                                                "sense_id": "e8ecd9c1-4f41-3847-af77-0e69bcb2663a",
                                                "text": "People flocked to the cinema to see the new film."
                                            },
                                            {
                                                "example_id": "1f77e517-a16d-49d7-8bd8-6fe071cab1e2",
                                                "sense_id": "e8ecd9c1-4f41-3847-af77-0e69bcb2663a",
                                                "text": "What place the gods for our repose assigned.\nFriends daily flock; and scarce the kindly spring\nBegan to clothe the ground"
                                            },
                                            {
                                                "example_id": "02785a65-7751-4306-bc21-b4ccc9a2ca94",
                                                "sense_id": "e8ecd9c1-4f41-3847-af77-0e69bcb2663a",
                                                "text": "Given the poor state of the line's trains and schedules, it is remarkable that people flock to use or experience it in embarrassingly large numbers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00ceef74-a2be-3a83-9d5f-87d0aa957db3",
                                        "entry_id": "47afbb38-1f2a-3061-9cf3-c47ce1519bcb",
                                        "glosses": [
                                            "To flock to; to crowd."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e75fd34a-3f14-4f19-aa37-1d7f82560c4f",
                                                "sense_id": "00ceef74-a2be-3a83-9d5f-87d0aa957db3",
                                                "text": "Good fellows, trooping, flocked me so."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "flock",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8c2522cb-7207-39f0-aa8d-e3e0236a86e8",
                                        "entry_id": "025b3e7a-bad9-3b7f-97ed-7f8e90b1afba",
                                        "glosses": [
                                            "Coarse tufts of wool or cotton used in bedding."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ba90306d-6457-339f-9113-066e3037ecfe",
                                        "entry_id": "025b3e7a-bad9-3b7f-97ed-7f8e90b1afba",
                                        "glosses": [
                                            "A lock of wool or hair."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54f86783-ae44-454c-b5e9-fd0f4f55347d",
                                                "sense_id": "ba90306d-6457-339f-9113-066e3037ecfe",
                                                "text": "I prythee, Tom, beat Cut's saddle, put a few flocks in the point."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4f30514-576a-3330-af13-d2ab67b286c2",
                                        "entry_id": "025b3e7a-bad9-3b7f-97ed-7f8e90b1afba",
                                        "glosses": [
                                            "Very fine sifted woollen refuse, especially that from shearing the nap of cloths, formerly used as a coating for wallpaper to give it a velvety or clothlike appearance; also, the dust of vegetable fibre used for a similar purpose."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ea67041-fb3a-4fbf-824f-cba92bff4c7b",
                                                "sense_id": "a4f30514-576a-3330-af13-d2ab67b286c2",
                                                "text": "There was a neat hat-and-umbrella stand, and the stranger's weary feet fell soft on a good, serviceable dark-red drugget, which matched in colour the flock-paper on the walls."
                                            }
                                        ]
                                    }
                                ]
                            },
