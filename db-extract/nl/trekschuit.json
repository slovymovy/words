                "senses": [
                    {
                        "sense_id": "ec2a5057-69d2-36e2-8fd7-dfcaa329e342",
                        "entry_id": "7a808612-b07a-3caa-a06f-66b3ac828f21",
                        "glosses": [
                            "vaartuig zonder krachtbron dat door trekpaarden op een jaagpad naast een kanaal werd voortbewogen"
                        ],
                        "tags": [],
