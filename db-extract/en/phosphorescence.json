                ],
                "senses": [
                    {
                        "sense_id": "cbc5180c-9627-36a5-82c3-982b39e917cc",
                        "entry_id": "dcf6f53a-535a-39cb-88d1-be861fcc6057",
                        "glosses": [
                            "The emission of light without any perceptible heat; the quality of being phosphorescent."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "1c8e664c-4a84-4d03-89e0-860e22c4d327",
                                "sense_id": "cbc5180c-9627-36a5-82c3-982b39e917cc",
                                "text": "We saw a round red sun rise over the City, paint the glassy towers with phosphorescence and, as it brightened and lost its shape, sprinkle across the sky feathers of pink and lilac."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6dc21bb9-7f56-4b2d-b307-109271457e6f",
                        "source_entry_id": "dcf6f53a-535a-39cb-88d1-be861fcc6057",
                        "source_sense_id": "cbc5180c-9627-36a5-82c3-982b39e917cc",
                        "source_sense_description": "emission of light without heat",
                        "target_lang_word": "phosphorescence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "phosphorescence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c8b3a74f-2963-3dab-9631-e44eb745c063",
                                        "entry_id": "53d8ad87-d961-3ced-ba38-37410625c250",
                                        "glosses": [
                                            "Propriété qu’ont certains corps de dégager de la lumière dans l’obscurité, sans chaleur ni combustion sensible, par réaction chimique, par opposition à la radiescence (par radio-activité) ou la fluorescence (par électro-magnétisme)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0b64c01-ce5d-4b26-9c18-b365d1c4cfaf",
                                                "sense_id": "c8b3a74f-2963-3dab-9631-e44eb745c063",
                                                "text": "Les biphores (salpa) sont des mollusques marins d’une forme très bizarre […]. Depuis assez longtemps, l’attention des naturalistes voyageurs avait été attirée sur ces animaux, dont la phosphorescence se fait remarquer même au milieu des vagues de feu de l’Océan intertropical."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "521bdabf-46d9-3578-a560-26b70972c234",
                                        "entry_id": "53d8ad87-d961-3ced-ba38-37410625c250",
                                        "glosses": [
                                            "Propriété qu’ont quelques corps d’émettre de la lumière quand ils ont été soumis à un rayonnement lumineux ou quand ils ont subi certaines actions mécaniques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c82c2fc6-75e7-442b-bb18-c105632af80d",
                                                "sense_id": "521bdabf-46d9-3578-a560-26b70972c234",
                                                "text": "La phosphorescence du sulfure de zinc après éclairement par la lumière bleue."
                                            },
                                            {
                                                "example_id": "28bda060-eb19-4d8e-936b-48f6aa6ea198",
                                                "sense_id": "521bdabf-46d9-3578-a560-26b70972c234",
                                                "text": "Phosphorescence de la mer, phénomène lumineux que l’on observe la nuit sur la mer et qui est dû surtout à une multitude d’animalcules répandus à sa surface."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
