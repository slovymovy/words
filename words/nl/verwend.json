    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1349c2d6-d67b-35b6-b51e-3bd17cbe18ff",
                    "sense_definition": "Bedorven door te veel toegeeflijkheid; gewend om altijd zijn zin te krijgen.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het <w>verwende</w> kind begon te huilen toen hij geen snoep kreeg.",
                            "target_lang_translations": {
                                "en": "The <w>spoiled</w> child started crying when he didn't get any candy.",
                                "ru": "<w>Избалованный</w> ребенок начал плакать, когда не получил конфет.",
                                "fr": "L'enfant <w>gâté</w> a commencé à pleurer quand il n'a pas eu de bonbons."
                            }
                        },
                        {
                            "text": "Zij gedraagt zich soms als een <w>verwend</w> nest als dingen tegenzitten.",
                            "target_lang_translations": {
                                "en": "She sometimes behaves like a <w>spoiled</w> brat when things go against her.",
                                "ru": "Она иногда ведет себя как <w>избалованная</w> девчонка, когда дела идут не так, как ей хочется.",
                                "fr": "Elle se comporte parfois comme une enfant <w>pourrie gâtée</w> quand les choses tournent mal."
                            }
                        }
                    ],
                    "synonyms": [
                        "bedorven"
                    ],
                    "common_phrases": [
                        "een verwend nest",
                        "verwend gedrag",
                        "verwend kind"
                    ],
                    "target_lang_definitions": {
                        "en": "Spoiled by excessive indulgence; accustomed to always getting one's way.",
                        "ru": "Испорченный излишней снисходительностью; привыкший всегда получать желаемое.",
                        "fr": "Gâté par trop d'indulgence ; habitué à toujours obtenir ce qu'il veut."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "spoiled",
                                "target_lang_sense_clarification": "having a selfish character due to pampering"
                            },
                            {
                                "target_lang_word": "pampered",
                                "target_lang_sense_clarification": "treated with extreme or excessive care"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "избалованный",
                                "target_lang_sense_clarification": "привыкший к исполнению всех капризов"
                            },
                            {
                                "target_lang_word": "испорченный",
                                "target_lang_sense_clarification": "о характере, ставшем плохим из-за потакания"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "gâté",
                                "target_lang_sense_clarification": "habitué à recevoir tout ce qu'il désire"
                            },
                            {
                                "target_lang_word": "pourri gâté",
                                "target_lang_sense_clarification": "excessivement gâté, capricieux"
                            },
                            {
                                "target_lang_word": "choyé",
                                "target_lang_sense_clarification": "entouré de trop d'attentions"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fff9661e-41df-370e-a9d1-26c569a931e5",
                    "sense_definition": "Voltooid deelwoord van <w>verwennen</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mijn moeder heeft ons gisteren heerlijk <w>verwend</w> met lekker eten.",
                            "target_lang_translations": {
                                "en": "My mother <w>spoiled</w> us wonderfully yesterday with delicious food.",
                                "ru": "Вчера мама чудесно <w>побаловала</w> нас вкусной едой.",
                                "fr": "Hier, ma mère nous a délicieusement <w>gâtés</w> avec de bons petits plats."
                            }
                        },
                        {
                            "text": "Tijdens onze vakantie hebben we ons in de spa laten <w>verwennen</w>.",
                            "target_lang_translations": {
                                "en": "During our vacation, we let ourselves be <w>pampered</w> at the spa.",
                                "ru": "Во время отпуска мы позволили себя <w>побаловать</w> в спа.",
                                "fr": "Pendant nos vacances, nous nous sommes fait <w>chouchouter</w> au spa."
                            }
                        }
                    ],
                    "synonyms": [
                        "vertroeteld"
                    ],
                    "antonyms": [
                        "verwaarloosd"
                    ],
                    "common_phrases": [
                        "zich laten verwennen",
                        "iemand verwennen"
                    ],
