                "senses": [
                    {
                        "sense_id": "0d512cd8-c0fd-38c7-9180-fa4416604221",
                        "entry_id": "3f9a0380-0913-3735-8fc6-5887fd3c7ed7",
                        "glosses": [
                            "Enlever les burnes à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4550d12-b465-4f3e-a1ab-9eb9e19c1d2c",
                                "sense_id": "0d512cd8-c0fd-38c7-9180-fa4416604221",
                                "text": "Les éburner comme des olives à farcir."
                            },
                            {
                                "example_id": "39faa0de-371d-4c71-90e3-9c7d76fb23f5",
                                "sense_id": "0d512cd8-c0fd-38c7-9180-fa4416604221",
                                "text": "Et c'est devant chez-elle que Rahan-le-Cheval s'est fait éburner !"
                            },
                            {
                                "example_id": "7f2b27a5-1829-42e6-9d33-0e9ed558c7b1",
                                "sense_id": "0d512cd8-c0fd-38c7-9180-fa4416604221",
                                "text": "Et je vous assure que l'éléphant qui a fourni l'ivoire du bracelet de votre grand-mère, mère ou copine ne s'est pas fait « éburner »."
                            },
                            {
                                "example_id": "125a500d-b6be-40e1-915f-63033b36d52c",
                                "sense_id": "0d512cd8-c0fd-38c7-9180-fa4416604221",
                                "text": "Je lui place deux genoux, il encaisse, on continue et je me fais coincer dans les cordes où je me fais éburner par deux coups de genoux d'affilée."
                            }
                        ]
                    }
