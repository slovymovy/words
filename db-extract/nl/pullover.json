                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "20bc4eb2-f850-44f5-8715-66bfe71b09e7",
                        "source_entry_id": "4e4ecb3d-ade0-32bb-9f00-352426084aef",
                        "source_sense_id": "6ec3f887-ccb8-319f-8857-545940b60ef0",
