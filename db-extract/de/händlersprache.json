                ],
                "senses": [
                    {
                        "sense_id": "76e86a92-d227-3234-9a92-07ad4c1e61a6",
                        "entry_id": "53476f7a-c6fa-362c-a5ce-6357b847cea2",
                        "glosses": [
                            "Geheimsprache einer bestimmten Gruppe von Händlern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "941c1232-3c48-4f90-93ce-9f388f99eb85",
                                "sense_id": "76e86a92-d227-3234-9a92-07ad4c1e61a6",
                                "text": "„Wenn überhaupt im kollektiven Sprachbewusssein das Jiddische eine Rolle spielt, dann sicherlich im Zusammenhang mit den alten Händlersprachen und dem Rotwelschen, also der alten deutschen Gaunersprache.“"
                            },
                            {
                                "example_id": "175faa35-887b-4925-8bd1-f521549e40e1",
                                "sense_id": "76e86a92-d227-3234-9a92-07ad4c1e61a6",
                                "text": "„In Burgberg, einem Teilort von Giengen an der Brenz, wird heute noch die \"Händlersprache\" Jenisch gesprochen.“"
                            },
                            {
                                "example_id": "874a6621-09ad-4605-ba66-c9a49a547a24",
                                "sense_id": "76e86a92-d227-3234-9a92-07ad4c1e61a6",
                                "text": "„Gesprochen wurde diese Händlersprache von den Händlern untereinander, wenn ein Dritter sie nicht verstehen sollte, aber sie war teilweise auch ein Ritual – viele Bauern kannten diese Sprache.“"
                            },
                            {
                                "example_id": "4a06b791-2d77-4596-8188-2c6bee0ff27b",
                                "sense_id": "76e86a92-d227-3234-9a92-07ad4c1e61a6",
                                "text": "„So zum Beispiel »lo Boser« aus der Metzgersprache für schlechtes Fleisch und »for (e) lo Bachinem« (für ein Spottgeld, fast umsonst) aus der Händlersprache.“"
                            },
                            {
                                "example_id": "e4b63002-c84a-415d-a48c-506506e6d905",
                                "sense_id": "76e86a92-d227-3234-9a92-07ad4c1e61a6",
                                "text": "„Wideristhöhe: Ein Meter und fünfzig, eine Puppe von Pferd, wie es in der Händlersprache heißt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
