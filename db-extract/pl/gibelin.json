                            {
                                "example_id": "2ea8161d-5ecb-45bf-a289-1d5f9f3111af",
                                "sense_id": "f8a34f6d-29e6-333d-8b73-b69ebf83f949",
                                "text": "Siena była w rękach gibelinów."
                            },
                            {
                                "example_id": "cbba5517-ecbc-45dd-a8ab-e551274371cd",
                                "sense_id": "f8a34f6d-29e6-333d-8b73-b69ebf83f949",
