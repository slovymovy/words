                        "glosses": [
                            "Désigne une personne d’environ cinquante ans, mais qui se comportent socialement comme un individu nettement plus jeune."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c12deb42-c31b-4727-9f4e-f6d488e6aebf",
                                "sense_id": "3943fc42-1c87-39e3-b02f-3b4d97812af4",
                                "text": "Une sorte de quincado intello au look de loubard brûlé au jeu politique, ce qu’il résuma avec candeur en citant un ancien secrétaire américain au Trésor…"
                            },
                            {
                                "example_id": "e857d2d1-3a2e-406d-be6d-adcc3ea6492a",
                                "sense_id": "3943fc42-1c87-39e3-b02f-3b4d97812af4",
                                "text": "– Et si tu essayais d’être une « quincados » comme Paul. Tu sais, cette tendance que developpe la nouvelle génération dont les médias parlent."
                            }
                        ]
                    }
