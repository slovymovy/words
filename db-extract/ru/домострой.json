                "senses": [
                    {
                        "sense_id": "b462ff65-29a4-3d28-b5fc-dc6b7389ea69",
                        "entry_id": "740fba0b-4ddf-330a-89fe-3d8d06c1d7db",
                        "glosses": [
                            "A 16th century set of household rules and instructions about religion, obedience to the tsar and God, and cuisine"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "adeee9f8-af68-43d5-98ef-401ae3f133b7",
                                "sense_id": "b462ff65-29a4-3d28-b5fc-dc6b7389ea69",
                                "text": "Феодальный домострой прославлял покорность и готовность к самопожертвованию как идеал женственности.",
                                "translation": "The feudal domostroy system glorified obedience and readiness for self-sacrifice as the ideal of femininity.",
                                "english": "The feudal domostroy system glorified obedience and readiness for self-sacrifice as the ideal of femininity."
                            }
                        ]
                    },
                    {
                        "sense_id": "bc544107-ad84-33e0-bf05-7ae629b41bea",
                        "entry_id": "740fba0b-4ddf-330a-89fe-3d8d06c1d7db",
                        "glosses": [
                            "Patriarchal tyranny."
                        ],
                        "tags": [
                            "colloquial",
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "4d0d0028-7a86-4328-8fe7-f5631ab0f94f",
                                "sense_id": "bc544107-ad84-33e0-bf05-7ae629b41bea",
                                "text": "Он закричал, что ему надоел этот домострой и вечные подозрения, на которые он не давал повода, и что трудно жить с женщиной, у которой такие мещанские представления о других.",
                                "translation": "He shouted that he was tired of this domostroy system and the eternal suspicions for which he gave no reason, and that it was difficult to live with a woman who had such bourgeois ideas about others.",
                                "english": "He shouted that he was tired of this domostroy system and the eternal suspicions for which he gave no reason, and that it was difficult to live with a woman who had such bourgeois ideas about others."
                            }
                        ]
                    }
                ],
