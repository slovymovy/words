                                        "glosses": [
                                            "Qui coulisse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efd9875a-9ce3-4225-99f0-bc9efd70cd45",
                                                "sense_id": "2cbaac55-9905-3c12-9530-e25e4e6db0ca",
                                                "text": "Je retrouve devant l'entrée de mon immeuble la petite agitation nocturne habituelle : bicraves et camés graves qui se fixent dans la tasse Decaux dont ils ont bricolé le mécanisme ouvrant la porte coulissante."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "coulissant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4a12394e-ab5a-3dc7-933f-bf43fa6233e2",
                                        "entry_id": "a0fc14d4-4334-354d-b2ec-30780a5bd562",
                                        "glosses": [
                                            "Élément d'ornement qui peut être déplacé sur une chaîne de montre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19aee999-dbe4-4755-a043-5127a14230d9",
                                                "sense_id": "4a12394e-ab5a-3dc7-933f-bf43fa6233e2",
                                                "text": "Il pose sa montre et la chaîne aux coulissants de rubis, avec porte-bonheur de nacre, puis il s’en va."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "coulissant",
                                "target_lang_code": "fr",
