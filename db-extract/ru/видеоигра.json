                    }
                ],
                "senses": [
                    {
                        "sense_id": "545fd7a1-0a77-3c10-8cf5-7f5eb34003d8",
                        "entry_id": "d94b0bf0-711e-3d61-aec7-69404b2c0708",
                        "glosses": [
                            "игра, основанная на манипуляции виртуальными объектами, имеющими видеоизображение (первоначально об играх на игровых автоматах с телеэкраном, позже о всех играх с использованием компьютера или приставки к телевизору)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "898f81a9-a2ad-468c-a50f-a38a2f3717b4",
                                "sense_id": "545fd7a1-0a77-3c10-8cf5-7f5eb34003d8",
                                "text": "Ориентировочно на май планируется выпуск новой видеоигры, которая, как утверждают создатели, обязательно окажется супербестселлером ― уж в Америке-то по крайней мере."
                            },
                            {
                                "example_id": "fea16810-84a1-44b9-b896-762e1c7ae02b",
                                "sense_id": "545fd7a1-0a77-3c10-8cf5-7f5eb34003d8",
                                "text": "Когда я служил в полиции, у нас был один компьютер в конторе: на нём играли в видеоигры."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "607f1661-a3f7-4f9d-b468-8acf1a378fab",
                        "source_entry_id": "d94b0bf0-711e-3d61-aec7-69404b2c0708",
                        "source_sense_id": "545fd7a1-0a77-3c10-8cf5-7f5eb34003d8",
                        "target_lang_word": "video game",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "video game",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a496a28a-1cb2-3b64-9557-abf9436ff8fd",
                                        "entry_id": "e7332dbd-a139-38f2-9047-29eeb537cde9",
                                        "glosses": [
                                            "A type of game, existing as and controlled by software, usually run by a video game console or a computer, played on a monitor or television screen, and controlled by a joypad, joystick, keyboard, mouse, touchscreen or paddle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "218c68db-6aef-49f1-b576-a9ade60e27e1",
                                                "sense_id": "a496a28a-1cb2-3b64-9557-abf9436ff8fd",
                                                "text": "My uncle’s favorite video game is Minecraft."
                                            },
                                            {
                                                "example_id": "365347d6-17ec-4da0-bcd5-90f6c9977cf7",
                                                "sense_id": "a496a28a-1cb2-3b64-9557-abf9436ff8fd",
                                                "text": "Swinging in the backyard / Pull up in your fast car whistling my name / Open up a beer / And you say get over here and play a video game / […] / I say you the bestest / Lean in for a big kiss, put his favorite perfume on / Go play your video game"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "video game",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c7f3fe86-c1c4-3059-a615-f1b2077a7394",
                                        "entry_id": "910d20f3-79e2-3fa5-88cd-a3ac5cfcc073",
                                        "glosses": [
                                            "To play video games."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06e1e10a-b7c8-47e5-ad41-0ccd5480ffec",
                                                "sense_id": "c7f3fe86-c1c4-3059-a615-f1b2077a7394",
                                                "text": "Soloway coins the “Nintendo Generation” expression, putting the attention on the never-seen-before trait of young people: they are video gaming."
                                            },
                                            {
                                                "example_id": "54c60d7a-b72e-4f94-bcc0-377b40dd5cb2",
                                                "sense_id": "c7f3fe86-c1c4-3059-a615-f1b2077a7394",
                                                "text": "And Mouse hacked and video gamed."
                                            },
                                            {
                                                "example_id": "dd7e7368-33e5-4dac-a26e-a22427816ae6",
                                                "sense_id": "c7f3fe86-c1c4-3059-a615-f1b2077a7394",
                                                "text": "He’d logged on once, only for her to demand to know why he was video gaming during a supposed vacation."
                                            },
                                            {
                                                "example_id": "76d2a686-96f6-402c-8d34-030d89381849",
                                                "sense_id": "c7f3fe86-c1c4-3059-a615-f1b2077a7394",
                                                "text": "They may not be engaged because they have fully bought into the existing structures, or because they are video gaming in their dorm rooms, or because they are working multiple jobs to pay for college (or to feed a family)."
                                            },
                                            {
                                                "example_id": "d4742d7e-0efa-4980-8732-9487a7458e2b",
                                                "sense_id": "c7f3fe86-c1c4-3059-a615-f1b2077a7394",
                                                "text": "This is one of the most common scenarios we see in our center — when a teen or young adult wants to finish high school, or more often college, and they are video gaming 12 hours a day."
                                            },
                                            {
                                                "example_id": "d16f5ab0-4230-4831-9b3a-e9d519ac8105",
                                                "sense_id": "c7f3fe86-c1c4-3059-a615-f1b2077a7394",
                                                "text": "It means you show up. Whether it’s a diaper change, advising your son about girls, patting his back after a tough sports game, or egging him on to stop slacking off while he’s video gaming."
                                            },
                                            {
                                                "example_id": "cb200603-22d6-4f42-9470-aa88b46e7a0c",
                                                "sense_id": "c7f3fe86-c1c4-3059-a615-f1b2077a7394",
                                                "text": "Relatedly, families that video gamed together reported better family satisfaction and closer relationships within the family (Wang et al., 2018)."
                                            },
                                            {
                                                "example_id": "f0ffbcd0-c32a-482a-bf6b-ee4459f23bba",
                                                "sense_id": "c7f3fe86-c1c4-3059-a615-f1b2077a7394",
                                                "text": "His feet were clad in brightly colored sneakers that made her think of the boyish side of him that often emerged when he was video gaming."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
