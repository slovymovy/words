                        ],
                        "form": "прокорми́в"
                    },
                    {
                        "form_id": "08a289c1-4f13-4acc-82bc-21bf94907179",
                        "entry_id": "3a6167a1-ea58-32a5-9dd6-544ff6fe1f21",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "прокорми́вши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "28439e01-8c78-3109-8ae0-f3d4227425fb",
                        "entry_id": "3a6167a1-ea58-32a5-9dd6-544ff6fe1f21",
                        "glosses": [
                            "предоставить кому-нибудь материальные средства для существования"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a0d981d-fcfc-4311-a315-367755a5d17a",
                                "sense_id": "28439e01-8c78-3109-8ae0-f3d4227425fb",
                                "text": "Прокормить семью."
                            },
                            {
                                "example_id": "a86fb16c-0e58-4d29-acc0-f8b5903d43a5",
                                "sense_id": "28439e01-8c78-3109-8ae0-f3d4227425fb",
                                "text": "И до вешних только дней прокорми и обогрей."
                            },
                            {
                                "example_id": "5c7514ad-85aa-4b0a-bc49-e274649fd950",
                                "sense_id": "28439e01-8c78-3109-8ae0-f3d4227425fb",
                                "text": "Я решил заняться ловлей певчих птиц; мне казалось, что это хорошо прокормит."
                            }
                        ]
                    },
                    {
                        "sense_id": "e0fbb5e7-5ad8-3e5a-a0b0-ba1f1696a609",
                        "entry_id": "3a6167a1-ea58-32a5-9dd6-544ff6fe1f21",
                        "glosses": [
                            "провести какое-нибудь определенное время, кормя кого-нибудь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0b2239c-23a8-4b93-8958-ac59d0fdcba3",
                                "sense_id": "e0fbb5e7-5ad8-3e5a-a0b0-ba1f1696a609",
                                "text": "Прокормить лошадей до вечера."
                            }
                        ]
                    },
                    {
                        "sense_id": "9a381825-96ad-33a3-9da5-bf38a364cd58",
                        "entry_id": "3a6167a1-ea58-32a5-9dd6-544ff6fe1f21",
                        "glosses": [
                            "рег. израсходовать на корм"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1247d48a-d53a-4ba1-a82b-b2ff7b9a41a1",
                                "sense_id": "9a381825-96ad-33a3-9da5-bf38a364cd58",
                                "text": "Извозчик больше прокормил, чем наездил. Прокормить все деньги."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d77184d2-071a-46f1-8ced-555646fd7b3e",
                        "source_entry_id": "3a6167a1-ea58-32a5-9dd6-544ff6fe1f21",
                        "target_lang_word": "nourrir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nourrir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6ac2ee5f-fbc4-3328-b5ef-dfa1327f90ba",
                                        "entry_id": "7d005bf0-1b4d-3589-a09d-ec6926d13f50",
                                        "glosses": [
                                            "Sustenter, servir d’aliment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e34da67-4293-4594-9499-8ed01c5db91f",
                                                "sense_id": "6ac2ee5f-fbc4-3328-b5ef-dfa1327f90ba",
                                                "text": "Les aliments propres à nourrir l’homme."
                                            },
                                            {
                                                "example_id": "1ac4008a-0314-4501-b8e3-29f091386687",
                                                "sense_id": "6ac2ee5f-fbc4-3328-b5ef-dfa1327f90ba",
                                                "text": "Cette fertile région produit tout ce qui est nécessaire pour nourrir hommes et animaux."
                                            },
                                            {
                                                "example_id": "4a24942b-ead3-43f4-b3f2-9022d1213179",
                                                "sense_id": "6ac2ee5f-fbc4-3328-b5ef-dfa1327f90ba",
                                                "text": "— Le pain nourrit beaucoup. — Certaines viandes nourrissent trop."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55e28205-399b-373d-9be3-c3c587ab9947",
                                        "entry_id": "7d005bf0-1b4d-3589-a09d-ec6926d13f50",
                                        "glosses": [
                                            "Donner des engrais, engraisser, fumer."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2fd37588-1819-442b-9735-f0d832cb1dbc",
                                                "sense_id": "55e28205-399b-373d-9be3-c3c587ab9947",
                                                "text": "Cet arbre n’a pas de quoi se nourrir dans ce sol peu fertile."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "343b33e3-18f9-3e4b-935f-2bc49e395ba7",
                                        "entry_id": "7d005bf0-1b4d-3589-a09d-ec6926d13f50",
                                        "glosses": [
                                            "Élever un nouveau-né en l’allaitant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cdc6bc0d-0e17-4937-a4d0-f7ffa6839e7c",
                                                "sense_id": "343b33e3-18f9-3e4b-935f-2bc49e395ba7",
                                                "text": "Mounira était malade depuis quelques jours. Elle devait renoncer à nourrir son bébé. Gasbieha demandait anxieusement à son amie d’enfance de chercher une nourrice."
                                            },
                                            {
                                                "example_id": "98a52d19-9f40-4f3c-b957-ee4e9ebd3946",
                                                "sense_id": "343b33e3-18f9-3e4b-935f-2bc49e395ba7",
                                                "text": "Jusqu'à la Première Guerre mondiale, la plupart de nos grands-mères – les arrière-arrière-grands-mères de notre petit-enfant – nourrissent leurs bébés, c'est-à-dire nos mères et nos pères, au sein, comme cela s'est fait depuis des millions d'années."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05e0eda6-b51f-337e-8cd0-0ef58dd56020",
                                        "entry_id": "7d005bf0-1b4d-3589-a09d-ec6926d13f50",
                                        "glosses": [
                                            "Élever un nouveau-né en l’allaitant."
                                        ],
                                        "tags": [
                                            "Absolument"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33803e50-5308-4359-b50a-e9fc15b0263a",
                                                "sense_id": "05e0eda6-b51f-337e-8cd0-0ef58dd56020",
                                                "text": "L'une d'elles, qui justement nourrissait, prit le lardon, l'enveloppa de son tablier, et, assise sur une borne, lui donna le sein."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53acb515-cdcd-3c8e-8234-9329da4d5718",
                                        "entry_id": "7d005bf0-1b4d-3589-a09d-ec6926d13f50",
                                        "glosses": [
                                            "Entretenir d’aliments."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e6388ca-ba93-4323-a197-8b1a846596ab",
                                                "sense_id": "53acb515-cdcd-3c8e-8234-9329da4d5718",
                                                "text": "Petite et misérable gargote de la rue Sainte-Geneviève où je me nourrissais jadis si mal que j’en ai, quand j’y pense, encore faim, je ne vous oublie pas […]."
                                            },
                                            {
                                                "example_id": "04cf39f8-f21f-4aa3-be3c-33166d148694",
                                                "sense_id": "53acb515-cdcd-3c8e-8234-9329da4d5718",
                                                "text": "Les biquettes se nourrissent des broussailles. Elles permettent l'entretien de la végétation de cette réserve naturelle."
                                            },
                                            {
                                                "example_id": "93c3681e-7efb-47bd-b48e-d5836883fd1d",
                                                "sense_id": "53acb515-cdcd-3c8e-8234-9329da4d5718",
                                                "text": "Les enfants sont obligés de nourrir leur père et leur mère dans le besoin."
                                            },
                                            {
                                                "example_id": "e99e0d6f-2908-4569-97bd-c4fe81675ee7",
                                                "sense_id": "53acb515-cdcd-3c8e-8234-9329da4d5718",
                                                "text": "Je lui donne tant par an pour me loger et pour me nourrir."
                                            },
                                            {
                                                "example_id": "6c93a415-840f-4c39-be93-fc7fd27e11f2",
                                                "sense_id": "53acb515-cdcd-3c8e-8234-9329da4d5718",
                                                "text": "On est bien nourri, on est mal nourri dans cette pension, dans cet hôtel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d47bce84-700e-30b8-82d5-66e3ae5f7bb2",
                                        "entry_id": "7d005bf0-1b4d-3589-a09d-ec6926d13f50",
                                        "glosses": [
                                            "Instruire, élever."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc101f76-f3f3-432a-b665-0bc7715b3560",
                                                "sense_id": "d47bce84-700e-30b8-82d5-66e3ae5f7bb2",
                                                "text": "Ce jeune homme a été nourri dans l’amour de la vertu, dans la haine du vice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "177475e7-1574-33fa-a960-5771de2447c8",
                                        "entry_id": "7d005bf0-1b4d-3589-a09d-ec6926d13f50",
                                        "glosses": [
                                            "Approvisionner de vivres."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ffa4888-b077-4bf2-a069-8588917f1e72",
                                                "sense_id": "177475e7-1574-33fa-a960-5771de2447c8",
                                                "text": "La Sicile nourrissait la Rome antique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03752073-4ebe-30ce-a251-688453b76106",
                                        "entry_id": "7d005bf0-1b4d-3589-a09d-ec6926d13f50",
                                        "glosses": [
                                            "Procurer un revenu, une rente."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1de264c3-be3f-44a1-920b-d6b8c7dcd12c",
                                                "sense_id": "03752073-4ebe-30ce-a251-688453b76106",
                                                "text": "Cette terre le nourrit, lui et toute sa famille. - Ce métier ne nourrit pas son homme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1802eb49-96a5-3d0f-8f79-be54cb57bda3",
                                        "entry_id": "7d005bf0-1b4d-3589-a09d-ec6926d13f50",
                                        "glosses": [
                                            "Produire, porter, renfermer."
                                        ],
                                        "tags": [
                                            "dated",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c59fddf7-a576-472c-9981-6891b72b6f2e",
                                                "sense_id": "1802eb49-96a5-3d0f-8f79-be54cb57bda3",
                                                "text": "L’Afrique nourrit beaucoup d’animaux féroces."
                                            },
                                            {
                                                "example_id": "cfb6db0c-98cd-467a-89d3-ff191147ec4d",
                                                "sense_id": "1802eb49-96a5-3d0f-8f79-be54cb57bda3",
                                                "text": "Cette terre nourrit une race d’hommes forts et courageux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18415274-db1c-36dc-9a1d-08527f65920f",
                                        "entry_id": "7d005bf0-1b4d-3589-a09d-ec6926d13f50",
                                        "glosses": [
                                            "Donner un aliment."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5365fee9-e8c7-45f8-8287-6dd06c08ebde",
                                                "sense_id": "18415274-db1c-36dc-9a1d-08527f65920f",
                                                "text": "Nourrir son imagination de chimères. - Il se nourrit d’idées tristes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00c304c3-e258-3729-8400-3e68c314e405",
                                        "entry_id": "7d005bf0-1b4d-3589-a09d-ec6926d13f50",
                                        "glosses": [
                                            "Entretenir ; faire subsister ; faire durer."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4ca4e2c-0f17-4537-b643-903a550bc8a5",
                                                "sense_id": "00c304c3-e258-3729-8400-3e68c314e405",
                                                "text": "Votre silence peut confirmer des doutes que je nourris depuis longtemps."
                                            },
                                            {
                                                "example_id": "0b4edcef-1873-44b8-a6cf-8e9609848bfc",
                                                "sense_id": "00c304c3-e258-3729-8400-3e68c314e405",
                                                "text": "Toute passion se nourrit de négation, parce qu’elle assume et souffre l’exception, au sens kierkegaardien du terme. Elle exile celui qui la vit."
                                            },
                                            {
                                                "example_id": "9e31d3c5-df89-4a9f-a980-031775cdd868",
                                                "sense_id": "00c304c3-e258-3729-8400-3e68c314e405",
                                                "text": "Nourrir une base de données."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa7d81bd-c93a-3705-b27d-1a7644d602cd",
                                        "entry_id": "7d005bf0-1b4d-3589-a09d-ec6926d13f50",
                                        "glosses": [
                                            "Entretenir, faire profiter de certaines choses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77d6ab97-f42b-450d-b41f-cb06c6de6b27",
                                                "sense_id": "fa7d81bd-c93a-3705-b27d-1a7644d602cd",
                                                "text": "Le bois nourrit le feu."
                                            },
                                            {
                                                "example_id": "fc6148c6-c94d-4064-8473-f7704e990017",
                                                "sense_id": "fa7d81bd-c93a-3705-b27d-1a7644d602cd",
                                                "text": "La bonne terre nourrit les plantes, les arbres. - Mettre du fumier au pied d’un arbre pour le nourrir."
                                            },
                                            {
                                                "example_id": "3273161d-7af6-49ff-8ccc-58e5b81a21c9",
                                                "sense_id": "fa7d81bd-c93a-3705-b27d-1a7644d602cd",
                                                "text": "— Nourrir un dossier d’éléments constitutifs. - Les services mutuels nourrissent l’amitié."
                                            },
                                            {
                                                "example_id": "35b19d7d-83fb-41a6-909d-bbbe72833768",
                                                "sense_id": "fa7d81bd-c93a-3705-b27d-1a7644d602cd",
                                                "text": "— L’étude, la lecture, la conversation des hommes éclairés nourrit l’esprit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f008e9d-8e49-3da2-8043-8d2352b9d073",
                                        "entry_id": "7d005bf0-1b4d-3589-a09d-ec6926d13f50",
                                        "glosses": [
                                            "Entretenir dans son esprit, un sentiment, une pensée ou un dessein."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13b1b679-e462-4dd7-9acf-f7476b17bf89",
                                                "sense_id": "5f008e9d-8e49-3da2-8043-8d2352b9d073",
                                                "text": "Mme Moreau nourrissait une haute ambition pour son fils. […]. Il aurait besoin de protections d’abord ; puis, grâce à ses moyens, il deviendrait conseiller d’État, ambassadeur, ministre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96f962b7-4984-3119-89ab-b82a1c5b78fb",
                                        "entry_id": "7d005bf0-1b4d-3589-a09d-ec6926d13f50",
                                        "glosses": [
                                            "Faire que les sons soient pleins et les soutenir pendant leur durée."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
