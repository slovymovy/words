            "senses": [
                {
                    "sense_id": "b859b797-a2ec-3943-a43d-0fd222e6d92a",
                    "sense_definition": "Relation étroite, intime ou amicale qui existe entre des personnes.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "relation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une grande <w>familiarité</w> s'est installée entre ces deux collègues après des années de travail commun."
                        },
                        {
                            "text": "Ils vivent dans une chaleureuse <w>familiarité</w> qui surprend souvent leurs invités."
                        }
                    ],
                    "synonyms": [
                        "intimité",
                        "camaraderie",
                        "proximité"
                    ],
                    "common_phrases": [
                        "vivre dans la familiarité"
                    ]
                },
                {
                    "sense_id": "c5da887a-05b1-3a64-8217-0c2995d980f9",
                    "sense_definition": "Comportement jugé trop libre, inconvenant ou irrespectueux envers quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "comportement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur n'a pas apprécié qu'un employé se permette des <w>familiarités</w> lors de la réunion."
                        },
                        {
                            "text": "Cette façon de lui taper sur l'épaule relevait d'une <w>familiarité</w> tout à fait déplacée."
                        }
                    ],
                    "synonyms": [
                        "désinvolture",
                        "hardiesse",
                        "irrévérence"
                    ],
                    "common_phrases": [
