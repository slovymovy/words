                        "sense_id": "1f0871ba-924e-3ab6-90da-ab56610f5c99",
                        "entry_id": "d99aefab-6460-3053-b253-9c6abe210e31",
                        "glosses": [
                            "Herrscher aus dem Adelsgeschlecht der Staufer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e18a14b-5b24-4285-ad44-c11b03c88429",
                                "sense_id": "1f0871ba-924e-3ab6-90da-ab56610f5c99",
                                "text": "„Alle Stauferherrscher betätigten sich als eifrige Burgenbauer, wobei neben der Anzahl vor allem Größe und Ausstattung ihrer Anlagen beeindruckten.“"
                            },
                            {
                                "example_id": "72bfb384-4650-43dd-911c-28c5aba367e6",
                                "sense_id": "1f0871ba-924e-3ab6-90da-ab56610f5c99",
                                "text": "„Barbarossa ist kein schwacher Stauferherrscher.“"
                            },
                            {
                                "example_id": "642b538e-d527-4dda-af13-c0e3e10e974a",
                                "sense_id": "1f0871ba-924e-3ab6-90da-ab56610f5c99",
                                "text": "„Anders als der Stauferherrscher Friedrich II. […] gestatten die Könige von Sizilien bzw. von Neapel aus dem Haus Anjou, Karl I. und Karl II., dem Orden die zollfreie Ausfuhr von Lebensmitteln und verzichteten auf eine Kontrolle der Waffen auf den Schiffen der Templer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
