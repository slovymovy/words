                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>minimum</w> age for obtaining a driver's license varies by country.",
                            "target_lang_translations": {
                                "ru": "<w>Минима́льный</w> возраст для получения водительских прав варьируется в зависимости от страны.",
                                "pl": "<w>Minimalny</w> wiek do uzyskania prawa jazdy różni się w zależności od kraju."
                            }
