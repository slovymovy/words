                                "target_senses": [
                                    {
                                        "sense_id": "597f8ade-3b4b-372f-ae64-a754f07b44b9",
                                        "entry_id": "01a34f77-ab7c-37f2-a971-160dd3f2a0f6",
                                        "glosses": [
                                            "nicht einer bestimmten Mode oder Epoche unterliegend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a78dff3-4442-4fc3-bbca-ad141cfb82fd",
                                                "sense_id": "597f8ade-3b4b-372f-ae64-a754f07b44b9",
                                                "text": "Es gibt Autoklassiker wie einen Porsche Spyder 550, einen Mercedes 300 SL oder einen Karmann Ghia Typ 14, die sind zeitlos schön."
                                            },
                                            {
                                                "example_id": "c3bff4f9-f429-4fe6-8952-32b317d5d1c7",
                                                "sense_id": "597f8ade-3b4b-372f-ae64-a754f07b44b9",
                                                "text": "Das Kleine Schwarze trug Audrey Hepburn in \"Frühstück bei Tiffany\", einem Film aus dem Jahr 1961. Es verkörpert zeitlose Eleganz. Denn auch heute noch wird das Kleine Schwarze gern getragen."
                                            },
                                            {
                                                "example_id": "016b0dd3-1f04-4b15-b208-d61bd78e5bee",
                                                "sense_id": "597f8ade-3b4b-372f-ae64-a754f07b44b9",
                                                "text": "Das Klassische bildet somit den zeitlosen Kontrapunkt zur zeitabhängigen Mode. Beispiel: die klassische „griechische“ Nase oder die „klassische“ Rennstrecke von 100 m."
                                            },
                                            {
                                                "example_id": "74b8289a-bc2e-4e64-9d06-b14f6d378cd3",
                                                "sense_id": "597f8ade-3b4b-372f-ae64-a754f07b44b9",
                                                "text": "Der Begriff \"Gute Form\" wurde in den 1950er Jahren geprägt und steht für ein Design, das zeitlos gültig sein sollte: Durch eine funktionelle, sachliche und trotzdem ästhetisch gültige Gestaltung sollte eine Dauerhaftigkeit der Dinge geschaffen werden, die über den modischen Zeitgeist hinausgeht."
                                            },
                                            {
                                                "example_id": "9bffd72e-9f7a-4a94-85df-385cc0e14f31",
                                                "sense_id": "597f8ade-3b4b-372f-ae64-a754f07b44b9",
                                                "text": "„Die Sehnsucht nach Tiefenerkenntnis der göttlichen Bestimmung des Menschen ist zeitlos.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
