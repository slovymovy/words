                        "entry_id": "fc8d3ca4-318a-3ea6-b91b-bb2c1ee3962c",
                        "glosses": [
                            "Système d’écriture qui utilise les concepts plutôt que les mots dans le but de l’intelligibilité universelle, qui n’est pas phonétique mais utilise des idéogrammes, comme par exemple des symboles mathématiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1e92416-4ef9-4c26-bbc5-9ce69d2d8cb1",
                                "sense_id": "0a596742-6050-314e-8eb0-18769cae3999",
                                "text": "Joseph de Maimieux définit la pasigraphie comme « l'art d'écrire à tous »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5d76bbd3-d436-4a06-bccc-cfac2db4f1d9",
