                        "examples": [
                            {
                                "example_id": "9a030321-8a39-4dff-800f-d37ed07c1195",
                                "sense_id": "c8d9d179-201e-3d94-a078-b336312158ee",
                                "text": "Quarante-deux mafiosi ont néanmoins réussi à prendre la fuite, mais les « ratissages » continuent dans l’Aspromonte (la montagne du sud calabrais, faisant office de « maquis ») et il est probable que la liste des inculpés va s’allonger."
                            },
                            {
                                "example_id": "2bdb6ffb-8497-4034-85ef-a3111309d02e",
                                "sense_id": "c8d9d179-201e-3d94-a078-b336312158ee",
                                "text": "Courir quarante-deux minutes en pratiquant le plogging, c’est-à-dire courir tout en ramassant des déchets."
                            },
                            {
                                "example_id": "8a3e47be-ed11-488c-9d37-7f133d4b0914",
                                "sense_id": "c8d9d179-201e-3d94-a078-b336312158ee",
                                "text": "Sur le front ukrainien, une roquette a frappé, mardi, un restaurant de Kramatorsk (est), faisant trois morts et quarante-deux blessés, selon un bilan provisoire de Kiev."
                            }
                        ]
                    },
