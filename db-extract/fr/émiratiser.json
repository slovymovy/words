                "senses": [
                    {
                        "sense_id": "0aeea778-336e-35eb-a825-9925966d0fe7",
                        "entry_id": "9d43ff63-e7ea-3b04-a54d-a613a59534f6",
                        "glosses": [
                            "Donner un caractère émirati à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78795ae0-6bc3-46c5-970b-cf8cfa159e30",
                                "sense_id": "0aeea778-336e-35eb-a825-9925966d0fe7",
                                "text": "Déstabiliser l’institution militaire, c’est « émiratiser » l’Afrique du Nord…"
                            },
                            {
                                "example_id": "b80dfed5-87fd-4641-93b5-64871b10c343",
                                "sense_id": "0aeea778-336e-35eb-a825-9925966d0fe7",
                                "text": "Actuellement, des dizaines de milliers de jeunes terminent leur éducation et entrent dans la vie active chaque année : il a donc fallu ’émiratiser’ l’emploi et utiliser au mieux leurs compétences."
                            },
                            {
                                "example_id": "8fa91f14-edf3-4bc4-9735-3c447ea86fc9",
                                "sense_id": "0aeea778-336e-35eb-a825-9925966d0fe7",
                                "text": "Du coup là ils se sont réveillés, ils ont réalisé qu’il fallait « émiratiser leur pays » et ils réservent des quotas dans les grandes entreprises pour les nationaux."
                            }
                        ]
                    }
