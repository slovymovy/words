                                                "sense_id": "df91d6c8-4ea6-3545-8d75-afcba9c195a9",
                                                "text": "The lower pasture also contains a pigsty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3420900e-ac79-31cb-bb50-2fa301dca20f",
                                        "entry_id": "998e8c1e-75e3-3f88-8279-35a44817a04f",
                                        "glosses": [
                                            "A dirty or very untidy place."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5e633fc-2621-40e7-86c3-8cd9841f4927",
                                                "sense_id": "3420900e-ac79-31cb-bb50-2fa301dca20f",
                                                "text": "This room is a pigsty. When are you going to clean it?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eea493b2-3b5e-4b0b-8741-35d9f85fb2a9",
                        "source_entry_id": "7712c1cf-b636-3c33-b7ec-ebe24f00d7e1",
                        "source_sense_id": "78bf9b51-37bb-3849-8e6e-ce86e88557ac",
                        "source_sense_description": "ruimte bestemd voor de huisvesting van varkens; 2. (figuurlijk) vuile boel",
                        "target_lang_word": "porcherie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "porcherie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "80fe6cbe-5c2e-31ea-8399-028a28acddbc",
                                        "entry_id": "8e155562-59ba-3ff0-ac4d-b571d57c2abe",
                                        "glosses": [
                                            "Lieu où on élève des porcs."
                                        ],
                                        "tags": [
                                            "Élevage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "498ccfc7-8313-4dc2-87d2-f11813dd3491",
                                                "sense_id": "80fe6cbe-5c2e-31ea-8399-028a28acddbc",
                                                "text": "Or, l’honnêteté m’oblige à dire que ces porcheries industrielles sont des lieux abominables, constituant une sorte d’enfer sur Terre pour les animaux qui s’y trouvent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39d4ca6d-bf54-3aa4-abdd-9bd6cd594484",
                                        "entry_id": "8e155562-59ba-3ff0-ac4d-b571d57c2abe",
                                        "glosses": [
                                            "Lieu très sale."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2df92556-6182-41f4-8591-b04e018e23b4",
                                                "sense_id": "39d4ca6d-bf54-3aa4-abdd-9bd6cd594484",
                                                "text": "Sa chambre est une véritable porcherie."
                                            },
                                            {
                                                "example_id": "b84f4c80-728e-48dc-9cb1-06b5c5fa60e7",
                                                "sense_id": "39d4ca6d-bf54-3aa4-abdd-9bd6cd594484",
                                                "text": "Encore un peu de temps et ils se rendront à l’idée suivante que, non seulement les « petits gestes » n’aident pas trop la planète, mais au contraire aident à ce que la porcherie capitaliste continue de la détruire, comme toujours quand les diversions permettent d’oublier l’essentiel et que le secondaire laisse les coudées encore plus franches au principal : « pendant que ces imbéciles ont le nez dans leurs bacs, songeons tranquillement à nos prochains modèles de voitures encore plus remplies de circuits intégrés que les précédentes »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
