                                "target_senses": [
                                    {
                                        "sense_id": "9af149d6-227a-3968-bc3e-e4d05760353b",
                                        "entry_id": "dd138cab-d92f-3cda-b2ab-2c3d94544bdb",
                                        "glosses": [
                                            "Carrefour où la circulation se fait dans un seul sens autour d’un îlot central. En France le sens giratoire est anti-horaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b5022af-748e-4203-8241-75a9b1a85e36",
                                                "sense_id": "9af149d6-227a-3968-bc3e-e4d05760353b",
                                                "text": "Le risque mortel est donc 14 fois plus élevé que pour le carrefour giratoire. Cela explique le succès et la prolifération de ces derniers qui se comptent à plus de 20 000 en France."
                                            },
                                            {
                                                "example_id": "3ba4f6ef-ec84-4f0a-bf67-52a5038555d5",
                                                "sense_id": "9af149d6-227a-3968-bc3e-e4d05760353b",
                                                "text": "La réalisation de carrefours giratoires à entrée(s) à 2 voies est liée au besoin d’écoulement de trafic qui doit être justifié par une étude de capacité."
                                            },
                                            {
                                                "example_id": "87d83e05-4c76-46fc-a711-fd1f321cd741",
                                                "sense_id": "9af149d6-227a-3968-bc3e-e4d05760353b",
                                                "text": "C'est à l'architecte français Eugène Hénard (1849-1923) du service d'architecture de la ville de Paris que nous devons le carrefour giratoire qu'il baptise à son époque \"carrefour à giration\"."
                                            }
                                        ]
                                    }
                                ]
                            }
