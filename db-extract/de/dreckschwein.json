                "senses": [
                    {
                        "sense_id": "bebe16ae-88d4-3aa3-95a9-81beb391ec94",
                        "entry_id": "f7bdb804-7f7b-35a3-8412-96d368280a60",
                        "glosses": [
                            "widerliche, abstoßende Person"
                        ],
                        "tags": [
                            "derogatory",
                            "impolite"
                        ],
                        "examples": [
                            {
                                "example_id": "bd59157f-9b82-4f70-a958-d1c880e52b2e",
                                "sense_id": "bebe16ae-88d4-3aa3-95a9-81beb391ec94",
                                "text": "„Dieser Kerl tut, was wir schon vor langer Zeit hätten tun sollen. Er schnappt sich diese Dreckschweine, die Kindern etwas antun, und legt sie um.“"
                            },
                            {
                                "example_id": "3513a2a2-ea23-4fa4-8204-577a32856298",
                                "sense_id": "bebe16ae-88d4-3aa3-95a9-81beb391ec94",
                                "text": "„Da ich seit einigen Monaten Drohanrufe erhielt, nahm ich nach zehn Uhr den Hörer nie ab: ›Wir lassen dich auffliegen, Kleiner, weil du ein Dreckschwein bist.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
