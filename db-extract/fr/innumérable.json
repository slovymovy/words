                                                "sense_id": "8dd35012-a627-359c-a6e5-f9b9f4ea2de0",
                                                "text": "There are countless stars in the sky."
                                            },
                                            {
                                                "example_id": "d9553a05-572c-44c9-b646-a52bdbe72fd8",
                                                "sense_id": "8dd35012-a627-359c-a6e5-f9b9f4ea2de0",
                                                "text": "He endured countless insults hurled at him before people finally respected him for his courage and his great ability as a baseball player."
