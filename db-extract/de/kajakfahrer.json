                ],
                "senses": [
                    {
                        "sense_id": "b7a29481-9994-3d38-8903-367415cf40ae",
                        "entry_id": "cfc6b245-c978-3f6e-b1a8-44159a7e1236",
                        "glosses": [
                            "Person, die ein Kajak fährt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea701843-6758-428f-a220-0f177903887d",
                                "sense_id": "b7a29481-9994-3d38-8903-367415cf40ae",
                                "text": "„Vor allem, wenn im Frühling die Schneeschmelze für optimalen Wasserstand sorgt, sind mehrere Hundert Kajakfahrer pro Tag auf dem Fluss und queren die innerhalb eines engen Waldtals liegende Schlucht zu Füßen von Zugspitze und Waxenstein.“"
                            },
                            {
                                "example_id": "f32070cc-b07e-4e13-abdb-352820ebe2be",
                                "sense_id": "b7a29481-9994-3d38-8903-367415cf40ae",
                                "text": "„Der versierte Kajakfahrer wird eins mit seinem Boot und kann sich in dieser neuen Einheit den Strömungen, Wirbeln und Kaskaden des Wildwassers stellen.“"
                            },
                            {
                                "example_id": "769e1df4-ff8b-4675-aa15-7331cedaafb9",
                                "sense_id": "b7a29481-9994-3d38-8903-367415cf40ae",
                                "text": "„In Frankreich wurden Berichten zufolge am Sonntag die Leichen von drei Kajakfahrern gefunden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aa2e46db-f334-4563-a861-9d782391e158",
                        "source_entry_id": "cfc6b245-c978-3f6e-b1a8-44159a7e1236",
                        "source_sense_id": "b7a29481-9994-3d38-8903-367415cf40ae",
                        "source_sense_description": "Person, die ein Kajak fährt",
                        "target_lang_word": "kayaker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kayaker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "44d6649a-8c93-333d-bdb1-db5ea8563af1",
                                        "entry_id": "b6d9bd25-74e7-3c7f-ad02-7af1069d0741",
                                        "glosses": [
                                            "One who kayaks."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5012cd2e-23e8-40ff-ae17-b112f56a98c0",
                                                "sense_id": "44d6649a-8c93-333d-bdb1-db5ea8563af1",
                                                "text": "A kayaker who was thrown from his boat and was being swept towards Teddington Weir was saved from a possible \"fatal injury\" by a brave rescue lifeboat team."
                                            },
                                            {
                                                "example_id": "01e496aa-9bf9-405e-9fc0-b3d7dd3a2ef2",
                                                "sense_id": "44d6649a-8c93-333d-bdb1-db5ea8563af1",
                                                "text": "Kayaking out in pre-dawn darkness to catch the sunrise behind Turnip Rock is a special treat for experienced kayakers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "86001dae-9629-4226-9c5f-b42e5c055fee",
                        "source_entry_id": "cfc6b245-c978-3f6e-b1a8-44159a7e1236",
                        "source_sense_id": "b7a29481-9994-3d38-8903-367415cf40ae",
                        "source_sense_description": "Person, die ein Kajak fährt",
                        "target_lang_word": "kayakeur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kayakeur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "683bd250-972a-3c16-abee-1ebd09b72453",
                                        "entry_id": "8801fd4e-4644-30bc-a239-056a706f6b6d",
                                        "glosses": [
                                            "Pagayeur qui pratique le kayak."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b483d47-fe9d-4cdf-b481-cdf455c8680f",
                                                "sense_id": "683bd250-972a-3c16-abee-1ebd09b72453",
                                                "text": "Un kayakeur expérimenté vous guidera à travers les rapides déchaînés du Zambèze."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ff801e3a-6a1e-405d-8bb3-3eecccfca547",
                        "source_entry_id": "cfc6b245-c978-3f6e-b1a8-44159a7e1236",
                        "source_sense_id": "b7a29481-9994-3d38-8903-367415cf40ae",
                        "source_sense_description": "Person, die ein Kajak fährt",
                        "target_lang_word": "kayakiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kayakiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bea05e4a-2078-3a3f-aeda-fbf8cae815a5",
                                        "entry_id": "00ddeeae-27ba-393a-91d3-ae8f5afeea3f",
                                        "glosses": [
                                            "Pagayeur qui pratique le kayak."
                                        ],
                                        "tags": [
                                            "Canoë-kayak"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "627e0a89-1066-42bc-9f01-414855d41daa",
                                                "sense_id": "bea05e4a-2078-3a3f-aeda-fbf8cae815a5",
                                                "text": "Un kayakiste doit en effet d’abord être en bonne forme physique."
                                            },
                                            {
                                                "example_id": "8996bea3-8c68-42c1-9ab5-25806443bb85",
                                                "sense_id": "bea05e4a-2078-3a3f-aeda-fbf8cae815a5",
                                                "text": "Et si vous êtes de ces pêcheurs, kayakistes, skieurs ou autres qui sont toujours à la fine pointe de la techno, vous savez très bien qu’il existe maintenant des appareils de sauvetage, de flottaison compacte, tout petits, que vous ne sentez plus une minute après les avoir attachés à votre corps."
                                            },
                                            {
                                                "example_id": "435cf530-8b10-4760-9548-0e6c52eca5eb",
                                                "sense_id": "bea05e4a-2078-3a3f-aeda-fbf8cae815a5",
                                                "text": "Après avoir décroché l’or en 2014 et 2021, et l’argent en 2009, le kayakiste français Boris Neveu a complété sa collection de médailles mondiales individuelles en slalom avec le bronze, samedi, sur le bassin d’Augsbourg, dans le sud de l’Allemagne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5cdb95bd-db5d-49b9-bc3f-4d3b7fb0ed88",
                        "source_entry_id": "cfc6b245-c978-3f6e-b1a8-44159a7e1236",
                        "source_sense_id": "b7a29481-9994-3d38-8903-367415cf40ae",
