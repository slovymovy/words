                            {
                                "example_id": "7e592449-7423-4cad-b875-e23e5f1b87bc",
                                "sense_id": "9dabdf63-1a4b-3a11-98fb-96c99f42fe90",
                                "text": "De Statenbijbel werd in 1637 uitgegeven.",
                                "translation": "La Bible officielle fut éditée en 1637."
                            },
                            {
                                "example_id": "87299649-805d-4a10-a777-0902986272d4",
                                "sense_id": "9dabdf63-1a4b-3a11-98fb-96c99f42fe90",
                                "text": "De Statenbijbel heeft op de Nederlandse taal een vrij grote invloed uitgeoefend.",
                                "translation": "La Bible officielle a exercé une assez grande influence sur la langue néerlandaise."
                            },
                            {
                                "example_id": "486ea863-dd9e-4de5-9233-717b12b16ace",
                                "sense_id": "9dabdf63-1a4b-3a11-98fb-96c99f42fe90",
                                "text": "De Statenbijbel is de eerste officiële Nederlandstalige Bijbelvertaling, die rechtstreeks uit het oorspronkelijke Hebreeuws, Aramees en Grieks werd vertaald.",
                                "translation": "La Bible des États constitue la première traduction officielle en néerlandais de la Bible, qui fut traduite directement de l’original hébreux, arménien et grec."
                            }
                        ]
