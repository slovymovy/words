                },
                {
                    "sense_id": "c6b5accd-9a23-31e3-9b1d-e53d108f5e20",
                    "sense_definition": "Bassin ou cuve qui recueille le moût ou jus de raisin au sortir du pressoir avant sa mise en tonneau.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vinification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vigneron nettoyait soigneusement l'<w>enchère</w> avant de commencer le pressurage du raisin."
                        },
                        {
                            "text": "Le moût s'écoulait directement dans l'<w>enchère</w> taillée dans la pierre de la cave."
