            "senses": [
                {
                    "sense_id": "17aca8b0-14b0-31e1-b17f-444ac77a856b",
                    "sense_definition": "The state of being officially connected or associated with a particular group or organization.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "association",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The researcher was asked to state their professional <w>affiliation</w> at the beginning of the conference.",
                            "target_lang_translations": {
                                "ru": "Исследователя попросили указать его профессиональную <w>принадлежность</w> в начале конференции.",
                                "nl": "De onderzoeker werd gevraagd aan het begin van de conferentie zijn professionele <w>affiliatie</w> te vermelden."
                            }
                        },
                        {
                            "text": "She decided to hide her political <w>affiliation</w> to remain neutral during the public debate.",
                            "target_lang_translations": {
                                "ru": "Она решила скрыть свою политическую <w>принадлежность</w>, чтобы оставаться нейтральной во время публичных дебатов.",
                                "nl": "Ze besloot haar politieke <w>gezindheid</w> te verbergen om neutraal te blijven tijdens het openbare debat."
                            }
                        }
                    ],
                    "synonyms": [
                        "association",
                        "connection",
                        "alliance",
                        "membership"
                    ],
                    "antonyms": [
                        "detachment",
                        "dissociation",
                        "separation"
                    ],
                    "common_phrases": [
