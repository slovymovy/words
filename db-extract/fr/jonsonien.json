                        "glosses": [
                            "Relatif au poète Ben Jonson."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "635fd922-2f84-429d-b368-0a2e84c9a8bd",
                                "sense_id": "7c00a3f7-060e-3786-b5b7-a56fc70faabc",
                                "text": "D’autre part, à la fin de la pièce de FLETCHER, les personnages sont ramenés à un équilibre psychique, \"déshumorisés\", à la façon jonsonienne."
                            },
                            {
                                "example_id": "27b1242b-ac83-48b1-a6ac-da99f7444000",
                                "sense_id": "7c00a3f7-060e-3786-b5b7-a56fc70faabc",
                                "text": "Je me demande si l’on doit distinguer entre humour rabelaisien et humeurs jonsoniennes."
                            },
                            {
                                "example_id": "870d2bf5-3e77-4b72-bbc2-2579c3e8ff3e",
                                "sense_id": "7c00a3f7-060e-3786-b5b7-a56fc70faabc",
                                "text": "Le nom des personnages de The School for Scandal montrent bien qu’il s’agit d’authentiques humours jonsoniens : Teazle, Surface, Bumper, Backbite, Careless, Snake, Crabtree, Sneerwell, Candour."
                            }
                        ]
                    }
