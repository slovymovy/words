                                        "sense_id": "41bba895-3a4f-35f6-81b7-ee19150a59ae",
                                        "entry_id": "ade2e11e-9a41-3c53-890e-88f2fb64b8ab",
                                        "glosses": [
                                            "An end in time; a conclusion."
                                        ],
                                        "tags": [
                                            "countable",
