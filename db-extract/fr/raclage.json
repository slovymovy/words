                "senses": [
                    {
                        "sense_id": "06dc4f8a-b969-38e3-a707-cb26613f2094",
                        "entry_id": "ae4063e6-9ca7-3d53-812e-4db8153b8afc",
                        "glosses": [
                            "Éclaircissement du bois taillis qu’on ne veut couper qu’à onze ou quinze ans."
                        ],
                        "tags": [
                            "Exploitation forestière"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "3ff88329-627f-3445-a506-150024e176ee",
                        "entry_id": "ae4063e6-9ca7-3d53-812e-4db8153b8afc",
                        "glosses": [
                            "Grattage de débris tissulaires d'une plaie. Rugination de la peau lors de certaine maladies cutanées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba5e76f2-70ae-4bfc-8551-de8fe872cdcf",
                                "sense_id": "3ff88329-627f-3445-a506-150024e176ee",
                                "text": "Cela explique que les tests effectués en médecine (prélèvement, raclage cutané, frottis…) ne sont pas toujours nécessaires en naturopathie, puisqu’il n’y a pas vraiment d’intérêt à identifier le microbe précisément."
                            }
                        ]
                    },
                    {
                        "sense_id": "f98211fb-368f-3fda-9aea-961c8f6afabb",
                        "entry_id": "ae4063e6-9ca7-3d53-812e-4db8153b8afc",
                        "glosses": [
                            "Opération de nettoyage d'une tuyauterie avec un racleur poussé à l'aide d'un fluide afin de récupérer un maximum de produit et de rendre la tuyauterie disponible pour un autre produit."
                        ],
                        "tags": [
                            "Industrie"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "e1935f3b-cd64-326e-9c10-2123eb45dd8e",
                        "entry_id": "ae4063e6-9ca7-3d53-812e-4db8153b8afc",
                        "glosses": [
                            "Action de gratter une surface pour y prélever quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2260105c-1b6f-4af6-bd6a-d4b01f59da7f",
                                "sense_id": "e1935f3b-cd64-326e-9c10-2123eb45dd8e",
                                "text": "Une demi-douzaine de lampées hâtives et j’ai engouffré ma soupe. Un petit raclage encore dans le fond de la boîte, deux coups de langue sur le bout de bois qui sert de cuiller et n’en parlons plus, jusqu’à demain."
                            }
                        ]
                    }
                ],
