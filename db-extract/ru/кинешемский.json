                "senses": [
                    {
                        "sense_id": "5d5ea7d9-fe4f-31d2-949d-738f8d2f7cc3",
                        "entry_id": "e55c1d7d-1798-3300-8342-5b08a5e584ef",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным Кинешма"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62762c17-a18f-486c-a788-f9756e5001b6",
                                "sense_id": "5d5ea7d9-fe4f-31d2-949d-738f8d2f7cc3",
                                "text": "Поручители: по жениху — кинешемский купеческий сын Галактион Иванович Миндовский и купеческий внук Пётр Дмитриевич Мочалов, по невесте — кинешемские купеческий сын Кузьма Иванович и купеческий внук Никанор Ефимович Коноваловы."
                            }
                        ]
                    },
                    {
                        "sense_id": "b2ea7a2d-903e-34dc-946a-fe51793a2122",
                        "entry_id": "e55c1d7d-1798-3300-8342-5b08a5e584ef",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным Кинешемка"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1c0c392-3625-42f8-a90f-d7f5e4d75a9b",
                                "sense_id": "b2ea7a2d-903e-34dc-946a-fe51793a2122",
                                "text": "В кинешемские воды вливаются Ястерма и Русиловка."
                            }
                        ]
                    }
