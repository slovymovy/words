                ],
                "senses": [
                    {
                        "sense_id": "138d3a3a-0bcb-32eb-87af-655d8fcdcc71",
                        "entry_id": "d54a6788-0845-3703-b16e-ed0682289a32",
                        "glosses": [
                            "middel tegen diarree"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8609f89e-dde5-4857-96c1-54aefbf24b38",
                                "sense_id": "138d3a3a-0bcb-32eb-87af-655d8fcdcc71",
                                "text": "'VLAK NA de Ronde van Nederland had ik gigantisch de schijterij gekregen. De laatste dag hadden we verkeerde kippen gegeten en ik heb me helemaal leeggescheten.Ik was toen al tegen stopmiddelen. Alles eruit, dat is het beste."
                            }
                        ]
                    },
                    {
                        "sense_id": "63e38fde-6860-3f98-9ffc-564fd2499473",
                        "entry_id": "d54a6788-0845-3703-b16e-ed0682289a32",
                        "glosses": [
                            "vulmiddel om gaatjes te stoppen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63802203-c62f-499c-b7ed-37f2235587b7",
                                "sense_id": "63e38fde-6860-3f98-9ffc-564fd2499473",
                                "text": "Het is ‘living in the fast lane’ voor veel mensen, met botox als stopmiddel om elk oneffenheidje op te vullen. Mijn ervaringen relativeren die honger naar perfectie misschien een beetje.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "fcef96ec-163c-3225-ad1f-e4d74fcff475",
                        "entry_id": "d54a6788-0845-3703-b16e-ed0682289a32",
                        "glosses": [
                            "middel dat mensen helpt om te stoppen met roken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6cffcde-c9ac-46a6-8ed2-1088c06049ed",
                                "sense_id": "fcef96ec-163c-3225-ad1f-e4d74fcff475",
                                "text": "Ondanks aanprijzingen van de tabaksindustrie dat de e-sigaret als stopmiddel is te gebruiken, is er tot nog toe geen enkel bewijs geleverd voor de effectiviteit van het middel."
                            },
                            {
                                "example_id": "231e34da-8dd5-43b8-bcff-f8f80c509d78",
                                "sense_id": "fcef96ec-163c-3225-ad1f-e4d74fcff475",
                                "text": "Rokende aanstaande moeders krijgen volgens het AD in enkele sessies van een kwartier voorlichting over de gevolgen van roken tijdens en na de zwangerschap. Ze krijgen methodes uitgereikt om als niet-roker door het leven te gaan of stopmiddelen aanbevolen."
                            }
                        ]
                    }
                ],
