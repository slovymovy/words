                            {
                                "example_id": "f9f226f5-b471-4c4c-9c42-b4fee8b64504",
                                "sense_id": "8f594b1d-06bd-3242-ad69-2565a3dc23df",
                                "text": "As they have transmitted the benefit to us, it is but reasonable we should suffer the appendant calamity."
                            }
