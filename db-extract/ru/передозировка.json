                "translations": [
                    {
                        "translation_id": "86385437-38f6-4eb8-ab3f-7ee0495d22c4",
                        "source_entry_id": "4c175056-fc40-30da-b8f9-eaf318a4975f",
                        "target_lang_word": "overdose",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "overdose",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3bbe3a02-206d-3ca1-a5fe-1431ceabb6d5",
                                        "entry_id": "7ec57bb6-01e2-3eb7-9934-5091a38c9ae2",
                                        "glosses": [
                                            "An excessive and dangerous dose of a drug."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e418543f-dbdf-4cb9-a313-deb346252fe6",
                                                "sense_id": "3bbe3a02-206d-3ca1-a5fe-1431ceabb6d5",
                                                "text": "to die of a heroin overdose"
                                            },
                                            {
                                                "example_id": "e2a02209-346d-4dbc-9c9f-1145b090b400",
                                                "sense_id": "3bbe3a02-206d-3ca1-a5fe-1431ceabb6d5",
                                                "text": "It works for a while, but when Spider-Man maneuvers him ouside the hospital room where Harry is recovering from his overdose, some part of the Goblin's brain that's still the loving father surfaces, drives him unconscious, and when next he wakes up, all memory of his being a super-villain is conveniently wiped clean."
                                            },
                                            {
                                                "example_id": "38f0d3a2-ed5e-4c33-ac91-c7fe0367fdfa",
                                                "sense_id": "3bbe3a02-206d-3ca1-a5fe-1431ceabb6d5",
                                                "text": "Drug overdoses are the leading cause of accidental death in West Virginia, and the state leads the country in fatal drug overdoses. OxyContin—nicknamed “hillbilly heroin”—is king."
                                            },
                                            {
                                                "example_id": "78a4a66f-dd79-469f-ae9a-6b8b0bbc33d9",
                                                "sense_id": "3bbe3a02-206d-3ca1-a5fe-1431ceabb6d5",
                                                "text": "After 15, 30, 60 or 90 days, the animals (n = 5 per time point for each subgroup) were sacrificed via an overdose of ketamine and xylazine hydrochloride (Vetbrands Brazil Limited, Jacareí, SP), and the hemimaxillae were removed and fixed in 10% formalin solution (Fig 1 )."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "overdose",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7e7041b3-937b-3ad3-8479-4dfb01d60ffe",
                                        "entry_id": "12847402-056b-3c44-950f-460696006dc3",
                                        "glosses": [
                                            "To dose to excess; to give an overdose, or too many doses, to someone."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e5393232-0538-30d6-8ae8-06b3ebb6858f",
                                        "entry_id": "12847402-056b-3c44-950f-460696006dc3",
                                        "glosses": [
                                            "To dose excessively, to take an overdose."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6acccd11-1b7b-4813-b3ad-b8bf75f0450a",
                                                "sense_id": "e5393232-0538-30d6-8ae8-06b3ebb6858f",
                                                "text": "Be careful not to overdose on those pills."
                                            },
                                            {
                                                "example_id": "d83fe642-426f-4c04-935e-9594ede6c9a9",
                                                "sense_id": "e5393232-0538-30d6-8ae8-06b3ebb6858f",
                                                "text": "She overdosed on cocaine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "231127f9-2397-32d0-a4d1-77bbe3c66a0d",
                                        "entry_id": "12847402-056b-3c44-950f-460696006dc3",
                                        "glosses": [
                                            "To indulge in something excessively."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5fd0ecb9-92f6-4252-8ab3-6509c58d21e7",
                                                "sense_id": "231127f9-2397-32d0-a4d1-77bbe3c66a0d",
                                                "text": "They still had Sergio Agüero to bring off the bench and the Etihad was overdosing on optimism. For the game to finish with an aggregate 5-1 score distorts the fact the occasion was full of drama and suspense until Salah’s goal conclusively changed the complexion of the evening."
                                            },
                                            {
                                                "example_id": "2976961f-e8d8-4080-b0a7-a30c559e30da",
                                                "sense_id": "231127f9-2397-32d0-a4d1-77bbe3c66a0d",
                                                "text": "Claude overdosed on smack in a Chicago flophouse three years later."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
