                "senses": [
                    {
                        "sense_id": "690b1310-345b-3b9e-b552-55715a4b95e3",
                        "entry_id": "4982792b-8682-3e51-a950-cfbaa4dc5a19",
                        "glosses": [
                            "to squeal, to screech, to yelp"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd5fd252-76d5-463e-bbd4-d936e3849b7d",
                                "sense_id": "690b1310-345b-3b9e-b552-55715a4b95e3",
                                "text": "То был прекра́сный весе́нний день. Приро́да ликова́ла; воробьи́ чири́кали; соба́ки ра́достно взви́згивали и виля́ли хвоста́ми.",
                                "translation": "It was a fine spring day. All nature was rejoicing: the sparrows chirped, the dogs yelped and wagged their tails for joy.",
                                "english": "It was a fine spring day. All nature was rejoicing: the sparrows chirped, the dogs yelped and wagged their tails for joy."
                            }
                        ]
                    }
