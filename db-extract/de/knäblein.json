                "senses": [
                    {
                        "sense_id": "9775894b-cd35-38a9-9194-f5c745457c18",
                        "entry_id": "5cb76f80-0464-3265-94fd-406db1cc8b16",
                        "glosses": [
                            "kleiner Knabe/Junge"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44449999-9cd1-470e-967a-05771a65b8b1",
                                "sense_id": "9775894b-cd35-38a9-9194-f5c745457c18",
                                "text": "„Am Abend ruhte Simen Tjing in Väsele Li's Zimmer und betrachtete dabei unaufhörlich das Knäblein.“"
                            },
                            {
                                "example_id": "1d750729-5191-43c2-b081-4f7bff940bd1",
                                "sense_id": "9775894b-cd35-38a9-9194-f5c745457c18",
                                "text": "„Falls sie einen gesunden Knäblein oder Mägdlein das Leben schenken sollte, gedachte er sie zu heiraten und mit ihr zusammenzubleiben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
