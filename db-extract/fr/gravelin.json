                "senses": [
                    {
                        "sense_id": "12002320-5d7d-3aba-bc80-b47ffde5d693",
                        "entry_id": "ff087a62-a662-37d7-bcfc-4a0c63fad0cd",
                        "glosses": [
                            "(Berry, Orléanais, Bourgogne) Banc de sable dans un cours d’eau (notamment la Loire) colonisé par le saule des vanniers."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "c2181774-9d5f-41f9-a782-e9b189149b30",
                                "sense_id": "12002320-5d7d-3aba-bc80-b47ffde5d693",
                                "text": "Le dernier débordement de la Loire a causé un dommage si exorbitant dans cette paroisse qu’elle a le plus grand intérêt à demander que l’on emploie tous les moyens qui pourront la mettre à l’abri de ce fléau destructeur ; en conséquence, elle demande la réparation et l’entretien des levées, la destruction des plantations existantes, telles que les gravelins qui obstruent le cours de la rivière."
                            }
                        ]
                    },
                    {
                        "sense_id": "fa58a7de-0358-3428-b252-48a581d1c29e",
                        "entry_id": "ff087a62-a662-37d7-bcfc-4a0c63fad0cd",
                        "glosses": [
                            "Ce saule lui-même."
                        ],
                        "tags": [
                            "broadly",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "4d2ac163-eafe-4f54-9b94-90b5aca64522",
                                "sense_id": "fa58a7de-0358-3428-b252-48a581d1c29e",
                                "text": "Gravelin (Salix viminalis), à Léré, Sancerre. Dans la région de la Loire, on désigne, sous le nom de gravelins, les îles formées par l’arrêt des sables, et qui sont en peu de temps envahies par ce saule …. Les tiges de l’année sont coupées pour confectionner des paniers et des corbeilles."
                            },
                            {
                                "example_id": "f9668281-2679-49a1-9494-78adbe6d56b3",
                                "sense_id": "fa58a7de-0358-3428-b252-48a581d1c29e",
                                "text": "24 septembre. — Le Danube, gêné dans son cours par de petites îles plantées de saules et de gravelins, devient lent et paresseux."
                            },
                            {
                                "example_id": "58934d55-f540-4e6e-ac8e-ebbbb3717b00",
                                "sense_id": "fa58a7de-0358-3428-b252-48a581d1c29e",
                                "text": "Les gravelins sont de petits saules ou des osiers qui poussent dans les grèves ou dans les graviers des cours d’eau. D’où : Les Gravelins (Mareau-aux-Prés)."
                            }
                        ]
                    }
