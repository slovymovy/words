                "senses": [
                    {
                        "sense_id": "9a263216-ffd5-3ffd-92f4-e02291ce09ec",
                        "entry_id": "dd41445a-5624-3f1f-936a-93b8b476b66e",
                        "glosses": [
                            "aus Weizen gebrautes Bier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "215372e3-bfb2-412e-aede-839b44c6da0c",
                                "sense_id": "9a263216-ffd5-3ffd-92f4-e02291ce09ec",
                                "text": "In Süddeutschland wird mehr Weizenbier als Pils getrunken."
                            },
                            {
                                "example_id": "b96d6855-bcd8-4764-a327-f44dd530b8f9",
                                "sense_id": "9a263216-ffd5-3ffd-92f4-e02291ce09ec",
                                "text": "„Als ich mich gegen halb zwölf an der Bar der Oberwelt mit einem frischen Weizenbier versorgt hatte, war es so weit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5a61ba0c-f7a1-4e5c-954a-857aa11790c9",
