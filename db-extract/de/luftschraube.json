                "senses": [
                    {
                        "sense_id": "d2bdac85-8117-37a1-9903-ee6a091c4b6a",
                        "entry_id": "f6ed001e-ed5b-37e5-bdc6-014d1983eb77",
                        "glosses": [
                            "Propeller, der bei einem Flugzeug für den Vortrieb sorgt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b089c4e-c58a-4619-86fa-2cb44090c3d2",
                                "sense_id": "d2bdac85-8117-37a1-9903-ee6a091c4b6a",
                                "text": "„Außerdem zählt eine Propellerbremse zur Ausstattung, welche die Trockenmasse um rund 22 Kilogramm erhöht. Sie verhindert das Drehen der Luftschraube im Ruhezustand.“"
                            },
                            {
                                "example_id": "0796e0d5-0237-4b3f-a1a9-79546a14130f",
                                "sense_id": "d2bdac85-8117-37a1-9903-ee6a091c4b6a",
                                "text": "„Mit ihren beiden je 5,5 Meter Durchmesser betragenden Luftschrauben (den größten der Welt) erreicht die \"Transall\" beim Ausfall eines Triebwerks bim Start nur eine Steigleistung von 30 Metern in der Minute, während die viermotorige \"Hercules\" unter denselben Bedingungen 195 Meter in der Minute steigt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
