                    },
                    {
                        "translation_id": "3bb340c9-c6a4-4ccf-a7b3-af22378607e5",
                        "source_entry_id": "a71f911f-0680-3e5b-aec8-d993ab8e2d07",
                        "source_sense_id": "79743161-fc26-390e-9146-78f1092da60f",
                        "target_lang_word": "Karbowanez",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "6c6c32ed-3aeb-4521-b2b9-76508566e114",
                        "source_entry_id": "a71f911f-0680-3e5b-aec8-d993ab8e2d07",
                        "source_sense_id": "79743161-fc26-390e-9146-78f1092da60f",
                        "target_lang_word": "карбованец",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "карбованец",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "08d470e1-dba3-3015-b61a-8b1473775023",
                                        "entry_id": "872e9aa3-4fed-3102-a44f-d4cbb521215b",
                                        "glosses": [
                                            "диал. рубль; деньги"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4afbbc1-5712-4b37-abbb-f0b5923cc79d",
                                                "sense_id": "08d470e1-dba3-3015-b61a-8b1473775023",
                                                "text": "Заветный сундук был отперт, из сундука были вынуты ― что же? карбованцы! старые, дедовские карбованцы! И эти карбованцы перешли в запачканные руки чернильных дельцов."
                                            },
                                            {
                                                "example_id": "f83a16e2-1de5-41e2-9184-15985125f3e2",
                                                "sense_id": "08d470e1-dba3-3015-b61a-8b1473775023",
                                                "text": "Ему так и виделись его карбованцы, как они, точно живые, ходят по разным рукам, в разных делах и все пасутся себе, и все плодятся."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "878735b4-d418-36c2-b830-76134bae7ab4",
                                        "entry_id": "872e9aa3-4fed-3102-a44f-d4cbb521215b",
                                        "glosses": [
                                            "истор. денежная единица Украины в 1992–1996 годах"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c129452-e471-498c-bbde-abd3c0fd100a",
                                                "sense_id": "878735b4-d418-36c2-b830-76134bae7ab4",
                                                "text": "Обмен продлится в течение двух недель, а если понадобится, то и дольше, при этом 100 тысяч карбованцев (то есть приблизительно 0,5 американского доллара) будут обмениваться на одну гривну."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
