                "senses": [
                    {
                        "sense_id": "545a0b63-dede-346a-a098-d3c3422eef91",
                        "entry_id": "ec6c200e-e369-314a-bcb5-890f981e9ec7",
                        "glosses": [
                            "hanukkiah (an eight- or more often nine-branched menorah used during Hanukkah)"
                        ],
                        "tags": [
                            "Judaism",
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "be5fbf9b-4667-472d-89a4-39f26a18ef22",
                                "sense_id": "545a0b63-dede-346a-a098-d3c3422eef91",
                                "text": "Die Chanukkia, die ich mit Georg bei unserem Flohmarktrundgang gleich am dritten oder vierten Stand entdeckt hatte, war die schönste Chanukkia, die ich jemals in meinem Leben gesehen habe.",
                                "translation": "The hanukkiah which I discovered together with Georg during our flea market tour at the third or fourth booth, was the most beautiful hanukkiah that I have ever seen in my life.",
                                "english": "The hanukkiah which I discovered together with Georg during our flea market tour at the third or fourth booth, was the most beautiful hanukkiah that I have ever seen in my life."
                            },
                            {
                                "example_id": "582e7eca-7939-4a5b-8d32-219ca924a7dc",
                                "sense_id": "545a0b63-dede-346a-a098-d3c3422eef91",
                                "text": "Heinrich Heine beschrieb 1840 die vom Licht der Chanukkias erleuchteten Fenster in der Frankfurter Judengasse, wo er abends entlangspazierte.",
                                "translation": "In 1840, Heinrich Heine described the windows in Frankfurt’s Judengasse, illuminated by the light of hanukkiahs, where he walked along in the evening.",
                                "english": "In 1840, Heinrich Heine described the windows in Frankfurt’s Judengasse, illuminated by the light of hanukkiahs, where he walked along in the evening."
                            },
                            {
                                "example_id": "6c8e5178-b5f1-4a31-be18-25640f03ae8c",
                                "sense_id": "545a0b63-dede-346a-a098-d3c3422eef91",
                                "text": "In der Tat gibt es Chanukkiot in ganz verschiedenen Formen und Größen.",
                                "translation": "Indeed, hanukkiahs come in many different shapes and sizes.",
                                "english": "Indeed, hanukkiahs come in many different shapes and sizes."
                            },
                            {
                                "example_id": "511ff41d-8235-4961-9c98-047938bd59b5",
                                "sense_id": "545a0b63-dede-346a-a098-d3c3422eef91",
                                "text": "Grzegorz Braun von der Partei Konfederacja stürmte mit einem Feuerlöscher auf den Chanukka-Leuchter zu und löschte die Kerzen der Chanukkia, die kurz zuvor entzündet worden waren."
                            }
                        ]
                    }
