            "senses": [
                {
                    "sense_id": "6a3b7cf9-3b96-3c9b-9592-1533bc3dfa53",
                    "sense_definition": "A person or animal that eats food, especially one described by how or what they eat.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "consumption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My younger brother has always been a notoriously fussy <w>eater</w> who avoids vegetables."
                        },
                        {
                            "text": "She finished her dinner last because she is naturally a very slow <w>eater</w>."
                        }
                    ],
                    "synonyms": [
                        "consumer"
                    ],
                    "common_phrases": [
                        "fussy eater",
                        "picky eater",
                        "big eater",
                        "slow eater"
                    ]
                },
                {
                    "sense_id": "d13ccd32-fcaf-346e-baeb-8984085ad506",
                    "sense_definition": "A fruit or other food item suitable for eating raw rather than cooked.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "food_classification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "These crisp red apples are great <w>eaters</w>, whereas the sour green ones are better for baking."
                        },
                        {
                            "text": "The orchard grower divided the autumn harvest into <w>eaters</w> and cookers."
                        }
                    ],
                    "synonyms": [
                        "eating apple"
                    ],
                    "antonyms": [
                        "cooker"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
