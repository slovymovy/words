{
    "word_family": [
        "killer"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0fad4b78-523b-3f4d-9454-7fc977b7ec96",
                    "sense_definition": "Van het leven beroven, vermoorden.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "doden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Katten <w>killen</w> honderd miljoen vogels per jaar.",
                            "target_lang_translations": {
                                "en": "Cats <w>kill</w> a hundred million birds a year."
                            }
                        },
                        {
                            "text": "De maffia wilde de getuige <w>killen</w> om hem het zwijgen op te leggen.",
                            "target_lang_translations": {
                                "en": "The mafia wanted to <w>kill</w> the witness to silence him."
                            }
                        }
                    ],
                    "synonyms": [
                        "doden"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Vaak informeel gebruikt, ontleend aan het Engels."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To deprive of life, to murder."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "kill",
                                "target_lang_sense_clarification": "to deprive of life"
                            },
                            {
                                "target_lang_word": "murder",
                                "target_lang_sense_clarification": "to kill intentionally"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "feb97bfd-ea0a-3915-a3e5-f95430d0ef7f",
                    "sense_definition": "Een wedstrijd definitief beslissen of winnen door de tegenstander geen kans meer te geven.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "wedstrijd_beslissen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Een wedstrijd <w>killen</w> tegen een topland is iets wat de ploeg van Caldas nog moet leren.",
                            "target_lang_translations": {
                                "en": "How to <w>kill off</w> a match against a top country is something Caldas's team still has to learn."
                            }
                        },
                        {
                            "text": "Ze kregen genoeg kansen om de wedstrijd te <w>killen</w>, maar lieten dat na.",
                            "target_lang_translations": {
                                "en": "They had enough chances to <w>seal</w> the match, but failed to do so."
                            }
                        }
                    ],
                    "common_phrases": [
                        "de wedstrijd killen"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Vooral gebruikt in sportcontexten."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To definitively decide or win a match by giving the opponent no further chance."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "kill off",
                                "target_lang_sense_clarification": "to put an end to a game or contest"
                            },
                            {
                                "target_lang_word": "seal",
                                "target_lang_sense_clarification": "to secure a victory in a match"
                            },
                            {
                                "target_lang_word": "put to bed",
                                "target_lang_sense_clarification": "to finalize or secure a game"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ae8641f6-895a-3a28-8225-e0b3c6af8216",
                    "sense_definition": "Meervoud van het zelfstandig naamwoord <w>kil</w> (een smalle watergeul).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geografie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De vissers voeren door de smalle <w>killen</w> van de rivierdelta.",
                            "target_lang_translations": {
                                "en": "The fishermen sailed through the narrow <w>channels</w> of the river delta."
                            }
                        },
                        {
                            "text": "In dit getijdengebied veranderen de <w>killen</w> voortdurend van diepte.",
                            "target_lang_translations": {
                                "en": "In this tidal area, the <w>creeks</w> constantly change in depth."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Meervoudsvorm"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Plural of the noun 'kil' (a narrow water channel or creek)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "channels",
                                "target_lang_sense_clarification": "narrow waterways or creeks"
                            },
                            {
                                "target_lang_word": "creeks",
                                "target_lang_sense_clarification": "narrow tidal inlets or streams"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}