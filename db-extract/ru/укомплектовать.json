                        "examples": [
                            {
                                "example_id": "0d6e1803-b2f1-4868-a4e0-bddf40f551d8",
                                "sense_id": "3bcbbbde-a63f-3acb-9449-9b02b6e34649",
                                "text": "Укомплектовать войсковые части."
                            },
                            {
                                "example_id": "ff1043ea-faf4-4a10-ae26-4e63a1c2a74d",
                                "sense_id": "3bcbbbde-a63f-3acb-9449-9b02b6e34649",
                                "text": "Укомплектовать областные учреждения новыми работниками."
                            },
                            {
                                "example_id": "c8a2a38b-5231-4692-8668-b29770eaca44",
                                "sense_id": "3bcbbbde-a63f-3acb-9449-9b02b6e34649",
                                "text": "Всё это надо было учесть, укомплектовать, заскладировать по очередности сборки и монтажа."
                            }
                        ]
                    },
                    {
                        "sense_id": "e87a0a31-8f89-3945-a4f7-5af55753d935",
