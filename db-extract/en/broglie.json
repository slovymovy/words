                            {
                                "target_word": "Broglie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "40090211-5776-3260-836f-4a09aa25a9c1",
                                        "entry_id": "574b829e-ed4b-38d6-91e4-c7e52c3bd7fc",
                                        "glosses": [
                                            "Nom de famille français dont la forme complète est de Broglie ^([Ins])."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15ff867f-a65b-4646-a9ca-5d6e6fd60464",
                                                "sense_id": "40090211-5776-3260-836f-4a09aa25a9c1",
                                                "text": "Peu préparé à la politique, mais d’opinions légitimistes, il se révèle politicien sans horizon. Les de Broglie et Cie n’ont pas de peine à le circonvenir."
                                            },
                                            {
                                                "example_id": "0c623a50-b812-4b5e-a728-4493102fd8de",
                                                "sense_id": "40090211-5776-3260-836f-4a09aa25a9c1",
                                                "text": "Les Broglie : Leur histoire"
                                            },
                                            {
                                                "example_id": "b6f3e1ce-0b4f-4396-a890-5f40335ff8b1",
                                                "sense_id": "40090211-5776-3260-836f-4a09aa25a9c1",
                                                "text": "Affaire Debreuil. Ça s’écrit « de Broglie », c’est des noms d’faux j’tons, ça s’écrit pas comme ça s’prononce. C’est comme les Russes, sur le maillot, y’a écrit CCCP… Au lieu d’URSS, les Mexicains, y croyaient que c’était « CourouCouCou Paloma ». Note : « Affaire de Broglie » : allusion à l’assassinat de Jean de Broglie (1921-1976)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00063662-8adf-3002-b184-76ddbd2cc0b1",
                                        "entry_id": "574b829e-ed4b-38d6-91e4-c7e52c3bd7fc",
                                        "glosses": [
                                            "Louis de Broglie (1892-1987)"
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa19590b-3c59-4d3f-8e79-032888d29122",
                                                "sense_id": "00063662-8adf-3002-b184-76ddbd2cc0b1",
                                                "text": "La théorie de De Broglie-Bohm."
                                            },
                                            {
                                                "example_id": "4afa5ecb-0045-43c2-be8f-a933c1fd423c",
                                                "sense_id": "00063662-8adf-3002-b184-76ddbd2cc0b1",
                                                "text": "L’hypothèse de De Broglie."
                                            }
                                        ]
                                    }
