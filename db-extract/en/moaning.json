                        "entry_id": "eaeecd5c-3ca4-3cff-8402-b544fd6c676b",
                        "glosses": [
                            "The utterance of a moan."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a35fa1f5-8eb6-4e8e-9b37-8174c8eeb741",
                                "sense_id": "98932318-99ff-3442-82e4-507fbd7d3bac",
                                "text": "the moanings of the wounded men"
                            },
                            {
                                "example_id": "f74987ad-373c-48f7-9480-69384b41e51a",
                                "sense_id": "98932318-99ff-3442-82e4-507fbd7d3bac",
                                "text": "But I should turn mine ears and hear\nThe moanings of the homeless sea,\n⁠The sound of streams that swift or slow\n⁠Draw down Æonian hills, and sow\nThe dust of continents to be; […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cd89e05e-205a-4d69-a731-190e3629b19f",
                        "source_entry_id": "eaeecd5c-3ca4-3cff-8402-b544fd6c676b",
                        "source_sense_id": "98932318-99ff-3442-82e4-507fbd7d3bac",
                        "source_sense_description": "the utterance of a moan",
                        "target_lang_word": "Stöhnen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stöhnen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0fcad849-2ce8-3ea5-b339-75491cabd291",
                                        "entry_id": "3e9f374f-4c80-3a7b-a040-cf36119bd9eb",
                                        "glosses": [
                                            "stöhnendes Geräusch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "898c5b08-ac55-4148-82fe-511f67506d83",
                                                "sense_id": "0fcad849-2ce8-3ea5-b339-75491cabd291",
                                                "text": "„Er hörte das Stöhnen eines Mannes, der offenbar dabei war, sich zu vergnügen, während die mütterliche Stimme einer Frau ihn anspornte.“"
                                            },
                                            {
                                                "example_id": "942f8b6d-cd46-4e9a-b870-58dafdeaae58",
                                                "sense_id": "0fcad849-2ce8-3ea5-b339-75491cabd291",
                                                "text": "„Ein Stöhnen aus dem Beiboot veranlasste ihn, sich ein, zwei Meter am Boot entlangzuhangeln und dann über den Bootsrand zu spähen, wobei er darauf achtete, das Boot zwischen sich und dem Frachtschiff in knapp 200 Metern Entfernung zu halten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2017fe77-44d9-4e15-81be-67bf3de5beb8",
                        "source_entry_id": "eaeecd5c-3ca4-3cff-8402-b544fd6c676b",
