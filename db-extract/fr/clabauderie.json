                        "entry_id": "ba972d4e-31d2-359c-b66b-a9fa86e43d6a",
                        "glosses": [
                            "Criaillerie importune et malveillante."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "d8d89b7a-d84a-4432-918b-d5a7370c2de4",
                                "sense_id": "4adc0711-0aa7-3952-9823-0906afdb6a0d",
                                "text": "Il croit l’emporter par ses clabauderies perpétuelles."
                            },
                            {
                                "example_id": "89a48aaa-8303-4ba5-a0f7-eecb64159ad4",
                                "sense_id": "4adc0711-0aa7-3952-9823-0906afdb6a0d",
                                "text": "Des pas et des voix d’homme se mêlèrent à leurs clabauderies."
                            },
                            {
                                "example_id": "ac20f756-9408-4c14-b53a-2b1871650b39",
                                "sense_id": "4adc0711-0aa7-3952-9823-0906afdb6a0d",
                                "text": "Le public aussitôt, s’imaginant qu’il [un abbé hué par les spectateurs d’un théâtre] cédait à l’orage et battait en retraite, redoubla ses clabauderies."
                            }
                        ]
                    }
