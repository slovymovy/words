                    {
                        "translation_id": "fab87342-ce55-4479-b06e-2950d1318aa9",
                        "source_entry_id": "e8cf6a4a-c77d-3872-89f5-eff07392f25c",
                        "source_sense_id": "2b94104d-68d6-318e-9774-a93faf89f4cf",
