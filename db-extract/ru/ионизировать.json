                ],
                "senses": [
                    {
                        "sense_id": "f8932ddd-617f-3db8-b6dd-de9fddb2817a",
                        "entry_id": "5ac541c8-d46b-3f8d-bf37-8e062898207f",
                        "glosses": [
                            "физ., мед. подвергать (подвергнуть) ионизации; насыщать (насытить) ионами"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79473acb-8f83-415b-94b0-2a2f2f29b51b",
                                "sense_id": "f8932ddd-617f-3db8-b6dd-de9fddb2817a",
                                "text": "Мы знаем, что он ионизи́рует воздух, накапливает электричество и озон, убивает микробов, обезвреживает яды."
                            },
                            {
                                "example_id": "eb0f10ec-8bf2-4d72-9f19-b8adf9deda7a",
                                "sense_id": "f8932ddd-617f-3db8-b6dd-de9fddb2817a",
                                "text": "Атмосферу ионизи́руют разные лучи, электризуют падающие капли воды, брызги, быстролетящая пыль и многое другое."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b8959644-0eae-41f8-8bf4-49fd547e062e",
                        "source_entry_id": "5ac541c8-d46b-3f8d-bf37-8e062898207f",
                        "source_sense_id": "f8932ddd-617f-3db8-b6dd-de9fddb2817a",
                        "target_lang_word": "ionize",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ionize",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "114d41ca-44a7-3eaa-8fda-534d9cff5e7f",
                                        "entry_id": "8ea45b9e-4078-3502-a27b-4b9354e83b6c",
                                        "glosses": [
                                            "To dissociate atoms or molecules into electrically charged species; to be thus dissociated."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7fd66377-ca0d-4500-b199-14ed07dee323",
                        "source_entry_id": "5ac541c8-d46b-3f8d-bf37-8e062898207f",
                        "source_sense_id": "f8932ddd-617f-3db8-b6dd-de9fddb2817a",
                        "target_lang_word": "ionisieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ionisieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a1555265-a837-3a58-a7f5-3f3aa177f7a5",
                                        "entry_id": "0d212d99-83d9-3b41-9c93-4a054244e1ef",
                                        "glosses": [
                                            "ein oder mehrere Elektronen zu einem Atom oder Molekül hinzufügen oder entfernen und damit den elektrischen Ladungszustand verändern"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b278651-6e2b-4151-b4ca-02a394f7616a",
                                                "sense_id": "a1555265-a837-3a58-a7f5-3f3aa177f7a5",
                                                "text": "„Diese energetischen geladenen Teilchen können das Zählgas eines Detektors, eine Art moderner Geigerzähler, ionisieren.“"
                                            },
                                            {
                                                "example_id": "cdc129cf-410f-4de3-aeff-876d5685158c",
                                                "sense_id": "a1555265-a837-3a58-a7f5-3f3aa177f7a5",
                                                "text": "Dagegen werden wir Neutronenstrahlen, die sehr wohl ionisieren, nicht als ionisierende Strahlung bezeichnen, weil ihre Hauptwirkung im Anstoßen von Atomkernen besteht, die ihrerseits ionisieren; die Ionisation ist dann ein sekundärer Prozess."
                                            },
                                            {
                                                "example_id": "bc20cc92-5183-4149-9ffa-58ae6f9bcdab",
                                                "sense_id": "a1555265-a837-3a58-a7f5-3f3aa177f7a5",
                                                "text": "Bei Strahlung ionisieren Alpha- und Betateilchen die Atome der von ihnen durchquerten Substanzen und erzeugen meist Kationen."
                                            },
                                            {
                                                "example_id": "cd018799-37e2-45a8-a280-b1325d1c1c36",
                                                "sense_id": "a1555265-a837-3a58-a7f5-3f3aa177f7a5",
                                                "text": "Auch Gammastrahlen können Atome ionisieren."
                                            },
                                            {
                                                "example_id": "698e17c7-3c3f-44e8-8e49-f1c471e3c6dd",
                                                "sense_id": "a1555265-a837-3a58-a7f5-3f3aa177f7a5",
                                                "text": "Die Gasatome vermögen durch ihre eigene kinetische Energie andere durch Stoß zu ionisieren (Stoßionisation)."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
