                "senses": [
                    {
                        "sense_id": "d7a0792c-21e9-3478-ad1f-807550de3807",
                        "entry_id": "8421f49a-8397-3a53-9d68-30d35b457a04",
                        "glosses": [
                            "ein Abdruck in Form eines Engels, der durch das Ausstrecken eines menschlichen Körpers und die durch dessen Gewicht und das Hin- und Herbewegen der Arme und Beine verursachte Komprimierung bzw. Verdrängung des Schnees auf einer Schneedecke entsteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e83ae9f1-69e0-4969-9897-dca82166121a",
                                "sense_id": "d7a0792c-21e9-3478-ad1f-807550de3807",
                                "text": "Die durch die Arme erzeugten Abdrücke stellen die Flügel, die der Beine das Gewand des Schneeengels dar."
                            },
                            {
                                "example_id": "f861596a-19f3-452d-ad94-254c04f43db2",
                                "sense_id": "d7a0792c-21e9-3478-ad1f-807550de3807",
                                "text": "„In einer Indoor-Winterlandschaft im Osten Bangkoks wirbeln Maschinen frischen Kunstschnee auf die Pisten voll entzückter Einheimischer, die sich im Skifahren versuchen oder mit Armen und Beinen Schneeengel in das kalte Weiß drücken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
