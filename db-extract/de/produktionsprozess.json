                "senses": [
                    {
                        "sense_id": "2bb4326e-373d-38dd-98e5-c8aaeeddcb13",
                        "entry_id": "b5d32027-9b5b-32b9-800c-4c06a0eb7465",
                        "glosses": [
                            "Vorgang der Produktion"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b781de06-71fe-49f4-9ae3-d327878217df",
                                "sense_id": "2bb4326e-373d-38dd-98e5-c8aaeeddcb13",
                                "text": "Während eines Produktionsprozesses fallen oft unerwünschte Nebenprodukte an."
                            },
                            {
                                "example_id": "13ec7396-bc30-42d4-9040-5462587d0a87",
                                "sense_id": "2bb4326e-373d-38dd-98e5-c8aaeeddcb13",
                                "text": "„Zunächst kauften die Briten einfach auf, was ihnen angeboten wurde. Dann griffen sie immer stärker in den Produktionsprozess ein und drangen dabei ins Innere des Landes vor.“"
                            }
                        ],
