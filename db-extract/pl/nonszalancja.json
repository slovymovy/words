                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "249d6504-6ce9-417b-9851-7fc08e9a7a15",
                                                "sense_id": "8c4c8330-6a59-36a7-af11-dbb8e8c6c65f",
