                                            {
                                                "example_id": "0c5f4708-57ba-4430-9202-757ab4807fab",
                                                "sense_id": "80fda838-de37-33c6-8a70-e8c70907900e",
                                                "text": "Trasę prowadzącą przez siodło często wybierają przemytnicy."
