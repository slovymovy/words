                        "examples": [
                            {
                                "example_id": "7d00776e-c78e-4fb3-99af-ddeee887cb08",
                                "sense_id": "028b50c3-7c87-39ab-b615-8a913de44cb5",
                                "text": "De film Star Wars: The Force Awakens is hard op weg het grootste filmsucces ooit te worden. Na vannacht is het de film met de hoogste omzet ooit. Het oude omzetrecord van ruim 760 miljoen dollar van Avatar in 2009, sneuvelde."
                            },
                            {
                                "example_id": "bfda56b1-4bcd-4af8-90d6-2de6c011fad4",
                                "sense_id": "028b50c3-7c87-39ab-b615-8a913de44cb5",
                                "text": "Wild, vis, ijs, kerstbrood met spijs, toastjes en salades. Dat zijn naar verwachting de hardlopers komende weken in de supermarkt. Marktonderzoeker GfK verwacht voor het elfde jaar op rij een omzetrecord in de twee weken voorafgaand aan Kerstmis: 740 miljoen euro. Dat is - ondanks de economische malaise - toch weer een procentje meer dan in 2012."
                            }
                        ]
