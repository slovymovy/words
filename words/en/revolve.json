{
    "word_family": [
        "revolution",
        "revolutionary",
        "revolver",
        "revolvable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "69d15fac-9504-3044-95c7-2780a75778c9",
                    "sense_definition": "To orbit a central point, especially of a celestial body.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "orbiting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The Earth <w>revolves</w> around the sun once every year.",
                            "target_lang_translations": {
                                "ru": "Земля <w>вращается</w> вокруг Солнца один раз в год."
                            }
                        },
                        {
                            "text": "Astronomers studied how the newly discovered planet <w>revolves</w> around its star.",
                            "target_lang_translations": {
                                "ru": "Астрономы изучили, как вновь открытая планета <w>обращается</w> вокруг своей звезды."
                            }
                        }
                    ],
                    "synonyms": [
                        "orbit",
                        "circle"
                    ],
                    "common_phrases": [
                        "revolve around the sun"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вращаться вокруг центральной точки, особенно о небесном теле."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вращаться",
                                "target_lang_sense_clarification": "вокруг центральной точки или по орбите"
                            },
                            {
                                "target_lang_word": "обращаться",
                                "target_lang_sense_clarification": "по орбите вокруг небесного тела"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "83de25b4-2063-3455-b511-31a2ca8515e2",
                    "sense_definition": "To rotate around an axis.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "rotation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The Earth <w>revolves</w> once every twenty-four hours on its axis.",
                            "target_lang_translations": {
                                "ru": "Земля <w>вращается</w> вокруг своей оси каждые двадцать четыре часа."
                            }
                        },
                        {
                            "text": "The wheels began to <w>revolve</w> slowly as the train pulled out of the station.",
                            "target_lang_translations": {
                                "ru": "Колеса начали медленно <w>крутиться</w>, когда поезд тронулся со станции."
                            }
                        }
                    ],
                    "synonyms": [
                        "rotate",
                        "spin",
                        "turn"
                    ],
                    "common_phrases": [
                        "revolve on its axis"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вращаться вокруг собственной оси."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вращаться",
                                "target_lang_sense_clarification": "вокруг своей оси"
                            },
                            {
                                "target_lang_word": "крутиться",
                                "target_lang_sense_clarification": "совершать круговые движения"
                            },
                            {
                                "target_lang_word": "вертеться",
                                "target_lang_sense_clarification": "находиться в круговом движении"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e71bf78b-9b55-335c-a968-0f6d894cf40e",
                    "sense_definition": "To cause something to turn around a central point.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "rotation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mechanism <w>revolves</w> the platform to show the car from all angles.",
                            "target_lang_translations": {
                                "ru": "Механизм <w>вращает</w> платформу, чтобы показать автомобиль со всех сторон."
                            }
                        },
                        {
                            "text": "You can <w>revolve</w> the display stand manually to see the other items.",
                            "target_lang_translations": {
                                "ru": "Вы можете <w>поворачивать</w> выставочный стенд вручную, чтобы рассмотреть другие товары."
                            }
                        }
                    ],
                    "synonyms": [
                        "rotate",
                        "spin",
                        "turn"
                    ],
                    "common_phrases": [
                        "revolve the wheel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приводить в движение вокруг центральной точки; вращать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вращать",
                                "target_lang_sense_clarification": "заставлять крутиться"
                            },
                            {
                                "target_lang_word": "поворачивать",
                                "target_lang_sense_clarification": "крутить в разные стороны"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fa45e270-7da0-3ecf-b53b-f94ba642f24d",
                    "sense_definition": "To move in order or sequence.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The program <w>revolves</w> through all the queues before returning to the start.",
                            "target_lang_translations": {
                                "ru": "Программа <w>циклически проходит</w> по всем очередям перед возвращением к началу."
                            }
                        },
                        {
                            "text": "The duty roster <w>revolves</w> through each team member weekly.",
                            "target_lang_translations": {
                                "ru": "График дежурств <w>чередуется</w> между всеми членами команды каждую неделю."
                            }
                        }
                    ],
                    "synonyms": [
                        "cycle",
                        "rotate"
                    ],
                    "common_phrases": [
                        "revolve through the sequence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигаться по кругу, чередоваться в определенной последовательности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чередоваться",
                                "target_lang_sense_clarification": "сменять друг друга по кругу"
                            },
                            {
                                "target_lang_word": "циклически меняться",
                                "target_lang_sense_clarification": "проходить по кругу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c2d039f2-5b7c-335f-a341-f0f0e602fbec",
                    "sense_definition": "To ponder on; to reflect repeatedly upon; to consider all aspects of.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "thinking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He sat silent for hours, <w>revolving</w> many thoughts in his mind.",
                            "target_lang_translations": {
                                "ru": "Он сидел молча часами, <w>прокручивая</w> в голове множество мыслей."
                            }
                        },
                        {
                            "text": "She spent the evening <w>revolving</w> the difficult decision before making her choice.",
                            "target_lang_translations": {
                                "ru": "Она провела вечер, <w>обдумывая</w> трудное решение, прежде чем сделать свой выбор."
                            }
                        }
                    ],
                    "synonyms": [
                        "ponder",
                        "contemplate",
                        "meditate",
                        "mull over"
                    ],
                    "common_phrases": [
                        "revolve thoughts in mind"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often literary or formal in modern usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обдумывать, мысленно прокручивать, рассматривать со всех сторон."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обдумывать",
                                "target_lang_sense_clarification": "мысленно рассматривать со всех сторон"
                            },
                            {
                                "target_lang_word": "прокручивать",
                                "target_lang_sense_clarification": "мысленно возвращаться к мыслям"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cbb59ac9-96ab-3f44-ad3e-a239194e04cb",
                    "sense_definition": "To read through, to study (a book, author etc.).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "thinking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent his years <w>revolving</w> the ancient texts to find the hidden meaning.",
                            "target_lang_translations": {
                                "ru": "Он провел годы, <w>изучая</w> древние тексты в поисках скрытого смысла."
                            }
                        },
                        {
                            "text": "The scholar would <w>revolve</w> the law and prophets day and night.",
                            "target_lang_translations": {
                                "ru": "Ученый день и ночь <w>штудировал</w> закон и пророков."
                            }
                        }
                    ],
                    "synonyms": [
                        "study",
                        "peruse"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is archaic and rarely used today"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Изучать, перечитывать, углубляться в изучение книг или авторов (архаичное)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изучать",
                                "target_lang_sense_clarification": "внимательно читать и исследовать"
                            },
                            {
                                "target_lang_word": "штудировать",
                                "target_lang_sense_clarification": "тщательно изучать тексты"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eecf92b5-7aa0-36de-a4e6-f8f376f008c9",
                    "sense_definition": "To bring back into a particular place or condition; to restore.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "restoration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old laws were <w>revolved</w> to their former authority after the rebellion.",
                            "target_lang_translations": {
                                "ru": "Старые законы были <w>восстановлены</w> в своей прежней силе после восстания."
                            }
                        },
                        {
                            "text": "They sought to <w>revolve</w> the estate to its original owner.",
                            "target_lang_translations": {
                                "ru": "Они стремились <w>вернуть</w> поместье его первоначальному владельцу."
                            }
                        }
                    ],
                    "synonyms": [
                        "restore",
                        "revert"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "This sense is obsolete"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Возвращать в прежнее состояние или место; восстанавливать (устаревшее)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "восстанавливать",
                                "target_lang_sense_clarification": "возвращать в прежнее состояние"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9a9500f0-c36e-3ab6-8d64-cef873f85442",
                    "sense_definition": "The rotating section of a stage in a theater.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "theater_scenery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The actors stood on the <w>revolve</w> as the scene transitioned seamlessly.",
                            "target_lang_translations": {
                                "ru": "Актеры стояли на <w>поворотном круге</w>, пока сцена плавно менялась."
                            }
                        },
                        {
                            "text": "The stage crew had to repair the motor that turned the heavy <w>revolve</w>.",
                            "target_lang_translations": {
                                "ru": "Рабочим сцены пришлось чинить мотор, который вращал тяжелый <w>поворотный круг</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "revolving stage"
                    ],
                    "common_phrases": [
                        "on the revolve"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Mainly used in theatrical contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Поворотный круг сцены в театре."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поворотный круг",
                                "target_lang_sense_clarification": "вращающаяся часть сцены"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4c4ce83c-758c-389e-b4a8-fb2fca1f472f",
                    "sense_definition": "The rotation of part of the scenery within a theatrical production.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "theater_scenery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dramatic <w>revolve</w> of the set revealed a completely different location.",
                            "target_lang_translations": {
                                "ru": "Эффектный <w>поворот</w> декораций открыл совершенно другое место действия."
                            }
                        },
                        {
                            "text": "During the musical, each <w>revolve</w> was timed perfectly with the music.",
                            "target_lang_translations": {
                                "ru": "Во время мюзикла каждое <w>вращение</w> сцены было идеально синхронизировано с музыкой."
                            }
                        }
                    ],
                    "synonyms": [
                        "rotation",
                        "turn"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Mainly used in theatrical contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вращение декораций во время театрального представления."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вращение",
                                "target_lang_sense_clarification": "поворот сцены или декораций"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9655a2fc-b1fd-3d60-ba3c-12056abfe9c1",
                    "sense_definition": "A radical change; a <w>revolution</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden political <w>revolve</w> caught the entire nation by surprise.",
                            "target_lang_translations": {
                                "ru": "Внезапный политический <w>переворот</w> застал врасплох всю страну."
                            }
                        },
                        {
                            "text": "They feared a social <w>revolve</w> that would overturn the established order.",
                            "target_lang_translations": {
                                "ru": "Они боялись социального <w>переворота</w>, который разрушит установленный порядок."
                            }
                        }
                    ],
                    "synonyms": [
                        "revolution",
                        "turnabout"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "This sense is obsolete"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Радикальное изменение; переворот (устаревшее)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переворот",
                                "target_lang_sense_clarification": "резкое изменение"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}