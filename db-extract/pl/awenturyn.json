                "senses": [
                    {
                        "sense_id": "2bd0cf63-79f5-3ba1-b5b9-8f8b9c31fd1b",
                        "entry_id": "7bd9265c-4197-343f-a2bb-72e5e335f72a",
                        "glosses": [
                            "rzadki minerał z gromady krzemianów, odmiana kwarcu, SiO₂"
                        ],
                        "tags": [],
