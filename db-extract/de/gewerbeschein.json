                        "target_lang_word": "licence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "licence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "904420d1-f310-3e0b-a3c4-f7b2f5f6562a",
                                        "entry_id": "2894af0d-26be-331f-a9e4-9d6f02d1b784",
                                        "glosses": [
                                            "Permission :"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5fdd3d28-8c6d-3677-8ca5-b27c57009edf",
                                        "entry_id": "2894af0d-26be-331f-a9e4-9d6f02d1b784",
                                        "glosses": [
                                            "Permission :",
                                            "Permission."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fce12695-8183-4dd9-be63-b945ecc43bb3",
                                                "sense_id": "5fdd3d28-8c6d-3677-8ca5-b27c57009edf",
                                                "text": "Ah ! cette ville imbécile et mortelle […]. Elle prend des aspects de nécropole où les macchabées folâtres auraient licence de grimacer et de gesticuler sous un ciel putride, gonflé comme un égout."
                                            },
                                            {
                                                "example_id": "4c108913-122d-42a0-9ee8-0c8ada0ad40e",
                                                "sense_id": "5fdd3d28-8c6d-3677-8ca5-b27c57009edf",
                                                "text": "Pour ce soir, je te donne licence de débiter tes sornettes."
                                            },
                                            {
                                                "example_id": "93a76dd5-33e4-4add-b251-9e69d04891a2",
                                                "sense_id": "5fdd3d28-8c6d-3677-8ca5-b27c57009edf",
                                                "text": "Il lui était sans limites donné licence de mettre en pièces et en sang la modestie, la pureté, la pudeur et les avilir sous lui à sa guise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "748fb65b-1fb2-3c55-acd2-85ad96f1a67a",
                                        "entry_id": "2894af0d-26be-331f-a9e4-9d6f02d1b784",
                                        "glosses": [
                                            "Permission :",
                                            "Permission spéciale, accordée par le gouvernement, pour exporter ou pour vendre certaines marchandises."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "111803b9-73fa-4280-b8e7-cae2640716ea",
                                                "sense_id": "748fb65b-1fb2-3c55-acd2-85ad96f1a67a",
                                                "text": "Il obtint une licence pour expédier du vin en pays étranger."
                                            },
                                            {
                                                "example_id": "5887f705-81eb-45c8-9d77-ee0bb534c030",
                                                "sense_id": "748fb65b-1fb2-3c55-acd2-85ad96f1a67a",
                                                "text": "Licence pour le débit du tabac en détail."
                                            },
                                            {
                                                "example_id": "3c85d58f-2d21-4a89-b9c2-00b7a606968d",
                                                "sense_id": "748fb65b-1fb2-3c55-acd2-85ad96f1a67a",
                                                "text": "Un nouveau cabaret ne peut ouvrir sans une licence."
                                            },
                                            {
                                                "example_id": "aebe850a-c062-4af2-9715-8226ad8913fa",
                                                "sense_id": "748fb65b-1fb2-3c55-acd2-85ad96f1a67a",
                                                "text": "Je vous affirme que je pense aux licences d'importation et à la prime de transport. La question vitale pour cette région."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32543824-438f-30a8-bcb6-5d943946702c",
                                        "entry_id": "2894af0d-26be-331f-a9e4-9d6f02d1b784",
                                        "glosses": [
                                            "Permission :",
                                            "Document exprimant officiellement cette permission."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76f4291a-4796-44aa-82a4-78761b63ed7b",
                                                "sense_id": "32543824-438f-30a8-bcb6-5d943946702c",
                                                "text": "Lors de l'importation effective, l'importateur est tenu de produire sa licence d'importation approuvée ou une copie de ladite licence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16ad63bd-5b04-310d-b189-372a4bf629de",
                                        "entry_id": "2894af0d-26be-331f-a9e4-9d6f02d1b784",
                                        "glosses": [
                                            "Licence sportive :"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3149728e-757b-3596-b81b-6dcc215ee690",
                                        "entry_id": "2894af0d-26be-331f-a9e4-9d6f02d1b784",
                                        "glosses": [
                                            "Licence sportive :",
                                            "Autorisation de pratiquer un sport et de participer aux compétitions dans le cadre d'une fédération sportive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78d9f8af-f5a0-40e9-b797-b4d10b814d60",
                                                "sense_id": "3149728e-757b-3596-b81b-6dcc215ee690",
                                                "text": "La Fédération Française de Football propose à ses clubs d'effectuer les démarches de demandes de licence intégralement en ligne.."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93cf94d3-e87b-3f56-b9b6-88c7babacaad",
                                        "entry_id": "2894af0d-26be-331f-a9e4-9d6f02d1b784",
                                        "glosses": [
                                            "Licence sportive :",
                                            "Carte de membre d'une fédération."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c72dcde9-b23b-43c4-abb5-6e60ec135bfc",
                                                "sense_id": "93cf94d3-e87b-3f56-b9b6-88c7babacaad",
                                                "text": "1° être français, muni de la licence tir à la cible, délivrée par la fédération française de tir au titre du « Tir National de Versailles » (règlement du Tir National de Versailles)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8302d7f-8459-3bd8-a9ab-fc265d028734",
                                        "entry_id": "2894af0d-26be-331f-a9e4-9d6f02d1b784",
                                        "glosses": [
                                            "Degré qui est entre celui de bachelier et celui de docteur dans les facultés de lettres, de sciences, de droit."
                                        ],
                                        "tags": [
                                            "France"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "501c3c11-2d84-40c7-a057-5f77f974912f",
                                                "sense_id": "f8302d7f-8459-3bd8-a9ab-fc265d028734",
                                                "text": "C’est un lieutenant qui me demande. Au temps où il préparait la licence, il a connu à Louis-le-grand, mes camarades et désire me parler d’eux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02512fb7-54e0-3c7f-b308-8eeeef0d0212",
                                        "entry_id": "2894af0d-26be-331f-a9e4-9d6f02d1b784",
                                        "glosses": [
                                            "Liberté que l'on s'accorde :"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2f97e5ff-bdb5-3a4c-bcae-f4895222ba61",
                                        "entry_id": "2894af0d-26be-331f-a9e4-9d6f02d1b784",
                                        "glosses": [
                                            "Liberté que l'on s'accorde :",
                                            "Liberté trop grande, contraire au respect, à la retenue et à la modestie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f1e21f6-59ab-4adb-8579-4dfcf8244f88",
                                                "sense_id": "2f97e5ff-bdb5-3a4c-bcae-f4895222ba61",
                                                "text": "C’est un homme qui se donne de grandes licences."
                                            },
                                            {
                                                "example_id": "36e43262-1e88-4214-bdef-93689b7e75fa",
                                                "sense_id": "2f97e5ff-bdb5-3a4c-bcae-f4895222ba61",
                                                "text": "Prendre bien des licences avec quelqu’un."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4eceb659-4e5d-3ac1-8817-fd0cfa089424",
                                        "entry_id": "2894af0d-26be-331f-a9e4-9d6f02d1b784",
                                        "glosses": [
                                            "Liberté que l'on s'accorde :",
                                            "Liberté excessive, dérèglement, insubordination."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f4a2fe9-7f16-4698-af6f-3efe122ed25d",
                                                "sense_id": "4eceb659-4e5d-3ac1-8817-fd0cfa089424",
                                                "text": "La licence des mœurs."
                                            },
                                            {
                                                "example_id": "2a7aee1b-3a73-43b4-a2a5-9d41188fc901",
                                                "sense_id": "4eceb659-4e5d-3ac1-8817-fd0cfa089424",
                                                "text": "Une licence effrénée."
                                            },
                                            {
                                                "example_id": "12afa67c-9853-4a41-80b9-b796cd09c6f6",
                                                "sense_id": "4eceb659-4e5d-3ac1-8817-fd0cfa089424",
                                                "text": "Réprimer la licence."
                                            },
                                            {
                                                "example_id": "482b9be9-6dbf-4337-8d27-198a5087a0b7",
                                                "sense_id": "4eceb659-4e5d-3ac1-8817-fd0cfa089424",
                                                "text": "Agir ainsi, c’est ouvrir la porte à la licence."
                                            },
                                            {
                                                "example_id": "17d17cbc-ebd1-46ce-a9dc-1f6047e13192",
                                                "sense_id": "4eceb659-4e5d-3ac1-8817-fd0cfa089424",
                                                "text": "La licence n’a plus de frein, n’a plus de bornes."
                                            },
                                            {
                                                "example_id": "54e7c8ea-004d-4073-a4e0-3f36d90107fb",
                                                "sense_id": "4eceb659-4e5d-3ac1-8817-fd0cfa089424",
                                                "text": "Une liberté qui dégénère en licence."
                                            },
                                            {
                                                "example_id": "e883d787-3d12-48ec-b629-48e6fc69b177",
                                                "sense_id": "4eceb659-4e5d-3ac1-8817-fd0cfa089424",
                                                "text": "Qu'il nous conjure de ne pas jouer le jeu fatal de la licence et, osons dire le mot, de l'immoralité, c'est dans notre intérêt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86c9b412-7072-30e4-981e-efd9f9a5d4e4",
                                        "entry_id": "2894af0d-26be-331f-a9e4-9d6f02d1b784",
                                        "glosses": [
                                            "Liberté que l'on s'accorde :",
                                            "Toute liberté que le poète se donne dans ses vers contre la règle et l’usage ordinaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d22a1193-5faf-43d1-acf5-c9f0b2d894ba",
                                                "sense_id": "86c9b412-7072-30e4-981e-efd9f9a5d4e4",
                                                "text": "Licence poétique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c77ebe02-49cd-377d-bfdf-83cbf2e2af48",
                                        "entry_id": "2894af0d-26be-331f-a9e4-9d6f02d1b784",
                                        "glosses": [
                                            "Permission contractuelle :"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8d2ae2a8-fc8f-3e65-a5da-ec18955cb94d",
                                        "entry_id": "2894af0d-26be-331f-a9e4-9d6f02d1b784",
                                        "glosses": [
                                            "Permission contractuelle :",
                                            "Autorisation contractuelle donnée par le titulaire d'un brevet d'en exploiter le contenu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c80b6fc-810e-433e-8ca7-e0dace02e465",
                                                "sense_id": "8d2ae2a8-fc8f-3e65-a5da-ec18955cb94d",
                                                "text": "Le plus souvent appliqué aux brevets et aux inventions, aux logiciels et au domaine informatique, les champs du contrat de licence sont larges (www.captaincontrat.com)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a70db087-67ef-3478-a3b8-460345b34453",
                                        "entry_id": "2894af0d-26be-331f-a9e4-9d6f02d1b784",
                                        "glosses": [
                                            "Permission contractuelle :",
                                            "Contrat ou déclaration par lequel le titulaire des droits d’un logiciel autorise un tiers (ou l'ensemble des tiers autorisés) vis-à-vis de l’usage, de la distribution ou de la modification. (S'utilise aussi pour des non-logiciels, pas forcément numérisés, pourvu que leur utilisation nécessite des droits d'auteur)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
