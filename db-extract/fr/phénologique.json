                "senses": [
                    {
                        "sense_id": "c5c1a0c9-7327-39dc-a079-fd0610c30ff2",
                        "entry_id": "b0300ef8-6015-37ce-a219-125d61fae1b7",
                        "glosses": [
                            "Relatif à la phénologie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "202a21f2-f6db-4365-946c-9049a8d5a649",
                                "sense_id": "c5c1a0c9-7327-39dc-a079-fd0610c30ff2",
                                "text": "L’O.N.M. peut, sur simple demande, adresser des fiches phénologiques aux particuliers, qui, en compensation s’engagent à les retourner remplies de leur mieux, courant décembre."
                            },
                            {
                                "example_id": "af859ae0-a228-4cb3-b612-c14f28199d10",
                                "sense_id": "c5c1a0c9-7327-39dc-a079-fd0610c30ff2",
                                "text": "Le stade phénologique de la plante au moment de l'infection et la sensibilité relative de la variété influencent l'importance des dégâts."
                            },
                            {
                                "example_id": "e5597db9-9e6b-4bf2-9c69-97345474693b",
                                "sense_id": "c5c1a0c9-7327-39dc-a079-fd0610c30ff2",
                                "text": "Il s’agit notamment d’envisager des variétés de vignes et de porte-greffe plus résistants à la chaleur et à la sécheresse, ainsi qu’un mode de culture permettant de réguler son développement phénologique."
                            }
                        ]
                    }
