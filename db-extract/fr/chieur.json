                    },
                    {
                        "sense_id": "6832409d-f384-3c57-989d-a7e72c02a35f",
                        "entry_id": "cace77b1-d7d3-37e2-a369-8cd8f5a3ed3c",
                        "glosses": [
                            "Celui qui fait chier."
                        ],
                        "tags": [
                            "figuratively",
                            "offensive",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "1d6fdb8a-7626-4912-a02b-c2e37999d8cf",
                                "sense_id": "6832409d-f384-3c57-989d-a7e72c02a35f",
                                "text": "Vous sous-estimez votre rang, et je suis pour une absolue hiérarchie, mais à l'extérieur. Il n'est pas bon que vous soyez trop fraternels avec des chieurs."
                            },
                            {
                                "example_id": "38458211-4d7d-44cc-95fb-9d69d1728e41",
                                "sense_id": "6832409d-f384-3c57-989d-a7e72c02a35f",
                                "text": "Pour prévenir toute intervention intempestive du service d'ordre, Kimdall utilisa le langage universel pour se débarrasser des chieurs : elle entrouvrit son manteau et montra son colt. Les plantons la laissèrent passer sans moufter."
                            },
                            {
                                "example_id": "ab8ac4fd-338f-401e-b2c4-a0287924eb31",
                                "sense_id": "6832409d-f384-3c57-989d-a7e72c02a35f",
                                "text": "Il est aussi correspondant de la CIA et jouit au sein de sa hiérarchie d’une solide réputation de cinglé et de chieur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9c7f9948-c966-4b3a-8a39-46046a2e0f66",
                        "source_entry_id": "cace77b1-d7d3-37e2-a369-8cd8f5a3ed3c",
                        "target_lang_word": "Nervensäge",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nervensäge",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e45b2699-2d99-34e1-af51-59968c741a7a",
                                        "entry_id": "fffcfdcc-0075-3ec2-a3ab-2cf6b81b85c3",
                                        "glosses": [
                                            "Person, die man nur schwer ertragen kann, weil sie einem „auf die Nerven geht“"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c10fcd0-d2e8-41fd-a9ac-f63851fe4202",
                                                "sense_id": "e45b2699-2d99-34e1-af51-59968c741a7a",
                                                "text": "Du bist heute wieder eine richtige Nervensäge."
                                            },
                                            {
                                                "example_id": "4897ecae-16f0-46f6-9b2c-f4bd7ed34ed8",
                                                "sense_id": "e45b2699-2d99-34e1-af51-59968c741a7a",
                                                "text": "„Hoffentlich kommt die blöde Nervensäge nicht auf die Idee, mir von hinten eine Kugel in den Kopf zu jagen, dachte Wilson.“"
                                            },
                                            {
                                                "example_id": "47b43966-6d21-4d7d-a5ed-fc1710297dac",
                                                "sense_id": "e45b2699-2d99-34e1-af51-59968c741a7a",
                                                "text": "„Die Nummern der schlimmsten Nervensägen habe ich eingespeichert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "26a8dffd-60b1-4244-98d2-72eae4a4aba3",
                        "source_entry_id": "cace77b1-d7d3-37e2-a369-8cd8f5a3ed3c",
                        "target_lang_word": "Arschloch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Arschloch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e71fb8ef-67a3-35b1-9ac5-86faf41c1b50",
                                        "entry_id": "c9f79665-cfeb-3575-b28b-3865b36963b4",
                                        "glosses": [
                                            "After"
                                        ],
                                        "tags": [
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a0dc9b1-ca86-4d2a-9155-372a8f3f1160",
                                                "sense_id": "e71fb8ef-67a3-35b1-9ac5-86faf41c1b50",
                                                "text": "„Jetzt sieht er mir ins Arschloch rein / Doch ich bleib tapfer und halte ein.“"
                                            },
                                            {
                                                "example_id": "14bb712f-1035-413d-a662-726fc0b500ac",
                                                "sense_id": "e71fb8ef-67a3-35b1-9ac5-86faf41c1b50",
                                                "text": "„Machen durfte man das bestimmt nicht, aber ich zog mir hinten die Backen auseinander und versuchte, das Arschloch von Claudia zu erkennen, die mit dem Rücken zu mir stand und ihre eigenen Arschbacken auseinanderzog.“"
                                            },
                                            {
                                                "example_id": "cefd5136-4ca0-4b11-b291-cce2986246ea",
                                                "sense_id": "e71fb8ef-67a3-35b1-9ac5-86faf41c1b50",
                                                "text": "„Er überredete ihn zum Onanieren und ließ sich für eine Krone die berühmte Erektion ins Arschloch stecken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e110c078-fe77-3934-b8fe-334749ff533e",
                                        "entry_id": "c9f79665-cfeb-3575-b28b-3865b36963b4",
                                        "glosses": [
                                            "Schimpfwort"
                                        ],
                                        "tags": [
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c6629c2-5a0a-4289-becb-f533e266f129",
                                                "sense_id": "e110c078-fe77-3934-b8fe-334749ff533e",
                                                "text": "„Du hast nie gelernt dich zu artikulieren und deine Freundin, die hat niemals für dich Zeit. Oh, Arschloch, Arschloch, Arschloch!“"
                                            },
                                            {
                                                "example_id": "3564c511-a021-4158-9ec6-33889c1b27b8",
                                                "sense_id": "e110c078-fe77-3934-b8fe-334749ff533e",
                                                "text": "„Mit Verlaub, Herr Präsident, Sie sind ein Arschloch.“"
                                            },
                                            {
                                                "example_id": "c9181e84-70b0-4768-b05f-bcc2bdf76ea3",
                                                "sense_id": "e110c078-fe77-3934-b8fe-334749ff533e",
                                                "text": "„Die Zeit verwandelt sie in Arschlöcher, die nur darauf warten, die Waffe zu ziehen.“"
                                            },
                                            {
                                                "example_id": "20e644a6-647a-4243-9b96-71bf8c6b52f3",
                                                "sense_id": "e110c078-fe77-3934-b8fe-334749ff533e",
                                                "text": "„Alles in allem, diese Sendung versammelte wieder einmal nichts als Arschlöcher.“"
                                            },
                                            {
                                                "example_id": "805d9dc2-4fef-471f-8285-2691fee44463",
                                                "sense_id": "e110c078-fe77-3934-b8fe-334749ff533e",
                                                "text": "„Aber gewinnen damit nicht letztlich eben doch die Arschlöcher, und die Anständigen können schauen, wo sie bleiben? ‹Das stimmt nicht!›, ruft Sutton fröhlich. Ein Arschloch zu sein, lohne sich nur kurzfristig – längerfristig zahle es sich nicht aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "23edd412-bb71-48ab-aff1-7dd97127564b",
