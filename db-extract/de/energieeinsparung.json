                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "энергосбережение",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b33fc725-e56a-394c-8aa3-79b2ef46d01d",
                                        "entry_id": "c0f66605-bf14-3960-99ad-b4f11f739ab1",
                                        "glosses": [
                                            "экономное потребление энергии"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85169dac-eed1-4682-89ea-52d9378cb409",
                                                "sense_id": "b33fc725-e56a-394c-8aa3-79b2ef46d01d",
                                                "text": "На предприятиях действует эффективная система морального и материального стимулирования энергосбержения. Постоянно повышается ответственность и заинтересованность руководящих и инженерно-технических работников, коллективов в целом за бережное расходование топлива и энергии, максимальное вовлечение в оборот вторичных энергоресурсов."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
