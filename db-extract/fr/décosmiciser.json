                ],
                "senses": [
                    {
                        "sense_id": "4eebc670-b955-3bce-a2cf-b432e981e7b4",
                        "entry_id": "6a2135a5-e159-36d3-937b-e8762298d4b5",
                        "glosses": [
                            "Faire perdre son caractère cosmique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89375237-2b40-4f26-ac47-d1d33423d2cd",
                                "sense_id": "4eebc670-b955-3bce-a2cf-b432e981e7b4",
                                "text": "Objectiver le corps, cela signifie à la fois le désacraliser, le décosmiciser, et le désocialiser."
                            },
                            {
                                "example_id": "12ba11c7-731d-4d52-8395-d6a52afd57fd",
                                "sense_id": "4eebc670-b955-3bce-a2cf-b432e981e7b4",
                                "text": "Goetz qualifie également un espace disloqué d’espace « décosmicisé », soit « un espace sans axe pour communiquer avec le ciel, un espace littéralement désastré » (2002, p.32)."
                            },
                            {
                                "example_id": "6cecc7cf-5661-4ac7-a0e6-829c27a271f0",
                                "sense_id": "4eebc670-b955-3bce-a2cf-b432e981e7b4",
                                "text": "D’un point de vue absolu (c’est-à-dire \"décosmicisé\"), aucune des deux alternatives ne recueille plus de crédibilité."
                            }
                        ]
                    }
                ],
