                        "tags": [
                            "plural"
                        ],
                        "form": "prébiotiques"
                    },
                    {
                        "form_id": "29c533b5-a7fe-4abc-a073-34e298804d6b",
                        "entry_id": "24988987-964e-3d94-bc64-aa7b0af7c9b1",
                        "tags": [],
                        "form": "pré-biotique"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fa227e42-e2fd-384c-8d10-9fab2a939092",
                        "entry_id": "24988987-964e-3d94-bc64-aa7b0af7c9b1",
                        "glosses": [
                            "Nutriment non digéré directement par l’être humain ou plus largement les mammifères, mais qui stimule l’activité et la croissance de la flore bactérienne intestinale."
                        ],
                        "tags": [
                            "Nutrition"
                        ],
                        "examples": [
                            {
                                "example_id": "d5c90438-c1a1-4935-97ba-82b663e22d75",
                                "sense_id": "fa227e42-e2fd-384c-8d10-9fab2a939092",
                                "text": "Les prébiotiques contenus dans les fibres des fruits et légumes nourrissent les « bonnes » bactéries intestinales et les aident à se reproduire. Ce sont des « glucides » ou sucres complexes naturels non digérés par le tube digestif haut qui ne sont pas source d’énergie pour nos cellules mais pour les bactéries de notre flore intestinale."
                            },
                            {
                                "example_id": "e293af2d-8392-45fe-8cae-b1ceb249a683",
                                "sense_id": "fa227e42-e2fd-384c-8d10-9fab2a939092",
                                "text": "Le principal prébiotique sur le marché est le fructo-oligo-saccharide (FOS)."
                            },
                            {
                                "example_id": "b17340e6-967c-4ff9-8ee4-165622b927e5",
                                "sense_id": "fa227e42-e2fd-384c-8d10-9fab2a939092",
                                "text": "L’inuline est un prébiotique extrait de la racine de chicorée."
                            }
                        ]
                    }
                ],
