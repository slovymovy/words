                        "glosses": [
                            "gebouw met een tentoonstelling met zaken die betrekking hebben op foto's, fotografen en alle andere zaken die te maken hebben met fotografie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2febcb9e-a9b9-4799-aed3-7ec5d6590f91",
                                "sense_id": "99168181-733c-35cb-aa52-4f4f7fb145f9",
                                "text": "Museum Boijmans van Beuningen, Museum TwentseWelle en fotografiemuseum FOAM krijgen als eerste musea geld van het nieuwe Blockbusterfonds. De instellingen gaan met het geld onder meer tentoonstellingen organiseren."
                            },
                            {
                                "example_id": "abe508f2-5897-4845-9b59-a988459dc0ae",
                                "sense_id": "99168181-733c-35cb-aa52-4f4f7fb145f9",
                                "text": "In het Fotografiemuseum Amsterdam FOAM is een overzichtstentoonstelling te zien van het fotografenduo Inez van Lamsweerde en Vinoodh Matadin. De twee behoren tot de weinige kunstenaars die de grens tussen mode en kunst met succes weten te overschrijden en tegelijkertijd in beide vakgebieden werkzaam zijn gebleven."
                            }
                        ]
                    }
