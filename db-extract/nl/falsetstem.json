                "senses": [
                    {
                        "sense_id": "88c08964-8f72-376d-a37b-b00c08edce8e",
                        "entry_id": "41294203-faa0-3478-ac00-5d2e32112832",
                        "glosses": [
                            "een manier van zingen waarbij hoge noten kunnen worden 'bereikt'"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f6db1dc-b8a7-48b1-8c62-4033baae3d29",
                                "sense_id": "88c08964-8f72-376d-a37b-b00c08edce8e",
                                "text": "‘Night-Heron’ springt eruit, omdat het minder zachtaardig klinkt. De staccato piano’s in de break en de falsetstem aan het eind tillen het nummer op, en zorgen zo voor een mooie afwisseling in de liedjes, waarin soms eenvormigheid dreigt."
                            },
                            {
                                "example_id": "f9fe89a7-3f60-4dd7-bf5e-1c2a5eb5b778",
                                "sense_id": "88c08964-8f72-376d-a37b-b00c08edce8e",
                                "text": "De Britse soulpopzanger Sam Smith weet doorvoelde liedjes van particulier hartzeer iets universeels mee te geven. Daarbij schiet zijn stem in falsetstand, een beetje zijn handelsmerk, die bij een hoog volume echter de neiging heeft schel en een tikje schreeuwerig te worden."
                            }
                        ]
                    }
                ],
