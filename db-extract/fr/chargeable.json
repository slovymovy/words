                                "example_id": "495a21d4-4f2f-4217-a166-ff284181bbc7",
                                "sense_id": "d194385e-852e-3cfe-add7-1c77d5cc1fba",
                                "text": "Benne 30 m3 avec pieds rétractables, chargeable sur camion. Très utilisée par les déménageurs."
                            },
