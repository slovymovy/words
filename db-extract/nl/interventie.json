                                        "entry_id": "1a718c5d-6ffd-3905-8bfd-d6f085b29bdc",
                                        "glosses": [
                                            "The action of intervening; interfering in some course of events."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9a492ee-c3ad-46eb-8241-149c117ae576",
                                                "sense_id": "755cf7f6-f573-3556-b7e6-1bc3be5f5ea5",
                                                "text": "Fernando Torres was recalled in place of the suspended Didier Drogba and he was only denied a goal in the opening seconds by Laurent Koscielny's intervention - a moment that set the tone for game filled with attacking quality and littered with errors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3bd45d83-887e-3368-af8b-0fb04b5db8e7",
                                        "entry_id": "1a718c5d-6ffd-3905-8bfd-d6f085b29bdc",
                                        "glosses": [
                                            "A legal motion through which a person or entity who has not been named as a party to a case seeks to have the court order that they be made a party."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
