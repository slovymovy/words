                "senses": [
                    {
                        "sense_id": "7b8ffbcf-3b44-323a-82bc-6aa1fc6a52a2",
                        "entry_id": "d688eace-2d7b-3e4a-a258-ae7878472388",
                        "glosses": [
                            "durch Kerzen beleuchtet, von Kerzenschein erhellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "776815ba-42a3-4ef0-b3ad-d7caa8a57545",
                                "sense_id": "7b8ffbcf-3b44-323a-82bc-6aa1fc6a52a2",
                                "text": "„Der Oberkellner und zwei Schwarze Anzüge traten an jeden kerzenbeleuchteten Tisch heran und sprachen leise mit den Gästen.“"
                            },
                            {
                                "example_id": "fb44f879-02a7-43cf-bc75-cacdfc8886d8",
                                "sense_id": "7b8ffbcf-3b44-323a-82bc-6aa1fc6a52a2",
                                "text": "„Camerons Sohlen glitten über den Boden, zur Eishöhle hinaus, in die angrenzende kerzenbeleuchtete Kammer hinein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
