                                        "sense_id": "adf5e110-1576-3f31-8eca-bfa51fd6cb0c",
                                        "entry_id": "6ef0feda-5b0b-36cf-91f7-cfb58aaefd37",
                                        "glosses": [
                                            "A stabbing weapon, similar to a sword but with a short, double-edged blade."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1bb6aed6-dd9a-43d7-ba40-ce805402282c",
                                                "sense_id": "adf5e110-1576-3f31-8eca-bfa51fd6cb0c",
                                                "text": "The dagger, under the title cultellum and misericorde, has been the constant companion of the sword, at least from the days of Edward I. and is mentioned in the statute of Winchester."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27d8dfaa-9cf2-3191-9522-83b51bd095d0",
                                        "entry_id": "6ef0feda-5b0b-36cf-91f7-cfb58aaefd37",
                                        "glosses": [
                                            "The typographical mark †."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1fd59921-5ef8-3a27-a3ca-8c1e7cbfd1fd",
                                        "entry_id": "6ef0feda-5b0b-36cf-91f7-cfb58aaefd37",
                                        "glosses": [
                                            "A point scored near the end of the game (clutch time) to take or increase the scorer's team lead, so that they are likely to win."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd14770f-0437-4a1a-99c9-67b136979caa",
                                                "sense_id": "1fd59921-5ef8-3a27-a3ca-8c1e7cbfd1fd",
                                                "text": "His last-minute 3-point dagger silenced the criticism for his so-called failure to come up big in big moments."
                                            }
                                        ]
                                    }
                                ]
                            },
