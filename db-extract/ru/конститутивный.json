                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d66b074-572b-425d-8cba-19388959cfe3",
                                                "sense_id": "1e065cc6-7fb2-3100-80cf-6bbf3e28c8bd",
                                                "text": "Der 35-S-Promotor ist konstitutiv aktiv."
