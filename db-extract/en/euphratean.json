                        "glosses": [
                            "Of or pertaining to the Euphrates river."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "2989eae0-4d71-4d3b-b56a-c0e6cb04eaea",
                                "sense_id": "3e1c8e6d-51d0-3400-8a26-fc6c414d5b2f",
                                "text": "Very little is known about it, and there is very little to know, till the limit of Arabia be passed and the Euphratean delta reached."
                            },
                            {
                                "example_id": "29e36336-2322-401a-b377-ccd9c03a9136",
                                "sense_id": "3e1c8e6d-51d0-3400-8a26-fc6c414d5b2f",
                                "text": "To those who would not heed the gently flowing stream of Shiloah he spoke by means of the Euphratean flood."
                            },
                            {
                                "example_id": "643ea6a3-d3a5-4ca2-81a2-a71554c56f4a",
                                "sense_id": "3e1c8e6d-51d0-3400-8a26-fc6c414d5b2f",
                                "text": "Some have viewed the two houses of Judah and Israel \"apart like two palms standing solitary and apart on the great Euphratean plain, but they are to be brought near to one another by Ezekiel's ministry, so they will become again as 'one tree.'\""
                            }
                        ]
                    }
