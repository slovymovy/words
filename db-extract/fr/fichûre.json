                            {
                                "example_id": "df3338d8-7f0e-404d-a3d1-e42dffa8b3ae",
                                "sense_id": "683293cc-b67d-370c-90c4-098b67124f63",
                                "text": "Faisons en outre défenses aux pêcheurs qui se servent d’engins appellés fichûres, de prendre les poissons enfermés dans les filets tendus dans les étangs salés. (Ordonn. août 1681)"
                            },
