        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "8eacfd8b-3cd4-311e-9bce-b620733c5dcc",
                "word": "horizontalism",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "561df3a8-7fa0-30b6-9fab-902d07975768",
                        "entry_id": "8eacfd8b-3cd4-311e-9bce-b620733c5dcc",
                        "glosses": [
                            "A political or social theory or system that advocates the equitable distribution of power in a society."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "fa917e34-5648-4848-ac03-01997602f765",
                                "sense_id": "561df3a8-7fa0-30b6-9fab-902d07975768",
                                "text": "Horizontalism is not described as an ideology but as a relationship—a way of relating to one another in a directly democratic way while at the same time continually creating through the process of discovery."
                            },
                            {
                                "example_id": "0ef4b9e6-e3f0-4405-958a-ff956da51372",
                                "sense_id": "561df3a8-7fa0-30b6-9fab-902d07975768",
                                "text": "The accounts Sitrin gathered from the direct participation in the Argentine uprising demonstrate that for many, horizontalism was perhaps an anti-ideological ideology composed of a fluid mixture of flexible, participatory, non-dogmatic values and practices oriented around consensus, federalism, and self-management."
                            }
                        ]
                    },
                    {
                        "sense_id": "ac42f559-919f-31aa-a226-3c4f9fa2beb0",
                        "entry_id": "8eacfd8b-3cd4-311e-9bce-b620733c5dcc",
                        "glosses": [
                            "An approach to money creation theory pioneered by Basil Moore which states that private bank reserves are not managed by central banks."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "69d28d9c-e846-417e-8762-4cc071673ce4",
                                "sense_id": "ac42f559-919f-31aa-a226-3c4f9fa2beb0",
                                "text": "Indeed, it has been said that in horizontalism, commercial banks lend to all who demand credit."
                            }
                        ]
                    }
                ],
