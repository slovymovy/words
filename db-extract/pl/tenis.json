                                "target_senses": [
                                    {
                                        "sense_id": "6f44bf8e-f79d-3776-8c8e-5d0c7d83293e",
                                        "entry_id": "856b1505-5881-3bf8-b0bd-20f0f0905ca4",
                                        "glosses": [
                                            "A sport played by two players (or four in doubles), who alternately strike the ball over a net using racquets."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7885a4c3-8335-4c15-a735-dca6e1893d7c",
                                                "sense_id": "6f44bf8e-f79d-3776-8c8e-5d0c7d83293e",
                                                "text": "“Anthea hasn't a notion in her head but to vamp a lot of silly mugwumps. She's set her heart on that tennis bloke[…]whom the papers are making such a fuss about.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1a4543e-2418-3a96-883f-7cb58c710c1c",
                                        "entry_id": "856b1505-5881-3bf8-b0bd-20f0f0905ca4",
                                        "glosses": [
                                            "A match in this sport."
                                        ],
                                        "tags": [
                                            "dated",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d6fddb2-5fe0-498c-8b12-0e01cfe6276b",
                                                "sense_id": "b1a4543e-2418-3a96-883f-7cb58c710c1c",
                                                "text": "We go about to parties in the daytime as usual, teas and tennises[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "971f86b7-1aa8-3a6a-a5e9-807eb198aa0b",
                                        "entry_id": "856b1505-5881-3bf8-b0bd-20f0f0905ca4",
                                        "glosses": [
                                            "An earlier game in which a ball is driven to and fro, or kept in motion by striking it with a racquet or with the open hand."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8590638-50cc-4ae2-871d-36695307447e",
                                                "sense_id": "971f86b7-1aa8-3a6a-a5e9-807eb198aa0b",
                                                "text": "tennis-balls"
                                            },
                                            {
                                                "example_id": "d8842bfb-04e8-4f4e-9f57-cfde0944104a",
                                                "sense_id": "971f86b7-1aa8-3a6a-a5e9-807eb198aa0b",
                                                "text": "His easy bow, his good stories, his style of dancing and playing tennis, […] were familiar to all London."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tennis",
