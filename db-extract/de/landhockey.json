                "senses": [
                    {
                        "sense_id": "6f9cba9f-5f5e-3f61-99ed-9923b1407992",
                        "entry_id": "110a43b4-37f5-3d5e-a2eb-9cfc2fc2fae5",
                        "glosses": [
                            "eine Ballsportart, die auf festem, nicht gefrorenem Boden mit Schlägern gespielt wird"
                        ],
                        "tags": [
                            "Austrian German",
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "91f6ac5e-fdbc-434b-8eba-efc55b91d8d9",
                                "sense_id": "6f9cba9f-5f5e-3f61-99ed-9923b1407992",
                                "text": "„Bedenkt man, dass Österreich im Landhockey erst heuer bei der WM in Lissabon den Aufstieg in die Division A schaffte, wäre es durchaus vermessen, die Qualifikation zu verlangen, sagte Teamchef Ruoss.“"
                            },
                            {
                                "example_id": "a75c2c9e-b7b9-4784-b6fe-fdc878d7fdd7",
                                "sense_id": "6f9cba9f-5f5e-3f61-99ed-9923b1407992",
                                "text": "„Allerdings geht es im Landhockey kompakter zu, der Titelträger wurde binnen vier Tagen ermittelt.“"
                            },
                            {
                                "example_id": "5a161d45-2a04-4901-b603-220b26ac90fb",
                                "sense_id": "6f9cba9f-5f5e-3f61-99ed-9923b1407992",
                                "text": "„In England wechselte sie zum Landhockey und rückte das Skifahren weit in den Hintergrund.“"
                            },
                            {
                                "example_id": "bc486a85-9e04-4c89-bd52-b6ccb261ce65",
                                "sense_id": "6f9cba9f-5f5e-3f61-99ed-9923b1407992",
                                "text": "„Nach der Schule habe er in Indien Landhockey gespielt und versucht, einen Job zu bekommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
