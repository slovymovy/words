    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "a31578b6-ebb0-32c2-ab9f-8e73c3a35d1a",
                "word": "allotheism",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "48f4bc4e-b5f6-39b3-b2d0-30286c61a8ec",
                        "entry_id": "a31578b6-ebb0-32c2-ab9f-8e73c3a35d1a",
                        "glosses": [
                            "Worship of a god or gods that are foreign to one's own land."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a744ae43-7e1d-483c-85a5-39f297cb5466",
                                "sense_id": "48f4bc4e-b5f6-39b3-b2d0-30286c61a8ec",
                                "text": "I consider that in the first commandment where atheism and polytheism and allotheism are forbidden directly and principally."
                            },
                            {
                                "example_id": "8ece11d6-4ea6-46bb-bbdd-36e3772cbfcd",
                                "sense_id": "48f4bc4e-b5f6-39b3-b2d0-30286c61a8ec",
                                "text": "But we should not forget that the world was yet too young to have arrived at the rigid and sharply-defined systems of polytheism or allotheism to which we are accustomed."
                            },
                            {
                                "example_id": "6a048a2d-e049-45ef-84b8-fb9de633a9c9",
                                "sense_id": "48f4bc4e-b5f6-39b3-b2d0-30286c61a8ec",
                                "text": "The inhabitants, also, of Ur had fallen into polytheism, or, if we may so speak, allotheism, the worship of other gods."
                            },
                            {
                                "example_id": "e277e221-9552-43c4-8b8f-0192ab6d0bae",
                                "sense_id": "48f4bc4e-b5f6-39b3-b2d0-30286c61a8ec",
                                "text": "There is no allotheism in Islam. Muslims do not anthropomorphise or, conversely, encourage belief in anthropolatry."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
