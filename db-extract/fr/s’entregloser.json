                ],
                "senses": [
                    {
                        "sense_id": "5b9bf864-d98d-3574-9547-80c6a5da616e",
                        "entry_id": "04353b1a-ec65-3995-b1b7-e13e0d2cc8e7",
                        "glosses": [
                            "Se gloser, s’interpréter l’un l’autre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab789c46-2430-4705-9f9a-4bf626ff282a",
                                "sense_id": "5b9bf864-d98d-3574-9547-80c6a5da616e",
                                "text": "La pensée vive y a été étouffée sous un amoncellement d’études qui se répètent et s’entreglosent à l’infini."
                            },
                            {
                                "example_id": "2b4abc98-49d1-4f44-b2b8-0386619b6f06",
                                "sense_id": "5b9bf864-d98d-3574-9547-80c6a5da616e",
                                "text": "Comme nous en prévenait déjà Montaigne, «il y a plus affaire à interpreter les interpretations qu’à interpreter les choses, et plus de livres sur les livres que sur tout autre subject : nous ne faisons que nous entregloser» (Essais, III, XIII)."
                            },
                            {
                                "example_id": "8137e19c-7984-4dd1-8113-d4862ce45fef",
                                "sense_id": "5b9bf864-d98d-3574-9547-80c6a5da616e",
                                "text": "En vikingnologie, il existe un savoir constitué par les spécialistes qui s’entreglosent."
                            }
                        ]
                    }
                ],
