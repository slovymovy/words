                        "entry_id": "28631086-fef2-3f68-9d03-35b223d76ac5",
                        "glosses": [
                            "Produit cosmétique pour activer la desquamation de la couche superficielle de l'épiderme."
                        ],
                        "tags": [
                            "Cosmétologie"
                        ],
                        "examples": [
                            {
                                "example_id": "6520db77-e5a9-4e86-a7c5-9e3b5db4fea3",
                                "sense_id": "7a9a5d98-10ea-3dc0-98b1-b2047b1abe25",
                                "text": "Applique un exfoliant sur un gant ou dans ta main et frotte doucement : les petits grains décollent les cellules mortes agrégées à la surface de ta peau."
                            },
                            {
                                "example_id": "c89b0e5b-69b7-4b01-86b1-8fb8ab06b056",
                                "sense_id": "7a9a5d98-10ea-3dc0-98b1-b2047b1abe25",
                                "text": "Pour confectionner un exfoliant maison, mélangez de l'huile d'olive et une poignée de sel de mer. Utilisez cette préparation comme gommage pour le corps."
                            }
                        ]
                    }
