                    {
                        "translation_id": "abf4518d-3a5d-4aea-b07a-ad30472058e9",
                        "source_entry_id": "4a9d11da-b795-33c4-a77f-aec4ece4f71b",
                        "source_sense_id": "d12d9186-ba15-36c5-abbe-e14486013a77",
                        "source_sense_description": "An excess of words",
