                        "translation_id": "e451a12e-1c0f-4815-90af-d2286186002e",
                        "source_entry_id": "ead296fd-8e19-3b9a-a33e-659c0eaebac1",
                        "source_sense_id": "51a58d9f-330f-3a34-bb3c-57c35a1fda0f",
