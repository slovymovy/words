                "senses": [
                    {
                        "sense_id": "4e37ea32-b9de-3b94-a776-e296dfe32f9d",
                        "entry_id": "4ecae944-c30a-3cbe-8220-90a8caa7ce85",
                        "glosses": [
                            "Prendre un caractère de cumulus, en parlant de nuages."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "243a1d94-9913-4250-8f5c-0d37679be470",
                                "sense_id": "4e37ea32-b9de-3b94-a776-e296dfe32f9d",
                                "text": "En journée, les nuages ont tendance à cumulifier sur nos reliefs et laissent échapper quelques averses de neige sporadiques, averses peut-être plus fréquentes sur le Pilat en liaison avec un talweg dépressionnaire sur le sud-ouest de la France."
                            },
                            {
                                "example_id": "cda3c259-53d0-45f9-87f9-a959893ef520",
                                "sense_id": "4e37ea32-b9de-3b94-a776-e296dfe32f9d",
                                "text": "Ça peut aussi \"cumulifier\" dans le Massif central."
                            },
                            {
                                "example_id": "03af9d58-363a-493e-9eae-67e68369b860",
                                "sense_id": "4e37ea32-b9de-3b94-a776-e296dfe32f9d",
                                "text": "Les nuages commençaient à se cumulifier en d’énormes tours, mais, insensible à ce spectacle grandiose, il filait droit sur Phnom Penh."
                            }
                        ]
                    }
                ],
