                        "sense_id": "2ffff07d-1820-3eec-b8d9-3d0bc1a7b9e2",
                        "entry_id": "4b5a78fd-26c9-3be8-bed5-e85b8581f2a1",
                        "glosses": [
                            "Relative ou relatif ou partisan·e de l’accélérationnisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f467b3f-c411-481a-9227-4743daf878f1",
                                "sense_id": "2ffff07d-1820-3eec-b8d9-3d0bc1a7b9e2",
                                "text": "« Les habitants seront comme des clients de supermarché. S’ils ne sont pas satisfaits, ils ne vont pas se mettre à discuter avec le gérant, ils vont aller voir ailleurs », explique Nick Land, un philosophe britannique qui a inspiré le courant dit « accélérationniste » avant de s’installer en Chine, où il s’est converti aux idées néoréactionnaires."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2003bb34-3d28-41d7-8b48-6c38d0379739",
                        "source_entry_id": "4b5a78fd-26c9-3be8-bed5-e85b8581f2a1",
                        "source_sense_id": "2ffff07d-1820-3eec-b8d9-3d0bc1a7b9e2",
                        "target_lang_word": "accelerationist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "accelerationist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4213257a-1600-3ae1-bba5-066052e7e6db",
                                        "entry_id": "c0f22039-4a1b-3564-aa6d-1b4b77d4b8c1",
                                        "glosses": [
                                            "A proponent of accelerationism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3287e77-6001-4df9-8b72-6c491008d6d5",
                                                "sense_id": "4213257a-1600-3ae1-bba5-066052e7e6db",
                                                "text": "Accelerationists argue that technology, particularly computer technology, and capitalism, particularly the most aggressive, global variety, should be massively sped up and intensified – either because this is the best way forward for humanity, or because there is no alternative. […] Occasionally, accelerationists have held teaching posts at universities. […] “We all live in an operating system set up by the accelerating triad of war, capitalism and emergent AI,” says Steve Goodman, a British accelerationist who has even smuggled its self-consciously dramatic ideas into dance music, via an acclaimed record label, Hyperdub."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "accelerationist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8ec42683-063f-393c-89db-90078b548911",
                                        "entry_id": "e11f990e-eb23-3073-ad35-ea377e6ea595",
                                        "glosses": [
                                            "Relating to accelerationism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8933900d-74f2-4217-b74c-aa53709e014f",
                                                "sense_id": "8ec42683-063f-393c-89db-90078b548911",
                                                "text": "accelerationist politics"
                                            },
                                            {
                                                "example_id": "7755d780-8330-429c-a452-686d093c603a",
                                                "sense_id": "8ec42683-063f-393c-89db-90078b548911",
                                                "text": "The aesthetics at play were a bit antidemocratic, accelerationist, what have you; and mainstream coverage of the trend from this past spring cited propaganda experts on its allegedly alarming implications."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
