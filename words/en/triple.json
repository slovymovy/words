                },
                {
                    "sense_id": "89712bad-c36e-3ad4-8455-5545ec82845d",
                    "sense_definition": "Consisting of three times the usual number or amount.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "quantity_multiplier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He demanded <w>triple</w> the usual fee for working on the holiday.",
                            "target_lang_translations": {
                                "ru": "Он потребовал <w>тройную</w> плату за работу в праздничный день.",
                                "zh": "他要求节假日工作时支付平时<w>三倍</w>的费用。"
                            }
                        },
                        {
                            "text": "The recipe calls for a <w>triple</w> serving of chocolate chips.",
                            "target_lang_translations": {
                                "ru": "В рецепте указана <w>тройная</w> порция шоколадной крошки.",
                                "zh": "这个食谱需要加入<w>三倍</w>量的巧克力碎。"
                            }
                        }
