                        "entry_id": "5a04cd8b-5013-3475-a4b6-7c9e4f88b0a1",
                        "glosses": [
                            "osad mineralny wytrącony na powierzchni skały w obrębie jaskini"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "80a9ad86-634a-39b8-a96b-157a793f9cc5",
                        "entry_id": "5a04cd8b-5013-3475-a4b6-7c9e4f88b0a1",
                        "glosses": [
                            "twór patologiczny, powstały wskutek odkształcenia tkanek przez zgromadzenie się substancji patogenicznych lub komórek nowotworowych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "633bc908-bab2-43ef-8b38-ae124df44bd5",
                                "sense_id": "80a9ad86-634a-39b8-a96b-157a793f9cc5",
                                "text": "Guzek różni się od grudki większą spoistością i głębszym usadowieniem oraz istnieniem nacieku zapalnego wokół miejsca jego występowania."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
