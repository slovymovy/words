                ],
                "senses": [
                    {
                        "sense_id": "63d78ccd-eaef-3e47-9ac9-6b09e17b447d",
                        "entry_id": "4699332b-c0db-33a2-878d-713af88688ba",
                        "glosses": [
                            "Gewinn eines Unternehmens in einer Periode ohne Sondereffekte, die nicht zum üblichen Geschäft gehören (beispielsweise Kauf oder Verkauf von Teilen des Unternehmens), ermittelt aus der Differenz von Aufwendungen und Erträgen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8bf6b3cc-37cf-4b23-aeb8-d17d801fe3aa",
                                "sense_id": "63d78ccd-eaef-3e47-9ac9-6b09e17b447d",
                                "text": "Im Sommer war als Ziel […] ein Betriebsergebnis von mindestens 2,2 Milliarden Euro angekündigt worden."
                            },
                            {
                                "example_id": "842b23e8-517b-4c8b-b38f-912061d3f302",
                                "sense_id": "63d78ccd-eaef-3e47-9ac9-6b09e17b447d",
                                "text": "Das Betriebsergebnis […] legte um knapp 32 Prozent auf fast 566 Millionen Euro zu."
                            },
                            {
                                "example_id": "63305d06-18bb-4078-9cfa-0c5c8a55cb3f",
                                "sense_id": "63d78ccd-eaef-3e47-9ac9-6b09e17b447d",
                                "text": "Der Umsatz der HHLA erhöhte sich um 6,3 Prozent auf 1,25 Milliarden Euro, das Betriebsergebnis (Ebit) kletterte um 5,6 Prozent auf 173 Millionen Euro."
                            },
                            {
                                "example_id": "480f72af-b462-4d01-ab12-34e58829e035",
                                "sense_id": "63d78ccd-eaef-3e47-9ac9-6b09e17b447d",
                                "text": "Im ersten Halbjahr betrug das Betriebsergebnis der Sparte Opel-Vauxhall ohne Einmalbelastungen 502 Millionen Euro, wie das Unternehmen berichtete."
                            },
                            {
                                "example_id": "6baaca6a-5023-4700-b052-23204d56e5c8",
                                "sense_id": "63d78ccd-eaef-3e47-9ac9-6b09e17b447d",
                                "text": "Bereits jetzt [erwirtschaften] tausende von Apotheken nur noch ein Betriebsergebnis von brutto 30.000 Euro im Jahr. Etwa die Hälfte dessen, was ein angestellter Apotheker verdient."
                            },
                            {
                                "example_id": "86cf18e6-1408-4a1e-ae44-d20f1e271db7",
                                "sense_id": "63d78ccd-eaef-3e47-9ac9-6b09e17b447d",
                                "text": "Pestizide sind teuer, sie schmälern das Betriebsergebnis [des Bauern]. Außerdem vergiften sie den Boden."
                            },
                            {
                                "example_id": "e2b8a85e-88fd-4ccc-a14c-2986209b1307",
                                "sense_id": "63d78ccd-eaef-3e47-9ac9-6b09e17b447d",
                                "text": "[Es] ist der Verdacht geäußert worden, dass in der Vergangenheit Brandschutzmaßnahmen [im Flughafen] nicht vorgenommen wurden, die das Betriebsergebnis schmälern könnten."
                            },
                            {
                                "example_id": "71d4de08-5d09-495d-85ef-9b860c7e0333",
                                "sense_id": "63d78ccd-eaef-3e47-9ac9-6b09e17b447d",
                                "text": "„Wir gehen davon aus, dass wir angesichts des Besucheraufkommens ein positives Betriebsergebnis haben […]“"
                            },
                            {
                                "example_id": "1e81f72f-e04c-4e7c-9791-56edaacaa97b",
                                "sense_id": "63d78ccd-eaef-3e47-9ac9-6b09e17b447d",
                                "text": "Für das Gesamtjahr erwartet die Lufthansa-Tochter […] ein bereinigtes Betriebsergebnis auf der Höhe des Vorjahrs."
                            },
                            {
                                "example_id": "0e9137f0-505c-45f2-be56-1d721cdabba3",
                                "sense_id": "63d78ccd-eaef-3e47-9ac9-6b09e17b447d",
                                "text": "Ohne diese Tricksereien hätte in Frankreich erst zu einem späteren Zeitpunkt ein positives Betriebsergebnis (Ebit) erzielt werden können."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
