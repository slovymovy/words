                "senses": [
                    {
                        "sense_id": "81b218b1-0dcc-3234-b72e-85fd1c3b2144",
                        "entry_id": "95aaa7ad-0085-3c86-9aea-4872baca6d38",
                        "glosses": [
                            "Mode d’exploitation agricole dans lequel le propriétaire de la terre concède l’entreprise à un tiers en échange de prestations en nature et, accessoirement, en argent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5be6d616-b4ca-4648-b481-70b8361a342a",
                                "sense_id": "81b218b1-0dcc-3234-b72e-85fd1c3b2144",
                                "text": "Une chaume, sans doute, reste avant tout le pâturage. Par là, cependant, du XVIᵉ au XVIIIᵉ siècle, les documents peuvent encore désigner les districts forestiers voisins, compris dans la même amodiation."
                            },
                            {
                                "example_id": "e1365798-e575-4c62-af67-9e4b781957ed",
                                "sense_id": "81b218b1-0dcc-3234-b72e-85fd1c3b2144",
                                "text": "Faire l’amodiation d’une terre."
                            }
                        ]
                    },
                    {
                        "sense_id": "80f969f9-90a7-3c8d-920e-67340125356d",
                        "entry_id": "95aaa7ad-0085-3c86-9aea-4872baca6d38",
                        "glosses": [
                            "Location de droits de chasse ou de pèche."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "f85ea9e7-d9aa-4ab9-86ea-dc30ae00af67",
                                "sense_id": "80f969f9-90a7-3c8d-920e-67340125356d",
                                "text": "Pourtant nous payons vingt-huit francs de permis de chasse, dix francs d’amodiation sans compter l’impôt et la nourriture des chiens."
                            }
                        ]
                    },
                    {
                        "sense_id": "22b1cb7a-2bed-3637-8f39-4307e753057f",
                        "entry_id": "95aaa7ad-0085-3c86-9aea-4872baca6d38",
                        "glosses": [
                            "Acte de louage d’une concession d’une mine, pendant une durée déterminée."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "2a72e8ff-f15d-414a-8c53-0cb877894001",
                                "sense_id": "22b1cb7a-2bed-3637-8f39-4307e753057f",
                                "text": "L’autorisation d’exploitation ne peut donner lieu à cession, amodiation ou location ; elle n’est pas susceptible d’hypothèque."
                            }
                        ]
                    }
