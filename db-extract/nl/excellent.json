                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ff27eda-9550-4171-beaf-5ffc87a17610",
                                "sense_id": "275a1b4b-cdea-33cc-9e5d-72e7f5c709da",
                                "text": "Dat was een excellente maaltijd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aaa853aa-bd54-484c-9908-f3294e9f59a9",
                        "source_entry_id": "795f3864-a251-3e75-ba1b-d5add9338701",
                        "source_sense_id": "275a1b4b-cdea-33cc-9e5d-72e7f5c709da",
                        "target_lang_word": "excellent",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "excellent",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "04a6a8ae-2c3b-3973-98b9-1223463a33bd",
                                        "entry_id": "41decbeb-b151-3674-bb81-54422cfeaa1e",
                                        "glosses": [
                                            "Qui excelle ; qui possède toutes les qualités requises, très bon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53d0b3de-1f71-4da8-95f3-182dea6454cc",
                                                "sense_id": "04a6a8ae-2c3b-3973-98b9-1223463a33bd",
                                                "text": "Les cuisiniers excellent à faire ce mets excellent."
                                            },
                                            {
                                                "example_id": "8f8d840d-e921-4666-87dc-5dcfae75703e",
                                                "sense_id": "04a6a8ae-2c3b-3973-98b9-1223463a33bd",
                                                "text": "Tom s’efforçait de vendre uniquement la récolte de son jardin, produits excellents assurément, mais de variété limitée."
                                            },
                                            {
                                                "example_id": "2151788a-0c86-4715-92fa-451a0cde4d34",
                                                "sense_id": "04a6a8ae-2c3b-3973-98b9-1223463a33bd",
                                                "text": "La plus franche cordialité régnait entre nous. Je passai là d’excellentes heures."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "excellent",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "94ea0a48-1fb5-35d7-9357-70da44f9b078",
                                        "entry_id": "d5ec15c9-8181-3945-9008-bfbfe6a20866",
                                        "glosses": [
                                            "Ce qui excelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0cafba37-de63-43d7-a923-66696a7edfc4",
                                                "sense_id": "94ea0a48-1fb5-35d7-9357-70da44f9b078",
                                                "text": "Il semble qu'il n’y ait point de milieu entre l’excellent et le détestable."
                                            },
                                            {
                                                "example_id": "8421aaf4-c0c7-45e3-abb0-1cf6d696541f",
                                                "sense_id": "94ea0a48-1fb5-35d7-9357-70da44f9b078",
                                                "text": "Cela n’empêche que le malheureux dans une nation vaincue est deux fois misérable et que les excellents esprits qui se rencontrent là devront pour ainsi dire remonter le torrent de la mésestime les frappant en tant que relevant d’un peuple impunément foulé."
                                            }
                                        ]
                                    }
                                ]
                            },
