        "nl-extract.jsonl": [
            {
                "entry_id": "10275be9-a284-33c5-abdc-1a74c59bb201",
                "word": "stoeierij",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "1b427a4c-9ff6-4165-975a-6e3afaac1564",
                        "entry_id": "10275be9-a284-33c5-abdc-1a74c59bb201",
