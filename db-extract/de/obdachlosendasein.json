                        "examples": [
                            {
                                "example_id": "13808d81-068f-455c-816b-fd657c710340",
                                "sense_id": "f98ab366-395d-31ad-870a-f9b93191c821",
                                "text": "„Er beschrieb das Obdachlosendasein geradezu als das ideale Leben in Freiheit…“"
                            },
                            {
                                "example_id": "4239bc9f-fc7e-44bf-95a1-e66113dca7e6",
                                "sense_id": "f98ab366-395d-31ad-870a-f9b93191c821",
                                "text": "„Ein Teil davon sind Mädchen, die ein Obdachlosendasein auf Nairobis Straßen fristeten.“"
                            },
                            {
                                "example_id": "8e7495bc-e7c8-4b19-bdc1-7adb4ec9aba9",
                                "sense_id": "f98ab366-395d-31ad-870a-f9b93191c821",
                                "text": "„Nur das nicht, hieß es in jenen Jahren, als das Obdachlosendasein der Clochards noch als freie Wahl verklärt wurde. “"
                            },
                            {
                                "example_id": "042bc6a0-16ba-4309-bcdb-418b2783f9a0",
                                "sense_id": "f98ab366-395d-31ad-870a-f9b93191c821",
                                "text": "„Nochmals festzuhalten ist, dass der Beschwerdeführer ein Obdachlosendasein führt und in der Stadt Zürich lebt.“"
                            }
                        ],
