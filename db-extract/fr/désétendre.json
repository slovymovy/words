                "senses": [
                    {
                        "sense_id": "eb701414-1a11-326b-b4a6-9812ea9c3ca9",
                        "entry_id": "b4cd6726-9164-393e-95c4-84a760f9f074",
                        "glosses": [
                            "Retirer ce qui a été étendu (en particulier du linge)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae41988a-0df6-45ab-bae2-823e1ccf3e04",
                                "sense_id": "eb701414-1a11-326b-b4a6-9812ea9c3ca9",
                                "text": "Et moi je vaque à mes occupations favorites : le linge à laver, plier, étendre, désétendre."
                            },
                            {
                                "example_id": "ee3eeb37-4825-40d8-a662-62b2d1453a81",
                                "sense_id": "eb701414-1a11-326b-b4a6-9812ea9c3ca9",
                                "text": "Aujourd'hui, je voulais faire une machine à laver, l'étendre et désétendre celle qui a déjà été faite, puis à 14 h j'avais rendez vous chez le coiffeur."
                            },
                            {
                                "example_id": "8c863651-072d-4d6b-946c-aa5459277238",
                                "sense_id": "eb701414-1a11-326b-b4a6-9812ea9c3ca9",
                                "text": "Et puis ça me fait suer de passer 1/2 heure à étendre, 1/2 heure à désétendre pour 1/4 d'heure de séchage."
                            }
                        ]
                    }
