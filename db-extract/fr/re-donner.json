                ],
                "senses": [
                    {
                        "sense_id": "ec101dff-d984-398a-8e71-ca47ae5c03b0",
                        "entry_id": "8c2641d7-0d36-3e12-9943-e30dbe48b1b9",
                        "glosses": [
                            "Variante orthographique, parfois rencontrée, et permettant d’insister sur le préfixe de redonner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b7dfc76-60da-42e6-98aa-ab0b42cd29c5",
                                "sense_id": "ec101dff-d984-398a-8e71-ca47ae5c03b0",
                                "text": "Mais que signifie ici reddere, sinon rendre, c’est-à-dire re-donner, donc d’abord donner ?"
                            },
                            {
                                "example_id": "a354a614-703d-4fc1-8b43-36ee488d40d2",
                                "sense_id": "ec101dff-d984-398a-8e71-ca47ae5c03b0",
                                "text": "Il est important de bien comprendre ici que re-donner n’est pas rendre, parce que donner à son tour après avoir reçu n’efface pas entièrement la dette vis-à-vis de l’autre qui vous avait donné."
                            },
                            {
                                "example_id": "56a1fb21-1bbd-4476-85da-2027a4db9d8c",
                                "sense_id": "ec101dff-d984-398a-8e71-ca47ae5c03b0",
                                "text": "Et l’alcool, ça vous re-donne l’envie de dormir."
                            }
                        ]
                    }
                ],
