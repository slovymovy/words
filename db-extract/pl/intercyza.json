                "senses": [
                    {
                        "sense_id": "e7144860-4161-304b-97d7-b4a079a59134",
                        "entry_id": "a5ba8de3-2678-3efa-a70c-81559a3dba14",
                        "glosses": [
                            "kontrakt przedmałżeński/przedślubny, umowa między narzeczonymi lub małżonkami o zachowaniu odrębnych majątków, rezygnacji ze wspólnoty majątkowej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6243493c-7b2c-4fd2-9d60-802f38d088c4",
                                "sense_id": "e7144860-4161-304b-97d7-b4a079a59134",
                                "text": "Podpisanie intercyzy chroni żonę przed odpowiadaniem za długi męża i na odwrót."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8fdec80f-6346-48df-8600-ae57869cfbb7",
                        "source_entry_id": "a5ba8de3-2678-3efa-a70c-81559a3dba14",
                        "source_sense_id": "e7144860-4161-304b-97d7-b4a079a59134",
                        "target_lang_word": "marriage articles",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "ce805cbd-87f0-4878-8084-1b1d19d2b9e2",
                        "source_entry_id": "a5ba8de3-2678-3efa-a70c-81559a3dba14",
                        "source_sense_id": "e7144860-4161-304b-97d7-b4a079a59134",
                        "target_lang_word": "prenuptial agreement",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prenuptial agreement",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b28e50c4-6ca7-3ba8-a513-becbd04d6eab",
                                        "entry_id": "10f69c8b-7432-3bd4-9c85-6d9e8b4ce990",
                                        "glosses": [
                                            "A legal document, signed by both parties before marriage, stating the legal claims on each other's estate upon a subsequent divorce."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc394596-e603-4ef3-a8cb-8a036eadff22",
                                                "sense_id": "b28e50c4-6ca7-3ba8-a513-becbd04d6eab",
                                                "text": "Not so long ago, prenuptial agreements raised eyebrows. What hope was there for a marriage, the thinking went, if even before the wedding the couple were specifying who gets what in case of divorce?"
                                            },
                                            {
                                                "example_id": "c88b8c69-86cd-4fb3-af41-8cadeb8c5360",
                                                "sense_id": "b28e50c4-6ca7-3ba8-a513-becbd04d6eab",
                                                "text": "Last week, he said we should get married and that he wants a prenuptial agreement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8825ae9f-9465-4e09-8c09-20a497d25e2b",
                        "source_entry_id": "a5ba8de3-2678-3efa-a70c-81559a3dba14",
                        "source_sense_id": "e7144860-4161-304b-97d7-b4a079a59134",
                        "target_lang_word": "prenup",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prenup",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "89c6b64f-670e-3c0e-9cc1-85ab155ccc63",
                                        "entry_id": "c89c74a9-2be3-328b-9b3d-6b652eaa366a",
                                        "glosses": [
                                            "A prenuptial agreement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "083687a4-eb93-49e8-a01a-b64a5d8689d5",
                                                "sense_id": "89c6b64f-670e-3c0e-9cc1-85ab155ccc63",
                                                "text": "Such tangles and many others can be avoided with a buy-sell agreement — basically a business prenup or a postnup, depending on when owners draw it up."
                                            },
                                            {
                                                "example_id": "b307eaba-42ee-48fe-8759-7eff25040e34",
                                                "sense_id": "89c6b64f-670e-3c0e-9cc1-85ab155ccc63",
                                                "text": "Now, let me add that I am not generally a fan of prenups for people without big assets or liabilities, or children from previous relationships."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00efc60a-00e1-3590-89fc-3064f081e6a6",
                                        "entry_id": "c89c74a9-2be3-328b-9b3d-6b652eaa366a",
                                        "glosses": [
                                            "A casual photoshoot before a wedding"
                                        ],
                                        "tags": [
                                            "Philippines",
                                            "informal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5dd587d4-73ea-425c-937f-8fced66c110f",
                        "source_entry_id": "a5ba8de3-2678-3efa-a70c-81559a3dba14",
                        "source_sense_id": "e7144860-4161-304b-97d7-b4a079a59134",
