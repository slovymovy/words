                        "examples": [
                            {
                                "example_id": "1d2f7754-08b2-4bbd-9199-12019a794f15",
                                "sense_id": "c2b400a7-2d82-3ba3-b423-0ba45cc9563d",
                                "text": "C'est cet état général d’incertitude intellectuelle qui permet chez beaucoup la persistance d’attitudes doctrinales périmées, irréalistes, sans que l'on puisse faire de leurs égarements des symptômes psycho-pathologiques."
                            }
                        ]
                    }
