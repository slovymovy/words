                "senses": [
                    {
                        "sense_id": "75530ae8-9c55-3d85-a506-c54b4e456317",
                        "entry_id": "a2daf861-b549-32e8-a263-0f69b0c5bb9a",
                        "glosses": [
                            "Beruf, der genau den eigenen Vorstellungen, Wünschen entspricht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9ba6fc8-ac38-4556-b317-612468dac664",
                                "sense_id": "75530ae8-9c55-3d85-a506-c54b4e456317",
                                "text": "In der Liste der Traumberufe stehen bei den Jungen Feuerwehrmann und Pilot ganz oben."
                            },
                            {
                                "example_id": "fe392b0a-7531-4d2d-b3cf-4b1fb74d2e97",
                                "sense_id": "75530ae8-9c55-3d85-a506-c54b4e456317",
                                "text": "„Zwar blieb ihr Vorstoß in den Traumberuf der Bibliothekarin erfolglos, die Bibliothek des Glasmuseums lehnte sie ab, obwohl sie mit Deutsch, Englisch und Fachkenntnissen in Sachen Schmuck die ideale Besetzung gewesen wäre.“"
                            },
                            {
                                "example_id": "1684481d-64f0-45d5-a82d-c3eb8bedfc11",
                                "sense_id": "75530ae8-9c55-3d85-a506-c54b4e456317",
                                "text": "„Jetzt sind wir beim Traumberuf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
