                        "cross_references": [
                            {
                                "target_word": "time lag",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cfaa608d-06f2-31cc-9117-11715946d253",
                                        "entry_id": "189bbdd6-e130-32d1-adde-fb1140b69b77",
                                        "glosses": [
                                            "A period of time between one event and another; a delay."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89237404-c908-4791-b801-b32ded1055e3",
                                                "sense_id": "cfaa608d-06f2-31cc-9117-11715946d253",
                                                "text": "Owing to the time lag which must occur between the dates of closing for press and publication, it sometimes happens that items of news are out of date, or inaccurate, by the time they reach readers."
                                            },
                                            {
                                                "example_id": "f1b3ea71-0c2e-4608-bb6b-fdf3b14c4e81",
                                                "sense_id": "cfaa608d-06f2-31cc-9117-11715946d253",
                                                "text": "The communicating doors of adjoining vehicles are opened simultaneously by pressing a large push-button located a suitable height for a man loaded with mailbags to contact it with his shoulder; after a time-lag of seven seconds the doors close automatically."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1ac61b44-edd8-47f9-84f0-ae4ba262005f",
                        "source_entry_id": "83ad1b60-efbe-31dd-a0be-584643f5ab18",
                        "source_sense_id": "43192988-30fb-34e4-9315-f6e6be950c7e",
                        "target_lang_word": "persistence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "persistence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a0dc80ac-9ffe-3f61-8338-bbb563d7b9ea",
                                        "entry_id": "2ce04a64-0b5c-36d8-98e1-f14257aabd4d",
                                        "glosses": [
                                            "The property of being persistent."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e01c0134-8420-48c4-93bb-2891c496132b",
                                                "sense_id": "a0dc80ac-9ffe-3f61-8338-bbb563d7b9ea",
                                                "text": "You've got to admire her persistence. She's asked him out every day for a month even though she keeps turning him down."
                                            },
                                            {
                                                "example_id": "ce305bb9-14bb-42df-9c95-bb5f712dbf0f",
                                                "sense_id": "a0dc80ac-9ffe-3f61-8338-bbb563d7b9ea",
                                                "text": "The Thaumatrope was based on the persistence of vision. The disc of card was rotated so rapidly by means of threads attached to it that the eye saw both sides of the card simultaneously."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cfe1192f-4523-3655-aae6-6e5bfb3499f5",
                                        "entry_id": "2ce04a64-0b5c-36d8-98e1-f14257aabd4d",
                                        "glosses": [
                                            "Of data, the property of continuing to exist after the termination of the program."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abd98977-491a-4232-84b2-e297c3b373a4",
                                                "sense_id": "cfe1192f-4523-3655-aae6-6e5bfb3499f5",
                                                "text": "Once written to a disk file, the data has persistence: it will still be there tomorrow when we run the next program."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a62cf30c-a829-3e10-9cff-e70c916a17ec",
                                        "entry_id": "2ce04a64-0b5c-36d8-98e1-f14257aabd4d",
                                        "glosses": [
                                            "Continuation of the previous day's weather (particularly temperature and precipitation statistics)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a0e0d061-484b-306a-95d5-b474fd517988",
                                        "entry_id": "2ce04a64-0b5c-36d8-98e1-f14257aabd4d",
                                        "glosses": [
                                            "The number of times an operation can be iteratively applied to a number before it reaches a permanently constant state."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "caa17a98-c88d-451a-a7d4-7b181f03ccdb",
                                                "sense_id": "a0e0d061-484b-306a-95d5-b474fd517988",
                                                "text": "The persistence of the number 39 under the operation of multiplying the digits of the number is three, because 3x9 = 27, 2x7 = 14, and 1x4 = 4, and no further iterations will change the number again."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
