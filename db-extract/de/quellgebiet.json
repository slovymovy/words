                "senses": [
                    {
                        "sense_id": "2e7d507d-d232-39d1-935a-34d460802138",
                        "entry_id": "036e0884-214f-3995-b697-390d467b9da4",
                        "glosses": [
                            "Bereich, in dem ein Fließgewässer aus der Erde tritt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b56c3f4e-e390-40c1-8c62-fe5d35288732",
                                "sense_id": "2e7d507d-d232-39d1-935a-34d460802138",
                                "text": "„Mein ursprünglicher Plan war es gewesen, mit dieser Woge zu reisen, doch mein Aufenthalt im Quellgebiet hatte zu lange gedauert, und die Zwangspause in Bamako hatte ein Übriges getan.“"
                            },
                            {
                                "example_id": "15034244-9c90-4022-95fa-b5ae69af2aae",
                                "sense_id": "2e7d507d-d232-39d1-935a-34d460802138",
                                "text": "„Mafeking war 40 Jahre zuvor auf der steinigen Steppenhochebene, wo das Quellgebiet des Flusses Molopo liegt, gegründet worden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
