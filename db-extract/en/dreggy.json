                "senses": [
                    {
                        "sense_id": "701b00ad-9605-3c26-bbf5-f703d115f2ea",
                        "entry_id": "36b7e90a-47cd-3d9d-9f56-90f91342071a",
                        "glosses": [
                            "Containing dregs or lees; muddy; foul."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57501e06-26a4-4dbf-a436-95127a60a478",
                                "sense_id": "701b00ad-9605-3c26-bbf5-f703d115f2ea",
                                "text": "In the third place, I truly esteem those that are pretty much perfumed and well scented, though I do not care that this perfection should be enclosed in a pulp that is extremely hard and full of dreggy matter, as the amadotte, the citron, and the great winter musk pears."
                            },
                            {
                                "example_id": "dfe270e4-f86c-4afd-a609-7f5b6978c6bd",
                                "sense_id": "701b00ad-9605-3c26-bbf5-f703d115f2ea",
                                "text": "Now, I have been in cleaning about two years and I know one thing, cleaning and catering are the dreggiest jobs to be in."
                            },
                            {
                                "example_id": "e5db07c9-f250-4f8e-807d-7203abdbf441",
                                "sense_id": "701b00ad-9605-3c26-bbf5-f703d115f2ea",
                                "text": "It was now dark and Heath found himself walking into the dreggiest part of town."
                            }
                        ]
                    }
                ],
