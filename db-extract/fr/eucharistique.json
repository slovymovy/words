                "senses": [
                    {
                        "sense_id": "caeac857-d23f-3c63-871a-c028640a902d",
                        "entry_id": "684d2df7-1a9d-3ba0-88ec-db5c741e3d9d",
                        "glosses": [
                            "Relatif à l’eucharistie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e95e014-51b6-4795-a877-a479edb249ef",
                                "sense_id": "caeac857-d23f-3c63-871a-c028640a902d",
                                "text": "Colombe eucharistique, vase en forme de colombe où l'on mettait en réserve l'eucharistie pour les malades."
                            },
                            {
                                "example_id": "bfdea59c-1fde-4f32-9aaf-7bcb32323cc1",
                                "sense_id": "caeac857-d23f-3c63-871a-c028640a902d",
                                "text": "Ce que j’éprouve, c’est quelque chose d’indéfinissable, quelque chose de très doux, de très grave aussi et de très religieux, une sorte d’extase eucharistique, semblable à celle où me ravit ma première communion."
                            },
                            {
                                "example_id": "1e0f2cd1-51e2-4990-ac84-22694db6b24a",
                                "sense_id": "caeac857-d23f-3c63-871a-c028640a902d",
                                "text": "Le dogme eucharistique implique la transsubstantiation des espèces consacrées sous la permanence des accidents sensibles du pain et du vin."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
