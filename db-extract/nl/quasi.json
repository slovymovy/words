        "nl-extract.jsonl": [
            {
                "entry_id": "cef109df-5f66-320c-bfd2-ad65fffce5b1",
                "word": "quasi",
                "pos": "adv",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "7bad8a02-a75c-4bd4-acd4-4e2ae2620d38",
                        "entry_id": "cef109df-5f66-320c-bfd2-ad65fffce5b1",
                        "tags": [],
                        "form": "kwasi",
                        "note": "van 1955 tot 1996 toegelaten schrijfwijze in de officiële spelling"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c65de341-5eac-3c74-8821-aa061e7e4fe2",
                        "entry_id": "cef109df-5f66-320c-bfd2-ad65fffce5b1",
                        "glosses": [
                            "in schijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4669512-59ba-4350-8932-8cb928f6172b",
                                "sense_id": "c65de341-5eac-3c74-8821-aa061e7e4fe2",
                                "text": "Comedian Tim Hartog merkt aan het begin van de avond op dat de eerste rij bijna leeg is. „Ik ga niet verder voordat hier wat publiek komt zitten”, zegt hij quasi streng."
                            }
                        ]
                    },
                    {
                        "sense_id": "e154be5f-1bcc-31c8-8717-d89ebd18bfaf",
                        "entry_id": "cef109df-5f66-320c-bfd2-ad65fffce5b1",
                        "glosses": [
                            "als het ware, nagenoeg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1bb5859b-b6d8-4e6a-9ae3-ec54ae1d0b1b",
                                "sense_id": "e154be5f-1bcc-31c8-8717-d89ebd18bfaf",
                                "text": "De maakbaarheid van de mens schiet niet op, maar de maakbaarheid van de renner lijkt quasi voltooid. Meer bepaald de tijdrijder, die tegenwoordig blinkt als boenwas, ver van snot en ongemak."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "80830c7d-0e04-448d-a1d8-b4ebc43f7f12",
                        "source_entry_id": "cef109df-5f66-320c-bfd2-ad65fffce5b1",
                        "source_sense_id": "c65de341-5eac-3c74-8821-aa061e7e4fe2",
                        "source_sense_description": "in schijn",
                        "target_lang_word": "quasi",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quasi",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "db451bc7-3439-36b5-be67-11d7da2062fe",
                                        "entry_id": "3463f383-6578-3da8-bba5-ee4d7164f4f9",
                                        "glosses": [
                                            "gleichsam"
                                        ],
                                        "tags": [
                                            "Einleitung eines Gleichnisses oder einer Übertreibung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ab44061-09e5-4cb9-90b5-524a80770c49",
                                                "sense_id": "db451bc7-3439-36b5-be67-11d7da2062fe",
                                                "text": "Ich bin quasi schon fertig."
                                            },
                                            {
                                                "example_id": "021e724c-5c21-4e92-a05d-3a8582ee86f9",
                                                "sense_id": "db451bc7-3439-36b5-be67-11d7da2062fe",
                                                "text": "Ich bin quasi der Kaiser vom Schrottplatz."
                                            },
                                            {
                                                "example_id": "6dd5fb1d-b5c0-4b88-a6e0-3a297519e114",
                                                "sense_id": "db451bc7-3439-36b5-be67-11d7da2062fe",
                                                "text": "Sie hatten den Urlaub quasi schon angetreten, als der Anruf kam."
                                            },
                                            {
                                                "example_id": "28263e76-62fe-4608-9c89-0fda81e7aed2",
                                                "sense_id": "db451bc7-3439-36b5-be67-11d7da2062fe",
                                                "text": "Das ist doch quasi das gleiche."
                                            },
                                            {
                                                "example_id": "02abdc65-21fc-4879-906d-57d6822e1df8",
                                                "sense_id": "db451bc7-3439-36b5-be67-11d7da2062fe",
                                                "text": "„Die Untersuchung eignet sich gut, um das Herz quasi von hinten durch die Speiseröhre hindurch zubetrachten.“"
                                            },
                                            {
                                                "example_id": "74eb7a37-4ba0-45c8-88c5-55652bbf80e9",
                                                "sense_id": "db451bc7-3439-36b5-be67-11d7da2062fe",
                                                "text": "„Es handelt sich um Kandidaten aus dem Spektrum der Alltagsgespräche, die quasi zufällig im Rahmen des täglichen Auslaufs mit dem Hund entstehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9aebdbb6-d789-4e99-a23d-629e430ce659",
                        "source_entry_id": "cef109df-5f66-320c-bfd2-ad65fffce5b1",
                        "source_sense_id": "c65de341-5eac-3c74-8821-aa061e7e4fe2",
                        "source_sense_description": "in schijn",
                        "target_lang_word": "quasi",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quasi",
