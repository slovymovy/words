                "senses": [
                    {
                        "sense_id": "28f84d4d-9a94-3dc5-a84a-ecae21a908ec",
                        "entry_id": "abfe34e3-436a-3876-a3bc-b1132e68201e",
                        "glosses": [
                            "To cause (someone) to go insane or become deranged."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "6a7833d2-b7c7-38a7-b0ca-63201dfbcfc6",
                        "entry_id": "abfe34e3-436a-3876-a3bc-b1132e68201e",
                        "glosses": [
                            "To cause disorder in (something); to distort from its ideal state."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "f4a2ca18-cfca-4404-841c-ce607239a1a5",
                                "sense_id": "6a7833d2-b7c7-38a7-b0ca-63201dfbcfc6",
                                "text": "Both these kinds of monopolies derange more or less the natural distribution of the stock of the society;"
                            }
                        ]
                    },
                    {
                        "sense_id": "69e261d8-2a76-395d-94c1-4e35ec9754be",
                        "entry_id": "abfe34e3-436a-3876-a3bc-b1132e68201e",
                        "glosses": [
                            "To cause to malfunction or become inoperative."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "65478f2a-da51-4e34-912e-d6dccfb50f45",
                                "sense_id": "69e261d8-2a76-395d-94c1-4e35ec9754be",
                                "text": "4-16. All lighting was cut off by a close detonation but was partially restored after a short while. Many auxiliary motors were short-circuited or deranged. There were at least nineteen cracked jars in the forward battery and one in the after battery, causing loss of electrolyte and full grounds. All of the electric alarm and telephone circuits were out of commission."
                            }
                        ]
                    },
                    {
                        "sense_id": "939af526-11d9-302b-91ca-1d65f051b610",
                        "entry_id": "abfe34e3-436a-3876-a3bc-b1132e68201e",
                        "glosses": [
                            "To disrupt (somebody's) plans, to inconvenience; to derail."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "3ac5d7c4-c3ba-417c-b4c6-13645631c51e",
                                "sense_id": "939af526-11d9-302b-91ca-1d65f051b610",
                                "text": "\"By no means, Sir,\" answered the Captain: \"I shall be quite au désespoir if I derange any body.\""
                            },
                            {
                                "example_id": "0f8caaf2-b8ca-483e-a666-7ad31af7c2a0",
                                "sense_id": "939af526-11d9-302b-91ca-1d65f051b610",
                                "text": "A second special was out of the question, as the ordinary local service was already somewhat deranged by the first."
                            }
                        ]
                    }
                ],
