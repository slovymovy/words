{
    "word_family": [
        "immersion",
        "immersive",
        "immersible"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a4fc285e-ca80-3579-b9f6-2120a8e81e99",
                    "sense_definition": "To dip or completely plunge something into a liquid or fluid.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>immerse</w> in water the dirty fabric before applying soap to it.",
                            "target_lang_translations": {
                                "pl": "Powinieneś <w>zanurzyć</w> brudną tkaninę w wodzie, zanim nałożysz na nią mydło."
                            }
                        },
                        {
                            "text": "The scientist will <w>immerse</w> the metal sample into a special chemical solution.",
                            "target_lang_translations": {
                                "pl": "Naukowiec <w>zanurzy</w> próbkę metalu w specjalnym roztworze chemicznym."
                            }
                        }
                    ],
                    "synonyms": [
                        "submerge"
                    ],
                    "common_phrases": [
                        "immerse in water",
                        "immerse in liquid"
                    ],
                    "target_lang_definitions": {
                        "pl": "Zanurzać lub całkowicie wkładać coś do cieczy lub płynu."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "zanurzać",
                                "target_lang_sense_clarification": "umieszczać coś w cieczy (aspekt niedokonany)"
                            },
                            {
                                "target_lang_word": "zanurzyć",
                                "target_lang_sense_clarification": "umieścić coś w cieczy (aspekt dokonany)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f5b5a0d-7123-35c2-b2e8-cea7978ccefe",
                    "sense_definition": "To involve oneself deeply in a particular activity, interest, or study.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to <w>immerse</w> herself in studies to prepare for the final exams.",
                            "target_lang_translations": {
                                "pl": "Postanowiła <w>zanurzyć</w> się w nauce, aby przygotować się do egzaminów końcowych."
                            }
                        },
                        {
                            "text": "When moving to a new country, it is best to <w>immerse</w> yourself in the local culture.",
                            "target_lang_translations": {
                                "pl": "Przeprowadzając się do nowego kraju, najlepiej jest <w>zanurzyć</w> się w lokalnej kulturze."
                            }
                        }
                    ],
                    "common_phrases": [
                        "immerse yourself in",
                        "immerse in studies",
                        "immerse in culture"
                    ],
                    "target_lang_definitions": {
                        "pl": "Głębokie angażowanie się w jakąś czynność, zainteresowanie lub naukę."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "pogrążać się",
                                "target_lang_sense_clarification": "całkowite oddanie się jakiejś czynności lub stanowi"
                            },
                            {
                                "target_lang_word": "zaabsorbować",
                                "target_lang_sense_clarification": "całkowite zajęcie czyjejś uwagi lub czasu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "753eeba5-2960-30e1-89b6-b2d4368be3c0",
                    "sense_definition": "To map a mathematical space into another through an immersion.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In differential topology, scientists often <w>immerse</w> a manifold into a higher dimensional space.",
                            "target_lang_translations": {
                                "pl": "W topologii różniczkowej naukowcy często <w>zanurzają</w> rozmaitość w przestrzeń o wyższym wymiarze."
                            }
                        },
                        {
                            "text": "A Klein bottle cannot be embedded smoothly, so mathematicians <w>immerse</w> it instead.",
                            "target_lang_translations": {
                                "pl": "Butelka Kleina nie może być gładko zanurzona (włożona), więc matematycy zamiast tego ją <w>zanurzają</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in mathematics"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Odwzorowanie przestrzeni matematycznej w inną przestrzeń poprzez zanurzenie."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "zanurzać",
                                "target_lang_sense_clarification": "termin matematyczny dotyczący odwzorowań przestrzeni"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ac793b49-d719-3bc9-9982-696fb98b9a14",
                    "sense_definition": "Deeply sunken, buried, or submerged.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The philosopher wrote about things <w>immerse</w> in physical matter.",
                            "target_lang_translations": {
                                "pl": "Filozof pisał o rzeczach <w>zanurzonych</w> w materii fizycznej."
                            }
                        },
                        {
                            "text": "Old texts describe ancient ruins as remaining <w>immerse</w> beneath the earth.",
                            "target_lang_translations": {
                                "pl": "Stare teksty opisują starożytne ruiny jako pozostające <w>zanurzone</w> pod ziemią."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rare or obsolete usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Głęboko osadzony, pogrzebany lub zatopiony."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "zanurzony",
                                "target_lang_sense_clarification": "będący w stanie zanurzenia"
                            },
                            {
                                "target_lang_word": "zatopiony",
                                "target_lang_sense_clarification": "znajdujący się pod powierzchnią czegoś"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}