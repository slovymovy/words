                                        "glosses": [
                                            "A pattern produced using such a utensil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee5b82b4-2ad3-443f-9c9c-cadab93f3bb3",
                                                "sense_id": "82e30a8e-02df-38fd-b49a-330c0af2b1e3",
                                                "text": "In 2013 a damaged stencil of a rat and an image of a girl hugging a bomb were painted over on the walls of a Fitzroy church by the building owner’s father-in-law, who tried to help out by painting the building while house sitting. He did not know the significance of the stencils."
                                            }
                                        ]
                                    },
