                "senses": [
                    {
                        "sense_id": "317ebbb4-e8f2-316e-9456-300d3f7146b9",
                        "entry_id": "20f0e7ca-2966-393a-9ebb-70e9f989723c",
                        "glosses": [
                            "Fahne des Dritten Reiches"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3a79647-6633-4347-961e-0e32cb8942c3",
                                "sense_id": "317ebbb4-e8f2-316e-9456-300d3f7146b9",
                                "text": "Die Hakenkreuzfahne war während des Dritten Reiches die Nationalflagge des Landes."
                            },
                            {
                                "example_id": "e3e56147-f2b4-4579-abd5-44508ab77cce",
                                "sense_id": "317ebbb4-e8f2-316e-9456-300d3f7146b9",
                                "text": "In der Hakenkreuzfahne spiegeln sich die Farben der alten Kaiserreichsflagge schwarz, rot und weiß wieder, wodurch man den Menschen den Bezug zur Vergangenheit ausmalen wollte und Hitlers Staat als das dritte Reich nach dem Heiligen Römischen Reich und dem Deutschen Kaiserreich rechtfertigte."
                            },
                            {
                                "example_id": "1a0747f3-d88f-4236-85d5-f262801f88e5",
                                "sense_id": "317ebbb4-e8f2-316e-9456-300d3f7146b9",
                                "text": "„Interessant sind aber Wochenschaueinblendungen, die den mit der Hakenkreuzfahne bekleideten Sarg bei Schneefall zeigen.“"
                            },
                            {
                                "example_id": "d6e3f6a2-7b15-4c7c-af81-b789bfcd05c9",
                                "sense_id": "317ebbb4-e8f2-316e-9456-300d3f7146b9",
                                "text": "„Eine riesige Hakenkreuzfahne hat damals über dem Tor geweht, die man kilometerweit sehen konnte.“"
                            },
                            {
                                "example_id": "9951f3f3-0bd3-42f7-b3cb-640aba289aef",
                                "sense_id": "317ebbb4-e8f2-316e-9456-300d3f7146b9",
                                "text": "„Ein Heer von Hakenkreuzfahnen hing aus den Fenstern.“"
                            },
                            {
                                "example_id": "28245954-2c3a-49b4-8b45-c9585a49177d",
                                "sense_id": "317ebbb4-e8f2-316e-9456-300d3f7146b9",
                                "text": "„Überall hingen Hakenkreuzfahnen und an den Litfaßsäulen häuften sich die Hetzplakate gegen die Juden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
