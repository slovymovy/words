    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "0a0a9994-470b-3ac0-8bcc-13286b7bd65f",
                    "sense_definition": "С производством шума, громких звуков.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "literal_sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Дети <w>шумно</w> играли во дворе, не обращая внимания на взрослых.",
                            "target_lang_translations": {
                                "en": "The children were playing <w>noisily</w> in the yard, paying no attention to the adults.",
                                "de": "Die Kinder spielten <w>geräuschvoll</w> im Hof und beachteten die Erwachsenen nicht."
                            }
                        },
                        {
                            "text": "Чарли окунулся и мгновенно выскочил, <w>шумно</w> отряхиваясь.",
                            "target_lang_translations": {
                                "en": "Charlie dipped in and instantly jumped out, shaking himself off <w>noisily</w>.",
                                "de": "Charlie tauchte unter und sprang sofort wieder heraus, wobei er sich <w>geräuschvoll</w> abschüttelte."
                            }
                        }
                    ],
                    "synonyms": [
                        "громко"
                    ],
                    "antonyms": [
                        "тихо",
                        "бесшумно",
                        "беззвучно"
                    ],
                    "common_phrases": [
                        "шумно вздохнуть",
                        "шумно вести себя"
                    ],
                    "target_lang_definitions": {
                        "en": "In a manner that produces noise or loud sounds.",
                        "de": "Auf eine Art und Weise, die Lärm oder laute Geräusche erzeugt."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "noisily",
                                "target_lang_sense_clarification": "adverb describing an action"
                            },
                            {
                                "target_lang_word": "loudly",
                                "target_lang_sense_clarification": "with high volume"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "geräuschvoll",
                                "target_lang_sense_clarification": "Adverb, das eine Handlung beschreibt"
                            },
                            {
                                "target_lang_word": "laut",
                                "target_lang_sense_clarification": "mit hoher Lautstärke"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5bce9f08-efd3-3ff4-9665-eb11f42e09e3",
                    "sense_definition": "О состоянии окружающей среды, когда вокруг много звуков и шума (используется как сказуемое).",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "predicative_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В ресторане было слишком <w>шумно</w>, и мы с трудом слышали друг друга.",
                            "target_lang_translations": {
                                "en": "It was too <w>noisy</w> in the restaurant, and we could barely hear each other.",
                                "de": "Im Restaurant war es zu <w>laut</w>, und wir konnten uns kaum verstehen."
                            }
                        },
                        {
                            "text": "На улице <w>шумно</w> из-за проезжающих машин.",
                            "target_lang_translations": {
                                "en": "It is <w>noisy</w> outside due to the passing cars.",
                                "de": "Draußen ist es wegen der vorbeifahrenden Autos <w>laut</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "громко"
                    ],
                    "antonyms": [
                        "тихо"
                    ],
                    "common_phrases": [
                        "слишком шумно",
                        "стало шумно"
                    ],
                    "target_lang_definitions": {
                        "en": "Describing an environment or situation filled with loud sounds or noise.",
                        "de": "Beschreibt eine Umgebung oder Situation, die von lauten Geräuschen oder Lärm erfüllt ist."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "noisy",
                                "target_lang_sense_clarification": "predicative use (e.g., 'it is noisy')"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "laut",
                                "target_lang_sense_clarification": "prädikative Verwendung (z. B. 'es ist laut')"
                            },
                            {
                                "target_lang_word": "lärmend",
                                "target_lang_sense_clarification": "Zustand einer Umgebung"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3a2d2465-45d3-320c-80b3-282cecc48384",
                    "sense_definition": "Оживлённо, с проявлением бурной деятельности, веселья или споров.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "lively_activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "За этим столом мужчины <w>шумно</w> играют в карты и смеются.",
                            "target_lang_translations": {
                                "en": "At this table, men are playing cards <w>boisterously</w> and laughing.",
                                "de": "An diesem Tisch spielen die Männer <w>lautstark</w> Karten und lachen."
                            }
                        },
                        {
                            "text": "Гости <w>шумно</w> обсуждали последние новости политики.",
                            "target_lang_translations": {
                                "en": "The guests were <w>loudly</w> discussing the latest political news.",
                                "de": "Die Gäste diskutierten <w>lebhaft</w> die neuesten politischen Nachrichten."
                            }
                        }
                    ],
                    "synonyms": [
                        "оживлённо",
                        "громко"
                    ],
                    "antonyms": [
                        "тихо",
                        "скромно"
                    ],
                    "common_phrases": [
                        "шумно праздновать",
                        "шумно спорить",
                        "шумно обсуждать"
                    ],
                    "target_lang_definitions": {
                        "en": "In a lively, animated, or boisterous manner, often involving loud talking or laughing.",
                        "de": "Auf eine lebhafte, animierte oder stürmische Weise, oft mit lautem Sprechen oder Lachen verbunden."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "boisterously",
                                "target_lang_sense_clarification": "energetic and noisy"
                            },
                            {
                                "target_lang_word": "animatedly",
                                "target_lang_sense_clarification": "lively discussion or activity"
                            },
                            {
                                "target_lang_word": "loudly",
                                "target_lang_sense_clarification": "general noise level"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "lebhaft",
                                "target_lang_sense_clarification": "energetische Aktivität"
                            },
                            {
                                "target_lang_word": "stürmisch",
                                "target_lang_sense_clarification": "wild oder ausgelassen"
                            },
                            {
                                "target_lang_word": "lautstark",
                                "target_lang_sense_clarification": "allgemeiner Lärmpegel bei Diskussionen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "84da7679-1497-332a-a3e1-f32264bbec46",
                    "sense_definition": "Привлекая всеобщее внимание, вызывая широкий общественный резонанс или сенсацию.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "figurative_sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Известный актёр <w>шумно</w> ушёл из театра после скандала.",
                            "target_lang_translations": {
                                "en": "The famous actor left the theatre <w>causing a stir</w> after the scandal.",
                                "de": "Der berühmte Schauspieler verließ das Theater nach dem Skandal <w>mit viel Wirbel</w>."
                            }
                        },
                        {
                            "text": "Премьера нового фильма прошла <w>шумно</w> и с большим успехом.",
                            "target_lang_translations": {
                                "en": "The premiere of the new film went off <w>sensationally</w> and with great success.",
                                "de": "Die Premiere des neuen Films verlief <w>aufsehenerregend</w> und mit großem Erfolg."
                            }
                        }
                    ],
                    "synonyms": [
                        "громко"
                    ],
                    "antonyms": [
                        "незаметно",
                        "скромно"
                    ],
                    "common_phrases": [
                        "шумно прославиться",
                        "шумно уйти"
                    ],
                    "target_lang_definitions": {
                        "en": "In a way that attracts public attention, causes a sensation, or creates a stir.",
                        "de": "Auf eine Weise, die öffentliche Aufmerksamkeit erregt, für Aufsehen sorgt oder ein großes Echo hervorruft."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sensationally",
                                "target_lang_sense_clarification": "causing public interest"
                            },
                            {
                                "target_lang_word": "with a stir",
                                "target_lang_sense_clarification": "causing commotion or talk"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "aufsehenerregend",
                                "target_lang_sense_clarification": "öffentliches Interesse weckend"
                            },
                            {
                                "target_lang_word": "mit viel Wirbel",
                                "target_lang_sense_clarification": "Aufregung oder Gerede verursachend"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
