                        "sense_id": "8b5ce8e4-705e-3812-ba67-8e804e44ec47",
                        "entry_id": "f17d1eb2-489c-393d-9447-23fe72614477",
                        "glosses": [
                            "a seven-league boot (one of a pair of boots enabling the wearer to cross seven leagues at one stride)"
                        ],
                        "tags": [
                            "in-plural",
                            "masculine",
                            "often",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "0ca8e0b6-5d1e-434b-8079-09f090c5989f",
                                "sense_id": "8b5ce8e4-705e-3812-ba67-8e804e44ec47",
                                "text": "Als sie sich ungefähr drei Fuß über dem Wasserspiegel befand, ruderte ein Boot unter dieselbe, und dann ließ sich ein Siebenmeilenstiefel, dem ein zweiter Siebenmeilenstiefel und noch zwei weitere Siebenmeilenstiefel folgten, langsam ins Boot hinab.",
                                "translation": "When she was about three feet above the water's surface, a boat rowed underneath, and then a seven-mile boot, which a second seven-mile boot and then two more seven-mile boots followed, slowly came into the boat.",
                                "english": "When she was about three feet above the water's surface, a boat rowed underneath, and then a seven-mile boot, which a second seven-mile boot and then two more seven-mile boots followed, slowly came into the boat."
                            }
                        ]
                    }
