                        ],
                        "examples": [
                            {
                                "example_id": "ce027a66-3c43-4d95-b952-f5e616944ba1",
                                "sense_id": "41b6b251-cf13-309c-8d39-81ecf7b9691e",
                                "text": "Well, pretty soon the whole town was there, squirming and scrouging and pushing and shoving to get at the window and have a look[…]"
                            },
                            {
                                "example_id": "1b634ee5-b62d-4cc5-9bbd-249df218b7e5",
                                "sense_id": "41b6b251-cf13-309c-8d39-81ecf7b9691e",
                                "text": "I look for veiled eyes or bodies scrouged into a seat in an alien world."
                            },
                            {
                                "example_id": "40580599-0c28-4117-ad0c-2eae9f067fda",
                                "sense_id": "41b6b251-cf13-309c-8d39-81ecf7b9691e",
                                "text": "We stayed up till eleven, sitting on the stairs, on the floor, and scrouged into the day room, surrounded by stacks of GI clothes."
                            }
                        ]
                    }
