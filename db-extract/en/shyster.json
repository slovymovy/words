                    },
                    {
                        "translation_id": "263bac9e-b9fb-4635-87ba-bd071337e96a",
                        "source_entry_id": "0df256a7-f10c-3fbb-9bd4-e4ca0706240f",
                        "source_sense_id": "311cfeba-f983-34f7-8018-667f3acf6955",
                        "source_sense_description": "someone who acts in a disreputable, unethical, or unscrupulous way",
                        "target_lang_word": "Gauner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gauner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "132fd213-bd4a-3580-a6fb-9aaf41d23d6d",
                                        "entry_id": "9f0994ad-9d9e-3752-8e2e-9f1034f6e94c",
                                        "glosses": [
                                            "eine Person, die auf Kosten eines anderen versucht, sich durch Betrug einen Vorteil zu verschaffen, in dem die Unwissenheit beziehungsweise Unaufmerksamkeit des anderen ausgenutzt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7485fdd7-0bb7-4e3a-9c49-ed9c844290e5",
                                                "sense_id": "132fd213-bd4a-3580-a6fb-9aaf41d23d6d",
                                                "text": "„Wenn Ihr’s doch absolut wissen müßt, da läuft ein niederträchtiger Schuft durchs Land, ein Kerl, sage ich Euch, nicht ’nen Schuß Pulver wert, der den Leuten schlechte Ware für teures Geld verkauft, arm und reich betrügt, ein Tagedieb, ein Gauner, ein Marktschreier –“"
                                            },
                                            {
                                                "example_id": "50d727ed-f92c-4919-8b54-3ed1d8840bc1",
                                                "sense_id": "132fd213-bd4a-3580-a6fb-9aaf41d23d6d",
                                                "text": "„Wurden nicht schließlich ein libanesischer Gauner, ein chinesischer Waffenhändler, ein russischer Mafioso und ein Drogenhändler aus Florida als Gegenleistung für ihre Geldgeschenke vom Präsidenten der \"für die Welt unentbehrlichen Nation\" im Weißen Haus empfangen?“"
                                            },
                                            {
                                                "example_id": "f52de5ba-f3e1-4934-ad38-ef69e1d3a221",
                                                "sense_id": "132fd213-bd4a-3580-a6fb-9aaf41d23d6d",
                                                "text": "„Dann folgt eine soziologische Analyse der jiddischen Ausdrücke im Rotwelsch, der Geheimsprache der deutschen Gauner und Vaganten, und eine Analyse der Sinnentstellung, die diese Ausdrücke beim Eintritt ins Milieu der Gauner erfahren haben.“"
                                            },
                                            {
                                                "example_id": "eb36762a-6e82-4638-ba34-e00aeecbfa85",
                                                "sense_id": "132fd213-bd4a-3580-a6fb-9aaf41d23d6d",
                                                "text": "„Ähnlich grotesk wie diese Welt Kiens erscheint vom zweiten Teil an die Welt von Hausierern, Gaunern, Dieben und Zuhältern, in der der Jude Fischerle, ein zwergenhafter Buckliger, als besonderer Führer agiert und besessen die beiden Ziele verfolgt, auf allen legalen und vor allem illegalen Wegen Geld für eine Operation zu horten, um seinen Buckel loszuwerden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bc2114af-a9aa-39f5-b804-9e6e6e98fdba",
                                        "entry_id": "9f0994ad-9d9e-3752-8e2e-9f1034f6e94c",
                                        "glosses": [
                                            "schlauer, durchtriebener Mensch"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a12f4274-bbcf-4299-9c7d-cd5192454845",
                                                "sense_id": "bc2114af-a9aa-39f5-b804-9e6e6e98fdba",
                                                "text": "„Der Mensch wußte, wie Ihr erzählt, daß Ihr allein wart mit dem Fräulein, ja sogar, daß sie noch wachte bei ihren Schriften; gewiß war es einer von den verfluchten Gaunern und Spitzbuben, die bis ins Innere der Häuser dringen, alles listig auskundschaftend, was ihnen zur Ausführung ihrer teuflischen Anschläge dienlich.“"
                                            },
                                            {
                                                "example_id": "89eb5706-c74e-44da-8af5-d5c73f634cf2",
                                                "sense_id": "bc2114af-a9aa-39f5-b804-9e6e6e98fdba",
                                                "text": "„In keinem Land gibt es geschicktere Gauner als in Italien, wenn wir vom alten und vom heutigen Griechenland absehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d194ffe9-2ee6-4b4d-b96d-49ba89a605b0",
                        "source_entry_id": "0df256a7-f10c-3fbb-9bd4-e4ca0706240f",
                        "source_sense_id": "311cfeba-f983-34f7-8018-667f3acf6955",
                        "source_sense_description": "someone who acts in a disreputable, unethical, or unscrupulous way",
                        "target_lang_word": "Rechtsverdreher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rechtsverdreher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2d3578df-a51e-393d-babb-76183e6626c4",
                                        "entry_id": "3019d0aa-fab4-332f-a9e0-af938473e259",
                                        "glosses": [
                                            "Person, die Gesetze so auslegt, dass sie ins Gegenteil verkehrt werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75d8e58a-e133-462e-bde8-186675439cb4",
                                                "sense_id": "2d3578df-a51e-393d-babb-76183e6626c4",
                                                "text": "Nimm dich vor diesem Anwalt in Acht, er ist ein notorischer Rechtsverdreher."
                                            },
                                            {
                                                "example_id": "868a47e4-e531-48e3-8588-af04d54500f7",
                                                "sense_id": "2d3578df-a51e-393d-babb-76183e6626c4",
                                                "text": "Seit Jahren treiben der Angeklagte und seine Rechtsverdreher mit immer neuen juristischen Spitzfindigkeiten nun schon ihre juristischen Spielchen mit diesem Gericht, um den Prozess zu verzögern und eine Verurteilung zu verhindern."
                                            },
                                            {
                                                "example_id": "cee50d04-52d8-4d99-b82a-df5677ee6caf",
                                                "sense_id": "2d3578df-a51e-393d-babb-76183e6626c4",
                                                "text": "„Sie haben keinen Beweis, bloß die Aussage von den vier Affen. Und die nimmt jeder Rechtsverdreher im Nu auseinander.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ce455ac6-eb7a-485e-b70f-7fb6548c0f62",
                        "source_entry_id": "0df256a7-f10c-3fbb-9bd4-e4ca0706240f",
