                        "examples": [
                            {
                                "example_id": "18cb0bf5-3245-422c-8688-fe0df23a00cb",
                                "sense_id": "38d98dfa-10c0-32fb-99fc-10b47e4a3486",
                                "text": "Grüß bitte Hänsel Mustermann herzlich von mir."
                            },
                            {
                                "example_id": "79b9f8b7-8ec5-4d30-82b1-72de58708c12",
                                "sense_id": "38d98dfa-10c0-32fb-99fc-10b47e4a3486",
                                "text": "Unser Hänsel ist nun Ministrant."
                            },
                            {
                                "example_id": "563c5e2c-efb4-4d95-ab53-81dfd86cb939",
                                "sense_id": "38d98dfa-10c0-32fb-99fc-10b47e4a3486",
                                "text": "Hänsel Mustermann ist ein schönes schöner Junge."
                            },
                            {
                                "example_id": "f1961640-523c-4608-8f97-e0a02448e9d1",
                                "sense_id": "38d98dfa-10c0-32fb-99fc-10b47e4a3486",
                                "text": "Hänsel ist 20 Jahre alt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
