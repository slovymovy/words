                                        "sense_id": "5e194a2b-e680-3b6d-81be-ca7f6c6023df",
                                        "entry_id": "d1b19bc6-8635-3f13-bfe7-e4a39fb82d91",
                                        "glosses": [
                                            "A range of values or locations."
