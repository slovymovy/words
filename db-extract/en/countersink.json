                        "entry_id": "ed190781-3671-3cb2-90d6-d173c40df3a1",
                        "glosses": [
                            "A conical recess, typically machined at the mouth of a hole to admit a screw (with a matching taper) so that the screw sits flush with a surface."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c3e64d6a-74a3-39c0-9e41-1fd2d0b6e1e0",
                        "entry_id": "ed190781-3671-3cb2-90d6-d173c40df3a1",
                        "glosses": [
                            "The cutter used to cut such a recess. (Also used, at less depth, for edge-breaking/deburring.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc0d2359-c91d-4214-badd-61369d81c911",
                                "sense_id": "c3e64d6a-74a3-39c0-9e41-1fd2d0b6e1e0",
                                "text": "Holonym: center drill (combined drill and countersink)"
                            }
                        ]
                    }
                ],
