                                        "sense_id": "a2b27810-10e0-3372-9e1c-a7408cccace7",
                                        "entry_id": "58ff34d7-a1d1-39c0-86fa-36e712c7ca56",
                                        "glosses": [
                                            "Commune française, située dans le département du Haut-Rhin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44b5874d-58c8-4c2f-8ed0-231712dc13a5",
                                                "sense_id": "a2b27810-10e0-3372-9e1c-a7408cccace7",
                                                "text": "Sa seule course à Verrières fut causée par l’envie d’acheter de nouvelles robes d’été qu’on venait d’apporter de Mulhouse."
                                            },
                                            {
                                                "example_id": "118b9ddc-fecd-43e2-9a8d-7fd259a4bab1",
                                                "sense_id": "a2b27810-10e0-3372-9e1c-a7408cccace7",
                                                "text": "Les produits viennent surtout naturellement des grandes régions de l’industrie textile : Mulhouse pour les tissus de coton et la mercerie, le Nord pour les lainages, Troyes pour la bonneterie."
                                            },
                                            {
                                                "example_id": "a771fad9-cba3-4d68-bd62-3ca9e928d77c",
                                                "sense_id": "a2b27810-10e0-3372-9e1c-a7408cccace7",
                                                "text": "Les deux vagues d’industrialisation de Mulhouse provoquent l’hyper-densification de la ville historique."
                                            }
                                        ]
                                    }
                                ]
                            }
