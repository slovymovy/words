                        "cross_references": [
                            {
                                "target_word": "braconner",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4083f4fc-afd5-315a-9c3e-85bc875f99e8",
                                        "entry_id": "b626b0bf-5fbb-334e-8f93-89d5265417a7",
                                        "glosses": [
                                            "Chasser furtivement et sans permission sur les terres d’autrui pour faire son profit du gibier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f85b5df5-d2e8-4aac-ac4f-119ce60062fc",
                                                "sense_id": "4083f4fc-afd5-315a-9c3e-85bc875f99e8",
                                                "text": "Rien ne l'effrayait, rien ne l'ébranlait. Il braconnait. Plus par malice que par pure nécessité. Tout y passait, gibier à poils ou poissons luisants. Il ne craignait ni Dieu ni Diable."
                                            },
                                            {
                                                "example_id": "0bb7f92c-49c4-407a-8245-2db5cd162384",
                                                "sense_id": "4083f4fc-afd5-315a-9c3e-85bc875f99e8",
                                                "text": "[…] le gentil clerc de Copmanhurst est un homme connu : c’est lui qui tue la moitié des daims qu’on braconne dans ces environs."
                                            },
                                            {
                                                "example_id": "8fad608f-09cb-4624-8c0c-d773cda041a5",
                                                "sense_id": "4083f4fc-afd5-315a-9c3e-85bc875f99e8",
                                                "text": "Il est expédient de bifurquer à faux pour dérouter les pillards qui braconnent les tenderies dès l'aube, avant le propriétaire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
