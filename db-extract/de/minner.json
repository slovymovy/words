                "senses": [
                    {
                        "sense_id": "f215b906-13da-3813-9168-91e748faa2db",
                        "entry_id": "3c273a15-7367-30db-a05a-a1a57adb988d",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b62578c-fd31-407e-9880-a53e83642699",
                                "sense_id": "f215b906-13da-3813-9168-91e748faa2db",
                                "text": "Frau Minner ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "fd4d4234-a647-4cac-b04b-d38663fa1374",
                                "sense_id": "f215b906-13da-3813-9168-91e748faa2db",
                                "text": "Herr Minner wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "2136e222-029f-4026-88c2-c7524b115bc4",
                                "sense_id": "f215b906-13da-3813-9168-91e748faa2db",
                                "text": "Die Minners fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "a2a87a1e-4d1e-47cf-84d6-bd0322f624d3",
                                "sense_id": "f215b906-13da-3813-9168-91e748faa2db",
                                "text": "Der Minner trägt nie die Pullover, die die Minner ihm strickt."
                            },
                            {
                                "example_id": "4045c47f-fcb6-48d1-a70d-313ff00b98e6",
                                "sense_id": "f215b906-13da-3813-9168-91e748faa2db",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Minner kommt, geht der Herr Minner.“"
                            },
                            {
                                "example_id": "e1f75858-01c8-4620-9aaf-1418ce6e54c6",
                                "sense_id": "f215b906-13da-3813-9168-91e748faa2db",
                                "text": "Minner kommt und geht."
                            },
                            {
                                "example_id": "48b61e87-9483-453e-ab5b-9a17968c2004",
                                "sense_id": "f215b906-13da-3813-9168-91e748faa2db",
                                "text": "Minners kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
