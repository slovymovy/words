            "senses": [
                {
                    "sense_id": "6e2fbf49-8e71-3f4d-821e-61f6d3786fe5",
                    "sense_definition": "Faire faire la connaissance de deux personnes en les mettant en relation.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "introduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je voudrais te <w>présenter</w> un ami que j'ai rencontré à l'université hier soir."
                        },
                        {
                            "text": "Paul a <w>présenté</w> sa famille à ses nouveaux collègues pendant la fête d'hier."
                        }
                    ],
                    "synonyms": [
                        "introduire"
                    ],
                    "common_phrases": [
                        "présenter un ami",
                        "présenter sa famille"
                    ]
                },
                {
                    "sense_id": "df98e70f-5118-3f19-a31a-090b491a70ec",
                    "sense_definition": "Montrer un objet ou un document à quelqu'un afin qu'il le voie ou le vérifie.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "montrer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le voyageur doit <w>présenter</w> son passeport aux agents des douanes à la sortie du train."
                        },
                        {
                            "text": "N'oubliez pas de <w>présenter</w> un justificatif valide avant d'entrer dans la salle d'examen."
                        }
                    ],
                    "synonyms": [
                        "montrer",
                        "exhiber"
                    ],
                    "antonyms": [
                        "cacher",
                        "dissimuler"
                    ],
                    "common_phrases": [
                        "présenter son passeport",
                        "présenter un justificatif"
