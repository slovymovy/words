                "senses": [
                    {
                        "sense_id": "c266d2e7-4d61-3cb8-8861-9894b91d5ee7",
                        "entry_id": "a9af6e63-c9ec-34d2-bcfd-7b713f2f8f7f",
                        "glosses": [
                            "Materialien, die zum Schreiben genutzt werden"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "1dabc025-4e8a-444c-b714-facd2178c754",
                                "sense_id": "c266d2e7-4d61-3cb8-8861-9894b91d5ee7",
                                "text": "Ich habe mein Schreibzeug zuhause vergessen."
                            },
                            {
                                "example_id": "de5dacd7-87ed-4238-894d-e47069ec43ea",
                                "sense_id": "c266d2e7-4d61-3cb8-8861-9894b91d5ee7",
                                "text": "„Er hatte sich mit seinem Schreibzeug in der Wohnstube des Bauernhauses etabliert, in dem er im Quartier lag.“"
                            },
                            {
                                "example_id": "d5d4fd91-852a-4a38-9d28-e55c7ed76801",
                                "sense_id": "c266d2e7-4d61-3cb8-8861-9894b91d5ee7",
                                "text": "„Cooper wurde mit dem Schreibzeug und den Papieren des Kapitäns zum Treffpunkt geschickt, und Letzterer wurde freigelassen.“"
                            },
                            {
                                "example_id": "aeb11ca2-4379-4e4e-a7fd-0821226eeec5",
                                "sense_id": "c266d2e7-4d61-3cb8-8861-9894b91d5ee7",
                                "text": "„Nachdem er gewählt hatte, bat er mich um Schreibzeug, um mir eine Quittung auszustellen.“"
                            },
                            {
                                "example_id": "217af3fb-5af8-4435-baf7-640f59a2863e",
                                "sense_id": "c266d2e7-4d61-3cb8-8861-9894b91d5ee7",
                                "text": "„Ich breite mein Schreibzeug auf die Back und versuche zu arbeiten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "43f0ccc0-821a-36de-a036-f98cd7554102",
                        "entry_id": "a9af6e63-c9ec-34d2-bcfd-7b713f2f8f7f",
                        "glosses": [
                            "oft kunstvoll gestalteter Tischschmuck mit integrierten Tintenfässern und Ablagemöglichkeit für die Feder"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ffef1873-154f-4c5d-90d4-2bef71abb67d",
                                "sense_id": "43f0ccc0-821a-36de-a036-f98cd7554102",
                                "text": "Als nächste Position wird ein bronzenes Schreibzeug im Jugendstil versteigert."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c500c705-5421-47b3-9b00-5d335a3510d0",
                        "source_entry_id": "a9af6e63-c9ec-34d2-bcfd-7b713f2f8f7f",
                        "source_sense_id": "c266d2e7-4d61-3cb8-8861-9894b91d5ee7",
                        "source_sense_description": "umgangssprachlich, nur Singular: Materialien, die zum Schreiben genutzt werden",
                        "target_lang_word": "écritoire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "écritoire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cc40f8bf-2007-30e3-a65e-63d7a73a40b7",
                                        "entry_id": "204d03ce-1916-3183-9f03-a0e444baec41",
                                        "glosses": [
                                            "Godet où l’on prend de l’encre avec la plume et qu’on appelle plus ordinairement encrier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1edba188-3f88-4356-912e-b9948e201b34",
                                                "sense_id": "cc40f8bf-2007-30e3-a65e-63d7a73a40b7",
                                                "text": "Ne parlons pas de cela, dit le juif en pâlissant et tirant à la hâte une écritoire de sa ceinture."
                                            },
                                            {
                                                "example_id": "92084288-609c-4045-bea3-54ad6875bcb0",
                                                "sense_id": "cc40f8bf-2007-30e3-a65e-63d7a73a40b7",
                                                "text": "Le diable rôde autour de l’homme ; Jésus lui-même n’a pas été à l’abri de ses embûches ; la tentation de saint Antoine est populaire ; Martin Luther fut aussi tourmenté par Satan, et, pour s’en débarrasser, fut obligé de lui jeter son écritoire à la tête. On voit encore la tache d’encre sur le mur de la cellule."
                                            },
                                            {
                                                "example_id": "fb986296-3a34-40a4-b635-d58deaf5f7a4",
                                                "sense_id": "cc40f8bf-2007-30e3-a65e-63d7a73a40b7",
                                                "text": "Curieux : « De quoi sert cette oblongue capsule ?\n D’écritoire, Monsieur, ou de boîte à ciseaux ? »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cfc1af59-e267-3cac-ae44-e003c85234f0",
                                        "entry_id": "204d03ce-1916-3183-9f03-a0e444baec41",
                                        "glosses": [
                                            "Petit meuble qui contenait ou renfermait les choses nécessaires pour écrire : encre, papier, plume, canif, etc."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "916a9f85-6adf-410d-b8d1-03b869cd7c7d",
                                                "sense_id": "cfc1af59-e267-3cac-ae44-e003c85234f0",
                                                "text": "[…] la place du candidat était marquée à l'autre bout, et directement en face; une écritoire et des feuilles de papier, placées sur le bureau, annonçaient l’intention, soit de prendre des notes, soit de rédiger le procès-verbal de la séance."
                                            },
                                            {
                                                "example_id": "b682296b-3662-4cb7-b2fa-2c9ebc9a7099",
                                                "sense_id": "cfc1af59-e267-3cac-ae44-e003c85234f0",
                                                "text": "En ce moment fortuné arriva la troisième lettre de Leuwen. Les premières avaient fait un vif plaisir, mais on n’avait pas eu la moindre tentation d’y répondre. Après avoir lu cette dernière, Bathilde courut chercher son écritoire, la plaça sur une table, l’ouvrit, et commença à écrire, sans se permettre de raisonner avec soi-même."
                                            },
                                            {
                                                "example_id": "661f5bf3-709b-422e-a1a2-a21f27ecf2cb",
                                                "sense_id": "cfc1af59-e267-3cac-ae44-e003c85234f0",
                                                "text": "Cette pièce était meublée d’un petit lit de fer, […] ; en face de la couche, une table, couverte d’un tapis et d’une écritoire, et un prie-Dieu au-dessus duquel était cloué un Christ ; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ff81659-cc6c-3df3-9ff1-fa92681e1041",
                                        "entry_id": "204d03ce-1916-3183-9f03-a0e444baec41",
                                        "glosses": [
                                            "Pièce où l'on écrit, bureau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31844496-3d0f-4cb5-9f72-48d33f619b41",
                                                "sense_id": "5ff81659-cc6c-3df3-9ff1-fa92681e1041",
                                                "text": "Mais à Kirchberger qui l'interrogeait sur le Nouvel homme il avait aussi confié en septembre 1792 sa lassitude de l'écriture : « J'ai assez séjourné dans mon écritoire ; je ne dois plus m'enfoncer dans ce genre d'occupation, et désormais …»."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0e5fdf00-9840-4ebe-a9a1-2e4bfded24d8",
                        "source_entry_id": "a9af6e63-c9ec-34d2-bcfd-7b713f2f8f7f",
                        "source_sense_id": "c266d2e7-4d61-3cb8-8861-9894b91d5ee7",
