                                "target_senses": [
                                    {
                                        "sense_id": "c306ebef-6b28-39a0-ba3f-819f334027fa",
                                        "entry_id": "32197707-4455-3c90-b618-1d2bd4ed806d",
                                        "glosses": [
                                            "Disposition allongée de la face, qui porte la mâchoire en avant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6440eaef-9bf6-451e-acae-19aad90dfb02",
                                                "sense_id": "c306ebef-6b28-39a0-ba3f-819f334027fa",
                                                "text": "Je souffre d’un léger prognathisme car ma mâchoire inférieure passe devant ma mâchoire supérieure."
                                            },
                                            {
                                                "example_id": "4444b679-3598-4afa-9560-9deb945864d8",
                                                "sense_id": "c306ebef-6b28-39a0-ba3f-819f334027fa",
                                                "text": "Un prognathisme de la mâchoire inférieure l’empêchait d’articuler, il [Chris Marker] parlait dents serrées et compensait la rareté de sa parole par un port de tête orgueilleux et ironique, qui changeait en énigmatique maxime chacune de ses proférations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e39bb26-e38c-3823-ba63-c54a9b32558e",
                                        "entry_id": "32197707-4455-3c90-b618-1d2bd4ed806d",
                                        "glosses": [
                                            "Configuration faciale selon laquelle une des deux mâchoires est plus longue que l’autre (particulièrement chez le chien)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fc0fe5c-c92e-4147-903b-30764b6c7a59",
                                                "sense_id": "5e39bb26-e38c-3823-ba63-c54a9b32558e",
                                                "text": "Un chien possédant un prognathisme supérieur est dit bégu."
                                            },
                                            {
                                                "example_id": "8c2a5fce-ecad-44fc-86f6-bc6a9c6c3004",
                                                "sense_id": "5e39bb26-e38c-3823-ba63-c54a9b32558e",
                                                "text": "Un chien possédant un prognathisme inférieur excessif est dit grignard."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "45d38882-a085-4191-bbe2-951b1a596b5a",
                        "source_entry_id": "9fed2924-c02b-3d08-9f08-814e07a19085",
                        "source_sense_id": "aee1a265-7746-32af-8ca4-bb07e36a4174",
                        "target_lang_word": "prognatismo",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prognatismo",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "84c126d0-a575-393b-86a7-fda55b055c9d",
                                        "entry_id": "a8c58047-d095-3167-91e7-9bf620050895",
                                        "glosses": [
                                            "Protrusión (deformación sobresaliente) en el plano vertical de la cara, ya sea en la parte inferior o en la superior de la mandíbula, causada por factores hereditarios o por alguna otra etiología. En la especie humana dificulta el habla, el dentelleo y la masticación."
                                        ],
                                        "tags": [
                                            "osteología"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "498fc1e6-1267-4a3c-b741-711f5409c514",
                                                "sense_id": "84c126d0-a575-393b-86a7-fda55b055c9d",
                                                "text": "Prognatismo. Es una extensión o protrusión del maxilar inferior (mandíbula). Ocurre cuando los dientes no están alineados de manera apropiada debido a la forma de los huesos de la cara. Consideraciones. El prognatismo puede causar oclusión dental defectuosa (desalineación de las superficies oclusoras de los dientes superiores e inferiores), lo que puede darle a las personas una apariencia de enfado o de peleador. El prognatismo puede ser un síntoma de diversos síndromes o afecciones"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
