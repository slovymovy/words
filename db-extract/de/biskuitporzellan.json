                                        "sense_id": "ba03b8e1-0c40-3121-8cd4-cf3faa170679",
                                        "entry_id": "aa717f81-96e5-3901-81b8-d0e0cfb63112",
                                        "glosses": [
                                            "Partie dure, pierreuse, d’une pierre à chaux calcinée."
                                        ],
