        "fr-extract.jsonl": [
            {
                "entry_id": "b47cc749-76a1-3658-84ff-e63fb5ed13b8",
                "word": "formalité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "73fa8f4f-ac76-4c33-85c5-4982ee35f63e",
                        "entry_id": "b47cc749-76a1-3658-84ff-e63fb5ed13b8",
                        "tags": [
                            "plural"
                        ],
                        "form": "formalités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "507c1db0-1dc7-34a4-9da7-e7a7e967eef2",
                        "entry_id": "b47cc749-76a1-3658-84ff-e63fb5ed13b8",
                        "glosses": [
                            "Formule prescrite obligatoirement pour la validité de certains actes civils, judiciaires, administratifs, religieux, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b27d112e-16bd-431b-b1ab-7ff05f3509a0",
                                "sense_id": "507c1db0-1dc7-34a4-9da7-e7a7e967eef2",
                                "text": "Les formalités nécessaires à la validité d’un contrat, d’un testament, d’un mariage."
                            },
                            {
                                "example_id": "17c097a7-66f5-4f06-b049-6f199a8a7b43",
                                "sense_id": "507c1db0-1dc7-34a4-9da7-e7a7e967eef2",
                                "text": "Nous n’eûmes pas à subir les formalités de la douane : l’Islande et les îles Fortunées sont les deux seuls pays où je n’aie pas rencontré cette aimable institution."
                            },
                            {
                                "example_id": "d93f4720-fd0d-48ab-a191-a2ab1595d590",
                                "sense_id": "507c1db0-1dc7-34a4-9da7-e7a7e967eef2",
                                "text": "Je la revis un an après avec son enfant. Elle me demanda d’être témoin à la mairie pour la reconnaissance. Il y avait des formalités compliquées, car l’enfant était né à l’étranger."
                            },
                            {
                                "example_id": "d2e76329-2e67-4b8e-a610-dc0a2c48f4e9",
                                "sense_id": "507c1db0-1dc7-34a4-9da7-e7a7e967eef2",
                                "text": "L’agent sanitaire maritime accoste et grimpe à bord. Après les formalités de l’arraisonnement je m’informe auprès de lui d’un hôtel et du moyen de s’y rendre."
                            }
                        ]
                    },
                    {
                        "sense_id": "5fd768e5-71b6-311d-8829-29dabc7ea98f",
                        "entry_id": "b47cc749-76a1-3658-84ff-e63fb5ed13b8",
                        "glosses": [
                            "Ensemble d’usages et d’actes d’une civilité recherchée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6faac308-0abb-476f-9036-6872143f16fb",
                                "sense_id": "5fd768e5-71b6-311d-8829-29dabc7ea98f",
                                "text": "Il attachait une grande importance aux moindres formalités de l’étiquette."
                            },
                            {
                                "example_id": "46e1e834-1d4d-4219-9cb9-a5d62a9024a2",
                                "sense_id": "5fd768e5-71b6-311d-8829-29dabc7ea98f",
                                "text": "Il entra et s’assit, sans autre formalité, sans plus de formalités."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0230abf2-474d-4981-9c9f-65c98b1ff5ea",
                        "source_entry_id": "b47cc749-76a1-3658-84ff-e63fb5ed13b8",
                        "target_lang_word": "formality",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "formality",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "29f91ae9-7056-31cc-b130-e0d75e7a356c",
                                        "entry_id": "c4ffd979-d3b7-391f-9109-eba3185f13c0",
                                        "glosses": [
                                            "The state of being formal."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "038fe986-feac-4e68-9584-77fbf87a458a",
                                                "sense_id": "29f91ae9-7056-31cc-b130-e0d75e7a356c",
                                                "text": "[S]uch an one […] recalls as a vision of Paradise the land he has learnt to love; he exaggerates the insalubrity of a northern climate; he bewails the wretched formality of our civilised life, and so, back to the distant solitudes flies his recollection like a dove to the wilderness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1dbfd038-34fb-38c7-9e39-797513f6149f",
                                        "entry_id": "c4ffd979-d3b7-391f-9109-eba3185f13c0",
                                        "glosses": [
                                            "Something said or done as a matter of form."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a09a9cc8-d6f9-3fd4-9a42-ecccac545f40",
                                        "entry_id": "c4ffd979-d3b7-391f-9109-eba3185f13c0",
                                        "glosses": [
                                            "A customary ritual without substance, real consequence, or unique meaning."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0ab4b6f-fc87-433f-aa5e-8152d71c368d",
                                                "sense_id": "a09a9cc8-d6f9-3fd4-9a42-ecccac545f40",
                                                "text": "The examination for priesthood is no mere formality, so we have to study well."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1089fb1-342b-3d23-ba7d-2ec7c94aadbf",
                                        "entry_id": "c4ffd979-d3b7-391f-9109-eba3185f13c0",
                                        "glosses": [
                                            "A specific requirement for obtaining a legal status, conducting a transaction, etc."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "202aef0d-b8ae-46f6-8f92-cbc905732b66",
                        "source_entry_id": "b47cc749-76a1-3658-84ff-e63fb5ed13b8",
                        "target_lang_word": "formalidad",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "formalidad",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "e3f69382-f53f-37f9-b125-d4bf38fd0f2a",
                                        "entry_id": "27ade5a3-747b-33d0-809d-ef9561c754af",
                                        "glosses": [
                                            "Precisión, concreción y puntualidad."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b023692f-9554-460d-877a-aec468cf82ef",
                                                "sense_id": "e3f69382-f53f-37f9-b125-d4bf38fd0f2a",
                                                "text": "A pesar de la precisión y la formalidad del Sol, los relojes solares tienen dos problemas: la noche y los días nublados"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e301116f-9137-32b9-b42d-e64645946a58",
                                        "entry_id": "27ade5a3-747b-33d0-809d-ef9561c754af",
                                        "glosses": [
                                            "Trámite o exigencia necesaria para la ejecución de algo."
                                        ],
                                        "tags": [
                                            "generalmente en plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3b0e98b-3593-43de-9484-e963010cce69",
                                                "sense_id": "e301116f-9137-32b9-b42d-e64645946a58",
                                                "text": "La definición de la función, considerada a menudo como una formalidad administrativa, debe servir de ocasión para establecer por escrito un \"contrato de confianza\""
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7f708bd6-e111-3104-be65-d103035604f5",
                                        "entry_id": "27ade5a3-747b-33d0-809d-ef9561c754af",
                                        "glosses": [
                                            "Procedimiento concreto de ejecución de un acto público."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d44d14c-acff-49e8-ac9f-51dcbd61c0b6",
                                                "sense_id": "7f708bd6-e111-3104-be65-d103035604f5",
                                                "text": "La formalidad del acontecimiento se completó con el embanderamiento de la ciudad, y una impecable formación militar frente al Palacio"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "763d2869-05ba-3453-83b0-c949fa8c0967",
                                        "entry_id": "27ade5a3-747b-33d0-809d-ef9561c754af",
                                        "glosses": [
                                            "Solemnidad, gravedad, buen comportamiento."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2b6494c-e151-4dd3-9c6b-9183a0b9d139",
                                                "sense_id": "763d2869-05ba-3453-83b0-c949fa8c0967",
                                                "text": "Es característico del pésame el saludo no verbal, entre hombres con una palmada en el hombro y un beso en la mejilla entre las mujeres o entre mujeres y hombres: el darse la mano es señal de mucha formalidad, lo que es corriente en Alemania, pero no en Venezuela"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
