                        "entry_id": "9cf34f34-f710-3849-8d8c-d82caf4540da",
                        "glosses": [
                            "Plante de la famille des Composées, aujourd'hui Astéracées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91b3b760-01a3-4eb4-9927-20466f111dac",
                                "sense_id": "06603de5-4891-3ccf-b077-7628edab8a57",
                                "text": "Voici une composée que je n'arrive pas à déterminer, prise le 15 mai dans un lieu sec et rocailleux."
                            },
                            {
                                "example_id": "e2d29d85-6a08-47ea-8032-fb77e871e92f",
                                "sense_id": "06603de5-4891-3ccf-b077-7628edab8a57",
                                "text": "A Mayence se trouve une colonie sarmatique intéressante où les sables portent des Stipa et diverses Composées."
                            }
                        ]
                    },
                    {
                        "sense_id": "d8cbd4e4-5418-3ede-a0b0-52a50fa25eb4",
                        "entry_id": "9cf34f34-f710-3849-8d8c-d82caf4540da",
                        "glosses": [
                            "Fonction composée, c’est-à-dire obtenue par composition de deux fonctions."
                        ],
                        "tags": [
                            "ellipsis"
                        ],
                        "examples": [
                            {
                                "example_id": "ac0d600f-52eb-4a69-b31c-2fda17e39b2e",
                                "sense_id": "d8cbd4e4-5418-3ede-a0b0-52a50fa25eb4",
                                "text": "La composée de la conjugaison complexe par elle-même n’est autre que l’identité."
                            }
                        ]
                    }
