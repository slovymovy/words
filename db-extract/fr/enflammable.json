                    {
                        "translation_id": "c63f3344-38bb-4465-a7dd-eeb6485791d3",
                        "source_entry_id": "25a3ebfd-d1f2-37d8-b7d1-eb4c388a4022",
                        "source_sense_id": "5b1b937f-bbf2-3a84-bbe9-33f1adb3d361",
                        "target_lang_word": "feuergefährlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "feuergefährlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "574957b6-dea1-37b0-ab9f-41f789a8607d",
                                        "entry_id": "313abe61-d292-314c-9e32-9f031694377f",
                                        "glosses": [
                                            "leicht entzündlich; mit einer Gefahr einer Entzündung / eines Brandes verbunden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d33eef5-cf5e-4fe9-8d31-739a1c0b0473",
                                                "sense_id": "574957b6-dea1-37b0-ab9f-41f789a8607d",
                                                "text": "Feuergefährliche Stoffe müssen in geeigneten Räumen gelagert werden."
                                            },
                                            {
                                                "example_id": "bffa2538-7a79-4d12-8af7-421250bc48b3",
                                                "sense_id": "574957b6-dea1-37b0-ab9f-41f789a8607d",
                                                "text": "Die Elektrolyte in Lithium-Ionen-Batterien, wie sie in Laptops, Smartphones oder Autos verbaut werden, bestehen aus organischen Materialien, die feuergefährlich sind."
                                            },
                                            {
                                                "example_id": "a97c0dde-01f5-4230-86e1-bf887eddee2c",
                                                "sense_id": "574957b6-dea1-37b0-ab9f-41f789a8607d",
                                                "text": "„Titan ist als Pulver feuergefährlich, kompakt ungefährlich.“"
                                            },
                                            {
                                                "example_id": "6623b9f5-de24-4a6e-bd50-870aa6d497cc",
                                                "sense_id": "574957b6-dea1-37b0-ab9f-41f789a8607d",
                                                "text": "„Explodiert war die Kammfabrik, weil sich Zelluloidstaub entzündet hatte. Aus dem feuergefährlichen Zelluloid (oder «Zäuerit», wie die Mümliswiler sagten) stellte die Fabrik die schmucken Kämme her, welche sie in die halbe Welt exportierte.“"
                                            },
                                            {
                                                "example_id": "b003f576-c07b-4821-8140-354372ba4216",
                                                "sense_id": "574957b6-dea1-37b0-ab9f-41f789a8607d",
                                                "text": "„[…] Helium […] ist nicht feuergefährlich, denn Edelgase sind reaktionsträge – sie verbinden sich kaum mit anderen Elementen.“"
                                            },
                                            {
                                                "example_id": "8ee2d9c5-e7af-421f-a28a-6448453d3b2e",
                                                "sense_id": "574957b6-dea1-37b0-ab9f-41f789a8607d",
                                                "text": "„Für Samsung bedeutet die Absetzung des feuergefährlichen Smartphones Galaxy Note 7 einen herben Image-Verlust.“"
                                            },
                                            {
                                                "example_id": "6b44139d-8a25-4ccd-bcfc-e2bbe028c93c",
                                                "sense_id": "574957b6-dea1-37b0-ab9f-41f789a8607d",
                                                "text": "„Seit zwei Monaten muss der hochmoderne Langstreckenjet \"Dreamliner\" schon am Boden bleiben. Feuergefährliche Batterien führten zu einem Flugverbot.“"
                                            },
                                            {
                                                "example_id": "3b374ed1-1958-4ce0-82c6-8d158836e608",
                                                "sense_id": "574957b6-dea1-37b0-ab9f-41f789a8607d",
                                                "text": "„Haithabu – […] Gerade die feuergefährlichen Gewerbe, die die Holzhäuser leicht in Brand setzten konnten, waren sicherheitshalber abseits der Bebauung angesiedelt.“"
                                            },
                                            {
                                                "example_id": "f4242d26-450f-46d4-97c4-fe39b284c36b",
                                                "sense_id": "574957b6-dea1-37b0-ab9f-41f789a8607d",
                                                "text": "„Standheizung [dürfen] fast überall betrieben werden. Ausnahmen stellen geschlossene Räume, wie Garagen oder Parkhäuser, und feuergefährliche Umgebungen, wie zum Beispiel Tankstellengelände, dar.“"
                                            },
                                            {
                                                "example_id": "0522e5f9-3eae-41aa-94b1-9fb0fc1c9c8e",
                                                "sense_id": "574957b6-dea1-37b0-ab9f-41f789a8607d",
                                                "text": "„In den letzten Wochen wurde das Gebäude saniert. […] Nach Angaben der Gemeinde [sind] an der Kirche allerdings noch keine feuergefährlichen Arbeiten wie etwa Schweißarbeiten ausgeführt worden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
