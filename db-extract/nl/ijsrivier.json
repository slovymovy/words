                        "glosses": [
                            "een hoeveelheid ijs die zich langzaam naar beneden glijdt op een manier die lijkt op die van een rivier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0cec820-6568-49e4-be6c-e2b3e4fa45f0",
                                "sense_id": "eefb808f-c0a3-3a00-a1fe-172f0c6d38cf",
                                "text": "Ook wordt momenteel onderzocht of aardbevingen iets te maken hebben met de beweging van de Whillans Ice Stream, een ijsrivier op Antarctica die tweemaal per dag een halve meter verschuift richting de Rosszee."
                            }
