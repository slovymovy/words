                "senses": [
                    {
                        "sense_id": "1d2d78b8-d000-3d13-83ba-9468a2f7467f",
                        "entry_id": "1481ead4-8219-3306-8958-176122755048",
                        "glosses": [
                            "wymienialne pokrycie na pościel"
                        ],
                        "tags": [],
