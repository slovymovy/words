    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "57687bf1-ab3e-3d24-9b2e-e24a298cb5e6",
                    "sense_definition": "The light and heat which are received from the sun; sunshine or sunlight.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "solar_phenomena",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cat spent the entire afternoon sleeping in the <w>sun</w> on the porch.",
                            "target_lang_translations": {
                                "ru": "Кот провёл весь день, спя на <w>солнце</w> на крыльце."
                            }
                        },
                        {
                            "text": "It is important to wear a hat to keep the <w>sun</w> out of your eyes.",
                            "target_lang_translations": {
                                "ru": "Важно носить шляпу, чтобы <w>солнце</w> не слепило глаза."
                            }
                        }
                    ],
                    "common_phrases": [
                        "in the sun",
                        "out of the sun",
                        "bright sun"
                    ],
                    "target_lang_definitions": {
                        "ru": "Свет и тепло, получаемые от солнца; солнечный свет."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "солнце",
                                "target_lang_sense_clarification": "солнечный свет и тепло"
                            },
                            {
                                "target_lang_word": "солнечный свет",
                                "target_lang_sense_clarification": "освещение от солнца"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "289d4e4e-dcdc-3bb0-866e-cd79ef073187",
                    "sense_definition": "A star, especially when seen as the centre of any single solar system.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "astronomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Astronomers have discovered a distant planet that orbits two different <w>suns</w>.",
                            "target_lang_translations": {
                                "ru": "Астрономы обнаружили далекую планету, которая вращается вокруг двух разных <w>солнц</w>."
                            }
                        },
                        {
                            "text": "Every <w>sun</w> in the galaxy has the potential to host its own planetary system.",
                            "target_lang_translations": {
                                "ru": "Каждое <w>солнце</w> в галактике потенциально может иметь свою планетную систему."
                            }
                        }
                    ],
                    "common_phrases": [
                        "distant sun",
                        "binary sun"
                    ],
                    "target_lang_definitions": {
                        "ru": "Звезда, являющаяся центром какой-либо планетной системы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "солнце",
                                "target_lang_sense_clarification": "звезда как центр системы"
                            },
                            {
                                "target_lang_word": "светило",
                                "target_lang_sense_clarification": "небесное тело, излучающее свет"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "db8a12f7-8b57-317f-b7e5-8733c0f23675",
                    "sense_definition": "The time of sunrise or sunset.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The laborers worked from <w>sun</w> to <w>sun</w> to finish the harvest before the rain.",
                            "target_lang_translations": {
                                "ru": "Рабочие трудились от <w>зари</w> до <w>зари</w>, чтобы закончить сбор урожая до дождя."
                            }
                        },
                        {
                            "text": "We shall meet tomorrow at first <w>sun</w> near the old oak tree.",
                            "target_lang_translations": {
                                "ru": "Мы встретимся завтра с первым <w>лучом солнца</w> у старого дуба."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sun to sun",
                        "first sun"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in phrases like 'sun to sun'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Время восхода или заката."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "солнце",
                                "target_lang_sense_clarification": "в значении времени суток"
                            },
                            {
                                "target_lang_word": "восход",
                                "target_lang_sense_clarification": "появление солнца"
                            },
                            {
                                "target_lang_word": "закат",
                                "target_lang_sense_clarification": "заход солнца"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dee2292a-66ec-3559-b69b-fa270f509680",
                    "sense_definition": "A day, measured by the transversing of the sky by the Sun.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It has been many <w>suns</w> since the travelers last saw a sign of civilization.",
                            "target_lang_translations": {
                                "ru": "Прошло много <w>солнц</w>, прежде чем путешественники снова увидели признаки цивилизации."
                            }
                        },
                        {
                            "text": "The tribe promised to return in three <w>suns</w> with the necessary supplies.",
                            "target_lang_translations": {
                                "ru": "Племя обещало вернуться через три <w>солнца</w> с необходимыми припасами."
                            }
                        }
                    ],
                    "common_phrases": [
                        "many suns"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in literary or historical contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "День, измеряемый прохождением Солнца по небу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "солнце",
                                "target_lang_sense_clarification": "поэтическое или архаичное обозначение дня"
                            },
                            {
                                "target_lang_word": "день",
                                "target_lang_sense_clarification": "сутки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "20c64537-cdef-30f4-84fc-81880fec4387",
                    "sense_definition": "A traditional Japanese unit of length, approximately 30.3 millimetres.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The craftsman measured the length of the blade in <w>sun</w> according to tradition.",
                            "target_lang_translations": {
                                "ru": "Мастер измерил длину клинка в <w>сунях</w> согласно традиции."
                            }
                        },
                        {
                            "text": "A standard Japanese sword might be several <w>sun</w> longer than a dagger.",
                            "target_lang_translations": {
                                "ru": "Стандартный японский меч может быть на несколько <w>суней</w> длиннее кинжала."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Japan"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Традиционная японская единица длины, примерно 30,3 миллиметра."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сунь",
                                "target_lang_sense_clarification": "японская мера длины"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "e9ab61b0-9872-3925-a852-343fcf7f7919",
                    "sense_definition": "The star at the center of our Solar System which provides light and heat to Earth.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "astronomy",
                    "name_type": "astronomical_name",
                    "examples": [
                        {
                            "text": "The Earth takes one year to complete a full orbit around the <w>Sun</w>.",
                            "target_lang_translations": {
                                "ru": "Земле требуется один год, чтобы совершить полный оборот вокруг <w>Солнца</w>."
                            }
                        },
                        {
                            "text": "Looking directly at the <w>Sun</w> without protection can cause permanent eye damage.",
                            "target_lang_translations": {
                                "ru": "Если смотреть прямо на <w>Солнце</w> без защиты, можно необратимо повредить зрение."
                            }
                        }
                    ],
                    "synonyms": [
                        "Sol"
                    ],
                    "common_phrases": [
                        "the Sun"
                    ],
                    "target_lang_definitions": {
                        "ru": "Звезда в центре нашей Солнечной системы, обеспечивающая Землю светом и теплом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Солнце",
                                "target_lang_sense_clarification": "название нашей звезды"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "20a3087d-aaff-3b22-9643-34b576125c33",
                    "sense_definition": "A popular English tabloid newspaper.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "media",
                    "name_type": "organization_name",
                    "examples": [
                        {
                            "text": "He was reading a sensational story on the front page of the <w>Sun</w> this morning.",
                            "target_lang_translations": {
                                "ru": "Сегодня утром он читал сенсационную статью на первой полосе газеты «<w>Сан</w>»."
                            }
                        },
                        {
                            "text": "The <w>Sun</w> is known for its celebrity gossip and bold headlines.",
                            "target_lang_translations": {
                                "ru": "Газета «<w>Сан</w>» известна своими сплетнями о знаменитостях и дерзкими заголовками."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "United Kingdom"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Популярная английская таблоидная газета."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Сан",
                                "target_lang_sense_clarification": "название британской газеты"
                            },
                            {
                                "target_lang_word": "The Sun",
                                "target_lang_sense_clarification": "оригинальное название издания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bbf84a52-0687-364f-9415-04181aab4aca",
                    "sense_definition": "A surname.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Professor <w>Sun</w> published a groundbreaking paper on renewable energy sources.",
                            "target_lang_translations": {
                                "ru": "Профессор <w>Сунь</w> опубликовал новаторскую работу о возобновляемых источниках энергии."
                            }
                        },
                        {
                            "text": "The <w>Suns</w> have lived in this neighborhood for over three decades.",
                            "target_lang_translations": {
                                "ru": "Семья <w>Сан</w> живет в этом районе уже более тридцати лет."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "common in East Asia"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Сунь",
                                "target_lang_sense_clarification": "китайская фамилия"
                            },
                            {
                                "target_lang_word": "Сан",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9dc0ce7b-b54a-3f1d-b747-90545ae880d7",
                    "sense_definition": "To expose oneself or something to the heat and radiation of the sun.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We spent the whole morning <w>sunning</w> ourselves on the golden sand.",
                            "target_lang_translations": {
                                "ru": "Мы провели все утро, <w>загорая</w> на золотистом песке."
                            }
                        },
                        {
                            "text": "The lizards like to <w>sun</w> themselves on the rocks to regulate their body temperature.",
                            "target_lang_translations": {
                                "ru": "Ящерицы любят <w>греться</w> на камнях, чтобы регулировать температуру тела."
                            }
                        }
                    ],
                    "synonyms": [
                        "apricate"
                    ],
                    "common_phrases": [
                        "sun oneself"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подставлять себя или что-либо под тепло и излучение солнца."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "загорать",
                                "target_lang_sense_clarification": "находиться на солнце для загара"
                            },
                            {
                                "target_lang_word": "греться",
                                "target_lang_sense_clarification": "согреваться на солнце"
                            },
                            {
                                "target_lang_word": "нежиться",
                                "target_lang_sense_clarification": "наслаждаться солнечным теплом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2131377f-1a19-3aee-8120-afc482d3e2c5",
                    "sense_definition": "To warm or dry something in the sunshine.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to <w>sun</w> the damp blankets on the balcony.",
                            "target_lang_translations": {
                                "ru": "Она решила <w>просушить</w> влажные одеяла на солнце на балконе."
                            }
                        },
                        {
                            "text": "The fruit was left out to <w>sun</w> until it became sweet and dry.",
                            "target_lang_translations": {
                                "ru": "Фрукты оставили <w>вялиться на солнце</w>, пока они не стали сладкими и сухими."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Греть или сушить что-либо на солнечном свету."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сушить",
                                "target_lang_sense_clarification": "высушивать на солнце"
                            },
                            {
                                "target_lang_word": "прогревать",
                                "target_lang_sense_clarification": "выставлять на солнце для тепла"
                            },
                            {
                                "target_lang_word": "выставлять на солнце",
                                "target_lang_sense_clarification": "помещать под солнечные лучи"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}