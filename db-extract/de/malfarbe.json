                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "65c93d61-0e72-4d48-b2f0-ef34108abb51",
                        "source_entry_id": "055e3bc8-fbee-373b-a0df-008fbd1bf470",
                        "source_sense_id": "b837c708-ab78-3179-91ef-ec2ce1fd5a86",
                        "source_sense_description": "Farbe zum Malen",
                        "target_lang_word": "paint",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paint",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d04b9f59-8357-39ce-8a29-695fb298de37",
                                        "entry_id": "abcbafde-6427-3566-992c-364e808cf922",
                                        "glosses": [
                                            "A substance that is applied as a liquid or paste, and dries into a solid coating that protects or adds colour to an object or surface to which it has been applied."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c48f812-b61b-42fc-9f7b-4b41810dc093",
                                                "sense_id": "d04b9f59-8357-39ce-8a29-695fb298de37",
                                                "text": "fresh coat of paint"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c47845e-0236-3d75-9150-780d6ec72c82",
                                        "entry_id": "abcbafde-6427-3566-992c-364e808cf922",
                                        "glosses": [
                                            "A set of containers or blocks of paint of different colors/colours, used for painting pictures."
                                        ],
                                        "tags": [
                                            "countable",
                                            "in-plural",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82a3969e-b7c6-4c44-8767-21fc2ae5847c",
                                                "sense_id": "4c47845e-0236-3d75-9150-780d6ec72c82",
                                                "text": "René went back into the kitchen and put a pot of coffee on, got out his paints and started on a new painting. He felt inspired."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38d78517-b0e6-3b02-8d51-2c27ce750fd8",
                                        "entry_id": "abcbafde-6427-3566-992c-364e808cf922",
                                        "glosses": [
                                            "The free-throw lane, construed with the."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "443547dc-3747-4d43-84b4-16cb10ea3131",
                                                "sense_id": "38d78517-b0e6-3b02-8d51-2c27ce750fd8",
                                                "text": "The Nimrods are strong on the outside, but not very good in the paint."
                                            },
                                            {
                                                "example_id": "600d4b3b-a71b-4d77-8b75-3f60243d5bd3",
                                                "sense_id": "38d78517-b0e6-3b02-8d51-2c27ce750fd8",
                                                "text": "Early on it was the Bulldogs who were clearly the aggressors, playing hard in the paint and getting baskets with muscle more than with their shooting prowess."
                                            },
                                            {
                                                "example_id": "8f044186-e0f1-4a55-82a1-3b13e3be71f0",
                                                "sense_id": "38d78517-b0e6-3b02-8d51-2c27ce750fd8",
                                                "text": "Isaiah Thomas is very clever, very crafty getting to the paint and finishing in the paint."
                                            },
                                            {
                                                "example_id": "d7a57b33-1b33-409a-9f88-3a2f131a272e",
                                                "sense_id": "38d78517-b0e6-3b02-8d51-2c27ce750fd8",
                                                "text": "In Game 3, they re-focused on protecting the paint and transition defense. The Cavs scored 106 points in the paint in the first two games and just 20 in Game 3."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0bf7fd7b-6528-3af8-8d99-b24d1b0812ef",
                                        "entry_id": "abcbafde-6427-3566-992c-364e808cf922",
                                        "glosses": [
                                            "Paintballs."
                                        ],
                                        "tags": [
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae91c669-6103-4d4f-964c-b194f549dd22",
                                                "sense_id": "0bf7fd7b-6528-3af8-8d99-b24d1b0812ef",
                                                "text": "I am running low on paint for my marker."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "809b96ff-c7f8-3100-913b-cfa716c5a1bf",
                                        "entry_id": "abcbafde-6427-3566-992c-364e808cf922",
                                        "glosses": [
                                            "Synonym of face card (king, queen, or jack)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e5f22a23-b632-3d6d-8f4b-80985fb37356",
                                        "entry_id": "abcbafde-6427-3566-992c-364e808cf922",
                                        "glosses": [
                                            "Graphics drawn using an input device, not scanned or generated."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3d6affb-9dc1-45a5-860f-2ef9c6586cca",
                                                "sense_id": "e5f22a23-b632-3d6d-8f4b-80985fb37356",
                                                "text": "It combines traditional paint capabilities with photograph enhancement features."
                                            },
                                            {
                                                "example_id": "436f821b-d042-4059-8365-997764113d30",
                                                "sense_id": "e5f22a23-b632-3d6d-8f4b-80985fb37356",
                                                "text": "Computer paint software operates similarly but adds features that are delightfully familiar and useful to artists trained in traditional graphics materials."
                                            },
                                            {
                                                "example_id": "aebe1158-8fe2-4aa4-b217-ba4fa2c6f5f7",
                                                "sense_id": "e5f22a23-b632-3d6d-8f4b-80985fb37356",
                                                "text": "If using a paint package, you must specify the color before you draw the line or shape."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "012e01f4-6eec-37ee-89b4-ed4de6fde695",
                                        "entry_id": "abcbafde-6427-3566-992c-364e808cf922",
                                        "glosses": [
                                            "Makeup."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c755e85b-4cb3-4075-81a8-a40a4add3364",
                                                "sense_id": "012e01f4-6eec-37ee-89b4-ed4de6fde695",
                                                "text": "They were as plain and homely as a table-top dancer when the rains had wiped the paint and powder from her face."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de47dfd5-3519-32c4-a6fa-561b4fd1cdec",
                                        "entry_id": "abcbafde-6427-3566-992c-364e808cf922",
                                        "glosses": [
                                            "Tattoo work."
                                        ],
                                        "tags": [
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "55d30db5-52e6-3fc7-89a2-9eb322c4ad97",
                                        "entry_id": "abcbafde-6427-3566-992c-364e808cf922",
                                        "glosses": [
                                            "Any substance fixed with latex to harden it."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "be07f1f8-4a2e-3239-a538-715a8323dd7b",
                                        "entry_id": "abcbafde-6427-3566-992c-364e808cf922",
                                        "glosses": [
                                            "The appearance of an object on a radar screen."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f758358-660d-4382-a297-2dc2b71c5b8a",
                                                "sense_id": "be07f1f8-4a2e-3239-a538-715a8323dd7b",
                                                "text": "Smaller target paints would also be preferred to those displayed on the existing DFTI."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "paint",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2a84297f-2bb2-3f92-bbfc-d6e87a3b8f4f",
                                        "entry_id": "eba6b82e-338a-3311-a391-865dba2ed8da",
                                        "glosses": [
                                            "To apply paint to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b3d10d1-558c-44a8-ac7c-893c26e3bacd",
                                                "sense_id": "2a84297f-2bb2-3f92-bbfc-d6e87a3b8f4f",
                                                "text": "I painted blue all of the bathroom walls, the ceiling, and a the corridor up to the hall."
                                            },
                                            {
                                                "example_id": "e785d34c-c4b1-4078-901b-d8e1273597c6",
                                                "sense_id": "2a84297f-2bb2-3f92-bbfc-d6e87a3b8f4f",
                                                "text": "The half-dozen pieces […] were painted white and carved with festoons of flowers, birds and cupids. To display them the walls had been tinted a vivid blue which had now faded, but the carpet, which had evidently been stored and recently relaid, retained its original turquoise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d239d6f-2395-362b-aa86-92a41ffd602b",
                                        "entry_id": "eba6b82e-338a-3311-a391-865dba2ed8da",
                                        "glosses": [
                                            "To apply in the manner that paint is applied."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "af8f8add-5ab2-3d85-912f-b69228e65f8d",
                                        "entry_id": "eba6b82e-338a-3311-a391-865dba2ed8da",
                                        "glosses": [
                                            "To apply with a brush in order to treat some body part."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c5de160c-561e-3cc6-bb97-9ef522078c1b",
                                        "entry_id": "eba6b82e-338a-3311-a391-865dba2ed8da",
                                        "glosses": [
                                            "To cover (something) with spots of colour, like paint."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6397c604-7aed-4fb2-b0c9-fe6ad3efbd44",
                                                "sense_id": "c5de160c-561e-3cc6-bb97-9ef522078c1b",
                                                "text": "not painted with the crimson spots of blood"
                                            },
                                            {
                                                "example_id": "f7a4408d-1cdb-49a2-b156-96c1b26ee762",
                                                "sense_id": "c5de160c-561e-3cc6-bb97-9ef522078c1b",
                                                "text": "Cuckoo buds of yellow hue / Do paint the meadows with delight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7f57930-b9a3-370d-9018-04dbf99ca1a1",
                                        "entry_id": "eba6b82e-338a-3311-a391-865dba2ed8da",
                                        "glosses": [
                                            "To create (an image) with paints."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8be48345-e0c5-4d76-b07b-f92309be03a9",
                                                "sense_id": "e7f57930-b9a3-370d-9018-04dbf99ca1a1",
                                                "text": "to paint a portrait or a landscape"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78a4f416-72a9-31bb-bcf3-88f3a85a8cda",
                                        "entry_id": "eba6b82e-338a-3311-a391-865dba2ed8da",
                                        "glosses": [
                                            "To practise the art of painting pictures."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d63de78-c46e-402f-ba9a-09690edd8ea3",
                                                "sense_id": "78a4f416-72a9-31bb-bcf3-88f3a85a8cda",
                                                "text": "I've been painting since I was a young child."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "100c6822-b2c1-3693-b695-4ca12df5905f",
                                        "entry_id": "eba6b82e-338a-3311-a391-865dba2ed8da",
                                        "glosses": [
                                            "To draw an element in a graphical user interface."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "604eb88d-1ad6-40a1-9afc-9eaf8242345d",
                                                "sense_id": "100c6822-b2c1-3693-b695-4ca12df5905f",
                                                "text": "Sent to a minimized window when the icon's background must be filled before it is painted."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84176956-239c-353b-8ad1-3e43bea87059",
                                        "entry_id": "eba6b82e-338a-3311-a391-865dba2ed8da",
                                        "glosses": [
                                            "To depict or portray."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c42e6883-66cf-44c5-9201-15273a354040",
                                                "sense_id": "84176956-239c-353b-8ad1-3e43bea87059",
                                                "text": "She sued the author of the biography, claiming it painted her as a duplicitous fraud."
                                            },
                                            {
                                                "example_id": "1df3c7d5-fb2f-481e-8c32-368bd83bc2a4",
                                                "sense_id": "84176956-239c-353b-8ad1-3e43bea87059",
                                                "text": "Disloyal? / The word is too good to paint out her wickedness."
                                            },
                                            {
                                                "example_id": "65fcc555-76ad-4aa6-b0b7-f714b9e887cb",
                                                "sense_id": "84176956-239c-353b-8ad1-3e43bea87059",
                                                "text": "VVhether the Charmer ſinner it, or ſaint it, / VVhen Folly grovvs romantic, vve muſt paint it."
                                            },
                                            {
                                                "example_id": "0ef58acc-5690-4d50-93ea-8078ef21d8ac",
                                                "sense_id": "84176956-239c-353b-8ad1-3e43bea87059",
                                                "text": "During defense openings, Bankman-Fried’s lawyer painted him as a “nerd” who tried to do the right thing but was overwhelmed with a fast-growing company."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2537dedd-a09c-35d5-9635-cbbd76e33bd8",
                                        "entry_id": "eba6b82e-338a-3311-a391-865dba2ed8da",
                                        "glosses": [
                                            "To color one's face by way of beautifying it."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44a1acb6-aa7b-449a-9222-02cbe0a8d4b5",
                                                "sense_id": "2537dedd-a09c-35d5-9635-cbbd76e33bd8",
                                                "text": "Let her paint an inch thick."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0db4092-6308-3bd2-94d4-5bcc9d2699c9",
                                        "entry_id": "eba6b82e-338a-3311-a391-865dba2ed8da",
                                        "glosses": [
                                            "To detect (something) with radar."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d6db9e5-08fd-42eb-bb1c-983b7a64114d",
                                                "sense_id": "b0db4092-6308-3bd2-94d4-5bcc9d2699c9",
                                                "text": "\"We'll paint the target for the flyboys,\" the JTAC said."
                                            },
                                            {
                                                "example_id": "fe963544-658f-4844-a2ca-63d63aae654b",
                                                "sense_id": "b0db4092-6308-3bd2-94d4-5bcc9d2699c9",
                                                "text": "The Albuquerque radar “painted” just one object whenever the light was on, none when it was off."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad76f3fd-51f2-3a52-8586-987718d8e244",
                                        "entry_id": "eba6b82e-338a-3311-a391-865dba2ed8da",
                                        "glosses": [
                                            "To defecate during anal sex."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
