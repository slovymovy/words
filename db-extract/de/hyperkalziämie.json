                "senses": [
                    {
                        "sense_id": "18c3978e-f27c-38a7-b2ff-8cac766a473a",
                        "entry_id": "dc3e9fec-d75d-3307-8707-a994c34fe25b",
                        "glosses": [
                            "erhöhte Konzentration an Calcium im Blut"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "a1fd9279-4ab2-4376-9e00-9668c1e9af3d",
                                "sense_id": "18c3978e-f27c-38a7-b2ff-8cac766a473a",
                                "text": "„Legen Sie ihm nahe, sich ärztlich vorzustellen, wenn abdominelle oder Gliederschmerzen auftreten, da sie ein Zeichen für eine Hyperkalziämie sein können, die zur Abklärung einer Blutuntersuchung bedarf.“"
                            },
                            {
                                "example_id": "80664238-aa4a-4d3c-af2c-badd11b02ff6",
                                "sense_id": "18c3978e-f27c-38a7-b2ff-8cac766a473a",
                                "text": "„Bei 10% der mit Lithium behandelten, affektiv erkrankten Patienten kommt es zu einer Hyperkalziämie.“"
                            },
                            {
                                "example_id": "2064bb7b-d871-4ad8-90fc-cabaf566826c",
                                "sense_id": "18c3978e-f27c-38a7-b2ff-8cac766a473a",
                                "text": "„Täglich sollten zusätzlich Kalzium 500mg und Vitamin D 400 IE zugeführt werden, außer die Behandlung erfolgt aufgrund tumorinduzierter Hyperkalziämie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
