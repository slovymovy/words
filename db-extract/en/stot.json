                    }
                ],
                "translations": [
                    {
                        "translation_id": "f880b44c-6e4c-4b01-85ca-c6c744ab41ec",
                        "source_entry_id": "0c14f52c-c498-3fa3-a561-bd7e8de44dc7",
                        "source_sense_id": "9d7663e0-2394-35b7-8a37-ebc086e68d7f",
                        "source_sense_description": "auffällige Gangart einiger Antilopenarten, wenn sie einen Räuber sichten",
                        "target_lang_word": "hüpfen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hüpfen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d310d27a-51e3-396f-9b24-49a48c2b3596",
                                        "entry_id": "190dd137-6b7d-3c99-9f76-853e8de5370e",
                                        "glosses": [
                                            "kleine Sprünge machen, mit kleinen Sprüngen laufen"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c548eea0-1682-4ac1-b658-b0cae782f0f2",
                                                "sense_id": "d310d27a-51e3-396f-9b24-49a48c2b3596",
                                                "text": "Die Kinder hüpfen unerlaubterweise auf dem Sofa herum."
                                            },
                                            {
                                                "example_id": "cdbab61c-3e9c-45ca-8fd6-539c1154085a",
                                                "sense_id": "d310d27a-51e3-396f-9b24-49a48c2b3596",
                                                "text": "Lisa kann nicht auf einem Bein hüpfen."
                                            },
                                            {
                                                "example_id": "9f58ac63-b92c-435c-8ecf-20da743e3a61",
                                                "sense_id": "d310d27a-51e3-396f-9b24-49a48c2b3596",
                                                "text": "Als ich diese Woche den neuen Palm Pre in die Hände bekam, fiel mir ein, was man sich über Pinguine erzählt: Sie sollen beim Fischefangen extrem vorsichtig sein, angeblich hüpft keiner freiwillig als Erster ins Wasser."
                                            },
                                            {
                                                "example_id": "90e986ff-049e-4602-9ded-c425fc1dc8eb",
                                                "sense_id": "d310d27a-51e3-396f-9b24-49a48c2b3596",
                                                "text": "Er ist mit dem jungen Chateauguyon eine Wette eingegangen, welchem von ihnen es zuerst gelinge, den Fuß im Munde das Zimmer auf und nieder zu hüpfen."
                                            },
                                            {
                                                "example_id": "5fba6e1a-33c0-4474-bfcf-f44d47c67b29",
                                                "sense_id": "d310d27a-51e3-396f-9b24-49a48c2b3596",
                                                "text": "So sprach er, und hüpfte vor Freude, wie eine junge Ziege im Mayenthau hüpft."
                                            },
                                            {
                                                "example_id": "df738fe3-89d5-4149-bd8d-36810c7063cd",
                                                "sense_id": "d310d27a-51e3-396f-9b24-49a48c2b3596",
                                                "text": "Kannst den gehüpften Mazurkaschritt?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ba8fbdfa-f0cf-40ef-8584-912531fdebaf",
                        "source_entry_id": "0c14f52c-c498-3fa3-a561-bd7e8de44dc7",
                        "source_sense_id": "9d7663e0-2394-35b7-8a37-ebc086e68d7f",
                        "source_sense_description": "auffällige Gangart einiger Antilopenarten, wenn sie einen Räuber sichten",
                        "target_lang_word": "prunken",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prunken",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3119f60e-37c5-3a4c-acf0-b5647ea31fb8",
                                        "entry_id": "e7c8626b-8c97-3081-9dc9-c6e0628915ee",
                                        "glosses": [
                                            "etwas angeberisch vorzeigen"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f20ea94-b1bd-46c7-afee-6b0e5ce8d3b3",
                                                "sense_id": "3119f60e-37c5-3a4c-acf0-b5647ea31fb8",
                                                "text": "„Ein eitles Mädchen prunkt mit ihrer Schönheit, und der aufgeblasene Reiche mit seinem Reichthum.“ (1827)"
                                            },
                                            {
                                                "example_id": "ff81f86c-b460-4f0b-8cfc-f6db620177f4",
                                                "sense_id": "3119f60e-37c5-3a4c-acf0-b5647ea31fb8",
                                                "text": "„Der kleine Ort prunkt mit zwei Barockkirchen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a78fc4ff-6fb9-3f51-a92a-7247387cc2e3",
                                        "entry_id": "e7c8626b-8c97-3081-9dc9-c6e0628915ee",
                                        "glosses": [
                                            "sich in seiner ganzen Schönheit zeigen"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2116f1ca-652a-4837-9206-201cadc62c57",
                                                "sense_id": "a78fc4ff-6fb9-3f51-a92a-7247387cc2e3",
                                                "text": "„Die Tür zum Konferenzsaal flankierten zwei weitere Tempelgardisten, doch diese trugen Schwerter, keine Hellebarden, und auf ihren Brustharnischen prunkte der goldene Stern des Großvikars neben dem Schwert des Erzengels Schueler.“"
                                            },
                                            {
                                                "example_id": "c444243a-25c4-4f45-b270-5d648bceaad2",
                                                "sense_id": "a78fc4ff-6fb9-3f51-a92a-7247387cc2e3",
                                                "text": "„In der Mitte eines der Räume der Akademie der Künste prunkte das Prachtstück: Johann Gottfried Schadows Prinzessinnengruppe als Gipsmodell.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a1bfe13e-2852-41e9-8834-1b04002f48ce",
                        "source_entry_id": "0c14f52c-c498-3fa3-a561-bd7e8de44dc7",
                        "source_sense_id": "9d7663e0-2394-35b7-8a37-ebc086e68d7f",
