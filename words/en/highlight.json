{
    "word_family": [
        "highlighter"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "47a16182-b752-3639-815a-36cb41b3e8dc",
                    "sense_definition": "An especially significant, interesting, or enjoyable detail, event, or period of time.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "noun_event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Meeting my future wife was the <w>highlight</w> of my trip to Spain.",
                            "target_lang_translations": {
                                "ru": "Встреча с моей будущей женой стала <w>самым ярким моментом</w> моей поездки в Испанию.",
                                "zh": "遇见我未来的妻子是我西班牙之行最<w>精彩</w>的部分。"
                            }
                        },
                        {
                            "text": "We watched the <w>highlights</w> of the football match on TV.",
                            "target_lang_translations": {
                                "ru": "Мы смотрели <w>лучшие моменты</w> футбольного матча по телевизору.",
                                "zh": "我们在电视上看了那场足球赛的<w>精彩片段</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "high point",
                        "peak",
                        "climax",
                        "feature",
                        "best part."
                    ],
                    "antonyms": [
                        "lowlight"
                    ],
                    "common_phrases": [
                        "highlight of the trip",
                        "career highlight",
                        "match highlights",
                        "news highlights"
                    ],
                    "target_lang_definitions": {
                        "ru": "Особенно значимая, интересная или приятная деталь, событие или период времени.",
                        "zh": "指特别重要、有趣或令人愉快的细节、事件或时期。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "яркий момент",
                                "target_lang_sense_clarification": "запоминающееся событие"
                            },
                            {
                                "target_lang_word": "лучшая часть",
                                "target_lang_sense_clarification": "наиболее приятная деталь"
                            },
                            {
                                "target_lang_word": "гвоздь программы",
                                "target_lang_sense_clarification": "идиома: главное событие"
                            },
                            {
                                "target_lang_word": "хайлайт",
                                "target_lang_sense_clarification": "неологизм: лучшие моменты матча или игры"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "亮点",
                                "target_lang_sense_clarification": "最精彩的部分"
                            },
                            {
                                "target_lang_word": "精彩片段",
                                "target_lang_sense_clarification": "活动或比赛中的精华部分"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fcaed208-4fee-3d39-87d2-62c5056de2ea",
                    "sense_definition": "A strand or spot of hair dyed a different, usually lighter, color than the rest.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "noun_hair",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She went to the salon to get blonde <w>highlights</w> put in her hair.",
                            "target_lang_translations": {
                                "ru": "Она пошла в салон, чтобы сделать светлые <w>пряди</w>.",
                                "zh": "她去沙龙给头发做了金色的<w>挑染</w>。"
                            }
                        },
                        {
                            "text": "The summer sun gave him natural <w>highlights</w>.",
                            "target_lang_translations": {
                                "ru": "Летнее солнце создало у него естественные <w>блики</w>.",
                                "zh": "夏日的阳光在他头发上留下了自然的<w>光泽</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "blonde highlights",
                        "get highlights"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прядь волос, окрашенная в цвет, отличный от основного (обычно более светлый).",
                        "zh": "染成与其余头发颜色不同（通常较浅）的一束或一点头发。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "светлая прядь",
                                "target_lang_sense_clarification": "окрашенный локон"
                            },
                            {
                                "target_lang_word": "мелирование",
                                "target_lang_sense_clarification": "процесс или результат окрашивания прядей"
                            },
                            {
                                "target_lang_word": "блик",
                                "target_lang_sense_clarification": "естественный отсвет на волосах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "挑染",
                                "target_lang_sense_clarification": "局部染发"
                            },
                            {
                                "target_lang_word": "发束",
                                "target_lang_sense_clarification": "指挑染后的那一束头发"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9faff3ee-34f0-3eb5-a463-d774a8ddb21a",
                    "sense_definition": "An area or spot in a drawing, painting, or photograph that is the brightest or most illuminated.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "noun_art",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist added a white <w>highlight</w> to the eye to make it look alive.",
                            "target_lang_translations": {
                                "ru": "Художник добавил белый <w>блик</w> на глаз, чтобы он выглядел живым.",
                                "zh": "艺术家在眼睛上加了一点白色的<w>高光</w>，使其看起来栩栩如生。"
                            }
                        },
                        {
                            "text": "You can adjust the shadows and <w>highlights</w> in the photo editor.",
                            "target_lang_translations": {
                                "ru": "Вы можете настроить тени и <w>светлые участки</w> в фоторедакторе.",
                                "zh": "你可以在照片编辑器中调整阴影和<w>高光</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "shadows and highlights"
                    ],
                    "target_lang_definitions": {
                        "ru": "Область или пятно на рисунке, картине или фотографии, которое является самым ярким или наиболее освещенным.",
                        "zh": "绘画、照片或图像中最亮或光照最强的区域或点。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "блик",
                                "target_lang_sense_clarification": "яркое пятно света"
                            },
                            {
                                "target_lang_word": "светлый участок",
                                "target_lang_sense_clarification": "освещенная область"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "高光",
                                "target_lang_sense_clarification": "画面中最亮的部分"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "48907ff1-4009-391b-bb61-ebd5777f77dd",
                    "sense_definition": "To mark important passages of text with a bright color or digital tool to make them stand out for reference.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "verb_mark",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>highlight</w> the key terms in the document before the meeting.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>выделите</w> ключевые термины в документе перед собранием.",
                                "zh": "请在开会前把文件里的关键词<w>高亮</w>出来。"
                            }
                        },
                        {
                            "text": "I <w>highlighted</w> the sentence in yellow so I would remember it.",
                            "target_lang_translations": {
                                "ru": "Я <w>выделил</w> это предложение желтым, чтобы запомнить его.",
                                "zh": "我用黄色把那句话<w>标注</w>了出来，这样我就能记住了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "mark",
                        "underline",
                        "stress."
                    ],
                    "common_phrases": [
                        "highlight text",
                        "highlight in yellow",
                        "highlight in green"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отмечать важные отрывки текста ярким цветом или цифровым инструментом.",
                        "zh": "用鲜艳的颜色或数字工具标记文本中的重要段落，使其突出以便参考。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выделять",
                                "target_lang_sense_clarification": "цветом или маркером"
                            },
                            {
                                "target_lang_word": "маркировать",
                                "target_lang_sense_clarification": "отмечать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "高亮",
                                "target_lang_sense_clarification": "用颜色标记文本"
                            },
                            {
                                "target_lang_word": "标注",
                                "target_lang_sense_clarification": "做标记"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4d9a78c2-aae7-3eba-a5cf-7a498effb4c9",
                    "sense_definition": "To make something prominent or emphasize it so that it receives attention.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "verb_emphasize",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The report <w>highlights</w> the need for better safety procedures in the factory.",
                            "target_lang_translations": {
                                "ru": "В отчете <w>подчёркивается</w> необходимость улучшения мер безопасности на заводе.",
                                "zh": "这份报告<w>强调</w>了工厂需要改进安全程序。"
                            }
                        },
                        {
                            "text": "Her speech <w>highlighted</w> the achievements of the entire team.",
                            "target_lang_translations": {
                                "ru": "Её речь <w>выделила</w> достижения всей команды.",
                                "zh": "她的演讲<w>突出</w>了整个团队的成就。"
                            }
                        }
                    ],
                    "synonyms": [
                        "emphasize",
                        "stress",
                        "underline",
                        "spotlight"
                    ],
                    "common_phrases": [
                        "highlight the importance",
                        "highlight a problem",
                        "highlight the need",
                        "highlight the fact"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать что-либо заметным или акцентировать на этом внимание.",
                        "zh": "使某事变得突出或强调某事，以引起注意。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подчёркивать",
                                "target_lang_sense_clarification": "акцентировать внимание"
                            },
                            {
                                "target_lang_word": "выделять",
                                "target_lang_sense_clarification": "делать заметным"
                            },
                            {
                                "target_lang_word": "акцентировать",
                                "target_lang_sense_clarification": "заострять внимание"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "强调",
                                "target_lang_sense_clarification": "着重指出"
                            },
                            {
                                "target_lang_word": "突出",
                                "target_lang_sense_clarification": "使显眼"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d928fd8a-d72c-3006-b1b9-2551bf7c0829",
                    "sense_definition": "To dye parts of the hair a different color than the rest.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "verb_hair",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to <w>highlight</w> her hair for the wedding.",
                            "target_lang_translations": {
                                "ru": "Она решила <w>мелировать</w> волосы к свадьбе.",
                                "zh": "她决定为婚礼做个<w>挑染</w>。"
                            }
                        },
                        {
                            "text": "The stylist <w>highlighted</w> only the tips of her hair.",
                            "target_lang_translations": {
                                "ru": "Стилист <w>мелировал</w> только кончики её волос.",
                                "zh": "造型师只给她发梢做了<w>挑染</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Окрашивать отдельные пряди волос в другой цвет.",
                        "zh": "将头发的某些部分染成与其余部分不同的颜色。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мелировать",
                                "target_lang_sense_clarification": "окрашивать пряди"
                            },
                            {
                                "target_lang_word": "делать мелирование",
                                "target_lang_sense_clarification": "процедура"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "挑染",
                                "target_lang_sense_clarification": "进行局部染发"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b7b35f56-b612-30e9-ad84-0218e085c1c7",
                    "sense_definition": "To seek the attention of a user in an online chat by mentioning their name, often triggering a notification.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "verb_chat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>highlight</w> me in the chat if you need urgent help.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>отметьте</w> меня в чате, если нужна срочная помощь.",
                                "zh": "如果你需要紧急帮助，请在聊天里<w>艾特</w>我。"
                            }
                        },
                        {
                            "text": "He missed the message because nobody <w>highlighted</w> him.",
                            "target_lang_translations": {
                                "ru": "Он пропустил сообщение, потому что никто его не <w>отметил</w>.",
                                "zh": "他错过了消息，因为没人<w>标记</w>他。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tag",
                        "mention",
                        "ping"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "internet"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Упоминать имя пользователя в чате для привлечения его внимания.",
                        "zh": "在在线聊天中通过提及用户名来寻求用户的注意，通常会触发通知。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отмечать",
                                "target_lang_sense_clarification": "упоминать в сообщении"
                            },
                            {
                                "target_lang_word": "тегать",
                                "target_lang_sense_clarification": "сленг: ставить тег"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "艾特",
                                "target_lang_sense_clarification": "网络用语：提及某人"
                            },
                            {
                                "target_lang_word": "标记",
                                "target_lang_sense_clarification": "在对话中点名"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}