                "senses": [
                    {
                        "sense_id": "121e6898-fbcc-381e-a06f-0337fafde6a7",
                        "entry_id": "651d3474-fca4-307a-ba64-bb54d92aa42f",
                        "glosses": [
                            "nazwa obiektu geograficznego w jednym z języków używanych na danym obszarze, gdzie dany obiekt się znajduje, używana poza miejscem występowania tego języka"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4b4dce7-1da4-45a6-8572-9bcebfe90441",
                                "sense_id": "121e6898-fbcc-381e-a06f-0337fafde6a7",
                                "text": "Nazwy takie jak Saint-Tropez są w języku polskim endonimami, i nie stanowią polskich wyrażeń."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f069fc96-5d41-4133-8a61-9391fd265fbe",
                        "source_entry_id": "651d3474-fca4-307a-ba64-bb54d92aa42f",
                        "source_sense_id": "121e6898-fbcc-381e-a06f-0337fafde6a7",
                        "target_lang_word": "endonym",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "endonym",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a0f3ba29-16fb-3ac0-b269-02bd003f8f9e",
                                        "entry_id": "e8b9dd9d-0132-3b32-a75f-f40cb7d3f151",
                                        "glosses": [
                                            "A name used by a group or category of people (an ingroup) to refer to themselves or their language, as opposed to a name given to them by other groups (outgroups)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ced3cab6-bdb5-4ba2-bf74-59506d507587",
                                                "sense_id": "a0f3ba29-16fb-3ac0-b269-02bd003f8f9e",
                                                "text": "The endonym is the basic toponymic exemplar and as such it needs to be understood properly. To do so we need to appreciate the context of space and place that produces it. Most endonyms arise from the elemental human relationship with space and place, and possess an intrinsic and enduring value which cannot normally be either bestowed or removed by political arbitrariness."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7dee0b51-ab01-4440-bf6f-7d69d7e9c332",
                        "source_entry_id": "651d3474-fca4-307a-ba64-bb54d92aa42f",
                        "source_sense_id": "121e6898-fbcc-381e-a06f-0337fafde6a7",
                        "target_lang_word": "endónimo",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "endónimo",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "8bc07478-46bc-30c8-894e-24e993a231b1",
                                        "entry_id": "ccf27ef7-ae11-3a58-a450-3f3014b80480",
                                        "glosses": [
                                            "Se dice de los nombres que son propios de la denominación que utilizan los hablantes nativos de un lugar."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b57aeca2-efb8-4b56-8293-9aa88478fbd9",
                                                "sense_id": "8bc07478-46bc-30c8-894e-24e993a231b1",
                                                "text": "Bordeaux es el endónimo para Burdeos"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "47673eb8-9bb1-4c55-88ad-c0a0a14f433a",
                        "source_entry_id": "651d3474-fca4-307a-ba64-bb54d92aa42f",
                        "source_sense_id": "121e6898-fbcc-381e-a06f-0337fafde6a7",
                        "target_lang_word": "Endonym",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Endonym",
