                ],
                "senses": [
                    {
                        "sense_id": "b4afd870-1d5c-3b83-8948-eb34d4c1f9c9",
                        "entry_id": "b7720af4-23e4-3e5d-9e57-f48f4cd0cd49",
                        "glosses": [
                            "(großräumiges) Gebiet mit erheblichem Wassermangel"
                        ],
                        "tags": [
                            "Geographie"
                        ],
                        "examples": [
                            {
                                "example_id": "bf0b489a-b01e-4311-baf8-fe649c56a2a4",
                                "sense_id": "b4afd870-1d5c-3b83-8948-eb34d4c1f9c9",
                                "text": "[Das Altaigebirge] „erstreckt sich über rund 2100 km Länge vom Quellgebiet der Flüsse Irtysch und Ob in Südsibirien bis in die Trockenregionen Xinjiangs und zum ostmongolischen Hochplateau.“"
                            },
                            {
                                "example_id": "2c4dc896-2be7-4f6a-94b1-3c5545667378",
                                "sense_id": "b4afd870-1d5c-3b83-8948-eb34d4c1f9c9",
                                "text": "„Nur manche Gebiete der Wüste Gobi bestehen aus Sanddünen. In China heißen sie \"Shamo\", in der Mongolei \"Els\". In Europa wird diese gesamte Trockenregion vereinfacht als \"Gobi\" bezeichnet.“"
                            },
                            {
                                "example_id": "0ab4de67-62c2-4a56-af10-dc989f708949",
                                "sense_id": "b4afd870-1d5c-3b83-8948-eb34d4c1f9c9",
                                "text": "„In einer Trockenregion in Botswana haben Walzenspinnen (Solifugae) einen beträchtlichen Anteil an der Ernährung der Falbkatzen.“"
                            },
                            {
                                "example_id": "c82275f8-b97a-4c75-8872-6a4fa89712ab",
                                "sense_id": "b4afd870-1d5c-3b83-8948-eb34d4c1f9c9",
                                "text": "[Sahara:] „Die umliegenden Trockenregionen sind weltweit am stärksten von Wüstenbildung bedroht – vor allem durch die Zerstörung der Böden durch die Menschen.“"
                            },
                            {
                                "example_id": "fff6ad7d-7f99-40b6-a8ea-3fc2b62841f2",
                                "sense_id": "b4afd870-1d5c-3b83-8948-eb34d4c1f9c9",
                                "text": "[Die Süßkartoffel war] „in den Trockenregionen Südamerikas eine weit verbreitete Nahrungspflanze.“"
                            },
                            {
                                "example_id": "b2d423a3-72c6-4b46-801e-bd3f543c5b22",
                                "sense_id": "b4afd870-1d5c-3b83-8948-eb34d4c1f9c9",
                                "text": "„An den Standorten der mitteldeutschen Trockenregion ist dagegen mit einem Anstieg des Niederschlags zu rechnen.“"
                            },
                            {
                                "example_id": "8ac95d63-094a-4215-9799-612d76ec56b6",
                                "sense_id": "b4afd870-1d5c-3b83-8948-eb34d4c1f9c9",
                                "text": "„Die beiden Journalisten“ […] „haben monatelang recherchiert, um herauszufinden, wer, wo, wieviel Wasser in der Trockenregion Unterfranken entnimmt.“"
                            },
                            {
                                "example_id": "25364f15-f545-4787-8ef7-e3ad80792d46",
                                "sense_id": "b4afd870-1d5c-3b83-8948-eb34d4c1f9c9",
                                "text": "„Folglich würden sich alle Klimazonen in Richtung Pole schieben – und damit auch die subtropische Trockenregion, die sich nach Südeuropa verlagern würde.“"
                            },
                            {
                                "example_id": "0889c61a-2d23-4262-8908-2703f8388743",
                                "sense_id": "b4afd870-1d5c-3b83-8948-eb34d4c1f9c9",
                                "text": "„Schraubenbäume (Pandanus) und Lontarpalmen (Borassus flabellifer) wachsen vor allem in den Trockenregionen.“"
                            },
                            {
                                "example_id": "ce309210-3aa6-4e4f-87df-3d1545ecd948",
                                "sense_id": "b4afd870-1d5c-3b83-8948-eb34d4c1f9c9",
                                "text": "„Für die Wasserversorgung dieser Trockenregion im Norden Sri Lankas wurden künstliche Seen angelegt, die den Monsunregen speicherten und die Bewässerung der Reisfelder regulierbar machten.“"
                            },
                            {
                                "example_id": "c1176e51-f448-4e53-8ccc-1d7487839af9",
                                "sense_id": "b4afd870-1d5c-3b83-8948-eb34d4c1f9c9",
                                "text": "[…] „»Es ist etwas ganz anderes, ob man sich eine Tomate aus Deutschland, also aus einer wasserreichen Region kauft, oder aus Südspanien, einer Trockenregion.«“"
                            },
                            {
                                "example_id": "7a9df26a-b27f-4783-a000-76ede210528e",
                                "sense_id": "b4afd870-1d5c-3b83-8948-eb34d4c1f9c9",
                                "text": "„Sieht man von den Salzkrusten ab, die sich oberflächlich in Trockenregionen bilden, entstehen die ergiebigsten Salzlagerstätten bei der Verdunstung von Meeresbecken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
