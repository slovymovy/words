                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2de172ca-335b-4e1f-a4b8-cd7c17792197",
                                "sense_id": "06cafe22-9dbe-3c4a-babe-7a757d2dc6eb",
                                "text": "Au programme, beaucoup de perso, souvent du très rigolo, mais aussi des recos ciné ou streaming et des sujets moins légers, comme la difficulté de se loger à Paris."
                            }
                        ]
                    },
                    {
                        "sense_id": "1252785b-2a97-3023-a158-a9822141c2f4",
                        "entry_id": "343eb946-62f0-372c-8841-00be6aedf0e7",
                        "glosses": [
                            "Recommandation faite par un prestataire de communication à un annonceur (client) en matière de publicité."
                        ],
                        "tags": [
                            "especially",
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "b517c1aa-e7d6-4663-a791-79ea168b6ca9",
                                "sense_id": "1252785b-2a97-3023-a158-a9822141c2f4",
                                "text": "Si la reco est bonne, tu peux lancer le BAT côté imprimeur : on est charrette !"
                            }
                        ]
                    }
