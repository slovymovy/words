                        "glosses": [
                            "Abstimmung der Teile eines Fahrwerks aufeinander und auf den geplanten Einsatzzweck des Fahrzeugs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8384973-c649-4896-8427-8c676f5b03c6",
                                "sense_id": "a5f58be3-5d1e-3c7c-a3be-93d8c4dcdd59",
                                "text": "„Per Knopfdruck wird die Fahrwerksabstimmung auf normal, sportlich oder komfortabel gestellt. “"
                            },
                            {
                                "example_id": "f9c7aa3b-3e79-4134-b546-6e57dd12022a",
                                "sense_id": "a5f58be3-5d1e-3c7c-a3be-93d8c4dcdd59",
                                "text": "„Bei einer idealen Federung folgen nur die Räder den Fahrbahnunebenheiten, während die Karosserie bewegungslos über der Straße zu schweben scheint. Mit einer sehr weichen Fahrwerksabstimmung ließe sich das erreichen.“"
                            }
