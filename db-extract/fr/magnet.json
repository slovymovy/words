                            {
                                "example_id": "7a6f0e8f-27fd-4eae-b682-3474852a7313",
                                "sense_id": "1751662c-5732-3af3-90fc-e89186ae7bc7",
                                "text": "La commune de Magnet est située au sud-est du département de l'Allier et au nord de Vichy."
