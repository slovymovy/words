                    {
                        "translation_id": "8af1513e-139d-481f-8f42-8eddc8854b32",
                        "source_entry_id": "70aa61cc-df1b-3223-86b6-a6c744f916b2",
                        "source_sense_id": "f546e386-6612-3fbc-823e-5a426c611ff6",
                        "source_sense_description": "Ausstellungsstück, Exponat",
                        "target_lang_word": "Exponat",
