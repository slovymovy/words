                        "examples": [
                            {
                                "example_id": "01ed34ff-4211-47a1-a0d0-8ab92318f972",
                                "sense_id": "aeabacd4-3426-3919-a3a6-3bc611d9497b",
                                "text": "Men kan zelfs stellen dat de verhouding van de mens Joanot Martorell tot het ridderwezen, van de persoon tot het voorgehouden model, te vergelijken is met de verhouding tussen Tirant lo Blanc en de verhalen uit de `matière de Bretagne'."
                            },
                            {
                                "example_id": "b3e641d3-9147-4c33-96b2-737e79f19445",
                                "sense_id": "aeabacd4-3426-3919-a3a6-3bc611d9497b",
                                "text": "Ik ben trouwens door mijn geloften gehouden de onvervaarde lotgevallen van de ridders uit het verleden in 't licht te stellen, vooral omdat in voornoemd boek heel wat wordt vermeld over de regels van de krijgskunst en het ridderwezen."
                            }
                        ]
