                            {
                                "example_id": "a26cb8e5-a780-4519-8f00-13942b9677b1",
                                "sense_id": "82fe4c98-1a39-3b91-a0da-afb5348bc2f8",
                                "text": "No wonder, then, that they made a straight wake for the whale's mouth--the bar--when the wrinkled little old Jonah, there officiating, soon poured them out brimmers all round."
                            }
