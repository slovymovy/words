                "senses": [
                    {
                        "sense_id": "5f09a47d-ed54-3513-9823-0b2a3e2ca894",
                        "entry_id": "6c4852ad-d2ad-3374-ab0a-37165fa3dca8",
                        "glosses": [
                            "eine Sprache, die im Osten der Türkei von den Zaza gesprochen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5fec5d7a-26b4-4074-b3e6-4ffd76c830c3",
                                "sense_id": "5f09a47d-ed54-3513-9823-0b2a3e2ca894",
                                "text": "„Aufgrund des großen Beitrags von K. Hadank zur Erforschung der Zaza-Sprache, mit deren Grammatik ich mich ebenfalls befasse, nahm ich die Verantwortung wahr, seinen Aufsatz nicht in Vergessenheit geraten zu lassen, sondern dem Fachkreis sowie der allgemein Interessierten durch Publikation zugänglich zu machen.“"
                            },
                            {
                                "example_id": "8bf12b8e-7795-4e82-94f7-3205bf832e57",
                                "sense_id": "5f09a47d-ed54-3513-9823-0b2a3e2ca894",
                                "text": "„Dann ging der Reisende mit seiner Karawane über Siwerck, wo die sogenannte Zaza-Sprache eingehend studiert werden konnte.“"
                            },
                            {
                                "example_id": "b4cb7e5f-24d3-48ba-9310-c400ad64ea33",
                                "sense_id": "5f09a47d-ed54-3513-9823-0b2a3e2ca894",
                                "text": "„Bei ihnen besteht ein ähnliche Affinität zum Gorani-Dialekt wie bei den kurdischen Alevi zur Zaza-Sprache.“"
                            },
                            {
                                "example_id": "777fbe03-b1e2-4594-9746-1f6beea95ce5",
                                "sense_id": "5f09a47d-ed54-3513-9823-0b2a3e2ca894",
                                "text": "„In jüngster Zeit haben Iranisten die sprachliche Eigenständigkeit der Zaza-Sprache betont.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
