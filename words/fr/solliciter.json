    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2e0e9097-50f2-3bd2-8e5f-68dab7c6d3f9",
                    "sense_definition": "Demander de manière formelle, polie ou insistante une aide, une faveur ou une décision.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "demande",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le candidat a décidé de <w>solliciter</w> un entretien avec le directeur des ressources humaines."
                        },
                        {
                            "text": "Face aux difficultés financières, l'association a dû <w>solliciter</w> l'aide de la mairie."
                        }
                    ],
                    "synonyms": [
                        "demander",
                        "implorer",
                        "requérir"
                    ],
                    "common_phrases": [
                        "solliciter un rendez-vous",
                        "solliciter une aide",
                        "solliciter l'avis de"
                    ]
                },
                {
                    "sense_id": "48338db9-64f8-304d-a6ae-989590d899f1",
                    "sense_definition": "Attirer ou stimuler l'attention, l'intérêt ou la curiosité de quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "stimulation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette exposition interactive <w>sollicite</w> la curiosité des jeunes visiteurs dès l'entrée."
                        },
                        {
                            "text": "Les nombreuses notifications de son téléphone portable <w>sollicitent</w> constamment son attention."
                        }
                    ],
                    "synonyms": [
                        "attirer",
                        "éveiller",
                        "stimuler"
                    ],
                    "common_phrases": [
                        "solliciter l'attention",
                        "solliciter la curiosité",
                        "solliciter l'imagination"
                    ]
                },
                {
                    "sense_id": "961af51a-7508-3c42-a8f9-1518a91a6a96",
                    "sense_definition": "Faire travailler un organe, un muscle ou exercer un effort mécanique sur un matériau ou une structure.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "effort_mecanique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet exercice de musculation permet de <w>solliciter</w> efficacement les muscles du dos."
                        },
                        {
                            "text": "Le pont a été conçu pour résister aux forces qui <w>sollicitent</w> son armature métallique."
                        }
                    ],
                    "synonyms": [
                        "faire travailler",
                        "activer"
                    ],
                    "common_phrases": [
                        "solliciter les muscles",
                        "solliciter les articulations"
                    ]
                },
                {
                    "sense_id": "96201e9c-8c69-3292-b1a1-526727c3631c",
                    "sense_definition": "Déformer ou forcer l'interprétation d'un texte ou d'une parole pour lui faire dire ce que l'on désire.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "interpretation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'avocat a cherché à <w>solliciter</w> la loi pour servir la cause de son client."
                        },
                        {
                            "text": "En voulant appuyer sa thèse, le chercheur a trop <w>sollicité</w> les conclusions du manuscrit ancien."
                        }
                    ],
                    "synonyms": [
                        "dénaturer",
                        "forcer"
                    ],
                    "antonyms": [
                        "respecter"
                    ],
                    "common_phrases": [
                        "solliciter un texte"
                    ]
                }
            ]
        }
    ]
