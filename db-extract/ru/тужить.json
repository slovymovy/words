                ],
                "senses": [
                    {
                        "sense_id": "c984be18-0637-36af-b740-368b62f8e347",
                        "entry_id": "1c1f258d-c5b6-386a-b748-81a15d4274c6",
                        "glosses": [
                            "нар.-поэт., разг. горевать, тосковать, скорбеть, печалиться"
                        ],
                        "tags": [
                            "по ком-чём, о ком-чём и без доп."
                        ],
                        "examples": [
                            {
                                "example_id": "6f26b69d-d957-48ab-8573-0574cccde301",
                                "sense_id": "c984be18-0637-36af-b740-368b62f8e347",
                                "text": "В темнице там царевна ту́жит."
                            },
                            {
                                "example_id": "66ab68a1-4dce-4c98-9d09-df425e50c32d",
                                "sense_id": "c984be18-0637-36af-b740-368b62f8e347",
                                "text": "Крестьянин ту́жит и горюет."
                            },
                            {
                                "example_id": "ca94d93d-088e-43b3-a657-68b9199bc0ad",
                                "sense_id": "c984be18-0637-36af-b740-368b62f8e347",
                                "text": "Наш герой… дичится знатных и не тужит ни о почи́ющей родне, ни о забытой старине."
                            },
                            {
                                "example_id": "40d48434-6eda-47b4-9731-9755bee91fbc",
                                "sense_id": "c984be18-0637-36af-b740-368b62f8e347",
                                "text": "Тужить и роптать мне, старому, было б грешно́ и не стать."
                            },
                            {
                                "example_id": "4e2ad9a5-48d4-451a-b129-ab3fa5094a84",
                                "sense_id": "c984be18-0637-36af-b740-368b62f8e347",
                                "text": "У нас коли ты дворянин, так живи, не тужи."
                            }
                        ]
                    },
                    {
                        "sense_id": "f081a598-28f1-3588-87e6-be7353c6e58a",
                        "entry_id": "1c1f258d-c5b6-386a-b748-81a15d4274c6",
                        "glosses": [
                            "разг. заботиться, беспокоиться о чём-либо."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4d6ad5c-6e2d-4ea1-8e9e-17fa3a0efd3a",
                                "sense_id": "f081a598-28f1-3588-87e6-be7353c6e58a",
                                "text": "Их уважали... но ездить к ним никто не ездил. Впрочем, они об этом также не тужи́ли."
                            },
                            {
                                "example_id": "2f3d4428-e904-45b5-b72f-5e1ce5ec278b",
                                "sense_id": "f081a598-28f1-3588-87e6-be7353c6e58a",
                                "text": "Жить — не тужить."
                            }
                        ]
                    },
                    {
                        "sense_id": "7078eb85-c0ab-3fd4-812d-47e14fe34c9d",
                        "entry_id": "1c1f258d-c5b6-386a-b748-81a15d4274c6",
                        "glosses": [
                            "нар.-поэт. сожалеть, жалеть, раскаиваться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "edf99237-0209-4fa5-af1b-4f33bf290612",
                                "sense_id": "7078eb85-c0ab-3fd4-812d-47e14fe34c9d",
                                "text": "— И так, хозяин мой, Твоя святая воля, Готов тебе я всячески служить; Да только ты смотри, чтоб после не тужи́ть: Меня ты попусту иступишь, А всё ножом избы не срубишь."
                            },
                            {
                                "example_id": "b0b5de62-d608-4fc3-8f89-f722bb70caf0",
                                "sense_id": "7078eb85-c0ab-3fd4-812d-47e14fe34c9d",
                                "text": "Лакей бежит по лугу, вдали мелькают разноцветные платья горничных, лакей спешит за ними и ту́жит, что не захватил с собою балалайки."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
