                "senses": [
                    {
                        "sense_id": "30aebecc-ac2f-39d7-9c8a-dbb63d582e1f",
                        "entry_id": "e960ab68-ad1e-3eef-86cb-48e5598ffb38",
                        "glosses": [
                            "männlicher Nachkomme eines Pastors"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be944a15-fc32-476f-992f-9c90adbd4676",
                                "sense_id": "30aebecc-ac2f-39d7-9c8a-dbb63d582e1f",
                                "text": "„Als Pastorensohn 1853 geboren, war Vincent ein schwieriger Mensch, leidenschaftlich, rechthaberisch, egozentrisch und unangepasst.“"
                            },
                            {
                                "example_id": "f3df3e6b-0b97-41fb-91d3-47d30d3c57c7",
                                "sense_id": "30aebecc-ac2f-39d7-9c8a-dbb63d582e1f",
                                "text": "„Einem frommen Pastorensohne kann es nicht gleichgültig sein, ob so ein Bund im Himmel geschlossen ist oder in der Hölle.“"
                            },
                            {
                                "example_id": "8033f4d2-5340-487e-883a-d3aba4e0c3e3",
                                "sense_id": "30aebecc-ac2f-39d7-9c8a-dbb63d582e1f",
                                "text": "„Schliemann wurde 1822 in Mecklenburg als Pastorensohn in ärmliche Verhältnisse hineingeboren.“"
                            },
                            {
                                "example_id": "e4df35ac-e978-4670-95b9-4df03401f4bc",
                                "sense_id": "30aebecc-ac2f-39d7-9c8a-dbb63d582e1f",
                                "text": "„Aus dem Verdrängungswettbewerb ging schließlich der aus England stammende Pastorensohn Cecil Rhodes als Triumphator hervor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
