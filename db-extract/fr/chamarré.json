                                "target_senses": [
                                    {
                                        "sense_id": "ea8df942-739e-39ed-a0fb-bf62624cd781",
                                        "entry_id": "706f060f-1358-33c5-9876-79fe2df6933f",
                                        "glosses": [
                                            "Dressed or ornamented in a gaudy, showy, or tasteless manner; ostentatious."
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f6d314a-368e-41ed-8dc7-86634f1fd51a",
                                                "sense_id": "ea8df942-739e-39ed-a0fb-bf62624cd781",
                                                "text": "There was much whispering and plotting after she had gone in, a conference with some of the boys, and a handing over of bedizened pencils and chews of gum for value received."
                                            },
                                            {
                                                "example_id": "11111dda-84e7-4a2d-9525-20d26074eb9a",
                                                "sense_id": "ea8df942-739e-39ed-a0fb-bf62624cd781",
                                                "text": "She wore only the subtlest touch of make up and round her delicate throat only a single string of pearls. Among the hundred bedizened women she was a rarity."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
