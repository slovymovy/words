                "senses": [
                    {
                        "sense_id": "c5615436-694a-39a2-85f5-bccf833c7ca2",
                        "entry_id": "23c71801-a96e-386d-a2d0-34300f75be8c",
                        "glosses": [
                            "feierliche Verpflichtung zur gesetzestreuen und gewissenhaften Ausübung übertragener Funktionen (durch ein Gelöbnis), unter anderem für politische Abgeordnete, Richter, Soldaten und Beamte"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "dd9a07fb-b20d-4f68-bcff-947a5605f7a1",
                                "sense_id": "c5615436-694a-39a2-85f5-bccf833c7ca2",
                                "text": "Die Angelobung der österreichischen Bundesregierung Faymann II ist für den 16. Dezember 2013 geplant."
                            },
                            {
                                "example_id": "b0dbc246-8b0a-46a2-9fb4-4f9a59401c3c",
                                "sense_id": "c5615436-694a-39a2-85f5-bccf833c7ca2",
                                "text": "„Bundespräsident Dr. Heinz Fischer wird am Montag, den 16. Dezember 2013 die Ernennung und Angelobung der neuen Bundesregierung und der neuen Staatssekretäre um 11.00 Uhr im Maria Theresien-Zimmer der Präsidentschaftskanzlei vornehmen.“"
                            },
                            {
                                "example_id": "698236b9-82bb-4acc-8ce4-9fef5e1ac94e",
                                "sense_id": "c5615436-694a-39a2-85f5-bccf833c7ca2",
                                "text": "„Monika Lindner bleibt der für heute geplanten Angelobung der Abgeordneten durch Präsident Heinz Fischer fern. Als Grund nannte sie das Ausbleiben eines angemessenen Überstundenzuschlags.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
