                                    {
                                        "sense_id": "f1bf97e9-694d-3260-9168-d65801fa859f",
                                        "entry_id": "0a9db012-a40f-3f33-b60a-fdb6b5d72b52",
                                        "glosses": [
                                            "The act, process, method, or an instance of representing by a system or set of marks, signs, figures, or characters."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e876ede9-8dac-347c-aae8-98926ba38b63",
                                        "entry_id": "0a9db012-a40f-3f33-b60a-fdb6b5d72b52",
                                        "glosses": [
                                            "A system of characters, symbols, or abbreviated expressions used in an art or science or in mathematics or logic to express technical facts or quantities."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba0bc224-a15d-4a4d-9177-ab5e54af607e",
                                                "sense_id": "e876ede9-8dac-347c-aae8-98926ba38b63",
                                                "text": "This section lists all algebraic notation used in this book."
                                            },
                                            {
                                                "example_id": "cba71db9-76dc-4253-afa4-2cfcf7c3b892",
                                                "sense_id": "e876ede9-8dac-347c-aae8-98926ba38b63",
                                                "text": "The notations used in the two books differed."
                                            },
                                            {
                                                "example_id": "0347f6d8-e8ac-48d4-9579-c949bef6d1fd",
                                                "sense_id": "e876ede9-8dac-347c-aae8-98926ba38b63",
                                                "text": "There is no official notation in the game of Stratego. Several notations are available but rely on perfect information of the initial piece set-up of both players. We will use a chess-like notation for Stratego."
                                            },
                                            {
                                                "example_id": "b8fc0453-bfa0-4b0f-841b-4aee48c03283",
                                                "sense_id": "e876ede9-8dac-347c-aae8-98926ba38b63",
                                                "text": "Finally, using Devanagari, and native scripts more generally, has the benefit of elevating indigenous scripts and languages within the context of English-language lexicography, rather than foregrounding, or purely relying on, western linguistic notations which cater solely to a monolingual English audience."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "587588b1-695b-3b90-8a44-ff5b959fb317",
                                        "entry_id": "0a9db012-a40f-3f33-b60a-fdb6b5d72b52",
                                        "glosses": [
                                            "A specific note or piece of information written in such a notation."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54b25feb-8567-4841-9708-aa55686d8027",
                                                "sense_id": "587588b1-695b-3b90-8a44-ff5b959fb317",
                                                "text": "She made a notation in the margin of the book."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
