                "senses": [
                    {
                        "sense_id": "487dcb9f-6220-32f6-804e-c30618009850",
                        "entry_id": "d788bc2a-2e60-36ca-acf5-0cfe04b60a43",
                        "glosses": [
                            "grantiger, verdrießlicher Mensch"
                        ],
                        "tags": [
                            "Austrian German",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "28b56f03-8221-4361-a30a-88ae2b032344",
                                "sense_id": "487dcb9f-6220-32f6-804e-c30618009850",
                                "text": "„Fast immer ist der Hobbypädagoge ein Grantscherben, der an einem Aggressionsstau leidet, weil die Kinder ausgezogen sind und er nur mehr die Ehegattin verprügeln kann.“"
                            },
                            {
                                "example_id": "67e1ae75-7060-400d-9115-8d308ef688c3",
                                "sense_id": "487dcb9f-6220-32f6-804e-c30618009850",
                                "text": "„Tatsächlich ähnelt der Tiroler in Sachen Dialogverweigerung immer mehr dem legendären Grantscherben Ernst Happel.“"
                            },
                            {
                                "example_id": "8d6763ab-ef86-4554-935e-5cd6ec570bf7",
                                "sense_id": "487dcb9f-6220-32f6-804e-c30618009850",
                                "text": "„Wenn es um Stimmung geht, dann gibt es dieser Tage nur einen Maßstab: Die Fußball-WM. Die hat 80 Millionen scheinbar ewig missmutiger Grantscherben zu einem Volk von Energie sprühenden Partytigern gemacht […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
