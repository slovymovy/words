                    "frequency": "High",
                    "semantic_group_id": "contenant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai mis mes pommes dans un <w>sac</w> en papier."
                        },
                        {
                            "text": "Ce <w>sac</w> en plastique est trop fragile pour porter les bouteilles."
                        }
                    ],
                    "synonyms": [
                        "besace",
                        "sacoche"
                    ],
                    "common_phrases": [
                        "sac en papier",
                        "sac en plastique",
                        "sac de toile"
                    ]
                },
