                        "entry_id": "e1958b7d-e4b8-3d68-9e02-d7f0c9aacd30",
                        "glosses": [
                            "Any of various devices used to measure the amount of air used by a system."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "decf9eb1-2915-4835-85d7-5360a95f40d8",
                                "sense_id": "77b22ed0-85db-3c18-8401-632b39a70084",
                                "text": "The air passes through large iron pipes, from the engine-house to an airometer, which stands at the centre of the works."
                            },
                            {
                                "example_id": "2c1415ee-c98b-4dd1-870b-e67badc822f1",
                                "sense_id": "77b22ed0-85db-3c18-8401-632b39a70084",
                                "text": "I claim the combination and arrangement of a vaporizer, an air-forcing apparatus, and an airometer, the whole being constructed to operate together, substantially as described.."
                            },
                            {
                                "example_id": "8485f7ac-482f-4a03-920c-4a6aa99044c6",
                                "sense_id": "77b22ed0-85db-3c18-8401-632b39a70084",
                                "text": "In a gas-engine, the combination, with the carburetor and the lamps arranged below the same, of the airometer connected to said carburetor , and the pump-piston cylinder connected by valved pipes with said airometer and carburetor, substantially as shown and described ."
                            },
                            {
                                "example_id": "1cebf0f8-bb8c-4f98-a45c-1fe2f198f482",
                                "sense_id": "77b22ed0-85db-3c18-8401-632b39a70084",
                                "text": "The airometer is built upon the principle that in the cylinder consumption of compressed air, the speed of the air passage is dependent upon the pressure, and that the number of cubic feet of free air used is in direct proportion to the speed the air body assumes when filling the cylinder.."
                            }
                        ]
                    }
