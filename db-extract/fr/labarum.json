                "senses": [
                    {
                        "sense_id": "654e2b85-0779-3099-9645-691363534139",
                        "entry_id": "98cbe1e1-3c7e-3744-959e-3ed64dcfb13f",
                        "glosses": [
                            "Étendard impérial."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "fc577410-bfb9-4f14-b9a6-1373c1348bbc",
                                "sense_id": "654e2b85-0779-3099-9645-691363534139",
                                "text": "L'empereur Constantin fit placer sur le labarum la croix et le monogramme de Jésus-Christ avec l’inscription In hoc signo vinces, ce qui signifie \"par ce signe tu vaincras\"."
                            },
                            {
                                "example_id": "b587015b-a4b2-4377-a615-926bcab91c90",
                                "sense_id": "654e2b85-0779-3099-9645-691363534139",
                                "text": "À l’œuvre, bannerets ! Hissez le labarum.\nComme aux anciens romains, donnez-nous le forum :\nEt nous saurons bientôt y dresser la tribune."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5b92585b-a397-4320-b20f-3692e04a29ec",
                        "source_entry_id": "98cbe1e1-3c7e-3744-959e-3ed64dcfb13f",
                        "source_sense_id": "654e2b85-0779-3099-9645-691363534139",
                        "source_sense_description": "étendard",
                        "target_lang_word": "Labarum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Labarum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "90bbe4dd-6ac8-31b4-ac3d-73140e6a0a25",
                                        "entry_id": "7b56bfd0-fa0f-34b1-9bc1-3af53ad5d8cb",
                                        "glosses": [
                                            "die von Konstantin dem Großen bei der Schlacht bei der Milvischen Brücke 312 n. Chr. eingeführte römische kaiserliche Heeresfahne mit dem Christusmonogramm"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53aec5c9-e8da-4e16-8e29-b90a6f0f5b2b",
                                                "sense_id": "90bbe4dd-6ac8-31b4-ac3d-73140e6a0a25",
                                                "text": "„Auch ein unscheinbares Blatt ist dort zu besichtigen, auf dem Kaiser Wilhelm II. im Jahre 1919, also im holländischen Exil, christliche Herrschaftszeichen gezeichnet hat, darunter das konstantinische Labarum, das Feldzeichen mit dem Christogramm, das Konstantin an der Milvischen Brücke geführt haben soll.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "206123d4-0740-3455-ac57-b9ec58f74b4f",
                                        "entry_id": "7b56bfd0-fa0f-34b1-9bc1-3af53ad5d8cb",
                                        "glosses": [
                                            "das Christusmonogramm"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d38af335-a4b2-4a75-9543-1df03a525624",
                        "source_entry_id": "98cbe1e1-3c7e-3744-959e-3ed64dcfb13f",
