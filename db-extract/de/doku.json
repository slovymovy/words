                "senses": [
                    {
                        "sense_id": "96b8f13b-f061-352d-a886-f920a2fe89cc",
                        "entry_id": "ca3ea81a-e9a5-3b70-b648-01bf0efd4a95",
                        "glosses": [
                            "Film, der gedreht wurde (aber auch Radioprogramm), um ein bestimmtes Thema wirklichkeitsgetreu darzustellen"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "c3d01416-01d9-4fc5-8c0d-e8bb12b0cf9a",
                                "sense_id": "96b8f13b-f061-352d-a886-f920a2fe89cc",
                                "text": "Ich schaue mir abends gerne Dokus an."
                            },
                            {
                                "example_id": "ffb05582-b3eb-408d-8f82-381c1f5d63a0",
                                "sense_id": "96b8f13b-f061-352d-a886-f920a2fe89cc",
                                "text": "„Beim Essen sah er sich eine isländische Doku im Staatsfernsehen an, dann legte er sich ins Bett und wollte schlafen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4c86c029-2002-3104-8384-00aabf07ebf5",
                        "entry_id": "ca3ea81a-e9a5-3b70-b648-01bf0efd4a95",
