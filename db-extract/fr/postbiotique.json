                        "glosses": [
                            "Micro-organismes inactivés, produits composants ses micro-organismes ou produits de leur métabolisme."
                        ],
                        "tags": [
                            "Nutrition"
                        ],
                        "examples": [
                            {
                                "example_id": "1cb1451a-ab7a-4a14-8711-0f995087db34",
                                "sense_id": "d627fcbc-d23e-3674-90c4-8a761b2b3898",
                                "text": "Un postbiotique, déchet des probiotiques, crée un environnement favorable au développement des bonnes bactéries, un peu comme le terreau pour les plantes."
                            },
                            {
                                "example_id": "4869c089-e038-4bcb-b854-fc97eba57138",
                                "sense_id": "d627fcbc-d23e-3674-90c4-8a761b2b3898",
                                "text": "C'est quoi un postbiotique ? Étymologiquement, c'est ce qui vient « après le probiotique ». Concrètement, ce sont des résidus, métabolites ou fragments de probiotiques."
                            }
                        ]
                    }
