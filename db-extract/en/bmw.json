    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "50c46e2e-01d2-3ef7-ae89-5abc5cd4ae86",
                "word": "BMW",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "bd621ef9-cf13-3a0b-891a-4df2273ac8c1",
                        "entry_id": "50c46e2e-01d2-3ef7-ae89-5abc5cd4ae86",
                        "glosses": [
                            "A manufacturer of motor vehicles (Bayerische Motoren-Werke (Bavarian Motor Works))."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "043738bb-c9f1-4e6b-ad24-1fffa5374403",
                                "sense_id": "bd621ef9-cf13-3a0b-891a-4df2273ac8c1",
                                "text": "So BMW has conjured a tweener — a roomier hatchback on platform shoes, with standard all-wheel drive — to attract customers who crave the 3 Series’ performance but need more utility to close the deal."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ac113b42-a21a-4398-838b-9632f914ba77",
                        "source_entry_id": "50c46e2e-01d2-3ef7-ae89-5abc5cd4ae86",
                        "source_sense_id": "bd621ef9-cf13-3a0b-891a-4df2273ac8c1",
                        "source_sense_description": "colloquial names and pronunciations, apart from the romanised \"BMW\"",
                        "target_lang_word": "BMW",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "BMW",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "5a7c9866-6ebd-30d1-bea9-257a75d16e10",
                                        "entry_id": "25692562-c4b2-3233-913c-cf15d7d0cf1a",
                                        "glosses": [
                                            "Duitse fabrikant van auto's en motoren, \\\"Bayrische Motoren Werke AG\\"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "952bd77b-80b6-4ad5-9016-2ead86accbd5",
                                                "sense_id": "5a7c9866-6ebd-30d1-bea9-257a75d16e10",
                                                "text": "Met het vertrek van Ferrovial wordt de druk op Groot-Brittannië verder vergroot. Vorige week waarschuwde Airbus zijn Britse activiteiten te kortwieken als brexit te omvangrijke gevolgen heeft. BMW schermt met het vertrek van Mini en Rolls-Royce en ook Siemens bereidt zich voor op een verhuizing."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "BMW",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "dd5a469e-ba33-38e2-b40b-483a4e30d83a",
                                        "entry_id": "8e0aedf0-7090-3f21-851b-0f880479c0ec",
                                        "glosses": [
                                            "auto van het merk BMW"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa15e177-0080-4e85-bf99-0b5c57b3c5f2",
                                                "sense_id": "dd5a469e-ba33-38e2-b40b-483a4e30d83a",
                                                "text": "De tips gingen vooral over de BMW, waarmee de twee schutters vluchtten en die later uitgebrand werd teruggevonden in de Dantestraat in Zuidoost. De gouden tip, waarvoor 25.000 euro wordt uitgeloofd, zat er niet tussen."
                                            },
                                            {
                                                "example_id": "86aaff90-b781-4198-84c0-1704df01b7fd",
                                                "sense_id": "dd5a469e-ba33-38e2-b40b-483a4e30d83a",
                                                "text": "Toen ze de straat in reed, viel haar blik direct op de zilverkleurige BMW."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dfbcd3cd-fe4f-37fa-9e9b-cbddff852ac3",
                                        "entry_id": "8e0aedf0-7090-3f21-851b-0f880479c0ec",
                                        "glosses": [
                                            "motorfiets van het merk BMW"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7da664ca-b544-4080-ae4c-d5c0b0f32c69",
                                                "sense_id": "dfbcd3cd-fe4f-37fa-9e9b-cbddff852ac3",
                                                "text": "Rechts van onze deur stond Egberts BMW te fonkelen. Ik liet mijn hand over de koplampen, de benzinetank en het zadel glijden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3f1e73c6-62e3-488c-898e-88321f0f0c2f",
                        "source_entry_id": "50c46e2e-01d2-3ef7-ae89-5abc5cd4ae86",
                        "source_sense_id": "bd621ef9-cf13-3a0b-891a-4df2273ac8c1",
                        "source_sense_description": "colloquial names and pronunciations, apart from the romanised \"BMW\"",
                        "target_lang_word": "BMW",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "BMW",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7ebe8aea-9783-3621-9d15-6b0268439402",
                                        "entry_id": "09e86af5-5b39-3f64-bf30-d91713fa36a1",
                                        "glosses": [
                                            "Marque de voitures et de motos allemandes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba32bb9b-94de-4f83-a647-45cfb0b769a4",
                                                "sense_id": "7ebe8aea-9783-3621-9d15-6b0268439402",
                                                "text": "Cette équipe de direction animée par Klaus Dieter Frers, puis à partir de 2010, par Wolfgang Ziebart (ex-responsable du département recherche et développement de BMW) est chargée de relever ces défis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9e2a4a2-c38a-3bd3-b967-e87afde33ee4",
                                        "entry_id": "09e86af5-5b39-3f64-bf30-d91713fa36a1",
                                        "glosses": [
                                            "Sigle de Bondues, Mouvaux et Wasquehal, villes de l'agglomération lilloise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "354ee5ee-7f4a-4050-bb0c-93c092372dd6",
                                                "sense_id": "f9e2a4a2-c38a-3bd3-b967-e87afde33ee4",
                                                "text": "Plus loin, et encore plus prisée, la fameuse banlieue «BMW» - Bondues, Mouvaux et Wasquehal - reste le paradis des familles bourgeoises."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb3c3d4d-63d7-35ec-8ef1-891e1c8dcfd3",
                                        "entry_id": "09e86af5-5b39-3f64-bf30-d91713fa36a1",
                                        "glosses": [
                                            "Sigle de Bondues, Marcq-en-Barœul et Wasquehal, villes de l'agglomération lilloise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a5c3a80-3189-48fe-8d0c-2fdaca86b789",
                                                "sense_id": "eb3c3d4d-63d7-35ec-8ef1-891e1c8dcfd3",
                                                "text": "Nettement plus bourgeoises, des communes comme Bondue, Marcq-en-Baroeul et Wasquehal _ le triangle BMW comme s'amusent à le surnommer les Lillois _ nécessitent un ticket d'entrée plus élevé."
                                            },
                                            {
                                                "example_id": "426f7776-cddf-450b-8022-1119c48f2f06",
                                                "sense_id": "eb3c3d4d-63d7-35ec-8ef1-891e1c8dcfd3",
                                                "text": "Longtemps surnommé le triangle d’or « BMW » de la métropole lilloise, les communes de Bondues, Marcq-en-Barœul et Wasquehal sont-elles en pleine mutation ?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "BMW",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "88d2d96b-3bed-3783-b8b0-2e3d074747ad",
                                        "entry_id": "f1c8a2ac-5a65-3f75-b11c-935d2223522d",
                                        "glosses": [
                                            "Véhicule de la marque BMW."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87c17ceb-8f4f-4d03-b0c6-176e752357f1",
                                                "sense_id": "88d2d96b-3bed-3783-b8b0-2e3d074747ad",
                                                "text": "Elle s’installa au volant de sa voiture, une BMW, douze cylindres, vers huit heures."
                                            },
                                            {
                                                "example_id": "daf6c66d-260d-4a67-8498-731711e79723",
                                                "sense_id": "88d2d96b-3bed-3783-b8b0-2e3d074747ad",
                                                "text": "Los Angeles est luxuriante de bougainvilliers et de camélias nourris de l'eau volée à la vallée de l'Owens. Los Angeles, c'est une piscine dans le jardin et une BMW dans l'allée."
                                            },
                                            {
                                                "example_id": "02364c68-d739-42bd-831b-7e8abfe7a950",
                                                "sense_id": "88d2d96b-3bed-3783-b8b0-2e3d074747ad",
                                                "text": "Une BMW était renversée sur le bas-côté."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
