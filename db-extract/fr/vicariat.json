                "entry_id": "dbe77a74-fe6e-3ab9-90de-8a13808da873",
                "word": "vicariat",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "90045e8b-0370-47b0-9b62-730d95788200",
                        "entry_id": "dbe77a74-fe6e-3ab9-90de-8a13808da873",
                        "tags": [
