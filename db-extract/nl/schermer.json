                "entry_id": "03d60b3f-27c7-3785-b268-b19808bb6801",
                "word": "Schermer",
                "pos": "name",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ff3a2305-25f3-35f4-b9cb-194366091365",
                        "entry_id": "03d60b3f-27c7-3785-b268-b19808bb6801",
                        "glosses": [
                            "polder in de Nederlandse provincie Noord-Holland"
                        ],
                        "tags": [
                            "toponymic"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "4d507320-bd13-31ad-bdae-c42a32e20b23",
                        "entry_id": "03d60b3f-27c7-3785-b268-b19808bb6801",
                        "glosses": [
                            "gemeente in de Nederlandse provincie Noord-Holland"
                        ],
                        "tags": [
                            "toponymic"
                        ],
                        "examples": [
                            {
                                "example_id": "9d80c47d-5bbf-47f8-86b7-5f8a0ce9ad97",
                                "sense_id": "4d507320-bd13-31ad-bdae-c42a32e20b23",
                                "text": "Er bestaan wel grote regionale verschillen. Volgens het CBS kregen in sommige gemeenten mensen tweemaal zo veel antibiotica als ergens anders. Zo werd in de gemeente Schermer (Noord-Holland) aan nog geen 15 procent van de bevolking antibiotica verstrekt, in de gemeente Pekela (Zuidoost-Groningen) was dit ruim 30 procent. Antibiotica worden vaker voorgeschreven aan kinderen en ouderen."
                            },
                            {
                                "example_id": "87baf90b-f923-4e6d-a20d-cc40aae75e31",
                                "sense_id": "4d507320-bd13-31ad-bdae-c42a32e20b23",
                                "text": "De ringvaarten in vaargebied Laag Holland maken dat je een mooi totaalbeeld van Noord-Holland krijgt. De Schermer, De Beemster, De Purmer: hoe oerhollands wil je de landschappen hebben?"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
