                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "158e60f8-f00b-4eee-81e4-97fb2c6a0a1e",
                                                "sense_id": "52d20242-31b1-3f77-8e23-ab3f724ec821",
                                                "text": "It was one January morning, very early — a pinching, frosty morning — the cove all gray with hoar-frost, the ripple lapping softly on the stones, the sun still low and only touching the hilltops and shining far to seaward."
