                "senses": [
                    {
                        "sense_id": "ee99b81a-c237-3aa0-aa85-165813940d0c",
                        "entry_id": "39dddba7-2f7e-3ff2-92e2-bb4e2f55a3de",
                        "glosses": [
                            "Passer montanus een zangvogel uit de familie van mussen en sneeuwvinken"
                        ],
                        "tags": [
                            "zangvogels"
                        ],
                        "examples": [
                            {
                                "example_id": "09639db3-d4d8-45f0-be05-7ac5bedbcf9f",
                                "sense_id": "ee99b81a-c237-3aa0-aa85-165813940d0c",
                                "text": "De veldleeuwerik, de ringmus en de patrijs zijn slachtoffers van de schaalvergroting in de Nederlandse landbouw. Deze drie soorten en veel andere akker- en weidevogels kunnen geen plek meer vinden om te nestelen op het boerenland."
                            },
                            {
                                "example_id": "b70e9bb0-5fc0-4599-bf0d-4dcca8e3d488",
                                "sense_id": "ee99b81a-c237-3aa0-aa85-165813940d0c",
                                "text": "De regeling is bedoeld voor inwoners en organisaties die een leefgebied versterken van zeldzame en kwetsbare dieren. Dat geldt voor poelen (kamsalamander, boomkikker en knoflookpad), boerenerven (kerkuil, steenuil, boerenzwaluw, huiszwaluw, ringmus en grauwe vliegenvanger), bosranden (kleine ijsvogelvlinder en sleedoornpage) en heide (adder, bruine eikenpage, bruine vuurvlinder, gentiaanblauwtje en kommavlinder). Uiteraard kunnen ook andere soorten meeprofiteren."
                            }
                        ]
                    }
                ],
