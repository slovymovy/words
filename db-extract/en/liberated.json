                "senses": [
                    {
                        "sense_id": "98830e02-5ee5-33a2-9aca-01fc31b60665",
                        "entry_id": "84dc6ad2-e249-3e8a-9077-927715e3b8bf",
                        "glosses": [
                            "Freed, especially from traditional ideas in social and sexual matters."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c902f36-906b-4f80-aa7b-cda823a7f544",
                                "sense_id": "98830e02-5ee5-33a2-9aca-01fc31b60665",
                                "text": "a newly liberated prisoner"
                            },
                            {
                                "example_id": "432aff2f-6572-4d15-9736-418f7f49d920",
                                "sense_id": "98830e02-5ee5-33a2-9aca-01fc31b60665",
                                "text": "His is a very liberated lifestyle."
                            },
                            {
                                "example_id": "1dba4a58-1c83-4122-a63b-72b32479ef18",
                                "sense_id": "98830e02-5ee5-33a2-9aca-01fc31b60665",
                                "text": "She is sexually liberated."
                            },
                            {
                                "example_id": "17de21a3-8df3-45d5-a9cc-8eeba549d8a8",
                                "sense_id": "98830e02-5ee5-33a2-9aca-01fc31b60665",
                                "text": "Even in the relatively liberated Scandinavian countries that permit a form of same-sex marriage, the legislation creating the right to marry explicitly states that such couples will not be permitted to adopt children."
                            },
                            {
                                "example_id": "591d9157-4606-4514-a4f8-13ec68e54ebc",
                                "sense_id": "98830e02-5ee5-33a2-9aca-01fc31b60665",
                                "text": "In private, Marilyn was perhaps more sexually liberated than most women were generally during her lifetime."
                            }
                        ]
                    }
                ],
