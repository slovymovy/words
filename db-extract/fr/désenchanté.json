                                        "examples": [
                                            {
                                                "example_id": "fe253486-d1f1-4335-a34a-06a7939145be",
                                                "sense_id": "97a8bb1f-f00e-3f61-b38f-168cf43d953f",
                                                "text": "I visited Chiang Kai-shek at a lake resort on Taiwan. Chiang still dreamed of returning to the mainland, and once again he urged that America support such an effort. He argued that the Chinese on the mainland were disenchanted with their leaders and ready to rally to another force."
                                            }
