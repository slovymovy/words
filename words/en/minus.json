                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used by children or in informal contexts instead of 'subtract'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выполнять математическую операцию вычитания.",
                        "zh": "执行减法运算。"
                    },
                    "translations": {
