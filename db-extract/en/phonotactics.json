                                        "examples": [
                                            {
                                                "example_id": "104e13a4-b96b-49eb-83e8-ca9e777cff59",
                                                "sense_id": "180df5c0-b59e-321d-ac65-625e9327f594",
                                                "text": "L’une des méthodes consiste à solliciter la production en employant des mots créés de toutes pièces, des pseudomots qui respectent les propriétés phonotactiques de la langue considérée."
                                            }
                                        ]
                                    }
                                ]
                            },
