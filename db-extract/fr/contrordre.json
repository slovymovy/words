                ],
                "senses": [
                    {
                        "sense_id": "77ae0582-5b49-3104-9a38-44e0991c2759",
                        "entry_id": "e88021c7-d0b2-381d-b809-409b4f2313eb",
                        "glosses": [
                            "Révocation d’un ordre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf458732-466e-4719-bf4f-a618bb44f99b",
                                "sense_id": "77ae0582-5b49-3104-9a38-44e0991c2759",
                                "text": "Il avait eu ordre de partir, mais il a reçu un contrordre."
                            },
                            {
                                "example_id": "14a3e1ab-acb5-49ff-a4d2-810659f21ea7",
                                "sense_id": "77ae0582-5b49-3104-9a38-44e0991c2759",
                                "text": "Donner, recevoir contrordre."
                            },
                            {
                                "example_id": "8e7334db-f8a7-4f3b-9437-d5df6b38acbf",
                                "sense_id": "77ae0582-5b49-3104-9a38-44e0991c2759",
                                "text": "Et de peur d’un contre-ordre, il se précipita vers la porte que Tristan lui rouvrit d’assez mauvaise grâce."
                            },
                            {
                                "example_id": "6d49e2eb-4e9a-4e44-9d8d-0835029f0d00",
                                "sense_id": "77ae0582-5b49-3104-9a38-44e0991c2759",
                                "text": "Je protestai que c’était impossible, que j’avais téléphoné chez moi pour que le dîner fût digne d’elle.\n— Eh bien, vous donnerez un contrordre de chez Eyrondo."
                            },
                            {
                                "example_id": "a69b8c95-535f-4a43-9d95-ac360e8185df",
                                "sense_id": "77ae0582-5b49-3104-9a38-44e0991c2759",
                                "text": "Je m’en souviens car, peu de temps après son retour de Rabat, le président envoya un contrordre."
                            },
                            {
                                "example_id": "4d24e974-c6a3-4e10-b6cc-29d4b91b3c08",
                                "sense_id": "77ae0582-5b49-3104-9a38-44e0991c2759",
                                "text": "– C’est comme à l’armée : avant d’exécuter un ordre, attendez le contrordre !"
                            }
                        ]
                    }
                ],
