                "senses": [
                    {
                        "sense_id": "76a5e077-5307-3dc4-83d8-af92daddf1fc",
                        "entry_id": "6dd6b82d-8179-3841-a8fe-84182db8e0e1",
                        "glosses": [
                            "bereits bei der Geburt vorhandene partielle Farbenblindheit, bei der nur zwei der drei Grundfarben wahrgenommen werden können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4a0891c-910b-43b1-97d1-650fbd7b66ec",
                                "sense_id": "76a5e077-5307-3dc4-83d8-af92daddf1fc",
                                "text": "„Bei der sog. Dichromasie, der teilweisen Farbenblindheit, kann der Betroffene eine der drei Grundfarben nicht sehen, ist z. B. Rot-blind, und kann daher bestimmte Farben nicht unterscheiden.“"
                            },
                            {
                                "example_id": "1ade810b-93a3-4190-8781-ae6109c39624",
                                "sense_id": "76a5e077-5307-3dc4-83d8-af92daddf1fc",
                                "text": "„Dichromasien sind die häufigsten Formen der Farbsinnstörung und sind geschlechtsgebunden vererbbar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
