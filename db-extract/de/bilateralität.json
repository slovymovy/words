                ],
                "senses": [
                    {
                        "sense_id": "ede72f2d-8e1d-35ad-ab7d-386f3bc1df80",
                        "entry_id": "650b792a-72f1-3d10-a30a-39e0b3535517",
                        "glosses": [
                            "Eigenschaft/Tatsache, dass etwas auf zwei Seiten, zweiseitig (bilateral) ausgeprägt ist; dass sich etwas auf zwei Seiten bezieht"
                        ],
                        "tags": [
                            "auch"
                        ],
                        "examples": [
                            {
                                "example_id": "8aaee59e-0c5d-414d-b9d6-5d2830360ceb",
                                "sense_id": "ede72f2d-8e1d-35ad-ab7d-386f3bc1df80",
                                "text": "Medizin, Biologie: „Bilateralität und Dorsoventralität. Diese beiden grundlegenden Körperausrichtungen sind für alle Bilateralier typisch, wobei die Bilateralität nie ganz streng spiegelbildlich symmetrisch ausgebildet ist.“"
                            },
                            {
                                "example_id": "f90c981c-bf5a-43ad-9604-67594365f440",
                                "sense_id": "ede72f2d-8e1d-35ad-ab7d-386f3bc1df80",
                                "text": "Medizin. Psychologie: „Häufigkeit des Vorkommens von Rechtshändigkeit, Linkshändigkeit und Beidhändigkeit: • Rechtshändigkeit (Dextralität): 85–90% • Linkshändigkeit (Sinistralität): 5–15% • Beidhändigkeit (Bilateralität): 5–10%.“"
                            },
                            {
                                "example_id": "b91c5317-53e4-4d1e-991e-ea7a0db8361d",
                                "sense_id": "ede72f2d-8e1d-35ad-ab7d-386f3bc1df80",
                                "text": "Linguistik: „Dieser Aspekt einer auf Dualität basierenden Einheit, der insbesondere in dem Begriff der Bilateralität (=Zweiseitigkeit) zum Ausdruck kommt, bildet bei Saussure die Grundlage zur Aufstellung verschiedener Thesen.“"
                            },
                            {
                                "example_id": "d120a8f9-0c5f-49ec-91f6-eef2d05f3219",
                                "sense_id": "ede72f2d-8e1d-35ad-ab7d-386f3bc1df80",
                                "text": "Linguistik: „Die paradigmatischen Relationen des Wortschatzes können auf Grund der Bilateralität des sprachlichen Zeichens in ausdrucksseitige und inhaltsseitige Relationen unterteilt werden.“"
                            },
                            {
                                "example_id": "ca58624d-37b3-45f3-8801-a39c0c0adbae",
                                "sense_id": "ede72f2d-8e1d-35ad-ab7d-386f3bc1df80",
                                "text": "Wirtschaft: „Dennoch wird der Tausch durch die Hinzunahme eines bloßen Versprechens als vollendet betrachtet, seine Bilateralität als gegeben angenommen.“"
                            },
                            {
                                "example_id": "02852845-ffb7-49b0-948d-c0f410d42b2f",
                                "sense_id": "ede72f2d-8e1d-35ad-ab7d-386f3bc1df80",
                                "text": "Politik: „Die Bilateralität der institutionalisierten Außenassoziation war bereits während der Vertragsverhandlungen der Hohen Behörde mit Großbritannien zu erkennen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
