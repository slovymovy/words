                    {
                        "translation_id": "ceae1905-2e42-466d-9afb-469bc28685c6",
                        "source_entry_id": "ab0ffbfa-3c09-3377-b158-f776ea18480b",
                        "source_sense_id": "b4e6e2ca-b643-38cf-a150-ca4ca5c2cb2c",
                        "source_sense_description": "Physiologie: Entleerung der Harnblase",
                        "target_lang_word": "miction",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
