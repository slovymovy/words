                "senses": [
                    {
                        "sense_id": "9403cd03-0bae-3675-be2f-17f54f1693bb",
                        "entry_id": "a0fe06e8-0dc6-3cef-8f82-411157785d0f",
                        "glosses": [
                            "Mangel an Ausgeglichenheit zwischen zwei oder mehr Dingen, Aspekten; Abweichung von einem normalen, erforderlichen Gleichgewicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb0e488c-6ed7-44ff-8342-770b842c3680",
                                "sense_id": "9403cd03-0bae-3675-be2f-17f54f1693bb",
                                "text": "„Diese Verhältnisse sind, auch wenn sie dem Westen missfallen, genauso real wie das demografische Ungleichgewicht, die Jugendarbeitslosigkeit und die Korruption der Regime.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5503208a-d65e-42e7-9ad0-b2654528916e",
                        "source_entry_id": "a0fe06e8-0dc6-3cef-8f82-411157785d0f",
                        "source_sense_id": "9403cd03-0bae-3675-be2f-17f54f1693bb",
                        "target_lang_word": "disequilibrium",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "disequilibrium",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "850bdd78-d1a3-338e-b683-5e0ff51672b5",
                                        "entry_id": "c149d128-d6e0-3c99-acc2-945311f4f226",
                                        "glosses": [
                                            "The loss of equilibrium or stability, especially due to an imbalance of forces."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a26ce814-5c7a-40ce-b240-868f1a159c4a",
                                                "sense_id": "850bdd78-d1a3-338e-b683-5e0ff51672b5",
                                                "text": "The world of the angelic hierarchy was an evolutionary stream of light in a steady-state, but the creation of Adam from matter disturbs that primordial steady-state; it generates the creative disequilibrium necessary for change, transformation, and evolution."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0aa5d35d-72ce-46ad-99e5-685142b0fe98",
                        "source_entry_id": "a0fe06e8-0dc6-3cef-8f82-411157785d0f",
                        "source_sense_id": "9403cd03-0bae-3675-be2f-17f54f1693bb",
                        "target_lang_word": "imbalance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "imbalance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ce377194-118a-31ab-a23d-c6613b4acc21",
                                        "entry_id": "68024b8a-e485-30b7-8156-cbeed6db9083",
                                        "glosses": [
                                            "The property of not being in balance."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0dfb964-b398-4ee9-a48a-9cf1c0ac2075",
                                                "sense_id": "ce377194-118a-31ab-a23d-c6613b4acc21",
                                                "text": "The growing imbalances between the rich and poor first lead to more crime."
                                            },
                                            {
                                                "example_id": "5e76ecde-d9e6-4c0c-a9c8-5ad0ffd12c3b",
                                                "sense_id": "ce377194-118a-31ab-a23d-c6613b4acc21",
                                                "text": "Ross Barkley, a second-half substitute, almost marked his debut with a goal but by that stage England were playing at half-pace. A team can do that when the imbalance of talent is this considerable."
                                            },
                                            {
                                                "example_id": "eaad9e10-2831-4a38-bc94-3083512dcec2",
                                                "sense_id": "ce377194-118a-31ab-a23d-c6613b4acc21",
                                                "text": "There are some stations which have literally 1,000-1,500 passengers a year, whereas Whitby has over 140,000, so there's a huge imbalance between the usage of some stations and others."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fba58020-894d-48fb-a566-221bc7f83dcf",
                        "source_entry_id": "a0fe06e8-0dc6-3cef-8f82-411157785d0f",
                        "source_sense_id": "9403cd03-0bae-3675-be2f-17f54f1693bb",
                        "target_lang_word": "déséquilibre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "déséquilibre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fe90d740-dd77-31b3-a92f-b00564748e5d",
                                        "entry_id": "c567a2a1-98b8-34ac-8d7a-20f01fdc9bc4",
                                        "glosses": [
                                            "Manque d’équilibre (au propre et au figuré)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bae98a54-1884-40e9-b97d-1c2dcf87ef2e",
                                                "sense_id": "fe90d740-dd77-31b3-a92f-b00564748e5d",
                                                "text": "L’impact […] s’inscrit dans la géographie des villes, des quartiers et des bidonvilles où les migrants tendent à se regrouper par ethnies, il s’inscrit aussi au niveau régional, accentuant les déséquilibres entre régions dynamiques et en crise."
                                            },
                                            {
                                                "example_id": "0c1c0692-495e-415c-9c00-21cec4dcb217",
                                                "sense_id": "fe90d740-dd77-31b3-a92f-b00564748e5d",
                                                "text": "« Le déséquilibre fiscal entre les provinces et le fédéral est encore bien réel, notamment en raison du poids des dépenses en santé. »"
                                            }
                                        ]
                                    }
                                ]
                            },
