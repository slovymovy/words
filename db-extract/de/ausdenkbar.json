                                        "entry_id": "3e5f3d9e-6836-3423-a821-5e7ae4c17ece",
                                        "glosses": [
                                            "Able to be thought or imagined; conceivable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c002eb6f-9407-453d-b55b-0aef04428316",
                                                "sense_id": "889e03ea-cba6-36f2-a5e0-e2262316d3cb",
                                                "text": "“Nothing can separate us; not hatred, not hunger, not homelessness, not threats, not even sin, not the thinkable or unthinkable can get between us,” it reads."
                                            }
