                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2aab236e-504d-3cff-aa63-848682d91c88",
                                        "entry_id": "1fdb6eba-46b0-39b4-985a-50ead7e6133d",
                                        "glosses": [
                                            "A box carried on locomotives, from which sand runs onto the rails in front of the driving wheels, to prevent slipping."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eff3e868-2758-495c-8cbd-bbb03581bd94",
                                                "sense_id": "2aab236e-504d-3cff-aa63-848682d91c88",
                                                "text": "For the most part they were small standard gauge 0-6-0 side tanks of the type illustrated, with long tapered chimneys and an unusual feature for the Continent in the shape of domeless boilers, the protuberance just behind the chimney being a sandbox."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "666ba78c-7313-3ccc-babb-b74eba74a00a",
                                        "entry_id": "1fdb6eba-46b0-39b4-985a-50ead7e6133d",
                                        "glosses": [
                                            "An isolated area where a program can be executed with a restricted portion of the resources available."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2182181c-0791-4900-a83a-b0d642906591",
                                                "sense_id": "666ba78c-7313-3ccc-babb-b74eba74a00a",
                                                "text": "Running a program in a sandbox can prevent it from doing any damage to the system."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b30321c-64ea-3847-be4d-2ad608c65bec",
                                        "entry_id": "1fdb6eba-46b0-39b4-985a-50ead7e6133d",
                                        "glosses": [
                                            "A page on a wiki where users are free to experiment without destroying or damaging any legitimate content."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "da54b84e-f180-3a39-ab2a-7bc2cfd6c551",
                                        "entry_id": "1fdb6eba-46b0-39b4-985a-50ead7e6133d",
                                        "glosses": [
                                            "The Middle East."
                                        ],
