{
    "word_family": [
        "discontented",
        "discontentment"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "463ab6a6-4eb3-3d1b-9d29-f2ad594b271e",
                    "sense_definition": "A feeling of dissatisfaction or lack of contentment.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dissatisfaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Widespread <w>discontent</w> among the workers led to a major strike.",
                            "target_lang_translations": {
                                "zh": "工人们中普遍存在的<w>不满</w>情绪导致了一场大规模罢工。"
                            }
                        },
                        {
                            "text": "There is growing social <w>discontent</w> over rising prices.",
                            "target_lang_translations": {
                                "zh": "由于物价上涨，社会上出现了日益增长的<w>不满</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dissatisfaction",
                        "unhappiness"
                    ],
                    "antonyms": [
                        "contentment",
                        "satisfaction"
                    ],
                    "common_phrases": [
                        "growing discontent",
                        "social discontent",
                        "express discontent"
                    ],
                    "target_lang_definitions": {
                        "zh": "对现状的不满或不满足感。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "不满",
                                "target_lang_sense_clarification": "指对现状或待遇感到不满意。"
                            },
                            {
                                "target_lang_word": "不平",
                                "target_lang_sense_clarification": "指心中感到不公平或不满。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f0b29308-8d84-3421-8031-b88273b37c8a",
                    "sense_definition": "A restlessly unhappy feeling or a longing for better circumstances.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "dissatisfaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His divine <w>discontent</w> pushed him to constantly improve his artistic work.",
                            "target_lang_translations": {
                                "zh": "他那种<w>不安于现状</w>的进取心促使他不断改进自己的艺术作品。"
                            }
                        },
                        {
                            "text": "The book describes the deep <w>discontent</w> felt by young intellectuals in the twentieth century.",
                            "target_lang_translations": {
                                "zh": "这本书描述了二十世纪年轻知识分子内心深处的<w>躁动</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "restlessness",
                        "unease"
                    ],
                    "common_phrases": [
                        "divine discontent",
                        "winter of discontent"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种不安于现状、渴望更好境遇的心理状态。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "不安于现状",
                                "target_lang_sense_clarification": "指不满足于当前情况，渴望进步或改变。"
                            },
                            {
                                "target_lang_word": "躁动",
                                "target_lang_sense_clarification": "指内心不安，渴望寻求突破。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "44782edd-1f37-3333-ae5e-6d819d038121",
                    "sense_definition": "A person who is dissatisfied and rebellious.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The royal guards quickly arrested the chief <w>discontent</w> before a riot could start.",
                            "target_lang_translations": {
                                "zh": "皇家卫队在骚乱开始前迅速逮捕了那名主要的<w>不满者</w>。"
                            }
                        },
                        {
                            "text": "The king feared that political <w>discontents</w> would try to overthrow his government.",
                            "target_lang_translations": {
                                "zh": "国王担心政治<w>不满者</w>会试图推翻他的政府。"
                            }
                        }
                    ],
                    "synonyms": [
                        "malcontent",
                        "rebel"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used as a noun for a person"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指心怀不满并倾向于反抗的人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "不满者",
                                "target_lang_sense_clarification": "指对现状不满并可能采取行动的人。"
                            },
                            {
                                "target_lang_word": "反叛者",
                                "target_lang_sense_clarification": "指对现有秩序不满并试图反抗的人。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "53d41d5c-0ec0-30e8-a584-fb5246e46815",
                    "sense_definition": "Not satisfied or content with one's circumstances.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The customer was extremely <w>discontent</w> with the service she received.",
                            "target_lang_translations": {
                                "zh": "那位顾客对她所接受的服务感到非常<w>不满</w>。"
                            }
                        },
                        {
                            "text": "Many young people feel <w>discontent</w> with their current career prospects.",
                            "target_lang_translations": {
                                "zh": "许多年轻人对他们目前的职业前景感到<w>不满足</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "discontented",
                        "dissatisfied"
                    ],
                    "antonyms": [
                        "content",
                        "satisfied"
                    ],
                    "common_phrases": [
                        "feel discontent"
                    ],
                    "target_lang_definitions": {
                        "zh": "对所处环境或现状感到不满意。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "不满",
                                "target_lang_sense_clarification": "形容词，表示对某事不满意。"
                            },
                            {
                                "target_lang_word": "不满足",
                                "target_lang_sense_clarification": "形容词，表示对现状感到不够好。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "adbf9ab3-f2dd-309e-bf03-c5e64f7190dd",
                    "sense_definition": "To make someone dissatisfied or uneasy.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nothing could <w>discontent</w> him more than being stuck inside on a sunny day.",
                            "target_lang_translations": {
                                "zh": "在阳光明媚的日子里被困在室内，没有什么比这更让他感到<w>不满</w>了。"
                            }
                        },
                        {
                            "text": "The sudden change of plans managed to <w>discontent</w> the entire group.",
                            "target_lang_translations": {
                                "zh": "计划的突然改变让整个团队都感到<w>不快</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dissatisfy",
                        "displease"
                    ],
                    "antonyms": [
                        "please",
                        "satisfy"
                    ],
                    "target_lang_definitions": {
                        "zh": "使某人感到不满或不安。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "使……不满",
                                "target_lang_sense_clarification": "动词短语，表示引起他人的不满情绪。"
                            },
                            {
                                "target_lang_word": "令……不快",
                                "target_lang_sense_clarification": "动词短语，表示让某人感到不高兴。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}