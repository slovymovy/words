                "senses": [
                    {
                        "sense_id": "333ffca6-4921-3cf7-82d6-b5305c511591",
                        "entry_id": "d786a83e-ff81-3fd7-84a5-720878efa1ef",
                        "glosses": [
                            "обсуждать совместно с кем-либо"
                        ],
