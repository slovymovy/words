                                                "sense_id": "547283fc-a1d2-3d0d-9cb5-8a4c67f34be3",
                                                "text": "irriverentemente disse: \"Fa il maestro... lui: oh, poverino\""
                                            },
                                            {
                                                "example_id": "3cafeb10-5074-477d-beba-3b04b84c0eb4",
                                                "sense_id": "547283fc-a1d2-3d0d-9cb5-8a4c67f34be3",
                                                "text": "tu non sei il maestro di nessuno!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f8402d35-0705-4f5d-ad4c-823ca054eb02",
