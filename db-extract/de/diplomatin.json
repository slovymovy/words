                "translations": [
                    {
                        "translation_id": "d51d6455-5e0e-4aaf-a165-9bfa4061c323",
                        "source_entry_id": "75e28f66-335b-35bc-98cf-dfaf775563c6",
                        "source_sense_id": "edee2f85-85b8-388e-a617-18d9aa5b7911",
                        "source_sense_description": "staatlich autorisierte weibliche Person, den eigenen Staat im Ausland/bei Organisationen zu vertreten",
                        "target_lang_word": "diplomate",
                        "target_lang_code": "fr",
