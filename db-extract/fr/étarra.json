                        ],
                        "examples": [
                            {
                                "example_id": "93908342-f796-45f3-a005-785ee7b92126",
                                "sense_id": "0d1f1932-0fc9-3a96-8ac4-955ed87104d3",
                                "text": "Mais le principal écueil réside, à nos yeux, dans l’absence d’explication convaincante concernant la recrudescence de la violence étarra lors de la transition démocratique."
                            },
                            {
                                "example_id": "7d2748e3-a7ef-4cfe-b8ae-685c133a228e",
                                "sense_id": "0d1f1932-0fc9-3a96-8ac4-955ed87104d3",
                                "text": "Le quatrième chapitre porte sur collaboration policière, judiciaire et politique entre la France et l’Espagne dans la lutte contre l’ETA ; collaboration évolutive au gré de la perception française de la menace étarra."
                            }
                        ]
                    }
