                                "example_id": "4fd4c371-5470-46ed-a5bf-c5a9d9551a11",
                                "sense_id": "02804495-39bc-3ffc-80df-be05e559f099",
                                "text": "„Unterschrieben hat er trotzdem, vermutlich um seinen Brotgeber, den S. Fischer Verlag zu unterstützen.“"
                            }
                        ],
