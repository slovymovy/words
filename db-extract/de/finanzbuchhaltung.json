                "senses": [
                    {
                        "sense_id": "6b749c62-718e-331d-a84a-86faaae860d7",
                        "entry_id": "1ac4812f-33b8-397d-9fc2-93f5c72c4338",
                        "glosses": [
                            "Vorgänge, die zur Bilanzierung und Gewinn- und Verlustrechnung nötig sind."
                        ],
                        "tags": [
                            "Rechnungswesen"
                        ],
                        "examples": [
                            {
                                "example_id": "19f298cb-7bd9-4171-b22d-8ba74988ee03",
                                "sense_id": "6b749c62-718e-331d-a84a-86faaae860d7",
                                "text": "„Mit der Finanzbuchhaltung - kurz auch FIBU genannt - werden alle Geschäftsfälle lückenlos und systematisch aufgezeichnet.“"
                            },
                            {
                                "example_id": "a95a429a-575c-4350-850e-453850f86bb3",
                                "sense_id": "6b749c62-718e-331d-a84a-86faaae860d7",
                                "text": "Schon vor Jahren hat mein Großvater die Finanzbuchhaltung erlernt."
                            },
                            {
                                "example_id": "51eda0be-c2e3-429a-98a7-23c44e3451ae",
                                "sense_id": "6b749c62-718e-331d-a84a-86faaae860d7",
                                "text": "„Eine Ergänzung der Finanzbuchhaltung bietet die Betriebsbuchhaltung, die, auf den Werten der Finanzbuchhaltung aufbauend, der innerbetrieblichen Abrechnung dient.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
