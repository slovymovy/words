                {
                    "sense_id": "e7135025-432e-3853-a18e-139ebca036d2",
                    "sense_definition": "Located close to or near a specific time or place.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "proximity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The weather usually gets colder <w>toward</w> the end of October.",
                            "target_lang_translations": {
                                "ru": "Погода обычно становится холоднее <w>ближе к</w> концу октября.",
                                "tr": "Hava genellikle Ekim ayının sonuna <w>doğru</w> soğur.",
                                "zh": "十月底<w>临近</w>时，天气通常会变冷。"
                            }
                        },
                        {
                            "text": "They live in a house over <w>toward</w> the river.",
                            "target_lang_translations": {
                                "ru": "Они живут в доме <w>у</w> реки.",
                                "tr": "Nehir <w>tarafındaki</w> bir evde yaşıyorlar.",
                                "zh": "他们住在靠近河边的一所房子里。"
                            }
