                "senses": [
                    {
                        "sense_id": "f844e7f8-b231-3260-a827-118d84d72b2a",
                        "entry_id": "9cff44cb-a6f6-3bdf-809a-60966429b820",
                        "glosses": [
                            "Relatif au massif montagneux, ou au département des Vosges et à ses habitants."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f3fe197-cd6d-4f2d-86e0-ecad77dde39a",
                                "sense_id": "f844e7f8-b231-3260-a827-118d84d72b2a",
                                "text": "Cette existence, si laborieuse et si monotone, du marcaire vosgien, au début du XVIIIᵉ siècle, était cependant moins pénible que celle de ses émules de certaines régions des Alpes."
                            },
                            {
                                "example_id": "a588ce93-47fc-4200-a465-6ddba531d2e6",
                                "sense_id": "f844e7f8-b231-3260-a827-118d84d72b2a",
                                "text": "Au point de vue floristique, la vallée de la Lanterne et de ses affluents de droite essentiels représente une zone de passage entre la flore vosgienne silicicole des Ballons et la flore des terrains jurassiques."
                            },
                            {
                                "example_id": "26d9093a-5dd9-431a-8733-90b395c4b5d0",
                                "sense_id": "f844e7f8-b231-3260-a827-118d84d72b2a",
                                "text": "Y aura-t-il des supporters vosgiens, dimanche, à Mazeray ?"
                            }
                        ]
                    }
