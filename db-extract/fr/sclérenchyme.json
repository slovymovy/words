                        "entry_id": "81217cb9-3095-309d-8c3f-bd0fb5f577e5",
                        "glosses": [
                            "Tissu de soutien rigide des plantes, constitué de cellules mortes à paroi lignifiée de type fibres scléreuses ou scléréides, et qui confère la rigidité et la solidité aux organes matures."
                        ],
                        "tags": [
                            "Biologie végétale",
                            "Histologie végétale"
                        ],
                        "examples": [
                            {
                                "example_id": "0d9c7f28-482c-45f9-97c0-7eec3de217b6",
                                "sense_id": "bfad9a94-9c06-32f4-8313-a856762222fd",
                                "text": "Le sclérenchyme est formé de cellules allongées (section longitudinales), polyédriques (section transversale), à membrane très épaissie.  ^([1])"
                            },
                            {
                                "example_id": "aa131f69-26e2-4974-949c-c17d49c8c3c0",
                                "sense_id": "bfad9a94-9c06-32f4-8313-a856762222fd",
                                "text": "Les cellules du sclérenchyme sont des fibres.  ^([1])"
                            }
                        ]
                    }
                ],
