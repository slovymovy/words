                "senses": [
                    {
                        "sense_id": "b8afcd46-c646-3126-8087-7ddb39cf14ba",
                        "entry_id": "cfc9dd21-f535-3d52-896a-e44fff01858a",
                        "glosses": [
                            "Impossible to end; which cannot be ended; interminable."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "3dc78f0f-2fd6-4f04-bbb8-cd35d632b93d",
                                "sense_id": "b8afcd46-c646-3126-8087-7ddb39cf14ba",
                                "text": "The discussion seemed unendable, and I fell asleep on the ground outside[.]"
                            },
                            {
                                "example_id": "b1115fd7-a2cb-4f1c-86a2-c15ba39333b0",
                                "sense_id": "b8afcd46-c646-3126-8087-7ddb39cf14ba",
                                "text": "In the far-off days before this unending and perhaps unendable war, we believed that reason governed human events, ..."
                            },
                            {
                                "example_id": "10498998-1ad1-4523-81d1-88b90323cd80",
                                "sense_id": "b8afcd46-c646-3126-8087-7ddb39cf14ba",
                                "text": "The abortion debate involves endless, unendable disagreement about such issues as when a fetus becomes a human or a person, when life begins, when or whether abortion should be legal, whether we should call it “killing” or “termination.”"
                            },
                            {
                                "example_id": "04420e12-c612-49cf-a85f-0622f60cda93",
                                "sense_id": "b8afcd46-c646-3126-8087-7ddb39cf14ba",
                                "text": "Likewise, in a period of just seven months, I have ended seven unendable wars. They said they were unendable. You're never going to get them solved. Some were going for 31 years, two of them, 31, you think of it, 31 years. One was 36 years, one was 28 years. I ended seven wars."
                            }
                        ]
                    }
