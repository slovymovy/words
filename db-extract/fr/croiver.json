                "senses": [
                    {
                        "sense_id": "a10b4220-6c11-3e8a-bb3c-17936866850a",
                        "entry_id": "9365b185-aa93-3214-b3d8-c878cee733d0",
                        "glosses": [
                            "Croire, en particulier quelque chose d’absolument faux."
                        ],
                        "tags": [
                            "Par plaisanterie"
                        ],
                        "examples": [
                            {
                                "example_id": "35a63131-14ec-4170-8aec-0962ec5e2fd7",
                                "sense_id": "a10b4220-6c11-3e8a-bb3c-17936866850a",
                                "text": "Et alors je ne vous dis pas, pour décoller de la lune avec un amas de papier crépon et aller choper et s'accrocher à un petit engin qui flotte quelque part dans l'espace !\nMais faut croiver convoudi !"
                            },
                            {
                                "example_id": "dd5c8eb5-bb87-468f-b06f-bcd0b0294152",
                                "sense_id": "a10b4220-6c11-3e8a-bb3c-17936866850a",
                                "text": "Ouaip, les fameux morgelons, d'ailleurs, les merdias essayent de nous faire croiver qu'il s'agit de toiles d'araignées mais les vrais sachent"
                            },
                            {
                                "example_id": "1144f503-0ea7-4275-9db5-dd6d7b4e50b4",
                                "sense_id": "a10b4220-6c11-3e8a-bb3c-17936866850a",
                                "text": "Cyril, la vie d’ma mère il faut que tu me croives, le vaccin à la chlorophylle ça marche vraiment !"
                            },
                            {
                                "example_id": "2f51c9c4-750e-4e8d-a5da-8e26eab3d8b8",
                                "sense_id": "a10b4220-6c11-3e8a-bb3c-17936866850a",
                                "text": "Hein ? Passe que tu croives j’ai le temps de ranger les jouets ?"
                            }
                        ]
                    }
                ],
