                    {
                        "translation_id": "877b227a-bf12-49f8-ae96-3d1c1f359510",
                        "source_entry_id": "973ea749-1321-380f-8af0-fadf82a9d08f",
                        "source_sense_description": "someone who trains athletes",
                        "target_lang_word": "entraîneur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "entraîneur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a59553d3-3e9d-355a-8cd4-9d20f138faaf",
                                        "entry_id": "8ba7b6ee-56f7-38e5-8414-4c62ff418f7f",
                                        "glosses": [
                                            "Qui entraîne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2ea2ded-c256-4a61-877b-7cd3421e1034",
                                                "sense_id": "a59553d3-3e9d-355a-8cd4-9d20f138faaf",
                                                "text": "Les deux cylindres entraîneurs sont cannelés, le cylindre supérieur est maintenu par deux torts ressorts qui peuvent se soulever."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "entraîneur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1928f077-4eb2-3b68-b903-d37459f13ba7",
                                        "entry_id": "831c5f08-a37e-3d3d-9753-12db0b07ecf9",
                                        "glosses": [
                                            "Celui qui entraîne (en particulier un animal de course, comme un cheval, ou de cirque)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1834408e-d38f-4abe-8940-8b649eec4357",
                                                "sense_id": "1928f077-4eb2-3b68-b903-d37459f13ba7",
                                                "text": "Ceux qui soignent des chevaux de course sont appelés entraîneurs ou grooms d'entraînement."
                                            },
                                            {
                                                "example_id": "49031f2a-7f37-455d-af05-bbc6072990da",
                                                "sense_id": "1928f077-4eb2-3b68-b903-d37459f13ba7",
                                                "text": "William avait une passion, commune à beaucoup de gens de service : les courses. Il connaissait tous les jockeys, tous les entraîneurs, tous les bookmakers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8add3058-2c52-3e4d-9e20-fb13930ed9ec",
                                        "entry_id": "831c5f08-a37e-3d3d-9753-12db0b07ecf9",
                                        "glosses": [
                                            "Homme chargé de la préparation physique, technique, tactique et mentale d’un sportif, d’une sportive ou d’une équipe sportive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e73c535c-58c3-4226-903e-0e7cf3c0c516",
                                                "sense_id": "8add3058-2c52-3e4d-9e20-fb13930ed9ec",
                                                "text": "« Pour les entraîneurs, il ne faut pas oublier, quand ils voient leur ancienne équipe performer, de ne pas se blâmer à outrance », explique Cédric Quignon-Fleuret, psychologue du sport et préparateur mental, passé par Monaco et Bordeaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a09aa33d-523f-31d5-8b50-2513f7368cad",
                                        "entry_id": "831c5f08-a37e-3d3d-9753-12db0b07ecf9",
                                        "glosses": [
                                            "Homme dont le rôle est de pousser les clients à boire ou à danser, souvent employé dans les bars ou les discothèques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc90f3f2-629a-4985-8b45-f0801355a713",
                                                "sense_id": "a09aa33d-523f-31d5-8b50-2513f7368cad",
                                                "text": "Une autre chose à savoir est qu’il vaut mieux éviter les bars devant lesquels de gentils rabatteurs tentent de vous faire entrer. Que les rabatteurs soient étrangers (africains majoritairement) ou qu’ils soient japonais (dans le plus pur style shimpila), ça sent l’arnaque. Bien souvent, ces bars sont remplis d’hôtesses (hommes ou femmes) qui ne sont en réalité que des entraîneurs et entraîneuses."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "entraîneur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5b30c453-6cc0-3837-8541-1f1bd28a9637",
                                        "entry_id": "2ad8052f-43c1-3786-96eb-db987aca1e1c",
                                        "glosses": [
                                            "Substance qui permet d’extraire d’un mélange une espèce chimique, présente le plus souvent à l’état de traces, en assurant son transport au cours d’un processus physique ou chimique de séparation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
