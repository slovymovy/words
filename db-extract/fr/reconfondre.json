                ],
                "senses": [
                    {
                        "sense_id": "873f41b7-8c23-3ca1-a113-f7b76b03bba3",
                        "entry_id": "959b68a3-8b0f-3818-9843-baf5a613ade9",
                        "glosses": [
                            "Faire de nouveau la confusion entre deux choses."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a8eaf21-4e1d-4152-9e24-706befe1400a",
                                "sense_id": "873f41b7-8c23-3ca1-a113-f7b76b03bba3",
                                "text": "Il reconfondait sans cesse les prénoms des jumeaux, même après lui avoir expliqué mille fois leurs différences."
                            },
                            {
                                "example_id": "f23f6633-baec-47a0-9534-34270b9f6d4b",
                                "sense_id": "873f41b7-8c23-3ca1-a113-f7b76b03bba3",
                                "text": "Il est important de bien spécifier la terminologie employée si vous ne voulez pas reconfondre masse et poids, force et puissance ou vecteur et direction."
                            }
                        ]
                    },
                    {
                        "sense_id": "c6c1f14c-a72e-377f-a888-bdf10ca965f9",
                        "entry_id": "959b68a3-8b0f-3818-9843-baf5a613ade9",
                        "glosses": [
                            "Se mélanger une nouvelle fois."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "653716bc-8c4c-41e8-ada0-45472b26cd8f",
                                "sense_id": "c6c1f14c-a72e-377f-a888-bdf10ca965f9",
                                "text": "Puis, si les créanciers de la masse nᵒ 1, payés il reste quelque chose, ce quelque chose vient se reconfondre avec la masse nᵒ 2 pour être distribué entre tous les créanciers de cette masse nᵒ 2 ainsi augmentée du reliquat de la masse nᵒ 1."
                            }
                        ]
                    },
                    {
                        "sense_id": "c83e5f47-b3e1-3b87-97c0-5a6a4155b894",
                        "entry_id": "959b68a3-8b0f-3818-9843-baf5a613ade9",
                        "glosses": [
                            "Multiplier de manière excessive ses excuses."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "9a11e07f-d5a3-41de-be83-773af1179538",
                                "sense_id": "c83e5f47-b3e1-3b87-97c0-5a6a4155b894",
                                "text": "Bien que je lui aie pardonné depuis longtemps, il ne cessait de se reconfondre en excuses chaque fois qu’il me rencontrait."
                            }
                        ]
                    }
                ],
