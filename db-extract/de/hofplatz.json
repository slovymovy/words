                "senses": [
                    {
                        "sense_id": "58a90487-b129-306a-9e55-2c2c035e5dad",
                        "entry_id": "79b3ddd7-2a53-310a-9d9a-439342ecb151",
                        "glosses": [
                            "freie Fläche vor/zwischen den Gebäuden eines Hofes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b61f4feb-f635-47e3-a3ca-840a7c6debc3",
                                "sense_id": "58a90487-b129-306a-9e55-2c2c035e5dad",
                                "text": "„Im selben Augenblick ritt jemand über den Hofplatz, und man hörte eine barsche Stimme einem Pferdeknecht Befehle geben.“"
                            },
                            {
                                "example_id": "f915a707-c8b4-47db-81cc-f8779f254864",
                                "sense_id": "58a90487-b129-306a-9e55-2c2c035e5dad",
                                "text": "„Ich konnte den Geruch schon auf dem Hofplatz wahrnehmen, als ich mit offener Autotür einen Moment lang stehen blieb, unsicher, ob ich klingeln oder einfach reingehen sollte.“"
                            }
                        ],
