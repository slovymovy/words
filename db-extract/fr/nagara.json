                "senses": [
                    {
                        "sense_id": "0922f8da-a407-3adc-a7ef-0dff73fe6e30",
                        "entry_id": "fc979c0e-03d5-3d3f-8718-f516d79fa71e",
                        "glosses": [
                            "Instrument à percussion consistant en une paire de timbales fort sonores, très répandu en Inde et dans le monde arabe, et qui fut importé dans l'Europe médiévale par les Croisés, qui l'appelaient nacaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08e35308-847f-444f-ab0d-63a361056560",
                                "sense_id": "0922f8da-a407-3adc-a7ef-0dff73fe6e30",
                                "text": "Sultan Mansour-Chah vint pour le faire enterrer, et lui accorda les honneurs du parasol, du (tambour appelé) gandang, de la flûte (sarouney), de la trompette (nafiri) et des timbales (nagara)."
                            }
                        ]
                    }
