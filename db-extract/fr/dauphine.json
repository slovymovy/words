            {
                "entry_id": "422fed03-6931-331d-b648-f208b60d112c",
                "word": "Dauphine",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5ed41617-d00b-3f73-934c-1c3f0f1ecc04",
                        "entry_id": "422fed03-6931-331d-b648-f208b60d112c",
                        "glosses": [
                            "Nom donné par la marque automobile Renault à un modèle de berline à moteur arrière, produit en France de 1956 à 1967."
                        ],
                        "tags": [
                            "Marque commerciale"
                        ],
                        "examples": [
                            {
                                "example_id": "38572f38-e286-495b-b5e9-57303b6bb811",
                                "sense_id": "5ed41617-d00b-3f73-934c-1c3f0f1ecc04",
                                "text": "Retour aux années soixante. Depuis 1956, les Dauphine, vendues 25 % moins cher que les Américaines les moins coûteuses, « font un malheur » aux États-Unis."
                            },
                            {
                                "example_id": "92b51577-ab10-4d79-86f3-4a4d4f5824a2",
                                "sense_id": "5ed41617-d00b-3f73-934c-1c3f0f1ecc04",
                                "text": "Renault a d’ailleurs confié à Henry Brownback, dès la fin 1955, un des premiers exemplaires de présérie de la Dauphine pour le tester dans le Maine."
                            },
                            {
                                "example_id": "253a6a01-b450-4c24-8627-c70a0620cfc2",
                                "sense_id": "5ed41617-d00b-3f73-934c-1c3f0f1ecc04",
                                "text": "En 1957, Renault décide de profiter de la récession qui sévit outre-Atlantique pour y introduire son nouveau modèle peu gourmand en énergie : la Dauphine."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
