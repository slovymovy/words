                "senses": [
                    {
                        "sense_id": "92a4091a-eaaa-3cf0-bfff-38c39911afe5",
                        "entry_id": "5ca9f729-0f25-319e-b08c-e78b0282a31f",
                        "glosses": [
                            "ein Schlag auf eine Pauke"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a0be3d9-354f-457f-a781-b1ed19346f90",
                                "sense_id": "92a4091a-eaaa-3cf0-bfff-38c39911afe5",
                                "text": "Das Werk endet mit einem sehr lauten Paukenschlag."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "50916394-1150-33f5-9275-26f9870cb61c",
                        "entry_id": "5ca9f729-0f25-319e-b08c-e78b0282a31f",
                        "glosses": [
                            "ein Aufsehen erregender Vorfall"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6475c6d5-475e-44f8-a90e-8e7be5652d84",
                                "sense_id": "50916394-1150-33f5-9275-26f9870cb61c",
                                "text": "„Seit Jahren dringt er auf die Absetzung der Geschäftsführung. Jetzt hat ihm das Landgericht Berlin recht gegeben. Es ist ein Paukenschlag, der alle erzittern lässt, denen das Schicksal des Suhrkamp Verlags am Herzen liegt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "809f45b6-16a9-45ee-afd6-b4ab47e8dd54",
                        "source_entry_id": "5ca9f729-0f25-319e-b08c-e78b0282a31f",
                        "source_sense_id": "92a4091a-eaaa-3cf0-bfff-38c39911afe5",
                        "source_sense_description": "ein Schlag auf eine Pauke",
                        "target_lang_word": "drumbeat",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "drumbeat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "93300ed9-0e6f-3bf6-82d5-17bbc08c80d4",
                                        "entry_id": "6013a0c8-898c-3036-ae12-e7f77bc0096b",
                                        "glosses": [
                                            "The beating of a drum."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "871c77cb-2820-3bb9-a868-9882a5c0b610",
                                        "entry_id": "6013a0c8-898c-3036-ae12-e7f77bc0096b",
                                        "glosses": [
                                            "The sound of a beating drum."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "389c1927-240a-4fb8-8d10-e6e0914453bb",
                                                "sense_id": "871c77cb-2820-3bb9-a868-9882a5c0b610",
                                                "text": "This is not the drumbeat of a single drummer leading a charge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c690650c-452d-370f-be8c-78ed69fdf267",
                                        "entry_id": "6013a0c8-898c-3036-ae12-e7f77bc0096b",
                                        "glosses": [
                                            "A repetitive beating sound."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eefad6e7-00ad-41fa-88e2-4db648769462",
                                                "sense_id": "c690650c-452d-370f-be8c-78ed69fdf267",
                                                "text": "This music has a groovy drumbeat that makes me dance!"
                                            },
                                            {
                                                "example_id": "b4ccb898-309a-4342-bfbd-27c1589e6135",
                                                "sense_id": "c690650c-452d-370f-be8c-78ed69fdf267",
                                                "text": "The drumbeat of roadside bombs and suicide attacks continued all over the 2d Brigade, 10th Mountain Division's area of operations."
                                            },
                                            {
                                                "example_id": "d88c3cb0-8aa0-4340-96a3-98151e106dbc",
                                                "sense_id": "c690650c-452d-370f-be8c-78ed69fdf267",
                                                "text": "Rycant stood close enough to catch his words despite the drumbeat of rain on the thick leaves above their heads, but only Rectoria picked up the note of relief."
                                            },
                                            {
                                                "example_id": "b8259d58-4be4-49d7-bc7f-ec69bece2c9c",
                                                "sense_id": "c690650c-452d-370f-be8c-78ed69fdf267",
                                                "text": "What does the drumbeat of your heart say?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5e01492-38a2-36f8-8db7-e0690f1d7375",
                                        "entry_id": "6013a0c8-898c-3036-ae12-e7f77bc0096b",
                                        "glosses": [
                                            "A driving force."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c0b64f2-14fa-4a8c-b94a-80adbd7a96bd",
                                                "sense_id": "b5e01492-38a2-36f8-8db7-e0690f1d7375",
                                                "text": "Nevertheless, greatness rarely receives public approval, because most people spend their lives goose-stepping to the drumbeat of economic necessity."
                                            },
                                            {
                                                "example_id": "3a61bbee-32b0-44a7-9a34-28efc4b99233",
                                                "sense_id": "b5e01492-38a2-36f8-8db7-e0690f1d7375",
                                                "text": "On a more scholarly level the drumbeat of need was signalled too: as when the newly appointed headmaster of the Merchant Taylors' School, Richard Mulcaster, declared: 'it would be a thing verie praiseworthy ... if som one learned and as laborious a man wold gather all the wordes which we vse in our English tung ... into one dictionarie.'"
                                            },
                                            {
                                                "example_id": "075eea59-b279-40f1-a562-0ceebecb26bc",
                                                "sense_id": "b5e01492-38a2-36f8-8db7-e0690f1d7375",
                                                "text": "We can hear the drumbeat of history, right in our own time."
                                            },
                                            {
                                                "example_id": "6b071ee9-7436-4a76-906b-8d26c2cf9cc1",
                                                "sense_id": "b5e01492-38a2-36f8-8db7-e0690f1d7375",
                                                "text": "While the partisan wrangling annoyed Clinton, it was the drumbeat of attacks on his character and the constant investigations of his administration that bothered him most of all."
                                            },
                                            {
                                                "example_id": "523a875a-ce0e-404b-82fe-760a5f845dea",
                                                "sense_id": "b5e01492-38a2-36f8-8db7-e0690f1d7375",
                                                "text": "It takes courage to be against the drumbeat of war and especially to become a “shield” against violence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "862556fa-39f2-4e88-b3d0-67b3a6d618aa",
                        "source_entry_id": "5ca9f729-0f25-319e-b08c-e78b0282a31f",
