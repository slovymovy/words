                                        "entry_id": "70311264-27e8-3013-8385-479e01bc8f2f",
                                        "glosses": [
                                            "Se procurer, par la contrainte, le service de personnes."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97d568c9-96b7-4ff2-94c2-f9bdfb1a8abb",
                                                "sense_id": "3277e445-4ab7-3083-8979-d7443bc0bedd",
                                                "text": "Tous les citoyens valides furent réquisitionnés pour aider au transport des matériaux."
                                            }
                                        ]
                                    }
