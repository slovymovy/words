        "fr-extract.jsonl": [
            {
                "entry_id": "5dec6791-6793-3226-a828-1beb1501f167",
                "word": "goujaterie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "04162f07-179d-450a-a76c-8aa3785016f3",
                        "entry_id": "5dec6791-6793-3226-a828-1beb1501f167",
                        "tags": [
                            "plural"
                        ],
                        "form": "goujateries"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8ffff047-d1f9-34c1-a7ce-14b3395e88df",
                        "entry_id": "5dec6791-6793-3226-a828-1beb1501f167",
                        "glosses": [
                            "Acte bas et grossier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc4626aa-65e9-475a-bfcb-98f4875fbbf0",
                                "sense_id": "8ffff047-d1f9-34c1-a7ce-14b3395e88df",
                                "text": "Jamais un Français n’aurait eu la goujaterie de profiter comme vous d’une circonstance aussi imprévue."
                            },
                            {
                                "example_id": "42978908-3559-46f7-a7d6-b1d245c62350",
                                "sense_id": "8ffff047-d1f9-34c1-a7ce-14b3395e88df",
                                "text": "Bref, j’ai entendu Rivaud dire au procureur qu’il considérait ta démarche comme une goujaterie et que, en arrivant ici, il avait une forte envie de t’apprendre à vivre…"
                            },
                            {
                                "example_id": "adb5dd4b-4cc9-48fc-bfbc-daba4de2e8c7",
                                "sense_id": "8ffff047-d1f9-34c1-a7ce-14b3395e88df",
                                "text": "— Vraiment, Kristina... Ce que je t'ai fait est impardonnable.\nIl se remémora les événements de ces dernières vingt-quatre heures et frémit de sa goujaterie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bb85460c-3f9d-4979-a5fd-3af446fa96f1",
                        "source_entry_id": "5dec6791-6793-3226-a828-1beb1501f167",
                        "source_sense_id": "8ffff047-d1f9-34c1-a7ce-14b3395e88df",
                        "target_lang_word": "Flegelhaftigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Flegelhaftigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1ba2162b-2797-3c16-8726-647e16e7bbd0",
                                        "entry_id": "e56ef83b-9527-30ef-87a8-4e78dce5df9e",
                                        "glosses": [
                                            "das flegelhafte Verhalten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7220b170-136c-43fb-ae03-0d5b40de28ce",
                                                "sense_id": "1ba2162b-2797-3c16-8726-647e16e7bbd0",
                                                "text": "Diese Flegelhaftigkeiten lasse ich mir nicht länger bieten!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b45111f-1a42-4b80-8f01-d6daab180cce",
                        "source_entry_id": "5dec6791-6793-3226-a828-1beb1501f167",
                        "source_sense_id": "8ffff047-d1f9-34c1-a7ce-14b3395e88df",
                        "target_lang_word": "boorishness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boorishness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fcad72b1-741d-342c-af9d-649d43f944c9",
                                        "entry_id": "69a609b3-127e-3283-8ac2-aabc8a44da66",
                                        "glosses": [
                                            "The state or characteristic of being a boor or of being boorish; boorish behaviour."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a72ce42d-4d7a-4ddc-8f05-4fc1f4643490",
                                                "sense_id": "fcad72b1-741d-342c-af9d-649d43f944c9",
                                                "text": "No refinement in him would now have surprised her; but neither would any outbreak of boorishness."
                                            },
                                            {
                                                "example_id": "c2eacf1f-c563-4742-a1e7-79a6905881d5",
                                                "sense_id": "fcad72b1-741d-342c-af9d-649d43f944c9",
                                                "text": "From the first the Russian had exhibited every trait of his true character—selfishness, boorishness, arrogance, cowardice, and lust."
                                            },
                                            {
                                                "example_id": "aa1b5681-db03-42e1-bbcf-cf2c4845a261",
                                                "sense_id": "fcad72b1-741d-342c-af9d-649d43f944c9",
                                                "text": "Unfortunately, there were moments of pure indulgence, drunken boorishness and rambling unintelligible poetry midway through the evening."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ff148c07-b188-4794-8bae-fac6125e0ec2",
