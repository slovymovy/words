                ],
                "senses": [
                    {
                        "sense_id": "d6bc1e6c-a639-3b0a-b8ef-4cfd8b91697f",
                        "entry_id": "0a851453-1cb0-3e37-bcde-f7f5a1248fc0",
                        "glosses": [
                            "Faire se décompresser tout seul."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d885092-7206-4595-b5c5-dbd04138bb53",
                                "sense_id": "d6bc1e6c-a639-3b0a-b8ef-4cfd8b91697f",
                                "text": "En double cliquant dessus tu vas auto-décompresser l'archive dans le dossier portant le même nom, à savoir « 177.92_vista »."
                            }
                        ]
                    },
                    {
                        "sense_id": "df43218b-88c9-3d40-88ed-bc66ba71d7d1",
                        "entry_id": "0a851453-1cb0-3e37-bcde-f7f5a1248fc0",
                        "glosses": [
                            "Se décompresser tout seul."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "5adaf844-775a-4e8b-b20f-6a49f03f4181",
                                "sense_id": "df43218b-88c9-3d40-88ed-bc66ba71d7d1",
                                "text": "L'archive va ensuite s'auto-décompresser."
                            },
                            {
                                "example_id": "a65a3231-008f-4ea5-bc08-d0ff05b8cffe",
                                "sense_id": "df43218b-88c9-3d40-88ed-bc66ba71d7d1",
                                "text": "Si j'ai bien compris, François te propose une méthode pour créer un fichier capable de s'auto-décompresser quand on l'exécute."
                            },
                            {
                                "example_id": "671845aa-c576-4d4e-8376-5ac8251a480c",
                                "sense_id": "df43218b-88c9-3d40-88ed-bc66ba71d7d1",
                                "text": "Il va lancer l'assistant d'installation dont la première tache va consister à s'auto-décompresser dans un répertoire."
                            }
                        ]
                    }
