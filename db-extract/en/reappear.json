                        ],
                        "form": "reappeared"
                    },
                    {
                        "form_id": "b41d8dca-a4cf-4352-be67-665709e4d62c",
                        "entry_id": "4cc0c80c-a26a-3f2c-8010-33c5bf7ef0f8",
                        "tags": [
                            "past"
                        ],
                        "form": "reappeared"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "08233c5f-ba85-342c-bf81-b7da3830c18a",
                        "entry_id": "4cc0c80c-a26a-3f2c-8010-33c5bf7ef0f8",
                        "glosses": [
                            "To appear again."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a389203-c0b6-4ee7-a2f9-68a220e6c97c",
                                "sense_id": "08233c5f-ba85-342c-bf81-b7da3830c18a",
                                "text": "After the slumber of the year / The woodland violets re-appear, / All things revive in field or grove, […]"
                            },
                            {
                                "example_id": "9a68bf26-f502-48c1-8889-fc534eea8211",
                                "sense_id": "08233c5f-ba85-342c-bf81-b7da3830c18a",
                                "text": "Day after day it reappears / Night after night my heartbeat shows the fear / Ghosts appear and fade away"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9093cf90-ac2d-4e4d-8999-53d0db8afb2c",
                        "source_entry_id": "4cc0c80c-a26a-3f2c-8010-33c5bf7ef0f8",
                        "source_sense_id": "08233c5f-ba85-342c-bf81-b7da3830c18a",
                        "source_sense_description": "to appear again",
                        "target_lang_word": "reparaître",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reparaître",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "77342de9-ba26-3247-adb5-4dcaa9c9e24c",
                                        "entry_id": "7daaaee5-840e-3095-aa2e-ee52d34ae0d5",
                                        "glosses": [
                                            "Paraître de nouveau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4af93b6e-e4d6-4e27-92b1-7d53eb99a6fc",
                                                "sense_id": "77342de9-ba26-3247-adb5-4dcaa9c9e24c",
                                                "text": "Le juge expliqua sans répondre au prévenu que, s’il avait subi la flétrissure infligée alors par les lois aux condamnés aux travaux forcés, en lui frappant l’épaule les lettres reparaîtraient aussitôt."
                                            },
                                            {
                                                "example_id": "94d2288c-2450-4324-b79f-2027711dd81b",
                                                "sense_id": "77342de9-ba26-3247-adb5-4dcaa9c9e24c",
                                                "text": "C'était le ministère du 24 mai 1873 qui reparaissait."
                                            },
                                            {
                                                "example_id": "4a241531-5ae7-4b38-b862-60314a1dab6d",
                                                "sense_id": "77342de9-ba26-3247-adb5-4dcaa9c9e24c",
                                                "text": "Cette apnée peut durer de quelques secondes à une, deux minutes et plus. On peut croire que l'enfant est expiré, puis une inspiration reparaît suivie d'autres de plus en plus rapprochées, et les alternatives d’apnée et de respiration fréquente se répètent à plusieurs reprises jusqu'à la mort."
                                            },
                                            {
                                                "example_id": "c9a5e017-964b-49eb-9caa-7ad59d7a5726",
                                                "sense_id": "77342de9-ba26-3247-adb5-4dcaa9c9e24c",
                                                "text": "Cette zone forestière correspond à la région humide des nuages qui ceignent les flancs du pic pendant la majeure partie de l’année et qui se dissipent généralement le soir pour reparaître peu après le lever du soleil."
                                            },
                                            {
                                                "example_id": "3f6cee2d-ffb8-4580-8345-3a3f391fcc1b",
                                                "sense_id": "77342de9-ba26-3247-adb5-4dcaa9c9e24c",
                                                "text": "Son absence durait un an, deux ans. Et puis, un beau soir, sans que personne de son entourage fût prévenu, il reparaissait soudainement."
                                            },
                                            {
                                                "example_id": "1f8c2b07-8aca-4b30-966a-351d684c7f10",
                                                "sense_id": "77342de9-ba26-3247-adb5-4dcaa9c9e24c",
                                                "text": "La soucoupe n'a pas encore reparu, chers auditeurs..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d503fe54-2027-46c2-9453-febb50bff870",
                        "source_entry_id": "4cc0c80c-a26a-3f2c-8010-33c5bf7ef0f8",
                        "source_sense_id": "08233c5f-ba85-342c-bf81-b7da3830c18a",
                        "source_sense_description": "to appear again",
                        "target_lang_word": "réapparaître",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "réapparaître",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "38bcd542-b844-3ca4-b3cc-9218d08defb8",
                                        "entry_id": "78ee8f84-3ba3-396f-9632-74a978d13ce2",
                                        "glosses": [
                                            "Apparaître à nouveau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "527b5ba6-f90e-42cf-a831-d7319fd37b25",
                                                "sense_id": "38bcd542-b844-3ca4-b3cc-9218d08defb8",
                                                "text": "Lorsque la terre réapparut, ce fut à l’entrée du détroit de Magellan."
                                            },
                                            {
                                                "example_id": "157eddc7-4100-42ae-afdd-2cac770f23c2",
                                                "sense_id": "38bcd542-b844-3ca4-b3cc-9218d08defb8",
                                                "text": "Enfin tout le monde sanglote, se mouche et pleure en songeant à l’affreux trépas de ce malheureux Olivier, réapparaissant hier au soleil de la gloire pour retomber, cette nuit, à l’obscurité du trépas !"
                                            },
                                            {
                                                "example_id": "02e60576-2213-4a45-8959-a422e6566c62",
                                                "sense_id": "38bcd542-b844-3ca4-b3cc-9218d08defb8",
                                                "text": "Il va falloir qu’on s’occupe sérieusement de M. le maire. Quand il aura réapparu."
                                            },
                                            {
                                                "example_id": "de1f885d-9274-4282-8f2f-9dcec22da9d9",
                                                "sense_id": "38bcd542-b844-3ca4-b3cc-9218d08defb8",
                                                "text": "Le samedi, les Fourqueusiens paressent jusqu'en milieu d'après-midi. Ils ne réapparaîtront pas avant 16 h 30. Camille sera déjà rentrée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "98b5b71c-e60f-40bb-a52e-8c61a648de4b",
