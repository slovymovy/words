                ],
                "senses": [
                    {
                        "sense_id": "d0bbdc6f-1cd4-351b-b68d-33e7cce8cffd",
                        "entry_id": "215cae1d-3830-3453-b409-3f3b14495970",
                        "glosses": [
                            "Zustand mit geringerem geistigen Potential, das durch einen niedrigen Intelligenzquotienten/IQ beschrieben wird; leichtere geistige Fehlfunktion/Behinderung/Intelligenzminderung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db9ce5eb-d9cd-4995-999d-6c7e3981d8c3",
                                "sense_id": "d0bbdc6f-1cd4-351b-b68d-33e7cce8cffd",
                                "text": "Unter einem IQ von 19 spricht man von Idiotie, 20–49 wird Imbezillität genannt, ein IQ zwischen 50 und 70 nennt sich Debilität, bei 70–85 spricht man von einer Lernschwäche, die den Besuch besonderer pädagogischer Einrichtungen erfordert."
                            },
                            {
                                "example_id": "811ab522-317f-40a8-b958-c0c66815c90a",
                                "sense_id": "d0bbdc6f-1cd4-351b-b68d-33e7cce8cffd",
                                "text": "Die Debilität ist die leichtere geistige Behinderung, von ihr sind rund 2 % der Bevölkerung betroffen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e6321b8c-8db3-4aad-8b2d-675062ec5c95",
                        "source_entry_id": "215cae1d-3830-3453-b409-3f3b14495970",
                        "source_sense_id": "d0bbdc6f-1cd4-351b-b68d-33e7cce8cffd",
                        "source_sense_description": "Zustand mit geringerem geistigen Potential",
                        "target_lang_word": "débilité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "débilité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9fbeb2e0-7103-3adc-8356-caacf9a3767c",
                                        "entry_id": "b59df493-39e9-31c3-b67b-7c00e6e8878b",
                                        "glosses": [
                                            "État de celui, de ce qui est débile, faible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83354e0c-28a3-4065-a020-972c0553ed1e",
                                                "sense_id": "9fbeb2e0-7103-3adc-8356-caacf9a3767c",
                                                "text": "Une grande débilité de nerfs, de jambes, d’estomac…"
                                            },
                                            {
                                                "example_id": "cfc8d4fa-de5d-4a5f-bc38-1dbe73c8c71d",
                                                "sense_id": "9fbeb2e0-7103-3adc-8356-caacf9a3767c",
                                                "text": "Ce sont ces pauvres femmes que je plains, obligées, malgré la débilité de leur sexe, à supporter des fatigues et des privations comme routiers en campagne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "313fc5fc-25ac-3934-890e-264c317b5bde",
                                        "entry_id": "b59df493-39e9-31c3-b67b-7c00e6e8878b",
                                        "glosses": [
                                            "Misère physiologique qui se mesure par différents tests faisant appel aux différentes facultés intellectuelles dont le test du quotient intellectuel, le Q I."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4891298a-496c-4b6d-9443-84c41c42d8a8",
                                                "sense_id": "313fc5fc-25ac-3934-890e-264c317b5bde",
                                                "text": "Être atteint de débilité mentale."
                                            },
                                            {
                                                "example_id": "c39c75d9-0e5c-4c6d-a7e4-be7d23275fed",
                                                "sense_id": "313fc5fc-25ac-3934-890e-264c317b5bde",
                                                "text": "On pourrait dire, par exemple,que ce sont là des cas de paranoïa aiguë à délire asystématique, en raison d’une débilité mentale native, profonde et, pour la même raison, aboutissant exceptionnellement à une démence rapide."
                                            },
                                            {
                                                "example_id": "68f450da-f914-454e-9761-7cf395dc5006",
                                                "sense_id": "313fc5fc-25ac-3934-890e-264c317b5bde",
                                                "text": "Présenter une débilité congénitale."
                                            }
                                        ]
                                    }
                                ]
                            },
