    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "52efbe42-340b-3b10-856f-bc0e9b01c5ea",
                "word": "acarology",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "84db7dbb-d206-3885-9cb9-838b3bfa3b5e",
                        "entry_id": "52efbe42-340b-3b10-856f-bc0e9b01c5ea",
                        "glosses": [
                            "The study of ticks and mites."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "29cbee6d-b4c8-4abf-a3bd-3d503d5f1b49",
                                "sense_id": "84db7dbb-d206-3885-9cb9-838b3bfa3b5e",
                                "text": "1999, Rodger David Mitchell (editor), Acarology IX, Volume 2: Symposia, Ohio Biological Survey, page xvii,\nThe students and faculty of the acarology course were Don's life, and his example pushed us all to higher levels of achievement."
                            },
                            {
                                "example_id": "4b5514bb-0879-4fe3-868d-d56b94bf9968",
                                "sense_id": "84db7dbb-d206-3885-9cb9-838b3bfa3b5e",
                                "text": "General texts on acarology include works by Woolley (1987), Evans (1992), and Krantz and Walter (2009)."
                            },
                            {
                                "example_id": "b8ad7370-5bce-490b-82c8-bd7b6076a6e6",
                                "sense_id": "84db7dbb-d206-3885-9cb9-838b3bfa3b5e",
                                "text": "Acarology is the study of mites, or Acari or Acarina. It is a specialized field of study in the larger topics of invertebrate zoology and entomology. Because some mites are economically important pests of agriculture (crops, honey bees, stored food products, and livestock), are household pests, or are vectors of diseases of humans and livestock, acarology is often studied in entomology departments."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cd16c978-9ab6-40a7-9cca-570f7d7bcf4e",
                        "source_entry_id": "52efbe42-340b-3b10-856f-bc0e9b01c5ea",
                        "source_sense_id": "84db7dbb-d206-3885-9cb9-838b3bfa3b5e",
                        "source_sense_description": "the study of ticks and mites",
                        "target_lang_word": "acarologie",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
