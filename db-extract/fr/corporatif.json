                ],
                "senses": [
                    {
                        "sense_id": "b0abc8e1-969a-3e4d-acff-143880e4c723",
                        "entry_id": "9e231f4c-be62-30ac-b350-d8a1e9dfff03",
                        "glosses": [
                            "Qui a rapport au groupement par corporations."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4dcb9d0d-ab8e-411b-9e59-9b1fdd545ef4",
                                "sense_id": "b0abc8e1-969a-3e4d-acff-143880e4c723",
                                "text": "On comprend que beaucoup de personnes aient pensé que cet esprit corporatif n'est pas une meilleure chose que l'esprit de clocher et qu'elles aient cherché à le faire disparaître, en employant des procédés fort analogues à ceux qui ont tant atténué, en France, les jalousies qui existaient entre les provinces."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8836508e-ee12-4269-b988-c8665ef1d137",
                        "source_entry_id": "9e231f4c-be62-30ac-b350-d8a1e9dfff03",
                        "source_sense_id": "b0abc8e1-969a-3e4d-acff-143880e4c723",
                        "target_lang_word": "corporate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "corporate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1c965e5f-741a-3aab-a6b9-7169222133cb",
                                        "entry_id": "e5697bbe-3fc7-3afc-bd5a-48630caa9749",
                                        "glosses": [
                                            "Of or relating to a corporation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "499d6222-0b43-4ca1-88f5-2f32a389145c",
                                                "sense_id": "1c965e5f-741a-3aab-a6b9-7169222133cb",
                                                "text": "The one on Seventh Street is a corporate franchise."
                                            },
                                            {
                                                "example_id": "92ea5051-e97e-432c-9bca-60407db7cec9",
                                                "sense_id": "1c965e5f-741a-3aab-a6b9-7169222133cb",
                                                "text": "But electric vehicles and the batteries that made them run became ensnared in corporate scandals, fraud, and monopolistic corruption that shook the confidence of the nation and inspired automotive upstarts."
                                            },
                                            {
                                                "example_id": "9370a080-024c-490f-b4b6-7a0dc41e7073",
                                                "sense_id": "1c965e5f-741a-3aab-a6b9-7169222133cb",
                                                "text": "Where we once sent love letters in a sealed envelope, or stuck photographs of our children in a family album, now such private material is despatched to servers and clouds operated by people we don't know and will never meet. Perhaps we assume that our name, address and search preferences will be viewed by some unseen pair of corporate eyes, probably not human, and don't mind that much."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "663f1e47-97f5-36f2-9121-9e87cf8149e2",
                                        "entry_id": "e5697bbe-3fc7-3afc-bd5a-48630caa9749",
                                        "glosses": [
                                            "Formed into a corporation; incorporated."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "13b43bb4-bd9e-35eb-a861-ac289017dd35",
                                        "entry_id": "e5697bbe-3fc7-3afc-bd5a-48630caa9749",
                                        "glosses": [
                                            "Unified into one body; collective."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "521b9212-da75-4547-b787-373c7bdd42eb",
                                                "sense_id": "13b43bb4-bd9e-35eb-a861-ac289017dd35",
                                                "text": "the corporate authorship of the working group"
                                            },
                                            {
                                                "example_id": "67e907d9-1e76-416e-ae79-cce62a312432",
                                                "sense_id": "13b43bb4-bd9e-35eb-a861-ac289017dd35",
                                                "text": "They answer in a joint and corporate voice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1cbd56b3-9843-3363-95c9-754c764c99d1",
                                        "entry_id": "e5697bbe-3fc7-3afc-bd5a-48630caa9749",
                                        "glosses": [
                                            "Soulless and inoffensive; sanitized and sterile, like a design from a large corporation."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5ec3ae9-8563-48be-b047-6806831eb7ac",
                                                "sense_id": "1cbd56b3-9843-3363-95c9-754c764c99d1",
                                                "text": "It's not that their interior decorating is horrible; it's just that, well, it's so corporate."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "corporate",
