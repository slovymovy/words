                },
                {
                    "sense_id": "64108dfa-f164-3abd-aa99-01de23be6426",
                    "sense_definition": "een beklagenswaardig, ellendig of kwetsbaar persoon",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "persoon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het arme <w>schepsel</w> dwaalde urenlang alleen door de koude straten van de stad.",
                            "target_lang_translations": {
                                "en": "The poor <w>creature</w> wandered alone through the cold city streets for hours."
                            }
                        },
                        {
                            "text": "Zij is een deerniswekkend <w>schepsel</w> dat altijd pech lijkt te hebben in het leven.",
                            "target_lang_translations": {
                                "en": "She is a pitiful <w>soul</w> who always seems to have bad luck in life."
                            }
                        }
                    ],
                    "synonyms": [
