                "senses": [
                    {
                        "sense_id": "0990fdcb-44fd-3afd-ad28-f3a897021b97",
                        "entry_id": "a3da3ed3-0d74-3028-810f-195610014f74",
                        "glosses": [
                            "vrouw die een ander persoon helpt bij kwade praktijken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "891f7586-565e-49fd-9387-82f50df7195a",
                                "sense_id": "0990fdcb-44fd-3afd-ad28-f3a897021b97",
                                "text": "Maar de spottende blikken van de man beantwoordde ze met de sluwe knipoog van een handlangster."
                            },
                            {
                                "example_id": "c2dca036-6a99-4aa7-9697-95e33e0c3e33",
                                "sense_id": "0990fdcb-44fd-3afd-ad28-f3a897021b97",
                                "text": "Vorig jaar kwam de ex-vrouw en handlangster van Dutroux, Michelle Martin, vrij onder voorwaarden. Haar vrijlating leidde tot flinke onrust. Zij verblijft in een klooster vlakbij Namen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "314eda25-103c-4d44-aee4-5f63ba7b2bf8",
                        "source_entry_id": "a3da3ed3-0d74-3028-810f-195610014f74",
                        "source_sense_id": "0990fdcb-44fd-3afd-ad28-f3a897021b97",
                        "source_sense_description": "vrouw die een ander persoon helpt bij kwade praktijken",
                        "target_lang_word": "accomplice",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "accomplice",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "562051d1-a745-3922-8904-5094cd184423",
                                        "entry_id": "c7c6dbae-f42b-39a4-9e4c-caaa98f1ecbe",
                                        "glosses": [
                                            "An associate in the commission of a crime; a participator in an offense, whether a principal or an accessory."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79c438bf-2d62-470c-a350-c4df338e0784",
                                                "sense_id": "562051d1-a745-3922-8904-5094cd184423",
                                                "text": "Childleſs Arturius, vaſtly rich before, / Thus by his Loſſes multiplies his Store: / Suſpected for Accomplice to the Fire, / That burnt his Palace but to build it higher."
                                            },
                                            {
                                                "example_id": "a45118bd-7993-45a9-831f-bdcaffe91a15",
                                                "sense_id": "562051d1-a745-3922-8904-5094cd184423",
                                                "text": "And thou, the curs’d Accomplice of her Treaſon, / Declare thy Meſſage, and expect thy Doom."
                                            },
                                            {
                                                "example_id": "c2a1448a-71f8-4cd5-b2eb-6cc01f7ff092",
                                                "sense_id": "562051d1-a745-3922-8904-5094cd184423",
                                                "text": "“You have a young son, yet you involve yourself in the world of organised crime. Robbing a bank no less! Stealing half a million pounds! Money, I might add, that has never been recovered. You must know where the money is hidden, and yet, Mr Goodie, you refuse to inform the police. You must have had accomplices, but you will not name them. This no doubt is the criminals’ code of honour.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95444974-883d-36a9-8891-b0d490e385b1",
                                        "entry_id": "c7c6dbae-f42b-39a4-9e4c-caaa98f1ecbe",
                                        "glosses": [
                                            "A cooperator."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f14709a-fc8e-44e6-953a-1cecb860f922",
                                                "sense_id": "95444974-883d-36a9-8891-b0d490e385b1",
                                                "text": "Succeſſe vnto our valiant Generall, / And happineſſe to his accomplices."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e3618e7a-c1cf-4381-99ff-e0a93f36024e",
                        "source_entry_id": "a3da3ed3-0d74-3028-810f-195610014f74",
                        "source_sense_id": "0990fdcb-44fd-3afd-ad28-f3a897021b97",
                        "source_sense_description": "vrouw die een ander persoon helpt bij kwade praktijken",
                        "target_lang_word": "confederate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "confederate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f5b674e1-f917-3b48-b1aa-ca13a86697fb",
                                        "entry_id": "cb2da03e-7a20-3021-8b6e-1fc788156eaa",
                                        "glosses": [
                                            "Of, relating to, or united in a confederacy"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "61dbd92b-9337-31aa-9f6e-819ab62e730b",
                                        "entry_id": "cb2da03e-7a20-3021-8b6e-1fc788156eaa",
                                        "glosses": [
                                            "Banded together; allied."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "085a7ee2-1888-41e0-bad1-31909c15cba9",
                                                "sense_id": "61dbd92b-9337-31aa-9f6e-819ab62e730b",
                                                "text": "All the swords / In Italy, and her confederate arms, / Could not have made this peace."
                                            },
                                            {
                                                "example_id": "e3a02ba4-1e6a-498b-aee2-bf3777b83c57",
                                                "sense_id": "61dbd92b-9337-31aa-9f6e-819ab62e730b",
                                                "text": "Hour after hour, remote from the world's throng,\nWork, contest, fame, all life's confederate pleas"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69a04176-90b6-3c28-a2fc-c429c0e9aa16",
                                        "entry_id": "cb2da03e-7a20-3021-8b6e-1fc788156eaa",
                                        "glosses": [
                                            "Confederated."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f428ea84-084f-46cc-ae51-175643d5fcfd",
                                                "sense_id": "69a04176-90b6-3c28-a2fc-c429c0e9aa16",
                                                "text": "Remember as thou read'ſt, thy promiſe paſt :\nI do repent me, reade not my name there,\nMy heart is not confederate with my hand."
                                            },
                                            {
                                                "example_id": "fbff2f07-b3d7-486d-95a6-aa0abffe4c63",
                                                "sense_id": "69a04176-90b6-3c28-a2fc-c429c0e9aa16",
                                                "text": "And it was told the house of Dauid, saying, Syria is confederate with Ephraim: and his heart was moued, and the heart of his people as the trees of the wood are mooued with the wind."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "confederate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3d716996-254d-3fac-8cca-ac36c8e502c1",
                                        "entry_id": "d61b6623-0249-340e-831e-411b20a14c13",
                                        "glosses": [
                                            "A member of a confederacy."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "961449d5-e893-3a0b-9a10-4448e3cacf25",
                                        "entry_id": "d61b6623-0249-340e-831e-411b20a14c13",
                                        "glosses": [
                                            "An accomplice in a plot."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b84d217-3398-46ec-8bb1-2b1d9cbc001a",
                                                "sense_id": "961449d5-e893-3a0b-9a10-4448e3cacf25",
                                                "text": "By'th'vvay, vve met my vvife, her ſiſter, and a rabble more\nOf vilde confederates : […]"
                                            },
                                            {
                                                "example_id": "914b3d0d-11ab-482a-9fa4-8d5db43339e3",
                                                "sense_id": "961449d5-e893-3a0b-9a10-4448e3cacf25",
                                                "text": "He found some of his confederates in gaol."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3cf0ae4-2c4f-37aa-97c6-1737914a016a",
                                        "entry_id": "d61b6623-0249-340e-831e-411b20a14c13",
                                        "glosses": [
                                            "An accomplice in a plot.",
                                            "An actor who participates in a psychological experiment pretending to be a subject but in actuality working for the researcher."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32550133-dcc2-4eab-ae5c-15862fd1263a",
                                                "sense_id": "d3cf0ae4-2c4f-37aa-97c6-1737914a016a",
                                                "text": "So how do you win the imitation game? “Just be yourself,” a past confederate advises Christian. But what does it mean to “be yourself”?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "confederate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1375a2bc-9fd7-3ee9-91c7-da07f856d8a4",
                                        "entry_id": "d418d229-bc77-3afc-9857-003db298e739",
                                        "glosses": [
                                            "To unite persons or states in a league, confederacy or conspiracy; to ally, league."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e60ea74-c68f-4cd9-917e-47b6d039c264",
                                                "sense_id": "1375a2bc-9fd7-3ee9-91c7-da07f856d8a4",
                                                "text": "All persons who conspire confederate and agree to murder any person whether a subject of Her Majesty or not and whether within the Queen's dominions or not, […] shall be guilty of a misdemeanour, and shall be liable to imprisonment for a term of not more than ten years."
                                            }
                                        ]
                                    }
