                        "target_lang_word": "Zucchini",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zucchini",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d894fee3-6805-3b8f-9495-91e39e284abf",
                                        "entry_id": "e2fbe441-ab0e-3659-b7fb-f8a1db4a25ea",
                                        "glosses": [
                                            "zu den Gartenkürbissen gehörende Pflanze mit länglichen oder rundlichen Früchten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f05344e-7845-4a52-a77b-4ef95c1c1c04",
                                                "sense_id": "d894fee3-6805-3b8f-9495-91e39e284abf",
                                                "text": "„Die Zucchinis werden blühen“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1cb897db-f106-3749-94c2-ed55857ceb5f",
                                        "entry_id": "e2fbe441-ab0e-3659-b7fb-f8a1db4a25ea",
                                        "glosses": [
                                            "Frucht der Pflanze"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11d1d08d-8bc8-4c33-b659-7e10c10a9a95",
                                                "sense_id": "1cb897db-f106-3749-94c2-ed55857ceb5f",
                                                "text": "Zucchini kann man auch roh essen."
                                            },
                                            {
                                                "example_id": "4538d2d4-2d55-4940-a364-62e92d90361b",
                                                "sense_id": "1cb897db-f106-3749-94c2-ed55857ceb5f",
                                                "text": "„Zucchinis kochen, abtropfen, mit Salz bestreuen und in eine Pfanne legen.“"
                                            },
                                            {
                                                "example_id": "32c87d8e-0f86-44e0-8d7e-515d526bbfe6",
                                                "sense_id": "1cb897db-f106-3749-94c2-ed55857ceb5f",
                                                "text": "„Auch die Zucchinis, die ich heute ernten und einmachen wollte, hätte ich in normalen Jahren wohl eher dem Kompost anvertraut, weil ich schon genug Gläser mit eingelegten Zucchinis im Keller hatte, um mich locker ein Jahr lang damit zu versorgen.“"
                                            },
                                            {
                                                "example_id": "435206a7-5bea-4a9c-861b-fd841e48a0dd",
                                                "sense_id": "1cb897db-f106-3749-94c2-ed55857ceb5f",
                                                "text": "„Jetzt warnen auch Bayerische Behörden vor dem Verzehr von selbstangebauten Zucchinis und Kürbissen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
