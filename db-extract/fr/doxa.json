                                    {
                                        "sense_id": "3ff7b608-b475-31d9-b360-e5a66a3bb925",
                                        "entry_id": "8605a5c5-2d1b-3c18-a1c2-47a477c71d50",
                                        "glosses": [
                                            "Popular opinion or belief."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63247396-30d5-400e-89d9-f702dadee913",
                                                "sense_id": "3ff7b608-b475-31d9-b360-e5a66a3bb925",
                                                "text": "This doxa can vacillate in time and in space, however, particularly when it comes up against other perspectives, because they too can generate their own doxas."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b20916e0-296e-4448-904e-48ee62023748",
                        "source_entry_id": "570533b9-1bd9-3e3f-afea-4bc1b9ac3046",
                        "source_sense_id": "d83939b4-3f29-3e16-94d1-92ee515729ad",
