    "entries": [
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "45b1acd8-3136-3303-829d-1d3127a3f7a9",
                    "sense_definition": "And; the sum of the previous number and the following one.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "addition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Two <w>plus</w> two equals four.",
                            "target_lang_translations": {
                                "ru": "Два <w>плюс</w> два равно четыре.",
                                "zh": "二<w>加</w>二等于四。"
                            }
                        },
                        {
                            "text": "A water molecule is made up of two hydrogen atoms <w>plus</w> one of oxygen.",
                            "target_lang_translations": {
                                "ru": "Молекула воды состоит из двух атомов водорода <w>плюс</w> один атом кислорода.",
                                "zh": "水分子由两个氢原子<w>加</w>一个氧原子组成。"
                            }
                        }
                    ],
                    "synonyms": [
                        "and"
                    ],
                    "antonyms": [
                        "minus"
                    ],
                    "common_phrases": [
                        "two plus two"
                    ],
                    "target_lang_definitions": {
                        "ru": "И; сумма предыдущего и последующего чисел.",
                        "zh": "和；前一个数字与后一个数字之和。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плюс",
                                "target_lang_sense_clarification": "математическое сложение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "加",
                                "target_lang_sense_clarification": "数学运算"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d243be61-31a0-3990-a437-4afdca07557e",
                    "sense_definition": "With; having in addition to something else.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "addition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I've won a holiday to France <w>plus</w> five hundred euros in spending money!",
                            "target_lang_translations": {
                                "ru": "Я выиграл отпуск во Франции <w>плюс</w> пятьсот евро на расходы!",
                                "zh": "我赢得了去法国度假的机会，<w>外加</w>五百欧元的零花钱！"
                            }
                        },
                        {
                            "text": "The price is fifty dollars <w>plus</w> tax.",
                            "target_lang_translations": {
                                "ru": "Цена составляет пятьдесят долларов <w>плюс</w> налог.",
                                "zh": "价格是五十美元<w>加</w>税。"
                            }
                        }
                    ],
                    "synonyms": [
                        "and"
                    ],
                    "common_phrases": [
                        "plus tax",
                        "plus shipping"
                    ],
                    "target_lang_definitions": {
                        "ru": "С; имеющий что-либо в дополнение к чему-то другому.",
                        "zh": "和；除了某物之外还有其他东西。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плюс",
                                "target_lang_sense_clarification": "в дополнение к чему-либо"
                            },
                            {
                                "target_lang_word": "и",
                                "target_lang_sense_clarification": "в значении добавления"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "加",
                                "target_lang_sense_clarification": "表示附加"
                            },
                            {
                                "target_lang_word": "外加",
                                "target_lang_sense_clarification": "额外增加"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "80116854-c9e0-3da3-b368-9d2fd471b0f6",
                    "sense_definition": "Being positive rather than negative or zero.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mathematical_sign",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The result of the calculation is a <w>plus</w> four.",
                            "target_lang_translations": {
                                "ru": "Результат вычисления — <w>плюс</w> четыре.",
                                "zh": "计算结果是<w>正</w>四。"
                            }
                        },
                        {
                            "text": "The temperature today is <w>plus</w> ten degrees Celsius.",
                            "target_lang_translations": {
                                "ru": "Температура сегодня <w>плюс</w> десять градусов по Цельсию.",
                                "zh": "今天气温是<w>零上</w>十摄氏度。"
                            }
                        }
                    ],
                    "synonyms": [
                        "positive"
                    ],
                    "antonyms": [
                        "minus",
                        "negative"
                    ],
                    "common_phrases": [
                        "plus four",
                        "plus ten"
                    ],
                    "target_lang_definitions": {
                        "ru": "Положительный, а не отрицательный или нулевой.",
                        "zh": "正的，而非负的或零。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плюс",
                                "target_lang_sense_clarification": "о температуре или числах"
                            },
                            {
                                "target_lang_word": "положительный",
                                "target_lang_sense_clarification": "о значении"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "正",
                                "target_lang_sense_clarification": "数学或温度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "576e4341-7ea3-384e-8954-1bed85ac9e55",
                    "sense_definition": "Equal to or greater than a specific quantity; upwards.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bus can fit sixty <w>plus</w> kids, but we only get forty-eight.",
                            "target_lang_translations": {
                                "ru": "В автобус может поместиться шестьдесят <w>с лишним</w> детей, но у нас только сорок восемь.",
                                "zh": "这辆巴士能坐六十<w>多</w>个孩子，但我们只有四十八个。"
                            }
                        },
                        {
                            "text": "He has been working there for twenty <w>plus</w> years.",
                            "target_lang_translations": {
                                "ru": "Он работает там уже двадцать <w>с лишним</w> лет.",
                                "zh": "他在那里工作了二十<w>多</w>年了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "sixty plus",
                        "twenty plus"
                    ],
                    "target_lang_definitions": {
                        "ru": "Равный или превышающий определенное количество; с лишним.",
                        "zh": "等于或超过特定数量；多于。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "с лишним",
                                "target_lang_sense_clarification": "о количестве"
                            },
                            {
                                "target_lang_word": "плюс",
                                "target_lang_sense_clarification": "после числа"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "多",
                                "target_lang_sense_clarification": "用于数字后表示超过"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7a42a78e-d5a8-3bef-a1d6-e405b06a2dc0",
                    "sense_definition": "Positive, or involving an advantage.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "advantage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His experience in marketing is a <w>plus</w> factor for this job.",
                            "target_lang_translations": {
                                "ru": "Его опыт в маркетинге является <w>положительным</w> фактором для этой работы.",
                                "zh": "他的市场营销经验是这份工作的<w>加分项</w>。"
                            }
                        },
                        {
                            "text": "Having a car is a <w>plus</w> point when living in the countryside.",
                            "target_lang_translations": {
                                "ru": "Наличие машины — это <w>плюс</w>, когда живешь в сельской местности.",
                                "zh": "住在乡下时，有辆车是个<w>优势</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "advantageous",
                        "good",
                        "positive"
                    ],
                    "antonyms": [
                        "bad",
                        "disadvantageous",
                        "negative"
                    ],
                    "common_phrases": [
                        "plus factor",
                        "plus point"
                    ],
                    "target_lang_definitions": {
                        "ru": "Положительный или дающий преимущество.",
                        "zh": "积极的，或具有优势的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "положительный",
                                "target_lang_sense_clarification": "дающий преимущество"
                            },
                            {
                                "target_lang_word": "дополнительный",
                                "target_lang_sense_clarification": "о факторе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "有利的",
                                "target_lang_sense_clarification": "具有优势"
                            },
                            {
                                "target_lang_word": "积极的",
                                "target_lang_sense_clarification": "正面因素"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "07b8d581-d03e-3573-b1b9-d5844fbc4291",
                    "sense_definition": "Electrically positive.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "electricity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A battery has both a <w>plus</w> pole and a minus pole.",
                            "target_lang_translations": {
                                "ru": "У батарейки есть как <w>положительный</w> полюс, так и отрицательный.",
                                "zh": "电池既有<w>正</w>极也有负极。"
                            }
                        },
                        {
                            "text": "Connect the red wire to the <w>plus</w> terminal of the device.",
                            "target_lang_translations": {
                                "ru": "Подключите красный провод к <w>плюсовой</w> клемме устройства.",
                                "zh": "将红线连接到设备的<w>正</w>极端子。"
                            }
                        }
                    ],
                    "synonyms": [
                        "positive"
                    ],
                    "antonyms": [
                        "negative"
                    ],
                    "common_phrases": [
                        "plus pole",
                        "plus terminal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Электрически положительный.",
                        "zh": "电学上的正极。"
                    },
                    "translations": {
