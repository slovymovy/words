    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b7a93660-490a-3343-a9d6-a15a2e0acbbc",
                    "sense_definition": "Foolish, clumsy, uncouth, or boorish.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "character",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>cloddish</w> behavior at the formal dinner embarrassed all of his colleagues.",
                            "target_lang_translations": {
                                "ru": "Его <w>неотёсанное</w> поведение на официальном ужине смутило всех его коллег."
                            }
                        },
                        {
                            "text": "He was a <w>cloddish</w> man who seemed completely out of place in high society.",
                            "target_lang_translations": {
                                "ru": "Он был <w>неуклюжим и грубоватым</w> человеком, который казался совершенно неуместным в высшем обществе."
                            }
                        }
                    ],
                    "synonyms": [
                        "boorish",
                        "clumsy",
                        "gawky",
                        "loutish",
                        "oafish"
                    ],
                    "antonyms": [
                        "graceful",
                        "refined",
                        "sophisticated"
                    ],
                    "common_phrases": [
                        "cloddish behavior"
                    ],
                    "target_lang_definitions": {
                        "ru": "Глупый, неуклюжий, неотёсанный или грубый."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неотёсанный",
                                "target_lang_sense_clarification": "о манерах или человеке"
                            },
                            {
                                "target_lang_word": "неуклюжий",
                                "target_lang_sense_clarification": "неловкий, мешковатый"
                            },
                            {
                                "target_lang_word": "грубый",
                                "target_lang_sense_clarification": "лишённый воспитания"
                            },
                            {
                                "target_lang_word": "дубоватый",
                                "target_lang_sense_clarification": "туповатый и нечуткий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1ec33a5a-388e-3982-b071-93b46cfee471",
                    "sense_definition": "Resembling or full of clods; lumpy, especially of soil or earth.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "soil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The plow struggled to break through the dry and <w>cloddish</w> soil of the field.",
                            "target_lang_translations": {
                                "ru": "Плуг с трудом преодолевал сухую и <w>комковатую</w> почву поля."
                            }
                        },
                        {
                            "text": "Heavy rain had turned the garden into a sticky, <w>cloddish</w> mess.",
                            "target_lang_translations": {
                                "ru": "Сильный дождь превратил сад в липкое месиво <w>из комьев земли</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "cloddy",
                        "lumpy"
                    ],
                    "common_phrases": [
                        "cloddish soil"
                    ],
                    "target_lang_definitions": {
                        "ru": "Комковатый, состоящий из комьев (обычно о почве или земле)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "комковатый",
                                "target_lang_sense_clarification": "о почве или земле с комьями"
                            },
                            {
                                "target_lang_word": "полный комьев",
                                "target_lang_sense_clarification": "состоящий из плотных комков земли"
                            }
                        ]
                    }
                }
            ]
        }
    ]
