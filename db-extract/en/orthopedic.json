                        "sense_id": "b4520276-7372-3659-b86e-9ee6797b8154",
                        "entry_id": "44a4a241-aeaf-3a27-9394-0772634bd45f",
                        "glosses": [
                            "Of or relating to orthopedics."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f952502-5835-4e23-bdcd-b33355c25ed9",
                                "sense_id": "b4520276-7372-3659-b86e-9ee6797b8154",
                                "text": "The destiny-grade event that happened to Orin Incandenza at this point was that just as he was passing glumly under the Home goalposts and entering the shadow of the south exit-tunnel's adit a loud and ominously orthopedic cracking sound, plus then shrieking, issued from somewhere on the field behind him."
                            },
                            {
                                "example_id": "c8ce4f06-feec-40af-ad78-447190dc2b6c",
                                "sense_id": "b4520276-7372-3659-b86e-9ee6797b8154",
                                "text": "From there, Thera-Paw’s team created a special pair of orthopedic boots for Lucas, made of Neoprene and rubber with extra padding on the bottoms. The black shade looks as close to his natural foot color as possible so as not to stand out too much."
                            }
                        ]
                    }
