                "senses": [
                    {
                        "sense_id": "f2e88eb1-4947-3440-a303-bb4e8e9d09c7",
                        "entry_id": "9cad235b-f2e1-346f-894c-4acb8d1f94f3",
                        "glosses": [
                            "een stuk land waarvan de grond verwijderd is, of waar men nog steeds aan het graven is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef7d2e52-42d9-482b-a889-0e313630cb1a",
                                "sense_id": "f2e88eb1-4947-3440-a303-bb4e8e9d09c7",
                                "text": "In het muur-toerisme zag hij nieuwe kansen. Zijn familie protesteerde fel, de dorpelingen lachten hem uit, omdat de torens en de muur hier bijkans onbereikbaar zijn. Maar hij zette door, zoals hij in de jaren tachtig de ontginning van de mijnen in deze verlaten, doodarme streek doorzette. Toevallige, archeologische ontdekkingen bij de aanleg van een weg en de afgraving van een berg sterkten hem in zijn plannen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "55ba133b-c5c3-468c-962d-6c970abd9cde",
                        "source_entry_id": "9cad235b-f2e1-346f-894c-4acb8d1f94f3",
                        "source_sense_id": "f2e88eb1-4947-3440-a303-bb4e8e9d09c7",
                        "source_sense_description": "een stuk land waarvan de grond verwijderd is, of waar men nog steeds aan het graven is",
                        "target_lang_word": "excavation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "excavation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2fa2bd54-59e2-3695-beaa-268e50f6e337",
                                        "entry_id": "3e633d00-42fb-30ce-9ed7-9a379f1dc419",
                                        "glosses": [
                                            "The act of excavating, or of making hollow, by cutting, scooping, or digging out a part of a solid mass."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2233097-f804-4464-a640-17119458c0fe",
                                                "sense_id": "2fa2bd54-59e2-3695-beaa-268e50f6e337",
                                                "text": "Near-synonyms: hollowing out, hollowing"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b86009a6-3acb-37eb-bcb7-b926d2a809a3",
                                        "entry_id": "3e633d00-42fb-30ce-9ed7-9a379f1dc419",
                                        "glosses": [
                                            "The act of excavating, or of making hollow, by cutting, scooping, or digging out a part of a solid mass.",
                                            "Especially, the trade of digging engineered holes for building foundations, roadbed preparations, and similar purposes."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "33d01032-c6f4-3e10-bd2b-ec530e3ebc47",
                                        "entry_id": "3e633d00-42fb-30ce-9ed7-9a379f1dc419",
                                        "glosses": [
                                            "A cavity formed by cutting, digging, or scooping."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3a73443-5691-4c7f-a069-61fe7b7b9412",
                                                "sense_id": "33d01032-c6f4-3e10-bd2b-ec530e3ebc47",
                                                "text": "Prof. Dainelli made a personal study of the lakes of the Upper Indus lying between its confluence with the Gilgit on the west and the plains of Kashmir on the east. From this district he cites fifty lakes and groups of lakes. Many of these are moraine-dammed, but some of the larger ones, as the Satpor Tso, the Tso Moriri, the Chiun Tso, and the group of lakes associated with the Pángong Tso, he considers to have originated by glacial excavation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65f37c39-b4d2-31a8-a02e-9cadde7276fc",
                                        "entry_id": "3e633d00-42fb-30ce-9ed7-9a379f1dc419",
                                        "glosses": [
                                            "An uncovered cutting in the earth, in distinction from a covered cutting or tunnel."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cdef6a2f-fb92-331a-9981-24c8e3c61314",
                                        "entry_id": "3e633d00-42fb-30ce-9ed7-9a379f1dc419",
                                        "glosses": [
                                            "The material dug out in making a channel or cavity."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48a13427-54e2-4be4-9a47-640a5d61d4a5",
                                                "sense_id": "cdef6a2f-fb92-331a-9981-24c8e3c61314",
                                                "text": "[…] to cart away the excavations from the work, and to recart the same back again so far as required to fill the trench over the sewer […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a74a6569-4a18-368f-831f-a692a206ce79",
                                        "entry_id": "3e633d00-42fb-30ce-9ed7-9a379f1dc419",
                                        "glosses": [
                                            "Archaeological research that unearths buildings, tombs and objects of historical value."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b1f818d5-c760-3c6b-bfa3-6acf2b8309f8",
                                        "entry_id": "3e633d00-42fb-30ce-9ed7-9a379f1dc419",
                                        "glosses": [
                                            "A site where an archaeological exploration is being carried out."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03b0c45a-8156-4d61-ab0b-1dee5b0954bf",
                                                "sense_id": "b1f818d5-c760-3c6b-bfa3-6acf2b8309f8",
                                                "text": "Gregory led the excavations alongside marine archaeologist Andreas Kallmeyer Bloch, who is also a curator at the National Museum.\n“It’s been a long process and I’ve come close to giving up along the way, but this is undoubtedly the craziest archaeological excavation I’ve yet been part of,” Bloch said in the news release."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c02bb0df-d0ab-3864-80b6-e1f59f9a7012",
                                        "entry_id": "3e633d00-42fb-30ce-9ed7-9a379f1dc419",
                                        "glosses": [
                                            "Something uncovered by archaeological excavation."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd39d8fb-7d95-4c85-a354-82aa5e55043e",
                                                "sense_id": "c02bb0df-d0ab-3864-80b6-e1f59f9a7012",
                                                "text": "To date, [Taco's 1982 cover of Irving Berlin's 1935] \"Cheek To Cheek\" and similar auditory excavations have fared poorly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d656ca0f-e4d3-3df3-9737-91c3e9404134",
                                        "entry_id": "3e633d00-42fb-30ce-9ed7-9a379f1dc419",
                                        "glosses": [
                                            "The act of discovering and exposing or developing (a quality)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84de7031-e145-474c-b5f9-765a050658fc",
                                                "sense_id": "d656ca0f-e4d3-3df3-9737-91c3e9404134",
                                                "text": "Chua looks at the landscape of childhood rather like a mining engineer looks at a pristine landscape—ripe for the excavation of talent."
                                            },
                                            {
                                                "example_id": "26a4d4b9-6caf-48f8-b2df-5c3b8e008d7b",
                                                "sense_id": "d656ca0f-e4d3-3df3-9737-91c3e9404134",
                                                "text": "This Andrade, a lawyer, seemed to enjoy bureucratic process as much as Mário de Andrade valorized the enthnographic excavation of creativity."
                                            },
                                            {
                                                "example_id": "614b912d-af63-4df7-b236-13253ee82ca0",
                                                "sense_id": "d656ca0f-e4d3-3df3-9737-91c3e9404134",
                                                "text": "In the same vein, Emirbayer and Desmond (2012) highlight the vital need for deeper scholarly reflexivity as regards race, advocating excavation of hidden presuppositions at social, disciplinary and scholastic levels."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
