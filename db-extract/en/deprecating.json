                "senses": [
                    {
                        "sense_id": "3c2687fa-bd59-33ad-8973-8fa880234804",
                        "entry_id": "f57ff222-093d-364c-813e-b7c717e8ce6e",
                        "glosses": [
                            "In manner that deprecates; insulting; belittling."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ec58071-4b07-48c5-b2d8-e45d7c940499",
                                "sense_id": "3c2687fa-bd59-33ad-8973-8fa880234804",
                                "text": "She looked at him with a deprecating smile on her face."
                            },
                            {
                                "example_id": "40c91bb5-25f3-42d9-8d5c-e15d479b34c1",
                                "sense_id": "3c2687fa-bd59-33ad-8973-8fa880234804",
                                "text": "He raised his hand with a deprecating gesture."
                            },
                            {
                                "example_id": "4b245896-dc52-4be1-9777-24bd29e08d7e",
                                "sense_id": "3c2687fa-bd59-33ad-8973-8fa880234804",
                                "text": "Theodora, with a deprecating look at Arnold Sherman, took his arm, and Ludovic marched her across the green amid a silence which the very horses tied to the storm fence seemed to share. For Ludovic 'twas a crowded hour of glorious life."
                            },
                            {
                                "example_id": "e695c050-088e-4746-8c64-d081c0f89622",
                                "sense_id": "3c2687fa-bd59-33ad-8973-8fa880234804",
                                "text": "It is now clear that the term Hobson-Jobson was originally a deprecating Anglo-Indian slang term for the Muharram used particularly in the army and merchant navy but also more widely."
                            }
                        ]
                    }
                ],
