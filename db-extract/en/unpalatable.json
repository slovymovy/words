                    }
                ],
                "senses": [
                    {
                        "sense_id": "41a14967-375f-3241-b02c-5ac9782d2537",
                        "entry_id": "3367b605-a96e-3e9a-9d44-281e2cca44b8",
                        "glosses": [
                            "Anything distasteful."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30ca6e40-a95b-4d02-a5f5-1c3b42b90bc0",
                                "sense_id": "41a14967-375f-3241-b02c-5ac9782d2537",
                                "text": "In the severer cases of hookworm the patient sometimes has an appetite for soil, paper, hair, clay, chalk, starch, and other unpalatables."
                            },
                            {
                                "example_id": "4a3bf2f1-b607-4894-864a-3379c1759582",
                                "sense_id": "41a14967-375f-3241-b02c-5ac9782d2537",
                                "text": "His wife, a small woman who walked always on high heels, borrowed Gerhardie's primus stove several times a day to cook her husband gargantuan meals of cockles, mussels, snails, and other such unpalatables."
                            },
                            {
                                "example_id": "b74713f0-28d6-45e3-b5f7-8465557185ed",
                                "sense_id": "41a14967-375f-3241-b02c-5ac9782d2537",
                                "text": "Denial and disbelief tend to be the default, not a pragmatic embracing of unthinkables and unpalatables. The way things have been is not the way they are and will soon be."
                            }
                        ]
                    }
                ],
