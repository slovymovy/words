{
    "word_family": [
        "convergence",
        "convergent",
        "convergency"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8f32cb7c-eaf6-34c8-a555-c98c6aeaa7fb",
                    "sense_definition": "To move toward one another and join at a common point.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two main roads <w>converge</w> at the center of the town.",
                            "target_lang_translations": {
                                "ru": "Две главные дороги <w>сходятся</w> в центре города."
                            }
                        },
                        {
                            "text": "Thousands of fans began to <w>converge</w> on the stadium hours before the concert started.",
                            "target_lang_translations": {
                                "ru": "Тысячи фанатов начали <w>стекаться</w> к стадиону за несколько часов до начала концерта."
                            }
                        }
                    ],
                    "synonyms": [
                        "meet",
                        "join",
                        "merge",
                        "unite"
                    ],
                    "antonyms": [
                        "diverge"
                    ],
                    "common_phrases": [
                        "converge on the city",
                        "paths converge",
                        "lines converge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигаться навстречу друг другу и соединяться в одной точке."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сходиться",
                                "target_lang_sense_clarification": "о дорогах, линиях или путях"
                            },
                            {
                                "target_lang_word": "стекаться",
                                "target_lang_sense_clarification": "о большом количестве людей, движущихся к одной цели"
                            },
                            {
                                "target_lang_word": "соединяться",
                                "target_lang_sense_clarification": "в общем смысле о слиянии в одной точке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d29da3bb-6739-3b9d-8685-4d5ed4d3e179",
                    "sense_definition": "To reach a stable state or a common result through a process or discussion.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "abstract_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After hours of debate, their opinions finally started to <w>converge</w> on a single solution.",
                            "target_lang_translations": {
                                "ru": "После многочасовых дебатов их мнения наконец начали <w>сходиться</w> на одном решении."
                            }
                        },
                        {
                            "text": "The algorithm will <w>converge</w> to a stable value after several iterations.",
                            "target_lang_translations": {
                                "ru": "Алгоритм <w>сойдется</w> к стабильному значению после нескольких итераций."
                            }
                        }
                    ],
                    "synonyms": [
                        "coincide",
                        "agree",
                        "concur"
                    ],
                    "antonyms": [
                        "diverge"
                    ],
                    "common_phrases": [
                        "opinions converge",
                        "converge to a solution"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прийти к стабильному состоянию или общему результату в процессе обсуждения или развития."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сходиться",
                                "target_lang_sense_clarification": "во взглядах или мнениях"
                            },
                            {
                                "target_lang_word": "согласовываться",
                                "target_lang_sense_clarification": "о данных или позициях"
                            },
                            {
                                "target_lang_word": "приближаться",
                                "target_lang_sense_clarification": "к единому решению или значению"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bdd03f3d-6ada-362f-83d5-92197d61c233",
                    "sense_definition": "To approach a definite finite limit as the number of terms increases.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This mathematical series will <w>converge</w> if the ratio is less than one.",
                            "target_lang_translations": {
                                "ru": "Этот математический ряд будет <w>сходиться</w>, если коэффициент меньше единицы."
                            }
                        },
                        {
                            "text": "The sequence does not <w>converge</w> to any specific number.",
                            "target_lang_translations": {
                                "ru": "Последовательность не <w>сходится</w> ни к какому конкретному числу."
                            }
                        }
                    ],
                    "antonyms": [
                        "diverge"
                    ],
                    "common_phrases": [
                        "converge to a limit",
                        "series converges"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Приближаться к определенному конечному пределу при увеличении числа членов (в математике)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сходиться",
                                "target_lang_sense_clarification": "о математических рядах, последовательностях или интегралах"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}