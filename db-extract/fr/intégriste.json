                                    {
                                        "sense_id": "0c77fd3b-6bb3-3b72-8510-0c63d65f660b",
                                        "entry_id": "483c3ca0-297b-3a4f-bebb-9d5a2b52d621",
                                        "glosses": [
                                            "One who reduces religion to strict interpretation of core or original texts."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "82efb9d0-9b64-31d6-8d24-42311b1432d5",
                                        "entry_id": "483c3ca0-297b-3a4f-bebb-9d5a2b52d621",
                                        "glosses": [
                                            "A trader who trades on the financial fundamentals of the companies involved, as opposed to a chartist or technician."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ba5433d2-3489-30f4-bcab-a48c5d6ead71",
                                        "entry_id": "483c3ca0-297b-3a4f-bebb-9d5a2b52d621",
                                        "glosses": [
                                            "Originally referred to an adherent of an American Christian movement that began as a response to the rejection of the accuracy of the Bible, the alleged deity of Christ, Christ's atonement for humanity, the virgin birth, and miracles."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5a7ebd8b-00f3-37bb-83e5-70598a9de87d",
                                        "entry_id": "483c3ca0-297b-3a4f-bebb-9d5a2b52d621",
                                        "glosses": [
                                            "A fundamentalist Christian."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8f309e1c-1b32-409e-a044-d509942036f5",
                        "source_entry_id": "7c48db3f-d777-3faf-a1fd-dfcaafee06d4",
                        "source_sense_id": "11ecd42a-0640-3894-993b-f01df03d8d50",
                        "target_lang_word": "integralist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "integralist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ae06b625-c5ee-3b6b-a564-e2fe038a7fc6",
                                        "entry_id": "a274a040-6d43-3fac-9757-e9fd7928e213",
                                        "glosses": [
                                            "An adherent of Catholic Integralism, an anti-pluralistic movement within Roman Catholicism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32cff38d-cddf-4be2-abe1-8550c17cb994",
                                                "sense_id": "ae06b625-c5ee-3b6b-a564-e2fe038a7fc6",
                                                "text": "Those who start out by vilifying the so-called integralists or traditionalists or arch-conservatives seem always to end by attacking the hierarchical structure of the Church itself and its authoritarian pope."
                                            },
                                            {
                                                "example_id": "c044cb73-a31c-4fc4-90eb-38e65da5b61a",
                                                "sense_id": "ae06b625-c5ee-3b6b-a564-e2fe038a7fc6",
                                                "text": "The curial integralists, who formed the small, vocal minority at Vatican II, gave voice in its debates to the vision of the Church that had gained popular credence in the wake of Vatican I."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c0e624c9-3e0e-4244-8e5b-bf031547ea6d",
                        "source_entry_id": "7c48db3f-d777-3faf-a1fd-dfcaafee06d4",
