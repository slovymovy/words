                    {
                        "sense_id": "6850bf63-0688-343b-a653-ba9ec8f4d13e",
                        "entry_id": "0f93edfd-67ef-30b6-9def-bef37a6c3ff4",
                        "glosses": [
                            "Cancérigène, qui peut provoquer, aggraver ou sensibiliser un cancer ou son apparition."
                        ],
                        "tags": [
                            "Toxicologie"
                        ],
                        "examples": [
                            {
                                "example_id": "f4e318fb-4e6f-409d-b206-a941096de36f",
                                "sense_id": "6850bf63-0688-343b-a653-ba9ec8f4d13e",
                                "text": "Le méthanal (formol) est une substance carcinogène."
                            },
                            {
                                "example_id": "46efa314-1470-4bb2-9748-a65c2c87f204",
                                "sense_id": "6850bf63-0688-343b-a653-ba9ec8f4d13e",
                                "text": "Ainsi a été découverte la plus petite molécule carcinogène connue, son rôle ayant été ensuite confirmé expérimentalement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e76e0e44-e91f-44cc-b4fe-6e237ed2c501",
                        "source_entry_id": "0f93edfd-67ef-30b6-9def-bef37a6c3ff4",
                        "source_sense_id": "6850bf63-0688-343b-a653-ba9ec8f4d13e",
                        "source_sense_description": "Cancérigène, qui peut provoquer, aggraver ou sensibiliser un cancer ou son apparition.",
                        "target_lang_word": "carcinogenic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
