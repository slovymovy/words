                {
                    "sense_id": "b44056db-439d-340a-a6c5-b179b545749c",
                    "sense_definition": "To cut meat into smaller pieces at the joints.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "action_cut",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The butcher will <w>joint</w> the chicken for you if you ask him.",
                            "target_lang_translations": {
                                "ru": "Мясник <w>разделает</w> для вас курицу, если вы его попросите.",
