                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50792edf-ccb5-48c1-b393-433b67577367",
                                                "sense_id": "09a54b1f-38e2-3445-bdc5-f54bcba68620",
                                                "text": "Or, when more deeply moved, he would exclaim--\n\"As noble thoughts the inward being grace,\nSo noble whiskers dignify the face.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d75a6804-e013-39b1-a0a7-ed3f381eaced",
