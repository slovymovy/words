                "senses": [
                    {
                        "sense_id": "2ccbefaf-6f18-3e76-8f2d-813ec93149e4",
                        "entry_id": "d65f4166-d795-3793-a98a-fa2c562f8a3c",
                        "glosses": [
                            "Errichten einer Festung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea4b7b57-8d43-4c09-a45d-483752eb057b",
                                "sense_id": "2ccbefaf-6f18-3e76-8f2d-813ec93149e4",
                                "text": "„Das Fortifikationswesen verwissenschaftlichte sich, und der Festungsbau wurde teurer und teurer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9c5260a6-ec1c-3010-a2fa-a753c97fc7bb",
                        "entry_id": "d65f4166-d795-3793-a98a-fa2c562f8a3c",
                        "glosses": [
                            "Bauwerk, das eine Festung/Teil einer Festung ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc420ae5-4960-4011-8265-e86bfb80fd79",
                                "sense_id": "9c5260a6-ec1c-3010-a2fa-a753c97fc7bb",
                                "text": "„Die Entwicklung hin zu den gezogenen Kanonenrohren war jedoch absehbar, und schon wenige Jahrzehnte nach ihrer Erbauung (ca. 1860) galten die Festungsbauten als militärisch überholt.“"
                            },
                            {
                                "example_id": "0f0f872f-1647-4f45-9510-5dd2dc7080b6",
                                "sense_id": "9c5260a6-ec1c-3010-a2fa-a753c97fc7bb",
                                "text": "„Es war ein sternförmiger, zwölfeckiger Festungsbau mit sechs Toren in idyllischer Umgebung, gut bewachbar.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c93d86bb-9710-4a0b-be3d-4020d24a35d4",
                        "source_entry_id": "d65f4166-d795-3793-a98a-fa2c562f8a3c",
                        "source_sense_id": "2ccbefaf-6f18-3e76-8f2d-813ec93149e4",
