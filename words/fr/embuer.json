            "senses": [
                {
                    "sense_id": "664afc91-f7f9-3f76-bb5d-ede3a0217c99",
                    "sense_definition": "Couvrir d'une couche de buée une surface transparente ou polie.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Quand je porte un masque en hiver, mon souffle chaud vient rapidement <w>embuer</w> mes lunettes."
                        },
                        {
                            "text": "Les vitres de la voiture s'<w>embuent</w> dès que la température baisse à l'extérieur."
                        }
                    ],
                    "synonyms": [
                        "obscurcir",
                        "ternir"
                    ],
                    "antonyms": [
                        "désembuer"
                    ],
                    "common_phrases": [
                        "embuer les lunettes",
                        "embuer les vitres"
                    ]
                },
                {
                    "sense_id": "987736bc-c59a-3cac-ae0e-37260fb2f454",
                    "sense_definition": "Voiler ou brouiller les yeux par des larmes sous l'effet de l'émotion.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une profonde tristesse <w>embua</w> ses yeux quand elle apprit la mauvaise nouvelle."
                        },
                        {
                            "text": "Ses yeux s'<w>embuent</w> dès qu'il repense à cette période difficile de sa jeunesse."
                        }
                    ],
                    "synonyms": [
                        "embrumer",
                        "voiler"
                    ],
                    "common_phrases": [
                        "embuer les yeux",
                        "embuer le regard"
                    ]
                },
                {
                    "sense_id": "9402af31-e683-32b6-ad50-ee860293253b",
                    "sense_definition": "Rendre confus ou imprécis l'esprit, le jugement ou la pensée.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La fatigue intense finissait par <w>embuer</w> son esprit après plusieurs nuits d'insomnie."
                        },
                        {
                            "text": "L'alcool <w>embuait</w> ses pensées et l'empêchait de prendre une décision raisonnable."
                        }
                    ],
