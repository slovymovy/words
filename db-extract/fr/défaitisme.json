        "fr-extract.jsonl": [
            {
                "entry_id": "b24bc2d9-1231-3f36-bbb5-3c6379355c8b",
                "word": "défaitisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ac7f5567-2fe0-4512-81fe-756da9c36470",
                        "entry_id": "b24bc2d9-1231-3f36-bbb5-3c6379355c8b",
                        "tags": [
                            "plural"
                        ],
                        "form": "défaitismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1b751fb8-dd1f-3360-806d-cf5f08e9bfd3",
                        "entry_id": "b24bc2d9-1231-3f36-bbb5-3c6379355c8b",
                        "glosses": [
                            "Fatalisme, pessimisme qui tient la défaite pour certaine et préfère rendre les armes —et être défait— plutôt que d’engager le combat et tenter la victoire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6ccd89f-5fe6-44d1-a2b5-8427cb5b1870",
                                "sense_id": "1b751fb8-dd1f-3360-806d-cf5f08e9bfd3",
                                "text": "L’Union européenne, cédant au défaitisme, estime qu’il n’est plus possible de l’empêcher la Corée du Nord d’acquérir la bombe atomique dans les années à venir."
                            },
                            {
                                "example_id": "fbe967b8-3608-4d8c-93b7-33b396a5586a",
                                "sense_id": "1b751fb8-dd1f-3360-806d-cf5f08e9bfd3",
                                "text": "Le défaitisme est une forme de vanité parce qu’en étant défaitiste, on se positionne en tant que Général en chef, mais d’une armée vaincue !"
                            },
                            {
                                "example_id": "711b93d0-a7fd-400d-9432-891fade9719c",
                                "sense_id": "1b751fb8-dd1f-3360-806d-cf5f08e9bfd3",
                                "text": "Et que dire du gouvernement qui a fustigé par le biais de la ministre du Travail Muriel Pénicaud le \"défaitisme\" du secteur de bâtiment, parlant même de manque de \"civisme\" lorsqu’entreprises et salariés du BTP avaient appelé à l’unisson à stopper l’activité après l’annonce du confinement par Emmanuel Macron…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "03b9595e-254b-4c1c-b4cd-f1d4a3f1d9b3",
                        "source_entry_id": "b24bc2d9-1231-3f36-bbb5-3c6379355c8b",
                        "source_sense_id": "1b751fb8-dd1f-3360-806d-cf5f08e9bfd3",
                        "target_lang_word": "Defätismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Defätismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "66f72f7a-77c7-3d15-9bc2-70f51081d1ac",
                                        "entry_id": "544baac3-2438-39ef-b34d-5087eaea0765",
                                        "glosses": [
                                            "pessimistische, mutlose Haltung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d23717d2-b037-460e-922b-711b54d137a8",
                                                "sense_id": "66f72f7a-77c7-3d15-9bc2-70f51081d1ac",
                                                "text": "„Kalick war der Junge gewesen, der mich angezeigt hatte wegen Defätismus und während der Gerichtsverhandlung auf Härte, unerbittlicher Härte bestanden hatte.“"
                                            },
                                            {
                                                "example_id": "6ba50845-3ef9-4616-bfe8-b0d29dde6562",
                                                "sense_id": "66f72f7a-77c7-3d15-9bc2-70f51081d1ac",
                                                "text": "„Aber der Mann, der Ostpreußen bis zum Schluss eisern im Griff hielt, Gauleiter Erich Koch, hatte gedroht, Fluchtvorbereitungen als Defätismus zu ahnden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "65234bf9-5fad-35c5-ae13-bf8b78443c24",
                                        "entry_id": "544baac3-2438-39ef-b34d-5087eaea0765",
                                        "glosses": [
                                            "Zustand der Mutlosigkeit oder Schwarzseherei"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8cdd5725-254e-4a70-acbf-a7d91dc87dc1",
                        "source_entry_id": "b24bc2d9-1231-3f36-bbb5-3c6379355c8b",
                        "source_sense_id": "1b751fb8-dd1f-3360-806d-cf5f08e9bfd3",
                        "target_lang_word": "defeatism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "defeatism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "553ac83d-a165-39a0-8a44-832748c5ba3e",
                                        "entry_id": "cf9fdd7e-3ee6-3a8b-9a32-da8842f6d3ec",
                                        "glosses": [
                                            "Acceptance of defeat without struggle."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c79484b-9cbd-45fe-9e94-b2ce91ca8521",
                                                "sense_id": "553ac83d-a165-39a0-8a44-832748c5ba3e",
                                                "text": "Objective assessment is good, but defeatism will reduce our potentials even when the prospects for victory have never been nearer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
