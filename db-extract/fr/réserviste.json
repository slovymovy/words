        "fr-extract.jsonl": [
            {
                "entry_id": "beeaccff-ccbb-3960-b872-30a2576356a5",
                "word": "réserviste",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "43296a20-b348-4e6a-8331-639696ac90ad",
                        "entry_id": "beeaccff-ccbb-3960-b872-30a2576356a5",
                        "tags": [
                            "plural"
