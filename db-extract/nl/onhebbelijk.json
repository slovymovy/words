                "senses": [
                    {
                        "sense_id": "7a7c6db7-5cc9-3e96-8f9e-b29722bc55a5",
                        "entry_id": "cd67a77f-b341-3f9a-aaf9-793e85e7a084",
                        "glosses": [
                            "ongemanierd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96c77744-1453-40be-a74e-3a69cd12942e",
                                "sense_id": "7a7c6db7-5cc9-3e96-8f9e-b29722bc55a5",
                                "text": "Sindsdien gedroeg Proto zich echt onhebbelijk. De doelman was ook niet meer geïnteresseerd in de teambuilding, want gisteren ging KVO raften op zee. Hij kampte ook met een zogezegde blessure. Die weerspannigheid kon geïnterpreteerd worden als een houding om een transfer naar Olympiakos te forceren. Alleen was de scout uit Athene toch niet zo onder de indruk geraakt van Proto en wilde de Griekse kampioen hem eigenlijk alleen nog overnemen als dat gratis kon."
                            }
                        ]
                    }
