                        ],
                        "examples": [
                            {
                                "example_id": "98114749-b02a-4cbf-bbc9-d99e14bf5e99",
                                "sense_id": "da7f5cf0-93df-3e53-a928-ec0e6743deb4",
                                "text": "Sypiali w kuchni, dopóki pewnej nocy nie wskoczyła przez okno puma, napędzając starcowi takiego strachu, że zataszczył łóżko na piętro.",
                                "translation": "They slept in the kitchen, until one night a puma jumped in through the window, frightening the old man so much that he dragged the bed upstairs.",
                                "english": "They slept in the kitchen, until one night a puma jumped in through the window, frightening the old man so much that he dragged the bed upstairs."
                            },
                            {
                                "example_id": "a2b97541-7480-41d6-a907-6c940acd5298",
                                "sense_id": "da7f5cf0-93df-3e53-a928-ec0e6743deb4",
                                "text": "18 wiader napełnić i w trzy godziny z drugiego na czwarte piętro zataszczyć nie każdy da radę.",
                                "translation": "Not everyone can fill 18 buckets and in three hours lug them from the third to the fifth floor.",
                                "english": "Not everyone can fill 18 buckets and in three hours lug them from the third to the fifth floor."
                            }
                        ]
                    }
                ],
