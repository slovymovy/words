                "senses": [
                    {
                        "sense_id": "20a667eb-71f8-3517-ba80-245ba78a9d6c",
                        "entry_id": "d8a1f990-18c0-3d41-9ee4-74dc2f47cf8e",
                        "glosses": [
                            "Variante de ululer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21a7d3d8-40d2-4b8e-8574-0b7a083f43d7",
                                "sense_id": "20a667eb-71f8-3517-ba80-245ba78a9d6c",
                                "text": "J'entends les pas des seigneurs bretons foulant le sol de leur domaine! mais le hibou houhoule dans les ruines,…"
                            },
                            {
                                "example_id": "a03c5ede-9905-4e26-9cdb-ddb46697c8c3",
                                "sense_id": "20a667eb-71f8-3517-ba80-245ba78a9d6c",
                                "text": "Il ferma les paupières en écoutant houhouler un hibou tout proche."
                            },
                            {
                                "example_id": "f28d18c6-3ce1-46de-a72b-43a0139e8695",
                                "sense_id": "20a667eb-71f8-3517-ba80-245ba78a9d6c",
                                "text": "Le jeune garçon noir, celui dont nous avons déjà signalé les exploits, fut même renvoyé sur sa propre piste pour « houhouler » à la manière des hiboux, signal usité parmi eux."
                            }
                        ]
                    }
