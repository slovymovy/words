                                        "entry_id": "37a7521d-0657-31eb-94f0-a908aefc643c",
                                        "glosses": [
                                            "A person who uses a harpoon, especially to hunt whales."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02b53498-f46b-4275-a6f9-5294901f30f6",
                                                "sense_id": "cb50207a-6b54-3e92-bba4-ab03162fb1d3",
                                                "text": "Y.T. laughs. So does Raven.\n\"What's your job?\" Y.T. asks.\n\"I'm a harpooner,\" he says."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
