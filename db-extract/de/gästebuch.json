                "senses": [
                    {
                        "sense_id": "2198c590-4df2-306e-9732-334a931ae3ec",
                        "entry_id": "eba56a13-5bc5-3135-a16f-5b1ee272a637",
                        "glosses": [
                            "Buch, ausgelegt für Besucher eines bestimmten Ortes, mit leeren Seiten, auf denen Kommentare und/oder Namen hinterlassen werden können, zum Beispiel um einem Gastgeber zu danken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "313fbacb-be6f-40fc-a59a-93bd77e77afd",
                                "sense_id": "2198c590-4df2-306e-9732-334a931ae3ec",
                                "text": "Haben Sie sich schon ins Gästebuch eingetragen?"
                            },
                            {
                                "example_id": "f42f2e32-90f3-4e1e-8beb-9eba9ed46e8d",
                                "sense_id": "2198c590-4df2-306e-9732-334a931ae3ec",
                                "text": "„Neben dem Gästebuch liegen die Hefte des Österreichischen Schwarzen Kreuzes, der Kriegsgräberfürsorge, die auf ihrer Website für »Versöhnung über den Gräbern« wirbt.“"
                            },
                            {
                                "example_id": "a7b6ea8c-3cca-428b-8840-29bf4cbc166b",
                                "sense_id": "2198c590-4df2-306e-9732-334a931ae3ec",
                                "text": "„Um die Pause zwischen den Gerichten auszufüllen, trug er sich in das Gästebuch ein.“"
                            },
                            {
                                "example_id": "b267a0b5-9731-4e5c-9327-7b8c9e2b9067",
                                "sense_id": "2198c590-4df2-306e-9732-334a931ae3ec",
                                "text": "„Heinrike zeigt mir das Gästebuch aus Triangel, mit Wildlederrücken und einem Abbild des Vesper-Hauses auf dem Einband.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d5f83b82-7702-3af7-9f4c-ae212a55dfd5",
                        "entry_id": "eba56a13-5bc5-3135-a16f-5b1ee272a637",
                        "glosses": [
                            "besondere Form des Hinterlassens von Nachrichten auf Websites, speziell von Kommentaren zur Website oder ihrem Thema"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11bfa4e1-cf28-4139-9583-7fc13d0453dd",
                                "sense_id": "d5f83b82-7702-3af7-9f4c-ae212a55dfd5",
                                "text": "Das Gästebuch durchbricht die Anonymität des Internets."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
