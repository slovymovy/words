                    "semantic_group_id": "humeur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon voisin est particulièrement <w>grincheux</w> le matin avant de boire son café."
                        },
                        {
                            "text": "Elle a répondu d'un ton <w>grincheux</w> quand on lui a demandé de l'aide."
                        }
                    ],
