                            "Scardinius erythrophthalmus, ryba z rodziny karpiowatych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0339c90b-7d34-4507-b742-9da75ea5eebb",
                                "sense_id": "89dfb149-d2a0-3afc-88c7-15834f768efe",
                                "text": "Byczki sporządza się głównie z płoci, wzdręgi, okonia i jazgarza."
                            }
                        ],
