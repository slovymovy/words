{
    "word_family": [
        "schorsen",
        "opschorten",
        "opschorting"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4a05cb23-ed19-30b9-9efb-40e84f5d7260",
                    "sense_definition": "Een tijdelijke onderbreking van een formele bijeenkomst, zoals een vergadering of een rechtszitting.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "onderbreking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na een korte <w>schorsing</w> van tien minuten vergaderden we verder over het nieuwe plan.",
                            "target_lang_translations": {
                                "en": "After a short <w>recess</w> of ten minutes, we continued meeting about the new plan."
                            }
                        },
                        {
                            "text": "De rechter vroeg om een <w>schorsing</w> van de zitting om het bewijsmateriaal te bestuderen.",
                            "target_lang_translations": {
                                "en": "The judge asked for a <w>suspension</w> of the session to study the evidence."
                            }
                        }
                    ],
                    "synonyms": [
                        "onderbreking",
                        "pauze",
                        "reces"
                    ],
                    "antonyms": [
                        "hervatting",
                        "voortzetting"
                    ],
                    "common_phrases": [
                        "korte schorsing",
                        "schorsing van de zitting",
                        "schorsing aanvragen"
                    ],
                    "target_lang_definitions": {
                        "en": "A temporary interruption of a formal meeting, such as a session or a court hearing."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "suspension",
                                "target_lang_sense_clarification": "of a meeting or session"
                            },
                            {
                                "target_lang_word": "adjournment",
                                "target_lang_sense_clarification": "formal pause in legal or legislative proceedings"
                            },
                            {
                                "target_lang_word": "recess",
                                "target_lang_sense_clarification": "a short break during a meeting"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c0212668-ca6c-3c91-8618-e395a3cce6fa",
                    "sense_definition": "Een tijdelijk verbod om een functie, beroep of sport uit te oefenen, vaak als straf of maatregel.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sanctie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door een <w>schorsing</w> van drie wedstrijden moest de voetballer het belangrijke duel missen.",
                            "target_lang_translations": {
                                "en": "Due to a three-match <w>suspension</w>, the football player had to miss the important duel."
                            }
                        },
                        {
                            "text": "De arts kreeg een tijdelijke <w>schorsing</w> opgelegd in afwachting van het tuchtonderzoek.",
                            "target_lang_translations": {
                                "en": "The doctor was given a temporary <w>suspension</w> pending the disciplinary investigation."
                            }
                        }
                    ],
                    "synonyms": [
                        "uitsluiting",
                        "non-actiefstelling"
                    ],
                    "common_phrases": [
                        "tijdelijke schorsing",
                        "schorsing van drie wedstrijden",
                        "schorsing opgelegd krijgen"
                    ],
                    "target_lang_definitions": {
                        "en": "A temporary ban from exercising a function, profession, or sport, often as a punishment or measure."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "suspension",
                                "target_lang_sense_clarification": "from a job, sport, or duty"
                            },
                            {
                                "target_lang_word": "ban",
                                "target_lang_sense_clarification": "temporary exclusion from participation"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}