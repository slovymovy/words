    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7b941bde-56d6-304d-bb29-c3b2a5ec1a67",
                    "sense_definition": "cordial and generous towards guests",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "hospitality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local people were incredibly <w>hospitable</w> and offered us food and a place to stay.",
                            "target_lang_translations": {
                                "ru": "Местные жители были невероятно <w>гостеприимны</w> и предложили нам еду и ночлег."
                            }
                        },
                        {
                            "text": "They are known as a <w>hospitable</w> family who always welcome strangers into their home.",
                            "target_lang_translations": {
                                "ru": "Они известны как <w>гостеприимная</w> семья, которая всегда рада незнакомцам в своем доме."
                            }
                        }
                    ],
                    "synonyms": [
                        "welcoming",
                        "friendly"
                    ],
                    "common_phrases": [
                        "hospitable family",
                        "hospitable host",
                        "warm and hospitable"
                    ],
                    "target_lang_definitions": {
                        "ru": "радушный и щедрый по отношению к гостям"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гостеприимный",
                                "target_lang_sense_clarification": "о людях или доме"
                            },
                            {
                                "target_lang_word": "радушный",
                                "target_lang_sense_clarification": "сердечный и приветливый"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6e0bcae3-46f5-38aa-af72-d0f1083c46f6",
                    "sense_definition": "providing a pleasant or suitable environment for life or growth",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "habitability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scientists are searching for other planets that might have a <w>hospitable</w> climate for humans.",
                            "target_lang_translations": {
                                "ru": "Ученые ищут другие планеты, на которых может быть <w>благоприятный</w> для человека климат."
                            }
                        },
                        {
                            "text": "The desert is not a very <w>hospitable</w> environment for most types of plants.",
                            "target_lang_translations": {
                                "ru": "Пустыня — не самая <w>пригодная</w> среда для большинства видов растений."
                            }
                        }
                    ],
                    "synonyms": [
                        "habitable",
                        "inhabitable",
                        "livable"
                    ],
                    "antonyms": [
                        "uninhabitable"
                    ],
                    "common_phrases": [
                        "hospitable environment",
                        "hospitable climate"
                    ],
                    "target_lang_definitions": {
                        "ru": "обеспечивающий приятную или подходящую среду для жизни или роста"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "благоприятный",
                                "target_lang_sense_clarification": "о климате или среде"
                            },
                            {
                                "target_lang_word": "пригодный для жизни",
                                "target_lang_sense_clarification": "о среде обитания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bfecf228-e814-3229-aab6-fbdbc390449e",
                    "sense_definition": "receptive and open-minded to new ideas or suggestions",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "receptiveness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee was <w>hospitable</w> to the new proposals regarding the company's restructuring.",
                            "target_lang_translations": {
                                "ru": "Комитет был <w>открыт</w> для новых предложений по реструктуризации компании."
                            }
                        },
                        {
                            "text": "He has always been <w>hospitable</w> to different points of view during our debates.",
                            "target_lang_translations": {
                                "ru": "Во время наших дебатов он всегда был <w>восприимчив</w> к различным точкам зрения."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hospitable to ideas",
                        "hospitable to suggestions"
                    ],
                    "target_lang_definitions": {
                        "ru": "восприимчивый и открытый для новых идей или предложений"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "открытый",
                                "target_lang_sense_clarification": "к новым идеям"
                            },
                            {
                                "target_lang_word": "восприимчивый",
                                "target_lang_sense_clarification": "к предложениям"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}