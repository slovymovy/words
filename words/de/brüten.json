                    "frequency": "Middle",
                    "semantic_group_id": "nachdenken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Seit vielen Stunden <w>brütet</w> der Mathematiker über einem schwierigen Problem."
                        },
                        {
                            "text": "Wir <w>brüteten</w> gestern den ganzen Nachmittag über einem neuen Plan."
                        }
                    ],
                    "synonyms": [
                        "grübeln",
                        "nachdenken",
                        "sich das Gehirn zermartern"
                    ],
                    "common_phrases": [
