                        "glosses": [
                            "In an unutterable manner; inexpressibly; so bad or otherwise extreme that one cannot talk about it."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "350d6371-ea1f-4fe1-a596-af02005823e9",
                                "sense_id": "054f0d53-f96f-37e5-91e2-ccca88d00fa0",
                                "text": "We both of us went on our knees, and, feeling unutterably sad, a whispered prayer went up from our lips as the poor fellow's soul flitted away to a happier and brighter world, and all was over."
                            },
                            {
                                "example_id": "255021c5-6c7a-412b-9f7c-0dfb85015d09",
                                "sense_id": "054f0d53-f96f-37e5-91e2-ccca88d00fa0",
                                "text": "I turned away and left her to finish her journey in peace, feeling, but only for a moment or two, that I had been an unutterably mean hound."
                            },
                            {
                                "example_id": "abdd0087-4121-4137-9855-3f35c4f4b53f",
                                "sense_id": "054f0d53-f96f-37e5-91e2-ccca88d00fa0",
                                "text": "The rapid reconquest of the capital, Kabul, by the Taliban after two decades of a staggeringly expensive, bloody effort to establish a secular government with functioning security forces in Afghanistan is, above all, unutterably tragic."
                            }
                        ]
                    }
                ],
