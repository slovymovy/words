                "senses": [
                    {
                        "sense_id": "c53feee1-fd9c-3ab8-ba60-707282fcb5b0",
                        "entry_id": "b94cf53c-1ca4-3b58-89e1-b5b4c271e613",
                        "glosses": [
                            "zevental personen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4afce56-ec56-4d7d-bc4d-13a858ebea7d",
                                "sense_id": "c53feee1-fd9c-3ab8-ba60-707282fcb5b0",
                                "text": "John Ricus en Catharina hadden in Batavia zeven kinderen gekregen (…) Het laatste nog in Indië geboren zoontje werd François Emile genoemd. Hij besloot deze plejade in 1857."
                            }
                        ]
                    },
                    {
                        "sense_id": "e03bd750-a1b8-3ff3-92ad-0d12c108491c",
                        "entry_id": "b94cf53c-1ca4-3b58-89e1-b5b4c271e613",
                        "glosses": [
                            "zeven of een ander select aantal personen die door hun prestaties als groep worden gezien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f0fe153-4cea-4df3-9a2d-6d665ec2b586",
                                "sense_id": "e03bd750-a1b8-3ff3-92ad-0d12c108491c",
                                "text": "Meer algemeen spreekt Van Loo vaak van ‘trek’ (…) in boeken en worden koks met een Michelinster omgekeerd beschreven in termen van de ‘plejade van de haute cuisine’ (…)."
                            },
                            {
                                "example_id": "8c3d60fa-0fb4-4a76-b198-983a3fb12262",
                                "sense_id": "e03bd750-a1b8-3ff3-92ad-0d12c108491c",
                                "text": "Met L'Allegria verwierf Ungaretti wereldfaam. Maar de dichter, die samen met Eugenio Montale, Salvatore Quasimodo en Umberto Saba tot de plejade van de 20ste-eeuwse Italiaanse poëzie behoort, is in Nederland alleen geëerd met verspreide publicaties en vertalingen."
                            }
                        ]
                    },
                    {
                        "sense_id": "b403717f-e064-3ea2-8583-de141e190338",
                        "entry_id": "b94cf53c-1ca4-3b58-89e1-b5b4c271e613",
                        "glosses": [
                            "selecte verscheidenheid"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "d69c26dc-7c89-4972-b7bb-a921fc3afa6e",
                                "sense_id": "b403717f-e064-3ea2-8583-de141e190338",
                                "text": "Wie de Vlaamse kranten en weekbladen van 2008 overloopt, merkt dat steeds meer schrijvers zich inderdaad weer mengen in het maatschappelijke debat en zich profileren in een plejade van thema's."
                            },
                            {
                                "example_id": "7c030fd9-3c85-4557-bc97-91c821490ff0",
                                "sense_id": "b403717f-e064-3ea2-8583-de141e190338",
                                "text": "Daarmee zijn we in de jaren zestig beland: een voortgezette plejade van tijdschriften en onder elkaar duchtig discussiërende groepen die in de golden sixties het artistieke gebeuren met hand en tand verdedigden tegen de burger en tegen het conformisme."
                            }
                        ]
                    },
                    {
                        "sense_id": "ee649e41-1bba-3f1c-9025-d14ea6d34bd6",
                        "entry_id": "b94cf53c-1ca4-3b58-89e1-b5b4c271e613",
                        "glosses": [
                            "verzamelterm voor al de isotopen van een element"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "cc05b871-70fa-48a2-8d72-dcfa513bf617",
                                "sense_id": "ee649e41-1bba-3f1c-9025-d14ea6d34bd6",
                                "text": "Volgens de officiële definitie werd nu een element echter een plejade, een groep, i.p.v. een streng bepaalde eenheid, wat theoretisch onbevredigend is."
                            }
                        ]
                    }
