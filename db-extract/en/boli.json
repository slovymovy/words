    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "f0eef54d-b4cd-303c-bd43-e6ff94b98e0e",
                "word": "Boli",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "10da77ef-9cf2-3d52-b597-4923ca078022",
                        "entry_id": "f0eef54d-b4cd-303c-bd43-e6ff94b98e0e",
                        "glosses": [
                            "Synonym of Khabarovsk: the Mandarin Chinese-derived name."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74245deb-93e8-4e6d-83d3-3d0d202d97cd",
                                "sense_id": "10da77ef-9cf2-3d52-b597-4923ca078022",
                                "text": "Khabarovsk (Boli), the second largest city in the Russian Far East, is about thirty kilometres from the Chinese border."
                            },
                            {
                                "example_id": "91b8a7dd-81d9-4b0e-8a3a-bb3fba522b68",
                                "sense_id": "10da77ef-9cf2-3d52-b597-4923ca078022",
                                "text": "Local press has created the most unbelievable stories about the Chinese conspiracy. According to these claims, Chinese diplomacy, “traditionally full of meanness”, would demand in future to “not only have those two islands but Khabarovsk itself, the ancient Chinese city of Boli, as well” which would lead to crisis and consequently - war between two countries."
                            },
                            {
                                "example_id": "1ea61f8a-ad23-4f22-be3d-f4cbec052c47",
                                "sense_id": "10da77ef-9cf2-3d52-b597-4923ca078022",
                                "text": "Indigenous people such as the Goldi saw the Amur's main stream north of Boli (Khabarovsk) as a natural extension of the Songhua River."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2aed7266-1400-4983-aff9-4dccf5a4e474",
                        "source_entry_id": "f0eef54d-b4cd-303c-bd43-e6ff94b98e0e",
                        "source_sense_id": "10da77ef-9cf2-3d52-b597-4923ca078022",
                        "source_sense_description": "city",
                        "target_lang_word": "はくり",
                        "target_lang_code": "ja",
                        "target_sense_ids": [],
                        "cross_references": []
                    }
                ],
                "word_linkages": [
