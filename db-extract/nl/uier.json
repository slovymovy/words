                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "85b33d9a-5141-3efe-94e9-893f7f346ffc",
                                        "entry_id": "a9966352-b5b0-37dd-858d-fb0d78d183be",
                                        "glosses": [
                                            "das in der Leistengegend von Huftieren sitzende Organ, welches im wesentlichen Milchdrüsen beherbergt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efc1ada9-cdbc-47df-bdf8-9f08759acb7d",
                                                "sense_id": "85b33d9a-5141-3efe-94e9-893f7f346ffc",
                                                "text": "Das Euter versorgt, wie auch bei den übrigen Säugetieren, über die Zitzen die Nachkommen in der ersten Lebenszeit mit Milch."
                                            },
                                            {
                                                "example_id": "f549ba01-7467-404c-ba81-2726fd01b0cc",
                                                "sense_id": "85b33d9a-5141-3efe-94e9-893f7f346ffc",
                                                "text": "„Ich trat also aus Ihrer Hütte und erblickte tatsächlich Ihre weiße Ziege, die mir den Rücken zuwandte und mir ihr pralles Euter zeigte.“"
                                            },
                                            {
                                                "example_id": "cdf65411-880c-4e8b-b5fe-c998649d3ea4",
                                                "sense_id": "85b33d9a-5141-3efe-94e9-893f7f346ffc",
                                                "text": "„Unsere Hauptarbeit besteht übrigens im Melken; am Morgen und am Abend müssen die prallen Euter geleert werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "297d8d27-cb18-4fca-a13d-f8b0d0009b05",
                        "source_entry_id": "7c4ba11e-31cb-3f48-b383-8efb09971aab",
