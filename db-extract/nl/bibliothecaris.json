                    {
                        "translation_id": "17f77337-ff20-4752-8451-4f2711eba6d5",
                        "source_entry_id": "00f8fd52-ce39-3517-8d9a-ce163d82f073",
                        "source_sense_id": "a2c86ce1-d86f-3398-98e9-fdecc8dd99d9",
                        "source_sense_description": "beheerder van een bibliotheek",
                        "target_lang_word": "Bibliothekar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bibliothekar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "361f05a2-18a9-38af-9802-d161b305568f",
                                        "entry_id": "3f37da61-2e9d-3eff-aa9c-614d49612ac2",
                                        "glosses": [
                                            "Mitarbeiter einer Bibliothek"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "547ea662-b162-4587-9e52-4fe687ccce2f",
                                                "sense_id": "361f05a2-18a9-38af-9802-d161b305568f",
                                                "text": "Immanuel Kant hat auch als Bibliothekar gearbeitet."
                                            },
                                            {
                                                "example_id": "07d748c4-de71-40a7-a2b7-ebe18f719c98",
                                                "sense_id": "361f05a2-18a9-38af-9802-d161b305568f",
                                                "text": "„Der Bibliothekar und sein Assistent starben ebenso wie einige der Fellows, die Interesse an der Bibliothek hatten, und das war der Stand der Dinge bis vor ein paar Jahren.“"
                                            },
                                            {
                                                "example_id": "8826f804-efb3-4b92-bb03-1d8d6e4cdc02",
                                                "sense_id": "361f05a2-18a9-38af-9802-d161b305568f",
                                                "text": "„Nach seiner ruhmreichen Anfangszeit erlebte das »Schatzhaus der Bücher« eine Glanzzeit unter dem Bibliothekar Leibniz, der in den Jahren 1690 bis 1716 von Herzog Anton Ulrich, dem Sohn des Gründers, nach Wolfenbüttel gerufen worden war.“"
                                            },
                                            {
                                                "example_id": "7320167e-d9a1-4b74-9699-3feaa3c66fba",
                                                "sense_id": "361f05a2-18a9-38af-9802-d161b305568f",
                                                "text": "„In seinem Bekanntenkreis gab es keine Bibliothekare.“"
                                            },
                                            {
                                                "example_id": "b91c17af-f9c8-4c18-852f-204a71d5b8a4",
                                                "sense_id": "361f05a2-18a9-38af-9802-d161b305568f",
                                                "text": "„Der Bibliothekar Jens Davidsen hatte Henriette gebeten, samstags die Bibliothek offen zu halten und sich um den Bestand zu kümmern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d4a82766-f931-404f-9a2a-5cbef1d3bd6b",
                        "source_entry_id": "00f8fd52-ce39-3517-8d9a-ce163d82f073",
