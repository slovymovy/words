                "senses": [
                    {
                        "sense_id": "e1c153fe-b7bd-32a8-a3a1-eec2505359a8",
                        "entry_id": "020f5da2-ff1e-3dc9-ba5f-9a291e197ef5",
                        "glosses": [
                            "Meeressäugetier aus der Gattung Balaenoptera mit heller Bauch- und grauer Rückenseite, zweitgrößtes rezentes Tier der Erde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d7557f4-d0d4-4ddb-b33f-97f24aadf7db",
                                "sense_id": "e1c153fe-b7bd-32a8-a3a1-eec2505359a8",
                                "text": "Finnwale sind eng mit den Blauwalen verwandt."
                            },
                            {
                                "example_id": "8fee18ea-0963-4b09-9a99-31a8dcf46641",
                                "sense_id": "e1c153fe-b7bd-32a8-a3a1-eec2505359a8",
                                "text": "„Bis 1958 wurden hier Finn-, Buckel- und Blauwale in industriellem Maßstab verarbeitet, danach war die Fabrik nur noch sporadisch in Betrieb.“"
                            },
                            {
                                "example_id": "21d23e65-b032-4300-bfa0-0f94e7b85ecd",
                                "sense_id": "e1c153fe-b7bd-32a8-a3a1-eec2505359a8",
                                "text": "„Bis 1930 wurde das jährliche Fangergebnis noch einmal verdoppelt, andere Arten wie Finnwal, Buckelwal oder Pottwal nicht eingerechnet.“"
                            },
                            {
                                "example_id": "8ace6d4b-a733-498b-847b-d506021b2116",
                                "sense_id": "e1c153fe-b7bd-32a8-a3a1-eec2505359a8",
                                "text": "„Ihm gehört die Firma, welche die bedrohten Finnwale jagt, die zweitgrößten Tiere des Planeten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
