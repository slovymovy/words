                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "subluxation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e56742e7-4459-3e33-a9b0-8fcad8b66397",
                                        "entry_id": "75186614-62ab-338b-81ec-619571037d7b",
                                        "glosses": [
                                            "A partial dislocation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b03acbf5-79a4-4b8d-92b9-4e0549adf844",
                                                "sense_id": "e56742e7-4459-3e33-a9b0-8fcad8b66397",
                                                "text": "The patient experienced subluxations of his right ulna, his lower right rear molar, and the lens of his left eye."
                                            },
                                            {
                                                "example_id": "5593896e-61d6-4a27-a538-e80e23a52023",
                                                "sense_id": "e56742e7-4459-3e33-a9b0-8fcad8b66397",
                                                "text": "Lateral subluxation of the atlantoaxial joints has also been observed in rheumatoid arthritis patients."
                                            },
                                            {
                                                "example_id": "d4c0b3aa-b47d-445e-88b3-2486715c1b0a",
                                                "sense_id": "e56742e7-4459-3e33-a9b0-8fcad8b66397",
                                                "text": "Many diseases and trauma are associated with lens subluxation. Clinical Features. All degrees of subluxation may be seen. Classically, iridodonesis is seen on slit lamp examination with eye movement. Phakodonesis may also be observed."
                                            },
                                            {
                                                "example_id": "7fbc9101-645b-4e54-870e-16ad0c0b928c",
                                                "sense_id": "e56742e7-4459-3e33-a9b0-8fcad8b66397",
                                                "text": "Subluxation of a tooth may cause bleeding and mobility of the tooth as a result of injury to the periodontal fibers. Displacement of the tooth is not usually apparent. Approximately 15 % to 20 % of reported trauma cases exhibit [it]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
