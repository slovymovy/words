                ],
                "senses": [
                    {
                        "sense_id": "80ab79dc-6ea8-327e-8190-54b551c978d3",
                        "entry_id": "29c70ea3-c9d3-3ce4-a5bc-082ba0f01992",
                        "glosses": [
                            "dem Schutz dienender Graben, der einem Hauptgraben vorgelagert ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0594ac4d-5240-4686-8d97-b9ea09f5083c",
                                "sense_id": "80ab79dc-6ea8-327e-8190-54b551c978d3",
                                "text": "„Das Titulum oder wenigstens der nachträglich hergestellte Wasserabfluß zum großen Graben muß übrigens bereits wieder zugefüllt gewesen sein, als die Töpfe vergraben wurden.“"
                            },
                            {
                                "example_id": "4b64794f-4a0c-4817-9afe-1509dcba97f5",
                                "sense_id": "80ab79dc-6ea8-327e-8190-54b551c978d3",
                                "text": "„Ausserdem wird in einer Entfernung von 60 Fuss vor dem Thore in der Breite der Thoröffnung ein Graben gezogen, das Titulum.“"
                            },
                            {
                                "example_id": "357a9184-e10e-4993-b4ea-85b6e719a24f",
                                "sense_id": "80ab79dc-6ea8-327e-8190-54b551c978d3",
                                "text": "„Um so mehr mußte ich an das Titulum denken, weil es ja in der Linie der ostwestlichen Lagerstraße liegt.“"
                            },
                            {
                                "example_id": "bdebd12b-cfc8-4c7b-9efc-01b14069e99c",
                                "sense_id": "80ab79dc-6ea8-327e-8190-54b551c978d3",
                                "text": "„Diese von Franke (15 und 16 f.) bemerkte Unklarheit hätte eigentlich schon zum Zurückgehen auf Iventarkartei und Grabungstagebuch veranlassen müssen, zumal Funde aus dem Titulum des Erdkastells mit Sicherheit als Erdkastell-Funde hätten ausgewertet werden müssen.“"
                            },
                            {
                                "example_id": "9ea77dd7-3bda-43ab-ba3e-b4f584aac9df",
                                "sense_id": "80ab79dc-6ea8-327e-8190-54b551c978d3",
                                "text": "„Jedes der insgesamt vier Lagertore war von einem Titulum (etwas versetzt zum Hauptgraben gezogener kurzer Graben) geschützt.“"
                            },
                            {
                                "example_id": "f4b26dc3-0bdf-4797-8339-c2db93f0e5d9",
                                "sense_id": "80ab79dc-6ea8-327e-8190-54b551c978d3",
                                "text": "„Eine Sondage im Bereich des vorgelagerten Titulum ergab einen ca. 1,60 m tief eingeschnittenen und 1,50 m breiten Graben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
