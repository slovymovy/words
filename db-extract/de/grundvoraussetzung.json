                ],
                "senses": [
                    {
                        "sense_id": "cc3eae16-8dd6-3277-8b37-e8e831fc3896",
                        "entry_id": "1c5aa725-b22b-3098-b0b1-eefa7d68f347",
                        "glosses": [
                            "wichtige, maßgebende Bedingung, Annahme, welche die Basis, Grundlage für etwas bildet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f155262c-1dc0-47b5-9e00-7b5dc61c0506",
                                "sense_id": "cc3eae16-8dd6-3277-8b37-e8e831fc3896",
                                "text": "„Es sollte immer bedacht werden, dass die Meinungsfreiheit Grundvoraussetzung für die Funktionsfähigkeit unserer Demokratie ist.“"
                            },
                            {
                                "example_id": "3763c207-d6a1-4e3c-95b0-b61ffe2451da",
                                "sense_id": "cc3eae16-8dd6-3277-8b37-e8e831fc3896",
                                "text": "„Früher war Latein eine Grundvoraussetzung für viele Studiengänge.“"
                            },
                            {
                                "example_id": "159db6bb-3ad1-4df0-baca-618ab2ba8501",
                                "sense_id": "cc3eae16-8dd6-3277-8b37-e8e831fc3896",
                                "text": "„Gesunde Lehrer seien die Grundvoraussetzung, um die Leistungsfähigkeit des Bildungssystems gewährleisten zu können.“"
                            },
                            {
                                "example_id": "aa9dcd53-8594-4d31-9b5e-8bda39981c01",
                                "sense_id": "cc3eae16-8dd6-3277-8b37-e8e831fc3896",
                                "text": "„Dort sind nach Angaben der Handwerkskammer Rhein-Main gut 20 Prozent der Betriebsinhaber älter als 55 Jahre, in den Unternehmen, die als Grundvoraussetzung einen Handwerksmeister brauchen, sind sogar 30 Prozent älter als 55 Jahre.“"
                            },
                            {
                                "example_id": "4398a994-643a-4e93-8119-f94b50211cbb",
                                "sense_id": "cc3eae16-8dd6-3277-8b37-e8e831fc3896",
                                "text": "„Denn sie schafft die Grundvoraussetzung, dass Gebäude effizient und hoch automatisiert betrieben werden können.“"
                            },
                            {
                                "example_id": "672bf749-06ae-4f00-9944-14ad4c8686e3",
                                "sense_id": "cc3eae16-8dd6-3277-8b37-e8e831fc3896",
                                "text": "„Für eine wirksame Unterdrückung der Virusausbreitung in der Gesamtgesellschaft bleibe es weiterhin Grundvoraussetzung, die Viruszirkulation in den Schulen niedrig zu halten, schreiben die Virologen in ihrer Stellungnahme.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
