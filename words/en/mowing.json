{
    "word_family": [
        "mow",
        "mower",
        "mown"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "91137b34-d98d-3c08-8120-816845dd6523",
                    "sense_definition": "The act or process of cutting grass or crops.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mowing_activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawn looks much better after two <w>mowings</w> this month.",
                            "target_lang_translations": {
                                "cs": "Trávník vypadá po dvou <w>sekáních</w> tento měsíc mnohem lépe."
                            }
                        },
                        {
                            "text": "He finished the <w>mowing</w> before the rain started.",
                            "target_lang_translations": {
                                "cs": "Dokončil <w>sekání</w> dříve, než začalo pršet."
                            }
                        }
                    ],
                    "synonyms": [
                        "cutting"
                    ],
                    "common_phrases": [
                        "lawn mowing"
                    ],
                    "target_lang_definitions": {
                        "cs": "Činnost nebo proces sekání trávy či obilí."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "sekání",
                                "target_lang_sense_clarification": "obecné označení pro proces řezání trávy"
                            },
                            {
                                "target_lang_word": "sečení",
                                "target_lang_sense_clarification": "tradiční výraz pro sekání trávy nebo obilí"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f4849393-138b-3d09-8a86-2f745b128cdb",
                    "sense_definition": "Grass clippings that have been cut.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mowing_material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Use the <w>mowings</w> as mulch for your garden beds.",
                            "target_lang_translations": {
                                "cs": "Použijte <w>posekanou trávu</w> jako mulč pro své záhony."
                            }
                        },
                        {
                            "text": "The pile of <w>mowings</w> was left on the side of the yard.",
                            "target_lang_translations": {
                                "cs": "Hromada <w>posekané trávy</w> zůstala ležet na kraji dvora."
                            }
                        }
                    ],
                    "synonyms": [
                        "clippings"
                    ],
                    "target_lang_definitions": {
                        "cs": "Posekaná tráva, která zůstala na zemi."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "posekaná tráva",
                                "target_lang_sense_clarification": "doslovné označení pro zbytky trávy"
                            },
                            {
                                "target_lang_word": "tráva",
                                "target_lang_sense_clarification": "v kontextu zahradnictví jako mulč"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e4be2f9e-54e3-349b-b501-4bcf3b1c3e8a",
                    "sense_definition": "A field or area of land from which grass is harvested.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mowing_land",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cattle were grazing in the lower <w>mowing</w>.",
                            "target_lang_translations": {
                                "cs": "Dobytek se pásl na dolní <w>louce</w>."
                            }
                        },
                        {
                            "text": "They walked across the old <w>mowing</w> to reach the forest.",
                            "target_lang_translations": {
                                "cs": "Přešli přes starou <w>louku</w>, aby se dostali k lesu."
                            }
                        }
                    ],
                    "synonyms": [
                        "meadow"
                    ],
                    "target_lang_definitions": {
                        "cs": "Pole nebo pozemek, ze kterého se sklízí tráva."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "louka",
                                "target_lang_sense_clarification": "pozemek určený k sečení trávy"
                            },
                            {
                                "target_lang_word": "sečiště",
                                "target_lang_sense_clarification": "místo, kde se právě seče nebo kde se sklízí tráva"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "81526e8b-296e-39b8-a5eb-c73f613c3209",
                    "sense_definition": "Present participle and gerund of <w>mow</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mowing_activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is <w>mowing</w> the grass in the backyard right now.",
                            "target_lang_translations": {
                                "cs": "Právě teď <w>seká</w> trávu na zahradě."
                            }
                        },
                        {
                            "text": "I spent the whole morning <w>mowing</w> the lawn.",
                            "target_lang_translations": {
                                "cs": "Celé dopoledne jsem strávil <w>sekáním</w> trávníku."
                            }
                        }
                    ],
                    "common_phrases": [
                        "mowing the lawn"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "grammatical form"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Přítomné příčestí a gerundium slovesa sekat."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "sekající",
                                "target_lang_sense_clarification": "příčestí činné"
                            },
                            {
                                "target_lang_word": "sekání",
                                "target_lang_sense_clarification": "gerundium vyjadřující činnost"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}